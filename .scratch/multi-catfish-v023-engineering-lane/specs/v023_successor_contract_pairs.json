      "consumer": {
        "path": ".scratch/multi-catfish-v023-two-route-source-training-runner/v023_two_route_learner_orchestrator.py",
        "functions": ["_identity_payload", "validate_two_route_provider_identity", "V023TwoRouteLearnerOrchestrator._checked_batch", "V023TwoRouteLearnerOrchestrator.advance", "V023TwoRouteLearnerOrchestrator.load_checkpoint_state"],
        "reader_attributes": ["provider_identity", "provider_identity_payload", "planned_epoch_budget", "next_batch", "sampler_state", "load_sampler_state", "route", "source", "file_id", "batch"],
        "constants": ["ORCHESTRATOR_SCHEMA", "IMPLEMENTATION_ONLY_CLAIM", "ROUTE_ORDER", "SOURCE_ORDER", "FORMAL_SOURCE_TRAINING_EPOCHS", "FORMAL_CHECKPOINT_CADENCE_UPDATES"]
      },
      "numeric_constants": ["EPOCH_BUDGET", "FORMAL_SOURCE_TRAINING_EPOCHS", "FORMAL_CHECKPOINT_CADENCE_UPDATES"]
    }
  ]
