        "constants": ["SCHEMA", "SCHEDULE_SCHEMA", "OPS3_SELECTED_PAIR_SCHEMA", "OPS3_TARGET_UNIT", "CLAIM_CEILING"]
      },
      "consumer": {
        "path": ".scratch/multi-catfish-v023-c1c2-target-generation-launch/run_v023_c1c2_targets_server.py",
        "functions": ["_read_receipt", "_ops3_row", "_validate_shard", "_merge"],
        "constants": ["SCHEMA", "SCHEDULE_SCHEMA", "SHARD_MODES", "SHARD_FAMILIES", "OPS3_SELECTED_PAIR_SCHEMA", "OPS3_TARGET_UNIT", "OPS3_HORIZON", "OPS3_FEATURE_DIM", "OPS3_SAMPLES_PER_STEP"]
      },
      "layout_constants": ["OPS3_FEATURE_DIM", "OPS3_SAMPLES_PER_STEP"],
      "numeric_constants": ["OPS3_HORIZON", "OPS3_FEATURE_DIM", "OPS3_SAMPLES_PER_STEP"],
      "bindings": [
        {"category": "token.schema", "name": "target generation schema", "producer": "SCHEMA", "consumer": "SCHEMA"},
        {"category": "token.schema", "name": "schedule schema", "producer": "SCHEDULE_SCHEMA", "consumer": "SCHEDULE_SCHEMA"},
        {"category": "token.schema", "name": "OPS-3 selected-pair schema", "producer": "OPS3_SELECTED_PAIR_SCHEMA", "consumer": "OPS3_SELECTED_PAIR_SCHEMA"},
        {"category": "token.unit", "name": "normalized C2 target unit", "producer": "OPS3_TARGET_UNIT", "consumer": "OPS3_TARGET_UNIT"}
      ]
    },
    {
      "name": "b2-generator-to-sealer",
      "producer": {
        "path": ".scratch/multi-catfish-v023-c1c2-target-generation/generate_v023_c1c2_targets.py",
