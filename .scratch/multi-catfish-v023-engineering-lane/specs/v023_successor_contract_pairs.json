        "reader_attributes": ["root", "receipt", "modes", "for_mode", "c1_datasets", "c2_datasets", "c1_pair_batch", "c2_pair_batch"],
        "constants": ["CONFIG_SCHEMA", "FACTORY_SCHEMA", "IDENTITY_SCHEMA", "SAMPLER_SCHEMA", "CLAIM_CEILING", "ROUTES", "SOURCES", "EXPECTED_C1_STATE_DIM", "EXPECTED_C2_STATE_DIM", "EXPECTED_ACTION_DIM"]
      },
      "layout_constants": ["EXPECTED_C1_STATE_DIM", "EXPECTED_C2_STATE_DIM", "EXPECTED_ACTION_DIM"],
      "numeric_constants": ["EXPECTED_C1_STATE_DIM", "EXPECTED_C2_STATE_DIM", "EXPECTED_ACTION_DIM"]
    },
    {
      "name": "d-provider-factory-v3-to-two-route-runner",
      "producer": {
