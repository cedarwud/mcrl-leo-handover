        {"category": "token.schema", "name": "OPS-3 selected-pair schema", "producer": "OPS3_SELECTED_PAIR_SCHEMA", "consumer": "OPS3_SELECTED_PAIR_SCHEMA"},
        {"category": "token.claim_ceiling", "name": "target claim ceiling", "producer": "CLAIM_CEILING", "consumer": "TARGET_CLAIM_CEILING"},
        {"category": "token.unit", "name": "normalized C2 target unit", "producer": "OPS3_TARGET_UNIT", "consumer": "OPS3_TARGET_UNIT"}
      ]
    },
    {
