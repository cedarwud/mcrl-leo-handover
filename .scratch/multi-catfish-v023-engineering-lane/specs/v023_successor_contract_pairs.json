        "constants": ["SCHEMA", "CLAIM_CEILING"]
      },
      "bindings": [
        {"category": "token.schema", "name": "target generation schema", "producer": "SCHEMA", "consumer": "SCHEMA"}
      ]
    },
    {
      "name": "c-adapter-to-provider-factory-v3",
      "producer": {
        "path": ".scratch/multi-catfish-v023-target-batch-adapter/target_batch_adapter.py",
        "functions": ["load_completed_target_artifact", "V023TargetArtifact.for_mode", "V023TargetArtifact.pair_batch"],
