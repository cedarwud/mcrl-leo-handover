DEFAULT_TLE_ROOT = Path("~/demo/tle_data/starlink/tle")
CANONICAL_STEPS = 30
FORECAST_STEPS = 3
PREPARED_STEPS = CANONICAL_STEPS + FORECAST_STEPS
_FUTURE_SECONDS = 900.0
_FUTURE_INTERVALS = int(math.ceil(_FUTURE_SECONDS / D2_MEASUREMENT_STEP_S))
