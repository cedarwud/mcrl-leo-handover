    61	def load_json(path: Path, *, verify_digest: bool = False) -> dict:
    62	    payload = json.loads(path.read_text(encoding="ascii"))
    63	    if verify_digest:
    64	        expected = payload.get("receipt_sha256")
    65	        actual = canonical_digest(payload)
    66	        if expected != actual:
    67	            raise RuntimeError(f"receipt digest mismatch: {path}: {actual} != {expected}")
    68	    return payload
    69	
    70	
    71	def write_receipt(payload: dict, path: Path) -> None:
    72	    payload["receipt_sha256"] = canonical_digest(payload)
    73	    path.parent.mkdir(parents=True, exist_ok=True)
    74	    path.write_text(
    75	        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
    76	        encoding="ascii",
    77	    )
