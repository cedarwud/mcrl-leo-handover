    37	
    38	    if len(true_relative_gain) != 3:
    39	        raise ValueError("three primary contrast alternatives are required")
    40	    date_effect = rng.normal(0.0, date_sd, (3, date_count))
    41	    seed_effect = rng.normal(0.0, seed_sd, (3, seed_count))
    42	    clusters: dict[tuple[str, int], dict[str, AdditiveTotals]] = {}
    43	    for date_index in range(date_count):
    44	        date = f"D{date_index:03d}"
