for f in controller-records/V025-CONTROLLER-FINDINGS*.md controller-records/V025-CONTROLLER-O*.md; do printf '\\nFILE %s\\n' \""'$f"; cat "$f"; done' in /home/sat/mcrl-v025-strategic-astra-ws
