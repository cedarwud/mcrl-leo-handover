    48	def canonical_digest(payload: Mapping[str, object]) -> str:
    49	    unsigned = dict(payload)
    50	    unsigned.pop("receipt_sha256", None)
    51	    encoded = json.dumps(
    52	        unsigned,
    53	        sort_keys=True,
    54	        separators=(",", ":"),
    55	        ensure_ascii=True,
    56	        allow_nan=False,
    57	    ).encode("ascii")
    58	    return hashlib.sha256(encoded).hexdigest()
