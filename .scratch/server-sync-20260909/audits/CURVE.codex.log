    base: Configuration,
    candidate: Configuration,
    *,
    cell_rekeyed_users: Iterable[int] = (),
) -> Fraction:
    return phi_qos(
        _physical_events(
            base, candidate, cell_rekeyed_users=cell_rekeyed_users
        )
    )


