+++ b/scripts/run_label_budget_curve.py
@@ -0,0 +1,480 @@
+#!/usr/bin/env python3
+"""Anchor-disjoint diagnostic learning curve for the V0.25 C3 interaction head.
+
+This script changes no production rule.  It reuses the sealed C3 feature vector,
+architecture, initialization, optimizer literals, learner seeds, and update count,
+and varies only which complete anchor blocks are visible during fitting.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+import hashlib
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+import numpy as np
+
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.tapes import build_world_tape
+from mcrl.stagec_v025.coalitions import read_coalition_shard
+from mcrl.stagec_v025.learner import (
+    AdamMLPHead,
+    LEARNER_SEEDS,
+    LEGACY_EPOCH_BUDGET,
+    LEGACY_TRAINER_LITERALS,
+)
+from mcrl.stagec_v025.state import Q1_FEATURES, Q2_FEATURES
+
+
+ROOT = Path(__file__).resolve().parents[1]
+CORPUS = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
+MANIFEST = CORPUS / "PILOT_NOT_CLAIM-manifest.json"
+OUTPUT = ROOT / "artifacts/label-budget-curve-20260909-DIAGNOSTIC_NOT_CLAIM.json"
+FIGURE = ROOT / "artifacts/label-budget-curve-20260909-DIAGNOSTIC_NOT_CLAIM.png"
+TARGETS = (180, 400, 800, 1600, 3200)
+FOLDS = 5
+CURVE_SEEDS = tuple(LEARNER_SEEDS[:4])
+STRATA = ("all", "size-2", "size-3-plus")
+METHODS = ("interaction-head", "size-only", "zero-interaction")
+
+
+def stable_key(domain: str, value: str) -> bytes:
+    return hashlib.sha256(f"{domain}|{value}".encode("ascii")).digest()
+
+
+def identity(action):
+    if action.is_null:
+        return None
+    return (int(action.norad_id), int(action.beam_chain_id))
+
+
+def load_rows():
+    rows = []
+    shard_paths = sorted((CORPUS / "rows").glob("world-*/*.jsonl"))
+    if len(shard_paths) != 180:
+        raise RuntimeError(f"expected 180 shards, found {len(shard_paths)}")
+    for path in shard_paths:
+        rows.extend(read_coalition_shard(path).rows)
+    anchors = sorted({row.anchor_id for row in rows})
+    if len(anchors) != 180:
+        raise RuntimeError(f"expected 180 anchors, found {len(anchors)}")
+    member_widths = {
+        len(member.invariant_features)
+        for row in rows
+        for member in row.context.members
+    }
+    if len(member_widths) != 1:
+        raise RuntimeError("member width drifted")
+    member_width = next(iter(member_widths))
+    x = np.stack([
+        row.context.invariant_vector(member_width=member_width) for row in rows
+    ])
+    psi = np.asarray([float.fromhex(row.psi_normalized_hex) for row in rows])
+    c1 = np.asarray([float.fromhex(row.c1_normalized_hex) for row in rows])
+    exact_delta = np.asarray([
+        float.fromhex(row.objective_delta_normalized_hex) for row in rows
+    ])
+    sizes = np.asarray([len(row.context.members) for row in rows], dtype=np.int64)
+    anchor_of = np.asarray([anchors.index(row.anchor_id) for row in rows], dtype=np.int64)
+    by_anchor = {
+        anchor_index: np.flatnonzero(anchor_of == anchor_index)
+        for anchor_index in range(len(anchors))
+    }
+    return rows, anchors, by_anchor, x, psi, c1, exact_delta, sizes, member_width
+
+
+def fold_layout(anchors, by_anchor):
+    ordered = sorted(
+        range(len(anchors)),
+        key=lambda index: (stable_key("label-budget-fold-v1", anchors[index]), anchors[index]),
+    )
+    fold_of = np.empty(len(anchors), dtype=np.int64)
+    for rank, anchor_index in enumerate(ordered):
+        fold_of[anchor_index] = rank % FOLDS
+    subsets = {}
+    for fold in range(FOLDS):
+        training_anchors = [index for index in ordered if fold_of[index] != fold]
+        training_anchors.sort(
+            key=lambda index: (
+                stable_key("label-budget-nested-order-v1", anchors[index]),
+                anchors[index],
+            )
+        )
+        cumulative = []
+        count = 0
+        target_index = 0
+        for anchor_index in training_anchors:
+            cumulative.append(anchor_index)
+            count += len(by_anchor[anchor_index])
+            while target_index < len(TARGETS) and count >= TARGETS[target_index]:
+                subsets[(fold, str(TARGETS[target_index]))] = tuple(cumulative)
+                target_index += 1
+        if target_index != len(TARGETS):
+            raise RuntimeError(f"fold {fold} cannot support all requested targets")
+        subsets[(fold, "full")] = tuple(training_anchors)
+    return fold_of, subsets
+
+
+def initialized_c3_head(seed: int, input_dim: int):
+    rng = np.random.default_rng(seed)
+    # The production orchestrator initializes C1, then C2, then C3 from one RNG.
+    AdamMLPHead.create(len(Q1_FEATURES), LEGACY_TRAINER_LITERALS["C1"], rng)
+    AdamMLPHead.create(len(Q2_FEATURES), LEGACY_TRAINER_LITERALS["C2"], rng)
+    return AdamMLPHead.create(input_dim, LEGACY_TRAINER_LITERALS["C3"], rng)
+
+
+def train_predictions(x, psi, anchor_of, fold_of, subsets):
+    point_names = tuple(str(value) for value in TARGETS) + ("full",)
+    model_predictions = {
+        point: np.full((len(CURVE_SEEDS), len(psi)), np.nan, dtype=np.float64)
+        for point in point_names
+    }
+    size_predictions = {
+        point: np.full(len(psi), np.nan, dtype=np.float64) for point in point_names
+    }
+    realised_counts = defaultdict(list)
+    started = time.perf_counter()
+    for fold in range(FOLDS):
+        test = np.flatnonzero(fold_of[anchor_of] == fold)
+        for point in point_names:
+            train_anchors = np.asarray(subsets[(fold, point)], dtype=np.int64)
+            train = np.flatnonzero(np.isin(anchor_of, train_anchors))
+            realised_counts[point].append(int(len(train)))
+            size_design = np.column_stack((np.ones(len(train)), np.asarray([
+                len_value for len_value in coalition_sizes[train]
+            ], dtype=np.float64)))
+            size_beta = np.linalg.lstsq(size_design, psi[train], rcond=None)[0]
+            size_predictions[point][test] = (
+                size_beta[0] + size_beta[1] * coalition_sizes[test]
+            )
+            for seed_index, seed in enumerate(CURVE_SEEDS):
+                head = initialized_c3_head(seed, x.shape[1])
+                for _ in range(LEGACY_EPOCH_BUDGET):
+                    head.update_scalar(x[train], psi[train])
+                model_predictions[point][seed_index, test] = head._forward(x[test])[0]
+                print(json.dumps({
+                    "event": "model-complete",
+                    "fold": fold,
+                    "point": point,
+                    "learner_seed": seed,
+                    "training_labels": len(train),
+                    "elapsed_wall_s": time.perf_counter() - started,
+                }), flush=True)
+    if any(np.isnan(values).any() for values in model_predictions.values()):
+        raise RuntimeError("model out-of-fold prediction coverage is incomplete")
+    if any(np.isnan(values).any() for values in size_predictions.values()):
+        raise RuntimeError("size-only out-of-fold prediction coverage is incomplete")
+    return model_predictions, size_predictions, realised_counts
+
+
+def in_stratum(row_indices: np.ndarray, sizes: np.ndarray, stratum: str) -> np.ndarray:
+    if stratum == "all":
+        return row_indices
+    if stratum == "size-2":
+        return row_indices[sizes[row_indices] == 2]
+    return row_indices[sizes[row_indices] >= 3]
+
+
+def r_squared(truth: np.ndarray, prediction: np.ndarray) -> float:
+    denominator = float(np.sum((truth - truth.mean()) ** 2))
+    return float(1.0 - np.sum((truth - prediction) ** 2) / denominator)
+
+
+def choose(scores: np.ndarray, exact: np.ndarray, signatures: list[str]):
+    # The no-change configuration is candidate -1, with score and exact delta zero.
+    candidates = [(-1, 0.0, 0.0, "BASELINE"), *(
+        (index, float(scores[offset]), float(exact[offset]), signatures[offset])
+        for offset, index in enumerate(range(len(scores)))
+    )]
+    selected = min(candidates, key=lambda row: (-row[1], row[3]))
+    oracle = min(candidates, key=lambda row: (-row[2], row[3]))
+    return selected[0], oracle[0], oracle[2] - selected[2]
+
+
+def score_all(rows, anchors, by_anchor, psi, c1, exact_delta, sizes,
+              model_predictions, size_predictions):
+    signatures = []
+    for row in rows:
+        signatures.append(";".join(
+            f"{member.user_id}:{identity(member.selected_action)}"
+            for member in row.context.members
+        ))
+    point_names = tuple(str(value) for value in TARGETS) + ("full",)
+    results = {}
+    selections = {}
+    for stratum in STRATA:
+        stratum_indices = in_stratum(np.arange(len(rows)), sizes, stratum)
+        for point in point_names:
+            prediction_by_method = {
+                "interaction-head": model_predictions[point],
+                "size-only": size_predictions[point][None, :],
+                "zero-interaction": np.zeros((1, len(rows)), dtype=np.float64),
+            }
+            for method, predictions in prediction_by_method.items():
+                seed_r2 = [r_squared(psi[stratum_indices], pred[stratum_indices]) for pred in predictions]
+                hits = []
+                regrets = []
+                selection_rows = []
+                for pred_index, pred in enumerate(predictions):
+                    for anchor_index in range(len(anchors)):
+                        candidates = in_stratum(by_anchor[anchor_index], sizes, stratum)
+                        selected_local, oracle_local, regret = choose(
+                            c1[candidates] + pred[candidates],
+                            exact_delta[candidates],
+                            [signatures[index] for index in candidates],
+                        )
+                        selected = -1 if selected_local == -1 else int(candidates[selected_local])
+                        oracle = -1 if oracle_local == -1 else int(candidates[oracle_local])
+                        hits.append(selected == oracle)
+                        regrets.append(regret)
+                        selection_rows.append({
+                            "prediction_replica": pred_index,
+                            "anchor_index": anchor_index,
+                            "row_index": selected,
+                        })
+                key = (stratum, point, method)
+                results[key] = {
+                    "held_out_r_squared_mean": float(np.mean(seed_r2)),
+                    "held_out_r_squared_by_replica": seed_r2,
+                    "exact_best_selection_fraction": float(np.mean(hits)),
+                    "mean_regret_normalized_objective": float(np.mean(regrets)),
+                    "p95_regret_normalized_objective": float(np.quantile(regrets, 0.95)),
+                    "selection_count": len(hits),
+                }
+                selections[key] = selection_rows
+    return results, selections
+
+
+def realised_profiles(rows, anchors, selections):
+    sys.path.insert(0, str(ROOT / "scripts"))
+    import run_v025_pilot_c3 as pilot
+
+    required = defaultdict(set)
+    for selection_rows in selections.values():
+        for selection in selection_rows:
+            required[selection["anchor_index"]].add(selection["row_index"])
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    outcomes = {}
+    physics_calls = 0
+    world_to_anchor_indices = defaultdict(list)
+    for anchor_index, anchor_id in enumerate(anchors):
+        world_to_anchor_indices[rows[by_anchor_global[anchor_index][0]].world_id].append(anchor_index)
+    for world_id in sorted(world_to_anchor_indices):
+        print(json.dumps({"event": "realised-world-start", "world": world_id}), flush=True)
+        tape = build_world_tape(
+            domain=world_id,
+            provider=LegacyWorldProvider(role="label-budget-curve-realised"),
+            steps=33,
+            start_time_s=0.0,
+        )
+        for anchor_index in world_to_anchor_indices[world_id]:
+            anchor_rows = by_anchor_global[anchor_index]
+            exemplar = rows[anchor_rows[0]]
+            step_index, carrier_offset = divmod(int(exemplar.anchor_index), len(pilot.ENGINE.REFERENCE_CARRIERS))
+            carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_offset]
+            base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
+            incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
+            expected_reference = {
+                int(user): identity(action) for user, action in exemplar.context.reference_profile
+            }
+            if base.mapping != expected_reference:
+                raise RuntimeError(f"anchor reconstruction drifted for {exemplar.anchor_id}")
+            evaluator = pilot.ENGINE.StepEvaluator(
+                tape,
+                setting,
+                step_index,
+                transition_from=incumbent,
+                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+                field="realised",
+                run_setting=run_setting,
+            )
+            configs = {-1: base}
+            for row_index in sorted(required[anchor_index]):
+                if row_index == -1:
+                    continue
+                row = rows[row_index]
+                mapping = dict(base.mapping)
+                for member in row.context.members:
+                    mapping[int(member.user_id)] = identity(member.selected_action)
+                configs[row_index] = pilot.ENGINE._configuration(
+                    base, mapping, kind="label-budget-curve-selected"
+                )
+            evaluator.evaluate_many(tuple(configs.values()))
+            if evaluator._invalid:
+                raise RuntimeError(
+                    f"realised evaluator rejected {len(evaluator._invalid)} selected configurations"
+                )
+            physics_calls += evaluator.physical_evaluations
+            for row_index, config in configs.items():
+                profile = evaluator.evaluate(config)
+                outcomes[(anchor_index, row_index)] = {
+                    "bits": float(profile.bits),
+                    "joules": float(profile.joules),
+                }
+        print(json.dumps({
+            "event": "realised-world-complete",
+            "world": world_id,
+            "physics_boundary_evaluations": physics_calls,
+        }), flush=True)
+    return outcomes, physics_calls
+
+
+def attach_pooled_ee(results, selections, outcomes):
+    for key, selection_rows in selections.items():
+        bits = math.fsum(
+            outcomes[(row["anchor_index"], row["row_index"])]["bits"]
+            for row in selection_rows
+        )
+        joules = math.fsum(
+            outcomes[(row["anchor_index"], row["row_index"])]["joules"]
+            for row in selection_rows
+        )
+        results[key]["realised_bits"] = bits
+        results[key]["realised_joules"] = joules
+        results[key]["realised_pooled_ee_bits_per_j"] = bits / joules
+
+
+def serialise(results, realised_counts, manifest, elapsed, physics_calls):
+    points = tuple(str(value) for value in TARGETS) + ("full",)
+    return {
+        "schema": "mcrl-v025-label-budget-curve-v1",
+        "claim_status": "DIAGNOSTIC_NOT_CLAIM",
+        "protocol": {
+            "folds": FOLDS,
+            "fold_assignment": "SHA256(label-budget-fold-v1|anchor_id), sorted then round-robin",
+            "nested_order": "SHA256(label-budget-nested-order-v1|anchor_id)",
+            "subsampling_unit": "complete anchor",
+            "requested_label_targets": list(TARGETS),
+            "full_point": "all non-held-out anchors in each fold",
+            "learner_seeds": list(CURVE_SEEDS),
+            "c3_hidden_layers": list(LEGACY_TRAINER_LITERALS["C3"]["hidden_layers"]),
+            "c3_activation": LEGACY_TRAINER_LITERALS["C3"]["activation"],
+            "c3_learning_rate": LEGACY_TRAINER_LITERALS["C3"]["learning_rate"],
+            "updates": LEGACY_EPOCH_BUDGET,
+            "size_only": "ordinary least squares psi ~ intercept + coalition_size on identical training anchors",
+            "zero_interaction": "psi_hat=0",
+            "selection_score": "exact additive C1 + predicted interaction; no-change included at score 0",
+            "oracle_score": "exact objective delta; no-change included at delta 0",
+            "regret_unit": "kappa-normalized exact objective",
+            "realised_endpoint": "sum bits / sum joules using unchanged 48-boundary realised StepEvaluator",
+        },
+        "corpus": {
+            "manifest_sha256": hashlib.sha256(MANIFEST.read_bytes()).hexdigest(),
+            "anchors": manifest["anchors"],
+            "coalition_rows": manifest["coalition_rows"],
+            "size_histogram": manifest["size_histogram"],
+        },
+        "training_labels_by_point": {
+            point: {
+                "by_fold": realised_counts[point],
+                "mean": float(np.mean(realised_counts[point])),
+                "min": min(realised_counts[point]),
+                "max": max(realised_counts[point]),
+            }
+            for point in points
+        },
+        "metrics": [
+            {"stratum": stratum, "point": point, "method": method, **results[(stratum, point, method)]}
+            for stratum in STRATA
+            for point in points
+            for method in METHODS
+        ],
+        "realised_evaluation_physics_boundary_calls": physics_calls,
+        "diagnostic_elapsed_wall_s": elapsed,
+        "source_generation_cost": {
+            "elapsed_wall_s": manifest["elapsed_wall_s"],
+            "physical_boundary_evaluations": manifest["physical_evaluations"],
+            "mean_wall_s_per_physics_evaluation": (
+                manifest["elapsed_wall_s"] / manifest["physical_evaluations"]
+            ),
+            "incremental_physics_calls_per_cached_anchor_coalition_label": 1,
+        },
+    }
+
+
+def plot(payload):
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    lookup = {
+        (row["stratum"], row["point"], row["method"]): row
+        for row in payload["metrics"]
+    }
+    points = tuple(str(value) for value in TARGETS) + ("full",)
+    x = np.asarray([payload["training_labels_by_point"][point]["mean"] for point in points])
+    metric_rows = (
+        ("held_out_r_squared_mean", "Held-out R-squared"),
+        ("exact_best_selection_fraction", "Exact-best selection"),
+        ("mean_regret_normalized_objective", "Mean exact regret"),
+        ("realised_pooled_ee_bits_per_j", "Realised pooled EE (bit/J)"),
+    )
+    colors = {
+        "interaction-head": "#1565c0",
+        "size-only": "#ef6c00",
+        "zero-interaction": "#555555",
+    }
+    fig, axes = plt.subplots(4, 3, figsize=(16, 17), sharex=True)
+    for column, stratum in enumerate(STRATA):
+        for row_index, (metric, label) in enumerate(metric_rows):
+            ax = axes[row_index, column]
+            for method in METHODS:
+                values = [lookup[(stratum, point, method)][metric] for point in points]
+                ax.plot(x, values, marker="o", linewidth=2, label=method, color=colors[method])
+            ax.set_xscale("log")
+            ax.grid(alpha=0.25)
+            ax.set_ylabel(label)
+            if row_index == 0:
+                ax.set_title(stratum)
+            if row_index == len(metric_rows) - 1:
+                ax.set_xlabel("Mean training labels per fold (whole anchors)")
+    axes[0, 0].legend(frameon=False)
+    fig.suptitle("V0.25 interaction label-budget curve — DIAGNOSTIC_NOT_CLAIM", fontsize=16)
+    fig.tight_layout(rect=(0, 0, 1, 0.98))
+    fig.savefig(FIGURE, dpi=150)
+    plt.close(fig)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--skip-realised", action="store_true")
+    args = parser.parse_args()
+    started = time.perf_counter()
+    manifest = json.loads(MANIFEST.read_text(encoding="ascii"))
+    global coalition_sizes, by_anchor_global
+    rows, anchors, by_anchor_global, x, psi, c1, exact_delta, coalition_sizes, _ = load_rows()
+    fold_of, subsets = fold_layout(anchors, by_anchor_global)
+    model_predictions, size_predictions, realised_counts = train_predictions(
+        x, psi, np.asarray([anchors.index(row.anchor_id) for row in rows]),
+        fold_of, subsets,
+    )
+    results, selections = score_all(
+        rows, anchors, by_anchor_global, psi, c1, exact_delta, coalition_sizes,
+        model_predictions, size_predictions,
+    )
+    physics_calls = 0
+    if not args.skip_realised:
+        outcomes, physics_calls = realised_profiles(rows, anchors, selections)
+        attach_pooled_ee(results, selections, outcomes)
+    payload = serialise(
+        results, realised_counts, manifest, time.perf_counter() - started, physics_calls
+    )
+    OUTPUT.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    if not args.skip_realised:
+        plot(payload)
+    print(json.dumps({
+        "event": "complete",
+        "output": str(OUTPUT),
+        "figure": None if args.skip_realised else str(FIGURE),
+        "elapsed_wall_s": time.perf_counter() - started,
+    }), flush=True)
+
+
+if __name__ == "__main__":
+    main()

diff --git a/scripts/run_label_budget_curve.py b/scripts/run_label_budget_curve.py
new file mode 100644
index 0000000000000000000000000000000000000000..9951272719ab75e26774eaf8597cf2cd0619f9d5
--- /dev/null
+++ b/scripts/run_label_budget_curve.py
@@ -0,0 +1,480 @@
+#!/usr/bin/env python3
+"""Anchor-disjoint diagnostic learning curve for the V0.25 C3 interaction head.
+
+This script changes no production rule.  It reuses the sealed C3 feature vector,
+architecture, initialization, optimizer literals, learner seeds, and update count,
+and varies only which complete anchor blocks are visible during fitting.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+import hashlib
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+import numpy as np
+
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.tapes import build_world_tape
+from mcrl.stagec_v025.coalitions import read_coalition_shard
+from mcrl.stagec_v025.learner import (
+    AdamMLPHead,
+    LEARNER_SEEDS,
+    LEGACY_EPOCH_BUDGET,
+    LEGACY_TRAINER_LITERALS,
+)
+from mcrl.stagec_v025.state import Q1_FEATURES, Q2_FEATURES
+
+
+ROOT = Path(__file__).resolve().parents[1]
+CORPUS = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
+MANIFEST = CORPUS / "PILOT_NOT_CLAIM-manifest.json"
+OUTPUT = ROOT / "artifacts/label-budget-curve-20260909-DIAGNOSTIC_NOT_CLAIM.json"
+FIGURE = ROOT / "artifacts/label-budget-curve-20260909-DIAGNOSTIC_NOT_CLAIM.png"
+TARGETS = (180, 400, 800, 1600, 3200)
+FOLDS = 5
+CURVE_SEEDS = tuple(LEARNER_SEEDS[:4])
+STRATA = ("all", "size-2", "size-3-plus")
+METHODS = ("interaction-head", "size-only", "zero-interaction")
+
+
+def stable_key(domain: str, value: str) -> bytes:
+    return hashlib.sha256(f"{domain}|{value}".encode("ascii")).digest()
+
+
+def identity(action):
+    if action.is_null:
+        return None
+    return (int(action.norad_id), int(action.beam_chain_id))
+
+
+def load_rows():
+    rows = []
+    shard_paths = sorted((CORPUS / "rows").glob("world-*/*.jsonl"))
+    if len(shard_paths) != 180:
+        raise RuntimeError(f"expected 180 shards, found {len(shard_paths)}")
+    for path in shard_paths:
+        rows.extend(read_coalition_shard(path).rows)
+    anchors = sorted({row.anchor_id for row in rows})
+    if len(anchors) != 180:
+        raise RuntimeError(f"expected 180 anchors, found {len(anchors)}")
+    member_widths = {
+        len(member.invariant_features)
+        for row in rows
+        for member in row.context.members
+    }
+    if len(member_widths) != 1:
+        raise RuntimeError("member width drifted")
+    member_width = next(iter(member_widths))
+    x = np.stack([
+        row.context.invariant_vector(member_width=member_width) for row in rows
+    ])
+    psi = np.asarray([float.fromhex(row.psi_normalized_hex) for row in rows])
+    c1 = np.asarray([float.fromhex(row.c1_normalized_hex) for row in rows])
+    exact_delta = np.asarray([
+        float.fromhex(row.objective_delta_normalized_hex) for row in rows
+    ])
+    sizes = np.asarray([len(row.context.members) for row in rows], dtype=np.int64)
+    anchor_of = np.asarray([anchors.index(row.anchor_id) for row in rows], dtype=np.int64)
+    by_anchor = {
+        anchor_index: np.flatnonzero(anchor_of == anchor_index)
+        for anchor_index in range(len(anchors))
+    }
+    return rows, anchors, by_anchor, x, psi, c1, exact_delta, sizes, member_width
+
+
+def fold_layout(anchors, by_anchor):
+    ordered = sorted(
+        range(len(anchors)),
+        key=lambda index: (stable_key("label-budget-fold-v1", anchors[index]), anchors[index]),
+    )
+    fold_of = np.empty(len(anchors), dtype=np.int64)
+    for rank, anchor_index in enumerate(ordered):
+        fold_of[anchor_index] = rank % FOLDS
+    subsets = {}
+    for fold in range(FOLDS):
+        training_anchors = [index for index in ordered if fold_of[index] != fold]
+        training_anchors.sort(
+            key=lambda index: (
+                stable_key("label-budget-nested-order-v1", anchors[index]),
+                anchors[index],
+            )
+        )
+        cumulative = []
+        count = 0
+        target_index = 0
+        for anchor_index in training_anchors:
+            cumulative.append(anchor_index)
+            count += len(by_anchor[anchor_index])
+            while target_index < len(TARGETS) and count >= TARGETS[target_index]:
+                subsets[(fold, str(TARGETS[target_index]))] = tuple(cumulative)
+                target_index += 1
+        if target_index != len(TARGETS):
+            raise RuntimeError(f"fold {fold} cannot support all requested targets")
+        subsets[(fold, "full")] = tuple(training_anchors)
+    return fold_of, subsets
+
+
+def initialized_c3_head(seed: int, input_dim: int):
+    rng = np.random.default_rng(seed)
+    # The production orchestrator initializes C1, then C2, then C3 from one RNG.
+    AdamMLPHead.create(len(Q1_FEATURES), LEGACY_TRAINER_LITERALS["C1"], rng)
+    AdamMLPHead.create(len(Q2_FEATURES), LEGACY_TRAINER_LITERALS["C2"], rng)
+    return AdamMLPHead.create(input_dim, LEGACY_TRAINER_LITERALS["C3"], rng)
+
+
+def train_predictions(x, psi, anchor_of, fold_of, subsets):
+    point_names = tuple(str(value) for value in TARGETS) + ("full",)
+    model_predictions = {
+        point: np.full((len(CURVE_SEEDS), len(psi)), np.nan, dtype=np.float64)
+        for point in point_names
+    }
+    size_predictions = {
+        point: np.full(len(psi), np.nan, dtype=np.float64) for point in point_names
+    }
+    realised_counts = defaultdict(list)
+    started = time.perf_counter()
+    for fold in range(FOLDS):
+        test = np.flatnonzero(fold_of[anchor_of] == fold)
+        for point in point_names:
+            train_anchors = np.asarray(subsets[(fold, point)], dtype=np.int64)
+            train = np.flatnonzero(np.isin(anchor_of, train_anchors))
+            realised_counts[point].append(int(len(train)))
+            size_design = np.column_stack((np.ones(len(train)), np.asarray([
+                len_value for len_value in coalition_sizes[train]
+            ], dtype=np.float64)))
+            size_beta = np.linalg.lstsq(size_design, psi[train], rcond=None)[0]
+            size_predictions[point][test] = (
+                size_beta[0] + size_beta[1] * coalition_sizes[test]
+            )
+            for seed_index, seed in enumerate(CURVE_SEEDS):
+                head = initialized_c3_head(seed, x.shape[1])
+                for _ in range(LEGACY_EPOCH_BUDGET):
+                    head.update_scalar(x[train], psi[train])
+                model_predictions[point][seed_index, test] = head._forward(x[test])[0]
+                print(json.dumps({
+                    "event": "model-complete",
+                    "fold": fold,
+                    "point": point,
+                    "learner_seed": seed,
+                    "training_labels": len(train),
+                    "elapsed_wall_s": time.perf_counter() - started,
+                }), flush=True)
+    if any(np.isnan(values).any() for values in model_predictions.values()):
+        raise RuntimeError("model out-of-fold prediction coverage is incomplete")
+    if any(np.isnan(values).any() for values in size_predictions.values()):
+        raise RuntimeError("size-only out-of-fold prediction coverage is incomplete")
+    return model_predictions, size_predictions, realised_counts
+
+
+def in_stratum(row_indices: np.ndarray, sizes: np.ndarray, stratum: str) -> np.ndarray:
+    if stratum == "all":
+        return row_indices
+    if stratum == "size-2":
+        return row_indices[sizes[row_indices] == 2]
+    return row_indices[sizes[row_indices] >= 3]
+
+
+def r_squared(truth: np.ndarray, prediction: np.ndarray) -> float:
+    denominator = float(np.sum((truth - truth.mean()) ** 2))
+    return float(1.0 - np.sum((truth - prediction) ** 2) / denominator)
+
+
+def choose(scores: np.ndarray, exact: np.ndarray, signatures: list[str]):
+    # The no-change configuration is candidate -1, with score and exact delta zero.
+    candidates = [(-1, 0.0, 0.0, "BASELINE"), *(
+        (index, float(scores[offset]), float(exact[offset]), signatures[offset])
+        for offset, index in enumerate(range(len(scores)))
+    )]
+    selected = min(candidates, key=lambda row: (-row[1], row[3]))
+    oracle = min(candidates, key=lambda row: (-row[2], row[3]))
+    return selected[0], oracle[0], oracle[2] - selected[2]
+
+
+def score_all(rows, anchors, by_anchor, psi, c1, exact_delta, sizes,
+              model_predictions, size_predictions):
+    signatures = []
+    for row in rows:
+        signatures.append(";".join(
+            f"{member.user_id}:{identity(member.selected_action)}"
+            for member in row.context.members
+        ))
+    point_names = tuple(str(value) for value in TARGETS) + ("full",)
+    results = {}
+    selections = {}
+    for stratum in STRATA:
+        stratum_indices = in_stratum(np.arange(len(rows)), sizes, stratum)
+        for point in point_names:
+            prediction_by_method = {
+                "interaction-head": model_predictions[point],
+                "size-only": size_predictions[point][None, :],
+                "zero-interaction": np.zeros((1, len(rows)), dtype=np.float64),
+            }
+            for method, predictions in prediction_by_method.items():
+                seed_r2 = [r_squared(psi[stratum_indices], pred[stratum_indices]) for pred in predictions]
+                hits = []
+                regrets = []
+                selection_rows = []
+                for pred_index, pred in enumerate(predictions):
+                    for anchor_index in range(len(anchors)):
+                        candidates = in_stratum(by_anchor[anchor_index], sizes, stratum)
+                        selected_local, oracle_local, regret = choose(
+                            c1[candidates] + pred[candidates],
+                            exact_delta[candidates],
+                            [signatures[index] for index in candidates],
+                        )
+                        selected = -1 if selected_local == -1 else int(candidates[selected_local])
+                        oracle = -1 if oracle_local == -1 else int(candidates[oracle_local])
+                        hits.append(selected == oracle)
+                        regrets.append(regret)
+                        selection_rows.append({
+                            "prediction_replica": pred_index,
+                            "anchor_index": anchor_index,
+                            "row_index": selected,
+                        })
+                key = (stratum, point, method)
+                results[key] = {
+                    "held_out_r_squared_mean": float(np.mean(seed_r2)),
+                    "held_out_r_squared_by_replica": seed_r2,
+                    "exact_best_selection_fraction": float(np.mean(hits)),
+                    "mean_regret_normalized_objective": float(np.mean(regrets)),
+                    "p95_regret_normalized_objective": float(np.quantile(regrets, 0.95)),
+                    "selection_count": len(hits),
+                }
+                selections[key] = selection_rows
+    return results, selections
+
+
+def realised_profiles(rows, anchors, selections):
+    sys.path.insert(0, str(ROOT / "scripts"))
+    import run_v025_pilot_c3 as pilot
+
+    required = defaultdict(set)
+    for selection_rows in selections.values():
+        for selection in selection_rows:
+            required[selection["anchor_index"]].add(selection["row_index"])
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    outcomes = {}
+    physics_calls = 0
+    world_to_anchor_indices = defaultdict(list)
+    for anchor_index, anchor_id in enumerate(anchors):
+        world_to_anchor_indices[rows[by_anchor_global[anchor_index][0]].world_id].append(anchor_index)
+    for world_id in sorted(world_to_anchor_indices):
+        print(json.dumps({"event": "realised-world-start", "world": world_id}), flush=True)
+        tape = build_world_tape(
+            domain=world_id,
+            provider=LegacyWorldProvider(role="label-budget-curve-realised"),
+            steps=33,
+            start_time_s=0.0,
+        )
+        for anchor_index in world_to_anchor_indices[world_id]:
+            anchor_rows = by_anchor_global[anchor_index]
+            exemplar = rows[anchor_rows[0]]
+            step_index, carrier_offset = divmod(int(exemplar.anchor_index), len(pilot.ENGINE.REFERENCE_CARRIERS))
+            carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_offset]
+            base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
+            incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
+            expected_reference = {
+                int(user): identity(action) for user, action in exemplar.context.reference_profile
+            }
+            if base.mapping != expected_reference:
+                raise RuntimeError(f"anchor reconstruction drifted for {exemplar.anchor_id}")
+            evaluator = pilot.ENGINE.StepEvaluator(
+                tape,
+                setting,
+                step_index,
+                transition_from=incumbent,
+                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+                field="realised",
+                run_setting=run_setting,
+            )
+            configs = {-1: base}
+            for row_index in sorted(required[anchor_index]):
+                if row_index == -1:
+                    continue
+                row = rows[row_index]
+                mapping = dict(base.mapping)
+                for member in row.context.members:
+                    mapping[int(member.user_id)] = identity(member.selected_action)
+                configs[row_index] = pilot.ENGINE._configuration(
+                    base, mapping, kind="label-budget-curve-selected"
+                )
+            evaluator.evaluate_many(tuple(configs.values()))
+            if evaluator._invalid:
+                raise RuntimeError(
+                    f"realised evaluator rejected {len(evaluator._invalid)} selected configurations"
+                )
+            physics_calls += evaluator.physical_evaluations
+            for row_index, config in configs.items():
+                profile = evaluator.evaluate(config)
+                outcomes[(anchor_index, row_index)] = {
+                    "bits": float(profile.bits),
+                    "joules": float(profile.joules),
+                }
+        print(json.dumps({
+            "event": "realised-world-complete",
+            "world": world_id,
+            "physics_boundary_evaluations": physics_calls,
+        }), flush=True)
+    return outcomes, physics_calls
+
+
+def attach_pooled_ee(results, selections, outcomes):
+    for key, selection_rows in selections.items():
+        bits = math.fsum(
+            outcomes[(row["anchor_index"], row["row_index"])]["bits"]
+            for row in selection_rows
+        )
+        joules = math.fsum(
+            outcomes[(row["anchor_index"], row["row_index"])]["joules"]
+            for row in selection_rows
+        )
+        results[key]["realised_bits"] = bits
+        results[key]["realised_joules"] = joules
+        results[key]["realised_pooled_ee_bits_per_j"] = bits / joules
+
+
+def serialise(results, realised_counts, manifest, elapsed, physics_calls):
+    points = tuple(str(value) for value in TARGETS) + ("full",)
+    return {
+        "schema": "mcrl-v025-label-budget-curve-v1",
+        "claim_status": "DIAGNOSTIC_NOT_CLAIM",
+        "protocol": {
+            "folds": FOLDS,
+            "fold_assignment": "SHA256(label-budget-fold-v1|anchor_id), sorted then round-robin",
+            "nested_order": "SHA256(label-budget-nested-order-v1|anchor_id)",
+            "subsampling_unit": "complete anchor",
+            "requested_label_targets": list(TARGETS),
+            "full_point": "all non-held-out anchors in each fold",
+            "learner_seeds": list(CURVE_SEEDS),
+            "c3_hidden_layers": list(LEGACY_TRAINER_LITERALS["C3"]["hidden_layers"]),
+            "c3_activation": LEGACY_TRAINER_LITERALS["C3"]["activation"],
+            "c3_learning_rate": LEGACY_TRAINER_LITERALS["C3"]["learning_rate"],
+            "updates": LEGACY_EPOCH_BUDGET,
+            "size_only": "ordinary least squares psi ~ intercept + coalition_size on identical training anchors",
+            "zero_interaction": "psi_hat=0",
+            "selection_score": "exact additive C1 + predicted interaction; no-change included at score 0",
+            "oracle_score": "exact objective delta; no-change included at delta 0",
+            "regret_unit": "kappa-normalized exact objective",
+            "realised_endpoint": "sum bits / sum joules using unchanged 48-boundary realised StepEvaluator",
+        },
+        "corpus": {
+            "manifest_sha256": hashlib.sha256(MANIFEST.read_bytes()).hexdigest(),
+            "anchors": manifest["anchors"],
+            "coalition_rows": manifest["coalition_rows"],
+            "size_histogram": manifest["size_histogram"],
+        },
+        "training_labels_by_point": {
+            point: {
+                "by_fold": realised_counts[point],
+                "mean": float(np.mean(realised_counts[point])),
+                "min": min(realised_counts[point]),
+                "max": max(realised_counts[point]),
+            }
+            for point in points
+        },
+        "metrics": [
+            {"stratum": stratum, "point": point, "method": method, **results[(stratum, point, method)]}
+            for stratum in STRATA
+            for point in points
+            for method in METHODS
+        ],
+        "realised_evaluation_physics_boundary_calls": physics_calls,
+        "diagnostic_elapsed_wall_s": elapsed,
+        "source_generation_cost": {
+            "elapsed_wall_s": manifest["elapsed_wall_s"],
+            "physical_boundary_evaluations": manifest["physical_evaluations"],
+            "mean_wall_s_per_physics_evaluation": (
+                manifest["elapsed_wall_s"] / manifest["physical_evaluations"]
+            ),
+            "incremental_physics_calls_per_cached_anchor_coalition_label": 1,
+        },
+    }
+
+
+def plot(payload):
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    lookup = {
+        (row["stratum"], row["point"], row["method"]): row
+        for row in payload["metrics"]
+    }
+    points = tuple(str(value) for value in TARGETS) + ("full",)
+    x = np.asarray([payload["training_labels_by_point"][point]["mean"] for point in points])
+    metric_rows = (
+        ("held_out_r_squared_mean", "Held-out R-squared"),
+        ("exact_best_selection_fraction", "Exact-best selection"),
+        ("mean_regret_normalized_objective", "Mean exact regret"),
+        ("realised_pooled_ee_bits_per_j", "Realised pooled EE (bit/J)"),
+    )
+    colors = {
+        "interaction-head": "#1565c0",
+        "size-only": "#ef6c00",
+        "zero-interaction": "#555555",
+    }
+    fig, axes = plt.subplots(4, 3, figsize=(16, 17), sharex=True)
+    for column, stratum in enumerate(STRATA):
+        for row_index, (metric, label) in enumerate(metric_rows):
+            ax = axes[row_index, column]
+            for method in METHODS:
+                values = [lookup[(stratum, point, method)][metric] for point in points]
+                ax.plot(x, values, marker="o", linewidth=2, label=method, color=colors[method])
+            ax.set_xscale("log")
+            ax.grid(alpha=0.25)
+            ax.set_ylabel(label)
+            if row_index == 0:
+                ax.set_title(stratum)
+            if row_index == len(metric_rows) - 1:
+                ax.set_xlabel("Mean training labels per fold (whole anchors)")
+    axes[0, 0].legend(frameon=False)
+    fig.suptitle("V0.25 interaction label-budget curve — DIAGNOSTIC_NOT_CLAIM", fontsize=16)
+    fig.tight_layout(rect=(0, 0, 1, 0.98))
+    fig.savefig(FIGURE, dpi=150)
+    plt.close(fig)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--skip-realised", action="store_true")
+    args = parser.parse_args()
+    started = time.perf_counter()
+    manifest = json.loads(MANIFEST.read_text(encoding="ascii"))
+    global coalition_sizes, by_anchor_global
+    rows, anchors, by_anchor_global, x, psi, c1, exact_delta, coalition_sizes, _ = load_rows()
+    fold_of, subsets = fold_layout(anchors, by_anchor_global)
+    model_predictions, size_predictions, realised_counts = train_predictions(
+        x, psi, np.asarray([anchors.index(row.anchor_id) for row in rows]),
+        fold_of, subsets,
+    )
+    results, selections = score_all(
+        rows, anchors, by_anchor_global, psi, c1, exact_delta, coalition_sizes,
+        model_predictions, size_predictions,
+    )
+    physics_calls = 0
+    if not args.skip_realised:
+        outcomes, physics_calls = realised_profiles(rows, anchors, selections)
+        attach_pooled_ee(results, selections, outcomes)
+    payload = serialise(
+        results, realised_counts, manifest, time.perf_counter() - started, physics_calls
+    )
+    OUTPUT.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    if not args.skip_realised:
+        plot(payload)
+    print(json.dumps({
+        "event": "complete",
+        "output": str(OUTPUT),
+        "figure": None if args.skip_realised else str(FIGURE),
+        "elapsed_wall_s": time.perf_counter() - started,
+    }), flush=True)
+
+
+if __name__ == "__main__":
+    main()

