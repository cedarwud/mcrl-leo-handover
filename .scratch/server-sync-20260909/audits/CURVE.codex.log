    def prepare(self, mappings: Sequence[Mapping[int, object]]) -> None:
        configs = {self.config(mapping).assignments: self.config(mapping) for mapping in mappings}
        ordered = list(configs.values())
        for start in range(0, len(ordered), 1024):
            self.evaluator.evaluate_many(tuple(ordered[start:start + 1024]))

    def value(self, mapping: Mapping[int, object]) -> Fraction:
        self.requests += 1
        key = self.key(mapping)
        if key in self._values:
            self.hits += 1
            return self._values[key]
        config = self.config(mapping)
        if config.configuration_id in self.evaluator._invalid:
            raise ValueError("invalid exact configuration")
        profile = self.evaluator.evaluate(config)
        outcome = profile.outcome(phi=pilot.ENGINE._phi_for(self.anchor, config))
        eta = Fraction(str(float(self.calibration.eta_ref)))
        kappa = Fraction(str(float(self.calibration.kappa_bits_per_user_step)))
        value = outcome.bits - eta * outcome.joules + kappa * outcome.phi
        self._values[key] = value
        return value


def _fraction_receipt(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def _all_required_mappings(anchor, proposals):
    base = anchor.mapping
    mappings = [base]
    for proposal in proposals:
        selected = proposal.mapping(base)
        mappings.append(selected)
        for user in proposal.users:
            singleton = dict(base)
            singleton[user] = selected[user]
            mappings.append(singleton)
        if len(proposal.users) >= 3:
            for first, second in itertools.combinations(proposal.users, 2):
                pair = dict(base)
                pair[first] = selected[first]
                pair[second] = selected[second]
                mappings.append(pair)
    return mappings


def _quantiles(values):
    if not values:
        return {key: None for key in ("min", "p05", "p50", "p95", "max", "mean", "mean_abs")}
    array = np.asarray(values, dtype=np.float64)
    return {
        "min": float(array.min()), "p05": float(np.quantile(array, 0.05)),
        "p50": float(np.quantile(array, 0.50)), "p95": float(np.quantile(array, 0.95)),
        "max": float(array.max()), "mean": float(array.mean()),
        "mean_abs": float(np.abs(array).mean()),
    }


def _write_jsonl(path: Path, header: Mapping[str, object], rows: Sequence[Mapping[str, object]]) -> str:
    encoded = b"\n".join(canonical_json_bytes(value) for value in (header, *rows)) + b"\n"
    return write_once_with_sha256(path, encoded)


def generate(*, source: Path, output: Path, world_limit: int | None, anchor_limit: int | None) -> dict:
    started = time.perf_counter()
    output.mkdir(parents=True, exist_ok=False)
    calibration = _calibration(source)
    normalization_kappa = Fraction(str(float(calibration.kappa_bits_per_user_step)))
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    size_histogram = Counter()
    family_histogram = Counter()
    family_size_histogram = defaultdict(Counter)
    coalitions_per_anchor = []
    occupancy_trainable_anchors = set()
    occupancy_2_anchors = set()
    family_rows = []
    family_psi_values = defaultdict(list)
    nested_observations = []
    r3_values = []
    invalid_proposals = 0
    old_pair_exact_matches = 0
    old_pair_mismatches = []
    total_cache_requests = total_cache_hits = total_physical = 0
    shard_paths = []
    global_anchor = 0
    worlds = pilot.TRAIN_WORLDS if world_limit is None else pilot.TRAIN_WORLDS[:world_limit]
    for world_number, domain in enumerate(worlds, start=1):
        print(json.dumps({"event": "world-start", "world": domain}), flush=True)
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(role="mechanism-coalition-corpus"),
            steps=33,
            start_time_s=0.0,
        )
        for anchor_index in range(90):
            if anchor_limit is not None and global_anchor >= anchor_limit:
                break
            step_index, carrier_offset = divmod(anchor_index, len(pilot.ENGINE.REFERENCE_CARRIERS))
            carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_offset]
            anchor = pilot.ENGINE._base_configuration(tape, step_index, carrier)
            incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
            options, _census = pilot.ENGINE._selection_shortlist(tape, step_index, run_setting=run_setting)
            legal_actions = {
                user: tuple(dict.fromkeys((anchor.mapping[user], *options[user], None)))
                for user in sorted(anchor.mapping)
            }
            source_path = source / "rows" / f"world-{world_number}" / f"{LABEL}-source-anchor-{anchor_index:03d}.jsonl"
            source_shard = read_source_shard(source_path)
            rows_by_user_action = {(row.user_id, _identity(row.action)): row for row in source_shard.rows}
            pair, old_payload = _old_pair(
                source, world_number, anchor_index, anchor
            )
            proposals = [pair]
            beam_audits = _beam_activation_audits(tape, step_index, anchor, legal_actions)
            activations = occupancy_activation_proposals(
                anchor=anchor.mapping,
                legal_actions=legal_actions,
                beam_audits=beam_audits,
            )
            if activations:
                occupancy_trainable_anchors.add((world_number, anchor_index))
            proposals.extend(activations)
            occupancy_2 = occupancy_2_diminishing_proposals(
                anchor=anchor.mapping,
                legal_actions=legal_actions,
                beam_audits=beam_audits,
            )
            if occupancy_2:
                occupancy_2_anchors.add((world_number, anchor_index))
            proposals.extend(occupancy_2)
            proposals.extend(_aggressor_relief_proposals(tape, step_index, anchor, legal_actions))
            proposals.extend(beam_evacuation_proposals(anchor=anchor.mapping, legal_actions=legal_actions))
            nested_block = None
            if anchor_index in NESTED_ANCHORS_PER_WORLD:
                alternatives = best_alternatives(anchor.mapping, legal_actions)
                if len(alternatives) >= 6:
                    nested_block = tuple(sorted(alternatives)[:6])
                    proposals.extend(nested_subset_proposals(block=nested_block, alternatives=alternatives))

            # Merge identical action configurations while retaining every family/mechanism label.
            grouped = defaultdict(list)
            for proposal in proposals:
                grouped[tuple(sorted(proposal.mapping(anchor.mapping).items()))].append(proposal)
            unique_proposals = [rows[0] for _assignments, rows in sorted(grouped.items(), key=lambda item: repr(item[0]))]
            counter = pilot.ENGINE.EvaluationCounter()
            evaluator = pilot.ENGINE.StepEvaluator(
                tape, setting, step_index, transition_from=incumbent,
                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
                field="nominal", counter=counter, run_setting=run_setting, boundary_indices=(0,),
            )
            cache = ExactObjectiveCache(
                tape=tape, step_index=step_index, carrier=carrier, anchor=anchor,
                evaluator=evaluator, calibration=calibration, setting=setting, run_setting=run_setting,
            )
            archived_counter = pilot.ENGINE.EvaluationCounter()
            archived_evaluator = pilot.ENGINE.StepEvaluator(
                tape, setting, step_index, transition_from=incumbent,
                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
                field="nominal", counter=archived_counter, run_setting=run_setting,
                boundary_indices=(0,),
            )
            archived_cache = ExactObjectiveCache(
                tape=tape, step_index=step_index, carrier=carrier, anchor=anchor,
                evaluator=archived_evaluator, calibration=calibration, setting=setting,
                run_setting=run_setting, evaluation_mode="archived-pair-compatible-exact",
            )
            archived_selected = pair.mapping(anchor.mapping)
            # Reproduce the archived primitive generator's exact call sequence:
            # scalar baseline, batched (already-cached baseline, joint), then
            # scalar singletons.  Solver results are order-sensitive at machine
            # precision, so this is part of the evaluator configuration.
            archived_evaluator.evaluate(anchor)
            archived_evaluator.evaluate_many((anchor, archived_cache.config(archived_selected)))
            exact_interaction_label(
                anchor=anchor.mapping,
                selected=archived_selected,
                evaluate=archived_cache.value,
            )
            required = _all_required_mappings(anchor, unique_proposals)
            if nested_block is not None:
                alternatives = best_alternatives(anchor.mapping, legal_actions)
                for mask in range(1 << len(nested_block)):
                    mapping = anchor.mapping
                    for offset, user in enumerate(nested_block):
                        if mask & (1 << offset):
                            mapping[user] = alternatives[user]
                    required.append(mapping)
            cache.prepare(required)
            anchor_rows = []
            anchor_family_records = []
            for assignments, mechanism_rows in sorted(grouped.items(), key=lambda item: repr(item[0])):
                selected = dict(assignments)
                config = cache.config(selected)
                is_archived_pair = any(row.family == PAIR_CATALOGUE for row in mechanism_rows)
                if is_archived_pair:
                    label = exact_interaction_label(
                        anchor=anchor.mapping, selected=selected, evaluate=archived_cache.value
                    )
                    archived_config = archived_cache.config(selected)
                    coalition_row = pilot._coalition_row(
                        tape=tape, step_index=step_index, carrier=carrier,
                        anchor_index=anchor_index, anchor=anchor, selected=archived_config,
                        evaluator=archived_evaluator, rows_by_user_action=rows_by_user_action,
                        calibration=calibration, run_setting=run_setting,
                    )
                    receipt_cache = archived_cache
                else:
                    try:
                        label = exact_interaction_label(
                            anchor=anchor.mapping, selected=selected, evaluate=cache.value
                        )
                    except (ValueError, KeyError):
                        invalid_proposals += len(mechanism_rows)
                        continue
                    coalition_row = pilot._coalition_row(
                        tape=tape, step_index=step_index, carrier=carrier,
                        anchor_index=anchor_index, anchor=anchor, selected=config,
                        evaluator=evaluator, rows_by_user_action=rows_by_user_action,
                        calibration=calibration, run_setting=run_setting,
                    )
                    receipt_cache = cache
                # The row builder and the independent Fraction path must agree exactly after float encoding.
                normalized_psi = float(label.psi / normalization_kappa)
                if coalition_row.psi_normalized_hex != float_hex(normalized_psi):
                    raise RuntimeError(
                        "independent exact label disagrees with coalition row builder: "
                        f"row={coalition_row.psi_normalized_hex} "
                        f"independent={float_hex(normalized_psi)} "
                        f"row_delta={coalition_row.objective_delta_normalized_hex} "
                        f"row_c1={coalition_row.c1_normalized_hex} "
                        f"independent_delta={float_hex(float(label.objective_delta / normalization_kappa))} "
                        f"independent_c1={float_hex(float(sum((value for _user, value in label.singleton_differences), Fraction()) / normalization_kappa))} "
                        f"families={[row.family for row in mechanism_rows]}"
                    )
                families = sorted({row.family for row in mechanism_rows})
                mechanisms = [
                    {"family": row.family, "mechanism_key": row.mechanism_key, "metadata": dict(row.metadata)}
                    for row in mechanism_rows
                ]
                r3_payload = None
                if len(label.users) >= 3:
                    r3, pair_terms = exact_r3(
                        anchor=anchor.mapping, selected=selected, label=label,
                        evaluate=receipt_cache.value,
                    )
                    normalized_r3 = float(r3 / normalization_kappa)
                    r3_values.append(normalized_r3)
                    r3_payload = {
                        "r3_normalized_hex": float_hex(normalized_r3),
                        "pair_psi_normalized_hex": [
                            {"users": list(pair_users), "psi": float_hex(float(value / normalization_kappa))}
                            for pair_users, value in pair_terms
                        ],
                    }
                receipt = {
                    "schema": f"{SCHEMA}-family-index-row-v1",
                    "artifact_label": LABEL,
                    "world_id": domain,
                    "anchor_index": anchor_index,
                    "anchor_id": coalition_row.anchor_id,
                    "configuration_id": config.configuration_id,
                    "coalition_row_sha256": canonical_sha256(coalition_row.payload()),
                    "coalition_size": len(label.users),
                    "families": families,
                    "mechanisms": mechanisms,
                    "label_convention": "EXACT_SINGLETON_DIFFERENCES",
                    "required_distinct_label_evaluations": len(label.users) + 2,
                    "observed_distinct_label_evaluations": label.distinct_evaluation_count,
                    "exact_objective_receipt": {
                        "encoding": "fraction-numerator-denominator",
                        "baseline": _fraction_receipt(label.baseline),
                        "singletons": [
                            {
                                "user": user,
                                "value": _fraction_receipt(value),
                                "difference": _fraction_receipt(
                                    dict(label.singleton_differences)[user]
                                ),
                            }
                            for user, value in label.singleton_values
                        ],
                        "coalition": _fraction_receipt(label.coalition_value),
                        "objective_delta": _fraction_receipt(label.objective_delta),
                        "psi": _fraction_receipt(label.psi),
                    },
                    "evaluation_cache_keys": {
                        "baseline": receipt_cache.key(anchor.mapping),
                        "singletons": [
                            {"user": user, "key": receipt_cache.key({**anchor.mapping, user: selected[user]})}
                            for user in label.users
                        ],
                        "coalition": receipt_cache.key(selected),
                    },
                    "r3": r3_payload,
                }
                anchor_rows.append(coalition_row)
                anchor_family_records.append(receipt)
                size_histogram[len(label.users)] += 1
                for family in families:
                    family_histogram[family] += 1
                    family_size_histogram[family][len(label.users)] += 1
                    family_psi_values[family].append(normalized_psi)
                if PAIR_CATALOGUE in families:
                    same = (
                        old_payload["psi_normalized_hex"] == coalition_row.psi_normalized_hex
                        and old_payload["objective_delta_normalized_hex"] == coalition_row.objective_delta_normalized_hex
                    )
                    if same:
                        old_pair_exact_matches += 1
                    else:
                        old_pair_mismatches.append({
                            "world": world_number, "anchor": anchor_index,
                            "old_psi": old_payload["psi_normalized_hex"], "new_psi": coalition_row.psi_normalized_hex,
                            "old_delta": old_payload["objective_delta_normalized_hex"],
                            "new_delta": coalition_row.objective_delta_normalized_hex,
                        })

            baseline_value = cache.value(anchor.mapping)
            if nested_block is not None:
                alternatives = best_alternatives(anchor.mapping, legal_actions)
                block_values = {}
                for mask in range(1 << len(nested_block)):
                    mapping = dict(anchor.mapping)
                    for offset, user in enumerate(nested_block):
                        if mask & (1 << offset):
                            mapping[user] = alternatives[user]
                    value = cache.value(mapping)
                    block_values[mask] = value
                for mask, value in block_values.items():
                    mobius = sum(
                        (-1 if (mask.bit_count() - subset.bit_count()) % 2 else 1)
                        * block_values[subset]
                        for subset in range(mask + 1)
                        if subset & mask == subset
                    )
                    nested_observations.append({
                        "schema": f"{SCHEMA}-nested-scalar-observation-v1",
                        "artifact_label": LABEL, "world_id": domain, "anchor_index": anchor_index,
                        "block": list(nested_block), "mask": mask, "mask_width": len(nested_block),
                        "objective_value_normalized_hex": float_hex(float(value / normalization_kappa)),
                        "objective_delta_normalized_hex": float_hex(float((value - baseline_value) / normalization_kappa)),
                        "mobius_coefficient_normalized_hex": float_hex(float(mobius / normalization_kappa)),
                        "evaluation_cache_key": cache.key(mapping),
                    })
            if not anchor_rows:
                raise RuntimeError("anchor produced no valid coalition rows")
            shard_path = output / "rows" / f"world-{world_number}" / f"{LABEL}-mechanism-anchor-{anchor_index:03d}.jsonl"
            shard = write_coalition_shard(shard_path, anchor_rows)
            shard_paths.append({"path": str(shard_path.relative_to(output)), "sha256": shard.file_sha256, "rows": len(anchor_rows)})
            family_rows.extend(anchor_family_records)
            coalitions_per_anchor.append(len(anchor_rows))
            total_cache_requests += cache.requests
            total_cache_hits += cache.hits
            total_cache_requests += archived_cache.requests
            total_cache_hits += archived_cache.hits
            total_physical += evaluator.physical_evaluations + archived_evaluator.physical_evaluations
            global_anchor += 1
            print(json.dumps({"event": "anchor-complete", "world": world_number, "anchor": anchor_index, "coalitions": len(anchor_rows)}), flush=True)
        if anchor_limit is not None and global_anchor >= anchor_limit:
            break

    family_digest = _write_jsonl(
        output / f"{LABEL}-family-index.jsonl",
        {"schema": f"{SCHEMA}-family-index-v1", "artifact_label": LABEL, "row_count": len(family_rows)},
        family_rows,
    )
    nested_digest = _write_jsonl(
        output / f"{LABEL}-nested-scalar-observations.jsonl",
        {"schema": f"{SCHEMA}-nested-scalar-observations-v1", "artifact_label": LABEL, "row_count": len(nested_observations)},
        nested_observations,
    )
    r3_summary = _quantiles(r3_values)
    r3_summary.update({
        "count": len(r3_values),
        "fraction_abs_gt_1e-6": float(np.mean(np.abs(r3_values) > 1e-6)) if r3_values else None,
        "fraction_abs_gt_1e-3": float(np.mean(np.abs(r3_values) > 1e-3)) if r3_values else None,
    })
    summary = {
        "schema": f"{SCHEMA}-manifest-v1", "artifact_label": LABEL,
        "claim_status": "PILOT_NOT_CLAIM", "anchors": global_anchor,
        "coalition_rows": sum(size_histogram.values()),
        "size_histogram": {str(key): size_histogram[key] for key in sorted(size_histogram)},
        "family_histogram_unique_rows": {key: family_histogram[key] for key in sorted(family_histogram)},
        "family_size_histogram": {
            family: {str(size): counts[size] for size in sorted(counts)}
            for family, counts in sorted(family_size_histogram.items())
        },
        "coalitions_per_anchor": _quantiles(coalitions_per_anchor),
        "occupancy_activation_anchors_trainable": len(occupancy_trainable_anchors),
        "occupancy_2_diminishing_anchors": len(occupancy_2_anchors),
        "family_psi_normalized_distributions": {
            family: {
                **_quantiles(values),
                "count": len(values),
                "negative_count": sum(value < 0.0 for value in values),
                "zero_count": sum(value == 0.0 for value in values),
                "positive_count": sum(value > 0.0 for value in values),
            }
            for family, values in sorted(family_psi_values.items())
        },
        "nested_blocks": len(nested_observations) // 64,
        "nested_scalar_observations": len(nested_observations),
        "nested_mobius_coefficients": len(nested_observations),
        "nested_nontrivial_residual_label_occurrences": (len(nested_observations) // 64) * 57,
        "nested_independence_statement": "64 scalar observations per six-user block; the 57 non-trivial residual labels are not 57 independent measurements",
        "label_convention": "EXACT_SINGLETON_DIFFERENCES",
        "label_evaluation_rule": "size k uses k+2 distinct configurations: baseline, k exact singletons, coalition",
        "evaluation_cache_key_axes": ["anchor", "context", "proposed_actions", "evaluator_configuration"],
        "evaluation_cache_requests": total_cache_requests, "evaluation_cache_hits": total_cache_hits,
        "physical_evaluations": total_physical, "invalid_proposals": invalid_proposals,
        "old_pair_rows_expected": global_anchor, "old_pair_exact_matches": old_pair_exact_matches,
        "old_pair_mismatches": old_pair_mismatches, "r3_normalized_distribution": r3_summary,
        "shards": shard_paths,
        "family_index_sha256": family_digest,
        "nested_scalar_observations_sha256": nested_digest,
        "code_digest": pilot.CODE_DIGEST, "physics_digest": pilot.PHYSICS_DIGEST,
        "calibration_digest": calibration.digest, "elapsed_wall_s": time.perf_counter() - started,
    }
    if world_limit is None and anchor_limit is None:
        if summary["coalition_rows"] < 3_000:
            raise RuntimeError("full corpus did not reach the several-thousand-row target")
        if set(summary["size_histogram"]) != {"2", "3", "4", "5", "6"}:
            raise RuntimeError("full corpus did not cover every coalition size 2 through 6")
        if min(coalitions_per_anchor) < 2:
            raise RuntimeError("full corpus lost within-anchor coalition variation")
    manifest_digest = write_once_with_sha256(
        output / f"{LABEL}-manifest.json", canonical_json_bytes(summary) + b"\n"
    )
    summary["manifest_sha256"] = manifest_digest
    return summary


