@dataclass(frozen=True, slots=True)
class PairwiseBatch:
    """A typed fixed aggregate batch. There is intentionally no next state."""

    route: Route
    reference_states: np.ndarray
    candidate_states: np.ndarray
    target_deltas: np.ndarray
    row_identities: tuple[str, ...]
    source_authority_sha256: str
    source_identity: str
    physics_digest: str
    digest: str

    @classmethod
    def create(
        cls,
        route: Route,
        reference_states: Sequence[Sequence[float]],
        candidate_states: Sequence[Sequence[float]],
        target_deltas: Sequence[float],
        row_identities: Sequence[str],
        source_authority_sha256: str,
        *,
        source_identity: str = "informed",
        physics_digest: str,
    ) -> "PairwiseBatch":
        reference = np.asarray(reference_states, dtype=np.float64)
        candidate = np.asarray(candidate_states, dtype=np.float64)
        targets = np.asarray(target_deltas, dtype=np.float64)
        identities = tuple(row_identities)
        if route not in ROUTES:
            raise StageCContractError("unknown pairwise route")
        if reference.ndim != 2 or candidate.shape != reference.shape:
            raise StageCContractError("pairwise state tensors must be equal rank-2 arrays")
        if targets.shape != (reference.shape[0],) or len(identities) != reference.shape[0]:
            raise StageCContractError("pairwise target/identity count drifted")
        if (
            reference.shape[0] < 1
            or not np.isfinite(reference).all()
            or not np.isfinite(candidate).all()
            or not np.isfinite(targets).all()
        ):
            raise StageCContractError("pairwise batch must be nonempty and finite")
        if len(source_authority_sha256) != 64 or any(
            character not in "0123456789abcdef"
            for character in source_authority_sha256
        ):
            raise StageCContractError("source authority must be a lowercase SHA-256")
        if len(physics_digest) != 64 or any(character not in "0123456789abcdef" for character in physics_digest):
            raise StageCContractError("pairwise batch physics digest is invalid")
        payload = {
            "schema": "mcrl-v025-stagec-pairwise-batch-v1",
            "route": route,
            "shape": list(reference.shape),
            "reference": [[float_hex(v) for v in row] for row in reference],
            "candidate": [[float_hex(v) for v in row] for row in candidate],
            "targets": [float_hex(v) for v in targets],
            "row_identities": list(identities),
            "source_authority_sha256": source_authority_sha256,
            "source_identity": source_identity,
            "physics_digest": physics_digest,
            "zero_bootstrap": True,
        }
        return cls(
            route,
            reference,
            candidate,
            targets,
            identities,
            source_authority_sha256,
            source_identity,
            physics_digest,
            canonical_sha256(payload),
        )

    def neutral(
        self, definition: "NeutralSourceDefinition | None" = None
    ) -> "PairwiseBatch":
        if definition is not None and definition.route != self.route:
            raise StageCContractError("neutral source route disagrees with batch")
        return PairwiseBatch.create(
            self.route,
            self.reference_states,
            self.candidate_states,
            np.zeros_like(self.target_deltas),
            self.row_identities,
            self.source_authority_sha256,
            source_identity=(
                "neutral:legacy"
                if definition is None
                else f"neutral:{definition.digest}"
            ),
            physics_digest=self.physics_digest,
        )


def _route_state(row: SourceRow, route: Route) -> tuple[float, ...]:
    if route == "C1":
        return row.q1_state
    if route == "C2":
        return row.q2_state
    return (*row.q1_state, *row.q2_state)


def _route_label(row: SourceRow, route: Route) -> float:
    if route == "C3":
        # Compatibility-only build-1 synthetic batch.  Contract-v1 training
        # uses CoalitionBatch and never consumes a per-action C3 label.
        return 0.0
    field = {
        "C1": row.c1_label_normalized_hex,
        "C2": row.c2_label_normalized_hex,
    }[route]
    return parse_float_hex(field, field=f"{route}.normalized_label")


def build_pairwise_batches(shards: Sequence[SourceShard]) -> dict[Route, PairwiseBatch]:
    rows = tuple(row for shard in shards for row in shard.rows)
    physics = {row.physics_digest for row in rows}
    if len(physics) != 1:
        raise StageCContractError("pairwise source shards mix physics digests")
    physics_digest = next(iter(physics))
    source_authority_sha256 = canonical_sha256(
        {
            "schema": "mcrl-v025-stagec-source-authority-v1",
            "shards": [shard.file_sha256 for shard in shards],
            "authorities": sorted(
                {
                    (
                        row.code_digest,
                        row.physics_digest,
                        row.launch_digest,
                        row.catalogue_digest,
                        row.provider_digest,
                        row.archive_digest,
                        row.setting_digest,
                        row.calibration_digest,
                        row.allocation_manifest_digest,
                        row.q1_schema_sha256,
                        row.q2_schema_sha256,
                    )
                    for row in rows
                }
            ),
        }
    )
    groups: dict[tuple[str, str, int], list[SourceRow]] = {}
    for row in rows:
        groups.setdefault((row.world_id, row.anchor_id, row.user_id), []).append(row)
    by_route: dict[Route, PairwiseBatch] = {}
    for route in ROUTES:
        references: list[tuple[float, ...]] = []
        candidates: list[tuple[float, ...]] = []
        targets: list[float] = []
        identities: list[str] = []
        for key in sorted(groups):
            ordered = sorted(groups[key], key=lambda row: row.action_index)
            shared_mask = ordered[0].action_mask
            if any(row.action_mask != shared_mask for row in ordered):
                raise StageCContractError("user-anchor rows disagree on the legal mask")
            expected_indices = [
                index for index, enabled in enumerate(shared_mask) if enabled
            ]
            if [row.action_index for row in ordered] != expected_indices:
                raise StageCContractError("user-anchor rows do not cover each legal action once")
            if sum(row.null_action for row in ordered) != 1:
                raise StageCContractError("user-anchor requires exactly one legal null action")
            reference_rows = [row for row in ordered if row.reference_action]
            if len(reference_rows) != 1:
                raise StageCContractError("every user-anchor requires exactly one BASE row")
            reference = reference_rows[0]
            for candidate in ordered:
                if candidate.reference_action or not candidate.action_mask[candidate.action_index]:
                    continue
                references.append(_route_state(reference, route))
                candidates.append(_route_state(candidate, route))
                targets.append(_route_label(candidate, route) - _route_label(reference, route))
                identities.append(
                    f"{candidate.world_id}|{candidate.anchor_id}|{candidate.user_id}|{candidate.action_index}"
                )
        by_route[route] = PairwiseBatch.create(
            route,
            references,
            candidates,
            targets,
            identities,
            source_authority_sha256,
            physics_digest=physics_digest,
        )
    return by_route
"""Mechanism-aware coalition selection and exact higher-order diagnostics.

This module is deliberately independent of the pilot feature encoder.  It
operates on immutable action assignments and scalar evaluations of the sealed
objective; callers may attach whatever feature context their learner needs.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from fractions import Fraction
import itertools
import math
from functools import lru_cache
from typing import Callable, Hashable, Mapping, Sequence

import numpy as np

from mcrl.physics_v025.acm import rate_target_sinr
from mcrl.physics_v025.channel import scintillation_loss_db, shadow_sigma_db
from mcrl.physics_v025.constants_v025 import (
    BEAM_BANDWIDTH_HZ,
    RATE_TARGET_BPS,
    RICIAN_K_FACTOR_DB,
    SINR_MIN,
)


PAIR_CATALOGUE = "pair-catalogue"
OCCUPANCY_ACTIVATION = "occupancy-activation"
OCCUPANCY_2_DIMINISHING = "occupancy-2-diminishing"
AGGRESSOR_RELIEF = "aggressor-relief"
BEAM_EVACUATION = "beam-evacuation"
NESTED_SUBSETS = "nested-subsets"
FAMILIES = (
    PAIR_CATALOGUE,
    OCCUPANCY_ACTIVATION,
    OCCUPANCY_2_DIMINISHING,
    AGGRESSOR_RELIEF,
    BEAM_EVACUATION,
    NESTED_SUBSETS,
)

Action = Hashable
Assignment = Mapping[int, Action]

# The independently verified engine value quoted in the repair request.
Q10_AT_10_DEG = 0.42923539
_QUANTILE_SAMPLES = 65_536


@lru_cache(maxsize=1)
def _quantile_standard_draws() -> tuple[np.ndarray, np.ndarray]:
    """Fixed common draws used only as deterministic numerical quadrature."""

    rng = np.random.default_rng(0xC0A110)
    shadow_z = rng.standard_normal(_QUANTILE_SAMPLES)
    real_z = rng.standard_normal(_QUANTILE_SAMPLES)
    imaginary_z = rng.standard_normal(_QUANTILE_SAMPLES)
    k_linear = 10.0 ** (RICIAN_K_FACTOR_DB / 10.0)
    los = math.sqrt(k_linear / (k_linear + 1.0))
    rician_sigma = math.sqrt(1.0 / (2.0 * (k_linear + 1.0)))
    rician = (los + rician_sigma * real_z) ** 2 + (rician_sigma * imaginary_z) ** 2
    return shadow_z, rician


@lru_cache(maxsize=1)
def _product_quantile_table() -> tuple[np.ndarray, np.ndarray]:
    shadow_z, rician = _quantile_standard_draws()
    sigma_grid = np.linspace(0.0, 4.0, 401, dtype=np.float64)
    q10 = np.asarray([
        np.quantile(
            rician * np.power(10.0, -(sigma_db * shadow_z) / 10.0),
            0.10,
            method="linear",
        )
        for sigma_db in sigma_grid
    ])
    return sigma_grid, q10


def _raw_distribution_q10(elevation_deg: float) -> float:
    sigma_grid, q10_grid = _product_quantile_table()
    sigma_db = float(shadow_sigma_db(elevation_deg))
    loss_db = float(scintillation_loss_db(elevation_deg))
    product_q10 = float(np.interp(sigma_db, sigma_grid, q10_grid))
    return product_q10 * 10.0 ** (-loss_db / 10.0)


def engine_table_q10(elevation_deg: float) -> float:
    """Numerically evaluate the engine's Rician×shadow q10 at an elevation.

    Common deterministic draws integrate the full product distribution using
    the engine's K factor and its interpolated scintillation/shadow tables.
    A single multiplicative authentication factor makes the numerical rule
    reproduce the independently verified 10-degree value exactly.
    """

    elevation = float(elevation_deg)
    if not math.isfinite(elevation) or not -90.0 <= elevation <= 90.0:
        raise ValueError("elevation must be finite and in [-90,90] degrees")
    return Q10_AT_10_DEG * (
        _raw_distribution_q10(elevation) / _raw_distribution_q10(10.0)
    )


def occupancy_activation_audit(elevation_deg: float) -> dict[str, object]:
    """Compute the first occupancy whose q10-scaled target clears PHY."""

    q10 = engine_table_q10(elevation_deg)
    gamma = {
        occupancy: rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
        for occupancy in range(1, 7)
    }
    activating = next(
        (
            occupancy
            for occupancy, target in gamma.items()
            if target is not None and q10 * target >= SINR_MIN
        ),
        None,
    )
    return {
        "elevation_deg": float(elevation_deg),
        "q10": q10,
        "q10_method": "65536-common-draw full Rician-times-shadow product quantile with 0.01 dB sigma interpolation, authenticated at 10 degrees",
        "lowest_threshold": SINR_MIN,
        "gamma_by_occupancy": gamma,
        "first_activating_occupancy": activating,
    }


@dataclass(frozen=True, slots=True)
class CoalitionProposal:
    """A deterministic proposed action for a named mechanism family."""

    family: str
    selected_actions: tuple[tuple[int, Action], ...]
    mechanism_key: str
    metadata: Mapping[str, object] = field(default_factory=dict)

    def __post_init__(self) -> None:
        users = tuple(user for user, _action in self.selected_actions)
        if self.family not in FAMILIES:
            raise ValueError(f"unknown coalition family {self.family!r}")
        if not users or users != tuple(sorted(users)) or len(set(users)) != len(users):
            raise ValueError("proposal users must be nonempty, unique, and sorted")

    @property
    def users(self) -> tuple[int, ...]:
        return tuple(user for user, _action in self.selected_actions)

    def mapping(self, anchor: Assignment) -> dict[int, Action]:
        result = dict(anchor)
        for user, action in self.selected_actions:
            if result[user] == action:
                raise ValueError("coalition proposals must change every member action")
            result[user] = action
        return result


@dataclass(frozen=True, slots=True)
class ExactInteractionLabel:
    """Exact additive residual and its complete evaluation receipt."""

    users: tuple[int, ...]
    baseline: Fraction
    singleton_values: tuple[tuple[int, Fraction], ...]
    coalition_value: Fraction
    singleton_differences: tuple[tuple[int, Fraction], ...]
    objective_delta: Fraction
    psi: Fraction
    distinct_evaluation_count: int


def exact_interaction_label(
    *,
    anchor: Assignment,
    selected: Assignment,
    evaluate: Callable[[Mapping[int, Action]], Fraction],
) -> ExactInteractionLabel:
    """Evaluate baseline, every exact singleton, and the joint configuration.

    A size-k label necessarily authenticates k+2 distinct configurations.
    Learned singleton predictions are never accepted by this interface.
    """

    users = tuple(sorted(user for user in anchor if anchor[user] != selected[user]))
    if len(users) < 2:
        raise ValueError("interaction labels require at least two changed users")
    baseline = evaluate(anchor)
    singleton_values: list[tuple[int, Fraction]] = []
    identities = {tuple(sorted(anchor.items()))}
    for user in users:
        mapping = dict(anchor)
        mapping[user] = selected[user]
        identity = tuple(sorted(mapping.items()))
        if identity in identities:
            raise ValueError("singleton evaluation is not distinct from baseline")
        identities.add(identity)
        singleton_values.append((user, evaluate(mapping)))
    selected_identity = tuple(sorted(selected.items()))
    if selected_identity in identities:
        raise ValueError("coalition evaluation is not distinct from baseline/singletons")
    identities.add(selected_identity)
    coalition_value = evaluate(selected)
    singleton_differences = tuple(
        (user, value - baseline) for user, value in singleton_values
    )
    objective_delta = coalition_value - baseline
    psi = objective_delta - sum(
        (difference for _user, difference in singleton_differences), Fraction()
    )
    if len(identities) != len(users) + 2:
        raise AssertionError("exact interaction receipt lost a required evaluation")
    return ExactInteractionLabel(
        users=users,
        baseline=baseline,
        singleton_values=tuple(singleton_values),
        coalition_value=coalition_value,
        singleton_differences=singleton_differences,
        objective_delta=objective_delta,
        psi=psi,
        distinct_evaluation_count=len(identities),
    )


def exact_r3(
    *,
    anchor: Assignment,
    selected: Assignment,
    label: ExactInteractionLabel,
    evaluate: Callable[[Mapping[int, Action]], Fraction],
) -> tuple[Fraction, tuple[tuple[tuple[int, int], Fraction], ...]]:
    """Return R3(A)=Psi(A)-sum_{pairs in A} Psi(pair), exactly."""

    if len(label.users) < 3:
        raise ValueError("R3 is defined here only for coalitions of size >=3")
    singleton = dict(label.singleton_values)
    pair_terms: list[tuple[tuple[int, int], Fraction]] = []
    for first, second in itertools.combinations(label.users, 2):
        mapping = dict(anchor)
        mapping[first] = selected[first]
        mapping[second] = selected[second]
        pair_value = evaluate(mapping)
        pair_psi = (
            pair_value
            - label.baseline
            - (singleton[first] - label.baseline)
            - (singleton[second] - label.baseline)
        )
        pair_terms.append(((first, second), pair_psi))
    return (
        label.psi - sum((value for _pair, value in pair_terms), Fraction()),
        tuple(pair_terms),
    )


