+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Verify the EXACTTRAIN input gates without reading evaluation-only material."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from fractions import Fraction
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import random
+import resource
+import sys
+import time
+
+
