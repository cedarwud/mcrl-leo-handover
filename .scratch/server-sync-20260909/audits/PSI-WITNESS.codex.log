+SETTING = next(x for x in MATRIX_SETTINGS if x.label == 'a-r0')
+SEED = seed_from_domain(SYNTHETIC_WORLD_DOMAINS[0])
+TIMES = tuple(k * .640 for k in range(48))
+GROUND = np.array([6371., 0., 0.])
+
+def satellite(elevation=90., altitude=550., azimuth=0.):
