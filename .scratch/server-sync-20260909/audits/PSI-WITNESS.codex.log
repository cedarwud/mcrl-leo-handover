index 0000000000000000000000000000000000000000..846b55bf79f1a22f09ae4728e0347250b1d36bfc
--- /dev/null
+++ b/witness/run_witnesses.py
@@ -0,0 +1,32 @@
+"""Run the selected constructive tests; no threshold/price/seed fitting."""
+import json
+from engine_harness import *
+
+def scenarios():
+    beams={'X':(1,0,0,GROUND),'Y':(1,1,1,ground(0,5)),'Z':(1,2,2,ground(0,-5))}
+    for incumbents in (1,2):
+        world=World([GROUND]*(incumbents+2),{1:satellite(60)},beams)
+        anchor=['X']*incumbents+['Y','Z']
+        yield f'occupancy_backoff_{incumbents}_incumbent',world,anchor,{incumbents:'X',incumbents+1:'X'}
+        if incumbents==1:
+            yield 'occupancy_backoff_single',world,anchor,{incumbents:'X'}
+    world=World([GROUND]*13,{1:satellite(60)},beams)
+    yield 'occupancy_unload',world,['X']*7+['Y']*3+['Z']*3,{0:'Y',1:'Z'}
+    left,right=ground(0,-15),ground(0,15)
+    world=World([right,left,left,left,right,right],{1:satellite(60)}, {'X':(1,0,0,left),'Y':(1,1,1,right)})
+    yield 'swap',world,['X','X','X','Y','Y','Y'],{0:'Y',3:'X'}
+    world=World([GROUND]*5,{1:satellite(60)}, {'X':(1,0,0,ground(0,45)),'Y':(1,1,1,GROUND)})
+    yield 'cap_release',world,['X','X','Y','Y','Y'],{0:'Y',1:'Y'}
+
+def main():
+    output={}
+    for name,w,a,m in scenarios():
+        output[name]={}
+        for field in ('margin','realised'):
+            result=quartet(w,a,m,field,trace=True)
+            output[name][field]=result
+            print(name,field, 'Psi', result['psi'], 'Delta F', result['delta_F'], 'd',result['d'],'served',[r['served'] for r in result['evaluations'].values()],flush=True)
+    (ROOT/'witness/selected-witnesses.json').write_text(json.dumps(output,indent=2,allow_nan=False)+'\n')
+    (ROOT/'witness/calibration-manifest.json').write_text(CAL_PATH.read_text())
+
+if __name__=='__main__':main()
diff --git a/witness/verify_evidence.py b/witness/verify_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab51eb24b83cc5ab50774502b68d1c42afcbc302
--- /dev/null
+++ b/witness/verify_evidence.py
@@ -0,0 +1,45 @@
+"""Check recorded witnesses against their physical traces and exact scores."""
+from fractions import Fraction
+import json
+from pathlib import Path
+
+root=Path(__file__).resolve().parent
+data=json.loads((root/'selected-witnesses.json').read_text())
+for name,fields in data.items():
+    for field,r in fields.items():
+        e=r['evaluations']; users=list(r['moves'])
+        f0=Fraction(e['base']['F_exact']); fj=Fraction(e['joint']['F_exact'])
+        ds=[Fraction(v) for v in r['d_exact'].values()]
+        assert fj-f0-sum(ds)==Fraction(r['psi_exact'])
+        assert r['guard']['joint']
+        for row in e.values():
+            assert row['max_residual_w']<=1e-10
+            assert row['served']==sum(row['served_by_user'].values())
+            for boundary in row['boundaries']:
+                for slot in boundary['slots']:
+                    assert slot['certificate']['status']!='INVALID'
+                    for tx in slot['transmissions']:
+                        assert tx['interference_w']==0.0
+                        assert 0<tx['power_w']<=1.65
+                        assert tx['decoded']==(tx['tx'] is not None and tx['actual_sinr']>=tx['tx_threshold'])
+        if name not in ('occupancy_backoff_single','occupancy_backoff_2_incumbent'):
+            assert r['psi']>1e6
+        if name=='occupancy_backoff_single': assert r['psi_exact']=='0'
+        if name=='occupancy_backoff_1_incumbent':
+            assert [v['served'] for v in e.values()]==[0,0,0,3]
+            assert all(e[key]['bits']==0 for key in ('base','only_1','only_2'))
+            assert e['joint']['bits']>1.9e9
+            assert e['joint']['bits_by_user']['0']>0
+        if name=='swap':
+            assert all(d<0 for d in ds) and fj>f0
+            assert [v['served'] for v in e.values()]==[6,4,4,6]
+        if name=='cap_release':
+            assert [v['served'] for v in e.values()]==[3,4,4,5]
+            for key in ('base','only_0','only_1'):
+                for boundary in e[key]['boundaries']:
+                    for slot in boundary['slots']:
+                        source=[tx for tx in slot['transmissions'] if tx['beam']==[1,0]]
+                        assert len(source)==1
+                        assert source[0]['power_w']==1.65 and source[0]['tx'] is None
+            assert e['joint']['bits_by_user']['0']>0 and e['joint']['bits_by_user']['1']>0
+print('PASS: exact identities, decoded-bit traces, unchanged guard, cap persistence, zero-interference isolation, and all witness assertions')

