+    full=core+CAL.kappa_bits_per_user_step*phi
+    result=dict(assignments=assignments,bits=float(outcome.bits),joules=score.joules,phi_preference=float(phi),phi_cost_bits=float(-CAL.kappa_bits_per_user_step*phi),F_core=float(core),F=float(full),F_exact=str(full),served=sum(score.served_phy.values()),served_by_user=score.served_phy,bits_by_user=score.bits,decoding_time_s=score.decoding_time_s,feasible=score.rate_target_feasible,attained=score.rate_target_attained,max_residual_w=score.certificate_residual_w)
+    if trace:
+        result['boundaries']=[dict(time_s=row.time_s,slots=[dict(fraction=s.fraction,certificate=vars(s.certificate),transmissions=[dict(user=t.user_id,beam=t.beam,power_w=t.rf_power_w,nominal_sinr=t.nominal_sinr,margin_sinr=t.margin_predicted_sinr,actual_sinr=t.sinr,target=None if t.m_target is None else t.m_target.name,tx=None if t.m_tx is None else t.m_tx.name,tx_threshold=None if t.m_tx is None else t.m_tx.threshold_linear,decoded=t.realised_outcome.decoded,interference_w=t.interference_w) for t in s.transmissions]) for s in row.radiation.slots]) for row in (rows if field=='realised' else rows[:1])]
+    return outcome,result
+
+def quartet(world, anchor, moves, field='margin', trace=False):
+    users=tuple(moves); subsets=[frozenset(),*(frozenset([u]) for u in users),frozenset(users)]
+    outcomes={}; rows={}
+    for subset in dict.fromkeys(subsets):
+        a=list(anchor)
+        for u in subset:a[u]=moves[u]
+        key='base' if not subset else 'joint' if subset==frozenset(users) else f'only_{next(iter(subset))}'
+        outcomes[subset],rows[key]=evaluate(world,a,anchor,field,trace)
+    dec=set_score_decomposition(coalition_users=users,outcomes_by_subset=outcomes,**PRICES)
+    joint=rows['joint']; base=rows['base']
+    d={u:Fraction(rows['joint' if len(users)==1 else f'only_{u}']['F_exact'])-Fraction(base['F_exact']) for u in users}
+    psi=Fraction(joint['F_exact'])-Fraction(base['F_exact'])-sum(d.values())
+    assert psi==dec.interaction_bits
+    return dict(classification='DIAGNOSTIC_NOT_CLAIM',field=field,world=world.payload(),anchor=anchor,moves=moves,evaluations=rows,d={u:float(v) for u,v in d.items()},d_exact={u:str(v) for u,v in d.items()},psi=float(psi),psi_exact=str(psi),delta_F=joint['F']-base['F'],delta_core=float(dec.joint_change_bits),psi_bits=joint['bits']-sum(rows[f'only_{u}']['bits'] for u in users)+base['bits'] if len(users)==2 else 0,psi_joules=joint['joules']-sum(rows[f'only_{u}']['joules'] for u in users)+base['joules'] if len(users)==2 else 0,guard={key:r['served']>=base['served'] for key,r in rows.items()},c1=float(dec.c1),c3=float(dec.c3))
