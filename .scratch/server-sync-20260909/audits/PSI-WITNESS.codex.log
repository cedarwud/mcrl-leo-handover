+"""DIAGNOSTIC_NOT_CLAIM: synthetic geometry, unmodified stage-4h scoring."""
+from dataclasses import dataclass
+from fractions import Fraction
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+from mcrl.env.geometry import angle_between_deg
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.channel import transmit_gain_linear, interference_receive_gain_linear, keyed_fading_gain, fading_product_quantile
+from mcrl.physics_v025.architectures import Geometry, Link, RadiationConfig, AngleRateTPC_TDM
+from mcrl.physics_v025.adapter import RadiationBoundary, SharedArchitectureTape, score_setting
+from mcrl.physics_v025.energy import HardwareInventory
+from mcrl.physics_v025.matrix import MATRIX_SETTINGS
+from mcrl.physics_v025.tapes import seed_from_domain, SYNTHETIC_WORLD_DOMAINS
+from mcrl.physics_v025.targets import NetworkOutcome, network_objective, set_score_decomposition, classify_physical_transition, phi_qos
+from mcrl.physics_v025.calibration import CalibrationValues
+
+ROOT = Path(__file__).resolve().parents[1]
+CAL_PATH = Path('/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json')
+CAL = CalibrationValues.from_payload(json.loads(CAL_PATH.read_text())['cells'][0])
+PRICES = dict(eta_ref=CAL.eta_ref, lambda_bits_per_j=CAL.lambda_bits_per_j, kappa_bits_per_user_step=CAL.kappa_bits_per_user_step)
+SETTING = next(x for x in MATRIX_SETTINGS if x.label == 'a-r0')
+SEED = seed_from_domain(SYNTHETIC_WORLD_DOMAINS[0])
+TIMES = tuple(k * .640 for k in range(48))
+GROUND = np.array([6371., 0., 0.])
+
+def satellite(elevation=90., altitude=550., azimuth=0.):
+    e, a = math.radians(elevation), math.radians(azimuth)
+    slant = -6371. * math.sin(e) + math.sqrt((6371. + altitude)**2 - (6371. * math.cos(e))**2)
+    return GROUND + slant * np.array([math.sin(e), math.cos(e)*math.cos(a), math.cos(e)*math.sin(a)])
+
+def ground(y=0., z=0.):
+    return np.array([math.sqrt(6371.**2-y*y-z*z), y, z])
+
+@dataclass
+class World:
+    users: list
+    satellites: dict
+    beams: dict  # name -> (satellite ID, chain ID, reuse color, target ECEF km)
+
+    def payload(self):
+        return dict(users_ecef_km=[list(map(float,x)) for x in self.users], satellites_ecef_km={str(k):list(map(float,v)) for k,v in self.satellites.items()}, beams={k:dict(identity=list(v[:2]),color=v[2],target_ecef_km=list(map(float,v[3]))) for k,v in self.beams.items()}, seed=SEED, seed_domain=SYNTHETIC_WORLD_DOMAINS[0], times_s=TIMES)
+
+    def geometry(self, assignments, time=0.):
+        selected = [(u,self.beams[b]) for u,b in enumerate(assignments) if b is not None]
+        links=[]
+        def path(user, beam):
+            p=np.asarray(self.users[user]); s=np.asarray(self.satellites[beam[0]])
+            delta=s-p; slant=float(np.linalg.norm(delta))
+            elevation=float(np.degrees(np.arcsin(np.dot(delta,p/np.linalg.norm(p))/slant)))
+            off=float(angle_between_deg(s,np.asarray(beam[3]),p))
+            base=float(transmit_gain_linear(off)*LegacyWorldProvider._nominal_path_without_scintillation(np.asarray(slant),np.asarray(elevation),np.asarray(1.)))
+            fade=keyed_fading_gain(world=SEED,user=user,norad=beam[0],absolute_time_ns=round(time*1e9),elevation_deg=elevation)
+            return base,fade,elevation
+        for u,b in selected:
+            base,fade,elevation=path(u,b)
+            links.append(Link(u,b[:2],b[2],base*10**3.5,base*10**3.5*fade,elevation))
+        nominal=np.zeros((len(links),len(links))); realised=nominal.copy()
+        for i,(u,wanted) in enumerate(selected):
+            for j,(_,aggressor) in enumerate(selected):
+                base,fade,_=path(u,aggressor)
+                sep=float(angle_between_deg(np.asarray(self.users[u]),np.asarray(self.satellites[wanted[0]]),np.asarray(self.satellites[aggressor[0]])))
+                rx=float(interference_receive_gain_linear(sep,same_satellite=wanted[0]==aggressor[0]))
+                nominal[i,j]=base*rx; realised[i,j]=base*rx*fade
+        return Geometry(tuple(links),nominal,realised)
+
+def evaluate(world, assignments, anchor, field='margin', trace=False):
+    engine=AngleRateTPC_TDM(); config=RadiationConfig(fading_quantile_alpha=.10)
+    first=engine.radiate(config,world.geometry(assignments),'margin' if field=='margin' else field)
+    rows=tuple(RadiationBoundary(t, first if field!='realised' else engine.radiate(config,world.geometry(assignments,t),field)) for t in TIMES)
+    shared=SharedArchitectureTape('a-r',HardwareInventory.fixed([v[:2] for v in world.beams.values()]),rows,rows[0],tuple(range(len(world.users))))
+    score=score_setting(shared,SETTING)
+    assert score.valid
+    events=[classify_physical_transition(user_id=u,before=None if a is None else world.beams[a][:2],after=None if b is None else world.beams[b][:2],cell_rekey=False,was_previously_served=a is not None) for u,(a,b) in enumerate(zip(anchor,assignments))]
+    phi=phi_qos(events)
+    bits={u:Fraction(str(v)) for u,v in score.bits.items()}
+    outcome=NetworkOutcome.build(bits=sum(bits.values()),joules=score.joules,phi=phi,decoding_availability=sum(score.served_phy.values())/len(world.users),useful_availability=sum(score.served_phy.values())/len(world.users),per_user_bits=bits)
+    core=network_objective(outcome,**PRICES)
+    full=core+CAL.kappa_bits_per_user_step*phi
+    result=dict(assignments=assignments,bits=float(outcome.bits),joules=score.joules,phi_preference=float(phi),phi_cost_bits=float(-CAL.kappa_bits_per_user_step*phi),F_core=float(core),F=float(full),F_exact=str(full),served=sum(score.served_phy.values()),served_by_user=score.served_phy,bits_by_user=score.bits,decoding_time_s=score.decoding_time_s,feasible=score.rate_target_feasible,attained=score.rate_target_attained,max_residual_w=score.certificate_residual_w)
+    if trace:
+        result['boundaries']=[dict(time_s=row.time_s,slots=[dict(fraction=s.fraction,certificate=vars(s.certificate),transmissions=[dict(user=t.user_id,beam=t.beam,power_w=t.rf_power_w,nominal_sinr=t.nominal_sinr,margin_sinr=t.margin_predicted_sinr,actual_sinr=t.sinr,target=None if t.m_target is None else t.m_target.name,tx=None if t.m_tx is None else t.m_tx.name,tx_threshold=None if t.m_tx is None else t.m_tx.threshold_linear,decoded=t.realised_outcome.decoded,interference_w=t.interference_w) for t in s.transmissions]) for s in row.radiation.slots]) for row in (rows if field=='realised' else rows[:1])]
+    return outcome,result
+
+def quartet(world, anchor, moves, field='margin', trace=False):
+    users=tuple(moves); subsets=[frozenset(),*(frozenset([u]) for u in users),frozenset(users)]
+    outcomes={}; rows={}
+    for subset in dict.fromkeys(subsets):
+        a=list(anchor)
+        for u in subset:a[u]=moves[u]
+        key='base' if not subset else 'joint' if subset==frozenset(users) else f'only_{next(iter(subset))}'
+        outcomes[subset],rows[key]=evaluate(world,a,anchor,field,trace)
+    dec=set_score_decomposition(coalition_users=users,outcomes_by_subset=outcomes,**PRICES)
+    joint=rows['joint']; base=rows['base']
+    d={u:Fraction(rows['joint' if len(users)==1 else f'only_{u}']['F_exact'])-Fraction(base['F_exact']) for u in users}
+    psi=Fraction(joint['F_exact'])-Fraction(base['F_exact'])-sum(d.values())
+    assert psi==dec.interaction_bits
+    return dict(classification='DIAGNOSTIC_NOT_CLAIM',field=field,world=world.payload(),anchor=anchor,moves=moves,evaluations=rows,d={u:float(v) for u,v in d.items()},d_exact={u:str(v) for u,v in d.items()},psi=float(psi),psi_exact=str(psi),delta_F=joint['F']-base['F'],delta_core=float(dec.joint_change_bits),psi_bits=joint['bits']-sum(rows[f'only_{u}']['bits'] for u in users)+base['bits'] if len(users)==2 else 0,psi_joules=joint['joules']-sum(rows[f'only_{u}']['joules'] for u in users)+base['joules'] if len(users)==2 else 0,guard={key:r['served']>=base['served'] for key,r in rows.items()},c1=float(dec.c1),c3=float(dec.c3))

