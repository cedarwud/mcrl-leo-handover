+from mcrl.physics_v025.calibration import CalibrationValues
+
+ROOT = Path(__file__).resolve().parents[1]
+CAL_PATH = Path('/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json')
+CAL = CalibrationValues.from_payload(json.loads(CAL_PATH.read_text())['cells'][0])
+PRICES = dict(eta_ref=CAL.eta_ref, lambda_bits_per_j=CAL.lambda_bits_per_j, kappa_bits_per_user_step=CAL.kappa_bits_per_user_step)
+SETTING = next(x for x in MATRIX_SETTINGS if x.label == 'a-r0')
+SEED = seed_from_domain(SYNTHETIC_WORLD_DOMAINS[0])
+TIMES = tuple(k * .640 for k in range(48))
+GROUND = np.array([6371., 0., 0.])
+
+def satellite(elevation=90., altitude=550., azimuth=0.):
+    e, a = math.radians(elevation), math.radians(azimuth)
+    slant = -6371. * math.sin(e) + math.sqrt((6371. + altitude)**2 - (6371. * math.cos(e))**2)
+    return GROUND + slant * np.array([math.sin(e), math.cos(e)*math.cos(a), math.cos(e)*math.sin(a)])
+
+def ground(y=0., z=0.):
+    return np.array([math.sqrt(6371.**2-y*y-z*z), y, z])
+
+@dataclass
+class World:
+    users: list
+    satellites: dict
+    beams: dict  # name -> (satellite ID, chain ID, reuse color, target ECEF km)
+
+    def payload(self):
+        return dict(users_ecef_km=[list(map(float,x)) for x in self.users], satellites_ecef_km={str(k):list(map(float,v)) for k,v in self.satellites.items()}, beams={k:dict(identity=list(v[:2]),color=v[2],target_ecef_km=list(map(float,v[3]))) for k,v in self.beams.items()}, seed=SEED, seed_domain=SYNTHETIC_WORLD_DOMAINS[0], times_s=TIMES)
+
+    def geometry(self, assignments, time=0.):
+        selected = [(u,self.beams[b]) for u,b in enumerate(assignments) if b is not None]
+        links=[]
+        def path(user, beam):
+            p=np.asarray(self.users[user]); s=np.asarray(self.satellites[beam[0]])
+            delta=s-p; slant=float(np.linalg.norm(delta))
+            elevation=float(np.degrees(np.arcsin(np.dot(delta,p/np.linalg.norm(p))/slant)))
+            off=float(angle_between_deg(s,np.asarray(beam[3]),p))
+            base=float(transmit_gain_linear(off)*LegacyWorldProvider._nominal_path_without_scintillation(np.asarray(slant),np.asarray(elevation),np.asarray(1.)))
+            fade=keyed_fading_gain(world=SEED,user=user,norad=beam[0],absolute_time_ns=round(time*1e9),elevation_deg=elevation)
+            return base,fade,elevation
+        for u,b in selected:
+            base,fade,elevation=path(u,b)
+            links.append(Link(u,b[:2],b[2],base*10**3.5,base*10**3.5*fade,elevation))
+        nominal=np.zeros((len(links),len(links))); realised=nominal.copy()
+        for i,(u,wanted) in enumerate(selected):
+            for j,(_,aggressor) in enumerate(selected):
+                base,fade,_=path(u,aggressor)
+                sep=float(angle_between_deg(np.asarray(self.users[u]),np.asarray(self.satellites[wanted[0]]),np.asarray(self.satellites[aggressor[0]])))
+                rx=float(interference_receive_gain_linear(sep,same_satellite=wanted[0]==aggressor[0]))
