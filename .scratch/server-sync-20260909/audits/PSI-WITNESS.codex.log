"""Independent conformance checks for the sealed stage-4h amendments."""

from __future__ import annotations

from fractions import Fraction
import importlib.util
import itertools
import math
from pathlib import Path
import sys

import numpy as np

from mcrl.physics_v025.acm import ACM_MODES, ACMRate
from mcrl.physics_v025.architectures import (
    AngleRateTPC_TDM,
    AngleTPC_TDM,
    Geometry,
    Link,
    RadiationConfig,
)
from mcrl.physics_v025.channel import (
    FADING_QUANTILE_DERIVATION_DOMAIN,
    FADING_QUANTILE_DRAWS,
    fading_product_quantile,
    fading_quantile_derivation_seed,
    noise_power_w,
)
from mcrl.physics_v025.constants_v025 import (
    BEAM_BANDWIDTH_HZ,
    RICIAN_K_FACTOR_DB,
    SCINTILLATION_ELEVATION_DEG,
    SCINTILLATION_LOSS_DB,
    SHADOW_SIGMA_DB,
    SHADOW_SIGMA_ELEVATION_DEG,
)
from mcrl.physics_v025.energy import HardwareInventory
from mcrl.physics_v025.resolution import resolve_configuration
from mcrl.physics_v025.targets import NetworkOutcome, set_score_decomposition


REPO = Path(__file__).resolve().parents[2]
RUNNER = REPO / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"


def _load_runner(name: str):
    spec = importlib.util.spec_from_file_location(name, RUNNER)
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def _direct_fading_quantile(elevation_deg: float, alpha: float) -> float:
    """Independent transcription of the sealed 200,000-draw procedure."""

    assert FADING_QUANTILE_DRAWS == 200_000
    assert FADING_QUANTILE_DERIVATION_DOMAIN == "V025_FADING_PRODUCT_QUANTILE/v1"
    elevation_bin = math.floor(elevation_deg / 0.5 + 0.5) * 0.5
    rng = np.random.default_rng(
        fading_quantile_derivation_seed(elevation_bin, alpha)
    )
    sigma_db = float(
        np.interp(
            elevation_bin, SHADOW_SIGMA_ELEVATION_DEG, SHADOW_SIGMA_DB
        )
    )
    scintillation_db = float(
        np.interp(
            elevation_bin,
            SCINTILLATION_ELEVATION_DEG,
            SCINTILLATION_LOSS_DB,
        )
    )
    shadow_db = sigma_db * rng.standard_normal(200_000)
    k = 10.0 ** (RICIAN_K_FACTOR_DB / 10.0)
    los = math.sqrt(k / (k + 1.0))
    component_sigma = math.sqrt(1.0 / (2.0 * (k + 1.0)))
    real = los + component_sigma * rng.standard_normal(200_000)
    imaginary = component_sigma * rng.standard_normal(200_000)
    product = (real**2 + imaginary**2) * 10.0 ** (
        -(shadow_db + scintillation_db) / 10.0
    )
    return float(np.quantile(product, alpha, method="linear"))


def test_cached_complete_fading_quantile_matches_direct_procedure() -> None:
    for elevation, alpha in ((10.24, 0.05), (31.26, 0.10), (89.9, 0.25)):
        cached = fading_product_quantile(elevation, alpha)
        direct = _direct_fading_quantile(elevation, alpha)
        assert cached == pytest.approx(direct, rel=1.0e-3)


def test_margin_changes_only_wanted_prediction_not_power_or_interference() -> None:
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    direct = 20.0 * noise
    links = (
        Link(0, (1, 1), 0, direct, direct, 30.0),
        Link(1, (2, 1), 0, direct, direct, 30.0),
    )
    cross = np.asarray([[0.0, direct * 0.01], [direct * 0.02, 0.0]])
    geometry = Geometry(links, cross, cross * 7.0)
    config = RadiationConfig(fading_quantile_alpha=0.10)
    nominal = AngleTPC_TDM().radiate(config, geometry, "nominal")
    margin = AngleTPC_TDM().radiate(config, geometry, "margin")
    assert [slot.beam_rf_w for slot in nominal.slots] == [
        slot.beam_rf_w for slot in margin.slots
    ]
    for nominal_slot, margin_slot in zip(nominal.slots, margin.slots, strict=True):
        for nominal_tx, margin_tx in zip(
            nominal_slot.transmissions, margin_slot.transmissions, strict=True
        ):
            assert margin_tx.nominal_sinr == nominal_tx.nominal_sinr
            assert margin_tx.intra_interference_w == nominal_tx.intra_interference_w
            assert margin_tx.inter_interference_w == nominal_tx.inter_interference_w
            assert margin_tx.margin_predicted_sinr < margin_tx.nominal_sinr


def test_acm_records_target_transmitted_mode_and_realised_outage_separately() -> None:
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    links = tuple(
        Link(user, (1, 1), user, 40.0 * noise, 0.01 * noise, 90.0)
        for user in range(4)
    )
    result = resolve_configuration(
        AngleRateTPC_TDM(),
        RadiationConfig(fading_quantile_alpha=0.10),
        Geometry(links, np.zeros((4, 4)), np.zeros((4, 4))),
        ACMRate(),
        HardwareInventory.fixed(((1, 1),)),
        duration_s=1.0,
        field="realised",
    )
    transmissions = [tx for slot in result.radiation.slots for tx in slot.transmissions]
    assert transmissions
    assert all(tx.m_target is not None and tx.m_tx is not None for tx in transmissions)
    assert all(tx.m_target != tx.m_tx for tx in transmissions)
    assert all(not tx.realised_outcome.decoded for tx in transmissions)
    assert all(tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz == 0.0 for tx in transmissions)
    assert result.bits == {user: 0.0 for user in range(4)}


def test_every_arm_uses_its_declared_primary_key_and_c2_only_breaks_ties() -> None:
    runner = _load_runner("v025_stage4h_arm_keys")
    catalog = tuple(
        runner.Configuration(name, ((0, None),), 0, "kat")
        for name in ("x", "y", "z")
    )
    factors = {
        "x": {"C1": Fraction(10), "C2": Fraction(0), "C3": Fraction(0)},
        "y": {"C1": Fraction(0), "C2": Fraction(1000), "C3": Fraction(9)},
        "z": {"C1": Fraction(5), "C2": Fraction(-100), "C3": Fraction(5)},
    }
    expected = {"FULL": "x", "DROP_C1": "y", "DROP_C2": "x", "DROP_C3": "x"}
    for arm, components in runner.ARM_PRIMARY_COMPONENTS.items():
        ranked = runner._rank_for_arm(
            catalog=catalog,
            factors=factors,
            primary_names=components,
            use_c2=arm != "DROP_C2",
        )
        assert ranked[0].configuration_id == expected[arm]
    # C2's huge value on y cannot displace FULL's unique immediate maximiser.
    assert runner._set_score_select(
        catalog=catalog, factors=factors, include=("C1", "C2", "C3")
    ).configuration_id == "x"


def test_large_set_keeps_exact_interaction_but_omits_shapley_split() -> None:
    users = tuple(range(5))
    def outcome(bits: int) -> NetworkOutcome:
        return NetworkOutcome.build(
            bits=bits,
            joules=100,
            phi=0,
            decoding_availability=1,
            useful_availability=1,
        )

    subsets = {frozenset(): outcome(100)}
    for user in users:
        subsets[frozenset((user,))] = outcome(101)
    subsets[frozenset(users)] = outcome(150)
    result = set_score_decomposition(
        coalition_users=users,
        outcomes_by_subset=subsets,
        lambda_bits_per_j=1,
        eta_ref=1,
        kappa_bits_per_user_step=1,
    )
    assert result.interaction_bits == 45
    assert result.shapley_interaction_by_user == ()
    assert result.credit_split == "NOT_COMPUTED_LARGE_SET"


def test_admission_truth_table_is_complete_and_monotone() -> None:
    runner = _load_runner("v025_stage4h_admission")
    rows = runner.admission_truth_table()
    assert len(rows) == 8
    decisions = {
        (
            row["common_certificates_pass"],
            row["c3_choice_nontrivial"],
            row["c3_realised_contrast_positive"],
        ): row["decision"]
        for row in rows
    }
    assert decisions[(False, False, False)] == "NOT_ADMITTED"
    assert decisions[(True, False, False)] == "ADMIT_C1C2"
    assert decisions[(True, True, True)] == "ADMIT_FULL"
    assert all(
        decisions[(False, choice, positive)] == "NOT_ADMITTED"
        for choice, positive in itertools.product((False, True), repeat=2)
    )


