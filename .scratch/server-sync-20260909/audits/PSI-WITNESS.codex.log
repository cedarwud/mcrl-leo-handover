@@ -0,0 +1,32 @@
+"""Run the selected constructive tests; no threshold/price/seed fitting."""
+import json
+from engine_harness import *
+
+def scenarios():
+    beams={'X':(1,0,0,GROUND),'Y':(1,1,1,ground(0,5)),'Z':(1,2,2,ground(0,-5))}
+    for incumbents in (1,2):
+        world=World([GROUND]*(incumbents+2),{1:satellite(60)},beams)
+        anchor=['X']*incumbents+['Y','Z']
+        yield f'occupancy_backoff_{incumbents}_incumbent',world,anchor,{incumbents:'X',incumbents+1:'X'}
+        if incumbents==1:
+            yield 'occupancy_backoff_single',world,anchor,{incumbents:'X'}
+    world=World([GROUND]*13,{1:satellite(60)},beams)
+    yield 'occupancy_unload',world,['X']*7+['Y']*3+['Z']*3,{0:'Y',1:'Z'}
+    left,right=ground(0,-15),ground(0,15)
+    world=World([right,left,left,left,right,right],{1:satellite(60)}, {'X':(1,0,0,left),'Y':(1,1,1,right)})
+    yield 'swap',world,['X','X','X','Y','Y','Y'],{0:'Y',3:'X'}
+    world=World([GROUND]*5,{1:satellite(60)}, {'X':(1,0,0,ground(0,45)),'Y':(1,1,1,GROUND)})
+    yield 'cap_release',world,['X','X','Y','Y','Y'],{0:'Y',1:'Y'}
+
+def main():
+    output={}
+    for name,w,a,m in scenarios():
+        output[name]={}
+        for field in ('margin','realised'):
+            result=quartet(w,a,m,field,trace=True)
+            output[name][field]=result
+            print(name,field, 'Psi', result['psi'], 'Delta F', result['delta_F'], 'd',result['d'],'served',[r['served'] for r in result['evaluations'].values()],flush=True)
+    (ROOT/'witness/selected-witnesses.json').write_text(json.dumps(output,indent=2,allow_nan=False)+'\n')
+    (ROOT/'witness/calibration-manifest.json').write_text(CAL_PATH.read_text())
+
+if __name__=='__main__':main()

