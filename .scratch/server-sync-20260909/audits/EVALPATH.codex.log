   274	def _pilot_calibration(tape, setting, run_setting) -> PilotCalibration:
   275	    base = ENGINE._base_configuration(tape, 0, "nearest-eligible")
   276	    evaluator = ENGINE.StepEvaluator(
   277	        tape,
   278	        setting,
   279	        0,
   280	        transition_from=base,
   281	        field="realised",
   282	        run_setting=run_setting,
   283	    )
   284	    profile = evaluator.evaluate(base)
   285	    bits = Fraction(str(profile.bits))
   286	    joules = Fraction(str(profile.joules))
   287	    if bits <= 0 or joules <= 0:
   288	        raise RuntimeError("pilot calibration proxy has a nonpositive endpoint")
   289	    return PilotCalibration(
   290	        eta_ref=bits / joules,
   291	        lambda_bits_per_j=bits / joules,
   292	        kappa_bits_per_user_step=bits / len(tape.user_layout),
   293	        bits_ref=bits,
   294	        joules_ref=joules,
   295	        users=len(tape.user_layout),
   296	    )
