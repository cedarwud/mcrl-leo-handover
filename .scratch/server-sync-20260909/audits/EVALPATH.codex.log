diff --git a/.scratch/eval-path/repro_eval_path.py b/.scratch/eval-path/repro_eval_path.py
new file mode 100644
index 0000000000000000000000000000000000000000..3062eb6441dd0cc393107c9379252fea8e21530f
--- /dev/null
+++ b/.scratch/eval-path/repro_eval_path.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Differential harness for StepEvaluator scalar vs dense a-r0 paths."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+
+ROOT = Path(__file__).resolve().parents[2]
+ENGINE_PATH = ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+
+
+def load_engine():
+    name = "eval_path_matrix_engine"
+    spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {ENGINE_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def evaluator(engine, tape, setting, run_setting, step_index, incumbent, *, boundaries, field):
+    return engine.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=engine._rekeyed_users(tape, step_index),
+        field=field,
+        run_setting=run_setting,
+        boundary_indices=boundaries,
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--smoke", action="store_true")
+    parser.add_argument("--field", choices=("nominal", "realised"), default="nominal")
+    parser.add_argument("--boundary-zero", action="store_true")
+    args = parser.parse_args()
+    engine = load_engine()
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="eval-path-forensics"),
+        steps=1 if args.smoke else 4,
+        start_time_s=0.0,
+    )
+    setting = engine._setting("a-r0")
+    run_setting = engine.run_setting_for("a-r0")
+    base = engine._base_configuration(tape, 0, engine.REFERENCE_CARRIERS[0])
+    configs = [base]
+    if args.smoke:
+        catalogue, _ = engine._catalogue_with_census(
+            tape, 0, base, setting=setting, calibration=None, run_setting=run_setting
+        )
+        configs.append(next(row for row in catalogue if row.changed_users == 1))
+    rows = []
+    boundaries = (0,) if args.boundary_zero else tuple(range(48))
+    for config in configs:
+        scalar = evaluator(
+            engine, tape, setting, run_setting, 0, base,
+            boundaries=boundaries, field=args.field,
+        )
+        batch = evaluator(
+            engine, tape, setting, run_setting, 0, base,
+            boundaries=boundaries, field=args.field,
+        )
+        started = time.perf_counter()
+        scalar_profile = scalar.evaluate(config)
+        scalar_s = time.perf_counter() - started
+        started = time.perf_counter()
+        batch.evaluate_many((config,))
+        batch_s = time.perf_counter() - started
+        batch_profile = batch.evaluate(config)
+        rows.append({
+            "configuration_id": config.configuration_id,
+            "changed_users": config.changed_users,
+            "same_object_id": id(config),
+            "scalar_s": scalar_s,
+            "batch_s": batch_s,
+            "scalar_bits": scalar_profile.bits,
+            "batch_bits": batch_profile.bits,
+            "bits_difference_batch_minus_scalar": batch_profile.bits - scalar_profile.bits,
+            "scalar_joules": scalar_profile.joules,
+            "batch_joules": batch_profile.joules,
+            "joules_difference_batch_minus_scalar": batch_profile.joules - scalar_profile.joules,
+            "per_user_differences": {
+                str(user): batch_profile.score.bits[user] - scalar_profile.score.bits[user]
+                for user in scalar_profile.score.bits
+            },
+            "binary64_agreement": (
+                scalar_profile.bits == batch_profile.bits
+                and scalar_profile.joules == batch_profile.joules
+                and scalar_profile.score.bits == batch_profile.score.bits
+            ),
+        })
+    print(json.dumps(rows, sort_keys=True))
+    return 0 if all(row["binary64_agreement"] for row in rows) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
