/bin/bash -lc 'env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/eval-path/repro_eval_path.py --smoke' in /home/sat/mcrl-v025-probe-ws
