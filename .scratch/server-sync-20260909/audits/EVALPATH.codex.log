   324	@dataclass(frozen=True)
   325	class PrimitiveBoundary:
   326	    absolute_time_s: float
   327	    candidates: tuple[PrimitiveCandidate, ...]
   328	    cell_rekeyed_users: tuple[int, ...] = ()
   329	
   330	    def __post_init__(self) -> None:
   450	            for index, identity in enumerate(self.aggressor_identities)
   451	        }
   452	
   453	    def _cross(self, boundary_index: int, victim_row: int, aggressor: BeamIdentity) -> tuple[float, float]:
   454	        aggressor_index = self._aggressor_index().get(aggressor)
   455	        if aggressor_index is None:
   456	            return 0.0, 0.0
   457	        return self._cross_at_index(boundary_index, victim_row, aggressor_index)
   458	
   459	    def _cross_at_index(
   460	        self, boundary_index: int, victim_row: int, aggressor_index: int
   461	    ) -> tuple[float, float]:
   462	        aggressor = tuple(
   463	            int(value) for value in self.aggressor_identities[aggressor_index]
   464	        )
   465	        if tuple(int(value) for value in self.identities[victim_row]) == aggressor:
   466	            return 0.0, 0.0
   467	        if int(self.colors[victim_row]) != int(self.aggressor_colors[aggressor_index]):
   468	            return 0.0, 0.0
   469	        user = int(self.row_user_column[victim_row])
   470	        wanted_slot = int(self.row_wanted_slot[victim_row])
   471	        satellite = int(self.aggressor_satellite_column[aggressor_index])
   472	        nominal = float(
   473	            self.cross_base_nominal[boundary_index, user, aggressor_index]
   474	            * self.receive_gain_by_wanted_slot[boundary_index, user, wanted_slot, satellite]
   475	        )
   476	        realised = nominal * float(self.fading_by_satellite[boundary_index, user, satellite])
   477	        return nominal, realised
   478	
   479	    def boundary_view(self, boundary_index: int) -> PrimitiveBoundary:
   480	        """Materialise the expensive object view only for audit/KAT callers."""
   481	
   482	        if type(boundary_index) is not int or not 0 <= boundary_index < len(self):
   483	            raise MCRLContractError("boundary index must be in 0..47")
   484	        aggressors = [
   485	            (int(identity[0]), int(identity[1]))
   486	            for identity in self.aggressor_identities
   487	        ]
   488	        rows: list[PrimitiveCandidate] = []
   489	        for row, raw_identity in enumerate(self.identities):
   490	            identity = (int(raw_identity[0]), int(raw_identity[1]))
   491	            nominal_identity = []
   492	            realised_identity = []
   493	            for aggressor_index, aggressor in enumerate(aggressors):
   494	                if aggressor == identity or int(self.aggressor_colors[aggressor_index]) != int(self.colors[row]):
   495	                    continue
   496	                nominal, realised = self._cross(boundary_index, row, aggressor)
   497	                nominal_identity.append((aggressor, nominal))
   498	                realised_identity.append((aggressor, realised))
   499	            # Compatibility view: NORAD-only maps cannot represent multiple
   500	            # beams, so aggregate all emitted physical terms by NORAD.
   501	            nominal_norad: dict[int, float] = {}
   502	            realised_norad: dict[int, float] = {}
   503	            for (norad, _cell), gain in nominal_identity:
   504	                nominal_norad[norad] = nominal_norad.get(norad, 0.0) + gain
   505	            for (norad, _cell), gain in realised_identity:
   506	                realised_norad[norad] = realised_norad.get(norad, 0.0) + gain
   507	            rows.append(
   508	                PrimitiveCandidate(
   509	                    user_id=int(self.users[int(self.row_user_column[row])]),
   510	                    identity=identity,
   511	                    color=int(self.colors[row]),
   512	                    elevation_deg=float(self.elevations_deg[boundary_index, row]),
   513	                    d2_entry_elevation_deg=float(self.d2_entry_elevations_deg[boundary_index, row]),
   514	                    slant_km=float(self.slants_km[boundary_index, row]),
   515	                    d2_distance_km=float(self.d2_distances_km[boundary_index, row]),
   516	                    visible=bool(self.visible[boundary_index, row]),
   517	                    d2_eligible=bool(self.d2_eligible[boundary_index, row]),
   518	                    nominal_gain=float(self.nominal_gain[boundary_index, row]),
   519	                    realised_gain=float(self.realised_gain[boundary_index, row]),
   520	                    nominal_cross_gain_by_norad=tuple(sorted(nominal_norad.items())),
   521	                    realised_cross_gain_by_norad=tuple(sorted(realised_norad.items())),
   522	                    remaining_visibility_s=float(self.remaining_visibility_s[boundary_index, row]),
   523	                    remaining_d2_s=float(self.remaining_d2_s[boundary_index, row]),
   524	                    cell_reachable=bool(self.cell_reachable[boundary_index, row]),
   525	                    nominal_cross_gain_by_identity=tuple(nominal_identity),
   526	                    realised_cross_gain_by_identity=tuple(realised_identity),
   527	                    visibility_right_censored=bool(self.visibility_right_censored[boundary_index, row]),
   528	                    d2_right_censored=bool(self.d2_right_censored[boundary_index, row]),
   529	                )
   530	            )
   531	        return PrimitiveBoundary(float(self.absolute_time_s[boundary_index]), tuple(rows))
   532	
   533	    def geometry_at(
   534	        self,
   535	        *,
   536	        boundary_index: int,
   537	        assignments: Mapping[int, BeamIdentity | None],
   538	    ) -> Geometry:
   539	        """Build selected geometry directly from arrays and physical keys."""
   540	
   541	        row_of = self._row_index()
   542	        selected: list[int] = []
   543	        identities: list[BeamIdentity] = []
   544	        for user in sorted(assignments):
   545	            identity = assignments[user]
   546	            if identity is None:
   547	                continue
   548	            try:
   549	                row = row_of[(user, identity)]
   550	            except KeyError:
   551	                raise MCRLContractError("assignment is absent from the exogenous tape") from None
   552	            legal_now = (
   553	                bool(self.visible[boundary_index, row])
   554	                and bool(self.d2_eligible[boundary_index, row])
   555	                and bool(self.cell_reachable[boundary_index, row])
   556	            )
   557	            if boundary_index == 0 and not legal_now:
   558	                raise MCRLContractError("assignment is not legal at the decision instant")
   559	            if not legal_now:
   560	                # Live in-step legality: the chain stops radiating and decoding
   561	                # at the first boundary where either physical mask is lost.
   562	                continue
   563	            selected.append(row)
   564	            identities.append(identity)
   565	        aggressor_of = self._aggressor_index()
   566	        victim_rows = np.asarray(selected, dtype=np.int64)
   567	        physical_columns = np.asarray(
   568	            [aggressor_of.get(identity, -1) for identity in identities],
   569	            dtype=np.int64,
   570	        )
   571	        nominal_cross = np.zeros((len(selected), len(selected)), dtype=np.float64)
   572	        realised_cross = np.zeros_like(nominal_cross)
   573	        valid_columns = physical_columns >= 0
   574	        if victim_rows.size and np.any(valid_columns):
   575	            users = self.row_user_column[victim_rows]
   576	            wanted_slots = self.row_wanted_slot[victim_rows]
   577	            physical = physical_columns[valid_columns]
   578	            satellites = self.aggressor_satellite_column[physical]
   579	            base_cross = self.cross_base_nominal[
   580	                boundary_index,
   581	                users[:, None],
   582	                physical[None, :],
   583	            ]
   584	            receive = self.receive_gain_by_wanted_slot[
   585	                boundary_index,
   586	                users[:, None],
   587	                wanted_slots[:, None],
   588	                satellites[None, :],
   589	            ]
   590	            block = base_cross * receive
   591	            color_mask = (
   592	                self.colors[victim_rows, None]
   593	                == self.aggressor_colors[physical][None, :]
   594	            )
   595	            identity_mask = (
   596	                self.identities[victim_rows, None, :]
   597	                != self.aggressor_identities[physical][None, :, :]
   598	            ).any(axis=2)
   599	            block = np.where(color_mask & identity_mask, block, 0.0)
   600	            nominal_cross[:, valid_columns] = block
   601	            realised_cross[:, valid_columns] = block * self.fading_by_satellite[
   602	                boundary_index,
   603	                users[:, None],
   604	                satellites[None, :],
   605	            ]
   606	        return Geometry(
   607	            tuple(
   608	                Link(
   609	                    int(self.users[int(self.row_user_column[row])]),
   610	                    identities[index],
   611	                    int(self.colors[row]),
   612	                    float(self.nominal_gain[boundary_index, row]),
   613	                    float(self.realised_gain[boundary_index, row]),
   614	                )
   615	                for index, row in enumerate(selected)
   616	            ),
   617	            nominal_cross,
   618	            realised_cross,
   619	        )
   620	
