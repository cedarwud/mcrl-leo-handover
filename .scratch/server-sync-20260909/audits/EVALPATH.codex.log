  1503	def _select_for_anchor(
  1504	    anchor_name, anchor, catalogue, exact, models, rows_by_user_action,
  1505	    tape, step_index, exact_s0,
  1506	):
  1507	    selections = {}
  1508	    diagnostics = {}
  1509	    legal_catalogue = [row for row in catalogue if row.configuration_id in exact]
  1510	    contexts = {}
  1511	    for config in legal_catalogue:
  1512	        if len(exact[config.configuration_id]["changed"]) >= 2:
  1513	            contexts[config.configuration_id] = _coalition_context(
  1514	                tape=tape, step_index=step_index, anchor=anchor,
  1515	                selected=config, rows_by_user_action=rows_by_user_action,
  1516	            )
  1517	    for seed in LEARNER_SEEDS:
  1518	        exact_scores = []
  1519	        additive_scores = []
  1520	        learned_scores_by_arm = {arm: [] for arm in PILOT_ARMS}
  1521	        deltas_by_arm = {}
  1522	        c2_tie_pairs = 0
  1523	        c2_eligible_pairs = 0
  1524	        for arm in PILOT_ARMS:
  1525	            model = models[(seed, arm)]
  1526	            deltas = {}
  1527	            for (user, action), row in rows_by_user_action.items():
  1528	                reference = rows_by_user_action[(user, anchor.mapping[user])]
  1529	                q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
  1530	                deltas[(user, action)] = (
  1531	                    model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
  1532	                    + q2_delta
  1533	                )
  1534	                if arm == "FULL" and action != anchor.mapping[user]:
  1535	                    c2_eligible_pairs += 1
  1536	                    c2_tie_pairs += int(q2_delta == 0.0)
  1537	            deltas_by_arm[arm] = deltas
  1538	        c2_tie_fraction = (
  1539	            c2_tie_pairs / c2_eligible_pairs if c2_eligible_pairs else None
  1540	        )
  1541	        for config in legal_catalogue:
  1542	            context = contexts.get(config.configuration_id)
  1543	            full_additive = math.fsum(
  1544	                deltas_by_arm["FULL"][(user, config.mapping[user])]
  1545	                for user in anchor.mapping
  1546	            )
  1547	            exact_scores.append((full_additive + exact[config.configuration_id]["psi"], config.configuration_id, config))
  1548	            additive_scores.append((full_additive, config.configuration_id, config))
  1549	            for arm in PILOT_ARMS:
  1550	                model = models[(seed, arm)]
  1551	                score = math.fsum(
  1552	                    deltas_by_arm[arm][(user, config.mapping[user])]
  1553	                    for user in anchor.mapping
  1554	                )
  1555	                if context is not None:
  1556	                    score += model.interaction(context)
  1557	                learned_scores_by_arm[arm].append((score, config.configuration_id, config))
  1558	        exact_choice = min(exact_scores, key=lambda row: (-row[0], row[1]))[2]
  1559	        additive_choice = min(additive_scores, key=lambda row: (-row[0], row[1]))[2]
  1560	        selections[(seed, "S0")] = exact_s0
  1561	        for arm in PILOT_ARMS:
  1562	            selections[(seed, arm)] = min(
  1563	                learned_scores_by_arm[arm], key=lambda row: (-row[0], row[1])
  1564	            )[2]
  1565	        diagnostics[seed] = {
  1566	            "top_choice_agreement": selections[(seed, "FULL")].assignments == exact_choice.assignments,
  1567	            "additive_choice": additive_choice,
  1568	            "exact_choice": exact_choice,
  1569	            "anchor": anchor_name,
  1570	            # Minimal-pilot C2 tie statistic: over the FULL arm, the fraction of
  1571	            # non-incumbent (user, action) candidates whose C2 head score is
  1572	            # exactly equal to the incumbent's, i.e. C2 cannot discriminate the
  1573	            # move at all and the ranking falls through to C1 + the tie-break.
  1574	            "c2_tie": c2_tie_fraction,
  1575	            "c2_tie_pairs": c2_tie_pairs,
  1576	            "c2_eligible_pairs": c2_eligible_pairs,
  1577	        }
  1578	    return selections, diagnostics
  1579	
