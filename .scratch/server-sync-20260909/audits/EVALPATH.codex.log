  1328	def _exact_interactions(anchor, incumbent, catalogue, evaluator, calibration):
  1329	    evaluator.evaluate_many(catalogue)
  1330	    base_profile = evaluator.evaluate(anchor)
  1331	    base_core = (
  1332	        Fraction(str(base_profile.bits))
  1333	        - calibration.eta_ref * Fraction(str(base_profile.joules))
  1334	        + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, anchor)
  1335	    )
  1336	    singleton_by_key = {}
  1337	    for config in catalogue:
  1338	        for user in anchor.mapping:
  1339	            if config.mapping[user] == anchor.mapping[user]:
  1340	                continue
  1341	            mapping = anchor.mapping
  1342	            mapping[user] = config.mapping[user]
  1343	            singleton_by_key[(config.configuration_id, user)] = ENGINE._configuration(
  1344	                anchor, mapping, kind="pilot-exact-singleton"
  1345	            )
  1346	    evaluator.evaluate_many(tuple({
  1347	        row.assignments: row for row in singleton_by_key.values()
  1348	    }.values()))
  1349	    values = {}
  1350	    for config in catalogue:
  1351	        if config.configuration_id in evaluator._invalid:
  1352	            continue
  1353	        changed = tuple(user for user in anchor.mapping if config.mapping[user] != anchor.mapping[user])
  1354	        additive = Fraction()
  1355	        for user in changed:
  1356	            singleton = singleton_by_key[(config.configuration_id, user)]
  1357	            if singleton.configuration_id in evaluator._invalid:
  1358	                additive = Fraction(-10**30)
  1359	                break
  1360	            profile = evaluator.evaluate(singleton)
  1361	            additive += (
  1362	                Fraction(str(profile.bits))
  1363	                - calibration.eta_ref * Fraction(str(profile.joules))
  1364	                + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, singleton)
  1365	                - base_core
  1366	            )
  1367	        profile = evaluator.evaluate(config)
  1368	        joint = (
  1369	            Fraction(str(profile.bits))
  1370	            - calibration.eta_ref * Fraction(str(profile.joules))
  1371	            + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, config)
  1372	            - base_core
  1373	        )
  1374	        values[config.configuration_id] = {
  1375	            "changed": changed,
  1376	            "joint": float(joint / calibration.kappa_bits_per_user_step),
  1377	            "additive": float(additive / calibration.kappa_bits_per_user_step),
  1378	            "psi": float((joint - additive) / calibration.kappa_bits_per_user_step),
  1379	        }
  1380	    return values
  1381	
