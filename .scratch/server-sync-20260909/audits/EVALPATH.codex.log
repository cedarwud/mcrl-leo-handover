   450	def _step_payload(
   451	    *,
   452	    unit: AllocationUnit,
   453	    arm: str,
   454	    step_index: int,
   455	    outcome: StepOutcome,
   456	    previous: tuple[PhysicalAction, ...] | None,
   457	    ever_served: set[int],
   458	    last_served: dict[int, PhysicalAction] | None = None,
   459	) -> dict[str, object]:
   460	    if not outcome.jointly_legal:
   461	        raise StageCContractError("evaluator returned a jointly illegal committed profile")
   462	    if (
   463	        len(outcome.profile) != len(outcome.complete_service)
   464	        or len(outcome.user_ids) != len(outcome.profile)
   465	        or len(set(outcome.user_ids)) != len(outcome.user_ids)
   466	    ):
   467	        raise StageCContractError(
   468	            "outcome roster and complete-service vector disagree"
   469	        )
   470	    if (
   471	        outcome.bits < 0
   472	        or outcome.joules < 0
   473	        or (outcome.bits > 0 and outcome.joules == 0)
   474	        or outcome.opportunity_user_seconds <= 0
   475	    ):
   476	        raise StageCContractError("invalid additive endpoint totals")
   477	    if outcome.coordinator_latency_s < 0 or not math.isfinite(outcome.coordinator_latency_s):
   478	        raise StageCContractError("coordinator latency sample must be finite and nonnegative")
   479	    if previous is not None and len(previous) != len(outcome.profile):
   480	        raise StageCContractError("arm roster changed between steps")
   481	    events: list[dict[str, object]] = []
   482	    last = {} if last_served is None else last_served
   483	    handovers = 0
   484	    phi_half_units = 0
   485	    for user_index, (user_id, after) in enumerate(
   486	        zip(outcome.user_ids, outcome.profile, strict=True)
   487	    ):
   488	        before = None if previous is None else previous[user_index]
   489	        kind = _event_kind(
   490	            before,
   491	            after,
   492	            cell_rekey=user_id in outcome.cell_rekey_users,
   493	            ever_served=user_id in ever_served,
   494	        )
   495	        reentry_reference = last.get(user_id)
   496	        if kind == "reentry":
   497	            handovers += 1
   498	            phi_half_units += (
   499	                2
   500	                if reentry_reference is None
   501	                or reentry_reference.norad_id != after.norad_id
   502	                else 1
   503	            )
   504	        elif kind in {"beam_change", "satellite_change"}:
   505	            handovers += 1
   506	            phi_half_units += 1 if kind == "beam_change" else 2
   507	        if not after.is_null:
   508	            ever_served.add(user_id)
   509	            last[user_id] = after
   510	        events.append(
   511	            {
   512	                "user_id": user_id,
   513	                "prior_physical_identity": _identity_payload(before),
   514	                "current_physical_identity": _identity_payload(after),
   515	                "event_type": kind,
   516	                "reentry_reference_physical_identity": _identity_payload(reentry_reference),
   517	                "cell_rekey": user_id in outcome.cell_rekey_users,
   518	                "complete_service": bool(outcome.complete_service[user_index]),
   519	            }
   520	        )
   521	    energy = {
   522	        name: float_hex(value)
   523	        for name, value in sorted(outcome.energy_components_j.items())
   524	    }
   525	    if not energy:
   526	        raise StageCContractError("energy component ledger must not be empty")
   527	    try:
   528	        start_utc = datetime.fromisoformat(
   529	            unit.resolved_start_utc.replace("Z", "+00:00")
   530	        )
   531	    except ValueError as error:
   532	        raise StageCContractError("unit start UTC is invalid") from error
