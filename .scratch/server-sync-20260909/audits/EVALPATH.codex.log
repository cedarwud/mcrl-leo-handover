  1316	def _additive_scores(model, rows_by_user_action, base, config):
  1317	    total = 0.0
  1318	    for user in sorted(base.mapping):
  1319	        reference = rows_by_user_action[(user, base.mapping[user])]
  1320	        selected = rows_by_user_action[(user, config.mapping[user])]
  1321	        total += (
  1322	            model.q1.score(selected.q1_state) - model.q1.score(reference.q1_state)
  1323	            + model.q2.score(selected.q2_state) - model.q2.score(reference.q2_state)
  1324	        )
  1325	    return total
