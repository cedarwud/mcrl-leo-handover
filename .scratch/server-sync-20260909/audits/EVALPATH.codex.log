   242	    def __post_init__(self) -> None:
   243	        if self.visible != (self.elevation_deg >= MINIMUM_ELEVATION_DEG):
   244	            raise MCRLContractError("candidate visibility disagrees with live 10-degree floor")
   245	        if len(self.identity) != 2:
   246	            raise MCRLContractError("candidate identity must be (NORAD, beam-chain)")
   247	        if any(value < 0.0 or not math.isfinite(value) for value in (
   248	            self.slant_km,
   249	            self.d2_distance_km,
   250	            self.nominal_gain,
   251	            self.realised_gain,
   252	            self.remaining_visibility_s,
   253	            self.remaining_d2_s,
   254	        )):
   255	            raise MCRLContractError("candidate physical values must be finite and nonnegative")
   256	        if self.nominal_gain <= 0.0 or self.realised_gain <= 0.0:
   257	            raise MCRLContractError("direct channel gains must be positive")
   258	        for name in ("nominal_cross_gain_by_norad", "realised_cross_gain_by_norad"):
   259	            rows = getattr(self, name)
   260	            if tuple(sorted(rows)) != rows or len({norad for norad, _ in rows}) != len(rows):
   261	                raise MCRLContractError("cross-gain fields must use unique sorted NORAD order")
   262	            if any(type(norad) is not int or not math.isfinite(gain) or gain < 0.0 for norad, gain in rows):
   263	                raise MCRLContractError("cross-gain fields must be finite and nonnegative")
   264	        for name in (
   265	            "nominal_cross_gain_by_identity",
   266	            "realised_cross_gain_by_identity",
   267	        ):
   268	            rows = getattr(self, name)
   269	            if tuple(sorted(rows)) != rows or len({identity for identity, _ in rows}) != len(rows):
   270	                raise MCRLContractError(
   271	                    "identity cross-gain fields must use unique sorted physical identities"
   272	                )
   273	            if any(
   274	                len(identity) != 2
   275	                or any(type(value) is not int for value in identity)
   276	                or not math.isfinite(gain)
   277	                or gain < 0.0
   278	                for identity, gain in rows
   279	            ):
   280	                raise MCRLContractError(
   281	                    "identity cross-gain fields must be finite and nonnegative"
   282	                )
