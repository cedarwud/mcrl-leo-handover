    95	    ):
    96	        raise ValueError("batch resolution inputs require arrays and selected rows")
    97	
    98	    if any(
    99	        value is None
   100	        for value in (
   101	            architecture,
   102	            radiation_config,
   103	            geometry,
   104	            rate_model,
   105	            inventory,
   106	            duration_s,
   107	        )
   108	    ):
   109	        raise ValueError("scalar resolution inputs are incomplete")
   110	
   111	    if not math.isfinite(duration_s) or duration_s < 0.0:
   112	        raise ValueError("duration_s must be finite and nonnegative")
   113	    radiation = architecture.radiate(radiation_config, geometry, field)
   114	    if not radiation.valid:
   115	        return ResolutionResult(radiation, None, None, None, None, None, None, None)
   116	
   117	    rates = {link.user_id: 0.0 for link in geometry.links}
   118	    served_fraction = {link.user_id: 0.0 for link in geometry.links}
   119	    allocated_fraction = {link.user_id: 0.0 for link in geometry.links}
   120	    for slot in radiation.slots:
   121	        for transmission in slot.transmissions:
   122	            allocated_fraction[transmission.user_id] += slot.fraction
   123	            served = rate_model.served(transmission.sinr, allocated=True)
   124	            if served:
   125	                served_fraction[transmission.user_id] += slot.fraction
   126	                rates[transmission.user_id] += slot.fraction * rate_model.rate_bps(
   127	                    transmission.sinr, transmission.bandwidth_hz
   128	                )
   129	            # No branch edits radiation: an unsuccessful attempt continues to
   130	            # interfere and consume exactly the energy already scheduled.
   131	    energy = schedule_energy(
   132	        inventory,
   133	        (
   134	            (slot.fraction, dict(slot.beam_rf_w))
   135	            for slot in radiation.slots
   136	        ),
   137	        duration_s=duration_s,
   138	        idle_power_w=idle_power_w,
   139	    )
   140	    bits = {user: rate * duration_s for user, rate in rates.items()}
   141	    complete = {
   142	        user: allocated_fraction[user] > 0.0
   143	        and math.isclose(served_fraction[user], allocated_fraction[user], rel_tol=0.0, abs_tol=1.0e-15)
   144	        for user in rates
   145	    }
   146	    return ResolutionResult(
   147	        radiation,
   148	        rates,
   149	        bits,
   150	        served_fraction,
   151	        complete,
   152	        radiation.rate_target_attained,
   153	        radiation.per_user_rate_target_feasible,
   154	        energy,
   155	    )
