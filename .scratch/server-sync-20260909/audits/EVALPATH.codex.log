    44	@dataclass(frozen=True)
    45	class IntegrationReceipt:
    46	    bits: dict[int, float]
    47	    joules: float
    48	    decoding_time_s: dict[int, float]
    49	    useful_time_s: dict[int, float]
    50	    event_log: tuple[InterruptionEvent, ...]
    51	
    52	
    53	def _validate_samples(samples: tuple[BoundarySample, ...]) -> None:
    54	    if len(samples) < 2:
    55	        raise MCRLContractError("trapezoidal integration needs at least two samples")
    56	    previous = -math.inf
    57	    users = set(samples[0].rate_bps)
    58	    for sample in samples:
    59	        if not math.isfinite(sample.time_s) or sample.time_s < previous:
    60	            raise MCRLContractError("sample times must be finite and nondecreasing")
    61	        if set(sample.rate_bps) != users or set(sample.decoding) != users:
    62	            raise MCRLContractError("every boundary must cover the same user identities")
    63	        if not math.isfinite(sample.power_w) or sample.power_w < 0.0:
    64	            raise MCRLContractError("boundary power must be finite and nonnegative")
    65	        if any(not math.isfinite(rate) or rate < 0.0 for rate in sample.rate_bps.values()):
    66	            raise MCRLContractError("boundary rates must be finite and nonnegative")
    67	        previous = sample.time_s
    68	
    69	
    70	def _blackouts(
    71	    events: Iterable[InterruptionEvent],
    72	    *,
    73	    start_s: float,
    74	    end_s: float,
    75	) -> tuple[dict[int, tuple[tuple[float, float], ...]], tuple[InterruptionEvent, ...]]:
    76	    logged = tuple(sorted(events, key=lambda event: (event.time_s, event.user_id, event.kind)))
    77	    intervals: dict[int, list[tuple[float, float]]] = {}
    78	    for event in logged:
    79	        if event.kind in {"initial_entry", "reentry"}:
    80	            continue
    81	        duration = (
    82	            SAME_SATELLITE_INTERRUPTION_S
    83	            if event.kind == "same_satellite_beam_change"
    84	            else SATELLITE_CHANGE_INTERRUPTION_S
    85	        )
    86	        low = max(start_s, event.time_s)
    87	        high = min(end_s, event.time_s + duration)
    88	        if high > low:
    89	            intervals.setdefault(event.user_id, []).append((low, high))
    90	    merged: dict[int, tuple[tuple[float, float], ...]] = {}
    91	    for user, rows in intervals.items():
    92	        result: list[list[float]] = []
    93	        for low, high in sorted(rows):
    94	            if result and low <= result[-1][1]:
    95	                result[-1][1] = max(result[-1][1], high)
    96	            else:
    97	                result.append([low, high])
    98	        merged[user] = tuple((low, high) for low, high in result)
    99	    return merged, logged
   100	
   101	
   102	def _linear_integral(y0: float, y1: float, t0: float, t1: float, low: float, high: float) -> float:
   103	    if high <= low or t1 <= t0:
   104	        return 0.0
   105	    slope = (y1 - y0) / (t1 - t0)
   106	    a = low - t0
   107	    b = high - t0
   108	    return y0 * (b - a) + 0.5 * slope * (b * b - a * a)
   109	
   110	
   111	def integrate_trapezoidal(
   112	    samples: Iterable[BoundarySample],
   113	    *,
   114	    interruptions: Iterable[InterruptionEvent] = (),
   115	    interruption_enabled: bool = False,
   116	) -> IntegrationReceipt:
   117	    """Integrate boundary values, never interpolating across duplicate-time jumps."""
   118	
   119	    points = tuple(samples)
   120	    _validate_samples(points)
   121	    start = points[0].time_s
   122	    end = points[-1].time_s
   123	    blackouts, log = _blackouts(interruptions, start_s=start, end_s=end)
   124	    users = tuple(points[0].rate_bps)
   125	    bits = {user: 0.0 for user in users}
   126	    decoding = {user: 0.0 for user in users}
   127	    useful = {user: 0.0 for user in users}
   128	    joules = 0.0
   129	    for left, right in zip(points, points[1:]):
   130	        t0, t1 = left.time_s, right.time_s
   131	        if t1 == t0:
   132	            continue
   133	        duration = t1 - t0
   134	        joules += 0.5 * (left.power_w + right.power_w) * duration
   135	        for user in users:
   136	            decoded_integral = 0.5 * (float(left.decoding[user]) + float(right.decoding[user])) * duration
   137	            decoding[user] += decoded_integral
   138	            excluded: list[tuple[float, float]] = []
   139	            if interruption_enabled:
   140	                for low, high in blackouts.get(user, ()):
   141	                    cut_low, cut_high = max(t0, low), min(t1, high)
   142	                    if cut_high > cut_low:
   143	                        excluded.append((cut_low, cut_high))
   144	            full_bits = 0.5 * (left.rate_bps[user] + right.rate_bps[user]) * duration
   145	            removed_bits = math.fsum(
   146	                _linear_integral(left.rate_bps[user], right.rate_bps[user], t0, t1, low, high)
   147	                for low, high in excluded
   148	            )
   149	            removed_time = math.fsum(
   150	                _linear_integral(
   151	                    float(left.decoding[user]),
   152	                    float(right.decoding[user]),
   153	                    t0,
   154	                    t1,
   155	                    low,
   156	                    high,
   157	                )
   158	                for low, high in excluded
   159	            )
   160	            bits[user] += full_bits - removed_bits
   161	            useful[user] += decoded_integral - removed_time
   162	    return IntegrationReceipt(bits, joules, decoding, useful, log)
   163	
   164	
   165	def integrate_47_subintervals(
   166	    samples: Iterable[BoundarySample],
   167	    *,
   168	    discontinuities: Iterable[BoundarySample] = (),
   169	    interruptions: Iterable[InterruptionEvent] = (),
   170	    interruption_enabled: bool = False,
   171	) -> IntegrationReceipt:
   172	    """Require exactly t plus the next 47 0.640-s D2 boundary samples."""
   173	
   174	    points = tuple(samples)
   175	    if len(points) != D2_SUBINTERVALS + 1:
   176	        raise MCRLContractError("treatment 0 needs exactly 48 boundary samples")
   177	    for index, point in enumerate(points):
   178	        expected = points[0].time_s + index * D2_MEASUREMENT_STEP_S
   179	        if not math.isclose(point.time_s, expected, rel_tol=0.0, abs_tol=1.0e-12):
   180	            raise MCRLContractError("D2 boundary tape is not on the frozen 0.640-s clock")
   181	    if not math.isclose(points[-1].time_s - points[0].time_s, DECISION_INTERVAL_S, rel_tol=0.0, abs_tol=1.0e-12):
   182	        raise MCRLContractError("integration tape does not span 30.08 seconds")
   183	    extra = tuple(discontinuities)
   184	    if any(point.time_s <= points[0].time_s or point.time_s >= points[-1].time_s for point in extra):
   185	        raise MCRLContractError("event discontinuities must lie strictly inside the step")
   186	    # Callers encode left/right event limits as two samples at the same time.
   187	    counts: dict[float, int] = {}
   188	    for point in extra:
   189	        counts[point.time_s] = counts.get(point.time_s, 0) + 1
   190	    if any(count != 2 for count in counts.values()):
   191	        raise MCRLContractError("each event discontinuity needs exactly left/right samples")
   192	    # When an event lands on a scheduled D2 sample, its explicit left/right
   193	    # limits replace that single regular point.  Keeping all three would still
   194	    # interpolate the preceding interval to the regular (right-limit) value.
   195	    merged = tuple(
   196	        sorted(
   197	            tuple(point for point in points if point.time_s not in counts) + extra,
   198	            key=lambda point: point.time_s,
   199	        )
   200	    )
   201	    return integrate_trapezoidal(
   202	        merged,
   203	        interruptions=interruptions,
   204	        interruption_enabled=interruption_enabled,
   205	    )
   206	
   207	
   208	def snapshot_left(sample: BoundarySample, *, end_s: float) -> IntegrationReceipt:
   209	    """Treatment T: decision-time (left) snapshot held to the supplied end."""
   210	
   211	    duration = end_s - sample.time_s
   212	    if not math.isfinite(duration) or duration <= 0.0:
   213	        raise MCRLContractError("left snapshot end must follow the decision instant")
   214	    bits = {user: rate * duration for user, rate in sample.rate_bps.items()}
   215	    decoding = {user: float(value) * duration for user, value in sample.decoding.items()}
   216	    return IntegrationReceipt(bits, sample.power_w * duration, decoding, dict(decoding), ())
   217	
   218	
   219	def snapshot_terminal(sample: BoundarySample, *, start_s: float) -> IntegrationReceipt:
   220	    """Compatibility helper for the superseded terminal-snapshot interpretation.
   221	
   222	    V0.25 matrix treatment T does not call this helper after the controller's
   223	    stage-1 decision record; it remains named so older stage-1 imports fail no
   224	    more broadly than necessary.
   225	    """
   226	
   227	    duration = sample.time_s - start_s
   228	    if not math.isclose(duration, DECISION_INTERVAL_S, rel_tol=0.0, abs_tol=1.0e-12):
   229	        raise MCRLContractError("terminal snapshot must be at t+30.08")
   230	    bits = {user: rate * duration for user, rate in sample.rate_bps.items()}
   231	    decoding = {user: float(value) * duration for user, value in sample.decoding.items()}
   232	    return IntegrationReceipt(bits, sample.power_w * duration, decoding, dict(decoding), ())
   233	
