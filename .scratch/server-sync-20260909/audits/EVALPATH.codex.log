   304	    def append(
   305	        self,
   306	        *,
   307	        status: str,
   308	        unit: AllocationUnit,
   309	        allocation_manifest_digest: str,
   310	        receipt_sha256: str | None = None,
   311	        reason: str | None = None,
   312	    ) -> dict[str, object]:
   313	        if status not in {"STARTED", "DONE", "ABANDONED"}:
   314	            raise StageCContractError("invalid attempt status")
   315	        descriptor = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
   316	        with os.fdopen(descriptor, "r+b", closefd=True) as stream:
   317	            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
   318	            stream.seek(0)
   319	            existing = self._decode(stream.read())
   320	            states = [
   321	                row["status"] for row in existing if row["attempt_key"] == unit.attempt_key
   322	            ]
   323	            if status == "STARTED" and states:
   324	                raise StageCContractError("duplicate evaluation attempt refused")
   325	            if status != "STARTED" and states != ["STARTED"]:
   326	                raise StageCContractError(
   327	                    "terminal attempt record lacks exactly one STARTED"
   328	                )
   329	            previous = (
   330	                str(existing[-1]["record_sha256"]) if existing else "0" * 64
   331	            )
   332	            body: dict[str, object] = {
   333	                "schema": ATTEMPT_SCHEMA,
   334	                "sequence": len(existing) + 1,
   335	                "previous_record_sha256": previous,
   336	                "status": status,
   337	                "attempt_key": unit.attempt_key,
   338	                "experiment_id": unit.experiment_id,
   339	                "experiment_schema": unit.experiment_schema,
   340	                "experiment_definition_sha256": unit.experiment_definition_sha256,
   341	                "experiment_execution_kind": unit.experiment_execution_kind,
   342	                "panel_id": unit.panel_id,
   343	                "cell_id": unit.cell_id,
   344	                "unit_id": unit.unit_id,
   345	                "world_id": unit.world_id,
   346	                "world_seed": unit.world_seed,
   347	                "learner_seed": unit.learner_seed,
   348	                "code_digest": unit.code_digest,
   349	                "provider_digest": unit.provider_digest,
   350	                "launch_digest": unit.launch_digest,
   351	                "physics_digest": unit.physics_digest,
   352	                "catalogue_digest": unit.catalogue_digest,
   353	                "deployment_capability_digest": unit.deployment_capability_digest,
   354	                "setting_digest": unit.setting_digest,
   355	                "calibration_digest": unit.calibration_digest,
   356	                "allocation_manifest_digest": allocation_manifest_digest,
   357	                "utc": _utc_now(),
   358	                "receipt_sha256": receipt_sha256,
   359	                "reason": reason,
   360	            }
   361	            body["record_sha256"] = canonical_sha256(body)
   362	            stream.seek(0, os.SEEK_END)
   363	            stream.write(canonical_json_bytes(body) + b"\n")
   364	            stream.flush()
   365	            os.fsync(stream.fileno())
   366	            return body
