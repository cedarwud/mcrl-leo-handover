    27	@dataclass(frozen=True)
    28	class BoundarySample:
    29	    """One D2-boundary value; duplicate times encode a discontinuity."""
    30	
    31	    time_s: float
    32	    rate_bps: Mapping[int, float]
    33	    power_w: float
    34	    decoding: Mapping[int, bool]
