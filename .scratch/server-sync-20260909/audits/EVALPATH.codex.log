   970	    )
   971	    receipts = [runner.run_unit(unit=unit, models=models, conformance=conformance) for unit in units]
   972	    report = merge_receipts(receipts, manifest=manifest, registry=registry)
   973	    assert report["contrasts"]["DROP_C1"]["point_estimates"]["ee_relative"] == 0.0
   974	    assert report["pooled_additive_totals"]["DROP_C2"]["bits_hex"] == 0.0.hex()
   975	    assert report["contrasts"]["DROP_C3"]["bootstrap"]["undefined_draws"]["ee_relative"] == 79
   976	    assert report["bootstrap"].startswith("primary two-way pigeonhole")
   977	    attribution = report["coordination_attribution"]
   978	    assert attribution["paired_full_vs_s_uni"]["point_estimates"]["ee_relative"] > 0.0
   979	    assert attribution["paired_full_vs_s_uni"]["full_strictly_greater_ee"] is True
   980	    assert attribution["paired_full_vs_s_uni"]["qos_noninferior"] is True
   300	        if self.path.is_symlink() or not self.path.is_file():
   301	            raise StageCContractError("attempt registry is not a regular file")
   302	        return self._decode(self.path.read_bytes())
