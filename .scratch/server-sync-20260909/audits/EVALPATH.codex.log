   582	def reaggregate_steps(
   583	    steps: Sequence[Mapping[str, object]],
   584	) -> dict[str, object]:
   585	    if not steps:
   586	        raise StageCContractError("cannot aggregate empty step rows")
   587	    bits = sum(
   588	        parse_float_hex(row["bits_hex"], field="bits_hex") for row in steps
   589	    )
   590	    joules = sum(
   591	        parse_float_hex(row["joules_hex"], field="joules_hex") for row in steps
   592	    )
   593	    complete_num = sum(int(row["complete_service_numerator"]) for row in steps)
   594	    complete_den = sum(int(row["complete_service_denominator"]) for row in steps)
   595	    handover_num = sum(int(row["handover_numerator"]) for row in steps)
   596	    handover_den = sum(int(row["handover_denominator"]) for row in steps)
   597	    phi_num = sum(int(row["phi_cost_numerator_half_units"]) for row in steps)
   598	    phi_den = sum(
   599	        int(row["phi_cost_denominator_half_user_steps"]) for row in steps
   600	    )
   601	    miss_num = sum(int(row["coordinator_deadline_miss_numerator"]) for row in steps)
   602	    miss_den = sum(int(row["coordinator_deadline_miss_denominator"]) for row in steps)
   603	    return {
   604	        "bits_hex": float_hex(bits),
   605	        "joules_hex": float_hex(joules),
   606	        "complete_service_numerator": complete_num,
   607	        "complete_service_denominator": complete_den,
   608	        "handover_numerator": handover_num,
   609	        "handover_denominator": handover_den,
   610	        "phi_cost_numerator_half_units": phi_num,
   611	        "phi_cost_denominator_half_user_steps": phi_den,
   612	        "coordinator_deadline_miss_numerator": miss_num,
   613	        "coordinator_deadline_miss_denominator": miss_den,
   614	    }
