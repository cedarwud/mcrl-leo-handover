   418	def _identity_payload(
   419	    action: PhysicalAction | None,
   420	) -> dict[str, int | None] | None:
   421	    return None if action is None else action.payload()
   422	
   423	
   424	def _event_kind(
   425	    before: PhysicalAction | None,
   426	    after: PhysicalAction,
   427	    *,
   428	    cell_rekey: bool,
   429	    ever_served: bool,
   430	) -> str:
   431	    if before is None:
   432	        if after.is_null:
   433	            return "unchanged"
   434	        return "reentry" if ever_served else "initial_entry"
   435	    if before.is_null and after.is_null:
   436	        return "unchanged"
   437	    if before.is_null:
   438	        return "reentry" if ever_served else "initial_entry"
   439	    if after.is_null:
   440	        return "exit"
   441	    if before.norad_id != after.norad_id:
   442	        return "satellite_change"
   443	    if before.beam_chain_id != after.beam_chain_id:
   444	        return "beam_change"
   445	    if cell_rekey:
   446	        return "cell_rekey"
   447	    return "unchanged"
   448	
