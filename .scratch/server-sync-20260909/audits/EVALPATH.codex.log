   394	def admission_decision(
   395	    *,
   396	    acceptance_suite_pass: bool,
   397	    oracle_positive_by_route: Mapping[str, bool],
   398	    qos_pass: bool,
   399	    genuine_joint_headroom: bool,
   400	    s0_relative_gain: float,
   401	    zero_bit_disposition_sealed: bool,
   402	) -> dict[str, object]:
   403	    required_routes = {"C1", "C2", "C3"}
   404	    route_pass = set(oracle_positive_by_route) == required_routes and all(
   405	        oracle_positive_by_route.values()
   406	    )
   407	    admitted = all(
   408	        (
   409	            acceptance_suite_pass,
   410	            route_pass,
   411	            qos_pass,
   412	            genuine_joint_headroom,
   413	            s0_relative_gain >= 0.01,
   414	            zero_bit_disposition_sealed,
   415	        )
   416	    )
   417	    return {
   418	        "decision": "PHYSICS-GO" if admitted else "HOLD",
   419	        "acceptance_suite_pass": acceptance_suite_pass,
   420	        "oracle_positive_by_route": dict(oracle_positive_by_route),
   421	        "qos_pass": qos_pass,
   422	        "genuine_joint_headroom": genuine_joint_headroom,
   423	        "s0_relative_gain": s0_relative_gain,
   424	        "zero_bit_disposition_sealed": zero_bit_disposition_sealed,
   425	    }
