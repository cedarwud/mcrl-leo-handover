   620	def _rate_targets(
   621	    config: RadiationConfig,
   622	    geometry: Geometry,
   623	    active: tuple[int, ...],
   624	    members: dict[BeamIdentity, tuple[int, ...]],
   625	) -> tuple[np.ndarray, np.ndarray, tuple[float | None, ...]]:
   626	    """Build per-user ACM targets and the explicit no-mode forced-cap mask."""
   627	
   628	    values: list[float] = []
   629	    forced: list[bool] = []
   630	    reported: list[float | None] = []
   631	    for index in active:
   632	        occupancy = len(members[geometry.links[index].beam])
   633	        gamma = rate_target_sinr(
   634	            config.rate_target_bps,
   635	            config.bandwidth_hz,
   636	            occupancy,
   637	        )
   638	        reported.append(gamma)
   639	        forced.append(gamma is None)
   640	        values.append(1.0 if gamma is None else gamma)
   641	    return (
   642	        np.asarray(values, dtype=np.float64),
   643	        np.asarray(forced, dtype=np.bool_),
   644	        tuple(reported),
   645	    )
