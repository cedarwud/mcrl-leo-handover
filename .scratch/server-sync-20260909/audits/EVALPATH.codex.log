  1396	def _build_u_catalogue(
  1397	    tape, step_index, a0, u, standard_catalogue, evaluator, calibration,
  1398	    rows_by_user_action,
  1399	):
  1400	    started = time.perf_counter()
  1401	    options, _ = ENGINE._legal_options(tape, step_index)
  1402	    evaluator.evaluate(u)
  1403	    candidates_by_user = {}
  1404	    for user in sorted(options):
  1405	        candidates = []
  1406	        for identity in options[user]:
  1407	            if identity == u.mapping[user]:
  1408	                continue
  1409	            mapping = u.mapping
  1410	            mapping[user] = identity
  1411	            config = ENGINE._configuration(a0, mapping, kind="pilot-u-unilateral")
  1412	            reference = rows_by_user_action[(user, u.mapping[user])]
  1413	            selected = rows_by_user_action[(user, identity)]
  1414	            score = (
  1415	                float.fromhex(selected.c1_label_normalized_hex)
  1416	                + float.fromhex(selected.c2_label_normalized_hex)
  1417	                - float.fromhex(reference.c1_label_normalized_hex)
  1418	                - float.fromhex(reference.c2_label_normalized_hex)
  1419	            )
  1420	            candidates.append((Fraction(str(score)), config))
  1421	        candidates_by_user[user] = candidates
  1422	    moves = {}
  1423	    for user in sorted(options):
  1424	        moves[user] = sorted(
  1425	            candidates_by_user[user],
  1426	            key=lambda row: (-row[0], row[1].configuration_id),
  1427	        )
  1428	    ranked = sorted(
  1429	        (user for user in moves if moves[user]),
  1430	        key=lambda user: (-abs(float(moves[user][0][0])), user),
  1431	    )[:10]
  1432	    rows = [a0, u]
  1433	    rows.extend(row for row in standard_catalogue if row.changed_users == 1)
  1434	    rows.extend(
  1435	        row for row in standard_catalogue if row.kind in {"s0-top-two", "beam-evacuation"}
  1470	            key=lambda row: (
  1471	                -(
  1472	                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
  1473	                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
  1474	                ),
  1475	                row.configuration_id,
  1476	            ),
  1477	        )[: ENGINE.TOP_PROPOSALS]
  1478	        top_ids.extend(row.configuration_id for row in ranked)
  1479	    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
  1480	    allowed.extend(
  1481	        row for row in catalogue
  1482	        if row.changed_users > 1
  1483	        and all(
  1484	            any(
  1485	                proposal.mapping[user] == identity
  1486	                for proposal in unilateral
  1487	                if proposal.configuration_id in top_ids
  1488	            )
  1489	            for user, identity in row.assignments
  1490	            if identity != base.mapping[user]
  1491	        )
  1492	    )
  1493	    evaluator.evaluate_many(tuple(allowed))
  1494	    allowed = [
  1495	        row for row in allowed if row.configuration_id not in evaluator._invalid
  1496	    ]
  1497	    return min(
  1498	        allowed,
  1499	        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
  1500	    )
