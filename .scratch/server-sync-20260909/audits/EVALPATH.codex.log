@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Differential harness for StepEvaluator scalar vs dense a-r0 paths."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[2]
+ENGINE_PATH = ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+
+
+def load_engine():
+    name = "eval_path_matrix_engine"
+    spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {ENGINE_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def evaluator(engine, tape, setting, run_setting, step_index, incumbent, *, boundaries):
+    return engine.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=engine._rekeyed_users(tape, step_index),
+        field="nominal",
+        run_setting=run_setting,
+        boundary_indices=boundaries,
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--smoke", action="store_true")
+    args = parser.parse_args()
+    engine = load_engine()
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="eval-path-forensics"),
+        steps=1 if args.smoke else 4,
+        start_time_s=0.0,
+    )
+    setting = engine._setting("a-r0")
+    run_setting = engine.run_setting_for("a-r0")
+    base = engine._base_configuration(tape, 0, engine.REFERENCE_CARRIERS[0])
+    scalar = evaluator(engine, tape, setting, run_setting, 0, base, boundaries=tuple(range(48)))
+    batch = evaluator(engine, tape, setting, run_setting, 0, base, boundaries=tuple(range(48)))
+    scalar_profile = scalar.evaluate(base)
+    batch.evaluate_many((base,))
+    batch_profile = batch.evaluate(base)
+    payload = {
+        "configuration_id": base.configuration_id,
+        "same_object_id": id(base),
+        "scalar_bits": scalar_profile.bits,
+        "batch_bits": batch_profile.bits,
+        "bits_difference_batch_minus_scalar": batch_profile.bits - scalar_profile.bits,
+        "scalar_joules": scalar_profile.joules,
+        "batch_joules": batch_profile.joules,
+        "joules_difference_batch_minus_scalar": batch_profile.joules - scalar_profile.joules,
+        "binary64_agreement": (
+            scalar_profile.bits == batch_profile.bits
+            and scalar_profile.joules == batch_profile.joules
+            and scalar_profile.score.bits == batch_profile.score.bits
+        ),
+    }
+    print(json.dumps(payload, sort_keys=True))
+    return 0 if payload["binary64_agreement"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
