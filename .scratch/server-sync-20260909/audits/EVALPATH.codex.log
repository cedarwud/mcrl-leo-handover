   406	class UnitEvaluator(Protocol):
   407	    def __call__(
   408	        self,
   409	        *,
   410	        unit: AllocationUnit,
   411	        arm: str,
   412	        model: ThreeRouteModel | None,
   413	        step_index: int,
   414	        previous_profile: tuple[PhysicalAction, ...] | None,
