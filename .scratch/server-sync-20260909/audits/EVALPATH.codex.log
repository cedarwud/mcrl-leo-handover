   340	    additive = _coalition_row("additive")
   341	
   342	    # Exact B4 identity with nonzero Phi charged once, and the second physical
   343	    # identity without Phi.  Values are normalized by kappa=2.
   344	    assert float.fromhex(synergy.c1_normalized_hex) == -1.0
   345	    assert float.fromhex(synergy.psi_normalized_hex) == 2.0
   346	    assert float.fromhex(synergy.objective_delta_normalized_hex) == 1.0
   347	    assert float.fromhex(synergy.physical_c1_normalized_hex) == -0.5
   348	    assert float.fromhex(synergy.physical_psi_normalized_hex) == 2.5
   349	    assert float.fromhex(synergy.physical_delta_normalized_hex) == 2.0
   350	    assert float.fromhex(antagonistic.psi_normalized_hex) == -1.0
   351	    assert float.fromhex(additive.psi_normalized_hex) == 0.0
   352	    # Exhaust all 2^3 profiles at each of the three hand-computed steps.  User
   353	    # 2 is a dummy, so toggling only that bit never changes F or Psi.
   354	    joint_f = {"additive": -2.0, "synergy": 2.0, "antagonistic": -4.0}
   355	    for kind, profile in product(joint_f, product((0, 1), repeat=3)):
   356	        u0, u1, dummy = profile
   357	        value = joint_f[kind] if u0 and u1 else -float(u0 + u1)
