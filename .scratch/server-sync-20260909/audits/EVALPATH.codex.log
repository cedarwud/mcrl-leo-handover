  1869	def summarize(records, row_manifest, training_manifest, evaluation_manifest):
  1870	    summary = {"anchors": {}, "contrasts": {}, "latency": {}}
  1871	    for variant in ("P-a0", "P-u"):
  1872	        summary["anchors"][variant] = {}
  1873	        subset = [row for row in records if row["catalogue_anchor"] == variant]
  1874	        for arm in REPORTED_ARMS:
  1875	            rows = [row for row in subset if row["arm"] == arm]
  1876	            bits = math.fsum(row["bits"] for row in rows)
  1877	            joules = math.fsum(row["joules"] for row in rows)
  1878	            summary["anchors"][variant][arm] = {
  1879	                "bits": bits,
  1880	                "joules": joules,
  1881	                "pooled_ee_bits_per_j": None if joules == 0 else bits / joules,
  1882	                "availability": math.fsum(row["availability"] for row in rows) / len(rows),
  1883	                "handover_rate": math.fsum(row["handover_count"] for row in rows) / math.fsum(row["handover_opportunities"] for row in rows),
  1884	                "cap_hit_rate": math.fsum(row["rf_cap_hits"] for row in rows) / max(1, math.fsum(row["rf_transmission_observations"] for row in rows)),
  1885	            }
  1886	        full = summary["anchors"][variant]["FULL"]
  1887	        for comparator in ("DROP_C3", "S0", "S_UNI"):
  1888	            other = summary["anchors"][variant][comparator]
  1889	            key = f"{variant}:FULL-vs-{comparator}"
  1890	            summary["contrasts"][key] = (
  1891	                None
  1892	                if full["pooled_ee_bits_per_j"] is None or other["pooled_ee_bits_per_j"] is None
  1893	                else full["pooled_ee_bits_per_j"] / other["pooled_ee_bits_per_j"] - 1.0
  1894	            )
  1895	        full_rows = [row for row in subset if row["arm"] == "FULL"]
  1896	        anchor_rows = {
  1897	            (row["world_id"], row["anchor_index"]): row for row in full_rows
  1898	        }
  1899	        reversal_rows = [
  1900	            row for row in full_rows if row.get("additive_choice_joint_delta", 0.0) < 0.0
  1901	        ]
  1902	        sizes = sorted(
  1903	            {
  1904	                int(size)
  1905	                for row in anchor_rows.values()
  1906	                for size in row.get("u_positive_joint_sizes", [])
  1907	            }
  1908	            | {int(row["changed_users"]) for row in full_rows}
  1909	        )
  1910	        summary["anchors"][variant]["diagnostics"] = {
  1911	            "positive_joint_escape_fraction_from_u": sum(
  1912	                bool(row["u_any_positive_joint_escape"])
  1913	                for row in anchor_rows.values()
  1914	            ) / len(anchor_rows),
  1915	            "selected_psi_distribution": _quantiles([row["psi_anchor_normalized"] for row in full_rows]),
  1916	            "g_A_distribution": _quantiles([row["g_A"] for row in full_rows if "g_A" in row]),
  1917	            "g_I_distribution": _quantiles([row["g_I"] for row in full_rows if "g_I" in row]),
  1918	            "top_choice_agreement": sum(bool(row["top_choice_agreement"]) for row in full_rows) / len(full_rows),
  1919	            "harmful_acceptance_rate": sum(row["joint_delta_anchor_normalized"] < 0.0 for row in full_rows) / len(full_rows),
  1920	            "c2_tie_frequency": sum(bool(row["c2_tie_break"]) for row in full_rows) / len(full_rows),
  1921	            "c2_tie_pair_fraction_mean": (
  1922	                math.fsum(row["c2_tie_break"] or 0.0 for row in full_rows) / len(full_rows)
  1923	            ),
  1924	            "v_ca": {
  1925	                field: math.fsum(row[field] for row in full_rows)
  1926	                for field in (
  1927	                    "v_ca_bits_component", "v_ca_energy_component_bits",
  1928	                    "v_ca_phi_component_bits", "v_ca_net_bits",
  1929	                )
  1930	            },
  1931	            "additive_reversal_frequency": len(reversal_rows) / len(full_rows),
  1932	            "additive_reversals_prevented_fraction": (
  1933	                None if not reversal_rows else sum(
  1934	                    row["joint_delta_anchor_normalized"] >= 0.0
  1935	                    for row in reversal_rows
  1936	                ) / len(reversal_rows)
  1937	            ),
  1938	            "escape_and_harm_by_coalition_size": {
  1939	                str(size): {
  1940	                    "escape_opportunities": sum(
  1941	                        size in row.get("u_positive_joint_sizes", [])
  1942	                        for row in anchor_rows.values()
  1943	                    ),
  1944	                    "selected": sum(row["changed_users"] == size for row in full_rows),
  1945	                    "harmful": sum(
  1946	                        row["changed_users"] == size
  1947	                        and row["joint_delta_anchor_normalized"] < 0.0
  1948	                        for row in full_rows
  1949	                    ),
  1950	                }
  1951	                for size in sizes
  1952	            },
  1953	        }
  1954	    latencies = evaluation_manifest["latencies"]
  1955	    for field in (
  1956	        "feature_construction_s", "catalogue_a0_s", "catalogue_u_extra_s", "s_uni_s", "total_s", "physics_boundary_evaluations"
  1957	    ):
  1958	        summary["latency"][field] = _quantiles([float(row[field]) for row in latencies])
  1959	    summary["resources"] = {
  1960	        "rows_wall_s": row_manifest["phase_wall_s"],
  1961	        "rows_core_s": row_manifest["phase_core_s"],
  1962	        "training_wall_s": training_manifest["phase_wall_s"],
  1963	        "training_core_s": training_manifest["phase_core_s"],
  1964	        "evaluation_wall_s": evaluation_manifest["phase_wall_s"],
  1965	        "evaluation_core_s": evaluation_manifest["phase_core_s"],
  1966	    }
  1967	    return summary
