index 0000000000000000000000000000000000000000..060c32f2826b4426bea55b3225702ee2632c7e9b
--- /dev/null
+++ b/.scratch/eval-path/run_forensics.py
@@ -0,0 +1,345 @@
+#!/usr/bin/env python3
+"""Read-only, deterministic evaluation-path forensic sampler."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import statistics
+import sys
+import time
+
+
+ROOT = Path(__file__).resolve().parents[2]
+ENGINE_PATH = ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+OUTPUT_PATH = ROOT / ".scratch/eval-path/comparisons.json"
+ANCHORS = (0, 4, 8, 12, 16, 20, 24, 28)
+ROWS_PER_ANCHOR = 28
+FULL_BOUNDARIES = tuple(range(48))
+
+
+def load_engine():
+    spec = importlib.util.spec_from_file_location("eval_path_forensics_engine", ENGINE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load sealed engine copy")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def make_evaluator(engine, tape, setting, run_setting, step, base, field, boundaries):
+    return engine.StepEvaluator(
+        tape,
+        setting,
+        step,
+        transition_from=base,
+        cell_rekeyed_users=engine._rekeyed_users(tape, step),
+        field=field,
+        run_setting=run_setting,
+        boundary_indices=boundaries,
+    )
+
+
+def choose_rows(catalogue):
+    by_occupancy = {}
+    for config in catalogue:
+        by_occupancy.setdefault(config.changed_users, []).append(config)
+    occupancies = sorted(by_occupancy)
+    cursors = {value: 0 for value in occupancies}
+    chosen = []
+    while len(chosen) < ROWS_PER_ANCHOR:
+        made_progress = False
+        for occupancy in occupancies:
+            cursor = cursors[occupancy]
+            rows = by_occupancy[occupancy]
+            if cursor < len(rows):
+                chosen.append(rows[cursor])
+                cursors[occupancy] += 1
+                made_progress = True
+                if len(chosen) == ROWS_PER_ANCHOR:
+                    break
+        if not made_progress:
+            break
+    if len(chosen) != ROWS_PER_ANCHOR:
+        raise RuntimeError("catalogue too small for requested sample")
+    return tuple(chosen)
+
+
+def profile_payload(profile):
+    return {
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "per_user_bits": {str(key): value for key, value in profile.score.bits.items()},
+        "decoding_time_s": {str(key): value for key, value in profile.score.decoding_time_s.items()},
+        "useful_time_s": {str(key): value for key, value in profile.score.useful_time_s.items()},
+        "energy_components": dict(profile.energy_components),
+        "lit_beam_seconds": profile.lit_beam_seconds,
+        "lit_satellite_seconds": profile.lit_satellite_seconds,
+        "acm_mode_counts": dict(profile.acm_mode_counts),
+        "rf_cap_hits": profile.rf_cap_hits,
+        "rf_transmission_observations": profile.rf_transmission_observations,
+        "certificate_status": profile.certificate_status,
+        "certificate_iterations": profile.certificate_iterations,
+        "required_power_w_max": profile.required_power_w_max,
+        "min_decoding_margin_db": profile.min_decoding_margin_db,
+        "mean_acm_se_bit_s_hz": profile.mean_acm_se_bit_s_hz,
+    }
+
+
+def comparison(batch, scalar, kappa):
+    users = sorted(scalar.score.bits)
+    per_user = {str(user): batch.score.bits[user] - scalar.score.bits[user] for user in users}
+    bits_difference = batch.bits - scalar.bits
+    joules_difference = batch.joules - scalar.joules
+    return {
+        "bits_batch_minus_scalar": bits_difference,
+        "kappa_units_batch_minus_scalar": bits_difference / kappa,
+        "joules_batch_minus_scalar": joules_difference,
+        "per_user_bits_batch_minus_scalar": per_user,
+        "binary64": {
+            "network_bits": batch.bits == scalar.bits,
+            "joules": batch.joules == scalar.joules,
+            "per_user_bits_vector": batch.score.bits == scalar.score.bits,
+            "all_requested": (
+                batch.bits == scalar.bits
+                and batch.joules == scalar.joules
+                and batch.score.bits == scalar.score.bits
+            ),
+        },
+    }
+
+
+def consistency(profile):
+    bit_sum = math.fsum(profile.score.bits.values())
+    component_sum = math.fsum(profile.energy_components.values())
+    users = set(profile.score.bits)
+    useful_ok = all(
+        profile.score.useful_time_s[user] <= profile.score.decoding_time_s[user] + 1e-12
+        for user in users
+    )
+    finite = all(
+        math.isfinite(value)
+        for value in (
+            list(profile.score.bits.values())
+            + list(profile.score.decoding_time_s.values())
+            + list(profile.score.useful_time_s.values())
+            + list(profile.energy_components.values())
+            + [profile.bits, profile.joules]
+        )
+    )
+    return {
+        "bits_fsum_minus_property": bit_sum - profile.bits,
+        "energy_component_fsum_minus_joules": component_sum - profile.joules,
+        "finite": finite,
+        "nonnegative_bits": all(value >= 0.0 for value in profile.score.bits.values()),
+        "nonnegative_energy_components": all(value >= 0.0 for value in profile.energy_components.values()),
+        "useful_time_not_above_decoding_time": useful_ok,
+        "rf_cap_hits_not_above_transmissions": profile.rf_cap_hits <= profile.rf_transmission_observations,
+    }
+
+
+def quantile(values, probability):
+    ordered = sorted(values)
+    if len(ordered) == 1:
+        return ordered[0]
+    position = probability * (len(ordered) - 1)
+    lower = math.floor(position)
+    upper = math.ceil(position)
+    if lower == upper:
+        return ordered[lower]
+    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)
+
+
+def describe(values):
+    return {
+        "count": len(values),
+        "min": min(values),
+        "p01": quantile(values, 0.01),
+        "p05": quantile(values, 0.05),
+        "p25": quantile(values, 0.25),
+        "median": quantile(values, 0.50),
+        "p75": quantile(values, 0.75),
+        "p95": quantile(values, 0.95),
+        "p99": quantile(values, 0.99),
+        "max": max(values),
+        "mean": statistics.fmean(values),
+        "population_sd": statistics.pstdev(values),
+        "negative": sum(value < 0.0 for value in values),
+        "zero": sum(value == 0.0 for value in values),
+        "positive": sum(value > 0.0 for value in values),
+    }
+
+
+def summarize(rows, key):
+    entries = [row["comparisons"][key] for row in rows]
+    per_user = [
+        value
+        for entry in entries
+        for value in entry["per_user_bits_batch_minus_scalar"].values()
+    ]
+    return {
+        "network_bits_batch_minus_scalar": describe([entry["bits_batch_minus_scalar"] for entry in entries]),
+        "kappa_units_batch_minus_scalar": describe([entry["kappa_units_batch_minus_scalar"] for entry in entries]),
+        "joules_batch_minus_scalar": describe([entry["joules_batch_minus_scalar"] for entry in entries]),
+        "per_user_bits_batch_minus_scalar": describe(per_user),
+        "binary64_equal_counts": {
+            name: sum(entry["binary64"][name] for entry in entries)
+            for name in ("network_bits", "joules", "per_user_bits_vector", "all_requested")
+        },
+    }
+
+
+def first_intermediate_probe(engine, tape, setting, run_setting, base):
+    scalar = make_evaluator(engine, tape, setting, run_setting, 0, base, "nominal", (0,))
+    scalar_profile = scalar.evaluate(base)
+    one = make_evaluator(engine, tape, setting, run_setting, 0, base, "nominal", (0,))
+    one.evaluate_many((base,))
+    one_profile = one.evaluate(base)
+    shared = scalar._shared[base.configuration_id]
+    duration_s = 47 * 0.640
+    first_rates = {str(user): shared.integrated[0].user_rates_bps[user] for user in shared.integrated[0].user_rates_bps}
+    last_rates = shared.integrated[-1].user_rates_bps
+    one_held_rates = {str(user): one_profile.score.bits[user] / duration_s for user in one_profile.score.bits}
+    return {
+        "configuration_id": base.configuration_id,
+        "requested_boundary_indices": [0],
+        "scalar_integrated_boundary_count": len(shared.integrated),
+        "batch_boundary_count": 1,
+        "held_duration_s": duration_s,
+        "scalar_first_boundary_rate_bps": first_rates,
+        "batch_held_rate_bps": one_held_rates,
+        "max_abs_first_rate_minus_batch_held_rate_bps": max(
+            abs(first_rates[str(user)] - one_held_rates[str(user)]) for user in one_profile.score.bits
+        ),
+        "users_whose_scalar_boundary47_rate_differs_from_boundary0": sum(
+            last_rates[user] != shared.integrated[0].user_rates_bps[user]
+            for user in last_rates
+        ),
+        "scalar_physical_evaluations": scalar.physical_evaluations,
+        "batch_physical_evaluations": one.physical_evaluations,
+        "resulting_network_bits_difference": one_profile.bits - scalar_profile.bits,
+        "resulting_joules_difference": one_profile.joules - scalar_profile.joules,
+    }
+
+
+def main():
+    engine = load_engine()
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+
+    started = time.perf_counter()
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="eval-path-forensics"),
+        steps=max(ANCHORS) + 1,
+        start_time_s=0.0,
+    )
+    setting = engine._setting("a-r0")
+    run_setting = engine.run_setting_for("a-r0")
+    anchor_inputs = []
+    for step in ANCHORS:
+        base = engine._base_configuration(tape, step, engine.REFERENCE_CARRIERS[0])
+        catalogue, census = engine._catalogue_with_census(
+            tape, step, base, setting=setting, calibration=None, run_setting=run_setting
+        )
+        anchor_inputs.append((step, base, choose_rows(catalogue), len(catalogue), census))
+        print(json.dumps({"phase": "catalogue", "step": step, "size": len(catalogue)}), flush=True)
+
+    first_step, first_base, first_configs, _, _ = anchor_inputs[0]
+    scalar_realised = make_evaluator(engine, tape, setting, run_setting, first_step, first_base, "realised", FULL_BOUNDARIES)
+    kappa = scalar_realised.evaluate(first_base).bits / len(first_base.assignments)
+    rows = []
+    consistency_failures = []
+    occupancy_counts = {}
+
+    for step, base, configs, catalogue_size, census in anchor_inputs:
+        evaluators = {
+            "scalar_nominal": make_evaluator(engine, tape, setting, run_setting, step, base, "nominal", (0,)),
+            "batch_nominal_boundary0": make_evaluator(engine, tape, setting, run_setting, step, base, "nominal", (0,)),
+            "batch_nominal_full48": make_evaluator(engine, tape, setting, run_setting, step, base, "nominal", FULL_BOUNDARIES),
+            "scalar_realised": make_evaluator(engine, tape, setting, run_setting, step, base, "realised", FULL_BOUNDARIES),
+            "batch_realised_full48": make_evaluator(engine, tape, setting, run_setting, step, base, "realised", FULL_BOUNDARIES),
+        }
+        evaluators["batch_nominal_boundary0"].evaluate_many(configs)
+        evaluators["batch_nominal_full48"].evaluate_many(configs)
+        evaluators["batch_realised_full48"].evaluate_many(configs)
+        for config in configs:
+            profiles = {name: evaluator.evaluate(config) for name, evaluator in evaluators.items()}
+            occupancy_counts[str(config.changed_users)] = occupancy_counts.get(str(config.changed_users), 0) + 1
+            checks = {name: consistency(profile) for name, profile in profiles.items()}
+            for name, check in checks.items():
+                if not all(value is True or value == 0.0 for value in check.values()):
+                    consistency_failures.append({"step": step, "configuration_id": config.configuration_id, "path": name, "check": check})
+            rows.append({
+                "anchor_step": step,
+                "catalogue_size": catalogue_size,
+                "catalogue_census": census,
+                "configuration_id": config.configuration_id,
+                "same_configuration_object_id_within_process": id(config),
+                "changed_users": config.changed_users,
+                "kind": config.kind,
+                "assignments": [[user, None if identity is None else list(identity)] for user, identity in config.assignments],
+                "profiles": {name: profile_payload(profile) for name, profile in profiles.items()},
+                "comparisons": {
+                    "nominal_boundary0_vs_scalar": comparison(profiles["batch_nominal_boundary0"], profiles["scalar_nominal"], kappa),
+                    "nominal_full48_vs_scalar": comparison(profiles["batch_nominal_full48"], profiles["scalar_nominal"], kappa),
+                    "realised_full48_vs_scalar": comparison(profiles["batch_realised_full48"], profiles["scalar_realised"], kappa),
+                },
+                "internal_consistency": checks,
+            })
+        print(json.dumps({"phase": "evaluated", "step": step, "rows_total": len(rows)}), flush=True)
+
+    result = {
+        "diagnostic_status": "DIAGNOSTIC_NOT_CLAIM",
+        "command_contract": {
+            "interpreter": sys.executable,
+            "anchors": list(ANCHORS),
+            "rows_per_anchor": ROWS_PER_ANCHOR,
+            "field_comparisons": ["nominal", "realised"],
+            "boundary_comparisons": [[0], list(FULL_BOUNDARIES)],
+        },
+        "provenance": {
+            "engine_path": str(ENGINE_PATH),
+            "engine_sha256": sha256(ENGINE_PATH),
+            "world_domain": repr(DEVELOPMENT_WORLD_DOMAINS[0]),
+            "tape_protocol_repr": repr(tape.protocol),
+        },
+        "calibration": {
+            "definition": "realised scalar base bits at step 0 divided by user count",
+            "kappa_bits_per_user_step": kappa,
+        },
+        "sample": {
+            "configuration_count": len(rows),
+            "anchor_count": len(ANCHORS),
+            "occupancy_changed_users_counts": occupancy_counts,
+        },
+        "summary": {
+            key: summarize(rows, key)
+            for key in ("nominal_boundary0_vs_scalar", "nominal_full48_vs_scalar", "realised_full48_vs_scalar")
+        },
+        "first_intermediate_divergence": first_intermediate_probe(engine, tape, setting, run_setting, first_base),
+        "internal_consistency_failure_count": len(consistency_failures),
+        "internal_consistency_failures": consistency_failures,
+        "elapsed_seconds": time.perf_counter() - started,
+        "comparisons": rows,
+    }
+    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)
+    OUTPUT_PATH.write_text(json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="utf-8")
+    print(json.dumps({"phase": "complete", "output": str(OUTPUT_PATH), "rows": len(rows), "elapsed_seconds": result["elapsed_seconds"]}), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
