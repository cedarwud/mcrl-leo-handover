    98	def build_shared_tape(
    99	    architecture: str,
   100	    geometry_samples: Sequence[tuple[float, Geometry]],
   101	    inventory: HardwareInventory,
   102	    *,
   103	    config: RadiationConfig = RadiationConfig(),
   104	    field: FieldKind = "realised",
   105	    roster: Sequence[int] | None = None,
   106	    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
   107	) -> SharedArchitectureTape:
   108	    """Build one 48-boundary tape and its separately named terminal snapshot."""
   109	
   110	    engine = architecture_for(architecture)
   111	    boundaries = tuple(
   112	        RadiationBoundary(
   113	            time_s,
   114	            resolve_configuration(
   115	                engine,
   116	                config,
   117	                geometry,
   118	                rate_model("ACM"),
   119	                inventory,
   120	                duration_s=1.0,
   121	                field=field,
   122	            ).radiation,
   123	        )
   124	        for time_s, geometry in geometry_samples
   125	    )
   126	    if len(boundaries) != 48:
   127	        raise MCRLContractError("shared integrated tape needs 48 D2 boundaries")
   128	    users = tuple(
   129	        sorted(
   130	            set(roster or ())
   131	            | {link.user_id for _, geometry in geometry_samples for link in geometry.links}
   132	        )
   133	    )
   134	    if any(not boundary.radiation.valid for boundary in boundaries):
   135	        # Keep the invalid certificate in memory for diagnostics but never
   136	        # synthesize a zero-effect cell from it.
   137	        return SharedArchitectureTape(
   138	            architecture,
   139	            inventory,
   140	            boundaries,
   141	            boundaries[-1],
   142	            users,
   143	            circuit_power_per_active_chain_w,
   144	        )
   145	    return SharedArchitectureTape(
   146	        architecture,
   147	        inventory,
   148	        boundaries,
   149	        boundaries[0],
   150	        users,
   151	        circuit_power_per_active_chain_w,
   152	    )
