  1297	def _repair_profile(base, proposed, evaluator):
  1298	    if proposed.configuration_id not in evaluator._invalid:
  1299	        evaluator.evaluate_many((proposed,))
  1300	    if proposed.configuration_id not in evaluator._invalid:
  1301	        return proposed, 0
  1302	    mapping = proposed.mapping
  1303	    repairs = 0
  1304	    for user in sorted(mapping):
  1305	        if mapping[user] == base.mapping[user]:
  1306	            continue
  1307	        mapping[user] = base.mapping[user]
  1308	        repairs += 1
  1309	        candidate = ENGINE._configuration(base, mapping, kind="pilot-deterministic-repair")
  1310	        evaluator.evaluate_many((candidate,))
  1311	        if candidate.configuration_id not in evaluator._invalid:
  1312	            return candidate, repairs
  1313	    return base, repairs
