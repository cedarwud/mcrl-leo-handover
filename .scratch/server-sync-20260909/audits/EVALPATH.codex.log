   902	            bits = 9.0 * energy
   903	        return StepOutcome(
   904	            bits=bits, energy_components_j={"total": energy}, user_ids=(0,),
   905	            profile=(self.action,), complete_service=(True,), decoding_user_seconds=1.0,
   906	            useful_user_seconds=1.0, opportunity_user_seconds=1.0, jointly_legal=True,
   907	            coordinator_latency_s=0.001,
   908	            selected_profile_differs_from_additive=arm == "FULL",
   909	            rejected_harmful_joint_move=arm == "FULL",
