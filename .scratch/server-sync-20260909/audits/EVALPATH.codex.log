   178	def _metrics(full: AdditiveTotals, drop: AdditiveTotals) -> dict[str, float | None]:
   179	    full_ee = _ratio(full.bits, full.joules)
   180	    drop_ee = _ratio(drop.bits, drop.joules)
   181	    ee_relative = (
   182	        None if full_ee is None or drop_ee in (None, 0.0) else full_ee / drop_ee - 1.0
   183	    )
   184	    full_availability = _ratio(full.complete_num, full.complete_den)
   185	    drop_availability = _ratio(drop.complete_num, drop.complete_den)
   186	    availability_difference = (
   187	        None
   188	        if full_availability is None or drop_availability is None
   189	        else full_availability - drop_availability
   190	    )
   191	    full_handover = _ratio(full.handover_num, full.handover_den)
   192	    drop_handover = _ratio(drop.handover_num, drop.handover_den)
   193	    handover_relative = (
   194	        None if full_handover is None or drop_handover is None
   195	        else (0.0 if full_handover == 0.0 and drop_handover == 0.0
   196	              else None if drop_handover == 0.0
   197	              else full_handover / drop_handover - 1.0)
   198	    )
   199	    full_phi = _ratio(full.phi_num, full.phi_den)
   200	    drop_phi = _ratio(drop.phi_num, drop.phi_den)
   201	    phi_relative = (
   202	        None if full_phi is None or drop_phi is None
   203	        else (0.0 if full_phi == 0.0 and drop_phi == 0.0
   204	              else None if drop_phi == 0.0
   205	              else full_phi / drop_phi - 1.0)
   206	    )
   207	    return {
   208	        "ee_relative": ee_relative,
   209	        "availability_difference": availability_difference,
   210	        "handover_relative": handover_relative,
   211	        "phi_cost_relative": phi_relative,
   212	    }
   213	
   214	
   215	def _interval(values: Sequence[float]) -> tuple[float, float] | None:
   216	    if not values:
   217	        return None
   218	    lower, upper = np.quantile(
   219	        np.asarray(values, dtype=np.float64), [0.025, 0.975], method="linear"
   220	    )
   420	        "oracle_positive_by_route": dict(oracle_positive_by_route),
   421	        "qos_pass": qos_pass,
   422	        "genuine_joint_headroom": genuine_joint_headroom,
   423	        "s0_relative_gain": s0_relative_gain,
   424	        "zero_bit_disposition_sealed": zero_bit_disposition_sealed,
   425	    }
   426	
   427	
   428	def claim_decision(contrasts: Mapping[str, Mapping[str, object]]) -> dict[str, object]:
   429	    per_contrast: dict[str, bool] = {}
   430	    for arm in DROP_ARMS:
   431	        result = contrasts.get(arm)
   432	        if result is None:
   433	            per_contrast[arm] = False
   434	            continue
   435	        primary = result["bootstrap"]
   436	        if primary.get("status") != "OK":
   437	            per_contrast[arm] = False
   438	            continue
   439	        intervals = primary["central_95_percentile_intervals"]
   440	        undefined = primary["undefined_draws"]
   441	        ee = intervals["ee_relative"]
   442	        availability = intervals["availability_difference"]
   443	        handover = intervals["handover_relative"]
   444	        phi = intervals["phi_cost_relative"]
   445	        per_contrast[arm] = bool(
   446	            ee is not None
   447	            and availability is not None
   448	            and handover is not None
   449	            and phi is not None
   450	            and not any(undefined.values())
   451	            and ee[0] > EE_MARGIN_RELATIVE
   452	            and availability[0] > AVAILABILITY_MARGIN
   453	            and handover[1] < HANDOVER_RELATIVE_MARGIN
   454	            and phi[1] < PHI_COST_RELATIVE_MARGIN
   455	        )
   456	    c3 = contrasts.get("DROP_C3", {})
   457	    c3_point = c3.get("point_estimates", {}).get("ee_relative") if isinstance(c3, Mapping) else None
   458	    c3_interval = (
   459	        c3.get("bootstrap", {}).get("central_95_percentile_intervals", {}).get("ee_relative")
   460	        if isinstance(c3, Mapping) else None
   461	    )
   462	    if c3_point == 0.0:
   463	        c3_disposition = "TERMINATED_ZERO_MARGINAL_NO_REDESIGN"
   464	    elif c3_interval is not None and c3_interval[1] <= EE_MARGIN_RELATIVE:
   465	        c3_disposition = "NO_PRACTICALLY_RELEVANT_BENEFIT_NO_REDESIGN"
   466	    elif c3_interval is None or c3_interval[0] <= EE_MARGIN_RELATIVE:
   467	        c3_disposition = "INCONCLUSIVE_NO_REDESIGN"
   468	    else:
   469	        c3_disposition = "POSITIVE_C3_CLAIM_ELIGIBLE"
   470	    passed = (
   471	        all(per_contrast.values())
   472	        and set(per_contrast) == set(DROP_ARMS)
   473	        and c3_disposition == "POSITIVE_C3_CLAIM_ELIGIBLE"
   474	    )
   475	    return {
   476	        "decision": "CLAIM_PASS" if passed else "CLAIM_FAIL",
   477	        "per_contrast": per_contrast,
   478	        "wording": (
   479	            "TRAIN-panel conditional intersection-union claim: with the other two "
   480	            "components enabled, each FULL-minus-DROP relative pooled-EE lower "
   481	            "bound exceeds +0.5%, and FULL is QoS non-inferior."
   482	        ),
   483	        "multiplicity": "single prespecified conjunction; no per-contrast inflation",
   484	        "c3_terminal_rule": {
   485	            "disposition": c3_disposition,
   486	            "zero_marginal_ends_positive_claim": True,
   487	            "outcome_contingent_redesign_permitted": False,
   488	        },
   489	    }
   490	
   491	
   492	def infer_cluster_totals(
   493	    clusters: Mapping[tuple[str, int], Mapping[str, AdditiveTotals]],
   494	    *,
   495	    bootstrap_draws: int,
   496	    bootstrap_seed: int,
   497	    include_supplementary: bool = True,
   498	) -> tuple[dict[str, dict[str, object]], dict[str, object]]:
   499	    """Production D2-D4 estimator shared by file merge and synthetic calibration."""
   500	

