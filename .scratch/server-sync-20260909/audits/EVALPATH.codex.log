   235	def _bootstrap(
   380	    )
   381	    covariance_of_mean = np.cov(rows, rowvar=False, ddof=1) / rows.shape[0]
   382	    variance = float(gradient @ covariance_of_mean @ gradient)
   383	    standard_error = sqrt(max(0.0, variance))
   384	    z = NormalDist().inv_cdf(0.975)
   385	    return {
   386	        "status": "OK",
   387	        "estimate": float(estimate),
   388	        "standard_error": standard_error,
   389	        "lower": float(estimate - z * standard_error),
   390	        "upper": float(estimate + z * standard_error),
   391	    }
