   154	
   155	def _rescore_boundary(
   156	    boundary: RadiationBoundary,
   157	    inventory: HardwareInventory,
   158	    setting: PhysicsSetting,
   159	    roster: Sequence[int],
   160	    circuit_power_per_active_chain_w: float,
   161	) -> BoundarySample:
   162	    model = rate_model(setting.rate)
   163	    transmitting_users = {
   164	        transmission.user_id
   165	        for slot in boundary.radiation.slots
   166	        for transmission in slot.transmissions
   167	    }
   168	    users = set(roster) | transmitting_users
   169	    rates = {user: 0.0 for user in users}
   170	    decoded = {user: True for user in users}
   171	    seen = {user: False for user in users}
   172	    for slot in boundary.radiation.slots:
   173	        for transmission in slot.transmissions:
   174	            seen[transmission.user_id] = True
   175	            passed = model.served(transmission.sinr, allocated=True)
   176	            decoded[transmission.user_id] &= passed
   177	            if passed:
   178	                rates[transmission.user_id] += slot.fraction * model.rate_bps(
   179	                    transmission.sinr, transmission.bandwidth_hz
   180	                )
   181	    decoded = {user: decoded[user] and seen[user] for user in users}
   182	    idle = SENSITIVITY_IDLE_POWER_W if setting.standby == "f" else PRIMARY_IDLE_POWER_W
   183	    energy = schedule_energy(
   184	        inventory,
   185	        ((slot.fraction, dict(slot.beam_rf_w)) for slot in boundary.radiation.slots),
   186	        duration_s=1.0,
   187	        idle_power_w=idle,
   188	        circuit_power_per_active_chain_w=circuit_power_per_active_chain_w,
   189	    )
   190	    return BoundarySample(boundary.time_s, rates, energy.joules, decoded)
   191	
   192	
   193	def discontinuities_from_event_ledger(
   194	    tape: SharedArchitectureTape,
   195	    events: Iterable[InterruptionEvent],
   196	    *,
   197	    exact_limits_by_time: Mapping[
   198	        float, tuple[BoundarySample, BoundarySample]
   199	    ] | None = None,
   200	) -> tuple[BoundarySample, ...]:
   201	    """Validate and flatten authentic event-time left/right limits.
   202	
   203	    Provider handovers currently occur at the decision boundary and therefore
   204	    need no interior pair. Any future interior event must carry two provider-
   205	    evaluated samples at that exact instant. A preceding D2 sample is never
   206	    retimestamped as a left limit; missing or mismatched limits fail closed.
   207	    """
   208	
   209	    event_times = sorted(
   210	        {
   211	            float(event.time_s)
   212	            for event in events
   213	            if tape.integrated[0].time_s < event.time_s < tape.integrated[-1].time_s
   214	        }
   215	    )
   216	    if not event_times:
   217	        return ()
   218	    result: list[BoundarySample] = []
   219	    supplied = {} if exact_limits_by_time is None else exact_limits_by_time
   220	    for event_time in event_times:
   221	        limits = supplied.get(event_time)
   222	        if limits is None or len(limits) != 2:
   223	            raise MCRLContractError(
   224	                "interior event lacks authentic left/right limit samples"
   225	            )
   226	        left, right = limits
   227	        if left.time_s != event_time or right.time_s != event_time:
   228	            raise MCRLContractError("event limit samples do not match the ledger instant")
   229	        result.extend((left, right))
   230	    return tuple(result)
   231	
   232	
   233	def score_setting(
   234	    tape: SharedArchitectureTape,
   235	    setting: PhysicsSetting,
   236	    *,
   237	    interruptions: Iterable[InterruptionEvent] = (),
   238	    discontinuities: Iterable[BoundarySample] = (),
   239	) -> CellScore:
   240	    """Rescore a declared cell without recomputing geometry or radiation."""
   241	
   242	    if setting.architecture != tape.architecture:
