    12	    D2_MEASUREMENT_STEP_S,
    13	    D2_SUBINTERVALS,
    14	    DECISION_INTERVAL_S,
    15	    SAME_SATELLITE_INTERRUPTION_S,
    16	    SATELLITE_CHANGE_INTERRUPTION_S,
    17	)
    18	
    19	EventKind = Literal[
    20	    "same_satellite_beam_change",
    21	    "satellite_change",
    22	    "initial_entry",
    23	    "reentry",
    24	]
