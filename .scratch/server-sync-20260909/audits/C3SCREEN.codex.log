    profiles = {}
    for key, config in unique.items():
        profile = evaluator._evaluated.get(key)
        if profile is None:
            raise RuntimeError(f"invalid committed configuration: {key}")
        profiles[key] = profile
    return profiles


def _committed_metric(reference, profile) -> dict:
    attained = profile.score.rate_target_attained
    if attained is None:
        raise RuntimeError("a-r0 committed profile omitted rate-target attainment")
    metric = _metric_payload(reference, profile)
    metric["rate_target_attained_count"] = sum(bool(value) for value in attained.values())
    metric["rate_target_user_count"] = len(attained)
    return metric


def _source_metric(source: Mapping[str, object], re_evaluated: Mapping[str, object]) -> dict:
    """Preserve a standing receipt metric while adding its missing attainment count."""

    if source["configuration_id"] != re_evaluated["configuration_id"]:
        raise RuntimeError("source and re-evaluated configurations differ")
    if json.dumps(source["assignments"], separators=(",", ":")) != json.dumps(
        re_evaluated["assignments"], separators=(",", ":")

def _config_payload(config) -> dict[str, object]:
    return {
        "configuration_id": config.configuration_id,
        "assignments": list(config.assignments),
    }


def _metric_payload(reference, profile) -> dict[str, object]:
    return {
        **_config_payload(profile.config),
        "bits": float(profile.bits),
        "joules": float(profile.joules),
        "ee_bit_per_j": reference.ratio(profile.bits, profile.joules),
        "served_count": reference.served(profile),
    }


