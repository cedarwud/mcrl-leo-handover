#!/usr/bin/env python3
"""Line-oriented adapter to the read-only sealed SEALED/MARGIN_Q evaluators.

The parent sends complete physical assignments on stdin and receives exact
realised outcomes on stdout.  One long-lived child owns one tape and one rule;
there is no process pool and parent plus child use two processes at most.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys


SIBLING = Path(__file__).resolve().parents[2] / "mcrl-v025-harness-ws"
if str(SIBLING) not in sys.path:
    sys.path.insert(0, str(SIBLING))

from harness import sealed as sealed_module  # noqa: E402
from harness import variants as variants_module  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--variant", choices=("SEALED", "MARGIN_Q"), required=True)
    parser.add_argument("--world", required=True)
    parser.add_argument("--steps", type=int, required=True)
    parser.add_argument("--step", type=int, required=True)
    parser.add_argument("--carrier", required=True)
    parser.add_argument("--setting", required=True)
    args = parser.parse_args()

    tree = sealed_module.verify()
    reference = sealed_module.reference_runner()
    variant = variants_module.get(args.variant)
    installed = variant.build(sealed_module)
    reference.probe.evaluate_ar_tdm_catalogue = installed

    from mcrl.physics_v025.provider_legacy import factory
    from mcrl.physics_v025.tapes import build_world_tape

    tape = build_world_tape(
        domain=args.world,
        provider=factory(),
        steps=args.steps,
        start_time_s=0.0,
    )
    probe = reference.probe
    setting = probe._setting(args.setting)
    run_setting = probe.run_setting_for(args.setting)
    base = probe._base_configuration(tape, args.step, args.carrier)
    incumbent = probe._base_configuration(
        tape, max(0, args.step - 1), args.carrier
    )
    evaluator = probe.StepEvaluator(
        tape,
        setting,
        args.step,
        transition_from=incumbent,
        cell_rekeyed_users=probe._rekeyed_users(tape, args.step),
        field="realised",
        run_setting=run_setting,
        fading_quantile_alpha=0.10,
    )
    evaluator_sha256 = hashlib.sha256(
        tree.manifest_sha256.encode("ascii")
        + args.variant.encode("ascii")
        + variant.description.encode("utf-8")
        + variant.source_sha256.encode("ascii")
    ).hexdigest()
    print(
        json.dumps(
            {
                "ready": True,
                "variant": args.variant,
                "sealed_manifest_sha256": tree.manifest_sha256,
                "evaluator_sha256": evaluator_sha256,
                "tape_sha256": tape.digest,
                "run_setting_sha256": run_setting.digest,
                "boundary_indices": list(evaluator.boundary_indices),
                "processes": 1,
            },
            sort_keys=True,
        ),
        flush=True,
    )

    for line in sys.stdin:
        request = json.loads(line)
        assignment = tuple(
            (int(user), None if identity is None else tuple(int(x) for x in identity))
            for user, identity in request["assignment"]
        )
        config = probe._configuration(
            base, dict(assignment), kind=f"c3-panel-{args.variant.lower()}"
        )
        profile = evaluator.evaluate(config)
        print(
            json.dumps(
                {
                    "bits": profile.bits,
                    "joules": profile.joules,
                    "valid": config.configuration_id not in evaluator._invalid,
                },
                sort_keys=True,
                allow_nan=False,
            ),
            flush=True,
        )


if __name__ == "__main__":
    main()
"""Contract tests for the C3 panel instrument (DIAGNOSTIC_NOT_CLAIM)."""

from __future__ import annotations

from fractions import Fraction
from pathlib import Path

import pytest

from mcrl.stagec_v025.c3_panel import (
    ArmPlan,
    PANEL_ARM_ORDER,
    PANEL_LEARNED_ARMS,
    PANEL_SOURCE_MAP,
    PanelTrainer,
    PhysicalCacheKey,
    PhysicalOutcomeCache,
    ScoredConfiguration,
    canonical_assignment,
    degeneracy_report,
    first_improvement,
    provisioning_rule,
    select_then_realise,
)
from mcrl.stagec_v025.canonical import StageCContractError
from mcrl.stagec_v025.learner import (
    ROUTES,
    build_pairwise_batches,
    default_synthetic_neutral_sources,
)
from mcrl.stagec_v025.shards import write_source_shard
from mcrl.stagec_v025.state import extract_source_rows
from mcrl.stagec_v025.synthetic import (
    _synthetic_coalition_batch,
    make_synthetic_anchors,
)


HEX = "a" * 64


def _assignment(value: int):
    return canonical_assignment({0: (100 + value, 10 + value)})


def _plan(arm: str, selected: int = 1) -> ArmPlan:
    return ArmPlan(
        arm=arm,
        seed=_assignment(0),
        catalogue=(
            ScoredConfiguration(_assignment(0), 0.0),
            ScoredConfiguration(_assignment(selected), 1.0),
        ),
        first_improvement_used=True,
    )


def _key(_arm: str, assignment) -> PhysicalCacheKey:
    return PhysicalCacheKey(
        tape_sha256=HEX,
        world_id="V025_PROBE/world/1",
        decision_time_ns=0,
        assignment=assignment,
        physical_setting_sha256=HEX,
        run_setting_sha256=HEX,
        evaluator_sha256=HEX,
        field="realised",
        boundary_indices=(0, 1),
        transition_sha256=HEX,
        prefix_history_sha256=HEX,
    )


def test_arm_inventory_is_complete_binary_factorial_plus_external_control() -> None:
    assert len(PANEL_LEARNED_ARMS) == 8
    assert len(PANEL_ARM_ORDER) == 9
    assert set(tuple(PANEL_SOURCE_MAP[arm][route] for route in ROUTES) for arm in PANEL_LEARNED_ARMS) == {
        tuple("informed" if mask & (1 << index) else "neutral" for index in range(3))
        for mask in range(8)
    }


def test_every_learned_arm_retains_updates_and_deploys_every_head(tmp_path: Path) -> None:
    rows = tuple(
        row
        for anchor in make_synthetic_anchors()
        for row in extract_source_rows(anchor)
    )
    source = write_source_shard(tmp_path / "source.jsonl", rows)
    pairs = build_pairwise_batches((source,))
    c3, _shard = _synthetic_coalition_batch(tmp_path, rows)
    trainer = PanelTrainer(
        learner_seed=17,
        q1_batch=pairs["C1"],
        q2_batch=pairs["C2"],
        c3_batch=c3,
        neutral_sources=default_synthetic_neutral_sources(),
    )
    trainer.train(2)
    receipt = trainer.deployment_receipt()
    assert receipt["all_learned_arms_retain_update_deploy_all_heads"] is True
    assert all(
        receipt["head_updates"][arm] == {"C1": 2, "C2": 2, "C3": 2}
        for arm in PANEL_LEARNED_ARMS
    )
    assert all(set(model.payload()) == set(ROUTES) for model in trainer.models.values())


def test_ordered_search_is_first_improvement_not_best_improvement() -> None:
    rows = {value: ScoredConfiguration(_assignment(value), float(value)) for value in range(4)}
    path = {
        rows[0].digest: (rows[1], rows[3]),
        rows[1].digest: (rows[2],),
        rows[2].digest: (),
        rows[3].digest: (),
    }
    selected, accepted = first_improvement(rows[0], lambda row: path[row.digest])
    assert selected == rows[2]
    assert accepted == 2
    assert selected != rows[3]  # best-improvement's first choice


def test_panel_selection_uses_unilateral_first_improvement_to_fixed_point() -> None:
    # Catalogue order offers score 1 before score 3.  First-improvement must
    # take that move and then its score-2 neighbour; a global argmax would
    # incorrectly jump directly to score 3.
    seed = canonical_assignment({0: (100, 10), 1: (200, 20)})
    first = canonical_assignment({0: (101, 11), 1: (200, 20)})
    fixed = canonical_assignment({0: (101, 11), 1: (201, 21)})
    global_best = canonical_assignment({0: (102, 12), 1: (202, 22)})
    plans = []
    for arm in PANEL_ARM_ORDER:
        plans.append(
            ArmPlan(
                arm,
                seed,
                (
                    ScoredConfiguration(seed, 0.0),
                    ScoredConfiguration(first, 1.0),
                    ScoredConfiguration(fixed, 2.0),
                    ScoredConfiguration(global_best, 3.0),
                ),
                True,
            )
        )
    receipt = select_then_realise(
        tuple(plans),
        key_for=_key,
        evaluate=lambda _key: {},
        cache=PhysicalOutcomeCache(),
    )
    assert all(value == fixed for value in receipt["selected"].values())


def test_shared_physical_cache_cannot_leak_into_selection() -> None:
    plans = tuple(_plan(arm, selected=1 if index < 5 else 2) for index, arm in enumerate(PANEL_ARM_ORDER))
    key_calls = 0

    class BarrierCache(PhysicalOutcomeCache[dict]):
        def realise(self, key, evaluate):
            # If realisation is moved inside the per-arm selection loop this
            # test fails on the first arm, before all nine keys exist.
            assert key_calls == len(PANEL_ARM_ORDER)
            return super().realise(key, evaluate)

    cache = BarrierCache()

    def key_for(arm, assignment):
        nonlocal key_calls
        key_calls += 1
        return _key(arm, assignment)

    receipt = select_then_realise(
        plans,
        key_for=key_for,
        evaluate=lambda key: {"poison": -10_000 if key.assignment == _assignment(1) else 10_000},
        cache=cache,
    )
    assert receipt["selection_completed_before_cache_lookups"] is True
    assert receipt["union_realised_configurations"] == 2
    assert receipt["cache_misses"] == 2
    assert all(receipt["selected"][arm] == plans[index].catalogue[1].assignment for index, arm in enumerate(PANEL_ARM_ORDER))

    unsealed = PhysicalOutcomeCache()
    with pytest.raises(StageCContractError, match="before all selections sealed"):
        unsealed.realise(_key("FULL", _assignment(1)), lambda _key: {})


def test_physical_cache_key_binds_every_declared_context_dimension() -> None:
    base = _key("FULL", _assignment(1))
    mutations = {
        "tape_sha256": "b" * 64,
        "world_id": "V025_PROBE/world/2",
        "decision_time_ns": 1,
        "assignment": _assignment(2),
        "physical_setting_sha256": "b" * 64,
        "run_setting_sha256": "b" * 64,
        "evaluator_sha256": "b" * 64,
        "field": "nominal",
        "boundary_indices": (0,),
        "transition_sha256": "b" * 64,
        "prefix_history_sha256": "b" * 64,
    }
    payload = {field: getattr(base, field) for field in mutations}
    for field, value in mutations.items():
        changed = {**payload, field: value}
        # Fill fields that are not in the mutation table from the base.
        for name in base.__dataclass_fields__:
            changed.setdefault(name, getattr(base, name))
        assert PhysicalCacheKey(**changed).digest != base.digest


def test_degeneracy_screen_is_exact_sign_reporting_not_filtering() -> None:
    anchors = (
        {
            "anchor_id": "a0",
            "reference": {
                "bits": Fraction(10), "joules": Fraction(2),
                "head_independent": True, "fixed_point_certified": True,
                "certificate_sha256": HEX,
            },
            "outcomes": {
                "FULL": {"bits": Fraction(11), "joules": Fraction(2)},
                "DROP_C1": {"bits": Fraction(9), "joules": Fraction(2)},
            },
        },
        {
            "anchor_id": "a1",
            "reference": {
                "bits": Fraction(10), "joules": Fraction(2),
                "head_independent": True, "fixed_point_certified": True,
                "certificate_sha256": HEX,
            },
            "outcomes": {
                "FULL": {"bits": Fraction(10), "joules": Fraction(2)},
                "DROP_C1": {"bits": Fraction(12), "joules": Fraction(2)},
            },
        },
    )
    report = degeneracy_report(anchors, (("FULL-minus-DROP_C1", "FULL", "DROP_C1"),))
    contrast = report["contrasts"]["FULL-minus-DROP_C1"]
    assert report["role"] == "REPORTING_ONLY_NOT_A_FILTER"
    assert report["anchors_retained"] == 2
    assert report["below_reference"]["a0"] == {"FULL": False, "DROP_C1": True}
    assert report["per_arm"]["DROP_C1"]["below_reference_count"] == 1
    assert report["per_arm"]["DROP_C1"]["below_reference_fraction"] == 0.5
    assert report["per_arm"]["DROP_C1"]["shortfall_bits_per_j"] == [0.5]
    assert contrast["all_anchor"]["anchor_count"] == 2
    assert contrast["all_arms_at_or_above_reference"]["anchor_ids"] == ["a1"]


def test_degeneracy_screen_rejects_uncertified_reference() -> None:
    with pytest.raises(StageCContractError, match="fixed-point certificate"):
        degeneracy_report(
            ({
                "anchor_id": "a0",
                "reference": {"bits": 10, "joules": 2},
                "outcomes": {"FULL": {"bits": 10, "joules": 2}},
            },),
            (),
        )


def test_both_provisioning_rules_are_named_and_no_third_rule_is_accepted() -> None:
    assert provisioning_rule("SEALED") == "SEALED"
    assert provisioning_rule("MARGIN_Q") == "MARGIN_Q"
    with pytest.raises(StageCContractError):
        provisioning_rule("POSTHOC")

codex
A key implementation detail is now explicit: the built harness is an instrument, not a production CLI, and it does not itself define a validation split or emit served/rate-target fields. I’m adding only a workspace-local screening driver around it: the smoke’s two exact anchors will be used deterministically as one training anchor and one held-out validation anchor, with the first anchor also serving as the single panel tier anchor. That preserves the smallest branch-exercising anchor inventory while making the requested validation curves meaningful; the report will flag this interpretation and the inherited harness unsoundness.
