class EngineCapture:
    def __init__(self, engine: object) -> None:
        self._engine = engine
        self.forecasts = None
        self.phi_calls_with_rekey_context = 0

    def __getattr__(self, name: str):
        return getattr(self._engine, name)

    def _batched_stage2_forecasts(self, **kwargs):
        result = self._engine._batched_stage2_forecasts(**kwargs)
        self.forecasts = result[0]
        return result

    def _phi_for(self, *args, **kwargs):
        if "cell_rekeyed_users" in kwargs:
            self.phi_calls_with_rekey_context += 1
        return self._engine._phi_for(*args, **kwargs)


def exact_nonfallback_builder(capture: EngineCapture):
    """Execute the existing dispatcher's non-fallback branch privately."""

    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("PILOT_PRIMITIVE_SOURCE_FALLBACK was not found unchanged")
    namespace = dict(pilot._build_anchor_rows.__globals__)
    namespace["PILOT_PRIMITIVE_SOURCE_FALLBACK"] = False
    namespace["ENGINE"] = capture
    return FunctionType(
        pilot._build_anchor_rows.__code__,
        namespace,
        name="_build_anchor_rows_nonfallback_c3_panel_smoke",
        argdefs=pilot._build_anchor_rows.__defaults__,
        closure=pilot._build_anchor_rows.__closure__,
    )


def calibration() -> pilot.PilotCalibration:
    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
    fraction = lambda name: Fraction(*payload[name])
    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
        bits_ref=fraction("bits_ref"),
        joules_ref=fraction("joules_ref"),
        users=int(payload["users"]),
    )


def _row_key(row) -> tuple[int, int | None, int | None]:
    return row.user_id, row.action.norad_id, row.action.beam_chain_id


def assert_exact_targets(built: dict, forecasts: dict, cal) -> dict[str, int]:
    base = built["base"]
    incumbent = built["incumbent"]
    current = built["current_evaluator"]
    base_profile = current.evaluate(base)
    base_forecasts = forecasts[base.configuration_id]
    flags = labels = outages = 0
    for row in built["rows"]:
        mapping = base.mapping
        mapping[row.user_id] = pilot._identity(row.action)
        config = pilot.ENGINE._configuration(base, mapping, kind="c3-panel-assertion")
        profile = current.evaluate(config)
        projections = forecasts[config.configuration_id]
        for offset, projection in enumerate(projections):
            assert bool(row.q2_state[10 + 4 * offset]) is projection.valid
            assert bool(row.q2_state[11 + 4 * offset]) is projection.survives
            flags += 2

        candidate_phi = pilot.ENGINE._phi_for(
            incumbent,
            config,
            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
                pilot.ENGINE._WORKER_TAPE if hasattr(pilot.ENGINE, "_WORKER_TAPE") else current.tape,
                current.step_index,
            ),
        )
        base_phi = pilot.ENGINE._phi_for(
            incumbent,
            base,
            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
                pilot.ENGINE._WORKER_TAPE if hasattr(pilot.ENGINE, "_WORKER_TAPE") else current.tape,
                current.step_index,
            ),
        )
        c1 = c1_difference_surplus(
            NetworkOutcome.build(
                bits=profile.bits,
                joules=profile.joules,
                phi=candidate_phi,
                decoding_availability=1.0,
                useful_availability=1.0,
            ),
            NetworkOutcome.build(
                bits=base_profile.bits,
                joules=base_profile.joules,
                phi=base_phi,
                decoding_availability=1.0,
                useful_availability=1.0,
            ),
            lambda_bits_per_j=cal.lambda_bits_per_j,
            eta_ref=cal.eta_ref,
            kappa_bits_per_user_step=cal.kappa_bits_per_user_step,
        )
        assert float.fromhex(row.c1_label_bits_hex) == float(c1.difference_surplus_bits)
        assert float.fromhex(row.c1_phi_difference_hex) == float(c1.phi_difference)
        labels += 1

        c2 = c2_persistence_forecast(
            projections,
            base_forecasts,
            lambda_bits_per_j=cal.lambda_bits_per_j,
            eta_ref=cal.eta_ref,
            kappa_bits_per_user_step=cal.kappa_bits_per_user_step,
        )
        expected_c2 = float(c2.forecast_surplus_bits - c2.persistence_penalty_bits)
        assert float.fromhex(row.c2_label_bits_hex) == expected_c2
        labels += 1
        assert row.outage is (not bool(profile.score.served_phy.get(row.user_id, False)))
        outages += 1
    return {
        "validity_survival_assertions": flags,
        "production_target_label_assertions": labels,
        "exact_outage_assertions": outages,
    }


def surrogate_differences(exact_builds, primitive_builds) -> dict[str, int]:
    variant = active_encoder_variant()
    q1 = {feature.name: index for index, feature in enumerate(variant.q1_features)}
    q2 = {feature.name: index for index, feature in enumerate(variant.q2_features)}
    groups = {
        "current_margin": ("q1", (q1["nominal_sinr_margin_at_rate_target"], q2["candidate_current_nominal_decoding_margin"])),
        "required_power": ("mixed", (q1["nominal_required_power_over_cap"], q2["required_power_cap_margin"])),
        "previous_beam_rf": ("q1", (q1["previous_beam_max_rf_over_cap"],)),
        "current_acm_se": ("q1", (q1["nominal_mode_spectral_efficiency"],)),
        "forecast_margin": ("q2", tuple(q2[f"offset_{offset}_minimum_decoding_margin"] for offset in (1, 2, 3))),
        "forecast_acm_se": ("q2", tuple(q2[f"offset_{offset}_mean_acm_spectral_efficiency"] for offset in (1, 2, 3))),
        "forecast_se_trend": ("q2", (q2["forecast_se_trend"],)),
    }
    counts = {name: 0 for name in (*groups, "validity_survival", "c1_label", "c1_phi", "c2_label", "outage", "coalition_identity")}
    for exact, primitive in zip(exact_builds, primitive_builds, strict=True):
        exact_rows = {_row_key(row): row for row in exact["rows"]}
        primitive_rows = {_row_key(row): row for row in primitive["rows"]}
        for key in exact_rows.keys() & primitive_rows.keys():
            left, right = exact_rows[key], primitive_rows[key]
            for name, (where, indices) in groups.items():
                if where == "q1":
                    differs = any(left.q1_state[index] != right.q1_state[index] for index in indices)
                elif where == "q2":
                    differs = any(left.q2_state[index] != right.q2_state[index] for index in indices)
                else:
                    differs = (
                        left.q1_state[indices[0]] != right.q1_state[indices[0]]
                        or left.q2_state[indices[1]] != right.q2_state[indices[1]]
                    )
                counts[name] += int(differs)
            counts["validity_survival"] += int(any(
                left.q2_state[q2[f"offset_{offset}_{field}"]] != right.q2_state[q2[f"offset_{offset}_{field}"]]
                for offset in (1, 2, 3) for field in ("valid", "survival")
            ))
            counts["c1_label"] += int(left.c1_label_bits_hex != right.c1_label_bits_hex)
            counts["c1_phi"] += int(left.c1_phi_difference_hex != right.c1_phi_difference_hex)
            counts["c2_label"] += int(left.c2_label_bits_hex != right.c2_label_bits_hex)
            counts["outage"] += int(left.outage != right.outage)
        exact_members = tuple(
            (member.user_id, member.selected_action.payload())
            for member in exact["coalition_row"].context.members
        )
        primitive_members = tuple(
            (member.user_id, member.selected_action.payload())
            for member in primitive["coalition_row"].context.members
        )
        counts["coalition_identity"] += int(exact_members != primitive_members)
    # This development world's sampled steps contain no rekey events, so the
    # rekey-aware and rekey-blind Phi values coincide.  The exact call-path
    # assertion is counted separately by EngineCapture.
    missing = [name for name, count in counts.items() if count == 0 and name != "c1_phi"]
    if missing:
        raise AssertionError(f"real-anchor exact/surrogate difference was not witnessed for {missing}")
    return counts


def _score(model, built, base, selected, tape, step_index: int) -> float:
    rows = built["rows_by_user_action"]
    total = 0.0
    for user in sorted(base.mapping):
        candidate = rows[(user, selected.mapping[user])]
        reference = rows[(user, base.mapping[user])]
        total += model.q1.score(candidate.q1_state) - model.q1.score(reference.q1_state)
        total += model.q2.score(candidate.q2_state) - model.q2.score(reference.q2_state)
    if selected.assignments != base.assignments:
        context = pilot._coalition_context(
            tape=tape,
            step_index=step_index,
            anchor=base,
            selected=selected,
            rows_by_user_action=rows,
        )
        total += model.interaction(context)
"""C3 neutral-source panel instrument.

This module is deliberately an instrument, not an experiment runner.  It
defines the complete 2^3 learned source factorial, trains every retained head,
keeps arm-owned proposal/catalogue state separate, realises only the union of
selected physical configurations, and reports (never filters) the declared
reference-degeneracy split.
"""

from __future__ import annotations

from dataclasses import dataclass
from fractions import Fraction
import math
from typing import Callable, Generic, Mapping, Sequence, TypeVar

from .canonical import StageCContractError, canonical_sha256
from .learner import (
    AdamMLPHead,
    AdamSetInteractionHead,
    CoalitionBatch,
    NeutralSourceDefinition,
    PairwiseBatch,
    ROUTES,
    Route,
    V1LineageOrchestrator,
    V1ThreeRouteModel,
)


# The listed intervention is the complete binary factorial: eight learned
# arms.  BASELINE is the ninth panel arm and has no learned heads.
PANEL_LEARNED_ARMS = (
    "FULL",
    "DROP_C1",
    "DROP_C2",
    "DROP_C3",
    "ONLY_C1",
    "ONLY_C2",
    "ONLY_C3",
    "ALL_NEUTRAL_CONTROL",
)
EXTERNAL_CONTROL = "BASELINE"
PANEL_ARM_ORDER = (*PANEL_LEARNED_ARMS, EXTERNAL_CONTROL)
PANEL_SOURCE_MAP: Mapping[str, Mapping[Route, str]] = {
    "FULL": {"C1": "informed", "C2": "informed", "C3": "informed"},
    "DROP_C1": {"C1": "neutral", "C2": "informed", "C3": "informed"},
    "DROP_C2": {"C1": "informed", "C2": "neutral", "C3": "informed"},
    "DROP_C3": {"C1": "informed", "C2": "informed", "C3": "neutral"},
    "ONLY_C1": {"C1": "informed", "C2": "neutral", "C3": "neutral"},
    "ONLY_C2": {"C1": "neutral", "C2": "informed", "C3": "neutral"},
    "ONLY_C3": {"C1": "neutral", "C2": "neutral", "C3": "informed"},
    "ALL_NEUTRAL_CONTROL": {"C1": "neutral", "C2": "neutral", "C3": "neutral"},
}
PROVISIONING_RULES = ("SEALED", "MARGIN_Q")


def provisioning_rule(name: str) -> str:
    """Validate the named physics rule selected by the command line."""

    if name not in PROVISIONING_RULES:
        raise StageCContractError(
            f"unknown provisioning rule {name!r}; expected one of {PROVISIONING_RULES}"
        )
    return name


class PanelTrainer:
    """Matched initialization and all-head updates for the eight learned arms."""

    def __init__(
        self,
        *,
        learner_seed: int,
        q1_batch: PairwiseBatch,
        q2_batch: PairwiseBatch,
        c3_batch: CoalitionBatch,
        neutral_sources: Mapping[Route, NeutralSourceDefinition],
    ) -> None:
        # Reuse the production initializer and head implementations.  The
        # production five-arm schema is not changed or reinterpreted.
        base = V1LineageOrchestrator(
            learner_seed=learner_seed,
            q1_batch=q1_batch,
            q2_batch=q2_batch,
            c3_batch=c3_batch,
            neutral_sources=neutral_sources,
        )
        template = base.models["FULL"]
        self.learner_seed = int(learner_seed)
        self.initialization_sha256 = base.initialization_sha256
        self.models = {arm: template.clone() for arm in PANEL_LEARNED_ARMS}
        self.informed = {"C1": q1_batch, "C2": q2_batch, "C3": c3_batch}
        self.neutral = {
            "C1": base._neutral_q1,
            "C2": base._neutral_q2,
            "C3": base._neutral_c3,
        }
        self.completed_source_epochs = 0
        self.head_updates = {
            arm: {route: 0 for route in ROUTES} for arm in PANEL_LEARNED_ARMS
        }

    def train_epoch(self) -> dict[str, dict[str, float]]:
        losses = {arm: {} for arm in PANEL_LEARNED_ARMS}
        for arm in PANEL_LEARNED_ARMS:
            model = self.models[arm]
            for route in ROUTES:
                batch = (
                    self.informed[route]
                    if PANEL_SOURCE_MAP[arm][route] == "informed"
                    else self.neutral[route]
                )
                if route == "C1":
                    head = model.q1
                elif route == "C2":
                    head = model.q2
                else:
                    head = model.psi
                if isinstance(head, AdamMLPHead):
                    losses[arm][route] = head.update(batch)  # type: ignore[arg-type]
                elif isinstance(head, AdamSetInteractionHead):
                    losses[arm][route] = head.update(batch)  # type: ignore[arg-type]
                else:  # pragma: no cover - production initializer invariant
                    raise StageCContractError("panel trainer received a non-Adam head")
                self.head_updates[arm][route] += 1
        self.completed_source_epochs += 1
        return losses

    def train(self, epochs: int) -> None:
        if isinstance(epochs, bool) or not isinstance(epochs, int) or epochs <= 0:
            raise StageCContractError("source epoch count must be a positive integer")
        for _ in range(epochs):
            self.train_epoch()

    def deployment_receipt(self) -> dict[str, object]:
        expected = self.completed_source_epochs
        for arm, routes in self.head_updates.items():
            if set(routes) != set(ROUTES) or any(value != expected for value in routes.values()):
                raise StageCContractError(f"{arm} did not update every retained head")
            if set(self.models[arm].payload()) != set(ROUTES):
                raise StageCContractError(f"{arm} does not deploy every retained head")
        return {
            "learned_arms": list(PANEL_LEARNED_ARMS),
            "external_control": EXTERNAL_CONTROL,
            "source_map": {arm: dict(PANEL_SOURCE_MAP[arm]) for arm in PANEL_LEARNED_ARMS},
            "initialization_sha256": self.initialization_sha256,
            "completed_source_epochs": expected,
            "head_updates": self.head_updates,
            "all_learned_arms_retain_update_deploy_all_heads": True,
        }


Assignment = tuple[tuple[int, tuple[int, int] | None], ...]


def canonical_assignment(mapping: Mapping[int, tuple[int, int] | None]) -> Assignment:
    return tuple(sorted((int(user), identity) for user, identity in mapping.items()))


@dataclass(frozen=True, slots=True)
class ScoredConfiguration:
    assignment: Assignment
    nominal_score: float
    eligible: bool = True

    def __post_init__(self) -> None:
        if not math.isfinite(self.nominal_score):
            raise StageCContractError("nominal selection score must be finite")

    @property
    def digest(self) -> str:
        return canonical_sha256({"assignment": self.assignment})


@dataclass(frozen=True, slots=True)
class ArmPlan:
    arm: str
    seed: Assignment
    catalogue: tuple[ScoredConfiguration, ...]
    first_improvement_used: bool

    def __post_init__(self) -> None:
        if self.arm not in PANEL_ARM_ORDER:
            raise StageCContractError(f"unknown panel arm {self.arm}")
        if not self.catalogue:
            raise StageCContractError("an arm-owned catalogue cannot be empty")
        if not self.first_improvement_used:
            raise StageCContractError("every panel arm must declare first-improvement")
        if sum(row.assignment == self.seed for row in self.catalogue) != 1:
            raise StageCContractError(
                "an arm-owned seed must occur exactly once in its own catalogue"
            )
        if not next(row for row in self.catalogue if row.assignment == self.seed).eligible:
            raise StageCContractError("an arm-owned seed must pass the unchanged guards")

    @property
    def seed_sha256(self) -> str:
        return canonical_sha256({"seed": self.seed})

    @property
    def catalogue_sha256(self) -> str:
        return canonical_sha256(
            [
                {
                    "assignment": row.assignment,
                    "nominal_score_hex": row.nominal_score.hex(),
                    "eligible": row.eligible,
                }
                for row in self.catalogue
            ]
        )


def first_improvement(
    initial: ScoredConfiguration,
    neighbours: Callable[[ScoredConfiguration], Sequence[ScoredConfiguration]],
) -> tuple[ScoredConfiguration, int]:
    """Ordered first strict improvement to a fixed point."""

    current = initial
    accepted = 0
    while True:
        for candidate in neighbours(current):
            if candidate.eligible and candidate.nominal_score > current.nominal_score:
                current = candidate
                accepted += 1
                break
        else:
            return current, accepted


@dataclass(frozen=True, slots=True)
class PhysicalCacheKey:
    tape_sha256: str
    world_id: str
    decision_time_ns: int
    assignment: Assignment
    physical_setting_sha256: str
    run_setting_sha256: str
    evaluator_sha256: str
    field: str
    boundary_indices: tuple[int, ...]
    transition_sha256: str
    prefix_history_sha256: str

    def __post_init__(self) -> None:
        for name in (
            "tape_sha256",
            "physical_setting_sha256",
            "run_setting_sha256",
            "evaluator_sha256",
            "transition_sha256",
            "prefix_history_sha256",
        ):
            value = getattr(self, name)
            if len(value) != 64 or any(c not in "0123456789abcdef" for c in value):
                raise StageCContractError(f"physical cache {name} is not a SHA-256")
        if not self.world_id or self.decision_time_ns < 0:
            raise StageCContractError("physical cache world/time context is invalid")
        if self.field not in {"nominal", "margin", "realised"}:
            raise StageCContractError("physical cache field is invalid")
        if not self.boundary_indices or tuple(sorted(set(self.boundary_indices))) != self.boundary_indices:
            raise StageCContractError("physical cache boundaries must be nonempty ordered unique")

    @property
    def digest(self) -> str:
        return canonical_sha256(
            {
                "schema": "mcrl-v025-c3-panel-physical-cache-key-v1",
                "tape_sha256": self.tape_sha256,
                "world_id": self.world_id,
                "decision_time_ns": self.decision_time_ns,
                "assignment": self.assignment,
                "physical_setting_sha256": self.physical_setting_sha256,
                "run_setting_sha256": self.run_setting_sha256,
                "evaluator_sha256": self.evaluator_sha256,
                "field": self.field,
                "boundary_indices": self.boundary_indices,
                "transition_sha256": self.transition_sha256,
                "prefix_history_sha256": self.prefix_history_sha256,
            }
        )


OutcomeT = TypeVar("OutcomeT")


class PhysicalOutcomeCache(Generic[OutcomeT]):
    """Shared physical cache that is unavailable until selection is sealed."""

    def __init__(self) -> None:
        self._rows: dict[str, OutcomeT] = {}
        self._selection_sealed = False
        self.hits = 0
        self.misses = 0

    def begin_selection(self) -> None:
        self._selection_sealed = False

    def seal_selection(self) -> None:
        self._selection_sealed = True

    def realise(
        self, key: PhysicalCacheKey, evaluate: Callable[[PhysicalCacheKey], OutcomeT]
    ) -> OutcomeT:
        if not self._selection_sealed:
            raise StageCContractError("realised outcome cache accessed before all selections sealed")
        if key.digest in self._rows:
            self.hits += 1
            return self._rows[key.digest]
        value = evaluate(key)
        self._rows[key.digest] = value
        self.misses += 1
        return value


def _select(plan: ArmPlan) -> ScoredConfiguration:
    seed = next(row for row in plan.catalogue if row.assignment == plan.seed)

    def unilateral_neighbours(
        current: ScoredConfiguration,
    ) -> tuple[ScoredConfiguration, ...]:
        current_map = dict(current.assignment)
        return tuple(
            row
            for row in plan.catalogue
            if row.eligible
            and row.assignment != current.assignment
            and sum(
                current_map[user] != identity
                for user, identity in row.assignment
            )
            == 1
        )

    # Catalogue order supplies the declared stable order.  Realised outcomes
    # are structurally unavailable until every arm reaches its fixed point.
    selected, _accepted = first_improvement(seed, unilateral_neighbours)
    return selected


def select_then_realise(
    plans: Sequence[ArmPlan],
    *,
    key_for: Callable[[str, Assignment], PhysicalCacheKey],
    evaluate: Callable[[PhysicalCacheKey], OutcomeT],
    cache: PhysicalOutcomeCache[OutcomeT],
) -> dict[str, object]:
    """Select from arm-owned catalogues, then realise the chosen-key union."""

    if tuple(plan.arm for plan in plans) != PANEL_ARM_ORDER:
        raise StageCContractError("panel plans must contain every arm in declared order")
    cache.begin_selection()
    selected = {plan.arm: _select(plan) for plan in plans}
    # This barrier is the anti-leak invariant.  No cache method is called in
    # the selection loop above, and the cache itself rejects such a call.
    cache.seal_selection()
    keys = {arm: key_for(arm, row.assignment) for arm, row in selected.items()}
    realised_by_key = {

exec
