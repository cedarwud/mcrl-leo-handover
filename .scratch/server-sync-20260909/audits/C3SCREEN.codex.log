 succeeded in 0ms:
        total += model.interaction(context)
    return total


def _action_tables(built) -> tuple[UserActionTable, ...]:
    grouped = defaultdict(list)
    for row in built["rows"]:
        grouped[row.user_id].append(row)
    tables = []
    for user, rows in sorted(grouped.items()):
        ordered = tuple(sorted(rows, key=lambda row: row.action_index))
        if tuple(row.action_index for row in ordered) != tuple(range(len(ordered))):
            raise AssertionError("exact source action indices are not contiguous")
        tables.append(
            UserActionTable(
                user,
                tuple(row.action for row in ordered),
                ordered[0].action_mask,
                tuple(row.q1_state for row in ordered),
                tuple(row.q2_state for row in ordered),
            )
        )
    return tuple(tables)


def _arm_owned_plans(*, trainer, built, tape, setting, run_setting, calibration):
    """Connect each trained model to its production proposal and bounded catalogue."""

    tables = _action_tables(built)
    carrier_base = built["base"]
    incumbent = built["incumbent"]

    def configuration(profile, kind):
        mapping = {
            table.user_id: (
                None
                if table.actions[index].is_null
                else (
                    table.actions[index].norad_id,
                    table.actions[index].beam_chain_id,
                )
            )
            for table, index in zip(tables, profile, strict=True)
        }
        return pilot.ENGINE._configuration(carrier_base, mapping, kind=kind)

    plans = []
    diagnostics = {}
    for arm in PANEL_LEARNED_ARMS:
        model = trainer.models[arm]
        proposal = tuple(
            masked_argmax(
                tuple(
                    model.score("C1", q1) + model.score("C2", q2)
                    for q1, q2 in zip(
                        table.q1_states, table.q2_states, strict=True
                    )
                ),
                table.action_mask,
            )
            for table in tables
        )
        proposal_config = configuration(proposal, f"c3-smoke-{arm}-proposal")
        validator = pilot.ENGINE.StepEvaluator(
            tape,
            setting,
            0,
            transition_from=incumbent,
            field="nominal",
            run_setting=run_setting,
        )
        repair_counter = pilot.ENGINE.EvaluationCounter()
        repair_catalogue, _repair_census = pilot.ENGINE._catalogue_with_census(
            tape,
            0,
            carrier_base,
            setting=setting,
            calibration=calibration,
            counter=repair_counter,
            run_setting=run_setting,
        )
        validator.evaluate_many((*repair_catalogue, proposal_config))
        carrier_profile = validator.evaluate(carrier_base)
        carrier_served = sum(carrier_profile.score.served_phy.values())
        action_indices = {
            table.user_id: {
                pilot._identity(action): index
                for index, action in enumerate(table.actions)
            }
            for table in tables
        }

        def profile_for(config):
            return tuple(
                action_indices[table.user_id][config.mapping[table.user_id]]
                for table in tables
            )

        repair_profiles = tuple(profile_for(row) for row in repair_catalogue)
        config_by_profile = {
            profile_for(row): row for row in (*repair_catalogue, proposal_config)
        }

        def guarded(profile):
            config = config_by_profile[profile]
            return (
                config.configuration_id not in validator._invalid
                and sum(
                    validator._evaluated[
                        config.configuration_id
                    ].score.served_phy.values()
                )
                >= carrier_served
            )

        seed_profile = ProfileSelector.repair_reference(
            model=model,
            tables=tables,
            catalogue=repair_profiles,
            jointly_legal=guarded,
        )
        seed = configuration(seed_profile, f"c3-smoke-{arm}-seed")
        counter = pilot.ENGINE.EvaluationCounter()
        catalogue, census = pilot.ENGINE._catalogue_with_census(
            tape,
            0,
            seed,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        validator.evaluate_many(catalogue)
        scored = tuple(
            ScoredConfiguration(
                row.assignments,
                _score(model, built, seed, row, tape, 0),
                row.configuration_id not in validator._invalid
                and sum(
                    validator._evaluated[
                        row.configuration_id
                    ].score.served_phy.values()
                )
                >= carrier_served,
            )
            for row in catalogue
        )
        plans.append(ArmPlan(arm, seed.assignments, scored, True))
        diagnostics[arm] = {
            "seed_sha256": canonical_sha256(seed.assignments),
            "catalogue_rows": len(catalogue),
            "catalogue_mode": census["catalogue_mode"],
            "nominal_boundary_evaluations": counter.boundary_evaluations,
            "repair_support_rows": len(repair_catalogue),
            "repair_nominal_boundary_evaluations": repair_counter.boundary_evaluations,
            "proposal_repaired": seed_profile != proposal,
        }

    counter = pilot.ENGINE.EvaluationCounter()
    catalogue, census = pilot.ENGINE._catalogue_with_census(
        tape,
        0,
        carrier_base,
        setting=setting,
        calibration=calibration,
        counter=counter,
        run_setting=run_setting,
    )
    baseline = tuple(
        ScoredConfiguration(row.assignments, -float(row.changed_users))
        for row in catalogue
    )
    plans.append(ArmPlan("BASELINE", carrier_base.assignments, baseline, True))
    diagnostics["BASELINE"] = {
        "seed_sha256": canonical_sha256(carrier_base.assignments),
        "catalogue_rows": len(catalogue),
        "catalogue_mode": census["catalogue_mode"],
        "nominal_boundary_evaluations": counter.boundary_evaluations,
    }
    return tuple(plans), diagnostics


class RuleEvaluator:
    """Single-child client for one verified sealed provisioning rule."""

    def __init__(self, rule: str, world: str, carrier: str) -> None:
        env = dict(os.environ)
        env.update(
            {
                "OMP_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
            }
        )
        self.process = subprocess.Popen(
            (
                sys.executable,
                str(RULE_EVALUATOR),
                "--variant",
                rule,
                "--world",
                world,
                "--steps",
                "5",
                "--step",
                "0",
                "--carrier",
                carrier,
                "--setting",
                "a-r0",
            ),
            cwd=ROOT,
            env=env,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
            encoding="ascii",
        )
        if self.process.stdout is None or self.process.stdin is None:
            raise RuntimeError("failed to open rule-evaluator pipes")
        self.ready = json.loads(self.process.stdout.readline())
        if self.ready.get("variant") != rule or self.ready.get("ready") is not True:
            raise RuntimeError(f"rule evaluator did not authenticate {rule}")

    def evaluate(self, assignment) -> dict[str, float | bool]:
        assert self.process.stdin is not None and self.process.stdout is not None
        self.process.stdin.write(json.dumps({"assignment": assignment}) + "\n")
        self.process.stdin.flush()
        response = json.loads(self.process.stdout.readline())
        if response.get("valid") is not True:
            raise RuntimeError("selected physical configuration is invalid")
        return response

    def close(self) -> None:
        if self.process.stdin is not None:
            self.process.stdin.close()
        return_code = self.process.wait()
        if return_code != 0:
            raise RuntimeError(f"rule evaluator exited {return_code}")


def smoke(output: Path) -> dict[str, object]:
    smoke_started = time.perf_counter()
    if output.exists():
        raise RuntimeError(f"refusing to overwrite smoke output: {output}")
    output.mkdir(parents=True)
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    cal = calibration()
    tape_started = time.perf_counter()
    tape = build_world_tape(
        domain=DEVELOPMENT_WORLD_DOMAINS[0],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=5,
        start_time_s=0.0,
    )
    tape_seconds = time.perf_counter() - tape_started

    exact_builds = []
    primitive_builds = []
    exact_seconds = []
    primitive_seconds = []
    assertions = {
        "validity_survival_assertions": 0,
        "production_target_label_assertions": 0,
        "exact_outage_assertions": 0,
        "rekey_context_path_assertions": 0,
    }
    smoke_anchors = (
        (0, REFERENCE_CARRIERS[0]),
        (1, REFERENCE_CARRIERS[1]),
    )
    for anchor_index, (step_index, carrier) in enumerate(smoke_anchors):
        capture = EngineCapture(pilot.ENGINE)
        exact = exact_nonfallback_builder(capture)
        started = time.perf_counter()
        built = exact(
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=cal,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            include_coalition=True,
            full_legal_actions=False,
        )
        exact_seconds.append(time.perf_counter() - started)
        assert capture.forecasts is not None
        for name, count in assert_exact_targets(built, capture.forecasts, cal).items():
            assertions[name] += count
        assert capture.phi_calls_with_rekey_context > 0
        assertions["rekey_context_path_assertions"] += capture.phi_calls_with_rekey_context
        exact_builds.append(built)

        started = time.perf_counter()
        primitive_builds.append(
            pilot._build_anchor_rows(
                tape=tape,
                setting=setting,
                run_setting=run_setting,
                calibration=cal,
                step_index=step_index,
                carrier=carrier,
                anchor_index=anchor_index,
                include_coalition=True,
                full_legal_actions=False,
            )
        )
        primitive_seconds.append(time.perf_counter() - started)
        assert pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True

    differences = surrogate_differences(exact_builds, primitive_builds)
    source = write_source_shard(
        output / "exact-source.jsonl",
        tuple(row for built in exact_builds for row in built["rows"]),
    )
    coalition = write_coalition_shard(
        output / "exact-coalitions.jsonl",
        tuple(built["coalition_row"] for built in exact_builds),
    )
    pairs = build_pairwise_batches((source,))
    c3 = CoalitionBatch.create((coalition,))
    trainer = PanelTrainer(
        learner_seed=LEARNER_SEEDS[0],
        q1_batch=pairs["C1"],
        q2_batch=pairs["C2"],
        c3_batch=c3,
        neutral_sources=default_synthetic_neutral_sources(),
    )
    train_started = time.perf_counter()
    trainer.train(2)
    train_seconds = time.perf_counter() - train_started
    training = trainer.deployment_receipt()

    built = exact_builds[0]
    base = built["base"]
    plan_started = time.perf_counter()
    plans, plan_diagnostics = _arm_owned_plans(
        trainer=trainer,
        built=built,
        tape=tape,
        setting=setting,
        run_setting=run_setting,
        calibration=cal,
    )
    plan_build_seconds = time.perf_counter() - plan_started
    baseline_rows = plans[-1].catalogue
    tier_rows = []
    screens = {}
    for rule_name in ("SEALED", "MARGIN_Q"):
        rule = provisioning_rule(rule_name)
        cache = PhysicalOutcomeCache[dict[str, float]]()
        setup_started = time.perf_counter()
        rule_evaluator = RuleEvaluator(rule, tape.domain, REFERENCE_CARRIERS[0])
        rule_setup_seconds = time.perf_counter() - setup_started
        realised_seconds = 0.0

        def key_for(_arm, assignment):
            return PhysicalCacheKey(
                tape_sha256=rule_evaluator.ready["tape_sha256"],
                world_id=tape.domain,
                decision_time_ns=0,
                assignment=assignment,
                physical_setting_sha256=canonical_sha256({"setting": "a-r0", "provisioning_rule": rule}),
                run_setting_sha256=rule_evaluator.ready["run_setting_sha256"],
                evaluator_sha256=rule_evaluator.ready["evaluator_sha256"],
                field="realised",
                boundary_indices=tuple(rule_evaluator.ready["boundary_indices"]),
                transition_sha256=canonical_sha256(built["incumbent"].assignments),
                prefix_history_sha256=canonical_sha256({"world": tape.domain, "step": 0, "prefix": []}),
            )

        def evaluate(key):
            nonlocal realised_seconds
            started = time.perf_counter()
            profile = rule_evaluator.evaluate(key.assignment)
            realised_seconds += time.perf_counter() - started
            return {"bits": profile["bits"], "joules": profile["joules"]}

        started = time.perf_counter()
        tier = select_then_realise(tuple(plans), key_for=key_for, evaluate=evaluate, cache=cache)
        total = time.perf_counter() - started
        tier_rows.append({
            "provisioning_rule": rule,
            **{
                key: value
                for key, value in tier.items()
                if key not in {"outcomes", "selected"}
            },
            "selected_sha256": {
                arm: canonical_sha256(assignment)
                for arm, assignment in tier["selected"].items()
            },
            "selection_seconds": total - realised_seconds,
            "realisation_seconds": realised_seconds,
            "rule_evaluator_setup_seconds": rule_setup_seconds,
            "sealed_manifest_sha256": rule_evaluator.ready["sealed_manifest_sha256"],
            "source_tape_sha256": tape.digest,
            "evaluation_tape_sha256": rule_evaluator.ready["tape_sha256"],
        })
        base_profile = rule_evaluator.evaluate(base.assignments)
        rule_evaluator.close()
        reference_certificate = canonical_sha256({
            "schema": "c3-smoke-head-independent-fixed-point-v1",
            "rule": rule,
            "seed": baseline_rows[0].assignment,
            "ordered_unilateral_scores_hex": [
                row.nominal_score.hex() for row in baseline_rows
            ],
            "fixed_point": baseline_rows[0].assignment,
        })
        screen_row = {
            "anchor_id": f"{tape.domain}|0|{REFERENCE_CARRIERS[0]}|{rule}",
            "reference": {
                "bits": base_profile["bits"],
                "joules": base_profile["joules"],
                "head_independent": True,
                "fixed_point_certified": True,
                "certificate_sha256": reference_certificate,
            },
            "outcomes": tier["outcomes"],
        }

        contrasts = tuple(
            (f"FULL-minus-{arm}", "FULL", arm)
            for arm in (*PANEL_LEARNED_ARMS[1:], "BASELINE")
        )
        screens[rule] = degeneracy_report((screen_row,), contrasts)

    result = {
        "label": LABEL,
        "smoke_test_not_evidence": True,
        "production_training_run": False,
        "policy_run": False,
        "worker_processes_used_peak": 2,
        "process_limit": 4,
        "world": tape.domain,
        "anchors": 2,
        "learner_seeds": 1,
        "source_epochs": 2,
        "panel_arms": len(PANEL_ARM_ORDER),
        "learned_arms": len(PANEL_LEARNED_ARMS),
        "tape_build_seconds": tape_seconds,
        "exact_row_build_seconds": exact_seconds,
        "primitive_row_build_seconds": primitive_seconds,
        "exact_row_seconds_per_anchor": sum(exact_seconds) / len(exact_seconds),
        "source_rows": sum(len(built["rows"]) for built in exact_builds),
        "coalition_rows": len(exact_builds),
        "exact_assertions": assertions,
        "surrogate_difference_witness_counts": differences,
        "training_seconds": train_seconds,
        "training_seconds_per_arm_per_epoch": train_seconds / len(PANEL_LEARNED_ARMS) / 2,
        "training": training,
        "arm_owned_plans": plan_diagnostics,
        "arm_owned_plan_build_seconds_per_anchor": plan_build_seconds,
        "tier": tier_rows,
        "screen_by_provisioning_rule": screens,
        "provisioning_rule_note": (
            "Both named branches use the verified read-only sealed harness evaluators. "
            "The child adapter is single-process and uses the pre-existing 0.10 judged "
            "fading quantile from that harness."
        ),
        "fallback_constant_unchanged": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True,
    }
    result["smoke_wall_seconds"] = time.perf_counter() - smoke_started
    path = output / "smoke.json"
    path.write_text(json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
    return result


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    print(json.dumps(smoke(args.output), indent=2, sort_keys=True, allow_nan=False))


if __name__ == "__main__":
    main()
    realised_by_key = {
        key.digest: cache.realise(key, evaluate)
        for key in {value.digest: value for value in keys.values()}.values()
    }
    return {
        "selected": {arm: row.assignment for arm, row in selected.items()},
        "outcomes": {arm: realised_by_key[keys[arm].digest] for arm in PANEL_ARM_ORDER},
        "seed_sha256": {plan.arm: plan.seed_sha256 for plan in plans},
        "catalogue_sha256": {plan.arm: plan.catalogue_sha256 for plan in plans},
        "selection_completed_before_cache_lookups": True,
        "chosen_configurations": len(selected),
        "union_realised_configurations": len(realised_by_key),
        "cache_hits": cache.hits,
        "cache_misses": cache.misses,
        "search": "ordered_first_strict_improvement",
    }


def _fraction(value: int | float | Fraction) -> Fraction:
    if isinstance(value, Fraction):
        return value
    if isinstance(value, int):
        return Fraction(value)
    if not math.isfinite(value):
        raise StageCContractError("reporting outcome must be finite")
    return Fraction.from_float(value)


def _ratio(bits: int | float | Fraction, joules: int | float | Fraction) -> Fraction:
    energy = _fraction(joules)
    if energy <= 0:
        raise StageCContractError("reporting energy must be positive")
    return _fraction(bits) / energy


def degeneracy_report(
    anchors: Sequence[Mapping[str, object]],
    contrasts: Sequence[tuple[str, str, str]],
) -> dict[str, object]:
    """Report exact-sign reference status and both pooled contrast marginals.

    Each anchor must contain ``outcomes`` (arm -> {bits, joules}) and a
    head-independent certified ``reference`` outcome.  No row is removed from
    the returned all-anchor material; the restricted view is supplementary.
    """

    if not anchors:
        raise StageCContractError("degeneracy report needs at least one anchor")
    status: dict[str, dict[str, bool]] = {}
    for row in anchors:
        anchor_id = str(row["anchor_id"])
        outcomes = row["outcomes"]
        reference = row["reference"]
        if not isinstance(outcomes, Mapping) or not isinstance(reference, Mapping):
            raise StageCContractError("malformed degeneracy-report anchor")
        certificate = reference.get("certificate_sha256")
        if (
            reference.get("head_independent") is not True
            or reference.get("fixed_point_certified") is not True
            or not isinstance(certificate, str)
            or len(certificate) != 64
            or any(c not in "0123456789abcdef" for c in certificate)
        ):
            raise StageCContractError(
                "reference must carry a head-independent fixed-point certificate"
            )
        ref_bits, ref_joules = reference["bits"], reference["joules"]
        status[anchor_id] = {}
        for arm, outcome in outcomes.items():
            if not isinstance(outcome, Mapping):
                raise StageCContractError("malformed arm outcome")
            # Cross multiplication gives the exact sign in integer/rational or
            # exact binary64 arithmetic; there is no tolerance or threshold.
            below = (
                _fraction(outcome["bits"]) * _fraction(ref_joules)
                < _fraction(ref_bits) * _fraction(outcome["joules"])
            )
            status[anchor_id][str(arm)] = below

    def pooled(rows: Sequence[Mapping[str, object]], arm: str) -> Fraction:
        bits = sum((_fraction(row["outcomes"][arm]["bits"]) for row in rows), Fraction())
        joules = sum((_fraction(row["outcomes"][arm]["joules"]) for row in rows), Fraction())
        return _ratio(bits, joules)

    arm_names = tuple(sorted(status[next(iter(status))]))
    if any(tuple(sorted(row)) != arm_names for row in status.values()):
        raise StageCContractError("degeneracy-report arm inventory differs by anchor")
    per_arm = {}
    for arm in arm_names:
        below_rows = [
            row for row in anchors if status[str(row["anchor_id"])][arm]
        ]
        shortfalls = []
        for row in below_rows:
            reference = row["reference"]
            outcome = row["outcomes"][arm]
            shortfalls.append(
                _ratio(reference["bits"], reference["joules"])
                - _ratio(outcome["bits"], outcome["joules"])
            )
        ordered = sorted(shortfalls)
        per_arm[arm] = {
            "anchor_count": len(anchors),
            "below_reference_count": len(below_rows),
            "below_reference_fraction": len(below_rows) / len(anchors),
            "shortfall_bits_per_j": [float(value) for value in ordered],
            "shortfall_min_bits_per_j": None if not ordered else float(ordered[0]),
            "shortfall_max_bits_per_j": None if not ordered else float(ordered[-1]),
        }

    reports: dict[str, object] = {}
    for name, left, right in contrasts:
        if any(left not in row["outcomes"] or right not in row["outcomes"] for row in anchors):
            raise StageCContractError(f"contrast {name} names an absent arm")
        restricted = [
            row
            for row in anchors
            if not status[str(row["anchor_id"])][left]
            and not status[str(row["anchor_id"])][right]
        ]

        def marginal(rows: Sequence[Mapping[str, object]]) -> float | None:
            if not rows:
                return None
            denominator = pooled(rows, right)
            return None if denominator == 0 else float(pooled(rows, left) / denominator - 1)

        reports[name] = {
            "arms": [left, right],
            "all_anchor": {
                "anchor_count": len(anchors),
                "marginal_relative_pooled_ee": marginal(anchors),
            },
            "all_arms_at_or_above_reference": {
                "anchor_count": len(restricted),
                "anchor_ids": [str(row["anchor_id"]) for row in restricted],
                "marginal_relative_pooled_ee": marginal(restricted),
            },
        }
    return {
        "screen": "exact sign against head-independent certified fixed point",
        "role": "REPORTING_ONLY_NOT_A_FILTER",
        "anchors_retained": len(anchors),
        "below_reference": status,
        "per_arm": per_arm,
        "contrasts": reports,
    }


