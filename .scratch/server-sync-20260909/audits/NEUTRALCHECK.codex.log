+            "argmax_different_anchors": differing,
+            "argmax_different_fraction": differing / len(eval_anchors),
+            "parameter_l2": parameter_l2(snapshots[epoch]),
+        }
+        selections[epoch] = choices
+
+    totals = {
+        "neutral_present": {"bits": 0.0, "joules": 0.0},
+        "knockout": {"bits": 0.0, "joules": 0.0},
+    }
+    boundary_evaluations = 0
+    selection_rows = []
+    for anchor, (present, knockout) in zip(
+        eval_anchors, selections[CHECKPOINTS[-1]], strict=True
+    ):
+        evaluator = pilot.ENGINE.StepEvaluator(
+            anchor["tape"],
+            anchor["setting"],
+            anchor["step_index"],
+            transition_from=anchor["incumbent"],
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
+                anchor["tape"], anchor["step_index"]
+            ),
+            field="realised",
+            run_setting=anchor["run_setting"],
+        )
+        evaluator.evaluate_many(tuple({
+            present.configuration_id: present,
+            knockout.configuration_id: knockout,
+        }.values()))
+        for label, config in (("neutral_present", present), ("knockout", knockout)):
+            profile = evaluator.evaluate(config)
+            totals[label]["bits"] += profile.bits
+            totals[label]["joules"] += profile.joules
+        boundary_evaluations += evaluator.physical_evaluations
+        selection_rows.append(
+            {
+                "anchor": anchor["step_index"],
+                "neutral_present_configuration_id": present.configuration_id,
+                "knockout_configuration_id": knockout.configuration_id,
+                "different": present.configuration_id != knockout.configuration_id,
+            }
+        )
+        print(
+            json.dumps({"event": "full_buffer_evaluated", "anchor": anchor["step_index"]}),
+            flush=True,
+        )
+
+    for row in totals.values():
+        row["pooled_ee_bits_per_j"] = row["bits"] / row["joules"]
+    ee_present = totals["neutral_present"]["pooled_ee_bits_per_j"]
+    ee_knockout = totals["knockout"]["pooled_ee_bits_per_j"]
+    result = {
+        "schema": "neutralcheck-c3-bounded-v1",
+        "route": ROUTE,
+        "learner_domain": LEARNER_DOMAIN,
+        "learner_seed": LEARNER_SEED,
+        "training_anchor_shards": TRAIN_ANCHORS,
+        "training_rows": int(neutral.target_psi.size),
+        "neutral_targets_all_exact_zero": bool(not np.count_nonzero(neutral.target_psi)),
+        "evaluation_world": DEVELOPMENT_WORLD_DOMAINS[2],
+        "evaluation_anchors": EVALUATION_ANCHORS,
+        "evaluation_carrier": pilot.ENGINE.REFERENCE_CARRIERS[0],
+        "evaluation_catalogue_rows": sum(len(row["catalogue"]) for row in eval_anchors),
+        "evaluation_joint_rows": sum(len(row["contexts"]) for row in eval_anchors),
+        "checkpoints": metrics,
