+        deltas[(user, action)] = (
+            model.q1.score(row.q1_state)
+            - model.q1.score(reference.q1_state)
+            + model.q2.score(row.q2_state)
+            - model.q2.score(reference.q2_state)
+        )
+    scored = []
+    contributions = []
+    for config in anchor["catalogue"]:
+        additive = math.fsum(
+            deltas[(user, config.mapping[user])] for user in base.mapping
+        )
+        contribution = 0.0
+        context = anchor["contexts"].get(config.configuration_id)
+        if context is not None:
+            contribution = model.interaction(context)
+        contributions.append(contribution)
+        score = additive + contribution if include_c3 else additive
+        scored.append((score, config.configuration_id, config))
+    chosen = min(scored, key=lambda row: (-row[0], row[1]))[2]
+    return chosen, contributions
+
+
+def main() -> int:
+    cal = calibration()
+    q1_batch, q2_batch, c3_batch = training_batches(cal)
+    snapshots, neutral = train_neutral_c3(q1_batch, q2_batch, c3_batch)
+    eval_anchors = build_evaluation_slice(cal)
+    metrics = {}
+    selections = {}
+    for epoch in CHECKPOINTS:
+        model = restored_model(
+            epoch, q1_batch, q2_batch, c3_batch, snapshots[epoch]
+        )
+        differing = 0
+        outputs = []
+        choices = []
+        for anchor in eval_anchors:
+            present, contributions = select(model, anchor, include_c3=True)
+            knockout, _ = select(model, anchor, include_c3=False)
+            outputs.extend(contributions)
+            differing += int(present.configuration_id != knockout.configuration_id)
+            choices.append((present, knockout))
+        values = np.asarray(outputs, dtype=np.float64)
+        if not np.isfinite(values).all():
+            raise RuntimeError(f"non-finite evaluation output at epoch {epoch}")
+        metrics[str(epoch)] = {
+            "max_abs_output": float(np.max(np.abs(values))),
+            "argmax_different_anchors": differing,
+            "argmax_different_fraction": differing / len(eval_anchors),
+            "parameter_l2": parameter_l2(snapshots[epoch]),
+        }
+        selections[epoch] = choices
+
+    totals = {
+        "neutral_present": {"bits": 0.0, "joules": 0.0},
+        "knockout": {"bits": 0.0, "joules": 0.0},
+    }
+    boundary_evaluations = 0
+    selection_rows = []
+    for anchor, (present, knockout) in zip(
+        eval_anchors, selections[CHECKPOINTS[-1]], strict=True
+    ):
+        evaluator = pilot.ENGINE.StepEvaluator(
+            anchor["tape"],
+            anchor["setting"],
+            anchor["step_index"],
+            transition_from=anchor["incumbent"],
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
+                anchor["tape"], anchor["step_index"]
+            ),
+            field="realised",
+            run_setting=anchor["run_setting"],
+        )
+        evaluator.evaluate_many(tuple({
+            present.configuration_id: present,
+            knockout.configuration_id: knockout,
+        }.values()))
+        for label, config in (("neutral_present", present), ("knockout", knockout)):
+            profile = evaluator.evaluate(config)
+            totals[label]["bits"] += profile.bits
+            totals[label]["joules"] += profile.joules
+        boundary_evaluations += evaluator.physical_evaluations
+        selection_rows.append(
+            {
+                "anchor": anchor["step_index"],
+                "neutral_present_configuration_id": present.configuration_id,
+                "knockout_configuration_id": knockout.configuration_id,
+                "different": present.configuration_id != knockout.configuration_id,
+            }
+        )
+        print(
+            json.dumps({"event": "full_buffer_evaluated", "anchor": anchor["step_index"]}),
+            flush=True,
+        )
+
+    for row in totals.values():
+        row["pooled_ee_bits_per_j"] = row["bits"] / row["joules"]
+    ee_present = totals["neutral_present"]["pooled_ee_bits_per_j"]
+    ee_knockout = totals["knockout"]["pooled_ee_bits_per_j"]
+    result = {
+        "schema": "neutralcheck-c3-bounded-v1",
+        "route": ROUTE,
+        "learner_domain": LEARNER_DOMAIN,
+        "learner_seed": LEARNER_SEED,
+        "training_anchor_shards": TRAIN_ANCHORS,
+        "training_rows": int(neutral.target_psi.size),
+        "neutral_targets_all_exact_zero": bool(not np.count_nonzero(neutral.target_psi)),
+        "evaluation_world": DEVELOPMENT_WORLD_DOMAINS[2],
+        "evaluation_anchors": EVALUATION_ANCHORS,
+        "evaluation_carrier": pilot.ENGINE.REFERENCE_CARRIERS[0],
+        "evaluation_catalogue_rows": sum(len(row["catalogue"]) for row in eval_anchors),
+        "evaluation_joint_rows": sum(len(row["contexts"]) for row in eval_anchors),
+        "checkpoints": metrics,
+        "epoch_500": {
+            "selection_rows": selection_rows,
+            "different_anchors": sum(row["different"] for row in selection_rows),
+            "totals": totals,
+            "pooled_ee_absolute_difference_bits_per_j": ee_present - ee_knockout,
+            "pooled_ee_relative_difference": ee_present / ee_knockout - 1.0,
+            "full_buffer_boundary_indices": list(range(48)),
+            "physical_boundary_evaluations": boundary_evaluations,
+        },
+    }
+    print(json.dumps(result, sort_keys=True, separators=(",", ":")), flush=True)
+    peak_kib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    print(f"PEAK_RSS_KIB={peak_kib} PEAK_RSS_GIB={peak_kib / 1024**2:.6f}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

