   968	class V1LineageOrchestrator:
   969	    """C7 matched five-arm learner with a scalar set-conditioned C3 route."""
   970	
   971	    def __init__(
   972	        self,
   973	        *,
   974	        learner_seed: int,
   975	        q1_batch: PairwiseBatch,
   976	        q2_batch: PairwiseBatch,
   977	        c3_batch: CoalitionBatch,
   978	        neutral_sources: Mapping[Route, NeutralSourceDefinition],
   979	    ) -> None:
   980	        if q1_batch.route != "C1" or q2_batch.route != "C2":
   981	            raise StageCContractError("v1 action batches must be C1 then C2")
   982	        if set(neutral_sources) != set(ROUTES) or any(
   983	            neutral_sources[route].route != route for route in ROUTES
   984	        ):
   985	            raise StageCContractError("all three sealed neutral-source definitions are required")
   986	        if len({q1_batch.physics_digest, q2_batch.physics_digest, c3_batch.physics_digest}) != 1:
   987	            raise StageCContractError("C1/C2/C3 training physics digests disagree")
   988	        self.learner_seed = int(learner_seed)
   989	        self.q1_batch = q1_batch
   990	        self.q2_batch = q2_batch
   991	        self.c3_batch = c3_batch
   992	        self.neutral_sources = dict(neutral_sources)
   993	        self.physics_digest = q1_batch.physics_digest
   994	        rng = np.random.default_rng(self.learner_seed)
   995	        template = V1ThreeRouteModel(
   996	            AdamMLPHead.create(
   997	                q1_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C1"], rng
   998	            ),
   999	            AdamMLPHead.create(
  1000	                q2_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C2"], rng
  1001	            ),
  1002	            AdamSetInteractionHead(
  1003	                AdamMLPHead.create(
  1004	                    c3_batch.invariant_states.shape[1], LEGACY_TRAINER_LITERALS["C3"], rng
  1005	                ),
  1006	                c3_batch.member_width,
  1007	            ),
  1008	        )
  1009	        self.initialization_payload = template.payload()
  1010	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
  1011	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
  1012	        # Engineering-only pilot lever: neutral batches are immutable and
  1013	        # identical for every source epoch, so materialise them once rather
  1014	        # than allocating and hashing them inside the hot epoch loop.
  1015	        self._neutral_q1 = q1_batch.neutral(self.neutral_sources["C1"])
  1016	        self._neutral_q2 = q2_batch.neutral(self.neutral_sources["C2"])
  1017	        self._neutral_c3 = c3_batch.neutral(self.neutral_sources["C3"])
  1018	        self.completed_source_epochs = 0
  1019	        self.route_update_count = 0
  1020	
  1021	    def train_epoch(self) -> dict[str, dict[str, float]]:
  1022	        if self.completed_source_epochs >= LEGACY_EPOCH_BUDGET:
  1023	            raise StageCContractError("legacy exact epoch budget is already complete")
  1024	        losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
  1025	        for route, informed in (("C1", self.q1_batch), ("C2", self.q2_batch)):
  1026	            neutral = self._neutral_q1 if route == "C1" else self._neutral_q2
  1027	            for arm in LEARNED_ARMS:
  1028	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
  1029	                head = self.models[arm].q1 if route == "C1" else self.models[arm].q2
  1030	                assert isinstance(head, AdamMLPHead)
  1031	                losses[arm][route] = head.update(batch)
  1032	            self.route_update_count += 1
  1033	        for arm in LEARNED_ARMS:
  1034	            batch = self.c3_batch if SOURCE_MAP[arm]["C3"] == "informed" else self._neutral_c3
  1035	            head = self.models[arm].psi
  1036	            assert isinstance(head, AdamSetInteractionHead)
  1037	            losses[arm]["C3"] = head.update(batch)
  1038	        self.route_update_count += 1
  1039	        self.completed_source_epochs += 1
  1040	        return losses
  1041	
  1042	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
  1043	        if isinstance(epochs, bool) or not isinstance(epochs, int) or epochs < 0:
  1044	            raise StageCContractError("epochs must be a nonnegative integer")
  1045	        if self.completed_source_epochs + epochs > LEGACY_EPOCH_BUDGET:
  1046	            raise StageCContractError("legacy exact epoch budget would be exceeded")
  1047	        for _ in range(epochs):
  1048	            self.train_epoch()
  1049	            if (
  1050	                checkpoint_directory is not None
  1051	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
  1052	            ):
  1053	                self.write_checkpoint(
  1054	                    Path(checkpoint_directory)
  1055	                    / f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
  1056	                )
  1057	
  1058	    def fit_to_budget(self, *, checkpoint_directory: str | Path) -> None:
  1059	        """Production fit: exhaust the frozen budget and checkpoint every 100 epochs."""
  1060	
  1061	        self.train(
  1062	            LEGACY_EPOCH_BUDGET - self.completed_source_epochs,
  1063	            checkpoint_directory=checkpoint_directory,
  1064	        )
  1065	
  1066	    def checkpoint_payload(self) -> dict[str, object]:
  1067	        return {
  1068	            "schema": "mcrl-v025-stagec-v1-lineage-checkpoint-v1",
  1069	            "learner_seed": self.learner_seed,
  1070	            "completed_source_epochs": self.completed_source_epochs,
  1071	            "route_update_count": self.route_update_count,
  1072	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
  1073	            "legacy_trainer_literals": dict(LEGACY_TRAINER_LITERALS),
  1074	            "legacy_trainer_literals_sha256": LEGACY_TRAINER_LITERALS_SHA256,
  1075	            "epoch_budget": LEGACY_EPOCH_BUDGET,
  1076	            "stopping_rule": "exact_epoch_budget_no_early_selection",
  1077	            "training_physics_digest": self.physics_digest,
  1078	            "batch_digests": {
  1079	                "C1": self.q1_batch.digest,
  1080	                "C2": self.q2_batch.digest,
  1081	                "C3": self.c3_batch.digest,
  1082	            },
  1083	            "neutral_source_digests": {
  1084	                route: self.neutral_sources[route].digest for route in ROUTES
  1085	            },
  1086	            "initialization": self.initialization_payload,
