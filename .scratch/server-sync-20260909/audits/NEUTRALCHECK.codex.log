   100	@dataclass(frozen=True, slots=True)
   101	class CoalitionContext:
   102	    anchor_id: str
   103	    reference_profile: tuple[tuple[int, PhysicalAction], ...]
   104	    members: tuple[CoalitionMember, ...]
   105	    affected_beams: tuple[AffectedBeamContext, ...]
   106	    global_resource_features: tuple[float, ...]
   107	    pairwise_cross_gain_terms: tuple[tuple[str, str, float], ...] = ()
   108	
   109	    def __post_init__(self) -> None:
   110	        reference_users = tuple(user for user, _ in self.reference_profile)
   111	        member_users = tuple(member.user_id for member in self.members)
   112	        if (
   113	            not reference_users
   114	            or reference_users != tuple(sorted(reference_users))
   115	            or len(set(reference_users)) != len(reference_users)
   116	        ):
   117	            raise StageCContractError("coalition a0 must be a complete sorted user profile")
   118	        if len(set(member_users)) != len(member_users) or not set(member_users) <= set(reference_users):
   119	            raise StageCContractError("changed users must be unique members of a0")
   120	        if not self.affected_beams:
   121	            raise StageCContractError("coalition context requires affected resource rows")
   122	        if not self.global_resource_features or not all(
   123	            math.isfinite(value) for value in self.global_resource_features
   124	        ):
   125	            raise StageCContractError("global coalition features must be finite and nonempty")
   126	        widths = {len(member.invariant_features) for member in self.members}
   127	        if len(widths) > 1:
   128	            raise StageCContractError("coalition member feature widths differ")
   129	        beam_keys = {beam.beam_key for beam in self.affected_beams}
   130	        if any(
   131	            source not in beam_keys
   132	            or target not in beam_keys
   133	            or source == target
   134	            or not math.isfinite(gain)
   135	            or gain < 0.0
   136	            for source, target, gain in self.pairwise_cross_gain_terms
   137	        ):
   138	            raise StageCContractError("pairwise cross-gain relation context is invalid")
   139	        relation_keys = [(source, target) for source, target, _gain in self.pairwise_cross_gain_terms]
   140	        if len(relation_keys) != len(set(relation_keys)):
   141	            raise StageCContractError("pairwise cross-gain relation keys must be unique")
   142	        object.__setattr__(
   143	            self,
   144	            "pairwise_cross_gain_terms",
   145	            tuple(sorted(self.pairwise_cross_gain_terms, key=lambda row: (row[0], row[1]))),
   146	        )
   147	
   148	    @property
   149	    def changed_users(self) -> tuple[int, ...]:
   150	        return tuple(sorted(member.user_id for member in self.members))
   151	
   152	    @property
   153	    def payload_sha256(self) -> str:
   154	        return canonical_sha256(self.payload())
   155	
   156	    def payload(self) -> dict[str, object]:
   157	        _retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
   158	        return {
   159	            "context_schema": COALITION_CONTEXT_SCHEMA,
   160	            "anchor_id": self.anchor_id,
   161	            "reference_profile": [
   162	                {"user_id": user, "action": action.payload()}
   163	                for user, action in self.reference_profile
   164	            ],
   165	            "members": [
   166	                {
   167	                    "user_id": member.user_id,
   168	                    "reference_action": member.reference_action.payload(),
   169	                    "selected_action": member.selected_action.payload(),
   170	                    "selected_q1_row_hex": [
   171	                        float_hex(value) for value in member.selected_q1_row
   172	                    ],
   173	                    "incumbent_q1_row_hex": [
   174	                        float_hex(value) for value in member.incumbent_q1_row
   175	                    ],
   176	                    "missing_incumbent": member.missing_incumbent,
   177	                }
   178	                for member in sorted(self.members, key=lambda item: item.user_id)
   179	            ],
   180	            "affected_beams": [
   181	                {
   182	                    "beam_key": beam.beam_key,
   183	                    "occupancy_before": beam.occupancy_before,
   184	                    "occupancy_after": beam.occupancy_after,
   185	                    "active_before": beam.active_before,
   186	                    "active_after": beam.active_after,
   187	                    "shared_capacity_hex": float_hex(beam.shared_capacity),
   188	                    "interference_summary_hex": float_hex(beam.interference_summary),
   189	                    "capacity_margin_hex": float_hex(beam.capacity_margin),
   190	                }
   191	                for beam in sorted(self.affected_beams, key=lambda item: item.beam_key)
   192	            ],
   193	            "global_resource_features_hex": [
   194	                float_hex(value) for value in self.global_resource_features
   195	            ],
   196	            "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
   197	            "pairwise_cross_gain_residual_sum_hex": float_hex(residual_sum),
   198	            "pairwise_cross_gain_terms": [
   199	                {
   200	                    "source_beam_key": source,
   201	                    "target_beam_key": target,
   202	                    "gain_hex": float_hex(gain),
   203	                }
   204	                for source, target, gain in self.pairwise_cross_gain_terms
   205	            ],
   206	        }
   207	
   208	    def _bounded_pairwise_cross_gain_terms(
   209	        self,
   210	    ) -> tuple[tuple[tuple[str, str, float], ...], float]:
   211	        """Top-K by magnitude, returned in canonical key order plus residual sum."""
   212	
   213	        ranked = sorted(
   214	            self.pairwise_cross_gain_terms,
   215	            key=lambda row: (-abs(row[2]), row[0], row[1]),
   216	        )
   217	        retained = tuple(
   218	            sorted(
   219	                ranked[:PAIRWISE_CROSS_GAIN_TOP_K],
   220	                key=lambda row: (row[0], row[1]),
   221	            )
   222	        )
   223	        residual_sum = math.fsum(row[2] for row in ranked[PAIRWISE_CROSS_GAIN_TOP_K:])
   224	        return retained, residual_sum
   225	
   226	    def pairwise_cross_gain_vector(self) -> np.ndarray:
   227	        """Fixed-width ordered pair block used by the interaction encoder."""
   228	
   229	        retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
   230	        block = np.zeros((PAIRWISE_CROSS_GAIN_TOP_K, 4), dtype=np.float64)
   231	        for index, (source, target, gain) in enumerate(retained):
   232	            block[index] = (
   233	                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
   234	                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
   235	                gain,
   236	                1.0,
   237	            )
   238	        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))
   239	
   240	    def invariant_vector(self, *, member_width: int) -> np.ndarray:
   241	        """DeepSets-style deterministic encoding; IDs/order are not features."""
   242	
   243	        if len(self.members) <= 1:
   244	            # Empty and singleton values are hard anchored by the head, but a
   245	            # stable vector remains useful for schema and KAT checks.
   246	            member_matrix = np.zeros((1, member_width), dtype=np.float64)
   247	        else:
   248	            member_matrix = np.asarray(
   249	                [member.invariant_features for member in self.members],
   250	                dtype=np.float64,
   251	            )
   252	            if member_matrix.shape[1] != member_width:
   253	                raise StageCContractError("coalition member feature width drifted")
   254	        beams = tuple(sorted(self.affected_beams, key=lambda beam: beam.beam_key))
   255	        beam_features = np.asarray([
   256	            [
   257	                beam.occupancy_before,
   258	                beam.occupancy_after,
   259	                float(beam.active_after) - float(beam.active_before),
   260	                beam.shared_capacity,
   261	                beam.interference_summary,
   262	                beam.capacity_margin,
   263	                1.0,
   264	            ]
   265	            for beam in beams
   266	        ], dtype=np.float64)
   267	        beam_pool = np.concatenate(
   268	            (
   269	                beam_features.sum(axis=0),
   270	                beam_features.max(axis=0),
   271	                beam_features.min(axis=0),
   272	                beam_features.mean(axis=0),
   273	            )
   274	        )
   275	        vector = np.concatenate(
   276	            (
   277	                np.asarray([float(len(self.members))], dtype=np.float64),
   278	                member_matrix.sum(axis=0),
   279	                member_matrix.max(axis=0),
   280	                beam_pool,
   281	                self.pairwise_cross_gain_vector(),
   282	                np.asarray(self.global_resource_features, dtype=np.float64),
   283	            )
   284	        )
   285	        if not np.isfinite(vector).all():
   286	            raise StageCContractError("coalition invariant encoding is non-finite")
   287	        return vector
