+#!/usr/bin/env python3
+"""Bounded C3 neutral-head versus knockout audit; emits one JSON result."""
+
+from __future__ import annotations
+
+from fractions import Fraction
+import json
+import math
+from pathlib import Path
+import resource
+
+import numpy as np
+
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape, seed_from_domain
+from mcrl.stagec_v025.canonical import canonical_sha256
+from mcrl.stagec_v025.coalitions import CoalitionShard
+from mcrl.stagec_v025.learner import (
+    AdamMLPHead,
+    AdamSetInteractionHead,
+    CoalitionBatch,
+    V1LineageOrchestrator,
+    V1ThreeRouteModel,
+    build_pairwise_batches,
+    default_synthetic_neutral_sources,
+)
+from mcrl.stagec_v025.shards import read_source_shard
+
+import scripts.run_v025_pilot_c3 as pilot
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE_ROOT = ROOT / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
+CHECKPOINT_ROOT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/checkpoints"
+TRAIN_ANCHORS = 5
+EVALUATION_ANCHORS = 5
+CHECKPOINTS = (100, 200, 300, 400, 500)
+LEARNER_DOMAIN = "V025_LEARNER/seed/1"
+LEARNER_SEED = seed_from_domain(LEARNER_DOMAIN)
+ROUTE = "C3"
+
+
+def parameter_l2(head: AdamSetInteractionHead) -> float:
+    network = head.network
+    squared = math.fsum(
+        float(np.sum(np.square(array)))
+        for array in (*network.weights, *network.biases)
+    )
+    return math.sqrt(squared)
+
+
+def calibration() -> pilot.PilotCalibration:
+    payload = json.loads(
+        (SOURCE_ROOT / "PILOT_NOT_CLAIM-calibration.json").read_text(encoding="ascii")
+    )
+    ratio = lambda name: Fraction(*payload[name])
+    return pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def training_batches(cal):
+    source_paths = sorted(
+        (SOURCE_ROOT / "rows/world-1").glob("*source-anchor-*.jsonl")
+    )[:TRAIN_ANCHORS]
+    source_shards = [read_source_shard(path) for path in source_paths]
+    pairwise = {
+        route: pilot._aggregate_pair_batch(batch)
+        for route, batch in build_pairwise_batches(source_shards).items()
+    }
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="neutralcheck-training"),
+        steps=TRAIN_ANCHORS + 3,
+        start_time_s=0.0,
+    )
+    coalition_rows = []
+    anchor_index = 0
+    for step_index in range(TRAIN_ANCHORS):
+        for carrier in pilot.ENGINE.REFERENCE_CARRIERS:
+            built = pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=cal,
+                step_index=step_index,
+                carrier=carrier,
+                anchor_index=anchor_index,
+                include_coalition=True,
+            )
+            coalition_rows.append(built["coalition_row"])
+            anchor_index += 1
+            print(
+                json.dumps({"event": "training_anchor_built", "anchor": anchor_index}),
+                flush=True,
+            )
+            if anchor_index == TRAIN_ANCHORS:
+                break
+        if anchor_index == TRAIN_ANCHORS:
+            break
+    rows_sha256 = canonical_sha256([row.payload() for row in coalition_rows])
+    shard = CoalitionShard(
+        Path("<neutralcheck-in-memory-v2>"),
+        canonical_sha256({"rows_sha256": rows_sha256}),
+        rows_sha256,
+        tuple(coalition_rows),
+    )
+    return pairwise["C1"], pairwise["C2"], CoalitionBatch.create((shard,))
+
+
+def train_neutral_c3(q1_batch, q2_batch, c3_batch):
+    orchestrator = V1LineageOrchestrator(
+        learner_seed=LEARNER_SEED,
+        q1_batch=q1_batch,
+        q2_batch=q2_batch,
+        c3_batch=c3_batch,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    neutral = orchestrator._neutral_c3
+    if np.count_nonzero(neutral.target_psi):
+        raise RuntimeError("neutral C3 target is not exactly zero")
+    head = orchestrator.models["DROP_C3"].psi
+    snapshots = {}
+    for epoch in range(1, CHECKPOINTS[-1] + 1):
+        head.update(neutral)
+        if epoch in CHECKPOINTS:
+            snapshots[epoch] = head.clone()
+            print(json.dumps({"event": "trained", "epoch": epoch}), flush=True)
+    return snapshots, neutral
+
+
+def restored_model(epoch, q1_batch, q2_batch, c3_batch, psi):
+    path = CHECKPOINT_ROOT / (
+        f"PILOT_NOT_CLAIM-seed-{LEARNER_SEED}-DROP_C3-epoch-{epoch:04d}.json"
+    )
+    payload = json.loads(path.read_text(encoding="ascii"))["model"]
+    orchestrator = V1LineageOrchestrator(
+        learner_seed=LEARNER_SEED,
+        q1_batch=q1_batch,
+        q2_batch=q2_batch,
+        c3_batch=c3_batch,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    model = orchestrator.models["DROP_C3"]
+    if not isinstance(model.q1, AdamMLPHead) or not isinstance(model.q2, AdamMLPHead):
+        raise TypeError("unexpected pairwise head kind")
+    V1LineageOrchestrator._restore_adam_head(model.q1, payload["C1"])
+    V1LineageOrchestrator._restore_adam_head(model.q2, payload["C2"])
+    return V1ThreeRouteModel(model.q1, model.q2, psi.clone())
+
+
+def build_evaluation_slice(cal):
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    domain = DEVELOPMENT_WORLD_DOMAINS[2]
+    tape = build_world_tape(
+        domain=domain,
+        provider=LegacyWorldProvider(role="neutralcheck-evaluation"),
+        steps=EVALUATION_ANCHORS + 3,
+        start_time_s=0.0,
+    )
+    anchors = []
+    carrier = pilot.ENGINE.REFERENCE_CARRIERS[0]
+    for step_index in range(EVALUATION_ANCHORS):
+        built = pilot._build_anchor_rows(
+            tape=tape,
+            setting=setting,
+            run_setting=run_setting,
+            calibration=cal,
+            step_index=step_index,
+            carrier=carrier,
+            anchor_index=step_index,
+            include_coalition=False,
+            full_legal_actions=True,
+        )
+        base = built["base"]
+        catalogue, census = pilot.ENGINE._catalogue_with_census(
+            tape,
+            step_index,
+            base,
+            setting=setting,
+            calibration=cal,
+            run_setting=run_setting,
+        )
+        contexts = {}
+        states = {}
+        for config in catalogue:
+            if config.changed_users >= 2:
+                context = pilot._coalition_context(
+                    tape=tape,
+                    step_index=step_index,
+                    anchor=base,
+                    selected=config,
+                    rows_by_user_action=built["rows_by_user_action"],
+                )
+                contexts[config.configuration_id] = context
+                states[config.configuration_id] = context.invariant_vector(
+                    member_width=next(iter(context.members)).invariant_features.__len__()
+                )
+        anchors.append(
+            {
+                "step_index": step_index,
+                "base": base,
+                "incumbent": built["incumbent"],
+                "rows": built["rows_by_user_action"],
+                "catalogue": catalogue,
+                "contexts": contexts,
+                "states": states,
+                "catalogue_census": census,
+                "tape": tape,
+                "setting": setting,
+                "run_setting": run_setting,
+            }
+        )
+        print(
+            json.dumps(
+                {
+                    "event": "evaluation_anchor_built",
+                    "anchor": step_index,
+                    "catalogue_rows": len(catalogue),
+                    "joint_rows": len(contexts),
+                }
+            ),
+            flush=True,
+        )
+    return anchors
+
+
+def select(model, anchor, *, include_c3):
+    base = anchor["base"]
+    rows = anchor["rows"]
+    deltas = {}
+    for (user, action), row in rows.items():
+        reference = rows[(user, base.mapping[user])]
+        deltas[(user, action)] = (
+            model.q1.score(row.q1_state)
+            - model.q1.score(reference.q1_state)
+            + model.q2.score(row.q2_state)
+            - model.q2.score(reference.q2_state)
+        )
+    scored = []
+    contributions = []
+    for config in anchor["catalogue"]:
+        additive = math.fsum(
+            deltas[(user, config.mapping[user])] for user in base.mapping
+        )
+        contribution = 0.0
+        context = anchor["contexts"].get(config.configuration_id)
+        if context is not None:
+            contribution = model.interaction(context)
+        contributions.append(contribution)
+        score = additive + contribution if include_c3 else additive
+        scored.append((score, config.configuration_id, config))
+    chosen = min(scored, key=lambda row: (-row[0], row[1]))[2]
+    return chosen, contributions
+
+
+def main() -> int:
+    cal = calibration()
+    q1_batch, q2_batch, c3_batch = training_batches(cal)
+    snapshots, neutral = train_neutral_c3(q1_batch, q2_batch, c3_batch)
+    eval_anchors = build_evaluation_slice(cal)
+    metrics = {}
+    selections = {}
+    for epoch in CHECKPOINTS:
+        model = restored_model(
+            epoch, q1_batch, q2_batch, c3_batch, snapshots[epoch]
+        )
+        differing = 0
+        outputs = []
+        choices = []
+        for anchor in eval_anchors:
+            present, contributions = select(model, anchor, include_c3=True)
+            knockout, _ = select(model, anchor, include_c3=False)
+            outputs.extend(contributions)
+            differing += int(present.configuration_id != knockout.configuration_id)
+            choices.append((present, knockout))
+        values = np.asarray(outputs, dtype=np.float64)
+        if not np.isfinite(values).all():
+            raise RuntimeError(f"non-finite evaluation output at epoch {epoch}")
+        metrics[str(epoch)] = {
+            "max_abs_output": float(np.max(np.abs(values))),
+            "argmax_different_anchors": differing,
+            "argmax_different_fraction": differing / len(eval_anchors),
+            "parameter_l2": parameter_l2(snapshots[epoch]),
+        }
+        selections[epoch] = choices
+
+    totals = {
+        "neutral_present": {"bits": 0.0, "joules": 0.0},
+        "knockout": {"bits": 0.0, "joules": 0.0},
+    }
+    boundary_evaluations = 0
+    selection_rows = []
+    for anchor, (present, knockout) in zip(
+        eval_anchors, selections[CHECKPOINTS[-1]], strict=True
+    ):
+        evaluator = pilot.ENGINE.StepEvaluator(
+            anchor["tape"],
+            anchor["setting"],
+            anchor["step_index"],
+            transition_from=anchor["incumbent"],
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
+                anchor["tape"], anchor["step_index"]
+            ),
+            field="realised",
+            run_setting=anchor["run_setting"],
+        )
+        evaluator.evaluate_many(tuple({
+            present.configuration_id: present,
+            knockout.configuration_id: knockout,
+        }.values()))
+        for label, config in (("neutral_present", present), ("knockout", knockout)):
+            profile = evaluator.evaluate(config)
+            totals[label]["bits"] += profile.bits
+            totals[label]["joules"] += profile.joules
+        boundary_evaluations += evaluator.physical_evaluations
+        selection_rows.append(
+            {
+                "anchor": anchor["step_index"],
+                "neutral_present_configuration_id": present.configuration_id,
+                "knockout_configuration_id": knockout.configuration_id,
+                "different": present.configuration_id != knockout.configuration_id,
+            }
+        )
+        print(
+            json.dumps({"event": "full_buffer_evaluated", "anchor": anchor["step_index"]}),
+            flush=True,
+        )
+
+    for row in totals.values():
+        row["pooled_ee_bits_per_j"] = row["bits"] / row["joules"]
+    ee_present = totals["neutral_present"]["pooled_ee_bits_per_j"]
+    ee_knockout = totals["knockout"]["pooled_ee_bits_per_j"]
+    result = {
+        "schema": "neutralcheck-c3-bounded-v1",
+        "route": ROUTE,
+        "learner_domain": LEARNER_DOMAIN,
+        "learner_seed": LEARNER_SEED,
+        "training_anchor_shards": TRAIN_ANCHORS,
+        "training_rows": int(neutral.target_psi.size),
+        "neutral_targets_all_exact_zero": bool(not np.count_nonzero(neutral.target_psi)),
+        "evaluation_world": DEVELOPMENT_WORLD_DOMAINS[2],
+        "evaluation_anchors": EVALUATION_ANCHORS,
+        "evaluation_carrier": pilot.ENGINE.REFERENCE_CARRIERS[0],
+        "evaluation_catalogue_rows": sum(len(row["catalogue"]) for row in eval_anchors),
+        "evaluation_joint_rows": sum(len(row["contexts"]) for row in eval_anchors),
+        "checkpoints": metrics,
+        "epoch_500": {
+            "selection_rows": selection_rows,
+            "different_anchors": sum(row["different"] for row in selection_rows),
+            "totals": totals,
+            "pooled_ee_absolute_difference_bits_per_j": ee_present - ee_knockout,
+            "pooled_ee_relative_difference": ee_present / ee_knockout - 1.0,
+            "full_buffer_boundary_indices": list(range(48)),
+            "physical_boundary_evaluations": boundary_evaluations,
+        },
+    }
+    print(json.dumps(result, sort_keys=True, separators=(",", ":")), flush=True)
+    peak_kib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    print(f"PEAK_RSS_KIB={peak_kib} PEAK_RSS_GIB={peak_kib / 1024**2:.6f}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/NEUTRAL-VS-KNOCKOUT-2026-09-10.md b/NEUTRAL-VS-KNOCKOUT-2026-09-10.md
new file mode 100644
index 0000000000000000000000000000000000000000..ed3481164ae91b05e2fb6fa00e0e445eba62dcb6
--- /dev/null
+++ b/NEUTRAL-VS-KNOCKOUT-2026-09-10.md
@@ -0,0 +1,130 @@
+**Neutral-source training is distinguishable from knockout in principle, but not in practical committed effect on the bounded C3 test: 0 of 5 anchors differed at epoch 500, and their pooled EE difference was exactly zero.**
+
+# NEUTRALCHECK — neutral-source training versus knockout
+
+Date: 2026-09-10
+
+## Bottom line
+
+The zero-target construction is not guaranteed to learn the identically zero function. Finite-epoch optimisation and unconstrained behaviour away from the finite training rows can leave a non-zero function; for C3, its output bias and all other residual output are added directly to the score. That happened here: the held-out maximum absolute C3 output was `20.6831760988` at epoch 500 and the parameter L2 norm was `16.1992481613`.
+
+Nevertheless, non-zero output is not the estimand. On this fixed slice it never changed a committed choice at 100, 200, 300, 400, or 500 epochs. At epoch 500, neutral-present and C3-knockout selected the same configuration at all five anchors, so their full-buffer bits, joules, and pooled EE were identical. **On this slice the two interventions are the same in effect.**
+
+This one-route, one-seed diagnostic does not establish that every route or the full `ALL_NEUTRAL_CONTROL` panel will be decision-identical. It does establish that retaining and updating a neutral head is not by itself evidence of a distinct intervention. Before `FULL - ALL_NEUTRAL_CONTROL` can serve as the primary number, the production-scale preflight must demonstrate decision-level separation from the corresponding all-route knockout; otherwise that contrast is operationally a knockout contrast despite its label.
+
+## What was verified in source
+
+### The neutral sources zero only the targets
+
+- `PairwiseBatch.neutral` passes through the original reference and candidate feature rows and replaces only `target_deltas` with `np.zeros_like(self.target_deltas)`: [learner.py lines 146–164](src/mcrl/stagec_v025/learner.py#L146-L164).
+- `CoalitionBatch.neutral` retains the contexts, copies the invariant feature matrix, and replaces only `target_psi` with `np.zeros_like(self.target_psi)`: [learner.py lines 634–655](src/mcrl/stagec_v025/learner.py#L634-L655).
+- The declared neutral metadata says the generator replaces the scalar target with exact zero while preserving support, one-to-one overlap, row weights/order, and optimisation dose: [learner.py lines 525–540](src/mcrl/stagec_v025/learner.py#L525-L540).
+- These are the active call sites: the v1 orchestrator materialises `q1_batch.neutral(...)`, `q2_batch.neutral(...)`, and `c3_batch.neutral(...)` once at construction: [learner.py lines 1012–1017](src/mcrl/stagec_v025/learner.py#L1012-L1017). Each epoch then dispatches the retained head to the informed or neutral batch according to `SOURCE_MAP`: [learner.py lines 1021–1040](src/mcrl/stagec_v025/learner.py#L1021-L1040). `ALL_NEUTRAL_CONTROL` maps all three routes to neutral: [learner.py lines 28–36](src/mcrl/stagec_v025/learner.py#L28-L36).
+
+Thus the implemented intervention is matched-row, exact-zero-target regression. It is not a shuffled, permuted, or marginal-preserving surrogate source.
+
+### Architecture, objective, regularisation, and cadence
+
+- C1 is an 8-unit ReLU MLP with `gauge_beta=0.2`; C2 is a 100–50–50 tanh MLP with `gauge_beta=0.1`; C3 is a 64–64 ReLU MLP with no gauge term. All use Adam, and every route has `weight_decay=0.0`: [learner.py lines 43–66](src/mcrl/stagec_v025/learner.py#L43-L66).
+- Every layer has a bias. Weights start non-zero at random and biases start at zero: [learner.py lines 678–701](src/mcrl/stagec_v025/learner.py#L678-L701). The final layer is linear: [learner.py lines 716–734](src/mcrl/stagec_v025/learner.py#L716-L734).
+- Pairwise training uses `f(candidate)-f(reference)-target_delta` plus the reference-output gauge term: [learner.py lines 778–791](src/mcrl/stagec_v025/learner.py#L778-L791). C3 uses direct scalar squared-error regression: [learner.py lines 793–799](src/mcrl/stagec_v025/learner.py#L793-L799) and [lines 828–841](src/mcrl/stagec_v025/learner.py#L828-L841).
+- C3 alone hard-bypasses its network to zero for empty and singleton coalitions; coalition sizes two or greater use the MLP: [learner.py lines 835–838](src/mcrl/stagec_v025/learner.py#L835-L838).
+- The sealed production budget is exactly 2,000 epochs with no early selection and 100-epoch checkpoints: [learner.py lines 38–65](src/mcrl/stagec_v025/learner.py#L38-L65) and [lines 1021–1064](src/mcrl/stagec_v025/learner.py#L1021-L1064). The contract independently requires deterministic aggregate epochs and 100-epoch checkpoints: [contract lines 18–25](V025-STAGES-6-8-CONTRACT-v1-2026-09-08.md#L18-L25).
+
+### Deployment is a plain sum
+
+- C1 and C2 enter as `f(selected)-f(reference)` differences; named knockout skips the corresponding addition: [deployment.py lines 626–645](src/mcrl/stagec_v025/deployment.py#L626-L645).
+- C3 enters as an absolute interaction output, and C3 knockout sets that contribution to zero by skipping it. The final score is exactly `additive + interaction`: [deployment.py lines 717–733](src/mcrl/stagec_v025/deployment.py#L717-L733).
+- There is no gate, normalization, softmax, or multiplicative coupling downstream. Therefore an exactly zero neutral contribution is algebraically identical to absence. The contract nevertheless names learned source substitution and checkpoint knockout as distinct experiments: [contract lines 20–23](V025-STAGES-6-8-CONTRACT-v1-2026-09-08.md#L20-L23).
+
+## Q1 — derived on paper
+
+For a neutral pairwise head, let `f_r=f(reference)`, `f_c=f(candidate)`, `n` be the row count, `w` the loss weight, and `beta>0` the gauge coefficient. The implemented empirical objective is
+
+`L = (w/n) Σ [(f_c - f_r)^2 + beta f_r^2]`.
+
+The zero function is representable and reaches the global minimum `L=0`. At any exact global minimum on the training batch, `f_r=0` and `f_c=0` for every pair. The gauge therefore removes a free common offset on training references; it does not create a distinct non-zero neutral solution. In deployment, the output-layer bias and any other perfectly constant output cancel exactly from C1/C2 score differences anyway.
+
+For C3, the objective is
+
+`L3 = (w/n3) Σ f(x)^2`.
+
+Again, zero is a global minimum and every exact empirical global minimizer outputs zero on all C3 training vectors. C3's bias does not cancel in deployment, however, because its output is added absolutely for coalitions of size at least two.
+
+What can keep a neutral head different from zero is therefore:
+
+1. **Finite optimisation.** Fixed-learning-rate Adam stops at an exact epoch budget; there is no convergence test or proof. Residual output may remain at 500 or even 2,000 epochs.
+2. **Finite-support generalisation.** Exact zero on every training row does not imply zero elsewhere for an over-parameterised MLP.
+3. **No norm regularisation.** `weight_decay=0.0`; a zero-output solution can retain large internal parameters, and many parameterizations represent the same training outputs.
+4. **C3's absolute output.** A surviving C3 bias or structured residual affects coalition rows directly. Its hard zero for size 0/1 also means a near-constant non-zero MLP is effectively a coalition-size gate.
+5. **Not the combiner.** The combiner cannot distinguish exact zero from absence because it is a plain sum. `gauge_beta` pushes pairwise heads toward zero on references rather than supplying a distinct signal.
+
+### Is the difference bounded?
+
+**On training rows, yes, conditionally on the empirical objective.** Non-negativity gives `|f_c-f_r| <= sqrt(nL/w)` and `|f_r| <= sqrt(nL/(w beta))`; for C3, `|f(x)| <= sqrt(n3 L3/w)`. These are output bounds on the fitted training rows only. They are not EE evidence.
+
+**On a fixed finite evaluation catalogue, yes, empirically.** If the maximum absolute C3 output is `epsilon`, a row score moves by at most `epsilon`. For a pairwise route with per-state maximum `epsilon`, a profile of `U` users moves by at most `2U epsilon` (usually less when unchanged users cancel). A winner whose margin exceeds twice the uniform score perturbation cannot change.
+
+**Under the sealed procedure in general, no useful uniform out-of-sample or EE bound exists.** Inputs are not clipped, C1/C3 use ReLU, and parameters have no norm bound. More importantly, argmax is discontinuous at ties: an arbitrarily small residual can change a choice when the knockout margin is zero, and the resulting physical EE change need not be small in proportion to the score residual. Loss is never used here as evidence about EE.
+
+## Q2 — verified by running code
+
+The bounded run trained one C3 neutral head, one seed (`V025_LEARNER/seed/1`, integer `6407676579069309528`), on five current-v2 in-memory training rows. Targets were checked to be exactly zero. For the additive background at each checkpoint, it restored the matched seed's DROP_C3 C1/C2 heads; only presence versus removal of the newly trained neutral C3 contribution varied.
+
+The fixed evaluation set was `V025_PROBE/world/3`, five anchors, the `nearest-eligible` carrier, 4,905 catalogue rows in total, including 1,045 joint rows on which C3 runs. “Argmax fraction” below means the fraction of the five anchor-catalogues whose winning row changed; a literal per-row argmax fraction is undefined because each catalogue has one argmax.
+
+| Epoch | Maximum absolute neutral C3 output | Argmax-changing anchor-catalogues | Parameter L2 norm |
+|---:|---:|---:|---:|
+| 100 | 21.8339367138 | 0/5 (0%) | 16.1970877366 |
+| 200 | 20.8261638773 | 0/5 (0%) | 16.1988464425 |
+| 300 | 20.6862106040 | 0/5 (0%) | 16.1992388828 |
+| 400 | 20.6831681401 | 0/5 (0%) | 16.1992481857 |
+| 500 | 20.6831760988 | 0/5 (0%) | 16.1992481613 |
+
+The head did **not** collapse to the zero function or to zero parameters. It retained large, structured held-out output, while remaining decision-inert against the much larger additive-score margins on these five catalogues. Parameter norm alone would not prove functional distinction, but the directly measured non-zero outputs do.
+
+## Q3 — decisive committed-selection test, verified by running code
+
+At epoch 500:
+
+| Quantity | Neutral C3 present | C3 term removed | Difference |
+|---|---:|---:|---:|
+| Committed anchors | 5 | 5 | **0 anchors differed** |
+| Full-buffer bits numerator | 681,921,001,974.815 | 681,921,001,974.815 | 0 |
+| Full-buffer joules denominator | 17,003.09909828719 | 17,003.09909828719 | 0 |
+| Pooled EE (bit/J) | 40,105,688.85312845 | 40,105,688.85312845 | **0 bit/J (0% relative)** |
+
+The physical pass used realised boundaries `0..47`, the engine's default complete boundary grid: [matrix probe lines 763–823](.scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py#L763-L823). Five identical selection pairs required 240 physical boundary evaluations. Boundary rates are integrated into the full-buffer bits numerator over the 47 subintervals: [batch.py lines 416–440](src/mcrl/physics_v025/batch.py#L416-L440). The declared estimator is pooled `Σbits/Σjoules`: [contract lines 27–30](V025-STAGES-6-8-CONTRACT-v1-2026-09-08.md#L27-L30) and [merge.py lines 1005–1009](src/mcrl/stagec_v025/merge.py#L1005-L1009).
+
+This is a mechanical equality result, not an EE claim for C3 or any route. Because the configurations were identical, the equality is exact by construction rather than a claim that either policy has better EE.
+
+## Q4 — proposed distinct neutral source; not implemented
+
+Replace the exact-zero targets with a **pre-sealed within-stratum derangement of the informative targets**. For example, permute C3 targets among rows sharing setting and coalition-size strata, and permute pairwise targets among rows sharing setting and action-count strata. This preserves target marginals and training difficulty while breaking the row-level relationship between features and labels. If a stratum is too small for a derangement, its fallback or exclusion rule must be declared before any outcome is inspected.
+
+For this to remain a fair comparator it must preserve:
+
+- exactly the same feature rows, legal support, strata, overlap, row weights, stable order, and row count;
+- the same architecture, initialization, optimizer, learning rate, batch schedule, number of updates, checkpoints, and deployment machinery;
+- the target distribution within predeclared scientifically relevant strata, including scale and, where intended, sign frequencies;
+- a deterministic permutation seed and digest sealed before training, with no evaluation/test information used;
+- demonstrably broken feature-target pairing, so the control removes informative alignment rather than target magnitude or optimisation dose.
+
+That construction would make “informative source versus neutral source” a genuine information-content intervention. It would not guarantee different committed decisions—no comparator can—but it would no longer make the zero function the intended optimum and therefore would not collapse conceptually into knockout.
+
+## Run boundary and resource receipt
+
+- Runner: [.scratch/neutralcheck/run_neutral_vs_knockout.py](.scratch/neutralcheck/run_neutral_vs_knockout.py).
+- Interpreter: `/home/sat/mcrl-leo-handover/.venv/bin/python` only.
+- One Python process, `nice -n 15`; `OMP_NUM_THREADS`, `OPENBLAS_NUM_THREADS`, `MKL_NUM_THREADS`, `NUMEXPR_NUM_THREADS`, `VECLIB_MAXIMUM_THREADS`, and `BLIS_NUM_THREADS` were all `1`.
+- Successful run wall time: 232.47 s. No sealed file was written or modified; current-v2 training rows were constructed only in memory.
+- The stored v1 pilot coalition rows were deliberately not coerced through the current v2 schema. Two preliminary attempts stopped on schema/checkpoint-inventory validation before producing measurements; the table and Q3 use only the successful run.
+
+`PEAK_RSS_KIB=1235368 PEAK_RSS_GIB=1.178139`
+
+## Claim classification
+
+- **Verified by running code:** exact-zero C3 targets; all Q2 values; 0/5 decision differences; equal full-buffer bits/joules/pooled EE; 48-boundary evaluation; peak RSS.
+- **Verified by source inspection:** neutral call sites; objectives and literals; deployment algebra; cadence; pooled estimator.
+- **Derived on paper:** global-minimum conditions, bias cancellation, conditional training-row bounds, and lack of a sealed out-of-sample/EE bound.
+- **Inferred:** the planned primary contrast is scientifically unsafe unless production-scale neutral-versus-knockout decision separation is demonstrated. The bounded result itself applies only to C3, one seed, five training rows, and five evaluation anchors.

