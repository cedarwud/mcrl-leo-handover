+from mcrl.stagec_v025.canonical import canonical_sha256
+from mcrl.stagec_v025.coalitions import CoalitionShard
+from mcrl.stagec_v025.learner import (
+    AdamMLPHead,
+    AdamSetInteractionHead,
+    CoalitionBatch,
+    V1LineageOrchestrator,
+    V1ThreeRouteModel,
+    build_pairwise_batches,
+    default_synthetic_neutral_sources,
+)
+from mcrl.stagec_v025.shards import read_source_shard
+
+import scripts.run_v025_pilot_c3 as pilot
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE_ROOT = ROOT / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
+CHECKPOINT_ROOT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/checkpoints"
+TRAIN_ANCHORS = 5
+EVALUATION_ANCHORS = 5
+CHECKPOINTS = (100, 200, 300, 400, 500)
+LEARNER_DOMAIN = "V025_LEARNER/seed/1"
+LEARNER_SEED = seed_from_domain(LEARNER_DOMAIN)
+ROUTE = "C3"
+
+
+def parameter_l2(head: AdamSetInteractionHead) -> float:
+    network = head.network
+    squared = math.fsum(
+        float(np.sum(np.square(array)))
+        for array in (*network.weights, *network.biases)
+    )
+    return math.sqrt(squared)
+
+
+def calibration() -> pilot.PilotCalibration:
+    payload = json.loads(
+        (SOURCE_ROOT / "PILOT_NOT_CLAIM-calibration.json").read_text(encoding="ascii")
+    )
+    ratio = lambda name: Fraction(*payload[name])
+    return pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def training_batches(cal):
+    source_paths = sorted(
+        (SOURCE_ROOT / "rows/world-1").glob("*source-anchor-*.jsonl")
+    )[:TRAIN_ANCHORS]
+    source_shards = [read_source_shard(path) for path in source_paths]
+    pairwise = {
+        route: pilot._aggregate_pair_batch(batch)
+        for route, batch in build_pairwise_batches(source_shards).items()
+    }
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="neutralcheck-training"),
+        steps=TRAIN_ANCHORS + 3,
+        start_time_s=0.0,
+    )
+    coalition_rows = []
+    anchor_index = 0
+    for step_index in range(TRAIN_ANCHORS):
+        for carrier in pilot.ENGINE.REFERENCE_CARRIERS:
+            built = pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=cal,
+                step_index=step_index,
+                carrier=carrier,
+                anchor_index=anchor_index,
+                include_coalition=True,
+            )
+            coalition_rows.append(built["coalition_row"])
+            anchor_index += 1
+            print(
+                json.dumps({"event": "training_anchor_built", "anchor": anchor_index}),
+                flush=True,
+            )
+            if anchor_index == TRAIN_ANCHORS:
+                break
+        if anchor_index == TRAIN_ANCHORS:
+            break
+    rows_sha256 = canonical_sha256([row.payload() for row in coalition_rows])
+    shard = CoalitionShard(
+        Path("<neutralcheck-in-memory-v2>"),
+        canonical_sha256({"rows_sha256": rows_sha256}),
+        rows_sha256,
+        tuple(coalition_rows),
+    )
+    return pairwise["C1"], pairwise["C2"], CoalitionBatch.create((shard,))
+
+
+def train_neutral_c3(q1_batch, q2_batch, c3_batch):
+    orchestrator = V1LineageOrchestrator(
+        learner_seed=LEARNER_SEED,
+        q1_batch=q1_batch,
+        q2_batch=q2_batch,
+        c3_batch=c3_batch,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    neutral = orchestrator._neutral_c3
+    if np.count_nonzero(neutral.target_psi):
+        raise RuntimeError("neutral C3 target is not exactly zero")
+    head = orchestrator.models["DROP_C3"].psi
+    snapshots = {}
+    for epoch in range(1, CHECKPOINTS[-1] + 1):
+        head.update(neutral)
+        if epoch in CHECKPOINTS:
+            snapshots[epoch] = head.clone()
+            print(json.dumps({"event": "trained", "epoch": epoch}), flush=True)
+    return snapshots, neutral
+
+
+def restored_model(epoch, q1_batch, q2_batch, c3_batch, psi):
+    path = CHECKPOINT_ROOT / (
+        f"PILOT_NOT_CLAIM-seed-{LEARNER_SEED}-DROP_C3-epoch-{epoch:04d}.json"
+    )
+    payload = json.loads(path.read_text(encoding="ascii"))["model"]
+    orchestrator = V1LineageOrchestrator(
+        learner_seed=LEARNER_SEED,
+        q1_batch=q1_batch,
+        q2_batch=q2_batch,
+        c3_batch=c3_batch,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    model = orchestrator.models["DROP_C3"]
+    if not isinstance(model.q1, AdamMLPHead) or not isinstance(model.q2, AdamMLPHead):
+        raise TypeError("unexpected pairwise head kind")
+    V1LineageOrchestrator._restore_adam_head(model.q1, payload["C1"])
+    V1LineageOrchestrator._restore_adam_head(model.q2, payload["C2"])
+    return V1ThreeRouteModel(model.q1, model.q2, psi.clone())
+
+
+def build_evaluation_slice(cal):
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    domain = DEVELOPMENT_WORLD_DOMAINS[2]
+    tape = build_world_tape(
+        domain=domain,
+        provider=LegacyWorldProvider(role="neutralcheck-evaluation"),
+        steps=EVALUATION_ANCHORS + 3,
+        start_time_s=0.0,
+    )
+    anchors = []
+    carrier = pilot.ENGINE.REFERENCE_CARRIERS[0]
+    for step_index in range(EVALUATION_ANCHORS):
+        built = pilot._build_anchor_rows(
+            tape=tape,
+            setting=setting,
+            run_setting=run_setting,
+            calibration=cal,
+            step_index=step_index,
+            carrier=carrier,
+            anchor_index=step_index,
+            include_coalition=False,
+            full_legal_actions=True,
+        )
+        base = built["base"]
+        catalogue, census = pilot.ENGINE._catalogue_with_census(
+            tape,
+            step_index,
+            base,
+            setting=setting,
+            calibration=cal,
+            run_setting=run_setting,
+        )
+        contexts = {}
+        states = {}
+        for config in catalogue:
+            if config.changed_users >= 2:
+                context = pilot._coalition_context(
+                    tape=tape,
+                    step_index=step_index,
+                    anchor=base,
+                    selected=config,
+                    rows_by_user_action=built["rows_by_user_action"],
+                )
+                contexts[config.configuration_id] = context
+                states[config.configuration_id] = context.invariant_vector(
+                    member_width=next(iter(context.members)).invariant_features.__len__()
+                )
+        anchors.append(
+            {
+                "step_index": step_index,
+                "base": base,
+                "incumbent": built["incumbent"],
+                "rows": built["rows_by_user_action"],
+                "catalogue": catalogue,
+                "contexts": contexts,
+                "states": states,
+                "catalogue_census": census,
+                "tape": tape,
+                "setting": setting,
+                "run_setting": run_setting,
+            }
+        )
+        print(
+            json.dumps(
+                {
+                    "event": "evaluation_anchor_built",
+                    "anchor": step_index,
+                    "catalogue_rows": len(catalogue),
+                    "joint_rows": len(contexts),
+                }
+            ),
+            flush=True,
+        )
+    return anchors
+
+
+def select(model, anchor, *, include_c3):
+    base = anchor["base"]
+    rows = anchor["rows"]
+    deltas = {}
+    for (user, action), row in rows.items():
+        reference = rows[(user, base.mapping[user])]
+        deltas[(user, action)] = (
+            model.q1.score(row.q1_state)
+            - model.q1.score(reference.q1_state)
+            + model.q2.score(row.q2_state)
+            - model.q2.score(reference.q2_state)
+        )
+    scored = []
+    contributions = []
+    for config in anchor["catalogue"]:
+        additive = math.fsum(
+            deltas[(user, config.mapping[user])] for user in base.mapping
+        )
+        contribution = 0.0
+        context = anchor["contexts"].get(config.configuration_id)
+        if context is not None:
+            contribution = model.interaction(context)
+        contributions.append(contribution)
+        score = additive + contribution if include_c3 else additive
+        scored.append((score, config.configuration_id, config))
+    chosen = min(scored, key=lambda row: (-row[0], row[1]))[2]
+    return chosen, contributions
+
+
+def main() -> int:
+    cal = calibration()
+    q1_batch, q2_batch, c3_batch = training_batches(cal)
+    snapshots, neutral = train_neutral_c3(q1_batch, q2_batch, c3_batch)
+    eval_anchors = build_evaluation_slice(cal)
+    metrics = {}
+    selections = {}
+    for epoch in CHECKPOINTS:
+        model = restored_model(
+            epoch, q1_batch, q2_batch, c3_batch, snapshots[epoch]
+        )
+        differing = 0
+        outputs = []
+        choices = []
+        for anchor in eval_anchors:
+            present, contributions = select(model, anchor, include_c3=True)
+            knockout, _ = select(model, anchor, include_c3=False)
+            outputs.extend(contributions)
+            differing += int(present.configuration_id != knockout.configuration_id)
+            choices.append((present, knockout))
+        values = np.asarray(outputs, dtype=np.float64)
+        if not np.isfinite(values).all():
+            raise RuntimeError(f"non-finite evaluation output at epoch {epoch}")
+        metrics[str(epoch)] = {
