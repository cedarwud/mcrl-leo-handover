   325	class LineageOrchestrator:
   326	    """Five matched learned arms plus an external BASELINE policy."""
   327	
   328	    def __init__(
   329	        self,
   330	        *,
   331	        learner_seed: int,
   332	        batches: Mapping[Route, PairwiseBatch],
   333	        learning_rate: float = 0.02,
   334	        gauge_weight: float = 0.01,
   335	    ) -> None:
   336	        if set(batches) != set(ROUTES):
   337	            raise StageCContractError("orchestrator needs exactly C1/C2/C3 batches")
   338	        self.learner_seed = int(learner_seed)
   339	        self.batches = dict(batches)
   340	        self.learning_rate = float(learning_rate)
   341	        self.gauge_weight = float(gauge_weight)
   342	        dimensions = {route: batch.reference_states.shape[1] for route, batch in batches.items()}
   343	        template = _initial_model(self.learner_seed, dimensions)
   344	        self.initialization_payload = template.payload()
   345	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
   346	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
   347	        self.completed_source_epochs = 0
   348	        self.route_update_count = 0
   349	        self.loss_history: list[dict[str, object]] = []
   350	
   351	    @property
   352	    def batch_digests(self) -> dict[str, str]:
   353	        return {route: self.batches[route].digest for route in ROUTES}
   354	
   355	    @property
   356	    def source_authority_sha256(self) -> str:
   357	        authorities = {
   358	            batch.source_authority_sha256 for batch in self.batches.values()
   359	        }
   360	        if len(authorities) != 1:
   360	        if len(authorities) != 1:
   361	            raise StageCContractError("route batches disagree on source authority")
   362	        return next(iter(authorities))
   363	
   364	    def train_epoch(self) -> dict[str, dict[str, float]]:
   365	        """One deterministic pass over C1, C2, C3 fixed aggregate batches."""
   366	
   367	        epoch_losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
   368	        for route in ROUTES:
   369	            informed = self.batches[route]
   370	            neutral = informed.neutral()
   371	            for arm in LEARNED_ARMS:
   372	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
   373	                epoch_losses[arm][route] = self.models[arm].heads[route].update(
   374	                    batch,
   375	                    learning_rate=self.learning_rate,
   376	                    gauge_weight=self.gauge_weight,
   377	                )
   378	            self.route_update_count += 1
   379	        self.completed_source_epochs += 1
   380	        self.loss_history.append({"epoch": self.completed_source_epochs, "losses": epoch_losses})
   381	        return epoch_losses
   382	
   383	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
   384	        if isinstance(epochs, bool) or epochs < 0:
   385	            raise StageCContractError("epochs must be a nonnegative integer")
   386	        for _ in range(epochs):
   387	            self.train_epoch()
   388	            if (
   389	                checkpoint_directory is not None
   390	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
   391	            ):
   392	                path = Path(checkpoint_directory) / (
   393	                    f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
   394	                )
   395	                self.write_checkpoint(path)
   396	
   397	    def checkpoint_payload(self) -> dict[str, object]:
   398	        return {
   399	            "schema": CHECKPOINT_SCHEMA,
   400	            "learner_seed": self.learner_seed,
   401	            "completed_source_epochs": self.completed_source_epochs,
   402	            "route_update_count": self.route_update_count,
   403	            "updates_per_source_epoch": len(ROUTES),
   404	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
   405	            "q1_schema_sha256": Q1_SCHEMA_SHA256,
   406	            "q2_schema_sha256": Q2_SCHEMA_SHA256,
   407	            "batch_digests": self.batch_digests,
   408	            "source_authority_sha256": self.source_authority_sha256,
   409	            "initialization_sha256": self.initialization_sha256,
   410	            "initialization": self.initialization_payload,
   411	            "arm_order": list(ARM_ORDER),
   412	            "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS},
   413	            "arm_order": list(ARM_ORDER),
   414	            "arms": {arm: self.models[arm].payload() for arm in LEARNED_ARMS},
   415	            "optimizer": {
   416	                "kind": "deterministic_full_batch_gradient_descent",
   417	                "learning_rate_hex": float_hex(self.learning_rate),
   418	                "gauge_weight_hex": float_hex(self.gauge_weight),
   419	                "state": "stateless",
   420	            },
   421	            "zero_bootstrap": True,
   422	        }
   423	
   424	    def write_checkpoint(self, path: str | Path) -> str:
   425	        return write_once_json(path, self.checkpoint_payload())
   426	
   427	    def load_checkpoint(self, path: str | Path) -> None:
   428	        payload = read_verified_json(path)
   429	        if not isinstance(payload, dict) or payload.get("schema") != CHECKPOINT_SCHEMA:
   430	            raise StageCContractError("unsupported checkpoint schema")
   431	        fixed = {
   432	            "learner_seed": self.learner_seed,
   433	            "batch_digests": self.batch_digests,
   434	            "source_authority_sha256": self.source_authority_sha256,
   435	            "initialization_sha256": self.initialization_sha256,
   436	            "initialization": self.initialization_payload,
   437	            "arm_order": list(ARM_ORDER),
   438	            "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS},
   439	            "arm_order": list(ARM_ORDER),
   440	            "q1_schema_sha256": Q1_SCHEMA_SHA256,
   441	            "q2_schema_sha256": Q2_SCHEMA_SHA256,
   442	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
   443	            "updates_per_source_epoch": len(ROUTES),
   444	            "zero_bootstrap": True,
   445	        }
   446	        for field, expected in fixed.items():
   447	            if payload.get(field) != expected:
   448	                raise StageCContractError(f"checkpoint {field} mismatch")
   449	        optimizer = payload.get("optimizer")
   450	        expected_optimizer = {
   451	            "kind": "deterministic_full_batch_gradient_descent",
   452	            "learning_rate_hex": float_hex(self.learning_rate),
   453	            "gauge_weight_hex": float_hex(self.gauge_weight),
   454	            "state": "stateless",
   455	        }
   456	        if optimizer != expected_optimizer:
   457	            raise StageCContractError("checkpoint optimizer state mismatch")
   458	        completed = int(payload.get("completed_source_epochs", -1))
   459	        updates = int(payload.get("route_update_count", -1))
   460	        if completed < 0 or updates != completed * len(ROUTES):
   461	            raise StageCContractError("checkpoint source-epoch cursor is invalid")
   462	        arms = payload.get("arms")
   463	        if not isinstance(arms, dict) or set(arms) != set(LEARNED_ARMS):
   464	            raise StageCContractError("checkpoint arm inventory drifted")
   465	        for arm in LEARNED_ARMS:
   466	            arm_payload = arms[arm]
   467	            if not isinstance(arm_payload, dict) or set(arm_payload) != set(ROUTES):
   468	                raise StageCContractError("checkpoint head inventory drifted")
   469	            for route in ROUTES:
   470	                head_payload = arm_payload[route]
   471	                if not isinstance(head_payload, dict):
   472	                    raise StageCContractError("checkpoint head payload drifted")
   473	                weights = np.asarray(
   474	                    [parse_float_hex(value, field="weight") for value in head_payload["weights_hex"]],
   475	                    dtype=np.float64,
   476	                )
   477	                if weights.shape != self.models[arm].heads[route].weights.shape:
   478	                    raise StageCContractError("checkpoint head shape drifted")
   479	                self.models[arm].heads[route].weights[:] = weights
   480	                self.models[arm].heads[route].bias = parse_float_hex(
   481	                    head_payload["bias_hex"], field="bias"
   482	                )
   483	        self.completed_source_epochs = completed
   484	        self.route_update_count = updates
