  1860	def _quantiles(values):
  1861	    if not values:
  1862	        return {"min": None, "p05": None, "p50": None, "p95": None, "max": None}
  1863	    return {
  1864	        name: float(np.quantile(values, q))
  1865	        for name, q in (("min", 0.0), ("p05", 0.05), ("p50", 0.5), ("p95", 0.95), ("max", 1.0))
  1866	    }
