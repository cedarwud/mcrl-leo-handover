  1149	def _aggregate_pair_batch(batch: PairwiseBatch) -> PairwiseBatch:
  1150	    if batch.target_deltas.size <= PILOT_AGGREGATE_PAIR_LIMIT:
  1151	        return batch
  1152	    indices = np.linspace(
  1153	        0, batch.target_deltas.size - 1, PILOT_AGGREGATE_PAIR_LIMIT,
  1154	        dtype=np.int64,
  1155	    )
  1156	    return PairwiseBatch.create(
  1157	        batch.route, batch.reference_states[indices],
  1158	        batch.candidate_states[indices], batch.target_deltas[indices],
  1159	        tuple(batch.row_identities[index] for index in indices),
  1160	        batch.source_authority_sha256,
  1161	        source_identity="informed:pilot-deterministic-4096-pair-aggregate",
  1162	        physics_digest=batch.physics_digest,
  1163	    )
