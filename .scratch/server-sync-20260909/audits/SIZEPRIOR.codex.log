#!/usr/bin/env python3
"""Compare ADDITIVE and DIRECT target parametrisations on exact labels.

DIAGNOSTIC_NOT_CLAIM.  This is an offline measurement fit only.  It never
invokes the production learner or policy runner and never writes a sealed
artifact.

Predeclared protocol (fixed before fitting)
-------------------------------------------
* Anchor split: seed 20260910, independently shuffled three-anchor blocks in
  each of two worlds; 15/5/5 blocks are train/validation/test (90/30/30
  anchors), and 5 blocks per world are quarantined because a loader smoke test
  opened them before fitting.  Hyperparameters see train and validation only.  Final models are
  refit on train+validation before the test anchors are loaded.
* Estimator family for every learned scalar: standardized random-feature ridge
  regression with a raw linear skip and a fixed ReLU random bank.  The grid is
  hidden width {64, 128} x ridge {1e-6, 1e-4, 1e-2}.  Each target/component is
  chosen by validation RMSE; ties prefer the smaller width then smaller ridge.
* Seed: 20260910 throughout.
* Set information: the existing 240-D invariant coalition vector, augmented
  by the same 144-D summed per-user raw/ReLU deviation bank used by the
  additive head.  DIRECT and the ADDITIVE interaction head receive the same
  384-D vector.  A predeclared member-only ablation removes the 163 resource
  context coordinates while retaining all per-user coordinates.
* Metrics: exactly those requested in the task, plus the predeclared context
  ablation needed to quantify the set-head information asymmetry.  Relative
  error is RMSE(error)/RMS(exact); rowwise relative medians exclude exact
  magnitudes <=1e-8.  Selection ties are broken by configuration ID.
"""

from __future__ import annotations

import argparse
from collections import Counter, defaultdict
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import json
import math
from pathlib import Path
import random
from typing import Iterable, Mapping, Sequence

import numpy as np


ROOT = Path(__file__).resolve().parents[1]
SMALL_ROOT = Path(
    "/home/sat/mcrl-v025-coalgen-ws/artifacts/"
    "v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
)
LARGE_DEVELOPMENT = ROOT / ".scratch/parametrisation-comparison/s0-large-development.jsonl"
LARGE_TEST = ROOT / ".scratch/parametrisation-comparison/s0-large-test.jsonl"
OUT = ROOT / ".scratch/parametrisation-comparison"
TUNING_PATH = OUT / "tuning.json"
RESULTS_PATH = OUT / "results.json"
REPORT_PATH = ROOT / "PARAMETRISATION-COMPARISON-2026-09-10.md"
SEED = 20260910
WIDTHS = (64, 128)
RIDGES = (1e-6, 1e-4, 1e-2)
GRID = tuple((width, ridge) for width in WIDTHS for ridge in RIDGES)
Q1_WIDTH = 16
MEMBER_WIDTH = 38
BASE_CONTEXT_WIDTH = 240
MEMBER_CONTEXT_WIDTH = 77
PER_USER_BANK_WIDTH = max(WIDTHS)
FULL_SET_WIDTH = BASE_CONTEXT_WIDTH + Q1_WIDTH + PER_USER_BANK_WIDTH
MEMBER_ONLY_SET_WIDTH = MEMBER_CONTEXT_WIDTH + Q1_WIDTH + PER_USER_BANK_WIDTH
EPSILON_RELATIVE = 1e-8


@dataclass(slots=True)
class Row:
    anchor: tuple[str, int]
    split: str
    configuration_id: str
    size: int
    base_context: np.ndarray
    selected_q1: np.ndarray
    reference_q1: np.ndarray
    additive: float
    interaction: float
    joint: float
    kappa: float
    source: str


@dataclass(slots=True)
class LinearReadout:
    mean: np.ndarray
    scale: np.ndarray
    random_weights: np.ndarray
    random_bias: np.ndarray
    width: int
    coefficients: np.ndarray

    def predict(self, values: np.ndarray) -> np.ndarray:
        standardized = (values - self.mean) / self.scale
        hidden = np.maximum(
            standardized @ self.random_weights[: self.width].T
            + self.random_bias[: self.width],
            0.0,
        )
        design = np.column_stack((standardized, hidden, np.ones(values.shape[0])))
        return design @ self.coefficients


@dataclass(slots=True)
class MemberReadout:
    width: int
    coefficients: np.ndarray

    def predict_design(self, full_design: np.ndarray) -> np.ndarray:
        columns = np.concatenate(
            (
                np.arange(Q1_WIDTH),
                np.arange(Q1_WIDTH, Q1_WIDTH + self.width),
            )
        )
        return full_design[:, columns] @ self.coefficients


def split_for(world_number: int, anchor_index: int) -> str:
    blocks = list(range(30))
    random.Random(SEED + world_number).shuffle(blocks)
    block = anchor_index // 3
    if block in set(blocks[:15]):
        return "train"
    if block in set(blocks[15:20]):
        return "validation"
    if block in set(blocks[20:25]):
        return "test"
    return "quarantine"


def key_split(world_id: str, anchor_index: int) -> str:
    return split_for(int(world_id.rsplit("/", 1)[1]), anchor_index)


def hash01(text: str) -> float:
    return int.from_bytes(hashlib.sha256(text.encode()).digest()[:8], "big") / 2**64


def action_identity_features(action: Mapping[str, object]) -> tuple[float, float]:
    norad = action["norad_id"]
    beam = action["beam_chain_id"]
    if norad is None:
        return (-1.0, -1.0)
    return (hash01(f"sat:{int(norad)}"), hash01(f"beam:{int(beam)}"))


def decode_hex(values: Sequence[str]) -> np.ndarray:
    return np.asarray([float.fromhex(value) for value in values], dtype=np.float64)


def configuration_id(context: Mapping[str, object]) -> str:
    mapping = {}
    for row in context["reference_profile"]:
        action = row["action"]
        mapping[int(row["user_id"])] = (
            None
            if action["norad_id"] is None
            else (int(action["norad_id"]), int(action["beam_chain_id"]))
        )
    for member in context["members"]:
        action = member["selected_action"]
        mapping[int(member["user_id"])] = (
            None
            if action["norad_id"] is None
            else (int(action["norad_id"]), int(action["beam_chain_id"]))
        )
    encoded = ";".join(
        f"{user}:NULL" if identity is None else f"{user}:{identity[0]}:{identity[1]}"
        for user, identity in sorted(mapping.items())
    )
    return f"CFG:{encoded}"


def context_arrays(context: Mapping[str, object]) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    members = sorted(context["members"], key=lambda item: int(item["user_id"]))
        "rows_checked": checked,
        "max_encoded_receipt_residual": max_identity,
        "family_index_sha256": manifest["family_index_sha256"],
        "manifest_file_sha256": hashlib.sha256(
            (SMALL_ROOT / "PILOT_NOT_CLAIM-manifest.json").read_bytes()
        ).hexdigest(),
        "label_convention": manifest["label_convention"],
        "invalid_proposals": manifest["invalid_proposals"],
    }


def fit_q1_bank(train_rows: Sequence[Row]) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    values = np.concatenate(
        [np.concatenate((row.selected_q1, row.reference_q1), axis=0) for row in train_rows],
        axis=0,
    )
    mean = values.mean(axis=0)
    scale = values.std(axis=0)
    scale[scale < 1e-12] = 1.0
    rng = np.random.default_rng(SEED)
    weights = rng.normal(0.0, math.sqrt(2.0 / Q1_WIDTH), size=(PER_USER_BANK_WIDTH, Q1_WIDTH))
    bias = rng.normal(0.0, 0.25, size=PER_USER_BANK_WIDTH)
    return mean, scale, weights, bias


def feature_matrices(
    rows: Sequence[Row],
    bank: tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray],
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    mean, scale, weights, bias = bank
    per_user = []
    full_set = []
    member_only = []
    for row in rows:
        selected = (row.selected_q1 - mean) / scale
        reference = (row.reference_q1 - mean) / scale
        selected_hidden = np.maximum(selected @ weights.T + bias, 0.0)
        reference_hidden = np.maximum(reference @ weights.T + bias, 0.0)
        deviation = np.concatenate(
            ((selected - reference).sum(axis=0), (selected_hidden - reference_hidden).sum(axis=0))
        )
        per_user.append(deviation)
        full_set.append(np.concatenate((row.base_context, deviation)))
        member_only.append(np.concatenate((row.base_context[:MEMBER_CONTEXT_WIDTH], deviation)))
    arrays = tuple(np.asarray(value, dtype=np.float64) for value in (per_user, full_set, member_only))
    if arrays[0].shape[1] != Q1_WIDTH + PER_USER_BANK_WIDTH:
        raise RuntimeError("per-user design width drift")
    if arrays[1].shape[1] != FULL_SET_WIDTH or arrays[2].shape[1] != MEMBER_ONLY_SET_WIDTH:
        raise RuntimeError("set design width drift")
    return arrays


def solve_ridge(design: np.ndarray, target: np.ndarray, ridge: float, *, intercept: bool) -> np.ndarray:
    if intercept:
        design = np.column_stack((design, np.ones(design.shape[0])))
    gram = design.T @ design / design.shape[0]
    penalty = np.eye(design.shape[1]) * ridge
    if intercept:
        penalty[-1, -1] = 0.0
    rhs = design.T @ target / design.shape[0]
    return np.linalg.solve(gram + penalty, rhs)


def random_bank(input_width: int) -> tuple[np.ndarray, np.ndarray]:
    rng = np.random.default_rng(SEED)
    weights = rng.normal(
        0.0, math.sqrt(2.0 / input_width), size=(max(WIDTHS), input_width)
    )
    bias = rng.normal(0.0, 0.25, size=max(WIDTHS))
    return weights, bias


def fit_set_model(values: np.ndarray, target: np.ndarray, width: int, ridge: float) -> LinearReadout:
    mean = values.mean(axis=0)
    scale = values.std(axis=0)
    scale[scale < 1e-12] = 1.0
    standardized = (values - mean) / scale
    weights, bias = random_bank(values.shape[1])
    hidden = np.maximum(standardized @ weights[:width].T + bias[:width], 0.0)
    design = np.column_stack((standardized, hidden))
    coefficients = solve_ridge(design, target, ridge, intercept=True)
    return LinearReadout(mean, scale, weights, bias, width, coefficients)


def fit_member_model(design: np.ndarray, target: np.ndarray, width: int, ridge: float) -> MemberReadout:
    columns = np.concatenate(
        (np.arange(Q1_WIDTH), np.arange(Q1_WIDTH, Q1_WIDTH + width))
    )
    coefficients = solve_ridge(design[:, columns], target, ridge, intercept=False)
    return MemberReadout(width, coefficients)


def rmse(target: np.ndarray, prediction: np.ndarray) -> float:
    return float(np.sqrt(np.mean((prediction - target) ** 2)))


def tune_set(
    train_values: np.ndarray,
    train_target: np.ndarray,
    validation_values: np.ndarray,
    validation_target: np.ndarray,
) -> tuple[dict[str, object], list[dict[str, object]]]:
    trials = []
    for width, ridge in GRID:
        model = fit_set_model(train_values, train_target, width, ridge)
        score = rmse(validation_target, model.predict(validation_values))
        trials.append({"width": width, "ridge": ridge, "validation_rmse": score})
    chosen = min(trials, key=lambda row: (row["validation_rmse"], row["width"], row["ridge"]))
    return chosen, trials


def tune_member(
    train_design: np.ndarray,
    train_target: np.ndarray,
    validation_design: np.ndarray,
    validation_target: np.ndarray,
) -> tuple[dict[str, object], list[dict[str, object]]]:
    trials = []
    for width, ridge in GRID:
        model = fit_member_model(train_design, train_target, width, ridge)
        score = rmse(validation_target, model.predict_design(validation_design))
        trials.append({"width": width, "ridge": ridge, "validation_rmse": score})
    chosen = min(trials, key=lambda row: (row["validation_rmse"], row["width"], row["ridge"]))
    return chosen, trials


def labels(rows: Sequence[Row]) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    return tuple(
        np.asarray([getattr(row, name) for row in rows], dtype=np.float64)
        for name in ("additive", "interaction", "joint")
    )


def tuning_phase() -> dict[str, object]:
    OUT.mkdir(parents=True, exist_ok=True)
    train_rows = load_small({"train"}) + load_large(LARGE_DEVELOPMENT, {"train"})
    validation_rows = load_small({"validation"}) + load_large(
        LARGE_DEVELOPMENT, {"validation"}
    )
    bank = fit_q1_bank(train_rows)
    train_member, train_full, train_member_only = feature_matrices(train_rows, bank)
    val_member, val_full, val_member_only = feature_matrices(validation_rows, bank)
    train_add, train_psi, train_joint = labels(train_rows)
    val_add, val_psi, val_joint = labels(validation_rows)

    member_choice, member_trials = tune_member(
        train_member, train_add, val_member, val_add
    )
    interaction_choice, interaction_trials = tune_set(
        train_full, train_psi, val_full, val_psi
    )
    direct_choice, direct_trials = tune_set(
        train_full, train_joint, val_full, val_joint
    )
    ablation_choice, ablation_trials = tune_set(
        train_member_only, train_psi, val_member_only, val_psi
    )
    payload = {
        "schema": "mcrl-v025-parametrisation-comparison-tuning-v1",
        "artifact_label": "DIAGNOSTIC_NOT_CLAIM",
        "seed": SEED,
        "split": {
            "unit": "three-anchor block within world",
            "blocks_per_world": {"train": 15, "validation": 5, "test": 5, "quarantine": 5},
            "train_anchors": len({row.anchor for row in train_rows}),
            "validation_anchors": len({row.anchor for row in validation_rows}),
            "test_loaded": False,
        },
        "estimator": {
            "family": "standardized fixed-ReLU-random-feature ridge with raw linear skip",
            "grid": [{"width": width, "ridge": ridge} for width, ridge in GRID],
            "criterion": "validation RMSE for each component's declared exact target",
        },
        "features": {
            "per_user_bank_width": Q1_WIDTH + PER_USER_BANK_WIDTH,
            "base_context_width": BASE_CONTEXT_WIDTH,
            "full_set_width": FULL_SET_WIDTH,
            "member_only_set_width": MEMBER_ONLY_SET_WIDTH,
            "resource_context_coordinates": FULL_SET_WIDTH - MEMBER_ONLY_SET_WIDTH,
        },
        "row_counts": {"train": len(train_rows), "validation": len(validation_rows)},
        "chosen": {
            "per_user_additive": member_choice,
            "interaction": interaction_choice,
            "direct": direct_choice,
            "member_only_interaction_ablation": ablation_choice,
        },
        "trials": {
            "per_user_additive": member_trials,
            "interaction": interaction_trials,
            "direct": direct_trials,
            "member_only_interaction_ablation": ablation_trials,
        },
    }
    TUNING_PATH.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    print(json.dumps({"event": "tuning-complete", "chosen": payload["chosen"]}, sort_keys=True))
    return payload


def explained_variance(target: np.ndarray, prediction: np.ndarray) -> float | None:
    if target.size < 2:
        return None
    variance = float(np.var(target))
    if variance <= 0.0:
        return None
    return 1.0 - float(np.var(target - prediction)) / variance


def value_summary(target: np.ndarray, prediction: np.ndarray) -> dict[str, object]:
    return {
        "n": int(target.size),
        "explained_variance": explained_variance(target, prediction),
        "rmse": rmse(target, prediction) if target.size else None,
    }


def selection_summary(
    rows: Sequence[Row], prediction: np.ndarray, train_support: set[int]
) -> dict[str, object]:
    groups = defaultdict(list)
    for index, row in enumerate(rows):
        groups[row.anchor].append(index)
    decisions = []
    for anchor in sorted(groups):
        indices = groups[anchor]
        exact_index = min(indices, key=lambda i: (-rows[i].joint, rows[i].configuration_id))
        chosen_index = min(indices, key=lambda i: (-prediction[i], rows[i].configuration_id))
        regret = rows[exact_index].joint - rows[chosen_index].joint
        if regret < 0.0 and abs(regret) < 1e-12:
            regret = 0.0
        decisions.append(
            {
                "world_id": anchor[0],
                "anchor_index": anchor[1],
                "exact_winner": rows[exact_index].configuration_id,
                "exact_winner_size": rows[exact_index].size,
                "exact_winner_value": rows[exact_index].joint,
                "chosen": rows[chosen_index].configuration_id,
                "chosen_size": rows[chosen_index].size,
                "chosen_exact_value": rows[chosen_index].joint,
                "chosen_prediction": float(prediction[chosen_index]),
                "chosen_value_error": float(prediction[chosen_index] - rows[chosen_index].joint),
                "regret": regret,
                "differs": exact_index != chosen_index,
                "outside_training_support": rows[chosen_index].size not in train_support,
            }
        )
    regrets = np.asarray([row["regret"] for row in decisions])
    by_size = {}
    for size in sorted({row["chosen_size"] for row in decisions}):
        subset = [row for row in decisions if row["chosen_size"] == size]
        values = np.asarray([row["regret"] for row in subset])
        by_size[str(size)] = {
            "n": len(subset),
            "mean": float(values.mean()),
            "median": float(np.median(values)),
            "p95": float(np.quantile(values, 0.95)),
            "differs_fraction": float(np.mean([row["differs"] for row in subset])),
        }
    outside = [row for row in decisions if row["outside_training_support"]]
    return {
        "n_anchors": len(decisions),
        "mean": float(regrets.mean()),
        "median": float(np.median(regrets)),
        "p95": float(np.quantile(regrets, 0.95)),
        "differs_fraction": float(np.mean([row["differs"] for row in decisions])),
        "selection_size_histogram": dict(
            sorted(Counter(str(row["chosen_size"]) for row in decisions).items())
        ),
        "exact_winner_size_histogram": dict(
            sorted(Counter(str(row["exact_winner_size"]) for row in decisions).items())
        ),
        "by_selected_size": by_size,
        "outside_training_support": {
            "count": len(outside),
            "fraction": len(outside) / len(decisions),
            "selected_value_error_rmse": (
                None
                if not outside
                else float(np.sqrt(np.mean([row["chosen_value_error"] ** 2 for row in outside])))
            ),
            "selection_regret_mean": (
                None if not outside else float(np.mean([row["regret"] for row in outside]))
            ),
        },
        "decisions": decisions,
    }


def predictor_metrics(
    rows: Sequence[Row], target: np.ndarray, prediction: np.ndarray, train_support: set[int]
) -> dict[str, object]:
    sizes = np.asarray([row.size for row in rows])
    by_size = {
        str(size): value_summary(target[sizes == size], prediction[sizes == size])
        for size in sorted(set(sizes.tolist()))
    }
    out_mask = np.asarray([row.size not in train_support for row in rows])
    return {
        "value": value_summary(target, prediction),
        "value_by_size": by_size,
        "out_of_support_test_rows": value_summary(target[out_mask], prediction[out_mask]),
        "selection": selection_summary(rows, prediction, train_support),
    }


def histogram(rows: Sequence[Row]) -> dict[str, int]:
    return dict(sorted(Counter(str(row.size) for row in rows).items()))


def fmt(value: object, digits: int = 6) -> str:
    if value is None:
        return "N/A"
    if isinstance(value, int):
        return str(value)
    return f"{float(value):.{digits}f}"


def table(lines: list[str], headers: Sequence[str], rows: Sequence[Sequence[object]]) -> None:
    lines.append("| " + " | ".join(headers) + " |")
    lines.append("|" + "|".join("---" for _ in headers) + "|")
    REPORT_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def final_phase() -> dict[str, object]:
    if not TUNING_PATH.exists():
        raise RuntimeError("tuning receipt is absent; run --phase tune before touching test")
    tuning = json.loads(TUNING_PATH.read_text())
    if tuning["split"]["test_loaded"] is not False or tuning["seed"] != SEED:
        raise RuntimeError("tuning receipt protocol drift")

    development = load_small({"train", "validation"}) + load_large(
        LARGE_DEVELOPMENT, {"train", "validation"}
    )
    # Refit before loading test anchors.
    bank = fit_q1_bank(development)
    dev_member, dev_full, dev_member_only = feature_matrices(development, bank)
    dev_add, dev_psi, dev_joint = labels(development)
    chosen = tuning["chosen"]
    member_model = fit_member_model(
        dev_member,
        dev_add,
        int(chosen["per_user_additive"]["width"]),
        float(chosen["per_user_additive"]["ridge"]),
    )
    interaction_model = fit_set_model(
        dev_full,
        dev_psi,
        int(chosen["interaction"]["width"]),
        float(chosen["interaction"]["ridge"]),
    )
    direct_model = fit_set_model(
        dev_full,
        dev_joint,
        int(chosen["direct"]["width"]),
        float(chosen["direct"]["ridge"]),
    )
    ablation_model = fit_set_model(
        dev_member_only,
        dev_psi,
        int(chosen["member_only_interaction_ablation"]["width"]),
        float(chosen["member_only_interaction_ablation"]["ridge"]),
    )
    constant = float(dev_joint.mean())

    # Hyperparameters are now frozen and models refit.  Load/audit test only now.
    test = load_small({"test"}) + load_large(LARGE_TEST, {"test"})
    all_small = load_small({"train", "validation", "test", "quarantine"})
    exact_audit = audit_small_exact_receipts(all_small)
    test_member, test_full, test_member_only = feature_matrices(test, bank)
    exact_add, exact_psi, exact_joint = labels(test)
    pred_add = member_model.predict_design(test_member)
    pred_psi = interaction_model.predict(test_full)
    pred_direct = direct_model.predict(test_full)
    pred_member_only_psi = ablation_model.predict(test_member_only)
    predictions = {
        "CONSTANT": np.full(exact_joint.shape, constant),
        "ADDITIVE": pred_add + pred_psi,
        "DIRECT": pred_direct,
        "EXACT_ADDITIVE_LEARNED_INTERACTION": exact_add + pred_psi,
        "LEARNED_ADDITIVE_EXACT_INTERACTION": pred_add + exact_psi,
        "ORACLE": exact_joint.copy(),
        "ADDITIVE_MEMBER_ONLY_ABLATION": pred_add + pred_member_only_psi,
    }
    train_support = set(row.size for row in development)
    predictor_results = {
        name: predictor_metrics(test, exact_joint, prediction, train_support)
        for name, prediction in predictions.items()
    }

    add_error = pred_add - exact_add
    psi_error = pred_psi - exact_psi
    joint_error = add_error + psi_error
    component_rss = math.sqrt(float(np.mean(add_error**2)) + float(np.mean(psi_error**2)))
    def rms(values: np.ndarray) -> float:
        return float(np.sqrt(np.mean(values**2)))
    def relative_rmse(error: np.ndarray, truth: np.ndarray) -> float:
        return rms(error) / rms(truth)
    def rowwise_median(error: np.ndarray, truth: np.ndarray) -> float:
        mask = np.abs(truth) > EPSILON_RELATIVE
        return float(np.median(np.abs(error[mask]) / np.abs(truth[mask])))
    additive_relative = relative_rmse(add_error, exact_add)
    amplification = {
        "additive_error_rmse": rms(add_error),
        "interaction_error_rmse": rms(psi_error),
        "joint_error_rmse": rms(joint_error),
        "error_correlation": float(np.corrcoef(add_error, psi_error)[0, 1]),
        "opposite_sign_fraction": float(np.mean(np.signbit(add_error) != np.signbit(psi_error))),
        "cancellation_factor": rms(joint_error) / component_rss,
        "additive_relative_error": additive_relative,
        "interaction_relative_error": relative_rmse(psi_error, exact_psi),
        "joint_relative_error": relative_rmse(joint_error, exact_joint),
        "relative_amplification_vs_additive": relative_rmse(joint_error, exact_joint) / additive_relative,
        "additive_rowwise_relative_median": rowwise_median(add_error, exact_add),
        "interaction_rowwise_relative_median": rowwise_median(psi_error, exact_psi),
        "joint_rowwise_relative_median": rowwise_median(joint_error, exact_joint),
    }
    full_ab = predictor_results["ADDITIVE"]
    member_ab = predictor_results["ADDITIVE_MEMBER_ONLY_ABLATION"]
    context_ablation = {
        "full_interaction_rmse": rmse(exact_psi, pred_psi),
        "member_only_interaction_rmse": rmse(exact_psi, pred_member_only_psi),
        "interaction_rmse_difference": rmse(exact_psi, pred_psi) - rmse(exact_psi, pred_member_only_psi),
        "full_additive_mean_regret": full_ab["selection"]["mean"],
        "member_only_additive_mean_regret": member_ab["selection"]["mean"],
        "selection_regret_difference": full_ab["selection"]["mean"] - member_ab["selection"]["mean"],
    }
    direct_regret = predictor_results["DIRECT"]["selection"]["mean"]
    additive_regret = predictor_results["ADDITIVE"]["selection"]["mean"]
    if direct_regret < additive_regret:
        interpretation = (
            f"DIRECT wins the declared decision metric: mean regret falls by "
            f"{additive_regret - direct_regret:.6f} normalized objective units "
            f"({(additive_regret - direct_regret) / additive_regret:.2%} relative). "
            f"Its exact-winner mismatch rate is nevertheless higher "
            f"({predictor_results['DIRECT']['selection']['differs_fraction']:.2%} versus "
            f"{predictor_results['ADDITIVE']['selection']['differs_fraction']:.2%}); the win is "
            "a reduction in the severity of mistakes, not their frequency. "
            "This supports keeping the reformulation proposal open for a sealed-contract decision; it does not itself authorize that change."
        )
    else:
        interpretation = (
            f"DIRECT does not win the declared decision metric: mean regret rises by "
            f"{direct_regret - additive_regret:.6f} normalized objective units. "
            "On this measurement the reformulation proposal should close rather than opening the sealed contract."
        )
    interaction_only_regret = predictor_results["EXACT_ADDITIVE_LEARNED_INTERACTION"]["selection"]["mean"]
    per_user_only_regret = predictor_results["LEARNED_ADDITIVE_EXACT_INTERACTION"]["selection"]["mean"]
    control_interpretation = (
        "The oracle-isolation controls do not support blaming only one half. With exact per-user terms and only the interaction learned, mean regret is "
        f"{interaction_only_regret:.6f}; with exact interaction and only the per-user terms learned, it is "
        f"{per_user_only_regret:.6f}. The learned per-user half is slightly worse by "
        f"{per_user_only_regret - interaction_only_regret:.6f}, and its value RMSE is also larger "
        f"({predictor_results['LEARNED_ADDITIVE_EXACT_INTERACTION']['value']['rmse']:.6f} versus "
        f"{predictor_results['EXACT_ADDITIVE_LEARNED_INTERACTION']['value']['rmse']:.6f}), but both isolated controls are worse than the fully learned ADDITIVE arm because the two realised component errors strongly cancel."
    )
    context_interpretation = (
        "The 163 resource-context coordinates make interaction RMSE worse by "
        f"{context_ablation['interaction_rmse_difference']:.6f}, while improving ADDITIVE mean selection regret by "
        f"{-context_ablation['selection_regret_difference']:.6f}. They therefore add decision-relevant ranking information in this fit even though they do not improve pointwise interaction calibration."
    )
    partitions = {}
    train_only = [row for row in development if row.split == "train"]
    validation_only = [row for row in development if row.split == "validation"]
    for name, rows in (
        ("train", train_only),
        ("validation", validation_only),
        ("test", test),
        ("all", [*development, *test]),
    ):
        partitions[name] = {
            "anchors": len({row.anchor for row in rows}),
            "rows": len(rows),
            "size_histogram": histogram(rows),
        }
    result = {
        "schema": "mcrl-v025-parametrisation-comparison-results-v1",
        "artifact_label": "DIAGNOSTIC_NOT_CLAIM",
        "corpus": {
            "small_path": str(SMALL_ROOT),
            "large_development_path": str(LARGE_DEVELOPMENT),
            "large_test_path": str(LARGE_TEST),
            "large_rows": sum(row.source == "s0-large" for row in [*development, *test]),
            "partitions": partitions,
        },
        "exact_audit": exact_audit,
        "estimator": {
            "family": tuning["estimator"]["family"],
            "grid": tuning["estimator"]["grid"],
            "chosen": chosen,
            "seed": SEED,
        },
        "predictors": predictor_results,
        "additive_amplification": amplification,
        "context_ablation": context_ablation,
        "out_of_support": {"training_size_support": sorted(train_support)},
        "interpretation": interpretation,
        "control_interpretation": control_interpretation,
        "context_interpretation": context_interpretation,
    }
    RESULTS_PATH.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
    write_report(result)
    print(
        json.dumps(
            {
                "event": "final-complete",
                "direct_mean_regret": direct_regret,
                "additive_mean_regret": additive_regret,
                "direct_beats": direct_regret < additive_regret,
                "report": str(REPORT_PATH),
            },
            sort_keys=True,
        )
    )
    return result



