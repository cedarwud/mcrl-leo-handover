@@ -0,0 +1,566 @@
+#!/usr/bin/env python3
+"""Compare the learned interaction head with a fixed per-size prior.
+
+DIAGNOSTIC_NOT_CLAIM. This is an offline measurement fit on copies only. It
+does not invoke production training, a policy run, or an acceptance test.
+
+The full protocol was fixed before fitting in
+`.scratch/parametrisation-comparison/size-prior-spec.md`.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import Mapping, Sequence
+
+import numpy as np
+
+import compare_target_parametrisations as harness
+
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / ".scratch/parametrisation-comparison"
+SPEC_PATH = OUT / "size-prior-spec.md"
+RESULTS_PATH = OUT / "size-prior-results.json"
+REPORT_PATH = ROOT / "SIZE-PRIOR-COMPARATOR-2026-09-10.md"
+FROZEN_RESULTS_PATH = OUT / "results.json"
+EXPECTED_SEED = 20260910
+EXPECTED_TUNING_SCHEMA = "mcrl-v025-parametrisation-comparison-tuning-v1"
+EXPECTED_FAMILY = "standardized fixed-ReLU-random-feature ridge with raw linear skip"
+SCORE_QUANTILES = (0.05, 0.5, 0.95)
+PREDICTOR_NAMES = ("LEARNED_PSI", "SIZE_PRIOR", "ZERO_PSI", "EXACT_PSI")
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def fit_size_prior(rows: Sequence[harness.Row], target: np.ndarray) -> dict[int, float]:
+    """Categorical least squares: one unregularized coefficient per size."""
+    sizes = np.asarray([row.size for row in rows], dtype=np.int64)
+    support = sorted(set(sizes.tolist()))
+    prior = {size: float(np.mean(target[sizes == size])) for size in support}
+    fitted = np.asarray([prior[int(size)] for size in sizes], dtype=np.float64)
+    # The OLS normal equations for one-hot size indicators are zero within group.
+    for size in support:
+        residual_sum = float(np.sum((target - fitted)[sizes == size]))
+        if not math.isclose(residual_sum, 0.0, rel_tol=0.0, abs_tol=1e-9):
+            raise RuntimeError(f"size-prior normal equation failed at size {size}")
+    return prior
+
+
+def compact_selection(
+    rows: Sequence[harness.Row], prediction: np.ndarray, train_support: set[int]
+) -> dict[str, object]:
+    full = harness.selection_summary(rows, prediction, train_support)
+    return {
+        key: full[key]
+        for key in (
+            "n_anchors",
+            "mean",
+            "median",
+            "p95",
+            "differs_fraction",
+            "selection_size_histogram",
+            "exact_winner_size_histogram",
+            "by_selected_size",
+            "decisions",
+        )
+    }
+
+
+def distribution(values: np.ndarray) -> dict[str, object]:
+    q05, median, q95 = np.quantile(values, SCORE_QUANTILES)
+    return {
+        "n": int(values.size),
+        "mean": float(np.mean(values)),
+        "population_std": float(np.std(values)),
+        "min": float(np.min(values)),
+        "p05": float(q05),
+        "median": float(median),
+        "p95": float(q95),
+        "max": float(np.max(values)),
+    }
+
+
+def fmt(value: object, digits: int = 6) -> str:
+    if value is None:
+        return "N/A"
+    if isinstance(value, int):
+        return str(value)
+    return f"{float(value):.{digits}f}"
+
+
+def table(
+    lines: list[str], headers: Sequence[str], rows: Sequence[Sequence[object]]
+) -> None:
+    lines.append("| " + " | ".join(headers) + " |")
+    lines.append("|" + "|".join("---" for _ in headers) + "|")
+    lines.extend("| " + " | ".join(str(cell) for cell in row) + " |" for row in rows)
+
+
+def assert_reference_reproduction(
+    frozen: Mapping[str, object], learned: Mapping[str, object]
+) -> dict[str, float]:
+    reference = frozen["predictors"]["ADDITIVE"]
+    checks = {
+        "selection_mean_abs_difference": abs(
+            learned["selection"]["mean"] - reference["selection"]["mean"]
+        ),
+        "selection_median_abs_difference": abs(
+            learned["selection"]["median"] - reference["selection"]["median"]
+        ),
+        "selection_p95_abs_difference": abs(
+            learned["selection"]["p95"] - reference["selection"]["p95"]
+        ),
+        "selection_differs_abs_difference": abs(
+            learned["selection"]["differs_fraction"]
+            - reference["selection"]["differs_fraction"]
+        ),
+        "value_explained_variance_abs_difference": abs(
+            learned["value"]["explained_variance"]
+            - reference["value"]["explained_variance"]
+        ),
+        "value_rmse_abs_difference": abs(
+            learned["value"]["rmse"] - reference["value"]["rmse"]
+        ),
+    }
+    if max(checks.values()) > 1e-12:
+        raise RuntimeError(f"LEARNED_PSI failed to reproduce ADDITIVE: {checks}")
+    if (
+        learned["selection"]["selection_size_histogram"]
+        != reference["selection"]["selection_size_histogram"]
+    ):
+        raise RuntimeError("LEARNED_PSI selection histogram failed to reproduce ADDITIVE")
+    return checks
+
+
+def make_first_line(result: Mapping[str, object]) -> str:
+    margin = result["regret_margins"]["learned_minus_size_prior"]
+    learned = result["predictors"]["LEARNED_PSI"]["selection"]["mean"]
+    size = result["predictors"]["SIZE_PRIOR"]["selection"]["mean"]
+    if margin < 0.0:
+        return (
+            "**LEARNED_PSI beats SIZE_PRIOR on held-out mean selection regret: "
+            f"{learned:.6f} vs {size:.6f}; signed margin "
+            f"LEARNED_PSI − SIZE_PRIOR = {margin:+.6f} normalized objective units.**"
+        )
+    if margin == 0.0:
+        return (
+            "**SIZE_PRIOR matches LEARNED_PSI on held-out mean selection regret: "
+            f"both are {learned:.6f}; signed margin LEARNED_PSI − SIZE_PRIOR = "
+            f"{margin:+.6f} normalized objective units.**"
+        )
+    return (
+        "**SIZE_PRIOR beats LEARNED_PSI on held-out mean selection regret: "
+        f"{size:.6f} vs {learned:.6f}; signed margin LEARNED_PSI − SIZE_PRIOR = "
+        f"{margin:+.6f} normalized objective units.**"
+    )
+
+
+def write_report(result: Mapping[str, object]) -> None:
+    predictors = result["predictors"]
+    margins = result["regret_margins"]
+    agreement = result["pairwise_agreement"]
+    lines = [
+        make_first_line(result),
+        "",
+        "# Size-prior comparator — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM`",
+        "",
+        "No production training run, policy run, or acceptance test was performed. This is an offline fit on copies for measurement only. No sealed contract, target, scorer, schema digest, manifest, constant, threshold, sign, seed, horizon, price, service guard, or acceptance rule was modified.",
+        "",
+        "## Direct answer",
+        "",
+    ]
+    learned_gain = margins["size_prior_minus_learned_gain"]
+    size_gain = margins["zero_minus_size_prior_gain"]
+    if learned_gain > size_gain:
+        comparison = "larger"
+    elif learned_gain < size_gain:
+        comparison = "smaller"
+    else:
+        comparison = "equal"
+    lines.append(
+        f"The learned interaction head's gain over the size prior is {learned_gain:+.6f} "
+        f"(`SIZE_PRIOR − LEARNED_PSI`). The size prior's gain over zero is "
+        f"{size_gain:+.6f} (`ZERO_PSI − SIZE_PRIOR`). The learned-head gain is "
+        f"**{comparison}** than the size-prior-versus-zero gain. In the requested signed "
+        f"left-minus-right convention, `LEARNED_PSI − SIZE_PRIOR` is "
+        f"{margins['learned_minus_size_prior']:+.6f}, and `SIZE_PRIOR − ZERO_PSI` is "
+        f"{margins['size_prior_minus_zero']:+.6f}; negative means the left scorer has lower regret."
+    )
+    lines.extend(
+        [
+            "",
+            "## Frozen protocol and fitted size prior",
+            "",
+            "The comparator reuses the exact-label loaders, frozen three-anchor-block split, seed `20260910`, Q1 feature construction, fixed-ReLU random-feature ridge family, grid choices, final train+validation refit, selection pools, and configuration-ID tie-break from `scripts/compare_target_parametrisations.py`. Neither scorer was tuned here: the learned heads use the already frozen hyperparameters, while the size prior is a single categorical least-squares fit to the exact interaction label on the same 8,231 final fitting rows.",
+            "",
+            "For a one-hot categorical size design, least squares sets each coefficient to that size's training-label mean. It sees only the integer coalition size; there is no interpolation, regularization, set context, member identity, or other feature.",
+            "",
+        ]
+    )
+    table(
+        lines,
+        ("coalition size", "fit rows", "fitted interaction prior"),
+        [
+            (size, item["n"], fmt(item["value"]))
+            for size, item in sorted(
+                ((int(key), value) for key, value in result["size_prior"].items())
+            )
+        ],
+    )
+    lines.extend(["", "## Held-out selection regret", ""])
+    table(
+        lines,
+        ("scorer", "mean", "median", "p95", "choice differs", "selection sizes"),
+        [
+            (
+                name,
+                fmt(predictors[name]["selection"]["mean"]),
+                fmt(predictors[name]["selection"]["median"]),
+                fmt(predictors[name]["selection"]["p95"]),
+                f"{predictors[name]['selection']['differs_fraction']:.2%}",
+                f"`{predictors[name]['selection']['selection_size_histogram']}`",
+            )
+            for name in PREDICTOR_NAMES
+        ],
+    )
+    lines.extend(
+        [
+            "",
+            f"Exact-winner size distribution: `{predictors['LEARNED_PSI']['selection']['exact_winner_size_histogram']}`.",
+            "",
+            "### Selection regret by selected coalition size",
+            "",
+        ]
+    )
+    stratified = []
+    for name in PREDICTOR_NAMES:
+        for size, values in predictors[name]["selection"]["by_selected_size"].items():
+            stratified.append(
+                (
+                    name,
+                    size,
+                    values["n"],
+                    fmt(values["mean"]),
+                    fmt(values["median"]),
+                    fmt(values["p95"]),
+                    f"{values['differs_fraction']:.2%}",
+                )
+            )
+    table(
+        lines,
+        ("scorer", "selected k", "n", "mean", "median", "p95", "differs"),
+        stratified,
+    )
+    lines.extend(["", "## Held-out value error", ""])
+    table(
+        lines,
+        ("scorer", "explained variance", "RMSE"),
+        [
+            (
+                name,
+                fmt(predictors[name]["value"]["explained_variance"]),
+                fmt(predictors[name]["value"]["rmse"]),
+            )
+            for name in PREDICTOR_NAMES
+        ],
+    )
+    lines.extend(
+        [
+            "",
+            "## LEARNED_PSI versus SIZE_PRIOR",
+            "",
+            f"They commit the same configuration on {agreement['same_configuration_count']} of {agreement['n_anchors']} held-out anchors ({agreement['same_configuration_fraction']:.2%}). Score differences below are `LEARNED_PSI − SIZE_PRIOR` over all held-out rows, as fixed before fitting.",
+            "",
+        ]
+    )
+    dist = agreement["score_difference_distribution"]
+    table(
+        lines,
+        ("n", "mean", "population SD", "min", "p05", "median", "p95", "max"),
+        [
+            (
+                dist["n"],
+                fmt(dist["mean"]),
+                fmt(dist["population_std"]),
+                fmt(dist["min"]),
+                fmt(dist["p05"]),
+                fmt(dist["median"]),
+                fmt(dist["p95"]),
+                fmt(dist["max"]),
+            )
+        ],
+    )
+    disagreements = agreement["disagreements"]
+    lines.extend(
+        [
+            "",
+            "### Where their selections disagree",
+            "",
+            "Each objective below is the exact normalized joint objective change of that scorer's selected configuration. `higher exact choice` is based only on those two committed configurations; `TIE` means their different configurations have equal exact objective.",
+            "",
+        ]
+    )
+    table(
+        lines,
+        (
+            "world",
+            "anchor",
+            "learned k",
+            "learned exact objective",
+            "size-prior k",
+            "size-prior exact objective",
+            "higher exact choice",
+        ),
+        [
+            (
+                row["world_id"],
+                row["anchor_index"],
+                row["learned_size"],
+                fmt(row["learned_exact_objective"]),
+                row["size_prior_size"],
+                fmt(row["size_prior_exact_objective"]),
+                row["higher_exact_choice"],
+            )
+            for row in disagreements
+        ],
+    )
+    lines.extend(
+        [
+            "",
+            "## Exact-label and reuse checks",
+            "",
+            f"The source exact-label audit checked {result['exact_audit']['rows_checked']} mechanism rows against Fraction receipts with maximum encoded residual {result['exact_audit']['max_encoded_receipt_residual']:.3e}; all 300 local size-100 rows were loaded through the prior harness's exact receipt checks. Source shards supplied features only; the pilot fallback labels were never read as targets. The family-index SHA-256 is `{result['exact_audit']['family_index_sha256']}`.",
+            "",
+            "The recomputed `LEARNED_PSI` selection mean, median, p95, mismatch fraction, explained variance, and RMSE reproduce the frozen comparison's `ADDITIVE` values within `1e-12`, and its selection-size histogram matches exactly.",
+            "",
+            "## What this did not reach",
+            "",
+            "This is not a production training run, policy run, or acceptance test, and it does not estimate downstream policy value or establish that any route individually raises pooled energy efficiency. It tests only whether the learned interaction head improves held-out selection within the available exact-labelled pools relative to a fitted size-only correction. Those pools are catalogue/mechanism candidates, not the full combinatorial action space. The mechanism corpus has no per-row served-count receipt, so this does not stratify by that sealed guard. Sizes 7–99 are absent, so the size-only curve is observed only at 2–6 and 100. No confidence interval or repeated-seed result was reached because the experiment fixes one split and seed and forbids adding metrics after seeing results.",
+            "",
+            "## Reproduction",
+            "",
+            "```bash",
+            "cd /home/sat/mcrl-v025-selector-ws",
+            "PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+            "  scripts/compare_size_prior.py",
+            "```",
+            "",
+            "Machine-readable output: `.scratch/parametrisation-comparison/size-prior-results.json`.",
+        ]
+    )
+    REPORT_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+def main() -> int:
+    if not SPEC_PATH.exists():
+        raise RuntimeError("locked protocol is absent")
+    tuning = json.loads(harness.TUNING_PATH.read_text(encoding="utf-8"))
+    if tuning["schema"] != EXPECTED_TUNING_SCHEMA:
+        raise RuntimeError("tuning schema drift")
+    if tuning["seed"] != EXPECTED_SEED or harness.SEED != EXPECTED_SEED:
+        raise RuntimeError("seed drift")
+    if tuning["split"]["test_loaded"] is not False:
+        raise RuntimeError("tuning receipt says test was loaded")
+    if tuning["estimator"]["family"] != EXPECTED_FAMILY:
+        raise RuntimeError("estimator-family drift")
+    if tuning["estimator"]["grid"] != [
+        {"width": width, "ridge": ridge} for width, ridge in harness.GRID
+    ]:
+        raise RuntimeError("estimator-grid drift")
+
+    development = harness.load_small({"train", "validation"}) + harness.load_large(
+        harness.LARGE_DEVELOPMENT, {"train", "validation"}
+    )
+    bank = harness.fit_q1_bank(development)
+    dev_member, dev_full, _ = harness.feature_matrices(development, bank)
+    dev_add, dev_psi, _ = harness.labels(development)
+    chosen = tuning["chosen"]
+    member_model = harness.fit_member_model(
+        dev_member,
+        dev_add,
+        int(chosen["per_user_additive"]["width"]),
+        float(chosen["per_user_additive"]["ridge"]),
+    )
+    interaction_model = harness.fit_set_model(
+        dev_full,
+        dev_psi,
+        int(chosen["interaction"]["width"]),
+        float(chosen["interaction"]["ridge"]),
+    )
+    size_prior = fit_size_prior(development, dev_psi)
+    size_counts = Counter(row.size for row in development)
+
+    # As in the reused harness, held-out rows are loaded only after all fits.
+    test = harness.load_small({"test"}) + harness.load_large(
+        harness.LARGE_TEST, {"test"}
+    )
+    all_small = harness.load_small({"train", "validation", "test", "quarantine"})
+    exact_audit = harness.audit_small_exact_receipts(all_small)
+    test_member, test_full, _ = harness.feature_matrices(test, bank)
+    _, exact_psi, exact_joint = harness.labels(test)
+    pred_add = member_model.predict_design(test_member)
+    pred_learned_psi = interaction_model.predict(test_full)
+    try:
+        pred_size_psi = np.asarray(
+            [size_prior[row.size] for row in test], dtype=np.float64
+        )
+    except KeyError as error:
+        raise RuntimeError(f"held-out size outside training support: {error}") from error
+
+    predictions = {
+        "LEARNED_PSI": pred_add + pred_learned_psi,
+        "SIZE_PRIOR": pred_add + pred_size_psi,
+        "ZERO_PSI": pred_add.copy(),
+        "EXACT_PSI": pred_add + exact_psi,
+    }
+    train_support = set(size_prior)
+    predictor_results = {}
+    for name, prediction in predictions.items():
+        predictor_results[name] = {
+            "selection": compact_selection(test, prediction, train_support),
+            "value": harness.value_summary(exact_joint, prediction),
+        }
+
+    learned_decisions = {
+        (row["world_id"], row["anchor_index"]): row
+        for row in predictor_results["LEARNED_PSI"]["selection"]["decisions"]
+    }
+    size_decisions = {
+        (row["world_id"], row["anchor_index"]): row
+        for row in predictor_results["SIZE_PRIOR"]["selection"]["decisions"]
+    }
+    if learned_decisions.keys() != size_decisions.keys():
+        raise RuntimeError("pairwise anchor mismatch")
+    disagreements = []
+    same = 0
+    for anchor in sorted(learned_decisions):
+        learned = learned_decisions[anchor]
+        size = size_decisions[anchor]
+        if learned["chosen"] == size["chosen"]:
+            same += 1
+            continue
+        exact_difference = learned["chosen_exact_value"] - size["chosen_exact_value"]
+        if exact_difference > 0.0:
+            higher = "LEARNED_PSI"
+        elif exact_difference < 0.0:
+            higher = "SIZE_PRIOR"
+        else:
+            higher = "TIE"
+        disagreements.append(
+            {
+                "world_id": anchor[0],
+                "anchor_index": anchor[1],
+                "learned_configuration": learned["chosen"],
+                "learned_size": learned["chosen_size"],
+                "learned_exact_objective": learned["chosen_exact_value"],
+                "size_prior_configuration": size["chosen"],
+                "size_prior_size": size["chosen_size"],
+                "size_prior_exact_objective": size["chosen_exact_value"],
+                "exact_difference_learned_minus_size_prior": exact_difference,
+                "higher_exact_choice": higher,
+            }
+        )
+
+    frozen = json.loads(FROZEN_RESULTS_PATH.read_text(encoding="utf-8"))
+    reproduction = assert_reference_reproduction(
+        frozen, predictor_results["LEARNED_PSI"]
+    )
+    learned_regret = predictor_results["LEARNED_PSI"]["selection"]["mean"]
+    size_regret = predictor_results["SIZE_PRIOR"]["selection"]["mean"]
+    zero_regret = predictor_results["ZERO_PSI"]["selection"]["mean"]
+    result = {
+        "schema": "mcrl-v025-size-prior-comparator-results-v1",
+        "artifact_label": "DIAGNOSTIC_NOT_CLAIM",
+        "protocol": {
+            "spec_path": str(SPEC_PATH),
+            "seed": EXPECTED_SEED,
+            "split": tuning["split"],
+            "estimator_family": tuning["estimator"]["family"],
+            "estimator_grid": tuning["estimator"]["grid"],
+            "chosen": {
+                "per_user_additive": chosen["per_user_additive"],
+                "interaction": chosen["interaction"],
+            },
+            "fit_partitions": ["train", "validation"],
+            "fit_rows": len(development),
+            "test_rows": len(test),
+            "test_anchors": len({row.anchor for row in test}),
+            "score_difference_summary": [
+                "n",
+                "mean",
+                "population_std",
+                "min",
+                "p05",
+                "median",
+                "p95",
+                "max",
+            ],
+            "tie_break": "configuration ID",
+        },
+        "input_sha256": {
+            "tuning": sha256(harness.TUNING_PATH),
+            "frozen_results": sha256(FROZEN_RESULTS_PATH),
+            "large_development": sha256(harness.LARGE_DEVELOPMENT),
+            "large_test": sha256(harness.LARGE_TEST),
+            "reused_harness": sha256(Path(harness.__file__)),
+        },
+        "exact_audit": exact_audit,
+        "size_prior": {
+            str(size): {"n": size_counts[size], "value": size_prior[size]}
+            for size in sorted(size_prior)
+        },
+        "predictors": predictor_results,
+        "pairwise_agreement": {
+            "n_anchors": len(learned_decisions),
+            "same_configuration_count": same,
+            "same_configuration_fraction": same / len(learned_decisions),
+            "score_difference_definition": "LEARNED_PSI minus SIZE_PRIOR over all held-out rows",
+            "score_difference_distribution": distribution(
+                predictions["LEARNED_PSI"] - predictions["SIZE_PRIOR"]
+            ),
+            "disagreements": disagreements,
+        },
+        "regret_margins": {
+            "learned_minus_size_prior": learned_regret - size_regret,
+            "size_prior_minus_zero": size_regret - zero_regret,
+            "size_prior_minus_learned_gain": size_regret - learned_regret,
+            "zero_minus_size_prior_gain": zero_regret - size_regret,
+        },
+        "reference_reproduction": {
+            "comparison_predictor": "ADDITIVE",
+            "tolerance": 1e-12,
+            "absolute_differences": reproduction,
+            "selection_histogram_exact_match": True,
+        },
+    }
+    RESULTS_PATH.write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    write_report(result)
+    print(
+        json.dumps(
+            {
+                "event": "size-prior-comparison-complete",
+                "learned_mean_regret": learned_regret,
+                "size_prior_mean_regret": size_regret,
+                "zero_mean_regret": zero_regret,
+                "learned_minus_size_prior": learned_regret - size_regret,
+                "report": str(REPORT_PATH),
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

