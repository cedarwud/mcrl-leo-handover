    )
    inventory = HardwareInventory.fixed(tuple(link.beam for link in geometry.links))
    energy = schedule_energy(inventory, ((slot.fraction, dict(slot.beam_rf_w)) for slot in radiation.slots), duration_s=duration)
    scalar_power = max(tx.rf_power_w for slot in radiation.slots for tx in slot.transmissions)
    power = float(after.max_rf_power_w[0])
    before_power = float(before.max_rf_power_w[0])
    direct = arrays.nominal_gain[0, 0]
    cross = arrays.cross_base_nominal[0, 0, 1]
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    # Symmetric fixture: all three powers equal, two equal interferers.
    nominal = power * direct / (noise + 2 * cross * power)
