+#!/usr/bin/env python3
+"""Fill the diagnostic report from the complete, verified strict experiment."""
+import json
+import math
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+REPORT = ROOT / "LADDER-FLOOR-2026-09-10.md"
+data = json.loads((HERE / "report-data-cleared.json").read_text())
+census = json.loads((HERE / "scalar-census-summary-cleared.json").read_text())
+activation = json.loads((HERE / "activation-signatures-cleared.json").read_text())
+reproduction = json.loads((HERE / "original-reproduction-audit.json").read_text())
+assert data["complete_20_anchor_panel"] and census["parity_passed"]
+assert reproduction["committed_endpoints_and_configuration_ids_exact"]
+forms = data["formulations"]
+original, margin = forms["original"], forms["margin-cleared"]
+assert margin["arms"]["ALL"]["counts"]["no_mode_uncapped"] == 0
+assert margin["arms"]["ALL"]["counts"]["served_target_miss_uncapped"] == 0
+gain = margin["oracle_over_unilateral_pct"]
+assert 0 < gain < 6.359  # If the completed outcome changes, rewrite the interpretation.
+text = REPORT.read_text()
+text = text.split("\n", 1)[1]
+text = f"The claimed occupancy-activation consolidation mechanism does not survive; oracle-over-unilateral gain falls from +6.359% to {gain:+.3f}%.\n" + text
+
+table = [
+    "| Formulation | Selector | Decoded bits (Gbit) | Energy (kJ) | Pooled EE (Mbit/J) | Served / 2,000 | Rate target attained / 2,000 |",
+    "|---|---|---:|---:|---:|---:|---:|",
+]
+for key, label in (("original", "Original"), ("margin-cleared", "Margin provisioned")):
+    for arm in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        v = forms[key]["arms"][arm]
+        table.append(f"| {label} | {arm} | {v['bits']/1e9:,.6f} | {v['joules']/1e3:,.6f} | {v['ee_bit_per_j']/1e6:,.6f} | {v['served_count_sum']:,} | {v['rate_target_attained_users_sum']:,} |")
+start = text.index("| Formulation | Selector |")
+end = text.index("\n\n**The decisive comparison", start)
+text = text[:start] + "\n".join(table) + text[end:]
+u, o = (margin["arms"][a] for a in ("UNILATERAL", "ORACLE_SET"))
+energy_change = 100 * (o["joules"] / u["joules"] - 1)
+bits_change = 100 * (o["bits"] / u["bits"] - 1)
+decisive = (
+    f"**The decisive comparison is +6.359000% versus {gain:+.6f}%.** EE is the ratio of summed bits to summed joules. "
+    f"The percentage gain is {100*(1-gain/original['oracle_over_unilateral_pct']):.2f}% smaller. "
+    f"In the variant, ORACLE_SET changes energy by {energy_change:+.4f}% and decoded bits by {bits_change:+.4f}% relative to UNILATERAL. "
+    f"Its realised EE improves on {margin['positive_oracle_ee_anchors']} anchors and declines on {margin['negative_oracle_ee_anchors']}; the original improves on all 20. "
+    f"Positive joint selection-objective improvements still exist on {margin['qualifying_set_count']}/20 variant anchors. "
+    "This smaller residual coordination gain does not validate the rejected occupancy-activation mechanism."
+)
+start = text.index("**The decisive comparison")
+end = text.index("\n\nThe selectors maximize", start)
+text = text[:start] + decisive + text[end:]
+
+lines = [
+    "A numerical trap had to be resolved before this comparison was valid. Simply dividing the target by q while retaining the finite solver unchanged produced **+0.544766%**, but left **1,179 uncapped occupancy-one NO_MODE attempts**. Their deficits below the first threshold were only 5.76e−12 to 2.616e−9 dB, with at least 0.04317 W of cap headroom. The final private variant retains the original solve, then verifies both `SINR_nominal >= Gamma/q` and `q*SINR_nominal >= threshold_target`. It raises only deficient uncapped powers with the existing capped interference update and existing numerical nudge, within the original iteration budget. All selectors were reoptimized after this correction. The uncorrected control is retained separately; it is not the decisive result.",
+    "",
+    "The census covers all 48 boundaries of all 60 committed profiles per formulation. An attempt is one transmission in a native TDM slot at one boundary. Raw counts can repeat a user's transmission when another beam changes the slot partition; airtime shares weight by the slot fraction and trapezoid boundary duration, making them the more comparable exposure measure.",
+    "",
+    "| Formulation | Selector | NO_MODE / attempts | Attempt share | Airtime share | Uncapped NO_MODE |",
+    "|---|---|---:|---:|---:|---:|",
+]
+for key, label in (("original", "Original"), ("margin-cleared", "Margin provisioned")):
+    for arm in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        v = forms[key]["arms"][arm]["counts"]
+        lines.append(f"| {label} | {arm} | {v['no_mode']:,} / {v['attempts']:,} | {100*v['no_mode_share']:.3f}% | {100*v['no_mode_duration_share']:.3f}% | {v['no_mode_uncapped']:,} |")
+lines += [
+    "", "Pooling the three selectors, the occupancy breakdown is:", "",
+    "| Occupancy | Original NO_MODE / attempts (share) | Margin NO_MODE / attempts (share) | Original airtime share | Margin airtime share |",
+    "|---:|---:|---:|---:|---:|",
+]
+old_occ = original["arms"]["ALL"]["by_occupancy"]
+new_occ = margin["arms"]["ALL"]["by_occupancy"]
+for n in sorted(set(old_occ) | set(new_occ), key=int):
+    pair = (old_occ.get(n), new_occ.get(n))
+    counts = ["No observations" if not v else f"{v['no_mode']:,} / {v['attempts']:,} ({100*v['no_mode_share']:.3f}%)" for v in pair]
+    exposure = ["—" if not v else f"{100*v['no_mode_duration_share']:.3f}%" for v in pair]
+    lines.append(f"| {n} | " + " | ".join(counts + exposure) + " |")
+lines += [
+    "",
+    f"**Occupancies one and two are servable under the alternative.** They produce {new_occ['1']['decoded']:,} and {new_occ['2']['decoded']:,} decoded attempts respectively. Across the complete variant census there are **zero uncapped NO_MODE attempts and zero uncapped demoted-rate misses**. Remaining NO_MODE attempts occur at the RF cap. Realised fading can still prevent decoding after a mode is selected. In the original, occupancy one has no decoded attempts; occupancy two has {old_occ['2']['decoded']:,}, confirming that its prohibition was almost universal on these anchors, rather than absolute.",
+    "",
+    f"The observed activation signature also disappears: an existing occupancy-one/two beam with no eligible mode becomes decoded after ORACLE_SET increases its occupancy on **{activation['original']['count']} original transitions versus {activation['margin-cleared']['count']} variant transitions**. The original transitions are W1/step2, occupancy 1→5, and W3/steps1 and2, occupancy 1→3. This narrowly defined count excludes newly populated beams and is not a decomposition of the EE gain. In the variant, ORACLE_SET still reduces the number of occupied beams on {activation['margin-cleared']['oracle_active_beam_count_decreases']} anchors, leaves it unchanged on {activation['margin-cleared']['oracle_active_beam_count_same']}, and increases it on {activation['margin-cleared']['oracle_active_beam_count_increases']}. Generic consolidation and set interactions therefore remain; the structural floor-activation explanation does not.",
+    "",
+    "The review's adjacent-step margin explanation is not correct. On an original uncapped link, nominal headroom above the transmitted mode is `threshold_target − threshold_tx`; demotion can skip several modes. Actual decoding margin is `10 log10(SINR_realised) − threshold_tx_dB`, which also includes realised desired-link and interference fading. The measured distributions are:",
+    "",
+    "| Formulation | Margin distribution (dB) | Minimum | P05 | Median | P95 | Maximum |",
+    "|---|---|---:|---:|---:|---:|---:|",
+]
+for key, label in (("original", "Original"), ("margin-cleared", "Margin provisioned")):
+    for name, title in (("nominal_tx_margin_db", "Nominal headroom above transmitted mode"), ("realised_tx_margin_db", "Realised margin, all selected modes"), ("realised_tx_margin_served_db", "Realised margin, decoded only")):
+        v = forms[key]["arms"]["ALL"]["distributions"][name]["duration_weighted"]
+        lines.append(f"| {label} | {title} | " + " | ".join(f"{v[k]:.3f}" for k in ("min", "P05", "P50", "P95", "max")) + " |")
+lines += [
+    "",
+    "These pool all three selectors. Percentiles are airtime-weighted, using 0.01 dB bins with at most 0.005 dB rounding; extrema retain full precision in the evidence. NO_MODE has no finite transmitted-mode margin and is counted separately. Negative realised margins are decode failures, so the decoded-only distribution is conditional on success.",
+    "",
+    "The margins actually applied span 1.107–4.830 dB. The model contains Rician fading, shadowing and scintillation, with no separate rain attenuation term. These results therefore cannot establish Ka-band rain availability. A rain margin depends on location-specific rainfall and the required exceedance probability, among other link parameters ([ITU-R P.618-14, §2.2.1.1](https://www.itu.int/dms_pubrec/itu-r/rec/p/R-REC-P.618-14-202308-I!!PDF-E.pdf)).",
+]
+text = text.replace("<!-- FULL_CENSUS_RESULTS -->", "\n".join(lines))
+old_count = original["arms"]["ALL"]["counts"]
+new_count = margin["arms"]["ALL"]["counts"]
+rates = (
+    f"The census confirms that all **{old_count['decoded']:,} original decoded attempts ({100*old_count['served_target_miss_share_of_decoded']:.0f}%)** use insufficient SE for `r*n/W`. "
+    "No original user-anchor endpoint attains the 50 Mbit/s average target. "
+    f"In the margin variant, {new_count['served_target_miss']:,} of {new_count['decoded']:,} decoded attempts ({100*new_count['served_target_miss_share_of_decoded']:.3f}%) miss that SE target, all at the cap. "
+    "Whole-endpoint rate attainment is reported separately in the first table."
+)
+max_bits = max(abs(v["bits_relative_difference"]) for v in census["parity"])
+max_joules = max(abs(v["joules_relative_difference"]) for v in census["parity"])
+verification = (
+    rates + "\n\n"
+    f"Verification: all 20 original anchors reproduce the archived committed assignments, bits, joules and served counts exactly; internal F/Psi reductions differ by at most 1.91e−5 bit under serial batching, without changing any selection. All 120 original/variant committed scalar replays match batch bits and joules to relative errors at most {max_bits:.2e} and {max_joules:.2e}, with identical served counts when using the preserved dense definition. The scalar adapter's stricter within-boundary AND service flag differs from the dense OR flag; neither implementation was amended, and the published dense definition is used consistently here. Seven focused fixtures independently verify uncapped target clearance, capped failures, scalar/batch agreement and unchanged uncoupled outputs.\n\n"
+    "All work stayed in this workspace. The sealed source tree remains `1728f6b0462f86d85618a4c73f4d1dd2d2c07376`; only diagnostic copies and outputs were added. Runs used the requested Python, `PYTHONPATH=src`, `nice -n 10`, one numerical thread per process and no more than three concurrent worker processes. No TEST split was opened.\n\n"
+    "Reproducible evidence:\n\n"
+    f"- [Original results]({HERE}/original-result.json), [strict margin results]({HERE}/margin-cleared-result.json), and [uncorrected numerical control]({HERE}/margin-result.json).\n"
+    f"- [Complete census and parity receipt]({HERE}/scalar-census-summary-cleared.json), [compact report data]({HERE}/report-data-cleared.json), and [activation transitions]({HERE}/activation-signatures-cleared.json).\n"
+    f"- [Copied batch formulation]({HERE}/cleared_margin_batch.py), [independent scalar formulation]({HERE}/scalar_diagnostics.py), and [selector runner]({HERE}/oracle_runner.py).\n"
+    f"- [Original reproduction audit]({HERE}/original-reproduction-audit.json), [clearance fixture audit]({HERE}/strict-variant-audit.json), and [numerical failure trace]({HERE}/uncapped-margin-failure-trace.json)."
+)
+text = text.replace("<!-- VERIFICATION_AND_ARTIFACTS -->", verification)
+text = text.replace("[architectures.py:727–742]", "[architectures.py:727]")
+text = text.replace("[lines 462–480]", "[line 462]")
+text = text.replace("[batch.py:301–314 and 395–417]", "[batch.py:301]")
+text = text.replace("[acm.py:93–98]", "[acm.py:93]")
+assert "<!--" not in text
+REPORT.write_text(text)
+print(REPORT)
