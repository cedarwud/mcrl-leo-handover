+)
+text = text.replace("<!-- VERIFICATION_AND_ARTIFACTS -->", verification)
+text = text.replace("[architectures.py:727–742]", "[architectures.py:727]")
+text = text.replace("[lines 462–480]", "[line 462]")
+text = text.replace("[batch.py:301–314 and 395–417]", "[batch.py:301]")
