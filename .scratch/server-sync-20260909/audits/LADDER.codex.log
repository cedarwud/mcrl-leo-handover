import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
REFERENCE = Path("/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/oracle-ceiling-result.json")
completed = HERE / "original-result.json"
current_path = completed if completed.exists() else HERE / "original-result.checkpoint.json"
reference = json.loads(REFERENCE.read_text())
current = json.loads(current_path.read_text())
reports = []
committed_mismatches = []
discrete_mismatches = []
max_internal_difference = 0.0
internal_float_keys = {
    "selected_Psi_A_bits", "selected_joint_F_gain_bits", "selected_singleton_sum_bits"
}
for old, new in zip(reference["anchors"], current["anchors"], strict=False):
    assert old["anchor_id"] == new["anchor_id"]
    differences = []
    for name in old["committed"]:
        for key, value in old["committed"][name].items():
            if value != new["committed"][name][key]:
                item = {"path": f"committed.{name}.{key}", "reference": value, "current": new["committed"][name][key]}
                differences.append(item)
                committed_mismatches.append({"anchor_id": old["anchor_id"], **item})
    for key, value in old["selection"].items():
        if value != new["selection"][key]:
            item = {"path": f"selection.{key}", "reference": value, "current": new["selection"][key]}
            differences.append(item)
            if key in internal_float_keys:
                max_internal_difference = max(max_internal_difference, abs(value - new["selection"][key]))
            elif key != "selected_Psi_A_exact":
                discrete_mismatches.append({"anchor_id": old["anchor_id"], **item})
    reports.append({"anchor_id": old["anchor_id"], "differences": differences})
result = {
    "status": "PASS" if all(not row["differences"] for row in reports) else "DIFFERENCES",
    "current_path": str(current_path),
    "reference_path": str(REFERENCE),
    "completed_anchors": len(reports),
    "committed_endpoints_and_configuration_ids_exact": not committed_mismatches,
    "discrete_search_path_counts_exact": not discrete_mismatches,
    "max_abs_internal_F_or_Psi_difference_bits": max_internal_difference,
    "committed_mismatches": committed_mismatches,
    "discrete_search_path_mismatches": discrete_mismatches,
    "anchors": reports,
}
(HERE / "original-reproduction-audit.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
print(json.dumps({key: value for key, value in result.items() if key != "anchors"}))
for row in reports:
    if row["differences"]:
