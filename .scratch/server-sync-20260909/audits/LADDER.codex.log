def _interference_contributors(
    *, tape, step_index: int, current, victim: int
) -> tuple[int, ...]:
    """Rank users by physical nominal interference, never by reward marginal."""

    mapping = current.mapping
    victim_beam = mapping[victim]
    if victim_beam is None:
        return ()
    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
    step = tape.steps[step_index]
    scores = []
    if step.arrays is not None:
        arrays = step.arrays
        victim_row = arrays._row_index().get((victim, victim_beam))
        aggressor_of = arrays._aggressor_index()
        if victim_row is None:
            return ()
        for user, beam in sorted(mapping.items()):
            if user == victim or beam is None or beam == victim_beam:
                continue
            aggressor_index = aggressor_of.get(beam)
            if aggressor_index is None:
                continue
            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
            score = gain / occupancy[beam]
            if score > 0.0:
                scores.append((score, user))
    else:
        boundary = step.boundary_at(0)
        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
        victim_row = by_key.get((victim, victim_beam))
        if victim_row is None:
            return ()
        cross = dict(victim_row.nominal_cross_gain_by_identity)
        for user, beam in sorted(mapping.items()):
            if user == victim or beam is None or beam == victim_beam:
                continue
            score = cross.get(beam, 0.0) / occupancy[beam]
            if score > 0.0:
                scores.append((score, user))
    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))


def build_joint_candidates(
    *, tape, step_index: int, base, unilateral, best_alternatives
) -> tuple[tuple[object, ...], Mapping[tuple, tuple[dict[str, object], ...]], dict[str, int]]:
    """Build a bounded catalogue from occupancy and interference mechanisms."""

    options, _ = probe._legal_options(tape, step_index)
    current_map = unilateral.mapping
    by_beam: dict[tuple[int, int], tuple[int, ...]] = {}
    for beam in sorted({row for row in current_map.values() if row is not None}):
        by_beam[beam] = tuple(
            user for user, identity in sorted(current_map.items()) if identity == beam
        )

    aliases: dict[tuple, list[dict[str, object]]] = {}
    configs: dict[tuple, object] = {}
    family_rows = Counter()

    def add(mapping, *, family: str, coalition: Sequence[int], detail: str) -> None:
        changed = tuple(
            user
            for user in sorted(current_map)
            if mapping[user] != current_map[user]
        )
        if len(changed) < 2:
            return
        assignments = tuple(sorted(mapping.items()))
        aliases.setdefault(assignments, []).append(
            {
                "family": family,
                "coalition_users": list(sorted(coalition)),
                "changed_users": list(changed),
                "detail": detail,
            }
        )
        if assignments not in configs:
            configs[assignments] = _configuration(base, mapping, family)
            family_rows[family] += 1

    occupant_rows = 0
    for beam, occupants in by_beam.items():
        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
            for coalition in itertools.combinations(occupants, size):
                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                    break
                if any(user not in best_alternatives for user in coalition):
                    continue
                mapping = dict(current_map)
                for user in coalition:
                    mapping[user] = best_alternatives[user]
                add(
                    mapping,
                    family="beam-occupant-subset",
                    coalition=coalition,
                    detail=f"origin={beam[0]}:{beam[1]};size={size}",
                )
                occupant_rows += 1
            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                break
        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
            break

    for victim in sorted(current_map):
        if victim not in best_alternatives:
            continue
        contributors = _interference_contributors(
            tape=tape, step_index=step_index, current=unilateral, victim=victim
        )
        for count in (2, 3):
            if len(contributors) < count:
                continue
            coalition = (victim, *contributors[:count])
            if any(user not in best_alternatives for user in coalition):
                continue
            mapping = dict(current_map)
            for user in coalition:
                mapping[user] = best_alternatives[user]
            add(
                mapping,
                family=f"victim-plus-top-{count}-contributors",
                coalition=coalition,
                detail=f"victim={victim};contributors={','.join(map(str, contributors[:count]))}",
            )

    for beam, occupants in by_beam.items():
        if len(occupants) < 2:
            continue
        common = set(options[occupants[0]])
        for user in occupants[1:]:
            common.intersection_update(options[user])
        common.discard(beam)
        for destination in sorted(common):
            mapping = dict(current_map)
            for user in occupants:
                mapping[user] = destination
            add(
                mapping,
                family="complete-beam-evacuation",
                coalition=occupants,
                detail=(
                    f"origin={beam[0]}:{beam[1]};"
                    f"destination={destination[0]}:{destination[1]}"
                ),
            )

    ordered = tuple(configs[key] for key in sorted(configs))
    if len(ordered) > JOINT_CANDIDATE_CAP:
        raise RuntimeError(
            f"mechanism catalogue exceeds fixed bound: {len(ordered)} > {JOINT_CANDIDATE_CAP}"
        )
    return (
        ordered,
        {key: tuple(value) for key, value in aliases.items()},
        dict(sorted(family_rows.items())),
    )


