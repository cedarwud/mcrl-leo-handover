new file mode 100644
index 0000000000000000000000000000000000000000..e772892ec3dbcc89a1e569ea25702d0600b833f3
--- /dev/null
+++ b/.scratch/ladder-floor-20260910/activation_signatures.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Count a narrowly defined observed occupancy-activation signature."""
+import argparse
+import json
+from pathlib import Path
+
+
+def summarize(census):
+    out = {}
+    for formulation in census["pooled"]:
+        rows = {
+            (row["anchor_id"], row["selector"]): {
+                tuple(beam["identity"]): beam for beam in row["boundary_zero_beams"]
+            }
+            for row in census["anchors"] if row["formulation"] == formulation
+        }
+        events = []
+        beam_count_changes = []
+        for (anchor, arm), unilateral in rows.items():
+            if arm != "UNILATERAL":
+                continue
+            oracle = rows[(anchor, "ORACLE_SET")]
+            beam_count_changes.append(len(oracle) - len(unilateral))
+            for identity, before in unilateral.items():
+                after = oracle.get(identity)
+                if (before["occupancy"] <= 2 and not before["has_mode_users"]
+                        and after and after["occupancy"] > before["occupancy"]
+                        and after["served_users"]):
+                    events.append({
+                        "anchor_id": anchor, "beam": list(identity),
+                        "before": before, "after": after,
+                    })
+        out[formulation] = {
+            "signature": "Existing occupancy-1/2 beam with no eligible mode in any boundary-zero slot becomes decoded after oracle increases its occupancy",
+            "scope": "Observed UNILATERAL-to-ORACLE transition; excludes newly activated beams and does not prove a unique causal contribution to gain",
+            "count": len(events), "events": events,
+            "oracle_active_beam_count_decreases": sum(x < 0 for x in beam_count_changes),
+            "oracle_active_beam_count_same": sum(x == 0 for x in beam_count_changes),
+            "oracle_active_beam_count_increases": sum(x > 0 for x in beam_count_changes),
+        }
+    return out
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("census", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    result = summarize(json.loads(args.census.read_text()))
+    args.output.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps(result, indent=2))
