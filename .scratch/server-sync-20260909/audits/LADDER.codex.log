def fading_quantile_elevation_bin(elevation_deg: float) -> float:
    """Return the sealed nearest 0.5-degree quantile-cache bin."""

    if not math.isfinite(elevation_deg) or not -90.0 <= elevation_deg <= 90.0:
        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
    # Avoid Python's ties-to-even rule so the binning convention is explicit.
    return math.floor(elevation_deg / FADING_QUANTILE_ELEVATION_BIN_DEG + 0.5) * FADING_QUANTILE_ELEVATION_BIN_DEG


def fading_quantile_derivation_seed(elevation_bin_deg: float, alpha: float) -> int:
    """Domain-separated seed for the sealed Monte-Carlo quantile procedure."""

    payload = (
        f"{FADING_QUANTILE_DERIVATION_DOMAIN}|"
        f"{elevation_bin_deg:.1f}|{alpha:.17g}"
    ).encode("ascii")
    return int.from_bytes(hashlib.sha256(payload).digest()[:8], "big")


@lru_cache(maxsize=None)
def _cached_fading_product_quantile(elevation_bin_deg: float, alpha: float) -> float:
    """200 000-draw quantile of Rician x shadow x scintillation fading."""

    if not math.isfinite(alpha) or not 0.0 < alpha < 1.0:
        raise MCRLContractError("fading quantile alpha must lie strictly in (0,1)")
    if fading_quantile_elevation_bin(elevation_bin_deg) != elevation_bin_deg:
        raise MCRLContractError("quantile cache key is not a sealed 0.5-degree bin")
    rng = np.random.default_rng(
        fading_quantile_derivation_seed(elevation_bin_deg, alpha)
    )
    shadow_db = float(shadow_sigma_db(elevation_bin_deg)) * rng.standard_normal(
        FADING_QUANTILE_DRAWS
    )
    rician = rician_power_gain(rng, (FADING_QUANTILE_DRAWS,))
    product = rician * 10.0 ** (
        -(
            shadow_db
            + float(scintillation_loss_db(elevation_bin_deg))
        )
        / 10.0
    )
    return float(np.quantile(product, alpha, method="linear"))


def fading_product_quantile(elevation_deg: float, alpha: float = 0.10) -> float:
    """Cached sealed complete-fading-product quantile at actual elevation."""

    elevation_bin = fading_quantile_elevation_bin(elevation_deg)
    return _cached_fading_product_quantile(elevation_bin, float(alpha))
