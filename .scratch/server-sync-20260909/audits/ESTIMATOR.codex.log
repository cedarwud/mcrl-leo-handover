def _fraction(pair: list[int]) -> Fraction:
    return Fraction(pair[0], pair[1])


def _calibration() -> pilot.PilotCalibration:
    payload = json.loads(CALIBRATION_PATH.read_text())
    return pilot.PilotCalibration(
        eta_ref=_fraction(payload["eta_ref"]),
        lambda_bits_per_j=_fraction(payload["lambda_bits_per_j"]),
        kappa_bits_per_user_step=_fraction(payload["kappa_bits_per_user_step"]),
        bits_ref=_fraction(payload["bits_ref"]),
        joules_ref=_fraction(payload["joules_ref"]),
        users=int(payload["users"]),
    )


@dataclass(frozen=True)
class ExactRow:
    anchor: int
    user_id: int
    action: tuple[int, int] | None
    q1: tuple[float, ...]
    q2: tuple[float, ...]
    c1_structure: tuple[float, ...]
    c2_structure: tuple[float, ...]
    c1_admissible: tuple[float, ...]
    c2_admissible: tuple[float, ...]
    c1_target: float
    c2_target: float
    c1_target_exact: str
    c2_target_exact: str


def _f(value: Fraction) -> float:
    return float(value)


def _relabel_anchor(tape, calibration, anchor_index: int) -> list[ExactRow]:
    step_index, carrier_index = divmod(anchor_index, len(REFERENCE_CARRIERS))
    carrier = REFERENCE_CARRIERS[carrier_index]
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    shard = read_source_shard(
        EXISTING_ROWS / f"PILOT_NOT_CLAIM-source-anchor-{anchor_index:03d}.jsonl"
    )
    base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    configs = {base.configuration_id: base}
    row_configs = []
    for row in shard.rows:
        mapping = base.mapping
        mapping[row.user_id] = pilot._identity(row.action)
        config = pilot.ENGINE._configuration(base, mapping, kind="sufficiency-replay")
        configs[config.configuration_id] = config
        row_configs.append((row, config))

    counter = pilot.ENGINE.EvaluationCounter()
    evaluator = pilot.ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    evaluator.evaluate_many(tuple(configs.values()))
    valid = tuple(
        config
        for config in configs.values()
        if config.configuration_id not in evaluator._invalid
    )
    forecasts, _ = pilot.ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_profile = evaluator.evaluate(base)
    rekeys = pilot.ENGINE._rekeyed_users(tape, step_index)
    base_outcome = base_profile.outcome(
        phi=pilot.ENGINE._phi_for(incumbent, base, cell_rekeyed_users=rekeys)
    )
    kappa = calibration.kappa_bits_per_user_step
    eta = calibration.eta_ref
    result = []
    for row, config in row_configs:
        if row.reference_action or config.configuration_id in evaluator._invalid:
            continue
        profile = evaluator.evaluate(config)
        outcome = profile.outcome(
            phi=pilot.ENGINE._phi_for(incumbent, config, cell_rekeyed_users=rekeys)
        )
        c1 = c1_difference_surplus(
            outcome,
            base_outcome,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=eta,
            kappa_bits_per_user_step=kappa,
        )
        candidate_forecasts = forecasts[config.configuration_id]
        c2 = c2_persistence_forecast(
            candidate_forecasts,
            forecasts[base.configuration_id],
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=eta,
            kappa_bits_per_user_step=kappa,
        )
        c1_structure = (
            _f(outcome.bits / kappa),
            _f(eta * outcome.joules / kappa),
            _f(outcome.phi),
            _f(base_outcome.bits / kappa),
            _f(eta * base_outcome.joules / kappa),
            _f(base_outcome.phi),
            float(profile.required_power_w_max / 1.65),
            float(profile.score.decoding_time_s.get(row.user_id, 0.0)),
        )
        c2_values: list[float] = []
        for candidate_projection, default_projection in zip(
            candidate_forecasts, forecasts[base.configuration_id], strict=True
        ):
            for projection in (candidate_projection, default_projection):
                c2_values.extend(
                    (
                        _f(projection.outcome.bits / kappa),
                        _f(eta * projection.outcome.joules / kappa),
                        _f(projection.outcome.decoding_availability),
                        _f(projection.outcome.useful_availability),
                        float(projection.valid),
                        float(projection.survives),
                        -1.0 if projection.required_power_w is None else projection.required_power_w / 1.65,
                    )
                )
        result.append(
            ExactRow(
                anchor_index,
                row.user_id,
                pilot._identity(row.action),
                row.q1_state,
                row.q2_state,
                c1_structure,
                tuple(c2_values),
                (float(base_profile.required_power_w_max / BEAM_RF_CAP_W),),
                (),
                float(c1.normalized_total),
                float(c2.normalized_total),
                str(c1.normalized_total),
                str(c2.normalized_total),
            )
        )
    return result


def _standardize(train: np.ndarray, other: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    mean = train.mean(axis=0)
    scale = train.std(axis=0)
    scale[scale < 1e-12] = 1.0
    return (train - mean) / scale, (other - mean) / scale


def _knn_predict(
    train_x: np.ndarray,
    train_y: np.ndarray,
    test_x: np.ndarray,
    *,
    neighbors: int,
    chunk_size: int = 128,
) -> np.ndarray:
    predictions = []
    k = min(neighbors, len(train_x))
    train_norm = np.einsum("ij,ij->i", train_x, train_x)
    for start in range(0, len(test_x), chunk_size):
        chunk = test_x[start : start + chunk_size]
        distances = (
            np.einsum("ij,ij->i", chunk, chunk)[:, None]
            + train_norm[None, :]
            - 2.0 * chunk @ train_x.T
        )
        indices = np.argpartition(distances, kth=k - 1, axis=1)[:, :k]
        selected_distances = np.take_along_axis(distances, indices, axis=1)
        weights = 1.0 / np.maximum(selected_distances, 1e-12)
        selected_y = train_y[indices]
        predictions.append((weights * selected_y).sum(axis=1) / weights.sum(axis=1))
    return np.concatenate(predictions)


def _explained_variance(actual: np.ndarray, predicted: np.ndarray) -> float:
    variance = float(np.var(actual))
    return float("nan") if variance == 0.0 else 1.0 - float(np.var(actual - predicted)) / variance


def _fit_route(
    rows: list[ExactRow],
    *,
    route: str,
    train_anchors: set[int],
    validation_anchors: set[int],
    test_anchors: set[int],
) -> dict[str, object]:
    q_name = {"C1": "q1", "C2": "q2"}[route]
    target_name = f"{route.lower()}_target"
    structure_name = f"{route.lower()}_structure"
    candidates = (1, 3, 7, 15, 31)

    def q_matrix(selected: list[ExactRow]) -> np.ndarray:
        return np.asarray([getattr(row, q_name) for row in selected], dtype=np.float64)

    def repaired_matrix(selected: list[ExactRow]) -> np.ndarray:
        feature_name = f"{route.lower()}_admissible"
        return np.asarray(
            [(*getattr(row, q_name), *getattr(row, feature_name)) for row in selected],
            dtype=np.float64,
        )

    def structure_matrix(selected: list[ExactRow]) -> np.ndarray:
        if route == "C1":
            # Exact C1 is linear in the six complete network terms.  Retain
            # the two extra evaluator diagnostics in the stored row, but do
            # not hand them to this sufficient comparator.
            return np.asarray(
                [getattr(row, structure_name)[:6] for row in selected],
                dtype=np.float64,
            )
        values = []
        for row in selected:
            raw = getattr(row, structure_name)
            alive = True
            live_cores = []
            lost = 0
            for offset in range(3):
                start = offset * 14
                candidate = raw[start : start + 7]
                default = raw[start + 7 : start + 14]
                core = candidate[0] - candidate[1] - default[0] + default[1]
                live_cores.append(core if alive else 0.0)
                if alive and not (bool(candidate[4]) and bool(candidate[5])):
                    alive = False
                    lost += 1
                elif not alive:
                    lost += 1
            values.append((*live_cores, float(lost)))
        return np.asarray(values, dtype=np.float64)

    def select(anchors: set[int]) -> list[ExactRow]:
        return [row for row in rows if row.anchor in anchors]

    fit_rows = select(train_anchors)
    validation_rows = select(validation_anchors)
    all_train_rows = select(train_anchors | validation_anchors)
    test_rows = select(test_anchors)
    fit_y = np.asarray([getattr(row, target_name) for row in fit_rows])
    validation_y = np.asarray([getattr(row, target_name) for row in validation_rows])
    all_train_y = np.asarray([getattr(row, target_name) for row in all_train_rows])
    test_y = np.asarray([getattr(row, target_name) for row in test_rows])

    def fit_knn(matrix, label: str) -> dict[str, object]:
        fit_x = matrix(fit_rows)
        validation_x = matrix(validation_rows)
        fit_x, validation_x = _standardize(fit_x, validation_x)
        scores = {}
        for neighbors in candidates:
            prediction = _knn_predict(fit_x, fit_y, validation_x, neighbors=neighbors)
            scores[neighbors] = _explained_variance(validation_y, prediction)
        selected_k = max(scores, key=lambda value: (scores[value], -value))
        train_x = matrix(all_train_rows)
        test_x = matrix(test_rows)
        train_x, test_x = _standardize(train_x, test_x)
        prediction = _knn_predict(train_x, all_train_y, test_x, neighbors=selected_k)
        residual = test_y - prediction
        return {
            "model": "standardized inverse-distance k-nearest-neighbor",
            "features": label,
            "selected_k": selected_k,
            "validation_explained_variance_by_k": {
                str(key): value for key, value in scores.items()
            },
            "held_out_explained_variance": _explained_variance(test_y, prediction),
            "held_out_rmse": float(np.sqrt(np.mean(residual * residual))),
            "held_out_mae": float(np.mean(np.abs(residual))),
        }

    results = {
        "q_only": fit_knn(q_matrix, f"{q_name} only"),
        "admissible_repair": fit_knn(
            repaired_matrix,
            (
                f"{q_name} + predecision_network_max_rf_over_cap"
                if route == "C1"
                else f"{q_name} only (no admissible C2 feature exists for the witness)"
            ),
        ),
    }

    # The comparator sees the complete outcome terms discarded by Q1/Q2.
    # Their production target definitions are linear once C2's absorbing
    # survival state is expanded, so ordinary least squares is sufficient and
    # avoids attributing k-NN's high-dimensional distance failure to physics.
    train_structure = structure_matrix(all_train_rows)
    test_structure = structure_matrix(test_rows)
    train_design = np.column_stack((np.ones(len(train_structure)), train_structure))
    test_design = np.column_stack((np.ones(len(test_structure)), test_structure))
    coefficients, *_ = np.linalg.lstsq(train_design, all_train_y, rcond=None)
    structure_prediction = test_design @ coefficients
    structure_residual = test_y - structure_prediction
    results["discarded_structure"] = {
        "model": "ordinary least squares on exact target-sufficient network terms",
        "held_out_explained_variance": _explained_variance(
            test_y, structure_prediction
        ),
        "held_out_rmse": float(
            np.sqrt(np.mean(structure_residual * structure_residual))
        ),
        "held_out_mae": float(np.mean(np.abs(structure_residual))),
        "held_out_max_abs_error": float(np.max(np.abs(structure_residual))),
        "coefficients": [float(value) for value in coefficients],
    }
    results["held_out_rows"] = len(test_rows)
    results["held_out_target_variance"] = float(np.var(test_y))
    results["explained_variance_gap"] = (
        results["discarded_structure"]["held_out_explained_variance"]
        - results["q_only"]["held_out_explained_variance"]
    )
    return results


def _survival_mismatch_summary(rows: list[ExactRow]) -> dict[str, object]:
    selected = [row for row in rows if row.anchor in {0, 1}]
    affected_rows = 0
    survival_offset_mismatches = 0
    validity_offset_mismatches = 0
    absorbing_mask_mismatches = 0
    for row in selected:
        stored_valid = tuple(bool(row.q2[10 + 4 * offset]) for offset in range(3))
        stored_survival = tuple(bool(row.q2[11 + 4 * offset]) for offset in range(3))
        exact_valid = tuple(
            bool(row.c2_structure[14 * offset + 4]) for offset in range(3)
        )
        exact_survival = tuple(
            bool(row.c2_structure[14 * offset + 5]) for offset in range(3)
        )
        row_mismatch = stored_valid != exact_valid or stored_survival != exact_survival
        affected_rows += int(row_mismatch)
        validity_offset_mismatches += sum(a != b for a, b in zip(stored_valid, exact_valid))
        survival_offset_mismatches += sum(
            a != b for a, b in zip(stored_survival, exact_survival)
        )
        alive = True
        exact_absorbing = []
        for valid, survives in zip(exact_valid, exact_survival, strict=True):
            exact_absorbing.append(alive and valid and survives)
            alive = alive and valid and survives
        absorbing_mask_mismatches += sum(
            a != b for a, b in zip(stored_survival, exact_absorbing)
        )
    return {
        "compared_rows": len(selected),
        "affected_rows": affected_rows,
        "validity_offset_mismatches": validity_offset_mismatches,
        "survival_offset_mismatches": survival_offset_mismatches,
        "stored_survival_vs_exact_absorbing_mask_offset_mismatches": absorbing_mask_mismatches,
    }


def explainability(anchor_count: int) -> dict[str, object]:
    if anchor_count < 12 or anchor_count > 90 or anchor_count % len(REFERENCE_CARRIERS):
        raise ValueError("anchor_count must be an even integer in [12, 90]")
    anchor_indices = tuple(range(anchor_count))
    max_step = max(index // len(REFERENCE_CARRIERS) for index in anchor_indices)
    tape = build_world_tape(
        domain=DEVELOPMENT_WORLD_DOMAINS[0],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=max_step + 4,
        start_time_s=0.0,
    )
    calibration = _calibration()
    rows = []
    for anchor_index in anchor_indices:
        rows.extend(_relabel_anchor(tape, calibration, anchor_index))
        print(
            json.dumps(
                {"phase": "exact-relabel", "anchor": anchor_index, "rows": len(rows)}
            ),
            file=sys.stderr,
            flush=True,
        )
    # Both carrier views of one physical step can have byte-identical Q rows.
    # Split by step, not by source shard, so those aliases cannot leak between
    # fitting, model-selection, and held-out sets.
    rng = np.random.default_rng(20260909)
    step_count = anchor_count // len(REFERENCE_CARRIERS)
    shuffled_steps = list(range(step_count))
    rng.shuffle(shuffled_steps)
    test_step_count = max(1, step_count // 4)
    validation_step_count = max(1, step_count // 6)
    test_steps = set(shuffled_steps[:test_step_count])
    validation_steps = set(
        shuffled_steps[test_step_count : test_step_count + validation_step_count]
    )
    train_steps = set(shuffled_steps[test_step_count + validation_step_count :])

    def anchors_for(steps: set[int]) -> set[int]:
        return {
            step * len(REFERENCE_CARRIERS) + carrier
            for step in steps
            for carrier in range(len(REFERENCE_CARRIERS))
        }

    train = anchors_for(train_steps)
    validation = anchors_for(validation_steps)
    test = anchors_for(test_steps)
    return {
        "source": str(EXISTING_ROWS.relative_to(ROOT)),
        "world": DEVELOPMENT_WORLD_DOMAINS[0],
        "anchor_indices": list(anchor_indices),
        "exact_relabelled_nonreference_valid_rows": len(rows),
        "split_unit": "whole physical step (both carrier views grouped)",
        "train_steps": sorted(train_steps),
        "validation_steps": sorted(validation_steps),
        "test_steps": sorted(test_steps),
        "train_anchors": sorted(train),
        "validation_anchors": sorted(validation),
        "test_anchors": sorted(test),
        "split_seed": 20260909,
        "two_anchor_survival_mismatch": _survival_mismatch_summary(rows),
        "c1": _fit_route(
            rows,
            route="C1",
            train_anchors=train,
            validation_anchors=validation,
            test_anchors=test,
        ),
        "c2": _fit_route(
            rows,
            route="C2",
            train_anchors=train,
            validation_anchors=validation,
            test_anchors=test,
        ),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--anchors", type=int, default=12)
    parser.add_argument("--collisions-only", action="store_true")
    args = parser.parse_args()
    payload = {"collisions": collision_witnesses()}
    if not args.collisions_only:
        payload["explainability"] = explainability(args.anchors)
    print(json.dumps(payload, sort_keys=True, indent=2))
    return 0


