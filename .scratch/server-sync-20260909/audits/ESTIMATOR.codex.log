def _network(bits: int, joules: int, *, phi: str = "0") -> NetworkOutcome:
    return NetworkOutcome.build(
        bits=bits,
        joules=joules,
        phi=phi,
        decoding_availability=1,
        useful_availability=1,
        per_user_bits={0: bits // 2, 1: bits - bits // 2},
    )


def _projection(
    index: int,
    outcome: NetworkOutcome,
    *,
    required_power_w: float,
) -> OffsetProjection:
    return OffsetProjection(
        offset_index=index,
        valid=True,
        survives=True,
        outcome=outcome,
        background_power_recomputed=True,
        required_power_w=required_power_w,
        power_cap_w=1.65,
        min_decoding_margin_db=4.0 - index,
        mean_acm_se_bit_s_hz=2.0,
    )


def _encoded_row(*, c1_bits: Fraction, c1_phi: Fraction, c2_bits: Fraction):
    forecasts = tuple(
        ForecastObservation(True, True, 4.0 - index, 2.0)
        for index in (1, 2, 3)
    )
    common = ActionEvaluation(
        action=PhysicalAction(1001, 7),
        nominal_sinr_margin_at_rate_target_db=4.0,
        nominal_required_power_over_cap=0.5,
        nominal_mode_spectral_efficiency=2.0,
        background_occupancy_excluding_focal=1,
        beam_active_before_focal=True,
        satellite_active_before_focal=True,
        off_axis_angle_rad=0.25,
        remaining_d2_time_s=60.0,
        remaining_visibility_time_s=90.0,
