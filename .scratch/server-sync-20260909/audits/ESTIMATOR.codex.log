+#!/usr/bin/env python3
+"""Audit estimators on the exact C1/C2 rows from the sufficiency diagnostic.
+
+DIAGNOSTIC_NOT_CLAIM.  This script performs no training or policy run.  It
+reuses the prior diagnostic's exact-row reconstruction, then fits only the
+predeclared estimator ladder.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import sys
+from typing import Callable, Iterable
+
+import numpy as np
+
+
+SEED = 20260909
+STEPS = tuple(range(10))
+TRAIN_STEPS = frozenset((1, 2, 4, 6, 7, 8, 9))
+VALIDATION_STEPS = frozenset((5,))
+TEST_STEPS = frozenset((0, 3))
+RIDGE_PENALTIES = (0.0, 1e-6, 1e-4, 1e-2, 1e-1, 1.0, 10.0, 100.0, 1e3, 1e4, 1e5, 1e6)
+KNN_NEIGHBORS = (1, 3, 7, 15, 31)
+GBT_MAX_TREES = 500
+GBT_DEPTH = 3
+GBT_LEARNING_RATE = 0.05
+GBT_PATIENCE = 30
+GBT_BINS = 64
+GBT_MIN_LEAF = 30
+
+PRIOR_SCRIPT = Path(
+    "/home/sat/mcrl-v025-c1c2suff-ws/scripts/diagnose_v025_c1c2_sufficiency.py"
+)
+
+
+def _load_prior_module():
+    spec = importlib.util.spec_from_file_location("prior_c1c2_diagnostic", PRIOR_SCRIPT)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PRIOR_SCRIPT}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _ev(actual: np.ndarray, predicted: np.ndarray) -> float:
+    variance = float(np.var(actual))
+    return float("nan") if variance == 0.0 else 1.0 - float(np.var(actual - predicted)) / variance
+
+
+def _metrics(actual: np.ndarray, predicted: np.ndarray) -> dict[str, float]:
+    residual = actual - predicted
+    return {
+        "explained_variance": _ev(actual, predicted),
+        "rmse": float(np.sqrt(np.mean(residual * residual))),
+    }
+
+
+def _standardization(x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    mean = x.mean(axis=0)
+    scale = x.std(axis=0)
+    scale[scale < 1e-12] = 1.0
+    return mean, scale
+
+
+def _linear_predict(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    predict_x: np.ndarray,
+    *,
+    penalty: float,
+) -> np.ndarray:
+    mean, scale = _standardization(fit_x)
+    x = (fit_x - mean) / scale
+    z = (predict_x - mean) / scale
+    y_mean = float(fit_y.mean())
+    centered_y = fit_y - y_mean
+    if penalty == 0.0:
+        coefficients, *_ = np.linalg.lstsq(x, centered_y, rcond=None)
+    else:
+        coefficients = np.linalg.solve(
+            x.T @ x + penalty * np.eye(x.shape[1]), x.T @ centered_y
+        )
+    return y_mean + z @ coefficients
+
+
+def _knn_predict(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    predict_x: np.ndarray,
+    *,
+    neighbors: int,
+    chunk_size: int = 128,
+) -> np.ndarray:
+    mean, scale = _standardization(fit_x)
+    train = (fit_x - mean) / scale
+    query = (predict_x - mean) / scale
+    k = min(neighbors, len(train))
+    train_norm = np.einsum("ij,ij->i", train, train)
+    predictions = []
+    for start in range(0, len(query), chunk_size):
+        chunk = query[start : start + chunk_size]
+        distances = (
+            np.einsum("ij,ij->i", chunk, chunk)[:, None]
+            + train_norm[None, :]
+            - 2.0 * chunk @ train.T
+        )
+        indices = np.argpartition(distances, kth=k - 1, axis=1)[:, :k]
+        selected_distances = np.take_along_axis(distances, indices, axis=1)
+        weights = 1.0 / np.maximum(selected_distances, 1e-12)
+        predictions.append(
+            (weights * fit_y[indices]).sum(axis=1) / weights.sum(axis=1)
+        )
+    return np.concatenate(predictions)
+
+
+@dataclass
+class TreeNode:
+    value: float
+    feature: int = -1
+    split_bin: int = -1
+    left: "TreeNode | None" = None
+    right: "TreeNode | None" = None
+
+
+@dataclass
+class BinnedTree:
+    edges: tuple[np.ndarray, ...]
+    root: TreeNode
+
+    def predict(self, x: np.ndarray) -> np.ndarray:
+        bins = _apply_bins(x, self.edges)
+        result = np.empty(len(x), dtype=np.float64)
+
+        def visit(node: TreeNode, indices: np.ndarray) -> None:
+            if node.feature < 0:
+                result[indices] = node.value
+                return
+            mask = bins[indices, node.feature] <= node.split_bin
+            assert node.left is not None and node.right is not None
+            visit(node.left, indices[mask])
+            visit(node.right, indices[~mask])
+
+        visit(self.root, np.arange(len(x), dtype=np.int64))
+        return result
+
+
+def _bin_edges(x: np.ndarray, max_bins: int) -> tuple[np.ndarray, ...]:
+    quantiles = np.linspace(0.0, 1.0, max_bins + 1)[1:-1]
+    edges = []
+    for feature in range(x.shape[1]):
+        candidate = np.unique(np.quantile(x[:, feature], quantiles))
+        candidate = candidate[
+            (candidate > np.min(x[:, feature])) & (candidate < np.max(x[:, feature]))
+        ]
+        edges.append(candidate)
+    return tuple(edges)
+
+
+def _apply_bins(x: np.ndarray, edges: tuple[np.ndarray, ...]) -> np.ndarray:
+    result = np.empty(x.shape, dtype=np.uint8)
+    for feature, feature_edges in enumerate(edges):
+        result[:, feature] = np.searchsorted(feature_edges, x[:, feature], side="right")
+    return result
+
+
+def _fit_binned_tree(
+    bins: np.ndarray,
+    residual: np.ndarray,
+    edges: tuple[np.ndarray, ...],
+    *,
+    max_depth: int,
+    min_leaf: int,
+) -> BinnedTree:
+    def build(indices: np.ndarray, depth: int) -> TreeNode:
+        values = residual[indices]
+        node = TreeNode(value=float(values.mean()))
+        if depth >= max_depth or len(indices) < 2 * min_leaf:
+            return node
+        total_sum = float(values.sum())
+        total_count = len(indices)
+        baseline = total_sum * total_sum / total_count
+        best_gain = 0.0
+        best_feature = -1
+        best_split = -1
+        for feature, feature_edges in enumerate(edges):
+            if len(feature_edges) == 0:
+                continue
+            feature_bins = bins[indices, feature]
+            bin_count = len(feature_edges) + 1
+            counts = np.bincount(feature_bins, minlength=bin_count).astype(np.int64)
+            sums = np.bincount(feature_bins, weights=values, minlength=bin_count)
+            left_count = np.cumsum(counts)[:-1]
+            left_sum = np.cumsum(sums)[:-1]
+            right_count = total_count - left_count
+            right_sum = total_sum - left_sum
+            valid = (left_count >= min_leaf) & (right_count >= min_leaf)
+            gains = np.full(len(left_count), -np.inf)
+            gains[valid] = (
+                left_sum[valid] ** 2 / left_count[valid]
+                + right_sum[valid] ** 2 / right_count[valid]
+                - baseline
+            )
+            split = int(np.argmax(gains))
+            gain = float(gains[split])
+            if gain > best_gain:
+                best_gain = gain
+                best_feature = feature
+                best_split = split
+        if best_feature < 0:
+            return node
+        left_mask = bins[indices, best_feature] <= best_split
+        node.feature = best_feature
+        node.split_bin = best_split
+        node.left = build(indices[left_mask], depth + 1)
+        node.right = build(indices[~left_mask], depth + 1)
+        return node
+
+    root = build(np.arange(len(bins), dtype=np.int64), 0)
+    return BinnedTree(edges=edges, root=root)
+
+
+@dataclass
+class GBTModel:
+    initial: float
+    trees: list[BinnedTree]
+    learning_rate: float
+
+    def predict(self, x: np.ndarray) -> np.ndarray:
+        result = np.full(len(x), self.initial, dtype=np.float64)
+        for tree in self.trees:
+            result += self.learning_rate * tree.predict(x)
+        return result
+
+
+def _fit_gbt(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    *,
+    tree_count: int,
+    validation: tuple[np.ndarray, np.ndarray] | None,
+) -> tuple[GBTModel, dict[str, object]]:
+    edges = _bin_edges(fit_x, GBT_BINS)
+    bins = _apply_bins(fit_x, edges)
+    initial = float(fit_y.mean())
+    fit_prediction = np.full(len(fit_y), initial, dtype=np.float64)
+    trees: list[BinnedTree] = []
+    best_count = 0
+    best_rmse = float("inf")
+    stale = 0
+    if validation is not None:
+        validation_x, validation_y = validation
+        validation_prediction = np.full(len(validation_y), initial, dtype=np.float64)
+    for iteration in range(1, tree_count + 1):
+        tree = _fit_binned_tree(
+            bins,
+            fit_y - fit_prediction,
+            edges,
+            max_depth=GBT_DEPTH,
+            min_leaf=GBT_MIN_LEAF,
+        )
+        trees.append(tree)
+        fit_prediction += GBT_LEARNING_RATE * tree.predict(fit_x)
+        if validation is None:
+            continue
+        validation_prediction += GBT_LEARNING_RATE * tree.predict(validation_x)
+        rmse = float(np.sqrt(np.mean((validation_y - validation_prediction) ** 2)))
+        if rmse < best_rmse - 1e-12:
+            best_rmse = rmse
+            best_count = iteration
+            stale = 0
+        else:
+            stale += 1
+        if stale >= GBT_PATIENCE:
+            break
+    if validation is None:
+        best_count = len(trees)
+    model = GBTModel(initial, trees[:best_count], GBT_LEARNING_RATE)
+    return model, {
+        "selected_trees": best_count,
+        "trees_fitted_before_stop": len(trees),
+        "best_validation_rmse": None if validation is None else best_rmse,
+    }
+
+
+def _feature_key(values: Iterable[float]) -> bytes:
+    numbers = tuple(values)
+    return struct.pack(f">{len(numbers)}d", *numbers)
+
+
+def _collision_floor(rows, *, route: str) -> dict[str, object]:
+    q_name = {"C1": "q1", "C2": "q2"}[route]
+    exact_name = f"{route.lower()}_target_exact"
+    float_name = f"{route.lower()}_target"
+    groups: dict[bytes, list[tuple[Fraction, float]]] = {}
+    for row in rows:
+        groups.setdefault(_feature_key(getattr(row, q_name)), []).append(
+            (Fraction(getattr(row, exact_name)), getattr(row, float_name))
+        )
+    collision_groups = [
+        values for values in groups.values() if len({value[0] for value in values}) > 1
+    ]
+    y = np.asarray([getattr(row, float_name) for row in rows], dtype=np.float64)
+    sse = 0.0
+    for values in collision_groups:
+        targets = np.asarray([value[1] for value in values], dtype=np.float64)
+        sse += float(np.sum((targets - targets.mean()) ** 2))
+    floor_variance = sse / len(rows)
+    total_variance = float(np.var(y))
+    return {
+        "unique_feature_vectors": len(groups),
+        "duplicate_groups_all": sum(len(values) > 1 for values in groups.values()),
+        "collision_groups_differing_exact_target": len(collision_groups),
+        "rows_in_collision_groups": sum(len(values) for values in collision_groups),
+        "irreducible_variance_floor": floor_variance,
+        "total_target_variance": total_variance,
+        "fraction_of_total_target_variance": floor_variance / total_variance,
+    }
+
+
+def _route_arrays(rows, route: str):
+    q_name = {"C1": "q1", "C2": "q2"}[route]
+    y_name = f"{route.lower()}_target"
+    x = np.asarray([getattr(row, q_name) for row in rows], dtype=np.float64)
+    y = np.asarray([getattr(row, y_name) for row in rows], dtype=np.float64)
+    steps = np.asarray([row.anchor // 3 for row in rows], dtype=np.int64)
+    return x, y, steps
+
+
+def _mask(steps: np.ndarray, selected: Iterable[int]) -> np.ndarray:
+    return np.isin(steps, tuple(selected))
+
+
+def _audit_route(rows, route: str) -> dict[str, object]:
+    x, y, steps = _route_arrays(rows, route)
+    train = _mask(steps, TRAIN_STEPS)
+    validation = _mask(steps, VALIDATION_STEPS)
+    test = _mask(steps, TEST_STEPS)
+    development = train | validation
+
+    constant_prediction = np.full(test.sum(), float(y[train].mean()))
+    ols_prediction = _linear_predict(x[development], y[development], x[test], penalty=0.0)
+
+    ridge_validation = {}
+    for penalty in RIDGE_PENALTIES:
+        prediction = _linear_predict(x[train], y[train], x[validation], penalty=penalty)
+        ridge_validation[str(penalty)] = _metrics(y[validation], prediction)
+    selected_penalty = max(
+        RIDGE_PENALTIES,
+        key=lambda penalty: (
+            ridge_validation[str(penalty)]["explained_variance"], -penalty
+        ),
+    )
+    ridge_prediction = _linear_predict(
+        x[development], y[development], x[test], penalty=selected_penalty
+    )
+
+    gbt, gbt_selection = _fit_gbt(
+        x[train],
+        y[train],
+        tree_count=GBT_MAX_TREES,
+        validation=(x[validation], y[validation]),
+    )
+    gbt_prediction = gbt.predict(x[test])
+
+    knn_validation = {}
+    for neighbors in KNN_NEIGHBORS:
+        prediction = _knn_predict(
+            x[train], y[train], x[validation], neighbors=neighbors
+        )
+        knn_validation[str(neighbors)] = _metrics(y[validation], prediction)
+    selected_k = max(
+        KNN_NEIGHBORS,
+        key=lambda neighbors: (
+            knn_validation[str(neighbors)]["explained_variance"], -neighbors
+        ),
+    )
+    knn_prediction = _knn_predict(
+        x[development], y[development], x[test], neighbors=selected_k
+    )
+
+    predictions = {
+        "constant": constant_prediction,
+        "ols": ols_prediction,
+        "ridge": ridge_prediction,
+        "gradient_boosted_trees": gbt_prediction,
+        "knn": knn_prediction,
+    }
+    ladder = {name: _metrics(y[test], prediction) for name, prediction in predictions.items()}
+    ladder["ridge"]["selected_penalty"] = selected_penalty
+    ladder["ridge"]["validation_by_penalty"] = ridge_validation
+    ladder["gradient_boosted_trees"].update(gbt_selection)
+    ladder["knn"]["selected_k"] = selected_k
+    ladder["knn"]["validation_by_k"] = knn_validation
+
+    best_name = max(ladder, key=lambda name: ladder[name]["explained_variance"])
+    best_prediction = predictions[best_name]
+    separate_test_steps = {}
+    test_step_values = steps[test]
+    for step in sorted(TEST_STEPS):
+        selected = test_step_values == step
+        separate_test_steps[str(step)] = _metrics(y[test][selected], best_prediction[selected])
+
+    def fit_selected(fit: np.ndarray, held_out: np.ndarray) -> np.ndarray:
+        if best_name == "constant":
+            return np.full(held_out.sum(), float(y[fit].mean()))
+        if best_name == "ols":
+            return _linear_predict(x[fit], y[fit], x[held_out], penalty=0.0)
+        if best_name == "ridge":
+            return _linear_predict(
+                x[fit], y[fit], x[held_out], penalty=selected_penalty
+            )
+        if best_name == "gradient_boosted_trees":
+            rotation_gbt, _ = _fit_gbt(
+                x[fit],
+                y[fit],
+                tree_count=int(gbt_selection["selected_trees"]),
+                validation=None,
+            )
+            return rotation_gbt.predict(x[held_out])
+        if best_name == "knn":
+            return _knn_predict(x[fit], y[fit], x[held_out], neighbors=selected_k)
+        raise AssertionError(best_name)
+
+    rotation = {}
+    for step in STEPS:
+        held_out = steps == step
+        fit = ~held_out
+        prediction = fit_selected(fit, held_out)
+        rotation[str(step)] = _metrics(y[held_out], prediction)
+    rotation_evs = np.asarray(
+        [rotation[str(step)]["explained_variance"] for step in STEPS]
+    )
+
+    return {
+        "rows": len(rows),
+        "feature_dimension": x.shape[1],
+        "split_row_counts": {
+            "train": int(train.sum()),
+            "validation": int(validation.sum()),
+            "test": int(test.sum()),
+        },
+        "ladder": ladder,
+        "best_estimator": best_name,
+        "best_estimator_test_step_metrics": separate_test_steps,
+        "leave_one_step_out": rotation,
+        "leave_one_step_out_ev_spread": {
+            "minimum": float(rotation_evs.min()),
+            "maximum": float(rotation_evs.max()),
+            "range": float(np.ptp(rotation_evs)),
+            "mean": float(rotation_evs.mean()),
+            "standard_deviation": float(rotation_evs.std()),
+            "negative_step_count": int(np.sum(rotation_evs < 0.0)),
+            "positive_step_count": int(np.sum(rotation_evs > 0.0)),
+        },
+        "collision_floor": _collision_floor(rows, route=route),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=Path("artifacts/c1c2-estimator-audit-20260910.json"),
+    )
+    args = parser.parse_args()
+    prior = _load_prior_module()
+    tape = prior.build_world_tape(
+        domain=prior.DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=prior.LegacyWorldProvider(role="pilot-source"),
+        steps=13,
+        start_time_s=0.0,
+    )
+    calibration = prior._calibration()
+    rows = []
+    for anchor in range(30):
+        rows.extend(prior._relabel_anchor(tape, calibration, anchor))
+        print(
+            json.dumps({"phase": "exact-relabel", "anchor": anchor, "rows": len(rows)}),
+            file=sys.stderr,
+            flush=True,
+        )
+    if len(rows) != 26345:
+        raise AssertionError(f"expected 26345 rows, got {len(rows)}")
+    result = {
+        "label": "DIAGNOSTIC_NOT_CLAIM",
+        "seed": SEED,
+        "steps": list(STEPS),
+        "split": {
+            "train_steps": sorted(TRAIN_STEPS),
+            "validation_steps": sorted(VALIDATION_STEPS),
+            "test_steps": sorted(TEST_STEPS),
+        },
+        "model_declaration": [
+            "constant predictor (strict training-split mean)",
+            "ordinary least squares on encoded features",
+            "ridge; penalty selected by validation explained variance only",
+            (
+                "deterministic squared-error histogram gradient-boosted trees; "
+                f"depth={GBT_DEPTH}, learning_rate={GBT_LEARNING_RATE}, "
+                f"max_trees={GBT_MAX_TREES}, patience={GBT_PATIENCE}, "
+                f"bins={GBT_BINS}, min_leaf={GBT_MIN_LEAF}; early stopping by "
+                "validation RMSE only"
+            ),
+            "original standardized inverse-distance k-nearest-neighbor",
+        ],
+        "c1": _audit_route(rows, "C1"),
+        "c2": _audit_route(rows, "C2"),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"output": str(args.output), "rows": len(rows)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/scripts/audit_v025_c1c2_estimators.py b/scripts/audit_v025_c1c2_estimators.py
new file mode 100644
index 0000000000000000000000000000000000000000..de9e5116c224837d150f8164514d50599f264ed8
--- /dev/null
+++ b/scripts/audit_v025_c1c2_estimators.py
@@ -0,0 +1,525 @@
+#!/usr/bin/env python3
+"""Audit estimators on the exact C1/C2 rows from the sufficiency diagnostic.
+
+DIAGNOSTIC_NOT_CLAIM.  This script performs no training or policy run.  It
+reuses the prior diagnostic's exact-row reconstruction, then fits only the
+predeclared estimator ladder.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import sys
+from typing import Callable, Iterable
+
+import numpy as np
+
+
+SEED = 20260909
+STEPS = tuple(range(10))
+TRAIN_STEPS = frozenset((1, 2, 4, 6, 7, 8, 9))
+VALIDATION_STEPS = frozenset((5,))
+TEST_STEPS = frozenset((0, 3))
+RIDGE_PENALTIES = (0.0, 1e-6, 1e-4, 1e-2, 1e-1, 1.0, 10.0, 100.0, 1e3, 1e4, 1e5, 1e6)
+KNN_NEIGHBORS = (1, 3, 7, 15, 31)
+GBT_MAX_TREES = 500
+GBT_DEPTH = 3
+GBT_LEARNING_RATE = 0.05
+GBT_PATIENCE = 30
+GBT_BINS = 64
+GBT_MIN_LEAF = 30
+
+PRIOR_SCRIPT = Path(
+    "/home/sat/mcrl-v025-c1c2suff-ws/scripts/diagnose_v025_c1c2_sufficiency.py"
+)
+
+
+def _load_prior_module():
+    spec = importlib.util.spec_from_file_location("prior_c1c2_diagnostic", PRIOR_SCRIPT)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PRIOR_SCRIPT}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _ev(actual: np.ndarray, predicted: np.ndarray) -> float:
+    variance = float(np.var(actual))
+    return float("nan") if variance == 0.0 else 1.0 - float(np.var(actual - predicted)) / variance
+
+
+def _metrics(actual: np.ndarray, predicted: np.ndarray) -> dict[str, float]:
+    residual = actual - predicted
+    return {
+        "explained_variance": _ev(actual, predicted),
+        "rmse": float(np.sqrt(np.mean(residual * residual))),
+    }
+
+
+def _standardization(x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    mean = x.mean(axis=0)
+    scale = x.std(axis=0)
+    scale[scale < 1e-12] = 1.0
+    return mean, scale
+
+
+def _linear_predict(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    predict_x: np.ndarray,
+    *,
+    penalty: float,
+) -> np.ndarray:
+    mean, scale = _standardization(fit_x)
+    x = (fit_x - mean) / scale
+    z = (predict_x - mean) / scale
+    y_mean = float(fit_y.mean())
+    centered_y = fit_y - y_mean
+    if penalty == 0.0:
+        coefficients, *_ = np.linalg.lstsq(x, centered_y, rcond=None)
+    else:
+        coefficients = np.linalg.solve(
+            x.T @ x + penalty * np.eye(x.shape[1]), x.T @ centered_y
+        )
+    return y_mean + z @ coefficients
+
+
+def _knn_predict(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    predict_x: np.ndarray,
+    *,
+    neighbors: int,
+    chunk_size: int = 128,
+) -> np.ndarray:
+    mean, scale = _standardization(fit_x)
+    train = (fit_x - mean) / scale
+    query = (predict_x - mean) / scale
+    k = min(neighbors, len(train))
+    train_norm = np.einsum("ij,ij->i", train, train)
+    predictions = []
+    for start in range(0, len(query), chunk_size):
+        chunk = query[start : start + chunk_size]
+        distances = (
+            np.einsum("ij,ij->i", chunk, chunk)[:, None]
+            + train_norm[None, :]
+            - 2.0 * chunk @ train.T
+        )
+        indices = np.argpartition(distances, kth=k - 1, axis=1)[:, :k]
+        selected_distances = np.take_along_axis(distances, indices, axis=1)
+        weights = 1.0 / np.maximum(selected_distances, 1e-12)
+        predictions.append(
+            (weights * fit_y[indices]).sum(axis=1) / weights.sum(axis=1)
+        )
+    return np.concatenate(predictions)
+
+
+@dataclass
+class TreeNode:
+    value: float
+    feature: int = -1
+    split_bin: int = -1
+    left: "TreeNode | None" = None
+    right: "TreeNode | None" = None
+
+
+@dataclass
+class BinnedTree:
+    edges: tuple[np.ndarray, ...]
+    root: TreeNode
+
+    def predict(self, x: np.ndarray) -> np.ndarray:
+        bins = _apply_bins(x, self.edges)
+        result = np.empty(len(x), dtype=np.float64)
+
+        def visit(node: TreeNode, indices: np.ndarray) -> None:
+            if node.feature < 0:
+                result[indices] = node.value
+                return
+            mask = bins[indices, node.feature] <= node.split_bin
+            assert node.left is not None and node.right is not None
+            visit(node.left, indices[mask])
+            visit(node.right, indices[~mask])
+
+        visit(self.root, np.arange(len(x), dtype=np.int64))
+        return result
+
+
+def _bin_edges(x: np.ndarray, max_bins: int) -> tuple[np.ndarray, ...]:
+    quantiles = np.linspace(0.0, 1.0, max_bins + 1)[1:-1]
+    edges = []
+    for feature in range(x.shape[1]):
+        candidate = np.unique(np.quantile(x[:, feature], quantiles))
+        candidate = candidate[
+            (candidate > np.min(x[:, feature])) & (candidate < np.max(x[:, feature]))
+        ]
+        edges.append(candidate)
+    return tuple(edges)
+
+
+def _apply_bins(x: np.ndarray, edges: tuple[np.ndarray, ...]) -> np.ndarray:
+    result = np.empty(x.shape, dtype=np.uint8)
+    for feature, feature_edges in enumerate(edges):
+        result[:, feature] = np.searchsorted(feature_edges, x[:, feature], side="right")
+    return result
+
+
+def _fit_binned_tree(
+    bins: np.ndarray,
+    residual: np.ndarray,
+    edges: tuple[np.ndarray, ...],
+    *,
+    max_depth: int,
+    min_leaf: int,
+) -> BinnedTree:
+    def build(indices: np.ndarray, depth: int) -> TreeNode:
+        values = residual[indices]
+        node = TreeNode(value=float(values.mean()))
+        if depth >= max_depth or len(indices) < 2 * min_leaf:
+            return node
+        total_sum = float(values.sum())
+        total_count = len(indices)
+        baseline = total_sum * total_sum / total_count
+        best_gain = 0.0
+        best_feature = -1
+        best_split = -1
+        for feature, feature_edges in enumerate(edges):
+            if len(feature_edges) == 0:
+                continue
+            feature_bins = bins[indices, feature]
+            bin_count = len(feature_edges) + 1
+            counts = np.bincount(feature_bins, minlength=bin_count).astype(np.int64)
+            sums = np.bincount(feature_bins, weights=values, minlength=bin_count)
+            left_count = np.cumsum(counts)[:-1]
+            left_sum = np.cumsum(sums)[:-1]
+            right_count = total_count - left_count
+            right_sum = total_sum - left_sum
+            valid = (left_count >= min_leaf) & (right_count >= min_leaf)
+            gains = np.full(len(left_count), -np.inf)
+            gains[valid] = (
+                left_sum[valid] ** 2 / left_count[valid]
+                + right_sum[valid] ** 2 / right_count[valid]
+                - baseline
+            )
+            split = int(np.argmax(gains))
+            gain = float(gains[split])
+            if gain > best_gain:
+                best_gain = gain
+                best_feature = feature
+                best_split = split
+        if best_feature < 0:
+            return node
+        left_mask = bins[indices, best_feature] <= best_split
+        node.feature = best_feature
+        node.split_bin = best_split
+        node.left = build(indices[left_mask], depth + 1)
+        node.right = build(indices[~left_mask], depth + 1)
+        return node
+
+    root = build(np.arange(len(bins), dtype=np.int64), 0)
+    return BinnedTree(edges=edges, root=root)
+
+
+@dataclass
+class GBTModel:
+    initial: float
+    trees: list[BinnedTree]
+    learning_rate: float
+
+    def predict(self, x: np.ndarray) -> np.ndarray:
+        result = np.full(len(x), self.initial, dtype=np.float64)
+        for tree in self.trees:
+            result += self.learning_rate * tree.predict(x)
+        return result
+
+
+def _fit_gbt(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    *,
+    tree_count: int,
+    validation: tuple[np.ndarray, np.ndarray] | None,
+) -> tuple[GBTModel, dict[str, object]]:
+    edges = _bin_edges(fit_x, GBT_BINS)
+    bins = _apply_bins(fit_x, edges)
+    initial = float(fit_y.mean())
+    fit_prediction = np.full(len(fit_y), initial, dtype=np.float64)
+    trees: list[BinnedTree] = []
+    best_count = 0
+    best_rmse = float("inf")
+    stale = 0
+    if validation is not None:
+        validation_x, validation_y = validation
+        validation_prediction = np.full(len(validation_y), initial, dtype=np.float64)
+    for iteration in range(1, tree_count + 1):
+        tree = _fit_binned_tree(
+            bins,
+            fit_y - fit_prediction,
+            edges,
+            max_depth=GBT_DEPTH,
+            min_leaf=GBT_MIN_LEAF,
+        )
+        trees.append(tree)
+        fit_prediction += GBT_LEARNING_RATE * tree.predict(fit_x)
+        if validation is None:
+            continue
+        validation_prediction += GBT_LEARNING_RATE * tree.predict(validation_x)
+        rmse = float(np.sqrt(np.mean((validation_y - validation_prediction) ** 2)))
+        if rmse < best_rmse - 1e-12:
+            best_rmse = rmse
+            best_count = iteration
+            stale = 0
+        else:
+            stale += 1
+        if stale >= GBT_PATIENCE:
+            break
+    if validation is None:
+        best_count = len(trees)
+    model = GBTModel(initial, trees[:best_count], GBT_LEARNING_RATE)
+    return model, {
+        "selected_trees": best_count,
+        "trees_fitted_before_stop": len(trees),
+        "best_validation_rmse": None if validation is None else best_rmse,
+    }
+
+
+def _feature_key(values: Iterable[float]) -> bytes:
+    numbers = tuple(values)
+    return struct.pack(f">{len(numbers)}d", *numbers)
+
+
+def _collision_floor(rows, *, route: str) -> dict[str, object]:
+    q_name = {"C1": "q1", "C2": "q2"}[route]
+    exact_name = f"{route.lower()}_target_exact"
+    float_name = f"{route.lower()}_target"
+    groups: dict[bytes, list[tuple[Fraction, float]]] = {}
+    for row in rows:
+        groups.setdefault(_feature_key(getattr(row, q_name)), []).append(
+            (Fraction(getattr(row, exact_name)), getattr(row, float_name))
+        )
+    collision_groups = [
+        values for values in groups.values() if len({value[0] for value in values}) > 1
+    ]
+    y = np.asarray([getattr(row, float_name) for row in rows], dtype=np.float64)
+    sse = 0.0
+    for values in collision_groups:
+        targets = np.asarray([value[1] for value in values], dtype=np.float64)
+        sse += float(np.sum((targets - targets.mean()) ** 2))
+    floor_variance = sse / len(rows)
+    total_variance = float(np.var(y))
+    return {
+        "unique_feature_vectors": len(groups),
+        "duplicate_groups_all": sum(len(values) > 1 for values in groups.values()),
+        "collision_groups_differing_exact_target": len(collision_groups),
+        "rows_in_collision_groups": sum(len(values) for values in collision_groups),
+        "irreducible_variance_floor": floor_variance,
+        "total_target_variance": total_variance,
+        "fraction_of_total_target_variance": floor_variance / total_variance,
+    }
+
+
+def _route_arrays(rows, route: str):
+    q_name = {"C1": "q1", "C2": "q2"}[route]
+    y_name = f"{route.lower()}_target"
+    x = np.asarray([getattr(row, q_name) for row in rows], dtype=np.float64)
+    y = np.asarray([getattr(row, y_name) for row in rows], dtype=np.float64)
+    steps = np.asarray([row.anchor // 3 for row in rows], dtype=np.int64)
+    return x, y, steps
+
+
+def _mask(steps: np.ndarray, selected: Iterable[int]) -> np.ndarray:
+    return np.isin(steps, tuple(selected))
+
+
+def _audit_route(rows, route: str) -> dict[str, object]:
+    x, y, steps = _route_arrays(rows, route)
+    train = _mask(steps, TRAIN_STEPS)
+    validation = _mask(steps, VALIDATION_STEPS)
+    test = _mask(steps, TEST_STEPS)
+    development = train | validation
+
+    constant_prediction = np.full(test.sum(), float(y[train].mean()))
+    ols_prediction = _linear_predict(x[development], y[development], x[test], penalty=0.0)
+
+    ridge_validation = {}
+    for penalty in RIDGE_PENALTIES:
+        prediction = _linear_predict(x[train], y[train], x[validation], penalty=penalty)
+        ridge_validation[str(penalty)] = _metrics(y[validation], prediction)
+    selected_penalty = max(
+        RIDGE_PENALTIES,
+        key=lambda penalty: (
+            ridge_validation[str(penalty)]["explained_variance"], -penalty
+        ),
+    )
+    ridge_prediction = _linear_predict(
+        x[development], y[development], x[test], penalty=selected_penalty
+    )
+
+    gbt, gbt_selection = _fit_gbt(
+        x[train],
+        y[train],
+        tree_count=GBT_MAX_TREES,
+        validation=(x[validation], y[validation]),
+    )
+    gbt_prediction = gbt.predict(x[test])
+
+    knn_validation = {}
+    for neighbors in KNN_NEIGHBORS:
+        prediction = _knn_predict(
+            x[train], y[train], x[validation], neighbors=neighbors
+        )
+        knn_validation[str(neighbors)] = _metrics(y[validation], prediction)
+    selected_k = max(
+        KNN_NEIGHBORS,
+        key=lambda neighbors: (
+            knn_validation[str(neighbors)]["explained_variance"], -neighbors
+        ),
+    )
+    knn_prediction = _knn_predict(
+        x[development], y[development], x[test], neighbors=selected_k
+    )
+
+    predictions = {
+        "constant": constant_prediction,
+        "ols": ols_prediction,
+        "ridge": ridge_prediction,
+        "gradient_boosted_trees": gbt_prediction,
+        "knn": knn_prediction,
+    }
+    ladder = {name: _metrics(y[test], prediction) for name, prediction in predictions.items()}
+    ladder["ridge"]["selected_penalty"] = selected_penalty
+    ladder["ridge"]["validation_by_penalty"] = ridge_validation
+    ladder["gradient_boosted_trees"].update(gbt_selection)
+    ladder["knn"]["selected_k"] = selected_k
+    ladder["knn"]["validation_by_k"] = knn_validation
+
+    best_name = max(ladder, key=lambda name: ladder[name]["explained_variance"])
+    best_prediction = predictions[best_name]
+    separate_test_steps = {}
+    test_step_values = steps[test]
+    for step in sorted(TEST_STEPS):
+        selected = test_step_values == step
+        separate_test_steps[str(step)] = _metrics(y[test][selected], best_prediction[selected])
+
+    def fit_selected(fit: np.ndarray, held_out: np.ndarray) -> np.ndarray:
+        if best_name == "constant":
+            return np.full(held_out.sum(), float(y[fit].mean()))
+        if best_name == "ols":
+            return _linear_predict(x[fit], y[fit], x[held_out], penalty=0.0)
+        if best_name == "ridge":
+            return _linear_predict(
+                x[fit], y[fit], x[held_out], penalty=selected_penalty
+            )
+        if best_name == "gradient_boosted_trees":
+            rotation_gbt, _ = _fit_gbt(
+                x[fit],
+                y[fit],
+                tree_count=int(gbt_selection["selected_trees"]),
+                validation=None,
+            )
+            return rotation_gbt.predict(x[held_out])
+        if best_name == "knn":
+            return _knn_predict(x[fit], y[fit], x[held_out], neighbors=selected_k)
+        raise AssertionError(best_name)
+
+    rotation = {}
+    for step in STEPS:
+        held_out = steps == step
+        fit = ~held_out
+        prediction = fit_selected(fit, held_out)
+        rotation[str(step)] = _metrics(y[held_out], prediction)
+    rotation_evs = np.asarray(
+        [rotation[str(step)]["explained_variance"] for step in STEPS]
+    )
+
+    return {
+        "rows": len(rows),
+        "feature_dimension": x.shape[1],
+        "split_row_counts": {
+            "train": int(train.sum()),
+            "validation": int(validation.sum()),
+            "test": int(test.sum()),
+        },
+        "ladder": ladder,
+        "best_estimator": best_name,
+        "best_estimator_test_step_metrics": separate_test_steps,
+        "leave_one_step_out": rotation,
+        "leave_one_step_out_ev_spread": {
+            "minimum": float(rotation_evs.min()),
+            "maximum": float(rotation_evs.max()),
+            "range": float(np.ptp(rotation_evs)),
+            "mean": float(rotation_evs.mean()),
+            "standard_deviation": float(rotation_evs.std()),
+            "negative_step_count": int(np.sum(rotation_evs < 0.0)),
+            "positive_step_count": int(np.sum(rotation_evs > 0.0)),
+        },
+        "collision_floor": _collision_floor(rows, route=route),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=Path("artifacts/c1c2-estimator-audit-20260910.json"),
+    )
+    args = parser.parse_args()
+    prior = _load_prior_module()
+    tape = prior.build_world_tape(
+        domain=prior.DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=prior.LegacyWorldProvider(role="pilot-source"),
+        steps=13,
+        start_time_s=0.0,
+    )
+    calibration = prior._calibration()
+    rows = []
+    for anchor in range(30):
+        rows.extend(prior._relabel_anchor(tape, calibration, anchor))
+        print(
+            json.dumps({"phase": "exact-relabel", "anchor": anchor, "rows": len(rows)}),
+            file=sys.stderr,
+            flush=True,
+        )
+    if len(rows) != 26345:
+        raise AssertionError(f"expected 26345 rows, got {len(rows)}")
+    result = {
+        "label": "DIAGNOSTIC_NOT_CLAIM",
+        "seed": SEED,
+        "steps": list(STEPS),
+        "split": {
+            "train_steps": sorted(TRAIN_STEPS),
+            "validation_steps": sorted(VALIDATION_STEPS),
+            "test_steps": sorted(TEST_STEPS),
+        },
+        "model_declaration": [
+            "constant predictor (strict training-split mean)",
+            "ordinary least squares on encoded features",
+            "ridge; penalty selected by validation explained variance only",
+            (
+                "deterministic squared-error histogram gradient-boosted trees; "
+                f"depth={GBT_DEPTH}, learning_rate={GBT_LEARNING_RATE}, "
+                f"max_trees={GBT_MAX_TREES}, patience={GBT_PATIENCE}, "
+                f"bins={GBT_BINS}, min_leaf={GBT_MIN_LEAF}; early stopping by "
+                "validation RMSE only"
+            ),
+            "original standardized inverse-distance k-nearest-neighbor",
+        ],
+        "c1": _audit_route(rows, "C1"),
+        "c2": _audit_route(rows, "C2"),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"output": str(args.output), "rows": len(rows)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/scripts/audit_v025_c1c2_estimators.py b/scripts/audit_v025_c1c2_estimators.py
new file mode 100644
index 0000000000000000000000000000000000000000..de9e5116c224837d150f8164514d50599f264ed8
--- /dev/null
+++ b/scripts/audit_v025_c1c2_estimators.py
@@ -0,0 +1,525 @@
+#!/usr/bin/env python3
+"""Audit estimators on the exact C1/C2 rows from the sufficiency diagnostic.
+
+DIAGNOSTIC_NOT_CLAIM.  This script performs no training or policy run.  It
+reuses the prior diagnostic's exact-row reconstruction, then fits only the
+predeclared estimator ladder.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import sys
+from typing import Callable, Iterable
+
+import numpy as np
+
+
+SEED = 20260909
+STEPS = tuple(range(10))
+TRAIN_STEPS = frozenset((1, 2, 4, 6, 7, 8, 9))
+VALIDATION_STEPS = frozenset((5,))
+TEST_STEPS = frozenset((0, 3))
+RIDGE_PENALTIES = (0.0, 1e-6, 1e-4, 1e-2, 1e-1, 1.0, 10.0, 100.0, 1e3, 1e4, 1e5, 1e6)
+KNN_NEIGHBORS = (1, 3, 7, 15, 31)
+GBT_MAX_TREES = 500
+GBT_DEPTH = 3
+GBT_LEARNING_RATE = 0.05
+GBT_PATIENCE = 30
+GBT_BINS = 64
+GBT_MIN_LEAF = 30
+
+PRIOR_SCRIPT = Path(
+    "/home/sat/mcrl-v025-c1c2suff-ws/scripts/diagnose_v025_c1c2_sufficiency.py"
+)
+
+
+def _load_prior_module():
+    spec = importlib.util.spec_from_file_location("prior_c1c2_diagnostic", PRIOR_SCRIPT)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PRIOR_SCRIPT}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _ev(actual: np.ndarray, predicted: np.ndarray) -> float:
+    variance = float(np.var(actual))
+    return float("nan") if variance == 0.0 else 1.0 - float(np.var(actual - predicted)) / variance
+
+
+def _metrics(actual: np.ndarray, predicted: np.ndarray) -> dict[str, float]:
+    residual = actual - predicted
+    return {
+        "explained_variance": _ev(actual, predicted),
+        "rmse": float(np.sqrt(np.mean(residual * residual))),
+    }
+
+
+def _standardization(x: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    mean = x.mean(axis=0)
+    scale = x.std(axis=0)
+    scale[scale < 1e-12] = 1.0
+    return mean, scale
+
+
+def _linear_predict(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    predict_x: np.ndarray,
+    *,
+    penalty: float,
+) -> np.ndarray:
+    mean, scale = _standardization(fit_x)
+    x = (fit_x - mean) / scale
+    z = (predict_x - mean) / scale
+    y_mean = float(fit_y.mean())
+    centered_y = fit_y - y_mean
+    if penalty == 0.0:
+        coefficients, *_ = np.linalg.lstsq(x, centered_y, rcond=None)
+    else:
+        coefficients = np.linalg.solve(
+            x.T @ x + penalty * np.eye(x.shape[1]), x.T @ centered_y
+        )
+    return y_mean + z @ coefficients
+
+
+def _knn_predict(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    predict_x: np.ndarray,
+    *,
+    neighbors: int,
+    chunk_size: int = 128,
+) -> np.ndarray:
+    mean, scale = _standardization(fit_x)
+    train = (fit_x - mean) / scale
+    query = (predict_x - mean) / scale
+    k = min(neighbors, len(train))
+    train_norm = np.einsum("ij,ij->i", train, train)
+    predictions = []
+    for start in range(0, len(query), chunk_size):
+        chunk = query[start : start + chunk_size]
+        distances = (
+            np.einsum("ij,ij->i", chunk, chunk)[:, None]
+            + train_norm[None, :]
+            - 2.0 * chunk @ train.T
+        )
+        indices = np.argpartition(distances, kth=k - 1, axis=1)[:, :k]
+        selected_distances = np.take_along_axis(distances, indices, axis=1)
+        weights = 1.0 / np.maximum(selected_distances, 1e-12)
+        predictions.append(
+            (weights * fit_y[indices]).sum(axis=1) / weights.sum(axis=1)
+        )
+    return np.concatenate(predictions)
+
+
+@dataclass
+class TreeNode:
+    value: float
+    feature: int = -1
+    split_bin: int = -1
+    left: "TreeNode | None" = None
+    right: "TreeNode | None" = None
+
+
+@dataclass
+class BinnedTree:
+    edges: tuple[np.ndarray, ...]
+    root: TreeNode
+
+    def predict(self, x: np.ndarray) -> np.ndarray:
+        bins = _apply_bins(x, self.edges)
+        result = np.empty(len(x), dtype=np.float64)
+
+        def visit(node: TreeNode, indices: np.ndarray) -> None:
+            if node.feature < 0:
+                result[indices] = node.value
+                return
+            mask = bins[indices, node.feature] <= node.split_bin
+            assert node.left is not None and node.right is not None
+            visit(node.left, indices[mask])
+            visit(node.right, indices[~mask])
+
+        visit(self.root, np.arange(len(x), dtype=np.int64))
+        return result
+
+
+def _bin_edges(x: np.ndarray, max_bins: int) -> tuple[np.ndarray, ...]:
+    quantiles = np.linspace(0.0, 1.0, max_bins + 1)[1:-1]
+    edges = []
+    for feature in range(x.shape[1]):
+        candidate = np.unique(np.quantile(x[:, feature], quantiles))
+        candidate = candidate[
+            (candidate > np.min(x[:, feature])) & (candidate < np.max(x[:, feature]))
+        ]
+        edges.append(candidate)
+    return tuple(edges)
+
+
+def _apply_bins(x: np.ndarray, edges: tuple[np.ndarray, ...]) -> np.ndarray:
+    result = np.empty(x.shape, dtype=np.uint8)
+    for feature, feature_edges in enumerate(edges):
+        result[:, feature] = np.searchsorted(feature_edges, x[:, feature], side="right")
+    return result
+
+
+def _fit_binned_tree(
+    bins: np.ndarray,
+    residual: np.ndarray,
+    edges: tuple[np.ndarray, ...],
+    *,
+    max_depth: int,
+    min_leaf: int,
+) -> BinnedTree:
+    def build(indices: np.ndarray, depth: int) -> TreeNode:
+        values = residual[indices]
+        node = TreeNode(value=float(values.mean()))
+        if depth >= max_depth or len(indices) < 2 * min_leaf:
+            return node
+        total_sum = float(values.sum())
+        total_count = len(indices)
+        baseline = total_sum * total_sum / total_count
+        best_gain = 0.0
+        best_feature = -1
+        best_split = -1
+        for feature, feature_edges in enumerate(edges):
+            if len(feature_edges) == 0:
+                continue
+            feature_bins = bins[indices, feature]
+            bin_count = len(feature_edges) + 1
+            counts = np.bincount(feature_bins, minlength=bin_count).astype(np.int64)
+            sums = np.bincount(feature_bins, weights=values, minlength=bin_count)
+            left_count = np.cumsum(counts)[:-1]
+            left_sum = np.cumsum(sums)[:-1]
+            right_count = total_count - left_count
+            right_sum = total_sum - left_sum
+            valid = (left_count >= min_leaf) & (right_count >= min_leaf)
+            gains = np.full(len(left_count), -np.inf)
+            gains[valid] = (
+                left_sum[valid] ** 2 / left_count[valid]
+                + right_sum[valid] ** 2 / right_count[valid]
+                - baseline
+            )
+            split = int(np.argmax(gains))
+            gain = float(gains[split])
+            if gain > best_gain:
+                best_gain = gain
+                best_feature = feature
+                best_split = split
+        if best_feature < 0:
+            return node
+        left_mask = bins[indices, best_feature] <= best_split
+        node.feature = best_feature
+        node.split_bin = best_split
+        node.left = build(indices[left_mask], depth + 1)
+        node.right = build(indices[~left_mask], depth + 1)
+        return node
+
+    root = build(np.arange(len(bins), dtype=np.int64), 0)
+    return BinnedTree(edges=edges, root=root)
+
+
+@dataclass
+class GBTModel:
+    initial: float
+    trees: list[BinnedTree]
+    learning_rate: float
+
+    def predict(self, x: np.ndarray) -> np.ndarray:
+        result = np.full(len(x), self.initial, dtype=np.float64)
+        for tree in self.trees:
+            result += self.learning_rate * tree.predict(x)
+        return result
+
+
+def _fit_gbt(
+    fit_x: np.ndarray,
+    fit_y: np.ndarray,
+    *,
+    tree_count: int,
+    validation: tuple[np.ndarray, np.ndarray] | None,
+) -> tuple[GBTModel, dict[str, object]]:
+    edges = _bin_edges(fit_x, GBT_BINS)
+    bins = _apply_bins(fit_x, edges)
+    initial = float(fit_y.mean())
+    fit_prediction = np.full(len(fit_y), initial, dtype=np.float64)
+    trees: list[BinnedTree] = []
+    best_count = 0
+    best_rmse = float("inf")
+    stale = 0
+    if validation is not None:
+        validation_x, validation_y = validation
+        validation_prediction = np.full(len(validation_y), initial, dtype=np.float64)
+    for iteration in range(1, tree_count + 1):
+        tree = _fit_binned_tree(
+            bins,
+            fit_y - fit_prediction,
+            edges,
+            max_depth=GBT_DEPTH,
+            min_leaf=GBT_MIN_LEAF,
+        )
+        trees.append(tree)
+        fit_prediction += GBT_LEARNING_RATE * tree.predict(fit_x)
+        if validation is None:
+            continue
+        validation_prediction += GBT_LEARNING_RATE * tree.predict(validation_x)
+        rmse = float(np.sqrt(np.mean((validation_y - validation_prediction) ** 2)))
+        if rmse < best_rmse - 1e-12:
+            best_rmse = rmse
+            best_count = iteration
+            stale = 0
+        else:
+            stale += 1
+        if stale >= GBT_PATIENCE:
+            break
+    if validation is None:
+        best_count = len(trees)
+    model = GBTModel(initial, trees[:best_count], GBT_LEARNING_RATE)
+    return model, {
+        "selected_trees": best_count,
+        "trees_fitted_before_stop": len(trees),
+        "best_validation_rmse": None if validation is None else best_rmse,
+    }
+
+
+def _feature_key(values: Iterable[float]) -> bytes:
+    numbers = tuple(values)
+    return struct.pack(f">{len(numbers)}d", *numbers)
+
+
+def _collision_floor(rows, *, route: str) -> dict[str, object]:
+    q_name = {"C1": "q1", "C2": "q2"}[route]
+    exact_name = f"{route.lower()}_target_exact"
+    float_name = f"{route.lower()}_target"
+    groups: dict[bytes, list[tuple[Fraction, float]]] = {}
+    for row in rows:
+        groups.setdefault(_feature_key(getattr(row, q_name)), []).append(
+            (Fraction(getattr(row, exact_name)), getattr(row, float_name))
+        )
+    collision_groups = [
+        values for values in groups.values() if len({value[0] for value in values}) > 1
+    ]
+    y = np.asarray([getattr(row, float_name) for row in rows], dtype=np.float64)
+    sse = 0.0
+    for values in collision_groups:
+        targets = np.asarray([value[1] for value in values], dtype=np.float64)
+        sse += float(np.sum((targets - targets.mean()) ** 2))
+    floor_variance = sse / len(rows)
+    total_variance = float(np.var(y))
+    return {
+        "unique_feature_vectors": len(groups),
+        "duplicate_groups_all": sum(len(values) > 1 for values in groups.values()),
+        "collision_groups_differing_exact_target": len(collision_groups),
+        "rows_in_collision_groups": sum(len(values) for values in collision_groups),
+        "irreducible_variance_floor": floor_variance,
+        "total_target_variance": total_variance,
+        "fraction_of_total_target_variance": floor_variance / total_variance,
+    }
+
+
+def _route_arrays(rows, route: str):
+    q_name = {"C1": "q1", "C2": "q2"}[route]
+    y_name = f"{route.lower()}_target"
+    x = np.asarray([getattr(row, q_name) for row in rows], dtype=np.float64)
+    y = np.asarray([getattr(row, y_name) for row in rows], dtype=np.float64)
+    steps = np.asarray([row.anchor // 3 for row in rows], dtype=np.int64)
+    return x, y, steps
+
+
+def _mask(steps: np.ndarray, selected: Iterable[int]) -> np.ndarray:
+    return np.isin(steps, tuple(selected))
+
+
+def _audit_route(rows, route: str) -> dict[str, object]:
+    x, y, steps = _route_arrays(rows, route)
+    train = _mask(steps, TRAIN_STEPS)
+    validation = _mask(steps, VALIDATION_STEPS)
+    test = _mask(steps, TEST_STEPS)
+    development = train | validation
+
+    constant_prediction = np.full(test.sum(), float(y[train].mean()))
+    ols_prediction = _linear_predict(x[development], y[development], x[test], penalty=0.0)
+
+    ridge_validation = {}
+    for penalty in RIDGE_PENALTIES:
+        prediction = _linear_predict(x[train], y[train], x[validation], penalty=penalty)
+        ridge_validation[str(penalty)] = _metrics(y[validation], prediction)
+    selected_penalty = max(
+        RIDGE_PENALTIES,
+        key=lambda penalty: (
+            ridge_validation[str(penalty)]["explained_variance"], -penalty
+        ),
+    )
+    ridge_prediction = _linear_predict(
+        x[development], y[development], x[test], penalty=selected_penalty
+    )
+
+    gbt, gbt_selection = _fit_gbt(
+        x[train],
+        y[train],
+        tree_count=GBT_MAX_TREES,
+        validation=(x[validation], y[validation]),
+    )
+    gbt_prediction = gbt.predict(x[test])
+
+    knn_validation = {}
+    for neighbors in KNN_NEIGHBORS:
+        prediction = _knn_predict(
+            x[train], y[train], x[validation], neighbors=neighbors
+        )
+        knn_validation[str(neighbors)] = _metrics(y[validation], prediction)
+    selected_k = max(
+        KNN_NEIGHBORS,
+        key=lambda neighbors: (
+            knn_validation[str(neighbors)]["explained_variance"], -neighbors
+        ),
+    )
+    knn_prediction = _knn_predict(
+        x[development], y[development], x[test], neighbors=selected_k
+    )
+
+    predictions = {
+        "constant": constant_prediction,
+        "ols": ols_prediction,
+        "ridge": ridge_prediction,
+        "gradient_boosted_trees": gbt_prediction,
+        "knn": knn_prediction,
+    }
+    ladder = {name: _metrics(y[test], prediction) for name, prediction in predictions.items()}
+    ladder["ridge"]["selected_penalty"] = selected_penalty
+    ladder["ridge"]["validation_by_penalty"] = ridge_validation
+    ladder["gradient_boosted_trees"].update(gbt_selection)
+    ladder["knn"]["selected_k"] = selected_k
+    ladder["knn"]["validation_by_k"] = knn_validation
+
+    best_name = max(ladder, key=lambda name: ladder[name]["explained_variance"])
+    best_prediction = predictions[best_name]
+    separate_test_steps = {}
+    test_step_values = steps[test]
+    for step in sorted(TEST_STEPS):
+        selected = test_step_values == step
+        separate_test_steps[str(step)] = _metrics(y[test][selected], best_prediction[selected])
+
+    def fit_selected(fit: np.ndarray, held_out: np.ndarray) -> np.ndarray:
+        if best_name == "constant":
+            return np.full(held_out.sum(), float(y[fit].mean()))
+        if best_name == "ols":
+            return _linear_predict(x[fit], y[fit], x[held_out], penalty=0.0)
+        if best_name == "ridge":
+            return _linear_predict(
+                x[fit], y[fit], x[held_out], penalty=selected_penalty
+            )
+        if best_name == "gradient_boosted_trees":
+            rotation_gbt, _ = _fit_gbt(
+                x[fit],
+                y[fit],
+                tree_count=int(gbt_selection["selected_trees"]),
+                validation=None,
+            )
+            return rotation_gbt.predict(x[held_out])
+        if best_name == "knn":
+            return _knn_predict(x[fit], y[fit], x[held_out], neighbors=selected_k)
+        raise AssertionError(best_name)
+
+    rotation = {}
+    for step in STEPS:
+        held_out = steps == step
+        fit = ~held_out
+        prediction = fit_selected(fit, held_out)
+        rotation[str(step)] = _metrics(y[held_out], prediction)
+    rotation_evs = np.asarray(
+        [rotation[str(step)]["explained_variance"] for step in STEPS]
+    )
+
+    return {
+        "rows": len(rows),
+        "feature_dimension": x.shape[1],
+        "split_row_counts": {
+            "train": int(train.sum()),
+            "validation": int(validation.sum()),
+            "test": int(test.sum()),
+        },
+        "ladder": ladder,
+        "best_estimator": best_name,
+        "best_estimator_test_step_metrics": separate_test_steps,
+        "leave_one_step_out": rotation,
+        "leave_one_step_out_ev_spread": {
+            "minimum": float(rotation_evs.min()),
+            "maximum": float(rotation_evs.max()),
+            "range": float(np.ptp(rotation_evs)),
+            "mean": float(rotation_evs.mean()),
+            "standard_deviation": float(rotation_evs.std()),
+            "negative_step_count": int(np.sum(rotation_evs < 0.0)),
+            "positive_step_count": int(np.sum(rotation_evs > 0.0)),
+        },
+        "collision_floor": _collision_floor(rows, route=route),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=Path("artifacts/c1c2-estimator-audit-20260910.json"),
+    )
+    args = parser.parse_args()
+    prior = _load_prior_module()
+    tape = prior.build_world_tape(
+        domain=prior.DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=prior.LegacyWorldProvider(role="pilot-source"),
+        steps=13,
+        start_time_s=0.0,
+    )
+    calibration = prior._calibration()
+    rows = []
+    for anchor in range(30):
+        rows.extend(prior._relabel_anchor(tape, calibration, anchor))
+        print(
+            json.dumps({"phase": "exact-relabel", "anchor": anchor, "rows": len(rows)}),
+            file=sys.stderr,
+            flush=True,
+        )
+    if len(rows) != 26345:
+        raise AssertionError(f"expected 26345 rows, got {len(rows)}")
+    result = {
+        "label": "DIAGNOSTIC_NOT_CLAIM",
+        "seed": SEED,
+        "steps": list(STEPS),
+        "split": {
+            "train_steps": sorted(TRAIN_STEPS),
+            "validation_steps": sorted(VALIDATION_STEPS),
+            "test_steps": sorted(TEST_STEPS),
+        },
+        "model_declaration": [
+            "constant predictor (strict training-split mean)",
+            "ordinary least squares on encoded features",
+            "ridge; penalty selected by validation explained variance only",
+            (
+                "deterministic squared-error histogram gradient-boosted trees; "
+                f"depth={GBT_DEPTH}, learning_rate={GBT_LEARNING_RATE}, "
+                f"max_trees={GBT_MAX_TREES}, patience={GBT_PATIENCE}, "
+                f"bins={GBT_BINS}, min_leaf={GBT_MIN_LEAF}; early stopping by "
+                "validation RMSE only"
+            ),
+            "original standardized inverse-distance k-nearest-neighbor",
+        ],
+        "c1": _audit_route(rows, "C1"),
+        "c2": _audit_route(rows, "C2"),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"output": str(args.output), "rows": len(rows)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

