def _standardize(train: np.ndarray, other: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    mean = train.mean(axis=0)
    scale = train.std(axis=0)
    scale[scale < 1e-12] = 1.0
    return (train - mean) / scale, (other - mean) / scale


def _knn_predict(
    train_x: np.ndarray,
    train_y: np.ndarray,
    test_x: np.ndarray,
    *,
    neighbors: int,
    chunk_size: int = 128,
) -> np.ndarray:
    predictions = []
    k = min(neighbors, len(train_x))
    train_norm = np.einsum("ij,ij->i", train_x, train_x)
    for start in range(0, len(test_x), chunk_size):
        chunk = test_x[start : start + chunk_size]
        distances = (
            np.einsum("ij,ij->i", chunk, chunk)[:, None]
            + train_norm[None, :]
            - 2.0 * chunk @ train_x.T
        )
        indices = np.argpartition(distances, kth=k - 1, axis=1)[:, :k]
        selected_distances = np.take_along_axis(distances, indices, axis=1)
        weights = 1.0 / np.maximum(selected_distances, 1e-12)
        selected_y = train_y[indices]
        predictions.append((weights * selected_y).sum(axis=1) / weights.sum(axis=1))
    return np.concatenate(predictions)


def _explained_variance(actual: np.ndarray, predicted: np.ndarray) -> float:
    variance = float(np.var(actual))
    return float("nan") if variance == 0.0 else 1.0 - float(np.var(actual - predicted)) / variance


def _fit_route(
    rows: list[ExactRow],
    *,
    route: str,
    train_anchors: set[int],
    validation_anchors: set[int],
    test_anchors: set[int],
) -> dict[str, object]:
    q_name = {"C1": "q1", "C2": "q2"}[route]
    target_name = f"{route.lower()}_target"
    structure_name = f"{route.lower()}_structure"
    candidates = (1, 3, 7, 15, 31)

    def q_matrix(selected: list[ExactRow]) -> np.ndarray:
        return np.asarray([getattr(row, q_name) for row in selected], dtype=np.float64)

    def repaired_matrix(selected: list[ExactRow]) -> np.ndarray:
        feature_name = f"{route.lower()}_admissible"
        return np.asarray(
            [(*getattr(row, q_name), *getattr(row, feature_name)) for row in selected],
            dtype=np.float64,
        )

    def structure_matrix(selected: list[ExactRow]) -> np.ndarray:
        if route == "C1":
            # Exact C1 is linear in the six complete network terms.  Retain
            # the two extra evaluator diagnostics in the stored row, but do
            # not hand them to this sufficient comparator.
            return np.asarray(
                [getattr(row, structure_name)[:6] for row in selected],
                dtype=np.float64,
            )
        values = []
        for row in selected:
            raw = getattr(row, structure_name)
            alive = True
            live_cores = []
            lost = 0
            for offset in range(3):
                start = offset * 14
                candidate = raw[start : start + 7]
                default = raw[start + 7 : start + 14]
                core = candidate[0] - candidate[1] - default[0] + default[1]
                live_cores.append(core if alive else 0.0)
                if alive and not (bool(candidate[4]) and bool(candidate[5])):
                    alive = False
                    lost += 1
                elif not alive:
                    lost += 1
            values.append((*live_cores, float(lost)))
        return np.asarray(values, dtype=np.float64)

    def select(anchors: set[int]) -> list[ExactRow]:
        return [row for row in rows if row.anchor in anchors]

    fit_rows = select(train_anchors)
    validation_rows = select(validation_anchors)
    all_train_rows = select(train_anchors | validation_anchors)
    test_rows = select(test_anchors)
    fit_y = np.asarray([getattr(row, target_name) for row in fit_rows])
    validation_y = np.asarray([getattr(row, target_name) for row in validation_rows])
    all_train_y = np.asarray([getattr(row, target_name) for row in all_train_rows])
    test_y = np.asarray([getattr(row, target_name) for row in test_rows])

    def fit_knn(matrix, label: str) -> dict[str, object]:
        fit_x = matrix(fit_rows)
        validation_x = matrix(validation_rows)
        fit_x, validation_x = _standardize(fit_x, validation_x)
        scores = {}
        for neighbors in candidates:
            prediction = _knn_predict(fit_x, fit_y, validation_x, neighbors=neighbors)
            scores[neighbors] = _explained_variance(validation_y, prediction)
        selected_k = max(scores, key=lambda value: (scores[value], -value))
        train_x = matrix(all_train_rows)
        test_x = matrix(test_rows)
        train_x, test_x = _standardize(train_x, test_x)
        prediction = _knn_predict(train_x, all_train_y, test_x, neighbors=selected_k)
        residual = test_y - prediction
        return {
            "model": "standardized inverse-distance k-nearest-neighbor",
            "features": label,
            "selected_k": selected_k,
            "validation_explained_variance_by_k": {
                str(key): value for key, value in scores.items()
            },
            "held_out_explained_variance": _explained_variance(test_y, prediction),
            "held_out_rmse": float(np.sqrt(np.mean(residual * residual))),
            "held_out_mae": float(np.mean(np.abs(residual))),
        }

    results = {
        "q_only": fit_knn(q_matrix, f"{q_name} only"),
        "admissible_repair": fit_knn(
            repaired_matrix,
            (
                f"{q_name} + predecision_network_max_rf_over_cap"
                if route == "C1"
                else f"{q_name} only (no admissible C2 feature exists for the witness)"
            ),
        ),
    }

    # The comparator sees the complete outcome terms discarded by Q1/Q2.
    # Their production target definitions are linear once C2's absorbing
    # survival state is expanded, so ordinary least squares is sufficient and
    # avoids attributing k-NN's high-dimensional distance failure to physics.
    train_structure = structure_matrix(all_train_rows)
    test_structure = structure_matrix(test_rows)
    train_design = np.column_stack((np.ones(len(train_structure)), train_structure))
    test_design = np.column_stack((np.ones(len(test_structure)), test_structure))
    coefficients, *_ = np.linalg.lstsq(train_design, all_train_y, rcond=None)
    structure_prediction = test_design @ coefficients
    structure_residual = test_y - structure_prediction
    results["discarded_structure"] = {
        "model": "ordinary least squares on exact target-sufficient network terms",
        "held_out_explained_variance": _explained_variance(
            test_y, structure_prediction
        ),
        "held_out_rmse": float(
            np.sqrt(np.mean(structure_residual * structure_residual))
        ),
        "held_out_mae": float(np.mean(np.abs(structure_residual))),
        "held_out_max_abs_error": float(np.max(np.abs(structure_residual))),
        "coefficients": [float(value) for value in coefficients],
    }
    results["held_out_rows"] = len(test_rows)
    results["held_out_target_variance"] = float(np.var(test_y))
    results["explained_variance_gap"] = (
        results["discarded_structure"]["held_out_explained_variance"]
        - results["q_only"]["held_out_explained_variance"]
    )
    return results


def _survival_mismatch_summary(rows: list[ExactRow]) -> dict[str, object]:
    selected = [row for row in rows if row.anchor in {0, 1}]
    affected_rows = 0
    survival_affected_rows = 0
    validity_affected_rows = 0
    survival_offset_mismatches = 0
    validity_offset_mismatches = 0
