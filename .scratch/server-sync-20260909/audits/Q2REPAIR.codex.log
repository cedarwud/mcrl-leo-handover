new file mode 100644
index 0000000000000000000000000000000000000000..34c590e9dd6c7415cf6a6b9cc7e5a1d2e5e3d4e1
--- /dev/null
+++ b/q2_schema_v2.py
@@ -0,0 +1,447 @@
+"""Versioned Q2 feature-schema successor; the sealed v1 code stays untouched.
+
+The module is a projection layer over authenticated v1 source rows. It removes
+four exact duplicates and adds the focal link elevation at each of C2's three
+declared forecast offsets. The added geometry is available at the decision
+boundary through the same declared forecast-horizon provider seam used to
+construct C2's offset projections.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from hashlib import sha256
+import json
+import math
+from typing import Any, Callable, Iterable, Mapping, Sequence
+
+
+Q2_V1_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"
+Q2_V1_SCHEMA_SHA256 = "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c"
+Q2_V2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v2"
+ROW_Q2_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-row-q2-v2"
+SHARD_Q2_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-shard-q2-v2"
+
+
+class Q2SchemaV2Error(RuntimeError):
+    """A v2 schema/projection invariant failed closed."""
+
+
+def canonical_json_bytes(value: Any) -> bytes:
+    try:
+        return json.dumps(
+            value,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=True,
+            allow_nan=False,
+        ).encode("ascii")
+    except (TypeError, ValueError, UnicodeEncodeError) as error:
+        raise Q2SchemaV2Error("value is not canonical finite JSON") from error
+
+
+def canonical_sha256(value: Any) -> str:
+    return sha256(canonical_json_bytes(value)).hexdigest()
+
+
+def float_hex(value: float | int) -> str:
+    number = float(value)
+    if not math.isfinite(number):
+        raise Q2SchemaV2Error("schema floats must be finite")
+    return number.hex()
+
+
+def parse_float_hex(value: object, *, field: str) -> float:
+    if not isinstance(value, str):
+        raise Q2SchemaV2Error(f"{field} must be a hexadecimal float string")
+    try:
+        number = float.fromhex(value)
+    except ValueError as error:
+        raise Q2SchemaV2Error(f"{field} is not a hexadecimal float") from error
+    if not math.isfinite(number) or number.hex() != value:
+        raise Q2SchemaV2Error(f"{field} is not a canonical finite float")
+    return number
+
+
+@dataclass(frozen=True, slots=True)
+class FeatureSpec:
+    name: str
+    unit: str
+    scale: float
+
+
+Q2_V2_CURRENT_FEATURES = (
+    FeatureSpec("candidate_current_nominal_decoding_margin", "dB", 20.0),
+    FeatureSpec("forecast_se_trend", "bit/s/Hz/s", 0.1),
+    FeatureSpec("remaining_d2_time", "s", 120.0),
+    FeatureSpec("remaining_visibility_time", "s", 120.0),
+    FeatureSpec("refresh_phase", "decision", 3.0),
+    FeatureSpec("background_occupancy_excluding_focal", "user", 10.0),
+    FeatureSpec("satellite_active_before_focal", "boolean", 1.0),
+    FeatureSpec("required_power_cap_margin", "W", 1.65),
+    FeatureSpec("missing_incumbent", "boolean", 1.0),
+)
+
+Q2_V2_OFFSET_FEATURES = tuple(
+    feature
+    for offset in (1, 2, 3)
+    for feature in (
+        FeatureSpec(f"offset_{offset}_survival", "boolean", 1.0),
+        FeatureSpec(f"offset_{offset}_minimum_decoding_margin", "dB", 20.0),
+        FeatureSpec(f"offset_{offset}_mean_acm_spectral_efficiency", "bit/s/Hz", 4.0),
+        FeatureSpec(f"offset_{offset}_focal_link_elevation", "deg", 90.0),
+    )
+)
+
+Q2_V2_FEATURES = Q2_V2_CURRENT_FEATURES + Q2_V2_OFFSET_FEATURES
+Q2_V2_FEATURE_NAMES = tuple(feature.name for feature in Q2_V2_FEATURES)
+
+Q2_V2_SCHEMA = {
+    "schema": Q2_V2_SCHEMA_VERSION,
+    "successor_of": {
+        "schema": Q2_V1_SCHEMA_VERSION,
+        "sha256": Q2_V1_SCHEMA_SHA256,
+    },
+    "normalization": "raw_value / positive_frozen_scale; signed values retained",
+    "shape": [len(Q2_V2_FEATURES)],
+    "features": [
+        {"name": feature.name, "unit": feature.unit, "scale_hex": float_hex(feature.scale)}
+        for feature in Q2_V2_FEATURES
+    ],
+    "changes": {
+        "removed_exact_redundancies": [
+            "beam_active_before_focal: exactly 1[background_occupancy_excluding_focal > 0]",
+            "offset_1_valid: exactly 1[offset_1_mean_acm_spectral_efficiency > 0]",
+            "offset_2_valid: exactly 1[offset_2_mean_acm_spectral_efficiency > 0]",
+            "offset_3_valid: exactly 1[offset_3_mean_acm_spectral_efficiency > 0]",
+        ],
+        "added": [
+            "offset_1_focal_link_elevation: provider boundary-0 elevation at the first declared C2 forecast offset",
+            "offset_2_focal_link_elevation: provider boundary-0 elevation at the second declared C2 forecast offset",
+            "offset_3_focal_link_elevation: provider boundary-0 elevation at the third declared C2 forecast offset",
+        ],
+        "retained_exact_constants_on_measured_development_panel": [
+            "required_power_cap_margin: computed as BEAM_RF_CAP_W - required_power_w_max; zero because every retained exact-path rate profile saturates the cap",
+            "missing_incumbent: zero because every user at every measured development anchor has an incumbent physical mapping",
+            "offset_3_survival: zero because none of the focal action changes remains physically served at the third offset on the measured step-0..9 development panel",
+        ],
+        "why_elevation_is_c2_relevant": (
+            "C2 scores physical surplus until the first failed offset and then absorbs all "
+            "later offsets. Per-offset link elevation is decision-time forecast geometry "
+            "governing visibility/link persistence at those exact three offsets."
+        ),
+        "null_action_geometry": (
+            "all three offset elevations are 0 only when the row-level null_action flag "
+            "says no focal physical link exists"
+        ),
+        "semantic_effective_dimension_accounting": (
+            "record constants and exact functions explicitly; do not equate serialized "
+            "width with effective dimension"
+        ),
+    },
+    "removed_legacy": ["recurrence_power", "entry_gain_ratio", "segment_age"],
+}
+Q2_V2_SCHEMA_SHA256 = canonical_sha256(Q2_V2_SCHEMA)
+
+
+def upgrade_q2_state_v2(
+    q2_state_v1: Sequence[float],
+    *,
+    offset_elevations_deg: Sequence[float],
+    null_action: bool,
+) -> tuple[float, ...]:
+    """Project one learner-normalized v1 vector to learner-normalized Q2-v2."""
+
+    if len(q2_state_v1) != 22:
+        raise Q2SchemaV2Error("v1 Q2 state must have exactly 22 slots")
+    old = tuple(float(value) for value in q2_state_v1)
+    if not all(math.isfinite(value) for value in old):
+        raise Q2SchemaV2Error("v1 Q2 state contains a non-finite value")
+    elevations = tuple(float(value) for value in offset_elevations_deg)
+    if len(elevations) != 3 or not all(math.isfinite(value) for value in elevations):
+        raise Q2SchemaV2Error("exactly three finite offset elevations are required")
+    if null_action:
+        if elevations != (0.0, 0.0, 0.0):
+            raise Q2SchemaV2Error("null action geometry must use explicit absent-link zeros")
+    elif not all(-90.0 <= elevation <= 90.0 for elevation in elevations):
+        raise Q2SchemaV2Error("non-null offset elevation is outside physical bounds")
+
+    # Old slots 6, 10, 14, and 18 are excluded. Elevation is appended to each
+    # corresponding three-offset block. Every retained old value is unchanged.
+    projected: list[float] = [*old[0:6], *old[7:10]]
+    for offset, start in enumerate((10, 14, 18)):
+        projected.extend((old[start + 1], old[start + 2], old[start + 3], elevations[offset] / 90.0))
+    result = tuple(projected)
+    if len(result) != len(Q2_V2_FEATURES):
+        raise AssertionError("internal Q2-v2 projection length drifted")
+    return result
+
+
+def project_row_payload_v2(
+    parent_payload: Mapping[str, object],
+    *,
+    offset_elevations_deg: Sequence[float],
+    geometry_source: str,
+) -> dict[str, object]:
+    """Create an authenticated Q2-v2 row payload from a sealed v1 row."""
+
+    if parent_payload.get("q2_schema_sha256") != Q2_V1_SCHEMA_SHA256:
+        raise Q2SchemaV2Error("parent row is not the sealed Q2-v1 schema")
+    raw_state = parent_payload.get("q2_state")
+    if not isinstance(raw_state, list) or len(raw_state) != 22:
+        raise Q2SchemaV2Error("parent q2_state is malformed")
+    old = tuple(parse_float_hex(value, field="q2_state") for value in raw_state)
+    null_action = parent_payload.get("null_action")
+    if type(null_action) is not bool:
+        raise Q2SchemaV2Error("parent null_action is not boolean")
+    elevations = tuple(float(value) for value in offset_elevations_deg)
+    state = upgrade_q2_state_v2(old, offset_elevations_deg=elevations, null_action=null_action)
+    if not geometry_source:
+        raise Q2SchemaV2Error("geometry source must be named")
+
+    result = dict(parent_payload)
+    result["schema"] = ROW_Q2_V2_SCHEMA_VERSION
+    result["q2_state"] = [float_hex(value) for value in state]
+    result["q2_schema_sha256"] = Q2_V2_SCHEMA_SHA256
+    result["q2_v1_parent_row_sha256"] = canonical_sha256(parent_payload)
+    result["q2_geometry_source"] = geometry_source
+    result["q2_visible_primitives_sha256"] = canonical_sha256({
+        "parent_visible_primitives_sha256": parent_payload.get("visible_primitives_sha256"),
+        "offset_elevations_deg_hex": [float_hex(value) for value in elevations],
+        "geometry_source": geometry_source,
+    })
+    validate_v2_row_payload(result)
+    return result
+
+
+def validate_v2_row_payload(payload: Mapping[str, object]) -> None:
+    if payload.get("schema") != ROW_Q2_V2_SCHEMA_VERSION:
+        raise Q2SchemaV2Error("row schema is not Q2-v2")
+    if payload.get("q2_schema_sha256") != Q2_V2_SCHEMA_SHA256:
+        raise Q2SchemaV2Error("row Q2 digest is not Q2-v2")
+    state = payload.get("q2_state")
+    if not isinstance(state, list) or len(state) != len(Q2_V2_FEATURES):
+        raise Q2SchemaV2Error("Q2-v2 row state dimension drifted")
+    for value in state:
+        parse_float_hex(value, field="q2_state")
+    for field in ("q2_v1_parent_row_sha256", "q2_visible_primitives_sha256"):
+        digest = payload.get(field)
+        if not isinstance(digest, str) or len(digest) != 64 or any(
+            character not in "0123456789abcdef" for character in digest
+        ):
+            raise Q2SchemaV2Error(f"{field} is not a lowercase SHA-256")
+
+
+def encode_v2_shard(rows: Iterable[Mapping[str, object]]) -> bytes:
+    material = [dict(row) for row in rows]
+    if not material:
+        raise Q2SchemaV2Error("cannot encode an empty Q2-v2 shard")
+    for row in material:
+        validate_v2_row_payload(row)
+    q1_digests = {row.get("q1_schema_sha256") for row in material}
+    if len(q1_digests) != 1:
+        raise Q2SchemaV2Error("Q2-v2 shard rows disagree on Q1 schema")
+    header = {
+        "schema": SHARD_Q2_V2_SCHEMA_VERSION,
+        "row_count": len(material),
+        "rows_sha256": canonical_sha256(material),
+        "q1_schema_sha256": next(iter(q1_digests)),
+        "q2_schema_sha256": Q2_V2_SCHEMA_SHA256,
+    }
+    return b"\n".join(canonical_json_bytes(value) for value in (header, *material)) + b"\n"
+
+
+def decode_v2_shard(encoded: bytes) -> tuple[dict[str, object], ...]:
+    try:
+        values = [json.loads(line.decode("ascii")) for line in encoded.splitlines()]
+    except (UnicodeError, json.JSONDecodeError) as error:
+        raise Q2SchemaV2Error("cannot parse Q2-v2 shard") from error
+    if not values or not isinstance(values[0], dict):
+        raise Q2SchemaV2Error("Q2-v2 shard header is missing")
+    if encoded != b"\n".join(canonical_json_bytes(value) for value in values) + b"\n":
+        raise Q2SchemaV2Error("Q2-v2 shard is not canonical JSONL")
+    header, rows = values[0], values[1:]
+    if (
+        header.get("schema") != SHARD_Q2_V2_SCHEMA_VERSION
+        or header.get("q2_schema_sha256") != Q2_V2_SCHEMA_SHA256
+        or header.get("row_count") != len(rows)
+        or header.get("rows_sha256") != canonical_sha256(rows)
+    ):
+        raise Q2SchemaV2Error("Q2-v2 shard header/digest check failed")
+    for row in rows:
+        if not isinstance(row, dict):
+            raise Q2SchemaV2Error("Q2-v2 shard row is not an object")
+        validate_v2_row_payload(row)
+    return tuple(rows)
+
+
+OffsetGeometryLookup = Callable[[object], tuple[float, float, float]]
+
+
+class ForecastElevationResolverV2:
+    """Resolve focal elevation at C2 offsets 1, 2, and 3 via public seams."""
+
+    def __init__(self, tape: object, provider: object, step_index: int) -> None:
+        import numpy as np
+        from mcrl.env.cells import build_cell_grid
+        from mcrl.env.geometry import geodetic_to_ecef
+        from mcrl.env.scenario import NOMINAL_GRID_ALTITUDE_KM
+
+        grid = build_cell_grid(altitude_km=NOMINAL_GRID_ALTITUDE_KM)
+        resolved: list[dict[tuple[int, tuple[int, int]], float]] = []
+        maximum_error = 0.0
+        for offset in (1, 2, 3):
+            projected_step = step_index + offset
+            layouts = (
+                tape.step_user_layouts[projected_step]
+                if tape.step_user_layouts
+                else tape.user_layout
+            )
+            ordered = sorted(layouts, key=lambda item: item.user_id)
+            user_ids = np.asarray([item.user_id for item in ordered], dtype=np.int64)
+            user_ecef = geodetic_to_ecef(
+                np.asarray([item.latitude_deg for item in ordered], dtype=np.float64),
+                np.asarray([item.longitude_deg for item in ordered], dtype=np.float64),
+            )
+            user_by_id = {
+                int(user_id): tuple(float(value) for value in user_ecef[index])
+                for index, user_id in enumerate(user_ids.tolist())
+            }
+            satellites = dict(provider.satellite_ecef_km(
+                world_seed=tape.seed,
+                step_index=projected_step,
+                boundary_index=0,
+            ))
+            offset_values: dict[tuple[int, tuple[int, int]], float] = {}
+            for user_id, user_position in user_by_id.items():
+                for norad, satellite in satellites.items():
+                    for cell_id in range(len(grid.centers_ecef_km)):
+                        identity = (int(norad), int(cell_id))
+                        # Only materialize identities that can be requested through
+                        # the provider array row seam where available. Missing future
+                        # candidate rows are resolved lazily in __call__.
+                        offset_values[(user_id, identity)] = _elevation_from_ecef(
+                            satellite_ecef_km=satellite,
+                            user_ecef_km=user_position,
+                        )
+            arrays = tape.steps[projected_step].arrays
+            if arrays is not None:
+                for key, array_row in arrays._row_index().items():
+                    expected = float(arrays.elevations_deg[0, array_row])
+                    maximum_error = max(maximum_error, abs(offset_values[key] - expected))
+            resolved.append(offset_values)
+        if maximum_error > 1.0e-9:
+            raise Q2SchemaV2Error("public ECEF elevation disagrees with forecast provider arrays")
+        self._resolved = tuple(resolved)
+        self.maximum_elevation_crosscheck_error_deg = maximum_error
+
+    def __call__(self, row: object) -> tuple[float, float, float]:
+        if bool(row.null_action):
+            return 0.0, 0.0, 0.0
+        action = row.action
+        if action.norad_id is None or action.beam_chain_id is None:
+            raise Q2SchemaV2Error("non-null row has no physical identity")
+        key = (int(row.user_id), (int(action.norad_id), int(action.beam_chain_id)))
+        try:
+            return tuple(values[key] for values in self._resolved)  # type: ignore[return-value]
+        except KeyError as error:
+            raise Q2SchemaV2Error("non-null row has no decision-time forecast geometry") from error
+
+
+def _elevation_from_ecef(
+    *, satellite_ecef_km: Sequence[float], user_ecef_km: Sequence[float]
+) -> float:
+    satellite = tuple(float(value) for value in satellite_ecef_km)
+    user = tuple(float(value) for value in user_ecef_km)
+    if len(satellite) != 3 or len(user) != 3 or not all(
+        math.isfinite(value) for vector in (satellite, user) for value in vector
+    ):
+        raise Q2SchemaV2Error("ECEF geometry must contain finite length-three vectors")
+    link = tuple(s - u for s, u in zip(satellite, user, strict=True))
+    link_norm = math.sqrt(sum(value * value for value in link))
+    user_norm = math.sqrt(sum(value * value for value in user))
+    if min(link_norm, user_norm) <= 0.0:
+        raise Q2SchemaV2Error("ECEF geometry contains a zero-length direction")
+    sine_elevation = sum(delta * up for delta, up in zip(link, user, strict=True)) / (
+        link_norm * user_norm
+    )
+    return math.degrees(math.asin(max(-1.0, min(1.0, sine_elevation))))
+
+
+def _upgrade_builder_output_v2(
+    result: Mapping[str, object], geometry_lookup: OffsetGeometryLookup
+) -> dict[str, object]:
+    parent_rows = result.get("rows")
+    if not isinstance(parent_rows, tuple):
+        raise Q2SchemaV2Error("builder result has no tuple of source rows")
+    upgraded = [
+        project_row_payload_v2(
+            row.payload(),
+            offset_elevations_deg=geometry_lookup(row),
+            geometry_source=(
+                "provider declared forecast-horizon boundary-0 ECEF satellite/user "
+                "geometry; cross-checked against PrimitiveStepArrays where present"
+            ),
+        )
+        for row in parent_rows
+    ]
+    output = dict(result)
+    output["rows_v1"] = parent_rows
+    output["rows"] = tuple(upgraded)
+    output["rows_by_user_action"] = {
+        (
+            int(row["user_id"]),
+            None if bool(row["null_action"]) else (
+                int(row["action"]["norad_id"]), int(row["action"]["beam_chain_id"])
+            ),
+        ): row
+        for row in upgraded
+    }
+    return output
+
+
+def build_primitive_rows_v2(
+    pilot_module: object,
+    *,
+    geometry_lookup: OffsetGeometryLookup,
+    **builder_arguments: object,
+) -> dict[str, object]:
+    result = pilot_module._build_anchor_rows_primitive(**builder_arguments)
+    return _upgrade_builder_output_v2(result, geometry_lookup)
+
+
+def build_exact_rows_v2(
+    pilot_module: object,
+    *,
+    geometry_lookup: OffsetGeometryLookup,
+    **builder_arguments: object,
+) -> dict[str, object]:
+    original = pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK
+    pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
+    try:
+        result = pilot_module._build_anchor_rows(**builder_arguments)
+    finally:
+        pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK = original
+    return _upgrade_builder_output_v2(result, geometry_lookup)
+
