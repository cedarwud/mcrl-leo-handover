new file mode 100644
index 0000000000000000000000000000000000000000..12964db8c00d2f99af8f5d1f8c5f8d73aa4a80ef
--- /dev/null
+++ b/.scratch/q2-schema-v2/census_v1.py
@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""Census the sealed 22-slot Q2 matrix before any successor is defined."""
+
+from __future__ import annotations
+
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import resource
+
+import numpy as np
+
+from mcrl.stagec_v025.state import Q2_FEATURES, Q2_SCHEMA_SHA256
+
+
+ROOT = Path(__file__).resolve().parents[2]
+INPUTS = (
+    ROOT / ".scratch/c2-declared/world-1.jsonl",
+    ROOT / ".scratch/c2-declared/world-2.jsonl",
+)
+OUTPUT = ROOT / ".scratch/q2-schema-v2/census-v1.json"
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_matrix() -> np.ndarray:
+    rows: list[list[float]] = []
+    for path in INPUTS:
+        with path.open(encoding="utf-8") as handle:
+            for line in handle:
+                record = json.loads(line)
+                if record["kind"] == "anchor":
+                    rows.extend(row["q2"] for row in record["rows"])
+    matrix = np.asarray(rows, dtype=np.float64)
+    if matrix.shape != (19647, 22) or not np.isfinite(matrix).all():
+        raise RuntimeError(f"unexpected sealed Q2 matrix {matrix.shape}")
+    return matrix
+
+
+def safe_condition(singular_values: np.ndarray, shape: tuple[int, int]) -> dict[str, float | str | int]:
+    tolerance = max(shape) * np.finfo(np.float64).eps * float(singular_values[0])
+    nonzero = singular_values[singular_values > tolerance]
+    return {
+        "full": "infinity" if nonzero.size < shape[1] else float(nonzero[0] / nonzero[-1]),
+        "nonzero_singular_subspace": float(nonzero[0] / nonzero[-1]),
+        "numerical_nonzero_singular_values": int(nonzero.size),
+        "rank_tolerance": float(tolerance),
+    }
+
+
+def main() -> None:
+    x = load_matrix()
+    names = [feature.name for feature in Q2_FEATURES]
+    census = []
+    for slot, name in enumerate(names):
+        values = x[:, slot]
+        counts = Counter(values.tolist())
+        census.append({
+            "slot": slot,
+            "name": name,
+            "minimum": float(values.min()),
+            "maximum": float(values.max()),
+            "mean": float(values.mean()),
+            "sd_population": float(values.std(ddof=0)),
+            "distinct_count": len(counts),
+            "modal_fraction": float(max(counts.values()) / values.size),
+            "mode": float(counts.most_common(1)[0][0]),
+        })
+
+    constant = np.ptp(x, axis=0) == 0.0
+    correlation = np.full((x.shape[1], x.shape[1]), np.nan, dtype=np.float64)
+    variable = np.flatnonzero(~constant)
+    correlation[np.ix_(variable, variable)] = np.corrcoef(x[:, variable], rowvar=False)
+
+    r2_on_others = []
+    for slot, name in enumerate(names):
+        y = x[:, slot]
+        if constant[slot]:
+            value = None
+        else:
+            others = np.delete(x, slot, axis=1)
+            design = np.column_stack((np.ones(x.shape[0]), others))
+            coefficients = np.linalg.lstsq(design, y, rcond=None)[0]
+            residual = y - design @ coefficients
+            value = float(1.0 - residual @ residual / ((y - y.mean()) @ (y - y.mean())))
+        r2_on_others.append({"slot": slot, "name": name, "r2": value})
+
+    centred = x - x.mean(axis=0)
+    raw_sv = np.linalg.svd(x, full_matrices=False, compute_uv=False)
+    centred_sv = np.linalg.svd(centred, full_matrices=False, compute_uv=False)
+    exact_checks = {
+        "slot_6_beam_active_from_occupancy": bool(np.array_equal(x[:, 6], (x[:, 5] > 0.0).astype(float))),
+        "slot_10_offset_1_valid_from_mean_se": bool(np.array_equal(x[:, 10], (x[:, 13] > 0.0).astype(float))),
+        "slot_14_offset_2_valid_from_mean_se": bool(np.array_equal(x[:, 14], (x[:, 17] > 0.0).astype(float))),
+        "slot_18_offset_3_valid_from_mean_se": bool(np.array_equal(x[:, 18], (x[:, 21] > 0.0).astype(float))),
+    }
+    if not all(exact_checks.values()):
+        raise RuntimeError(f"declared exact-function checks failed: {exact_checks}")
+
+    result = {
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "phase": "sealed-v1-census-before-q2-v2-definition",
+        "inputs": [{"path": str(path.relative_to(ROOT)), "sha256": file_sha256(path)} for path in INPUTS],
+        "q2_schema_sha256": Q2_SCHEMA_SHA256,
+        "rows": int(x.shape[0]),
+        "slots": int(x.shape[1]),
+        "slot_census": census,
+        "correlation_matrix_slot_order": names,
+        "correlation_matrix": [[None if np.isnan(value) else float(value) for value in row] for row in correlation],
+        "r2_on_all_other_slots": r2_on_others,
+        "uncentered_rank": int(np.linalg.matrix_rank(x)),
+        "centered_rank": int(np.linalg.matrix_rank(centred)),
+        "uncentered_condition": safe_condition(raw_sv, x.shape),
+        "centered_condition": safe_condition(centred_sv, centred.shape),
+        "exact_constant_slots": [int(slot) for slot in np.flatnonzero(constant)],
+        "exact_function_checks": exact_checks,
+        "semantic_effective_dimension": int(x.shape[1] - constant.sum() - len(exact_checks)),
+    }
+    OUTPUT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    peak_kib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    print(f"WROTE={OUTPUT}")
+    print(f"SEALED_Q2_ROWS={x.shape[0]} SLOTS={x.shape[1]}")
+    print(f"RANK_UNCENTERED={result['uncentered_rank']} RANK_CENTERED={result['centered_rank']}")
+    print(f"EFFECTIVE_DIMENSION={result['semantic_effective_dimension']}")
+    print(f"PEAK_RSS_KB={peak_kib}")
+    if peak_kib >= 4 * 1024 * 1024:
+        raise RuntimeError("peak RSS exceeded 4 GiB")
+
+
+if __name__ == "__main__":
+    main()

