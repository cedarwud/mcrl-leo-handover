from scripts.diagnose_v025_c1c2_sufficiency import DEVELOPMENT_WORLD_DOMAINS, LegacyWorldProvider, REFERENCE_CARRIERS, build_world_tape, pilot
from mcrl.physics_v025.constants_v025 import BEAM_RF_CAP_W

tape = build_world_tape(domain=DEVELOPMENT_WORLD_DOMAINS[0], provider=LegacyWorldProvider(role='pilot-source'), steps=13, start_time_s=0.0)
setting = pilot.ENGINE._setting('a-r0')
run_setting = pilot.ENGINE.run_setting_for('a-r0')
values = []
for step in range(10):
    for carrier in REFERENCE_CARRIERS:
        base = pilot.ENGINE._base_configuration(tape, step, carrier)
        incumbent = pilot.ENGINE._base_configuration(tape, max(0, step - 1), carrier)
        evaluator = pilot.ENGINE.StepEvaluator(tape, setting, step, transition_from=incumbent, cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step), field='nominal', run_setting=run_setting, boundary_indices=(0,))
        evaluator.evaluate_many((base,))
        values.append(evaluator.evaluate(base).required_power_w_max / BEAM_RF_CAP_W)
print('unique_hex', sorted({value.hex() for value in values}))
print('count', len(values))
