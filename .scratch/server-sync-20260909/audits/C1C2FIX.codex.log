+    assert exact == [(False, False, False), (True, True, True)]
+    assert rows[0].c2_target_exact != rows[1].c2_target_exact
+    return {
+        "world": DEVELOPMENT_WORLD_DOMAINS[0],
+        "step": 0,
+        "user": 6,
+        "action": [65028, 44],
+        "current_base_mapping_equal": True,
+        "q1_equal": True,
+        "q2_equal": True,
+        "stored_survival_by_anchor": stored,
