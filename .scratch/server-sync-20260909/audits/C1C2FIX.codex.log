                index: int,
                _time_s: float,
                assignments: Mapping[int, tuple[int, int] | None],
                recompute_background: bool,
                *,
                expected_assignments: Mapping[int, tuple[int, int] | None] = config.mapping,
                projections: tuple[OffsetProjection, ...] = rows,
