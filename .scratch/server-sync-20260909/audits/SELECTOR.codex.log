+#!/usr/bin/env python3
+"""DIAGNOSTIC_NOT_CLAIM: isolate the V0.25 epoch-200 selector symptom."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Mapping, Sequence
+
+import numpy as np
+
+
+ROOT = Path(__file__).resolve().parents[1]
+PILOT = ROOT / "scripts/run_v025_pilot_c3.py"
+MIN_OUTPUT = ROOT / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
+FULL_OUTPUT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+OUT = ROOT / ".scratch/selector-diagnosis"
+SEEDS = (6407676579069309528, 925030429265975792)
+EPOCHS = tuple(range(100, 2001, 100))
+
+
+def _load_pilot():
+    spec = importlib.util.spec_from_file_location("selector_diag_pilot", PILOT)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PILOT}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    # Reproduce the minimal-pilot knobs without invoking its write-once runner.
+    module.EVALUATION_WORLDS = module.DEVELOPMENT_WORLD_DOMAINS[2:3]
+    module.LEARNER_DOMAINS = module.LEARNER_DOMAINS[:2]
+    module.LEARNER_SEEDS = SEEDS
+    module.PILOT_ARMS = ("FULL",)
+    module.EVAL_ANCHOR_STEPS = 5
+    module.EVAL_CARRIER_LIMIT = 1
+    module.EVAL_EPOCH = 200
+    module.ROW_WORLD_GLOB = "world-1"
+    module.ROW_ANCHOR_LIMIT = 5
+    module.EVAL_TAPE_STEPS = 8
+    return module
+
+
+def _arrays(values: Sequence[object]) -> list[np.ndarray]:
+    return [np.asarray([[float.fromhex(x) for x in row] for row in value], dtype=np.float64)
+            if value and isinstance(value[0], list)
+            else np.asarray([float.fromhex(x) for x in value], dtype=np.float64)
+            for value in values]
+
+
+@dataclass
+class PayloadHead:
+    weights: list[np.ndarray]
+    biases: list[np.ndarray]
+    activation: str
+
+    @classmethod
+    def from_payload(cls, payload: Mapping[str, object]) -> "PayloadHead":
+        return cls(
+            _arrays(payload["weights_hex"]),
+            _arrays(payload["biases_hex"]),
+            str(payload["activation"]),
+        )
+
+    def score(self, state: Sequence[float]) -> float:
+        current = np.asarray(state, dtype=np.float64)[None, :]
+        for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
+            current = current @ weights + bias
+            if index != len(self.weights) - 1:
+                current = np.maximum(current, 0.0) if self.activation == "relu" else np.tanh(current)
+        return float(current[0, 0])
+
+
+@dataclass
+class PayloadModel:
+    q1: PayloadHead
+    q2: PayloadHead
+    c3: PayloadHead
+    member_width: int
+
+    @classmethod
+    def load(cls, path: Path) -> "PayloadModel":
+        payload = json.loads(path.read_text(encoding="ascii"))["model"]
+        return cls(
+            PayloadHead.from_payload(payload["C1"]),
+            PayloadHead.from_payload(payload["C2"]),
+            PayloadHead.from_payload(payload["C3"]),
+            int(payload["C3"]["member_width"]),
+        )
+
+    def interaction(self, context) -> float:
+        if len(context.members) <= 1:
+            return 0.0
+        vector = legacy_invariant_vector(context, member_width=self.member_width)
+        if vector.size != self.c3.weights[0].shape[0]:
+            raise RuntimeError(
+                f"legacy C3 vector width {vector.size} != checkpoint width "
+                f"{self.c3.weights[0].shape[0]}"
+            )
+        return self.c3.score(vector)
+
+
+def _hash01(value: str) -> float:
+    return int.from_bytes(hashlib.sha256(value.encode()).digest()[:8], "big") / 2**64
+
+
+def legacy_invariant_vector(context, *, member_width: int) -> np.ndarray:
+    """Reconstruct the v1 117-D encoder bound into the inherited checkpoints.
+
+    The v1 rows/checkpoints predate the current padded relation block.  Their
+    dimensions and row payloads determine: member sum/max, beam
+    sum/max/min/mean, pooled (source-id, target-id, gain) sum/max, and global
+    resource scalars.
+    """
+
+    member_matrix = np.asarray(
+        [member.invariant_features for member in context.members], dtype=np.float64
+    )
+    if member_matrix.shape[1] != member_width:
+        raise RuntimeError("member width drift")
+    beam_features = np.asarray([
+        [
+            beam.occupancy_before,
+            beam.occupancy_after,
+            float(beam.active_after) - float(beam.active_before),
+            beam.shared_capacity,
+            beam.interference_summary,
+            beam.capacity_margin,
+            1.0,
+        ]
+        for beam in sorted(context.affected_beams, key=lambda item: item.beam_key)
+    ], dtype=np.float64)
+    relation_features = np.asarray(
+        [(_hash01(source), _hash01(target), gain) for source, target, gain in context.pairwise_cross_gain_terms]
+        or [(0.0, 0.0, 0.0)],
+        dtype=np.float64,
+    )
+    return np.concatenate((
+        np.asarray([float(len(context.members))]),
+        member_matrix.sum(axis=0),
+        member_matrix.max(axis=0),
+        beam_features.sum(axis=0),
+        beam_features.max(axis=0),
+        beam_features.min(axis=0),
+        beam_features.mean(axis=0),
+        relation_features.sum(axis=0),
+        relation_features.max(axis=0),
+        np.asarray(context.global_resource_features, dtype=np.float64),
+    ))
+
+
+def checkpoint_path(seed: int, epoch: int, *, minimal: bool = False) -> Path:
+    root = MIN_OUTPUT if minimal else FULL_OUTPUT
+    return root / "checkpoints" / f"PILOT_NOT_CLAIM-seed-{seed}-FULL-epoch-{epoch:04d}.json"
+
+
+def load_calibration(pilot):
+    payload = json.loads((MIN_OUTPUT / "PILOT_NOT_CLAIM-calibration.json").read_text(encoding="ascii"))
+    ratio = lambda name: Fraction(*payload[name])
+    return pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def additive_score(model: PayloadModel, rows, base, config) -> float:
+    return math.fsum(
+        model.q1.score(rows[(user, config.mapping[user])].q1_state)
+        - model.q1.score(rows[(user, base.mapping[user])].q1_state)
+        + model.q2.score(rows[(user, config.mapping[user])].q2_state)
+        - model.q2.score(rows[(user, base.mapping[user])].q2_state)
+        for user in sorted(base.mapping)
+    )
+
+
+def stable_argmax(scored):
+    return min(scored, key=lambda row: (-row[0], row[1]))
+
+
+def expected_epoch200() -> dict[tuple[int, int], str]:
+    path = MIN_OUTPUT / "evaluation/PILOT_NOT_CLAIM-raw-receipts.jsonl"
+    result = {}
+    for line in path.read_text(encoding="ascii").splitlines():
+        row = json.loads(line)
+        if row["catalogue_anchor"] == "P-a0" and row["arm"] == "FULL":
+            result[(int(row["anchor_index"]), int(row["learner_seed"]))] = row["configuration_id"]
+    return result
+
+
+def build_anchors(pilot):
+    calibration = load_calibration(pilot)
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    domain = pilot.DEVELOPMENT_WORLD_DOMAINS[2]
+    started = time.perf_counter()
+    tape = pilot.build_world_tape(
+        domain=domain,
+        provider=pilot.LegacyWorldProvider(role="selector-diagnosis"),
+        steps=8,
+        start_time_s=0.0,
+    )
+    print(json.dumps({"event": "tape-built", "wall_s": time.perf_counter() - started}), flush=True)
+    anchors = []
+    for anchor_index in range(5):
+        started = time.perf_counter()
+        built = pilot._build_anchor_rows(
+            tape=tape,
+            setting=setting,
+            run_setting=run_setting,
+            calibration=calibration,
+            step_index=anchor_index,
+            carrier=pilot.ENGINE.REFERENCE_CARRIERS[0],
+            anchor_index=anchor_index,
+            include_coalition=False,
+            full_legal_actions=True,
+        )
+        catalogue, census = pilot.ENGINE._catalogue_with_census(
+            tape,
+            anchor_index,
+            built["base"],
+            setting=setting,
+            calibration=calibration,
+            run_setting=run_setting,
+        )
+        anchors.append({
+            "anchor_index": anchor_index,
+            "tape": tape,
+            "setting": setting,
+            "run_setting": run_setting,
+            "calibration": calibration,
+            "built": built,
+            "catalogue": catalogue,
+            "census": census,
+        })
+        print(json.dumps({
+            "event": "anchor-built",
+            "anchor": anchor_index,
+            "catalogue": len(catalogue),
+            "sizes": dict(sorted(Counter(row.changed_users for row in catalogue).items())),
+            "wall_s": time.perf_counter() - started,
+        }), flush=True)
+    return anchors
+
+
+def run_zero(anchors) -> dict[str, object]:
+    expected = expected_epoch200()
+    models = {seed: PayloadModel.load(checkpoint_path(seed, 200, minimal=True)) for seed in SEEDS}
+    rows_out = []
+    for anchor in anchors:
+        base = anchor["built"]["base"]
+        rows = anchor["built"]["rows_by_user_action"]
+        catalogue = anchor["catalogue"]
+        for seed, model in models.items():
+            scored = [
+                (additive_score(model, rows, base, config), config.configuration_id, config)
+                for config in catalogue
+            ]
+            score, configuration_id, choice = stable_argmax(scored)
+            row = {
+                "anchor": anchor["anchor_index"],
+                "learner_seed": seed,
+                "zero_c3_choice_size": choice.changed_users,
+                "zero_c3_choice": configuration_id,
+                "zero_c3_score": score,
+                "observed_full_choice": expected[(anchor["anchor_index"], seed)],
+                "same_as_observed_full": configuration_id == expected[(anchor["anchor_index"], seed)],
+            }
+            rows_out.append(row)
+            print(json.dumps({"event": "zero-result", **row}), flush=True)
+    result = {
+        "schema": "mcrl-v025-selector-zero-c3-diagnostic-v1",
+        "artifact_label": "DIAGNOSTIC_NOT_CLAIM",
+        "rows": rows_out,
+        "all_zero_c3_choose_100": all(row["zero_c3_choice_size"] == 100 for row in rows_out),
+    }
+    OUT.mkdir(parents=True, exist_ok=True)
+    (OUT / "zero-c3.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii")
+    return result
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--phase", choices=("zero",), default="zero")
+    args = parser.parse_args(argv)
+    pilot = _load_pilot()
+    anchors = build_anchors(pilot)
+    if args.phase == "zero":
+        result = run_zero(anchors)
+        print(json.dumps({"event": "complete", "phase": "zero", "all_choose_100": result["all_zero_c3_choose_100"]}), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

