+        "declared_served_count": int(declared["served_count"]),
+        "best_found_served_count": int(found["served_count"]),
+        "declared_rate_target_attained_count": int(declared["rate_target_attained_count"]),
+        "best_found_rate_target_attained_count": int(found["rate_target_attained_count"]),
+    }
+
+
+def main() -> int:
