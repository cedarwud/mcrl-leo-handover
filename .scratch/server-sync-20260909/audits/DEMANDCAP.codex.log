#!/usr/bin/env python3
"""Audit whether the fast-look receipts can support demand-capped rescoring.

This script performs arithmetic over existing JSON receipts only. It does not
load the simulator, rebuild a world, or run any search, learner, or trainer.
"""

from __future__ import annotations

import json
import math
from pathlib import Path


REPO = Path(__file__).resolve().parents[1]
FAST_LOOK_RESULT = REPO / ".scratch/control-law-fast-look-result.json"
CORRECTED_RECEIPT = REPO / ".scratch/oracle-ceiling30-margin/results/date-2025-11-04.json"
FAST_LOOK_SOURCE = REPO / ".scratch/control_law_fast_look.py"


def capacity_row(anchor: dict[str, object]) -> dict[str, object]:
    declared = anchor["declared"]
    found = anchor["best_found"]
    assert isinstance(declared, dict) and isinstance(found, dict)
    declared_bits = float(declared["bits"])
    declared_joules = float(declared["joules"])
    found_bits = float(found["bits"])
    found_joules = float(found["joules"])
    return {
        "anchor_id": anchor["anchor_id"],
        "declared_bits_gbit": declared_bits / 1.0e9,
        "best_found_bits_gbit": found_bits / 1.0e9,
        "declared_joules": declared_joules,
        "best_found_joules": found_joules,
        "declared_ee_mbit_per_j": declared_bits / declared_joules / 1.0e6,
        "best_found_ee_mbit_per_j": found_bits / found_joules / 1.0e6,
        "relative_ee_gain_pct": ((found_bits / found_joules) / (declared_bits / declared_joules) - 1.0) * 100.0,
        "relative_bit_gain_pct": (found_bits / declared_bits - 1.0) * 100.0,
        "relative_joule_change_pct": (found_joules / declared_joules - 1.0) * 100.0,
        "declared_served_count": int(declared["served_count"]),
        "best_found_served_count": int(found["served_count"]),
        "declared_rate_target_attained_count": int(declared["rate_target_attained_count"]),
        "best_found_rate_target_attained_count": int(found["rate_target_attained_count"]),
    }


def main() -> int:
    result = json.loads(FAST_LOOK_RESULT.read_text(encoding="ascii"))
    corrected = json.loads(CORRECTED_RECEIPT.read_text(encoding="ascii"))
    source = FAST_LOOK_SOURCE.read_text(encoding="utf-8")

    anchors = result["anchors"]
    rows = [capacity_row(anchor) for anchor in anchors]
    declared_bits = math.fsum(float(anchor["declared"]["bits"]) for anchor in anchors)
    declared_joules = math.fsum(float(anchor["declared"]["joules"]) for anchor in anchors)
    found_bits = math.fsum(float(anchor["best_found"]["bits"]) for anchor in anchors)
    found_joules = math.fsum(float(anchor["best_found"]["joules"]) for anchor in anchors)
    pooled = {
        "declared_bits_gbit": declared_bits / 1.0e9,
        "best_found_bits_gbit": found_bits / 1.0e9,
        "declared_joules": declared_joules,
        "best_found_joules": found_joules,
        "declared_ee_mbit_per_j": declared_bits / declared_joules / 1.0e6,
        "best_found_ee_mbit_per_j": found_bits / found_joules / 1.0e6,
        "relative_ee_gain_pct": ((found_bits / found_joules) / (declared_bits / declared_joules) - 1.0) * 100.0,
        "relative_bit_gain_pct": (found_bits / declared_bits - 1.0) * 100.0,
        "relative_joule_change_pct": (found_joules / declared_joules - 1.0) * 100.0,
        "declared_served_count": sum(row["declared_served_count"] for row in rows),
        "best_found_served_count": sum(row["best_found_served_count"] for row in rows),
        "declared_rate_target_attained_count": sum(row["declared_rate_target_attained_count"] for row in rows),
        "best_found_rate_target_attained_count": sum(row["best_found_rate_target_attained_count"] for row in rows),
    }

    # Check the published pooled capacity calculation exactly against the
    # arithmetic derived above. This is not an independent physical rescore.
    assert math.isclose(
        pooled["declared_ee_mbit_per_j"] * 1.0e6,
        float(result["pooled"]["declared_ee_bit_per_j"]),
        rel_tol=1.0e-15,
    )
    assert math.isclose(
        pooled["best_found_ee_mbit_per_j"] * 1.0e6,
        float(result["pooled"]["best_found_ee_bit_per_j"]),
        rel_tol=1.0e-15,
    )
    assert math.isclose(
        pooled["relative_ee_gain_pct"] / 100.0,
        float(result["pooled"]["relative_gap"]),
        rel_tol=1.0e-15,
    )

    fast_setting_keys = {
        setting: sorted(anchors[0][setting].keys())
        for setting in ("declared", "best_found")
    }
    corrected_setting_keys = sorted(corrected["anchors"][0]["committed"]["ORACLE_SET"].keys())

    # The optimizer held these values only in the local ``slots`` objects.
    # Confirm that the source never adds them to the returned/serialized result.
    assert 'slot["searched_power"] = powers' in source
    assert 'slot["searched_se"] = se' in source
    assert '"best_found": searched' in source
    assert set(fast_setting_keys["best_found"]) == {
        "bits",
        "ee_bit_per_j",
        "joules",
        "mode_counts",
        "rate_target_attained_count",
        "served_count",
    }

    audit = {
        "status": "BLOCKED_MISSING_RECEIPT_FIELDS",
        "scope": "existing-receipt arithmetic only; no search/world rebuild/learner/training",
        "capacity": {"anchors": rows, "pooled": pooled},
        "serialized_keys": {
            "fast_look_declared": fast_setting_keys["declared"],
            "fast_look_best_found": fast_setting_keys["best_found"],
            "corrected_oracle_set": corrected_setting_keys,
        },
        "missing_for_demand_capped": (
            "for both settings, per-user delivered rate at each of the 48 boundaries after exact "
            "rational-subslot weighting, or equivalent per-boundary/subslot user delivery records"
        ),
        "missing_for_attainment_only": (
            "for both settings, integrated bits keyed by user (and an unambiguous rule on whether "
            "attaining users retain uncapped capacity or contracted bits)"
        ),
        "missing_for_increment_split": (
            "stable user identities plus declared and best-found per-user integrated/capped bits, "
            "so the 142 declared attainers and 58 declared non-attainers can be followed"
        ),
        "missing_control_receipt": (
            "best-found power and ACM-mode choices for every boundary and rational subslot; only "
            "the fixed association configuration_id was serialized"
        ),
    }
    print(json.dumps(audit, indent=2, sort_keys=True, allow_nan=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

