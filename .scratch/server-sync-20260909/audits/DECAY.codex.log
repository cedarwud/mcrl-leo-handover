@@ -0,0 +1,442 @@
+#!/usr/bin/env python3
+"""C3 decay-schedule convergence diagnostic; computes no EE quantity."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+ROOT = Path("/home/sat/mcrl-v025-decay-ws")
+OUT = ROOT / ".scratch/decay-schedule"
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2-ws")
+SOURCE_RUNNER = SOURCE_ROOT / ".scratch/lr-convergence-sweep/run_sweep.py"
+SOURCE_SPEC = SOURCE_ROOT / ".scratch/lr-convergence-sweep/spec.md"
+SOURCE_RESULTS = SOURCE_ROOT / ".scratch/lr-convergence-sweep/results.json"
+SOURCE_LEARNER = SOURCE_ROOT / "src/mcrl/stagec_v025/learner.py"
+HORIZON_RESULTS = Path("/home/sat/mcrl-v025-horizon-ws/.scratch/horizon-lever/results.json")
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+RSS_LIMIT_BYTES = 3 * 1024**3 - 1
+MAX_UPDATES = 4000
+CADENCE = 100
+BASE_LR = 1e-3
+HIGHER_LR = 3e-3
+TAU = 1000
+PLATEAU_N = 3
+SCHEDULE_ORDER = ("cosine", "step", "inverse_time_tau1000", "plateau_n3")
+EXPECTED_HASHES = {
+    str(SOURCE_RUNNER): "dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6",
+    str(SOURCE_SPEC): "0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19",
+    str(SOURCE_RESULTS): "9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861",
+    str(SOURCE_LEARNER): "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+    str(HORIZON_RESULTS): "b05fed675d137b95cefffcad745fda1a67cdffc816f3ba3d7f43b08cd0ff7c62",
+}
+
+
+class LoadPause(RuntimeError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_json(path: Path, payload: object) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def verify_runtime() -> None:
+    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) != 18:
+        raise RuntimeError(f"process niceness is not 18: {os.getpriority(os.PRIO_PROCESS, 0)}")
+    actual = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    if actual != EXPECTED_HASHES:
+        raise RuntimeError(f"sealed source hash mismatch: {actual}")
+
+
+def load_average() -> float:
+    return float(Path("/proc/loadavg").read_text(encoding="ascii").split()[0])
+
+
+def guard_load() -> float:
+    value = load_average()
+    if value > 30.0:
+        raise LoadPause(f"one-minute load average {value:.2f} exceeds 30")
+    return value
+
+
+def import_sweep():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    spec = importlib.util.spec_from_file_location("sealed_lr_sweep", SOURCE_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load sealed LRSWEEP harness")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+    return module
+
+
+def checkpoint(sweep, heads, data):
+    predictions = []
+    objectives = []
+    norms = []
+    for fold_index, (head, test) in enumerate(zip(heads, data.anchors, strict=True)):
+        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        loss, count = sweep.c3_loss(head, train)
+        if not math.isfinite(loss) or not sweep.parameters_finite(head):
+            raise RuntimeError(f"non-finite state at fold {fold_index + 1}")
+        prediction = sweep.np.zeros_like(test.truth)
+        prediction[test.train_indices] = head._forward(test.x)[0]
+        predictions.append(prediction)
+        objectives.append((loss, count))
+        norms.append(sweep.parameter_norm(head))
+    weighted = sum(value * count for value, count in objectives) / sum(count for _, count in objectives)
+    return {
+        "training_objective": float(weighted),
+        "held_out": sweep.c3_metric(predictions, data.anchors),
+        "parameter_l2": sweep.summarize(norms),
+    }
+
+
+def stability(sweep, left: dict[str, object], right: dict[str, object]) -> dict[str, object]:
+    changes = {
+        "objective_relative_abs": abs(right["training_objective"] - left["training_objective"])
+        / max(abs(left["training_objective"]), 1e-12),
+        "r2_absolute": abs(right["held_out"]["r2"] - left["held_out"]["r2"]),
+        "pairwise_ordering_absolute": abs(
+            right["held_out"]["pairwise_ordering"] - left["held_out"]["pairwise_ordering"]
+        ),
+        "top1_accuracy_absolute": abs(
+            right["held_out"]["top1_accuracy"] - left["held_out"]["top1_accuracy"]
+        ),
+    }
+    passed = {
+        "objective": changes["objective_relative_abs"] <= sweep.STABILITY_TOLERANCES["objective_relative"],
+        "r2": changes["r2_absolute"] <= sweep.STABILITY_TOLERANCES["r2_absolute"],
+        "pairwise_ordering": changes["pairwise_ordering_absolute"]
+        <= sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        "top1_accuracy": changes["top1_accuracy_absolute"]
+        <= sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    }
+    return {"changes": changes, "passed": passed, "admissible": all(passed.values())}
+
+
+def scheduled_lr(name: str, start_lr: float, update: int, plateau_lr: float) -> float:
+    t = update - 1
+    if name == "constant":
+        return start_lr
+    if name == "cosine":
+        return start_lr * (1.0 + math.cos(math.pi * t / MAX_UPDATES)) / 2.0
+    if name == "step":
+        return start_lr * (1.0 if update <= 2000 else 0.1 if update <= 3000 else 0.01)
+    if name == "inverse_time_tau1000":
+        return start_lr / (1.0 + t / TAU)
+    if name == "plateau_n3":
+        return plateau_lr
+    raise ValueError(name)
+
+
+def run_schedule(sweep, data, name: str, start_lr: float, maximum_updates: int,
+                 progress: list[int], total_work: int) -> dict[str, object]:
+    literal = dict(sweep.LEGACY_TRAINER_LITERALS["C3"])
+    literal["learning_rate"] = start_lr
+    heads = [
+        sweep.AdamMLPHead.create(
+            anchor.x.shape[1], literal, sweep.np.random.default_rng(sweep.SEED)
+        )
+        for anchor in data.anchors
+    ]
+    trains = [
+        tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        for fold_index in range(len(data.anchors))
+    ]
+    trajectory = {"0": checkpoint(sweep, heads, data)}
+    checks = {}
+    lr_trace = {"0": start_lr}
+    first_admissible = None
+    cadence_total = []
+    cadence_update = []
+    cadence_checkpoint = []
+    cumulative_total = []
+    running_total = 0.0
+    observed_load = [guard_load()]
+    plateau_lr = start_lr
+    plateau_best = None
+    plateau_stale = 0
+    plateau_events = []
+    started = time.perf_counter()
+
+    for cadence_end in range(CADENCE, maximum_updates + 1, CADENCE):
+        cadence_started = time.perf_counter()
+        update_elapsed = 0.0
+        for update in range(cadence_end - CADENCE + 1, cadence_end + 1):
+            lr = scheduled_lr(name, start_lr, update, plateau_lr)
+            for fold_index, head in enumerate(heads):
+                head.learning_rate = lr
+                update_started = time.perf_counter()
+                with sweep.np.errstate(all="ignore"):
+                    loss_before = sweep.c3_update(head, trains[fold_index])
+                update_elapsed += time.perf_counter() - update_started
+                if not math.isfinite(loss_before) or not sweep.parameters_finite(head):
+                    raise RuntimeError(
+                        f"schedule {name} lr {start_lr} fold {fold_index + 1} "
+                        f"diverged at update {update}"
+                    )
+        checkpoint_started = time.perf_counter()
+        point = checkpoint(sweep, heads, data)
+        checkpoint_elapsed = time.perf_counter() - checkpoint_started
+        trajectory[str(cadence_end)] = point
+        check = stability(sweep, trajectory[str(cadence_end - CADENCE)], point)
+        checks[str(cadence_end)] = check
+        if first_admissible is None and check["admissible"]:
+            first_admissible = cadence_end
+
+        if name == "plateau_n3":
+            motion = check["changes"]["objective_relative_abs"]
+            if plateau_best is None or motion < plateau_best:
+                plateau_best = motion
+                plateau_stale = 0
+            else:
+                plateau_stale += 1
+                if plateau_stale >= PLATEAU_N:
+                    old_lr = plateau_lr
+                    plateau_lr *= 0.5
+                    plateau_events.append({
+                        "after_update": cadence_end, "old_lr": old_lr,
+                        "new_lr": plateau_lr, "trigger_motion": motion,
+                    })
+                    plateau_best = motion
+                    plateau_stale = 0
+        lr_trace[str(cadence_end)] = (
+            0.0 if name == "cosine" and cadence_end == MAX_UPDATES
+            else plateau_lr if name == "plateau_n3"
+            else scheduled_lr(name, start_lr, cadence_end, plateau_lr)
+        )
+        total_elapsed = time.perf_counter() - cadence_started
+        cadence_total.append(total_elapsed)
+        cadence_update.append(update_elapsed)
+        cadence_checkpoint.append(checkpoint_elapsed)
+        running_total += total_elapsed
+        cumulative_total.append(running_total)
+        progress[0] += CADENCE * len(heads)
+        current_load = load_average()
+        observed_load.append(current_load)
+        print(
+            f"update {progress[0]}/{total_work} schedule={name} start_lr={start_lr:g} "
+            f"destination={cadence_end}/{maximum_updates} load1={current_load:.2f}",
+            flush=True,
+        )
+        if current_load > 30.0:
+            raise LoadPause(f"one-minute load average {current_load:.2f} exceeds 30")
+
+    return {
+        "schedule": name,
+        "starting_learning_rate": start_lr,
+        "maximum_updates": maximum_updates,
+        "trajectory": trajectory,
+        "cadence_checks": checks,
+        "first_admissible_update": first_admissible,
+        "learning_rate_at_cadence": lr_trace,
+        "plateau_events": plateau_events,
+        "wall_s": time.perf_counter() - started,
+        "timing": {
+            "total_s_per_100_updates_across_12_loao_folds": cadence_total,
+            "update_only_s_per_100_updates_across_12_loao_folds": cadence_update,
+            "checkpoint_s_per_100_updates_across_12_loao_folds": cadence_checkpoint,
+            "cumulative_total_s_across_12_loao_folds": cumulative_total,
+            "mean_total_s_per_100_updates_across_12_loao_folds": sum(cadence_total) / len(cadence_total),
+            "mean_update_only_s_per_100_updates_across_12_loao_folds": sum(cadence_update) / len(cadence_update),
+        },
+        "maximum_observed_load1": max(observed_load),
+    }
+
+
+def source_state(sweep, data):
+    fixed = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    inputs = {str(anchor.path): file_sha256(anchor.path) for anchor in data.anchors}
+    return fixed, inputs
+
+
+def common_result(sweep, data, started, initial_load, before, inputs_before):
+    after, inputs_after = source_state(sweep, data)
+    changed = [path for path in (*before, *inputs_before)
+               if (before | inputs_before)[path] != (after | inputs_after)[path]]
+    peak_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    if peak_kb * 1024 >= 3 * 1024**3:
+        raise RuntimeError(f"peak RSS cap exceeded: {peak_kb} KiB")
+    return {
+        "schema": "mcrl-v025-decay-schedule-diagnostic-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "route": "C3",
+        "model_seed_domain": "V025_LEARNER/seed/1",
+        "model_seed": sweep.SEED,
+        "cadence_updates": CADENCE,
+        "stability_tolerances": sweep.STABILITY_TOLERANCES,
+        "inventory": {
+            "anchors": len(data.anchors),
+            "rows": sum(anchor.truth.size for anchor in data.anchors),
+            "trainable_rows": sum(anchor.train_indices.size for anchor in data.anchors),
+            "input_files": [str(anchor.path) for anchor in data.anchors],
+        },
+        "schedule_parameters": {"tau": TAU, "plateau_n": PLATEAU_N},
+        "scope": {
+            "diagnostic_not_claim": True, "ee_quantities_computed": False,
+            "selection_on_ee": False, "selection_on_predictive_levels": False,
+            "metrics_use": "convergence diagnostics only; never evidence about EE",
+        },
+        "resource_policy": {
+            "python_processes": 1, "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "blas_threads": 1, "rlimit_as_bytes": resource.getrlimit(resource.RLIMIT_AS)[0],
+            "peak_rss_kb": peak_kb, "initial_load1": initial_load,
+            "final_load1": load_average(), "elapsed_wall_s": time.perf_counter() - started,
+        },
+        "source_sha256_before": before, "source_sha256_after": after,
+        "c3_input_sha256_before": inputs_before, "c3_input_sha256_after": inputs_after,
+        "changed_inputs": changed,
+    }
+
+
+def original_c3_cell():
+    payload = json.loads(SOURCE_RESULTS.read_text(encoding="utf-8"))
+    return next(cell for cell in payload["cells"]
+                if cell["route"] == "C3" and cell["learning_rate"] == BASE_LR)
+
+
+def parity(sweep, data, started, initial_load, before, inputs_before):
+    progress = [0]
+    run = run_schedule(
+        sweep, data, "constant", BASE_LR, 500, progress,
+        len(data.anchors) * 500,
+    )
+    horizon = json.loads(HORIZON_RESULTS.read_text(encoding="utf-8"))["arms"]["A"]
+    lrsweep = original_c3_cell()
+    comparisons = {}
+    for update in range(0, 501, CADENCE):
+        key = str(update)
+        fields = ("training_objective", "held_out")
+        comparisons[key] = {
+            "horizon_exact": all(run["trajectory"][key][field] == horizon["trajectory"][key][field]
+                                 for field in fields),
+            "lrsweep_exact": all(run["trajectory"][key][field] == lrsweep["trajectory"][key][field]
+                                 for field in fields),
+        }
+    reproduced = all(all(value.values()) for value in comparisons.values())
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "parity", "run": run, "comparisons": comparisons,
+                   "parity_reproduced": reproduced})
+    atomic_json(OUT / "parity.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "parity.json"),
+                      "parity_reproduced": reproduced}), flush=True)
+    if not reproduced:
+        raise RuntimeError("HORIZON Arm A parity failed; stop before schedules")
+
+
+def cap_tolerance_score(sweep, run):
+    check = run["cadence_checks"][str(MAX_UPDATES)]
+    changes = check["changes"]
+    ratios = (
+        changes["objective_relative_abs"] / sweep.STABILITY_TOLERANCES["objective_relative"],
+        changes["r2_absolute"] / sweep.STABILITY_TOLERANCES["r2_absolute"],
+        changes["pairwise_ordering_absolute"] / sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        changes["top1_accuracy_absolute"] / sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    )
+    return max(ratios)
+
+
+def select_extension_shape(sweep, runs):
+    ranked = []
+    for index, name in enumerate(SCHEDULE_ORDER):
+        run = runs[name]
+        first = run["first_admissible_update"]
+        key = (0, first, index) if first is not None else (1, cap_tolerance_score(sweep, run), index)
+        ranked.append((key, name))
+    ranked.sort()
+    return ranked[0][1], [{"schedule": name, "ranking_key": list(key)} for key, name in ranked]
+
+
+def base(sweep, data, started, initial_load, before, inputs_before):
+    parity_result = json.loads((OUT / "parity.json").read_text(encoding="utf-8"))
+    if not parity_result.get("parity_reproduced"):
+        raise RuntimeError("verified parity artifact is absent or failed")
+    progress = [0]
+    total = len(SCHEDULE_ORDER) * len(data.anchors) * MAX_UPDATES
+    runs = {name: run_schedule(sweep, data, name, BASE_LR, MAX_UPDATES, progress, total)
+            for name in SCHEDULE_ORDER}
+    shape, ranking = select_extension_shape(sweep, runs)
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "base", "parity_reproduced": True, "runs": runs,
+                   "extension_shape": shape, "extension_ranking": ranking})
+    atomic_json(OUT / "base-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "base-results.json"),
+                      "extension_shape": shape}), flush=True)
+
+
+def higher(sweep, data, started, initial_load, before, inputs_before):
+    base_result = json.loads((OUT / "base-results.json").read_text(encoding="utf-8"))
+    if not base_result.get("parity_reproduced"):
+        raise RuntimeError("base result does not carry successful parity")
+    expected_shape, ranking = select_extension_shape(sweep, base_result["runs"])
+    if expected_shape != base_result["extension_shape"]:
+        raise RuntimeError("extension shape selection drifted")
+    progress = [0]
+    run = run_schedule(
+        sweep, data, expected_shape, HIGHER_LR, MAX_UPDATES, progress,
+        len(data.anchors) * MAX_UPDATES,
+    )
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "higher", "parity_reproduced": True,
+                   "extension_shape": expected_shape, "extension_ranking": ranking,
+                   "run": run})
+    atomic_json(OUT / "higher-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "higher-results.json"),
+                      "extension_shape": expected_shape}), flush=True)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("parity", "base", "higher"))
+    args = parser.parse_args()
+    OUT.mkdir(parents=True, exist_ok=True)
+    verify_runtime()
+    initial_load = guard_load()
+    sweep = import_sweep()
+    verify_runtime()
+    data = sweep.load_c3()
+    before, inputs_before = source_state(sweep, data)
+    started = time.perf_counter()
+    if args.mode == "parity":
+        parity(sweep, data, started, initial_load, before, inputs_before)
+    elif args.mode == "base":
+        base(sweep, data, started, initial_load, before, inputs_before)
+    else:
+        higher(sweep, data, started, initial_load, before, inputs_before)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/.scratch/decay-schedule/spec.md b/.scratch/decay-schedule/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..c1e9562db0b10b3e97dd58216f34fdc84eec34cb
--- /dev/null
+++ b/.scratch/decay-schedule/spec.md
@@ -0,0 +1,64 @@
+# DECAY schedule diagnostic protocol — 2026-09-10
+
+`DIAGNOSTIC_NOT_CLAIM`. This protocol is fixed before any fit in this
+workspace. The diagnostic computes no EE quantity and makes no selection on
+EE or on predictive-metric levels.
+
+## Fixed source and design
+
+- Import and reuse LRSWEEP's runner, rule, and results without modification:
+  `/home/sat/mcrl-v025-c1c2-ws/.scratch/lr-convergence-sweep/run_sweep.py`,
+  `spec.md`, and `results.json`.
+- C3 only; the twelve filenames hard-coded by LRSWEEP; identical LOAO folds;
+  model seed `V025_LEARNER/seed/1` (`6407676579069309528`); sealed `(64,64)`
+  ReLU head and every sealed Adam literal except the scheduled learning rate;
+  deterministic full-batch aggregation; 4,000-update cap; cadence 100.
+- Before schedule fitting, reproduce HORIZON Arm A's constant-`1e-3`
+  trajectory at updates 0, 100, ..., 500. Stop on any inequality.
+- At every destination cadence `k`, apply LRSWEEP's unchanged rule to
+  `k-100 -> k`: objective relative absolute motion `<=0.01`; held-out level
+  R2 absolute motion `<=0.01`; ordering absolute motion `<=0.005`; top-1
+  absolute motion `<=0.005`. All four and finite state are required.
+
+## Schedule semantics fixed before fitting
+
+Let optimizer updates be one-indexed as `k=1,...,4000`. Smooth schedules use
+`t=k-1`, so the first update uses the declared starting rate.
+
+1. `cosine`: `lr(t)=lr0*(1+cos(pi*t/4000))/2`; the schedule endpoint after
+   update 4,000 is exactly zero (the last applied update rate is the value at
+   `t=3999`).
+2. `step`: updates 1–2,000 use `lr0`; updates 2,001–3,000 use `0.1*lr0`;
+   updates 3,001–4,000 use `0.01*lr0`.
+3. `inverse_time_tau1000`: `lr(t)=lr0/(1+t/1000)`, so `tau=1000` updates.
+4. `plateau_n3`: start at `lr0`. At each cadence, compute the aggregate LOAO
+   objective's absolute relative motion. The first motion establishes the
+   best value. A later strictly smaller motion is an improvement and resets
+   the non-improvement count. After `n=3` consecutive non-improving cadences,
+   multiply the rate by 0.5 for subsequent updates, reset the count, and use
+   the triggering motion as the new post-decay best. Decisions occur only
+   after the checkpoint, never retroactively.
+
+The four base schedules start at `lr0=1e-3`. One extension starts at `3e-3`,
+the next higher rate already present in LRSWEEP's fixed grid. Its shape is
+chosen from the four base runs by this diagnostic-only ordering:
+
+1. schedules that become admissible precede schedules that do not;
+2. among admissible schedules, earlier first-admissible update precedes later;
+3. otherwise, smaller maximum cap tolerance ratio across the four unchanged
+   rule components precedes larger;
+4. exact ties use the declared order above.
+
+This ordering exists only to assign the mandated higher-start extension. It
+does not select a production schedule and does not use predictive levels.
+
+## Resources and scope
+
+- One Python process, `/home/sat/mcrl-leo-handover/.venv/bin/python` only,
+  niceness 18, all named BLAS thread variables one, address-space limit one
+  byte below 3 GiB, and measured peak RSS below 3 GiB.
+- Print progress as `update k/N` and print peak RSS. Pause if one-minute load
+  exceeds 30 at a cadence boundary.
+- Read only LRSWEEP's twelve named development anchors. Do not discover or
+  read evaluation-only claim dates. Do not compute production, policy,
+  acceptance, or EE quantities.

diff --git a/.scratch/decay-schedule/run_decay.py b/.scratch/decay-schedule/run_decay.py
new file mode 100644
index 0000000000000000000000000000000000000000..2534131be32880b4288e433a88f18ce5bc997b51
--- /dev/null
+++ b/.scratch/decay-schedule/run_decay.py
@@ -0,0 +1,442 @@
+#!/usr/bin/env python3
+"""C3 decay-schedule convergence diagnostic; computes no EE quantity."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+ROOT = Path("/home/sat/mcrl-v025-decay-ws")
+OUT = ROOT / ".scratch/decay-schedule"
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2-ws")
+SOURCE_RUNNER = SOURCE_ROOT / ".scratch/lr-convergence-sweep/run_sweep.py"
+SOURCE_SPEC = SOURCE_ROOT / ".scratch/lr-convergence-sweep/spec.md"
+SOURCE_RESULTS = SOURCE_ROOT / ".scratch/lr-convergence-sweep/results.json"
+SOURCE_LEARNER = SOURCE_ROOT / "src/mcrl/stagec_v025/learner.py"
+HORIZON_RESULTS = Path("/home/sat/mcrl-v025-horizon-ws/.scratch/horizon-lever/results.json")
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+RSS_LIMIT_BYTES = 3 * 1024**3 - 1
+MAX_UPDATES = 4000
+CADENCE = 100
+BASE_LR = 1e-3
+HIGHER_LR = 3e-3
+TAU = 1000
+PLATEAU_N = 3
+SCHEDULE_ORDER = ("cosine", "step", "inverse_time_tau1000", "plateau_n3")
+EXPECTED_HASHES = {
+    str(SOURCE_RUNNER): "dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6",
+    str(SOURCE_SPEC): "0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19",
+    str(SOURCE_RESULTS): "9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861",
+    str(SOURCE_LEARNER): "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+    str(HORIZON_RESULTS): "b05fed675d137b95cefffcad745fda1a67cdffc816f3ba3d7f43b08cd0ff7c62",
+}
+
+
+class LoadPause(RuntimeError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_json(path: Path, payload: object) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def verify_runtime() -> None:
+    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) != 18:
+        raise RuntimeError(f"process niceness is not 18: {os.getpriority(os.PRIO_PROCESS, 0)}")
+    actual = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    if actual != EXPECTED_HASHES:
+        raise RuntimeError(f"sealed source hash mismatch: {actual}")
+
+
+def load_average() -> float:
+    return float(Path("/proc/loadavg").read_text(encoding="ascii").split()[0])
+
+
+def guard_load() -> float:
+    value = load_average()
+    if value > 30.0:
+        raise LoadPause(f"one-minute load average {value:.2f} exceeds 30")
+    return value
+
+
+def import_sweep():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    spec = importlib.util.spec_from_file_location("sealed_lr_sweep", SOURCE_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load sealed LRSWEEP harness")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+    return module
+
+
+def checkpoint(sweep, heads, data):
+    predictions = []
+    objectives = []
+    norms = []
+    for fold_index, (head, test) in enumerate(zip(heads, data.anchors, strict=True)):
+        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        loss, count = sweep.c3_loss(head, train)
+        if not math.isfinite(loss) or not sweep.parameters_finite(head):
+            raise RuntimeError(f"non-finite state at fold {fold_index + 1}")
+        prediction = sweep.np.zeros_like(test.truth)
+        prediction[test.train_indices] = head._forward(test.x)[0]
+        predictions.append(prediction)
+        objectives.append((loss, count))
+        norms.append(sweep.parameter_norm(head))
+    weighted = sum(value * count for value, count in objectives) / sum(count for _, count in objectives)
+    return {
+        "training_objective": float(weighted),
+        "held_out": sweep.c3_metric(predictions, data.anchors),
+        "parameter_l2": sweep.summarize(norms),
+    }
+
+
+def stability(sweep, left: dict[str, object], right: dict[str, object]) -> dict[str, object]:
+    changes = {
+        "objective_relative_abs": abs(right["training_objective"] - left["training_objective"])
+        / max(abs(left["training_objective"]), 1e-12),
+        "r2_absolute": abs(right["held_out"]["r2"] - left["held_out"]["r2"]),
+        "pairwise_ordering_absolute": abs(
+            right["held_out"]["pairwise_ordering"] - left["held_out"]["pairwise_ordering"]
+        ),
+        "top1_accuracy_absolute": abs(
+            right["held_out"]["top1_accuracy"] - left["held_out"]["top1_accuracy"]
+        ),
+    }
+    passed = {
+        "objective": changes["objective_relative_abs"] <= sweep.STABILITY_TOLERANCES["objective_relative"],
+        "r2": changes["r2_absolute"] <= sweep.STABILITY_TOLERANCES["r2_absolute"],
+        "pairwise_ordering": changes["pairwise_ordering_absolute"]
+        <= sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        "top1_accuracy": changes["top1_accuracy_absolute"]
+        <= sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    }
+    return {"changes": changes, "passed": passed, "admissible": all(passed.values())}
+
+
+def scheduled_lr(name: str, start_lr: float, update: int, plateau_lr: float) -> float:
+    t = update - 1
+    if name == "constant":
+        return start_lr
+    if name == "cosine":
+        return start_lr * (1.0 + math.cos(math.pi * t / MAX_UPDATES)) / 2.0
+    if name == "step":
+        return start_lr * (1.0 if update <= 2000 else 0.1 if update <= 3000 else 0.01)
+    if name == "inverse_time_tau1000":
+        return start_lr / (1.0 + t / TAU)
+    if name == "plateau_n3":
+        return plateau_lr
+    raise ValueError(name)
+
+
+def run_schedule(sweep, data, name: str, start_lr: float, maximum_updates: int,
+                 progress: list[int], total_work: int) -> dict[str, object]:
+    literal = dict(sweep.LEGACY_TRAINER_LITERALS["C3"])
+    literal["learning_rate"] = start_lr
+    heads = [
+        sweep.AdamMLPHead.create(
+            anchor.x.shape[1], literal, sweep.np.random.default_rng(sweep.SEED)
+        )
+        for anchor in data.anchors
+    ]
+    trains = [
+        tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        for fold_index in range(len(data.anchors))
+    ]
+    trajectory = {"0": checkpoint(sweep, heads, data)}
+    checks = {}
+    lr_trace = {"0": start_lr}
+    first_admissible = None
+    cadence_total = []
+    cadence_update = []
+    cadence_checkpoint = []
+    cumulative_total = []
+    running_total = 0.0
+    observed_load = [guard_load()]
+    plateau_lr = start_lr
+    plateau_best = None
+    plateau_stale = 0
+    plateau_events = []
+    started = time.perf_counter()
+
+    for cadence_end in range(CADENCE, maximum_updates + 1, CADENCE):
+        cadence_started = time.perf_counter()
+        update_elapsed = 0.0
+        for update in range(cadence_end - CADENCE + 1, cadence_end + 1):
+            lr = scheduled_lr(name, start_lr, update, plateau_lr)
+            for fold_index, head in enumerate(heads):
+                head.learning_rate = lr
+                update_started = time.perf_counter()
+                with sweep.np.errstate(all="ignore"):
+                    loss_before = sweep.c3_update(head, trains[fold_index])
+                update_elapsed += time.perf_counter() - update_started
+                if not math.isfinite(loss_before) or not sweep.parameters_finite(head):
+                    raise RuntimeError(
+                        f"schedule {name} lr {start_lr} fold {fold_index + 1} "
+                        f"diverged at update {update}"
+                    )
+        checkpoint_started = time.perf_counter()
+        point = checkpoint(sweep, heads, data)
+        checkpoint_elapsed = time.perf_counter() - checkpoint_started
+        trajectory[str(cadence_end)] = point
+        check = stability(sweep, trajectory[str(cadence_end - CADENCE)], point)
+        checks[str(cadence_end)] = check
+        if first_admissible is None and check["admissible"]:
+            first_admissible = cadence_end
+
+        if name == "plateau_n3":
+            motion = check["changes"]["objective_relative_abs"]
+            if plateau_best is None or motion < plateau_best:
+                plateau_best = motion
+                plateau_stale = 0
+            else:
+                plateau_stale += 1
+                if plateau_stale >= PLATEAU_N:
+                    old_lr = plateau_lr
+                    plateau_lr *= 0.5
+                    plateau_events.append({
+                        "after_update": cadence_end, "old_lr": old_lr,
+                        "new_lr": plateau_lr, "trigger_motion": motion,
+                    })
+                    plateau_best = motion
+                    plateau_stale = 0
+        lr_trace[str(cadence_end)] = (
+            0.0 if name == "cosine" and cadence_end == MAX_UPDATES
+            else plateau_lr if name == "plateau_n3"
+            else scheduled_lr(name, start_lr, cadence_end, plateau_lr)
+        )
+        total_elapsed = time.perf_counter() - cadence_started
+        cadence_total.append(total_elapsed)
+        cadence_update.append(update_elapsed)
+        cadence_checkpoint.append(checkpoint_elapsed)
+        running_total += total_elapsed
+        cumulative_total.append(running_total)
+        progress[0] += CADENCE * len(heads)
+        current_load = load_average()
+        observed_load.append(current_load)
+        print(
+            f"update {progress[0]}/{total_work} schedule={name} start_lr={start_lr:g} "
+            f"destination={cadence_end}/{maximum_updates} load1={current_load:.2f}",
+            flush=True,
+        )
+        if current_load > 30.0:
+            raise LoadPause(f"one-minute load average {current_load:.2f} exceeds 30")
+
+    return {
+        "schedule": name,
+        "starting_learning_rate": start_lr,
+        "maximum_updates": maximum_updates,
+        "trajectory": trajectory,
+        "cadence_checks": checks,
+        "first_admissible_update": first_admissible,
+        "learning_rate_at_cadence": lr_trace,
+        "plateau_events": plateau_events,
+        "wall_s": time.perf_counter() - started,
+        "timing": {
+            "total_s_per_100_updates_across_12_loao_folds": cadence_total,
+            "update_only_s_per_100_updates_across_12_loao_folds": cadence_update,
+            "checkpoint_s_per_100_updates_across_12_loao_folds": cadence_checkpoint,
+            "cumulative_total_s_across_12_loao_folds": cumulative_total,
+            "mean_total_s_per_100_updates_across_12_loao_folds": sum(cadence_total) / len(cadence_total),
+            "mean_update_only_s_per_100_updates_across_12_loao_folds": sum(cadence_update) / len(cadence_update),
+        },
+        "maximum_observed_load1": max(observed_load),
+    }
+
+
+def source_state(sweep, data):
+    fixed = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    inputs = {str(anchor.path): file_sha256(anchor.path) for anchor in data.anchors}
+    return fixed, inputs
+
+
+def common_result(sweep, data, started, initial_load, before, inputs_before):
+    after, inputs_after = source_state(sweep, data)
+    changed = [path for path in (*before, *inputs_before)
+               if (before | inputs_before)[path] != (after | inputs_after)[path]]
+    peak_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    if peak_kb * 1024 >= 3 * 1024**3:
+        raise RuntimeError(f"peak RSS cap exceeded: {peak_kb} KiB")
+    return {
+        "schema": "mcrl-v025-decay-schedule-diagnostic-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "route": "C3",
+        "model_seed_domain": "V025_LEARNER/seed/1",
+        "model_seed": sweep.SEED,
+        "cadence_updates": CADENCE,
+        "stability_tolerances": sweep.STABILITY_TOLERANCES,
+        "inventory": {
+            "anchors": len(data.anchors),
+            "rows": sum(anchor.truth.size for anchor in data.anchors),
+            "trainable_rows": sum(anchor.train_indices.size for anchor in data.anchors),
+            "input_files": [str(anchor.path) for anchor in data.anchors],
+        },
+        "schedule_parameters": {"tau": TAU, "plateau_n": PLATEAU_N},
+        "scope": {
+            "diagnostic_not_claim": True, "ee_quantities_computed": False,
+            "selection_on_ee": False, "selection_on_predictive_levels": False,
+            "metrics_use": "convergence diagnostics only; never evidence about EE",
+        },
+        "resource_policy": {
+            "python_processes": 1, "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "blas_threads": 1, "rlimit_as_bytes": resource.getrlimit(resource.RLIMIT_AS)[0],
+            "peak_rss_kb": peak_kb, "initial_load1": initial_load,
+            "final_load1": load_average(), "elapsed_wall_s": time.perf_counter() - started,
+        },
+        "source_sha256_before": before, "source_sha256_after": after,
+        "c3_input_sha256_before": inputs_before, "c3_input_sha256_after": inputs_after,
+        "changed_inputs": changed,
+    }
+
+
+def original_c3_cell():
+    payload = json.loads(SOURCE_RESULTS.read_text(encoding="utf-8"))
+    return next(cell for cell in payload["cells"]
+                if cell["route"] == "C3" and cell["learning_rate"] == BASE_LR)
+
+
+def parity(sweep, data, started, initial_load, before, inputs_before):
+    progress = [0]
+    run = run_schedule(
+        sweep, data, "constant", BASE_LR, 500, progress,
+        len(data.anchors) * 500,
+    )
+    horizon = json.loads(HORIZON_RESULTS.read_text(encoding="utf-8"))["arms"]["A"]
+    lrsweep = original_c3_cell()
+    comparisons = {}
+    for update in range(0, 501, CADENCE):
+        key = str(update)
+        fields = ("training_objective", "held_out")
+        comparisons[key] = {
+            "horizon_exact": all(run["trajectory"][key][field] == horizon["trajectory"][key][field]
+                                 for field in fields),
+            "lrsweep_exact": all(run["trajectory"][key][field] == lrsweep["trajectory"][key][field]
+                                 for field in fields),
+        }
+    reproduced = all(all(value.values()) for value in comparisons.values())
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "parity", "run": run, "comparisons": comparisons,
+                   "parity_reproduced": reproduced})
+    atomic_json(OUT / "parity.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "parity.json"),
+                      "parity_reproduced": reproduced}), flush=True)
+    if not reproduced:
+        raise RuntimeError("HORIZON Arm A parity failed; stop before schedules")
+
+
+def cap_tolerance_score(sweep, run):
+    check = run["cadence_checks"][str(MAX_UPDATES)]
+    changes = check["changes"]
+    ratios = (
+        changes["objective_relative_abs"] / sweep.STABILITY_TOLERANCES["objective_relative"],
+        changes["r2_absolute"] / sweep.STABILITY_TOLERANCES["r2_absolute"],
+        changes["pairwise_ordering_absolute"] / sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        changes["top1_accuracy_absolute"] / sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    )
+    return max(ratios)
+
+
+def select_extension_shape(sweep, runs):
+    ranked = []
+    for index, name in enumerate(SCHEDULE_ORDER):
+        run = runs[name]
+        first = run["first_admissible_update"]
+        key = (0, first, index) if first is not None else (1, cap_tolerance_score(sweep, run), index)
+        ranked.append((key, name))
+    ranked.sort()
+    return ranked[0][1], [{"schedule": name, "ranking_key": list(key)} for key, name in ranked]
+
+
+def base(sweep, data, started, initial_load, before, inputs_before):
+    parity_result = json.loads((OUT / "parity.json").read_text(encoding="utf-8"))
+    if not parity_result.get("parity_reproduced"):
+        raise RuntimeError("verified parity artifact is absent or failed")
+    progress = [0]
+    total = len(SCHEDULE_ORDER) * len(data.anchors) * MAX_UPDATES
+    runs = {name: run_schedule(sweep, data, name, BASE_LR, MAX_UPDATES, progress, total)
+            for name in SCHEDULE_ORDER}
+    shape, ranking = select_extension_shape(sweep, runs)
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "base", "parity_reproduced": True, "runs": runs,
+                   "extension_shape": shape, "extension_ranking": ranking})
+    atomic_json(OUT / "base-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "base-results.json"),
+                      "extension_shape": shape}), flush=True)
+
+
+def higher(sweep, data, started, initial_load, before, inputs_before):
+    base_result = json.loads((OUT / "base-results.json").read_text(encoding="utf-8"))
+    if not base_result.get("parity_reproduced"):
+        raise RuntimeError("base result does not carry successful parity")
+    expected_shape, ranking = select_extension_shape(sweep, base_result["runs"])
+    if expected_shape != base_result["extension_shape"]:
+        raise RuntimeError("extension shape selection drifted")
+    progress = [0]
+    run = run_schedule(
+        sweep, data, expected_shape, HIGHER_LR, MAX_UPDATES, progress,
+        len(data.anchors) * MAX_UPDATES,
+    )
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "higher", "parity_reproduced": True,
+                   "extension_shape": expected_shape, "extension_ranking": ranking,
+                   "run": run})
+    atomic_json(OUT / "higher-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "higher-results.json"),
+                      "extension_shape": expected_shape}), flush=True)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("parity", "base", "higher"))
+    args = parser.parse_args()
+    OUT.mkdir(parents=True, exist_ok=True)
+    verify_runtime()
+    initial_load = guard_load()
+    sweep = import_sweep()
+    verify_runtime()
+    data = sweep.load_c3()
+    before, inputs_before = source_state(sweep, data)
+    started = time.perf_counter()
+    if args.mode == "parity":
+        parity(sweep, data, started, initial_load, before, inputs_before)
+    elif args.mode == "base":
+        base(sweep, data, started, initial_load, before, inputs_before)
+    else:
+        higher(sweep, data, started, initial_load, before, inputs_before)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/.scratch/decay-schedule/spec.md b/.scratch/decay-schedule/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..c1e9562db0b10b3e97dd58216f34fdc84eec34cb
--- /dev/null
+++ b/.scratch/decay-schedule/spec.md
@@ -0,0 +1,64 @@
+# DECAY schedule diagnostic protocol — 2026-09-10
+
+`DIAGNOSTIC_NOT_CLAIM`. This protocol is fixed before any fit in this
+workspace. The diagnostic computes no EE quantity and makes no selection on
+EE or on predictive-metric levels.
+
+## Fixed source and design
+
+- Import and reuse LRSWEEP's runner, rule, and results without modification:
+  `/home/sat/mcrl-v025-c1c2-ws/.scratch/lr-convergence-sweep/run_sweep.py`,
+  `spec.md`, and `results.json`.
+- C3 only; the twelve filenames hard-coded by LRSWEEP; identical LOAO folds;
+  model seed `V025_LEARNER/seed/1` (`6407676579069309528`); sealed `(64,64)`
+  ReLU head and every sealed Adam literal except the scheduled learning rate;
+  deterministic full-batch aggregation; 4,000-update cap; cadence 100.
+- Before schedule fitting, reproduce HORIZON Arm A's constant-`1e-3`
+  trajectory at updates 0, 100, ..., 500. Stop on any inequality.
+- At every destination cadence `k`, apply LRSWEEP's unchanged rule to
+  `k-100 -> k`: objective relative absolute motion `<=0.01`; held-out level
+  R2 absolute motion `<=0.01`; ordering absolute motion `<=0.005`; top-1
+  absolute motion `<=0.005`. All four and finite state are required.
+
+## Schedule semantics fixed before fitting
+
+Let optimizer updates be one-indexed as `k=1,...,4000`. Smooth schedules use
+`t=k-1`, so the first update uses the declared starting rate.
+
+1. `cosine`: `lr(t)=lr0*(1+cos(pi*t/4000))/2`; the schedule endpoint after
+   update 4,000 is exactly zero (the last applied update rate is the value at
+   `t=3999`).
+2. `step`: updates 1–2,000 use `lr0`; updates 2,001–3,000 use `0.1*lr0`;
+   updates 3,001–4,000 use `0.01*lr0`.
+3. `inverse_time_tau1000`: `lr(t)=lr0/(1+t/1000)`, so `tau=1000` updates.
+4. `plateau_n3`: start at `lr0`. At each cadence, compute the aggregate LOAO
+   objective's absolute relative motion. The first motion establishes the
+   best value. A later strictly smaller motion is an improvement and resets
+   the non-improvement count. After `n=3` consecutive non-improving cadences,
+   multiply the rate by 0.5 for subsequent updates, reset the count, and use
+   the triggering motion as the new post-decay best. Decisions occur only
+   after the checkpoint, never retroactively.
+
+The four base schedules start at `lr0=1e-3`. One extension starts at `3e-3`,
+the next higher rate already present in LRSWEEP's fixed grid. Its shape is
+chosen from the four base runs by this diagnostic-only ordering:
+
+1. schedules that become admissible precede schedules that do not;
+2. among admissible schedules, earlier first-admissible update precedes later;
+3. otherwise, smaller maximum cap tolerance ratio across the four unchanged
+   rule components precedes larger;
+4. exact ties use the declared order above.
+
+This ordering exists only to assign the mandated higher-start extension. It
+does not select a production schedule and does not use predictive levels.
+
+## Resources and scope
+
+- One Python process, `/home/sat/mcrl-leo-handover/.venv/bin/python` only,
+  niceness 18, all named BLAS thread variables one, address-space limit one
+  byte below 3 GiB, and measured peak RSS below 3 GiB.
+- Print progress as `update k/N` and print peak RSS. Pause if one-minute load
+  exceeds 30 at a cadence boundary.
+- Read only LRSWEEP's twelve named development anchors. Do not discover or
+  read evaluation-only claim dates. Do not compute production, policy,
+  acceptance, or EE quantities.

diff --git a/.scratch/decay-schedule/run_decay.py b/.scratch/decay-schedule/run_decay.py
new file mode 100644
index 0000000000000000000000000000000000000000..2534131be32880b4288e433a88f18ce5bc997b51
--- /dev/null
+++ b/.scratch/decay-schedule/run_decay.py
@@ -0,0 +1,442 @@
+#!/usr/bin/env python3
+"""C3 decay-schedule convergence diagnostic; computes no EE quantity."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+ROOT = Path("/home/sat/mcrl-v025-decay-ws")
+OUT = ROOT / ".scratch/decay-schedule"
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2-ws")
+SOURCE_RUNNER = SOURCE_ROOT / ".scratch/lr-convergence-sweep/run_sweep.py"
+SOURCE_SPEC = SOURCE_ROOT / ".scratch/lr-convergence-sweep/spec.md"
+SOURCE_RESULTS = SOURCE_ROOT / ".scratch/lr-convergence-sweep/results.json"
+SOURCE_LEARNER = SOURCE_ROOT / "src/mcrl/stagec_v025/learner.py"
+HORIZON_RESULTS = Path("/home/sat/mcrl-v025-horizon-ws/.scratch/horizon-lever/results.json")
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+RSS_LIMIT_BYTES = 3 * 1024**3 - 1
+MAX_UPDATES = 4000
+CADENCE = 100
+BASE_LR = 1e-3
+HIGHER_LR = 3e-3
+TAU = 1000
+PLATEAU_N = 3
+SCHEDULE_ORDER = ("cosine", "step", "inverse_time_tau1000", "plateau_n3")
+EXPECTED_HASHES = {
+    str(SOURCE_RUNNER): "dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6",
+    str(SOURCE_SPEC): "0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19",
+    str(SOURCE_RESULTS): "9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861",
+    str(SOURCE_LEARNER): "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+    str(HORIZON_RESULTS): "b05fed675d137b95cefffcad745fda1a67cdffc816f3ba3d7f43b08cd0ff7c62",
+}
+
+
+class LoadPause(RuntimeError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_json(path: Path, payload: object) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def verify_runtime() -> None:
+    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) != 18:
+        raise RuntimeError(f"process niceness is not 18: {os.getpriority(os.PRIO_PROCESS, 0)}")
+    actual = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    if actual != EXPECTED_HASHES:
+        raise RuntimeError(f"sealed source hash mismatch: {actual}")
+
+
+def load_average() -> float:
+    return float(Path("/proc/loadavg").read_text(encoding="ascii").split()[0])
+
+
+def guard_load() -> float:
+    value = load_average()
+    if value > 30.0:
+        raise LoadPause(f"one-minute load average {value:.2f} exceeds 30")
+    return value
+
+
+def import_sweep():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    spec = importlib.util.spec_from_file_location("sealed_lr_sweep", SOURCE_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load sealed LRSWEEP harness")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+    return module
+
+
+def checkpoint(sweep, heads, data):
+    predictions = []
+    objectives = []
+    norms = []
+    for fold_index, (head, test) in enumerate(zip(heads, data.anchors, strict=True)):
+        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        loss, count = sweep.c3_loss(head, train)
+        if not math.isfinite(loss) or not sweep.parameters_finite(head):
+            raise RuntimeError(f"non-finite state at fold {fold_index + 1}")
+        prediction = sweep.np.zeros_like(test.truth)
+        prediction[test.train_indices] = head._forward(test.x)[0]
+        predictions.append(prediction)
+        objectives.append((loss, count))
+        norms.append(sweep.parameter_norm(head))
+    weighted = sum(value * count for value, count in objectives) / sum(count for _, count in objectives)
+    return {
+        "training_objective": float(weighted),
+        "held_out": sweep.c3_metric(predictions, data.anchors),
+        "parameter_l2": sweep.summarize(norms),
+    }
+
+
+def stability(sweep, left: dict[str, object], right: dict[str, object]) -> dict[str, object]:
+    changes = {
+        "objective_relative_abs": abs(right["training_objective"] - left["training_objective"])
+        / max(abs(left["training_objective"]), 1e-12),
+        "r2_absolute": abs(right["held_out"]["r2"] - left["held_out"]["r2"]),
+        "pairwise_ordering_absolute": abs(
+            right["held_out"]["pairwise_ordering"] - left["held_out"]["pairwise_ordering"]
+        ),
+        "top1_accuracy_absolute": abs(
+            right["held_out"]["top1_accuracy"] - left["held_out"]["top1_accuracy"]
+        ),
+    }
+    passed = {
+        "objective": changes["objective_relative_abs"] <= sweep.STABILITY_TOLERANCES["objective_relative"],
+        "r2": changes["r2_absolute"] <= sweep.STABILITY_TOLERANCES["r2_absolute"],
+        "pairwise_ordering": changes["pairwise_ordering_absolute"]
+        <= sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        "top1_accuracy": changes["top1_accuracy_absolute"]
+        <= sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    }
+    return {"changes": changes, "passed": passed, "admissible": all(passed.values())}
+
+
+def scheduled_lr(name: str, start_lr: float, update: int, plateau_lr: float) -> float:
+    t = update - 1
+    if name == "constant":
+        return start_lr
+    if name == "cosine":
+        return start_lr * (1.0 + math.cos(math.pi * t / MAX_UPDATES)) / 2.0
+    if name == "step":
+        return start_lr * (1.0 if update <= 2000 else 0.1 if update <= 3000 else 0.01)
+    if name == "inverse_time_tau1000":
+        return start_lr / (1.0 + t / TAU)
+    if name == "plateau_n3":
+        return plateau_lr
+    raise ValueError(name)
+
+
+def run_schedule(sweep, data, name: str, start_lr: float, maximum_updates: int,
+                 progress: list[int], total_work: int) -> dict[str, object]:
+    literal = dict(sweep.LEGACY_TRAINER_LITERALS["C3"])
+    literal["learning_rate"] = start_lr
+    heads = [
+        sweep.AdamMLPHead.create(
+            anchor.x.shape[1], literal, sweep.np.random.default_rng(sweep.SEED)
+        )
+        for anchor in data.anchors
+    ]
+    trains = [
+        tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        for fold_index in range(len(data.anchors))
+    ]
+    trajectory = {"0": checkpoint(sweep, heads, data)}
+    checks = {}
+    lr_trace = {"0": start_lr}
+    first_admissible = None
+    cadence_total = []
+    cadence_update = []
+    cadence_checkpoint = []
+    cumulative_total = []
+    running_total = 0.0
+    observed_load = [guard_load()]
+    plateau_lr = start_lr
+    plateau_best = None
+    plateau_stale = 0
+    plateau_events = []
+    started = time.perf_counter()
+
+    for cadence_end in range(CADENCE, maximum_updates + 1, CADENCE):
+        cadence_started = time.perf_counter()
+        update_elapsed = 0.0
+        for update in range(cadence_end - CADENCE + 1, cadence_end + 1):
+            lr = scheduled_lr(name, start_lr, update, plateau_lr)
+            for fold_index, head in enumerate(heads):
+                head.learning_rate = lr
+                update_started = time.perf_counter()
+                with sweep.np.errstate(all="ignore"):
+                    loss_before = sweep.c3_update(head, trains[fold_index])
+                update_elapsed += time.perf_counter() - update_started
+                if not math.isfinite(loss_before) or not sweep.parameters_finite(head):
+                    raise RuntimeError(
+                        f"schedule {name} lr {start_lr} fold {fold_index + 1} "
+                        f"diverged at update {update}"
+                    )
+        checkpoint_started = time.perf_counter()
+        point = checkpoint(sweep, heads, data)
+        checkpoint_elapsed = time.perf_counter() - checkpoint_started
+        trajectory[str(cadence_end)] = point
+        check = stability(sweep, trajectory[str(cadence_end - CADENCE)], point)
+        checks[str(cadence_end)] = check
+        if first_admissible is None and check["admissible"]:
+            first_admissible = cadence_end
+
+        if name == "plateau_n3":
+            motion = check["changes"]["objective_relative_abs"]
+            if plateau_best is None or motion < plateau_best:
+                plateau_best = motion
+                plateau_stale = 0
+            else:
+                plateau_stale += 1
+                if plateau_stale >= PLATEAU_N:
+                    old_lr = plateau_lr
+                    plateau_lr *= 0.5
+                    plateau_events.append({
+                        "after_update": cadence_end, "old_lr": old_lr,
+                        "new_lr": plateau_lr, "trigger_motion": motion,
+                    })
+                    plateau_best = motion
+                    plateau_stale = 0
+        lr_trace[str(cadence_end)] = (
+            0.0 if name == "cosine" and cadence_end == MAX_UPDATES
+            else plateau_lr if name == "plateau_n3"
+            else scheduled_lr(name, start_lr, cadence_end, plateau_lr)
+        )
+        total_elapsed = time.perf_counter() - cadence_started
+        cadence_total.append(total_elapsed)
+        cadence_update.append(update_elapsed)
+        cadence_checkpoint.append(checkpoint_elapsed)
+        running_total += total_elapsed
+        cumulative_total.append(running_total)
+        progress[0] += CADENCE * len(heads)
+        current_load = load_average()
+        observed_load.append(current_load)
+        print(
+            f"update {progress[0]}/{total_work} schedule={name} start_lr={start_lr:g} "
+            f"destination={cadence_end}/{maximum_updates} load1={current_load:.2f}",
+            flush=True,
+        )
+        if current_load > 30.0:
+            raise LoadPause(f"one-minute load average {current_load:.2f} exceeds 30")
+
+    return {
+        "schedule": name,
+        "starting_learning_rate": start_lr,
+        "maximum_updates": maximum_updates,
+        "trajectory": trajectory,
+        "cadence_checks": checks,
+        "first_admissible_update": first_admissible,
+        "learning_rate_at_cadence": lr_trace,
+        "plateau_events": plateau_events,
+        "wall_s": time.perf_counter() - started,
+        "timing": {
+            "total_s_per_100_updates_across_12_loao_folds": cadence_total,
+            "update_only_s_per_100_updates_across_12_loao_folds": cadence_update,
+            "checkpoint_s_per_100_updates_across_12_loao_folds": cadence_checkpoint,
+            "cumulative_total_s_across_12_loao_folds": cumulative_total,
+            "mean_total_s_per_100_updates_across_12_loao_folds": sum(cadence_total) / len(cadence_total),
+            "mean_update_only_s_per_100_updates_across_12_loao_folds": sum(cadence_update) / len(cadence_update),
+        },
+        "maximum_observed_load1": max(observed_load),
+    }
+
+
+def source_state(sweep, data):
+    fixed = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    inputs = {str(anchor.path): file_sha256(anchor.path) for anchor in data.anchors}
+    return fixed, inputs
+
+
+def common_result(sweep, data, started, initial_load, before, inputs_before):
+    after, inputs_after = source_state(sweep, data)
+    changed = [path for path in (*before, *inputs_before)
+               if (before | inputs_before)[path] != (after | inputs_after)[path]]
+    peak_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    if peak_kb * 1024 >= 3 * 1024**3:
+        raise RuntimeError(f"peak RSS cap exceeded: {peak_kb} KiB")
+    return {
+        "schema": "mcrl-v025-decay-schedule-diagnostic-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "route": "C3",
+        "model_seed_domain": "V025_LEARNER/seed/1",
+        "model_seed": sweep.SEED,
+        "cadence_updates": CADENCE,
+        "stability_tolerances": sweep.STABILITY_TOLERANCES,
+        "inventory": {
+            "anchors": len(data.anchors),
+            "rows": sum(anchor.truth.size for anchor in data.anchors),
+            "trainable_rows": sum(anchor.train_indices.size for anchor in data.anchors),
+            "input_files": [str(anchor.path) for anchor in data.anchors],
+        },
+        "schedule_parameters": {"tau": TAU, "plateau_n": PLATEAU_N},
+        "scope": {
+            "diagnostic_not_claim": True, "ee_quantities_computed": False,
+            "selection_on_ee": False, "selection_on_predictive_levels": False,
+            "metrics_use": "convergence diagnostics only; never evidence about EE",
+        },
+        "resource_policy": {
+            "python_processes": 1, "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "blas_threads": 1, "rlimit_as_bytes": resource.getrlimit(resource.RLIMIT_AS)[0],
+            "peak_rss_kb": peak_kb, "initial_load1": initial_load,
+            "final_load1": load_average(), "elapsed_wall_s": time.perf_counter() - started,
+        },
+        "source_sha256_before": before, "source_sha256_after": after,
+        "c3_input_sha256_before": inputs_before, "c3_input_sha256_after": inputs_after,
+        "changed_inputs": changed,
+    }
+
+
+def original_c3_cell():
+    payload = json.loads(SOURCE_RESULTS.read_text(encoding="utf-8"))
+    return next(cell for cell in payload["cells"]
+                if cell["route"] == "C3" and cell["learning_rate"] == BASE_LR)
+
+
+def parity(sweep, data, started, initial_load, before, inputs_before):
+    progress = [0]
+    run = run_schedule(
+        sweep, data, "constant", BASE_LR, 500, progress,
+        len(data.anchors) * 500,
+    )
+    horizon = json.loads(HORIZON_RESULTS.read_text(encoding="utf-8"))["arms"]["A"]
+    lrsweep = original_c3_cell()
+    comparisons = {}
+    for update in range(0, 501, CADENCE):
+        key = str(update)
+        fields = ("training_objective", "held_out")
+        comparisons[key] = {
+            "horizon_exact": all(run["trajectory"][key][field] == horizon["trajectory"][key][field]
+                                 for field in fields),
+            "lrsweep_exact": all(run["trajectory"][key][field] == lrsweep["trajectory"][key][field]
+                                 for field in fields),
+        }
+    reproduced = all(all(value.values()) for value in comparisons.values())
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "parity", "run": run, "comparisons": comparisons,
+                   "parity_reproduced": reproduced})
+    atomic_json(OUT / "parity.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "parity.json"),
+                      "parity_reproduced": reproduced}), flush=True)
+    if not reproduced:
+        raise RuntimeError("HORIZON Arm A parity failed; stop before schedules")
+
+
+def cap_tolerance_score(sweep, run):
+    check = run["cadence_checks"][str(MAX_UPDATES)]
+    changes = check["changes"]
+    ratios = (
+        changes["objective_relative_abs"] / sweep.STABILITY_TOLERANCES["objective_relative"],
+        changes["r2_absolute"] / sweep.STABILITY_TOLERANCES["r2_absolute"],
+        changes["pairwise_ordering_absolute"] / sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        changes["top1_accuracy_absolute"] / sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    )
+    return max(ratios)
+
+
+def select_extension_shape(sweep, runs):
+    ranked = []
+    for index, name in enumerate(SCHEDULE_ORDER):
+        run = runs[name]
+        first = run["first_admissible_update"]
+        key = (0, first, index) if first is not None else (1, cap_tolerance_score(sweep, run), index)
+        ranked.append((key, name))
+    ranked.sort()
+    return ranked[0][1], [{"schedule": name, "ranking_key": list(key)} for key, name in ranked]
+
+
+def base(sweep, data, started, initial_load, before, inputs_before):
+    parity_result = json.loads((OUT / "parity.json").read_text(encoding="utf-8"))
+    if not parity_result.get("parity_reproduced"):
+        raise RuntimeError("verified parity artifact is absent or failed")
+    progress = [0]
+    total = len(SCHEDULE_ORDER) * len(data.anchors) * MAX_UPDATES
+    runs = {name: run_schedule(sweep, data, name, BASE_LR, MAX_UPDATES, progress, total)
+            for name in SCHEDULE_ORDER}
+    shape, ranking = select_extension_shape(sweep, runs)
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "base", "parity_reproduced": True, "runs": runs,
+                   "extension_shape": shape, "extension_ranking": ranking})
+    atomic_json(OUT / "base-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "base-results.json"),
+                      "extension_shape": shape}), flush=True)
+
+
+def higher(sweep, data, started, initial_load, before, inputs_before):
+    base_result = json.loads((OUT / "base-results.json").read_text(encoding="utf-8"))
+    if not base_result.get("parity_reproduced"):
+        raise RuntimeError("base result does not carry successful parity")
+    expected_shape, ranking = select_extension_shape(sweep, base_result["runs"])
+    if expected_shape != base_result["extension_shape"]:
+        raise RuntimeError("extension shape selection drifted")
+    progress = [0]
+    run = run_schedule(
+        sweep, data, expected_shape, HIGHER_LR, MAX_UPDATES, progress,
+        len(data.anchors) * MAX_UPDATES,
+    )
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "higher", "parity_reproduced": True,
+                   "extension_shape": expected_shape, "extension_ranking": ranking,
+                   "run": run})
+    atomic_json(OUT / "higher-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "higher-results.json"),
+                      "extension_shape": expected_shape}), flush=True)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("parity", "base", "higher"))
+    args = parser.parse_args()
+    OUT.mkdir(parents=True, exist_ok=True)
+    verify_runtime()
+    initial_load = guard_load()
+    sweep = import_sweep()
+    verify_runtime()
+    data = sweep.load_c3()
+    before, inputs_before = source_state(sweep, data)
+    started = time.perf_counter()
+    if args.mode == "parity":
+        parity(sweep, data, started, initial_load, before, inputs_before)
+    elif args.mode == "base":
+        base(sweep, data, started, initial_load, before, inputs_before)
+    else:
+        higher(sweep, data, started, initial_load, before, inputs_before)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/.scratch/decay-schedule/spec.md b/.scratch/decay-schedule/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..c1e9562db0b10b3e97dd58216f34fdc84eec34cb
--- /dev/null
+++ b/.scratch/decay-schedule/spec.md
@@ -0,0 +1,64 @@
+# DECAY schedule diagnostic protocol — 2026-09-10
+
+`DIAGNOSTIC_NOT_CLAIM`. This protocol is fixed before any fit in this
+workspace. The diagnostic computes no EE quantity and makes no selection on
+EE or on predictive-metric levels.
+
+## Fixed source and design
+
+- Import and reuse LRSWEEP's runner, rule, and results without modification:
+  `/home/sat/mcrl-v025-c1c2-ws/.scratch/lr-convergence-sweep/run_sweep.py`,
+  `spec.md`, and `results.json`.
+- C3 only; the twelve filenames hard-coded by LRSWEEP; identical LOAO folds;
+  model seed `V025_LEARNER/seed/1` (`6407676579069309528`); sealed `(64,64)`
+  ReLU head and every sealed Adam literal except the scheduled learning rate;
+  deterministic full-batch aggregation; 4,000-update cap; cadence 100.
+- Before schedule fitting, reproduce HORIZON Arm A's constant-`1e-3`
+  trajectory at updates 0, 100, ..., 500. Stop on any inequality.
+- At every destination cadence `k`, apply LRSWEEP's unchanged rule to
+  `k-100 -> k`: objective relative absolute motion `<=0.01`; held-out level
+  R2 absolute motion `<=0.01`; ordering absolute motion `<=0.005`; top-1
+  absolute motion `<=0.005`. All four and finite state are required.
+
+## Schedule semantics fixed before fitting
+
+Let optimizer updates be one-indexed as `k=1,...,4000`. Smooth schedules use
+`t=k-1`, so the first update uses the declared starting rate.
+
+1. `cosine`: `lr(t)=lr0*(1+cos(pi*t/4000))/2`; the schedule endpoint after
+   update 4,000 is exactly zero (the last applied update rate is the value at
+   `t=3999`).
+2. `step`: updates 1–2,000 use `lr0`; updates 2,001–3,000 use `0.1*lr0`;
+   updates 3,001–4,000 use `0.01*lr0`.
+3. `inverse_time_tau1000`: `lr(t)=lr0/(1+t/1000)`, so `tau=1000` updates.
+4. `plateau_n3`: start at `lr0`. At each cadence, compute the aggregate LOAO
+   objective's absolute relative motion. The first motion establishes the
+   best value. A later strictly smaller motion is an improvement and resets
+   the non-improvement count. After `n=3` consecutive non-improving cadences,
+   multiply the rate by 0.5 for subsequent updates, reset the count, and use
+   the triggering motion as the new post-decay best. Decisions occur only
+   after the checkpoint, never retroactively.
+
+The four base schedules start at `lr0=1e-3`. One extension starts at `3e-3`,
+the next higher rate already present in LRSWEEP's fixed grid. Its shape is
+chosen from the four base runs by this diagnostic-only ordering:
+
+1. schedules that become admissible precede schedules that do not;
+2. among admissible schedules, earlier first-admissible update precedes later;
+3. otherwise, smaller maximum cap tolerance ratio across the four unchanged
+   rule components precedes larger;
+4. exact ties use the declared order above.
+
+This ordering exists only to assign the mandated higher-start extension. It
+does not select a production schedule and does not use predictive levels.
+
+## Resources and scope
+
+- One Python process, `/home/sat/mcrl-leo-handover/.venv/bin/python` only,
+  niceness 18, all named BLAS thread variables one, address-space limit one
+  byte below 3 GiB, and measured peak RSS below 3 GiB.
+- Print progress as `update k/N` and print peak RSS. Pause if one-minute load
+  exceeds 30 at a cadence boundary.
+- Read only LRSWEEP's twelve named development anchors. Do not discover or
+  read evaluation-only claim dates. Do not compute production, policy,
+  acceptance, or EE quantities.

diff --git a/.scratch/decay-schedule/run_decay.py b/.scratch/decay-schedule/run_decay.py
new file mode 100644
index 0000000000000000000000000000000000000000..2534131be32880b4288e433a88f18ce5bc997b51
--- /dev/null
+++ b/.scratch/decay-schedule/run_decay.py
@@ -0,0 +1,442 @@
+#!/usr/bin/env python3
+"""C3 decay-schedule convergence diagnostic; computes no EE quantity."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+ROOT = Path("/home/sat/mcrl-v025-decay-ws")
+OUT = ROOT / ".scratch/decay-schedule"
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2-ws")
+SOURCE_RUNNER = SOURCE_ROOT / ".scratch/lr-convergence-sweep/run_sweep.py"
+SOURCE_SPEC = SOURCE_ROOT / ".scratch/lr-convergence-sweep/spec.md"
+SOURCE_RESULTS = SOURCE_ROOT / ".scratch/lr-convergence-sweep/results.json"
+SOURCE_LEARNER = SOURCE_ROOT / "src/mcrl/stagec_v025/learner.py"
+HORIZON_RESULTS = Path("/home/sat/mcrl-v025-horizon-ws/.scratch/horizon-lever/results.json")
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+RSS_LIMIT_BYTES = 3 * 1024**3 - 1
+MAX_UPDATES = 4000
+CADENCE = 100
+BASE_LR = 1e-3
+HIGHER_LR = 3e-3
+TAU = 1000
+PLATEAU_N = 3
+SCHEDULE_ORDER = ("cosine", "step", "inverse_time_tau1000", "plateau_n3")
+EXPECTED_HASHES = {
+    str(SOURCE_RUNNER): "dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6",
+    str(SOURCE_SPEC): "0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19",
+    str(SOURCE_RESULTS): "9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861",
+    str(SOURCE_LEARNER): "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+    str(HORIZON_RESULTS): "b05fed675d137b95cefffcad745fda1a67cdffc816f3ba3d7f43b08cd0ff7c62",
+}
+
+
+class LoadPause(RuntimeError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_json(path: Path, payload: object) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def verify_runtime() -> None:
+    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) != 18:
+        raise RuntimeError(f"process niceness is not 18: {os.getpriority(os.PRIO_PROCESS, 0)}")
+    actual = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    if actual != EXPECTED_HASHES:
+        raise RuntimeError(f"sealed source hash mismatch: {actual}")
+
+
+def load_average() -> float:
+    return float(Path("/proc/loadavg").read_text(encoding="ascii").split()[0])
+
+
+def guard_load() -> float:
+    value = load_average()
+    if value > 30.0:
+        raise LoadPause(f"one-minute load average {value:.2f} exceeds 30")
+    return value
+
+
+def import_sweep():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    spec = importlib.util.spec_from_file_location("sealed_lr_sweep", SOURCE_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load sealed LRSWEEP harness")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+    return module
+
+
+def checkpoint(sweep, heads, data):
+    predictions = []
+    objectives = []
+    norms = []
+    for fold_index, (head, test) in enumerate(zip(heads, data.anchors, strict=True)):
+        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        loss, count = sweep.c3_loss(head, train)
+        if not math.isfinite(loss) or not sweep.parameters_finite(head):
+            raise RuntimeError(f"non-finite state at fold {fold_index + 1}")
+        prediction = sweep.np.zeros_like(test.truth)
+        prediction[test.train_indices] = head._forward(test.x)[0]
+        predictions.append(prediction)
+        objectives.append((loss, count))
+        norms.append(sweep.parameter_norm(head))
+    weighted = sum(value * count for value, count in objectives) / sum(count for _, count in objectives)
+    return {
+        "training_objective": float(weighted),
+        "held_out": sweep.c3_metric(predictions, data.anchors),
+        "parameter_l2": sweep.summarize(norms),
+    }
+
+
+def stability(sweep, left: dict[str, object], right: dict[str, object]) -> dict[str, object]:
+    changes = {
+        "objective_relative_abs": abs(right["training_objective"] - left["training_objective"])
+        / max(abs(left["training_objective"]), 1e-12),
+        "r2_absolute": abs(right["held_out"]["r2"] - left["held_out"]["r2"]),
+        "pairwise_ordering_absolute": abs(
+            right["held_out"]["pairwise_ordering"] - left["held_out"]["pairwise_ordering"]
+        ),
+        "top1_accuracy_absolute": abs(
+            right["held_out"]["top1_accuracy"] - left["held_out"]["top1_accuracy"]
+        ),
+    }
+    passed = {
+        "objective": changes["objective_relative_abs"] <= sweep.STABILITY_TOLERANCES["objective_relative"],
+        "r2": changes["r2_absolute"] <= sweep.STABILITY_TOLERANCES["r2_absolute"],
+        "pairwise_ordering": changes["pairwise_ordering_absolute"]
+        <= sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        "top1_accuracy": changes["top1_accuracy_absolute"]
+        <= sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    }
+    return {"changes": changes, "passed": passed, "admissible": all(passed.values())}
+
+
+def scheduled_lr(name: str, start_lr: float, update: int, plateau_lr: float) -> float:
+    t = update - 1
+    if name == "constant":
+        return start_lr
+    if name == "cosine":
+        return start_lr * (1.0 + math.cos(math.pi * t / MAX_UPDATES)) / 2.0
+    if name == "step":
+        return start_lr * (1.0 if update <= 2000 else 0.1 if update <= 3000 else 0.01)
+    if name == "inverse_time_tau1000":
+        return start_lr / (1.0 + t / TAU)
+    if name == "plateau_n3":
+        return plateau_lr
+    raise ValueError(name)
+
+
+def run_schedule(sweep, data, name: str, start_lr: float, maximum_updates: int,
+                 progress: list[int], total_work: int) -> dict[str, object]:
+    literal = dict(sweep.LEGACY_TRAINER_LITERALS["C3"])
+    literal["learning_rate"] = start_lr
+    heads = [
+        sweep.AdamMLPHead.create(
+            anchor.x.shape[1], literal, sweep.np.random.default_rng(sweep.SEED)
+        )
+        for anchor in data.anchors
+    ]
+    trains = [
+        tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        for fold_index in range(len(data.anchors))
+    ]
+    trajectory = {"0": checkpoint(sweep, heads, data)}
+    checks = {}
+    lr_trace = {"0": start_lr}
+    first_admissible = None
+    cadence_total = []
+    cadence_update = []
+    cadence_checkpoint = []
+    cumulative_total = []
+    running_total = 0.0
+    observed_load = [guard_load()]
+    plateau_lr = start_lr
+    plateau_best = None
+    plateau_stale = 0
+    plateau_events = []
+    started = time.perf_counter()
+
+    for cadence_end in range(CADENCE, maximum_updates + 1, CADENCE):
+        cadence_started = time.perf_counter()
+        update_elapsed = 0.0
+        for update in range(cadence_end - CADENCE + 1, cadence_end + 1):
+            lr = scheduled_lr(name, start_lr, update, plateau_lr)
+            for fold_index, head in enumerate(heads):
+                head.learning_rate = lr
+                update_started = time.perf_counter()
+                with sweep.np.errstate(all="ignore"):
+                    loss_before = sweep.c3_update(head, trains[fold_index])
+                update_elapsed += time.perf_counter() - update_started
+                if not math.isfinite(loss_before) or not sweep.parameters_finite(head):
+                    raise RuntimeError(
+                        f"schedule {name} lr {start_lr} fold {fold_index + 1} "
+                        f"diverged at update {update}"
+                    )
+        checkpoint_started = time.perf_counter()
+        point = checkpoint(sweep, heads, data)
+        checkpoint_elapsed = time.perf_counter() - checkpoint_started
+        trajectory[str(cadence_end)] = point
+        check = stability(sweep, trajectory[str(cadence_end - CADENCE)], point)
+        checks[str(cadence_end)] = check
+        if first_admissible is None and check["admissible"]:
+            first_admissible = cadence_end
+
+        if name == "plateau_n3":
+            motion = check["changes"]["objective_relative_abs"]
+            if plateau_best is None or motion < plateau_best:
+                plateau_best = motion
+                plateau_stale = 0
+            else:
+                plateau_stale += 1
+                if plateau_stale >= PLATEAU_N:
+                    old_lr = plateau_lr
+                    plateau_lr *= 0.5
+                    plateau_events.append({
+                        "after_update": cadence_end, "old_lr": old_lr,
+                        "new_lr": plateau_lr, "trigger_motion": motion,
+                    })
+                    plateau_best = motion
+                    plateau_stale = 0
+        lr_trace[str(cadence_end)] = (
+            0.0 if name == "cosine" and cadence_end == MAX_UPDATES
+            else plateau_lr if name == "plateau_n3"
+            else scheduled_lr(name, start_lr, cadence_end, plateau_lr)
+        )
+        total_elapsed = time.perf_counter() - cadence_started
+        cadence_total.append(total_elapsed)
+        cadence_update.append(update_elapsed)
+        cadence_checkpoint.append(checkpoint_elapsed)
+        running_total += total_elapsed
+        cumulative_total.append(running_total)
+        progress[0] += CADENCE * len(heads)
+        current_load = load_average()
+        observed_load.append(current_load)
+        print(
+            f"update {progress[0]}/{total_work} schedule={name} start_lr={start_lr:g} "
+            f"destination={cadence_end}/{maximum_updates} load1={current_load:.2f}",
+            flush=True,
+        )
+        if current_load > 30.0:
+            raise LoadPause(f"one-minute load average {current_load:.2f} exceeds 30")
+
+    return {
+        "schedule": name,
+        "starting_learning_rate": start_lr,
+        "maximum_updates": maximum_updates,
+        "trajectory": trajectory,
+        "cadence_checks": checks,
+        "first_admissible_update": first_admissible,
+        "learning_rate_at_cadence": lr_trace,
+        "plateau_events": plateau_events,
+        "wall_s": time.perf_counter() - started,
+        "timing": {
+            "total_s_per_100_updates_across_12_loao_folds": cadence_total,
+            "update_only_s_per_100_updates_across_12_loao_folds": cadence_update,
+            "checkpoint_s_per_100_updates_across_12_loao_folds": cadence_checkpoint,
+            "cumulative_total_s_across_12_loao_folds": cumulative_total,
+            "mean_total_s_per_100_updates_across_12_loao_folds": sum(cadence_total) / len(cadence_total),
+            "mean_update_only_s_per_100_updates_across_12_loao_folds": sum(cadence_update) / len(cadence_update),
+        },
+        "maximum_observed_load1": max(observed_load),
+    }
+
+
+def source_state(sweep, data):
+    fixed = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    inputs = {str(anchor.path): file_sha256(anchor.path) for anchor in data.anchors}
+    return fixed, inputs
+
+
+def common_result(sweep, data, started, initial_load, before, inputs_before):
+    after, inputs_after = source_state(sweep, data)
+    changed = [path for path in (*before, *inputs_before)
+               if (before | inputs_before)[path] != (after | inputs_after)[path]]
+    peak_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    if peak_kb * 1024 >= 3 * 1024**3:
+        raise RuntimeError(f"peak RSS cap exceeded: {peak_kb} KiB")
+    return {
+        "schema": "mcrl-v025-decay-schedule-diagnostic-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "route": "C3",
+        "model_seed_domain": "V025_LEARNER/seed/1",
+        "model_seed": sweep.SEED,
+        "cadence_updates": CADENCE,
+        "stability_tolerances": sweep.STABILITY_TOLERANCES,
+        "inventory": {
+            "anchors": len(data.anchors),
+            "rows": sum(anchor.truth.size for anchor in data.anchors),
+            "trainable_rows": sum(anchor.train_indices.size for anchor in data.anchors),
+            "input_files": [str(anchor.path) for anchor in data.anchors],
+        },
+        "schedule_parameters": {"tau": TAU, "plateau_n": PLATEAU_N},
+        "scope": {
+            "diagnostic_not_claim": True, "ee_quantities_computed": False,
+            "selection_on_ee": False, "selection_on_predictive_levels": False,
+            "metrics_use": "convergence diagnostics only; never evidence about EE",
+        },
+        "resource_policy": {
+            "python_processes": 1, "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "blas_threads": 1, "rlimit_as_bytes": resource.getrlimit(resource.RLIMIT_AS)[0],
+            "peak_rss_kb": peak_kb, "initial_load1": initial_load,
+            "final_load1": load_average(), "elapsed_wall_s": time.perf_counter() - started,
+        },
+        "source_sha256_before": before, "source_sha256_after": after,
+        "c3_input_sha256_before": inputs_before, "c3_input_sha256_after": inputs_after,
+        "changed_inputs": changed,
+    }
+
+
+def original_c3_cell():
+    payload = json.loads(SOURCE_RESULTS.read_text(encoding="utf-8"))
+    return next(cell for cell in payload["cells"]
+                if cell["route"] == "C3" and cell["learning_rate"] == BASE_LR)
+
+
+def parity(sweep, data, started, initial_load, before, inputs_before):
+    progress = [0]
+    run = run_schedule(
+        sweep, data, "constant", BASE_LR, 500, progress,
+        len(data.anchors) * 500,
+    )
+    horizon = json.loads(HORIZON_RESULTS.read_text(encoding="utf-8"))["arms"]["A"]
+    lrsweep = original_c3_cell()
+    comparisons = {}
+    for update in range(0, 501, CADENCE):
+        key = str(update)
+        fields = ("training_objective", "held_out")
+        comparisons[key] = {
+            "horizon_exact": all(run["trajectory"][key][field] == horizon["trajectory"][key][field]
+                                 for field in fields),
+            "lrsweep_exact": all(run["trajectory"][key][field] == lrsweep["trajectory"][key][field]
+                                 for field in fields),
+        }
+    reproduced = all(all(value.values()) for value in comparisons.values())
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "parity", "run": run, "comparisons": comparisons,
+                   "parity_reproduced": reproduced})
+    atomic_json(OUT / "parity.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "parity.json"),
+                      "parity_reproduced": reproduced}), flush=True)
+    if not reproduced:
+        raise RuntimeError("HORIZON Arm A parity failed; stop before schedules")
+
+
+def cap_tolerance_score(sweep, run):
+    check = run["cadence_checks"][str(MAX_UPDATES)]
+    changes = check["changes"]
+    ratios = (
+        changes["objective_relative_abs"] / sweep.STABILITY_TOLERANCES["objective_relative"],
+        changes["r2_absolute"] / sweep.STABILITY_TOLERANCES["r2_absolute"],
+        changes["pairwise_ordering_absolute"] / sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        changes["top1_accuracy_absolute"] / sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    )
+    return max(ratios)
+
+
+def select_extension_shape(sweep, runs):
+    ranked = []
+    for index, name in enumerate(SCHEDULE_ORDER):
+        run = runs[name]
+        first = run["first_admissible_update"]
+        key = (0, first, index) if first is not None else (1, cap_tolerance_score(sweep, run), index)
+        ranked.append((key, name))
+    ranked.sort()
+    return ranked[0][1], [{"schedule": name, "ranking_key": list(key)} for key, name in ranked]
+
+
+def base(sweep, data, started, initial_load, before, inputs_before):
+    parity_result = json.loads((OUT / "parity.json").read_text(encoding="utf-8"))
+    if not parity_result.get("parity_reproduced"):
+        raise RuntimeError("verified parity artifact is absent or failed")
+    progress = [0]
+    total = len(SCHEDULE_ORDER) * len(data.anchors) * MAX_UPDATES
+    runs = {name: run_schedule(sweep, data, name, BASE_LR, MAX_UPDATES, progress, total)
+            for name in SCHEDULE_ORDER}
+    shape, ranking = select_extension_shape(sweep, runs)
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "base", "parity_reproduced": True, "runs": runs,
+                   "extension_shape": shape, "extension_ranking": ranking})
+    atomic_json(OUT / "base-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "base-results.json"),
+                      "extension_shape": shape}), flush=True)
+
+
+def higher(sweep, data, started, initial_load, before, inputs_before):
+    base_result = json.loads((OUT / "base-results.json").read_text(encoding="utf-8"))
+    if not base_result.get("parity_reproduced"):
+        raise RuntimeError("base result does not carry successful parity")
+    expected_shape, ranking = select_extension_shape(sweep, base_result["runs"])
+    if expected_shape != base_result["extension_shape"]:
+        raise RuntimeError("extension shape selection drifted")
+    progress = [0]
+    run = run_schedule(
+        sweep, data, expected_shape, HIGHER_LR, MAX_UPDATES, progress,
+        len(data.anchors) * MAX_UPDATES,
+    )
+    result = common_result(sweep, data, started, initial_load, before, inputs_before)
+    result.update({"mode": "higher", "parity_reproduced": True,
+                   "extension_shape": expected_shape, "extension_ranking": ranking,
+                   "run": run})
+    atomic_json(OUT / "higher-results.json", result)
+    print(f"PEAK_RSS_KB={result['resource_policy']['peak_rss_kb']}", flush=True)
+    print(json.dumps({"written": str(OUT / "higher-results.json"),
+                      "extension_shape": expected_shape}), flush=True)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("parity", "base", "higher"))
+    args = parser.parse_args()
+    OUT.mkdir(parents=True, exist_ok=True)
+    verify_runtime()
+    initial_load = guard_load()
+    sweep = import_sweep()
+    verify_runtime()
+    data = sweep.load_c3()
+    before, inputs_before = source_state(sweep, data)
+    started = time.perf_counter()
+    if args.mode == "parity":
+        parity(sweep, data, started, initial_load, before, inputs_before)
+    elif args.mode == "base":
+        base(sweep, data, started, initial_load, before, inputs_before)
+    else:
+        higher(sweep, data, started, initial_load, before, inputs_before)
+
+
+if __name__ == "__main__":
+    main()
