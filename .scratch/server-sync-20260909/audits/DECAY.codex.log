def verify_runtime() -> None:
    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
    if wrong:
        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below 15")


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_json(path: Path, payload: object) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def load_c1() -> PairData:
    rows = []
    for path in C1_INPUTS:
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                record = json.loads(line)
                if record["kind"] == "metadata":
                    if record["q1_schema"] != SCHEMA_V2 or record["q1_schema_sha256"] != SCHEMA_V2_SHA256:
                        raise RuntimeError("C1 repaired schema mismatch")
                    continue
                maximum = 17 if record["world_id"].endswith("/1") else 18
                if int(record["anchor_index"]) > maximum:
                    continue
                for row in record["rows"]:
                    rows.append((
                        row["q1"], row["declared"], row["reference"],
                        record["anchor_id"], row["user_id"],
                    ))
    return make_pair_data("C1", rows, C1_INPUTS, SCHEMA_V2, SCHEMA_V2_SHA256)


def load_c2() -> PairData:
    rows = []
    for path in C2_INPUTS:
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                record = json.loads(line)
                if record["kind"] == "metadata":
                    continue
                for row in record["rows"]:
                    rows.append((
                        row["q2"], row["declared"], row["reference"],
                        record["anchor_id"], row["user_id"],
                    ))
    return make_pair_data(
        "C2", rows, C2_INPUTS,
        "mcrl-v025-stagec-q2-action-v1",
        "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c",
    )


def make_pair_data(
    route: str,
    rows: list[tuple[object, object, object, object, object]],
    paths: tuple[Path, ...],
    schema: str,
    schema_sha256: str,
) -> PairData:
    anchors = sorted({str(row[3]) for row in rows})
    groups = sorted({f"{row[3]}|user/{row[4]}" for row in rows})
    anchor_code = {value: index for index, value in enumerate(anchors)}
    group_code = {value: index for index, value in enumerate(groups)}
    return PairData(
        route=route,
        x=np.asarray([row[0] for row in rows], dtype=np.float64),
        y=np.asarray([row[1] for row in rows], dtype=np.float64),
        reference=np.asarray([row[2] for row in rows], dtype=bool),
        anchor=np.asarray([anchor_code[str(row[3])] for row in rows], dtype=np.int16),
        group=np.asarray([group_code[f"{row[3]}|user/{row[4]}"] for row in rows], dtype=np.int32),
        input_files=paths,
        schema=schema,
        schema_sha256=schema_sha256,
    )


def load_c3() -> C3Data:
    missing = [str(path) for path in C3_INPUTS if not path.is_file()]
    if missing:
        raise RuntimeError(f"frozen C3 inputs missing: {missing}")
    anchors = []
    for path in C3_INPUTS:
        with np.load(path, allow_pickle=False) as payload:
            truth = np.asarray(payload["target"], dtype=np.float64)
            size = np.asarray(payload["size"], dtype=np.int16)
            indices = np.asarray(payload["coalition_indices"], dtype=np.int32)
            x = np.asarray(payload["x_v2"], dtype=np.float64)
        if x.shape[0] != indices.size or not np.array_equal(indices, np.flatnonzero(size >= 2)):
            raise RuntimeError(f"C3 train support mismatch: {path}")
        if not np.isfinite(truth).all() or not np.isfinite(x).all():
            raise RuntimeError(f"non-finite C3 input: {path}")
        anchors.append(C3Anchor(path, truth, size, indices, x))
    dimensions = {anchor.x.shape[1] for anchor in anchors}
    if len(dimensions) != 1:
        raise RuntimeError("C3 input dimensions disagree")
    return C3Data(tuple(anchors), SCHEMA_V2, SCHEMA_V2_SHA256)


def pair_batch(data: PairData, train: np.ndarray) -> SimpleNamespace:
    ref_by_group = {int(data.group[i]): int(i) for i in np.flatnonzero(train & data.reference)}
    candidates = np.flatnonzero(train & ~data.reference)
    references = np.asarray([ref_by_group[int(data.group[i])] for i in candidates], dtype=np.int64)
    if candidates.size > PAIR_LIMIT:
        chosen = np.linspace(0, candidates.size - 1, PAIR_LIMIT, dtype=np.int64)
        candidates = candidates[chosen]
        references = references[chosen]
    return SimpleNamespace(
        reference_states=data.x[references],
        candidate_states=data.x[candidates],
        target_deltas=data.y[candidates] - data.y[references],
    )


def parameters_finite(head: AdamMLPHead) -> bool:
    return all(np.isfinite(value).all() for value in (*head.weights, *head.biases))


def parameter_norm(head: AdamMLPHead) -> float:
    total = sum(float(np.square(value).sum()) for value in (*head.weights, *head.biases))
    return math.sqrt(total)


def pair_objective(head: AdamMLPHead, batch: SimpleNamespace) -> float:
    reference = head._forward(batch.reference_states)[0]
    candidate = head._forward(batch.candidate_states)[0]
    residual = candidate - reference - batch.target_deltas
    return float(head.loss_weight * np.mean(residual * residual + head.gauge_beta * reference * reference))


def metric(prediction: np.ndarray, truth: np.ndarray, group: np.ndarray) -> dict[str, float | int]:
    rss = float(np.square(truth - prediction).sum())
    tss = float(np.square(truth - truth.mean()).sum())
    credit = 0.0
    pairs = 0
    top1_hits = 0
    group_count = 0
    for group_id in np.unique(group):
        indices = np.flatnonzero(group == group_id)
        if indices.size < 2:
            continue
        target = truth[indices]
        score = prediction[indices]
        left, right = np.triu_indices(indices.size, 1)
        target_delta = target[left] - target[right]
        score_delta = score[left] - score[right]
        keep = np.abs(target_delta) > 1e-12
        target_delta = target_delta[keep]
        score_delta = score_delta[keep]
        pairs += int(target_delta.size)
        credit += float(np.sum(np.sign(target_delta) == np.sign(score_delta)))
        credit += 0.5 * float(np.sum(np.abs(score_delta) <= 1e-15))
        selected = int(np.argmax(score))
        top1_hits += int(target[selected] >= target.max() - 1e-12)
        group_count += 1
    return {
        "r2": float(1.0 - rss / tss) if tss else math.nan,
        "pairwise_ordering": float(credit / pairs) if pairs else math.nan,
        "top1_accuracy": float(top1_hits / group_count) if group_count else math.nan,
        "rows": int(truth.size),
        "pairs": pairs,
        "groups": group_count,
    }


def run_pair(data: PairData, lr: float, maximum_epoch: int = 500, maximum_folds: int | None = None) -> dict[str, object]:
    folds = list(np.unique(data.anchor))
    if maximum_folds is not None:
        folds = folds[:maximum_folds]
    checkpoints = tuple(value for value in CHECKPOINTS if value <= maximum_epoch)
    predictions = {epoch: np.full(data.y.shape, np.nan) for epoch in checkpoints}
    objectives = {epoch: [] for epoch in checkpoints}
    norms = {epoch: [] for epoch in checkpoints}
    divergence_rows = []
    literal = dict(LEGACY_TRAINER_LITERALS[data.route])
    literal["learning_rate"] = lr
    started = time.perf_counter()
    for fold_number, value in enumerate(folds, start=1):
        test = data.anchor == value
        train = ~test
        batch = pair_batch(data, train)
        head = AdamMLPHead.create(data.x.shape[1], literal, np.random.default_rng(SEED))
        for epoch in range(maximum_epoch + 1):
            if epoch in checkpoints:
                loss = pair_objective(head, batch)
                if not math.isfinite(loss) or not parameters_finite(head):
                    divergence_rows.append({"fold": int(value), "epoch": epoch, "phase": "checkpoint"})
                    break
                objectives[epoch].append((loss, int(batch.target_deltas.size)))
                norms[epoch].append(parameter_norm(head))
                predictions[epoch][test] = head._forward(data.x[test])[0]
            if epoch == maximum_epoch:
                break
            with np.errstate(all="ignore"):
                loss_before_update = head.update(batch)
            if not math.isfinite(loss_before_update) or not parameters_finite(head):
                divergence_rows.append({"fold": int(value), "epoch": epoch + 1, "phase": "update"})
                break
        print(json.dumps({
            "event": "fold", "route": data.route, "lr": lr,
            "fold": fold_number, "folds": len(folds),
            "diverged": bool(divergence_rows and divergence_rows[-1]["fold"] == int(value)),
        }), flush=True)
    usable = np.isin(data.anchor, np.asarray(folds))
    trajectory = {}
    for epoch in checkpoints:
        finite_predictions = bool(np.isfinite(predictions[epoch][usable]).all())
        if len(objectives[epoch]) == len(folds) and finite_predictions:
            weighted_loss = sum(value * count for value, count in objectives[epoch]) / sum(count for _, count in objectives[epoch])
            trajectory[str(epoch)] = {
                "training_objective": float(weighted_loss),
                "held_out": metric(predictions[epoch][usable], data.y[usable], data.group[usable]),
                "parameter_l2": summarize(norms[epoch]),
            }
        else:
            trajectory[str(epoch)] = None
    return finalize_cell(
        data.route, lr, trajectory, divergence_rows,
        wall_s=time.perf_counter() - started,
        schema=data.schema, schema_sha256=data.schema_sha256,
        folds=len(folds), rows=int(usable.sum()), groups=int(np.unique(data.group[usable]).size),
        pair_limit=PAIR_LIMIT,
    )


def c3_loss(head: AdamMLPHead, anchors: Iterable[C3Anchor]) -> tuple[float, int]:
    squared = 0.0
    count = 0
    for anchor in anchors:
        target = anchor.truth[anchor.train_indices]
        prediction = head._forward(anchor.x)[0]
        squared += float(np.square(prediction - target).sum())
        count += int(target.size)
    return float(head.loss_weight * squared / count), count


def c3_update(head: AdamMLPHead, anchors: Iterable[C3Anchor]) -> float:
    grad_w = [np.zeros_like(value) for value in head.weights]
    grad_b = [np.zeros_like(value) for value in head.biases]
    squared = 0.0
    count = 0
    for anchor in anchors:
        target = anchor.truth[anchor.train_indices]
        prediction, activations, preactivations = head._forward(anchor.x)
        residual = prediction - target
        chunk_w, chunk_b = head._backward(activations, preactivations, residual)
        for total, chunk in zip(grad_w, chunk_w, strict=True):
            total += chunk
        for total, chunk in zip(grad_b, chunk_b, strict=True):
            total += chunk
        squared += float(np.square(residual).sum())
        count += int(target.size)
    scale = 2.0 * head.loss_weight / count
    head._adam([value * scale for value in grad_w], [value * scale for value in grad_b])
# HORIZON lever diagnostic protocol — 2026-09-10

`DIAGNOSTIC_NOT_CLAIM`. This file is fixed before either horizon arm is fit.

## Question and fixed inputs

- Diagnose whether C3 convergence under-run is addressed by more full-batch
  updates (Arm A) or by minibatch updates (Arm B). This is one route and one
  seed, not a learning-rate grid and not a learning-rate selection.
- Use the twelve fixed C3 LOAO anchors named by the LRSWEEP harness, including
  only size>=2 rows for training and retaining the declared hard-zero
  empty/singleton predictions for held-out diagnostics.
- Use model seed `V025_LEARNER/seed/1` (`6407676579069309528`), C3 learning
  rate `1e-3`, and every other architecture and Adam literal unchanged.
- Import and reuse the LRSWEEP harness at
  `/home/sat/mcrl-v025-c1c2-ws/.scratch/lr-convergence-sweep/run_sweep.py`
  (SHA-256 `dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6`),
  its frozen rule (SHA-256
  `0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19`),
  and its results (SHA-256
  `9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861`)
  directly and without modifying those artifacts.

## Common cadence and rule

- Cap both arms at 4,000 optimizer updates and evaluate at update 0 and every
  100 updates through 4,000.
- At each destination cadence `k`, apply LRSWEEP's identical four checks to
  `k-100 -> k`: objective relative absolute motion <= 0.01; held-out level R2
  absolute motion <= 0.01; held-out within-group ordering absolute motion <=
  0.005; held-out top-1 absolute motion <= 0.005. The first finite destination
  cadence satisfying all four is that arm's first admissible update.
- The checkpoint training objective is always evaluated on the complete LOAO
  training fold, including for Arm B. A last-minibatch loss is not used.

## Arms

- Arm A: the LRSWEEP C3 full-batch gradient aggregation verbatim, one Adam
  update over all eleven training anchors per optimizer step.
- Arm B: batch size 256. For each LOAO fold, concatenate the eleven training
  anchors in the fixed LRSWEEP filename order. Initialise an independent PCG64
  generator from the SHA-256 domain seed
  `V025_HORIZON/C3/minibatch-shuffle/seed/1`. At the start of every pass,
  generate a permutation of all training rows; consume consecutive batches of
  256 without replacement within that pass; include the final remainder batch;
  then reshuffle for the next pass. Rows recur across passes. Each fold starts
  a fresh generator at the same declared shuffle seed. This deterministic
  ordering is separate from the unchanged model-initialisation seed.
- Minibatching is a training-procedure change, not a hyperparameter.

## Scope and resources

- Metrics are convergence diagnostics only and are never evidence about EE.
  Compute no EE quantity and perform no selection on EE.
- Read only the twelve C3 files fixed in LRSWEEP. Do not discover or read any
  evaluation-only claim dates.
- Run both arms sequentially in one Python process using only
  `/home/sat/mcrl-leo-handover/.venv/bin/python`, niceness 19, all named BLAS
  thread variables equal to one, and an address-space limit below 3 GiB.
- Print progress as `step k/N` and print peak RSS. If one-minute load average
  exceeds 30 at a cadence boundary, stop before more training and record a
  load pause rather than pushing through.

#!/usr/bin/env python3
"""C3 horizon-vs-minibatch convergence diagnostic; computes no EE quantity."""

from __future__ import annotations

import hashlib
import importlib.util
import json
import math
import os
from pathlib import Path
import resource
import sys
import time
from typing import Callable


ROOT = Path("/home/sat/mcrl-v025-horizon-ws")
OUT = ROOT / ".scratch/horizon-lever"
SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2-ws")
SOURCE_RUNNER = SOURCE_ROOT / ".scratch/lr-convergence-sweep/run_sweep.py"
SOURCE_SPEC = SOURCE_ROOT / ".scratch/lr-convergence-sweep/spec.md"
SOURCE_RESULTS = SOURCE_ROOT / ".scratch/lr-convergence-sweep/results.json"
SOURCE_LEARNER = SOURCE_ROOT / "src/mcrl/stagec_v025/learner.py"
EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
THREAD_ENV = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)
RSS_LIMIT_BYTES = 3 * 1024**3 - 1
MAX_UPDATES = 4000
CADENCE = 100
BATCH_SIZE = 256
SHUFFLE_DOMAIN = "V025_HORIZON/C3/minibatch-shuffle/seed/1"
EXPECTED_HASHES = {
    str(SOURCE_RUNNER): "dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6",
    str(SOURCE_SPEC): "0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19",
    str(SOURCE_RESULTS): "9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861",
    str(SOURCE_LEARNER): "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
}


class LoadPause(RuntimeError):
    pass


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_json(path: Path, payload: object) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def verify_runtime() -> None:
    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
    if wrong:
        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
    if os.getpriority(os.PRIO_PROCESS, 0) != 19:
        raise RuntimeError(f"process niceness is not 19: {os.getpriority(os.PRIO_PROCESS, 0)}")
    actual = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
    if actual != EXPECTED_HASHES:
        raise RuntimeError(f"sealed source hash mismatch: {actual}")


def load_average() -> float:
    return float(Path("/proc/loadavg").read_text(encoding="ascii").split()[0])


def guard_load() -> float:
    value = load_average()
    if value > 30.0:
        raise LoadPause(f"one-minute load average {value:.2f} exceeds 30")
    return value


def import_sweep():
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    spec = importlib.util.spec_from_file_location("sealed_lr_sweep", SOURCE_RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load sealed LRSWEEP harness")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
    return module


def record_checkpoint(sweep, head, train, test):
    loss, count = sweep.c3_loss(head, train)
    if not math.isfinite(loss) or not sweep.parameters_finite(head):
        raise RuntimeError("non-finite objective or parameter at checkpoint")
    prediction = sweep.np.zeros_like(test.truth)
    prediction[test.train_indices] = head._forward(test.x)[0]
    return loss, count, sweep.parameter_norm(head), prediction


def make_minibatch_updater(sweep, head, train) -> Callable[[], float]:
    states = sweep.np.concatenate([anchor.x for anchor in train], axis=0)
    targets = sweep.np.concatenate([
        anchor.truth[anchor.train_indices] for anchor in train
    ])
    rng = sweep.np.random.default_rng(sweep.seed_from_domain(SHUFFLE_DOMAIN))
    order = sweep.np.empty(0, dtype=sweep.np.int64)
    cursor = 0

    def update() -> float:
        nonlocal order, cursor
        if cursor >= order.size:
            order = rng.permutation(states.shape[0])
            cursor = 0
        stop = min(cursor + BATCH_SIZE, order.size)
        selected = order[cursor:stop]
        cursor = stop
        return head.update_scalar(states[selected], targets[selected])

    return update


def stability(sweep, left: dict[str, object], right: dict[str, object]) -> dict[str, object]:
    changes = {
        "objective_relative_abs": abs(right["training_objective"] - left["training_objective"])
        / max(abs(left["training_objective"]), 1e-12),
        "r2_absolute": abs(right["held_out"]["r2"] - left["held_out"]["r2"]),
        "pairwise_ordering_absolute": abs(
            right["held_out"]["pairwise_ordering"] - left["held_out"]["pairwise_ordering"]
        ),
        "top1_accuracy_absolute": abs(
            right["held_out"]["top1_accuracy"] - left["held_out"]["top1_accuracy"]
        ),
    }
    passed = {
        "objective": changes["objective_relative_abs"] <= sweep.STABILITY_TOLERANCES["objective_relative"],
        "r2": changes["r2_absolute"] <= sweep.STABILITY_TOLERANCES["r2_absolute"],
        "pairwise_ordering": changes["pairwise_ordering_absolute"]
        <= sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
        "top1_accuracy": changes["top1_accuracy_absolute"]
        <= sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
    }
    return {"changes": changes, "passed": passed, "admissible": all(passed.values())}


def run_arm(sweep, data, arm: str, progress: list[int], total_work: int) -> dict[str, object]:
    checkpoints = tuple(range(0, MAX_UPDATES + 1, CADENCE))
    predictions = {step: [None] * len(data.anchors) for step in checkpoints}
    objectives = {step: [] for step in checkpoints}
    norms = {step: [] for step in checkpoints}
    interval_total = {step: [] for step in checkpoints[1:]}
    interval_update = {step: [] for step in checkpoints[1:]}
    interval_checkpoint = {step: [] for step in checkpoints[1:]}
    literal = dict(sweep.LEGACY_TRAINER_LITERALS["C3"])
    arm_started = time.perf_counter()
    load_observed = [guard_load()]

    for fold_index, test in enumerate(data.anchors):
        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
        fold_started = time.perf_counter()
        head = sweep.AdamMLPHead.create(
            test.x.shape[1], literal, sweep.np.random.default_rng(sweep.SEED)
        )
        initial_started = time.perf_counter()
        loss, count, norm, prediction = record_checkpoint(sweep, head, train, test)
        initial_checkpoint_s = time.perf_counter() - initial_started
        objectives[0].append((loss, count))
        norms[0].append(norm)
        predictions[0][fold_index] = prediction
        if arm == "A":
            updater = lambda: sweep.c3_update(head, train)
        else:
            updater = make_minibatch_updater(sweep, head, train)

        previous_end = fold_started
        update_accumulator = 0.0
        for step in range(1, MAX_UPDATES + 1):
            update_started = time.perf_counter()
            with sweep.np.errstate(all="ignore"):
                loss_before_update = updater()
            update_accumulator += time.perf_counter() - update_started
            if not math.isfinite(loss_before_update) or not sweep.parameters_finite(head):
                raise RuntimeError(f"arm {arm} fold {fold_index + 1} diverged at update {step}")
            if step % CADENCE:
                continue
            checkpoint_started = time.perf_counter()
            loss, count, norm, prediction = record_checkpoint(sweep, head, train, test)
            checkpoint_s = time.perf_counter() - checkpoint_started
            objectives[step].append((loss, count))
            norms[step].append(norm)
            predictions[step][fold_index] = prediction
            now = time.perf_counter()
            interval_total[step].append(now - previous_end)
            interval_update[step].append(update_accumulator)
            interval_checkpoint[step].append(checkpoint_s + (initial_checkpoint_s if step == CADENCE else 0.0))
            previous_end = now
            update_accumulator = 0.0
            progress[0] += CADENCE
            current_load = load_average()
            load_observed.append(current_load)
            print(
                f"step {progress[0]}/{total_work} arm={arm} "
                f"fold={fold_index + 1}/{len(data.anchors)} update={step}/{MAX_UPDATES} "
                f"load1={current_load:.2f}",
                flush=True,
            )
            if current_load > 30.0:
                raise LoadPause(f"one-minute load average {current_load:.2f} exceeds 30")

    trajectory = {}
    for step in checkpoints:
        weighted_loss = sum(value * count for value, count in objectives[step]) / sum(
            count for _, count in objectives[step]
        )
        held_out = sweep.c3_metric(
            [value for value in predictions[step] if value is not None], data.anchors
        )
        trajectory[str(step)] = {
            "training_objective": float(weighted_loss),
            "held_out": held_out,
            "parameter_l2": sweep.summarize(norms[step]),
        }

    checks = {}
    first_admissible = None
    for step in checkpoints[1:]:
        check = stability(sweep, trajectory[str(step - CADENCE)], trajectory[str(step)])
        checks[str(step)] = check
        if first_admissible is None and check["admissible"]:
            first_admissible = step

    total_by_interval = [sum(interval_total[step]) for step in checkpoints[1:]]
    update_by_interval = [sum(interval_update[step]) for step in checkpoints[1:]]
    checkpoint_by_interval = [sum(interval_checkpoint[step]) for step in checkpoints[1:]]
    cumulative = []
    running = 0.0
    for value in total_by_interval:
        running += value
        cumulative.append(running)
    return {
        "arm": arm,
        "procedure": "full_batch" if arm == "A" else "minibatch",
        "trajectory": trajectory,
        "cadence_checks": checks,
        "first_admissible_update": first_admissible,
        "wall_s": time.perf_counter() - arm_started,
        "timing": {
            "total_s_per_100_updates_across_12_loao_folds": total_by_interval,
            "update_only_s_per_100_updates_across_12_loao_folds": update_by_interval,
            "checkpoint_s_per_100_updates_across_12_loao_folds": checkpoint_by_interval,
            "cumulative_total_s_across_12_loao_folds": cumulative,
            "mean_total_s_per_100_updates_across_12_loao_folds": sum(total_by_interval) / len(total_by_interval),
            "mean_update_only_s_per_100_updates_across_12_loao_folds": sum(update_by_interval) / len(update_by_interval),
            "per_fold_interval_total_s": {str(step): interval_total[step] for step in checkpoints[1:]},
        },
        "maximum_observed_load1": max(load_observed),
    }


def equal_wall_comparison(arms: dict[str, dict[str, object]]) -> dict[str, object]:
    a = arms["A"]
    b = arms["B"]
    a_times = a["timing"]["cumulative_total_s_across_12_loao_folds"]
    b_times = b["timing"]["cumulative_total_s_across_12_loao_folds"]

    def reached(times: list[float], budget: float) -> int:
        return CADENCE * sum(value <= budget for value in times)

    comparisons = []
    for label, budget in (
        ("arm_a_cap_time", a_times[-1]),
        ("arm_b_cap_time", b_times[-1]),
        ("common_cap_time", min(a_times[-1], b_times[-1])),
    ):
        comparisons.append({
            "budget_label": label,
            "wall_s": budget,
            "arm_a_update": reached(a_times, budget),
            "arm_b_update": reached(b_times, budget),
        })
    if b["first_admissible_update"] is not None:
        budget = b_times[b["first_admissible_update"] // CADENCE - 1]
        comparisons.append({
            "budget_label": "arm_b_first_admissible_time",
            "wall_s": budget,
            "arm_a_update": reached(a_times, budget),
            "arm_b_update": b["first_admissible_update"],
        })
    return {"comparisons": comparisons}


