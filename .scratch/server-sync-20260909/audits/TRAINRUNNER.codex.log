def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(row for row in root.rglob("*") if row.is_file()):
        relative = path.relative_to(root).as_posix().encode("utf-8")
        digest.update(len(relative).to_bytes(8, "big"))
        digest.update(relative)
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def atomic_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(json.dumps(payload, sort_keys=True, indent=2, allow_nan=False).encode())
        handle.write(b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def assert_runtime() -> None:
    if sys.executable != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins are not all one: {bad}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below 15")


def load_pilot():
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    name = f"exact_source_build_pilot_{os.getpid()}"
    spec = importlib.util.spec_from_file_location(name, RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load pilot runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def load_calibration(pilot):
    payload = json.loads(CALIBRATION.read_text())

    def fraction(name: str) -> Fraction:
        numerator, denominator = payload[name]
        return Fraction(numerator, denominator)

    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
        bits_ref=fraction("bits_ref"),
        joules_ref=fraction("joules_ref"),
        users=int(payload["users"]),
    )


def fraction_payload(value: Fraction) -> dict[str, object]:
    return {
        "fraction": [value.numerator, value.denominator],
        "float_hex": float.hex(float(value)),
    }


def profile_payload(profile) -> dict[str, object]:
    if profile is None:
        return {
            "valid": False,
            "whole_network_bits_hex": float.hex(0.0),
            "whole_network_joules_hex": float.hex(0.0),
            "per_user": [],
            "required_power_w_max_hex": None,
            "minimum_decoding_margin_db_hex": float.hex(-100.0),
            "mean_acm_spectral_efficiency_bit_s_hz_hex": float.hex(0.0),
        }
    return {
        "valid": True,
        "whole_network_bits_hex": float.hex(profile.bits),
        "whole_network_joules_hex": float.hex(profile.joules),
        "per_user": [
            {
                "user_id": int(user),
                "bits_hex": float.hex(float(profile.score.bits[user])),
                "served_phy": bool(profile.score.served_phy[user]),
                "decoding_time_s_hex": float.hex(float(profile.score.decoding_time_s[user])),
                "useful_time_s_hex": float.hex(float(profile.score.useful_time_s[user])),
                "rate_target_attained": (
                    None
                    if profile.score.rate_target_attained is None
                    else bool(profile.score.rate_target_attained[user])
                ),
                "rate_target_feasible": (
                    None
                    if profile.score.rate_target_feasible is None
                    else bool(profile.score.rate_target_feasible[user])
                ),
            }
            for user in sorted(profile.score.bits)
        ],
        "energy_components_j_hex": {
            str(name): float.hex(float(value))
            for name, value in sorted(profile.energy_components.items())
        },
        "required_power_w_max_hex": float.hex(profile.required_power_w_max),
        "minimum_decoding_margin_db_hex": float.hex(profile.min_decoding_margin_db),
        "mean_acm_spectral_efficiency_bit_s_hz_hex": float.hex(
            profile.mean_acm_se_bit_s_hz
        ),
        "acm_mode_counts": dict(sorted(profile.acm_mode_counts.items())),
        "certificate_status": profile.certificate_status,
        "certificate_iterations": int(profile.certificate_iterations),
        "rf_cap_hits": int(profile.rf_cap_hits),
        "rf_transmission_observations": int(profile.rf_transmission_observations),
    }


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def assert_rss() -> int:
    value = peak_rss_bytes()
    if value > MAX_RSS_BYTES:
        raise MemoryError(f"peak RSS exceeded 6 GB: {value}")
    return value


def build_true_off_axis_lookup(provider, tape) -> dict[int, dict[tuple[int, tuple[int, int]], float]]:
    """Recompute provider-native direct angles without modifying its tape schema."""

    from mcrl.env.geometry import angle_between_deg
    from mcrl.physics_v025.constants_v025 import D2_SUBINTERVALS

    world = provider._ensure(tape.seed)
    result: dict[int, dict[tuple[int, tuple[int, int]], float]] = {}
    for step_index, step in enumerate(tape.steps):
        if step.arrays is None:
            raise RuntimeError("exact source build requires primitive step arrays")
        state = world.steps[step_index]
        row_user, _row_action, identities, _row_slot = provider._row_metadata(state)
        begin = step_index * D2_SUBINTERVALS
        tracked_column = {
            int(norad): index for index, norad in enumerate(world.tracked_norads.tolist())
        }
        tracked_rows = np.asarray(
            [tracked_column[int(norad)] for norad in identities[:, 0]], dtype=np.int64
        )
        row_positions = world.positions_ecef_km[tracked_rows, begin, :]
        row_users = state.user_ecef_km[row_user]
        row_centres = world.grid.centers_ecef_km[identities[:, 1]]
        angles = angle_between_deg(row_positions, row_centres, row_users)
        lookup = {}
        for index, raw_identity in enumerate(identities):
            user = int(step.arrays.users[int(row_user[index])])
            identity = (int(raw_identity[0]), int(raw_identity[1]))
            lookup[(user, identity)] = float(angles[index])
        result[step_index] = lookup
    return result


def geometry_payload(tape, off_axis, *, step_index: int, user: int, identity) -> dict[str, object]:
    if identity is None:
        return {"step_index": step_index, "identity": None, "present_in_tape": False}
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        raise RuntimeError("exact source build requires primitive step arrays")
    row = arrays._row_index().get((user, identity))
    if row is None:
        return {
            "step_index": step_index,
            "identity": list(identity),
            "present_in_tape": False,
        }
    theta_deg = off_axis[step_index].get((user, identity))
    if theta_deg is None:
        raise AssertionError("provider-native off-axis lookup lost a candidate row")
    return {
        "step_index": step_index,
        "identity": list(identity),
        "present_in_tape": True,
        "elevation_deg_hex": float.hex(float(arrays.elevations_deg[0, row])),
        "true_off_axis_angle_deg_hex": float.hex(theta_deg),
        "true_off_axis_angle_rad_hex": float.hex(math.radians(theta_deg)),
        "d2_entry_elevation_deg_hex": float.hex(float(arrays.d2_entry_elevations_deg[0, row])),
        "slant_km_hex": float.hex(float(arrays.slants_km[0, row])),
        "d2_distance_km_hex": float.hex(float(arrays.d2_distances_km[0, row])),
        "nominal_gain_hex": float.hex(float(arrays.nominal_gain[0, row])),
        "realised_gain_hex": float.hex(float(arrays.realised_gain[0, row])),
        "remaining_visibility_s_hex": float.hex(float(arrays.remaining_visibility_s[0, row])),
        "remaining_d2_s_hex": float.hex(float(arrays.remaining_d2_s[0, row])),
        "visible": bool(arrays.visible[0, row]),
        "d2_eligible": bool(arrays.d2_eligible[0, row]),
        "cell_reachable": bool(arrays.cell_reachable[0, row]),
        "visibility_right_censored": bool(arrays.visibility_right_censored[0, row]),
        "d2_right_censored": bool(arrays.d2_right_censored[0, row]),
    }


def surrogate_labels(pilot, *, tape, step_index: int, carrier: str, user: int,
                     identity, base, incumbent, config, calibration,
                     row_indices) -> dict[str, object]:
    base_metric = pilot._primitive_metrics(
        tape, step_index, user, base.mapping[user], row_indices
    )
    metric = pilot._primitive_metrics(tape, step_index, user, identity, row_indices)
    base_gain = max(base_metric["gain"], 1e-300)
    ratio = max(metric["gain"], 1e-300) / base_gain
    if identity is None or not metric["legal"]:
        c1_normalized_without_phi = -1.0
    else:
        c1_normalized_without_phi = math.tanh(math.log(max(ratio, 1e-30)))
    c1_bits = float(calibration.kappa_bits_per_user_step) * c1_normalized_without_phi
    phi = pilot.ENGINE._phi_for(incumbent, config) - pilot.ENGINE._phi_for(incumbent, base)

    alive = True
    c2_normalized = 0.0
    for offset in (1, 2, 3):
        projected = step_index + offset
        future_metric = pilot._primitive_metrics(
            tape, projected, user, identity, row_indices
        )
        future_base = pilot.ENGINE._base_configuration(
            tape, projected, carrier
        ).mapping[user]
        future_base_metric = pilot._primitive_metrics(
            tape, projected, user, future_base, row_indices
        )
        future_ratio = max(future_metric["gain"], 1e-300) / max(
            future_base_metric["gain"], 1e-300
        )
        survives = bool(future_metric["legal"] and identity is not None)
        if alive:
            c2_normalized += (
                math.tanh(math.log(max(future_ratio, 1e-30))) if survives else -1.0
            )
            alive = survives
        else:
            c2_normalized -= 1.0
    c2_bits = float(calibration.kappa_bits_per_user_step) * c2_normalized
    return {
        "method": "provider-primitive-fallback-for-same-row",
        "c1_core_bits_hex": float.hex(c1_bits),
        "c1_phi_difference_hex": float.hex(float(phi)),
        "c1_normalized_total_hex": float.hex(
            c1_bits / float(calibration.kappa_bits_per_user_step) + float(phi)
        ),
        "c2_label_bits_hex": float.hex(c2_bits),
        "c2_normalized_total_hex": float.hex(c2_normalized),
    }


def write_anchor_shard(path: Path, header: dict[str, object], payloads: Iterable[dict[str, object]]) -> tuple[str, int, int]:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    digest = hashlib.sha256()
    row_count = 0
    with temporary.open("wb") as handle:
        for payload in (header, *payloads):
            encoded = canonical_bytes(payload) + b"\n"
            handle.write(encoded)
            digest.update(encoded)
            if payload is not header:
                row_count += 1
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    file_hash = digest.hexdigest()
    sidecar = path.with_suffix(path.suffix + ".sha256")
    sidecar_tmp = sidecar.with_name(f".{sidecar.name}.{os.getpid()}.tmp")
    sidecar_tmp.write_text(f"{file_hash}  {path.name}\n")
    sidecar_tmp.replace(sidecar)
    sidecar_tmp.replace(sidecar)
    return file_hash, row_count, path.stat().st_size


def build_anchor(pilot, *, tape, setting, run_setting, calibration, world_index: int,
                 step_index: int, carrier_index: int, global_index: int,
                 off_axis) -> dict[str, object]:
    runner_before = sha256(RUNNER)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("source fallback value was not true before in-process override")
    captured_forecasts = {}
    captured_forecast_profiles = {}
    original_forecast = pilot.ENGINE._batched_stage2_forecasts

    def capture_forecast(**kwargs):
        configs = tuple(kwargs["configs"])
        if not configs:
            raise AssertionError("forecast batch unexpectedly contained no configurations")
        original_projection = pilot.ENGINE._projection_from_profile
        call_index = 0

        def capture_projection(**projection_kwargs):
            nonlocal call_index
            config = configs[call_index % len(configs)]
            expected_offset = call_index // len(configs) + 1
            if int(projection_kwargs["offset"]) != expected_offset:
                raise AssertionError("forecast projection order changed")
            captured_forecast_profiles.setdefault(config.configuration_id, {})[
                expected_offset
            ] = projection_kwargs["profile"]
            call_index += 1
            return original_projection(**projection_kwargs)

        pilot.ENGINE._projection_from_profile = capture_projection
        try:
            result = original_forecast(**kwargs)
        finally:
            pilot.ENGINE._projection_from_profile = original_projection
        if call_index != len(configs) * 3:
            raise AssertionError("forecast profile capture count changed")
        captured_forecasts.update(result[0])
        return result

    carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_index]
    pilot.ENGINE._batched_stage2_forecasts = capture_forecast
    pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
    started = time.perf_counter()
    try:
        built = pilot._build_anchor_rows(
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step_index=step_index,
            carrier=carrier,
            anchor_index=step_index * len(CARRIERS) + carrier_index,
            include_coalition=False,
            full_legal_actions=False,
        )
    finally:
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = True
        pilot.ENGINE._batched_stage2_forecasts = original_forecast
    build_wall = time.perf_counter() - started
    if not captured_forecasts or not captured_forecast_profiles:
        raise AssertionError("exact branch did not call the batched forecast path")

    base = built["base"]
    incumbent = built["incumbent"]
    current = built["current_evaluator"]
    base_profile = current._evaluated[base.configuration_id]
    base_projections = captured_forecasts[base.configuration_id]
    rekeyed = pilot.ENGINE._rekeyed_users(tape, step_index)
    row_indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    from mcrl.physics_v025.targets import c1_difference_surplus, c2_persistence_forecast

    view_payloads = []
    physics_rows = []
    configurations = {}
    gauge_max = Fraction()
    decomposition_max = Fraction()
    c2_decomposition_max = Fraction()
    attribution_max = 0.0
    default_phi = pilot.ENGINE._phi_for(
        incumbent, base, cell_rekeyed_users=rekeyed
    )
    for row in built["rows"]:
        identity = pilot._identity(row.action)
        mapping = base.mapping
        mapping[row.user_id] = identity
        config = pilot.ENGINE._configuration(base, mapping, kind="exact-source-attribution")
        profile = current._evaluated[config.configuration_id]
        candidate_phi = pilot.ENGINE._phi_for(
            incumbent, config, cell_rekeyed_users=rekeyed
        )
        c1 = c1_difference_surplus(
            profile.outcome(phi=candidate_phi),
            base_profile.outcome(phi=default_phi),
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        c2 = c2_persistence_forecast(
            captured_forecasts[config.configuration_id],
            base_projections,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        c1_residual = c1.normalized_total - (
            c1.difference_surplus_bits / calibration.kappa_bits_per_user_step
            + c1.phi_difference
        )
        c2_residual = c2.normalized_total - (
            (c2.forecast_surplus_bits - c2.persistence_penalty_bits)
            / calibration.kappa_bits_per_user_step
        )
        decomposition_max = max(decomposition_max, abs(c1_residual))
        c2_decomposition_max = max(c2_decomposition_max, abs(c2_residual))
        if row.reference_action:
            gauge_max = max(gauge_max, abs(c1.normalized_total))
        attribution_max = max(
            attribution_max,
            abs(math.fsum(profile.score.bits.values()) - profile.bits),
            abs(math.fsum(base_profile.score.bits.values()) - base_profile.bits),
        )
        surrogate = surrogate_labels(
            pilot,
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            user=row.user_id,
            identity=identity,
            base=base,
            incumbent=incumbent,
            config=config,
            calibration=calibration,
            row_indices=row_indices,
        )
        row_key = f"u{row.user_id:03d}-a{row.action_index:03d}"
        view = row.payload()
        view["exact_source_view"] = {
            "schema": "mcrl-v025-exact-source-view-extension-v1",
            "row_key": row_key,
            "physics_configuration_id": config.configuration_id,
            "c1_difference_surplus": {
                "core_bits": fraction_payload(c1.difference_surplus_bits),
                "phi_difference": fraction_payload(c1.phi_difference),
                "normalized_total": fraction_payload(c1.normalized_total),
                "decomposition_residual": fraction_payload(c1_residual),
            },
            "c2_persistence_forecast": {
                "forecast_surplus_bits": fraction_payload(c2.forecast_surplus_bits),
                "lost_offsets": c2.lost_offsets,
                "persistence_penalty_bits": fraction_payload(c2.persistence_penalty_bits),
                "label_bits": fraction_payload(
                    c2.forecast_surplus_bits - c2.persistence_penalty_bits
                ),
                "normalized_total": fraction_payload(c2.normalized_total),
                "decomposition_residual": fraction_payload(c2_residual),
            },
            "surrogate": surrogate,
            "evaluation_path": {
                "exact_candidate_current": "evaluate_many then cache access",
                "exact_default_current": "evaluate_many then cache access",
                "exact_candidate_forecasts": "evaluate_many",
                "exact_default_forecasts": "evaluate_many",
                "c1_target": "c1_difference_surplus",
                "c2_target": "c2_persistence_forecast",
                "surrogate": "provider-primitive-array-lookup",
                "boundary_indices": [0],
            },
        }
        view_payloads.append(view)

        candidate_geometry = []
        default_geometry = []
