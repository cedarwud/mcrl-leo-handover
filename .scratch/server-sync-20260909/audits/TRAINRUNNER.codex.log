"""Contract tests for the C3 panel instrument (DIAGNOSTIC_NOT_CLAIM)."""

from __future__ import annotations

from fractions import Fraction
from pathlib import Path

import pytest

from mcrl.stagec_v025.c3_panel import (
    ArmPlan,
    PANEL_ARM_ORDER,
    PANEL_LEARNED_ARMS,
    PANEL_SOURCE_MAP,
    PanelTrainer,
    PhysicalCacheKey,
    PhysicalOutcomeCache,
    ScoredConfiguration,
    canonical_assignment,
    degeneracy_report,
    first_improvement,
    provisioning_rule,
    select_then_realise,
)
from mcrl.stagec_v025.canonical import StageCContractError
from mcrl.stagec_v025.learner import (
    ROUTES,
