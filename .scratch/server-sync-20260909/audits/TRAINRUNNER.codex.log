            "rule": rule,
            "seed": baseline_rows[0].assignment,
            "ordered_unilateral_scores_hex": [
                row.nominal_score.hex() for row in baseline_rows
            ],
            "fixed_point": baseline_rows[0].assignment,
        })
        screen_row = {
            "anchor_id": f"{tape.domain}|0|{REFERENCE_CARRIERS[0]}|{rule}",
            "reference": {
                "bits": base_profile["bits"],
                "joules": base_profile["joules"],
                "head_independent": True,
                "fixed_point_certified": True,
                "certificate_sha256": reference_certificate,
            },
            "outcomes": tier["outcomes"],
        }

        contrasts = tuple(
            (f"FULL-minus-{arm}", "FULL", arm)
            for arm in (*PANEL_LEARNED_ARMS[1:], "BASELINE")
        )
        screens[rule] = degeneracy_report((screen_row,), contrasts)

    result = {
        "label": LABEL,
        "smoke_test_not_evidence": True,
        "production_training_run": False,
        "policy_run": False,
        "worker_processes_used_peak": 2,
        "process_limit": 4,
        "world": tape.domain,
        "anchors": 2,
        "learner_seeds": 1,
        "source_epochs": 2,
        "panel_arms": len(PANEL_ARM_ORDER),
        "learned_arms": len(PANEL_LEARNED_ARMS),
        "tape_build_seconds": tape_seconds,
        "exact_row_build_seconds": exact_seconds,
        "primitive_row_build_seconds": primitive_seconds,
        "exact_row_seconds_per_anchor": sum(exact_seconds) / len(exact_seconds),
        "source_rows": sum(len(built["rows"]) for built in exact_builds),
        "coalition_rows": len(exact_builds),
        "exact_assertions": assertions,
        "surrogate_difference_witness_counts": differences,
        "training_seconds": train_seconds,
        "training_seconds_per_arm_per_epoch": train_seconds / len(PANEL_LEARNED_ARMS) / 2,
        "training": training,
        "arm_owned_plans": plan_diagnostics,
        "arm_owned_plan_build_seconds_per_anchor": plan_build_seconds,
        "tier": tier_rows,
        "screen_by_provisioning_rule": screens,
        "provisioning_rule_note": (
            "Both named branches use the verified read-only sealed harness evaluators. "
            "The child adapter is single-process and uses the pre-existing 0.10 judged "
            "fading quantile from that harness."
        ),
        "fallback_constant_unchanged": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True,
    }
    result["smoke_wall_seconds"] = time.perf_counter() - smoke_started
    path = output / "smoke.json"
    path.write_text(json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
    return result


