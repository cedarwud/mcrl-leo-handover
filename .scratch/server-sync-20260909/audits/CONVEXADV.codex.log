@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""DIAGNOSTIC_NOT_CLAIM: deterministic common-channel fading integration.
+
+The provisioners retain their original powers/eligibility. This local copy
+compares expected ACM capacity and expected contract-clamped bits under the
+same production Rician/shadow/scintillation distribution. No sample paths,
+seed/horizon changes, policy, training, or production edits.
+"""
+from __future__ import annotations
+import json
+import math
+from pathlib import Path
+import numpy as np
+from a15_numerator_discriminator import gain, optimize
+from mcrl.physics_v025.acm import ACM_MODES, ACMRate
+from mcrl.physics_v025.channel import noise_power_w, scintillation_loss_db, shadow_sigma_db
+from mcrl.physics_v025.constants_v025 import BEAM_BANDWIDTH_HZ as B, SINR_MIN, RATE_TARGET_BPS as RATE
+from mcrl.stagec_v025.mechanism_corpus import _rician_power_cdf, engine_table_q10
+
+OUT = Path(__file__).resolve().parent
+
+
+def cdf(thresholds, order=192):
+    nodes, weights = np.polynomial.hermite.hermgauss(order)
+    inverse_shadow = 10 ** ((float(shadow_sigma_db(30.0))*math.sqrt(2)*nodes +
+                            float(scintillation_loss_db(30.0)))/10)
+    return _rician_power_cdf(np.asarray(thresholds)[:, None]*inverse_shadow) @ (weights/math.sqrt(math.pi))
+
+
+def main():
+    baseline = json.loads((OUT/'a15_results.json').read_text())
+    thresholds = np.asarray(sorted({max(SINR_MIN, m.threshold_linear) for m in ACM_MODES}))
+    model = ACMRate()
+    mode_rates = np.asarray([model.rate_bps(float(np.nextafter(t, np.inf)), B) for t in thresholds])
+    out = {'label':'DIAGNOSTIC_NOT_CLAIM', 'rules': {},
+           'fading_cdf_at_one':float(cdf([1])[0]),
+           'fading_cdf_at_q10':float(cdf([engine_table_q10(30)])[0])}
+    for name, data in baseline['rules'].items():
+        rows = {}
+        for key, row in data['rows'].items():
+            n = int(key)
+            nominal_sinr = row['rf']*gain()/noise_power_w(B)
+            f = cdf(thresholds/nominal_sinr)
+            probability = np.maximum(0, np.diff(np.append(f, 1.0)))
+            assert float(np.sum(probability)) <= 1+1e-12
+            delivered = float(mode_rates@probability)
+            contract = float(np.minimum(mode_rates, n*RATE)@probability)
+            assert contract <= n*RATE*(1+1e-12)
+            rows[n] = dict(row, delivered=delivered, target=contract,
+                expected_acm_mbps=delivered/1e6, expected_contract_mbps=contract/1e6,
+                target_attainment_probability=float(np.sum(probability[mode_rates>=n*RATE])))
+        results = {f'{credit}_fixed_{fixed}':optimize(24, rows, credit=credit, fixed=fixed)
+                   for credit in ['delivered','target'] for fixed in [True,False]}
+        out['rules'][name] = {'rows':rows, 'optima':results}
+        print(name, results)
+    # Quadrature stability check at every threshold used, no stochastic test.
+    max_diff = 0.0
+    for data in baseline['rules'].values():
+        for row in data['rows'].values():
+            nominal_sinr = row['rf']*gain()/noise_power_w(B)
+            max_diff=max(max_diff,float(np.max(np.abs(cdf(thresholds/nominal_sinr,128)-cdf(thresholds/nominal_sinr,192)))))
+    out['maximum_cdf_difference_128_vs_192']=max_diff
+    (OUT/'a7_common_fading.json').write_text(json.dumps(out,indent=2)+'\n')
+    print('CDF at1/q10',out['fading_cdf_at_one'],out['fading_cdf_at_q10'],'quadrature difference',max_diff)
+
+
+if __name__ == '__main__':
+    main()
