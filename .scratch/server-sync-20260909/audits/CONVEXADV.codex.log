                result['perturbations'].append(dict(rule=rule,n=n,angle=a,distance=r,
                    angle_delta=da,range_delta=dr,best=opt['partition'],
                    stays_same=opt['partition']==row['best']))
    (OUT/'a6_geometry.json').write_text(json.dumps(result,indent=2)+'\n')
    for key,rows in result['switches'].items():
        feasible=[r for r in rows if r['old_feasible']]
        print(key, 'changes',len(rows),'cap_forced',len(rows)-len(feasible),
