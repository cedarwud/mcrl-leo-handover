OUT = Path('.scratch/convexity-adversarial')


@lru_cache(None)
def partitions(total, minimum=1):
    if total == 0:
        return ((),)
    return tuple((n,) + rest for n in range(minimum, min(12, total) + 1)
                 for rest in partitions(total-n, n))


def targets(part):
    return np.array([rate_target_sinr(RATE, BW, n) for n in part])


def delivered(part):
    return sum(BW * rate_target_mode(RATE, BW, n).spectral_efficiency_bit_per_s_hz
               for n in part)


def power_receipt(powers):
    inventory = HardwareInventory.fixed((1, b) for b in range(len(powers)))
    return interval_energy(inventory, EnergyInterval(1., {(1,b): float(p)
                            for b,p in enumerate(powers)}))


@lru_cache(None)
def pair_solve(part, coupling, pair, rule):
    factor = 1. if rule == 'SEALED' else Q10
    k = len(part)
    direct = np.full(k, GAIN * factor)
    cross = np.zeros((k,k))
    if pair is not None:
        i,j = pair
        cross[i,j] = cross[j,i] = GAIN * factor * coupling
    power, cert = _solve_power(direct, cross, np.full(k,NOISE), np.full(k,CAP),
        tuple(range(k)), CONFIG, target_sinr=targets(part), enforce_target_clearance=True)
    actual = power * direct / (NOISE + cross @ power)
    feasible = cert.valid and bool(np.all(actual >= targets(part)))
    energy = power_receipt(power).joules
    return dict(partition=list(part), coupling=coupling, pair=pair,
                power_w=power.tolist(), energy_w=energy, feasible=feasible,
                delivered_mbps=delivered(part)/1e6,
                ee_mbit_j=delivered(part)/energy/1e6,
                max_interference_noise_ratio=float(np.max(cross@power/NOISE)),
                certificate=cert.status, iterations=cert.iterations)


def full_radiation(part, direct, cross, colors, rule='SEALED'):
    # MARGIN is explicitly a copied geometry with coherent same-satellite fade.
    factor = 1. if rule == 'SEALED' else Q10
    user_beams = np.repeat(np.arange(len(part)), part)
    links = tuple(Link(i,(1,int(b)),int(colors[b]),float(direct[b]*factor))
                  for i,b in enumerate(user_beams))
    user_cross = cross[user_beams[:,None],user_beams[None,:]]*factor
    geometry = Geometry(links,user_cross)
    result = AngleRateTPC_TDM().radiate(CONFIG,geometry,'nominal')
    inventory = HardwareInventory.fixed({link.beam for link in links})
    energy = schedule_energy(inventory, ((s.fraction,dict(s.beam_rf_w)) for s in result.slots),duration_s=1.)
    model = ACMRate()
    rates = dict.fromkeys(range(sum(part)),0.)
    max_in = 0.
    for slot in result.slots:
        for tx in slot.transmissions:
            max_in = max(max_in, tx.interference_w/tx.noise_w)
            if model.served(tx.sinr,allocated=True):
                rates[tx.user_id] += slot.fraction*model.rate_bps(tx.sinr,tx.bandwidth_hz)
    return dict(partition=list(part), rule=rule, feasible=all(result.rate_target_attained.values()),
                target_attained_count=int(sum(result.rate_target_attained.values())),
                controller_feasible_count=int(sum(result.per_user_rate_target_feasible.values())),
                min_rate_mbps=min(rates.values())/1e6,
                delivered_mbps=sum(rates.values())/1e6,energy_w=energy.joules,
                ee_mbit_j=sum(rates.values())/energy.joules/1e6,
                max_interference_noise_ratio=max_in,
                certificate=result.certificate.status,
                max_rf_w=max(p for s in result.slots for _,p in s.beam_rf_w))


def optimum_minimal_pair(coupling,rule):
    # k=3 can use all three colors. For k=4, one cochannel pair is necessary.
    # Exhaustive zero-coupling upper bounds certify that k>4 cannot win here.
    baseline=pair_solve((8,8,8),0.,None,rule)
    candidates=[baseline]
    counts=dict(enumerated=0, isolated_feasible=0, pruned_by_isolated_bound=0,
                pair_evaluated=0)
    for part in partitions(24):
        counts['enumerated'] += 1
        isolated=pair_solve(part,0.,None,rule)
        if not isolated['feasible']:
            continue
        counts['isolated_feasible'] += 1
        if isolated['ee_mbit_j'] <= baseline['ee_mbit_j']:
            counts['pruned_by_isolated_bound'] += 1
            continue
        if len(part) <= 3:
            candidates.append(isolated)
        else:
            assert len(part)==4, 'An unhandled candidate invalidates the pruning certificate'
            for pair in itertools.combinations(range(4),2):
                row=pair_solve(part,coupling,pair,rule)
                counts['pair_evaluated'] += 1
                if row['feasible']:
                    candidates.append(row)
    winner=max(candidates,key=lambda x:x['ee_mbit_j'])
    return dict(winner=winner, counts=counts,
                challengers=sorted(candidates,key=lambda x:x['ee_mbit_j'],reverse=True))


def hex_geometry(k, same_color=False):
    # A physical spherical-Earth sample: reference user at 30 degrees and 750 km.
    # Satellite altitude is derived, not prescribed inconsistently.
    seed_grid=build_cell_grid(altitude_km=400.)
    origin=seed_grid.centers_ecef_km[np.flatnonzero(np.all(seed_grid.axial==0,axis=1))[0]]
    up=origin/np.linalg.norm(origin)
    east=np.cross(np.array([0.,0.,1.]),up);east/=np.linalg.norm(east)
    satellite=origin+750.*(math.cos(math.radians(30))*east+math.sin(math.radians(30))*up)
    altitude=float(np.linalg.norm(satellite)-R_E_KM)
    grid=build_cell_grid(altitude_km=altitude)
    ids=sorted(range(grid.count), key=lambda j:(float(np.dot(grid.centers_km[j],grid.centers_km[j])),
                                               int(grid.axial[j,0]),int(grid.axial[j,1])))
    if same_color:
        ids=[j for j in ids if grid.colors[j]==0]
    ids=ids[:k]
    centers=grid.centers_ecef_km[ids]
    rays=centers-satellite
    slant=np.linalg.norm(rays,axis=1)
    elevation=np.degrees(np.arcsin(np.sum(-rays*centers/np.linalg.norm(centers,axis=1)[:,None],axis=1)/slant))
    unit=rays/slant[:,None]
    angles=np.degrees(np.arccos(np.clip(unit@unit.T,-1.,1.)))
    np.fill_diagonal(angles,0.)
    path=LegacyWorldProvider._nominal_path_without_scintillation(slant,elevation,np.full(k,RX))
    direct=np.asarray(transmit_gain_linear(np.zeros(k))*path)
    cross=np.asarray(transmit_gain_linear(angles)*path[:,None])
    np.fill_diagonal(cross,0.)
    colors=grid.colors[ids]
    active=(colors[:,None]==colors[None,:]) & ~np.eye(k,dtype=bool)
    ratios=cross/direct[:,None]
    return direct,cross,colors,dict(altitude_km=altitude,axial=grid.axial[ids].tolist(),
        colors=colors.tolist(),slant_km=slant.tolist(),elevation_deg=elevation.tolist(),
        min_cochannel_angle_deg=float(np.min(angles[active])) if np.any(active) else None,
        max_cross_direct_ratio=float(np.max(ratios[active])) if np.any(active) else 0.)


def main():
    rows={}
    couplings=[0.,1e-5,5e-5,1e-4, float(transmit_gain_linear(4.98)/transmit_gain_linear(0.)),
               float(transmit_gain_linear(5.75)/transmit_gain_linear(0.)), .001,.002,.003,.005,
               float(transmit_gain_linear(4.)/transmit_gain_linear(0.)), .01,.04,.1,.3]
    for rule in ['SEALED','MARGIN']:
        sweep=[]
        for c in couplings:
            opt=optimum_minimal_pair(c,rule)
            w=opt['winner']
            part=w['partition']; k=len(part)
            cross=np.zeros((k,k));colors=list(range(k))
            if k==4:
                i,j=w['pair'];cross[i,j]=cross[j,i]=GAIN*c
                colors=[1,2,1,2];colors[i]=colors[j]=0
                other=[b for b in range(4) if b not in [i,j]]
                colors[other[0]]=1;colors[other[1]]=2
            full=full_radiation(part,np.full(k,GAIN),cross,colors,rule)
            assert full['feasible'] and abs(full['ee_mbit_j']-w['ee_mbit_j'])<1e-6
            opt['full_endpoint']=full
            sweep.append(dict(coupling=c,**opt))
        low,high=0.,.02
        for _ in range(40):
            mid=(low+high)/2
            if len(optimum_minimal_pair(mid,rule)['winner']['partition'])==3:high=mid
            else:low=mid
        rows[rule]=dict(sweep=sweep, transition_coupling=(low+high)/2,
            transition_db=10*math.log10((low+high)/2))
    hex_rows=[]
    # Explicitly finite candidate comparisons, not a global placement optimization.
    for same_color in [False,True]:
        for part in [(8,8,8),(3,7,7,7),(4,4,4,4,4,4),(3,)*8,(2,)*12,(1,)*24]:
            direct,cross,colors,meta=hex_geometry(len(part),same_color)
            # For the two key layouts, enumerate every distinct occupancy ordering.
            assignments=sorted(set(itertools.permutations(part))) if len(set(part))>1 else [part]
            for rule in ['SEALED','MARGIN']:
                trials=[full_radiation(p,direct,cross,colors,rule) for p in assignments]
                uncoupled_trials=[full_radiation(p,direct,np.zeros_like(cross),colors,rule) for p in assignments]
                feasible=[row for row in trials if row['feasible']]
                best=max(feasible or trials,key=lambda row:row['ee_mbit_j'])
                hex_rows.append(dict(same_color_only=same_color,geometry=meta,result=best,
                                     uncoupled=max(uncoupled_trials,key=lambda row:row['ee_mbit_j']),
                                     assignments_tested=len(assignments)))
    result=dict(label='DIAGNOSTIC_NOT_CLAIM',noise_w=NOISE,gain=GAIN,q10=Q10,
                pair_sweep=rows,hex_checks=hex_rows)
    (OUT/'a2_results.json').write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps(dict(pair_summary={r:{'transition':v['transition_coupling'],
        'transition_db':v['transition_db'],'sweep':[(x['coupling'],x['winner']['partition'],
        x['winner']['ee_mbit_j']) for x in v['sweep']]} for r,v in rows.items()},
        hex_checks=hex_rows),indent=2))


if __name__=='__main__':main()

