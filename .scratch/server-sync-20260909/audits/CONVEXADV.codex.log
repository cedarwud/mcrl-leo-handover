#!/usr/bin/env python3
"""DIAGNOSTIC_NOT_CLAIM: adversarial placement and feasibility audit.

Unchanged production scalar resolution is used for every isolated occupancy.
MARGIN is explicitly a copied diagnostic geometry whose controller/design gain
is q10 times nominal. No production module, constant, or guard is modified.
The separately labelled NO_RF_CAP analytic counterfactual is never substituted
into production resolution. No training, policy, temporal horizon, or seed.
"""
from __future__ import annotations

from dataclasses import asdict
from functools import lru_cache
import json
import math
from pathlib import Path

import numpy as np

from mcrl.physics_v025.acm import ACMRate, rate_target_mode, rate_target_sinr, select_mode
from mcrl.physics_v025.architectures import AngleRateTPC_TDM, Geometry, Link, RadiationConfig
from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W, BEAM_BANDWIDTH_HZ, BEAM_RF_CAP_W,
    CIRCUIT_POWER_PER_CHAIN_W, RATE_TARGET_BPS, RX_GAIN_MAX_DBI, TX_FULL_HPBW_DEG,
)
from mcrl.physics_v025.energy import HardwareInventory, pa_supply_power_w
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.resolution import resolve_configuration
from mcrl.stagec_v025.mechanism_corpus import engine_table_q10

OUT = Path(__file__).resolve().parent


def direct_gain(theta: float, slant: float) -> float:
    path = LegacyWorldProvider._nominal_path_without_scintillation(
        np.asarray(slant), np.asarray(30.0), np.asarray(10.0 ** (RX_GAIN_MAX_DBI / 10.0)),
    )
    return float(path * transmit_gain_linear(np.asarray(theta)))


@lru_cache(None)
def parts(n: int, smallest: int = 1) -> tuple[tuple[int, ...], ...]:
    if n == 0:
        return ((),)
    return tuple((i,) + tail for i in range(smallest, n + 1)
                 for tail in parts(n - i, i))


def geometry_for(partition: tuple[int, ...], gain: float, ceiling: int) -> Geometry:
    links = []
    for beam_index, n in enumerate(partition):
        identity = (1000 + beam_index // ceiling, beam_index % ceiling)
        first_user = len(links)
        links.extend(Link(first_user + j, identity, beam_index % 3, gain)
                     for j in range(n))
    return Geometry(tuple(links), np.zeros((sum(partition), sum(partition))))


def solve(partition: tuple[int, ...], gain: float, ceiling: int = 39) -> dict:
    geometry = geometry_for(partition, gain, ceiling)
    result = resolve_configuration(
        AngleRateTPC_TDM(), RadiationConfig(), geometry, ACMRate(),
        HardwareInventory.fixed(set(link.beam for link in geometry.links)),
        duration_s=1.0, field="nominal",
    )
    assert result.valid and result.energy is not None
    rates = list(result.average_rate_bps.values())
    txs = [tx for slot in result.radiation.slots for tx in slot.transmissions]
    return {
        "partition": partition, "satellites": math.ceil(len(partition) / ceiling),
        "power_w": result.energy.joules, "energy_receipt": asdict(result.energy),
        "delivered_bps": math.fsum(rates), "rates_bps": rates,
        "min_rate_bps": min(rates), "max_rate_bps": max(rates),
        "contract_credited_bps": math.fsum(min(r, RATE_TARGET_BPS) for r in rates),
        "complete_service_users": sum(result.complete_service.values()),
        "target_attained_users": sum(result.rate_target_attained.values()),
        "target_feasible_users": sum(result.rate_target_feasible.values()),
        "all_service": all(result.complete_service.values()),
        "all_target": all(result.rate_target_attained.values()),
        "ee_mbit_per_j": math.fsum(rates) / result.energy.joules / 1e6,
        "contract_ee_mbit_per_j": math.fsum(min(r, RATE_TARGET_BPS) for r in rates) / result.energy.joules / 1e6,
        "min_rf_w": min(tx.rf_power_w for tx in txs),
        "max_rf_w": max(tx.rf_power_w for tx in txs),
        "modes": sorted({select_mode(tx.sinr).name for tx in txs}),
        "certificate": asdict(result.radiation.certificate),
    }


def curve(gain: float) -> dict[int, dict]:
    rows = {n: solve((n,), gain) for n in range(1, 25)}
    for n, row in rows.items():
        target = rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, n)
        row["uncapped_required_rf_w"] = None if target is None else target * noise_power_w(BEAM_BANDWIDTH_HZ) / gain
        row["original_filter_pass"] = target is not None and row["uncapped_required_rf_w"] <= BEAM_RF_CAP_W
    return rows


def optimize(n: int, rows: dict[int, dict], *, admission: str = "original_filter_pass",
             numerator: str = "delivered_bps", ceiling: int = 39,
             available_satellites: int | None = None) -> dict | None:
    best = None
    for partition in parts(n):
        if not all(rows[i][admission] for i in partition):
            continue
        satellites = math.ceil(len(partition) / ceiling)
        if available_satellites is not None and satellites > available_satellites:
            continue
        delivered = math.fsum(rows[i][numerator] for i in partition)
        pa = math.fsum(rows[i]["energy_receipt"]["pa_j"] for i in partition)
        power = pa + len(partition) * CIRCUIT_POWER_PER_CHAIN_W + satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
        key = (delivered / power, -len(partition), partition)
        if best is None or key > best[0]:
            best = (key, {"partition": partition, "beams": len(partition), "satellites": satellites,
                          "power_w": power, "credited_bps": delivered,
                          "ee_mbit_per_j": delivered / power / 1e6,
                          "min_user_rate_bps": min(rows[i]["min_rate_bps"] for i in partition)})
    return None if best is None else best[1]


def no_cap_counterfactual(gain: float, rows: dict[int, dict]) -> dict[int, dict]:
    """Clearly separate analytic variant: remove only cap, retain mode table."""
    result = {}
    for n in range(1, 13):
        mode = rate_target_mode(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, n)
        required = rows[n]["uncapped_required_rf_w"]
        delivered = BEAM_BANDWIDTH_HZ * mode.spectral_efficiency_bit_per_s_hz
        result[n] = {"original_filter_pass": True, "delivered_bps": delivered,
                     "energy_receipt": {"pa_j": pa_supply_power_w(required)},
                     "min_rate_bps": delivered / n}
    # No invented no-mode continuation: n>=13 remains impossible for contract.
    for n in range(13, 25):
        result[n] = {"original_filter_pass": False}
    return result


def run() -> None:
    output = {"label": "DIAGNOSTIC_NOT_CLAIM", "q10": engine_table_q10(30.0),
              "curves": {}, "placement": [], "grid_feasibility": [],
              "production_winner_checks": [], "placement_changes": {}}
    for rule in ("SEALED", "MARGIN_DIAGNOSTIC_GAIN_COPY"):
        divisor = 1.0 if rule == "SEALED" else output["q10"]
        gain = direct_gain(0.0, 750.0) * divisor
        rows = curve(gain)
        output["curves"][rule] = rows
        for ceiling in (1, 2, 3, 4, 12, 39):
            row = {"rule": rule, "ceiling": ceiling}
            for admission in ("original_filter_pass", "all_target", "all_service"):
                row[admission] = optimize(24, rows, admission=admission, ceiling=ceiling)
            row["only_one_available_satellite"] = optimize(24, rows, ceiling=ceiling, available_satellites=1)
            output["placement"].append(row)
            base = {n: optimize(n, rows) for n in range(1, 25)}
            changed = []
            for n in range(1, 25):
                altered = optimize(n, rows, ceiling=ceiling)
                if altered["partition"] != base[n]["partition"]:
                    changed.append({"N": n, "baseline": base[n], "altered": altered})
            output["placement_changes"][f"{rule}_ceiling_{ceiling}"] = changed
        # Scalar full-partition checks certify additive enumeration receipts.
        for admission in ("original_filter_pass", "all_service"):
            for ceiling in (1, 3, 39):
                winner = optimize(24, rows, admission=admission, ceiling=ceiling)
                actual = solve(winner["partition"], gain, ceiling)
                assert math.isclose(actual["ee_mbit_per_j"], winner["ee_mbit_per_j"], rel_tol=1e-12)
                output["production_winner_checks"].append({"rule": rule, "admission": admission,
                                                            "ceiling": ceiling, "receipt": actual})
        for theta in (0.0, TX_FULL_HPBW_DEG / 4, TX_FULL_HPBW_DEG / 2):
            for slant in (500.0, 750.0, 1000.0):
                grid_gain = direct_gain(theta, slant) * divisor
                grid_rows = rows if theta == 0.0 and slant == 750.0 else curve(grid_gain)
                no_cap_rows = no_cap_counterfactual(grid_gain, grid_rows)
                for n in range(1, 25):
                    original = optimize(n, grid_rows)
                    service = optimize(n, grid_rows, admission="all_service")
                    contract_clamped = optimize(n, grid_rows, admission="all_service", numerator="contract_credited_bps")
                    target = optimize(n, grid_rows, admission="all_target")
                    no_cap = optimize(n, no_cap_rows)
                    output["grid_feasibility"].append({"rule": rule, "theta_deg": theta,
                                                       "slant_km": slant, "N": n,
                                                       "original": original, "all_service": service,
                                                       "all_target": target, "clamped_service": contract_clamped,
                                                       "NO_RF_CAP_ANALYTIC_COUNTERFACTUAL": no_cap})
    (OUT / "a34_results.json").write_text(json.dumps(output, indent=2, default=lambda v: v.item()) + "\n")
    print("Wrote", OUT / "a34_results.json")
    for row in output["placement"]:
        print("PLACEMENT", row["rule"], row["ceiling"], row["original_filter_pass"], "single_sat", row["only_one_available_satellite"])
    for rule, rows in output["curves"].items():
        for n in (9, 10, 11, 12, 13, 24):
            r = rows[n]
            print("BEAM", rule, n, r["max_rf_w"], r["modes"], r["min_rate_bps"] / 1e6,
                  r["complete_service_users"], r["target_attained_users"], r["ee_mbit_per_j"])
    for rule in output["curves"]:
        grid = [r for r in output["grid_feasibility"] if r["rule"] == rule]
        for alternative in ("all_service", "all_target", "NO_RF_CAP_ANALYTIC_COUNTERFACTUAL"):
            changed = [r for r in grid if r[alternative]["partition"] != r["original"]["partition"]]
            print("GRID", rule, alternative, "changed", len(changed), "/", len(grid))
            for r in changed:
                print(" CHANGE", r["theta_deg"], r["slant_km"], r["N"], r["original"], r[alternative])


if __name__ == "__main__":
    run()

