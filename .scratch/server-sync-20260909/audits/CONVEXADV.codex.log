+#!/usr/bin/env python3
+"""DIAGNOSTIC_NOT_CLAIM: independent occupancy attacks; no sealed edits.
+
+Production a-r, ACM, gain and energy functions supply the baseline. All changed
+objectives/PA laws/smooth target curves below are local, labelled variants.
+No policy, training, world generation, random sampling, or configuration edits.
+"""
+from __future__ import annotations
+
+from functools import lru_cache
+import hashlib
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+from mcrl.physics_v025.acm import ACMRate, rate_target_mode, rate_target_sinr
+from mcrl.physics_v025.architectures import AngleRateTPC_TDM, Geometry, Link, RadiationConfig
+from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
+from mcrl.physics_v025.constants_v025 import (
+    BEAM_BANDWIDTH_HZ as B, BEAM_RF_CAP_W as CAP,
+    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W as BASE,
+    CIRCUIT_POWER_PER_CHAIN_W as CHAIN, RATE_TARGET_BPS as RATE,
+    RX_GAIN_MAX_DBI, IMPLEMENTATION_MARGIN_DB, SINR_MIN,
+)
+from mcrl.physics_v025.energy import HardwareInventory, pa_supply_power_w, schedule_energy
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.stagec_v025.mechanism_corpus import engine_table_q10
+
+OUT = Path(__file__).resolve().parent
+
+
+def gain(theta=0.0, slant=750.0):
+    return float(transmit_gain_linear(np.asarray(theta)) *
+                 LegacyWorldProvider._nominal_path_without_scintillation(
+                     np.asarray(slant), np.asarray(30.0), np.asarray(10 ** (RX_GAIN_MAX_DBI / 10))))
+
+
+@lru_cache(None)
+def parts(n, ceiling=24):
+    # Descending enumeration, independent of the report's ascending recursion.
+    if n == 0:
+        return ((),)
+    return tuple((i,) + tail for i in range(min(n, ceiling), 0, -1)
+                 for tail in parts(n-i, i))
+
+
+def production_beam(n, divisor=1.0):
+    # MARGIN is a separate synthetic geometry copy: design gain q10*g.
+    g = gain() * divisor
+    geo = Geometry(tuple(Link(u, (1, 0), 0, g) for u in range(n)), np.zeros((n, n)))
+    result = AngleRateTPC_TDM().radiate(RadiationConfig(), geo, 'nominal')
+    rate = ACMRate()
+    delivered = math.fsum(s.fraction * rate.rate_bps(t.sinr, t.bandwidth_hz)
+                          for s in result.slots for t in s.transmissions)
+    energy = schedule_energy(HardwareInventory.fixed([(1, 0)]),
+                             [(s.fraction, dict(s.beam_rf_w)) for s in result.slots], duration_s=1.0)
+    assert result.valid
+    return dict(n=n, delivered=delivered, target=n*RATE, pa=energy.pa_j,
+                power=energy.joules, rf=math.fsum(s.fraction*sum(dict(s.beam_rf_w).values()) for s in result.slots),
+                target_attained=all(result.rate_target_attained.values()),
+                controller_feasible=all(result.per_user_rate_target_feasible.values()),
+                mode=None if rate_target_mode(RATE, B, n) is None else rate_target_mode(RATE, B, n).name)
+
+
+def score(p, rows, credit='delivered', fixed=True, cost='pa'):
+    power = math.fsum(rows[n][cost] for n in p) + (len(p)*CHAIN + BASE if fixed else 0)
+    rate = math.fsum(rows[n][credit] for n in p)
+    return dict(partition=sorted(p), power_w=power, rate_mbps=rate/1e6, ee_mbit_j=rate/power/1e6)
+
+
+def optimize(n, rows, **kw):
+    candidates = [score(p, rows, **kw) for p in parts(n)
+                  if all(i in rows and rows[i]['target_attained'] for i in p)]
+    return max(candidates, key=lambda r: (r['ee_mbit_j'], -len(r['partition']), r['partition']))
+
+
+def main():
+    files = sorted(Path('src/mcrl/physics_v025').glob('*.py'))
+    before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+    output = {'label': 'DIAGNOSTIC_NOT_CLAIM', 'gain': gain(), 'noise': noise_power_w(B),
+              'q10': engine_table_q10(30), 'rules': {}}
+    for rule, divisor in [('SEALED', 1.0), ('MARGIN_DIAGNOSTIC', engine_table_q10(30))]:
+        rows = {n: production_beam(n, divisor) for n in range(1, 25)}
+        # Independent analytic check against actual solver, including its nudge.
+        relerr = []
+        for n, row in rows.items():
+            gamma = rate_target_sinr(RATE, B, n)
+            if gamma is not None and row['controller_feasible']:
+                expected = gamma*noise_power_w(B)/(gain()*divisor)
+                relerr.append(abs(row['rf']/expected-1))
+                assert abs(row['rf']/expected-1) < 3e-9
+        optima = {}
+        for fixed in [True, False]:
+            for credit in ['delivered', 'target']:
+                key = f'{credit}_fixed_{fixed}'
+                optima[key] = [optimize(n, rows, credit=credit, fixed=fixed) for n in range(1, 25)]
+        one_beam = {f'{credit}_fixed_{fixed}': max(
+            [score((n,), rows, credit=credit, fixed=fixed) for n in rows if rows[n]['target_attained']],
+            key=lambda r: r['ee_mbit_j']) for credit in ['delivered', 'target'] for fixed in [True, False]}
+        output['rules'][rule] = dict(rows=rows, optima=optima, one_beam=one_beam,
+            solver_rf_max_relative_error= max(relerr),
+            candidate_comparisons={f'{credit}_fixed_{fixed}': [score(p, rows, credit=credit, fixed=fixed)
+                 for p in [(3, 7, 7, 7), (8, 8, 8), (4, 4, 4, 4, 4, 4), (1,)*24]]
+                 for credit in ['delivered', 'target'] for fixed in [True, False]})
+    # Smooth diagnostic copies replace only the target SINR curve. Keep the
+    # production service floor, bandwidth, rate, noise, gain, RF cap, PA law.
+    smooth = {}
+    for rule, divisor in [('SEALED', 1.0), ('MARGIN_DIAGNOSTIC', engine_table_q10(30))]:
+        rows = {}
+        for n in range(1, 25):
+            gamma = max(SINR_MIN, 10**(IMPLEMENTATION_MARGIN_DB/10)*(2**(RATE*n/B)-1))
+            p = gamma * noise_power_w(B)/(gain()*divisor)
+            rows[n] = dict(rf=p, pa=pa_supply_power_w(p), target=n*RATE, delivered=n*RATE,
+                           target_attained=p <= CAP)
+        # Linear PA comparison is a separate local diagnostic cost p; scaling
+        # by any constant efficiency cannot affect zero-fixed optima.
+        smooth[rule] = dict(rows=rows, sqrt_zero_fixed=optimize(24, rows, credit='target', fixed=False),
+                            linear_zero_fixed=optimize(24, rows, credit='target', fixed=False, cost='rf'),
+                            sqrt_fixed=optimize(24, rows, credit='target', fixed=True))
+    low, high = 0.1, 3.0
+    for _ in range(70):
+        x = (low+high)/2
+        if x - 2*(1-math.exp(-x)) > 0:
+            high = x
+        else:
+            low = x
+    x = (low+high)/2
+    output['smooth_diagnostic'] = smooth
+    output['smooth_stationary'] = {'x': x, 'occupancy': x/(RATE/B*math.log(2))}
+    # The curve itself is not discretely convex: save second differences.
+    for rule, result in output['rules'].items():
+        rows = result['rows']
+        result['pa_second_differences'] = {n: rows[n+1]['pa']-2*rows[n]['pa']+rows[n-1]['pa']
+                                          for n in range(2, 11)}
+        result['target_credit_partition_changes'] = {str(fixed): sum(
+            a['partition'] != b['partition'] for a,b in zip(
+                result['optima'][f'delivered_fixed_{fixed}'], result['optima'][f'target_fixed_{fixed}']))
+            for fixed in [True, False]}
+    after = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+    assert before == after
+    output['production_sha256'] = before
+    path = OUT / 'a15_results.json'
+    path.write_text(json.dumps(output, indent=2)+'\n')
+    print('DIAGNOSTIC_NOT_CLAIM:', path)
+    print('Independent solver and analytic RF checks passed.')
+    for rule, result in output['rules'].items():
+        print(rule, 'changed partitions', result['target_credit_partition_changes'])
+        for k,v in result['optima'].items():
+            print(k, v[-1])
+        print('one_beam', result['one_beam'])
+    print('smooth_stationary', output['smooth_stationary'])
+    for rule, result in smooth.items():
+        print('SMOOTH_DIAGNOSTIC', rule, {k:v for k,v in result.items() if k != 'rows'})
+
+
+if __name__ == '__main__':
+    main()
