@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""Render the adversarial review from the saved independent diagnostics."""
+import hashlib
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+
+
+def read(name):
+    return json.loads((HERE/name).read_text())
+
+
+def main():
+    a15 = read('a15_results.json')
+    a2 = read('a2_results.json')
