                result['frozen_reference_production_capped'].append(dict(rule=rule,angle=a,distance=r,
                    frozen=frozen,adaptive_strict=adaptive,
                    frozen_ee_advantage_pct=100*(frozen['ee']/adaptive['ee']-1)))
        for row in result['switches'][f'{rule}_angle_original']:
