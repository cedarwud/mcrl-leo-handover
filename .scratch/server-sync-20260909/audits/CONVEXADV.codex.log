              'regret_pct_mean_all_144',sum(r['regret_pct'] for r in feasible)/144)
        if key.endswith('_angle_original'):
            for row in rows: print(row)
    print('reference SEALED N24',result['baseline_reference']['SEALED'][-1])
    print('isolated peaks',[(r['rule'],r['angle'],r['distance'],r['peak']['partition']) for r in result['isolated_peak_grid']])

if __name__=='__main__': main()
