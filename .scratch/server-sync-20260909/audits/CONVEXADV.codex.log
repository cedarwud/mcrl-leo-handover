def _target_feasibility(
    power: np.ndarray,
    direct: np.ndarray,
    coupling: np.ndarray,
    noise: np.ndarray,
    target_sinr_values: tuple[float | None, ...],
) -> tuple[bool, ...]:
    denominators = noise + coupling @ power
