"""DIAGNOSTIC_NOT_CLAIM: independent A6 geometry adversarial recomputation.

Uses production scalar laws; never imports the report's script.  Variants only
alter this diagnostic objective/feasibility filter, never sealed constants.
"""
from __future__ import annotations
import json
import math
from functools import lru_cache
from pathlib import Path
import numpy as np
from mcrl.physics_v025.acm import ACMRate, rate_target_mode, rate_target_sinr
from mcrl.physics_v025.architectures import AngleRateTPC_TDM, Geometry, Link, RadiationConfig
from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W as BB,
    BEAM_BANDWIDTH_HZ as BW, BEAM_RF_CAP_W as CAP,
    CIRCUIT_POWER_PER_CHAIN_W as CHAIN, RATE_TARGET_BPS as TARGET,
    RX_GAIN_MAX_DBI, TX_FULL_HPBW_DEG,
)
from mcrl.physics_v025.energy import HardwareInventory, pa_supply_power_w, schedule_energy
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.stagec_v025.mechanism_corpus import engine_table_q10

OUT = Path(__file__).parent
ANGLES = (0., TX_FULL_HPBW_DEG / 4., TX_FULL_HPBW_DEG / 2.)
RANGES = (500., 750., 1000.)
Q10 = engine_table_q10(30.)

@lru_cache(None)
def partitions(total, maximum=12):
    """Independent descending partition recursion."""
    if total == 0:
        return ((),)
    return tuple((i,) + p for i in range(min(total, maximum), 0, -1)
                 for p in partitions(total-i, i))

@lru_cache(None)
def curve(rule, angle, distance):
    gain = float(transmit_gain_linear(angle)) * float(
        LegacyWorldProvider._nominal_path_without_scintillation(
            np.asarray(distance), np.asarray(30.),
            np.asarray(10 ** (RX_GAIN_MAX_DBI / 10))))
    scale = noise_power_w(BW) / gain / (1. if rule == "SEALED" else Q10)
    result = {}
    for n in range(1, 25):
        mode = rate_target_mode(TARGET, BW, n)
        threshold = rate_target_sinr(TARGET, BW, n)
        if mode is not None:
            rf = float(threshold) * scale
            result[n] = dict(rf=rf, pa=pa_supply_power_w(rf),
                             capacity=BW*mode.spectral_efficiency_bit_per_s_hz)
    return result

def evaluate(p, c, fixed=True, target=False, relaxed_cap=False):
    if any(n not in c or (c[n]['rf'] > CAP and not relaxed_cap) for n in p):
        return None
    denominator = math.fsum(c[n]['pa'] for n in p) + (CHAIN*len(p)+BB if fixed else 0.)
    numerator = TARGET*sum(p) if target else math.fsum(c[n]['capacity'] for n in p)
    return dict(partition=sorted(p), ee=numerator/denominator,
                power=denominator, capacity=math.fsum(c[n]['capacity'] for n in p),
                largest_rf=max(c[n]['rf'] for n in p))

def ranked(n, rule, angle, distance, fixed=True, target=False, relaxed_cap=False):
    c = curve(rule, angle, distance)
    results = (evaluate(p, c, fixed, target, relaxed_cap) for p in partitions(n))
    return sorted((r for r in results if r is not None),
                  key=lambda r: (r['ee'], -len(r['partition']), r['partition']), reverse=True)

def production_capped(partition, rule, angle, distance):
    """Production standalone radiation evaluation, no environment or policy.

    MARGIN variant represents its design fade by scaling a *new* Geometry's
    direct nominal field by q10; production config/constants stay untouched.
    """
    c=curve(rule,angle,distance)
    gain=rate_target_sinr(TARGET,BW,1)*noise_power_w(BW)/c[1]['rf']
    links=[]
    for beam,n in enumerate(partition):
        for _ in range(n):
            links.append(Link(len(links),(1,beam),beam%3,gain,gain))
    geometry=Geometry(tuple(links),np.zeros((len(links),len(links))))
    radiation=AngleRateTPC_TDM().radiate(RadiationConfig(),geometry,'nominal')
    energy=schedule_energy(HardwareInventory.fixed({link.beam for link in links}),
        tuple((slot.fraction,dict(slot.beam_rf_w)) for slot in radiation.slots),duration_s=1.)
    model=ACMRate()
    rates={link.user_id:0. for link in links}
    served={link.user_id:True for link in links}
    for slot in radiation.slots:
        for tx in slot.transmissions:
            rates[tx.user_id]+=slot.fraction*model.rate_bps(tx.sinr,tx.bandwidth_hz)
            served[tx.user_id]&=model.served(tx.sinr)
    return dict(partition=list(partition),ee=sum(rates.values())/energy.joules,
        power=energy.joules,delivered_bps=sum(rates.values()),
        phy_served_users=sum(served.values()),target_attained_users=sum(r>=TARGET for r in rates.values()),
        min_user_mbps=min(rates.values())/1e6,certificate=radiation.certificate.status)

def switches(rule, axis, fixed=True, target=False, relaxed_cap=False):
    rows=[]
    for angle in ANGLES:
        for distance in RANGES:
            if axis == 'angle' and angle == 0 or axis == 'range' and distance == 500:
                continue
            base_angle, base_distance = (0., distance) if axis == 'angle' else (angle, 500.)
            for n in range(1,25):
                a = ranked(n, rule, base_angle, base_distance, fixed, target, relaxed_cap)[0]
                b = ranked(n, rule, angle, distance, fixed, target, relaxed_cap)
                if a['partition'] == b[0]['partition']:
                    continue
                old = evaluate(a['partition'], curve(rule, angle, distance), fixed, target, relaxed_cap)
                rows.append(dict(rule=rule, n=n, angle=angle, distance=distance,
                    previous=a['partition'], best=b[0]['partition'],
                    best_ee_mbit_j=b[0]['ee']/1e6,
                    old_feasible=old is not None,
                    old_rf_max=max(curve(rule, angle, distance)[i]['rf'] for i in a['partition']),
                    regret_pct=None if old is None else 100*(1-old['ee']/b[0]['ee']),
                    runner_up=b[1]['partition'],
                    runner_up_gap_pct=100*(1-b[1]['ee']/b[0]['ee'])))
    return rows

def main():
