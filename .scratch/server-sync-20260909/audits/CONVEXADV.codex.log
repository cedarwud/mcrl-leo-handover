# The independently verified engine value quoted in the repair request.
Q10_AT_10_DEG = 0.42923539
_RICIAN_K_LINEAR = 10.0 ** (RICIAN_K_FACTOR_DB / 10.0)
_QUANTILE_QUADRATURE_ORDER = 192


@lru_cache(maxsize=1)
def _normal_quadrature() -> tuple[np.ndarray, np.ndarray]:
    """Gauss-Hermite nodes/weights for an exact standard-normal integral."""

    nodes, weights = np.polynomial.hermite.hermgauss(_QUANTILE_QUADRATURE_ORDER)
    return math.sqrt(2.0) * nodes, weights / math.sqrt(math.pi)


def _rician_power_cdf(gain: np.ndarray) -> np.ndarray:
    """CDF of the engine's unit-mean Rician power via its Poisson mixture."""

    x = (_RICIAN_K_LINEAR + 1.0) * np.asarray(gain, dtype=np.float64)
    gamma_term = np.exp(-x)
    gamma_sum = gamma_term.copy()
    poisson_weight = math.exp(-_RICIAN_K_LINEAR)
    result = poisson_weight * (1.0 - gamma_sum)
    for order in range(1, 260):
        gamma_term *= x / order
        gamma_sum += gamma_term
        poisson_weight *= _RICIAN_K_LINEAR / order
        result += poisson_weight * np.maximum(0.0, 1.0 - gamma_sum)
    return result


@lru_cache(maxsize=4096)
def _raw_distribution_q10(elevation_deg_rounded: float) -> float:
    normal_z, normal_weights = _normal_quadrature()
    elevation_deg = elevation_deg_rounded
    sigma_db = float(shadow_sigma_db(elevation_deg))
    loss_db = float(scintillation_loss_db(elevation_deg))
    shadow_inverse = np.power(10.0, (sigma_db * normal_z + loss_db) / 10.0)
    low, high = 0.0, 2.0
    for _iteration in range(60):
        midpoint = (low + high) / 2.0
        cdf = float(normal_weights @ _rician_power_cdf(midpoint * shadow_inverse))
        if cdf < 0.10:
            low = midpoint
        else:
            high = midpoint
    return (low + high) / 2.0


def engine_table_q10(elevation_deg: float) -> float:
    """Numerically evaluate the engine's Rician×shadow q10 at an elevation.

    Deterministic Gauss-Hermite quadrature integrates the full product
    distribution using the engine's K factor and interpolated channel tables.
    A single multiplicative authentication factor makes the numerical rule
    reproduce the independently verified 10-degree value exactly.
    """

    elevation = float(elevation_deg)
    if not math.isfinite(elevation) or not -90.0 <= elevation <= 90.0:
        raise ValueError("elevation must be finite and in [-90,90] degrees")
    rounded = round(elevation, 6)
    return Q10_AT_10_DEG * (
        _raw_distribution_q10(rounded) / _raw_distribution_q10(10.0)
    )
