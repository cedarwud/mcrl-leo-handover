def run_pair(data: PairData, lr: float, maximum_epoch: int = 500, maximum_folds: int | None = None) -> dict[str, object]:
    folds = list(np.unique(data.anchor))
    if maximum_folds is not None:
        folds = folds[:maximum_folds]
    checkpoints = tuple(value for value in CHECKPOINTS if value <= maximum_epoch)
    predictions = {epoch: np.full(data.y.shape, np.nan) for epoch in checkpoints}
    objectives = {epoch: [] for epoch in checkpoints}
    norms = {epoch: [] for epoch in checkpoints}
    divergence_rows = []
    literal = dict(LEGACY_TRAINER_LITERALS[data.route])
    literal["learning_rate"] = lr
    started = time.perf_counter()
    for fold_number, value in enumerate(folds, start=1):
        test = data.anchor == value
        train = ~test
        batch = pair_batch(data, train)
        head = AdamMLPHead.create(data.x.shape[1], literal, np.random.default_rng(SEED))
        for epoch in range(maximum_epoch + 1):
            if epoch in checkpoints:
                loss = pair_objective(head, batch)
                if not math.isfinite(loss) or not parameters_finite(head):
                    divergence_rows.append({"fold": int(value), "epoch": epoch, "phase": "checkpoint"})
                    break
                objectives[epoch].append((loss, int(batch.target_deltas.size)))
                norms[epoch].append(parameter_norm(head))
                predictions[epoch][test] = head._forward(data.x[test])[0]
            if epoch == maximum_epoch:
                break
            with np.errstate(all="ignore"):
                loss_before_update = head.update(batch)
            if not math.isfinite(loss_before_update) or not parameters_finite(head):
                divergence_rows.append({"fold": int(value), "epoch": epoch + 1, "phase": "update"})
                break
        print(json.dumps({
            "event": "fold", "route": data.route, "lr": lr,
            "fold": fold_number, "folds": len(folds),
            "diverged": bool(divergence_rows and divergence_rows[-1]["fold"] == int(value)),
        }), flush=True)
    usable = np.isin(data.anchor, np.asarray(folds))
    trajectory = {}
    for epoch in checkpoints:
        finite_predictions = bool(np.isfinite(predictions[epoch][usable]).all())
        if len(objectives[epoch]) == len(folds) and finite_predictions:
            weighted_loss = sum(value * count for value, count in objectives[epoch]) / sum(count for _, count in objectives[epoch])
            trajectory[str(epoch)] = {
                "training_objective": float(weighted_loss),
                "held_out": metric(predictions[epoch][usable], data.y[usable], data.group[usable]),
                "parameter_l2": summarize(norms[epoch]),
            }
        else:
            trajectory[str(epoch)] = None
    return finalize_cell(
        data.route, lr, trajectory, divergence_rows,
        wall_s=time.perf_counter() - started,
        schema=data.schema, schema_sha256=data.schema_sha256,
        folds=len(folds), rows=int(usable.sum()), groups=int(np.unique(data.group[usable]).size),
        pair_limit=PAIR_LIMIT,
    )


def c3_loss(head: AdamMLPHead, anchors: Iterable[C3Anchor]) -> tuple[float, int]:
    squared = 0.0
    count = 0
    for anchor in anchors:
        target = anchor.truth[anchor.train_indices]
        prediction = head._forward(anchor.x)[0]
        squared += float(np.square(prediction - target).sum())
        count += int(target.size)
    return float(head.loss_weight * squared / count), count


def c3_update(head: AdamMLPHead, anchors: Iterable[C3Anchor]) -> float:
    grad_w = [np.zeros_like(value) for value in head.weights]
    grad_b = [np.zeros_like(value) for value in head.biases]
    squared = 0.0
    count = 0
    for anchor in anchors:
        target = anchor.truth[anchor.train_indices]
        prediction, activations, preactivations = head._forward(anchor.x)
        residual = prediction - target
        chunk_w, chunk_b = head._backward(activations, preactivations, residual)
        for total, chunk in zip(grad_w, chunk_w, strict=True):
            total += chunk
        for total, chunk in zip(grad_b, chunk_b, strict=True):
            total += chunk
        squared += float(np.square(residual).sum())
        count += int(target.size)
    scale = 2.0 * head.loss_weight / count
    head._adam([value * scale for value in grad_w], [value * scale for value in grad_b])
    return float(head.loss_weight * squared / count)


def c3_metric(predictions: list[np.ndarray], anchors: tuple[C3Anchor, ...]) -> dict[str, float | int]:
    truth = np.concatenate([anchor.truth for anchor in anchors])
    prediction = np.concatenate(predictions)
    group = np.concatenate([
        np.full(anchor.truth.shape, index, dtype=np.int16)
        for index, anchor in enumerate(anchors)
    ])
    return metric(prediction, truth, group)


def run_c3(data: C3Data, lr: float, maximum_epoch: int = 500, maximum_folds: int | None = None) -> dict[str, object]:
    fold_indices = list(range(len(data.anchors)))
    if maximum_folds is not None:
        fold_indices = fold_indices[:maximum_folds]
    checkpoints = tuple(value for value in CHECKPOINTS if value <= maximum_epoch)
    predictions: dict[int, list[np.ndarray | None]] = {
        epoch: [None] * len(fold_indices) for epoch in checkpoints
    }
    objectives = {epoch: [] for epoch in checkpoints}
    norms = {epoch: [] for epoch in checkpoints}
    divergence_rows = []
    literal = dict(LEGACY_TRAINER_LITERALS["C3"])
    literal["learning_rate"] = lr
    started = time.perf_counter()
    for local_fold, test_index in enumerate(fold_indices):
        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != test_index)
        test = data.anchors[test_index]
        head = AdamMLPHead.create(test.x.shape[1], literal, np.random.default_rng(SEED))
        for epoch in range(maximum_epoch + 1):
            if epoch in checkpoints:
                loss, count = c3_loss(head, train)
                if not math.isfinite(loss) or not parameters_finite(head):
                    divergence_rows.append({"fold": test.path.stem, "epoch": epoch, "phase": "checkpoint"})
                    break
                objectives[epoch].append((loss, count))
                norms[epoch].append(parameter_norm(head))
                prediction = np.zeros_like(test.truth)
                prediction[test.train_indices] = head._forward(test.x)[0]
                predictions[epoch][local_fold] = prediction
            if epoch == maximum_epoch:
                break
            with np.errstate(all="ignore"):
                loss_before_update = c3_update(head, train)
            if not math.isfinite(loss_before_update) or not parameters_finite(head):
                divergence_rows.append({"fold": test.path.stem, "epoch": epoch + 1, "phase": "update"})
                break
        print(json.dumps({
            "event": "fold", "route": "C3", "lr": lr,
            "fold": local_fold + 1, "folds": len(fold_indices),
            "diverged": bool(divergence_rows and divergence_rows[-1]["fold"] == test.path.stem),
        }), flush=True)
    selected_anchors = tuple(data.anchors[index] for index in fold_indices)
    trajectory = {}
    for epoch in checkpoints:
        complete = len(objectives[epoch]) == len(fold_indices) and all(
            value is not None for value in predictions[epoch]
        )
        if complete:
            weighted_loss = sum(value * count for value, count in objectives[epoch]) / sum(count for _, count in objectives[epoch])
            trajectory[str(epoch)] = {
                "training_objective": float(weighted_loss),
                "held_out": c3_metric([value for value in predictions[epoch] if value is not None], selected_anchors),
                "parameter_l2": summarize(norms[epoch]),
            }
        else:
            trajectory[str(epoch)] = None
    return finalize_cell(
        "C3", lr, trajectory, divergence_rows,
        wall_s=time.perf_counter() - started,
        schema=data.schema, schema_sha256=data.schema_sha256,
        folds=len(fold_indices), rows=sum(anchor.truth.size for anchor in selected_anchors),
        groups=len(selected_anchors), pair_limit=None,
    )


def summarize(values: list[float]) -> dict[str, float]:
    return {
        "mean": float(np.mean(values)), "minimum": float(np.min(values)),
        "maximum": float(np.max(values)), "rms": float(np.sqrt(np.mean(np.square(values)))),
    }


def finalize_cell(
    route: str, lr: float, trajectory: dict[str, object], divergence_rows: list[dict[str, object]],
    **metadata: object,
) -> dict[str, object]:
    divergence_epoch = min((int(row["epoch"]) for row in divergence_rows), default=None)
    stable = None
    changes = None
    if divergence_epoch is None and trajectory.get("400") is not None and trajectory.get("500") is not None:
        left = trajectory["400"]
        right = trajectory["500"]
        objective_relative = abs(float(right["training_objective"]) - float(left["training_objective"])) / max(
            abs(float(left["training_objective"])), 1e-12
        )
        changes = {
            "objective_relative_abs": objective_relative,
            "r2_absolute": abs(float(right["held_out"]["r2"]) - float(left["held_out"]["r2"])),
            "pairwise_ordering_absolute": abs(float(right["held_out"]["pairwise_ordering"]) - float(left["held_out"]["pairwise_ordering"])),
            "top1_accuracy_absolute": abs(float(right["held_out"]["top1_accuracy"]) - float(left["held_out"]["top1_accuracy"])),
        }
        stable = {
            "objective": changes["objective_relative_abs"] <= STABILITY_TOLERANCES["objective_relative"],
            "r2": changes["r2_absolute"] <= STABILITY_TOLERANCES["r2_absolute"],
            "pairwise_ordering": changes["pairwise_ordering_absolute"] <= STABILITY_TOLERANCES["pairwise_ordering_absolute"],
            "top1_accuracy": changes["top1_accuracy_absolute"] <= STABILITY_TOLERANCES["top1_accuracy_absolute"],
        }
    last_improved = {key: None for key in ("objective", "r2", "pairwise_ordering", "top1_accuracy")}
    for previous, current in zip(CHECKPOINTS[:-1], CHECKPOINTS[1:], strict=True):
        left = trajectory.get(str(previous))
        right = trajectory.get(str(current))
        if left is None or right is None:
            continue
        relative_drop = (float(left["training_objective"]) - float(right["training_objective"])) / max(
            abs(float(left["training_objective"])), 1e-12
        )
        if relative_drop > STABILITY_TOLERANCES["objective_relative"]:
            last_improved["objective"] = current
        for key, tolerance_key in (
            ("r2", "r2_absolute"),
            ("pairwise_ordering", "pairwise_ordering_absolute"),
            ("top1_accuracy", "top1_accuracy_absolute"),
        ):
            improvement = float(right["held_out"][key]) - float(left["held_out"][key])
            if improvement > STABILITY_TOLERANCES[tolerance_key]:
                last_improved[key] = current
    admissible = bool(divergence_epoch is None and stable is not None and all(stable.values()))
    return {
        "route": route, "learning_rate": lr,
        "divergence": {
            "diverged": divergence_epoch is not None,
            "earliest_epoch": divergence_epoch,
            "fold_events": divergence_rows,
            "criterion": "non-finite objective or trainable parameter",
        },
        "trajectory": trajectory,
        "stability_400_to_500": stable,
        "changes_400_to_500": changes,
        "last_material_improvement_epoch": last_improved,
        "admissible_on_convergence": admissible,
        **metadata,
    }


def constant_floor_pair(data: PairData) -> dict[str, object]:
    prediction = np.empty_like(data.y)
    for value in np.unique(data.anchor):
        test = data.anchor == value
        prediction[test] = float(data.y[~test].mean())
    return metric(prediction, data.y, data.group)


def constant_floor_c3(data: C3Data, anchored: bool) -> dict[str, object]:
    predictions = []
    for test_index, test in enumerate(data.anchors):
        train = [anchor for index, anchor in enumerate(data.anchors) if index != test_index]
        if anchored:
            values = np.concatenate([anchor.truth[anchor.train_indices] for anchor in train])
            prediction = np.zeros_like(test.truth)
            prediction[test.train_indices] = float(values.mean())
        else:
            values = np.concatenate([anchor.truth for anchor in train])
            prediction = np.full_like(test.truth, float(values.mean()))
        predictions.append(prediction)
    return c3_metric(predictions, data.anchors)


def inventory(c1: PairData, c2: PairData, c3: C3Data) -> dict[str, object]:
    sizes = np.concatenate([anchor.size for anchor in c3.anchors])
    unique, counts = np.unique(sizes, return_counts=True)
    return {
        "C1": {"anchors": int(np.unique(c1.anchor).size), "rows": int(c1.y.size), "groups": int(np.unique(c1.group).size)},
        "C2": {"anchors": int(np.unique(c2.anchor).size), "rows": int(c2.y.size), "groups": int(np.unique(c2.group).size)},
        "C3": {
            "anchors": len(c3.anchors), "rows": int(sum(anchor.truth.size for anchor in c3.anchors)),
            "trainable_rows": int(sum(anchor.train_indices.size for anchor in c3.anchors)),
            "coalition_size_counts": {str(int(size)): int(count) for size, count in zip(unique, counts, strict=True)},
        },
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--routes", nargs="+", choices=("C1", "C2", "C3"), default=("C1", "C2", "C3"))
    parser.add_argument("--lrs", nargs="+", type=float, default=LRS)
    parser.add_argument("--smoke", action="store_true")
    args = parser.parse_args()
    verify_runtime()
    OUT.mkdir(parents=True, exist_ok=True)
    learner_path = ROOT / "src/mcrl/stagec_v025/learner.py"
    c1, c2, c3 = load_c1(), load_c2(), load_c3()
    inputs = (*c1.input_files, *c2.input_files, *(anchor.path for anchor in c3.anchors), learner_path)
    before = {str(path): file_sha256(path) for path in inputs}
    maximum_epoch = 2 if args.smoke else 500
    maximum_folds = 1 if args.smoke else None
    cells = []
    for route in args.routes:
        for lr in args.lrs:
            tag = f"{route.lower()}-lr-{lr:.0e}".replace("e-0", "e-")
            cache = OUT / f"{tag}.json"
            if cache.exists() and not args.smoke:
                cell = json.loads(cache.read_text(encoding="utf-8"))
                print(json.dumps({"event": "cache", "route": route, "lr": lr}), flush=True)
            else:
                if route == "C1":
                    cell = run_pair(c1, lr, maximum_epoch, maximum_folds)
                elif route == "C2":
                    cell = run_pair(c2, lr, maximum_epoch, maximum_folds)
                else:
                    cell = run_c3(c3, lr, maximum_epoch, maximum_folds)
                if not args.smoke:
                    atomic_json(cache, cell)
            cells.append(cell)
            print(json.dumps({
                "event": "cell", "route": route, "lr": lr,
                "admissible": cell["admissible_on_convergence"],
                "wall_s": cell["wall_s"],
            }), flush=True)
    after = {str(path): file_sha256(path) for path in inputs}
    changed = [path for path in before if before[path] != after[path]]
    if changed:
        raise RuntimeError(f"read-only inputs changed during sweep: {changed}")
    peak_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
    if peak_kb * 1024 >= RSS_LIMIT_BYTES:
        raise RuntimeError(f"peak RSS cap exceeded: {peak_kb} KiB")
    result = {
        "schema": "mcrl-v025-lr-convergence-sweep-v1",
        "status": "DIAGNOSTIC_NOT_CLAIM",
        "routes": list(args.routes), "learning_rates": list(args.lrs),
        "seed": SEED, "checkpoints": list(CHECKPOINTS),
        "stability_tolerances": STABILITY_TOLERANCES,
        "inventory": inventory(c1, c2, c3),
        "constant_floors": {
            "C1": constant_floor_pair(c1), "C2": constant_floor_pair(c2),
            "C3": constant_floor_c3(c3, anchored=False),
            "C3_anchored_supplement": constant_floor_c3(c3, anchored=True),
        },
        "cells": cells,
        "resource_policy": {
            "python_processes": 1, "nice": os.nice(0), "blas_threads": 1,
            "rlimit_as_bytes": RSS_LIMIT_BYTES, "peak_rss_kb": peak_kb,
        },
        "input_sha256_before": before, "input_sha256_after": after,
        "changed_inputs": changed,
        "scope": {
            "loss_use": "convergence diagnostic only; never EE evidence",
            "ee_quantities_computed": False, "production_training": False,
            "policy_run": False, "acceptance_test": False,
        },
    }
    output = OUT / ("smoke.json" if args.smoke else "results.json")
    atomic_json(output, result)
    print(f"PEAK_RSS_KB={peak_kb}", flush=True)
    print(json.dumps({"written": str(output), "changed_inputs": changed}), flush=True)


