    f"world-{world}-step-{step:02d}.npz"
    for world in (1, 2) for step in range(6)
)
C3_INPUTS = tuple(C3_ROWS / name for name in C3_NAMES)


@dataclass(frozen=True)
class PairData:
    route: str
    x: np.ndarray
    y: np.ndarray
    reference: np.ndarray
    anchor: np.ndarray
    group: np.ndarray
    input_files: tuple[Path, ...]
    schema: str
    schema_sha256: str


@dataclass(frozen=True)
class C3Anchor:
    path: Path
    truth: np.ndarray
    size: np.ndarray
    train_indices: np.ndarray
    x: np.ndarray


@dataclass(frozen=True)
class C3Data:
    anchors: tuple[C3Anchor, ...]
    schema: str
    schema_sha256: str


def verify_runtime() -> None:
    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
    if wrong:
        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below 15")


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_json(path: Path, payload: object) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def load_c1() -> PairData:
    rows = []
    for path in C1_INPUTS:
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                record = json.loads(line)
                if record["kind"] == "metadata":
                    if record["q1_schema"] != SCHEMA_V2 or record["q1_schema_sha256"] != SCHEMA_V2_SHA256:
                        raise RuntimeError("C1 repaired schema mismatch")
                    continue
                maximum = 17 if record["world_id"].endswith("/1") else 18
                if int(record["anchor_index"]) > maximum:
                    continue
                for row in record["rows"]:
                    rows.append((
                        row["q1"], row["declared"], row["reference"],
                        record["anchor_id"], row["user_id"],
                    ))
    return make_pair_data("C1", rows, C1_INPUTS, SCHEMA_V2, SCHEMA_V2_SHA256)


def load_c2() -> PairData:
    rows = []
    for path in C2_INPUTS:
        with path.open(encoding="utf-8") as stream:
            for line in stream:
                record = json.loads(line)
                if record["kind"] == "metadata":
                    continue
                for row in record["rows"]:
                    rows.append((
                        row["q2"], row["declared"], row["reference"],
                        record["anchor_id"], row["user_id"],
                    ))
    return make_pair_data(
        "C2", rows, C2_INPUTS,
        "mcrl-v025-stagec-q2-action-v1",
        "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c",
    )


def make_pair_data(
    route: str,
    rows: list[tuple[object, object, object, object, object]],
    paths: tuple[Path, ...],
    schema: str,
    schema_sha256: str,
) -> PairData:
    anchors = sorted({str(row[3]) for row in rows})
    groups = sorted({f"{row[3]}|user/{row[4]}" for row in rows})
    anchor_code = {value: index for index, value in enumerate(anchors)}
    group_code = {value: index for index, value in enumerate(groups)}
    return PairData(
        route=route,
        x=np.asarray([row[0] for row in rows], dtype=np.float64),
        y=np.asarray([row[1] for row in rows], dtype=np.float64),
        reference=np.asarray([row[2] for row in rows], dtype=bool),
        anchor=np.asarray([anchor_code[str(row[3])] for row in rows], dtype=np.int16),
        group=np.asarray([group_code[f"{row[3]}|user/{row[4]}"] for row in rows], dtype=np.int32),
        input_files=paths,
        schema=schema,
        schema_sha256=schema_sha256,
    )


def load_c3() -> C3Data:
    missing = [str(path) for path in C3_INPUTS if not path.is_file()]
    if missing:
        raise RuntimeError(f"frozen C3 inputs missing: {missing}")
    anchors = []
    for path in C3_INPUTS:
        with np.load(path, allow_pickle=False) as payload:
            truth = np.asarray(payload["target"], dtype=np.float64)
            size = np.asarray(payload["size"], dtype=np.int16)
            indices = np.asarray(payload["coalition_indices"], dtype=np.int32)
            x = np.asarray(payload["x_v2"], dtype=np.float64)
        if x.shape[0] != indices.size or not np.array_equal(indices, np.flatnonzero(size >= 2)):
            raise RuntimeError(f"C3 train support mismatch: {path}")
        if not np.isfinite(truth).all() or not np.isfinite(x).all():
            raise RuntimeError(f"non-finite C3 input: {path}")
        anchors.append(C3Anchor(path, truth, size, indices, x))
    dimensions = {anchor.x.shape[1] for anchor in anchors}
    if len(dimensions) != 1:
        raise RuntimeError("C3 input dimensions disagree")
    return C3Data(tuple(anchors), SCHEMA_V2, SCHEMA_V2_SHA256)


def pair_batch(data: PairData, train: np.ndarray) -> SimpleNamespace:
    ref_by_group = {int(data.group[i]): int(i) for i in np.flatnonzero(train & data.reference)}
    candidates = np.flatnonzero(train & ~data.reference)
    references = np.asarray([ref_by_group[int(data.group[i])] for i in candidates], dtype=np.int64)
    if candidates.size > PAIR_LIMIT:
        chosen = np.linspace(0, candidates.size - 1, PAIR_LIMIT, dtype=np.int64)
        candidates = candidates[chosen]
        references = references[chosen]
    return SimpleNamespace(
        reference_states=data.x[references],
        candidate_states=data.x[candidates],
        target_deltas=data.y[candidates] - data.y[references],
    )


def parameters_finite(head: AdamMLPHead) -> bool:
    return all(np.isfinite(value).all() for value in (*head.weights, *head.biases))


def parameter_norm(head: AdamMLPHead) -> float:
    total = sum(float(np.square(value).sum()) for value in (*head.weights, *head.biases))
    return math.sqrt(total)


def pair_objective(head: AdamMLPHead, batch: SimpleNamespace) -> float:
    reference = head._forward(batch.reference_states)[0]
    candidate = head._forward(batch.candidate_states)[0]
    residual = candidate - reference - batch.target_deltas
    return float(head.loss_weight * np.mean(residual * residual + head.gauge_beta * reference * reference))


def metric(prediction: np.ndarray, truth: np.ndarray, group: np.ndarray) -> dict[str, float | int]:
    rss = float(np.square(truth - prediction).sum())
    tss = float(np.square(truth - truth.mean()).sum())
    credit = 0.0
    pairs = 0
    top1_hits = 0
    group_count = 0
    for group_id in np.unique(group):
        indices = np.flatnonzero(group == group_id)
        if indices.size < 2:
            continue
        target = truth[indices]
        score = prediction[indices]
        left, right = np.triu_indices(indices.size, 1)
        target_delta = target[left] - target[right]
        score_delta = score[left] - score[right]
        keep = np.abs(target_delta) > 1e-12
        target_delta = target_delta[keep]
        score_delta = score_delta[keep]
        pairs += int(target_delta.size)
        credit += float(np.sum(np.sign(target_delta) == np.sign(score_delta)))
        credit += 0.5 * float(np.sum(np.abs(score_delta) <= 1e-15))
        selected = int(np.argmax(score))
        top1_hits += int(target[selected] >= target.max() - 1e-12)
        group_count += 1
    return {
        "r2": float(1.0 - rss / tss) if tss else math.nan,
        "pairwise_ordering": float(credit / pairs) if pairs else math.nan,
        "top1_accuracy": float(top1_hits / group_count) if group_count else math.nan,
        "rows": int(truth.size),
        "pairs": pairs,
        "groups": group_count,
    }


def run_pair(data: PairData, lr: float, maximum_epoch: int = 500, maximum_folds: int | None = None) -> dict[str, object]:
    folds = list(np.unique(data.anchor))
    if maximum_folds is not None:
        folds = folds[:maximum_folds]
    checkpoints = tuple(value for value in CHECKPOINTS if value <= maximum_epoch)
    predictions = {epoch: np.full(data.y.shape, np.nan) for epoch in checkpoints}
    objectives = {epoch: [] for epoch in checkpoints}
    norms = {epoch: [] for epoch in checkpoints}
    divergence_rows = []
    literal = dict(LEGACY_TRAINER_LITERALS[data.route])
    literal["learning_rate"] = lr
    started = time.perf_counter()
    for fold_number, value in enumerate(folds, start=1):
        test = data.anchor == value
        train = ~test
        batch = pair_batch(data, train)
        head = AdamMLPHead.create(data.x.shape[1], literal, np.random.default_rng(SEED))
        for epoch in range(maximum_epoch + 1):
            if epoch in checkpoints:
                loss = pair_objective(head, batch)
                if not math.isfinite(loss) or not parameters_finite(head):
                    divergence_rows.append({"fold": int(value), "epoch": epoch, "phase": "checkpoint"})
                    break
                objectives[epoch].append((loss, int(batch.target_deltas.size)))
                norms[epoch].append(parameter_norm(head))
                predictions[epoch][test] = head._forward(data.x[test])[0]
            if epoch == maximum_epoch:
                break
            with np.errstate(all="ignore"):
                loss_before_update = head.update(batch)
            if not math.isfinite(loss_before_update) or not parameters_finite(head):
                divergence_rows.append({"fold": int(value), "epoch": epoch + 1, "phase": "update"})
                break
        print(json.dumps({
            "event": "fold", "route": data.route, "lr": lr,
            "fold": fold_number, "folds": len(folds),
            "diverged": bool(divergence_rows and divergence_rows[-1]["fold"] == int(value)),
        }), flush=True)
    usable = np.isin(data.anchor, np.asarray(folds))
    trajectory = {}
    for epoch in checkpoints:
        finite_predictions = bool(np.isfinite(predictions[epoch][usable]).all())
        if len(objectives[epoch]) == len(folds) and finite_predictions:
            weighted_loss = sum(value * count for value, count in objectives[epoch]) / sum(count for _, count in objectives[epoch])
            trajectory[str(epoch)] = {
                "training_objective": float(weighted_loss),
                "held_out": metric(predictions[epoch][usable], data.y[usable], data.group[usable]),
                "parameter_l2": summarize(norms[epoch]),
            }
**C1: no grid learning rate is admissible by epoch 500 and current `1e-2` is not; C2: no grid learning rate is admissible and current `1e-3` is not; C3: no grid learning rate is admissible and current `1e-3` is not—the declared 500-epoch horizon is inadequate for all three sealed architectures under the predeclared convergence rule.**

`DIAGNOSTIC_NOT_CLAIM`

## Answer

[RUN] All 21 declared route–learning-rate cells were run and all remained
finite through 500 epochs. None passed the convergence rule fixed before the
sweep: stability from epoch 400 to 500 of the training objective, held-out
level R², held-out within-group ordering, and held-out top-1. There is therefore
no learning-rate selection to make. In particular, none of the three current
literals is admissible.

[INFERRED] Under the fixed selection rule, the finding is that 500 epochs is
the wrong horizon for each of these architectures on these panels. This does
not imply that every rate would fail at a longer horizon, and the run does not
pick the rate with the best predictive result at epoch 500.

**Loss values below are convergence diagnostics only and are never evidence
about EE. No EE quantity was computed, so no EE result could influence this
finding.** No production training, policy run, or acceptance test was run.

## Rule fixed before running

[DERIVED] For objective `L`, objective stability means
`abs(L500-L400) / max(abs(L400), 1e-12) <= 0.01`. Predictive stability means
absolute 400-to-500 changes no larger than `0.01` for level R² and `0.005` for
each of ordering and top-1. A cell is admissible exactly when it stays finite
through 500 and all four checks pass. This formula, the grid, and the data
boundaries were written before the full process started in
`.scratch/lr-convergence-sweep/spec.md`.

“Last material improvement” is the destination epoch of the last adjacent
sampled interval, including 0→100, in which loss decreased by more than 1%
relative or the named held-out metric increased by more than its absolute
tolerance. `—` means no sampled interval did so. “Stable L/R/O/T” reports the
four 400→500 tests in order: loss, R², ordering, top-1. A material decline also
fails stability even though it is not an improvement.

