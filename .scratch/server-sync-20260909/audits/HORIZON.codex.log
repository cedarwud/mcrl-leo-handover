@@ -0,0 +1,404 @@
+#!/usr/bin/env python3
+"""C3 horizon-vs-minibatch convergence diagnostic; computes no EE quantity."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+from typing import Callable
+
+
+ROOT = Path("/home/sat/mcrl-v025-horizon-ws")
+OUT = ROOT / ".scratch/horizon-lever"
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2-ws")
+SOURCE_RUNNER = SOURCE_ROOT / ".scratch/lr-convergence-sweep/run_sweep.py"
+SOURCE_SPEC = SOURCE_ROOT / ".scratch/lr-convergence-sweep/spec.md"
+SOURCE_RESULTS = SOURCE_ROOT / ".scratch/lr-convergence-sweep/results.json"
+SOURCE_LEARNER = SOURCE_ROOT / "src/mcrl/stagec_v025/learner.py"
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+RSS_LIMIT_BYTES = 3 * 1024**3 - 1
+MAX_UPDATES = 4000
+CADENCE = 100
+BATCH_SIZE = 256
+SHUFFLE_DOMAIN = "V025_HORIZON/C3/minibatch-shuffle/seed/1"
+EXPECTED_HASHES = {
+    str(SOURCE_RUNNER): "dde9a8e93a54d67dbe601a47465e47108fb27f57e5b7d9213cf3a8a1a0300fc6",
+    str(SOURCE_SPEC): "0484ffbf3ea2447e0bb0067a8067739c069c1550d48dc0629b9fbf3af20f9b19",
+    str(SOURCE_RESULTS): "9424c6d8c00906e5b86f9ed9d00e4c8b2e8a8bd3a598f3f61677c6eafaf84861",
+    str(SOURCE_LEARNER): "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+}
+
+
+class LoadPause(RuntimeError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def atomic_json(path: Path, payload: object) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def verify_runtime() -> None:
+    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment not pinned: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) != 19:
+        raise RuntimeError(f"process niceness is not 19: {os.getpriority(os.PRIO_PROCESS, 0)}")
+    actual = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    if actual != EXPECTED_HASHES:
+        raise RuntimeError(f"sealed source hash mismatch: {actual}")
+
+
+def load_average() -> float:
+    return float(Path("/proc/loadavg").read_text(encoding="ascii").split()[0])
+
+
+def guard_load() -> float:
+    value = load_average()
+    if value > 30.0:
+        raise LoadPause(f"one-minute load average {value:.2f} exceeds 30")
+    return value
+
+
+def import_sweep():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    spec = importlib.util.spec_from_file_location("sealed_lr_sweep", SOURCE_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load sealed LRSWEEP harness")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+    return module
+
+
+def record_checkpoint(sweep, head, train, test):
+    loss, count = sweep.c3_loss(head, train)
+    if not math.isfinite(loss) or not sweep.parameters_finite(head):
+        raise RuntimeError("non-finite objective or parameter at checkpoint")
+    prediction = sweep.np.zeros_like(test.truth)
+    prediction[test.train_indices] = head._forward(test.x)[0]
+    return loss, count, sweep.parameter_norm(head), prediction
+
+
+def make_minibatch_updater(sweep, head, train) -> Callable[[], float]:
+    states = sweep.np.concatenate([anchor.x for anchor in train], axis=0)
+    targets = sweep.np.concatenate([
+        anchor.truth[anchor.train_indices] for anchor in train
+    ])
+    rng = sweep.np.random.default_rng(sweep.seed_from_domain(SHUFFLE_DOMAIN))
+    order = sweep.np.empty(0, dtype=sweep.np.int64)
+    cursor = 0
+
+    def update() -> float:
+        nonlocal order, cursor
+        if cursor >= order.size:
+            order = rng.permutation(states.shape[0])
+            cursor = 0
+        stop = min(cursor + BATCH_SIZE, order.size)
+        selected = order[cursor:stop]
+        cursor = stop
+        return head.update_scalar(states[selected], targets[selected])
+
+    return update
+
+
+def stability(sweep, left: dict[str, object], right: dict[str, object]) -> dict[str, object]:
+    changes = {
+        "objective_relative_abs": abs(right["training_objective"] - left["training_objective"])
+        / max(abs(left["training_objective"]), 1e-12),
+        "r2_absolute": abs(right["held_out"]["r2"] - left["held_out"]["r2"]),
+        "pairwise_ordering_absolute": abs(
+            right["held_out"]["pairwise_ordering"] - left["held_out"]["pairwise_ordering"]
+        ),
+        "top1_accuracy_absolute": abs(
+            right["held_out"]["top1_accuracy"] - left["held_out"]["top1_accuracy"]
+        ),
+    }
+    passed = {
+        "objective": changes["objective_relative_abs"] <= sweep.STABILITY_TOLERANCES["objective_relative"],
+        "r2": changes["r2_absolute"] <= sweep.STABILITY_TOLERANCES["r2_absolute"],
+        "pairwise_ordering": changes["pairwise_ordering_absolute"]
+        <= sweep.STABILITY_TOLERANCES["pairwise_ordering_absolute"],
+        "top1_accuracy": changes["top1_accuracy_absolute"]
+        <= sweep.STABILITY_TOLERANCES["top1_accuracy_absolute"],
+    }
+    return {"changes": changes, "passed": passed, "admissible": all(passed.values())}
+
+
+def run_arm(sweep, data, arm: str, progress: list[int], total_work: int) -> dict[str, object]:
+    checkpoints = tuple(range(0, MAX_UPDATES + 1, CADENCE))
+    predictions = {step: [None] * len(data.anchors) for step in checkpoints}
+    objectives = {step: [] for step in checkpoints}
+    norms = {step: [] for step in checkpoints}
+    interval_total = {step: [] for step in checkpoints[1:]}
+    interval_update = {step: [] for step in checkpoints[1:]}
+    interval_checkpoint = {step: [] for step in checkpoints[1:]}
+    literal = dict(sweep.LEGACY_TRAINER_LITERALS["C3"])
+    arm_started = time.perf_counter()
+    load_observed = [guard_load()]
+
+    for fold_index, test in enumerate(data.anchors):
+        train = tuple(anchor for index, anchor in enumerate(data.anchors) if index != fold_index)
+        fold_started = time.perf_counter()
+        head = sweep.AdamMLPHead.create(
+            test.x.shape[1], literal, sweep.np.random.default_rng(sweep.SEED)
+        )
+        initial_started = time.perf_counter()
+        loss, count, norm, prediction = record_checkpoint(sweep, head, train, test)
+        initial_checkpoint_s = time.perf_counter() - initial_started
+        objectives[0].append((loss, count))
+        norms[0].append(norm)
+        predictions[0][fold_index] = prediction
+        if arm == "A":
+            updater = lambda: sweep.c3_update(head, train)
+        else:
+            updater = make_minibatch_updater(sweep, head, train)
+
+        previous_end = fold_started
+        update_accumulator = 0.0
+        for step in range(1, MAX_UPDATES + 1):
+            update_started = time.perf_counter()
+            with sweep.np.errstate(all="ignore"):
+                loss_before_update = updater()
+            update_accumulator += time.perf_counter() - update_started
+            if not math.isfinite(loss_before_update) or not sweep.parameters_finite(head):
+                raise RuntimeError(f"arm {arm} fold {fold_index + 1} diverged at update {step}")
+            if step % CADENCE:
+                continue
+            checkpoint_started = time.perf_counter()
+            loss, count, norm, prediction = record_checkpoint(sweep, head, train, test)
+            checkpoint_s = time.perf_counter() - checkpoint_started
+            objectives[step].append((loss, count))
+            norms[step].append(norm)
+            predictions[step][fold_index] = prediction
+            now = time.perf_counter()
+            interval_total[step].append(now - previous_end)
+            interval_update[step].append(update_accumulator)
+            interval_checkpoint[step].append(checkpoint_s + (initial_checkpoint_s if step == CADENCE else 0.0))
+            previous_end = now
+            update_accumulator = 0.0
+            progress[0] += CADENCE
+            current_load = load_average()
+            load_observed.append(current_load)
+            print(
+                f"step {progress[0]}/{total_work} arm={arm} "
+                f"fold={fold_index + 1}/{len(data.anchors)} update={step}/{MAX_UPDATES} "
+                f"load1={current_load:.2f}",
+                flush=True,
+            )
+            if current_load > 30.0:
+                raise LoadPause(f"one-minute load average {current_load:.2f} exceeds 30")
+
+    trajectory = {}
+    for step in checkpoints:
+        weighted_loss = sum(value * count for value, count in objectives[step]) / sum(
+            count for _, count in objectives[step]
+        )
+        held_out = sweep.c3_metric(
+            [value for value in predictions[step] if value is not None], data.anchors
+        )
+        trajectory[str(step)] = {
+            "training_objective": float(weighted_loss),
+            "held_out": held_out,
+            "parameter_l2": sweep.summarize(norms[step]),
+        }
+
+    checks = {}
+    first_admissible = None
+    for step in checkpoints[1:]:
+        check = stability(sweep, trajectory[str(step - CADENCE)], trajectory[str(step)])
+        checks[str(step)] = check
+        if first_admissible is None and check["admissible"]:
+            first_admissible = step
+
+    total_by_interval = [sum(interval_total[step]) for step in checkpoints[1:]]
+    update_by_interval = [sum(interval_update[step]) for step in checkpoints[1:]]
+    checkpoint_by_interval = [sum(interval_checkpoint[step]) for step in checkpoints[1:]]
+    cumulative = []
+    running = 0.0
+    for value in total_by_interval:
+        running += value
+        cumulative.append(running)
+    return {
+        "arm": arm,
+        "procedure": "full_batch" if arm == "A" else "minibatch",
+        "trajectory": trajectory,
+        "cadence_checks": checks,
+        "first_admissible_update": first_admissible,
+        "wall_s": time.perf_counter() - arm_started,
+        "timing": {
+            "total_s_per_100_updates_across_12_loao_folds": total_by_interval,
+            "update_only_s_per_100_updates_across_12_loao_folds": update_by_interval,
+            "checkpoint_s_per_100_updates_across_12_loao_folds": checkpoint_by_interval,
+            "cumulative_total_s_across_12_loao_folds": cumulative,
+            "mean_total_s_per_100_updates_across_12_loao_folds": sum(total_by_interval) / len(total_by_interval),
+            "mean_update_only_s_per_100_updates_across_12_loao_folds": sum(update_by_interval) / len(update_by_interval),
+            "per_fold_interval_total_s": {str(step): interval_total[step] for step in checkpoints[1:]},
+        },
+        "maximum_observed_load1": max(load_observed),
+    }
+
+
+def equal_wall_comparison(arms: dict[str, dict[str, object]]) -> dict[str, object]:
+    a = arms["A"]
+    b = arms["B"]
+    a_times = a["timing"]["cumulative_total_s_across_12_loao_folds"]
+    b_times = b["timing"]["cumulative_total_s_across_12_loao_folds"]
+
+    def reached(times: list[float], budget: float) -> int:
+        return CADENCE * sum(value <= budget for value in times)
+
+    comparisons = []
+    for label, budget in (
+        ("arm_a_cap_time", a_times[-1]),
+        ("arm_b_cap_time", b_times[-1]),
+        ("common_cap_time", min(a_times[-1], b_times[-1])),
+    ):
+        comparisons.append({
+            "budget_label": label,
+            "wall_s": budget,
+            "arm_a_update": reached(a_times, budget),
+            "arm_b_update": reached(b_times, budget),
+        })
+    if b["first_admissible_update"] is not None:
+        budget = b_times[b["first_admissible_update"] // CADENCE - 1]
+        comparisons.append({
+            "budget_label": "arm_b_first_admissible_time",
+            "wall_s": budget,
+            "arm_a_update": reached(a_times, budget),
+            "arm_b_update": b["first_admissible_update"],
+        })
+    return {"comparisons": comparisons}
+
+
+def main() -> None:
+    verify_runtime()
+    initial_load = guard_load()
+    sweep = import_sweep()
+    verify_runtime()
+    before = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    data = sweep.load_c3()
+    c3_paths = tuple(anchor.path for anchor in data.anchors)
+    c3_before = {str(path): file_sha256(path) for path in c3_paths}
+    shuffle_seed = sweep.seed_from_domain(SHUFFLE_DOMAIN)
+    total_work = 2 * len(data.anchors) * MAX_UPDATES
+    progress = [0]
+    started = time.perf_counter()
+    arms = {}
+    status = "complete"
+    pause_reason = None
+    try:
+        arms["A"] = run_arm(sweep, data, "A", progress, total_work)
+        arms["B"] = run_arm(sweep, data, "B", progress, total_work)
+    except LoadPause as error:
+        status = "paused_load"
+        pause_reason = str(error)
+    after = {path: file_sha256(Path(path)) for path in EXPECTED_HASHES}
+    c3_after = {str(path): file_sha256(path) for path in c3_paths}
+    changed = [path for path in (*before, *c3_before) if (before | c3_before)[path] != (after | c3_after)[path]]
+    peak_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    if peak_kb * 1024 >= 3 * 1024**3:
+        raise RuntimeError(f"peak RSS cap exceeded: {peak_kb} KiB")
+    original = json.loads(SOURCE_RESULTS.read_text(encoding="utf-8"))
+    original_c3 = next(
+        cell for cell in original["cells"]
+        if cell["route"] == "C3" and cell["learning_rate"] == 1e-3
+    )
+    reproduction = None
+    if "A" in arms:
+        fields = ("training_objective", "held_out")
+        reproduction = {
+            str(step): all(
+                arms["A"]["trajectory"][str(step)][field]
+                == original_c3["trajectory"][str(step)][field]
+                for field in fields
+            )
+            for step in range(0, 501, 100)
+        }
+    result = {
+        "schema": "mcrl-v025-horizon-lever-diagnostic-v1",
+        "status": status,
+        "pause_reason": pause_reason,
+        "scope": {
+            "diagnostic_not_claim": True,
+            "ee_quantities_computed": False,
+            "selection_on_ee": False,
+            "metrics_use": "convergence diagnostics only; never evidence about EE",
+        },
+        "route": "C3",
+        "learning_rate": 1e-3,
+        "model_seed_domain": "V025_LEARNER/seed/1",
+        "model_seed": sweep.SEED,
+        "maximum_updates": MAX_UPDATES,
+        "cadence_updates": CADENCE,
+        "stability_tolerances": sweep.STABILITY_TOLERANCES,
+        "minibatch": {
+            "batch_size": BATCH_SIZE,
+            "shuffle_rng": "numpy Generator(PCG64)",
+            "shuffle_seed_domain": SHUFFLE_DOMAIN,
+            "shuffle_seed": shuffle_seed,
+            "replacement": False,
+            "replacement_scope": "without replacement within each pass; rows recur after reshuffle next pass",
+            "remainder_batch_used": True,
+            "fresh_same_seed_per_loao_fold": True,
+            "classification": "training-procedure change, not a hyperparameter",
+        },
+        "inventory": {
+            "anchors": len(data.anchors),
+            "rows": sum(anchor.truth.size for anchor in data.anchors),
+            "trainable_rows": sum(anchor.train_indices.size for anchor in data.anchors),
+            "input_files": [str(path) for path in c3_paths],
+        },
+        "arms": arms,
+        "equal_wall": equal_wall_comparison(arms) if len(arms) == 2 else None,
+        "arm_a_reproduces_lr_sweep_0_to_500": reproduction,
+        "resource_policy": {
+            "python_processes": 1,
+            "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "blas_threads": 1,
+            "rlimit_as_bytes": resource.getrlimit(resource.RLIMIT_AS)[0],
+            "peak_rss_kb": peak_kb,
+            "initial_load1": initial_load,
+            "final_load1": load_average(),
+            "elapsed_wall_s": time.perf_counter() - started,
+        },
+        "source_sha256_before": before,
+        "source_sha256_after": after,
+        "c3_input_sha256_before": c3_before,
+        "c3_input_sha256_after": c3_after,
+        "changed_inputs": changed,
+    }
+    atomic_json(OUT / "results.json", result)
+    print(f"PEAK_RSS_KB={peak_kb}", flush=True)
+    print(json.dumps({
+        "written": str(OUT / "results.json"),
+        "status": status,
+        "changed_inputs": changed,
+    }), flush=True)
+
+
+if __name__ == "__main__":
+    main()
