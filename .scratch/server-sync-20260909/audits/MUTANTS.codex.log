from mcrl.stagec_v025.synthetic import make_synthetic_anchors, run_synthetic_pipeline


def _digest(label: str) -> str:
    return canonical_sha256({"synthetic": label})


def _outcome(*, physical_f: float, phi: float = 0.0, kappa: float = 2.0) -> NetworkOutcome:
    # eta=1, E=100, so physical objective is bits-100.  The signed preference
    # enters F as +kappa*phi exactly once.
    del kappa
    return NetworkOutcome.build(
        bits=100.0 + physical_f,
        joules=100.0,
        phi=phi,
        decoding_availability=1.0,
        useful_availability=1.0,
    )


def _context(
    kind: str,
    members: tuple[int, ...],
    *,
    relabel: int = 0,
    omit_joint_context: bool = False,
    signal_scale: float = 1.0,
) -> CoalitionContext:
    base = tuple(
        (user, PhysicalAction(None, None))
        for user in range(max(3, max(members, default=-1) + 1))
    )
    del omit_joint_context
    pairwise = {
        # Same total cross-gain (0.9): one dominant aggressor versus three
        # weak aggressors.  No scalar feature below discloses the distribution.
        "synergy": (
            ("beam-a", "victim", 0.7),
            ("beam-b", "victim", 0.1),
            ("beam-c", "victim", 0.1),
        ),
        "antagonistic": (
            ("beam-a", "victim", 0.3),
            ("beam-b", "victim", 0.3),
            ("beam-c", "victim", 0.3),
        ),
        "additive": (
            ("beam-a", "victim", 0.3),
            ("beam-b", "victim", 0.3),
            ("beam-c", "victim", 0.3),
        ),
    }[kind]
    pairwise = tuple(
        (source, target, signal_scale * gain) for source, target, gain in pairwise
    )
    return CoalitionContext(
        anchor_id="information-twin-anchor",
        reference_profile=base,
        members=tuple(
            CoalitionMember(
                user_id=user,
                reference_action=base[user][1],
                selected_action=PhysicalAction(2000 + relabel + user, 20 + user),
                selected_q1_row=(1.0,),
                incumbent_q1_row=(float(user == 0),),
                missing_incumbent=False,
            )
            for user in members
        ),
        affected_beams=tuple(
            AffectedBeamContext(
                beam_key,
                0,
                len(members),
                False,
                bool(members),
                2.0,
                0.9 * signal_scale if beam_key == "victim" else 0.0,
            )
            for beam_key in ("beam-a", "beam-b", "beam-c", "victim")
        ),
        global_resource_features=(0.5, 0.5, 0.5),
        pairwise_cross_gain_terms=pairwise,
    )


def _coalition_row(
    kind: str, *, tmp_count: int = 2, members: tuple[int, ...] = (0, 1),
    signal_scale: float = 1.0,
):
    context = _context(kind, members, signal_scale=signal_scale)
    joint = {
        "synergy": _outcome(physical_f=4.0, phi=-1.0),       # F=+2
        "antagonistic": _outcome(physical_f=-2.0, phi=-1.0), # F=-4
        "additive": _outcome(physical_f=-2.0, phi=0.0),      # F=-2
    }[kind]
    return build_coalition_row(
        context=context,
        reference_outcome=_outcome(physical_f=0.0),
        unilateral_outcomes={
            user: (
                _outcome(physical_f=0.0, phi=-0.5)
                if user == 0
                else _outcome(physical_f=-1.0)
                if user == 1
                else _outcome(physical_f=0.0)
            )
            for user in members
        },
        coalition_outcome=joint,
        original_changed_user_count=tmp_count,
        original_changed_users=tuple(range(tmp_count)),
        world_id=f"synthetic/{kind}/{signal_scale.hex()}",
        world_seed=11,
        anchor_index=0,
        decision_time_utc="2026-01-01T00:00:00Z",
    assert float.fromhex(rows[1].objective_delta_normalized_hex) < 0.0
    held_out_path = tmp_path / "held-out-twins.jsonl"
    write_coalition_shard(held_out_path, rows)
    values = [
        json.loads(line)
        for line in held_out_path.read_text(encoding="ascii").splitlines()
    ]
    values[0]["context_schema"] = "mcrl-v025-stagec-c3-coalition-context-v1"
    stale_bytes = b"\n".join(canonical_json_bytes(value) for value in values) + b"\n"
    stale_path = tmp_path / "stale-context-shard.jsonl"
    stale_path.write_bytes(stale_bytes)
    stale_path.with_name(stale_path.name + ".sha256").write_text(
        f"{hashlib.sha256(stale_bytes).hexdigest()}  {stale_path.name}\n",
        encoding="ascii",
    )
    with pytest.raises(
        StageCContractError,
        match=r"schema drifted: expected .*context-v2.*got .*context-v1",
    ):
        read_coalition_shard(stale_path)
    batch = _held_out_training_batch(tmp_path, "twin-training.jsonl")
    model = _model_from_batch(batch, tmp_path)
    dominant = _context("synergy", (0, 1))
    diffuse = _context("antagonistic", (0, 1))
    assert dominant.payload()["context_schema"] == COALITION_CONTEXT_SCHEMA
    assert dominant.payload()["pairwise_cross_gain_top_k"] == PAIRWISE_CROSS_GAIN_TOP_K
    assert canonical_json_bytes(dominant.payload()) != canonical_json_bytes(
        diffuse.payload()
    )
    dominant_without_pairs = replace(dominant, pairwise_cross_gain_terms=())
    diffuse_without_pairs = replace(diffuse, pairwise_cross_gain_terms=())
    assert canonical_json_bytes(dominant_without_pairs.payload()) == canonical_json_bytes(
        diffuse_without_pairs.payload()
    )
    assert model.interaction(_context("synergy", ())) == 0.0
    assert model.interaction(_context("synergy", (0,))) == 0.0
    assert model.interaction(dominant) > 1.0
