def test_T2_information_twins_reversal_and_additive_placebo(tmp_path) -> None:
    rows = tuple(_coalition_row(kind) for kind in ("synergy", "antagonistic", "additive"))
    assert float.fromhex(rows[0].objective_delta_normalized_hex) > 0.0
    assert float.fromhex(rows[1].objective_delta_normalized_hex) < 0.0
    held_out_path = tmp_path / "held-out-twins.jsonl"
    write_coalition_shard(held_out_path, rows)
    values = [
        json.loads(line)
        for line in held_out_path.read_text(encoding="ascii").splitlines()
    ]
    values[0]["context_schema"] = "mcrl-v025-stagec-c3-coalition-context-v1"
    stale_bytes = b"\n".join(canonical_json_bytes(value) for value in values) + b"\n"
    stale_path = tmp_path / "stale-context-shard.jsonl"
    stale_path.write_bytes(stale_bytes)
    stale_path.with_name(stale_path.name + ".sha256").write_text(
        f"{hashlib.sha256(stale_bytes).hexdigest()}  {stale_path.name}\n",
        encoding="ascii",
    )
    with pytest.raises(
        StageCContractError,
        match=r"schema drifted: expected .*context-v2.*got .*context-v1",
    ):
        read_coalition_shard(stale_path)
    batch = _held_out_training_batch(tmp_path, "twin-training.jsonl")
    model = _model_from_batch(batch, tmp_path)
    dominant = _context("synergy", (0, 1))
    diffuse = _context("antagonistic", (0, 1))
    assert dominant.payload()["context_schema"] == COALITION_CONTEXT_SCHEMA
    assert dominant.payload()["pairwise_cross_gain_top_k"] == PAIRWISE_CROSS_GAIN_TOP_K
    assert canonical_json_bytes(dominant.payload()) != canonical_json_bytes(
        diffuse.payload()
    )
    dominant_without_pairs = replace(dominant, pairwise_cross_gain_terms=())
    diffuse_without_pairs = replace(diffuse, pairwise_cross_gain_terms=())
    assert canonical_json_bytes(dominant_without_pairs.payload()) == canonical_json_bytes(
        diffuse_without_pairs.payload()
    )
    assert model.interaction(_context("synergy", ())) == 0.0
    assert model.interaction(_context("synergy", (0,))) == 0.0
    assert model.interaction(dominant) > 1.0
    assert model.interaction(diffuse) < 0.0
    member_permuted = replace(dominant, members=tuple(reversed(dominant.members)))
    assert model.interaction(member_permuted) == pytest.approx(
        model.interaction(dominant), abs=1e-12
    )
    pair_permuted = replace(
        dominant,
        pairwise_cross_gain_terms=tuple(reversed(dominant.pairwise_cross_gain_terms)),
    )
    assert pair_permuted.payload_sha256 == dominant.payload_sha256
    assert canonical_json_bytes(pair_permuted.payload()) == canonical_json_bytes(
        dominant.payload()
    )
    assert model.interaction(pair_permuted) == pytest.approx(
        model.interaction(dominant), abs=1e-12
    )

    catalogue = ((0, 0, 0), (1, 0, 0), (0, 1, 0), (1, 1, 0))
    selector = ProfileSelector("S3")
    choose = lambda kind, relabel=0: selector.select(
        base_profile=(0, 0, 0), tables=(tables := _tables(relabel=relabel)), catalogue=catalogue,
        jointly_legal=lambda profile: profile in catalogue,
        service_guard=lambda profile: True, model=model,
        coalition_context={
            profile: _profile_contexts(kind, relabel=relabel)[profile]
            for profile in catalogue
        },
        model_checkpoint_sha256=model.checkpoint_sha256,
        **_selector_authority(tables, catalogue, anchor_id="information-twin-anchor"),
    ).profile
    assert choose("synergy") == (1, 1, 0)
    assert choose("antagonistic") == (0, 0, 0)
    laundered = {
        profile: _profile_contexts("synergy")[profile] for profile in catalogue
    }
