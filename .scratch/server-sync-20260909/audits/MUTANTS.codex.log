    credit_split: str
    joint_change_bits: Fraction
    phi_difference: Fraction
    c1: Fraction
    c3: Fraction

    @property
    def factor_c1(self) -> Fraction:
        """C1 selector value: exact physical singleton core plus Phi."""

        return self.c1 + self.phi_difference


