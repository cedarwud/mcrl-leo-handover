from __future__ import annotations

import math

import numpy as np
import pytest

from mcrl.physics_v025.acm import ACMRate, UncappedShannonDiagnosticRate
from mcrl.physics_v025.architectures import (
    AngleRateTPC_FDM,
    AngleRateTPC_TDM,
    AngleTPC_FDM,
    AngleTPC_TDM,
    FixedRF,
    Geometry,
    Link,
    RadiationConfig,
    _solve_power,
    _target_feasibility,
)
