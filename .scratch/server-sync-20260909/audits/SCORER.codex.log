+def _smoke_panel(widths: Mapping[str, int]) -> dict[str, object]:
+    rng = random.Random(20260910)
+    anchor_rows = []
+    anchor_ids = ["fixture-world-1/anchor-0", "fixture-world-1/anchor-1", "fixture-world-2/anchor-0"]
+    for anchor_index, anchor_id in enumerate(anchor_ids):
+        profiles = []
+        for profile_index in range(6):
+            state_pairs = {}
+            for route in ("C1", "C2"):
+                reference = [0.0 for _ in range(widths[route])]
+                selected = [
+                    0.0 if profile_index == 0 else rng.uniform(-1.0, 1.0) * (1.0 + 0.1 * anchor_index)
+                    for _ in range(widths[route])
+                ]
+                state_pairs[route] = [{"reference": reference, "selected": selected}]
+            c3_state = [
+                0.0 if profile_index == 0 else rng.uniform(-0.5, 0.5)
+                for _ in range(widths["C3"])
+            ]
+            quality = 1.0 + 0.15 * profile_index + 0.03 * anchor_index
+            profiles.append({
+                "profile_id": f"p{profile_index}",
+                "catalogue_order": profile_index,
+                **state_pairs,
+                "C3": {"coalition_size": 0 if profile_index == 0 else 2, "invariant_state": c3_state},
+                "outcome": {
+                    "full_buffer_bits": 1_000_000_000.0 * quality,
+                    "joules": 120.0 - 5.0 * profile_index + anchor_index,
+                    "rate_target_attained": 80 + 3 * profile_index,
+                    "rate_target_opportunities": 100,
+                    "service_available": 90 + profile_index,
+                    "service_opportunities": 100,
+                    "handovers": profile_index,
+                    "handover_opportunities": 100,
+                    "deadline_misses": 0,
+                    "decisions": 1,
+                },
+            })
+        anchor_rows.append({
+            "anchor_id": anchor_id,
+            "world_id": f"fixture-world-{1 + anchor_index // 2}",
+            "date": "2099-01-01",
+            "world_seed": 9000 + anchor_index,
+            "base_profile_id": "p0",
+            "certified_fixed_point_profile_id": "p5",
+            "anytime_incumbent_profile_id": "p4",
+            "profiles": profiles,
+            "arm_instrumentation": None,
+        })
+    traversal = (
+        "synthetic smoke: users ascending, legal actions ascending, first strict improvement, "
+        "restart at the first user after each commit, stop after a complete no-move sweep"
+    )
+    return {
+        "schema": PANEL_SCHEMA,
+        "panel_identity": {
+            "name": "synthetic-stagec-dual-axis-smoke-NOT-EVIDENCE",
+            "information_class": "synthetic fixture model inputs and synthetic full-buffer physical outcomes",
+            "estimand": "pipeline-population check only; no scientific EE estimand",
+            "numerator": NUMERATOR,
+            "energy_boundary": EE_BOUNDARY,
+            "anchors": anchor_ids,
+            "worlds": ["fixture-world-1", "fixture-world-2"],
+            "dates": ["2099-01-01"],
+            "world_seeds": [9000, 9001, 9002],
+            "fixed_point_traversal_order": traversal,
+            "provisioning_rule": "SYNTHETIC_FIXTURE_NOT_SEALED_OR_CLAIMABLE",
+        },
+        "reference_objects": {
+            "certified_fixed_point": {
+                "name": "synthetic offline certified fixed point p5",
+                "construction": "fixture-designated terminal p5; construction exists only to exercise the reference plumbing",
+                "information_class": "synthetic fixture",
+                "budget_s": None,
+                "fixed_point_traversal_order": traversal,
+            },
+            "anytime_incumbent": {
+                "name": "synthetic anytime incumbent p4 at 10 seconds",
+                "construction": "fixture-designated p4 returned at the same 10-second wall-clock budget",
+                "information_class": "synthetic fixture",
+                "budget_s": 10.0,
+                "fixed_point_traversal_order": traversal,
+            },
+        },
+        "coordinator_budget_s": 10.0,
+        "runner_instrumentation": {
+            "producer": "/home/sat/mcrl-v025-retrain-ws/scripts/run_stagec_training.py",
+            "physics_evaluations_per_arm_recorded": False,
+            "wall_clock_to_decision_per_arm_recorded": False,
+            "missing_fields_required_addition": (
+                "add per checkpoint/anchor/arm physics_evaluations_consumed and monotonic "
+                "wall_clock_to_committed_decision_s to the evaluation runner receipt; the training runner cannot supply them"
+            ),
+        },
+        "anchors": anchor_rows,
+        "synthetic_smoke_not_evidence": True,
+        "full_buffer_no_demand_cap": True,
+    }
+
+
+def _discover_checkpoints(paths: Sequence[Path]) -> list[Path]:
+    found = []
+    for path in paths:
+        resolved = path.resolve()
+        if resolved.is_dir():
+            for candidate in sorted(resolved.rglob("*.json")):
+                try:
+                    value = _read_json(candidate)
+                except ScorerContractError:
+                    continue
+                if isinstance(value, Mapping) and value.get("schema") == CHECKPOINT_SCHEMA:
+                    found.append(candidate)
+        elif resolved.is_file():
+            found.append(resolved)
+        else:
+            raise ScorerContractError(f"checkpoint path does not exist: {path}")
+    unique = []
+    seen = set()
+    for path in found:
+        identity = str(path.resolve())
+        if identity not in seen:
+            unique.append(path)
+            seen.add(identity)
+    if not unique:
+        raise ScorerContractError("no Stage-C checkpoint was found")
+    return unique
+
+
+def _classification(results: Sequence[Mapping[str, object]]) -> tuple[str, bool]:
+    all_coincide = all(result["knockout_check"]["coincide_at_every_anchor"] for result in results)
+    label = (
+        "knockout_contrast_no_source_substitution_claim"
+        if all_coincide else "neutral_source_substitution_contrast_decision_separated_from_knockout"
+    )
+    for result in results:
+        for row in result["axis_a"]:
+            if row.get("contrast") == "FULL-minus-ALL_NEUTRAL_CONTROL":
+                row["primary_interpretation"] = label
+    return label, all_coincide
+
+
+def _flatten(rows: Sequence[Mapping[str, object]]) -> list[dict[str, object]]:
+    def scalar(value: object) -> object:
+        if isinstance(value, (Mapping, list, tuple)):
+            return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+        return value
+    return [{key: scalar(value) for key, value in row.items()} for row in rows]
+
+
+def _write_csv(path: Path, rows: Sequence[Mapping[str, object]]) -> None:
+    flat = _flatten(rows)
+    fields = []
+    for row in flat:
+        for key in row:
+            if key not in fields:
+                fields.append(key)
+    if path.exists():
+        raise ScorerContractError(f"refusing to overwrite {path}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    with temporary.open("x", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="raise")
+        writer.writeheader()
+        writer.writerows(flat)
+        handle.flush()
+        os.fsync(handle.fileno())
+    temporary.replace(path)
+
+
+def _fmt(value: object) -> str:
+    if value is None:
+        return "UNAVAILABLE"
+    if isinstance(value, float):
+        return f"{value:.10g}"
+    return str(value)
+
+
+def _build_report(result: Mapping[str, object]) -> str:
+    panel = result["panel"]
+    lines = [
+        "# Stage-C dual-axis checkpoint score report",
+        "",
+        f"Status: **{'SYNTHETIC SMOKE — NOT EVIDENCE' if panel['synthetic_smoke_not_evidence'] else 'SCORING RESULT'}**.",
+        "",
+        f"Panel: `{panel['identity']['name']}`. Information class: {panel['identity']['information_class']}. ",
+        f"Numerator: {panel['identity']['numerator']}. Energy boundary: {panel['identity']['energy_boundary']}.",
+        "",
+        f"Anchors: `{json.dumps(panel['identity']['anchors'])}`; worlds: `{json.dumps(panel['identity']['worlds'])}`; "
+        f"dates: `{json.dumps(panel['identity']['dates'])}`; world seeds: `{json.dumps(panel['identity']['world_seeds'])}`.",
+        "",
+        f"Fixed-point traversal order: **{panel['identity']['fixed_point_traversal_order']}**.",
+        "",
+        "Loss values are not read or reported as EE evidence.",
+        "",
+        "## Knockout check before the primary contrast",
+        "",
+        f"Cross-checkpoint classification: `{result['primary_contrast_interpretation']}`. "
+        f"Neutral and all-knockout coincide at every anchor and checkpoint: `{result['neutral_and_knockout_coincide_everywhere']}`.",
+        "",
+        "| epoch | learner seed | differing anchors | N | pooled EE difference (bit/J) |",
+        "|---:|---:|---:|---:|---:|",
+    ]
+    for checkpoint in result["checkpoints"]:
+        check = checkpoint["knockout_check"]
+        lines.append(
+            f"| {checkpoint['checkpoint']['completed_source_epochs']} | {checkpoint['checkpoint']['learner_seed']} | "
+            f"{check['differing_anchor_count']} | {check['anchor_count']} | {_fmt(check['pooled_ee_difference_bits_per_j'])} |"
+        )
+    lines.extend([
+        "",
+        "## F6 — five-arm ablation",
+        "",
+        "Reference for the primary contrast is `ALL_NEUTRAL_CONTROL`, never `BASE`. Values are pooled on the full-buffer numerator with no demand cap.",
+        "",
+        "| epoch | arm/contrast | pooled EE or difference (bit/J) | relative difference | primary interpretation |",
+        "|---:|---|---:|---:|---|",
+    ])
+    for row in result["tables"]["F6_ablation"]:
+        label = row.get("arm", row.get("contrast"))
+        value = row.get("pooled_ee_bits_per_j", row.get("difference_bits_per_j"))
+        lines.append(
+            f"| {row['completed_source_epochs']} | {label} | {_fmt(value)} | {_fmt(row.get('relative_difference'))} | "
+            f"{row.get('primary_interpretation', '')} |"
+        )
+    lines.extend([
+        "",
+        "## F7 — training trajectory",
+        "",
+        "| epoch | arm | pooled EE (bit/J) | target attainment | availability | handover rate | deadline-miss rate |",
+        "|---:|---|---:|---:|---:|---:|---:|",
+    ])
+    for row in result["tables"]["F7_training_trajectory"]:
+        lines.append(
+            f"| {row['completed_source_epochs']} | {row['arm']} | {_fmt(row['pooled_ee_bits_per_j'])} | "
+            f"{_fmt(row['rate_target_attainment'])} | {_fmt(row['service_availability'])} | "
+            f"{_fmt(row['handover_rate'])} | {_fmt(row['deadline_miss_rate'])} |"
+        )
+    lines.extend([
+        "",
+        "## F8 — recovered fraction under the 10-second coordinator budget",
+        "",
+        f"Certified reference: {panel['references']['certified_fixed_point']['construction']} "
+        f"(information class: {panel['references']['certified_fixed_point']['information_class']}). "
+        f"Anytime comparator: {panel['references']['anytime_incumbent']['construction']} "
+        f"(information class: {panel['references']['anytime_incumbent']['information_class']}).",
+        "",
+        "| epoch | arm | arm/fixed point | anytime/fixed point | arm − anytime (bit/J) | physics evals | wall time | budget status |",
+        "|---:|---|---:|---:|---:|---:|---:|---|",
+    ])
+    for row in result["tables"]["F8_recovered_fraction"]:
+        lines.append(
+            f"| {row['completed_source_epochs']} | {row['arm']} | {_fmt(row['attained_ee_fraction_of_certified_fixed_point'])} | "
+            f"{_fmt(row['anytime_incumbent_fraction_of_certified_fixed_point'])} | {_fmt(row['arm_minus_anytime_bits_per_j'])} | "
+            f"{_fmt(row['physics_evaluations_consumed'])} | {_fmt(row['wall_clock_to_decision_mean_s'])} | "
+            f"{row['budget_compliance_status']} |"
+        )
+    if not panel["instrumentation_recorded"]:
+        lines.extend([
+            "",
+            "The training runner records neither physics evaluations consumed per arm nor wall-clock to committed decision. "
+            "No value is estimated. Required addition: " + panel["instrumentation"]["missing_fields_required_addition"] + ".",
+        ])
+    lines.extend([
+        "",
+        "## Evidence classification",
+        "",
+        "- Verified by running code: checkpoint parsing and arm inventory; model-score selection; pooled full-buffer B/E; co-metrics; same-budget anytime and certified-reference joins; knockout selections; all three emitted tables; resource receipt.",
+        "",
+        "- Derived on paper: differences, relative differences, and EE fractions are deterministic arithmetic on the verified pooled numerators and denominators.",
+        "",
+        "- Inferred: only the cross-checkpoint knockout classification is an interpretation of decision equality. No source-substitution claim is made when equality holds everywhere.",
+        "",
+    ])
+    return "\n".join(lines)
+
+
+def run(checkpoint_paths: Sequence[Path], panel_path: Path | None, output: Path, smoke: bool) -> dict[str, object]:
+    if output.exists():
+        raise ScorerContractError(f"output directory already exists: {output}")
+    checkpoints = [_load_checkpoint(path) for path in _discover_checkpoints(checkpoint_paths)]
+    widths = checkpoints[0]["widths"]
+    if any(checkpoint["widths"] != widths for checkpoint in checkpoints[1:]):
+        raise ScorerContractError("checkpoint model-input schemas differ")
+    if smoke:
+        if len(checkpoints) != 1 or checkpoints[0]["sha256"] != SMOKE_CHECKPOINT_SHA256:
+            raise ScorerContractError("--smoke-fixture requires the declared bcf99d... fixture checkpoint")
+        panel_raw = _smoke_panel(widths)
+    else:
+        if panel_path is None:
+            raise ScorerContractError("production scoring requires --panel")
+        panel_raw = _read_json(panel_path)
+    panel = _validate_panel(panel_raw, widths, panel_path)
+    scored = [_score_checkpoint(checkpoint, panel) for checkpoint in checkpoints]
+    label, all_coincide = _classification(scored)
+    f6 = [row for checkpoint in scored for row in checkpoint["axis_a"]]
+    f7 = [row for row in f6 if row["row_type"] == "arm"]
+    f8 = [row for checkpoint in scored for row in checkpoint["axis_b"]]
+    result = {
+        "schema": RESULT_SCHEMA,
+        "scorer": str(Path(__file__).resolve()),
+        "scorer_sha256": _sha256(Path(__file__)),
+        "panel": {key: panel[key] for key in (
+            "path", "sha256", "identity", "references", "instrumentation",
+            "instrumentation_recorded", "synthetic_smoke_not_evidence",
+        )},
+        "checkpoints": scored,
+        "primary_reference": "ALL_NEUTRAL_CONTROL",
+        "base_is_reference": False,
+        "primary_contrast_interpretation": label,
+        "neutral_and_knockout_coincide_everywhere": all_coincide,
+        "loss_values_are_not_ee_evidence": True,
+        "tables": {
+            "F6_ablation": f6,
+            "F7_training_trajectory": f7,
+            "F8_recovered_fraction": f8,
+        },
+        "resource_limits": {
+            "python_processes_used": PROCESS_COUNT,
+            "max_python_processes": 3,
+            "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "blas_threads": {name: os.environ[name] for name in THREAD_VARIABLES},
+            "address_space_limit_bytes": MAX_RSS_BYTES,
+            "peak_rss_bytes": _peak_rss_bytes(),
+        },
+    }
+    if result["resource_limits"]["peak_rss_bytes"] >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS exceeded the strict per-process bound")
+    output.mkdir(parents=True, exist_ok=False)
+    _write_json_once(output / "dual-axis-scores.json", result)
+    _write_csv(output / "F6-ablation.csv", f6)
+    _write_csv(output / "F7-training-trajectory.csv", f7)
+    _write_csv(output / "F8-recovered-fraction.csv", f8)
+    _write_bytes_once(output / "report.md", _build_report(result).encode("utf-8"))
+    return result
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--checkpoints", type=Path, nargs="+", required=True)
+    parser.add_argument("--panel", type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--smoke-fixture", action="store_true")
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    try:
+        _enforce_resources()
+        args = build_parser().parse_args(argv)
+        if args.smoke_fixture == (args.panel is not None):
+            raise ScorerContractError("choose exactly one of --panel or --smoke-fixture")
+        result = run(args.checkpoints, args.panel, args.output.resolve(), args.smoke_fixture)
+        print(json.dumps({
+            "event": "dual-axis-scoring-complete",
+            "checkpoints": len(result["checkpoints"]),
+            "F6_rows": len(result["tables"]["F6_ablation"]),
+            "F7_rows": len(result["tables"]["F7_training_trajectory"]),
+            "F8_rows": len(result["tables"]["F8_recovered_fraction"]),
+            "primary_interpretation": result["primary_contrast_interpretation"],
+        }, sort_keys=True), flush=True)
+        return 0
+    except ScorerContractError as error:
+        print(f"SCORER_CONTRACT_ERROR: {error}", file=sys.stderr, flush=True)
+        return 2
+    finally:
+        print(f"PEAK_RSS_BYTES={_peak_rss_bytes()}", flush=True)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
