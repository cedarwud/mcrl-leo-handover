+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+REPO = Path(__file__).resolve().parents[2]
+SCORER = REPO / "scripts/score_stagec_checkpoints.py"
+CHECKPOINT = Path(
+    "/home/sat/mcrl-v025-retrain-ws/.scratch/training-runner-checkpoint-kat-20260910-final/"
+    "fixture-checkpoint/learner-6407676579069309528-epoch-000100.json"
+)
+
+
+def _module():
+    spec = importlib.util.spec_from_file_location("dual_axis_scorer", SCORER)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_fixture_populates_all_tables_and_knockout(tmp_path: Path) -> None:
+    scorer = _module()
+    result = scorer.run([CHECKPOINT], None, tmp_path / "score", True)
+    assert len(result["tables"]["F6_ablation"]) == 9
+    assert len(result["tables"]["F7_training_trajectory"]) == 5
+    assert len(result["tables"]["F8_recovered_fraction"]) == 5
+    assert result["checkpoints"][0]["knockout_check"]["anchor_count"] == 3
+    assert result["primary_reference"] == "ALL_NEUTRAL_CONTROL"
+    assert result["base_is_reference"] is False
+    assert all(row["physics_evaluations_consumed"] is None for row in result["tables"]["F8_recovered_fraction"])
+    assert all(row["wall_clock_to_decision_s"] is None for row in result["tables"]["F8_recovered_fraction"])
+    for name in (
+        "dual-axis-scores.json", "report.md", "F6-ablation.csv",
+        "F7-training-trajectory.csv", "F8-recovered-fraction.csv",
+    ):
+        assert (tmp_path / "score" / name).is_file()
+
+
+def test_panel_rejects_implicit_fixed_point_order() -> None:
+    scorer = _module()
+    checkpoint = scorer._load_checkpoint(CHECKPOINT)
+    panel = scorer._smoke_panel(checkpoint["widths"])
+    panel["panel_identity"]["fixed_point_traversal_order"] = ""
+    try:
+        scorer._validate_panel(panel, checkpoint["widths"], None)
+    except scorer.ScorerContractError as error:
+        assert "traversal order" in str(error)
+    else:
+        raise AssertionError("implicit traversal order was accepted")
+
+
+def test_knockout_global_classification_relabels_primary() -> None:
+    scorer = _module()
+    rows = [{
+        "knockout_check": {"coincide_at_every_anchor": True},
+        "axis_a": [{"contrast": "FULL-minus-ALL_NEUTRAL_CONTROL", "primary_interpretation": "pending"}],
+    }]
+    label, all_coincide = scorer._classification(rows)
+    assert all_coincide is True
+    assert label == "knockout_contrast_no_source_substitution_claim"
+    assert rows[0]["axis_a"][0]["primary_interpretation"] == label

