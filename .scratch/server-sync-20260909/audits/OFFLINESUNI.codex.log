+++ b/tests/physics_v025/test_offline_suni_diagnostic.py
@@ -0,0 +1,214 @@
+"""Contract checks for the deadline-free certified unilateral diagnostic."""
+
+from __future__ import annotations
+
+from fractions import Fraction
+import importlib.util
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+
+REPO = Path(__file__).resolve().parents[2]
+OFFLINE = REPO / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_offline_suni.py"
+
+
+def _load_offline(name: str):
+    spec = importlib.util.spec_from_file_location(name, OFFLINE)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+class FakeEvaluator:
+    def __init__(self, values, served=None):
+        self.values = values
+        self.served = served or {}
+        self._invalid = set()
+        self.counter = SimpleNamespace(boundary_evaluations=0)
+        self._seen = set()
+
+    def evaluate_many(self, configs):
+        for config in configs:
+            self.evaluate(config)
+
+    def evaluate(self, config):
+        if config.configuration_id not in self._seen:
+            self._seen.add(config.configuration_id)
+            self.counter.boundary_evaluations += 1
+        key = tuple(identity for _user, identity in config.assignments)
+        return SimpleNamespace(
+            score=SimpleNamespace(
+                served_phy={
+                    user: self.served.get((key, user), True)
+                    for user, _identity in config.assignments
+                }
+            ),
+            outcome=lambda: SimpleNamespace(value=Fraction(self.values[key])),
+        )
+
+
+class FakeRunner:
+    @staticmethod
+    def _configuration(base, mapping, *, kind):
+        del kind
+        assignments = tuple(sorted(mapping.items()))
+        encoded = ";".join(
+            f"{user}:{'NULL' if identity is None else identity[0]}"
+            for user, identity in assignments
+        )
+        changed = sum(dict(base.assignments)[user] != identity for user, identity in assignments)
+        return SimpleNamespace(
+            configuration_id=f"CFG:{encoded}",
+            assignments=assignments,
+            changed_users=changed,
+            mapping=dict(assignments),
+        )
+
+    @staticmethod
+    def _objective(profile, calibration):
+        del calibration
+        return profile.outcome().value
+
+    @staticmethod
+    def _phi_for(incumbent, config, *, cell_rekeyed_users):
+        del incumbent, config, cell_rekeyed_users
+        return Fraction()
+
+
+def _config(*identities):
+    assignments = tuple(enumerate(identities))
+    return SimpleNamespace(
+        configuration_id="BASE",
+        assignments=assignments,
+        changed_users=0,
+        mapping=dict(assignments),
+    )
+
+
+def test_sequential_arm_moves_and_emits_completed_neighbourhood_certificate() -> None:
+    offline = _load_offline("v025_offline_suni_moves")
+    base = _config((10, 1), (20, 1))
+    options = {0: ((10, 1), (11, 1)), 1: ((20, 1), (21, 1))}
+    values = {
+        ((10, 1), (20, 1)): 0,
+        ((11, 1), (20, 1)): 2,
+        ((10, 1), (21, 1)): 1,
+        ((11, 1), (21, 1)): 5,
+    }
+    result = offline.sequential_round_robin(
+        runner=FakeRunner,
+        anchor=base,
+        incumbent=base,
+        options=options,
+        evaluator=FakeEvaluator(values),
+        calibration=SimpleNamespace(kappa_bits_per_user_step=Fraction(1)),
+    )
+    assert result.final.assignments == ((0, (11, 1)), (1, (21, 1)))
+    assert result.move_count == 2
+    assert result.pass_count == 2
+    assert result.completed_neighbourhood == {
+        "complete": True,
+        "statement": offline.CERTIFICATE_STATEMENT,
+        "legal_unilateral_alternatives_evaluated": 2,
+        "physically_invalid_alternatives": 0,
+        "service_guard_rejected_alternatives": 0,
+        "strictly_improving_alternatives": 0,
+    }
+
+
+def test_sequential_and_global_paths_agree_on_sampled_anchor() -> None:
+    offline = _load_offline("v025_offline_suni_agreement")
+    base = _config((10, 1), (20, 1))
+    options = {0: ((10, 1), (11, 1)), 1: ((20, 1), (21, 1))}
+    values = {
+        ((10, 1), (20, 1)): 0,
+        ((11, 1), (20, 1)): 2,
+        ((10, 1), (21, 1)): 1,
+        ((11, 1), (21, 1)): 5,
+    }
+    kwargs = dict(
+        runner=FakeRunner,
+        anchor=base,
+        incumbent=base,
+        options=options,
+        calibration=SimpleNamespace(kappa_bits_per_user_step=Fraction(1)),
+    )
+    sequential = offline.sequential_round_robin(
+        **kwargs, evaluator=FakeEvaluator(values)
+    )
+    global_result = offline.global_argmax(
+        **kwargs, evaluator=FakeEvaluator(values)
+    )
+    assert sequential.final.assignments == global_result.final.assignments
+    assert sequential.completed_neighbourhood["complete"] is True
+    assert global_result.completed_neighbourhood["complete"] is True
+
+
+def test_receipt_calls_path_dependent_result_neither_ceiling_nor_claim() -> None:
+    offline = _load_offline("v025_offline_suni_wording")
+    base = _config((10, 1))
+    result = offline.SearchResult(
+        final=base,
+        move_count=0,
+        pass_count=1,
+        wall_seconds=0.5,
+        physical_boundary_evaluations=2,
+        candidate_evaluation_requests=1,
+        completed_neighbourhood={
+            "complete": True,
+            "statement": offline.CERTIFICATE_STATEMENT,
+            "legal_unilateral_alternatives_evaluated": 1,
+            "physically_invalid_alternatives": 0,
+            "service_guard_rejected_alternatives": 0,
+            "strictly_improving_alternatives": 0,
+        },
+    )
+    receipt = offline.result_receipt(
+        result=result,
+        anchor=base,
+        world_domain="KAT",
+        world_sha256="0" * 64,
+        step_index=0,
+        carrier="nearest-eligible",
+        path="DETERMINISTIC_SEQUENTIAL_ROUND_ROBIN",
+    )
+    assert receipt["arm"] == "S_UNI_OFFLINE"
+    assert receipt["claim_status"] == "DIAGNOSTIC_NOT_CLAIM"
+    assert receipt["not_a_unilateral_ceiling"] is True
+    assert "only 'not reproducible by this greedy path'" in receipt["interpretation_limit"]
+
+
+def test_t2_strengthening_rejects_current_degenerate_anchor_anchor_behavior() -> None:
+    offline = _load_offline("v025_offline_suni_t2_degenerate")
+    with pytest.raises(offline.OfflineSuniError, match="T2 is vacuous"):
+        offline.assert_t2_additive_placebo_nonvacuous(
+            interaction=0.0,
+            interaction_tolerance=1.0e-12,
+            anchor_configuration_id="BASE",
+            deployed_configuration_id="BASE",
+            unilateral_configuration_id="BASE",
+        )
+
+
+def test_t2_requires_near_zero_placebo_and_matching_non_anchor_decision() -> None:
+    offline = _load_offline("v025_offline_suni_t2_nonvacuous")
+    offline.assert_t2_additive_placebo_nonvacuous(
+        interaction=0.0,
+        interaction_tolerance=1.0e-12,
+        anchor_configuration_id="BASE",
+        deployed_configuration_id="ALT",
+        unilateral_configuration_id="ALT",
+    )
+    with pytest.raises(offline.OfflineSuniError, match="does not match"):
+        offline.assert_t2_additive_placebo_nonvacuous(
+            interaction=0.0,
+            interaction_tolerance=1.0e-12,
+            anchor_configuration_id="BASE",
+            deployed_configuration_id="OTHER",
+            unilateral_configuration_id="ALT",
+        )

