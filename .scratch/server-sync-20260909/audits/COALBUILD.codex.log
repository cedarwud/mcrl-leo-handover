   254	
   255	    ATTEMPT_REGISTRY.parent.mkdir(parents=True, exist_ok=True)
   256	    with ATTEMPT_REGISTRY.open("a+b") as handle:
   257	        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
   258	        handle.seek(0)
   259	        lines = [line for line in handle.read().splitlines() if line]
   260	        previous = None
   261	        if lines:
   262	            previous = json.loads(lines[-1])["record_sha256"]
   263	        record = {
