   284	def _attempt_records() -> list[dict[str, object]]:
   285	    if not ATTEMPT_REGISTRY.is_file():
   286	        return []
   287	    records = [json.loads(line) for line in ATTEMPT_REGISTRY.read_text(encoding="ascii").splitlines() if line]
   288	    previous = None
   289	    for record in records:
   290	        declared = record.get("record_sha256")
   291	        unsigned = dict(record)
   292	        unsigned.pop("record_sha256", None)
   293	        if unsigned.get("previous_record_sha256") != previous or declared != digest_payload(unsigned):
   294	            raise ProbeError("attempt registry hash chain is invalid")
   295	        previous = declared
   296	    return records
