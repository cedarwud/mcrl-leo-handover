   709	def read_coalition_shard(path: str | Path) -> CoalitionShard:
   710	    source = Path(path)
   711	    digest = verify_sha256_sidecar(source)
   712	    try:
   713	        raw_lines = source.read_bytes().splitlines()
   714	        values = [json.loads(line.decode("ascii")) for line in raw_lines]
   715	    except (OSError, UnicodeError, json.JSONDecodeError) as error:
   716	        raise StageCContractError("cannot parse coalition shard") from error
   717	    if not values or not isinstance(values[0], Mapping):
   718	        raise StageCContractError("coalition shard header is missing")
   719	    header = values[0]
   720	    actual_versions = {
   721	        "shard": header.get("schema", "<missing>"),
   722	        "row": header.get("row_schema", "<missing>"),
   723	        "context": header.get("context_schema", "<missing>"),
   724	    }
   725	    expected_versions = {
   726	        "shard": COALITION_SHARD_SCHEMA,
   727	        "row": COALITION_ROW_SCHEMA,
   728	        "context": COALITION_CONTEXT_SCHEMA,
   729	    }
   730	    if actual_versions != expected_versions:
   731	        raise StageCContractError(
   732	            "coalition shard schema drifted: "
   733	            f"expected {expected_versions}, got {actual_versions}"
   734	        )
   735	    expected_header = {
