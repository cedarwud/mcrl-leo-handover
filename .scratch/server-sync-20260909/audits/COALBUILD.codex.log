   341	        useful = math.fsum(self.score.useful_time_s.values()) / opportunities
   342	        return NetworkOutcome.build(
   343	            bits=sum((Fraction(str(value)) for value in self.score.bits.values()), Fraction()),
   344	            joules=self.joules,
   345	            phi=phi,
   346	            decoding_availability=min(1.0, max(0.0, decoding)),
   347	            useful_availability=min(1.0, max(0.0, useful)),
   348	            per_user_bits=self.score.bits,
   349	        )
