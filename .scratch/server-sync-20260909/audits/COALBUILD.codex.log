   582	def _action(payload: Mapping[str, object]) -> PhysicalAction:
   583	    return PhysicalAction(
   584	        None if payload["norad_id"] is None else int(payload["norad_id"]),
   585	        None if payload["beam_chain_id"] is None else int(payload["beam_chain_id"]),
