   120	    if Path(sys.executable).resolve() != INTERPRETER.resolve():
   121	        raise RuntimeError(f"wrong interpreter: {sys.executable}; required {INTERPRETER}")
   122	    current_nice = os.getpriority(os.PRIO_PROCESS, 0)
   123	    if current_nice < REQUIRED_NICE:
   124	        os.nice(REQUIRED_NICE - current_nice)
   125	    if os.getpriority(os.PRIO_PROCESS, 0) < REQUIRED_NICE:
   126	        raise RuntimeError("could not enforce nice -n 15")
   127	    bad = {name: os.environ.get(name) for name in THREAD_VARIABLES if os.environ.get(name) != "1"}
