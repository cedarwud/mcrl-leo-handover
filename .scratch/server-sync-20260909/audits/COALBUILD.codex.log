def _build_anchor_rows_primitive(
    *, tape, setting, run_setting, calibration, step_index, carrier,
    anchor_index, include_coalition, full_legal_actions,
):
    """Schema-complete provider-primitive fallback for bounded pilot compute."""

    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    # The generating-input digest already authenticates the provider inputs
    # and boundary-zero bytes. Computing ``tape.digest`` here hashes every
    # dense 33x48 array and dominates an entire anchor on this snapshot.
    tape_digest = tape.generating_input_digest or canonical_sha256({
        "domain": tape.domain,
        "seed": tape.seed,
        "provider": tape.protocol.provider_source_digest,
    })
    future_bases = {
        offset: ENGINE._base_configuration(tape, step_index + offset, carrier)
        for offset in (1, 2, 3)
    }
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape, setting, step_index, transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal", counter=counter, run_setting=run_setting,
        boundary_indices=(0,),
    )
    base_profile = current.evaluate(base)
    source_rows = []
    rows_by_user_action = {}
    for user in sorted(by_user):
        actions = []
        identities = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        base_metric = _primitive_metrics(
            tape, step_index, user, base.mapping[user], indices
        )
        base_gain = max(base_metric["gain"], 1e-300)
        for identity in by_user[user]:
            metric = _primitive_metrics(tape, step_index, user, identity, indices)
            ratio = max(metric["gain"], 1e-300) / base_gain
            gain_db = 10.0 * math.log10(max(ratio, 1e-30))
            if identity is None or not metric["legal"]:
                normalized_delta = -1.0
            else:
                normalized_delta = math.tanh(math.log(max(ratio, 1e-30)))
            candidate_margin = base_profile.min_decoding_margin_db + gain_db
            required_ratio = min(1e6, max(0.0, base_profile.required_power_w_max / BEAM_RF_CAP_W / max(ratio, 1e-12)))
            se = max(0.0, base_profile.mean_acm_se_bit_s_hz * min(4.0, max(0.0, ratio)))
            forecast_rows = []
            c2_normalized = 0.0
            alive = True
            for offset in (1, 2, 3):
                projected = step_index + offset
                future_metric = _primitive_metrics(tape, projected, user, identity, indices)
                future_base = future_bases[offset].mapping[user]
                future_base_metric = _primitive_metrics(tape, projected, user, future_base, indices)
                future_ratio = max(future_metric["gain"], 1e-300) / max(future_base_metric["gain"], 1e-300)
                survives = bool(future_metric["legal"] and identity is not None)
                if alive:
                    c2_normalized += math.tanh(math.log(max(future_ratio, 1e-30))) if survives else -1.0
                    alive = survives
                else:
                    c2_normalized -= 1.0
                forecast_rows.append(ForecastObservation(
                    valid=survives,
                    survival=survives,
                    minimum_decoding_margin_db=base_profile.min_decoding_margin_db + 10.0 * math.log10(max(future_ratio, 1e-30)),
                    mean_acm_spectral_efficiency=max(0.0, se * min(4.0, max(0.0, future_ratio))),
                ))
            phi = ENGINE._phi_for(incumbent, configs[(user, identity)]) - ENGINE._phi_for(incumbent, base)
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = 0 if identity is None else previous_beam.get(identity, 0)
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=candidate_margin,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=se,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=metric["remaining_d2"],
                remaining_visibility_time_s=metric["remaining_visibility"],
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent.mapping[user],
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=identity is not None and identity in previous_beam,
                previous_satellite_active_for_action=identity is not None and identity[0] in previous_satellite,
                previous_beam_max_rf_over_cap=0.0 if identity is None else min(1.0, required_ratio),
                missing_incumbent=incumbent.mapping[user] is None,
                candidate_current_nominal_decoding_margin_db=candidate_margin,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(forecast_rows[0].mean_acm_spectral_efficiency - se) / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W * (1.0 - required_ratio),
                forecasts=tuple(forecast_rows),
                c1_label_bits=float(calibration.kappa_bits_per_user_step) * normalized_delta,
                c1_phi_difference=float(phi),
                c2_label_bits=float(calibration.kappa_bits_per_user_step) * c2_normalized,
                legal=True,
                terminal=step_index == 29,
                outage=not bool(metric["legal"]),
            )
            actions.append(seal_action_evaluation(
                observation,
                source_provenance_sha256=canonical_sha256({
                    "artifact_label": LABEL, "method": "provider-primitive-fallback",
                    "world": tape_digest, "step": step_index, "carrier": carrier,
                    "user": user, "identity": identity,
                }),
                forecast_method_sha256=canonical_sha256({
                    "method": "provider-primitive-boundary-0", "offsets": [1, 2, 3]
                }),
            ))
            identities.append(identity)
        envelope = AnchorEnvelope(
            world_id=tape.domain, split="TRAIN", world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}", anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user, setting_id="a-r0", code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST, launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest, calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape), allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]), actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row
    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)
    return {
        "base": base, "incumbent": incumbent, "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action, "current_evaluator": current,
        "coalition_row": coalition_row, "census": census, "skipped_invalid": 0,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=0.0 if primitive is None else primitive["remaining_d2"],
                remaining_visibility_time_s=(
                    0.0 if primitive is None else primitive["remaining_visibility"]
                ),
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent_identity,
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=(
                    identity is not None and identity in previous_beam
                ),
                previous_satellite_active_for_action=(
                    identity is not None and identity[0] in previous_satellite
                ),
                previous_beam_max_rf_over_cap=(
                    0.0 if identity is None else min(1.0, required_ratio)
                ),
                missing_incumbent=missing_incumbent,
                candidate_current_nominal_decoding_margin_db=profile.min_decoding_margin_db,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(
                    projections[0].mean_acm_se_bit_s_hz
                    - profile.mean_acm_se_bit_s_hz
                )
                / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W - profile.required_power_w_max,
                forecasts=tuple(
                    ForecastObservation(
                        valid=row.valid,
                        survival=row.survives,
                        minimum_decoding_margin_db=row.min_decoding_margin_db,
                        mean_acm_spectral_efficiency=row.mean_acm_se_bit_s_hz,
                    )
                    for row in projections
                ),
                c1_label_bits=float(core),
                c1_phi_difference=float(phi),
                c2_label_bits=float(c2.forecast_surplus_bits - c2.persistence_penalty_bits),
                legal=True,
                terminal=step_index == 29,
                outage=not bool(profile.score.served_phy.get(user, False)),
            )
            provenance = canonical_sha256(
                {
                    "artifact_label": LABEL,
                    "world": tape.digest,
                    "step": step_index,
                    "carrier": carrier,
                    "user": user,
                    "configuration": config.configuration_id,
                }
            )
            actions.append(
                seal_action_evaluation(
                    observation,
                    source_provenance_sha256=provenance,
                    forecast_method_sha256=canonical_sha256(
                        {
                            "engine": ENGINE.SCHEMA,
                            "offsets": [1, 2, 3],
                            "boundaries": list(ENGINE.SELECTION_BOUNDARY_INDICES),
                        }
                    ),
                )
            )
            identities.append(identity)
        if base.mapping[user] not in identities or None not in identities:
            raise RuntimeError("source action set lost BASE or the explicit null action")
        envelope = AnchorEnvelope(
            world_id=tape.domain,
            split="TRAIN",
            world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}",
            anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user,
            setting_id="a-r0",
            code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST,
            launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest,
            calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape),
            allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]),
            actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row

    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _catalogue_census = ENGINE._catalogue_with_census(
            tape,
            step_index,
            base,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        current.evaluate_many(catalogue)
        catalogue_count = len(catalogue)
        factors = ENGINE._selection_factor_scores(
            base=base,
            incumbent=incumbent,
            catalog=tuple(
                row for row in catalogue if row.configuration_id not in current._invalid
            ),
            evaluated=current._evaluated,
            calibration=calibration,
            cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        )
        pairwise = [
            row
            for row in catalogue
            if row.changed_users == 2
            and row.configuration_id in factors
        ]
        if not pairwise:
            raise RuntimeError("sealed catalogue produced no trainable joint coalition")
        selected = min(
            pairwise,
            key=lambda row: (
                -float(factors[row.configuration_id]["C1"] + factors[row.configuration_id]["C3"]),
                row.configuration_id,
            ),
        )
        coalition_row = _coalition_row(
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            run_setting=run_setting,
        )
    return {
        "base": base,
        "incumbent": incumbent,
        "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action,
        "current_evaluator": current,
        "coalition_row": coalition_row,
        "census": census,
        "skipped_invalid": skipped_invalid,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )


def _coalition_row(
    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
    rows_by_user_action, calibration, run_setting,
):
    context = _coalition_context(
        tape=tape,
        step_index=step_index,
        anchor=anchor,
        selected=selected,
        rows_by_user_action=rows_by_user_action,
    )
    reference = evaluator.evaluate(anchor).outcome(
        phi=ENGINE._phi_for(anchor, anchor)
    )
    unilateral = {}
    for user in context.changed_users:
        mapping = anchor.mapping
        mapping[user] = selected.mapping[user]
        config = ENGINE._configuration(anchor, mapping, kind="pilot-coalition-singleton")
        unilateral[user] = evaluator.evaluate(config).outcome(
            phi=ENGINE._phi_for(anchor, config)
        )
    selected_outcome = evaluator.evaluate(selected).outcome(
        phi=ENGINE._phi_for(anchor, selected)
    )
    return build_coalition_row(
        context=context,
        reference_outcome=reference,
        unilateral_outcomes=unilateral,
        coalition_outcome=selected_outcome,
        world_id=tape.domain,
        world_seed=tape.seed,
        anchor_index=anchor_index,
        decision_time_utc=_utc_at(tape, step_index),
        decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
        setting_id="a-r0",
        lambda_bits_per_j=float(calibration.lambda_bits_per_j),
        eta_ref_bits_per_j=float(calibration.eta_ref),
        kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
        code_digest=CODE_DIGEST,
        physics_digest=PHYSICS_DIGEST,
        catalogue_digest=ENGINE.catalogue_definition()["sha256"],
        setting_digest=run_setting.digest,
        calibration_digest=calibration.digest,
        allocation_manifest_digest=ALLOCATION_DIGEST,
    )


def _write_phase_manifest(path: Path, payload: Mapping[str, object]) -> str:
    return write_once_json(path, {"artifact_label": LABEL, **payload})


def generate_rows(output: Path):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    source_shards = []
    coalition_shards = []
    calibration = None
    world_records = []
    if proposed.configuration_id not in evaluator._invalid:
        return proposed, 0
    mapping = proposed.mapping
    repairs = 0
    for user in sorted(mapping):
        if mapping[user] == base.mapping[user]:
            continue
        mapping[user] = base.mapping[user]
        repairs += 1
        candidate = ENGINE._configuration(base, mapping, kind="pilot-deterministic-repair")
        evaluator.evaluate_many((candidate,))
        if candidate.configuration_id not in evaluator._invalid:
            return candidate, repairs
    return base, repairs


def _additive_scores(model, rows_by_user_action, base, config):
    total = 0.0
    for user in sorted(base.mapping):
        reference = rows_by_user_action[(user, base.mapping[user])]
        selected = rows_by_user_action[(user, config.mapping[user])]
        total += (
            model.q1.score(selected.q1_state) - model.q1.score(reference.q1_state)
            + model.q2.score(selected.q2_state) - model.q2.score(reference.q2_state)
        )
    return total


def _exact_interactions(anchor, incumbent, catalogue, evaluator, calibration):
    evaluator.evaluate_many(catalogue)
    base_profile = evaluator.evaluate(anchor)
    base_core = (
        Fraction(str(base_profile.bits))
        - calibration.eta_ref * Fraction(str(base_profile.joules))
        + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, anchor)
    )
    singleton_by_key = {}
    for config in catalogue:
        for user in anchor.mapping:
            if config.mapping[user] == anchor.mapping[user]:
                continue
            mapping = anchor.mapping
            mapping[user] = config.mapping[user]
            singleton_by_key[(config.configuration_id, user)] = ENGINE._configuration(
                anchor, mapping, kind="pilot-exact-singleton"
            )
    evaluator.evaluate_many(tuple({
        row.assignments: row for row in singleton_by_key.values()
    }.values()))
    values = {}
    for config in catalogue:
        if config.configuration_id in evaluator._invalid:
            continue
        changed = tuple(user for user in anchor.mapping if config.mapping[user] != anchor.mapping[user])
        additive = Fraction()
        for user in changed:
            singleton = singleton_by_key[(config.configuration_id, user)]
            if singleton.configuration_id in evaluator._invalid:
                additive = Fraction(-10**30)
                break
            profile = evaluator.evaluate(singleton)
            additive += (
                Fraction(str(profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules))
                + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, singleton)
                - base_core
            )
        profile = evaluator.evaluate(config)
        joint = (
            Fraction(str(profile.bits))
            - calibration.eta_ref * Fraction(str(profile.joules))
            + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, config)
            - base_core
        )
        values[config.configuration_id] = {
            "changed": changed,
            "joint": float(joint / calibration.kappa_bits_per_user_step),
            "additive": float(additive / calibration.kappa_bits_per_user_step),
            "psi": float((joint - additive) / calibration.kappa_bits_per_user_step),
        }
    return values


def _structural_interactions(anchor, catalogue):
    return {
        config.configuration_id: {
            "changed": tuple(
                user for user in anchor.mapping
                if config.mapping[user] != anchor.mapping[user]
            ),
            "joint": 0.0, "additive": 0.0, "psi": 0.0,
        }
        for config in catalogue
    }


def _build_u_catalogue(
    tape, step_index, a0, u, standard_catalogue, evaluator, calibration,
    rows_by_user_action,
):
    started = time.perf_counter()
    options, _ = ENGINE._legal_options(tape, step_index)
    evaluator.evaluate(u)
    candidates_by_user = {}
    for user in sorted(options):
        candidates = []
        for identity in options[user]:
            if identity == u.mapping[user]:
                continue
            mapping = u.mapping
            mapping[user] = identity
            config = ENGINE._configuration(a0, mapping, kind="pilot-u-unilateral")
            reference = rows_by_user_action[(user, u.mapping[user])]
            selected = rows_by_user_action[(user, identity)]
            score = (
                float.fromhex(selected.c1_label_normalized_hex)
                + float.fromhex(selected.c2_label_normalized_hex)
                - float.fromhex(reference.c1_label_normalized_hex)
                - float.fromhex(reference.c2_label_normalized_hex)
            )
            candidates.append((Fraction(str(score)), config))
        candidates_by_user[user] = candidates
    moves = {}
    for user in sorted(options):
        moves[user] = sorted(
            candidates_by_user[user],
            key=lambda row: (-row[0], row[1].configuration_id),
        )
    ranked = sorted(
        (user for user in moves if moves[user]),
        key=lambda user: (-abs(float(moves[user][0][0])), user),
    )[:10]
    rows = [a0, u]
    rows.extend(row for row in standard_catalogue if row.changed_users == 1)
    rows.extend(
        row for row in standard_catalogue if row.kind in {"s0-top-two", "beam-evacuation"}
    )
    for first, second in itertools.combinations(ranked, 2):
        mapping = u.mapping
        mapping[first] = moves[first][0][1].mapping[first]
        mapping[second] = moves[second][0][1].mapping[second]
        rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-pairwise-top10"))
    for beam in sorted({identity for identity in u.mapping.values() if identity is not None}):
        mapping = u.mapping
        changed = False
        for user in sorted(mapping):
            if mapping[user] == beam and moves.get(user):
                mapping[user] = moves[user][0][1].mapping[user]
                changed = True
        if changed:
            rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-beam-evacuation"))
    unique = {row.assignments: row for row in rows}
    ordered = tuple(sorted(unique.values(), key=lambda row: row.configuration_id))
    if len(ordered) > ENGINE.CATALOGUE_CAP:
        ordered = ordered[: ENGINE.CATALOGUE_CAP]
    return ordered, ranked, time.perf_counter() - started


def _exact_s0_boundary0(base, catalogue, evaluator, rows_by_user_action):
    """Primitive proposal ranking plus exact nominal bounded-set S0."""

    unilateral = [row for row in catalogue if row.changed_users == 1]
    top_ids = []
    for user in sorted(base.mapping):
        proposals = [
            row for row in unilateral
            if row.mapping[user] != base.mapping[user]
        ]
        ranked = sorted(
            proposals,
            key=lambda row: (
                -(
                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
                ),
                row.configuration_id,
            ),
        )[: ENGINE.TOP_PROPOSALS]
        top_ids.extend(row.configuration_id for row in ranked)
    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
    allowed.extend(
        row for row in catalogue
        if row.changed_users > 1
        and all(
            any(
                proposal.mapping[user] == identity
                for proposal in unilateral
                if proposal.configuration_id in top_ids
            )
            for user, identity in row.assignments
            if identity != base.mapping[user]
        )
    )
    evaluator.evaluate_many(tuple(allowed))
    allowed = [
        row for row in allowed if row.configuration_id not in evaluator._invalid
    ]
    return min(
        allowed,
        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
    )


def _select_for_anchor(
    anchor_name, anchor, catalogue, exact, models, rows_by_user_action,
    tape, step_index, exact_s0,
):
    selections = {}
    diagnostics = {}
    legal_catalogue = [row for row in catalogue if row.configuration_id in exact]
    contexts = {}
    for config in legal_catalogue:
        if len(exact[config.configuration_id]["changed"]) >= 2:
            contexts[config.configuration_id] = _coalition_context(
                tape=tape, step_index=step_index, anchor=anchor,
                selected=config, rows_by_user_action=rows_by_user_action,
            )
    for seed in LEARNER_SEEDS:
        exact_scores = []
        additive_scores = []
        learned_scores_by_arm = {arm: [] for arm in PILOT_ARMS}
        deltas_by_arm = {}
        c2_tie_pairs = 0
        c2_eligible_pairs = 0
        for arm in PILOT_ARMS:
            model = models[(seed, arm)]
            deltas = {}
            for (user, action), row in rows_by_user_action.items():
                reference = rows_by_user_action[(user, anchor.mapping[user])]
                q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
                deltas[(user, action)] = (
                    model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
                    + q2_delta
                )
                if arm == "FULL" and action != anchor.mapping[user]:
                    c2_eligible_pairs += 1
                    c2_tie_pairs += int(q2_delta == 0.0)
            deltas_by_arm[arm] = deltas
        c2_tie_fraction = (
            c2_tie_pairs / c2_eligible_pairs if c2_eligible_pairs else None
        )
        for config in legal_catalogue:
            context = contexts.get(config.configuration_id)
            full_additive = math.fsum(
                deltas_by_arm["FULL"][(user, config.mapping[user])]
                for user in anchor.mapping
            )
            exact_scores.append((full_additive + exact[config.configuration_id]["psi"], config.configuration_id, config))
            additive_scores.append((full_additive, config.configuration_id, config))
            for arm in PILOT_ARMS:
                model = models[(seed, arm)]
                score = math.fsum(
                    deltas_by_arm[arm][(user, config.mapping[user])]
                    for user in anchor.mapping
                )
                if context is not None:
                    score += model.interaction(context)
                learned_scores_by_arm[arm].append((score, config.configuration_id, config))
        exact_choice = min(exact_scores, key=lambda row: (-row[0], row[1]))[2]
        additive_choice = min(additive_scores, key=lambda row: (-row[0], row[1]))[2]
        selections[(seed, "S0")] = exact_s0
        for arm in PILOT_ARMS:
            selections[(seed, arm)] = min(
                learned_scores_by_arm[arm], key=lambda row: (-row[0], row[1])
            )[2]
        diagnostics[seed] = {
    for name in set(surrogate) - {"method"}:
        parse_float_hex(surrogate[name], field=f"surrogate.{name}")
    path = extension["evaluation_path"]
    expected_path = {
        "exact_candidate_current": "evaluate_many then cache access",
        "exact_default_current": "evaluate_many then cache access",
        "exact_candidate_forecasts": "evaluate_many",
        "exact_default_forecasts": "evaluate_many",
        "c1_target": "c1_difference_surplus",
        "c2_target": "c2_persistence_forecast",
        "surrogate": "provider-primitive-array-lookup",
        "boundary_indices": [0],
    }
    if path != expected_path:
        raise StageCContractError("exact source evaluation path drifted")


def _read_exact_source_view(path: Path) -> tuple[SourceShard, dict[str, object]]:
    file_digest = verify_sha256_sidecar(path)
    raw_lines = path.read_bytes().splitlines()
    try:
        values = [json.loads(line.decode("ascii")) for line in raw_lines]
    except (UnicodeError, json.JSONDecodeError) as error:
        raise StageCContractError(f"cannot parse exact source view {path}") from error
    if not values or any(not isinstance(value, Mapping) for value in values):
        raise StageCContractError("exact source view requires one header and object rows")
    if any(line != canonical_json_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise StageCContractError("exact source view is not canonical JSONL")
    header = values[0]
    if set(header) != SOURCE_HEADER_FIELDS or header["schema"] != SOURCE_VIEW_SCHEMA:
        raise StageCContractError("exact source view header schema drifted")
    if (
        header["existing_row_schema"] != "mcrl-v025-stagec-source-row-v1"
        or header["extension_schema"] != SOURCE_EXTENSION_SCHEMA
        or header["evaluation_path"] != {
            "boundaries": [0],
            "current_candidate_and_default": "evaluate_many",
            "forecast_candidate_and_default": "evaluate_many",
        }
    ):
        raise StageCContractError("exact source view authority drifted")
    expected_row_fields = set(values[1]) if len(values) > 1 else set()
    rows = []
    row_keys: set[str] = set()
    for payload in values[1:]:
        if set(payload) != expected_row_fields or "exact_source_view" not in payload:
            raise StageCContractError("exact source view row field inventory drifted")
        _validate_extension(payload["exact_source_view"])
        row_key = str(payload["exact_source_view"]["row_key"])
        if row_key in row_keys:
            raise StageCContractError("duplicate exact source row_key")
        row_keys.add(row_key)
        base = {key: value for key, value in payload.items() if key != "exact_source_view"}
        row = _row_from_payload(base)
        if (
            row.world_id != header["world_id"]
            or row.anchor_index != header["anchor_index_within_world"]
        ):
            raise StageCContractError("exact source row/header anchor disagreement")
        rows.append(row)
    if not rows or len(rows) != int(header["row_count"]):
        raise StageCContractError("exact source view row count drifted")
    variant = variant_for_digests(rows[0].q1_schema_sha256, rows[0].q2_schema_sha256)
    if (
        any((row.q1_schema_sha256, row.q2_schema_sha256) !=
            (variant.q1_schema_sha256, variant.q2_schema_sha256) for row in rows)
        or header["q1_slots"] != variant.q1_width
        or header["q2_slots"] != variant.q2_width
    ):
        raise StageCContractError("exact source feature schema drifted")
    shard = SourceShard(path, file_digest, canonical_sha256([row.payload() for row in rows]), tuple(rows))
    return shard, dict(header)


def _candidate_view_files(corpus: Path) -> list[Path]:
    promoted = corpus / "views"
    staging = corpus / ".staging-separated-v1"
    if promoted.is_dir():
        root = promoted
    elif staging.is_dir():
        root = staging
    else:
        raise StageCContractError("corpus has neither views/ nor .staging-separated-v1/*/views/")
    files = sorted(path for path in root.rglob("*.jsonl") if path.is_file() and "views" in path.parts)
    if not files:
        raise StageCContractError("view layer contains no JSONL shards")
    if any("physics" in path.parts for path in files):
        raise StageCContractError("physics path was admitted into view inventory")
    return files


def load_corpus(corpus: Path) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
    source_shards = []
    coalition_shards = []
    anchors = []
    inventory = []
    for path in _candidate_view_files(corpus):
        try:
            first = json.loads(path.read_bytes().splitlines()[0].decode("ascii"))
        except (OSError, IndexError, UnicodeError, json.JSONDecodeError) as error:
            raise StageCContractError(f"cannot identify view shard {path}") from error
        schema = first.get("schema") if isinstance(first, Mapping) else None
        if schema == SOURCE_VIEW_SCHEMA:
            shard, header = _read_exact_source_view(path)
            source_shards.append(shard)
            anchors.append({
                key: header[key] for key in (
                    "global_anchor_index", "world_id", "anchor_index_within_world",
                    "step_index", "carrier",
                )
            })
        elif schema == COALITION_SHARD_SCHEMA:
            coalition_shards.append(read_coalition_shard(path))
        else:
            raise StageCContractError(f"unsupported view schema {schema!r}: {path}")
        inventory.append({"path": path.relative_to(corpus).as_posix(), "sha256": _sha256(path)})
    if not source_shards:
        raise StageCContractError("corpus has no exact C1/C2 source view shards")
    if not coalition_shards:
        raise StageCContractError(
            "corpus has no authenticated mcrl-v025-stagec-c3-coalition-shard-v2 view; "
            "five-arm training is forbidden"
        )
    pairs = build_pairwise_batches(tuple(source_shards))
    c3 = CoalitionBatch.create(tuple(coalition_shards))
    if len({pairs["C1"].physics_digest, pairs["C2"].physics_digest, c3.physics_digest}) != 1:
        raise StageCContractError("C1/C2/C3 view physics digests disagree")
    first_row = source_shards[0].rows[0]
    variant = variant_for_digests(first_row.q1_schema_sha256, first_row.q2_schema_sha256)
    corpus_receipt = {
        "mode": "exact-view-corpus",
        "root": str(corpus.resolve()),
        "digest": canonical_sha256(inventory),
        "files": inventory,
        "anchor_list": sorted(anchors, key=lambda row: row["global_anchor_index"]),
        "source_rows": sum(len(shard.rows) for shard in source_shards),
        "coalition_rows": sum(len(shard.rows) for shard in coalition_shards),
    }
    feature = {
        "name": variant.name,
        "digest": canonical_sha256(variant.schema_manifest()),
        "q1_schema_sha256": variant.q1_schema_sha256,
        "q2_schema_sha256": variant.q2_schema_sha256,
        "q1_width": variant.q1_width,
        "q2_width": variant.q2_width,
        "view_schema": SOURCE_VIEW_SCHEMA,
        "view_extension_schema": SOURCE_EXTENSION_SCHEMA,
        "coalition_schema": COALITION_SHARD_SCHEMA,
    }
    return {"pairs": pairs, "c3": c3}, corpus_receipt, feature


def build_synthetic_corpus(
    output: Path, *, directory_name: str = "synthetic-input"
) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
    material = output / directory_name
@dataclass(frozen=True, slots=True)
class CoalitionRow:
    schema: str
    split: str
    world_id: str
    world_seed: int
    learner_seed: int | None
    anchor_id: str
    anchor_index: int
    decision_time_utc: str
    decision_time_ns: int
    setting_id: str
    context: CoalitionContext
    original_changed_user_count: int
    capped_decomposition: bool
    original_changed_users: tuple[int, ...]
    decomposition_id: str
    decomposition_weight_hex: str
    lambda_bits_per_j_hex: str
    eta_ref_bits_per_j_hex: str
    kappa_normalization_bits_hex: str
    c1_normalized_hex: str
    psi_normalized_hex: str
    objective_delta_normalized_hex: str
    physical_c1_normalized_hex: str
    physical_psi_normalized_hex: str
    physical_delta_normalized_hex: str
    code_digest: str
    physics_digest: str
    catalogue_digest: str
    setting_digest: str
    calibration_digest: str
    allocation_manifest_digest: str
    credit_split: str

    def __post_init__(self) -> None:
        if self.schema != COALITION_ROW_SCHEMA or self.split != "TRAIN":
            raise StageCContractError("C3 coalition rows are versioned TRAIN rows")
        size = len(self.context.members)
        if size < 2:
            raise StageCContractError("trainable C3 rows require coalition size >=2")
        if self.original_changed_user_count != size or self.capped_decomposition:
            raise StageCContractError("v1.2 selected-coalition interaction labels are uncapped")
        if self.original_changed_user_count != len(self.original_changed_users):
            raise StageCContractError("larger-set original user inventory is incomplete")
        if self.context.changed_users != self.original_changed_users:
            raise StageCContractError("uncapped row must carry the actual selected user set")
        weight = parse_float_hex(self.decomposition_weight_hex, field="decomposition_weight")
        if not self.decomposition_id or weight <= 0.0 or weight > 1.0:
            raise StageCContractError("capped decomposition identity/weight is invalid")
        expected = capped_coalition_decomposition(self.original_changed_users)
        expected_weights = {users: value for users, value in expected}
        if expected_weights.get(self.context.changed_users) != weight:
            raise StageCContractError("capped decomposition subset or row weight drifted")
        expected_id = canonical_sha256({
            "schema": "mcrl-v025-stagec-capped-coalition-decomposition-v1",
            "original_changed_users": list(self.original_changed_users),
            "subsets": [list(users) for users, _ in expected],
        })
        if self.decomposition_id != expected_id:
            raise StageCContractError("capped decomposition digest drifted")
        expected_credit = (
            "EXACT_SHAPLEY_SMALL_SET"
            if size <= MAX_LABEL_COALITION_SIZE
            else "NOT_COMPUTED_LARGE_SET"
        )
        if self.credit_split != expected_credit:
            raise StageCContractError("credit split disagrees with reporting-only Shapley cap")
        for field in (
            "code_digest",
            "physics_digest",
            "catalogue_digest",
            "setting_digest",
            "calibration_digest",
            "allocation_manifest_digest",
        ):
            digest = getattr(self, field)
            if len(digest) != 64 or any(character not in "0123456789abcdef" for character in digest):
                raise StageCContractError(f"C3 {field} must be a lowercase SHA-256")
        kappa = parse_float_hex(self.kappa_normalization_bits_hex, field="kappa")
        lambda_bits = parse_float_hex(self.lambda_bits_per_j_hex, field="lambda")
        eta_ref = parse_float_hex(self.eta_ref_bits_per_j_hex, field="eta_ref")
        if kappa <= 0.0 or lambda_bits <= 0.0 or lambda_bits != eta_ref:
            raise StageCContractError("C3 row prices must be positive and lambda=eta_ref")
        c1 = parse_float_hex(self.c1_normalized_hex, field="c1")
        psi = parse_float_hex(self.psi_normalized_hex, field="psi")
        delta = parse_float_hex(self.objective_delta_normalized_hex, field="objective_delta")
        pc1 = parse_float_hex(self.physical_c1_normalized_hex, field="physical_c1")
        ppsi = parse_float_hex(self.physical_psi_normalized_hex, field="physical_psi")
        pdelta = parse_float_hex(self.physical_delta_normalized_hex, field="physical_delta")
        if not math.isclose(c1 + psi, delta, rel_tol=0.0, abs_tol=1e-12) or not math.isclose(
            pc1 + ppsi, pdelta, rel_tol=0.0, abs_tol=1e-12
        ):
            raise StageCContractError("C3 row reconstruction identity drifted")

    def payload(self) -> dict[str, object]:
        value = asdict(self)
        value["context"] = self.context.payload()
        return value


def build_coalition_row(
    *,
    context: CoalitionContext,
    reference_outcome: NetworkOutcome,
    unilateral_outcomes: Mapping[int, NetworkOutcome],
    coalition_outcome: NetworkOutcome,
    original_changed_user_count: int | None = None,
    original_changed_users: Sequence[int] | None = None,
    world_id: str,
    world_seed: int,
    anchor_index: int,
    decision_time_utc: str,
    decision_time_ns: int,
    setting_id: str,
    lambda_bits_per_j: float,
    eta_ref_bits_per_j: float,
    kappa_normalization_bits: float,
    code_digest: str,
    physics_digest: str,
    catalogue_digest: str,
    setting_digest: str,
    calibration_digest: str,
    allocation_manifest_digest: str,
) -> CoalitionRow:
    """Production B4/B5 builder from nominal counterfactual outcomes."""

    identity = coalition_identity(
        coalition_users=context.changed_users,
        reference=reference_outcome,
        unilateral_by_user=unilateral_outcomes,
        coalition=coalition_outcome,
        lambda_bits_per_j=lambda_bits_per_j,
        eta_ref=eta_ref_bits_per_j,
        kappa_bits_per_user_s=kappa_normalization_bits,
    )
    kappa = Fraction(str(kappa_normalization_bits))
    original_users = (
        context.changed_users
        if original_changed_users is None
        else tuple(sorted(int(user) for user in original_changed_users))
    )
    original_count = len(original_users) if original_changed_user_count is None else original_changed_user_count
    if original_count != len(original_users):
        raise StageCContractError("original changed-user count requires the complete user inventory")
    decomposition = dict(capped_coalition_decomposition(original_users))
    if context.changed_users not in decomposition:
        raise StageCContractError("coalition context is absent from the sealed capped decomposition")
    return CoalitionRow(
        schema=COALITION_ROW_SCHEMA,
        split="TRAIN",
        world_id=world_id,
        world_seed=world_seed,
        learner_seed=None,
        anchor_id=context.anchor_id,
        anchor_index=anchor_index,
        decision_time_utc=decision_time_utc,
        decision_time_ns=decision_time_ns,
        setting_id=setting_id,
        context=context,
        original_changed_user_count=original_count,
        capped_decomposition=False,
        original_changed_users=original_users,
        decomposition_id=canonical_sha256({
            "schema": "mcrl-v025-stagec-capped-coalition-decomposition-v1",
            "original_changed_users": list(original_users),
            "subsets": [list(users) for users, _ in capped_coalition_decomposition(original_users)],
        }),
        decomposition_weight_hex=float_hex(decomposition[context.changed_users]),
        lambda_bits_per_j_hex=float_hex(lambda_bits_per_j),
        eta_ref_bits_per_j_hex=float_hex(eta_ref_bits_per_j),
        kappa_normalization_bits_hex=float_hex(kappa_normalization_bits),
        c1_normalized_hex=float_hex(float(identity.c1 / kappa)),
        psi_normalized_hex=float_hex(float(identity.c3 / kappa)),
        objective_delta_normalized_hex=float_hex(float(identity.objective_delta / kappa)),
        physical_c1_normalized_hex=float_hex(float(identity.physical_c1 / kappa)),
        physical_psi_normalized_hex=float_hex(float(identity.physical_c3 / kappa)),
        physical_delta_normalized_hex=float_hex(float(identity.physical_delta / kappa)),
        code_digest=code_digest,
        physics_digest=physics_digest,
        catalogue_digest=catalogue_digest,
        setting_digest=setting_digest,
        calibration_digest=calibration_digest,
        allocation_manifest_digest=allocation_manifest_digest,
        credit_split=(
            "EXACT_SHAPLEY_SMALL_SET"
            if len(context.members) <= MAX_LABEL_COALITION_SIZE
            else "NOT_COMPUTED_LARGE_SET"
        ),
    )


def capped_coalition_decomposition(
    changed_users: Sequence[int],
) -> tuple[tuple[tuple[int, ...], float], ...]:
    """v1.2 rule: one uncapped row for the actual selected coalition."""
def write_coalition_shard(path: str | Path, rows: Iterable[CoalitionRow]) -> CoalitionShard:
    material = tuple(rows)
    if not material:
        raise StageCContractError("cannot write an empty coalition shard")
    payloads = [row.payload() for row in material]
    rows_sha256 = canonical_sha256(payloads)
    header = {
        "schema": COALITION_SHARD_SCHEMA,
        "context_schema": COALITION_CONTEXT_SCHEMA,
        "context_payloads_sha256": canonical_sha256(
            [row.context.payload() for row in material]
        ),
        "split": "TRAIN",
        "row_count": len(material),
        "rows_sha256": rows_sha256,
        "interaction_label_coalition_size": "UNCAPPED",
        "max_reporting_shapley_coalition_size": MAX_LABEL_COALITION_SIZE,
        "row_schema": COALITION_ROW_SCHEMA,
        "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
    }
    encoded = b"\n".join(canonical_json_bytes(value) for value in (header, *payloads)) + b"\n"
    destination = Path(path)
    digest = write_once_with_sha256(destination, encoded)
    return CoalitionShard(destination, digest, rows_sha256, material)


def _action(payload: Mapping[str, object]) -> PhysicalAction:
    return PhysicalAction(
        None if payload["norad_id"] is None else int(payload["norad_id"]),
        None if payload["beam_chain_id"] is None else int(payload["beam_chain_id"]),
    )


def _context(payload: Mapping[str, object]) -> CoalitionContext:
    actual_schema = payload.get("context_schema", "<missing>")
    if actual_schema != COALITION_CONTEXT_SCHEMA:
        raise StageCContractError(
            "coalition context schema drifted: "
            f"expected {COALITION_CONTEXT_SCHEMA!r}, got {actual_schema!r}"
        )
    expected_fields = {
        "context_schema",
        "anchor_id",
        "reference_profile",
        "members",
        "affected_beams",
        "global_resource_features_hex",
        "pairwise_cross_gain_top_k",
        "pairwise_cross_gain_residual_sum_hex",
        "pairwise_cross_gain_terms",
    }
    if set(payload) != expected_fields:
        missing = sorted(expected_fields - set(payload))
        extra = sorted(set(payload) - expected_fields)
        raise StageCContractError(
            f"coalition context schema drifted for {COALITION_CONTEXT_SCHEMA}: "
            f"missing={missing}, extra={extra}"
        )
    actual_top_k = payload["pairwise_cross_gain_top_k"]
    if actual_top_k != PAIRWISE_CROSS_GAIN_TOP_K:
        raise StageCContractError(
            "coalition context pairwise truncation drifted: "
            f"expected top_k={PAIRWISE_CROSS_GAIN_TOP_K}, got {actual_top_k!r}"
        )
    for row in payload["reference_profile"]:
        if set(row) != {"user_id", "action"}:
            raise StageCContractError("coalition reference-profile schema drifted")
    for row in payload["members"]:
        if set(row) != {
            "user_id",
            "reference_action",
            "selected_action",
            "selected_q1_row_hex",
            "incumbent_q1_row_hex",
            "missing_incumbent",
        }:
            raise StageCContractError("coalition member schema drifted")
    for row in payload["affected_beams"]:
        if set(row) != {
            "beam_key",
            "occupancy_before",
            "occupancy_after",
            "active_before",
            "active_after",
            "shared_capacity_hex",
            "interference_summary_hex",
            "capacity_margin_hex",
        }:
            raise StageCContractError("affected-beam context schema drifted")
    for row in payload["pairwise_cross_gain_terms"]:
        if set(row) != {"source_beam_key", "target_beam_key", "gain_hex"}:
            raise StageCContractError("pairwise cross-gain context schema drifted")
    context = CoalitionContext(
        anchor_id=str(payload["anchor_id"]),
        reference_profile=tuple(
            (int(row["user_id"]), _action(row["action"])) for row in payload["reference_profile"]
        ),
        members=tuple(
            CoalitionMember(
                user_id=int(row["user_id"]),
                reference_action=_action(row["reference_action"]),
                selected_action=_action(row["selected_action"]),
                selected_q1_row=tuple(
                    parse_float_hex(value, field="selected_action_feature")
                    for value in row["selected_q1_row_hex"]
                ),
                incumbent_q1_row=tuple(
                    parse_float_hex(value, field="incumbent_action_feature")
                    for value in row["incumbent_q1_row_hex"]
                ),
                missing_incumbent=bool(row["missing_incumbent"]),
            )
            for row in payload["members"]
        ),
        affected_beams=tuple(
            AffectedBeamContext(
                beam_key=str(row["beam_key"]),
                occupancy_before=int(row["occupancy_before"]),
                occupancy_after=int(row["occupancy_after"]),
                active_before=bool(row["active_before"]),
                active_after=bool(row["active_after"]),
                shared_capacity=parse_float_hex(row["shared_capacity_hex"], field="shared_capacity"),
                interference_summary=parse_float_hex(row["interference_summary_hex"], field="interference"),
                capacity_margin=parse_float_hex(row["capacity_margin_hex"], field="capacity_margin"),
            )
            for row in payload["affected_beams"]
        ),
        global_resource_features=tuple(
            parse_float_hex(value, field="global_resource_feature")
            for value in payload["global_resource_features_hex"]
        ),
        pairwise_cross_gain_terms=tuple(
            (
                str(row["source_beam_key"]),
                str(row["target_beam_key"]),
                parse_float_hex(row["gain_hex"], field="pairwise_cross_gain"),
            )
            for row in payload["pairwise_cross_gain_terms"]
        ),
    )
    encoded_residual = parse_float_hex(
        payload["pairwise_cross_gain_residual_sum_hex"],
        field="pairwise_cross_gain_residual_sum",
    )
    _retained, expected_residual = context._bounded_pairwise_cross_gain_terms()
    if encoded_residual != expected_residual:
        raise StageCContractError(
            "coalition context pairwise residual drifted: "
            f"expected {float_hex(expected_residual)}, got {float_hex(encoded_residual)}"
        )
    return context


def read_coalition_shard(path: str | Path) -> CoalitionShard:
    source = Path(path)
    digest = verify_sha256_sidecar(source)
    try:
        raw_lines = source.read_bytes().splitlines()
        values = [json.loads(line.decode("ascii")) for line in raw_lines]
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise StageCContractError("cannot parse coalition shard") from error
    if not values or not isinstance(values[0], Mapping):
        raise StageCContractError("coalition shard header is missing")
    header = values[0]
    actual_versions = {
        "shard": header.get("schema", "<missing>"),
        "row": header.get("row_schema", "<missing>"),
        "context": header.get("context_schema", "<missing>"),
    }
    expected_versions = {
        "shard": COALITION_SHARD_SCHEMA,
        "row": COALITION_ROW_SCHEMA,
        "context": COALITION_CONTEXT_SCHEMA,
    }
    if actual_versions != expected_versions:
        raise StageCContractError(
            "coalition shard schema drifted: "
            f"expected {expected_versions}, got {actual_versions}"
        )
    expected_header = {
        "interaction_label_coalition_size": "UNCAPPED",
        "max_reporting_shapley_coalition_size": MAX_LABEL_COALITION_SIZE,
        "row_count": len(values) - 1,
        "row_schema": COALITION_ROW_SCHEMA,
        "rows_sha256": header.get("rows_sha256"),
        "schema": COALITION_SHARD_SCHEMA,
        "context_schema": COALITION_CONTEXT_SCHEMA,
        "context_payloads_sha256": header.get("context_payloads_sha256"),
        "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
        "split": "TRAIN",
    }
    if header != expected_header:
        raise StageCContractError(
            f"coalition shard header drifted for {COALITION_SHARD_SCHEMA}: "
            f"expected keys={sorted(expected_header)}, got keys={sorted(header)}"
        )
    if any(line != canonical_json_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise StageCContractError("coalition shard is not canonical JSONL")
    rows: list[CoalitionRow] = []
    for payload in values[1:]:
        if not isinstance(payload, Mapping) or set(payload) != set(CoalitionRow.__dataclass_fields__):
            raise StageCContractError("coalition row schema drifted")
        context = _context(payload["context"])
        scalar = {key: value for key, value in payload.items() if key != "context"}
        scalar["original_changed_users"] = tuple(
            int(user) for user in scalar["original_changed_users"]
        )
        rows.append(CoalitionRow(context=context, **scalar))
    material = tuple(rows)
    rows_sha256 = canonical_sha256([row.payload() for row in material])
    if rows_sha256 != header["rows_sha256"]:
        raise StageCContractError("coalition shard row digest drifted")
    contexts_sha256 = canonical_sha256([row.context.payload() for row in material])
    if contexts_sha256 != header["context_payloads_sha256"]:
        raise StageCContractError(
            "coalition shard context payload digest drifted: "
            f"expected {header['context_payloads_sha256']}, got {contexts_sha256}"
        )
    return CoalitionShard(source, digest, rows_sha256, material)


