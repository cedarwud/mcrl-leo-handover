    65	def _slot_grid(maximum_occupancy: int) -> tuple[np.ndarray, np.ndarray]:
    66	    boundaries = {0.0, 1.0}
    67	    for occupancy in range(1, maximum_occupancy + 1):
    68	        boundaries.update(index / occupancy for index in range(1, occupancy))
    69	    ordered = np.asarray(sorted(boundaries), dtype=np.float64)
    70	    return (ordered[1:] - ordered[:-1], (ordered[1:] + ordered[:-1]) / 2.0)
