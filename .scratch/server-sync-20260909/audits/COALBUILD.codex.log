   485	    """v1.2 rule: one uncapped row for the actual selected coalition."""
   556	def write_coalition_shard(path: str | Path, rows: Iterable[CoalitionRow]) -> CoalitionShard:
   557	    material = tuple(rows)
   558	    if not material:
   559	        raise StageCContractError("cannot write an empty coalition shard")
   560	    payloads = [row.payload() for row in material]
   561	    rows_sha256 = canonical_sha256(payloads)
   562	    header = {
   563	        "schema": COALITION_SHARD_SCHEMA,
   564	        "context_schema": COALITION_CONTEXT_SCHEMA,
   565	        "context_payloads_sha256": canonical_sha256(
   566	            [row.context.payload() for row in material]
   567	        ),
   568	        "split": "TRAIN",
   569	        "row_count": len(material),
   570	        "rows_sha256": rows_sha256,
   571	        "interaction_label_coalition_size": "UNCAPPED",
   572	        "max_reporting_shapley_coalition_size": MAX_LABEL_COALITION_SIZE,
   573	        "row_schema": COALITION_ROW_SCHEMA,
   574	        "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
   575	    }
   576	    encoded = b"\n".join(canonical_json_bytes(value) for value in (header, *payloads)) + b"\n"
   577	    destination = Path(path)
   578	    digest = write_once_with_sha256(destination, encoded)
   579	    return CoalitionShard(destination, digest, rows_sha256, material)
