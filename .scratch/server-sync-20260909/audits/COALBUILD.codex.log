   380	def _base_configuration(tape: ExogenousWorldTape, step_index: int, carrier: str) -> Configuration:
   381	    action = next(
   382	        row for row in tape.carriers if row.step_index == step_index and row.carrier == carrier
   383	    )
   384	    mapping = dict(action.assignments)
   385	    step = tape.steps[step_index]
   386	    if step.arrays is not None:
   387	        arrays = step.arrays
   388	        live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
   389	        users_with_legal = {
   390	            int(arrays.users[int(arrays.row_user_column[row])])
   391	            for row in np.flatnonzero(live).tolist()
   392	        }
   393	    else:
   394	        users_with_legal = {
   395	            row.user_id for row in step.boundaries[0].candidates if row.legal
   396	        }
   397	    # The opening reference is part of the selection contract: a user with
   398	    # no live legal action is NULL in BASE and in every derived catalogue row.
   399	    for user in mapping:
   400	        if user not in users_with_legal:
   401	            mapping[user] = None
   402	    return Configuration(
   403	        f"BASE:{carrier}", tuple(sorted(mapping.items())), 0, "reference"
   404	    )
