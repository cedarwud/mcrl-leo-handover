   589	def _context(payload: Mapping[str, object]) -> CoalitionContext:
   590	    actual_schema = payload.get("context_schema", "<missing>")
   591	    if actual_schema != COALITION_CONTEXT_SCHEMA:
   592	        raise StageCContractError(
   593	            "coalition context schema drifted: "
   594	            f"expected {COALITION_CONTEXT_SCHEMA!r}, got {actual_schema!r}"
   595	        )
   596	    expected_fields = {
   597	        "context_schema",
   598	        "anchor_id",
   599	        "reference_profile",
   600	        "members",
   601	        "affected_beams",
   602	        "global_resource_features_hex",
   603	        "pairwise_cross_gain_top_k",
   604	        "pairwise_cross_gain_residual_sum_hex",
   605	        "pairwise_cross_gain_terms",
   606	    }
   607	    if set(payload) != expected_fields:
   608	        missing = sorted(expected_fields - set(payload))
   609	        extra = sorted(set(payload) - expected_fields)
   610	        raise StageCContractError(
   611	            f"coalition context schema drifted for {COALITION_CONTEXT_SCHEMA}: "
   612	            f"missing={missing}, extra={extra}"
   613	        )
   614	    actual_top_k = payload["pairwise_cross_gain_top_k"]
   615	    if actual_top_k != PAIRWISE_CROSS_GAIN_TOP_K:
   616	        raise StageCContractError(
   617	            "coalition context pairwise truncation drifted: "
   618	            f"expected top_k={PAIRWISE_CROSS_GAIN_TOP_K}, got {actual_top_k!r}"
   619	        )
   620	    for row in payload["reference_profile"]:
   621	        if set(row) != {"user_id", "action"}:
   622	            raise StageCContractError("coalition reference-profile schema drifted")
   623	    for row in payload["members"]:
   624	        if set(row) != {
   625	            "user_id",
   626	            "reference_action",
   627	            "selected_action",
   628	            "selected_q1_row_hex",
   629	            "incumbent_q1_row_hex",
   630	            "missing_incumbent",
   631	        }:
   632	            raise StageCContractError("coalition member schema drifted")
   633	    for row in payload["affected_beams"]:
   634	        if set(row) != {
   635	            "beam_key",
   636	            "occupancy_before",
   637	            "occupancy_after",
   638	            "active_before",
   639	            "active_after",
   640	            "shared_capacity_hex",
   641	            "interference_summary_hex",
   642	            "capacity_margin_hex",
   643	        }:
   644	            raise StageCContractError("affected-beam context schema drifted")
   645	    for row in payload["pairwise_cross_gain_terms"]:
   646	        if set(row) != {"source_beam_key", "target_beam_key", "gain_hex"}:
   647	            raise StageCContractError("pairwise cross-gain context schema drifted")
   648	    context = CoalitionContext(
   649	        anchor_id=str(payload["anchor_id"]),
   650	        reference_profile=tuple(
   651	            (int(row["user_id"]), _action(row["action"])) for row in payload["reference_profile"]
   652	        ),
   653	        members=tuple(
   654	            CoalitionMember(
   655	                user_id=int(row["user_id"]),
   656	                reference_action=_action(row["reference_action"]),
   657	                selected_action=_action(row["selected_action"]),
   658	                selected_q1_row=tuple(
   659	                    parse_float_hex(value, field="selected_action_feature")
   660	                    for value in row["selected_q1_row_hex"]
   661	                ),
   662	                incumbent_q1_row=tuple(
   663	                    parse_float_hex(value, field="incumbent_action_feature")
   664	                    for value in row["incumbent_q1_row_hex"]
   665	                ),
   666	                missing_incumbent=bool(row["missing_incumbent"]),
   667	            )
   668	            for row in payload["members"]
   669	        ),
   670	        affected_beams=tuple(
   671	            AffectedBeamContext(
   672	                beam_key=str(row["beam_key"]),
   673	                occupancy_before=int(row["occupancy_before"]),
   674	                occupancy_after=int(row["occupancy_after"]),
   675	                active_before=bool(row["active_before"]),
   676	                active_after=bool(row["active_after"]),
   677	                shared_capacity=parse_float_hex(row["shared_capacity_hex"], field="shared_capacity"),
   678	                interference_summary=parse_float_hex(row["interference_summary_hex"], field="interference"),
   679	                capacity_margin=parse_float_hex(row["capacity_margin_hex"], field="capacity_margin"),
   680	            )
   681	            for row in payload["affected_beams"]
   682	        ),
   683	        global_resource_features=tuple(
   684	            parse_float_hex(value, field="global_resource_feature")
   685	            for value in payload["global_resource_features_hex"]
   686	        ),
   687	        pairwise_cross_gain_terms=tuple(
   688	            (
   689	                str(row["source_beam_key"]),
   690	                str(row["target_beam_key"]),
   691	                parse_float_hex(row["gain_hex"], field="pairwise_cross_gain"),
   692	            )
   693	            for row in payload["pairwise_cross_gain_terms"]
   694	        ),
   695	    )
   696	    encoded_residual = parse_float_hex(
   697	        payload["pairwise_cross_gain_residual_sum_hex"],
   698	        field="pairwise_cross_gain_residual_sum",
   699	    )
   700	    _retained, expected_residual = context._bounded_pairwise_cross_gain_terms()
   701	    if encoded_residual != expected_residual:
   702	        raise StageCContractError(
   703	            "coalition context pairwise residual drifted: "
   704	            f"expected {float_hex(expected_residual)}, got {float_hex(encoded_residual)}"
   705	        )
   706	    return context
