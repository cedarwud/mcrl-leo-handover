   455	            "original_changed_users": list(original_users),
   456	            "subsets": [list(users) for users, _ in capped_coalition_decomposition(original_users)],
   457	        }),
   458	        decomposition_weight_hex=float_hex(decomposition[context.changed_users]),
   459	        lambda_bits_per_j_hex=float_hex(lambda_bits_per_j),
   460	        eta_ref_bits_per_j_hex=float_hex(eta_ref_bits_per_j),
   461	        kappa_normalization_bits_hex=float_hex(kappa_normalization_bits),
   462	        c1_normalized_hex=float_hex(float(identity.c1 / kappa)),
   463	        psi_normalized_hex=float_hex(float(identity.c3 / kappa)),
   464	        objective_delta_normalized_hex=float_hex(float(identity.objective_delta / kappa)),
   465	        physical_c1_normalized_hex=float_hex(float(identity.physical_c1 / kappa)),
   466	        physical_psi_normalized_hex=float_hex(float(identity.physical_c3 / kappa)),
   467	        physical_delta_normalized_hex=float_hex(float(identity.physical_delta / kappa)),
   468	        code_digest=code_digest,
   469	        physics_digest=physics_digest,
   470	        catalogue_digest=catalogue_digest,
   471	        setting_digest=setting_digest,
   472	        calibration_digest=calibration_digest,
