   352	def build_synthetic_corpus(
   353	    output: Path, *, directory_name: str = "synthetic-input"
   354	) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
   355	    material = output / directory_name
   290	@dataclass(frozen=True, slots=True)
   291	class CoalitionRow:
   292	    schema: str
   293	    split: str
   294	    world_id: str
   295	    world_seed: int
   296	    learner_seed: int | None
   297	    anchor_id: str
   298	    anchor_index: int
   299	    decision_time_utc: str
   300	    decision_time_ns: int
   301	    setting_id: str
   302	    context: CoalitionContext
   303	    original_changed_user_count: int
   304	    capped_decomposition: bool
   305	    original_changed_users: tuple[int, ...]
   306	    decomposition_id: str
   307	    decomposition_weight_hex: str
   308	    lambda_bits_per_j_hex: str
   309	    eta_ref_bits_per_j_hex: str
   310	    kappa_normalization_bits_hex: str
   311	    c1_normalized_hex: str
   312	    psi_normalized_hex: str
   313	    objective_delta_normalized_hex: str
   314	    physical_c1_normalized_hex: str
   315	    physical_psi_normalized_hex: str
   316	    physical_delta_normalized_hex: str
   317	    code_digest: str
   318	    physics_digest: str
   319	    catalogue_digest: str
   320	    setting_digest: str
   321	    calibration_digest: str
   322	    allocation_manifest_digest: str
   323	    credit_split: str
   324	
   325	    def __post_init__(self) -> None:
   326	        if self.schema != COALITION_ROW_SCHEMA or self.split != "TRAIN":
   327	            raise StageCContractError("C3 coalition rows are versioned TRAIN rows")
   328	        size = len(self.context.members)
   329	        if size < 2:
   330	            raise StageCContractError("trainable C3 rows require coalition size >=2")
   331	        if self.original_changed_user_count != size or self.capped_decomposition:
   332	            raise StageCContractError("v1.2 selected-coalition interaction labels are uncapped")
   333	        if self.original_changed_user_count != len(self.original_changed_users):
   334	            raise StageCContractError("larger-set original user inventory is incomplete")
   335	        if self.context.changed_users != self.original_changed_users:
   336	            raise StageCContractError("uncapped row must carry the actual selected user set")
   337	        weight = parse_float_hex(self.decomposition_weight_hex, field="decomposition_weight")
   338	        if not self.decomposition_id or weight <= 0.0 or weight > 1.0:
   339	            raise StageCContractError("capped decomposition identity/weight is invalid")
   340	        expected = capped_coalition_decomposition(self.original_changed_users)
   341	        expected_weights = {users: value for users, value in expected}
   342	        if expected_weights.get(self.context.changed_users) != weight:
   343	            raise StageCContractError("capped decomposition subset or row weight drifted")
   344	        expected_id = canonical_sha256({
   345	            "schema": "mcrl-v025-stagec-capped-coalition-decomposition-v1",
   346	            "original_changed_users": list(self.original_changed_users),
   347	            "subsets": [list(users) for users, _ in expected],
   348	        })
   349	        if self.decomposition_id != expected_id:
   350	            raise StageCContractError("capped decomposition digest drifted")
   351	        expected_credit = (
   352	            "EXACT_SHAPLEY_SMALL_SET"
   353	            if size <= MAX_LABEL_COALITION_SIZE
   354	            else "NOT_COMPUTED_LARGE_SET"
   355	        )
   356	        if self.credit_split != expected_credit:
   357	            raise StageCContractError("credit split disagrees with reporting-only Shapley cap")
   358	        for field in (
   359	            "code_digest",
   360	            "physics_digest",
   361	            "catalogue_digest",
   362	            "setting_digest",
   363	            "calibration_digest",
   364	            "allocation_manifest_digest",
   365	        ):
   366	            digest = getattr(self, field)
   367	            if len(digest) != 64 or any(character not in "0123456789abcdef" for character in digest):
   368	                raise StageCContractError(f"C3 {field} must be a lowercase SHA-256")
   369	        kappa = parse_float_hex(self.kappa_normalization_bits_hex, field="kappa")
   370	        lambda_bits = parse_float_hex(self.lambda_bits_per_j_hex, field="lambda")
   371	        eta_ref = parse_float_hex(self.eta_ref_bits_per_j_hex, field="eta_ref")
   372	        if kappa <= 0.0 or lambda_bits <= 0.0 or lambda_bits != eta_ref:
   373	            raise StageCContractError("C3 row prices must be positive and lambda=eta_ref")
   374	        c1 = parse_float_hex(self.c1_normalized_hex, field="c1")
   375	        psi = parse_float_hex(self.psi_normalized_hex, field="psi")
   376	        delta = parse_float_hex(self.objective_delta_normalized_hex, field="objective_delta")
   377	        pc1 = parse_float_hex(self.physical_c1_normalized_hex, field="physical_c1")
   378	        ppsi = parse_float_hex(self.physical_psi_normalized_hex, field="physical_psi")
   379	        pdelta = parse_float_hex(self.physical_delta_normalized_hex, field="physical_delta")
   380	        if not math.isclose(c1 + psi, delta, rel_tol=0.0, abs_tol=1e-12) or not math.isclose(
   381	            pc1 + ppsi, pdelta, rel_tol=0.0, abs_tol=1e-12
   382	        ):
   383	            raise StageCContractError("C3 row reconstruction identity drifted")
   384	
   385	    def payload(self) -> dict[str, object]:
   386	        value = asdict(self)
   387	        value["context"] = self.context.payload()
   388	        return value
