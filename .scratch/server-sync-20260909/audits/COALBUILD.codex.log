   527	def _configuration(
   528	    base: Configuration,
   529	    mapping: Mapping[int, tuple[int, int] | None],
   530	    *,
   531	    kind: str,
   532	) -> Configuration:
   533	    assignments = tuple(sorted(mapping.items()))
   534	    base_map = base.mapping
   535	    changed = sum(base_map[user] != identity for user, identity in assignments)
   536	    encoded = ";".join(
   537	        f"{user}:NULL" if identity is None else f"{user}:{identity[0]}:{identity[1]}"
   538	        for user, identity in assignments
   539	    )
   540	    return Configuration(f"CFG:{encoded}", assignments, changed, kind)
