    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
)
for _thread_var in THREAD_VARS:
    os.environ[_thread_var] = "1"

import numpy as np  # noqa: E402

import q1_schema_v2 as q1v2  # noqa: E402


