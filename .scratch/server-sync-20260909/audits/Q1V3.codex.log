ANCHORS = 22
MAX_AS_BYTES = 4_900_000_000
GEOMETRY_SOURCE = (
    "stored mcrl-v025-exact-source-row-physics-v1 candidate geometry at "
    "offset 0: true_off_axis_angle_rad_hex and elevation_deg_hex"
)
SOURCE_VIEW_SCHEMA = "mcrl-v025-exact-source-view-shard-v1"
COALITION_SHARD_SCHEMA = "mcrl-v025-stagec-c3-coalition-shard-v2"


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode("ascii")


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def visible_python_processes() -> tuple[tuple[int, str], ...]:
    rows = []
    for child in Path("/proc").iterdir():
        if not child.name.isdigit():
            continue
        try:
            name = (child / "comm").read_text(encoding="ascii").strip()
        except (FileNotFoundError, PermissionError, ProcessLookupError, UnicodeError):
            continue
        if name.startswith("python"):
            rows.append((int(child.name), name))
    return tuple(sorted(rows))


def enforce_resources() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS threads are not pinned to one: {bad}")
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
    processes = visible_python_processes()
    if len(processes) > 3:
        raise RuntimeError(f"python-process cap exceeded: {processes}")
    if peak_rss_bytes() >= 5_000_000_000:
        raise MemoryError("initial peak RSS is already at or above 5 GB")


def verify_sidecar(path: Path) -> str:
    sidecar = path.with_suffix(path.suffix + ".sha256")
    fields = sidecar.read_text(encoding="ascii").strip().split()
    actual = file_sha256(path)
    if len(fields) != 2 or fields[0] != actual or fields[1] != path.name:
        raise RuntimeError(f"SHA-256 sidecar disagreement: {path}")
    return actual


def write_jsonl(path: Path, values: list[dict[str, object]]) -> str:
    if path.exists() or path.with_suffix(path.suffix + ".sha256").exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    digest = hashlib.sha256()
    with temporary.open("wb") as handle:
        for value in values:
            encoded = canonical_bytes(value) + b"\n"
            handle.write(encoded)
            digest.update(encoded)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    hexdigest = digest.hexdigest()
    sidecar = path.with_suffix(path.suffix + ".sha256")
    sidecar.write_text(f"{hexdigest}  {path.name}\n", encoding="ascii")
    if verify_sidecar(path) != hexdigest:
        raise AssertionError("new JSONL sidecar did not round trip")
    return hexdigest


def write_json(path: Path, value: object) -> None:
    if path.exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(json.dumps(value, indent=2, sort_keys=True, allow_nan=False).encode("ascii"))
        handle.write(b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def read_result(index: int) -> dict[str, object]:
    path = (
        EXACT_STAGING
        / f"global-{index:03d}"
        / f"BUILD_NOT_CLAIM-anchor-{index:03d}.result.json"
    )
    result = json.loads(path.read_text(encoding="ascii"))
    if int(result["global_anchor_index"]) != index:
        raise RuntimeError(f"source result index drifted at {index}")
    return result


def paths_for_anchor(index: int) -> tuple[dict[str, object], Path, Path, Path]:
    result = read_result(index)
    physics = EXACT_ROOT / str(result["physics_staging_path"])
    source = EXACT_ROOT / str(result["view_staging_path"])
    world_index = int(result["world_index"])
    coalition = (
        COALITION_STAGING
        / f"global-{index:03d}"
        / "views"
        / f"world-{world_index}"
        / f"COALITION_BUILD-c3-anchor-{index:03d}.jsonl"
    )
    return result, physics, source, coalition


def load_geometry(physics_path: Path, expected_count: int) -> dict[str, dict[str, object]]:
    geometry: dict[str, dict[str, object]] = {}
    with physics_path.open("r", encoding="ascii") as handle:
        header = json.loads(next(handle))
        if header.get("schema") != "mcrl-v025-exact-source-physics-shard-v1":
            raise RuntimeError("stored physics shard schema drifted")
        for line in handle:
            if '"schema":"mcrl-v025-exact-source-row-physics-v1"' not in line:
                continue
            row = json.loads(line)
            candidate = row["candidate_geometry_offsets_0_1_2_3"][0]
            if int(candidate["step_index"]) != int(header["step_index"]):
                raise RuntimeError("stored candidate geometry is not offset 0")
            if row["row_key"] in geometry:
                raise RuntimeError("duplicate physics row_key")
            geometry[str(row["row_key"])] = candidate
    if len(geometry) != expected_count:
        raise RuntimeError("physics/view row inventory differs")
    return geometry


def action_key(user_id: int, action: Mapping[str, object]) -> tuple[int, int | None, int | None]:
    return (
        int(user_id),
        None if action["norad_id"] is None else int(action["norad_id"]),
        None if action["beam_chain_id"] is None else int(action["beam_chain_id"]),
    )


def rebuild_source_view(
    source_path: Path,
    geometry: dict[str, dict[str, object]],
    destination: Path,
    census_rows: list[tuple[float, ...]],
) -> tuple[str, dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]], str]:
    verify_sidecar(source_path)
    raw_lines = source_path.read_bytes().splitlines()
    values = [json.loads(line.decode("ascii")) for line in raw_lines]
    if any(line != canonical_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise RuntimeError("parent source view is not canonical JSONL")
    header = values[0]
    if (
        header.get("schema") != SOURCE_VIEW_SCHEMA
        or header.get("q1_slots") != 16
        or header.get("q2_slots") != 22
    ):
        raise RuntimeError("parent exact-source header drifted")
    if len(values) - 1 != int(header["row_count"]):
        raise RuntimeError("parent exact-source row count drifted")

    upgraded_values: list[dict[str, object]] = [
        {**header, "q1_slots": len(q1v2.Q1_V2_FEATURES)}
    ]
    by_action: dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]] = {}
    lineage = hashlib.sha256()
    for payload in values[1:]:
        extension = payload.get("exact_source_view")
        if not isinstance(extension, Mapping):
            raise RuntimeError("exact-source extension is absent")
        row_key = str(extension["row_key"])
        candidate = geometry.get(row_key)
        if candidate is None:
            raise RuntimeError(f"stored physics has no geometry for {row_key}")
        parent = {key: value for key, value in payload.items() if key != "exact_source_view"}
        null_action = parent.get("null_action")
        if type(null_action) is not bool:
            raise RuntimeError("parent null_action drifted")
        if null_action:
            if candidate != {
                "identity": None,
                "present_in_tape": False,
                "step_index": int(header["step_index"]),
            }:
                raise RuntimeError("null row has unexpected stored geometry")
            angle = 0.0
            elevation = 0.0
        else:
            if candidate.get("present_in_tape") is not True:
                raise RuntimeError("non-null row lacks stored candidate geometry")
            angle = float.fromhex(str(candidate["true_off_axis_angle_rad_hex"]))
            elevation = float.fromhex(str(candidate["elevation_deg_hex"]))
            expected_identity = [parent["action"]["norad_id"], parent["action"]["beam_chain_id"]]
            if candidate.get("identity") != expected_identity:
                raise RuntimeError("stored geometry identity differs from source action")
        upgraded = q1v2.project_row_payload_v2(
            parent,
            off_axis_angle_rad=angle,
            focal_elevation_deg=elevation,
            geometry_source=GEOMETRY_SOURCE,
        )

        # The production exact-view reader owns a stable whole-row envelope.
        # Keep that envelope and replace only its versioned Q1 fields.  The
        # full v2 row lineage is bound into the build receipt below.
        compatible = dict(parent)
        compatible["q1_state"] = list(upgraded["q1_state"])
        compatible["q1_schema_sha256"] = str(upgraded["q1_schema_sha256"])
        compatible["visible_primitives_sha256"] = str(
            upgraded["q1_visible_primitives_sha256"]
        )
        output = {**compatible, "exact_source_view": dict(extension)}
        upgraded_values.append(output)
        old_state = list(parent["q1_state"])
        new_state = list(compatible["q1_state"])
        key = action_key(int(parent["user_id"]), parent["action"])
        if key in by_action:
            raise RuntimeError("duplicate user/action in source view")
        by_action[key] = (old_state, new_state)
        numeric = tuple(float.fromhex(str(value)) for value in new_state)
        census_rows.append(numeric)
        lineage.update(
            canonical_bytes(
                {
                    "row_key": row_key,
                    "q1_v1_parent_row_sha256": upgraded["q1_v1_parent_row_sha256"],
                    "q1_visible_primitives_sha256": upgraded[
                        "q1_visible_primitives_sha256"
                    ],
                }
            )
        )
    if len(by_action) != int(header["row_count"]):
        raise RuntimeError("upgraded source inventory drifted")
    digest = write_jsonl(destination, upgraded_values)
    return digest, by_action, lineage.hexdigest()


def rebuild_coalition_view(
    source_path: Path,
    destination: Path,
    by_action: dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]],
) -> tuple[str, int, int]:
    verify_sidecar(source_path)
    raw_lines = source_path.read_bytes().splitlines()
    values = [json.loads(line.decode("ascii")) for line in raw_lines]
    if any(line != canonical_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise RuntimeError("parent coalition shard is not canonical JSONL")
    header, rows = values[0], values[1:]
    if header.get("schema") != COALITION_SHARD_SCHEMA:
        raise RuntimeError("parent coalition schema drifted")
    if len(rows) != int(header["row_count"]):
        raise RuntimeError("parent coalition row count drifted")
    replacements = 0
    for row in rows:
        members = row["context"]["members"]
        for member in members:
            user_id = int(member["user_id"])
            selected = action_key(user_id, member["selected_action"])
            reference = action_key(user_id, member["reference_action"])
            try:
                old_selected, new_selected = by_action[selected]
                old_reference, new_reference = by_action[reference]
            except KeyError as error:
                raise RuntimeError("coalition member action absent from source view") from error
            if member["selected_q1_row_hex"] != old_selected:
        *,
        world_seed: int,
        step_index: int,
        start_time_s: float = 0.0,
    ) -> PrimitiveStepArrays:
        """Return one recomputable 48-boundary engine snapshot as arrays."""

        world = self._ensure(world_seed)
        self._indices(world, step_index, 0)
        if not math.isfinite(start_time_s):
            raise MCRLContractError("start_time_s must be finite")
        state = world.steps[step_index]
        users = np.arange(state.user_ecef_km.shape[0], dtype=np.int64)
        row_user, row_action, identities, row_slot = self._row_metadata(state)
        # Keep one genuine tracked-but-ineligible row per user.  The legacy
        # four-slot action table erases these identities; the primitive mask
        # seam must expose false D2/visibility values rather than make those
        # predicates vacuous.  The lowest-elevation tracked satellite is a
        # deterministic, non-action audit row (legacy_action_index == -1).
        begin = step_index * D2_SUBINTERVALS
        tracked_now = world.positions_ecef_km[:, begin, :]
        user_delta = tracked_now[None, :, :] - state.user_ecef_km[:, None, :]
        user_slant = np.linalg.norm(user_delta, axis=-1)
        user_up_all = state.user_ecef_km / np.linalg.norm(
            state.user_ecef_km, axis=1, keepdims=True
        )
        tracked_elevation = np.degrees(
            np.arcsin(
                np.clip(
                    np.einsum("usc,uc->us", user_delta, user_up_all) / user_slant,
                    -1.0,
                    1.0,
                )
            )
        )
        extra_satellite_column = np.argmin(tracked_elevation, axis=1)
        extra_norads = world.tracked_norads[extra_satellite_column].astype(np.int64)
        extra_cells = np.asarray(
            [
                next(int(cell) for cell in state.cell_ids[user].tolist() if int(cell) >= 0)
                for user in range(users.size)
            ],
            dtype=np.int64,
        )
        extra_identities = np.stack((extra_norads, extra_cells), axis=1)
        identities = np.concatenate((identities, extra_identities), axis=0)
        row_user = np.concatenate((row_user, users), axis=0)
        row_action = np.concatenate(
            (row_action, np.full(users.size, -1, dtype=np.int64)), axis=0
        )
        row_slot = np.concatenate(
            (row_slot, np.full(users.size, NUM_SATELLITE_SLOTS, dtype=np.int64)),
            axis=0,
        )
        row_cells = identities[:, 1]
        grid = world.grid
        colors = np.asarray(grid.colors[row_cells], dtype=np.int64)
        tracked_column = {
            int(norad): index
            for index, norad in enumerate(world.tracked_norads.tolist())
        }
        satellite_norads = np.asarray(
            sorted({int(value) for value in identities[:, 0]}), dtype=np.int64
        )
        satellite_column = {
            int(norad): index for index, norad in enumerate(satellite_norads.tolist())
        }
        tracked_rows = np.asarray(
            [tracked_column[int(norad)] for norad in satellite_norads], dtype=np.int64
        )
        positions = world.positions_ecef_km[tracked_rows, begin : begin + 48, :].transpose(1, 0, 2)
        row_satellite = np.asarray(
            [satellite_column[int(norad)] for norad in identities[:, 0]], dtype=np.int64
        )
        row_positions = positions[:, row_satellite, :]
        row_users = state.user_ecef_km[row_user]
        row_centres = grid.centers_ecef_km[row_cells]
        delta = row_positions - row_users[None, :, :]
        slants = np.linalg.norm(delta, axis=-1)
        up = row_users / np.linalg.norm(row_users, axis=1, keepdims=True)
        elevations = np.degrees(
            np.arcsin(
                np.clip(np.einsum("brc,rc->br", delta, up) / slants, -1.0, 1.0)
            )
        )
        direct_angles = angle_between_deg(
            row_positions,
            np.broadcast_to(row_centres, row_positions.shape),
            np.broadcast_to(row_users, row_positions.shape),
        )
        peak_receive = 10.0 ** (RX_GAIN_MAX_DBI / 10.0)
        direct_path = self._nominal_path_without_scintillation(
            slants, elevations, np.full_like(slants, peak_receive)
        )
        nominal = transmit_gain_linear(direct_angles) * direct_path

        fading = np.empty(
            (48, users.size, satellite_norads.size), dtype=np.float64
        )
        times = (
            float(start_time_s)
            + step_index * DECISION_INTERVAL_S
            + np.arange(48, dtype=np.float64) * D2_MEASUREMENT_STEP_S
        )
        for boundary in range(48):
            absolute_ns = int(round(float(times[boundary]) * 1.0e9))
            for user in range(users.size):
                user_position = state.user_ecef_km[user]
                for sat_column, norad in enumerate(satellite_norads.tolist()):
                    sat_position = positions[boundary, sat_column]
                    sat_delta = sat_position - user_position
                    sat_slant = float(np.linalg.norm(sat_delta))
                    sat_up = user_position / np.linalg.norm(user_position)
                    sat_elevation = math.degrees(
                        math.asin(float(np.clip(np.dot(sat_delta, sat_up) / sat_slant, -1.0, 1.0)))
                    )
                    fading[boundary, user, sat_column] = keyed_fading_gain(
                        world=int(world_seed),
                        user=user,
                        norad=int(norad),
                        absolute_time_ns=absolute_ns,
"""−228.60 dBW/K/Hz."""


def carrier_to_noise_db(
    *,
    eirp_dbw: float,
    free_space_loss_db: float,
    other_losses_db: float,
    g_over_t_db_per_k: float,
    bandwidth_hz: float,
) -> float:
    """``C/N = EIRP − FSL − L + G/T − k − 10log₁₀(B)``, all dB.

    The standard link equation, written out term by term so a delta ledger
    against a published budget (G-2) can be built from the same pieces.
    """
    if bandwidth_hz <= 0.0:
        raise ValueError("bandwidth must be positive")
    return (
        eirp_dbw
        - free_space_loss_db
        - other_losses_db
        + g_over_t_db_per_k
        - BOLTZMANN_DBW_PER_K_PER_HZ
        - 10.0 * math.log10(bandwidth_hz)
    )


def g_over_t_db_per_k(receive_gain_dbi: float) -> float:
    """Terminal figure of merit against this project's ``T_sys``."""
    return receive_gain_dbi - 10.0 * math.log10(SYSTEM_TEMPERATURE_K)


def eirp_dbw(transmit_power_w: float, transmit_gain_dbi: float) -> float:
    if transmit_power_w <= 0.0:
        raise MCRLContractError("EIRP is undefined for zero transmit power")
    return 10.0 * math.log10(transmit_power_w) + transmit_gain_dbi


def free_space_loss_db(slant_km: np.ndarray) -> np.ndarray:
    """Positive FSPL in dB — the reciprocal of :func:`free_space_path_gain`."""
    return -10.0 * np.log10(free_space_path_gain(slant_km))


def link_power_factor(
    slant_km: np.ndarray,
    elevation_deg: np.ndarray,
    receive_gain_linear: np.ndarray,
    *,
    fading_gain: np.ndarray | None = None,
    shadow_fading_db: np.ndarray | float = 0.0,
) -> np.ndarray:
    """Paper eq. (3.10a): ``H = 10^(−L/10) · G^R``, times Rician fading.

    ``H`` carries everything **except** the wanted-link transmit pattern:
    the four losses of (3.10b), the receive gain of (3.10c), and the
    small-scale fading (3.10) names.  ``G^T(θ)`` multiplies it separately so
    the angle enters exactly once and visibly.
    """
    loss_db = total_path_loss_db(
        slant_km, elevation_deg, shadow_fading_db=shadow_fading_db
    )
    receive = np.asarray(receive_gain_linear, dtype=np.float64)
    if np.any(receive < 0.0):
        raise MCRLContractError("receive gain must be non-negative")
    factor = 10.0 ** (-loss_db / 10.0) * receive
    if fading_gain is None:
        return factor
    fading = np.asarray(fading_gain, dtype=np.float64)
    if np.any(fading < 0.0):
        raise MCRLContractError("fading gain must be non-negative")
    return factor * fading


def sinr(
    wanted_w: np.ndarray, interference_w: np.ndarray, noise_w: float
) -> np.ndarray:
    """Paper eq. (3.13): ``γ = p·H·G^T / (I + σ²)``.

    The denominator must be strictly positive — the paper says so — and a
    zero there would be a missing noise term rather than a limit to take.
    """
    wanted = np.asarray(wanted_w, dtype=np.float64)
    interference = np.asarray(interference_w, dtype=np.float64)
    if np.any(wanted < 0.0) or np.any(interference < 0.0):
        raise MCRLContractError("powers must be non-negative")
    denominator = interference + noise_w
    if np.any(denominator <= 0.0):
        raise MCRLContractError(
            "eq. (3.13) requires I + sigma^2 > 0; a zero denominator means "
            "the noise term is missing, not that the SINR is infinite"

