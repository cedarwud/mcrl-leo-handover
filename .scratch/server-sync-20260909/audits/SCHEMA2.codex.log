    """Retained Ka-LOS zero-mean-dB shadow sigma table."""

    elevation = np.asarray(elevation_deg, dtype=np.float64)
    if not np.all(np.isfinite(elevation)) or np.any((elevation < -90.0) | (elevation > 90.0)):
