"""Independent corroboration: census the 16 Q1 slots over the ALREADY-SHIPPED
pilot source corpus (the rows a training run would actually consume), and
verify which row path produced them via the sealed forecast-method digest."""
from __future__ import annotations

import importlib.util, json, sys
from collections import Counter
from pathlib import Path
import numpy as np

WS = Path("/home/sat/mcrl-v025-coverage-ws")
SRC = WS / "src-copy"
OUT = WS / ".scratch" / "preflight-data"
ROWS = Path("/home/sat/mcrl-v025-pilot-ws/artifacts/"
            "v025-pilot-c3-20260909-PILOT_NOT_CLAIM/rows")

sys.path.insert(0, str(SRC / "src"))
from mcrl.stagec_v025.state import Q1_FEATURES
from mcrl.stagec_v025.canonical import canonical_sha256

spec = importlib.util.spec_from_file_location(
    "pilot_c3", SRC / "scripts" / "run_v025_pilot_c3.py")
MOD = importlib.util.module_from_spec(spec); sys.modules["pilot_c3"] = MOD
spec.loader.exec_module(MOD)

FALLBACK_FORECAST_DIGEST = canonical_sha256(
    {"method": "provider-primitive-boundary-0", "offsets": [1, 2, 3]})
NORMAL_FORECAST_DIGEST = canonical_sha256(
    {"engine": MOD.ENGINE.SCHEMA, "offsets": [1, 2, 3],
     "boundaries": list(MOD.ENGINE.SELECTION_BOUNDARY_INDICES)})

NAMES = [f.name for f in Q1_FEATURES]
SCALES = np.asarray([f.scale for f in Q1_FEATURES])

rows_q1, meta, labels = [], [], []
digest_counts = Counter()
anchors = set()
for path in sorted(ROWS.glob("world-*/*source-anchor-*.jsonl")):
    with path.open() as handle:
        handle.readline()  # shard header
        for line in handle:
            row = json.loads(line)
            rows_q1.append([float.fromhex(v) for v in row["q1_state"]])
            digest_counts[row["forecast_method_sha256"]] += 1
            anchors.add((row["world_id"], row["anchor_id"]))
            occ = float.fromhex(row["q1_state"][3]) * 10.0
            meta.append([occ, float(row["outage"]), float(row["null_action"]),
                         float(row["terminal"]), float(row["reference_action"])])
            labels.append([float.fromhex(row["c1_label_bits_hex"]),
                           float.fromhex(row["c1_phi_difference_hex"]),
                           float.fromhex(row["c2_label_bits_hex"]),
                           float.fromhex(row["c1_label_normalized_hex"]),
                           float.fromhex(row["c2_label_normalized_hex"]),
                           float.fromhex(row["kappa_normalization_bits_hex"])])

Xn = np.asarray(rows_q1, dtype=float)          # learner-facing normalized
X = Xn * SCALES                                 # physical raw
M = np.asarray(meta, dtype=float)
L = np.asarray(labels, dtype=float)
N = X.shape[0]
print(f"shipped rows={N} anchors={len(anchors)}", flush=True)
print("forecast_method digests:", flush=True)
for d, c in digest_counts.most_common():
    tag = ("FALLBACK-PATH" if d == FALLBACK_FORECAST_DIGEST
           else "NORMAL-ENGINE-PATH" if d == NORMAL_FORECAST_DIGEST else "UNRECOGNISED")
    print(f"  {d} {c} {tag}", flush=True)

slots = []
for i, name in enumerate(NAMES):
    col = X[:, i]
    vals = Counter(col.tolist())
    modal_value, modal_count = max(vals.items(), key=lambda kv: kv[1])
    slots.append({"index": i, "name": name, "unit": Q1_FEATURES[i].unit,
                  "frozen_scale": float(SCALES[i]),
                  "min": float(col.min()), "max": float(col.max()),
                  "mean": float(col.mean()), "sd_population": float(col.std(ddof=0)),
                  "distinct_values": len(vals), "modal_value": float(modal_value),
                  "modal_fraction": modal_count / N, "CONSTANT": len(vals) == 1})

sd = X.std(axis=0, ddof=0)
nz = np.flatnonzero(sd > 0.0)
R = np.full((16, 16), np.nan)
R[np.ix_(nz, nz)] = np.corrcoef(X[:, nz], rowvar=False)
high = [{"slot_a": NAMES[a], "slot_b": NAMES[b], "r": float(R[a, b])}
        for a in range(16) for b in range(a + 1, 16)
        if np.isfinite(R[a, b]) and abs(R[a, b]) >= 0.98]

r2 = {}
for i in range(16):
    y = X[:, i]
    ss_tot = float(((y - y.mean()) ** 2).sum())
    others = [j for j in range(16) if j != i]
    A = np.column_stack([X[:, others], np.ones(N)])
    coef, *_ = np.linalg.lstsq(A, y, rcond=None)
    ss_res = float(((y - A @ coef) ** 2).sum())
    r2[NAMES[i]] = {"r2": None if ss_tot == 0.0 else 1.0 - ss_res / ss_tot,
                    "zero_total_variance": ss_tot == 0.0,
                    "residual_rms": float(np.sqrt(ss_res / N))}

def rank_cond(mat):
    sv = np.linalg.svd(mat, compute_uv=False)
    return int(np.linalg.matrix_rank(mat)), (float(sv[0] / sv[-1]) if sv[-1] > 0 else None), \
        [float(v) for v in sv]

rank, cond, sv = rank_cond(X)
rank_n, cond_n, sv_n = rank_cond(Xn)
rank_c, cond_c, sv_c = rank_cond(X - X.mean(axis=0))

occ = M[:, 0].round().astype(int)
kappa = float(np.median(L[:, 5]))
c1_over_kappa = L[:, 0] / L[:, 5]
c2_over_kappa = L[:, 2] / L[:, 5]

payload = {
    "diagnostic": "DIAGNOSTIC_NOT_CLAIM",
    "basis": "shipped v025 pilot source corpus (production rows)",
    "rows_total": N, "anchors_total": len(anchors),
    "forecast_method_digest_counts": dict(digest_counts),
    "fallback_forecast_method_sha256": FALLBACK_FORECAST_DIGEST,
    "normal_forecast_method_sha256": NORMAL_FORECAST_DIGEST,
    "slots": slots,
    "correlation_matrix": [[None if not np.isfinite(v) else float(v) for v in r] for r in R],
    "correlation_pairs_abs_ge_0.98": high,
    "r2_on_all_other_slots": r2,
    "matrix_rank_raw_16col": rank, "condition_number_raw": cond,
    "singular_values_raw": sv,
    "matrix_rank_learner_normalized": rank_n,
    "condition_number_learner_normalized": cond_n,
    "matrix_rank_mean_centered": rank_c, "condition_number_mean_centered": cond_c,
    "background_occupancy_histogram": {str(k): int(v) for k, v in sorted(Counter(occ.tolist()).items())},
    "outage_rows": int(M[:, 1].sum()), "null_action_rows": int(M[:, 2].sum()),
    "reference_action_rows": int(M[:, 4].sum()),
    "label_probe": {
        "kappa_bits_per_user_step_median": kappa,
        "c1_over_kappa_min": float(c1_over_kappa.min()),
        "c1_over_kappa_max": float(c1_over_kappa.max()),
        "c1_over_kappa_abs_le_1_fraction": float((np.abs(c1_over_kappa) <= 1.0 + 1e-12).mean()),
        "c1_over_kappa_saturated_ge_0.99_fraction": float((np.abs(c1_over_kappa) >= 0.99).mean()),
        "c1_over_kappa_eq_minus1_fraction": float((np.abs(c1_over_kappa + 1.0) < 1e-12).mean()),
        "c2_over_kappa_min": float(c2_over_kappa.min()),
        "c2_over_kappa_max": float(c2_over_kappa.max()),
        "c2_over_kappa_le_minus3_plus_eps_fraction": float((c2_over_kappa <= -3.0 + 1e-9).mean()),
        "phi_difference_distinct_count": int(len(set(L[:, 1].tolist()))),
        "phi_difference_distinct_sorted": sorted({float(v) for v in L[:, 1].tolist()})[:25],
        "c1_normalized_min": float(L[:, 3].min()), "c1_normalized_max": float(L[:, 3].max()),
        "c2_normalized_min": float(L[:, 4].min()), "c2_normalized_max": float(L[:, 4].max()),
    },
}
(OUT / "shipped-census.json").write_text(json.dumps(payload, indent=1), encoding="utf-8")
print("WROTE shipped-census.json", flush=True)
for s in slots:
    print(f"{s['index']:2d} {s['name']:<42s} min={s['min']:+.6g} max={s['max']:+.6g} "
          f"mean={s['mean']:+.6g} sd={s['sd_population']:.6g} nd={s['distinct_values']} "
          f"modal={s['modal_fraction']:.4f} {'CONSTANT' if s['CONSTANT'] else ''}", flush=True)
print("rank_raw", rank, "cond_raw", cond)
print("rank_norm", rank_n, "cond_norm", cond_n)
print("rank_centered", rank_c, "cond_centered", cond_c)
print("high_pairs", json.dumps(high, indent=1))
print("r2", json.dumps(r2, indent=1))
print("labels", json.dumps(payload["label_probe"], indent=1))
print("occ", json.dumps(payload["background_occupancy_histogram"]))
