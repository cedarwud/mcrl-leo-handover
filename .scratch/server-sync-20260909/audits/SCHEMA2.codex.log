+
+_audit_busy = False
+_before: dict[str, str] = {}
+
+
+def _inside(path: Path, root: Path) -> bool:
+    try:
+        path.relative_to(root)
+        return True
+    except ValueError:
+        return False
+
+
+def _digest_file(path: Path) -> str:
+    global _audit_busy
+    previous = _audit_busy
+    _audit_busy = True
+    try:
+        digest = sha256()
+        with path.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+        return digest.hexdigest()
+    finally:
+        _audit_busy = previous
+
+
+def _sealed_open_audit(event: str, arguments: tuple[object, ...]) -> None:
+    """Hash each sealed file immediately before first Python-level open."""
+
+    if event != "open" or _audit_busy or not arguments:
+        return
+    raw_path = arguments[0]
+    if not isinstance(raw_path, (str, bytes, os.PathLike)):
+        return
+    try:
+        path = Path(raw_path).resolve()
+    except (OSError, TypeError, ValueError):
+        return
+    if not any(_inside(path, root) for root in SEALED_ROOTS):
+        return
+    mode = arguments[1] if len(arguments) > 1 else None
+    flags = arguments[2] if len(arguments) > 2 else 0
+    write_mode = isinstance(mode, str) and any(character in mode for character in "wax+")
+    write_flags = (
+        isinstance(flags, int)
+        and bool(
+            flags
+            & (
+                os.O_WRONLY
+                | os.O_RDWR
+                | os.O_CREAT
+                | os.O_TRUNC
+                | os.O_APPEND
+            )
+        )
+    )
+    if write_mode or write_flags:
+        raise RuntimeError(f"blocked write attempt to sealed path: {path}")
+    key = str(path)
+    if key not in _before and path.is_file():
+        _before[key] = _digest_file(path)
+
+
+sys.addaudithook(_sealed_open_audit)
+sys.path.insert(0, str(WORKSPACE))
+sys.path.insert(0, str(SOURCE_WORKSPACE / "src"))
