+# Q1 schema v2 completion criterion
+
+- Outcome: a versioned Q1 successor repairs decision-time off-axis, adds
+  decision-time focal-link elevation, retains `missing_incumbent` with an
+  explicit structural-constancy note for this corpus, and drops the two exact
+  indicator duplicates.
+- Mutation boundary: this design workspace only; the c1c2 workspace, pilot
+  corpus, and handover interpreter/venv are read-only inputs.
+- Proof: the v2 projection regression test passes; all 176,223 sealed v1 rows
+  remain readable; a full old/new census reports slot summaries, correlations,
+  per-slot R2, rank, condition number, effective dimension, elevation/time
+  correlation, and identical before/after digests for every sealed file opened.
+- Stop: write `.scratch/schema-v2/census.json` and
+  `Q1-SCHEMA-V2-2026-09-10.md`; run no learner and make no EE or learnability
+  claim.
+
diff --git a/.scratch/schema-v2/test_schema_v2.py b/.scratch/schema-v2/test_schema_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..c5d6e88f0fe88fefb806ff199295a6c904d4ae37
--- /dev/null
+++ b/.scratch/schema-v2/test_schema_v2.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import math
+import sys
+from pathlib import Path
+import unittest
+
+
+WORKSPACE = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(WORKSPACE))
+
+import q1_schema_v2 as schema_v2
+
+
+class Q1SchemaV2ProjectionTest(unittest.TestCase):
+    def test_repairs_geometry_and_drops_exact_indicators(self) -> None:
+        old_normalized = tuple(float(index) for index in range(16))
+        result = schema_v2.upgrade_q1_state_v2(
+            old_normalized,
+            off_axis_angle_rad=0.25,
+            focal_elevation_deg=45.0,
+            null_action=False,
+        )
+
+        self.assertEqual(len(result), 15)
+        self.assertEqual(result[0:4], old_normalized[0:4])
+        self.assertEqual(result[4], old_normalized[5])
+        self.assertEqual(result[5], 0.25)
+        self.assertEqual(result[6], 0.5)
+        self.assertEqual(result[7:12], old_normalized[7:12])
+        self.assertEqual(result[12:15], old_normalized[13:16])
+        self.assertNotIn("beam_active_before_focal", schema_v2.Q1_V2_FEATURE_NAMES)
+        self.assertNotIn("previous_beam_active_for_action", schema_v2.Q1_V2_FEATURE_NAMES)
+
+    def test_null_action_has_explicit_absent_link_encoding(self) -> None:
+        old_normalized = (0.0,) * 16
+        result = schema_v2.upgrade_q1_state_v2(
+            old_normalized,
+            off_axis_angle_rad=0.0,
+            focal_elevation_deg=0.0,
+            null_action=True,
+        )
+        self.assertTrue(all(math.isfinite(value) for value in result))
+        self.assertEqual(result[5:7], (0.0, 0.0))
+
+    def test_non_null_geometry_must_be_physical(self) -> None:
+        with self.assertRaises(schema_v2.Q1SchemaV2Error):
+            schema_v2.upgrade_q1_state_v2(
+                (0.0,) * 16,
+                off_axis_angle_rad=-0.01,
+                focal_elevation_deg=45.0,
+                null_action=False,
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
