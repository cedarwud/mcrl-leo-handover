@@ -0,0 +1,466 @@
+"""Full old/new Q1 census with read-only sealed-file digest auditing."""
+
+from __future__ import annotations
+
+from collections import Counter
+import gc
+from hashlib import sha256
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+from typing import Any
+
+
+WORKSPACE = Path(__file__).resolve().parents[2]
+SOURCE_WORKSPACE = Path("/home/sat/mcrl-v025-c1c2-ws")
+INTERPRETER_ROOT = Path("/home/sat/mcrl-leo-handover")
+TLE_ROOT = Path("/home/sat/demo/tle_data")
+SEALED_ROOTS = tuple(path.resolve() for path in (SOURCE_WORKSPACE, INTERPRETER_ROOT, TLE_ROOT))
+CORPUS = (
+    SOURCE_WORKSPACE
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/rows"
+)
+OUTPUT = WORKSPACE / ".scratch/schema-v2/census.json"
+EXPECTED_ROWS = 176_223
+WORLDS = ("V025_PROBE/world/1", "V025_PROBE/world/2")
+WORLD_DIRECTORIES = ("world-1", "world-2")
+
+
+_audit_busy = False
+_before: dict[str, str] = {}
+
+
+def _inside(path: Path, root: Path) -> bool:
+    try:
+        path.relative_to(root)
+        return True
+    except ValueError:
+        return False
+
+
+def _digest_file(path: Path) -> str:
+    global _audit_busy
+    previous = _audit_busy
+    _audit_busy = True
+    try:
+        digest = sha256()
+        with path.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+        return digest.hexdigest()
+    finally:
+        _audit_busy = previous
+
+
+def _sealed_open_audit(event: str, arguments: tuple[object, ...]) -> None:
+    """Hash each sealed file immediately before first Python-level open."""
+
+    if event != "open" or _audit_busy or not arguments:
+        return
+    raw_path = arguments[0]
+    if not isinstance(raw_path, (str, bytes, os.PathLike)):
+        return
+    try:
+        path = Path(raw_path).resolve()
+    except (OSError, TypeError, ValueError):
+        return
+    if not any(_inside(path, root) for root in SEALED_ROOTS):
+        return
+    mode = arguments[1] if len(arguments) > 1 else None
+    flags = arguments[2] if len(arguments) > 2 else 0
+    write_mode = isinstance(mode, str) and any(character in mode for character in "wax+")
+    write_flags = (
+        isinstance(flags, int)
+        and bool(
+            flags
+            & (
+                os.O_WRONLY
+                | os.O_RDWR
+                | os.O_CREAT
+                | os.O_TRUNC
+                | os.O_APPEND
+            )
+        )
+    )
+    if write_mode or write_flags:
+        raise RuntimeError(f"blocked write attempt to sealed path: {path}")
+    key = str(path)
+    if key not in _before and path.is_file():
+        _before[key] = _digest_file(path)
+
+
+sys.addaudithook(_sealed_open_audit)
+sys.path.insert(0, str(WORKSPACE))
+sys.path.insert(0, str(SOURCE_WORKSPACE / "src"))
+
+import numpy as np
+
+import q1_schema_v2 as v2
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.tapes import build_world_tape
+from mcrl.stagec_v025.shards import read_source_shard
+from mcrl.stagec_v025.state import Q1_FEATURES, Q1_SCHEMA_SHA256
+
+
+if Q1_SCHEMA_SHA256 != v2.Q1_V1_SCHEMA_SHA256:
+    raise RuntimeError("successor parent digest does not match the readable sealed schema")
+
+
+OLD_SCALES = np.asarray([feature.scale for feature in Q1_FEATURES], dtype=np.float64)
+NEW_SCALES = np.asarray([feature.scale for feature in v2.Q1_V2_FEATURES], dtype=np.float64)
+X_OLD = np.empty((EXPECTED_ROWS, len(Q1_FEATURES)), dtype=np.float64)
+X_NEW = np.empty((EXPECTED_ROWS, len(v2.Q1_V2_FEATURES)), dtype=np.float64)
+
+
+def _safe_number(value: float) -> float | None:
+    return float(value) if math.isfinite(float(value)) else None
+
+
+def _matrix_summary(matrix: np.ndarray) -> dict[str, object]:
+    singular = np.linalg.svd(matrix, compute_uv=False)
+    rank = int(np.linalg.matrix_rank(matrix))
+    condition = math.inf if singular[-1] == 0.0 else float(singular[0] / singular[-1])
+    return {
+        "rank": rank,
+        "columns": int(matrix.shape[1]),
+        "condition_number": _safe_number(condition),
+        "condition_number_class": "infinite" if not math.isfinite(condition) else "finite",
+        "singular_values": [float(value) for value in singular],
+    }
+
+
+def _analyse_matrix(
+    matrix: np.ndarray,
+    features: tuple[object, ...],
+    *,
+    structurally_constant: set[str],
+) -> dict[str, object]:
+    rows, columns = matrix.shape
+    names = [feature.name for feature in features]
+    slots = []
+    for index, feature in enumerate(features):
+        column = matrix[:, index]
+        unique, counts = np.unique(column, return_counts=True)
+        modal_index = int(np.argmax(counts))
+        slots.append(
+            {
+                "index": index,
+                "name": feature.name,
+                "unit": feature.unit,
+                "scale": float(feature.scale),
+                "min": float(column.min()),
+                "max": float(column.max()),
+                "mean": float(column.mean()),
+                "sd_population": float(column.std(ddof=0)),
+                "distinct_values": int(unique.size),
+                "modal_value": float(unique[modal_index]),
+                "modal_fraction": float(counts[modal_index] / rows),
+                "exactly_constant": bool(unique.size == 1),
+                "documented_structurally_constant": feature.name in structurally_constant,
+            }
+        )
+
+    standard_deviation = matrix.std(axis=0, ddof=0)
+    live = np.flatnonzero(standard_deviation > 0.0)
+    correlation = np.full((columns, columns), np.nan, dtype=np.float64)
+    correlation[np.ix_(live, live)] = np.corrcoef(matrix[:, live], rowvar=False)
+
+    r2 = []
+    for index, name in enumerate(names):
+        target = matrix[:, index]
+        total = float(np.square(target - target.mean()).sum())
+        if total == 0.0:
+            r2.append(
+                {
+                    "index": index,
+                    "name": name,
+                    "r2": None,
+                    "zero_total_variance": True,
+                    "residual_rms": 0.0,
+                }
+            )
+            continue
+        others = [other for other in range(columns) if other != index]
+        design = np.column_stack((matrix[:, others], np.ones(rows, dtype=np.float64)))
+        coefficient, *_ = np.linalg.lstsq(design, target, rcond=None)
+        residual = target - design @ coefficient
+        residual_sum = float(np.square(residual).sum())
+        r2.append(
+            {
+                "index": index,
+                "name": name,
+                "r2": float(1.0 - residual_sum / total),
+                "zero_total_variance": False,
+                "residual_rms": float(math.sqrt(residual_sum / rows)),
+            }
+        )
+
+    raw_summary = _matrix_summary(matrix)
+    centred_summary = _matrix_summary(matrix - matrix.mean(axis=0))
+    live_matrix = matrix[:, live]
+    live_summary = _matrix_summary(live_matrix)
+    return {
+        "rows": rows,
+        "nominal_columns": columns,
+        "slots": slots,
+        "correlation_feature_order": names,
+        "correlation_matrix": [
+            [None if not math.isfinite(float(value)) else float(value) for value in row]
+            for row in correlation
+        ],
+        "r2_on_all_other_slots_with_intercept": r2,
+        "raw_design_matrix": raw_summary,
+        "mean_centered_design_matrix": centred_summary,
+        "after_dropping_exactly_constant_columns": live_summary,
+    }
+
+
+row_cursor = 0
+anchors: set[tuple[str, str]] = set()
+null_rows = 0
+nonnull_geometry_rows = 0
+missing_rows = 0
+incumbent_mapping_slots = 0
+incumbent_mapping_missing = 0
+maximum_elevation_crosscheck_error_deg = 0.0
+sample_payload: dict[str, object] | None = None
+
+for world, world_directory in zip(WORLDS, WORLD_DIRECTORIES, strict=True):
+    provider = LegacyWorldProvider(role="pilot-source")
+    tape = build_world_tape(
+        domain=world,
+        provider=provider,
+        steps=33,
+        start_time_s=0.0,
+    )
+    carrier_maps = {
+        (entry.carrier, entry.step_index): dict(entry.assignments)
+        for entry in tape.carriers
+    }
+    for step_index in range(30):
+        for carrier in ("nearest-eligible", "stay-if-possible", "random-masked"):
+            incumbent = carrier_maps[(carrier, max(0, step_index - 1))]
+            incumbent_mapping_slots += len(incumbent)
+            incumbent_mapping_missing += sum(value is None for value in incumbent.values())
+
+    current_step: int | None = None
+    resolver: v2.DecisionGeometryResolverV2 | None = None
+    shard_paths = sorted((CORPUS / world_directory).glob("*source-anchor-*.jsonl"))
+    if len(shard_paths) != 90:
+        raise RuntimeError(f"expected 90 source shards for {world}, got {len(shard_paths)}")
+    for shard_path in shard_paths:
+        shard = read_source_shard(shard_path)
+        shard_steps = {int(row.anchor_id.split("|")[1]) for row in shard.rows}
+        if len(shard_steps) != 1:
+            raise RuntimeError("source shard spans multiple steps")
+        step_index = next(iter(shard_steps))
+        if step_index != current_step:
+            resolver = v2.DecisionGeometryResolverV2(tape, provider, step_index)
+            current_step = step_index
+            maximum_elevation_crosscheck_error_deg = max(
+                maximum_elevation_crosscheck_error_deg,
+                resolver.maximum_elevation_crosscheck_error_deg,
+            )
+        assert resolver is not None
+        for row in shard.rows:
+            if row_cursor >= EXPECTED_ROWS:
+                raise RuntimeError("source corpus exceeds declared row count")
+            old_normalized = np.asarray(row.q1_state, dtype=np.float64)
+            X_OLD[row_cursor] = old_normalized * OLD_SCALES
+            angle_rad, elevation_deg = resolver(row)
+            new_normalized = v2.upgrade_q1_state_v2(
+                old_normalized,
+                off_axis_angle_rad=angle_rad,
+                focal_elevation_deg=elevation_deg,
+                null_action=row.null_action,
+            )
+            X_NEW[row_cursor] = np.asarray(new_normalized) * NEW_SCALES
+            anchors.add((row.world_id, row.anchor_id))
+            null_rows += int(row.null_action)
+            nonnull_geometry_rows += int(not row.null_action)
+            missing_rows += int(bool(old_normalized[15]))
+            if sample_payload is None and not row.null_action:
+                sample_payload = v2.project_row_payload_v2(
+                    row.payload(),
+                    off_axis_angle_rad=angle_rad,
+                    focal_elevation_deg=elevation_deg,
+                    geometry_source=(
+                        "provider boundary-0 ECEF satellite/cell/user geometry; "
+                        "elevation cross-checked against PrimitiveStepArrays"
+                    ),
+                )
+            row_cursor += 1
+        del shard
+
+    del resolver, tape, provider, carrier_maps
+    gc.collect()
+
+if row_cursor != EXPECTED_ROWS:
+    raise RuntimeError(f"expected {EXPECTED_ROWS} rows, read {row_cursor}")
+if sample_payload is None:
+    raise RuntimeError("corpus contained no non-null v2 sample row")
+
+old_indicator_checks = {
+    "beam_active_equals_indicator_background_occupancy": bool(
+        np.array_equal(X_OLD[:, 4], (X_OLD[:, 3] > 0.0).astype(np.float64))
+    ),
+    "previous_beam_active_equals_indicator_previous_load": bool(
+        np.array_equal(X_OLD[:, 12], (X_OLD[:, 11] > 0.0).astype(np.float64))
+    ),
+}
+if not all(old_indicator_checks.values()):
+    raise RuntimeError("sealed corpus no longer has the documented exact indicators")
+
+old_analysis = _analyse_matrix(
+    X_OLD,
+    Q1_FEATURES,
+    structurally_constant=set(),
+)
+new_analysis = _analyse_matrix(
+    X_NEW,
+    v2.Q1_V2_FEATURES,
+    structurally_constant={"missing_incumbent"},
+)
+
+new_names = list(v2.Q1_V2_FEATURE_NAMES)
+elevation_index = new_names.index("focal_link_elevation")
+visibility_index = new_names.index("remaining_visibility_time")
+nonnull = X_NEW[:, elevation_index] != 0.0
+elevation_visibility_all = float(
+    np.corrcoef(X_NEW[:, elevation_index], X_NEW[:, visibility_index])[0, 1]
+)
+elevation_visibility_nonnull = float(
+    np.corrcoef(
+        X_NEW[nonnull, elevation_index], X_NEW[nonnull, visibility_index]
+    )[0, 1]
+)
+
+encoded_sample = v2.encode_v2_shard([sample_payload])
+decoded_sample = v2.decode_v2_shard(encoded_sample)
+if len(decoded_sample) != 1:
+    raise RuntimeError("v2 sample shard round trip failed")
+
+# Freeze the read set and compare every sealed file opened after the audit hook
+# was installed. No sealed reads occur after this point.
+after = {path: _digest_file(Path(path)) for path in sorted(_before)}
+changed = [path for path in sorted(_before) if _before[path] != after[path]]
+if changed:
+    raise RuntimeError(f"sealed inputs changed during census: {changed}")
+
+peak_rss_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+payload: dict[str, Any] = {
+    "artifact": "Q1_SCHEMA_V2_CENSUS",
+    "diagnostic": "DIAGNOSTIC_NOT_CLAIM",
+    "verified_interpreter": sys.executable,
+    "resource_policy": {
+        "python_processes_used": 1,
+        "nice": 15,
+        "blas_threads": 1,
+        "address_space_limit_bytes": 4 * 1024**3,
+        "peak_rss_kb": peak_rss_kb,
+    },
+    "basis": {
+        "sealed_corpus": str(CORPUS),
+        "rows": row_cursor,
+        "anchors": len(anchors),
+        "worlds": list(WORLDS),
+        "null_action_rows": null_rows,
+        "nonnull_geometry_rows": nonnull_geometry_rows,
+    },
+    "schema_v2": {
+        "name": v2.Q1_V2_SCHEMA_VERSION,
+        "sha256": v2.Q1_V2_SCHEMA_SHA256,
+        "manifest": v2.Q1_V2_SCHEMA,
+        "nominal_dimension": len(v2.Q1_V2_FEATURES),
+        "effective_dimension": 14,
+        "effective_dimension_derivation": (
+            "15 serialized columns minus one documented structurally constant "
+            "missing_incumbent coordinate; the two v1 exact indicators were dropped"
+        ),
+    },
+    "old_schema": {
+        "name": v2.Q1_V1_SCHEMA_VERSION,
+        "sha256": Q1_SCHEMA_SHA256,
+        "nominal_dimension": 16,
+        "matrix_rank": old_analysis["raw_design_matrix"]["rank"],
+        "effective_dimension": 12,
+        "effective_dimension_derivation": (
+            "16 minus two constant coordinates and two exact indicator redundancies"
+        ),
+        "exact_indicator_checks": old_indicator_checks,
+    },
+    "missing_incumbent": {
+        "row_values_nonzero": missing_rows,
+        "incumbent_carrier_mapping_slots_checked": incumbent_mapping_slots,
+        "incumbent_carrier_mapping_none": incumbent_mapping_missing,
+        "structural_reason": (
+            "Both builders already assign incumbent.mapping[user] is None. On these tapes "
+            "every fixed-carrier incumbent mapping is served; step 0 deliberately uses its "
+            "current base as the incumbent, and later anchors use the previous carrier mapping."
+        ),
+    },
+    "geometry_checks": {
+        "maximum_elevation_ecef_vs_provider_array_error_deg": (
+            maximum_elevation_crosscheck_error_deg
+        ),
+        "off_axis_nonnull_min_rad": float(X_NEW[nonnull, new_names.index("off_axis_angle")].min()),
+        "off_axis_nonnull_max_rad": float(X_NEW[nonnull, new_names.index("off_axis_angle")].max()),
+        "elevation_nonnull_min_deg": float(X_NEW[nonnull, elevation_index].min()),
+        "elevation_nonnull_max_deg": float(X_NEW[nonnull, elevation_index].max()),
+        "elevation_vs_remaining_visibility_pearson_all_rows": elevation_visibility_all,
+        "elevation_vs_remaining_visibility_pearson_nonnull_rows": (
+            elevation_visibility_nonnull
+        ),
+        "null_geometry_encoding": "both values exactly 0, gated by SourceRow.null_action",
+    },
+    "old_census": old_analysis,
+    "new_census": new_analysis,
+    "v2_shard_contract_check": {
+        "sample_rows": len(decoded_sample),
+        "sample_encoded_sha256": sha256(encoded_sample).hexdigest(),
+        "header_q1_schema_sha256": json.loads(encoded_sample.splitlines()[0])[
+            "q1_schema_sha256"
+        ],
+        "reader_rechecked_header_and_every_row": True,
+    },
+    "sealed_file_digest_audit": {
+        "roots": [str(root) for root in SEALED_ROOTS],
+        "files_opened_after_audit_install": len(_before),
+        "changed_files": changed,
+        "all_unchanged": not changed,
+        "files": [
+            {"path": path, "before_sha256": _before[path], "after_sha256": after[path]}
+            for path in sorted(_before)
+        ],
+    },
+    "claim_boundaries": {
+        "learner_run": False,
+        "ee_claim": False,
+        "learnability_claim": False,
+        "tuning": False,
+    },
+}
+
+OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+OUTPUT.write_text(
+    json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
+    encoding="utf-8",
+)
+print(f"WROTE {OUTPUT}", flush=True)
+print(
+    f"ROWS={row_cursor} OLD_RANK={old_analysis['raw_design_matrix']['rank']} "
+    f"OLD_EFFECTIVE=12 NEW_RANK={new_analysis['raw_design_matrix']['rank']} "
+    f"NEW_EFFECTIVE=14",
+    flush=True,
+)
+print(f"Q1_V2_SCHEMA_SHA256={v2.Q1_V2_SCHEMA_SHA256}", flush=True)
+print(
+    f"SEALED_FILES={len(_before)} CHANGED={len(changed)} "
+    f"ELEV_VIS_R_ALL={elevation_visibility_all:.12g} "
+    f"ELEV_VIS_R_NONNULL={elevation_visibility_nonnull:.12g}",
+    flush=True,
+)
+print(f"PEAK_RSS_KB={peak_rss_kb}", flush=True)
