#!/usr/bin/env python3
"""Generate one-anchor-at-a-time exact catalogue rows for C3REAL."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import resource
from types import SimpleNamespace
import sys
import time

import numpy as np


RSS_LIMIT_BYTES = 5 * 1024**3
resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))

ROOT = Path(__file__).resolve().parents[2]
V2_ROOT = Path("/home/sat/mcrl-v025-design-ws")
V2_PATH = V2_ROOT / "q1_schema_v2.py"
PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
THREAD_ENV = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def verify_runtime() -> None:
    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
    if wrong:
        raise RuntimeError(f"thread environment is not pinned: {wrong}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness below 15")


def ratio(payload: dict[str, object], key: str):
    from fractions import Fraction
    value = payload[key]
    return Fraction(int(value[0]), int(value[1]))


def calibration(pilot):
    path = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/PILOT_NOT_CLAIM-calibration.json"
    payload = json.loads(path.read_text(encoding="ascii"))
    return pilot.PilotCalibration(
        eta_ref=ratio(payload, "eta_ref"),
        lambda_bits_per_j=ratio(payload, "lambda_bits_per_j"),
        kappa_bits_per_user_step=ratio(payload, "kappa_bits_per_user_step"),
        bits_ref=ratio(payload, "bits_ref"),
        joules_ref=ratio(payload, "joules_ref"),
        users=int(payload["users"]),
    )


def physical_action(pilot, identity):
    return pilot._physical_action(identity)


def proxy(row):
    return SimpleNamespace(
        null_action=row.action.is_null,
        user_id=int(row.user_id),
        action=SimpleNamespace(
            norad_id=row.action.norad_id,
            beam_chain_id=row.action.beam_chain_id,
        ),
    )


def projected_route_state(row, resolver, v2):
    angle, elevation = resolver(proxy(row))
    return (
        *v2.upgrade_q1_state_v2(
            row.q1_state,
            off_axis_angle_rad=angle,
            focal_elevation_deg=elevation,
            null_action=row.action.is_null,
        ),
        *row.q2_state,
    )


def declared_context(pilot, base_context, rows_by_user_action, resolver, v2, schema):
    """Use the declared C3 per-member route state: (*q1_state,*q2_state)."""
    members = []
    for member in base_context.members:
        selected_key = None if member.selected_action.is_null else (
            member.selected_action.norad_id, member.selected_action.beam_chain_id
        )
        reference_key = None if member.reference_action.is_null else (
            member.reference_action.norad_id, member.reference_action.beam_chain_id
        )
        selected = rows_by_user_action[(member.user_id, selected_key)]
        reference = rows_by_user_action[(member.user_id, reference_key)]
        if schema == "v1":
            selected_state = (*selected.q1_state, *selected.q2_state)
            reference_state = (*reference.q1_state, *reference.q2_state)
        else:
            selected_state = projected_route_state(selected, resolver, v2)
            reference_state = projected_route_state(reference, resolver, v2)
        members.append(
            pilot.CoalitionMember(
                user_id=member.user_id,
                reference_action=member.reference_action,
                selected_action=member.selected_action,
                selected_q1_row=tuple(selected_state),
                incumbent_q1_row=tuple(reference_state),
                missing_incumbent=member.missing_incumbent,
            )
        )
    return pilot.CoalitionContext(
        anchor_id=base_context.anchor_id,
        reference_profile=base_context.reference_profile,
        members=tuple(members),
        affected_beams=base_context.affected_beams,
        global_resource_features=base_context.global_resource_features,
        pairwise_cross_gain_terms=base_context.pairwise_cross_gain_terms,
    )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--world-index", type=int, choices=(1, 2), required=True)
    parser.add_argument("--start-step", type=int, default=0)
    parser.add_argument("--stop-step", type=int, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    args = parser.parse_args()
    verify_runtime()
    if not 0 <= args.start_step < args.stop_step <= 30:
        raise SystemExit("invalid step interval")
    args.output_dir.mkdir(parents=True, exist_ok=True)

    sys.path.insert(0, str(V2_ROOT))
    import q1_schema_v2 as v2
    import scripts.run_v025_pilot_c3 as pilot
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape

    watched = (
        PILOT_PATH, V2_PATH, ROOT / "src/mcrl/stagec_v025/learner.py",
        ROOT / "src/mcrl/stagec_v025/coalitions.py",
        ROOT / "src/mcrl/stagec_v025/state.py",
    )
    before = {str(path): sha256(path) for path in watched}
    original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
    domain = DEVELOPMENT_WORLD_DOMAINS[args.world_index - 1]
    provider_started = time.perf_counter()
    provider = LegacyWorldProvider(role="pilot-source")
    tape = build_world_tape(domain=domain, provider=provider, steps=33, start_time_s=0.0)
    provider_wall = time.perf_counter() - provider_started
    print(json.dumps({"event": "provider-ready", "world": domain, "wall_s": provider_wall}), flush=True)
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    cal = calibration(pilot)
    receipts = []
    maximum_geometry_error = 0.0
    try:
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
        assert pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is False
        for step_index in range(args.start_step, args.stop_step):
            started = time.perf_counter()
            built = pilot._build_anchor_rows(
                tape=tape, setting=setting, run_setting=run_setting,
                calibration=cal, step_index=step_index, carrier="nearest-eligible",
                anchor_index=step_index, include_coalition=False,
                # The bounded catalogue is built from the sealed eight-action
                # selection shortlist, so the exact-path source need not pay
                # for legal actions outside that support.
                full_legal_actions=False,
            )
            source_wall = time.perf_counter() - started
            print(json.dumps({"event": "source-ready", "world": domain, "step": step_index, "wall_s": source_wall}), flush=True)
            base = built["base"]
            incumbent = built["incumbent"]
            evaluator = built["current_evaluator"]
            catalogue_started = time.perf_counter()
            catalogue, census = pilot.ENGINE._catalogue_with_census(
                tape, step_index, base, setting=setting, calibration=cal,
                run_setting=run_setting,
            )
            exact = pilot._exact_interactions(base, incumbent, catalogue, evaluator, cal)
            print(json.dumps({"event": "exact-ready", "world": domain, "step": step_index, "rows": len(exact)}), flush=True)
            legal = tuple(row for row in catalogue if row.configuration_id in exact)
            catalogue_wall = time.perf_counter() - catalogue_started
            resolver = v2.DecisionGeometryResolverV2(tape, provider, step_index)
            maximum_geometry_error = max(
                maximum_geometry_error,
                float(resolver.maximum_elevation_crosscheck_error_deg),
            )
            sizes = np.asarray([len(exact[row.configuration_id]["changed"]) for row in legal], dtype=np.int16)
            targets = np.asarray([exact[row.configuration_id]["psi"] for row in legal], dtype=np.float64)
            joints = np.asarray([exact[row.configuration_id]["joint"] for row in legal], dtype=np.float64)
            additives = np.asarray([exact[row.configuration_id]["additive"] for row in legal], dtype=np.float64)
            coalition_indices = np.flatnonzero(sizes >= 2)
            x_v1 = []
            x_v2 = []
            x_v1_reversed = []
            x_v2_reversed = []
            invariant_vector_max_abs = 0.0
            for index in coalition_indices:
                config = legal[int(index)]
                base_context = pilot._coalition_context(
                    tape=tape, step_index=step_index, anchor=base, selected=config,
                    rows_by_user_action=built["rows_by_user_action"],
                )
                context_v1 = declared_context(
                    pilot, base_context, built["rows_by_user_action"], resolver, v2, "v1"
                )
                context_v2 = declared_context(
                    pilot, base_context, built["rows_by_user_action"], resolver, v2, "v2"
                )
                width_v1 = len(context_v1.members[0].invariant_features)
                width_v2 = len(context_v2.members[0].invariant_features)
                vector_v1 = context_v1.invariant_vector(member_width=width_v1)
                vector_v2 = context_v2.invariant_vector(member_width=width_v2)
                # Reversing members must leave the declared invariant vector unchanged.
                reverse_v1 = pilot.CoalitionContext(
                    anchor_id=context_v1.anchor_id,
                    reference_profile=context_v1.reference_profile,
                    members=tuple(reversed(context_v1.members)),
                    affected_beams=context_v1.affected_beams,
                    global_resource_features=context_v1.global_resource_features,
                    pairwise_cross_gain_terms=context_v1.pairwise_cross_gain_terms,
                ).invariant_vector(member_width=width_v1)
                reverse_v2 = pilot.CoalitionContext(
                    anchor_id=context_v2.anchor_id,
                    reference_profile=context_v2.reference_profile,
                    members=tuple(reversed(context_v2.members)),
                    affected_beams=context_v2.affected_beams,
                    global_resource_features=context_v2.global_resource_features,
                    pairwise_cross_gain_terms=context_v2.pairwise_cross_gain_terms,
                ).invariant_vector(member_width=width_v2)
                invariant_vector_max_abs = max(
                    invariant_vector_max_abs,
                    float(np.max(np.abs(vector_v1 - reverse_v1))),
                    float(np.max(np.abs(vector_v2 - reverse_v2))),
                )
                x_v1.append(vector_v1)
                x_v2.append(vector_v2)
                x_v1_reversed.append(reverse_v1)
                x_v2_reversed.append(reverse_v2)
            x_v1_array = np.stack(x_v1)
            x_v2_array = np.stack(x_v2)
            x_v1_reversed_array = np.stack(x_v1_reversed)
            x_v2_reversed_array = np.stack(x_v2_reversed)

