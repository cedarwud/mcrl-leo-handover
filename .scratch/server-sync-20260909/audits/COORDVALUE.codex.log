+    print("PARITY PASS " + json.dumps(endpoint_pooled, sort_keys=True), flush=True)
+
+    payload = {
+        "schema": "mcrl-v025-coordvalue-design-diagnostic-v1",
+        "status": "RUNNING",
+        "claim_status": "DESIGN_PHASE_DIAGNOSTIC_NOT_A_CLAIM",
+        "learner_free": True,
+        "python": sys.executable,
