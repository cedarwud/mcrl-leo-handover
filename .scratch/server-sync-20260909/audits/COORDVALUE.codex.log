+                            index = int(anchor_row["panel_row"]["global_anchor_index"])
+                            assignments = basin["anchors"][index]["endpoint"]["metrics"]["RSS_MAX_CATALOGUE_BEST"]["assignments"]
+                            seed_mapping = {
