+            anchor["selection_physical_boundary_evaluations"] = selection_evaluator.physical_evaluations
+            anchor["endpoint_physical_boundary_evaluations"] = endpoint.physical_evaluations
+            payload["anchors"].append(anchor)
+            payload["peak_rss_bytes"] = peak_rss_bytes()
+            atomic_write(payload)
+            del selection_evaluator, endpoint, supports, current_support
+            gc.collect()
+            check_runtime()
+            print(
+                f"anchor {position}/{len(prepared)} peak RSS {peak_rss_bytes()/2**30:.3f} GiB "
+                + json.dumps({
+                    name: {
