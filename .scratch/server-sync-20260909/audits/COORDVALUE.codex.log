   477	def evaluate_rows(handle, anchor_index, anchor_id, start_name, rows, k,
   478	                  selection_evaluator, endpoint_metrics,
   479	                  panel, runner, calibration, incumbent, rekeys, start,
   480	                  start_selection_profile, start_f, start_ee, start_served, support_ids,
   481	                  first_prefix=()):
   482	    output_rows = []
   483	    first = True
   484	    for offset in range(0, len(rows), EVAL_BATCH):
   485	        chunk = rows[offset:offset + EVAL_BATCH]
   486	        configs = [item[0] for item in chunk]
   487	        if first and first_prefix:
   488	            selection_evaluator.evaluate_many(dedupe((*first_prefix, *configs)))
   489	        else:
   490	            selection_evaluator.evaluate_many(configs)
   491	        first = False
   492	        for config, members, edits, method in chunk:
   493	            row = classify_candidate(
   494	                panel, runner, calibration, incumbent, rekeys, selection_evaluator,
   495	                endpoint_metrics, start, start_selection_profile,
   496	                start_f, start_ee, start_served,
   497	                config, members, edits, method, support_ids, k,
   498	            )
   499	            handle.write(json.dumps({
   500	                "anchor_index": anchor_index, "anchor_id": anchor_id,
   501	                "start": start_name, **row,
   502	            }, sort_keys=True, separators=(",", ":")) + "\n")
   503	            output_rows.append(row)
   504	        keep = {row.configuration_id for row in first_prefix}
   505	        keep.update((start.configuration_id,))
   506	        for config in configs:
   507	            if config.configuration_id not in keep:
   508	                selection_evaluator._evaluated.pop(config.configuration_id, None)
   509	    return output_rows
