   512	def endpoint_candidate_metrics(panel, evaluator, rows, keep_ids):
   513	    result = {}
   514	    for offset in range(0, len(rows), EVAL_BATCH):
   515	        chunk = rows[offset:offset + EVAL_BATCH]
   516	        configs = [item[0] for item in chunk]
   517	        evaluator.evaluate_many(configs)
   518	        for config in configs:
   519	            p = profile(evaluator, config)
   520	            result[config.configuration_id] = {
   521	                "bits": p.bits,
   522	                "joules": p.joules,
   523	                "ee_mbit_per_j": p.bits / p.joules / 1e6,
   524	                "served": panel.served(p),
   525	            }
   526	        for config in configs:
   527	            if config.configuration_id not in keep_ids:
   528	                evaluator._evaluated.pop(config.configuration_id, None)
   529	    return result
