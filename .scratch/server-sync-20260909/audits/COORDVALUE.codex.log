+                                forced.append(mapping)
+                    samples = sampled_candidates(
+                        runner, representative_base, start, target, options, k, SAMPLE_BUDGET,
+                        RANDOM_SEED + 100000 * step_index + 1000 * start_ordinal + k,
+                        best_by_user, forced,
