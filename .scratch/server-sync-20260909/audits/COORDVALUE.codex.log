   315	def catalogue_support_ids(runner, calibration, tape, step_index, geometric_base, start, run_setting):
   316	    """Rebuild bounded-union-v2 support around start without scalar evaluate.
   317	
   318	    The auxiliary nominal evaluator identifies the catalogue's sealed top-10
   319	    rank only.  It does not score or select any COORDVALUE candidate.
   320	    """
   321	    options, census = runner._selection_shortlist(tape, step_index, run_setting=run_setting)
   322	    users = tuple(sorted(start.mapping))
   323	    base_map = start.mapping
   324	    unilaterals = {user: [] for user in users}
   325	    rows = [start]
   326	    for user in users:
   327	        for identity in options[user]:
   328	            if identity == base_map[user]:
   329	                continue
   330	            mapping = dict(base_map)
   331	            mapping[user] = identity
   332	            row = runner._configuration(start, mapping, kind="unilateral")
   333	            rows.append(row)
   334	            unilaterals[user].append(row)
   335	
   336	    nominal = fresh_evaluator(
   337	        runner, tape, step_index, start, run_setting, "nominal", (0,),
   338	    )
   339	    first_call = dedupe((geometric_base, start, *rows[1:]))
   340	    assert first_call[0].configuration_id == geometric_base.configuration_id
   341	    assert len(first_call) > 2
   342	    for offset in range(0, len(first_call), EVAL_BATCH):
   343	        nominal.evaluate_many(first_call[offset:offset + EVAL_BATCH])
   344	    start_profile = profile(nominal, start)
   345	    best_surplus = {}
   346	    for user in users:
   347	        values = []
   348	        for row in unilaterals[user]:
   349	            p = profile(nominal, row)
   350	            core = Fraction(str(p.bits - start_profile.bits)) - calibration.eta_ref * Fraction(
   351	                str(p.joules - start_profile.joules)
   352	            )
   353	            core += calibration.kappa_bits_per_user_step * runner._phi_for(start, row)
   354	            values.append(core)
   355	        best_surplus[user] = max(values, default=Fraction(-10**30))
   356	    ranked_users = sorted(users, key=lambda user: (-best_surplus[user], user))[:runner.PAIRWISE_TOP_K_USERS]
   357	
   358	    for proposal_rank in range(runner.TOP_PROPOSALS):
   359	        mapping = dict(base_map)
   360	        for user in users:
   361	            if len(unilaterals[user]) > proposal_rank:
   362	                mapping[user] = unilaterals[user][proposal_rank].mapping[user]
   363	        if mapping != base_map:
   364	            rows.append(runner._configuration(start, mapping, kind="s0-top-two"))
   365	    for first, second in itertools.combinations(ranked_users, 2):
   366	        for first_row in unilaterals[first][:runner.TOP_PROPOSALS]:
   367	            for second_row in unilaterals[second][:runner.TOP_PROPOSALS]:
   368	                mapping = dict(base_map)
   369	                mapping[first] = first_row.mapping[first]
   370	                mapping[second] = second_row.mapping[second]
   371	                rows.append(runner._configuration(start, mapping, kind="pairwise-top10-top2"))
   372	    for beam in sorted({identity for identity in base_map.values() if identity is not None}):
   373	        mapping = dict(base_map)
   374	        affected = [user for user in users if base_map[user] == beam]
   375	        for user in affected:
   376	            mapping[user] = next((identity for identity in options[user] if identity != beam), None)
   377	        if mapping != base_map:
   378	            rows.append(runner._configuration(start, mapping, kind="beam-evacuation"))
   379	    unique = {row.configuration_id: row for row in rows}
   380	    histogram = Counter(len(changed_users(start, row)) for row in unique.values())
   381	    result = {
   382	        "ids": frozenset(unique),
   383	        "count": len(unique),
   384	        "size_histogram": dict(sorted(histogram.items())),
   385	        "top10_users": ranked_users,
   386	        "shortlist_census": census,
   387	        "nominal_physical_boundary_evaluations": nominal.physical_evaluations,
   388	    }
   389	    del nominal
   390	    gc.collect()
   391	    return result
