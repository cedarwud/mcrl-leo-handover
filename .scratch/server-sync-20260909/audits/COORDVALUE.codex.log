+        "endpoint_pooled": endpoint_pooled,
+        "pooled_candidate_counts": pooled_counts,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+    }, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

