+    }
+    atomic_write(payload)
+    CANDIDATES.parent.mkdir(parents=True, exist_ok=True)
+    with CANDIDATES.open("w", encoding="utf-8") as handle:
+        completed = 0
+        for group in groups:
+            step_index = group["step_index"]
+            options = group["options"]
