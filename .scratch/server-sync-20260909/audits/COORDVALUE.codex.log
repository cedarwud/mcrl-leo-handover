   220	def add_sample(samples, seen, runner, base, start, mapping, k, method):
   221	    changed = tuple(user for user in sorted(mapping) if mapping[user] != start.mapping[user])
   222	    if len(changed) != k:
   223	        return False
   224	    row = runner._configuration(base, mapping, kind=f"coordvalue-sampled-k{k}")
   225	    if row.configuration_id in seen:
   226	        return False
   227	    seen.add(row.configuration_id)
   228	    edits = tuple((user, mapping[user]) for user in changed)
   229	    samples.append((row, changed, edits, method))
   230	    return True
