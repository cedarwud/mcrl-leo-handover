+                        "counts": all_counts,
+                    }
+                anchor["selection_physical_boundary_evaluations"] = selection_evaluator.physical_evaluations
+                anchor["endpoint_physical_boundary_evaluations_shared_for_step"] = endpoint.physical_evaluations
