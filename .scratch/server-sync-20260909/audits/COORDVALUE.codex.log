   532	def pool_endpoints(endpoint_anchors, name):
   533	    rows = [anchor[name] for anchor in endpoint_anchors]
   534	    bits = math.fsum(row["bits"] for row in rows)
   535	    joules = math.fsum(row["joules"] for row in rows)
