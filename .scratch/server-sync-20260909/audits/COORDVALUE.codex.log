+                )
+                anchor = {
+                    "global_anchor_index": index, "anchor_id": anchor_id,
+                    "step_index": step_index, "carrier": carrier, "starts": {},
+                }
+                first_prefix = (base, *start_configs.values())
+                first_call_pending = True
+                for start_name, start in start_configs.items():
