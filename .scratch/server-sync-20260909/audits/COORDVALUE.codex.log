   468	        "improving_inside_current_catalogue_count": sum(row["inside_current_catalogue"] for row in improving),
   469	        "improving_outside_current_catalogue_count": sum(not row["inside_current_catalogue"] for row in improving),
   470	        "candidate_inside_current_catalogue_count": support_count,
