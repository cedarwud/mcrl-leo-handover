+                    ))
+                minimum_k = next((row["k"] for row in summaries if row["ee_improving_count"]), None)
+                all_counts = {
+                    "candidates_evaluated": sum(row["candidates_evaluated"] for row in summaries),
+                    "guarded_candidates": sum(row["guarded_candidates"] for row in summaries),
+                    "service_dropping_candidates": sum(row["service_dropping_candidates"] for row in summaries),
+                    "service_dropping_ee_increase_count": sum(row["service_dropping_ee_increase_count"] for row in summaries),
+                    "ee_improving_count": sum(row["ee_improving_count"] for row in summaries),
+                    "ee_improves_f_decreases_count": sum(row["ee_improves_f_decreases_count"] for row in summaries),
+                    "f_improves_ee_decreases_count": sum(row["f_improves_ee_decreases_count"] for row in summaries),
+                    "improving_inside_current_catalogue_count": sum(row["improving_inside_current_catalogue_count"] for row in summaries),
+                    "improving_outside_current_catalogue_count": sum(row["improving_outside_current_catalogue_count"] for row in summaries),
+                }
