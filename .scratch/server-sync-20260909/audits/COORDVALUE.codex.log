+    # 1. Combine the best guarded one-user EE move for promising users.
+    ranked = [user for user, _row in sorted(
+        best_by_user.items(), key=lambda item: (-item[1]["delta_ee_mbit_per_j"], item[0])
+    )]
+    top = ranked[:min(32, len(ranked))]
+    if len(top) >= k:
