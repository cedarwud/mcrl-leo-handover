+        "kappa_bits_per_user_step": fraction_payload(calibration.kappa_bits_per_user_step),
+        "eta_ref_source": str(CALIBRATION_PATH),
+        "endpoint_parity": {
+            "status": "PASS",
+            "path": "per anchor: one separate fresh realised dense full-48 StepEvaluator; first evaluate_many batch contains BASE, RSS_MAX, and CROWDED; after parity passes, every candidate is added to this same endpoint evaluator",
+            "anchors": endpoint_anchors,
