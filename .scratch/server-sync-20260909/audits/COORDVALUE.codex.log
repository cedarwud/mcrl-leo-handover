+def compact_best(row):
+    if row is None:
+        return None
+    return {key: row[key] for key in (
+        "configuration_id", "changed_users", "edits", "method", "bits", "joules",
+        "ee_mbit_per_j", "delta_ee_mbit_per_j", "delta_f", "served", "guarded",
