+        "count": len(unique),
+        "size_histogram": dict(sorted(histogram.items())),
+        "top10_users": ranked_users,
+        "shortlist_census": census,
+        "nominal_physical_boundary_evaluations": nominal.physical_evaluations,
+    }
+    del nominal
+    gc.collect()
+    return result
