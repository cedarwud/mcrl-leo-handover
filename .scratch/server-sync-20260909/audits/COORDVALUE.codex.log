+                            "ee_mbit_per_j": start_ee, "f": fraction_payload(start_f),
+                            "physical_core_b_minus_eta_e": fraction_payload(start_physical),
+                            "phi_cost_bits": fraction_payload(start_phi), "served": start_served,
+                        },
+                        "catalogue_support": {
