   233	def sampled_candidates(runner, base, start, target, options, k, budget, seed, best_by_user,
   234	                       forced_mappings=()):
   235	    """Fixed-budget deterministic mixture; every returned profile has exactly k edits."""
   236	    rng = random.Random(seed)
   237	    samples = []
   238	    seen = set()
   239	    start_map = start.mapping
   240	    users = tuple(sorted(start_map))
   241	
   242	    # Deterministic prior catalogue witness/subsets are candidates, not accepted
   243	    # evidence: they are rescored below on the same fresh realised EE surface.
   244	    for mapping in forced_mappings:
   245	        add_sample(
   246	            samples, seen, runner, base, start, dict(mapping), k,
   247	            "prior-basin2-catalogue-witness-or-subset",
   248	        )
   249	
   250	    # 1. Combine the best guarded one-user EE move for promising users.
   251	    ranked = [user for user, _row in sorted(
   252	        best_by_user.items(), key=lambda item: (-item[1]["delta_ee_mbit_per_j"], item[0])
   253	    )]
   254	    top = ranked[:min(32, len(ranked))]
   255	    if len(top) >= k:
   256	        combos = itertools.combinations(top, k)
   257	        for members in itertools.islice(combos, budget // 4):
   258	            mapping = dict(start_map)
   259	            for user in members:
   260	                mapping[user] = best_by_user[user]["identity"]
   261	            add_sample(samples, seen, runner, base, start, mapping, k, "top-single-combination")
   262	
   263	    # 2. Move subsets toward the opposite known-good endpoint.
   264	    target_users = [user for user in users if target.mapping[user] != start_map[user]]
   265	    attempts = 0
   266	    target_goal = min(budget // 2, budget)
   267	    while len(samples) < target_goal and len(target_users) >= k and attempts < budget * 20:
   268	        attempts += 1
   269	        members = tuple(sorted(rng.sample(target_users, k)))
   270	        mapping = dict(start_map)
   271	        for user in members:
   272	            mapping[user] = target.mapping[user]
   273	        add_sample(samples, seen, runner, base, start, mapping, k, "opposite-endpoint-subset")
   274	
   275	    # 3. Concentrate k users on one common legal destination beam.
   276	    beam_users = defaultdict(list)
   277	    for user in users:
   278	        for beam in options[user]:
   279	            if beam != start_map[user]:
   280	                beam_users[beam].append(user)
   281	    eligible_beams = [beam for beam, members in sorted(beam_users.items()) if len(members) >= k]
   282	    consolidation_goal = min(3 * budget // 4, budget)
   283	    attempts = 0
   284	    while len(samples) < consolidation_goal and eligible_beams and attempts < budget * 30:
   285	        attempts += 1
   286	        beam = eligible_beams[rng.randrange(len(eligible_beams))]
   287	        members = tuple(sorted(rng.sample(beam_users[beam], k)))
   288	        mapping = dict(start_map)
   289	        for user in members:
   290	            mapping[user] = beam
   291	        add_sample(samples, seen, runner, base, start, mapping, k, "common-destination-consolidation")
   292	
   293	    # 4. Uniform users and uniform legal non-incumbent identities; 5% include null edits.
   294	    attempts = 0
   295	    while len(samples) < budget and attempts < budget * 100:
   296	        attempts += 1
   297	        members = tuple(sorted(rng.sample(users, k)))
   298	        mapping = dict(start_map)
   299	        possible = True
   300	        for user in members:
   301	            alternatives = [identity for identity in options[user] if identity != start_map[user]]
   302	            if start_map[user] is not None and rng.random() < 0.05:
   303	                alternatives.append(None)
   304	            if not alternatives:
   305	                possible = False
   306	                break
   307	            mapping[user] = alternatives[rng.randrange(len(alternatives))]
   308	        if possible:
   309	            add_sample(samples, seen, runner, base, start, mapping, k, "uniform-legal-mixture")
   310	    if len(samples) != budget:
   311	        raise RuntimeError(f"could only construct {len(samples)}/{budget} unique k={k} samples")
   312	    return samples
