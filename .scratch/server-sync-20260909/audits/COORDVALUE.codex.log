   394	def classify_candidate(panel, runner, calibration, incumbent, rekeys,
   395	                       selection_evaluator, endpoint_metrics,
   396	                       start, start_selection_profile, start_f, start_ee, start_served,
   397	                       config, members, edits, method, support_ids, k):
   398	    selection_profile = profile(selection_evaluator, config)
   399	    endpoint_profile = endpoint_metrics[config.configuration_id]
   400	    candidate_f, physical_f, phi_cost = total_f(
   401	        runner, calibration, incumbent, rekeys, config, selection_profile,
   402	    )
   403	    served = endpoint_profile["served"]
   404	    ee = endpoint_profile["ee_mbit_per_j"]
   405	    delta_ee = ee - start_ee
   406	    delta_f = candidate_f - start_f
   407	    guarded = served >= start_served
   408	    ee_improves = guarded and delta_ee > 0.0
   409	    f_improves = guarded and delta_f > 0
   410	    return {
   411	        "k": k,
   412	        "configuration_id": config.configuration_id,
   413	        "changed_users": list(members),
   414	        "edits": [[user, None if identity is None else list(identity)] for user, identity in edits],
   415	        "method": method,
   416	        "bits": endpoint_profile["bits"],
   417	        "joules": endpoint_profile["joules"],
   418	        "endpoint_boundaries": 48,
   419	        "selection_boundary0_bits": selection_profile.bits,
   420	        "selection_boundary0_joules": selection_profile.joules,
   421	        "ee_mbit_per_j": ee,
   422	        "delta_ee_mbit_per_j": delta_ee,
   423	        "f": fraction_payload(candidate_f),
   424	        "physical_core_b_minus_eta_e": fraction_payload(physical_f),
   425	        "phi_cost_bits": fraction_payload(phi_cost),
   426	        "delta_f": fraction_payload(delta_f),
   427	        "served": served,
   428	        "start_served": start_served,
   429	        "guarded": guarded,
   430	        "service_dropping_ee_increase": served < start_served and delta_ee > 0.0,
   431	        "ee_improves": ee_improves,
   432	        "f_improves": f_improves,
   433	        "ee_improves_f_decreases": ee_improves and delta_f < 0,
   434	        "f_improves_ee_decreases": f_improves and delta_ee < 0.0,
   435	        "inside_current_catalogue": config.configuration_id in support_ids,
   436	    }
