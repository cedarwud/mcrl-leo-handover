+                    summaries.append(summarize_rows(
+                        sampled_rows, k, "sampled-fixed-mixture", SAMPLE_BUDGET, False,
+                        sum(row["inside_current_catalogue"] for row in sampled_rows),
+                    ))
+                minimum_k = next((row["k"] for row in summaries if row["ee_improving_count"]), None)
+                all_counts = {
+                    "candidates_evaluated": sum(row["candidates_evaluated"] for row in summaries),
+                    "guarded_candidates": sum(row["guarded_candidates"] for row in summaries),
+                    "service_dropping_candidates": sum(row["service_dropping_candidates"] for row in summaries),
+                    "service_dropping_ee_increase_count": sum(row["service_dropping_ee_increase_count"] for row in summaries),
+                    "ee_improving_count": sum(row["ee_improving_count"] for row in summaries),
+                    "ee_improves_f_decreases_count": sum(row["ee_improves_f_decreases_count"] for row in summaries),
+                    "f_improves_ee_decreases_count": sum(row["f_improves_ee_decreases_count"] for row in summaries),
+                    "improving_inside_current_catalogue_count": sum(row["improving_inside_current_catalogue_count"] for row in summaries),
+                    "improving_outside_current_catalogue_count": sum(row["improving_outside_current_catalogue_count"] for row in summaries),
+                }
+                anchor["starts"][start_name] = {
+                    "configuration_id": start.configuration_id,
+                    "start": {
+                        "bits": start_endpoint_profile.bits,
+                        "joules": start_endpoint_profile.joules,
+                        "endpoint_boundaries": 48,
+                        "selection_boundary0_bits": start_selection_profile.bits,
+                        "selection_boundary0_joules": start_selection_profile.joules,
+                        "ee_mbit_per_j": start_ee,
+                        "f": fraction_payload(start_f),
+                        "physical_core_b_minus_eta_e": fraction_payload(start_physical),
+                        "phi_cost_bits": fraction_payload(start_phi),
+                        "served": start_served,
+                    },
+                    "catalogue_support": {
+                        key: value for key, value in supports[start_name].items() if key != "ids"
+                    },
+                    "by_k": summaries,
+                    "minimum_sampled_or_exhaustive_improving_k": minimum_k,
+                    "counts": all_counts,
+                }
+            anchor["selection_physical_boundary_evaluations"] = selection_evaluator.physical_evaluations
+            anchor["endpoint_physical_boundary_evaluations"] = endpoint.physical_evaluations
+            payload["anchors"].append(anchor)
+            payload["peak_rss_bytes"] = peak_rss_bytes()
+            atomic_write(payload)
+            del selection_evaluator, endpoint, supports, current_support
+            gc.collect()
+            check_runtime()
+            print(
+                f"anchor {position}/{len(prepared)} peak RSS {peak_rss_bytes()/2**30:.3f} GiB "
+                + json.dumps({
+                    name: {
+                        "minimum_k": anchor["starts"][name]["minimum_sampled_or_exhaustive_improving_k"],
+                        "k1_improving": anchor["starts"][name]["by_k"][0]["ee_improving_count"],
+                    } for name in start_configs
+                }, sort_keys=True),
+                flush=True,
+            )
+
+    pooled_counts = {}
+    for start_name in ("RSS_MAX", "CROWDED"):
+        pooled_counts[start_name] = {
+            key: sum(anchor["starts"][start_name]["counts"][key] for anchor in payload["anchors"])
+            for key in payload["anchors"][0]["starts"][start_name]["counts"]
+        }
+        pooled_counts[start_name]["minimum_k_distribution"] = dict(Counter(
+            str(anchor["starts"][start_name]["minimum_sampled_or_exhaustive_improving_k"])
+            for anchor in payload["anchors"]
+        ))
+        rejected = [
+            row["best_ee_improvement_f_rejects"]
+            for anchor in payload["anchors"]
+            for row in anchor["starts"][start_name]["by_k"]
+            if row["best_ee_improvement_f_rejects"] is not None
+        ]
+        pooled_counts[start_name]["best_ee_improvement_f_rejects"] = max(
+            rejected, key=lambda row: (row["delta_ee_mbit_per_j"], row["configuration_id"]),
+            default=None,
+        )
+    payload["pooled_candidate_counts"] = pooled_counts
+    payload["candidate_log_sha256"] = sha256(CANDIDATES)
+    payload["scalar_evaluate_calls"] = SCALAR_EVALUATE_CALLS
+    assert SCALAR_EVALUATE_CALLS == 0
+    payload["scalar_evaluate_assertion"] = "PASS: raising stub installed; zero calls"
+    payload["status"] = "COMPLETE"
+    payload["peak_rss_bytes"] = peak_rss_bytes()
+    payload["wall_seconds"] = time.perf_counter() - started
+    payload["runner_sha256"] = sha256(Path(__file__))
+    atomic_write(payload)
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(json.dumps({
+        "endpoint_pooled": endpoint_pooled,
+        "pooled_candidate_counts": pooled_counts,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+    }, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

