+        mapping = dict(start_map)
+        possible = True
+        for user in members:
+            alternatives = [identity for identity in options[user] if identity != start_map[user]]
+            if start_map[user] is not None and rng.random() < 0.05:
+                alternatives.append(None)
+            if not alternatives:
