#!/usr/bin/env python3
"""Targeted, shared-work evaluation of existing PILOT_NOT_CLAIM checkpoints."""

from __future__ import annotations

import hashlib
import importlib.util
import json
import math
from pathlib import Path
import sys
import time


ROOT = Path(__file__).resolve().parents[2]
PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
MINIMAL = ROOT / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
FULL_RUN = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
OUTPUT = ROOT / "artifacts/v025-pilot-epoch-trend-20260909-PILOT_NOT_CLAIM"
EPOCHS = (200, 600, 1000, 1400, 2000)
ARMS = ("FULL", "DROP_C3")
REPORTED_ARMS = (*ARMS, "BASELINE")


def load_pilot():
    spec = importlib.util.spec_from_file_location("v025_epoch_trend_pilot", PILOT_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {PILOT_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def verify_checkpoint(path: Path) -> None:
    sidecar = path.with_name(path.name + ".sha256")
    expected = sidecar.read_text(encoding="ascii").split()[0]
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != expected:
        raise RuntimeError(f"checkpoint digest mismatch: {path}")


def summarize(records):
    result = {}
    for variant in ("P-a0", "P-u"):
        result[variant] = {}
        for epoch in EPOCHS:
            epoch_rows = [
                row for row in records
                if row["catalogue_anchor"] == variant and row["epoch"] == epoch
            ]
            arms = {}
            for arm in REPORTED_ARMS:
                rows = [row for row in epoch_rows if row["arm"] == arm]
                bits = math.fsum(row["bits"] for row in rows)
                joules = math.fsum(row["joules"] for row in rows)
                arms[arm] = {
                    "bits": bits,
                    "joules": joules,
                    "pooled_ee_bits_per_j": bits / joules,
                    "availability": math.fsum(row["availability"] for row in rows) / len(rows),
                }
            full_rows = [row for row in epoch_rows if row["arm"] == "FULL"]
            result[variant][str(epoch)] = {
                "arms": arms,
                "full_minus_drop_c3_relative": (
                    arms["FULL"]["pooled_ee_bits_per_j"]
                    / arms["DROP_C3"]["pooled_ee_bits_per_j"] - 1.0
                ),
                "full_mean_selected_coalition_size": (
                    math.fsum(row["changed_users"] for row in full_rows) / len(full_rows)
                ),
                "full_selected_coalition_sizes": sorted(
                    {int(row["changed_users"]) for row in full_rows}
                ),
            }
    return result


def main() -> int:
    if OUTPUT.exists():
        raise SystemExit(f"refusing to overwrite {OUTPUT}")
    pilot = load_pilot()
    pilot.EVALUATION_WORLDS = pilot.DEVELOPMENT_WORLD_DOMAINS[2:3]
    pilot.LEARNER_DOMAINS = pilot.LEARNER_DOMAINS[:2]
    pilot.LEARNER_SEEDS = pilot.LEARNER_SEEDS[:2]
    pilot.PILOT_ARMS = ARMS
    pilot.REPORTED_ARMS = REPORTED_ARMS
    pilot.ROW_WORLD_GLOB = "world-1"
    pilot.ROW_ANCHOR_LIMIT = 5
    pilot.EVAL_EPOCH = 200

    row_manifest, training_manifest, calibration, _old_models, batches = (
        pilot._load_completed_training(MINIMAL)
    )
    models_by_epoch = {}
    checkpoint_digests = {}
    for epoch in EPOCHS:
        payloads = {}
        for seed in pilot.LEARNER_SEEDS:
            for arm in ARMS:
                path = FULL_RUN / "checkpoints" / (
                    f"{pilot.LABEL}-seed-{seed}-{arm}-epoch-{epoch:04d}.json"
                )
                verify_checkpoint(path)
                checkpoint_digests[str(path.relative_to(ROOT))] = hashlib.sha256(
                    path.read_bytes()
                ).hexdigest()
                payloads[(seed, arm)] = json.loads(
                    path.read_text(encoding="ascii")
                )["model"]
        models_by_epoch[epoch] = pilot._restore_models(payloads, batches)

    records = []
    latencies = []
    started = time.perf_counter()
    cpu_started = time.process_time()
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    for domain in pilot.EVALUATION_WORLDS:
        tape_started = time.perf_counter()
        print(json.dumps({"event": "tape_build_start", "steps": 8}), flush=True)
        tape = pilot.build_world_tape(
            domain=domain,
            provider=pilot.LegacyWorldProvider(role="pilot-evaluation"),
            steps=8,
            start_time_s=0.0,
        )
        print(json.dumps({
            "event": "tape_build_done",
            "wall_s": time.perf_counter() - tape_started,
        }), flush=True)
        for anchor_index, step_index in enumerate(range(5)):
            anchor_started = time.perf_counter()
            built = pilot._build_anchor_rows(
                tape=tape,
                setting=setting,
                run_setting=run_setting,
                calibration=calibration,
                step_index=step_index,
                carrier="nearest-eligible",
                anchor_index=anchor_index,
                include_coalition=False,
                full_legal_actions=True,
            )
            carrier_base = built["base"]
            incumbent = built["incumbent"]
            source_rows = built["rows_by_user_action"]
            current = built["current_evaluator"]
            standard_catalogue, _ = pilot.ENGINE._catalogue_with_census(
                tape,
                step_index,
                carrier_base,
                setting=setting,
                calibration=calibration,
                run_setting=run_setting,
            )
            u, u_iterations, u_wall, u_missed, u_certificate = (
                pilot.ENGINE._s_uni_select(
                    base=carrier_base,
                    incumbent=incumbent,
                    tape=tape,
                    step_index=step_index,
                    evaluator=current,
                    calibration=calibration,
                    compute_budget_s=5.0,
                    run_setting=run_setting,
                    cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
                )
            )
            u_catalogue, ranked_users, u_catalogue_wall = pilot._build_u_catalogue(
                tape,
                step_index,
                carrier_base,
                u,
                standard_catalogue,
                current,
                calibration,
                source_rows,
            )
            variants = {
                "P-a0": (carrier_base, standard_catalogue),
                "P-u": (u, u_catalogue),
            }
            realised = pilot.ENGINE.StepEvaluator(
                tape,
                setting,
                step_index,
                transition_from=incumbent,
                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
                field="realised",
                run_setting=run_setting,
            )
            for variant, (catalogue_anchor, catalogue) in variants.items():
                structural = pilot._structural_interactions(catalogue_anchor, catalogue)
                selections_by_epoch = {}
                for epoch in EPOCHS:
                    selections, _diagnostics = pilot._select_for_anchor(
                        variant,
                        catalogue_anchor,
                        catalogue,
                        structural,
                        models_by_epoch[epoch],
                        source_rows,
                        tape,
                        step_index,
                        carrier_base,
                    )
                    for seed in pilot.LEARNER_SEEDS:
                        selections[(seed, "BASELINE")] = carrier_base
                    selections_by_epoch[epoch] = selections
                configs = {
                    config.assignments: config
                    for selections in selections_by_epoch.values()
                    for config in selections.values()
                }
                realised.evaluate_many(tuple(configs.values()))
                for epoch, selections in selections_by_epoch.items():
                    for seed in pilot.LEARNER_SEEDS:
                        for arm in REPORTED_ARMS:
                            config = selections[(seed, arm)]
                            profile = realised.evaluate(config)
                            records.append({
                                "artifact_label": pilot.LABEL,
                                "epoch": epoch,
                                "world_id": domain,
                                "world_seed": tape.seed,
                                "anchor_index": anchor_index,
                                "step_index": step_index,
                                "carrier": "nearest-eligible",
                                "catalogue_anchor": variant,
                                "learner_seed": seed,
                                "arm": arm,
                                "configuration_id": config.configuration_id,
                                "changed_users": config.changed_users,
                                "bits": profile.bits,
                                "joules": profile.joules,
                                "pooled_ee_bits_per_j": profile.bits / profile.joules,
                                "availability": float(profile.outcome().useful_availability),
                            })
            latencies.append({
                "anchor_index": anchor_index,
                "wall_s": time.perf_counter() - anchor_started,
                "source_physics_evaluations": built["physics_calls"],
                "current_physics_evaluations": current.physical_evaluations,
                "realised_physics_evaluations": realised.physical_evaluations,
                "s_uni_iterations": u_iterations,
                "s_uni_wall_s": u_wall,
                "s_uni_deadline_missed": u_missed,
                "s_uni_termination_certificate": u_certificate,
                "u_catalogue_wall_s": u_catalogue_wall,
                "u_top10_users_by_abs_d": ranked_users,
            })
            print(json.dumps({
                "event": "anchor_done",
                "anchor": anchor_index + 1,
                "anchors_total": 5,
                "wall_s": latencies[-1]["wall_s"],
            }), flush=True)

    summary = summarize(records)
    OUTPUT.mkdir(parents=True)
    receipt_path = OUTPUT / "PILOT_NOT_CLAIM-epoch-trend-receipts.jsonl"
    with receipt_path.open("x", encoding="ascii") as stream:
        for row in records:
            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n")
    receipt_digest = hashlib.sha256(receipt_path.read_bytes()).hexdigest()
    (receipt_path.with_name(receipt_path.name + ".sha256")).write_text(
        f"{receipt_digest}  {receipt_path.name}\n", encoding="ascii"
    )
    manifest = {
        "artifact_label": pilot.LABEL,
        "schema": "mcrl-v025-pilot-epoch-trend-evaluation-v1",
        "scope": {
            "epochs": EPOCHS,
            "worlds": pilot.EVALUATION_WORLDS,
            "anchors": 5,
            "tape_steps": 8,
            "carrier": "nearest-eligible",
            "learner_seed_domains": pilot.LEARNER_DOMAINS,
            "arms": REPORTED_ARMS,
            "catalogue_anchors": ("P-a0", "P-u"),
        },
        "source_artifacts": {
            "minimal_rows_and_calibration": str(MINIMAL.relative_to(ROOT)),
            "full_run_checkpoints": str(FULL_RUN.relative_to(ROOT)),
            "row_manifest_schema": row_manifest["schema"],
            "training_manifest_schema": training_manifest["schema"],
            "checkpoint_sha256": checkpoint_digests,
        },
        "defective_coalition_feature_path": True,
        "evaluation_source": "clean git HEAD snapshot, isolated from concurrent coalition repair",
        "wall_s": time.perf_counter() - started,
        "core_s": time.process_time() - cpu_started,
        "receipt_rows": len(records),
        "receipt_sha256": receipt_digest,
        "latencies": latencies,
        "summary": summary,
    }
    manifest_path = OUTPUT / "PILOT_NOT_CLAIM-epoch-trend-summary.json"
.scratch/epoch-trend/run_epoch_trend.py:16:PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"

