    LEARNED_ARMS,
    PairwiseBatch,
    ROUTES,
    SOURCE_MAP,
    V1LineageOrchestrator,
    build_pairwise_batches,
    default_synthetic_neutral_sources,
)
from mcrl.stagec_v025.shards import read_source_shard, write_source_shard
from mcrl.stagec_v025.state import (
    ActionEvaluation,
    ForecastObservation,
    PhysicalAction,
    extract_source_rows,
    seal_action_evaluation,
)


LABEL = "PILOT_NOT_CLAIM"
PILOT_SCHEMA = "mcrl-v025-learned-c3-real-physics-pilot-v1"
ROOT = Path(__file__).resolve().parents[1]
ENGINE_PATH = ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
DEFAULT_OUTPUT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
REPORT_PATH = ROOT / "V025-PILOT-C3-REPORT-2026-09-09.md"
TRAIN_WORLDS = DEVELOPMENT_WORLD_DOMAINS[:2]
EVALUATION_WORLDS = DEVELOPMENT_WORLD_DOMAINS[2:4]
LEARNER_DOMAINS = tuple(f"V025_LEARNER/seed/{index}" for index in range(1, 5))
LEARNER_SEEDS = tuple(seed_from_domain(domain) for domain in LEARNER_DOMAINS)
REPORTED_ARMS = (*LEARNED_ARMS, "BASELINE", "S0", "S_UNI")
# --- minimal-pilot scale knobs (engineering only; overridden from main()) ---
# Defaults reproduce the original full-scale pilot exactly.
PILOT_ARMS = tuple(LEARNED_ARMS)
EVAL_ANCHOR_STEPS = 30
EVAL_CARRIER_LIMIT = None
EVAL_EPOCH = LEGACY_EPOCH_BUDGET
ROW_WORLD_GLOB = "world-*"
ROW_ANCHOR_LIMIT = None
EVAL_TAPE_STEPS = 33
PILOT_FORECAST_BOUNDARIES = (0,)
PILOT_AGGREGATE_PAIR_LIMIT = 4_096
PILOT_PRIMITIVE_SOURCE_FALLBACK = True


def _engine() -> ModuleType:
    name = "mcrl_v025_pilot_matrix_engine"
    if name in sys.modules:
        return sys.modules[name]
    spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load engine at {ENGINE_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


ENGINE = _engine()
# Pilot-only compute fallback. The sealed engine remains byte-for-byte intact;
# its forecast helper reads this module constant at call time.
ENGINE.SELECTION_BOUNDARY_INDICES = PILOT_FORECAST_BOUNDARIES


def _sha_files(paths: Iterable[Path]) -> str:
    digest = hashlib.sha256()
    for path in sorted(paths):
        digest.update(path.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


CODE_DIGEST = _sha_files(
    [Path(__file__), *sorted((ROOT / "src/mcrl/stagec_v025").glob("*.py"))]
)
PHYSICS_DIGEST = _sha_files(sorted((ROOT / "src/mcrl/physics_v025").glob("*.py")))
LAUNCH_DIGEST = _sha_files(
    [
        ROOT / "V025-PILOT-TRACK-DECLARATION-2026-09-09.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1-2026-09-08.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1.1-AMENDMENT-2026-09-09.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1.2-AMENDMENT-2026-09-09.md",
    ]
)
ALLOCATION_DIGEST = canonical_sha256(
    {
        "artifact_label": LABEL,
        "training_worlds": TRAIN_WORLDS,
        "evaluation_worlds": EVALUATION_WORLDS,
        "learner_seed_domains": LEARNER_DOMAINS,
        "anchors_per_world_per_carrier": 30,
    }
)


@dataclass(frozen=True)
class PilotCalibration:
    eta_ref: Fraction
    lambda_bits_per_j: Fraction
    kappa_bits_per_user_step: Fraction
    bits_ref: Fraction
    joules_ref: Fraction
    users: int
    source: str = "one-development-anchor-proxy"

    def __post_init__(self) -> None:
        assert_calibration_prices(
            lambda_bits_per_j=self.lambda_bits_per_j,
            eta_ref=self.eta_ref,
            kappa_bits_per_user_step=self.kappa_bits_per_user_step,
        )

    @property
    def digest(self) -> str:
        return canonical_sha256(self.payload())

    def payload(self) -> dict[str, object]:
        def ratio(value: Fraction) -> list[int]:
            return [value.numerator, value.denominator]

        return {
            "schema": f"{PILOT_SCHEMA}-calibration-proxy-v1",
            "artifact_label": LABEL,
            "source": self.source,
            "eta_ref": ratio(self.eta_ref),
            "lambda_bits_per_j": ratio(self.lambda_bits_per_j),
            "kappa_bits_per_user_step": ratio(self.kappa_bits_per_user_step),
            "bits_ref": ratio(self.bits_ref),
            "joules_ref": ratio(self.joules_ref),
            "users": self.users,
        }

            world_id=tape.domain, split="TRAIN", world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}", anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user, setting_id="a-r0", code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST, launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest, calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape), allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]), actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row
    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)
    return {
        "base": base, "incumbent": incumbent, "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action, "current_evaluator": current,
        "coalition_row": coalition_row, "census": census, "skipped_invalid": 0,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=0.0 if primitive is None else primitive["remaining_d2"],
                remaining_visibility_time_s=(
                    0.0 if primitive is None else primitive["remaining_visibility"]
                ),
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent_identity,
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=(
                    identity is not None and identity in previous_beam
                ),
                previous_satellite_active_for_action=(
                    identity is not None and identity[0] in previous_satellite
                ),
                previous_beam_max_rf_over_cap=(
                    0.0 if identity is None else min(1.0, required_ratio)
                ),
                missing_incumbent=missing_incumbent,
                candidate_current_nominal_decoding_margin_db=profile.min_decoding_margin_db,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(
                    projections[0].mean_acm_se_bit_s_hz
                    - profile.mean_acm_se_bit_s_hz
                )
                / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W - profile.required_power_w_max,
                forecasts=tuple(
                    ForecastObservation(
                        valid=row.valid,
                        survival=row.survives,
                        minimum_decoding_margin_db=row.min_decoding_margin_db,
                        mean_acm_spectral_efficiency=row.mean_acm_se_bit_s_hz,
                    )
                    for row in projections
                ),
                c1_label_bits=float(core),
                c1_phi_difference=float(phi),
                c2_label_bits=float(c2.forecast_surplus_bits - c2.persistence_penalty_bits),
                legal=True,
                terminal=step_index == 29,
                outage=not bool(profile.score.served_phy.get(user, False)),
            )
            provenance = canonical_sha256(
                {
                    "artifact_label": LABEL,
                    "world": tape.digest,
                    "step": step_index,
                    "carrier": carrier,
                    "user": user,
                    "configuration": config.configuration_id,
                }
            )
            actions.append(
                seal_action_evaluation(
                    observation,
                    source_provenance_sha256=provenance,
                    forecast_method_sha256=canonical_sha256(
                        {
                            "engine": ENGINE.SCHEMA,
                            "offsets": [1, 2, 3],
                            "boundaries": list(ENGINE.SELECTION_BOUNDARY_INDICES),
                        }
                    ),
                )
            )
            identities.append(identity)
        if base.mapping[user] not in identities or None not in identities:
            raise RuntimeError("source action set lost BASE or the explicit null action")
        envelope = AnchorEnvelope(
            world_id=tape.domain,
            split="TRAIN",
            world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}",
            anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user,
            setting_id="a-r0",
            code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST,
            launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest,
            calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape),
            allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]),
            actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row

    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _catalogue_census = ENGINE._catalogue_with_census(
            tape,
            step_index,
            base,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        current.evaluate_many(catalogue)
        catalogue_count = len(catalogue)
        factors = ENGINE._selection_factor_scores(
            base=base,
            incumbent=incumbent,
            catalog=tuple(
                row for row in catalogue if row.configuration_id not in current._invalid
            ),
            evaluated=current._evaluated,
            calibration=calibration,
            cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        )
        pairwise = [
            row
            for row in catalogue
            if row.changed_users == 2
            and row.configuration_id in factors
        ]
        if not pairwise:
            raise RuntimeError("sealed catalogue produced no trainable joint coalition")
        selected = min(
            pairwise,
            key=lambda row: (
                -float(factors[row.configuration_id]["C1"] + factors[row.configuration_id]["C3"]),
                row.configuration_id,
            ),
        )
        coalition_row = _coalition_row(
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            run_setting=run_setting,
        )
    return {
        "base": base,
        "incumbent": incumbent,
        "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action,
        "current_evaluator": current,
        "coalition_row": coalition_row,
        "census": census,
        "skipped_invalid": skipped_invalid,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
            column = aggressors.get(source)
            gain = 0.0 if column is None else max(
                (
                    float(arrays.cross_base_nominal[0, user, column])
                    for user in victim_columns.get(target, ())
                ),
                default=0.0,
            )
            pair_cache[relation] = gain
        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
    return tuple(result)


def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
    changed = tuple(
        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
    )
    members = tuple(
        CoalitionMember(
            user_id=user,
            reference_action=_physical_action(anchor.mapping[user]),
            selected_action=_physical_action(selected.mapping[user]),
            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
        )
        for user in changed
    )
    affected = sorted(
        {
            identity
            for user in changed
            for identity in (anchor.mapping[user], selected.mapping[user])
            if identity is not None
        }
    )
    before_counts: dict[tuple[int, int], int] = {}
    after_counts: dict[tuple[int, int], int] = {}
    for identity in anchor.mapping.values():
        if identity is not None:
            before_counts[identity] = before_counts.get(identity, 0) + 1
    for identity in selected.mapping.values():
        if identity is not None:
            after_counts[identity] = after_counts.get(identity, 0) + 1
    relations = _cross_gain_terms(tape, step_index, affected)
    beams = tuple(
        AffectedBeamContext(
            beam_key=f"{identity[0]}:{identity[1]}",
            occupancy_before=before_counts.get(identity, 0),
            occupancy_after=after_counts.get(identity, 0),
            active_before=before_counts.get(identity, 0) > 0,
            active_after=after_counts.get(identity, 0) > 0,
            shared_capacity=1.0,
            interference_summary=math.fsum(
                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
            ),
            capacity_margin=float(10 - after_counts.get(identity, 0)),
        )
        for identity in affected
    )
    return CoalitionContext(
        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
        reference_profile=tuple(
            (user, _physical_action(identity)) for user, identity in anchor.assignments
        ),
        members=members,
        affected_beams=beams,
        global_resource_features=(
            len(changed) / max(1, len(anchor.assignments)),
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )


def _coalition_row(
    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
    rows_by_user_action, calibration, run_setting,
):
    context = _coalition_context(
        tape=tape,
        step_index=step_index,
        anchor=anchor,
        selected=selected,
        rows_by_user_action=rows_by_user_action,
    )
    reference = evaluator.evaluate(anchor).outcome(
        phi=ENGINE._phi_for(anchor, anchor)
    )
    unilateral = {}
    for user in context.changed_users:
        mapping = anchor.mapping
        mapping[user] = selected.mapping[user]
        config = ENGINE._configuration(anchor, mapping, kind="pilot-coalition-singleton")
        unilateral[user] = evaluator.evaluate(config).outcome(
            phi=ENGINE._phi_for(anchor, config)
                            "phase": "evaluation",
                            "world": world_offset,
                            "anchor": anchor_index,
                            "anchors_total": 90,
                        }
                    ),
                    flush=True,
                )
    receipt_path = output / "evaluation" / f"{LABEL}-raw-receipts.jsonl"
    receipt_path.parent.mkdir(parents=True, exist_ok=True)
    with receipt_path.open("x", encoding="ascii") as stream:
        for row in records:
            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n")
    digest = hashlib.sha256(receipt_path.read_bytes()).hexdigest()
    receipt_path.with_name(receipt_path.name + ".sha256").write_text(
        f"{digest}  {receipt_path.name}\n", encoding="ascii"
    )
    manifest = {
        "schema": f"{PILOT_SCHEMA}-evaluation-manifest-v1",
        "phase_wall_s": time.perf_counter() - phase_started,
        "phase_core_s": time.process_time() - cpu_started,
        "receipt_rows": len(records),
        "receipt_bytes": receipt_path.stat().st_size,
        "receipt_sha256": digest,
        "latencies": phase_latencies,
    }
    _write_phase_manifest(output / f"{LABEL}-evaluation-manifest.json", manifest)
    return records, manifest


def _quantiles(values):
    if not values:
        return {"min": None, "p05": None, "p50": None, "p95": None, "max": None}
    return {
        name: float(np.quantile(values, q))
        for name, q in (("min", 0.0), ("p05", 0.05), ("p50", 0.5), ("p95", 0.95), ("max", 1.0))
    }


def summarize(records, row_manifest, training_manifest, evaluation_manifest):
    summary = {"anchors": {}, "contrasts": {}, "latency": {}}
    for variant in ("P-a0", "P-u"):
        summary["anchors"][variant] = {}
        subset = [row for row in records if row["catalogue_anchor"] == variant]
        for arm in REPORTED_ARMS:
            rows = [row for row in subset if row["arm"] == arm]
            bits = math.fsum(row["bits"] for row in rows)
            joules = math.fsum(row["joules"] for row in rows)
            summary["anchors"][variant][arm] = {
                "bits": bits,
                "joules": joules,
                "pooled_ee_bits_per_j": None if joules == 0 else bits / joules,
                "availability": math.fsum(row["availability"] for row in rows) / len(rows),
                "handover_rate": math.fsum(row["handover_count"] for row in rows) / math.fsum(row["handover_opportunities"] for row in rows),
                "cap_hit_rate": math.fsum(row["rf_cap_hits"] for row in rows) / max(1, math.fsum(row["rf_transmission_observations"] for row in rows)),
            }
        full = summary["anchors"][variant]["FULL"]
        for comparator in ("DROP_C3", "S0", "S_UNI"):
            other = summary["anchors"][variant][comparator]
            key = f"{variant}:FULL-vs-{comparator}"
            summary["contrasts"][key] = (
                None
                if full["pooled_ee_bits_per_j"] is None or other["pooled_ee_bits_per_j"] is None
                else full["pooled_ee_bits_per_j"] / other["pooled_ee_bits_per_j"] - 1.0
            )
        full_rows = [row for row in subset if row["arm"] == "FULL"]
        anchor_rows = {
            (row["world_id"], row["anchor_index"]): row for row in full_rows
        }
        reversal_rows = [
            row for row in full_rows if row.get("additive_choice_joint_delta", 0.0) < 0.0
        ]
        sizes = sorted(
            {
                int(size)
                for row in anchor_rows.values()
                for size in row.get("u_positive_joint_sizes", [])
            }
            | {int(row["changed_users"]) for row in full_rows}
        )
        summary["anchors"][variant]["diagnostics"] = {
            "positive_joint_escape_fraction_from_u": sum(
                bool(row["u_any_positive_joint_escape"])
                for row in anchor_rows.values()
            ) / len(anchor_rows),
            "selected_psi_distribution": _quantiles([row["psi_anchor_normalized"] for row in full_rows]),
            "g_A_distribution": _quantiles([row["g_A"] for row in full_rows if "g_A" in row]),
            "g_I_distribution": _quantiles([row["g_I"] for row in full_rows if "g_I" in row]),
            "top_choice_agreement": sum(bool(row["top_choice_agreement"]) for row in full_rows) / len(full_rows),
            "harmful_acceptance_rate": sum(row["joint_delta_anchor_normalized"] < 0.0 for row in full_rows) / len(full_rows),
            "c2_tie_frequency": sum(bool(row["c2_tie_break"]) for row in full_rows) / len(full_rows),
            "c2_tie_pair_fraction_mean": (
                math.fsum(row["c2_tie_break"] or 0.0 for row in full_rows) / len(full_rows)
            ),
            "v_ca": {
                field: math.fsum(row[field] for row in full_rows)
                for field in (
                    "v_ca_bits_component", "v_ca_energy_component_bits",
                    "v_ca_phi_component_bits", "v_ca_net_bits",
                )
            },
            "additive_reversal_frequency": len(reversal_rows) / len(full_rows),
            "additive_reversals_prevented_fraction": (
                None if not reversal_rows else sum(
                    row["joint_delta_anchor_normalized"] >= 0.0
                    for row in reversal_rows
                ) / len(reversal_rows)
            ),
            "escape_and_harm_by_coalition_size": {
                str(size): {
                    "escape_opportunities": sum(
                        size in row.get("u_positive_joint_sizes", [])
                        for row in anchor_rows.values()
                    ),
                    "selected": sum(row["changed_users"] == size for row in full_rows),
                    "harmful": sum(
                        row["changed_users"] == size
                        and row["joint_delta_anchor_normalized"] < 0.0
                        for row in full_rows
                    ),
                }
                for size in sizes
            },
        }
    latencies = evaluation_manifest["latencies"]
    for field in (
        "feature_construction_s", "catalogue_a0_s", "catalogue_u_extra_s", "s_uni_s", "total_s", "physics_boundary_evaluations"
    ):
        summary["latency"][field] = _quantiles([float(row[field]) for row in latencies])
    summary["resources"] = {
        "rows_wall_s": row_manifest["phase_wall_s"],
        "rows_core_s": row_manifest["phase_core_s"],
        "training_wall_s": training_manifest["phase_wall_s"],
        "training_core_s": training_manifest["phase_core_s"],
        "evaluation_wall_s": evaluation_manifest["phase_wall_s"],
        "evaluation_core_s": evaluation_manifest["phase_core_s"],
    }
    return summary


def _scope_paragraph() -> str:
    return (
        f"**Scope of this run.** Evaluation worlds {list(EVALUATION_WORLDS)}; "
        f"{EVAL_ANCHOR_STEPS} anchor steps x "
        f"{'nearest-eligible carrier only' if EVAL_CARRIER_LIMIT == 1 else str(EVAL_CARRIER_LIMIT) + ' carriers'}; "
        f"learner seeds {list(LEARNER_DOMAINS)} ({len(LEARNER_SEEDS)}); "
        f"learned arms {list(PILOT_ARMS)} plus BASELINE, S0, S_UNI; "
        f"checkpoint epoch {EVAL_EPOCH} (NOT the sealed {LEGACY_EPOCH_BUDGET}); "
        f"training rows restricted to `rows/{ROW_WORLD_GLOB}` "
        f"(first {ROW_ANCHOR_LIMIT} anchor shards)."
        if EVAL_ANCHOR_STEPS < 30 else
        "**Scope of this run.** Full pilot scale."
    )


def write_report(summary, row_manifest, training_manifest, evaluation_manifest):
    lines = [
        "# V0.25 pilot C3 report — 2026-09-09",
        "",
        f"**{LABEL}. Every artefact and every numerical value in this report is {LABEL}.**",
        "",
        "This is quarantined engineering evidence only. No scientific conclusion, configuration selection, or claim is made.",
        "",
        _scope_paragraph(),
        "",
        "## Rows",
        "",
        "| World | Anchors | Q1/Q2 rows | C3 rows | Bytes |",
        "|---|---:|---:|---:|---:|",
    ]
    for row in row_manifest["worlds"]:
        lines.append(
            f"| {row['world_id']} | {row['anchors']} | {row['source_rows']} | {row['coalition_rows']} | {row['source_bytes'] + row['coalition_bytes']} |"
        )
    lines.extend([
        "",
        "The pilot calibration proxy and every row carry explicit lambda, eta, and kappa exact ratios/hex values. The formal calibration was absent from the launch copy; see DEFECTS.",
        "",
        "## Training",
        "",
        f"Learned arm-seed lineages ran with concurrency {training_manifest['concurrency']}; external BASELINE seed records were emitted separately. Neutral batches were hoisted once per worker. Each learned lineage completed {LEGACY_EPOCH_BUDGET} source epochs with a checkpoint every 100 epochs; **this report evaluates the epoch-{EVAL_EPOCH} checkpoint**.",
        "",
        "## Realised pooled results",
        "",
    ])
    for variant in ("P-a0", "P-u"):
        lines.extend([
            f"### {variant}",
            "",
            "| Arm | Sum B | Sum E | Pooled EE | Availability | Handover rate | Cap-hit rate |",
            "|---|---:|---:|---:|---:|---:|---:|",
        ])
        for arm, row in summary["anchors"][variant].items():
            if arm == "diagnostics":
                continue
            lines.append(
                f"| {arm} | {row['bits']:.9g} | {row['joules']:.9g} | {row['pooled_ee_bits_per_j']:.9g} | {row['availability']:.9g} | {row['handover_rate']:.9g} | {row['cap_hit_rate']:.9g} |"
            )
        lines.append("")
        for comparator in ("DROP_C3", "S0", "S_UNI"):
            value = summary["contrasts"][f"{variant}:FULL-vs-{comparator}"]
            lines.append(f"- FULL vs {comparator}: relative pooled-EE difference = {value:.9g}.")
        diagnostics = summary["anchors"][variant]["diagnostics"]
        lines.extend([
            f"- Strictly improving selected joint escape from the catalogue anchor: {diagnostics['positive_joint_escape_fraction_from_u']:.9g}.",
            f"- Selected Psi distribution (min/p05/p50/p95/max): {diagnostics['selected_psi_distribution']}.",
            f"- Matched-anchor g_A distribution: {diagnostics['g_A_distribution']}.",
            f"- Matched-anchor g_I distribution: {diagnostics['g_I_distribution']}.",
            f"- Learned/exact top-choice agreement: {diagnostics['top_choice_agreement']:.9g}.",
            f"- Harmful-acceptance rate: {diagnostics['harmful_acceptance_rate']:.9g}.",
            f"- C2 tie-break frequency: {diagnostics['c2_tie_frequency']:.9g}.",
            f"- V_CA (unclipped realised bits, -eta*energy, Phi, net bit-equivalent components): {diagnostics['v_ca']}.",
            f"- Additive-reversal frequency: {diagnostics['additive_reversal_frequency']:.9g}; prevented fraction: {diagnostics['additive_reversals_prevented_fraction']}.",
            f"- Escape/harm counts by selected coalition size: {diagnostics['escape_and_harm_by_coalition_size']}.",
            "",
        ])
    lines.extend([
        "## Catalogue-anchor comparison and latency",
        "",
        f"P-u extra catalogue wall-time distribution: {summary['latency']['catalogue_u_extra_s']}.",
        f"Full decision total wall-time distribution: {summary['latency']['total_s']}.",
        f"Feature-construction wall-time distribution: {summary['latency']['feature_construction_s']}.",
        f"Catalogue-generation wall-time distribution: {summary['latency']['catalogue_a0_s']}.",
        f"Physics-call distribution: {summary['latency']['physics_boundary_evaluations']}.",
        "Timeout frequency is the mean of the raw `s_uni_deadline_missed` field; all timeout outcomes include the executed fallback.",
        "",
        "The C2 tie-break diagnostic is the fraction of non-incumbent (user, action) candidates whose C2 head score is exactly equal to the incumbent's under the FULL arm, i.e. C2 cannot discriminate the move and the ranking falls through to C1 plus the stable configuration-ID tie-break. `c2_tie_frequency` is the fraction of anchor-seed decisions with any such tie; `c2_tie_pair_fraction_mean` is the mean per-decision tie fraction. See DEFECTS.",
        "",
        "## Four experiments (kept separate)",
        "",
        "1. Learned neutral-source experiment: run here (FULL, DROP_C1, DROP_C2, DROP_C3, ALL_NEUTRAL_CONTROL, BASELINE).",
        "2. Oracle factor-score removal: not run; stage-4 physics receipts remain separate.",
        "3. Checkpoint knockout: not run in this pilot.",
        "4. Architecture removal: named only and not run, as required.",
        "",
        "## Resource use",
        "",
        "| Phase | Wall hours | Core hours |",
        "|---|---:|---:|",
    ])
    for phase in ("rows", "training", "evaluation"):
        lines.append(
            f"| {phase} | {summary['resources'][phase + '_wall_s'] / 3600:.6g} | {summary['resources'][phase + '_core_s'] / 3600:.6g} |"
        )
    lines.extend([
        "",
        "## DEFECTS",
        "",
        "- The launcher copy was not a usable Git repository (`.git` was empty), so no baseline diff or commit could be made.",
        "- Stage-C build 3 imported `coalition_identity`, absent from the stage-4d target snapshot. A compatibility implementation restored both exact B4 identities and accepts uncapped selected coalitions.",
        "- The fixed provider imported `ProviderAttestation`, absent from the stage-4d tape snapshot, and lacked the older `protocol_outputs` method. A data-only attestation seam and adapter were added; physical calculations are unchanged.",
        "- Stage-C build 3 predated amendment v1.2: it capped interaction labels at four and omitted a pairwise cross-gain relation block. The pilot changed labels to uncapped, retained the <=4 Shapley cap for reporting only, and added pooled physical-ID/cross-gain relations.",
        "- No signed formal calibration manifest was present because stage 4d stopped on HOLD. The pilot uses an explicitly labelled one-development-anchor proxy solely to complete wiring; every row carries its exact values.",
        "- The engine does not expose candidate off-axis angle at the Stage-C adapter seam. The smallest schema-complete pilot fills that Q1 field with 0 and records this defect; this is not admissible evidence.",
        "- Power-invalid shortlisted actions have no engine outcome object. They are counted and omitted from rows; BASE and explicit NULL are required to remain.",
        "- The old T1 acceptance assertion expected the superseded four-user label cap. T1/T2 logic otherwise ran; the full T3 Monte Carlo gate was stopped after ten wall minutes to protect the pilot compute budget.",
        "- Build 3 has no explicit C2 tie-break implementation. Stable total score then configuration ID is used. The C2 tie statistic reported here was implemented by this pilot as the smallest schema-satisfying measurement (exact C2-score equality against the incumbent); it measures head indiscriminability, not a build-3 tie-break code path.",
        "- V_CA and coalition-size anti-pattern strata were not first-class build-3 receipt fields. The pilot records V_CA as the realised FULL-minus-additive-selector F difference, with bits, -eta*energy and Phi components unclipped, and emits explicit size strata.",
        "- To remain inside the six-core-hour ceiling after timing the real provider, Q2 forecasts use boundary 0 at each of the three sealed offsets rather than all five coarse boundaries, and training uses a deterministic 4096-pair aggregate while preserving all raw rows. This is a schema-complete pilot fallback, not sealed evidence.",
        "- Exact full-network C1/C2 evaluation for every shortlisted source action exceeded the compute ceiling. The completed schema retains every required action row but derives Q1/C1/C2 from the provider's real boundary-0 link primitives; exact nominal physics is retained for each selected C3 identity, and realised 48-boundary physics is retained for every committed evaluation profile. These approximate source labels are PILOT_NOT_CLAIM.",
        "- Exact S0 over 48 boundaries for every catalogue profile was unbounded in the joined engine. The pilot ranks S0's top-two proposals with provider-primitive C1+C2, applies the same bounded evacuation rule, evaluates that set with exact nominal boundary-0 physics, then evaluates the committed S0 profile over all 48 realised boundaries.",
        "- Exhaustive exact interaction decomposition over every catalogue row was also unbounded. Exact Psi is computed for every P-u joint escape candidate and every selected FULL coalition; other rows retain learned scoring only. P-u top-10 users are primitive-ranked by |d_i^u|. The pilot S_UNI wall budget was reduced to 5 seconds, with the engine's fallback and termination certificate retained verbatim.",
        "",
        f"Raw evaluation rows: {evaluation_manifest['receipt_rows']}; bytes: {evaluation_manifest['receipt_bytes']}; SHA-256: `{evaluation_manifest['receipt_sha256']}`.",
        "",
    ])
    REPORT_PATH.write_text("\n".join(lines), encoding="utf-8")
    digest = hashlib.sha256(REPORT_PATH.read_bytes()).hexdigest()
    REPORT_PATH.with_name(REPORT_PATH.name + ".sha256").write_text(
        f"{digest}  {REPORT_PATH.name}\n", encoding="ascii"
    )
    return digest


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument(
        "--resume-evaluation", action="store_true",
        help="resume from immutable completed row/training artifacts",
    )
    parser.add_argument("--min-pilot", action="store_true",
                        help="minimal PILOT_NOT_CLAIM scale: world 3, 5 anchors, "
                             "nearest carrier, 2 seeds, FULL/DROP_C3/BASELINE, epoch 200")
    args = parser.parse_args(argv)
    if args.min_pilot:
        global EVALUATION_WORLDS, LEARNER_DOMAINS, LEARNER_SEEDS, REPORTED_ARMS
        global PILOT_ARMS, EVAL_ANCHOR_STEPS, EVAL_CARRIER_LIMIT, EVAL_EPOCH
        global ROW_WORLD_GLOB, ROW_ANCHOR_LIMIT, REPORT_PATH
        EVALUATION_WORLDS = DEVELOPMENT_WORLD_DOMAINS[2:3]
        LEARNER_DOMAINS = LEARNER_DOMAINS[:2]
        LEARNER_SEEDS = LEARNER_SEEDS[:2]
        PILOT_ARMS = ("FULL", "DROP_C3")
        REPORTED_ARMS = (*PILOT_ARMS, "BASELINE", "S0", "S_UNI")
        EVAL_ANCHOR_STEPS = 5
        EVAL_CARRIER_LIMIT = 1
        EVAL_EPOCH = 200
        ROW_WORLD_GLOB = "world-1"
        ROW_ANCHOR_LIMIT = 5
        global EVAL_TAPE_STEPS
        EVAL_TAPE_STEPS = EVAL_ANCHOR_STEPS + 3
        REPORT_PATH = ROOT / "V025-PILOT-MIN-REPORT-2026-09-09.md"
    if args.output.exists() and not args.resume_evaluation:
        raise SystemExit(f"refusing to overwrite pilot output: {args.output}")
    if args.resume_evaluation and not args.output.exists():
        raise SystemExit(f"resume output does not exist: {args.output}")
    args.output.mkdir(parents=True, exist_ok=args.resume_evaluation)
    total_started = time.perf_counter()
    if args.resume_evaluation:
        row_manifest, training_manifest, calibration, models, batches = (
            _load_completed_training(args.output)
        )
    else:
        rows, coalitions, calibration, row_manifest = generate_rows(args.output)
        models, training_manifest, batches = train(args.output, rows, coalitions)
    records, evaluation_manifest = evaluate(
        args.output, calibration, models, batches
    )
    summary = summarize(records, row_manifest, training_manifest, evaluation_manifest)
    _write_phase_manifest(
        args.output / f"{LABEL}-summary.json",
        {
            "schema": f"{PILOT_SCHEMA}-summary-v1",
            "total_wall_s": time.perf_counter() - total_started,
            "summary": summary,
        },
    )
    report_digest = write_report(
        summary, row_manifest, training_manifest, evaluation_manifest
    )
    print(
        json.dumps(
            {
                "artifact_label": LABEL,
                "status": "COMPLETE",
                "output": str(args.output),

