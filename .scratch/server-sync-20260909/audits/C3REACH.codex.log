+#!/usr/bin/env python3
+"""DIAGNOSTIC_NOT_CLAIM: measure C3 catalogue-argmax reachability."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import statistics
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+
+ROOT = Path(__file__).resolve().parents[2]
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+PILOT_OUTPUT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+DEFAULT_RESULTS = ROOT / ".scratch/c3-reach/results.json"
+DEFAULT_REPORT = ROOT / "C3-ARGMAX-REACHABILITY-2026-09-10.md"
+THREAD_ENV = (
+    "OMP_NUM_THREADS",
+    "OPENBLAS_NUM_THREADS",
+    "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS",
+    "VECLIB_MAXIMUM_THREADS",
+    "BLIS_NUM_THREADS",
+)
+DEMAND_RATE_BPS = 50_000_000.0
+DECISION_INTERVAL_S = 47 * 0.640
+DEMAND_CAP_BITS = DEMAND_RATE_BPS * DECISION_INTERVAL_S
+MODEL_EPOCH = 2_000
+MODEL_BATCH_ANCHORS_FOR_RESTORE = 5
+LABEL = "DIAGNOSTIC_NOT_CLAIM"
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def quantiles(values: Iterable[float]) -> dict[str, float | None]:
+    ordered = sorted(float(value) for value in values)
+    if not ordered:
+        return {key: None for key in ("min", "p05", "p50", "p95", "max")}
+
+    def linear(q: float) -> float:
+        position = q * (len(ordered) - 1)
+        low = int(math.floor(position))
+        high = int(math.ceil(position))
+        if low == high:
+            return ordered[low]
+        return ordered[low] + (ordered[high] - ordered[low]) * (position - low)
+
+    return {
+        "min": ordered[0],
+        "p05": linear(0.05),
+        "p50": linear(0.50),
+        "p95": linear(0.95),
+        "max": ordered[-1],
+    }
+
+
+def fmt(value: float | None, digits: int = 6) -> str:
+    return "NA" if value is None else f"{value:.{digits}g}"
+
+
+def within_one_ulp(first: float, second: float) -> bool:
+    return abs(first - second) <= max(math.ulp(first), math.ulp(second))
+
+
+def rank(scores: Mapping[str, float]) -> list[tuple[str, float]]:
+    return sorted(scores.items(), key=lambda row: (-row[1], row[0]))
+
+
+def spread(scores: Mapping[str, float]) -> dict[str, object]:
+    ordered = rank(scores)
+    top_id, top = ordered[0]
+    second_id, second = ordered[1]
+    bottom = ordered[-1][1]
+    gap = top - second
+    return {
+        "argmax_configuration_id": top_id,
+        "top_score": top,
+        "top_score_hex": top.hex(),
+        "second_configuration_id": second_id,
+        "second_score": second,
+        "second_score_hex": second.hex(),
+        "max_minus_second_max": gap,
+        "max_minus_second_max_hex": gap.hex(),
+        "full_range": top - bottom,
+        "full_range_hex": (top - bottom).hex(),
+        "top_two_exactly_equal": top == second,
+        "top_two_within_one_ulp": within_one_ulp(top, second),
+    }
+
+
+def choice_change(
+    additive_scores: Mapping[str, float],
+    with_scores: Mapping[str, float],
+) -> dict[str, object]:
+    without = rank(additive_scores)[0][0]
+    with_term = rank(with_scores)[0][0]
+    changed = without != with_term
+    with_margin = with_scores[with_term] - with_scores[without]
+    without_margin = additive_scores[without] - additive_scores[with_term]
+    with_tie = changed and with_scores[with_term] == with_scores[without]
+    without_tie = changed and additive_scores[without] == additive_scores[with_term]
+    return {
+        "changed": changed,
+        "without_configuration_id": without,
+        "with_configuration_id": with_term,
+        "with_winner_margin_over_without_choice": with_margin,
+        "without_winner_margin_over_with_choice": without_margin,
+        "final_ranking_tie_break_flip": bool(with_tie),
+        "involves_any_exact_tie": bool(with_tie or without_tie),
+        "involves_any_within_one_ulp": bool(
+            changed
+            and (
+                within_one_ulp(with_scores[with_term], with_scores[without])
+                or within_one_ulp(additive_scores[without], additive_scores[with_term])
+            )
+        ),
+    }
+
+
+def score_terms(terms: Mapping[str, float]) -> dict[str, object]:
+    result = spread(terms)
+    result["min"] = min(terms.values())
+    result["max"] = max(terms.values())
+    return result
+
+
+def profile_receipt(profile) -> dict[str, float]:
+    capped = math.fsum(min(float(value), DEMAND_CAP_BITS) for value in profile.score.bits.values())
+    joules = float(profile.joules)
+    return {
+        "reported_capped_bits": capped,
+        "uncapped_bits_diagnostic_only": float(profile.bits),
+        "joules": joules,
+        "reported_ee_bits_per_j": capped / joules,
+    }
+
+
+def pooled_ee(events: Sequence[Mapping[str, object]], side: str) -> dict[str, object]:
+    profiles = [event[side] for event in events]
+    bits = math.fsum(float(row["reported_capped_bits"]) for row in profiles)
+    joules = math.fsum(float(row["joules"]) for row in profiles)
+    return {
+        "event_count": len(profiles),
+        "reported_capped_bits": bits,
+        "joules": joules,
+        "pooled_reported_ee_bits_per_j": None if not profiles else bits / joules,
+    }
+
+
+def load_pilot():
+    source = str(ROOT / "src")
+    scripts = str(ROOT / "scripts")
+    if source not in sys.path:
+        sys.path.insert(0, source)
+    if scripts not in sys.path:
+        sys.path.insert(0, scripts)
+    import run_v025_pilot_c3 as pilot
+
+    pilot.LEARNER_SEEDS = tuple(pilot.LEARNER_SEEDS)
+    pilot.PILOT_ARMS = ("FULL",)
+    pilot.EVAL_EPOCH = MODEL_EPOCH
+    pilot.ROW_WORLD_GLOB = "world-1"
+    pilot.ROW_ANCHOR_LIMIT = MODEL_BATCH_ANCHORS_FOR_RESTORE
+    _rows, _training, calibration, payloads, batches = pilot._load_completed_training(
+        PILOT_OUTPUT
+    )
+    models = pilot._restore_models(payloads, batches)
+    return pilot, calibration, models
+
+
+def verify_runtime() -> None:
+    actual = Path(sys.executable).resolve()
+    if actual != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {actual}; expected {EXPECTED_PYTHON}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment is not pinned to one: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("process niceness is below required nice -n 15")
+
+
+def model_provenance(pilot) -> list[dict[str, object]]:
+    rows = []
+    for seed in pilot.LEARNER_SEEDS:
+        path = PILOT_OUTPUT / "checkpoints" / (
+            f"PILOT_NOT_CLAIM-seed-{seed}-FULL-epoch-{MODEL_EPOCH:04d}.json"
+        )
+        sidecar = Path(str(path) + ".sha256")
+        digest = sha256(path)
+        declared = sidecar.read_text(encoding="ascii").split()[0]
+        if digest != declared:
+            raise RuntimeError(f"checkpoint sidecar mismatch: {path}")
+        payload = json.loads(path.read_text(encoding="ascii"))
+        if payload["learner_seed"] != seed or payload["arm"] != "FULL":
+            raise RuntimeError(f"checkpoint identity mismatch: {path}")
+        if payload["completed_source_epochs"] != MODEL_EPOCH:
+            raise RuntimeError(f"checkpoint epoch mismatch: {path}")
+        rows.append({"learner_seed": seed, "path": str(path.relative_to(ROOT)), "sha256": digest})
+    return rows
+
+
+def measure_anchor(pilot, calibration, models, tape, anchor_index: int, step_index: int, carrier: str):
+    started = time.perf_counter()
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    built = pilot._build_anchor_rows(
+        tape=tape,
+        setting=setting,
+        run_setting=run_setting,
+        calibration=calibration,
+        step_index=step_index,
+        carrier=carrier,
+        anchor_index=anchor_index,
+        include_coalition=False,
+        full_legal_actions=True,
+    )
+    anchor = built["base"]
+    incumbent = built["incumbent"]
+    rows_by_user_action = built["rows_by_user_action"]
+    selection_evaluator = built["current_evaluator"]
+    catalogue_started = time.perf_counter()
+    catalogue, catalogue_census = pilot.ENGINE._catalogue_with_census(
+        tape,
+        step_index,
+        anchor,
+        setting=setting,
+        calibration=calibration,
+        run_setting=run_setting,
+    )
+    raw_catalogue_size = len(catalogue)
+    exact = pilot._exact_interactions(
+        anchor, incumbent, catalogue, selection_evaluator, calibration
+    )
+    legal_catalogue = tuple(row for row in catalogue if row.configuration_id in exact)
+    contexts = {
+        config.configuration_id: pilot._coalition_context(
+            tape=tape,
+            step_index=step_index,
+            anchor=anchor,
+            selected=config,
+            rows_by_user_action=rows_by_user_action,
+        )
+        for config in legal_catalogue
+        if len(exact[config.configuration_id]["changed"]) >= 2
+    }
+    by_id = {row.configuration_id: row for row in legal_catalogue}
+    exact_terms = {row.configuration_id: float(exact[row.configuration_id]["psi"]) for row in legal_catalogue}
+    seed_rows = []
+    configs_for_commit = {}
+    for seed in pilot.LEARNER_SEEDS:
+        model = models[(seed, "FULL")]
+        deltas = {}
+        for (user, action), source_row in rows_by_user_action.items():
+            reference = rows_by_user_action[(user, anchor.mapping[user])]
+            deltas[(user, action)] = (
+                model.q1.score(source_row.q1_state) - model.q1.score(reference.q1_state)
+                + model.q2.score(source_row.q2_state) - model.q2.score(reference.q2_state)
+            )
+        additive = {
+            config.configuration_id: math.fsum(
+                deltas[(user, config.mapping[user])] for user in anchor.mapping
+            )
+            for config in legal_catalogue
+        }
+        learned_terms = {
+            config.configuration_id: (
+                0.0
+                if config.configuration_id not in contexts
+                else float(model.interaction(contexts[config.configuration_id]))
+            )
+            for config in legal_catalogue
+        }
+        learned_scores = {
+            key: additive[key] + learned_terms[key] for key in additive
+        }
+        exact_scores = {key: additive[key] + exact_terms[key] for key in additive}
+        learned_change = choice_change(additive, learned_scores)
+        exact_change = choice_change(additive, exact_scores)
+        for change in (learned_change, exact_change):
+            if change["changed"]:
+                configs_for_commit[change["without_configuration_id"]] = by_id[
+                    change["without_configuration_id"]
+                ]
+                configs_for_commit[change["with_configuration_id"]] = by_id[
+                    change["with_configuration_id"]
+                ]
+        seed_rows.append(
+            {
+                "learner_seed": seed,
+                "additive": spread(additive),
+                "learned_interaction": score_terms(learned_terms),
+                "learned_with_interaction": spread(learned_scores),
+                "learned_change": learned_change,
+                "exact_interaction": score_terms(exact_terms),
+                "exact_with_interaction": spread(exact_scores),
+                "exact_change": exact_change,
+            }
+        )
+
+    commit_profiles = {}
+    if configs_for_commit:
+        realised = pilot.ENGINE.StepEvaluator(
+            tape,
+            setting,
+            step_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+            field="realised",
+            run_setting=run_setting,
+        )
+        realised.evaluate_many(tuple(configs_for_commit.values()))
+        for config_id, config in configs_for_commit.items():
+            commit_profiles[config_id] = profile_receipt(realised.evaluate(config))
+    for seed_row in seed_rows:
+        for mechanism in ("learned", "exact"):
+            change = seed_row[f"{mechanism}_change"]
+            if change["changed"]:
+                without = commit_profiles[change["without_configuration_id"]]
+                with_term = commit_profiles[change["with_configuration_id"]]
+                change["committed_ee"] = {"without": without, "with": with_term}
+                change["reported_ee_moved"] = (
+                    without["reported_capped_bits"] != with_term["reported_capped_bits"]
+                    or without["joules"] != with_term["joules"]
+                )
+
+    context_none = len(legal_catalogue) - len(contexts)
+    return {
+        "anchor_index": anchor_index,
+        "anchor_id": f"{tape.domain}|{step_index}|{carrier}",
+        "world_id": tape.domain,
+        "world_seed": tape.seed,
+        "step_index": step_index,
+        "carrier": carrier,
+        "anchor_configuration_id": anchor.configuration_id,
+        "raw_catalogue_size": raw_catalogue_size,
+        "legal_catalogue_size": len(legal_catalogue),
+        "invalid_catalogue_rows": raw_catalogue_size - len(legal_catalogue),
+        "catalogue_census": catalogue_census,
+        "context_none_rows": context_none,
+        "context_none_fraction": context_none / len(legal_catalogue),
+        "context_present_rows": len(contexts),
+        "exact_interaction_shared_across_seeds": score_terms(exact_terms),
+        "seeds": seed_rows,
+        "timing_s": {
+            "catalogue_and_exact": time.perf_counter() - catalogue_started,
+            "total": time.perf_counter() - started,
+        },
+    }
+
+
+def change_events(anchors: Sequence[Mapping[str, object]], mechanism: str) -> list[dict[str, object]]:
+    events = []
+    for anchor in anchors:
+        for seed_row in anchor["seeds"]:
+            change = seed_row[f"{mechanism}_change"]
+            if change["changed"]:
+                events.append(
+                    {
+                        "anchor_index": anchor["anchor_index"],
+                        "anchor_id": anchor["anchor_id"],
+                        "learner_seed": seed_row["learner_seed"],
+                        "without_configuration_id": change["without_configuration_id"],
+                        "with_configuration_id": change["with_configuration_id"],
+                        "final_ranking_tie_break_flip": change["final_ranking_tie_break_flip"],
+                        "involves_any_exact_tie": change["involves_any_exact_tie"],
+                        "involves_any_within_one_ulp": change["involves_any_within_one_ulp"],
+                        "reported_ee_moved": change["reported_ee_moved"],
+                        "without": change["committed_ee"]["without"],
+                        "with": change["committed_ee"]["with"],
+                    }
+                )
+    return events
+
+
+def summarize(anchors: Sequence[Mapping[str, object]], seed_count: int) -> dict[str, object]:
+    total_decisions = len(anchors) * seed_count
+    pooled_rows = sum(int(anchor["legal_catalogue_size"]) for anchor in anchors)
+    pooled_none = sum(int(anchor["context_none_rows"]) for anchor in anchors)
+    summary: dict[str, object] = {
+        "anchor_count": len(anchors),
+        "learner_seed_count": seed_count,
+        "anchor_seed_decision_count": total_decisions,
+        "catalogue_size_distribution": quantiles(anchor["legal_catalogue_size"] for anchor in anchors),
+        "catalogue_size_frequency": dict(sorted(Counter(int(anchor["legal_catalogue_size"]) for anchor in anchors).items())),
+        "singleton_catalogue_anchor_count": sum(int(anchor["legal_catalogue_size"]) == 1 for anchor in anchors),
+        "context_none_fraction_by_anchor_distribution": quantiles(anchor["context_none_fraction"] for anchor in anchors),
+        "context_none_pooled_rows": pooled_none,
+        "catalogue_pooled_rows": pooled_rows,
+        "context_none_pooled_fraction": pooled_none / pooled_rows,
+    }
+    for mechanism in ("learned", "exact"):
+        events = change_events(anchors, mechanism)
+        anchors_changed = {
+            int(event["anchor_index"]) for event in events
+        }
+        summary[f"{mechanism}_interaction"] = {
+            "anchors_with_any_argmax_change": len(anchors_changed),
+            "anchor_fraction": len(anchors_changed) / len(anchors),
+            "anchor_seed_argmax_changes": len(events),
+            "anchor_seed_fraction": len(events) / total_decisions,
+            "final_ranking_tie_break_flips": sum(bool(event["final_ranking_tie_break_flip"]) for event in events),
+            "changes_involving_any_exact_tie": sum(bool(event["involves_any_exact_tie"]) for event in events),
+            "changes_involving_any_within_one_ulp": sum(bool(event["involves_any_within_one_ulp"]) for event in events),
+            "changes_moving_reported_ee": sum(bool(event["reported_ee_moved"]) for event in events),
+            "without_interaction_pooled": pooled_ee(events, "without"),
+            "with_interaction_pooled": pooled_ee(events, "with"),
+            "change_events": events,
+        }
+    summary["top_two_within_one_ulp"] = {
+        "additive": sum(bool(seed["additive"]["top_two_within_one_ulp"]) for anchor in anchors for seed in anchor["seeds"]),
+        "learned_with_interaction": sum(bool(seed["learned_with_interaction"]["top_two_within_one_ulp"]) for anchor in anchors for seed in anchor["seeds"]),
+        "exact_with_interaction": sum(bool(seed["exact_with_interaction"]["top_two_within_one_ulp"]) for anchor in anchors for seed in anchor["seeds"]),
+        "denominator_anchor_seed_decisions": total_decisions,
+    }
+    summary["spread_distributions_over_anchor_seed_decisions"] = {
+        "additive_max_minus_second_max": quantiles(seed["additive"]["max_minus_second_max"] for anchor in anchors for seed in anchor["seeds"]),
+        "additive_full_range": quantiles(seed["additive"]["full_range"] for anchor in anchors for seed in anchor["seeds"]),
+        "learned_interaction_full_range": quantiles(seed["learned_interaction"]["full_range"] for anchor in anchors for seed in anchor["seeds"]),
+        "exact_interaction_full_range": quantiles(seed["exact_interaction"]["full_range"] for anchor in anchors for seed in anchor["seeds"]),
+    }
+    return summary
+
+
+def range_over_seeds(anchor: Mapping[str, object], path: tuple[str, str]) -> str:
+    values = [float(seed[path[0]][path[1]]) for seed in anchor["seeds"]]
+    return fmt(values[0]) if min(values) == max(values) else f"{fmt(min(values))}–{fmt(max(values))}"
+
+
+def render_report(results: Mapping[str, object]) -> str:
+    summary = results["summary"]
+    anchors = results["anchors"]
+    learned = summary["learned_interaction"]
+    exact = summary["exact_interaction"]
+    n = summary["anchor_count"]
+    decision_n = summary["anchor_seed_decision_count"]
+    lines = [
+        f"**Exact Ψ changed the catalogue argmax at {exact['anchors_with_any_argmax_change']}/{n} anchors ({exact['anchor_fraction']:.1%}); learned Ψ changed it at {learned['anchors_with_any_argmax_change']}/{n} anchors ({learned['anchor_fraction']:.1%}).**",
+        "",
+        "# C3 argmax reachability — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM`. Read-only measurement on the workspace copy; no sealed artefact or setting was changed.",
+        "",
+        "## Verified by running code",
+        "",
+        f"Measured **{n} real anchors** from `{results['scope']['world_id']}` in pilot evaluation order (step, then the three sealed reference carriers), with {summary['learner_seed_count']} final epoch-2000 FULL lineages: **{decision_n} matched anchor-seed decisions**. The selector inputs and catalogue are the pilot's deployed `_build_anchor_rows(..., full_legal_actions=True)` and `_catalogue_with_census` paths. Exact Ψ is from `_exact_interactions` on every legal row; learned Ψ is `model.interaction(context)` with the production `contexts.get(configuration_id)` gate. Every comparison removes only the interaction term from the same FULL model's scores and applies score-descending / lexicographic-configuration-ID argmax.",
+        "",
+        "### Catalogue size and context coverage",
+        "",
+        f"Legal catalogue size distribution (min/p05/p50/p95/max): `{summary['catalogue_size_distribution']}`. No catalogue had one row ({summary['singleton_catalogue_anchor_count']}/{n}). Exact frequency map: `{summary['catalogue_size_frequency']}`.",
+        "",
+        f"`contexts.get(...) is None` for **{summary['context_none_pooled_rows']}/{summary['catalogue_pooled_rows']} pooled legal rows ({summary['context_none_pooled_fraction']:.3%})**. Per-anchor fraction distribution: `{summary['context_none_fraction_by_anchor_distribution']}`.",
+        "",
+        "| Anchor | Step | Carrier | Legal rows | Context None | Additive max−2nd (4 seeds) | Additive range (4 seeds) | Learned Ψ range (4 seeds) | Exact Ψ range | Learned flips | Exact flips |",
+        "|---:|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+    ]
+    for anchor in anchors:
+        learned_flips = sum(bool(seed["learned_change"]["changed"]) for seed in anchor["seeds"])
+        exact_flips = sum(bool(seed["exact_change"]["changed"]) for seed in anchor["seeds"])
+        lines.append(
+            f"| {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | {anchor['legal_catalogue_size']} | {anchor['context_none_fraction']:.3%} | {range_over_seeds(anchor, ('additive', 'max_minus_second_max'))} | {range_over_seeds(anchor, ('additive', 'full_range'))} | {range_over_seeds(anchor, ('learned_interaction', 'full_range'))} | {fmt(anchor['exact_interaction_shared_across_seeds']['full_range'])} | {learned_flips}/4 | {exact_flips}/4 |"
+        )
+    lines.extend([
