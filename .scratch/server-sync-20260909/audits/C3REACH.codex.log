#!/usr/bin/env python3
"""Quarantined end-to-end V0.25 learned-C3 pilot (PILOT_NOT_CLAIM).

This adapter joins the independently delivered stage-4d/4f real-physics
engine, fixed legacy provider, and Stage-C build-3 learner.  It deliberately
uses only V025_PROBE/world/{1..4}; no claim-panel namespace is accepted.
"""

from __future__ import annotations

import argparse
from concurrent.futures import ProcessPoolExecutor, as_completed
from dataclasses import dataclass
import datetime as dt
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import multiprocessing as mp
import os
from pathlib import Path
import resource
import sys
import time
from types import ModuleType
from typing import Iterable, Mapping, Sequence

import numpy as np

from mcrl.physics_v025.calibration import assert_calibration_prices
from mcrl.physics_v025.constants_v025 import BEAM_RF_CAP_W, DECISION_INTERVAL_S
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape, digest_payload, seed_from_domain
from mcrl.physics_v025.targets import c2_persistence_forecast, matched_anchor_decomposition
from mcrl.stagec_v025.canonical import canonical_sha256, write_once_json
from mcrl.stagec_v025.coalitions import (
    AffectedBeamContext,
    CoalitionContext,
    CoalitionMember,
    build_coalition_row,
    read_coalition_shard,
    write_coalition_shard,
)
from mcrl.stagec_v025.learner import (
    CoalitionBatch,
    LEGACY_EPOCH_BUDGET,
    LEARNED_ARMS,
    PairwiseBatch,
    ROUTES,
    SOURCE_MAP,
    V1LineageOrchestrator,
    build_pairwise_batches,
    default_synthetic_neutral_sources,
)
from mcrl.stagec_v025.shards import read_source_shard, write_source_shard
from mcrl.stagec_v025.state import (
    ActionEvaluation,
    ForecastObservation,
    PhysicalAction,
    extract_source_rows,
    seal_action_evaluation,
)


LABEL = "PILOT_NOT_CLAIM"
PILOT_SCHEMA = "mcrl-v025-learned-c3-real-physics-pilot-v1"
ROOT = Path(__file__).resolve().parents[1]
ENGINE_PATH = ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
DEFAULT_OUTPUT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
REPORT_PATH = ROOT / "V025-PILOT-C3-REPORT-2026-09-09.md"
TRAIN_WORLDS = DEVELOPMENT_WORLD_DOMAINS[:2]
EVALUATION_WORLDS = DEVELOPMENT_WORLD_DOMAINS[2:4]
LEARNER_DOMAINS = tuple(f"V025_LEARNER/seed/{index}" for index in range(1, 5))
LEARNER_SEEDS = tuple(seed_from_domain(domain) for domain in LEARNER_DOMAINS)
REPORTED_ARMS = (*LEARNED_ARMS, "BASELINE", "S0", "S_UNI")
# --- minimal-pilot scale knobs (engineering only; overridden from main()) ---
# Defaults reproduce the original full-scale pilot exactly.
PILOT_ARMS = tuple(LEARNED_ARMS)
EVAL_ANCHOR_STEPS = 30
EVAL_CARRIER_LIMIT = None
EVAL_EPOCH = LEGACY_EPOCH_BUDGET
ROW_WORLD_GLOB = "world-*"
ROW_ANCHOR_LIMIT = None
EVAL_TAPE_STEPS = 33
PILOT_FORECAST_BOUNDARIES = (0,)
PILOT_AGGREGATE_PAIR_LIMIT = 4_096
PILOT_PRIMITIVE_SOURCE_FALLBACK = True


def _engine() -> ModuleType:
    name = "mcrl_v025_pilot_matrix_engine"
    if name in sys.modules:
        return sys.modules[name]
    spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load engine at {ENGINE_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


ENGINE = _engine()
# Pilot-only compute fallback. The sealed engine remains byte-for-byte intact;
# its forecast helper reads this module constant at call time.
ENGINE.SELECTION_BOUNDARY_INDICES = PILOT_FORECAST_BOUNDARIES


def _sha_files(paths: Iterable[Path]) -> str:
    digest = hashlib.sha256()
    for path in sorted(paths):
        digest.update(path.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


CODE_DIGEST = _sha_files(
    [Path(__file__), *sorted((ROOT / "src/mcrl/stagec_v025").glob("*.py"))]
)
PHYSICS_DIGEST = _sha_files(sorted((ROOT / "src/mcrl/physics_v025").glob("*.py")))
LAUNCH_DIGEST = _sha_files(
    [
        ROOT / "V025-PILOT-TRACK-DECLARATION-2026-09-09.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1-2026-09-08.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1.1-AMENDMENT-2026-09-09.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1.2-AMENDMENT-2026-09-09.md",
    ]
)
ALLOCATION_DIGEST = canonical_sha256(
    {
        "artifact_label": LABEL,
        "training_worlds": TRAIN_WORLDS,
        "evaluation_worlds": EVALUATION_WORLDS,
        "learner_seed_domains": LEARNER_DOMAINS,
        "anchors_per_world_per_carrier": 30,
    }
)


@dataclass(frozen=True)
class PilotCalibration:
    eta_ref: Fraction
    lambda_bits_per_j: Fraction
    kappa_bits_per_user_step: Fraction
    bits_ref: Fraction
    joules_ref: Fraction
    users: int
    source: str = "one-development-anchor-proxy"

    def __post_init__(self) -> None:
        assert_calibration_prices(
            lambda_bits_per_j=self.lambda_bits_per_j,
            eta_ref=self.eta_ref,
            kappa_bits_per_user_step=self.kappa_bits_per_user_step,
        )

    @property
    def digest(self) -> str:
        return canonical_sha256(self.payload())

    def payload(self) -> dict[str, object]:


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
            column = aggressors.get(source)
            gain = 0.0 if column is None else max(
                (
                    float(arrays.cross_base_nominal[0, user, column])
                    for user in victim_columns.get(target, ())
                ),
                default=0.0,
            )
            pair_cache[relation] = gain
        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
    return tuple(result)


def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
    changed = tuple(
        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
    )
    members = tuple(
        CoalitionMember(
            user_id=user,
            reference_action=_physical_action(anchor.mapping[user]),
            selected_action=_physical_action(selected.mapping[user]),
            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
        )
        for user in changed
    )
    affected = sorted(
        {
            identity
            for user in changed
            for identity in (anchor.mapping[user], selected.mapping[user])
            if identity is not None
        }
    )
    before_counts: dict[tuple[int, int], int] = {}
    after_counts: dict[tuple[int, int], int] = {}
    for identity in anchor.mapping.values():
        if identity is not None:
            before_counts[identity] = before_counts.get(identity, 0) + 1
    for identity in selected.mapping.values():
        if identity is not None:
            after_counts[identity] = after_counts.get(identity, 0) + 1
    relations = _cross_gain_terms(tape, step_index, affected)
    beams = tuple(
        AffectedBeamContext(
            beam_key=f"{identity[0]}:{identity[1]}",
            occupancy_before=before_counts.get(identity, 0),
            occupancy_after=after_counts.get(identity, 0),
            active_before=before_counts.get(identity, 0) > 0,
            active_after=after_counts.get(identity, 0) > 0,
            shared_capacity=1.0,
            interference_summary=math.fsum(
                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
            ),
            capacity_margin=float(10 - after_counts.get(identity, 0)),
        )
        for identity in affected
    )
    return CoalitionContext(
        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
        reference_profile=tuple(
            (user, _physical_action(identity)) for user, identity in anchor.assignments
        ),
        members=members,
        affected_beams=beams,
        global_resource_features=(
            len(changed) / max(1, len(anchor.assignments)),
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )


def _coalition_row(
    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
    rows_by_user_action, calibration, run_setting,
):
    context = _coalition_context(
        tape=tape,
        step_index=step_index,
        anchor=anchor,
        selected=selected,
        rows_by_user_action=rows_by_user_action,
    )
    reference = evaluator.evaluate(anchor).outcome(
        phi=ENGINE._phi_for(anchor, anchor)
    )
    unilateral = {}
    for user in context.changed_users:
        mapping = anchor.mapping
        mapping[user] = selected.mapping[user]
        config = ENGINE._configuration(anchor, mapping, kind="pilot-coalition-singleton")
        unilateral[user] = evaluator.evaluate(config).outcome(
            phi=ENGINE._phi_for(anchor, config)
        )
    selected_outcome = evaluator.evaluate(selected).outcome(
        phi=ENGINE._phi_for(anchor, selected)
    )
    return build_coalition_row(
        context=context,
        reference_outcome=reference,
        unilateral_outcomes=unilateral,
        coalition_outcome=selected_outcome,
        world_id=tape.domain,
        world_seed=tape.seed,
        anchor_index=anchor_index,
        decision_time_utc=_utc_at(tape, step_index),
        decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
        setting_id="a-r0",
        lambda_bits_per_j=float(calibration.lambda_bits_per_j),
        eta_ref_bits_per_j=float(calibration.eta_ref),
        kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
        code_digest=CODE_DIGEST,
        physics_digest=PHYSICS_DIGEST,
        catalogue_digest=ENGINE.catalogue_definition()["sha256"],
        setting_digest=run_setting.digest,
        calibration_digest=calibration.digest,
        allocation_manifest_digest=ALLOCATION_DIGEST,
    )


def _write_phase_manifest(path: Path, payload: Mapping[str, object]) -> str:
    return write_once_json(path, {"artifact_label": LABEL, **payload})


def generate_rows(output: Path):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    source_shards = []
    coalition_shards = []
    calibration = None
    world_records = []
    for world_index, domain in enumerate(TRAIN_WORLDS, start=1):
        provider_started = time.perf_counter()
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(role="pilot-source"),
            steps=33,
            start_time_s=0.0,
        )
        provider_wall = time.perf_counter() - provider_started
        if calibration is None:
            calibration = _pilot_calibration(tape, setting, run_setting)
            _write_phase_manifest(output / f"{LABEL}-calibration.json", calibration.payload())
        skipped = physics_calls = catalogue_rows = 0
        source_row_count = coalition_row_count = source_bytes = coalition_bytes = 0
        source_hashes = []
        coalition_hashes = []
        anchor_started = time.perf_counter()
        anchor_index = 0
        for step_index in range(30):
            for carrier in ENGINE.REFERENCE_CARRIERS:
                built = _build_anchor_rows(
                    tape=tape,
                    setting=setting,
                    run_setting=run_setting,
                    calibration=calibration,
                    step_index=step_index,
                    carrier=carrier,
                    anchor_index=anchor_index,
                    include_coalition=True,
                )
                source_path = (
                    output / "rows" / f"world-{world_index}"
                    / f"{LABEL}-source-anchor-{anchor_index:03d}.jsonl"
                )
                coalition_path = (
                    output / "rows" / f"world-{world_index}"
                    / f"{LABEL}-coalition-anchor-{anchor_index:03d}.jsonl"
                )
                source_shard = write_source_shard(source_path, built["rows"])
                coalition_shard = write_coalition_shard(
                    coalition_path, (built["coalition_row"],)
                )
                source_shards.append(source_shard)
                coalition_shards.append(coalition_shard)
                source_row_count += len(built["rows"])
        batch.source_authority_sha256,
        source_identity="informed:pilot-deterministic-4096-pair-aggregate",
        physics_digest=batch.physics_digest,
    )


def train(output: Path, source_shards, coalition_shards):
    global _TRAIN_Q1, _TRAIN_Q2, _TRAIN_C3, _TRAIN_NEUTRAL, _TRAIN_OUTPUT
    phase_started = time.perf_counter()
    q_batches = {
        route: _aggregate_pair_batch(batch)
        for route, batch in build_pairwise_batches(source_shards).items()
    }
    _TRAIN_Q1, _TRAIN_Q2 = q_batches["C1"], q_batches["C2"]
    _TRAIN_C3 = CoalitionBatch.create(coalition_shards)
    _TRAIN_NEUTRAL = default_synthetic_neutral_sources()
    _TRAIN_OUTPUT = str(output)
    tasks = [(seed, arm) for seed in LEARNER_SEEDS for arm in LEARNED_ARMS]
    results = []
    context = mp.get_context("fork")
    with ProcessPoolExecutor(max_workers=16, mp_context=context) as executor:
        future_to_task = {executor.submit(_train_one, task): task for task in tasks}
        for future in as_completed(future_to_task):
            result = future.result()
            results.append(result)
            print(
                json.dumps(
                    {
                        "artifact_label": LABEL,
                        "phase": "train",
                        "arm": result["arm"],
                        "learner_seed": result["learner_seed"],
                        "completed": len(results),
                        "total": len(tasks),
                    }
                ),
                flush=True,
            )
    baseline = [
        {
            "artifact_label": LABEL,
            "arm": "BASELINE",
            "learner_seed": seed,
            "completed_source_epochs": 0,
            "external_policy": "fixed carrier proposal",
            "wall_s": 0.0,
            "core_s": 0.0,
            "checkpoint_count": 0,
        }
        for seed in LEARNER_SEEDS
    ]
    serializable = [{key: value for key, value in row.items() if key != "model_payload"} for row in results]
    manifest = {
        "schema": f"{PILOT_SCHEMA}-training-manifest-v1",
        "artifact_label": LABEL,
        "concurrency": 16,
        "neutral_batches_hoisted": True,
        "pilot_aggregate_pair_limit": PILOT_AGGREGATE_PAIR_LIMIT,
        "aggregate_batch_rows": {
            "C1": int(_TRAIN_Q1.target_deltas.size),
            "C2": int(_TRAIN_Q2.target_deltas.size),
            "C3": int(_TRAIN_C3.target_psi.size),
        },
        "phase_wall_s": time.perf_counter() - phase_started,
        "phase_core_s": sum(float(row["core_s"]) for row in results),
        "learner_seed_domains": list(LEARNER_DOMAINS),
        "lineages": sorted(serializable + baseline, key=lambda row: (row["learner_seed"], row["arm"])),
    }
    _write_phase_manifest(output / f"{LABEL}-training-manifest.json", manifest)
    models = {(row["learner_seed"], row["arm"]): row["model_payload"] for row in results}
    return models, manifest, (_TRAIN_Q1, _TRAIN_Q2, _TRAIN_C3, _TRAIN_NEUTRAL)


def _load_completed_training(output: Path):
    row_manifest = json.loads(
        (output / f"{LABEL}-rows-manifest.json").read_text(encoding="ascii")
    )
    training_manifest = json.loads(
        (output / f"{LABEL}-training-manifest.json").read_text(encoding="ascii")
    )
    calibration_payload = json.loads(
        (output / f"{LABEL}-calibration.json").read_text(encoding="ascii")
    )
    ratio = lambda name: Fraction(*calibration_payload[name])
    calibration = PilotCalibration(
        eta_ref=ratio("eta_ref"),
        lambda_bits_per_j=ratio("lambda_bits_per_j"),
        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
        bits_ref=ratio("bits_ref"), joules_ref=ratio("joules_ref"),
        users=int(calibration_payload["users"]),
    )
    source_shards = [
        read_source_shard(path)
        for path in sorted((output / "rows").glob(f"{ROW_WORLD_GLOB}/*source-anchor-*.jsonl"))[:ROW_ANCHOR_LIMIT]
    ]
    coalition_shards = [
        read_coalition_shard(path)
        for path in sorted((output / "rows").glob(f"{ROW_WORLD_GLOB}/*coalition-anchor-*.jsonl"))[:ROW_ANCHOR_LIMIT]
    ]
    q_batches = {
        route: _aggregate_pair_batch(batch)
        for route, batch in build_pairwise_batches(source_shards).items()
    }
    batches = (
        q_batches["C1"], q_batches["C2"],
        CoalitionBatch.create(coalition_shards), default_synthetic_neutral_sources(),
    )
    model_payloads = {}
    for seed in LEARNER_SEEDS:
        for arm in PILOT_ARMS:
            checkpoint = output / "checkpoints" / (
                f"{LABEL}-seed-{seed}-{arm}-epoch-{EVAL_EPOCH:04d}.json"
            )
            payload = json.loads(checkpoint.read_text(encoding="ascii"))
            model_payloads[(seed, arm)] = payload["model"]
    return row_manifest, training_manifest, calibration, model_payloads, batches


