   538	class FixedRF:
   539	    """Architecture b: fixed 1.65-W RF per active full-band TDM beam."""
   540	
   541	    code: Literal["b"] = "b"
   542	
   543	    def radiate(
   544	        self, config: RadiationConfig, geometry: Geometry, nominal_or_realised: FieldKind
   545	    ) -> RadiationResult:
   546	        direct_all = geometry.gains(
   547	            nominal_or_realised,
   548	            fading_quantile_alpha=config.fading_quantile_alpha,
   549	        )
   550	        slots: list[RadiationSlot] = []
   551	        certificates: list[PowerCertificate] = []
   552	        for start, end, active in _tdm_slots(geometry):
   553	            power = np.full(len(active), config.beam_cap_w, dtype=np.float64)
   554	            direct = direct_all[list(active)] if active else np.zeros(0)
   555	            coupling = _masked_coupling(geometry, active, nominal_or_realised)
   556	            nominal_direct = geometry.gains("nominal")[list(active)] if active else np.zeros(0)
   557	            nominal_coupling = _masked_coupling(geometry, active, "nominal")
   558	            noise = np.full(len(active), noise_power_w(config.bandwidth_hz))
   559	            bandwidth = np.full(len(active), config.bandwidth_hz)
   560	            certificate = PowerCertificate("FIXED", 0, 0.0, config.solver_tolerance_w)
   561	            certificates.append(certificate)
   562	            slots.append(
   563	                RadiationSlot(
   564	                    start,
   565	                    end,
   566	                    tuple((geometry.links[index].beam, config.beam_cap_w) for index in active),
   567	                    _transmissions(
   568	                        geometry,
   569	                        active,
   570	                        power,
   780	                else digest_payload(
   781	                    [
   782	                        [row.payload() for row in layout]
   783	                        for layout in self.step_user_layouts
   784	                    ]
   785	                )
   786	            ),
   787	        }
   788	
   789	    def geometry_for(
   790	        self,
   791	        *,
   792	        step_index: int,
   793	        assignments: Mapping[int, BeamIdentity | None],
   794	    ) -> tuple[tuple[float, Geometry], ...]:
   795	        """Materialize one selected configuration without mutating the tape."""
   796	
   797	        step = self.steps[step_index]
   798	        if step.arrays is not None:
   799	            return tuple(
   800	                (
   801	                    float(step.arrays.absolute_time_s[boundary_index]),
   802	                    step.arrays.geometry_at(
   803	                        boundary_index=boundary_index,
   804	                        assignments=assignments,
   805	                    ),
   806	                )
   807	                for boundary_index in range(step.boundary_count)
   808	            )
   809	        result: list[tuple[float, Geometry]] = []
   810	        for boundary_index, boundary in enumerate(step.boundaries):
   811	            by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
   812	            chosen = []
   813	            for user in sorted(assignments):
   814	                identity = assignments[user]
   815	                if identity is None:
   816	                    continue
   817	                try:
   818	                    row = by_key[(user, identity)]
   819	                except KeyError:
   820	                    raise MCRLContractError("assignment is absent from the exogenous tape") from None
   821	                if boundary_index == 0 and not row.legal:
   822	                    raise MCRLContractError("assignment is not visible and D2-eligible")
   823	                if not row.legal:
   824	                    continue
   825	                chosen.append(row)
