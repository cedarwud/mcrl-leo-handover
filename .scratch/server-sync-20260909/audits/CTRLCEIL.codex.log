   269	def summarize_cell(anchors: list[dict[str, object]]) -> dict[str, object]:
   270	    result: dict[str, object] = {"arms": {}}
   271	    flat_by_arm = {
   272	        arm: [
   273	            user
   274	            for anchor in anchors
   275	            for user in anchor["arms"][arm]["users"]  # type: ignore[index]
   276	        ]
   277	        for arm in ARMS
   278	    }
   279	    for arm in ARMS:
   280	        rows = flat_by_arm[arm]
   281	        bits = math.fsum(float(row["bits"]) for row in rows)
   282	        served = sum(bool(row["served"]) for row in rows)
   283	        attained = sum(bool(row["rate_target_attained"]) for row in rows)
   284	        zero_bits = sum(float(row["bits"]) == 0.0 for row in rows)
   285	        arm_summary = {
   286	            "observations": len(rows),
   287	            "bits": bits,
   288	            "served_count": served,
   289	            "served_share": served / len(rows),
   290	            "rate_target_attained_count": attained,
   291	            "rate_target_attained_share": attained / len(rows),
   292	            "zero_credited_bits_count": zero_bits,
   293	            "attributions": {},
   294	        }
   295	        for name in ATTRIBUTIONS:
   296	            joules = math.fsum(float(row[name]["joules"]) for row in rows)
   297	            efficiencies = [float(row[name]["ee_bit_per_j"]) for row in rows]
   298	            arm_summary["attributions"][name] = {  # type: ignore[index]
   299	                "joules": joules,
   300	                "pooled_ee_bit_per_j": bits / joules,
   301	                "summed_per_user_ee_bit_per_j": math.fsum(efficiencies),
   302	                "distribution_all_user_steps": quantiles(efficiencies),
   303	                "distribution_served_user_steps": quantiles(
   304	                    float(row[name]["ee_bit_per_j"])
   305	                    for row in rows
   306	                    if bool(row["served"])
   307	                ),
   308	            }
   309	        result["arms"][arm] = arm_summary  # type: ignore[index]
   310	
   311	    paired = {}
   312	    u_rows = flat_by_arm["UNILATERAL"]
   313	    j_rows = flat_by_arm["ORACLE_SET"]
   314	    u_keys = [(row["anchor_id"], row["user_id"]) for row in u_rows]
   315	    j_keys = [(row["anchor_id"], row["user_id"]) for row in j_rows]
   316	    if u_keys != j_keys:
   317	        raise RuntimeError("joint/unilateral user rows are not paired")
   318	    for name in ATTRIBUTIONS:
   319	        changes = [
   320	            float(j[name]["ee_bit_per_j"]) - float(u[name]["ee_bit_per_j"])
   321	            for u, j in zip(u_rows, j_rows, strict=True)
   322	        ]
   323	        u_sum = result["arms"]["UNILATERAL"]["attributions"][name][  # type: ignore[index]
   324	            "summed_per_user_ee_bit_per_j"
   325	        ]
   326	        j_sum = result["arms"]["ORACLE_SET"]["attributions"][name][  # type: ignore[index]
   327	            "summed_per_user_ee_bit_per_j"
   328	        ]
   329	        paired[name] = {
   330	            "better_count": sum(value > 0.0 for value in changes),
   331	            "worse_count": sum(value < 0.0 for value in changes),
   332	            "tied_count": sum(value == 0.0 for value in changes),
   333	            "change_distribution_bit_per_j": quantiles(changes),
   334	            "summed_absolute_change_bit_per_j": j_sum - u_sum,
   335	            "summed_relative_change": relative_gain(j_sum, u_sum),
   336	        }
   337	    result["paired_joint_minus_unilateral"] = paired
   338	    return result
   339	
