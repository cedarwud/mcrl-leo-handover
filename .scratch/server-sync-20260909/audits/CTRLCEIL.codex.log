   123	    implement the sealed ``Gamma_r(n_b)`` definition with one helper.
   124	    """
   125	
   126	    if not math.isfinite(rate_target_bps) or rate_target_bps <= 0.0:
   127	        raise MCRLContractError("rate target must be finite and positive")
   128	    if not math.isfinite(full_bandwidth_hz) or full_bandwidth_hz <= 0.0:
   129	        raise MCRLContractError("full bandwidth must be finite and positive")
   130	    if type(occupancy) is not int or occupancy < 1:
   131	        raise MCRLContractError("occupancy must be a positive exact integer")
   132	    required_se = rate_target_bps * occupancy / full_bandwidth_hz
