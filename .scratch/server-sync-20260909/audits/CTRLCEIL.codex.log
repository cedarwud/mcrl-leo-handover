   360	
   361	def _solve_power(
   362	    direct: np.ndarray,
   363	    coupling: np.ndarray,
   364	    noise: np.ndarray,
   365	    caps: np.ndarray,
   366	    active_user_ids: tuple[int, ...],
   367	    config: RadiationConfig,
   368	    *,
   369	    target_sinr: np.ndarray | None = None,
   370	    force_cap: np.ndarray | None = None,
   371	    enforce_target_clearance: bool = False,
   372	) -> tuple[np.ndarray, PowerCertificate]:
   373	    """Capped standard-interference fixed point, always initialised at zero."""
   374	
   375	    targets = (
   376	        np.full(len(active_user_ids), config.target_sinr, dtype=np.float64)
   377	        if target_sinr is None
   378	        else np.asarray(target_sinr, dtype=np.float64)
   379	    )
   380	    forced = (
   381	        np.zeros(len(active_user_ids), dtype=np.bool_)
   382	        if force_cap is None
   383	        else np.asarray(force_cap, dtype=np.bool_)
   384	    )
   385	    if targets.shape != caps.shape or forced.shape != caps.shape:
   386	        raise MCRLContractError("power target, forced-cap mask, and caps must share shape")
   387	    power = np.zeros(len(active_user_ids), dtype=np.float64)
   388	    residual = math.inf
   389	    recent_changes: list[float] = []
   390	    status: Literal["CONVERGED", "CONVERGED_SLOW"] = "CONVERGED"
   391	    for iteration in range(1, config.solver_iteration_cap + 1):
   392	        updated = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   393	        updated[forced] = caps[forced]
   394	        if not np.all(np.isfinite(updated)) or np.any(
   395	            updated + config.solver_tolerance_w < power
   396	        ):
   397	            return power, PowerCertificate(
   398	                "INVALID", iteration, math.inf, config.solver_tolerance_w
   399	            )
   400	        change = np.abs(updated - power)
   401	        residual = float(np.max(change)) if power.size else 0.0
   402	        relative = float(
   403	            np.max(change / np.maximum(np.abs(updated), np.finfo(float).tiny))
   404	        ) if power.size else 0.0
   405	        recent_changes.append(residual)
   406	        if len(recent_changes) > 1_000:
   407	            recent_changes.pop(0)
   408	        power = updated
   409	        if residual <= config.solver_tolerance_w or relative <= 1.0e-9:
   410	            break
   411	    else:
   412	        if (
   413	            len(recent_changes) == 1_000
   414	            and max(recent_changes) < 1.0e-6
   415	            and all(
   416	                right <= left + np.finfo(float).eps
   417	                for left, right in zip(recent_changes, recent_changes[1:])
   418	            )
   419	        ):
   420	            status = "CONVERGED_SLOW"
   421	        else:
   422	            return power, PowerCertificate(
   423	                "INVALID", config.solver_iteration_cap, residual, config.solver_tolerance_w
   424	            )
   425	    if enforce_target_clearance and power.size:
   426	        # A monotone fixed-point sequence approaches the threshold from below.
   427	        # Preserve the established full-path endpoint by taking one final
   428	        # update, then move one negligible solver-scale step into the
   429	        # certified feasible half-space.
   430	        power = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   431	        power[forced] = caps[forced]
   432	        power = np.minimum(caps, np.nextafter(power * (1.0 + 2.0e-9), np.inf))
   433	        power[forced] = caps[forced]
   434	    return power, PowerCertificate(
   435	        status,
   436	        iteration,
   437	        residual,
   438	        config.solver_tolerance_w,
   439	        tuple(active_user_ids[index] for index in np.flatnonzero(power >= caps - config.solver_tolerance_w)),
   440	    )
   441	
   442	
   443	def _transmissions(
   444	    geometry: Geometry,
   445	    active: tuple[int, ...],
   446	    power: np.ndarray,
   447	    direct: np.ndarray,
   448	    coupling: np.ndarray,
   449	    noise: np.ndarray,
   450	    bandwidth: np.ndarray,
   451	    subbands: tuple[tuple[float, float], ...],
   452	    *,
   453	    nominal_direct: np.ndarray,
   454	    nominal_coupling: np.ndarray,
   455	    fading_quantile_alpha: float | None,
   456	    rate_target_bps: float | None = None,
   457	    rate_target_sinr_values: tuple[float | None, ...] | None = None,
   458	    rate_target_feasible: tuple[bool, ...] | None = None,
   459	    m_target_values: tuple[ACMMode | None, ...] | None = None,
   460	) -> tuple[Transmission, ...]:
   461	    rows = []
   462	    nominal_denominators = noise + nominal_coupling @ power
   463	    nominal_sinr_values = power * nominal_direct / nominal_denominators
   464	    for row, index in enumerate(active):
   465	        link = geometry.links[index]
   466	        intra = 0.0
   467	        inter = 0.0
   468	        for column, aggressor in enumerate(active):
   469	            term = coupling[row, column] * power[column]
   470	            if geometry.links[aggressor].beam[0] == link.beam[0]:
   471	                intra += term
   472	            else:
   473	                inter += term
   474	        nominal_sinr = float(nominal_sinr_values[row])
   475	        quantile = (
   476	            1.0
   477	            if fading_quantile_alpha is None
   478	            else fading_product_quantile(link.elevation_deg, fading_quantile_alpha)
   479	        )
   480	        m_tx = select_transmitted_mode(nominal_sinr, quantile)
   481	        actual_sinr = float(
   482	            power[row] * direct[row] / (noise[row] + intra + inter)
   483	        )
   484	        outcome = decode_transmitted_mode(m_tx, actual_sinr)
   485	        rows.append(
   486	            Transmission(
   487	                user_id=link.user_id,
   488	                beam=link.beam,
   489	                rf_power_w=float(power[row]),
   490	                wanted_w=float(power[row] * direct[row]),
   491	                intra_interference_w=float(intra),
   492	                inter_interference_w=float(inter),
   493	                noise_w=float(noise[row]),
   494	                bandwidth_hz=float(bandwidth[row]),
   495	                subband=subbands[row],
   496	                rate_target_bps=rate_target_bps,
   497	                rate_target_sinr=(
   498	                    None if rate_target_sinr_values is None else rate_target_sinr_values[row]
   499	                ),
   500	                rate_target_feasible=(
   501	                    None if rate_target_feasible is None else rate_target_feasible[row]
   502	                ),
   503	                m_target=(
   504	                    None if m_target_values is None else m_target_values[row]
   505	                ),
   506	                m_tx=m_tx,
   507	                realised_outcome=outcome,
   508	                nominal_sinr=nominal_sinr,
   509	                margin_predicted_sinr=nominal_sinr * quantile,
   510	            )
   511	        )
   512	    return tuple(rows)
   513	
   514	
   515	def _aggregate_certificates(certificates: list[PowerCertificate]) -> PowerCertificate:
   516	    if not certificates:
   517	        return PowerCertificate("FIXED", 0, 0.0, POWER_SOLVER_TOLERANCE_W)
   518	    invalid = any(c.status == "INVALID" for c in certificates)
   519	    statuses = {c.status for c in certificates}
   520	    status: Literal["FIXED", "CONVERGED", "CONVERGED_SLOW", "INVALID"] = (
   521	        "INVALID"
   522	        if invalid
   523	        else "FIXED"
   524	        if statuses == {"FIXED"}
   525	        else "CONVERGED_SLOW"
   526	        if "CONVERGED_SLOW" in statuses
   527	        else "CONVERGED"
   528	    )
   529	    return PowerCertificate(
   530	        status,
   531	        sum(c.iterations for c in certificates),
   532	        max(c.residual_w for c in certificates),
   533	        certificates[0].tolerance_w,
   534	        tuple(sorted({uid for c in certificates for uid in c.saturated_users})),
   535	    )
