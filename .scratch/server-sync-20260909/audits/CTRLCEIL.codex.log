    86	def quantiles(values: Iterable[float]) -> dict[str, float]:
    87	    rows = np.asarray(tuple(values), dtype=np.float64)
    88	    if rows.size == 0 or not np.all(np.isfinite(rows)):
    89	        raise RuntimeError("distribution is empty or non-finite")
    90	    q05, q25, q50, q75, q95 = np.quantile(
    91	        rows, (0.05, 0.25, 0.50, 0.75, 0.95), method="linear"
    92	    )
    93	    return {
    94	        "p05": float(q05),
    95	        "q1": float(q25),
    96	        "median": float(q50),
    97	        "q3": float(q75),
    98	        "p95": float(q95),
    99	    }
