   467	                    f"{fmt_m(q['q1'])}–{fmt_m(q['q3'])} | {fmt_m(q['median'])} | "
   468	                    f"{fmt_m(q['p95'])} | {row['zero_credited_bits_count']} |"
   469	                )
   470	    lines += [
   471	        "",
   472	        "## Per-arm distributions: equal-account fixed-cost attribution",
   473	        "",
   474	        "| Rule | Width | Arm | Sum (Gbit/J) | P5 | Q1–Q3 | Median | P95 | Zero-bit users |",
   475	        "|:---|---:|:---:|---:|---:|---:|---:|---:|---:|",
