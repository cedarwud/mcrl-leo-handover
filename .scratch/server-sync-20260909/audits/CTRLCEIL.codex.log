   359	def render_report(result: Mapping[str, object], output: Path, receipt_path: Path) -> None:
   360	    cells = result["cells"]  # type: ignore[index]
   361	    source = cells["margin"]["3.32"]  # type: ignore[index]
   362	    source_primary = source["paired_joint_minus_unilateral"]["activity"]  # type: ignore[index]
   363	    source_gap = float(source_primary["summed_relative_change"])
   364	    source_abs = float(source_primary["summed_absolute_change_bit_per_j"])
   365	    survives = source_gap > 0.0
   366	    if survives:
   367	        lead = (
   368	            "**Yes. At the source's 3.32° one-sided beam width under the corrected rule, "
   369	            f"the joint selector retains a {fmt_pct(source_gap)} activity-attributed "
   370	            f"summed-per-user advantage ({source_abs / 1e9:+.3f} Gbit/J in the sum).**"
   371	        )
   372	    else:
   373	        lead = (
   374	            "**No. At the source's 3.32° one-sided beam width under the corrected rule, "
   375	            f"the joint selector's advantage vanishes or reverses: {fmt_pct(source_gap)} "
   376	            f"under activity-attributed summed-per-user EE ({source_abs / 1e9:+.3f} Gbit/J).**"
   377	        )
   378	
   379	    lines = [
   380	        lead,
   381	        "",
   382	        "# Per-user energy-efficiency diagnostic for the beam-width sweep",
   383	        "",
   384	        "`DIAGNOSTIC_NOT_CLAIM`",
   385	        "",
   386	        "## Direct answer",
   387	        "",
   388	        "The sealed pooled objective is unchanged. This report adds unweighted summed individual-link EE (a sum of ratios) and user-level service/distribution diagnostics beside it; it does not replace, reopen, or retune the sealed ratio of sums.",
   389	        "",
   390	        "A summed-metric advantage *survives* in a cell only when `sum_u EE_u(J) / sum_u EE_u(U) - 1 > 0`. The primary answer uses activity/airtime attribution. The second attribution is a fixed-cost sensitivity fixed before results were computed.",
   391	        "",
   392	        "| Rule | One-sided / full | Pooled U / J (Mbit/J) | Pooled J−U | Summed U / J, activity (Gbit/J) | Activity J−U (Gbit/J; %) | Summed U / J, account (Gbit/J) | Account J−U (Gbit/J; %) | Pooled/activity disagree? |",
   393	        "|:---|:---:|---:|---:|---:|---:|---:|---:|:---:|",
   394	    ]
   395	    disagreements = []
   396	    account_disagreements = []
   397	    for rule in RULES:
   398	        for width in WIDTHS:
   399	            cell = cells[rule][width]  # type: ignore[index]
   400	            arms = cell["arms"]
   401	            pooled_u = arms["UNILATERAL"]["attributions"]["activity"]["pooled_ee_bit_per_j"]
   402	            pooled_j = arms["ORACLE_SET"]["attributions"]["activity"]["pooled_ee_bit_per_j"]
   403	            pooled_gap = relative_gain(pooled_j, pooled_u)
   404	            a = cell["paired_joint_minus_unilateral"]["activity"]
   405	            b = cell["paired_joint_minus_unilateral"]["account"]
   406	            au = arms["UNILATERAL"]["attributions"]["activity"]["summed_per_user_ee_bit_per_j"]
   407	            aj = arms["ORACLE_SET"]["attributions"]["activity"]["summed_per_user_ee_bit_per_j"]
   408	            bu = arms["UNILATERAL"]["attributions"]["account"]["summed_per_user_ee_bit_per_j"]
   409	            bj = arms["ORACLE_SET"]["attributions"]["account"]["summed_per_user_ee_bit_per_j"]
   410	            disagree = (pooled_gap > 0.0) != (float(a["summed_relative_change"]) > 0.0)
   411	            account_disagree = (pooled_gap > 0.0) != (
   412	                float(b["summed_relative_change"]) > 0.0
   413	            )
   414	            if disagree:
   415	                disagreements.append(f"{rule.upper()} {width}°")
   416	            if account_disagree:
   417	                account_disagreements.append(f"{rule.upper()} {width}°")
   418	            lines.append(
   419	                f"| {rule.upper()} | {width}° / {2*float(width):.2f}° | "
   420	                f"{fmt_m(pooled_u)} / {fmt_m(pooled_j)} | {fmt_pct(pooled_gap)} | "
   420	                f"{fmt_m(pooled_u)} / {fmt_m(pooled_j)} | {fmt_pct(pooled_gap)} | "
   421	                f"{fmt_g(au)} / {fmt_g(aj)} | {float(a['summed_absolute_change_bit_per_j'])/1e9:+.3f}; {fmt_pct(a['summed_relative_change'])} | "
   422	                f"{fmt_g(bu)} / {fmt_g(bj)} | {float(b['summed_absolute_change_bit_per_j'])/1e9:+.3f}; {fmt_pct(b['summed_relative_change'])} | "
   423	                f"{'YES' if disagree else 'no'} |"
   424	            )
   425	    lines += [
   426	        "",
   427	        (
