   347	def fmt_share(count: int, total: int = 800) -> str:
   348	    return f"{count} ({100.0 * count / total:.3f}%)"
   349	
   350	
   351	def fmt_m(value: float) -> str:
   352	    return f"{value / 1e6:.3f}"
   353	
   354	
   355	def fmt_g(value: float) -> str:
   356	    return f"{value / 1e9:.3f}"
