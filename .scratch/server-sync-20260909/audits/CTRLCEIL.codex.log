+    }
+    for rule in ("SEALED", "STRICT"):
+        lines += [f"### {rule}", ""]
+        anchors = result["rules"][rule]["anchors"]  # type: ignore[index]
+        # Aggregate anchor decompositions by summing their already conserved Mbit/J
+        # is not valid under pooled energy denominators, so report anchor-weighted
+        # pooled shares reconstructed from receipt detail below.
+        pooled_decomp = result["rules"][rule]["pooled_decomposition"]  # type: ignore[index]
+        for dimension in labels:
+            table_bucket(lines, labels[dimension], pooled_decomp[dimension])
+    lines += [
