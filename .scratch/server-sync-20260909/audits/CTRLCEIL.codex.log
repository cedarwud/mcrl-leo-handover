    48	    def __post_init__(self) -> None:
    49	        if type(self.user_id) is not int or self.user_id < 0:
    50	            raise MCRLContractError("user_id must be a nonnegative exact integer")
    51	        if len(self.beam) != 2 or any(type(value) is not int for value in self.beam):
    52	            raise MCRLContractError("beam must be the physical (NORAD, chain) identity")
    53	        if type(self.color) is not int or self.color < 0:
    54	            raise MCRLContractError("color must be a nonnegative exact integer")
    55	        for label, value in (
    56	            ("nominal_gain", self.nominal_gain),
    57	            ("realised_gain", self.realised_gain),
    58	        ):
    59	            if value is not None and (not math.isfinite(value) or value <= 0.0):
    60	                raise MCRLContractError(f"{label} must be finite and positive")
    61	        if not math.isfinite(self.elevation_deg) or not -90.0 <= self.elevation_deg <= 90.0:
    62	            raise MCRLContractError("elevation_deg must be finite and in [-90,90]")
