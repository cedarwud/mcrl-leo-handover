#!/usr/bin/env python3
"""Replay the fixed beam-width selections and add user-level EE diagnostics.

This script does not run a selector.  It reconstructs only the three recorded
committed configurations at each of the 80 anchors (five widths, two rules,
eight anchors), verifies their aggregate receipts, attributes every joule to
user-steps under two predeclared energy-conserving rules, writes a detailed
JSON receipt, and renders PER-USER-METRIC-2026-09-10.md.
"""

from __future__ import annotations

import argparse
from collections import defaultdict
import hashlib
import importlib.util
import json
import math
from pathlib import Path
import sys
from typing import Iterable, Mapping

import numpy as np


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
WIDTHS = ("1.66", "2.40", "3.32", "4.50", "6.65")
RULES = ("sealed", "margin")
ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
SHORT = {"BASELINE": "B", "UNILATERAL": "U", "ORACLE_SET": "J"}
ATTRIBUTIONS = ("activity", "account")
ATTRIBUTION_LABEL = {
    "activity": "activity/airtime",
    "account": "equal-account fixed cost",
}
STEP_S = 0.640
BOUNDARIES = 48
USERS_PER_ANCHOR = 100
RATE_TARGET_BPS = 50_000_000.0


def _load_runner():
    path = HERE / "run_beamwidth_network.py"
    spec = importlib.util.spec_from_file_location("per_user_runner", path)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load beam-width runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


runner = _load_runner()

import margin_batch
from mcrl.physics_v025 import batch as sealed_batch
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
)
from mcrl.physics_v025.energy import pa_supply_power_w
from mcrl.physics_v025.provider_legacy import factory


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def configuration_from_id(base, configuration_id: str):
    if configuration_id.startswith("BASE:"):
        if base.configuration_id != configuration_id:
            raise RuntimeError("baseline configuration reconstruction failed")
        return base
    if not configuration_id.startswith("CFG:"):
        raise RuntimeError(f"unexpected configuration id: {configuration_id}")
    mapping = {}
    for assignment in configuration_id[4:].split(";"):
        user, norad, chain = assignment.split(":")
        mapping[int(user)] = (int(norad), int(chain))
    config = runner.probe._configuration(base, mapping, kind="per-user-replay")
    if config.configuration_id != configuration_id:
        raise RuntimeError("configuration reconstruction failed")
    return config


def quantiles(values: Iterable[float]) -> dict[str, float]:
    rows = np.asarray(tuple(values), dtype=np.float64)
    if rows.size == 0 or not np.all(np.isfinite(rows)):
        raise RuntimeError("distribution is empty or non-finite")
    q05, q25, q50, q75, q95 = np.quantile(
        rows, (0.05, 0.25, 0.50, 0.75, 0.95), method="linear"
    )
    return {
        "p05": float(q05),
        "q1": float(q25),
        "median": float(q50),
        "q3": float(q75),
        "p95": float(q95),
    }


def relative_gain(numerator: float, denominator: float) -> float | None:
    return None if denominator == 0.0 else numerator / denominator - 1.0


def scalar_boundary(
    *, architecture, geometry, circuit_power_w: float, roster: tuple[int, ...]
) -> tuple[dict[int, float], dict[str, dict[int, float]], float]:
    """Return rate, two allocated-power maps, and exact network power."""

    config = runner.RadiationConfig(
        rate_target_bps=RATE_TARGET_BPS,
        fading_quantile_alpha=0.10,
    )
    radiation = architecture.radiate(config, geometry, "realised")
    if not radiation.valid:
        raise RuntimeError("recorded committed configuration became invalid")

    rates = {user: 0.0 for user in roster}
    activity = {user: 0.0 for user in roster}
    account = {user: 0.0 for user in roster}
    active_users_by_beam: dict[tuple[int, int], set[int]] = defaultdict(set)

    for slot in radiation.slots:
        positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
        by_satellite: dict[int, list[object]] = defaultdict(list)
        for tx in positive:
            by_satellite[tx.beam[0]].append(tx)
            active_users_by_beam[tx.beam].add(tx.user_id)
            pa_w = pa_supply_power_w(tx.rf_power_w)
            activity[tx.user_id] += slot.fraction * (pa_w + circuit_power_w)
            account[tx.user_id] += slot.fraction * pa_w
        for rows in by_satellite.values():
            share = BASEBAND_POWER_PER_ACTIVE_SATELLITE_W / len(rows)
            for tx in rows:
                activity[tx.user_id] += slot.fraction * share
        for tx in slot.transmissions:
            outcome = tx.realised_outcome
            if outcome is None:
                raise RuntimeError("ACM transmission lacks realised outcome")
            if outcome.decoded:
                rates[tx.user_id] += (
                    slot.fraction
                    * tx.bandwidth_hz
                    * outcome.credited_spectral_efficiency_bit_per_s_hz
                )

    # Alternative allocation of fixed costs: a chain's circuit cost is shared
    # equally by its assigned transmitting accounts, and a satellite's common
    # baseband cost is shared equally by all such accounts on that satellite.
    active_users_by_satellite: dict[int, set[int]] = defaultdict(set)
    for beam, users in active_users_by_beam.items():
        share = circuit_power_w / len(users)
        for user in users:
            account[user] += share
            active_users_by_satellite[beam[0]].add(user)
    for users in active_users_by_satellite.values():
        share = BASEBAND_POWER_PER_ACTIVE_SATELLITE_W / len(users)
        for user in users:
            account[user] += share

    # Reconstruct the engine's energy formula independently from the same
    # radiation slots.  Primary V0.25 has no standby or bus draw.
    network_power = 0.0
    for slot in radiation.slots:
        positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
        network_power += slot.fraction * (
            math.fsum(pa_supply_power_w(tx.rf_power_w) + circuit_power_w for tx in positive)
            + len({tx.beam[0] for tx in positive})
            * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
