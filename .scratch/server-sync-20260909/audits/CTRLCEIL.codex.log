#!/usr/bin/env python3
"""Cross-fitted selection diagnostic for three coalition interaction models.

This is deliberately a diagnostic, not a deployment path.  It reads the
authenticated V0.25 mechanism corpus, holds complete anchors out, and compares
an additive pair head, a resource-load anchored residual, and an anchor-local
ranking model.  Frozen physics and scoring code are imported but never edited.
"""

from __future__ import annotations

import argparse
from collections import Counter, defaultdict
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import json
import math
from pathlib import Path
import sys
import time
from typing import Iterable, Mapping, Sequence

import numpy as np
import torch
from torch import nn
from torch.nn import functional as F

from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import build_world_tape
from mcrl.stagec_v025.canonical import canonical_sha256, parse_float_hex
from mcrl.stagec_v025.coalitions import CoalitionContext, _context
from mcrl.stagec_v025.learner import LEARNER_SEEDS


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
import generate_mechanism_coalition_corpus as corpus_generator  # noqa: E402
import run_v025_pilot_c3 as pilot  # noqa: E402


LABEL = "DIAGNOSTIC_NOT_CLAIM"
SCHEMA = "mcrl-v025-architecture-alternatives-diagnostic-v1"
CORPUS = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
SOURCE = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
DEFAULT_OUTPUT = ROOT / "artifacts/v025-architecture-alternatives-20260909-DIAGNOSTIC_NOT_CLAIM"
DEFAULT_REPORT = ROOT / "ARCH-ALTERNATIVES-2026-09-09.md"
FOLDS = 5
MATERIAL_R3 = 1.0e-3
MODELS = ("pairwise baseline", "resource anchored", "same-anchor ranker")
DEVICE = torch.device("cpu")


@dataclass(frozen=True)
class Row:
    world_id: str
    anchor_index: int
    anchor_id: str
    configuration_id: str
    coalition_size: int
    families: tuple[str, ...]
    psi: float
    c1: float
    exact_delta: float
    material_r3: bool
    r3: float | None
    candidate_features: np.ndarray
    member_invariants: tuple[np.ndarray, ...]
    selected_q1: tuple[np.ndarray, ...]
    incumbent_q1: tuple[np.ndarray, ...]
    member_users: tuple[int, ...]
    member_selected_actions: tuple[tuple[int, int] | None, ...]
    member_reference_actions: tuple[tuple[int, int] | None, ...]
    singleton_keys: tuple[str, ...]
    singleton_targets: tuple[float, ...]
    pair_features: tuple[np.ndarray, ...]
    pair_users: tuple[tuple[int, int], ...]
    pair_targets: tuple[float, ...]
    resource_terms: tuple[tuple[np.ndarray, int, float], ...]
    resource_structural_zero: bool

    @property
    def anchor_key(self) -> tuple[str, int]:
        return (self.world_id, self.anchor_index)


def _fraction(pair: Sequence[int]) -> Fraction:
    return Fraction(int(pair[0]), int(pair[1]))


def _action_key(action) -> tuple[int, int] | None:
    if action.is_null:
        return None
    return (int(action.norad_id), int(action.beam_chain_id))


def _pair_features(first, second) -> np.ndarray:
    left = np.asarray(first.invariant_features, dtype=np.float64)
    right = np.asarray(second.invariant_features, dtype=np.float64)
    lr, ls = _action_key(first.reference_action), _action_key(first.selected_action)
    rr, rs = _action_key(second.reference_action), _action_key(second.selected_action)
    relations = np.asarray(
        [
            float(lr == rr),
            float(ls == rs),
            float(ls == rr),
            float(rs == lr),
            float(lr is None),
            float(rr is None),
            float(ls is None),
            float(rs is None),
        ],
        dtype=np.float64,
    )
    return np.concatenate((left + right, np.abs(left - right), left * right, relations))


def _resource_terms(context: CoalitionContext) -> tuple[tuple[np.ndarray, int, float], ...]:
    incoming: dict[str, list[float]] = defaultdict(list)
    outgoing: dict[str, list[float]] = defaultdict(list)
    for source, target, gain in context.pairwise_cross_gain_terms:
        outgoing[source].append(float(gain))
        incoming[target].append(float(gain))
    terms: list[tuple[np.ndarray, int, float]] = []
    for beam in context.affected_beams:
        changes = []
        for member in context.members:
            reference = _action_key(member.reference_action)
            selected = _action_key(member.selected_action)
            beam_key = None if reference is None else f"{reference[0]}:{reference[1]}"
            selected_key = None if selected is None else f"{selected[0]}:{selected[1]}"
            change = int(selected_key == beam.beam_key) - int(beam_key == beam.beam_key)
            if change:
                changes.append(change)
        if beam.occupancy_after != beam.occupancy_before + sum(changes):
            raise RuntimeError("beam occupancy is not additive under member changes")
        # A resource touched by only one member cancels identically in the
        # anchored residual.  Omitting its zero coefficients is exact.
        if len(changes) < 2:
            continue
        inc = incoming.get(beam.beam_key, ())
        out = outgoing.get(beam.beam_key, ())
        z = np.asarray(
            [
                float(beam.occupancy_before),
                float(beam.active_before),
                float(beam.shared_capacity),
                float(beam.interference_summary),
                math.fsum(inc),
                math.fsum(out),
                max(inc, default=0.0),
                max(out, default=0.0),
            ],
            dtype=np.float64,
        )
        coefficients: Counter[int] = Counter()
        coefficients[int(beam.occupancy_after)] += 1.0
        coefficients[int(beam.occupancy_before)] += len(changes) - 1.0
        for change in changes:
            coefficients[int(beam.occupancy_before + change)] -= 1.0
        for load, coefficient in sorted(coefficients.items()):
            if coefficient:
                terms.append((z, load, float(coefficient)))
    return tuple(terms)


def _load_index() -> dict[str, Mapping[str, object]]:
    path = CORPUS / "PILOT_NOT_CLAIM-family-index.jsonl"
    result = {}
    with path.open("rb") as handle:
        header = json.loads(next(handle))
        if int(header["row_count"]) != 11924:
            raise RuntimeError("family index row count drifted")
        for line in handle:
            payload = json.loads(line)
            result[str(payload["coalition_row_sha256"])] = payload
    if len(result) != 11924:
        raise RuntimeError("family index identities are not unique")
    return result


def load_rows() -> list[Row]:
    index = _load_index()
    rows: list[Row] = []
    for path in sorted((CORPUS / "rows").glob("world-*/*.jsonl")):
        with path.open("rb") as handle:
            next(handle)
            for line in handle:
                payload = json.loads(line)
                digest = hashlib.sha256(line.rstrip(b"\n")).hexdigest()
                receipt = index[digest]
                context = _context(payload["context"])
                width = len(context.members[0].invariant_features)
                members = tuple(sorted(context.members, key=lambda item: item.user_id))
                pair_members = tuple(
                    (members[first], members[second])
                    for first in range(len(members))
                    for second in range(first + 1, len(members))
                )
                pair_users = tuple((left.user_id, right.user_id) for left, right in pair_members)
                r3_payload = receipt["r3"]
                r3 = None if r3_payload is None else float.fromhex(r3_payload["r3_normalized_hex"])
                if r3_payload is None:
                    pair_targets = (parse_float_hex(payload["psi_normalized_hex"], field="psi"),)
                else:
                    by_users = {
                        tuple(int(value) for value in item["users"]): float.fromhex(item["psi"])
                        for item in r3_payload["pair_psi_normalized_hex"]
                    }
                    pair_targets = tuple(by_users[users] for users in pair_users)
                exact = receipt["exact_objective_receipt"]
                kappa = parse_float_hex(payload["kappa_normalization_bits_hex"], field="kappa")
                singleton_receipts = {int(item["user"]): item for item in exact["singletons"]}
                cache_keys = {
                    int(item["user"]): str(item["key"])
                    for item in receipt["evaluation_cache_keys"]["singletons"]
                }
                resource_terms = _resource_terms(context)
                rows.append(
                    Row(
                        world_id=str(payload["world_id"]),
                        anchor_index=int(payload["anchor_index"]),
                        anchor_id=str(payload["anchor_id"]),
                        configuration_id=str(receipt["configuration_id"]),
                        coalition_size=len(members),
                        families=tuple(str(value) for value in receipt["families"]),
                        psi=parse_float_hex(payload["psi_normalized_hex"], field="psi"),
                        c1=parse_float_hex(payload["c1_normalized_hex"], field="c1"),
                        exact_delta=float(_fraction(exact["objective_delta"]) / Fraction(str(kappa))),
                        material_r3=r3 is not None and abs(r3) > MATERIAL_R3,
                        r3=r3,
                        candidate_features=context.invariant_vector(member_width=width).astype(np.float64),
                        member_invariants=tuple(
                            np.asarray(member.invariant_features, dtype=np.float64) for member in members
                        ),
                        selected_q1=tuple(np.asarray(member.selected_q1_row, dtype=np.float64) for member in members),
                        incumbent_q1=tuple(np.asarray(member.incumbent_q1_row, dtype=np.float64) for member in members),
                        member_users=tuple(member.user_id for member in members),
                        member_selected_actions=tuple(_action_key(member.selected_action) for member in members),
                        member_reference_actions=tuple(_action_key(member.reference_action) for member in members),
                        singleton_keys=tuple(cache_keys[member.user_id] for member in members),
                        singleton_targets=tuple(
                            float(_fraction(singleton_receipts[member.user_id]["difference"]) / Fraction(str(kappa)))
                            for member in members
                        ),
                        pair_features=tuple(_pair_features(left, right) for left, right in pair_members),
                        pair_users=pair_users,
                        pair_targets=pair_targets,
                        resource_terms=resource_terms,
                        resource_structural_zero=not resource_terms,
                    )
                )
    if len(rows) != len(index):
        raise RuntimeError("coalition shards and family index are not one-to-one")
    for row in rows:
        if not math.isclose(row.c1 + row.psi, row.exact_delta, rel_tol=0.0, abs_tol=2e-12):
            raise RuntimeError("row exact delta does not reconstruct from C1 + Psi")
    return rows



