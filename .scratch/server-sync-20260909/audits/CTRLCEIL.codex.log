   454	        "| Rule | Width | Arm | Sum (Gbit/J) | P5 | Q1–Q3 | Median | P95 | Zero-bit users |",
   455	        "|:---|---:|:---:|---:|---:|---:|---:|---:|---:|",
   456	    ]
   457	    for rule in RULES:
   458	        for width in WIDTHS:
   459	            cell = cells[rule][width]  # type: ignore[index]
   460	            for arm in ARMS:
   461	                row = cell["arms"][arm]
   462	                metric = row["attributions"]["activity"]
   463	                q = metric["distribution_all_user_steps"]
   464	                lines.append(
