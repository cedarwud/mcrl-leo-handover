   105	
   106	def scalar_boundary(
   107	    *, architecture, geometry, circuit_power_w: float, roster: tuple[int, ...]
   108	) -> tuple[dict[int, float], dict[str, dict[int, float]], float]:
   109	    """Return rate, two allocated-power maps, and exact network power."""
   110	
   111	    config = runner.RadiationConfig(
   112	        rate_target_bps=RATE_TARGET_BPS,
   113	        fading_quantile_alpha=0.10,
   114	    )
   115	    radiation = architecture.radiate(config, geometry, "realised")
   116	    if not radiation.valid:
   117	        raise RuntimeError("recorded committed configuration became invalid")
   118	
   119	    rates = {user: 0.0 for user in roster}
   120	    activity = {user: 0.0 for user in roster}
   121	    account = {user: 0.0 for user in roster}
   122	    active_users_by_beam: dict[tuple[int, int], set[int]] = defaultdict(set)
   123	
   124	    for slot in radiation.slots:
   125	        positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
   126	        by_satellite: dict[int, list[object]] = defaultdict(list)
   127	        for tx in positive:
   128	            by_satellite[tx.beam[0]].append(tx)
   129	            active_users_by_beam[tx.beam].add(tx.user_id)
   130	            pa_w = pa_supply_power_w(tx.rf_power_w)
   131	            activity[tx.user_id] += slot.fraction * (pa_w + circuit_power_w)
   132	            account[tx.user_id] += slot.fraction * pa_w
   133	        for rows in by_satellite.values():
   134	            share = BASEBAND_POWER_PER_ACTIVE_SATELLITE_W / len(rows)
   135	            for tx in rows:
   136	                activity[tx.user_id] += slot.fraction * share
   137	        for tx in slot.transmissions:
   138	            outcome = tx.realised_outcome
   139	            if outcome is None:
   140	                raise RuntimeError("ACM transmission lacks realised outcome")
   141	            if outcome.decoded:
   142	                rates[tx.user_id] += (
   143	                    slot.fraction
   144	                    * tx.bandwidth_hz
   145	                    * outcome.credited_spectral_efficiency_bit_per_s_hz
   146	                )
   147	
   148	    # Alternative allocation of fixed costs: a chain's circuit cost is shared
   149	    # equally by its assigned transmitting accounts, and a satellite's common
   150	    # baseband cost is shared equally by all such accounts on that satellite.
   151	    active_users_by_satellite: dict[int, set[int]] = defaultdict(set)
   152	    for beam, users in active_users_by_beam.items():
   153	        share = circuit_power_w / len(users)
   154	        for user in users:
   155	            account[user] += share
   156	            active_users_by_satellite[beam[0]].add(user)
   157	    for users in active_users_by_satellite.values():
   158	        share = BASEBAND_POWER_PER_ACTIVE_SATELLITE_W / len(users)
   159	        for user in users:
   160	            account[user] += share
   161	
   162	    # Reconstruct the engine's energy formula independently from the same
   163	    # radiation slots.  Primary V0.25 has no standby or bus draw.
   164	    network_power = 0.0
   165	    for slot in radiation.slots:
   166	        positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
   167	        network_power += slot.fraction * (
   168	            math.fsum(pa_supply_power_w(tx.rf_power_w) + circuit_power_w for tx in positive)
   169	            + len({tx.beam[0] for tx in positive})
   170	            * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
   171	        )
   172	    for label, allocated in (("activity", activity), ("account", account)):
   173	        if not math.isclose(
   174	            math.fsum(allocated.values()), network_power, rel_tol=1e-12, abs_tol=1e-10
   175	        ):
   176	            raise RuntimeError(f"{label} attribution does not conserve boundary energy")
   177	    return rates, {"activity": activity, "account": account}, network_power
   178	
   179	
   180	def replay_profile(*, tape, step_index: int, config, profile, rule: str):
   181	    roster = tuple(sorted(int(user) for user in profile.score.bits))
   182	    if len(roster) != USERS_PER_ANCHOR:
   183	        raise RuntimeError("unexpected user roster")
   184	    architecture = (
   185	        runner.MarginAngleRateTPC_TDM()
   186	        if rule == "margin"
   187	        else runner.AngleRateTPC_TDM()
   188	    )
   189	    circuit = runner.probe.run_setting_for("a-r0").circuit_power_per_active_chain_w
   190	    geometries = tape.geometry_for(step_index=step_index, assignments=config.mapping)
   191	    if len(geometries) != BOUNDARIES:
   192	        raise RuntimeError("unexpected boundary count")
   193	    boundary_rates = []
   194	    boundary_power = {name: [] for name in ATTRIBUTIONS}
   195	    boundary_network_power = []
   196	    for _time_s, geometry in geometries:
   197	        rates, allocated, network_power = scalar_boundary(
   198	            architecture=architecture,
   199	            geometry=geometry,
   200	            circuit_power_w=circuit,
   201	            roster=roster,
   202	        )
   203	        boundary_rates.append(rates)
   204	        boundary_network_power.append(network_power)
   205	        for name in ATTRIBUTIONS:
   206	            boundary_power[name].append(allocated[name])
   207	
   208	    scalar_bits = {user: 0.0 for user in roster}
   209	    energy = {name: {user: 0.0 for user in roster} for name in ATTRIBUTIONS}
   210	    scalar_joules = 0.0
   211	    for index in range(BOUNDARIES - 1):
   212	        scalar_joules += 0.5 * (
   213	            boundary_network_power[index] + boundary_network_power[index + 1]
   214	        ) * STEP_S
   215	        for user in roster:
   216	            scalar_bits[user] += 0.5 * (
   217	                boundary_rates[index][user] + boundary_rates[index + 1][user]
   218	            ) * STEP_S
   219	            for name in ATTRIBUTIONS:
   220	                energy[name][user] += 0.5 * (
   221	                    boundary_power[name][index][user]
   222	                    + boundary_power[name][index + 1][user]
   223	                ) * STEP_S
   224	
   225	    if not math.isclose(scalar_joules, profile.joules, rel_tol=2e-11, abs_tol=2e-7):
   226	        raise RuntimeError(
   227	            f"scalar energy differs from dense replay: {scalar_joules} != {profile.joules}"
   228	        )
   229	    for name in ATTRIBUTIONS:
   230	        if not math.isclose(
   231	            math.fsum(energy[name].values()), profile.joules,
   232	            rel_tol=2e-11, abs_tol=2e-7,
   233	        ):
   234	            raise RuntimeError(f"{name} attribution does not conserve endpoint energy")
   235	    for user in roster:
   236	        if not math.isclose(
   237	            scalar_bits[user], profile.score.bits[user], rel_tol=2e-11, abs_tol=2e-4
   238	        ):
   239	            raise RuntimeError(
   240	                f"scalar bits differ for user {user}: "
   241	                f"{scalar_bits[user]} != {profile.score.bits[user]}"
   242	            )
   243	
   244	    users = []
   245	    for user in roster:
   246	        bits = float(profile.score.bits[user])
   247	        decoding_s = float(profile.score.decoding_time_s[user])
   248	        row = {
   249	            "user_id": user,
   250	            "bits": bits,
   251	            "decoding_time_s": decoding_s,
   252	            "served": bool(profile.score.served_phy[user]),
   253	            "rate_target_attained": bool(profile.score.rate_target_attained[user]),
   254	        }
   255	        for name in ATTRIBUTIONS:
   256	            joules = energy[name][user]
   257	            if bits > 0.0 and joules <= 0.0:
   258	                raise RuntimeError("positive bits without attributed energy")
   259	            row[name] = {
   260	                "joules": joules,
   261	                # An unassigned or failed user-step has zero credited bits and
   262	                # contributes zero.  This makes the 800-row distribution total.
   263	                "ee_bit_per_j": 0.0 if bits == 0.0 else bits / joules,
   264	            }
   265	        users.append(row)
   266	    return users
   267	
