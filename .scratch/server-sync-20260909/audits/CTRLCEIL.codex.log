#!/usr/bin/env python3
"""Reproduce the V0.25 beam-occupancy energy-efficiency diagnostic.

This is a deterministic analytic/numeric map.  It does not train or run a
policy.  The script prints the complete Markdown report to stdout.
"""

from __future__ import annotations

from dataclasses import dataclass
from functools import lru_cache
import math

import numpy as np

from mcrl.physics_v025.acm import ACMMode, ACM_MODES, rate_target_mode, rate_target_sinr
from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
    CIRCUIT_POWER_PER_CHAIN_W,
    ENGINE_VERSION,
    PA_SATURATION_POWER_W,
    RATE_TARGET_BPS,
    RX_GAIN_MAX_DBI,
    TX_FULL_HPBW_DEG,
)
from mcrl.physics_v025.energy import pa_supply_power_w
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.stagec_v025.mechanism_corpus import engine_table_q10


REFERENCE_ELEVATION_DEG = 30.0
REFERENCE_SLANT_KM = 750.0
REFERENCE_OFF_AXIS_DEG = 0.0
OFF_AXIS_GRID_DEG = (0.0, TX_FULL_HPBW_DEG / 4.0, TX_FULL_HPBW_DEG / 2.0)
SLANT_GRID_KM = (500.0, 750.0, 1000.0)
MAX_POPULATION = 24


@dataclass(frozen=True)
class BeamPoint:
    occupancy: int
    required_se: float
    mode: ACMMode
    controller_threshold_linear: float
    controller_threshold_db: float
    required_rf_w: float
    radiated_rf_w: float
    pa_supply_w: float
    total_one_beam_w: float

    @property
    def feasible(self) -> bool:
        return self.required_rf_w <= BEAM_RF_CAP_W

    @property
    def aggregate_delivered_bps(self) -> float:
        # n equal 1/n TDM shares sum back to one full-band mode rate.
        return BEAM_BANDWIDTH_HZ * self.mode.spectral_efficiency_bit_per_s_hz


@dataclass(frozen=True)
class Optimum:
    partition: tuple[int, ...]
    active_beams: int
    active_satellites: int
    delivered_bps: float
    power_w: float
    ee_bits_per_j: float


def nominal_direct_gain(theta_deg: float, slant_km: float, elevation_deg: float) -> float:
    """Use the provider's exact direct-nominal composition."""

    receive_peak = np.asarray(10.0 ** (RX_GAIN_MAX_DBI / 10.0), dtype=np.float64)
    path = LegacyWorldProvider._nominal_path_without_scintillation(
        np.asarray(slant_km, dtype=np.float64),
        np.asarray(elevation_deg, dtype=np.float64),
        receive_peak,
    )
    transmit = transmit_gain_linear(np.asarray(theta_deg, dtype=np.float64))
    return float(transmit * path)


def beam_curve(
    rule: str,
    theta_deg: float = REFERENCE_OFF_AXIS_DEG,
    slant_km: float = REFERENCE_SLANT_KM,
    elevation_deg: float = REFERENCE_ELEVATION_DEG,
) -> dict[int, BeamPoint]:
    if rule not in {"SEALED", "MARGIN"}:
        raise ValueError(rule)
    direct = nominal_direct_gain(theta_deg, slant_km, elevation_deg)
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    divisor = 1.0 if rule == "SEALED" else engine_table_q10(elevation_deg)
    result: dict[int, BeamPoint] = {}
    for occupancy in range(1, 13):
        mode = rate_target_mode(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
        target = rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
        assert mode is not None and target is not None
        required_rf = target * noise / direct / divisor
        radiated = min(required_rf, BEAM_RF_CAP_W)
        pa = pa_supply_power_w(radiated)
        result[occupancy] = BeamPoint(
            occupancy=occupancy,
            required_se=RATE_TARGET_BPS * occupancy / BEAM_BANDWIDTH_HZ,
            mode=mode,
            controller_threshold_linear=target,
            controller_threshold_db=10.0 * math.log10(target),
            required_rf_w=required_rf,
            radiated_rf_w=radiated,
            pa_supply_w=pa,
            total_one_beam_w=pa
            + CIRCUIT_POWER_PER_CHAIN_W
            + BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
        )
    return result


@lru_cache(maxsize=None)
def integer_partitions(total: int, minimum: int = 1) -> tuple[tuple[int, ...], ...]:
    if total == 0:
        return ((),)
    rows: list[tuple[int, ...]] = []
    for first in range(minimum, total + 1):
        for rest in integer_partitions(total - first, first):
            rows.append((first,) + rest)
    return tuple(rows)


def optimise(
    population: int,
    rule: str,
    theta_deg: float = REFERENCE_OFF_AXIS_DEG,
    slant_km: float = REFERENCE_SLANT_KM,
    elevation_deg: float = REFERENCE_ELEVATION_DEG,
    *,
    fixed_costs: bool = True,
    satellite_placement: str = "packed",
) -> Optimum:
    curve = beam_curve(rule, theta_deg, slant_km, elevation_deg)
    candidates: list[Optimum] = []
    for partition in integer_partitions(population):
        if any(size not in curve or not curve[size].feasible for size in partition):
            continue
        beams = len(partition)
        if satellite_placement == "packed":
            satellites = 1
        elif satellite_placement == "separate":
            satellites = beams
        else:
            raise ValueError(satellite_placement)
        delivered = math.fsum(curve[size].aggregate_delivered_bps for size in partition)
        pa = math.fsum(pa_supply_power_w(curve[size].required_rf_w) for size in partition)
        fixed = (
            beams * CIRCUIT_POWER_PER_CHAIN_W
            + satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
            if fixed_costs
            else 0.0
        )
        power = pa + fixed
        candidates.append(
            Optimum(partition, beams, satellites, delivered, power, delivered / power)
        )
    if not candidates:
        raise RuntimeError("no feasible partition")
    # Deterministic tie-break: fewer beams, then lexicographically larger loads.
    return max(candidates, key=lambda row: (row.ee_bits_per_j, -row.active_beams, row.partition))


def partition_text(partition: tuple[int, ...]) -> str:
    return "+".join(str(value) for value in partition)


def first_cap(curve: dict[int, BeamPoint]) -> int | None:
    return next((n for n, row in curve.items() if not row.feasible), None)


def d1_table(rule: str) -> list[str]:
    curve = beam_curve(rule)
    rows = [
        "| n | required SE (bit/s/Hz) | selected mode | target (dB) | RF needed (W) | RF radiated (W) | PA supply (W) | chain+baseband total (W) | RF x to n+1 | total x to n+1 |",
        "|---:|---:|:---|---:|---:|---:|---:|---:|---:|---:|",
    ]
    for n, point in curve.items():
        next_point = curve.get(n + 1)
        growth = "n/a" if next_point is None else f"{next_point.required_rf_w / point.required_rf_w:.4f}"
        total_growth = (
            "n/a"
            if next_point is None
            else f"{next_point.total_one_beam_w / point.total_one_beam_w:.4f}"
        )
        rf_needed = f"{point.required_rf_w:.6f}" + (" **CAP**" if not point.feasible else "")
        rows.append(
            f"| {n} | {point.required_se:.6f} | {point.mode.name} | "
            f"{point.controller_threshold_db:.6f} | {rf_needed} | "
            f"{point.radiated_rf_w:.6f} | {point.pa_supply_w:.6f} | "
            f"{point.total_one_beam_w:.6f} | {growth} | {total_growth} |"
        )
    return rows


def d2_table() -> list[str]:
    rows = [
        "| N | SEALED beams | SEALED occupancies | SEALED EE (Mbit/J) | MARGIN beams | MARGIN occupancies | MARGIN EE (Mbit/J) |",
        "|---:|---:|:---|---:|---:|:---|---:|",
    ]
    for population in range(1, MAX_POPULATION + 1):
        sealed = optimise(population, "SEALED")
        margin = optimise(population, "MARGIN")
        rows.append(
            f"| {population} | {sealed.active_beams} | {partition_text(sealed.partition)} | "
            f"{sealed.ee_bits_per_j / 1e6:.6f} | {margin.active_beams} | "
            f"{partition_text(margin.partition)} | {margin.ee_bits_per_j / 1e6:.6f} |"
        )
    return rows


def d3_table() -> list[str]:
    rows = [
        "| off-axis (deg) | slant (km) | SEALED feasible max n | SEALED N=24 optimum | MARGIN feasible max n | MARGIN N=24 optimum |",
        "|---:|---:|---:|:---|---:|:---|",
    ]
    for theta in OFF_AXIS_GRID_DEG:
        for slant in SLANT_GRID_KM:
            sealed_curve = beam_curve("SEALED", theta, slant)
            margin_curve = beam_curve("MARGIN", theta, slant)
            sealed_max = max(n for n, row in sealed_curve.items() if row.feasible)
            margin_max = max(n for n, row in margin_curve.items() if row.feasible)
            sealed = optimise(24, "SEALED", theta, slant)
            margin = optimise(24, "MARGIN", theta, slant)
            rows.append(
                f"| {theta:.2f} | {slant:.0f} | {sealed_max} | "
                f"{sealed.active_beams} beams: {partition_text(sealed.partition)} | "
                f"{margin_max} | {margin.active_beams} beams: {partition_text(margin.partition)} |"
            )
    return rows


def geometry_summary(rule: str) -> tuple[int, int, int, int, int]:
    changed = 0
    comparisons = 0
    min_beams = 10**9
    max_beams = 0
    occupancy_values: set[int] = set()
    reference = {n: optimise(n, rule).partition for n in range(1, MAX_POPULATION + 1)}
    for theta in OFF_AXIS_GRID_DEG:
        for slant in SLANT_GRID_KM:
            for population in range(1, MAX_POPULATION + 1):
                result = optimise(population, rule, theta, slant)
                comparisons += 1
                changed += result.partition != reference[population]
                min_beams = min(min_beams, result.active_beams)
                max_beams = max(max_beams, result.active_beams)
                occupancy_values.update(result.partition)
    return changed, comparisons, min_beams, max_beams, len(occupancy_values)



