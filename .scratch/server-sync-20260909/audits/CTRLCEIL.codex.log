def summarize_cell(anchors: list[dict[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {"arms": {}}
    flat_by_arm = {
        arm: [
            user
            for anchor in anchors
            for user in anchor["arms"][arm]["users"]  # type: ignore[index]
        ]
        for arm in ARMS
    }
    for arm in ARMS:
        rows = flat_by_arm[arm]
        bits = math.fsum(float(row["bits"]) for row in rows)
        served = sum(bool(row["served"]) for row in rows)
        attained = sum(bool(row["rate_target_attained"]) for row in rows)
        zero_bits = sum(float(row["bits"]) == 0.0 for row in rows)
        arm_summary = {
            "observations": len(rows),
            "bits": bits,
            "served_count": served,
            "served_share": served / len(rows),
            "rate_target_attained_count": attained,
            "rate_target_attained_share": attained / len(rows),
            "zero_credited_bits_count": zero_bits,
            "attributions": {},
        }
        for name in ATTRIBUTIONS:
            joules = math.fsum(float(row[name]["joules"]) for row in rows)
            efficiencies = [float(row[name]["ee_bit_per_j"]) for row in rows]
            arm_summary["attributions"][name] = {  # type: ignore[index]
                "joules": joules,
                "pooled_ee_bit_per_j": bits / joules,
                "summed_per_user_ee_bit_per_j": math.fsum(efficiencies),
                "distribution_all_user_steps": quantiles(efficiencies),
                "distribution_served_user_steps": quantiles(
                    float(row[name]["ee_bit_per_j"])
                    for row in rows
                    if bool(row["served"])
                ),
            }
        result["arms"][arm] = arm_summary  # type: ignore[index]

    paired = {}
    u_rows = flat_by_arm["UNILATERAL"]
    j_rows = flat_by_arm["ORACLE_SET"]
    u_keys = [(row["anchor_id"], row["user_id"]) for row in u_rows]
    j_keys = [(row["anchor_id"], row["user_id"]) for row in j_rows]
    if u_keys != j_keys:
        raise RuntimeError("joint/unilateral user rows are not paired")
    for name in ATTRIBUTIONS:
        changes = [
            float(j[name]["ee_bit_per_j"]) - float(u[name]["ee_bit_per_j"])
            for u, j in zip(u_rows, j_rows, strict=True)
        ]
        u_sum = result["arms"]["UNILATERAL"]["attributions"][name][  # type: ignore[index]
            "summed_per_user_ee_bit_per_j"
        ]
        j_sum = result["arms"]["ORACLE_SET"]["attributions"][name][  # type: ignore[index]
            "summed_per_user_ee_bit_per_j"
        ]
        paired[name] = {
            "better_count": sum(value > 0.0 for value in changes),
            "worse_count": sum(value < 0.0 for value in changes),
            "tied_count": sum(value == 0.0 for value in changes),
            "change_distribution_bit_per_j": quantiles(changes),
            "summed_absolute_change_bit_per_j": j_sum - u_sum,
            "summed_relative_change": relative_gain(j_sum, u_sum),
        }
    result["paired_joint_minus_unilateral"] = paired
    return result


