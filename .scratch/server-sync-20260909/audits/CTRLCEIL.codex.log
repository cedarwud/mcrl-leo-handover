   478	def evaluate_ar_tdm_catalogue(
   479	    arrays: PrimitiveStepArrays,
   480	    selected_rows: np.ndarray,
   260	    def radiate(
   261	        self,
   262	        config: RadiationConfig,
   263	        geometry: Geometry,
   264	        nominal_or_realised: FieldKind,
   265	    ) -> RadiationResult: ...
   266	
   267	
   268	def _beam_members(geometry: Geometry) -> dict[BeamIdentity, tuple[int, ...]]:
   269	    grouped: dict[BeamIdentity, list[int]] = {}
   270	    for index, link in enumerate(geometry.links):
   271	        grouped.setdefault(link.beam, []).append(index)
   272	    return {
   273	        beam: tuple(sorted(indices, key=lambda index: geometry.links[index].user_id))
   274	        for beam, indices in sorted(grouped.items())
   275	    }
   276	
   277	
   278	def _tdm_slots(geometry: Geometry) -> tuple[tuple[float, float, tuple[int, ...]], ...]:
   279	    grouped = _beam_members(geometry)
   280	    if not grouped:
   281	        return ((0.0, 1.0, ()),)
   282	    boundaries = {0.0, 1.0}
   283	    for members in grouped.values():
   284	        boundaries.update(offset / len(members) for offset in range(1, len(members)))
   285	    ordered = sorted(boundaries)
   286	    result = []
   287	    for start, end in zip(ordered, ordered[1:]):
   288	        midpoint = (start + end) / 2.0
   289	        active = tuple(
   290	            members[min(int(midpoint * len(members)), len(members) - 1)]
   291	            for members in grouped.values()
   292	        )
   293	        result.append((start, end, active))
   294	    return tuple(result)
   295	
   296	
   297	def _masked_coupling(
   298	    geometry: Geometry,
   299	    active: tuple[int, ...],
   300	    field: FieldKind,
   301	    overlap: np.ndarray | None = None,
   302	) -> np.ndarray:
   303	    count = len(active)
   304	    coupling = np.zeros((count, count), dtype=np.float64)
   305	    cross = geometry.cross(field)
   306	    for row, victim in enumerate(active):
   307	        victim_link = geometry.links[victim]
   308	        for column, aggressor in enumerate(active):
   309	            aggressor_link = geometry.links[aggressor]
   310	            if victim == aggressor or victim_link.beam == aggressor_link.beam:
   311	                continue
   312	            if victim_link.color != aggressor_link.color:
   313	                continue
   314	            factor = 1.0 if overlap is None else float(overlap[row, column])
   315	            coupling[row, column] = cross[victim, aggressor] * factor
   316	    return coupling
   317	
   318	
   319	def _solve_power(
   320	    direct: np.ndarray,
   321	    coupling: np.ndarray,
   322	    noise: np.ndarray,
   323	    caps: np.ndarray,
   324	    active_user_ids: tuple[int, ...],
   325	    config: RadiationConfig,
   326	    *,
   327	    target_sinr: np.ndarray | None = None,
   328	    force_cap: np.ndarray | None = None,
   329	    enforce_target_clearance: bool = False,
   330	) -> tuple[np.ndarray, PowerCertificate]:
   331	    """Capped standard-interference fixed point, always initialised at zero."""
   332	
   333	    targets = (
   334	        np.full(len(active_user_ids), config.target_sinr, dtype=np.float64)
   335	        if target_sinr is None
   336	        else np.asarray(target_sinr, dtype=np.float64)
   337	    )
   338	    forced = (
   339	        np.zeros(len(active_user_ids), dtype=np.bool_)
   340	        if force_cap is None
   341	        else np.asarray(force_cap, dtype=np.bool_)
   342	    )
   343	    if targets.shape != caps.shape or forced.shape != caps.shape:
   344	        raise MCRLContractError("power target, forced-cap mask, and caps must share shape")
   345	    power = np.zeros(len(active_user_ids), dtype=np.float64)
   346	    residual = math.inf
   347	    recent_changes: list[float] = []
   348	    status: Literal["CONVERGED", "CONVERGED_SLOW"] = "CONVERGED"
   349	    for iteration in range(1, config.solver_iteration_cap + 1):
   350	        updated = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   351	        updated[forced] = caps[forced]
   352	        if not np.all(np.isfinite(updated)) or np.any(
   353	            updated + config.solver_tolerance_w < power
   354	        ):
   355	            return power, PowerCertificate(
   356	                "INVALID", iteration, math.inf, config.solver_tolerance_w
   357	            )
   358	        change = np.abs(updated - power)
   359	        residual = float(np.max(change)) if power.size else 0.0
   360	        relative = float(
   361	            np.max(change / np.maximum(np.abs(updated), np.finfo(float).tiny))
   362	        ) if power.size else 0.0
   363	        recent_changes.append(residual)
   364	        if len(recent_changes) > 1_000:
   365	            recent_changes.pop(0)
   366	        power = updated
   367	        if residual <= config.solver_tolerance_w or relative <= 1.0e-9:
   368	            break
   369	    else:
   370	        if (
   371	            len(recent_changes) == 1_000
   372	            and max(recent_changes) < 1.0e-6
   373	            and all(
   374	                right <= left + np.finfo(float).eps
   375	                for left, right in zip(recent_changes, recent_changes[1:])
   376	            )
   377	        ):
   378	            status = "CONVERGED_SLOW"
   379	        else:
   380	            return power, PowerCertificate(
   381	                "INVALID", config.solver_iteration_cap, residual, config.solver_tolerance_w
   382	            )
   383	    if enforce_target_clearance and power.size:
   384	        # A monotone fixed-point sequence approaches the threshold from below.
   385	        # Preserve the established full-path endpoint by taking one final
   386	        # update, then move one negligible solver-scale step into the
   387	        # certified feasible half-space.
   388	        power = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   389	        power[forced] = caps[forced]
   390	        power = np.minimum(caps, np.nextafter(power * (1.0 + 2.0e-9), np.inf))
   391	        power[forced] = caps[forced]
   392	    return power, PowerCertificate(
   393	        status,
   394	        iteration,
   395	        residual,
   396	        config.solver_tolerance_w,
   397	        tuple(active_user_ids[index] for index in np.flatnonzero(power >= caps - config.solver_tolerance_w)),
   398	    )
   399	
   400	
   401	def _transmissions(
   402	    geometry: Geometry,
   403	    active: tuple[int, ...],
   404	    power: np.ndarray,
   405	    direct: np.ndarray,
   406	    coupling: np.ndarray,
   407	    noise: np.ndarray,
   408	    bandwidth: np.ndarray,
   409	    subbands: tuple[tuple[float, float], ...],
   410	    *,
   411	    rate_target_bps: float | None = None,
   412	    rate_target_sinr_values: tuple[float | None, ...] | None = None,
   413	    rate_target_feasible: tuple[bool, ...] | None = None,
   414	) -> tuple[Transmission, ...]:
   415	    rows = []
   416	    for row, index in enumerate(active):
   417	        link = geometry.links[index]
   418	        intra = 0.0
   419	        inter = 0.0
   420	        for column, aggressor in enumerate(active):
   421	            term = coupling[row, column] * power[column]
   422	            if geometry.links[aggressor].beam[0] == link.beam[0]:
   423	                intra += term
   424	            else:
   425	                inter += term
   426	        rows.append(
   427	            Transmission(
   428	                user_id=link.user_id,
   429	                beam=link.beam,
   430	                rf_power_w=float(power[row]),
   431	                wanted_w=float(power[row] * direct[row]),
   432	                intra_interference_w=float(intra),
   433	                inter_interference_w=float(inter),
   434	                noise_w=float(noise[row]),
   435	                bandwidth_hz=float(bandwidth[row]),
   436	                subband=subbands[row],
   437	                rate_target_bps=rate_target_bps,
   438	                rate_target_sinr=(
   439	                    None if rate_target_sinr_values is None else rate_target_sinr_values[row]
   440	                ),
   441	                rate_target_feasible=(
   442	                    None if rate_target_feasible is None else rate_target_feasible[row]
   443	                ),
   444	            )
   445	        )
   446	    return tuple(rows)
   447	
   448	
   449	def _aggregate_certificates(certificates: list[PowerCertificate]) -> PowerCertificate:
   450	    if not certificates:
   451	        return PowerCertificate("FIXED", 0, 0.0, POWER_SOLVER_TOLERANCE_W)
   452	    invalid = any(c.status == "INVALID" for c in certificates)
   453	    statuses = {c.status for c in certificates}
   454	    status: Literal["FIXED", "CONVERGED", "CONVERGED_SLOW", "INVALID"] = (
   455	        "INVALID"
   456	        if invalid
   457	        else "FIXED"
   458	        if statuses == {"FIXED"}
   459	        else "CONVERGED_SLOW"
   460	        if "CONVERGED_SLOW" in statuses
   461	        else "CONVERGED"
   462	    )
   463	    return PowerCertificate(
   464	        status,
   465	        sum(c.iterations for c in certificates),
   466	        max(c.residual_w for c in certificates),
   467	        certificates[0].tolerance_w,
   468	        tuple(sorted({uid for c in certificates for uid in c.saturated_users})),
   469	    )
   470	
   471	
   472	class FixedRF:
   473	    """Architecture b: fixed 1.65-W RF per active full-band TDM beam."""
   474	
   475	    code: Literal["b"] = "b"
   476	
   477	    def radiate(
   478	        self, config: RadiationConfig, geometry: Geometry, nominal_or_realised: FieldKind
   479	    ) -> RadiationResult:
   480	        direct_all = geometry.gains(nominal_or_realised)
   481	        slots: list[RadiationSlot] = []
