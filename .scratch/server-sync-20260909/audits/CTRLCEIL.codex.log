    69	def configuration_from_id(base, configuration_id: str):
    70	    if configuration_id.startswith("BASE:"):
    71	        if base.configuration_id != configuration_id:
    72	            raise RuntimeError("baseline configuration reconstruction failed")
    73	        return base
    74	    if not configuration_id.startswith("CFG:"):
    75	        raise RuntimeError(f"unexpected configuration id: {configuration_id}")
    76	    mapping = {}
    77	    for assignment in configuration_id[4:].split(";"):
    78	        user, norad, chain = assignment.split(":")
    79	        mapping[int(user)] = (int(norad), int(chain))
    80	    config = runner.probe._configuration(base, mapping, kind="per-user-replay")
    81	    if config.configuration_id != configuration_id:
    82	        raise RuntimeError("configuration reconstruction failed")
    83	    return config
