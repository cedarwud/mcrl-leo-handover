def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--receipt", type=Path, default=HERE / "per-user-metric.json"
    )
    parser.add_argument(
        "--report", type=Path, default=REPO / "PER-USER-METRIC-2026-09-10.md"
    )
    args = parser.parse_args()

    receipt_paths = {
        rule: {
            width: HERE
            / f"{'sealed-diagnostics' if rule == 'sealed' else 'margin-sweep'}-one-sided-{width}.json"
            for width in WIDTHS
        }
        for rule in RULES
    }
    sources = {
        rule: {
            width: json.loads(path.read_text(encoding="ascii"))
            for width, path in receipt_paths[rule].items()
        }
        for rule in RULES
    }
    result = {
        "schema": "mcrl-v025-beamwidth-per-user-metric-v1",
        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
        "selection_rerun": False,
        "physics_replay": "recorded committed configurations only",
        "widths_one_sided_deg": list(WIDTHS),
        "rules": list(RULES),
        "arms": list(ARMS),
        "user_observations_per_cell": 800,
        "quantile_method": "numpy linear (Hyndman-Fan type 7)",
        "zero_efficiency_rule": "zero credited bits maps to zero EE, including zero-joule unassigned user-steps",
        "attribution_definitions": {
            "activity": (
                "PA and active-chain circuit draw to the slot transmitter; "
                "active-satellite baseband draw equally across concurrent active chain-users"
            ),
            "account": (
                "PA to the slot transmitter; active-chain circuit draw equally across "
                "assigned transmitting beam accounts; active-satellite baseband draw "
                "equally across assigned transmitting satellite accounts"
            ),
        },
        "source_receipts": {
            rule: {
                width: {"path": str(path.relative_to(REPO)), "sha256": sha256(path)}
                for width, path in receipt_paths[rule].items()
            }
            for rule in RULES
        },
        "cells": {rule: {} for rule in RULES},
    }

    for width in WIDTHS:
        runner.channel_module.TX_FULL_HPBW_DEG = 2.0 * float(width)
        tapes = {}
        reference = sources["margin"][width]
        for world_index in (1, 2):
            tape = runner.probe.build_world_tape(
                domain=runner.probe.PROBE_WORLD_DOMAINS[world_index - 1],
                provider=factory(),
                steps=4,
                start_time_s=0.0,
            )
            expected = next(
                row for row in reference["worlds"] if row["world_index"] == world_index
            )
            if tape.digest != expected["world_sha256"]:
                raise RuntimeError("world digest mismatch")
            tapes[world_index] = tape

        for rule in RULES:
            runner.PROVISIONING_RULE = rule
            runner.probe.evaluate_ar_tdm_catalogue = (
                margin_batch.evaluate_ar_tdm_catalogue
                if rule == "margin"
                else sealed_batch.evaluate_ar_tdm_catalogue
            )
            source_receipt = sources[rule][width]
            anchors = []
            for recorded in source_receipt["anchors"]:
                tape = tapes[int(recorded["world_index"])]
                step_index = int(recorded["step_index"])
                base = runner.probe._base_configuration(
                    tape, step_index, "nearest-eligible"
                )
                configs = {
                    arm: configuration_from_id(
                        base, recorded["committed"][arm]["configuration_id"]
                    )
                    for arm in ARMS
                }
                evaluator = runner.probe.StepEvaluator(
                    tape,
                    runner.probe._setting("a-r0"),
                    step_index,
                    transition_from=base,
                    field="realised",
                    run_setting=runner.probe.run_setting_for("a-r0"),
                    boundary_indices=tuple(range(BOUNDARIES)),
                    fading_quantile_alpha=0.10,
                )
                evaluator.evaluate_many(tuple(configs.values()))
                anchor = {
                    "anchor_id": recorded["anchor_id"],
                    "world_index": recorded["world_index"],
                    "step_index": step_index,
                    "arms": {},
                }
                for arm in ARMS:
                    profile = evaluator.evaluate(configs[arm])
                    old = recorded["committed"][arm]
                    if (
                        profile.bits.hex() != float(old["bits"]).hex()
                        or profile.joules.hex() != float(old["joules"]).hex()
                        or runner.served(profile) != int(old["served_count"])
                    ):
                        raise RuntimeError(
                            f"dense committed replay mismatch: {rule} {width} "
                            f"{recorded['anchor_id']} {arm}"
                        )
                    users = replay_profile(
                        tape=tape,
                        step_index=step_index,
                        config=configs[arm],
                        profile=profile,
                        rule=rule,
                    )
                    for user in users:
                        user["anchor_id"] = recorded["anchor_id"]
                    anchor["arms"][arm] = {
                        "configuration_id": configs[arm].configuration_id,
                        "users": users,
                    }
                anchors.append(anchor)
                print(
                    json.dumps(
                        {
                            "completed": recorded["anchor_id"],
                            "rule": rule,
                            "width": width,
                        },
                        sort_keys=True,
                    ),
                    flush=True,
                )
            cell = summarize_cell(anchors)
            cell["anchors"] = anchors
            result["cells"][rule][width] = cell

    args.receipt.parent.mkdir(parents=True, exist_ok=True)
    args.receipt.write_text(
        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    render_report(result, args.report, args.receipt)
    print(json.dumps({"receipt": str(args.receipt), "report": str(args.report)}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


def evaluate_anchor(*, tape, world_index: int, step_index: int, pool=None) -> dict[str, object]:
    setting = probe._setting("a-r0")
    run_setting = probe.run_setting_for("a-r0")
    base = probe._base_configuration(tape, step_index, "nearest-eligible")
    selection = ParallelSelectionEvaluator(tape, step_index, base, pool)
    started = time.perf_counter()
    coordinate = coordinate_optimum(
        tape=tape,
        step_index=step_index,
        base=base,
        evaluator=selection,
    )
    unilateral = coordinate.selected
    before_joint_evaluations = selection.physical_evaluations
    candidates, aliases, family_counts = build_joint_candidates(
        tape=tape,
        step_index=step_index,
        base=base,
        unilateral=unilateral,
        best_alternatives=coordinate.best_alternatives,
    )
    selection.evaluate_many(candidates)
    base_profile = selection.evaluate(base)
    unilateral_profile = selection.evaluate(unilateral)
    guard = served(base_profile)
    best = unilateral
    best_profile = unilateral_profile
    for candidate in candidates:
        profile = selection._evaluated.get(candidate.configuration_id)
        if profile is None or served(profile) < guard:
            continue
        value = objective(profile)
        best_value = objective(best_profile)
        if value > best_value or (
            value == best_value
            and best is not unilateral
            and candidate.configuration_id < best.configuration_id
        ):
            best, best_profile = candidate, profile

    coalition_users = tuple(
        user
        for user in sorted(unilateral.mapping)
        if unilateral.mapping[user] != best.mapping[user]
    )
    psi = Fraction()
    singleton_sum = Fraction()
    if coalition_users:
        for user in coalition_users:
            mapping = unilateral.mapping
            mapping[user] = best.mapping[user]
            singleton = _configuration(base, mapping, "oracle-singleton-component")
            singleton_profile = selection.evaluate(singleton)
            singleton_sum += objective(singleton_profile) - objective(unilateral_profile)
        psi = (
            objective(best_profile)
            - objective(unilateral_profile)
            - singleton_sum
        )

    committed_counter = probe.EvaluationCounter()
    committed = probe.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=base,
        field="realised",
        counter=committed_counter,
        run_setting=run_setting,
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    unique = {
        row.configuration_id: row for row in (base, unilateral, best)
    }
    committed.evaluate_many(tuple(unique.values()))

    profiles = {
        "BASELINE": committed.evaluate(base),
        "UNILATERAL": committed.evaluate(unilateral),
        "ORACLE_SET": committed.evaluate(best),
    }
    structure = {
        "BASELINE": interference_structure(
            tape=tape, step_index=step_index, selected=base
        ),
        "UNILATERAL": interference_structure(
            tape=tape, step_index=step_index, selected=unilateral
        ),
        "ORACLE_SET": interference_structure(
            tape=tape, step_index=step_index, selected=best
        ),
    }
    chosen_aliases = aliases.get(best.assignments, ())
    qualifying = bool(coalition_users) and objective(best_profile) > objective(
        unilateral_profile
    )
    row = {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "world_domain": tape.domain,
        "world_sha256": tape.digest,
        "tle_date": tape.tle_date,
        "training_seed": tape.training_seed,
        "step_index": step_index,
        "selection": {
            "field": "realised",
            "boundary_indices": [0],
            "held_snapshot_seconds": 30.08,
            "eta_ref": frac_payload(ETA_REF),
            "baseline_served_guard": guard,
            "unilateral_iterations": coordinate.iterations,
            "unilateral_passes": coordinate.passes,
            "unilateral_terminal_certified": True,
            "unilateral_candidate_comparisons": coordinate.candidate_comparisons,
            "joint_catalogue_unique": len(candidates),
            "joint_catalogue_aliases": sum(len(value) for value in aliases.values()),
            "joint_family_unique_counts": family_counts,
            "qualifying_coalition_existed": qualifying,
            "selected_coalition_size": len(coalition_users) if qualifying else 0,
            "selected_coalition_users": list(coalition_users) if qualifying else [],
            "selected_candidate_aliases": list(chosen_aliases) if qualifying else [],
            "selected_joint_served": served(best_profile),
            "selected_joint_F_gain_bits": float(
                objective(best_profile) - objective(unilateral_profile)
            ),
            "selected_singleton_sum_bits": float(singleton_sum),
            "selected_Psi_A_bits": float(psi),
            "selected_Psi_A_exact": frac_payload(psi),
class EvaluatedProfile:
    config: Configuration
    score: CellScore
    energy_components: Mapping[str, float]
    lit_beam_seconds: float
    lit_satellite_seconds: float
    acm_mode_counts: Mapping[str, int]
    se_plateau_user_steps: int
    user_step_observations: int
    rf_cap_hits: int
    rf_transmission_observations: int
    treatment_t_same_instant_comparison: Mapping[str, object] | None
    certificate_status: str = "CONVERGED"
    certificate_iterations: int = 0
    required_power_w_max: float = 0.0
    min_decoding_margin_db: float = -100.0
    mean_acm_se_bit_s_hz: float = 0.0
    m_target_counts: Mapping[str, int] = None  # type: ignore[assignment]
    m_tx_counts: Mapping[str, int] = None  # type: ignore[assignment]
    realised_decode_successes: int = 0
    realised_decode_failures: int = 0

    @property
    def bits(self) -> float:
        return math.fsum(self.score.bits.values())

    @property
    def joules(self) -> float:
        return self.score.joules

    def outcome(self, *, phi: Fraction = Fraction()) -> NetworkOutcome:
        opportunities = max(1, len(self.score.bits)) * DECISION_INTERVAL_S
        decoding = math.fsum(self.score.decoding_time_s.values()) / opportunities
        useful = math.fsum(self.score.useful_time_s.values()) / opportunities
        return NetworkOutcome.build(
            bits=sum((Fraction(str(value)) for value in self.score.bits.values()), Fraction()),
            joules=self.joules,
            phi=phi,
            decoding_availability=min(1.0, max(0.0, decoding)),
            useful_availability=min(1.0, max(0.0, useful)),
            per_user_bits=self.score.bits,
        )


@dataclass(frozen=True)
class SelectionProfile:
    """Minimal stage-1 result transferred from a worker to the coordinator."""

    config: Configuration
    bits: float
    joules: float
    served_count: int


@dataclass
class EvaluationCounter:
    boundary_evaluations: int = 0


_SELECTION_WORKER_CONTEXT: dict[str, object] | None = None


def _deterministic_shards(
    configs: Sequence[Configuration], workers: int
) -> tuple[tuple[Configuration, ...], ...]:
    """Round-robin configuration shards with a stable worker assignment."""

    if type(workers) is not int or workers < 1:
        raise ProbeError("selection worker count must be a positive integer")
    return tuple(tuple(configs[index::workers]) for index in range(workers))


def _selection_worker_stage1(
    task: tuple[int, tuple[Configuration, ...]],
) -> tuple[int, tuple[SelectionProfile, ...], tuple[str, ...], int]:
    """Evaluate one deterministic k=0 shard in a forked worker process."""

    if _SELECTION_WORKER_CONTEXT is None:
        raise ProbeError("selection worker context was not installed before fork")
    shard_index, configs = task
    context = _SELECTION_WORKER_CONTEXT
    evaluator = StepEvaluator(
        context["tape"],  # type: ignore[arg-type]
        context["setting"],  # type: ignore[arg-type]
        int(context["step_index"]),
        transition_from=context["incumbent"],  # type: ignore[arg-type]
        cell_rekeyed_users=context["cell_rekeys"],  # type: ignore[arg-type]
        previously_served_users=context["previously_served_users"],  # type: ignore[arg-type]
        field=(
            "nominal" if context["selection_alpha"] is None else "margin"
        ),
        fading_quantile_alpha=(
            None
            if context["selection_alpha"] is None
            else float(context["selection_alpha"])
        ),
        run_setting=context["run_setting"],  # type: ignore[arg-type]
        boundary_indices=(0,),
    )
    evaluator.evaluate_many(configs)
    profiles = tuple(
        SelectionProfile(
            config,
            evaluator._evaluated[config.configuration_id].bits,
            evaluator._evaluated[config.configuration_id].joules,
            sum(
                evaluator._evaluated[
                    config.configuration_id
                ].score.served_phy.values()
            ),
        )
        for config in configs
        if config.configuration_id in evaluator._evaluated
    )
    invalid = tuple(
        config.configuration_id
        for config in configs
        if config.configuration_id in evaluator._invalid
    )
    return shard_index, profiles, invalid, evaluator.physical_evaluations


def _selection_worker_stage2(
    task: tuple[int, tuple[Configuration, ...], tuple[int, ...]],
) -> tuple[
    int,
    dict[str, tuple[OffsetProjection, ...]],
    tuple[dict[str, object], ...],
    int,
]:
    """Evaluate every offset for one shortlist shard in a worker process."""
