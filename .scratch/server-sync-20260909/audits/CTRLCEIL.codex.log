   195	        beam_code = row_beam_code[safe_rows]
   196	        victim_color = arrays.colors[safe_rows]
   197	        wanted_slot = arrays.row_wanted_slot[safe_rows]
   198	        aggressor_color = victim_color
   199	        aggressor_satellite = row_satellite[safe_rows]
   200	        aggressor_norad = arrays.identities[safe_rows, 0]
   201	        previous_rate = previous_decode = previous_energy = None
   202	
   203	        previous_boundary = None
   204	        for boundary in boundary_indices:
   205	            live = valid_assignment & arrays.visible[boundary, safe_rows] \
   206	                & arrays.d2_eligible[boundary, safe_rows] \
   207	                & arrays.cell_reachable[boundary, safe_rows]
   208	            same_beam = beam_code[:, :, None] == beam_code[:, None, :]
   209	            occupancy = np.sum(same_beam & live[:, None, :], axis=2)
   210	            maximum = int(np.max(occupancy, initial=1))
   211	            fractions, midpoints = _slot_grid(maximum)
   212	            boundary_rate = np.zeros((count, users), dtype=np.float64)
   213	            boundary_decode = np.zeros((count, users), dtype=np.bool_)
   214	            boundary_feasible = np.zeros((count, users), dtype=np.bool_)
   215	            boundary_energy = np.zeros((count, 3), dtype=np.float64)
   216	            rank = np.sum(same_beam & live[:, None, :] & lower_user, axis=2)
   217	            direct_nominal = arrays.nominal_gain[boundary, safe_rows]
   218	            direct_field = (
   219	                direct_nominal
   220	                if field == "nominal"
   221	                else arrays.realised_gain[boundary, safe_rows]
   222	            )
   223	            base_cross = arrays.cross_base_nominal[
   224	                boundary,
   225	                user_axis[None, :, None],
   226	                safe_aggressor[:, None, :],
   227	            ]
   228	            receive = arrays.receive_gain_by_wanted_slot[
   229	                boundary,
   230	                user_axis[None, :, None],
   231	                wanted_slot[:, :, None],
   232	                aggressor_satellite[:, None, :],
   233	            ]
   234	            nominal_cross = base_cross * receive
   235	            colour_mask = victim_color[:, :, None] == aggressor_color[:, None, :]
   236	            available_aggressor = aggressor[:, None, :] >= 0
   237	            nominal_cross *= colour_mask & ~same_beam & available_aggressor
   238	            if field == "realised":
   239	                field_cross = nominal_cross * arrays.fading_by_satellite[
   240	                    boundary,
   241	                    user_axis[None, :, None],
   242	                    aggressor_satellite[:, None, :],
   243	                ]
   244	            else:
   245	                field_cross = nominal_cross
   246	
   247	            for fraction, midpoint in zip(fractions, midpoints, strict=True):
   248	                active = live & (rank == np.floor(midpoint * occupancy).astype(np.int64))
   249	                active_pair = active[:, :, None] & active[:, None, :]
   250	                coupling = nominal_cross * active_pair
   251	                targets = gamma[np.minimum(occupancy, users)]
   252	                forced = active & np.isnan(targets)
   253	                targets = np.nan_to_num(targets, nan=1.0)
   254	                power = np.zeros((count, users), dtype=np.float64)
   255	                residual = np.full(count, math.inf, dtype=np.float64)
   256	                done = np.zeros(count, dtype=np.bool_)
   257	                invalid = np.zeros(count, dtype=np.bool_)
   258	                recent_changes: list[np.ndarray] = []
   259	                for iteration in range(1, POWER_SOLVER_ITERATION_CAP + 1):
   260	                    interference = np.matmul(coupling, power[..., None])[..., 0]
   261	                    updated = np.minimum(
   262	                        BEAM_RF_CAP_W,
   263	                        targets * (noise + interference) / direct_nominal,
   264	                    )
   265	                    updated = np.where(active, updated, 0.0)
   266	                    updated[forced] = BEAM_RF_CAP_W
   267	                    bad = ~np.all(np.isfinite(updated), axis=1) | np.any(
   268	                        updated + POWER_SOLVER_TOLERANCE_W < power, axis=1
   269	                    )
   270	                    invalid |= bad
   271	                    change = np.abs(updated - power)
   272	                    next_residual = np.max(change, axis=1)
   273	                    relative = np.max(
   274	                        change
   275	                        / np.maximum(np.abs(updated), np.finfo(float).tiny),
   276	                        axis=1,
   277	                    )
   278	                    newly_done = (~invalid) & (
   279	                        (next_residual <= POWER_SOLVER_TOLERANCE_W)
   280	                        | (relative <= 1.0e-9)
   281	                    )
   282	                    active_solver = ~(done | invalid)
   283	                    power = np.where(active_solver[:, None], updated, power)
   284	                    residual = np.where(active_solver, next_residual, residual)
   285	                    done |= newly_done
   286	                    recent_changes.append(next_residual.copy())
   287	                    if len(recent_changes) > 1_000:
   288	                        recent_changes.pop(0)
   289	                    if bool(np.all(done | invalid)):
   290	                        break
   291	                slow = np.zeros(count, dtype=np.bool_)
   292	                unfinished = ~(done | invalid)
   293	                if np.any(unfinished) and len(recent_changes) == 1_000:
   294	                    history = np.stack(recent_changes, axis=0)
   295	                    monotone = np.all(
   296	                        history[1:] <= history[:-1] + np.finfo(float).eps,
   297	                        axis=0,
   298	                    )
   299	                    slow = unfinished & (np.max(history, axis=0) < 1.0e-6) & monotone
   300	                    done |= slow
   301	                invalid |= ~done
   302	                slot_status = np.where(invalid, 0, np.where(slow, 2, 1)).astype(np.int8)
   303	                destination = slice(low, high)
   304	                certificate_status[destination] = np.where(
   305	                    (certificate_status[destination] == 0) | (slot_status == 0),
   306	                    0,
   307	                    np.maximum(certificate_status[destination], slot_status),
   308	                )
   309	                certificate_iterations[destination] += iteration
   310	                residual_max[low:high] = np.maximum(residual_max[low:high], residual)
   311	                valid_result[low:high] &= ~invalid
   312	                # Preserve the pre-stage-4c full-path endpoint exactly: both
   313	                # scalar and batch paths take one final fixed-point update
   314	                # before the target-clearance nudge.  Status classification
   315	                # still uses the bounded loop above.
   316	                final = np.minimum(
   317	                    BEAM_RF_CAP_W,
   318	                    targets
   319	                    * (
   320	                        noise
   321	                        + np.matmul(coupling, power[..., None])[..., 0]
   322	                    )
   323	                    / direct_nominal,
   324	                )
   325	                final = np.where(active, final, 0.0)
   326	                final[forced] = BEAM_RF_CAP_W
   327	                power = np.minimum(
   328	                    BEAM_RF_CAP_W,
   329	                    np.nextafter(final * (1.0 + 2.0e-9), np.inf),
   330	                )
   331	                power = np.where(active, power, 0.0)
   332	                power[forced] = BEAM_RF_CAP_W
   333	                realised_interference = np.matmul(
   334	                    field_cross * active_pair, power[..., None]
   335	                )[..., 0]
   336	                sinr = np.where(
   337	                    active,
   338	                    power * direct_field / (noise + realised_interference),
   339	                    0.0,
   340	                )
   341	                safe_sinr = np.maximum(sinr, np.finfo(float).tiny)
   342	                active_margin = np.where(
   343	                    active,
   344	                    10.0 * np.log10(safe_sinr) - SINR_MIN_DB,
   345	                    np.inf,
   346	                )
   347	                min_decoding_margin_db[low:high] = np.minimum(
   348	                    min_decoding_margin_db[low:high],
   349	                    np.min(active_margin, axis=1),
   350	                )
   351	                max_rf_power_w[low:high] = np.maximum(
   352	                    max_rf_power_w[low:high], np.max(power, axis=1)
   353	                )
   354	                eligible_modes = sinr[:, :, None] >= thresholds[None, None, :]
   355	                mode_index = np.argmax(
   356	                    np.where(eligible_modes, efficiencies[None, None, :], -1.0),
   357	                    axis=2,
   358	                )
   359	                served = active & np.any(eligible_modes, axis=2)
   360	                chosen_efficiency = efficiencies[mode_index]
   361	                slot_rate = np.where(served, chosen_efficiency * BEAM_BANDWIDTH_HZ, 0.0)
   362	                acm_se_sum[low:high] += np.sum(
   363	                    np.where(active & served, chosen_efficiency, 0.0), axis=1
   364	                )
   365	                acm_se_count[low:high] += np.sum(active, axis=1)
   366	                boundary_rate += fraction * slot_rate
   367	                boundary_decode |= served
   368	                nominal_sinr = np.where(
   369	                    active,
   370	                    power
   371	                    * direct_nominal
   372	                    / (
   373	                        noise
   374	                        + np.matmul(coupling, power[..., None])[..., 0]
   375	                    ),
   376	                    0.0,
   377	                )
   378	                boundary_feasible |= active & ~forced & (nominal_sinr >= targets)
   379	                flat_config, flat_user = np.nonzero(active)
   380	                flat_modes = np.where(
   381	                    served[flat_config, flat_user],
   382	                    mode_index[flat_config, flat_user] + 1,
   383	                    0,
   384	                )
   385	                np.add.at(mode_counts[low:high], (flat_config, flat_modes), 1)
   386	                seen[low:high] |= active
   387	                top_mode_index = int(np.argmax(efficiencies))
   388	                plateau[low:high] &= ~active | (mode_index == top_mode_index)
   389	                transmissions[low:high] += np.sum(active, axis=1)
   390	                cap_hits[low:high] += np.sum(
   391	                    active & (power >= BEAM_RF_CAP_W - 1.0e-9), axis=1
   392	                )
   393	                pa_w = np.sum(
   394	                    np.where(
   395	                        active & (power > 0.0),
   396	                        np.sqrt(power * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY,
   397	                        0.0,
   398	                    ),
   399	                    axis=1,
   400	                )
   401	                circuit_w = np.sum(active & (power > 0.0), axis=1) * circuit_power_per_active_chain_w
   402	                same_sat = aggressor_norad[:, :, None] == aggressor_norad[:, None, :]
   403	                earlier_active_sat = np.any(
   404	                    same_sat & (active[:, None, :] & lower_user), axis=2
   405	                )
   406	                active_satellites = np.sum(active & ~earlier_active_sat, axis=1)
   407	                boundary_energy += fraction * np.stack(
   408	                    (
   409	                        pa_w,
   410	                        circuit_w,
   411	                        active_satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
   412	                    ),
   413	                    axis=1,
   414	                )
   415	
   416	            # The scalar roster path records a missing in-step transmission as
   417	            # infeasible, rather than silently dropping that user.
   418	            feasible_all[low:high] &= boundary_feasible
   419	            if previous_rate is not None and previous_boundary is not None:
   420	                elapsed_s = (boundary - previous_boundary) * D2_MEASUREMENT_STEP_S
   421	                bits[low:high] += 0.5 * (previous_rate + boundary_rate) * elapsed_s
   422	                decoding[low:high] += 0.5 * (
   423	                    previous_decode.astype(np.float64) + boundary_decode.astype(np.float64)
   424	                ) * elapsed_s
   425	                components[low:high] += 0.5 * (previous_energy + boundary_energy) * elapsed_s
   426	            previous_rate = boundary_rate
   427	            previous_decode = boundary_decode
   428	            previous_energy = boundary_energy
   429	            previous_boundary = boundary
   430	
   431	        # A one-boundary nominal snapshot is a decision-instant score held
   432	        # over the decision interval.  Multi-boundary grids use trapezoids.
   433	        if len(boundary_indices) == 1 and previous_rate is not None:
   434	            duration_s = 47 * D2_MEASUREMENT_STEP_S
   435	            bits[low:high] += previous_rate * duration_s
   436	            decoding[low:high] += previous_decode.astype(np.float64) * duration_s
   437	            components[low:high] += previous_energy * duration_s
   438	
   439	    joules = np.sum(components, axis=1)
   440	    attained = bits >= rate_target_bps * (47 * D2_MEASUREMENT_STEP_S)
   441	    return BatchARResult(
   442	        *(
   443	            _readonly(value)
   444	            for value in (
   445	                bits[inverse_order],
   446	                joules[inverse_order],
   447	                components[inverse_order, 0],
   448	                components[inverse_order, 1],
   449	                components[inverse_order, 2],
   450	                decoding[inverse_order],
   451	                feasible_all[inverse_order],
   452	                attained[inverse_order],
   453	                residual_max[inverse_order],
   454	                mode_counts[inverse_order],
   455	                np.sum(plateau & seen, axis=1)[inverse_order],
   456	                transmissions[inverse_order],
   457	                cap_hits[inverse_order],
   458	                valid_result[inverse_order],
   459	                certificate_status[inverse_order],
   460	                certificate_iterations[inverse_order],
   461	                max_rf_power_w[inverse_order],
   462	                np.where(
   463	                    np.isfinite(min_decoding_margin_db[inverse_order]),
   464	                    min_decoding_margin_db[inverse_order],
   465	                    -100.0,
   466	                ),
   467	                np.divide(
   468	                    acm_se_sum[inverse_order],
   469	                    acm_se_count[inverse_order],
   470	                    out=np.zeros(configurations, dtype=np.float64),
   471	                    where=acm_se_count[inverse_order] > 0,
   472	                ),
   473	            )
   474	        )
   475	    )
