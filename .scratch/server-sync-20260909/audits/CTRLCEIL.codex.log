+def aggregate_decomposition(anchors: Sequence[Mapping[str, object]], pooled: Mapping[str, object]) -> dict:
+    dimensions = ("cap_status", "occupancy", "elevation", "off_axis", "component")
+    pooled_gap = float(pooled["gap"]["absolute_mbit_per_j"])  # type: ignore[index]
+    c2_j = float(pooled["c2_best_known"]["joules"])  # type: ignore[index]
+    result = {}
+    for dimension in dimensions:
+        surplus_by_bucket: dict[str, float] = defaultdict(float)
+        for anchor in anchors:
+            anchor_j = float(anchor["c2_best_known"]["joules"])  # type: ignore[index]
+            for row in anchor["decomposition"][dimension]:  # type: ignore[index]
+                surplus_by_bucket[str(row["bucket"])] += (
+                    float(row["gap_contribution_mbit_per_j"]) * 1e6 * anchor_j
+                )
+        total = math.fsum(surplus_by_bucket.values())
+        changed_by_bucket: dict[str, int] = defaultdict(int)
+        for anchor in anchors:
+            for row in anchor["decomposition"][dimension]:  # type: ignore[index]
+                changed_by_bucket[str(row["bucket"])] += int(row["changed_boundary_slot_links"])
+        result[dimension] = [
+            {
+                "bucket": key,
+                "gap_contribution_mbit_per_j": value / c2_j / 1e6,
+                "signed_share_pct": 100.0 * value / total,
+                "changed_boundary_slot_links": changed_by_bucket[key],
+            }
+            for key, value in sorted(surplus_by_bucket.items())
+        ]
+        if not math.isclose(math.fsum(float(r["gap_contribution_mbit_per_j"])
+                                      for r in result[dimension]),
+                            pooled_gap, rel_tol=3e-10, abs_tol=3e-10):
+            raise RuntimeError("pooled decomposition failed to conserve gap")
+    return result
+
+
+def self_test() -> None:
+    if not FRONTIER or any(
+        ACM_MODES[b].spectral_efficiency_bit_per_s_hz <=
+        ACM_MODES[a].spectral_efficiency_bit_per_s_hz
+        for a, b in zip(FRONTIER, FRONTIER[1:])
+    ):
+        raise RuntimeError("ACM frontier construction failed")
+    direct = np.asarray([2.0, 1.5])
+    coupling = np.asarray([[0.0, 0.1], [0.2, 0.0]])
+    gamma = np.asarray([0.5, 0.7])
+    noise = np.asarray([0.01, 0.02])
+    matrix = np.eye(2) - gamma[:, None] * coupling / direct[:, None]
+    rhs = gamma * noise / direct
+    power = np.linalg.solve(matrix, rhs)
+    achieved = power * direct / (noise + coupling @ power)
+    if not np.allclose(achieved, gamma, rtol=2e-14, atol=2e-14):
+        raise RuntimeError("inner coupled power identity failed")
+    print(json.dumps({"self_test": "PASS", "frontier_modes": len(FRONTIER)}))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--receipt", type=Path,
+                        default=REPO / ".scratch/control-law-ceiling/control-law-ceiling.json")
+    parser.add_argument("--report", type=Path,
+                        default=REPO / "CONTROL-LAW-CEILING-2026-09-10.md")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if args.self_test:
+        self_test()
+        return 0
+    for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
+        if os.environ.get(name) != "1":
+            raise RuntimeError(f"{name}=1 is required by the shared-machine process contract")
+    sources = {}
+    for rule, path in SOURCE_RECEIPTS.items():
+        actual = sha256(path)
+        if actual != EXPECTED_SOURCE_SHA256[rule]:
+            raise RuntimeError(f"source receipt hash mismatch for {rule}: {actual}")
+        sources[rule] = json.loads(path.read_text(encoding="ascii"))
+    runner.channel_module.TX_FULL_HPBW_DEG = 2.0 * ONE_SIDED_HP_DEG
+    started = time.time()
+    result = {
+        "schema": "mcrl-v025-control-law-fixed-assignment-best-known-v1",
+        "claim_ceiling": CLAIM,
+        "optimality_status": "best-known; not a certified ceiling",
+        "max_workers": 1,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "source_receipts": {
+            rule: {"path": str(path), "sha256": sha256(path)}
+            for rule, path in SOURCE_RECEIPTS.items()
+        },
+        "constants_replayed_unchanged": {
+            "beam_rf_cap_w": BEAM_RF_CAP_W,
+            "rate_target_bps": RATE_TARGET_BPS,
+            "beam_bandwidth_hz": BEAM_BANDWIDTH_HZ,
+            "pa_saturation_power_w": PA_SATURATION_POWER_W,
+            "pa_max_efficiency": PA_MAX_EFFICIENCY,
+            "circuit_power_per_active_chain_w": CIRCUIT_POWER_PER_CHAIN_W,
+            "baseband_power_per_active_satellite_w": BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
+        },
+        "search_contract": {
+            "assignment": "fixed per rule/anchor at recorded J_from_first commit",
+            "outer": "Dinkelbach iterations; deterministic two-order coordinate ascent",
+            "inner": "direct binary64 solve of exact realised coupled minimum-power equations",
+            "service_constraint": "each C1-decoded link retains or improves its mode",
+            "mode_candidates": [ACM_MODES[i].name for i in FRONTIER],
+            "certified": False,
+        },
+        "rules": {},
+    }
+    # Build each world once and retain its provider for off-axis reconstruction.
+    worlds = {}
+    reference_anchors = {a["anchor_id"]: a for a in sources["STRICT"]["anchors"]}
+    for world_index in (1, 2):
+        domain = runner.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        provider = factory()
+        tape = runner.probe.build_world_tape(
+            domain=domain, provider=provider, steps=4, start_time_s=0.0
+        )
+        expected = next(a for a in reference_anchors.values()
+                        if int(a["world_index"]) == world_index)
+        if tape.digest != expected["world_sha256"]:
+            raise RuntimeError("world tape digest mismatch")
+        worlds[world_index] = (tape, provider)
+    for rule in ("SEALED", "STRICT"):
+        anchors = []
+        for source_anchor in sources[rule]["anchors"]:
+            tape, provider = worlds[int(source_anchor["world_index"])]
+            anchor = evaluate_anchor(rule, source_anchor, tape, provider)
+            anchors.append(anchor)
+            print(json.dumps({
+                "completed": anchor["anchor_id"], "rule": rule,
+                "c1_mbit_per_j": anchor["c1"]["ee_bit_per_j"] / 1e6,
+                "c2_mbit_per_j": anchor["c2_best_known"]["ee_bit_per_j"] / 1e6,
+                "gap_pct": anchor["gap"]["relative_pct"],
+            }, sort_keys=True), flush=True)
+        pooled = pool(rule, anchors)
+        result["rules"][rule] = {
+            "anchors": anchors,
+            "pooled": pooled,
+            "pooled_decomposition": aggregate_decomposition(anchors, pooled),
+            "implementability": {
+                "changed_boundary_slot_links": sum(a["implementability"]["changed_boundary_slot_links"] for a in anchors),
+                "changed_in_multibeam_component": sum(a["implementability"]["changed_in_multibeam_component"] for a in anchors),
+                "maximum_interference_component_size": max(a["implementability"]["maximum_interference_component_size"] for a in anchors),
+            },
+        }
+        impl = result["rules"][rule]["implementability"]
+        impl["changed_in_multibeam_component_pct"] = (
+            0.0 if impl["changed_boundary_slot_links"] == 0 else
+            100.0 * impl["changed_in_multibeam_component"] / impl["changed_boundary_slot_links"]
+        )
+    result["summary"] = {rule: result["rules"][rule]["pooled"]
+                         for rule in ("SEALED", "STRICT")}
+    result["wall_seconds"] = time.time() - started
+    result["receipt_sha256"] = canonical_digest(result)
+    args.receipt.parent.mkdir(parents=True, exist_ok=True)
+    args.receipt.write_text(json.dumps(result, indent=2, sort_keys=True,
+                                        allow_nan=False) + "\n", encoding="ascii")
+    render_report(result, args.report, args.receipt)
+    print(json.dumps({"receipt": str(args.receipt), "report": str(args.report),
+                      "receipt_sha256": result["receipt_sha256"]}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/.scratch/control-law-ceiling/spec.md b/.scratch/control-law-ceiling/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..90707d0a32df6a490dff487324c3f4b05e4b1893
--- /dev/null
+++ b/.scratch/control-law-ceiling/spec.md
@@ -0,0 +1,31 @@
+# Control-law fixed-assignment diagnostic specification
+
+Status: `DIAGNOSTIC_NOT_CLAIM`.
+
+The measurement uses the eight real `V025_PROBE_R2/world/{1,2}:step/{0..3}`
+anchors at the sealed 1.66 degree one-sided half-power angle.  For each of the
+SEALED and STRICT provisioning rules, the user-to-beam assignment is the
+correctly paired `J_from_first` committed assignment recorded by the final
+beam-width receipt.
+
+Acceptance criteria:
+
+1. Independently replay C1 over all 48 boundaries and require its bits,
+   joules, served count, and target count to match the committed receipt.
+2. Hold every C1 user-to-beam assignment fixed.  Search only the per-slot
+   transmitted ACM mode (including OFF where C1 failed) and RF power.
+3. Never reduce a C1-decoded link's mode.  This conservatively preserves the
+   service guard and rate-target attainment; verify both endpoint counts.
+4. For each discrete mode vector solve the realised, co-channel coupled
+   minimum-power equations directly, reject cap violations, and record
+   residual/SINR checks.
+5. Label the bounded deterministic two-order coordinate search as best-known,
+   not certified.  Report anchor and pooled C1/C2/C3 plus exact additive C4
+   decompositions by C1 cap status, occupancy, elevation, off-axis angle, and
+   interference-component size.
+6. State that the C2 oracle uses joint realised coupling/mode information and
+   is not itself an implementable causal rule; quantify the affected
+   component sizes for C5.
+7. Run with one Python process and one numerical-library thread.  Do not edit
+   production physics or any sibling workspace.
+
diff --git a/scripts/run_control_law_ceiling.py b/scripts/run_control_law_ceiling.py
new file mode 100644
index 0000000000000000000000000000000000000000..4f55b883327dbef7ab9f1d90e6b124b09c217dae
--- /dev/null
+++ b/scripts/run_control_law_ceiling.py
@@ -0,0 +1,985 @@
+#!/usr/bin/env python3
+"""Fixed-assignment power/mode headroom diagnostic for V0.25.
+
+DIAGNOSTIC_NOT_CLAIM.  This script replays recorded committed assignments and
+performs a separate realised-oracle search.  It never runs or changes a policy,
+learner, training job, selector, sealed constant, or production source file.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+from dataclasses import dataclass
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+BEAM_REPO = REPO.parent / "mcrl-v025-beam-ws"
+BEAM_SRC = BEAM_REPO / "src"
+BEAM_DIAG = BEAM_REPO / ".scratch/beamwidth"
+RUNNER_PATH = BEAM_DIAG / "run_beamwidth_network.py"
+SOURCE_RECEIPTS = {
+    "SEALED": BEAM_DIAG / "final-sealed-one-sided-1.66.json",
+    "STRICT": BEAM_DIAG / "final-strict-one-sided-1.66.json",
+}
+EXPECTED_SOURCE_SHA256 = {
+    "SEALED": "a035c17491b6a743b39b65c4cdbdf453d4aa7a4180ced5b4fc3055a355709c64",
+    "STRICT": "35732966ad6008f50338f85187ba718ca1dda22d714489d6bf48e7992cbf1b9b",
+}
+CLAIM = "DIAGNOSTIC_NOT_CLAIM"
+BOUNDARIES = 48
+STEP_S = 0.640
+RATE_TARGET_BPS = 50_000_000.0
+ONE_SIDED_HP_DEG = 1.66
+OFF = -1
+MAX_DINKELBACH = 10
+MAX_COORDINATE_PASSES = 20
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    encoded = json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def load_runner():
+    sys.path.insert(0, str(BEAM_SRC))
+    sys.path.insert(0, str(BEAM_DIAG))
+    spec = importlib.util.spec_from_file_location("control_ceiling_runner", RUNNER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load hash-pinned beam diagnostic runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+runner = load_runner()
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    CIRCUIT_POWER_PER_CHAIN_W,
+    PA_MAX_EFFICIENCY,
+    PA_SATURATION_POWER_W,
+)
+from mcrl.physics_v025.energy import pa_supply_power_w  # noqa: E402
+from mcrl.physics_v025.provider_legacy import factory  # noqa: E402
+
+
+def mode_frontier() -> tuple[int, ...]:
+    rows = sorted(
+        range(len(ACM_MODES)),
+        key=lambda i: (ACM_MODES[i].threshold_linear,
+                       -ACM_MODES[i].spectral_efficiency_bit_per_s_hz,
+                       ACM_MODES[i].name),
+    )
+    best = -math.inf
+    result = []
+    for index in rows:
+        se = ACM_MODES[index].spectral_efficiency_bit_per_s_hz
+        if se > best:
+            result.append(index)
+            best = se
+    return tuple(result)
+
+
+FRONTIER = mode_frontier()
+MODE_INDEX = {mode.name: index for index, mode in enumerate(ACM_MODES)}
+
+
+def configuration_from_record(base, record: Mapping[str, object]):
+    mapping = {
+        int(user): (int(identity[0]), int(identity[1]))
+        for user, identity in record["assignments"]  # type: ignore[index]
+    }
+    config = runner.probe._configuration(base, mapping, kind="control-law-fixed-assignment")
+    if config.configuration_id != record["configuration_id"]:
+        raise RuntimeError("recorded fixed assignment reconstruction failed")
+    return config
+
+
+def trapezoid(values: Sequence[float]) -> float:
+    if len(values) != BOUNDARIES:
+        raise RuntimeError("expected 48 boundary values")
+    return STEP_S * math.fsum(
+        0.5 * (values[index] + values[index + 1])
+        for index in range(BOUNDARIES - 1)
+    )
+
+
+def off_axis_by_user(provider, domain: str, step_index: int, boundary: int,
+                     geometry) -> dict[int, float]:
+    seed = runner.probe.seed_from_domain(domain)
+    world = provider._ensure(seed)
+    state = world.steps[step_index]
+    tracked = {int(n): i for i, n in enumerate(world.tracked_norads.tolist())}
+    time_index = step_index * 47 + boundary
+    result = {}
+    for link in geometry.links:
+        sat = world.positions_ecef_km[tracked[link.beam[0]], time_index]
+        centre = world.grid.centers_ecef_km[link.beam[1]]
+        user = state.user_ecef_km[link.user_id]
+        a = centre - sat
+        b = user - sat
+        cosine = float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))
+        result[link.user_id] = math.degrees(math.acos(max(-1.0, min(1.0, cosine))))
+    return result
+
+
+@dataclass(frozen=True)
+class SlotValue:
+    feasible: bool
+    rate_bps: float
+    power_w: float
+    modes: tuple[int, ...]
+    rf_power_w: tuple[float, ...]
+    rates_bps: tuple[float, ...]
+    allocated_power_w: tuple[float, ...]
+    residual_w: float
+    min_sinr_ratio: float
+
+
+class SlotProblem:
+    """One boundary/TDM slot with a discrete-mode/exact-power oracle."""
+
+    def __init__(self, geometry, radiation_slot, *, boundary: int,
+                 off_axis: Mapping[int, float]) -> None:
+        tx_by_user = {tx.user_id: tx for tx in radiation_slot.transmissions}
+        index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+        self.users = tuple(tx.user_id for tx in radiation_slot.transmissions)
+        self.links = tuple(geometry.links[index_by_user[user]] for user in self.users)
+        active = tuple(index_by_user[user] for user in self.users)
+        self.direct = geometry.gains("realised")[list(active)]
+        self.coupling = runner.architecture_module._masked_coupling(
+            geometry, active, "realised"
+        )
+        self.noise = np.full(len(active), runner.noise_power_w(BEAM_BANDWIDTH_HZ))
+        self.fraction = float(radiation_slot.fraction)
+        self.boundary = boundary
+        occupancies = Counter(link.beam for link in geometry.links)
+        self.occupancy = tuple(int(occupancies[link.beam]) for link in self.links)
+        self.elevation_deg = tuple(float(link.elevation_deg) for link in self.links)
+        self.off_axis_deg = tuple(float(off_axis[user]) for user in self.users)
+        self.c1_modes = []
+        self.allowed = []
+        c1_powers = []
+        c1_rates = []
+        for user in self.users:
+            tx = tx_by_user[user]
+            outcome = tx.realised_outcome
+            if outcome is None:
+                raise RuntimeError("C1 transmission has no realised ACM outcome")
+            c1_powers.append(float(tx.rf_power_w))
+            c1_rates.append(
+                BEAM_BANDWIDTH_HZ
+                * float(outcome.credited_spectral_efficiency_bit_per_s_hz)
+            )
+            if outcome.decoded:
+                index = MODE_INDEX[tx.m_tx.name]
+                self.c1_modes.append(index)
+                baseline_se = ACM_MODES[index].spectral_efficiency_bit_per_s_hz
+                candidates = [i for i in FRONTIER
+                              if ACM_MODES[i].spectral_efficiency_bit_per_s_hz >= baseline_se]
+                if index not in candidates:
+                    candidates.append(index)
+                self.allowed.append(tuple(sorted(set(candidates), key=lambda i: (
+                    ACM_MODES[i].threshold_linear, ACM_MODES[i].name))))
+            else:
+                self.c1_modes.append(OFF)
+                self.allowed.append((OFF,) + FRONTIER)
+        self.c1_modes = tuple(self.c1_modes)
+        self.c1_rf_power_w = tuple(c1_powers)
+        self.c1_rates_bps = tuple(c1_rates)
+        self.c1_allocated_power_w = self._allocate_power(self.c1_rf_power_w)
+        self._cache: dict[tuple[int, ...], SlotValue] = {}
+
+    def _allocate_power(self, powers: Sequence[float]) -> tuple[float, ...]:
+        values = [0.0] * len(powers)
+        by_sat: dict[int, list[int]] = defaultdict(list)
+        for i, power in enumerate(powers):
+            if power > 0.0:
+                values[i] += pa_supply_power_w(float(power)) + CIRCUIT_POWER_PER_CHAIN_W
+                by_sat[self.links[i].beam[0]].append(i)
+        for rows in by_sat.values():
+            share = BASEBAND_POWER_PER_ACTIVE_SATELLITE_W / len(rows)
+            for i in rows:
+                values[i] += share
+        return tuple(values)
+
+    def evaluate(self, modes: tuple[int, ...]) -> SlotValue:
+        cached = self._cache.get(modes)
+        if cached is not None:
+            return cached
+        n = len(modes)
+        on = np.asarray([i for i, mode in enumerate(modes) if mode != OFF], dtype=np.int64)
+        powers = np.zeros(n, dtype=np.float64)
+        residual = 0.0
+        min_ratio = 1.0
+        feasible = True
+        if on.size:
+            gamma = np.asarray([ACM_MODES[modes[i]].threshold_linear for i in on])
+            direct = self.direct[on]
+            coupling = self.coupling[np.ix_(on, on)]
+            noise = self.noise[on]
+            matrix = np.eye(on.size) - gamma[:, None] * coupling / direct[:, None]
+            rhs = gamma * noise / direct
+            try:
+                solved = np.linalg.solve(matrix, rhs)
+            except np.linalg.LinAlgError:
+                feasible = False
+                solved = np.full(on.size, math.inf)
+            if (not np.all(np.isfinite(solved)) or np.any(solved <= 0.0)
+                    or np.any(solved > BEAM_RF_CAP_W + 1.0e-12)):
+                feasible = False
+            if feasible:
+                achieved = solved * direct / (noise + coupling @ solved)
+                min_ratio = float(np.min(achieved / gamma))
+                residual = float(np.max(np.abs(
+                    solved - gamma * (noise + coupling @ solved) / direct
+                )))
+                if min_ratio < 1.0 - 2.0e-12 or residual > 5.0e-10:
+                    feasible = False
+                powers[on] = solved
+        if not feasible:
+            value = SlotValue(False, -math.inf, math.inf, modes, tuple(), tuple(),
+                              tuple(), residual, min_ratio)
+        else:
+            rates = tuple(
+                0.0 if mode == OFF else
+                BEAM_BANDWIDTH_HZ * ACM_MODES[mode].spectral_efficiency_bit_per_s_hz
+                for mode in modes
+            )
+            allocated = self._allocate_power(powers)
+            value = SlotValue(
+                True, math.fsum(rates), math.fsum(allocated), modes,
+                tuple(float(v) for v in powers), rates, allocated,
+                residual, min_ratio,
+            )
+        self._cache[modes] = value
+        return value
+
+    def coordinate(self, eta: float, starts: Iterable[tuple[int, ...]]) -> tuple[SlotValue, int]:
+        best = None
+        comparisons = 0
+        orders = (tuple(range(len(self.users))), tuple(reversed(range(len(self.users)))))
+        for start, order in zip(starts, orders, strict=False):
+            current = start
+            current_value = self.evaluate(current)
+            if not current_value.feasible:
+                current = self.c1_modes
+                current_value = self.evaluate(current)
+            for _ in range(MAX_COORDINATE_PASSES):
+                moved = False
+                for position in order:
+                    candidate_best = current_value
+                    candidate_modes = current
+                    for mode in self.allowed[position]:
+                        trial = list(current)
+                        trial[position] = mode
+                        trial_tuple = tuple(trial)
+                        value = self.evaluate(trial_tuple)
+                        comparisons += 1
+                        if not value.feasible:
+                            continue
+                        score = value.rate_bps - eta * value.power_w
+                        best_score = candidate_best.rate_bps - eta * candidate_best.power_w
+                        if score > best_score + 1.0e-7 or (
+                            abs(score - best_score) <= 1.0e-7
+                            and trial_tuple < candidate_modes
+                        ):
+                            candidate_best, candidate_modes = value, trial_tuple
+                    if candidate_modes != current:
+                        current, current_value = candidate_modes, candidate_best
+                        moved = True
+                if not moved:
+                    break
+            if best is None:
+                best = current_value
+            else:
+                score = current_value.rate_bps - eta * current_value.power_w
+                best_score = best.rate_bps - eta * best.power_w
+                if score > best_score + 1.0e-7 or (
+                    abs(score - best_score) <= 1.0e-7 and current < best.modes
+                ):
+                    best = current_value
+        if best is None:
+            raise RuntimeError("coordinate search produced no feasible value")
+        return best, comparisons
+
+
+def c1_architecture(rule: str):
+    if rule == "SEALED":
+        return runner.AngleRateTPC_TDM(), None
+    if rule == "STRICT":
+        return runner.MarginAngleRateTPC_TDM(), runner.strict_clearance_adapter.scalar_formulation(
+            "margin-cleared"
+        )
+    raise RuntimeError(f"unknown rule {rule}")
+
+
+def connected_sizes(problem: SlotProblem, active_union: Sequence[bool]) -> tuple[int, ...]:
+    n = len(active_union)
+    sizes = [1] * n
+    remaining = {i for i, active in enumerate(active_union) if active}
+    while remaining:
+        seed = min(remaining)
+        component = {seed}
+        frontier = [seed]
+        remaining.remove(seed)
+        while frontier:
+            i = frontier.pop()
+            neighbours = [j for j in list(remaining) if
+                          problem.coupling[i, j] > 0.0 or problem.coupling[j, i] > 0.0]
+            for j in neighbours:
+                remaining.remove(j)
+                component.add(j)
+                frontier.append(j)
+        for i in component:
+            sizes[i] = len(component)
+    return tuple(sizes)
+
+
+def occupancy_bin(value: int) -> str:
+    return "1" if value == 1 else "2" if value == 2 else "3-4" if value <= 4 else "5+"
+
+
+def elevation_bin(value: float) -> str:
+    if value < 20.0:
+        return "10-20deg"
+    if value < 40.0:
+        return "20-40deg"
+    if value < 60.0:
+        return "40-60deg"
+    return "60-90deg"
+
+
+def off_axis_bin(value: float) -> str:
+    if value < ONE_SIDED_HP_DEG / 2.0:
+        return "0-0.83deg"
+    if value <= ONE_SIDED_HP_DEG:
+        return "0.83-1.66deg"
+    return ">1.66deg"
+
+
+def component_bin(value: int) -> str:
+    return "1" if value == 1 else "2-4" if value <= 4 else "5-8" if value <= 8 else "9+"
+
+
+def summarize_buckets(rows: Sequence[dict], total_surplus_bits: float,
+                      best_joules: float) -> dict[str, list[dict[str, object]]]:
+    dimensions = ("cap_status", "occupancy", "elevation", "off_axis", "component")
+    output = {}
+    for dimension in dimensions:
+        grouped: dict[str, dict[str, float]] = defaultdict(lambda: {
+            "surplus_bits": 0.0, "link_seconds": 0.0, "changed": 0.0,
+        })
+        for row in rows:
+            cell = grouped[str(row[dimension])]
+            cell["surplus_bits"] += float(row["surplus_bits"])
+            cell["link_seconds"] += float(row["link_seconds"])
+            cell["changed"] += float(bool(row["changed"]))
+        output[dimension] = [
+            {
+                "bucket": key,
+                "gap_contribution_mbit_per_j": values["surplus_bits"] / best_joules / 1e6,
+                "signed_share_pct": 100.0 * values["surplus_bits"] / total_surplus_bits,
+                "link_seconds": values["link_seconds"],
+                "changed_boundary_slot_links": int(values["changed"]),
+            }
+            for key, values in sorted(grouped.items())
+        ]
+        if not math.isclose(
+            math.fsum(float(row["gap_contribution_mbit_per_j"])
+                      for row in output[dimension]),
+            total_surplus_bits / best_joules / 1e6,
+            rel_tol=2e-10, abs_tol=2e-10,
+        ):
+            raise RuntimeError(f"{dimension} decomposition does not conserve the EE gap")
+    return output
+
+
+def evaluate_anchor(rule: str, source_anchor: Mapping[str, object], tape, provider) -> dict:
+    step_index = int(source_anchor["step_index"])
+    base = runner.probe._base_configuration(tape, step_index, "nearest-eligible")
+    recorded = source_anchor["committed"]["J_from_first"]  # type: ignore[index]
+    config = configuration_from_record(base, recorded)
+    geometries = tape.geometry_for(step_index=step_index, assignments=config.mapping)
+    architecture, context = c1_architecture(rule)
+    radiation = []
+    c1_boundary_rates = []
+    c1_boundary_power = []
+    slot_problems: list[list[SlotProblem]] = []
+    c1_user_boundary = []
+    roster = tuple(sorted(config.mapping))
+    domain = str(source_anchor["anchor_id"]).split(":step/")[0]
+
+    if context is not None:
+        context.__enter__()
+    try:
+        for boundary, (_time, geometry) in enumerate(geometries):
+            result = architecture.radiate(
+                runner.RadiationConfig(rate_target_bps=RATE_TARGET_BPS,
+                                       fading_quantile_alpha=0.10),
+                geometry, "realised",
+            )
+            if not result.valid:
+                raise RuntimeError("committed C1 radiation became invalid")
+            radiation.append(result)
+            rates = {user: 0.0 for user in roster}
+            power = 0.0
+            for slot in result.slots:
+                positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
+                power += slot.fraction * (
+                    math.fsum(pa_supply_power_w(tx.rf_power_w) + CIRCUIT_POWER_PER_CHAIN_W
+                              for tx in positive)
+                    + len({tx.beam[0] for tx in positive})
+                    * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
+                )
+                for tx in slot.transmissions:
+                    if tx.realised_outcome.decoded:
+                        rates[tx.user_id] += slot.fraction * BEAM_BANDWIDTH_HZ * (
+                            tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
+                        )
+            c1_boundary_rates.append(math.fsum(rates.values()))
+            c1_boundary_power.append(power)
+            c1_user_boundary.append(rates)
+            offsets = off_axis_by_user(provider, domain, step_index, boundary, geometry)
+            slot_problems.append([
+                SlotProblem(geometry, slot, boundary=boundary, off_axis=offsets)
+                for slot in result.slots
+            ])
+    finally:
+        if context is not None:
+            context.__exit__(None, None, None)
+
+    c1_bits = trapezoid(c1_boundary_rates)
+    c1_joules = trapezoid(c1_boundary_power)
+    c1_user_bits = {
+        user: trapezoid([row[user] for row in c1_user_boundary]) for user in roster
+    }
+    c1_served = sum(bits > 0.0 for bits in c1_user_bits.values())
+    target_bits = RATE_TARGET_BPS * 47 * STEP_S
+    c1_target = sum(bits >= target_bits for bits in c1_user_bits.values())
+    checks = {
+        "bits_abs_error": c1_bits - float(recorded["bits"]),
+        "joules_abs_error": c1_joules - float(recorded["joules"]),
+        "served_count_equal": c1_served == int(recorded["served_count"]),
+        "target_count_equal": c1_target == int(recorded["rate_target_attained_count"]),
+    }
+    if (not math.isclose(c1_bits, float(recorded["bits"]), rel_tol=2e-11, abs_tol=2e-4)
+            or not math.isclose(c1_joules, float(recorded["joules"]),
+                                rel_tol=2e-11, abs_tol=2e-7)
+            or not checks["served_count_equal"] or not checks["target_count_equal"]):
+        raise RuntimeError(f"C1 replay mismatch at {source_anchor['anchor_id']} {rule}: {checks}")
+
+    eta = c1_bits / c1_joules
+    chosen = [[problem.evaluate(problem.c1_modes) for problem in boundary]
+              for boundary in slot_problems]
+    comparisons = 0
+    dinkelbach_rows = []
+    best_snapshot = None
+    best_eta = eta
+    for iteration in range(MAX_DINKELBACH):
+        new_chosen = []
+        for boundary_index, boundary in enumerate(slot_problems):
+            boundary_values = []
+            for slot_index, problem in enumerate(boundary):
+                previous = chosen[boundary_index][slot_index].modes
+                value, count = problem.coordinate(
+                    eta, (previous, problem.c1_modes)
+                )
+                comparisons += count
+                boundary_values.append(value)
+            new_chosen.append(boundary_values)
+        best_boundary_rates = [
+            math.fsum(problem.fraction * value.rate_bps
+                      for problem, value in zip(slot_problems[b], new_chosen[b], strict=True))
+            for b in range(BOUNDARIES)
+        ]
+        best_boundary_power = [
+            math.fsum(problem.fraction * value.power_w
+                      for problem, value in zip(slot_problems[b], new_chosen[b], strict=True))
+            for b in range(BOUNDARIES)
+        ]
+        bits = trapezoid(best_boundary_rates)
+        joules = trapezoid(best_boundary_power)
+        new_eta = bits / joules
+        residual_bits = bits - eta * joules
+        dinkelbach_rows.append({
+            "iteration": iteration + 1, "eta_bit_per_j": eta,
+            "candidate_eta_bit_per_j": new_eta,
+            "residual_bits": residual_bits,
+        })
+        if new_eta >= best_eta - 1e-8:
+            best_eta = max(best_eta, new_eta)
+            best_snapshot = (new_chosen, best_boundary_rates, best_boundary_power, bits, joules)
+        chosen = new_chosen
+        if abs(new_eta - eta) <= 1e-10 * max(1.0, abs(eta)):
+            eta = new_eta
+            break
+        eta = new_eta
+    if best_snapshot is None:
+        raise RuntimeError("best-known search failed to retain a feasible snapshot")
+    chosen, c2_boundary_rates, c2_boundary_power, c2_bits, c2_joules = best_snapshot
+
+    c2_user_boundary = []
+    attribution_rows = []
+    max_residual = 0.0
+    min_sinr_ratio = math.inf
+    changed_total = 0
+    changed_joint = 0
+    component_max = 1
+    for boundary_index, boundary in enumerate(slot_problems):
+        rates = {user: 0.0 for user in roster}
+        endpoint_weight = 0.5 if boundary_index in (0, BOUNDARIES - 1) else 1.0
+        for problem, value in zip(boundary, chosen[boundary_index], strict=True):
+            max_residual = max(max_residual, value.residual_w)
+            min_sinr_ratio = min(min_sinr_ratio, value.min_sinr_ratio)
+            active_union = [
+                p1 > 0.0 or p2 > 0.0
+                for p1, p2 in zip(problem.c1_rf_power_w, value.rf_power_w, strict=True)
+            ]
+            sizes = connected_sizes(problem, active_union)
+            for i, user in enumerate(problem.users):
+                rates[user] += problem.fraction * value.rates_bps[i]
+                seconds = endpoint_weight * STEP_S * problem.fraction
+                delta_rate = value.rates_bps[i] - problem.c1_rates_bps[i]
+                delta_power = value.allocated_power_w[i] - problem.c1_allocated_power_w[i]
+                changed = (value.modes[i] != problem.c1_modes[i]
+                           or abs(value.rf_power_w[i] - problem.c1_rf_power_w[i]) > 1e-9)
+                changed_total += int(changed)
+                changed_joint += int(changed and sizes[i] > 1)
+                component_max = max(component_max, sizes[i])
+                attribution_rows.append({
+                    "surplus_bits": seconds * (delta_rate - (c1_bits / c1_joules) * delta_power),
+                    "link_seconds": seconds,
+                    "changed": changed,
+                    "cap_status": "C1 cap-binding" if
+                        abs(problem.c1_rf_power_w[i] - BEAM_RF_CAP_W) <= 1e-9
+                        else "C1 below-cap",
+                    "occupancy": occupancy_bin(problem.occupancy[i]),
+                    "elevation": elevation_bin(problem.elevation_deg[i]),
+                    "off_axis": off_axis_bin(problem.off_axis_deg[i]),
+                    "component": component_bin(sizes[i]),
+                })
+        c2_user_boundary.append(rates)
+    c2_user_bits = {
+        user: trapezoid([row[user] for row in c2_user_boundary]) for user in roster
+    }
+    c2_served = sum(bits > 0.0 for bits in c2_user_bits.values())
+    c2_target = sum(bits >= target_bits for bits in c2_user_bits.values())
+    if c2_served < c1_served or c2_target < c1_target:
+        raise RuntimeError("conservative C2 search regressed service or target attainment")
+    total_surplus = (c2_bits - c1_bits) - (c1_bits / c1_joules) * (c2_joules - c1_joules)
+    if not math.isclose(
+        math.fsum(float(row["surplus_bits"]) for row in attribution_rows),
+        total_surplus, rel_tol=3e-10, abs_tol=2e-3,
+    ):
+        raise RuntimeError("link attribution does not conserve endpoint surplus")
+    gap_bit_per_j = c2_bits / c2_joules - c1_bits / c1_joules
+    if not math.isclose(total_surplus / c2_joules, gap_bit_per_j,
+                        rel_tol=3e-10, abs_tol=2e-5):
+        raise RuntimeError("surplus identity does not reproduce EE gap")
+
+    return {
+        "anchor_id": source_anchor["anchor_id"],
+        "world_index": source_anchor["world_index"],
+        "step_index": step_index,
+        "world_sha256": tape.digest,
+        "fixed_configuration_id": config.configuration_id,
+        "c1": {
+            "bits": c1_bits, "joules": c1_joules,
+            "ee_bit_per_j": c1_bits / c1_joules,
+            "served_count": c1_served, "rate_target_attained_count": c1_target,
+        },
+        "c2_best_known": {
+            "bits": c2_bits, "joules": c2_joules,
+            "ee_bit_per_j": c2_bits / c2_joules,
+            "served_count": c2_served, "rate_target_attained_count": c2_target,
+        },
+        "gap": {
+            "absolute_mbit_per_j": gap_bit_per_j / 1e6,
+            "relative_pct": 100.0 * ((c2_bits / c2_joules) / (c1_bits / c1_joules) - 1.0),
+            "extra_served": c2_served - c1_served,
+            "extra_target_attained": c2_target - c1_target,
+        },
+        "search": {
+            "optimality_status": "best-known; discrete outer search not certified",
+            "mode_frontier_count": len(FRONTIER),
+            "dinkelbach_iterations": len(dinkelbach_rows),
+            "coordinate_candidate_comparisons": comparisons,
+            "dinkelbach_trace": dinkelbach_rows,
+            "inner_power_max_residual_w": max_residual,
+            "inner_power_min_achieved_to_target_sinr_ratio": min_sinr_ratio,
+            "changed_boundary_slot_links": changed_total,
+        },
+        "implementability": {
+            "changed_boundary_slot_links": changed_total,
+            "changed_in_multibeam_component": changed_joint,
+            "changed_in_multibeam_component_pct": 0.0 if changed_total == 0 else 100.0 * changed_joint / changed_total,
+            "maximum_interference_component_size": component_max,
+        },
+        "c1_replay_checks": checks,
+        "decomposition": summarize_buckets(attribution_rows, total_surplus, c2_joules),
+    }
+
+
+def pool(rule: str, anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    c1_bits = math.fsum(float(a["c1"]["bits"]) for a in anchors)  # type: ignore[index]
+    c1_j = math.fsum(float(a["c1"]["joules"]) for a in anchors)  # type: ignore[index]
+    c2_bits = math.fsum(float(a["c2_best_known"]["bits"]) for a in anchors)  # type: ignore[index]
+    c2_j = math.fsum(float(a["c2_best_known"]["joules"]) for a in anchors)  # type: ignore[index]
+    return {
+        "rule": rule,
+        "anchor_count": len(anchors),
+        "c1": {
+            "bits": c1_bits, "joules": c1_j, "ee_bit_per_j": c1_bits / c1_j,
+            "served_count": sum(int(a["c1"]["served_count"]) for a in anchors),  # type: ignore[index]
+            "rate_target_attained_count": sum(int(a["c1"]["rate_target_attained_count"]) for a in anchors),  # type: ignore[index]
+        },
+        "c2_best_known": {
+            "bits": c2_bits, "joules": c2_j, "ee_bit_per_j": c2_bits / c2_j,
+            "served_count": sum(int(a["c2_best_known"]["served_count"]) for a in anchors),  # type: ignore[index]
+            "rate_target_attained_count": sum(int(a["c2_best_known"]["rate_target_attained_count"]) for a in anchors),  # type: ignore[index]
+        },
+        "gap": {
+            "absolute_mbit_per_j": (c2_bits / c2_j - c1_bits / c1_j) / 1e6,
+            "relative_pct": 100.0 * ((c2_bits / c2_j) / (c1_bits / c1_j) - 1.0),
+        },
+    }
+
+
+def table_bucket(lines: list[str], title: str, rows: Sequence[Mapping[str, object]]) -> None:
+    lines += [f"### {title}", "",
+              "| Bucket | Gap contribution (Mbit/J) | Signed share | Changed link-slots |",
+              "|---|---:|---:|---:|"]
+    for row in rows:
+        lines.append(
+            f"| {row['bucket']} | {float(row['gap_contribution_mbit_per_j']):+.3f} | "
+            f"{float(row['signed_share_pct']):+.1f}% | {int(row['changed_boundary_slot_links'])} |"
+        )
+    lines.append("")
+
+
+def render_report(result: Mapping[str, object], report_path: Path, receipt_path: Path) -> None:
+    summaries = result["summary"]  # type: ignore[index]
+    lead = "; ".join(
+        f"{rule} {float(summaries[rule]['gap']['relative_pct']):.2f}% below the best-known value"
+        for rule in ("SEALED", "STRICT")
+    )
+    lines = [
+        f"**At fixed assignment, the declared law is {lead}; neither best-known value is a certified ceiling.**",
+        "",
+        "# Control-law fixed-assignment headroom — 2026-09-10",
+        "",
+        f"Status: **{CLAIM}**. No learner, training run, policy run, association search, or production edit was performed. No sealed constant, threshold, sign, seed, horizon, price, guard, acceptance rule, cap, or declared control law was changed or replaced.",
+        "",
+        "## Answer",
+        "",
+        "The bounded search finds material fixed-assignment control-law headroom only to the extent shown below. Because the discrete mode search is not exhaustive, these are feasible lower bounds on the achievable result (best-known values), not upper bounds and not ceilings.",
+        "",
+        "| Rule | C1 declared (Mbit/J) | C2 best-known (Mbit/J) | C3 gap | Served C1→C2 | Target C1→C2 | Status |",
+        "|---|---:|---:|---:|---:|---:|---|",
+    ]
+    for rule in ("SEALED", "STRICT"):
+        row = summaries[rule]
+        lines.append(
+            f"| {rule} | {float(row['c1']['ee_bit_per_j'])/1e6:.3f} | "
+            f"{float(row['c2_best_known']['ee_bit_per_j'])/1e6:.3f} | "
+            f"+{float(row['gap']['relative_pct']):.2f}% | "
+            f"{int(row['c1']['served_count'])}→{int(row['c2_best_known']['served_count'])} | "
+            f"{int(row['c1']['rate_target_attained_count'])}→{int(row['c2_best_known']['rate_target_attained_count'])} | best-known, not certified |"
+        )
+    lines += [
+        "",
+        "Pooling means summing bits and joules across the eight independently searched anchors; it is not a ninth separately optimized objective.",
+        "",
+        "## C1–C3 by anchor",
+        "",
+        "| Rule | Anchor | C1 Mbit/J | C2 Mbit/J | Gap | Served | Target attained |",
+        "|---|---|---:|---:|---:|---:|---:|",
+    ]
+    for rule in ("SEALED", "STRICT"):
+        for anchor in result["rules"][rule]["anchors"]:  # type: ignore[index]
+            lines.append(
+                f"| {rule} | `{anchor['anchor_id']}` | "
+                f"{float(anchor['c1']['ee_bit_per_j'])/1e6:.3f} | "
+                f"{float(anchor['c2_best_known']['ee_bit_per_j'])/1e6:.3f} | "
+                f"{float(anchor['gap']['relative_pct']):+.2f}% | "
+                f"{int(anchor['c1']['served_count'])}→{int(anchor['c2_best_known']['served_count'])} | "
+                f"{int(anchor['c1']['rate_target_attained_count'])}→{int(anchor['c2_best_known']['rate_target_attained_count'])} |"
+            )
+    lines += [
+        "",
+        "C1 was reconstructed independently over all 48 realised boundaries. Every anchor matched the recorded committed bits and joules within `2e-11` relative tolerance and matched served/target counts exactly.",
+        "",
+        "## C2 method and optimality status",
+        "",
+        "For each realised boundary and TDM slot, C2 chooses OFF or a non-dominated DVB-S2 ACM mode for every transmitting beam. A link decoded by C1 may only retain or increase its credited mode; a failed C1 transmission may be switched off or assigned any frontier mode. This pointwise non-regression makes every C1-served user's integrated bits nondecreasing, so the unchanged service guard and rate target cannot regress; the reported endpoint counts verify that invariant.",
+        "",
+        "For a discrete target vector, the inner solve is direct: `p = (I - diag(gamma/g) C)^-1 diag(gamma/g) n`, using the exact realised direct gains and full masked co-channel cross-gain matrix. Solutions are rejected if non-positive, singular, above the unchanged 1.65 W per-beam cap, outside a `5e-10 W` equation residual, or below their unchanged ACM threshold by more than binary64 tolerance. PA, active-chain, and active-satellite power are then evaluated with the unchanged energy model.",
+        "",
+        "The outer search uses Dinkelbach ratio iterations. At each price it performs deterministic coordinate ascent from two starts/orders over the non-dominated mode frontier. This is bounded and reproducible, but it is not exhaustive over joint discrete modes. Therefore **C2 is best-known, not a certified optimum or ceiling**. The exact inner solve certifies only the minimum RF powers for each visited feasible mode vector.",
+        "",
+        "## C4 — where the gap lives",
+        "",
+        "The decomposition is exact and additive. For C1 efficiency `eta1`, each link-slot receives its rate change minus `eta1` times its allocated power change; dividing the conserved total by C2 joules reproduces `eta2-eta1`. PA and circuit power belong to their transmitting link; satellite baseband power is divided equally among that satellite's active slot links. Buckets use the C1 geometry/state, so the classification is not selected after seeing C2.",
+        "",
+    ]
+    labels = {
+        "cap_status": "C1 cap status",
+        "occupancy": "C1 beam occupancy",
+        "elevation": "C1 elevation",
+        "off_axis": "C1 off-axis angle",
+        "component": "Realised interference-component size",
+    }
+    for rule in ("SEALED", "STRICT"):
+        lines += [f"### {rule}", ""]
+        anchors = result["rules"][rule]["anchors"]  # type: ignore[index]
+        # Aggregate anchor decompositions by summing their already conserved Mbit/J
+        # is not valid under pooled energy denominators, so report anchor-weighted
+        # pooled shares reconstructed from receipt detail below.
+        pooled_decomp = result["rules"][rule]["pooled_decomposition"]  # type: ignore[index]
+        for dimension in labels:
+            table_bucket(lines, labels[dimension], pooled_decomp[dimension])
+    lines += [
+        "Negative bucket shares are allowed: they identify regimes where extra rate/power locally hurts the C1-price surplus while other regimes more than compensate.",
