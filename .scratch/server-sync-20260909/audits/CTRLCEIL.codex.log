    65	@dataclass(frozen=True)
    66	class Geometry:
    67	    """A history-free scheduled geometry sample.
    68	
    69	    Cross-gain entry ``[victim, aggressor]`` is received watts per aggressor
    70	    RF watt before colour, serving-beam, and waveform-overlap masks.
    71	    """
    72	
    73	    links: tuple[Link, ...]
    74	    nominal_cross_gain: np.ndarray
    75	    realised_cross_gain: np.ndarray | None = None
    76	
    77	    def __post_init__(self) -> None:
    78	        users = len(self.links)
    79	        if users == 0:
    80	            if np.asarray(self.nominal_cross_gain).shape != (0, 0):
    81	                raise MCRLContractError("empty geometry needs a (0,0) cross-gain matrix")
    82	            empty = np.zeros((0, 0), dtype=np.float64)
    83	            empty.setflags(write=False)
    84	            object.__setattr__(self, "nominal_cross_gain", empty)
    85	            object.__setattr__(self, "realised_cross_gain", None)
    86	            return
    87	        ids = [link.user_id for link in self.links]
    88	        if len(set(ids)) != users:
    89	            raise MCRLContractError("user identities must be unique")
    90	        for name in ("nominal_cross_gain", "realised_cross_gain"):
    91	            value = getattr(self, name)
    92	            if value is None:
    93	                continue
    94	            matrix = np.asarray(value, dtype=np.float64)
    95	            if matrix.shape != (users, users):
    96	                raise MCRLContractError(f"{name} must have shape ({users},{users})")
    97	            if not np.all(np.isfinite(matrix)) or np.any(matrix < 0.0):
    98	                raise MCRLContractError(f"{name} must be finite and nonnegative")
    99	            frozen = np.array(matrix, copy=True)
   100	            frozen.setflags(write=False)
   101	            object.__setattr__(self, name, frozen)
   102	
   103	    def gains(
   104	        self, field: FieldKind, *, fading_quantile_alpha: float | None = None
   105	    ) -> np.ndarray:
   106	        if field == "nominal":
   107	            return np.asarray([link.nominal_gain for link in self.links], dtype=np.float64)
   108	        if field == "margin":
   109	            if fading_quantile_alpha is None:
   110	                raise MCRLContractError("margin field requires a fading quantile alpha")
   111	            return np.asarray(
   112	                [
   113	                    link.nominal_gain
   114	                    * fading_product_quantile(
   115	                        link.elevation_deg, fading_quantile_alpha
   116	                    )
   117	                    for link in self.links
   118	                ],
   119	                dtype=np.float64,
   120	            )
   121	        return np.asarray(
   122	            [
   123	                link.nominal_gain if link.realised_gain is None else link.realised_gain
   124	                for link in self.links
   125	            ],
   126	            dtype=np.float64,
   127	        )
   128	
   129	    def cross(self, field: FieldKind) -> np.ndarray:
   130	        if field == "margin":
   131	            return np.asarray(self.nominal_cross_gain, dtype=np.float64)
   132	        if field == "realised" and self.realised_cross_gain is not None:
   133	            return np.asarray(self.realised_cross_gain, dtype=np.float64)
   134	        return np.asarray(self.nominal_cross_gain, dtype=np.float64)
