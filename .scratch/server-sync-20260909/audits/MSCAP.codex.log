+            "",
+            f"- Multi-start runner: `{MULTISTART_RUNNER}` (`SHA-256 {data['provenance']['multistart_runner_sha256']}`)",
+            "",
+            f"- Sealed dense evaluator: `SHA-256 {data['provenance']['sealed_batch_sha256']}`",
+            "",
+            f"- MARGIN_Q dense evaluator: `SHA-256 {data['provenance']['margin_batch_sha256']}`",
+            "",
