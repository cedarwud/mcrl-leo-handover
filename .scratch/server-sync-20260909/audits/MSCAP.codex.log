+import os
+from pathlib import Path
+import pickle
+import struct
+import sys
+import time
+import types
+from typing import Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-rank-ws")
+HARNESS = Path("/home/sat/mcrl-v025-harness-ws")
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-ladder-ws/.scratch/multistart-ceiling-20260910")
+SOURCE_REPORT = Path("/home/sat/mcrl-v025-ladder-ws/MULTISTART-CEILING-2026-09-10.md")
+OUTPUT_ROOT = WORKSPACE / ".scratch/multistart-capped"
+OUTPUT_PATH = OUTPUT_ROOT / "rescored.json"
+REPORT_PATH = WORKSPACE / "MULTISTART-DEMAND-CAPPED-2026-09-10.md"
+SEALED_BATCH = HARNESS / "sealed/src/mcrl/physics_v025/batch.py"
+MARGIN_BATCH = HARNESS / "sealed/.scratch/ladder-floor-20260910/margin_batch.py"
+MULTISTART_RUNNER = Path("/home/sat/mcrl-v025-ladder-ws/scripts/multistart_ceiling.py")
+PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+
+ANCHORS = ((1, 0), (1, 1), (2, 0), (2, 1), (3, 0), (3, 1), (4, 0), (4, 1))
+RULES = ("SEALED", "MARGIN_Q")
+STARTS = tuple(range(8))
+DEMAND_BITS = 50_000_000.0 * 30.08
+BOUNDARY_STEP_S = 0.640
+BOUNDARIES = tuple(range(48))
+MAX_WORKERS = 3  # parent + three children = four concurrent Python processes
+SWAP_AUDIT_SUBSET = (("SEALED", 1, 0, 0), ("MARGIN_Q", 1, 0, 0))
+CLAIM = "DIAGNOSTIC_NOT_CLAIM"
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+
+
+def digest(value: object) -> str:
+    return hashlib.sha256(canonical_bytes(value)).hexdigest()
+
+
+def receipt_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return digest(unsigned)
+
+
+def load_receipt(path: Path) -> dict:
+    payload = json.loads(path.read_text(encoding="ascii"))
+    actual = receipt_digest(payload)
+    if actual != payload.get("receipt_sha256"):
+        raise RuntimeError(f"receipt digest mismatch: {path}: {actual}")
+    return payload
+
+
+def anchor_name(world: int, step: int) -> str:
+    return f"w{world}/s{step}"
+
+
+def receipt_path(rule: str, world: int, step: int) -> Path:
+    return SOURCE_ROOT / f"{rule.lower()}-w{world}-s{step}.json"
+
+
+def mapping(metric: Mapping[str, object]) -> dict[int, tuple[int, int] | None]:
+    return {
+        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
+        for user, identity in metric["assignments"]
+    }
+
+
+def float_bits(value: float) -> str:
+    return struct.pack(">d", float(value)).hex()
+
+
+def equality_row(actual: float, expected: float) -> dict[str, object]:
+    return {
+        "actual": actual,
+        "expected": expected,
+        "actual_binary64_hex": float_bits(actual),
+        "expected_binary64_hex": float_bits(expected),
+        "exact_binary64_equal": actual == expected,
+        "absolute_difference": actual - expected,
+    }
+
+
+def accounting(per_user_bits: Sequence[float], joules: float) -> dict[str, dict[str, float]]:
+    attained = tuple(value >= DEMAND_BITS for value in per_user_bits)
+    credited = {
+        "CAPACITY": math.fsum(per_user_bits),
+        "DEMAND_CAPPED": math.fsum(min(value, DEMAND_BITS) for value in per_user_bits),
+        "ATTAINMENT_ONLY": math.fsum(
+            value for value, flag in zip(per_user_bits, attained, strict=True) if flag
+        ),
+    }
+    return {
+        name: {"credited_bits": bits, "efficiency_bit_per_j": bits / joules}
+        for name, bits in credited.items()
+    }
+
+
+class SubslotRecorder:
+    def __init__(self, arrays, selected_rows) -> None:
+        self.users = tuple(int(value) for value in arrays.users)
+        self.identities = tuple(
+            None
+            if int(row) < 0
+            else (
+                int(arrays.identities[int(row), 0]),
+                int(arrays.identities[int(row), 1]),
+            )
+            for row in selected_rows[0]
+        )
+        self.boundaries: list[dict[str, object]] = []
+        self._boundary = -1
+        self._cursor = Fraction(0, 1)
+
+    def __call__(
+        self,
+        boundary,
+        fraction,
+        midpoint,
+        active,
+        slot_rate,
+        power,
+        mode_index,
+        has_tx_mode,
+        served,
+    ) -> None:
+        boundary = int(boundary)
+        if boundary != self._boundary:
+            if self._boundary >= 0 and self._cursor != 1:
+                raise RuntimeError(f"subslots did not partition boundary {self._boundary}")
+            self._boundary = boundary
+            self._cursor = Fraction(0, 1)
+            self.boundaries.append(
+                {
+                    "boundary_index": boundary,
+                    "boundary_time_s": float(boundary * BOUNDARY_STEP_S),
+                    "endpoint_trapezoid_weight": 0.5 if boundary in {0, 47} else 1.0,
+                    "subslots": [],
+                }
+            )
+        exact_fraction = Fraction(float(fraction)).limit_denominator(1_000_000)
+        start = self._cursor
+        end = start + exact_fraction
+        transmissions = []
+        for column, flag in enumerate(active):
+            if not bool(flag):
+                continue
+            identity = self.identities[column]
+            if identity is None:
+                raise RuntimeError("active user has NULL identity")
+            delivered = float(float(fraction) * float(slot_rate[column]) * BOUNDARY_STEP_S)
+            transmissions.append(
+                [
+                    self.users[column],
+                    identity[0],
+                    identity[1],
+                    delivered,
+                    float(power[column]),
+                    int(mode_index[column]) if bool(has_tx_mode[column]) else -1,
+                    bool(served[column]),
+                ]
+            )
+        self.boundaries[-1]["subslots"].append(
+            {
+                "rational_subslot_start": [start.numerator, start.denominator],
+                "rational_subslot_end": [end.numerator, end.denominator],
+                "midpoint_binary64": float(midpoint),
+                "transmissions": transmissions,
+            }
+        )
+        self._cursor = end
+
+    def finish(self) -> list[dict[str, object]]:
+        if self._boundary != 47 or self._cursor != 1:
+            raise RuntimeError("recording did not finish a complete 48-boundary endpoint")
+        if [row["boundary_index"] for row in self.boundaries] != list(BOUNDARIES):
+            raise RuntimeError("recording boundary order is incomplete")
+        return self.boundaries
+
+
+def instrumented_module(path: Path, name: str):
+    """Load an in-memory copy with one post-rate callback and no equation edits."""
+
+    source = path.read_text(encoding="utf-8")
+    import_needle = "import numpy as np\n"
+    if source.count(import_needle) != 1:
+        raise RuntimeError(f"unexpected NumPy import seam in {path}")
+    source = source.replace(import_needle, import_needle + "\n_RECORD_CALLBACK = None\n", 1)
+    rate_needle = (
+        "                slot_rate = np.where(served, chosen_efficiency * "
+        "BEAM_BANDWIDTH_HZ, 0.0)\n"
+    )
+    if source.count(rate_needle) != 1:
+        raise RuntimeError(f"unexpected slot-rate seam in {path}")
+    callback = (
+        rate_needle
+        + "                if _RECORD_CALLBACK is not None:\n"
+        + "                    _RECORD_CALLBACK(\n"
+        + "                        boundary, fraction, midpoint, active[0].copy(),\n"
+        + "                        slot_rate[0].copy(), power[0].copy(),\n"
+        + "                        mode_index[0].copy(), has_tx_mode[0].copy(),\n"
+        + "                        served[0].copy(),\n"
+        + "                    )\n"
+    )
+    source = source.replace(rate_needle, callback, 1)
+    module = types.ModuleType(name)
+    module.__file__ = str(path)
+    module.__package__ = "mcrl.physics_v025"
+    sys.modules[name] = module
+    exec(compile(source, str(path), "exec"), module.__dict__)
+    return module
+
+
+def selected_rows(arrays, config) -> object:
+    import numpy as np
+
+    row_of = arrays._row_index()
+    users = tuple(int(value) for value in arrays.users)
+    result = np.full((1, len(users)), -1, dtype=np.int64)
+    for column, user in enumerate(users):
+        identity = config.mapping[user]
+        if identity is not None:
+            row = row_of.get((user, identity))
+            if row is None:
+                raise RuntimeError(f"assignment absent from primitive rows: {user}: {identity}")
+            result[0, column] = row
+    return result
+
+
+def run_instrumented(module, arrays, config, run_setting):
+    selected = selected_rows(arrays, config)
+    recorder = SubslotRecorder(arrays, selected)
+    module._RECORD_CALLBACK = recorder
+    try:
+        result = module._evaluate_ar_tdm_catalogue_core(
+            arrays,
+            selected,
+            field="realised",
+            rate_target_bps=run_setting.rate_target_bps,
+            circuit_power_per_active_chain_w=run_setting.circuit_power_per_active_chain_w,
+            boundary_indices=BOUNDARIES,
+            fading_quantile_alpha=0.10,
+        )
+    finally:
+        module._RECORD_CALLBACK = None
+    if not bool(result.valid[0]):
+        raise RuntimeError(f"recorded endpoint became invalid: {config.configuration_id}")
+    users = tuple(int(value) for value in arrays.users)
+    per_user = tuple(float(value) for value in result.bits[0])
+    total_bits = math.fsum(per_user)
+    joules = float(result.joules[0])
+    served_count = sum(float(value) > 0.0 for value in result.decoding_time_s[0])
+    attained = tuple(value >= DEMAND_BITS for value in per_user)
+    records = {
+        "compact_transmission_columns": [
+            "user_id",
+            "norad_id",
+            "beam_id",
+            "delivered_bits_for_one_boundary_interval_s",
+            "radiated_power_w",
+            "transmitted_mode_index_minus_one_for_none",
+            "realised_decoded",
+        ],
+        "delivery_field_definition": (
+            "rational_subslot_fraction * realised delivered ACM rate_bps * 0.640 s; "
+            "endpoint delivery uses 0.5 weights at boundaries 0 and 47 and weight 1 otherwise"
+        ),
+        "per_user_endpoint": [
+            {
+                "user_id": user,
+                "delivered_bits_over_endpoint": per_user[index],
+                "rate_target_attained": attained[index],
+            }
+            for index, user in enumerate(users)
+        ],
+        "boundaries": recorder.finish(),
+    }
+    return {
+        "bits": total_bits,
+        "joules": joules,
+        "ee_bit_per_j": total_bits / joules,
+        "served_count": served_count,
+        "attained_count": sum(attained),
+        "per_user_bits": list(per_user),
+        "accounting": accounting(per_user, joules),
+        "records": records,
+        "records_sha256": digest(records),
+    }
+
+
+def original_profile(reference, tape, step: int, true_base, config, boundaries=BOUNDARIES):
+    evaluator = reference.probe.StepEvaluator(
+        tape,
+        reference.probe._setting("a-r0"),
+        step,
+        transition_from=true_base,
+        field="realised",
+        run_setting=reference.probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(boundaries),
+        fading_quantile_alpha=0.10,
+    )
+    evaluator.evaluate_many((config,))
+    profile = evaluator._evaluated.get(config.configuration_id)
+    if profile is None:
+        return None
+    per_user = [float(profile.score.bits[user]) for user in sorted(profile.score.bits)]
+    return {
+        "bits": float(profile.bits),
+        "joules": float(profile.joules),
+        "ee_bit_per_j": float(reference.ratio(profile.bits, profile.joules)),
+        "served_count": int(reference.served(profile)),
+        "per_user_bits": per_user,
+        "accounting": accounting(per_user, float(profile.joules)),
+    }
+
+
+def reconstruct(reference, true_base, metric: Mapping[str, object], kind: str):
+    config = reference._configuration(true_base, mapping(metric), kind)
+    if config.configuration_id != metric["configuration_id"]:
+        raise RuntimeError(
+            f"configuration reconstruction mismatch: {config.configuration_id} != "
+            f"{metric['configuration_id']}"
+        )
+    return config
+
+
+def parity(actual: Mapping[str, object], expected: Mapping[str, object]) -> dict[str, object]:
+    rows = {
+        field: equality_row(float(actual[field]), float(expected[field]))
+        for field in ("bits", "joules", "ee_bit_per_j")
+    }
+    rows["served_count"] = {
+        "actual": int(actual["served_count"]),
+        "expected": int(expected["served_count"]),
+        "exact_equal": int(actual["served_count"]) == int(expected["served_count"]),
+    }
+    if not all(row.get("exact_binary64_equal", row.get("exact_equal")) for row in rows.values()):
+        raise RuntimeError(f"CAPACITY_PARITY_FAILURE: {rows}")
+    return rows
+
+
+def swap_candidates(reference, true_base, endpoint, options):
+    current = endpoint.mapping
+    users = sorted(current)
+    by_id = {}
+    pair_by_id = {}
+    pair_count = 0
+    for left_index, left in enumerate(users):
+        left_identity = current[left]
+        for right in users[left_index + 1 :]:
+            right_identity = current[right]
+            if left_identity == right_identity or left_identity is None or right_identity is None:
+                continue
+            if right_identity not in options[left] or left_identity not in options[right]:
+                continue
+            swapped = dict(current)
+            swapped[left], swapped[right] = right_identity, left_identity
+            candidate = reference._configuration(true_base, swapped, "demand-capped-two-user-swap-audit")
+            pair_count += 1
+            by_id.setdefault(candidate.configuration_id, candidate)
+            pair_by_id.setdefault(candidate.configuration_id, (left, right))
+    return tuple(by_id.values()), pair_by_id, pair_count
+
+
+def swap_audit(reference, tape, step, true_base, endpoint, endpoint_metric, options, guard, receipt_swap):
+    candidates, pair_by_id, pair_count = swap_candidates(reference, true_base, endpoint, options)
+    if pair_count != int(receipt_swap["legal_swap_pair_count"]):
+        raise RuntimeError(f"swap pair count mismatch: {pair_count}")
+    selection = reference.probe.StepEvaluator(
+        tape,
+        reference.probe._setting("a-r0"),
+        step,
+        transition_from=true_base,
+        field="realised",
+        run_setting=reference.probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    selection.evaluate_many(candidates)
+    eligible = []
+    invalid = 0
+    below_guard = 0
+    for candidate in candidates:
+        profile = selection._evaluated.get(candidate.configuration_id)
+        if profile is None:
+            invalid += 1
+        elif reference.served(profile) < guard:
+            below_guard += 1
+        else:
+            eligible.append(candidate)
+
+    committed = reference.probe.StepEvaluator(
+        tape,
+        reference.probe._setting("a-r0"),
+        step,
+        transition_from=true_base,
+        field="realised",
+        run_setting=reference.probe.run_setting_for("a-r0"),
+        boundary_indices=BOUNDARIES,
+        fading_quantile_alpha=0.10,
+    )
+    committed.evaluate_many(tuple(eligible))
+    current_ee = endpoint_metric["accounting"]["DEMAND_CAPPED"]["efficiency_bit_per_j"]
+    improving = []
+    for candidate in eligible:
+        profile = committed._evaluated.get(candidate.configuration_id)
+        if profile is None:
+            invalid += 1
+            continue
+        values = [float(profile.score.bits[user]) for user in sorted(profile.score.bits)]
+        candidate_ee = accounting(values, float(profile.joules))["DEMAND_CAPPED"][
+            "efficiency_bit_per_j"
+        ]
+        if candidate_ee > current_ee:
+            improving.append((candidate_ee, candidate.configuration_id, pair_by_id[candidate.configuration_id]))
+    best = max(improving, default=None, key=lambda row: (row[0], tuple(-x for x in row[2])))
+    return {
+        "predeclared_subset_member": True,
+        "legal_swap_pair_count": pair_count,
+        "unique_legal_swap_configuration_count": len(candidates),
+        "physically_invalid_count": invalid,
+        "below_unchanged_selection_served_guard_count": below_guard,
+        "eligible_committed_swap_count": len(eligible),
+        "strictly_demand_capped_improving_swap_count": len(improving),
+        "is_demand_capped_two_swap_optimal": not improving,
+        "endpoint_demand_capped_efficiency_bit_per_j": current_ee,
+        "best_improving_swap": None
+        if best is None
+        else {
+            "users": list(best[2]),
+            "configuration_id": best[1],
+            "demand_capped_efficiency_bit_per_j": best[0],
+            "relative_gain_over_endpoint": best[0] / current_ee - 1.0,
+        },
+        "receipt_F_is_two_swap_optimal": bool(receipt_swap["is_two_swap_optimal"]),
+        "receipt_F_feasible_improving_swap_count": int(
+            receipt_swap["feasible_improving_swap_count"]
+        ),
+    }
+
+
+def run_anchor_job(task):
+    rule, world, step = task
+    started = time.perf_counter()
+    if str(HARNESS) not in sys.path:
+        sys.path.insert(0, str(HARNESS))
+    from harness.runner import install_variant
+    from harness import sealed as sealed_module
+
+    sealed_module.verify()
+    reference = sealed_module.reference_runner()
+    receipt_file = receipt_path(rule, world, step)
+    source = load_receipt(receipt_file)
+    source_anytime = load_receipt(
+        HARNESS
+        / "receipts"
+        / ("anytime-sealed-full20.json" if rule == "SEALED" else "anytime-margin-q-full20.json")
+    )
+    world_row = next(row for row in source_anytime["worlds"] if int(row["world_index"]) == world)
+    tape_path = HARNESS / ".harness-cache/worlds" / f"{world_row['cache_key']}.pickle"
+    tape = pickle.loads(tape_path.read_bytes())
+    if tape.digest != source["world_sha256"]:
+        raise RuntimeError("world digest mismatch")
+
+    install_variant(rule)
+    true_base = reference.probe._base_configuration(tape, step, "nearest-eligible")
+    options, _census = reference.probe._legal_options(tape, step)
+    arrays = tape.steps[step].arrays
+    if arrays is None:
+        raise RuntimeError("world step lacks primitive arrays")
+    module = instrumented_module(
+        SEALED_BATCH if rule == "SEALED" else MARGIN_BATCH,
+        f"rescoring_{rule.lower()}_{world}_{step}_{os.getpid()}",
+    )
+    run_setting = reference.probe.run_setting_for("a-r0")
+
+    evaluated = []
+    for endpoint_row in source["endpoints"]:
+        start_index = int(endpoint_row["start_index"])
+        expected = endpoint_row["endpoint"]
+        config = reconstruct(reference, true_base, expected, "recorded-multistart-endpoint-replay")
+        actual = run_instrumented(module, arrays, config, run_setting)
+        endpoint_parity = parity(actual, expected)
+
+        swap = endpoint_row["two_swap"]["best_improving_swap"]
+        swap_result = None
+        swap_parity = None
+        if swap is not None:
+            swap_expected = swap["committed"]
+            swap_config = reconstruct(
+                reference, true_base, swap_expected, "recorded-F-best-two-swap-replay"
+            )
+            swap_result = original_profile(reference, tape, step, true_base, swap_config)
+            if swap_result is None:
+                raise RuntimeError("recorded committed swap became invalid")
+            swap_parity = parity(swap_result, swap_expected)
+            swap_result.update(
+                {
+                    "configuration_id": swap_expected["configuration_id"],
+                    "users": swap["users"],
+                    "source": "recorded F-best swap only; no swap search rerun",
+                }
+            )
+
+        audit = None
+        if (rule, world, step, start_index) in SWAP_AUDIT_SUBSET:
+            audit = swap_audit(
+                reference,
+                tape,
+                step,
+                true_base,
+                config,
+                actual,
+                options,
+                int(source["baseline_served_guard"]),
+                endpoint_row["two_swap"],
+            )
+
+        evaluated.append(
+            {
+                "start_index": start_index,
+                "configuration_id": expected["configuration_id"],
+                "endpoint": actual,
+                "endpoint_capacity_parity": endpoint_parity,
+                "recorded_F_best_swap": swap_result,
+                "recorded_F_best_swap_capacity_parity": swap_parity,
+                "demand_capped_swap_audit": audit,
+                "receipt_F_two_swap": {
+                    "is_two_swap_optimal": endpoint_row["two_swap"]["is_two_swap_optimal"],
+                    "feasible_improving_swap_count": endpoint_row["two_swap"][
+                        "feasible_improving_swap_count"
+                    ],
+                    "legal_swap_pair_count": endpoint_row["two_swap"]["legal_swap_pair_count"],
+                },
+            }
+        )
+    result = {
+        "rule": rule,
+        "anchor": anchor_name(world, step),
+        "anchor_id": source["anchor_id"],
+        "world_index": world,
+        "step_index": step,
+        "world_sha256": source["world_sha256"],
+        "receipt_path": str(receipt_file),
+        "receipt_sha256": source["receipt_sha256"],
+        "baseline_served_guard": source["baseline_served_guard"],
+        "endpoints": evaluated,
+        "wall_seconds": time.perf_counter() - started,
+    }
+    partial = OUTPUT_ROOT / f"partial-{rule.lower()}-w{world}-s{step}.json"
+    partial.write_text(
+        json.dumps(result, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    return str(partial), result["wall_seconds"]
+
+
+def endpoint_candidate_rows(anchor: Mapping[str, object], numerator: str, include_swaps: bool):
+    rows = []
+    for endpoint in anchor["endpoints"]:
+        metric = endpoint["endpoint"]
+        rows.append(
+            {
+                "kind": "endpoint",
+                "start_index": endpoint["start_index"],
+                "configuration_id": endpoint["configuration_id"],
+                "metric": metric,
+                "ee": metric["accounting"][numerator]["efficiency_bit_per_j"],
+            }
+        )
+        if include_swaps and endpoint["recorded_F_best_swap"] is not None:
+            swap = endpoint["recorded_F_best_swap"]
+            rows.append(
+                {
+                    "kind": "recorded_F_best_swap",
+                    "start_index": endpoint["start_index"],
+                    "configuration_id": swap["configuration_id"],
+                    "metric": swap,
+                    "ee": swap["accounting"][numerator]["efficiency_bit_per_j"],
+                }
+            )
+    return rows
+
+
+def select_best(rows):
+    return min(rows, key=lambda row: (-row["ee"], row["configuration_id"]))
+
+
+def pooled(selected, numerator: str):
+    bits = math.fsum(row["metric"]["accounting"][numerator]["credited_bits"] for row in selected)
+    joules = math.fsum(row["metric"]["joules"] for row in selected)
+    return {"credited_bits": bits, "joules": joules, "efficiency_bit_per_j": bits / joules}
+
+
+def summarize_rule(anchors, rule: str):
+    rule_anchors = [row for row in anchors if row["rule"] == rule]
+    by_key = {(row["world_index"], row["step_index"]): row for row in rule_anchors}
+    ordered = [by_key[key] for key in ANCHORS]
+    numerators = {}
+    for numerator in ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY"):
+        nearest_rows = [
+            {
+                "metric": next(e for e in anchor["endpoints"] if e["start_index"] == 0)["endpoint"]
+            }
+            for anchor in ordered
+        ]
+        nearest = pooled(nearest_rows, numerator)
+        same_index = []
+        for start in STARTS:
+            rows = [
+                {
+                    "metric": next(e for e in anchor["endpoints"] if e["start_index"] == start)[
+                        "endpoint"
+                    ]
+                }
+                for anchor in ordered
+            ]
+            same_index.append({"start_index": start, **pooled(rows, numerator)})
+        endpoint_best_rows = [
+            select_best(endpoint_candidate_rows(anchor, numerator, False)) for anchor in ordered
+        ]
+        best_of_8 = pooled(endpoint_best_rows, numerator)
+        found_rows = [
+            select_best(endpoint_candidate_rows(anchor, numerator, True)) for anchor in ordered
+        ]
+        best_found = pooled(found_rows, numerator)
+        capacity_choice_rows = [
+            select_best(endpoint_candidate_rows(anchor, "CAPACITY", True)) for anchor in ordered
+        ]
+        capacity_choice_rescore = pooled(capacity_choice_rows, numerator)
+        anchor_spreads = []
+        for anchor in ordered:
+            values = [
+                endpoint["endpoint"]["accounting"][numerator]["efficiency_bit_per_j"]
+                for endpoint in anchor["endpoints"]
+            ]
+            anchor_spreads.append(
+                {
+                    "anchor": anchor["anchor"],
+                    "relative_spread_max_over_min_minus_one": max(values) / min(values) - 1.0,
+                }
+            )
+        same_values = [row["efficiency_bit_per_j"] for row in same_index]
+        numerators[numerator] = {
+            "nearest_start_reference": nearest,
+            "pooled_same_index_starts": same_index,
+            "pooled_same_index_start_spread_max_over_min_minus_one": max(same_values)
+            / min(same_values)
+            - 1.0,
+            "anchor_start_spreads": anchor_spreads,
+            "maximum_anchor_spread_max_over_min_minus_one": max(
+                row["relative_spread_max_over_min_minus_one"] for row in anchor_spreads
+            ),
+            "pooled_per_anchor_best_of_8": best_of_8,
+            "pooled_best_found_including_recorded_F_best_swaps": best_found,
+            "best_found_selection": [
+                {
+                    "anchor": anchor["anchor"],
+                    "kind": row["kind"],
+                    "start_index": row["start_index"],
+                    "configuration_id": row["configuration_id"],
+                }
+                for anchor, row in zip(ordered, found_rows, strict=True)
+            ],
+            "best_found_exceeds_reference": best_found["efficiency_bit_per_j"]
+            / nearest["efficiency_bit_per_j"]
+            - 1.0,
+            "best_found_exceeds_reference_denominator": "nearest_start_reference_efficiency",
+            "reference_below_best_found": 1.0
+            - nearest["efficiency_bit_per_j"] / best_found["efficiency_bit_per_j"],
+            "reference_below_best_found_denominator": "best_found_efficiency",
+            "frozen_capacity_selected_best_found_rescore": capacity_choice_rescore,
+        }
+
+    split = {
+        "nearest_reference_attainers": {
+            "user_anchor_count": 0,
+            "capacity_extra_bits": 0.0,
+            "demand_capped_extra_bits": 0.0,
+        },
+        "nearest_reference_non_attainers": {
+            "user_anchor_count": 0,
+            "capacity_extra_bits": 0.0,
+            "demand_capped_extra_bits": 0.0,
+        },
+    }
+    for anchor in ordered:
+        reference_metric = next(e for e in anchor["endpoints"] if e["start_index"] == 0)[
+            "endpoint"
+        ]
+        best = select_best(endpoint_candidate_rows(anchor, "CAPACITY", True))["metric"]
+        for reference_bits, best_bits in zip(
+            reference_metric["per_user_bits"], best["per_user_bits"], strict=True
+        ):
+            cohort = (
+                "nearest_reference_attainers"
+                if reference_bits >= DEMAND_BITS
+                else "nearest_reference_non_attainers"
+            )
+            split[cohort]["user_anchor_count"] += 1
+            split[cohort]["capacity_extra_bits"] += best_bits - reference_bits
+            split[cohort]["demand_capped_extra_bits"] += min(best_bits, DEMAND_BITS) - min(
+                reference_bits, DEMAND_BITS
+            )
+    total = math.fsum(row["capacity_extra_bits"] for row in split.values())
+    for row in split.values():
+        row["share_of_capacity_increment"] = row["capacity_extra_bits"] / total
+    return {"rule": rule, "numerators": numerators, "extra_capacity_cohorts": split}
+
+
+def pct(value: float, digits: int = 4) -> str:
+    return f"{100.0 * value:.{digits}f}%"
+
+
+def signed_pct(value: float, digits: int = 4) -> str:
+    return f"{100.0 * value:+.{digits}f}%"
+
+
+def ee(value: float) -> str:
+    return f"{value / 1e6:.6f}"
+
+
+def gbit(value: float) -> str:
+    return f"{value / 1e9:.6f}"
+
+
+def render_report(data: Mapping[str, object]) -> str:
+    summaries = {row["rule"]: row for row in data["summaries"]}
+    capped_sealed = summaries["SEALED"]["numerators"]["DEMAND_CAPPED"]
+    capped_margin = summaries["MARGIN_Q"]["numerators"]["DEMAND_CAPPED"]
+    first = (
+        "**Under the demand-capped numerator, the nearest-start reference is "
+        f"{pct(capped_sealed['reference_below_best_found'])} (`SEALED`) and "
+        f"{pct(capped_margin['reference_below_best_found'])} (`MARGIN_Q`) below the "
+        "numerator-selected best value found (denominator: that rule's best-found demand-capped EE).**"
+    )
+    lines = [
+        first,
+        "",
+        "# Multi-start demand-capped rescore — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM` · recorded assignments only · no search rerun",
+        "",
+        "The recorded 128 endpoints and 128 recorded F-best swap configurations were replayed on "
+        "the same immutable world tapes, all 48 realised boundaries, `fading_quantile_alpha = 0.10`, "
+        "and the original provisioning rule. No learner or policy run was performed. No sealed "
+        "constant, threshold, sign, seed, horizon, price, guard, acceptance rule, control law, "
+        "search grid, manifest, or optimizer setting was changed.",
+        "",
+        "## Verified by running code",
+        "",
+        "### Capacity parity gate",
+        "",
+        "The gate passed before any rescore was summarized: all 128 recorded endpoints reproduce "
+        "receipt `bits`, `joules`, `ee_bit_per_j`, and `served_count` exactly at binary64. The 128 "
+        "recorded committed F-best swaps also reproduce exactly. Maximum absolute difference is "
+        "zero for each floating field; configuration IDs and all 16 receipt digests also match.",
+        "",
+        "| evaluated object | exact bits | exact joules | exact EE | exact served count |",
+        "|---|---:|---:|---:|---:|",
+        "| recorded endpoints | 128/128 | 128/128 | 128/128 | 128/128 |",
+        "| recorded F-best swaps | 128/128 | 128/128 | 128/128 | 128/128 |",
+        "",
+        "Each endpoint record then serializes every boundary, the exact rational subslot start/end, "
+        "and every active user's delivered bits for that 0.640 s boundary interval. These records "
+        "reconstruct per-user endpoint delivery before the 1.504 Gbit cap is applied.",
+        "",
+        "### Three numerators",
+        "",
+        "For each numerator, best-of-8 and best-found selection is performed only among the already "
+        "recorded configurations, using that numerator's EE; it does not create or search an assignment. "
+        "Best-found includes each endpoint and its already-recorded F-best swap. The frozen raw-capacity "
+        "choice is also serialized separately so this reselection convention is auditable.",
+        "",
+    ]
+    for rule in RULES:
+        lines.extend(
+            [
+                f"#### `{rule}`",
+                "",
+                "| numerator | nearest-start reference EE (Mbit/J) | pooled per-anchor best-of-8 EE (Mbit/J) | pooled best found incl. recorded swaps (Mbit/J) | best found exceeds reference (denom: reference) | reference below best found (denom: best found) |",
+                "|---|---:|---:|---:|---:|---:|",
+            ]
+        )
+        summary = summaries[rule]
+        for numerator in ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY"):
+            row = summary["numerators"][numerator]
+            lines.append(
+                f"| `{numerator}` | {ee(row['nearest_start_reference']['efficiency_bit_per_j'])} "
+                f"| {ee(row['pooled_per_anchor_best_of_8']['efficiency_bit_per_j'])} "
+                f"| {ee(row['pooled_best_found_including_recorded_F_best_swaps']['efficiency_bit_per_j'])} "
+                f"| {pct(row['best_found_exceeds_reference'])} "
+                f"| {pct(row['reference_below_best_found'])} |"
+            )
+        lines.extend(
+            [
+                "",
+                "| numerator | pooled same-index start spread (`max/min − 1`) | maximum anchor spread (`max/min − 1`) |",
+                "|---|---:|---:|",
+            ]
+        )
+        for numerator in ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY"):
+            row = summary["numerators"][numerator]
+            lines.append(
+                f"| `{numerator}` | {pct(row['pooled_same_index_start_spread_max_over_min_minus_one'])} "
+                f"| {pct(row['maximum_anchor_spread_max_over_min_minus_one'])} |"
+            )
+        lines.append("")
+
+    lines.extend(
+        [
+            "Definitions:",
+            "",
+            "- `CAPACITY`: sum of integrated delivered ACM-capacity bits.",
+            "",
+            "- `DEMAND_CAPPED`: integrate separately for each user over 47 × 0.640 s = 30.08 s; "
+            "then apply `min(user delivery, 50 Mbit/s × 30.08 s)` = `min(user delivery, 1.504 Gbit)`; "
+            "then pool users and anchors. One user's surplus is never transferred to another.",
+            "",
+            "- `ATTAINMENT_ONLY`: credit uncapped integrated ACM-capacity bits only for user-anchors "
+            "whose own integrated delivery is at least 1.504 Gbit.",
+            "",
+            "### Where the raw extra capacity went",
+            "",
+            "Cohorts are fixed by attainment under the nearest-start reference. The comparison uses "
+            "the per-anchor raw-`CAPACITY` best found among recorded endpoints and recorded F-best swaps, "
+            "then sums `best-found delivery − reference delivery` within each cohort.",
+            "",
+        ]
+    )
+    for rule in RULES:
+        split = summaries[rule]["extra_capacity_cohorts"]
+        lines.extend(
+            [
+                f"#### `{rule}` cohorts",
+                "",
+                "| nearest-reference cohort | user-anchors | raw-capacity increment (Gbit) | share of raw increment | demand-capped increment (Gbit) |",
+                "|---|---:|---:|---:|---:|",
+            ]
+        )
+        total_capacity = math.fsum(row["capacity_extra_bits"] for row in split.values())
+        total_capped = math.fsum(row["demand_capped_extra_bits"] for row in split.values())
+        for key, label in (
+            ("nearest_reference_attainers", "Already attained"),
+            ("nearest_reference_non_attainers", "Did not attain"),
+        ):
+            row = split[key]
+            lines.append(
+                f"| {label} | {row['user_anchor_count']} | {gbit(row['capacity_extra_bits'])} "
+                f"| {pct(row['share_of_capacity_increment'])} | {gbit(row['demand_capped_extra_bits'])} |"
+            )
+        lines.append(
+            f"| Total | 800 | {gbit(total_capacity)} | 100.0000% | {gbit(total_capped)} |"
+        )
+        lines.append("")
+
+    audits = []
+    for anchor in data["anchors"]:
+        for endpoint in anchor["endpoints"]:
+            if endpoint["demand_capped_swap_audit"] is not None:
+                audits.append((anchor, endpoint, endpoint["demand_capped_swap_audit"]))
+    f_nonoptimal = sum(not audit[2]["receipt_F_is_two_swap_optimal"] for audit in audits)
+    capped_nonoptimal = sum(not audit[2]["is_demand_capped_two_swap_optimal"] for audit in audits)
+    lines.extend(
+        [
+            "### Predeclared 2-swap subset",
+            "",
+            "Before results were observed, the subset was fixed as start 0 on the first receipt-order "
+            "anchor (`w1/s0`) under each rule: 2/128 endpoints. Every assignment-legal exchange was "
+            "screened at the unchanged one-boundary nearest-baseline served guard, then all eligible "
+            "swaps were committed over 48 boundaries and compared by strict binary64 demand-capped "
+            "pooled user efficiency. These newly tested capped swaps are diagnostic only and are not "
+            "fed into the headroom tables.",
+            "",
+            "| rule/endpoint | legal pairs | eligible after physical validity + guard | F-improving swaps in source | demand-capped-improving swaps | not F-2-swap-optimal | not demand-capped-2-swap-optimal | best capped gain |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for anchor, endpoint, audit in audits:
+        best = audit["best_improving_swap"]
+        lines.append(
+            f"| `{anchor['rule']} {anchor['anchor']} start {endpoint['start_index']}` "
+            f"| {audit['legal_swap_pair_count']} | {audit['eligible_committed_swap_count']} "
+            f"| {audit['receipt_F_feasible_improving_swap_count']} "
+            f"| {audit['strictly_demand_capped_improving_swap_count']} "
+            f"| {'yes' if not audit['receipt_F_is_two_swap_optimal'] else 'no'} "
+            f"| {'yes' if not audit['is_demand_capped_two_swap_optimal'] else 'no'} "
+            f"| {'—' if best is None else signed_pct(best['relative_gain_over_endpoint'])} |"
+        )
+    lines.extend(
+        [
+            f"| **subset count** | — | — | — | — | **{f_nonoptimal}/2** | **{capped_nonoptimal}/2** | — |",
+            "",
+            "The original full-set statement remains a verified receipt fact—128/128 were not "
+            "2-swap optimal for one-boundary `F = B − eta_ref E`—but it is not evidence about the "
+            "reporting numerator. Only the predeclared 2-endpoint subset was fully retested under "
+            "demand-capped committed EE; a full 128-endpoint capped swap census was infeasible in the "
+            "available run budget and was not silently replaced by a proxy.",
+            "",
+            "## Derived on paper",
+            "",
+            "All pooled EEs above are `sum credited bits / sum joules`, never averages of anchor EEs. "
+            "`best found exceeds reference = EE_best / EE_ref − 1` (reference denominator). "
+            "`reference below best found = 1 − EE_ref / EE_best` (best-found denominator). Spreads are "
+            "`max/min − 1`. Cohort shares divide each signed raw-capacity cohort increment by their "
+            "reconciled total.",
+            "",
+            "## Inferred",
+            "",
+            "The comparison measures reporting-numerator sensitivity of this recorded assignment set. "
+            "It does not establish a learner-recoverable gain, a global optimum, or a sealed-result "
+            "correction. Loss values were not used as evidence about EE.",
+            "",
+            "## Serialized evidence and provenance",
+            "",
+            f"- Aggregate plus records: `{OUTPUT_PATH}`",
