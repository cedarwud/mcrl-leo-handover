            prior_policy = prior_anchor[policy_name]
            for field in ("bits", "joules", "ee_bit_per_j", "served_count", "rate_target_attained_count", "mode_counts"):
                assert policy[field] == prior_policy[field], (anchor["anchor_id"], policy_name, field)

            records = policy["records"]
            digest = hashlib.sha256(canonical_bytes(records)).hexdigest()
            assert digest == policy["records_sha256"]
            entry[f"{policy_name}_records_sha256"] = digest

            by_boundary = defaultdict(list)
            reconstructed = defaultdict(list)
            endpoint_flags = {
                row["user_id"]: row["rate_target_attained"]
                for row in records["per_user_endpoint"]
            }
            for subslot in records["subslots"]:
                by_boundary[subslot["boundary_index"]].append(subslot)
                identities = set()
                for transmission in subslot["transmissions"]:
                    identity = tuple(transmission["beam_identity"])
                    assert identity not in identities
                    identities.add(identity)
                    assert transmission["radiated_power_w"] >= 0.0
                    assert transmission["transmitted_mode_index"] >= -1
                    assert transmission["rate_target_attained_over_endpoint"] == endpoint_flags[
                        transmission["user_id"]
                    ]
                    reconstructed[transmission["user_id"]].append(
                        subslot["endpoint_trapezoid_weight"]
                        * transmission["delivered_bits_for_one_boundary_interval_s"]
                    )
            assert sorted(by_boundary) == list(range(48))
            for boundary, subslots in by_boundary.items():
                assert [row["rational_subslot_index"] for row in subslots] == list(range(len(subslots)))
                cursor = Fraction(0, 1)
                for subslot in subslots:
                    start = Fraction(*subslot["rational_subslot_start"])
                    end = Fraction(*subslot["rational_subslot_end"])
                    assert start == cursor and end > start, boundary
                    cursor = end
                assert cursor == 1, boundary

            per_user = {row["user_id"]: row for row in records["per_user_endpoint"]}
            assert len(per_user) == 100
            for user_id, row in per_user.items():
                rebuilt = math.fsum(reconstructed[user_id])
                assert close(rebuilt, row["delivered_bits_over_endpoint"]), (user_id, rebuilt, row)
                assert row["rate_target_attained"] == (row["delivered_bits_over_endpoint"] >= demand_bits)
            rebuilt_total = math.fsum(row["delivered_bits_over_endpoint"] for row in per_user.values())
            assert close(rebuilt_total, policy["bits"])
            accounting = policy["accounting"]
            expected = {
                "CAPACITY": rebuilt_total,
                "DEMAND_CAPPED": math.fsum(
                    min(row["delivered_bits_over_endpoint"], demand_bits) for row in per_user.values()
                ),
                "ATTAINMENT_ONLY": math.fsum(
                    row["delivered_bits_over_endpoint"]
                    for row in per_user.values()
                    if row["rate_target_attained"]
                ),
            }
            for numerator, bits in expected.items():
                assert close(bits, accounting[numerator]["credited_bits"])
                assert close(bits / policy["joules"], accounting[numerator]["efficiency_bit_per_j"])
        manifest.append(entry)

    assert manifest == result["records_digest_manifest"]
    assert hashlib.sha256(canonical_bytes(manifest)).hexdigest() == result["records_manifest_sha256"]
    assert result["extra_bits_split_by_declared_attainment"]["baseline_attainers"]["user_anchor_count"] == 142
    assert result["extra_bits_split_by_declared_attainment"]["baseline_non_attainers"]["user_anchor_count"] == 58
    assert sum(anchor["best_found"]["rate_target_attained_count"] for anchor in result["anchors"]) == 200

    print(
        "PASS: prior aggregates/search counts match; 4 record digests verify; "
        "all 48-boundary rational subslots reconstruct 200 per-user endpoints; "
        "three numerators and the 142/58 split reconcile"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Render FAST-LOOK-RESCORED-2026-09-10.md from verified JSON."""

from __future__ import annotations

import json
import hashlib
import math
from pathlib import Path


WORKSPACE = Path(__file__).resolve().parents[2]
RESULT_PATH = WORKSPACE / ".scratch/control-law-rescored/fast-look-rescored.json"
REPORT_PATH = WORKSPACE / "FAST-LOOK-RESCORED-2026-09-10.md"


def pct(value: float) -> str:
    return f"{100.0 * value:+.3f}%"


def gbit(value: float) -> str:
    return f"{value / 1e9:.3f}"


def mbit_per_j(value: float) -> str:
    return f"{value / 1e6:.3f}"


def main() -> int:
    data = json.loads(RESULT_PATH.read_text(encoding="ascii"))
    pooled = data["pooled"]["accounting"]
    split = data["extra_bits_split_by_declared_attainment"]
    capacity_extra = (
        pooled["CAPACITY"]["best_found_credited_bits"]
        - pooled["CAPACITY"]["declared_credited_bits"]
    )
    already = split["baseline_attainers"]["capacity_extra_bits"]
    non_attainers = split["baseline_non_attainers"]["capacity_extra_bits"]
    useful_non_attainers = split["baseline_non_attainers"]["demand_capped_extra_bits"]
    surplus_non_attainers = non_attainers - useful_non_attainers
    declared_joules = math.fsum(anchor["declared"]["joules"] for anchor in data["anchors"])
    found_joules = math.fsum(anchor["best_found"]["joules"] for anchor in data["anchors"])
    bits_gain = (
        pooled["CAPACITY"]["best_found_credited_bits"]
        / pooled["CAPACITY"]["declared_credited_bits"]
        - 1.0
    )
    joules_gain = found_joules / declared_joules - 1.0

    lines = [
        (
            f"**Demand-capped pooled efficiency improves only {pct(pooled['DEMAND_CAPPED']['relative_gain'])}, "
            f"versus {pct(pooled['CAPACITY']['relative_gain'])} under raw capacity; of the "
            f"{gbit(capacity_extra)} Gbit raw-capacity increment, {gbit(already)} Gbit went to the "
            f"142 user-anchors already at target, while {gbit(non_attainers)} Gbit went to the 58 "
            f"baseline non-attainers—only {gbit(useful_non_attainers)} Gbit brought them to target "
            f"and {gbit(surplus_non_attainers)} Gbit was surplus beyond target.**"
        ),
        "",
        "`DIAGNOSTIC_NOT_CLAIM` · `FAST_LOOK_TWO_ANCHORS`",
        "",
        "# Fast look rescored",
        "",
        "The same fixed-assignment coarse search is reproducible and its raw-capacity result is unchanged. "
        "Once delivered bits are capped at each user's contracted demand, the apparent two-anchor gain "
        "deflates from +113.412% to +0.273%. This is a diagnostic on a copy: no learner or training was "
        "run, and no sealed constant, threshold, sign, seed, horizon, price, guard, acceptance rule, "
        "declared control law, assignment, search grid, or optimizer setting was changed.",
        "",
        "## Pooled result under three numerators",
        "",
        f"All three efficiencies use the policy's own pooled energy: {declared_joules:.6f} J for the declared law "
        f"and {found_joules:.6f} J for the best-found settings ({pct(joules_gain)}).",
        "",
        "| Numerator | Declared credited bits (Gbit) | Best-found credited bits (Gbit) | Declared efficiency (Mbit/J) | Best-found efficiency (Mbit/J) | Relative gain |",
        "|---|---:|---:|---:|---:|---:|",
    ]
    for name in ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY"):
        row = pooled[name]
        lines.append(
            f"| `{name}` | {gbit(row['declared_credited_bits'])} | {gbit(row['best_found_credited_bits'])} "
            f"| {mbit_per_j(row['declared_efficiency_bit_per_j'])} "
            f"| {mbit_per_j(row['best_found_efficiency_bit_per_j'])} | {pct(row['relative_gain'])} |"
        )
    lines.extend(
        [
            "",
            "Definitions:",
            "",
            "- `CAPACITY` is delivered ACM-capacity bits after the unchanged 48-boundary, 47-interval "
            "trapezoidal integration. It is the prior headline numerator.",
            "",
            "- `DEMAND_CAPPED` first performs that integration separately for every user over the full "
            "30.08 s endpoint, then applies `min(user integrated delivery, 50 Mbit/s × 30.08 s)`—a "
            "1.504 Gbit cap per user-anchor—and only then pools users and anchors. This placement is "
            "faithful to the field convention because demand is contracted per user over the endpoint: "
            "it allows one user's delivery to vary across rational subslots and boundaries, while "
            "preventing surplus capacity for that user from satisfying another user's unmet demand.",
            "",
            "- `ATTAINMENT_ONLY` credits the integrated ACM-capacity bits of a user-anchor only when that "
            "user reaches 1.504 Gbit over the endpoint. It does not cap surplus for an attainer. Since all "
            "200 best-found user-anchors attain, its best-found numerator equals `CAPACITY`.",
            "",
            "## Where the extra capacity went",
            "",
            "The split below classifies each user-anchor by its attainment under the declared law, then "
            "sums `best-found delivery − declared delivery` within the two fixed cohorts.",
            "",
            "| Declared-law cohort | User-anchors | Raw-capacity increment (Gbit) | Share of raw increment | Demand-capped increment (Gbit) |",
            "|---|---:|---:|---:|---:|",
            f"| Already attained | 142 | {gbit(already)} | {100.0 * already / capacity_extra:.3f}% | "
            f"{gbit(split['baseline_attainers']['demand_capped_extra_bits'])} |",
            f"| Did not attain | 58 | {gbit(non_attainers)} | {100.0 * non_attainers / capacity_extra:.3f}% | "
            f"{gbit(useful_non_attainers)} |",
            f"| Total | 200 | {gbit(capacity_extra)} | 100.000% | "
            f"{gbit(pooled['DEMAND_CAPPED']['best_found_credited_bits'] - pooled['DEMAND_CAPPED']['declared_credited_bits'])} |",
            "",
            f"Thus {gbit(already)} Gbit of the extra raw capacity was entirely unrequested by users already "
            f"at target. The 58 non-attainers received {gbit(non_attainers)} Gbit extra, but their pooled "
            f"shortfall was only {gbit(useful_non_attainers)} Gbit; after filling it, "
            f"{gbit(surplus_non_attainers)} Gbit was additional unrequested capacity.",
            "",
            "## Capacity-parity check and attainment",
            "",
            f"The rerun reproduces the prior pooled capacity-efficiency headline exactly at binary64: "
            f"{mbit_per_j(pooled['CAPACITY']['declared_efficiency_bit_per_j'])} → "
            f"{mbit_per_j(pooled['CAPACITY']['best_found_efficiency_bit_per_j'])} Mbit/J, "
            f"{pct(pooled['CAPACITY']['relative_gain'])}. Integrated capacity bits rise "
            f"{pct(bits_gain)}, while joules rise {pct(joules_gain)}.",
            "",
            "| Anchor | Declared → best-found target attainers | Declared → best-found capacity (Gbit) | Declared → best-found energy (J) | Power/mode comparisons |",
            "|---|---:|---:|---:|---:|",
        ]
    )
    for anchor in data["anchors"]:
        lines.append(
            f"| Step {anchor['step_index']} | {anchor['declared']['rate_target_attained_count']} → "
            f"{anchor['best_found']['rate_target_attained_count']} | "
            f"{gbit(anchor['declared']['bits'])} → {gbit(anchor['best_found']['bits'])} | "
            f"{anchor['declared']['joules']:.3f} → {anchor['best_found']['joules']:.3f} | "
            f"{anchor['power_mode_comparisons']:,} |"
        )
    lines.extend(
        [
            "",
            "The demand-capped anchor-local efficiency changes are −0.238% at step 0 and +0.759% at "
            "step 1. Pooling credited bits and joules—not averaging those two percentages—gives +0.273%.",
            "",
            "## Serialized records and digests",
            "",
            "The aggregate-and-record artifact is `.scratch/control-law-rescored/fast-look-rescored.json` "
            f"({RESULT_PATH.stat().st_size:,} bytes in this run). For both `declared` and `best_found`, each anchor stores:",
            "",
            "- every boundary and exact rational subslot start/end, plus its endpoint trapezoid weight;",
            "",
            "- for every active beam: fixed beam identity, user ID, chosen radiated power, transmitted ACM "
            "mode (including `NO_TRANSMISSION`), delivered bits for one 0.640 s boundary interval after "
            "the rational TDM fraction, and the user's endpoint attainment flag;",
            "",
            "- per-user integrated endpoint delivery and attainment, from which all three numerators are rescored.",
            "",
            "| Anchor/policy record payload | SHA-256 |",
            "|---|---|",
        ]
    )
    for anchor, item in zip(data["anchors"], data["records_digest_manifest"], strict=True):
        lines.append(f"| Step {anchor['step_index']}, declared | `{item['declared_records_sha256']}` |")
        lines.append(f"| Step {anchor['step_index']}, best found | `{item['best_found_records_sha256']}` |")
    lines.extend(
        [
            f"| Digest manifest | `{data['records_manifest_sha256']}` |",
            "",
            "The verifier recomputes every digest, checks rational subslots partition every boundary, "
            "reconstructs all 200 user-anchor endpoint deliveries from subslot records, recomputes the "
            "three numerators and cohort split, and confirms prior aggregate/search-count parity.",
            "",
            "## Search identity and provenance",
            "",
            "The wrapper imports and executes the prior search functions unchanged. Its only hooks annotate "
            "the slots and replace aggregate-only integration output with aggregate-plus-record output. The "
            "prior script and corrected receipt/runner remain read-only in the prior workspace.",
            "",
            "| Item | Value |",
            "|---|---|",
            f"| Prior search script SHA-256 | `{data['provenance']['prior_script_sha256']}` |",
            f"| Prior aggregate result SHA-256 | `{data['provenance']['prior_result_sha256']}` |",
            f"| World SHA-256 | `{data['world_sha256']}` |",
            f"| Training seed (unchanged provenance; no training run) | `{data['training_seed']}` |",
            f"| Step-0 fixed assignment SHA-256 | `{hashlib.sha256(data['anchors'][0]['configuration_id'].encode('ascii')).hexdigest()}` |",
            f"| Step-1 fixed assignment SHA-256 | `{hashlib.sha256(data['anchors'][1]['configuration_id'].encode('ascii')).hexdigest()}` |",
            f"| Recorded-search wall time | {data['wall_seconds']:.3f} s |",
            "| Concurrency | One process; numerical-library threads pinned to one |",
            "",
            "The unchanged power grid is `0, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875, 1.0, "
            "1.125, 1.25, 1.5, 2.0 × declared power`, clipped to 1.65 W with 1.65 W explicitly "
            "included. The same 28 ACM modes plus no transmission, four coordinate sweeps per subslot, "
            "three efficiency-ratio updates per anchor, fixed `ORACLE_SET` assignment, full coupled "
            "interference recomputation, service guard, and no-below-declared per-slot spectral-efficiency "
            "acceptance condition were reused.",
            "",
            "## Exact reproduction commands",
            "",
            "Run from `/home/sat/mcrl-v025-floor-ws`:",
            "",
            "```bash",
            "nice -n 15 env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/control-law-rescored/fast_look_rescored.py",
            "nice -n 15 env PYTHONPATH=src /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/control-law-rescored/verify_rescored.py",
            "nice -n 15 env PYTHONPATH=src /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/control-law-rescored/render_report.py",
            "```",
            "",
            "Expected verifier line:",
            "",
            "```text",
            "PASS: prior aggregates/search counts match; 4 record digests verify; all 48-boundary rational subslots reconstruct 200 per-user endpoints; three numerators and the 142/58 split reconcile",
            "```",
        ]
    )
    REPORT_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(REPORT_PATH)
    return 0


