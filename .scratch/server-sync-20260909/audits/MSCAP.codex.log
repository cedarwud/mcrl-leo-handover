+        total_capacity = math.fsum(row["capacity_extra_bits"] for row in split.values())
+        total_capped = math.fsum(row["demand_capped_extra_bits"] for row in split.values())
+        for key, label in (
+            ("nearest_reference_attainers", "Already attained"),
+            ("nearest_reference_non_attainers", "Did not attain"),
+        ):
+            row = split[key]
+            lines.append(
+                f"| {label} | {row['user_anchor_count']} | {gbit(row['capacity_extra_bits'])} "
+                f"| {pct(row['share_of_capacity_increment'])} | {gbit(row['demand_capped_extra_bits'])} |"
+            )
+        lines.append(
+            f"| Total | 800 | {gbit(total_capacity)} | 100.0000% | {gbit(total_capped)} |"
+        )
+        lines.append("")
+
+    audits = []
+    for anchor in data["anchors"]:
+        for endpoint in anchor["endpoints"]:
+            if endpoint["demand_capped_swap_audit"] is not None:
+                audits.append((anchor, endpoint, endpoint["demand_capped_swap_audit"]))
+    f_nonoptimal = sum(not audit[2]["receipt_F_is_two_swap_optimal"] for audit in audits)
+    capped_nonoptimal = sum(not audit[2]["is_demand_capped_two_swap_optimal"] for audit in audits)
+    lines.extend(
+        [
+            "### Predeclared 2-swap subset",
