from __future__ import annotations

import json
import sys
from collections import Counter
from pathlib import Path

import numpy as np

WS = Path("/home/sat/mcrl-v025-headroom-ws")
TAG = sys.argv[1] if len(sys.argv) > 1 else "R0"
PA_SAT_W = 1.65 * 10.0 ** 0.5
ETA_MAX = 0.35
CAP_W = 1.65

rec = dict(np.load(WS / f".work/records-{TAG}.npz"))
us = np.load(WS / f".work/usersteps-{TAG}.npy")
val = json.loads((WS / f".work/validation-{TAG}.json").read_text())

noise = rec["noise_w"]
gam = rec["gamma"]
forced = rec["forced"].astype(bool)
power = rec["power_w"]
sinr = power * rec["direct_nom"] / (noise + rec["i_nom_w"])
sinr_if = power * rec["direct_nom"] / noise
thr = np.nan_to_num(gam, nan=np.inf) * (1.0 - 1.0e-10)
feas_tx = (~np.isnan(gam)) & (sinr >= thr)
feas_if_tx = (~np.isnan(gam)) & (sinr_if >= thr)
inr = rec["i_nom_w"] / noise
inr_db = 10.0 * np.log10(np.maximum(inr, 1e-300))

# how many arms use each distinct committed configuration
arm_weight = Counter()
for row in val:
    arm_weight[(row["anchor"], row["arm"])] = 0
gcfg_arm_count = Counter()
for row in val:
    gcfg_arm_count[row["anchor"]] += 0
# reconstruct: usersteps carry (anchor, arm, cfg)
w = Counter()
for r in us:
    w[(int(r["anchor"]), int(r["cfg"]))] += 1
# each (anchor,cfg) appears once per arm per user -> divide by user count
n_users = len({int(r["user"]) for r in us})
weight_of = {k: v // n_users for k, v in w.items()}
gkey = rec["anchor"].astype(np.int64) * 100 + (rec["gcfg"] % 100)
tx_w = np.asarray(
    [weight_of[(int(a), int(g % 100))] for a, g in zip(rec["anchor"], rec["gcfg"])],
    dtype=np.float64,
)

out: dict[str, object] = {"tag": TAG}


def pct(a, b):
    return None if b == 0 else 100.0 * a / b


# ---------------- item 1 ---------------------------------------------------
infeas = ~us["feasible"]
rescued = infeas & us["feasible_if"]
out["user_steps"] = int(us.size)
out["infeasible_user_steps"] = int(infeas.sum())
out["infeasible_share_pct"] = pct(int(infeas.sum()), us.size)
out["rescued_user_steps"] = int(rescued.sum())
out["rescued_share_of_infeasible_pct"] = pct(int(rescued.sum()), int(infeas.sum()))
out["rescued_share_of_all_pct"] = pct(int(rescued.sum()), us.size)
out["feasible_after_pct"] = pct(int(us["feasible_if"].sum()), us.size)
# sanity: interference can only help
out["monotone_no_user_step_lost"] = bool(np.all(us["feasible_if"] | ~us["feasible"]))

no_mode = rec["m_tx_idx"] < 0
no_mode_if = rec["m_tx_if_idx"] < 0
out["transmissions_weighted"] = float(tx_w.sum())
out["no_mode_transmissions_weighted"] = float(tx_w[no_mode].sum())
out["no_mode_share_pct"] = pct(float(tx_w[no_mode].sum()), float(tx_w.sum()))
moved = no_mode & ~no_mode_if
out["no_mode_moved_off_weighted"] = float(tx_w[moved].sum())
out["no_mode_moved_off_share_pct"] = pct(
    float(tx_w[moved].sum()), float(tx_w[no_mode].sum())
)
out["no_mode_share_after_pct"] = pct(
    float(tx_w[no_mode_if].sum()), float(tx_w.sum())
)

# ---------------- item 2 ---------------------------------------------------
def q(x, weights):
    if x.size == 0:
        return None
    o = np.argsort(x)
    xs, ws = x[o], weights[o]
    c = np.cumsum(ws) / ws.sum()
    return {
        f"p{int(p*100)}": float(np.interp(p, c, xs))
        for p in (0.01, 0.05, 0.25, 0.50, 0.75, 0.95, 0.99)
    }


out["inr_db_all"] = q(inr_db, tx_w)
out["inr_db_feasible_tx"] = q(inr_db[feas_tx], tx_w[feas_tx])
out["inr_db_infeasible_tx"] = q(inr_db[~feas_tx], tx_w[~feas_tx])
for label, mask in (("all", np.ones_like(feas_tx)), ("feasible", feas_tx), ("infeasible", ~feas_tx)):
    tot = float(tx_w[mask].sum())
    out[f"inr_below_minus10db_share_pct_{label}"] = pct(
        float(tx_w[mask & (inr_db < -10.0)].sum()), tot
    )
    out[f"inr_below_0db_share_pct_{label}"] = pct(
        float(tx_w[mask & (inr_db < 0.0)].sum()), tot
    )
    out[f"inr_above_0db_share_pct_{label}"] = pct(
        float(tx_w[mask & (inr_db >= 0.0)].sum()), tot
    )
out["zero_interference_share_pct_all"] = pct(
    float(tx_w[rec["i_nom_w"] == 0.0].sum()), float(tx_w.sum())
)

# ---------------- item 3 ---------------------------------------------------
bad = ~feas_tx
cls = np.full(bad.size, "", dtype=object)
cls[bad & forced] = "MODE_INFEASIBLE"
cls[bad & ~forced & feas_if_tx] = "INTERFERENCE_LIMITED"
cls[bad & ~forced & ~feas_if_tx] = "NOISE_LIMITED"
tx_classes = {}
for name in ("MODE_INFEASIBLE", "INTERFERENCE_LIMITED", "NOISE_LIMITED"):
    m = cls == name
    tx_classes[name] = {
        "weighted": float(tx_w[m].sum()),
        "share_of_failing_pct": pct(float(tx_w[m].sum()), float(tx_w[bad].sum())),
        "at_cap_pct": pct(
            float(tx_w[m & (power >= CAP_W - 1e-9)].sum()), float(tx_w[m].sum())
        ),
    }
out["failing_transmissions_weighted"] = float(tx_w[bad].sum())
out["failing_transmission_classes"] = tx_classes
out["failing_transmissions_at_cap_pct"] = pct(
    float(tx_w[bad & (power >= CAP_W - 1e-9)].sum()), float(tx_w[bad].sum())
)
out["feasible_transmissions_at_cap_pct"] = pct(
    float(tx_w[feas_tx & (power >= CAP_W - 1e-9)].sum()), float(tx_w[feas_tx].sum())
)

# user-step classification
key = rec["anchor"].astype(np.int64) * 1000 + (rec["gcfg"] % 100) * 1000000 + rec["user"]
order = np.argsort(key, kind="stable")
ks, cs, fo, fi = key[order], cls[order], forced[order], feas_if_tx[order]
bd = bad[order]
bounds = np.flatnonzero(np.r_[True, ks[1:] != ks[:-1], True])
group_reason: dict[int, str] = {}
for i in range(len(bounds) - 1):
    lo, hi = bounds[i], bounds[i + 1]
    if not bd[lo:hi].any():
        continue
    still = bd[lo:hi] & ~fi[lo:hi]
    if not still.any():
        group_reason[int(ks[lo])] = "INTERFERENCE_LIMITED"
    elif bool(fo[lo:hi][still].all()):
        group_reason[int(ks[lo])] = "MODE_INFEASIBLE"
    else:
        group_reason[int(ks[lo])] = "NOISE_LIMITED"

us_reason = Counter()
for r in us:
    if r["feasible"]:
        continue
    k = int(r["anchor"]) * 1000 + int(r["cfg"]) * 1000000 + int(r["user"])
    us_reason[group_reason.get(k, "UNCLASSIFIED")] += 1
out["infeasible_user_step_classes"] = {
    k: {"count": v, "share_pct": pct(v, int(infeas.sum()))} for k, v in us_reason.items()
}

# ---------------- item 4 ---------------------------------------------------
il = cls == "INTERFERENCE_LIMITED"
if il.any():
    itot = rec["i_nom_w"][il]
    intra = rec["i_intra_sat_w"][il]
    top1 = rec["i_top1_w"][il]
    ww = tx_w[il]
    out["interference_limited_sources"] = {
        "weighted_transmissions": float(ww.sum()),
        "mean_same_satellite_share_pct": float(np.average(intra / itot, weights=ww) * 100.0),
        "mean_other_satellite_share_pct": float(
            np.average(1.0 - intra / itot, weights=ww) * 100.0
        ),
        "same_satellite_dominant_share_pct": pct(
            float(ww[(intra / itot) > 0.5].sum()), float(ww.sum())
        ),
        "top1_share_quantiles": q(top1 / itot, ww),
        "mean_top1_share_pct": float(np.average(top1 / itot, weights=ww) * 100.0),
        "top1_over_half_share_pct": pct(
            float(ww[(top1 / itot) > 0.5].sum()), float(ww.sum())
        ),
        "top1_over_90pct_share_pct": pct(
            float(ww[(top1 / itot) > 0.9].sum()), float(ww.sum())
        ),
        "top1_is_same_satellite_pct": pct(
            float(ww[rec["i_top1_intra"][il].astype(bool)].sum()), float(ww.sum())
        ),
        "contributor_count_quantiles": q(
            rec["n_contrib"][il].astype(np.float64), ww
        ),
        "removing_top1_alone_would_fix_pct": pct(
            float(
                ww[
                    (
                        power[il] * rec["direct_nom"][il]
                        / (noise[il] + itot - top1)
                    )
                    >= thr[il]
                ].sum()
            ),
            float(ww.sum()),
        ),
    }
else:
    out["interference_limited_sources"] = None

# ---------------- item 5 ---------------------------------------------------
def pa_w(p):
    return np.where(p > 0.0, np.sqrt(np.maximum(p, 0.0) * PA_SAT_W) / ETA_MAX, 0.0)


pa_j_all = float(np.sum(pa_w(power) * rec["time_weight_s"] * tx_w))
out["pa_joules_weighted_total"] = pa_j_all
if il.any():
    p_req0 = np.nan_to_num(gam, nan=0.0) * noise / rec["direct_nom"]
    save = (pa_w(power) - pa_w(np.minimum(p_req0, CAP_W))) * rec["time_weight_s"]
    out["energy_recoverable_j"] = float(np.sum(save[il] * tx_w[il]))
    out["energy_recoverable_share_of_pa_pct"] = pct(
        float(np.sum(save[il] * tx_w[il])), pa_j_all
    )
    out["interference_limited_pa_j"] = float(
        np.sum(pa_w(power[il]) * rec["time_weight_s"][il] * tx_w[il])
    )
    out["interference_limited_power_min_w"] = float(power[il].min())
    out["interference_limited_p_req0_max_w"] = float(np.minimum(p_req0, CAP_W)[il].max())
    # per-arm-anchor average
    out["energy_recoverable_j_per_arm_anchor"] = float(
        np.sum(save[il] * tx_w[il]) / len(val)
    )
# whole-population reference: what if every failing transmission dropped to
# its interference-free required power (upper bound, includes noise-limited
# which cannot in fact reach it)
out["pa_joules_failing_at_cap"] = float(
    np.sum(pa_w(power[bad]) * rec["time_weight_s"][bad] * tx_w[bad])
)

out["conventions_used"] = dict(Counter(r["convention"] for r in val))
print(json.dumps(out, indent=1, default=float))
(WS / f".work/summary-{TAG}.json").write_text(json.dumps(out, indent=1, default=float))
from __future__ import annotations

import json
import sys
from collections import Counter, defaultdict
from pathlib import Path

import numpy as np

WS = Path("/home/sat/mcrl-v025-headroom-ws")
TAG = sys.argv[1] if len(sys.argv) > 1 else "R0"
PA_SAT_W = 1.65 * 10.0 ** 0.5
ETA_MAX = 0.35
CAP_W = 1.65

rec = dict(np.load(WS / f".work/records-{TAG}.npz"))
us = np.load(WS / f".work/usersteps-{TAG}.npy")
val = json.loads((WS / f".work/validation-{TAG}.json").read_text())
receipt = json.loads(
    Path("/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/smoke/a-r0-world-1.json").read_bytes()
)

noise = rec["noise_w"]
gam = rec["gamma"]
power = rec["power_w"]
sinr = power * rec["direct_nom"] / (noise + rec["i_nom_w"])
sinr_if = power * rec["direct_nom"] / noise
thr = np.nan_to_num(gam, nan=np.inf) * (1.0 - 1.0e-10)
feas_tx = (~np.isnan(gam)) & (sinr >= thr)
bad = ~feas_tx
shortfall_db = 10.0 * np.log10(np.maximum(thr, 1e-300) / np.maximum(sinr, 1e-300))
inr_db = 10.0 * np.log10(np.maximum(rec["i_nom_w"] / noise, 1e-300))
interference_tax_db = 10.0 * np.log10((noise + rec["i_nom_w"]) / noise)

out: dict[str, object] = {"tag": TAG}

# ---- energy-model validation against the sealed receipt --------------------
def pa_w(p):
    return np.where(p > 0.0, np.sqrt(np.maximum(p, 0.0) * PA_SAT_W) / ETA_MAX, 0.0)


pa_row = pa_w(power) * rec["time_weight_s"]
by_cfg = defaultdict(float)
for a, g, v in zip(rec["anchor"], rec["gcfg"], pa_row):
    by_cfg[(int(a), int(g) % 100)] += float(v)
cfg_of = {(r["anchor"], r["arm"]): None for r in val}
errs = []
for step_row in receipt["steps"]:
    anchor = int(step_row["anchor_index"])
    order: list[str] = []
    for arm in step_row["arms"]:
        if arm["configuration_id"] not in order:
            order.append(arm["configuration_id"])
    for arm in step_row["arms"]:
        ci = order.index(arm["configuration_id"])
        got = by_cfg[(anchor, ci)]
        want = float(arm["energy"]["pa_j"])
        errs.append(abs(got - want) / want)
out["pa_j_max_relative_error_vs_receipt"] = float(max(errs))
out["pa_j_checked_arm_anchors"] = len(errs)

# ---- how marginal are the failing transmissions? --------------------------
w = Counter()
for r in us:
    w[(int(r["anchor"]), int(r["cfg"]))] += 1
n_users = len({int(r["user"]) for r in us})
weight_of = {k: v // n_users for k, v in w.items()}
