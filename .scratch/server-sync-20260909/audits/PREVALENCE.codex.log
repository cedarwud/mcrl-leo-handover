def serialize_value(value: object) -> object:
    if isinstance(value, Fraction):
        return {"numerator": value.numerator, "denominator": value.denominator, "decimal": float(value)}
    if isinstance(value, NetworkOutcome):
        return {
            "bits": serialize_value(value.bits),
            "joules": serialize_value(value.joules),
            "phi": serialize_value(value.phi),
            "decoding_availability": serialize_value(value.decoding_availability),
            "useful_availability": serialize_value(value.useful_availability),
            "per_user_bits": [[u, serialize_value(v)] for u, v in value.per_user_bits],
        }
    if isinstance(value, dict):
        return {str(k): serialize_value(v) for k, v in value.items() if k != "result"}
    if isinstance(value, (tuple, list)):
        return [serialize_value(v) for v in value]
    if isinstance(value, (np.floating, np.integer, np.bool_)):
        return value.item()
    return value


def rate_world() -> World:
    beams = [(1, 0), (1, 1), (1, 2), (1, 3), (1, 4)]
    direct = {beam: 20.0 * NOISE for beam in beams}
    users = tuple(UserSpec(user, direct) for user in range(4))
    return World(users, HardwareInventory.fixed(beams), {})


def decode_world() -> World:
    # The nominal target path fixes power; the realised cross-gain surface is
    # deliberately stronger in the interfering configurations.  The surface
    # is supplied to Geometry and all radiation/decode decisions remain in the
    # engine.
    beams = [(1, 0), (1, 1), (1, 2), (1, 3), (1, 4), (1, 5), (1, 6)]
    direct = {beam: 20.0 * NOISE for beam in beams}
    # FixedRF makes the threshold cliff especially transparent: the power is
    # the sealed 1.65 W cap and only the real cross-interference changes.
    nominal_cross: dict[tuple[int, tuple[int, int], int, tuple[int, int]], float] = {}
    realised_cross: dict[tuple[int, tuple[int, int], int, tuple[int, int]], float] = {}
    source_beams = [(1, 0), (1, 1), (1, 2), (1, 3), (1, 4), (1, 5)]
    for victim_user in (0, 1):
        for aggressor_user in (0, 1):
            if victim_user == aggressor_user:
                continue
            for victim_beam in source_beams:
                for aggressor_beam in source_beams:
                    if victim_beam != aggressor_beam:
                        key = (victim_user, victim_beam, aggressor_user, aggressor_beam)
                        nominal_cross[key] = 0.0
                        realised_cross[key] = 0.0
    colors = {beam: 0 for beam in beams}
    users = tuple(
        UserSpec(
            user,
            direct,
            color_by_beam=colors,
            elevation_by_beam={beam: 90.0 for beam in beams},
        )
        for user in range(3)
    )
    # f00: mutual outage.  f10: A leaves, A remains below its decode cliff
    # while B clears.  f01: B's unilateral destination still collides with A.
    # f11: both changed identities, so both links are clean.
    high_i = 1.10 * NOISE / BEAM_RF_CAP_W
    cliffs = (
        (0, (1, 0), 1, (1, 1)),
        (1, (1, 1), 0, (1, 0)),
        (0, (1, 2), 1, (1, 1)),
        (0, (1, 0), 1, (1, 3)),
        (1, (1, 3), 0, (1, 0)),
    )
    for victim_user, victim_beam, aggressor_user, aggressor_beam in cliffs:
        realised_cross[(victim_user, victim_beam, aggressor_user, aggressor_beam)] = high_i
    return World(
        users,
        HardwareInventory.fixed(beams),
        nominal_cross,
        realised_cross,
        architecture=FixedRF(),
    )


def exchange_world() -> World:
    """Two-beam swap with occupied hosts and a served guard pair.

    A/B start on X/Y and exchange X/Y.  A unilateral move makes one host
    beam have occupancy 1 and the destination have occupancy 3; the joint
    swap restores occupancy 2 on each beam.  Low elevation is intentional:
    it exposes the sealed back-off cliff, while users 4/5 at zenith provide
    an invariant served baseline.
    """
    x, y, z = (1, 0), (1, 1), (1, 2)
    beams = [x, y, z]
    values = {
        0: {x: 60.0, y: 100.0},
        1: {x: 160.0, y: 10.0},
        2: {x: 1.0, y: 1.0},
        3: {x: 0.25, y: 0.25},
    }
    users = []
    for user in range(4):
        direct = {beam: values[user].get(beam, values[user][x]) * NOISE for beam in beams}
        users.append(
            UserSpec(
                user,
                direct,
                elevation_by_beam={beam: 80.0 for beam in beams},
            )
        )
    for user in (4, 5):
        users.append(
            UserSpec(
                user,
                {beam: 20.0 * NOISE for beam in beams},
                elevation_by_beam={beam: 90.0 for beam in beams},
            )
        )
    return World(tuple(users), HardwareInventory.fixed(beams), {})


def cap_world() -> World:
    """A cap-release swap using the fixed-RF reference architecture.

    A/B begin on weak links, so the real engine emits 1.65 W and NO_MODE.
    Each unilateral destination still sees a nominal interference cliff and
    therefore remains NO_MODE.  Together the destination links are clean;
    the same fixed cap now carries a credited ACM mode.  Users 2--5 keep all
    five RF beams active and make the service guard non-vacuous.
    """
    sa, sb, da, db, z = (1, 0), (1, 1), (1, 2), (1, 3), (1, 4)
    beams = [sa, sb, da, db, z]
    low = 0.1 * NOISE
    high = 20.0 * NOISE
    users = []
    for user in (0, 1):
        direct = {beam: high for beam in beams}
        direct[sa if user == 0 else sb] = low
        users.append(
            UserSpec(
                user,
                direct,
                elevation_by_beam={beam: 90.0 for beam in beams},
            )
        )
    # Fixed occupants keep every beam active.  They are deliberately strong
    # and isolated from the two cap-release cross terms.
    for user, beam in ((2, sa), (3, sb), (4, da), (5, db)):
        users.append(
            UserSpec(
                user,
                {candidate: high for candidate in beams},
                elevation_by_beam={candidate: 90.0 for candidate in beams},
            )
        )
    nominal_cross: dict[tuple[int, tuple[int, int], int, tuple[int, int]], float] = {
        (0, da, 1, sb): 40.0 * NOISE / BEAM_RF_CAP_W,
        (1, db, 0, sa): 40.0 * NOISE / BEAM_RF_CAP_W,
    }
    return World(
        tuple(users),
        HardwareInventory.fixed(beams),
        nominal_cross,
        nominal_cross,
        architecture=FixedRF(),
    )


def pair_decomposition(rows: Mapping[str, Mapping[str, object]]) -> dict[str, object]:
    """Run the engine's sealed O(|A|) decomposition over the four outcomes."""
    outcomes = {
        frozenset(): rows["a0"]["outcome"],
        frozenset((0,)): rows["a_A"]["outcome"],
        frozenset((1,)): rows["a_B"]["outcome"],
        frozenset((0, 1)): rows["a_AB"]["outcome"],
    }
    result = set_score_decomposition(
        coalition_users=(0, 1),
        outcomes_by_subset=outcomes,  # type: ignore[arg-type]
        lambda_bits_per_j=LAMBDA,
        eta_ref=ETA_REF,
        kappa_bits_per_user_step=KAPPA,
        phi_difference=rows["a_AB"]["phi_cost"] * -1,  # sealed phi_qos preference
    )
    return {
        "d_by_user_physical_core": result.d_by_user,
        "interaction_bits": result.interaction_bits,
        "joint_change_bits": result.joint_change_bits,
        "c1": result.c1,
        "c3": result.c3,
        "c1_plus_c3": result.c1 + result.c3,
        "credit_split": result.credit_split,
        "shapley_interaction_by_user": result.shapley_interaction_by_user,
    }


def main() -> None:
    # Mechanism 2: two users each move alone onto an empty beam (occupancy 1,
    # still NO_MODE); together they create occupancy 2 and both get the lowest
    # transmitted mode.  Users 2/3 are an invariant served guard sentinel.
    rate = rate_world()
    anchor_rate = {0: (1, 0), 1: (1, 1), 2: (1, 2), 3: (1, 2)}
    profiles_rate = {
        "a_A": {0: (1, 3), 1: (1, 1), 2: (1, 2), 3: (1, 2)},
        "a_B": {0: (1, 0), 1: (1, 3), 2: (1, 2), 3: (1, 2)},
        "a_AB": {0: (1, 3), 1: (1, 3), 2: (1, 2), 3: (1, 2)},
    }
    rate_rows = evaluate_profiles(rate, anchor_rate, profiles_rate)

    # Mechanism 1: three-user surface, with user 2 an invariant served guard
    # sentinel.  A and B jointly leave their two-way interference pattern.
    decode = decode_world()
    anchor_decode = {0: (1, 0), 1: (1, 1), 2: (1, 6)}
    profiles_decode = {
        "a_A": {0: (1, 2), 1: (1, 1), 2: (1, 6)},
        "a_B": {0: (1, 0), 1: (1, 3), 2: (1, 6)},
        "a_AB": {0: (1, 2), 1: (1, 3), 2: (1, 6)},
    }
    decode_rows = evaluate_profiles(decode, anchor_decode, profiles_decode)

    exchange = exchange_world()
    anchor_exchange = {0: (1, 0), 1: (1, 1), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 2)}
    profiles_exchange = {
        "a_A": {0: (1, 1), 1: (1, 1), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 2)},
        "a_B": {0: (1, 0), 1: (1, 0), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 2)},
        "a_AB": {0: (1, 1), 1: (1, 0), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 2)},
    }
    exchange_rows = evaluate_profiles(exchange, anchor_exchange, profiles_exchange)

    cap = cap_world()
    anchor_cap = {0: (1, 0), 1: (1, 1), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 3)}
    profiles_cap = {
        "a_A": {0: (1, 2), 1: (1, 1), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 3)},
        "a_B": {0: (1, 0), 1: (1, 3), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 3)},
        "a_AB": {0: (1, 2), 1: (1, 3), 2: (1, 0), 3: (1, 1), 4: (1, 2), 5: (1, 3)},
    }
    cap_rows = evaluate_profiles(cap, anchor_cap, profiles_cap)

    payload = {
        "prices": {
            "lambda": serialize_value(LAMBDA),
            "eta_ref": serialize_value(ETA_REF),
            "kappa": serialize_value(KAPPA),
        },
        "constants": {
            "noise_w": NOISE,
            "beam_bandwidth_hz": BEAM_BANDWIDTH_HZ,
            "decision_interval_s": DECISION_INTERVAL_S,
            "sinr_min": SINR_MIN,
            "acm_modes": [
                {
                    "name": m.name,
                    "spectral_efficiency": m.spectral_efficiency_bit_per_s_hz,
                    "threshold_db": m.threshold_db,
                    "threshold_linear": m.threshold_linear,
                }
                for m in ACM_MODES
            ],
        },
        "mechanism_2_rate_target": serialize_value(rate_rows),
        "mechanism_1_decode_cliff": serialize_value(decode_rows),
        "mechanism_3_exchange": serialize_value(exchange_rows),
        "mechanism_4_cap_release": serialize_value(cap_rows),
        "decompositions": {
            "mechanism_1_decode_cliff": serialize_value(pair_decomposition(decode_rows)),
            "mechanism_2_rate_target": serialize_value(pair_decomposition(rate_rows)),
            "mechanism_3_exchange": serialize_value(pair_decomposition(exchange_rows)),
            "mechanism_4_cap_release": serialize_value(pair_decomposition(cap_rows)),
        },
    }
    out = ENGINE_ROOT / "analysis/psi_witness_raw.json"
    out.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
    print(json.dumps(payload, indent=2, sort_keys=True))


