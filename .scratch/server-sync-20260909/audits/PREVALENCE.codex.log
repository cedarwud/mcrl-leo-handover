@dataclass(frozen=True)
class RadiationSlot:
    start_fraction: float
    end_fraction: float
    beam_rf_w: tuple[tuple[BeamIdentity, float], ...]
    transmissions: tuple[Transmission, ...]
    certificate: PowerCertificate

    @property
    def fraction(self) -> float:
