script part1:
"""Small constructive tests of the V0.25 interaction term.

All B/E/PHY values in this file come from ``resolve_configuration``.  The
scenario builder only supplies a synthetic Geometry; it does not duplicate
the radiation, ACM, or energy equations.
"""

from __future__ import annotations

from dataclasses import dataclass
from fractions import Fraction
import json
from pathlib import Path
from typing import Mapping

import numpy as np

from mcrl.physics_v025.acm import ACM_MODES, ACMRate
from mcrl.physics_v025.architectures import (
    AngleRateTPC_TDM,
    AngleTPC_TDM,
    FixedRF,
    Geometry,
    Link,
    RadiationConfig,
)
from mcrl.physics_v025.channel import noise_power_w
from mcrl.physics_v025.constants_v025 import (
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
    DECISION_INTERVAL_S,
    SINR_MIN,
)
from mcrl.physics_v025.energy import HardwareInventory
from mcrl.physics_v025.resolution import ResolutionResult, resolve_configuration
from mcrl.physics_v025.targets import (
    NetworkOutcome,
    classify_physical_transition,
    network_objective,
    phi_qos,
    set_score_decomposition,
)


ENGINE_ROOT = Path(__file__).resolve().parents[1]
MANIFEST = Path(
    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
)


def load_prices() -> tuple[Fraction, Fraction, Fraction]:
    payload = json.loads(MANIFEST.read_text(encoding="utf-8"))
    cell = payload["cells"][0]
    eta = Fraction(*cell["eta_ref"])
    lam = Fraction(*cell["lambda_bits_per_j"])
    kappa = Fraction(*cell["kappa_bits_per_user_step"])
    if eta != lam:
        raise AssertionError("sealed lambda and eta_ref differ")
    return lam, eta, kappa


LAMBDA, ETA_REF, KAPPA = load_prices()
NOISE = noise_power_w(BEAM_BANDWIDTH_HZ)


@dataclass(frozen=True)
class UserSpec:
    user: int
    direct_by_beam: Mapping[tuple[int, int], float]
    realised_by_beam: Mapping[tuple[int, int], float] | None = None
    color_by_beam: Mapping[tuple[int, int], int] | None = None
    elevation_by_beam: Mapping[tuple[int, int], float] | None = None

    def link(self, beam: tuple[int, int]) -> Link:
        nominal = float(self.direct_by_beam[beam])
        realised = nominal if self.realised_by_beam is None else float(
            self.realised_by_beam[beam]
        )
        color = 0 if self.color_by_beam is None else int(self.color_by_beam[beam])
        elevation = (
            90.0
            if self.elevation_by_beam is None
            else float(self.elevation_by_beam[beam])
        )
        return Link(self.user, beam, color, nominal, realised, elevation)


@dataclass(frozen=True)
class World:
    users: tuple[UserSpec, ...]
    inventory: HardwareInventory
    nominal_cross: Mapping[tuple[int, tuple[int, int], int, tuple[int, int]], float]
    realised_cross: Mapping[tuple[int, tuple[int, int], int, tuple[int, int]], float] | None = None
    architecture: object = AngleRateTPC_TDM()
    rate_target_bps: float = 50_000_000.0
    alpha: float | None = 0.10
    circuit_power_per_active_chain_w: float = 0.338

    def geometry(self, assignments: Mapping[int, tuple[int, int] | None]) -> Geometry:
        links = tuple(
            spec.link(beam)
            for spec in sorted(self.users, key=lambda row: row.user)
            for beam in (assignments.get(spec.user),)
            if beam is not None
        )
        nominal = np.zeros((len(links), len(links)), dtype=np.float64)
        realised = np.zeros_like(nominal)
        for row, victim in enumerate(links):
            for col, aggressor in enumerate(links):
                if row == col:
                    continue
                key = (victim.user_id, victim.beam, aggressor.user_id, aggressor.beam)
                nominal[row, col] = float(self.nominal_cross.get(key, 0.0))
                source = self.nominal_cross if self.realised_cross is None else self.realised_cross
                realised[row, col] = float(source.get(key, 0.0))
        return Geometry(links, nominal, realised)

    def evaluate(self, assignments: Mapping[int, tuple[int, int] | None]) -> ResolutionResult:
        config = RadiationConfig(
            bandwidth_hz=BEAM_BANDWIDTH_HZ,
            beam_cap_w=BEAM_RF_CAP_W,
            rate_target_bps=self.rate_target_bps,
            fading_quantile_alpha=self.alpha,
        )
        return resolve_configuration(
            self.architecture,
            config,
            self.geometry(assignments),
            # The architecture's ACM path is the sealed primary decoder.
            ACMRate(),
            self.inventory,
            duration_s=DECISION_INTERVAL_S,
            field="realised",
        )


def outcome(result: ResolutionResult) -> NetworkOutcome:
    if not result.valid or result.bits is None or result.energy is None:
        raise AssertionError("scenario produced an invalid engine certificate")
    users = tuple(sorted(result.bits))
    count = len(users)
    decoding = result.decoding_time_fraction or {}
    return NetworkOutcome.build(
        bits=sum((Fraction(str(value)) for value in result.bits.values()), Fraction()),
        joules=result.energy.joules,
        phi=0,
        decoding_availability=(
            0.0 if count == 0 else sum(decoding.values()) / count
        ),
        useful_availability=(
            0.0 if count == 0 else sum(decoding.values()) / count
        ),
        per_user_bits=result.bits,
    )


def physical_phi(
    anchor: Mapping[int, tuple[int, int] | None],
    selected: Mapping[int, tuple[int, int] | None],
) -> Fraction:
    events = tuple(
        classify_physical_transition(
            user_id=user,
            before=anchor.get(user),
            after=selected.get(user),
            cell_rekey=False,
            was_previously_served=anchor.get(user) is not None,
        )
        for user in sorted(set(anchor) | set(selected))
    )
    return -phi_qos(events)


def score_f(result: ResolutionResult, phi_cost: Fraction) -> tuple[NetworkOutcome, Fraction]:
    raw = outcome(result)
    core = network_objective(
        raw,
        lambda_bits_per_j=LAMBDA,
        eta_ref=ETA_REF,
        kappa_bits_per_user_step=KAPPA,
    )
    # The sealed target layer stores Phi as a higher-is-better negative
    # preference.  F = B - eta E - cost is therefore core + phi_qos.
    return raw, core - phi_cost


def transmissions(result: ResolutionResult) -> list[dict[str, object]]:
    rows = []
    if not result.valid:
        return rows
    for slot in result.radiation.slots:
        for tx in slot.transmissions:
            rows.append(
                {
                    "user": tx.user_id,
                    "beam": list(tx.beam),
                    "fraction": slot.fraction,
                    "power_w": tx.rf_power_w,
                    "wanted_w": tx.wanted_w,
                    "intra_interference_w": tx.intra_interference_w,
                    "inter_interference_w": tx.inter_interference_w,
                    "nominal_sinr": tx.nominal_sinr,
                    "sinr": tx.sinr,
                    "target_mode": None if tx.m_target is None else tx.m_target.name,
                    "tx_mode": None if tx.m_tx is None else tx.m_tx.name,
                    "target_feasible": tx.rate_target_feasible,
                    "decoded": None
                    if tx.realised_outcome is None
                    else tx.realised_outcome.decoded,
                    "credited_se": None
                    if tx.realised_outcome is None
                    else tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz,
                }
            )
    return rows


def evaluate_profiles(
    world: World,
    anchor: Mapping[int, tuple[int, int] | None],
    profiles: Mapping[str, Mapping[int, tuple[int, int] | None]],
) -> dict[str, dict[str, object]]:
    all_profiles = {"a0": anchor, **profiles}
    evaluated: dict[str, dict[str, object]] = {}
    for label, assignment in all_profiles.items():
        result = world.evaluate(assignment)
        cost = physical_phi(anchor, assignment)
        raw, f_value = score_f(result, cost)
        served_phy = {
            user: bool(result.complete_service and result.complete_service.get(user, False))
            for user in sorted(assignment)
        }
        # This is the same count used by the production selection guard:
        # decoding_time_fraction > 0 (partial service counts as served).
        served_guard = {
            user: bool(
                result.decoding_time_fraction
                and result.decoding_time_fraction.get(user, 0.0) > 0.0
            )
            for user in sorted(assignment)
        }
        evaluated[label] = {
            "assignments": {str(k): (None if v is None else list(v)) for k, v in assignment.items()},
            "result": result,
            "outcome": raw,
            "f": f_value,
            "phi_cost": cost,
            "bits_by_user": {} if result.bits is None else dict(result.bits),
            "joules": None if result.energy is None else result.energy.joules,
            "served_complete": served_phy,
            "served_guard": served_guard,
            "served_count": sum(served_guard.values()),
            "complete_count": sum(served_phy.values()),
            "rate_target_feasible": result.rate_target_feasible,
            "rate_target_attained": result.rate_target_attained,
            "transmissions": transmissions(result),
        }
    return evaluated


