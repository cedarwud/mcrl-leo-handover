SMOKE_LABEL = "SMOKE_NOT_MATRIX"
ARMS = (
    "U1",
    "J1",
    "UNION_CEILING",
    "S0",
    "FULL",
    "DROP_C1",
    "DROP_C2",
    "DROP_C3",
    "UNI",
    "S_UNI",
    "NULL",
    "RANDOM_FEASIBLE",
    "NOMINAL_GREEDY",
)
TOP_K_USERS = 10
TOP_OPTIONS = 2
S0_PROPOSAL_CAP = 200
CATALOGUE_CAP = 3_200


@dataclass(frozen=True)
class Configuration:
    configuration_id: str
    rows: tuple[int, ...]
    changed_users: tuple[int, ...]
    kinds: tuple[str, ...]

    @property
    def changed_count(self) -> int:
        return len(self.changed_users)


@dataclass(frozen=True)
class BatchEvaluation:
    """Integrated outputs, one row per configuration."""

    bits: np.ndarray
    joules: np.ndarray
    per_user_bits: np.ndarray
    decoding_user_seconds: np.ndarray
    served_users: np.ndarray
    complete_service_users: np.ndarray
    energy_components: np.ndarray
    lit_beam_seconds: np.ndarray
    acm_airtime_seconds: np.ndarray
    cap_hit_airtime_seconds: np.ndarray
    transmission_airtime_seconds: np.ndarray
    max_residual_w: np.ndarray
    max_iterations: np.ndarray
    certificate_status: np.ndarray
    valid: np.ndarray

    def take(self, indices: Sequence[int]) -> "BatchEvaluation":
        pick = np.asarray(indices, dtype=np.int64)
        return BatchEvaluation(*(getattr(self, name)[pick] for name in self.__dataclass_fields__))

    @classmethod
    def concatenate(cls, rows: Sequence["BatchEvaluation"]) -> "BatchEvaluation":
        if not rows:
            raise MCRLContractError("cannot concatenate an empty evaluation")
        return cls(*(np.concatenate([getattr(row, name) for row in rows], axis=0) for name in cls.__dataclass_fields__))


def _row_maps(step: PrimitiveStepArrays) -> tuple[dict[tuple[int, tuple[int, int]], int], np.ndarray]:
    row_of: dict[tuple[int, tuple[int, int]], int] = {}
    for row, identity in enumerate(step.identities):
        user = int(step.users[int(step.row_user_column[row])])
        key = (user, (int(identity[0]), int(identity[1])))
        if key in row_of:
            raise MCRLContractError("duplicate user/physical candidate row")
        row_of[key] = row
    aggressor_of = {
        (int(identity[0]), int(identity[1])): index
        for index, identity in enumerate(step.aggressor_identities)
    }
    row_aggressor = np.asarray(
        [aggressor_of.get((int(identity[0]), int(identity[1])), -1) for identity in step.identities],
        dtype=np.int64,
    )
    for row, aggressor in enumerate(row_aggressor):
        if aggressor < 0:
            continue
        if int(step.colors[row]) != int(step.aggressor_colors[aggressor]):
            raise MCRLContractError("one physical chain carries more than one colour")
    return row_of, row_aggressor


def legal_rows_by_user(step: PrimitiveStepArrays) -> tuple[tuple[int, ...], ...]:
    """Decision-instant legal options, sorted nearest then physical identity."""

    legal = step.visible[0] & step.d2_eligible[0] & step.cell_reachable[0]
    result: list[list[int]] = [[] for _ in step.users]
    for row in np.flatnonzero(legal).tolist():
        result[int(step.row_user_column[row])].append(row)
    return tuple(
        tuple(
            sorted(
                rows,
                key=lambda row: (
                    float(step.slants_km[0, row]),
                    int(step.identities[row, 0]),
                    int(step.identities[row, 1]),
                ),
            )
        )
        for rows in result
    )


def nearest_configuration(step: PrimitiveStepArrays) -> Configuration:
    options = legal_rows_by_user(step)
    rows = tuple(user_rows[0] if user_rows else -1 for user_rows in options)
    return Configuration("BASE:nearest-eligible", rows, (), ("base",))


def _configuration_id(base_rows: Sequence[int], rows: Sequence[int]) -> str:
    changes = [(user, int(row)) for user, (before, row) in enumerate(zip(base_rows, rows, strict=True)) if before != row]
    if not changes:
        return "BASE:nearest-eligible"
    return "CFG:" + ";".join(f"{user}:{row}" for user, row in changes)


def all_unilateral_configurations(
    step: PrimitiveStepArrays, base: Configuration
) -> tuple[Configuration, ...]:
    options = legal_rows_by_user(step)
    rows: list[Configuration] = []
    for user, legal_rows in enumerate(options):
        for selected in legal_rows:
            if selected == base.rows[user]:
                continue
            changed = list(base.rows)
            changed[user] = selected
            values = tuple(changed)
            rows.append(Configuration(_configuration_id(base.rows, values), values, (user,), ("unilateral",)))
    return tuple(rows)


def _with_changes(
    base: Configuration,
    changes: Mapping[int, int],
    kind: str,
) -> Configuration:
    rows = list(base.rows)
    for user, row in changes.items():
        rows[user] = int(row)
    values = tuple(rows)
    changed = tuple(user for user, (before, after) in enumerate(zip(base.rows, values, strict=True)) if before != after)
    return Configuration(_configuration_id(base.rows, values), values, changed, (kind,))


def _deduplicate(configurations: Iterable[Configuration]) -> tuple[Configuration, ...]:
    by_rows: dict[tuple[int, ...], Configuration] = {}
    for config in configurations:
        prior = by_rows.get(config.rows)
        if prior is None:
            by_rows[config.rows] = config
        else:
            by_rows[config.rows] = Configuration(
                prior.configuration_id,
                prior.rows,
                prior.changed_users,
                tuple(sorted(set(prior.kinds + config.kinds))),
            )
    return tuple(sorted(by_rows.values(), key=lambda row: (row.changed_count != 0, row.configuration_id)))


def build_bounded_catalogue(
    step: PrimitiveStepArrays,
    base: Configuration,
    unilateral: Sequence[Configuration],
    unilateral_d: Mapping[tuple[int, int], float],
) -> tuple[tuple[Configuration, ...], dict[str, object]]:
    """Build the declared bounded union without a Cartesian product."""

    by_user: dict[int, list[Configuration]] = {user: [] for user in range(len(base.rows))}
    for config in unilateral:
        by_user[config.changed_users[0]].append(config)
    ranked: dict[int, tuple[Configuration, ...]] = {}
    for user, rows in by_user.items():
        ranked[user] = tuple(
            sorted(
                rows,
                key=lambda row: (
                    -unilateral_d[(user, row.rows[user])],
                    row.configuration_id,
                ),
            )
        )
    user_order = tuple(
        sorted(
            range(len(base.rows)),
            key=lambda user: (
                -max((unilateral_d[(user, row.rows[user])] for row in ranked[user]), default=-math.inf),
                user,
            ),
        )
    )
    top_users = tuple(user for user in user_order if ranked[user])[:TOP_K_USERS]
    top_two = {user: ranked[user][:TOP_OPTIONS] for user in range(len(base.rows))}

    pairs: list[Configuration] = []
    for left_position, left in enumerate(top_users):
        for right in top_users[left_position + 1 :]:
            for first in top_two[left]:
                for second in top_two[right]:
                    pairs.append(
                        _with_changes(
                            base,
                            {left: first.rows[left], right: second.rows[right]},
                            "pairwise-top10x2",
                        )
                    )

    # Per-beam evacuation: every incumbent of the beam takes its best legal
    # alternative that does not use the evacuated beam.
    beam_of = {
        row: (int(step.identities[row, 0]), int(step.identities[row, 1]))
        for row in range(len(step.identities))
    }
    users_by_beam: dict[tuple[int, int], list[int]] = {}
    for user, row in enumerate(base.rows):
        if row >= 0:
            users_by_beam.setdefault(beam_of[row], []).append(user)
    evacuations: list[Configuration] = []
    for beam, users in sorted(users_by_beam.items()):
        changes: dict[int, int] = {}
        for user in users:
            alternative = next(
                (row for row in ranked[user] if beam_of[row.rows[user]] != beam),
                None,
            )
            if alternative is None:
                changes = {}
                break
            changes[user] = alternative.rows[user]
        if changes:
            evacuations.append(_with_changes(base, changes, "beam-evacuation"))

    # Bounded S0 proposals: deterministic cumulative profiles from each user's
    # top option, followed by the corresponding second-option substitution.
    s0: list[Configuration] = []
    ordered = [user for user in user_order if top_two[user]]
    cumulative: dict[int, int] = {}
    for user in ordered:
        cumulative[user] = top_two[user][0].rows[user]
        if len(cumulative) >= 2:
            s0.append(_with_changes(base, cumulative, "s0-top-two-prefix"))
            if len(top_two[user]) > 1:
                alternate = dict(cumulative)
                alternate[user] = top_two[user][1].rows[user]
                s0.append(_with_changes(base, alternate, "s0-top-two-prefix"))
        if len(s0) >= S0_PROPOSAL_CAP:
            break
    s0 = s0[:S0_PROPOSAL_CAP]

    catalog = _deduplicate((base, *unilateral, *pairs, *evacuations, *s0))
    if len(catalog) > CATALOGUE_CAP:
        raise MCRLContractError(f"bounded catalogue has {len(catalog)} rows, cap is {CATALOGUE_CAP}")
    census: dict[str, object] = {
        "base": 1,
        "unilateral": len(unilateral),
        "pairwise_generated": len(pairs),
        "evacuations_generated": len(evacuations),
        "s0_proposals_generated": len(s0),
        "deduplicated_total": len(catalog),
        "top_users": list(top_users),
        "null_action_users": [user for user, row in enumerate(base.rows) if row < 0],
        "definition_sha256": digest_payload(
            {
                "all_unilateral": True,
                "pairwise": "top-10 users by nominal unilateral d; top-2 options each",
                "evacuation": "each active base beam; best legal off-beam option",
                "s0": "cumulative top-two prefixes; cap 200",
                "null": "users without legal options fixed at unserved and excluded",
                "cap": CATALOGUE_CAP,
            }
        ),
    }
    return catalog, census


def translate_rows(
    source: PrimitiveStepArrays,
    target: PrimitiveStepArrays,
    configurations: Sequence[Configuration],
) -> np.ndarray:
    """Translate physical assignments to another step; missing means unserved."""

    row_of, _ = _row_maps(target)
    result = np.full((len(configurations), len(source.users)), -1, dtype=np.int64)
    for cindex, config in enumerate(configurations):
        for user, row in enumerate(config.rows):
            if row < 0:
                continue
            identity = (int(source.identities[row, 0]), int(source.identities[row, 1]))
            result[cindex, user] = row_of.get((int(source.users[user]), identity), -1)
    return result


