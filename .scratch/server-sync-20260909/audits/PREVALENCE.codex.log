                rx=float(interference_receive_gain_linear(sep,same_satellite=wanted[0]==aggressor[0]))
                nominal[i,j]=base*rx; realised[i,j]=base*rx*fade
        return Geometry(tuple(links),nominal,realised)

def evaluate(world, assignments, anchor, field='margin', trace=False):
    engine=AngleRateTPC_TDM(); config=RadiationConfig(fading_quantile_alpha=.10)
    first=engine.radiate(config,world.geometry(assignments),'margin' if field=='margin' else field)
    rows=tuple(RadiationBoundary(t, first if field!='realised' else engine.radiate(config,world.geometry(assignments,t),field)) for t in TIMES)
    shared=SharedArchitectureTape('a-r',HardwareInventory.fixed([v[:2] for v in world.beams.values()]),rows,rows[0],tuple(range(len(world.users))))
    score=score_setting(shared,SETTING)
    assert score.valid
    events=[classify_physical_transition(user_id=u,before=None if a is None else world.beams[a][:2],after=None if b is None else world.beams[b][:2],cell_rekey=False,was_previously_served=a is not None) for u,(a,b) in enumerate(zip(anchor,assignments))]
    phi=phi_qos(events)
    bits={u:Fraction(str(v)) for u,v in score.bits.items()}
    opportunities=len(world.users)*(TIMES[-1]-TIMES[0])
    decoding=min(1.,max(0.,math.fsum(score.decoding_time_s.values())/opportunities))
    useful=min(1.,max(0.,math.fsum(score.useful_time_s.values())/opportunities))
    outcome=NetworkOutcome.build(bits=sum(bits.values()),joules=score.joules,phi=phi,decoding_availability=decoding,useful_availability=useful,per_user_bits=bits)
    core=network_objective(outcome,**PRICES)
    full=core+CAL.kappa_bits_per_user_step*phi
    result=dict(assignments=assignments,bits=float(outcome.bits),joules=score.joules,phi_preference=float(phi),phi_cost_bits=float(-CAL.kappa_bits_per_user_step*phi),F_core=float(core),F=float(full),F_exact=str(full),served=sum(score.served_phy.values()),served_by_user=score.served_phy,bits_by_user=score.bits,decoding_time_s=score.decoding_time_s,feasible=score.rate_target_feasible,attained=score.rate_target_attained,max_residual_w=score.certificate_residual_w)
    if trace:
        result['boundaries']=[dict(time_s=row.time_s,slots=[dict(fraction=s.fraction,certificate=vars(s.certificate),transmissions=[dict(user=t.user_id,beam=t.beam,power_w=t.rf_power_w,nominal_sinr=t.nominal_sinr,margin_sinr=t.margin_predicted_sinr,actual_sinr=t.sinr,target=None if t.m_target is None else t.m_target.name,tx=None if t.m_tx is None else t.m_tx.name,tx_threshold=None if t.m_tx is None else t.m_tx.threshold_linear,decoded=t.realised_outcome.decoded,interference_w=t.interference_w) for t in s.transmissions]) for s in row.radiation.slots]) for row in (rows if field=='realised' else rows[:1])]
    return outcome,result

def quartet(world, anchor, moves, field='margin', trace=False):
    users=tuple(moves); subsets=[frozenset(),*(frozenset([u]) for u in users),frozenset(users)]
    outcomes={}; rows={}
    for subset in dict.fromkeys(subsets):
        a=list(anchor)
        for u in subset:a[u]=moves[u]
        key='base' if not subset else 'joint' if subset==frozenset(users) else f'only_{next(iter(subset))}'
        outcomes[subset],rows[key]=evaluate(world,a,anchor,field,trace)
    dec=set_score_decomposition(coalition_users=users,outcomes_by_subset=outcomes,phi_difference=outcomes[frozenset(users)].phi-outcomes[frozenset()].phi,**PRICES)
    joint=rows['joint']; base=rows['base']
    d={u:Fraction(rows['joint' if len(users)==1 else f'only_{u}']['F_exact'])-Fraction(base['F_exact']) for u in users}
    psi=Fraction(joint['F_exact'])-Fraction(base['F_exact'])-sum(d.values())
    assert psi==dec.interaction_bits
    delta=Fraction(joint['F_exact'])-Fraction(base['F_exact'])
    assert (dec.factor_c1+dec.c3)*CAL.kappa_bits_per_user_step==delta
    return dict(classification='DIAGNOSTIC_NOT_CLAIM',field=field,world=world.payload(),anchor=anchor,moves=moves,evaluations=rows,d={u:float(v) for u,v in d.items()},d_exact={u:str(v) for u,v in d.items()},d_core={u:float(v) for u,v in dec.d_by_user},psi=float(psi),psi_exact=str(psi),delta_F=float(delta),delta_F_exact=str(delta),delta_core=float(dec.joint_change_bits),psi_bits=joint['bits']-sum(rows[f'only_{u}']['bits'] for u in users)+base['bits'] if len(users)==2 else 0,psi_joules=joint['joules']-sum(rows[f'only_{u}']['joules'] for u in users)+base['joules'] if len(users)==2 else 0,guard={key:r['served']>=base['served'] for key,r in rows.items()},c1=float(dec.c1),factor_c1=float(dec.factor_c1),c3=float(dec.c3))
"""DIAGNOSTIC_NOT_CLAIM: coordinate-grounded interference/decode witness.

Run from workspace root with PYTHONPATH=src, fixed seed inherited from harness.
All B, E, service, mode, power and F scoring comes from the archived engine.
"""
import json
from pathlib import Path
from engine_harness import World, ground, satellite, quartet


def world_for(y_a=30., sep=1., y_src=40., away_offset=100., n_src=4, n_dst=3):
    # Users 0=A and 1=B are movers. Other users retain their beam assignment.
    users = [ground(y_a), ground()]
    users += [ground(y_src) for _ in range(n_src - 1)]
    users += [ground() for _ in range(n_dst)]
    satellites = {
        80001: satellite(80. + sep),
        80002: satellite(80.),
        80003: satellite(85., azimuth=180.),
        80004: satellite(80., azimuth=90.),
    }
    beams = {
        'x': (80001, 0, 0, ground()),
        'y': (80002, 0, 0, ground()),
        's': (80003, 0, 1, ground(y_src)),
        'away': (80004, 0, 2, ground(y_a + away_offset)),
    }
    anchor = ['x', 's'] + ['s'] * (n_src - 1) + ['y'] * n_dst
    return World(users, satellites, beams), anchor, {0: 'away', 1: 'y'}


def tx_for(boundary, user):
    return next(t for slot in boundary['slots'] for t in slot['transmissions'] if t['user'] == user)


def crossing_receipts(result):
    only = result['evaluations']['only_1']['boundaries']
    joint = result['evaluations']['joint']['boundaries']
    crossings = []
    for before, after in zip(only, joint):
        b, j = tx_for(before, 1), tx_for(after, 1)
        assert b['tx'] == j['tx'] == 'QPSK 1/3'
        assert b['target'] == j['target'] == 'QPSK 3/4'
        if not b['decoded'] and j['decoded']:
            crossings.append({'time_s': before['time_s'], 'only_B': b, 'joint': j})
    return crossings


def main():
    world, anchor, moves = world_for()
    margin = quartet(world, anchor, moves, field='margin', trace=True)
    realised = quartet(world, anchor, moves, field='realised', trace=True)
    assert all(margin['guard'].values()) and all(realised['guard'].values())
    assert all(value < 0 for value in margin['d'].values())
    assert all(value < 0 for value in realised['d'].values())
    assert margin['psi'] > 0 and realised['psi'] > 0 and realised['psi_bits'] > 0
    assert realised['evaluations']['base']['bits_by_user'][0] == 0
    assert realised['evaluations']['base']['bits_by_user'][1] == 0
    crossings = crossing_receipts(realised)
    assert crossings

    # A physical orthogonal-colour intervention preserves coordinates, antenna
    # gains, power law, occupancy, fixed seeded fades, actions and price.
    # It changes only X's reuse colour to remove the same-colour coupling.
    recoloured, _, _ = world_for()
    x = recoloured.beams['x']
    recoloured.beams['x'] = (x[0], x[1], 2, x[3])
    controls = {
        field: quartet(recoloured, anchor, moves, field=field, trace=False)
        for field in ('margin', 'realised')
    }
    for row in controls.values():
        assert abs(row['psi']) < 1e-4
        assert abs(row['psi_bits']) < 1e-4
        assert abs(row['psi_joules']) < 1e-9

    result = {
        'classification': 'DIAGNOSTIC_NOT_CLAIM',
        'mechanism': 'interference causes fixed-transmitted-mode decode threshold crossings',
        'margin': margin,
        'realised': realised,
        'B_rescued_boundaries_same_target_and_tx_mode': crossings,
        'physical_colour_control': controls,
        'limitations': [
            'B alone delivers some bits over the full fixed-seed step but has negative total F change.',
            'The joint move has positive Psi but negative total F change.',
            'Both positive bit interaction and positive energy interaction contribute; the latter is larger.',
            'Background occupancy makes transmitted modes available. The colour control proves occupancy alone does not produce this coalition interaction.',
        ],
    }
    output = Path(__file__).with_name('mechanism1-selected.json')
    output.write_text(json.dumps(result, indent=2) + '\n')
    print(json.dumps({
        'artifact': str(output),
        'margin': {k: margin[k] for k in ('psi', 'psi_bits', 'psi_joules', 'd', 'delta_F', 'guard')},
        'realised': {k: realised[k] for k in ('psi', 'psi_bits', 'psi_joules', 'd', 'delta_F', 'guard')},
        'colour_control_psi': {k: v['psi'] for k, v in controls.items()},
        'rescued_B_boundaries': len(crossings),
    }, indent=2))


if __name__ == '__main__':
    main()

