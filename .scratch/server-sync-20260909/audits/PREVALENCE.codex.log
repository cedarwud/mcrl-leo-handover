"""Coordinate-grounded occupancy witness with a nonzero service floor."""

from __future__ import annotations

import json
from pathlib import Path

from witness.engine_harness import GROUND, World, ground, quartet, satellite


ROOT = Path(__file__).resolve().parents[1]


def main() -> None:
    beams = {
        "X": (1, 0, 0, GROUND),
        "Y": (1, 1, 1, ground(0, 5)),
        "Z": (1, 2, 2, ground(0, -5)),
        "G": (2, 0, 2, GROUND),
    }
    # User 0 is the incumbent. Users 1/2 are the two arrivals. Users 3/4
    # remain on a separate three-user-capable beam and make the guard floor
    # nonzero without changing X's occupancy.
    world = World(
        [GROUND] * 5,
        {1: satellite(60), 2: satellite(90)},
        beams,
    )
    anchor = ["X", "Y", "Z", "G", "G"]
    moves = {1: "X", 2: "X"}
    result = {
        "classification": "DIAGNOSTIC_NOT_CLAIM",
        "anchor": anchor,
        "moves": moves,
        "fields": {
            field: quartet(world, anchor, moves, field=field, trace=True)
            for field in ("margin", "realised")
        },
    }
    out = ROOT / "analysis/mechanism2_guarded.json"
    out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(result, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
"""Coordinate-grounded interference cliff using the sealed b0 engine arm.

The geometry builder only derives Link/cross gains from coordinates.  Radiation,
ACM decoding, integration, energy, and score decomposition are all delegated
to the archived V0.25 engine and adapter.
"""

from __future__ import annotations

from fractions import Fraction
import json
import math
from pathlib import Path

from witness.engine_harness import (
    GROUND,
    PRICES,
    TIMES,
    World,
    ground,
    satellite,
)
from mcrl.physics_v025.adapter import build_shared_tape, score_setting
from mcrl.physics_v025.architectures import RadiationConfig
from mcrl.physics_v025.matrix import MATRIX_SETTINGS
from mcrl.physics_v025.targets import (
    NetworkOutcome,
    classify_physical_transition,
    network_objective,
    phi_qos,
    set_score_decomposition,
)
from mcrl.physics_v025.energy import HardwareInventory


ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "analysis/mechanism1_fixedrf.json"
SETTING = next(setting for setting in MATRIX_SETTINGS if setting.label == "b0")


def interference_world() -> tuple[World, list[str], dict[str, list[str]]]:
    """A/B use distinct same-colour chains; three G users are guard sentinels.

    X and W are cleanly boresighted for A and B respectively.  Y is an
    off-axis B destination.  A's X transmission is a same-satellite
    co-channel aggressor for both Y and W.  Aaway is a deliberately
    off-axis, different-colour beam for A.
    """

    beams = {
        "X": (1, 0, 0, GROUND),
        "Y": (1, 1, 0, ground(0, 45)),
        "W": (1, 2, 0, GROUND),
        "Aaway": (2, 0, 2, ground(0, 150)),
        "G": (3, 0, 2, GROUND),
    }
    world = World(
        [GROUND] * 5,
        {1: satellite(30), 2: satellite(10), 3: satellite(90)},
        beams,
    )
    anchor = ["X", "Y", "G", "G", "G"]
    profiles = {
        "only_A": ["Aaway", "Y", "G", "G", "G"],
        "only_B": ["X", "W", "G", "G", "G"],
        "joint": ["Aaway", "W", "G", "G", "G"],
    }
    return world, anchor, profiles


def _score(
    world: World,
    assignments: list[str],
    anchor: list[str],
    field: str,
) -> tuple[NetworkOutcome, dict[str, object], object]:
    inventory = HardwareInventory.fixed([value[:2] for value in world.beams.values()])
    tape = build_shared_tape(
        "b",
        [(time_s, world.geometry(assignments, time_s)) for time_s in TIMES],
        inventory,
        config=RadiationConfig(fading_quantile_alpha=0.10),
        field=field,
        roster=tuple(range(len(world.users))),
    )
    score = score_setting(tape, SETTING)
    assert score.valid
    events = tuple(
        classify_physical_transition(
            user_id=user,
            before=world.beams[anchor[user]][:2],
            after=world.beams[assignments[user]][:2],
            cell_rekey=False,
            was_previously_served=True,
        )
        for user in range(len(assignments))
    )
    phi = phi_qos(events)
    bits = {user: Fraction(str(value)) for user, value in score.bits.items()}
    opportunity_s = len(world.users) * (TIMES[-1] - TIMES[0])
    availability = min(
        1.0,
        max(0.0, math.fsum(score.decoding_time_s.values()) / opportunity_s),
    )
    outcome = NetworkOutcome.build(
        bits=sum(bits.values(), Fraction()),
        joules=score.joules,
        phi=phi,
        decoding_availability=availability,
        useful_availability=availability,
        per_user_bits=bits,
    )
    core = network_objective(outcome, **PRICES)
    full = core + PRICES["kappa_bits_per_user_step"] * phi

    boundaries = []
    for boundary in tape.integrated:
        slots = []
        for slot in boundary.radiation.slots:
            transmissions = []
            for tx in slot.transmissions:
                mode = tx.m_tx
                realised = tx.realised_outcome
                transmissions.append(
                    {
                        "user": tx.user_id,
                        "beam": list(tx.beam),
                        "power_w": tx.rf_power_w,
                        "wanted_w": tx.wanted_w,
                        "intra_interference_w": tx.intra_interference_w,
                        "inter_interference_w": tx.inter_interference_w,
                        "nominal_sinr": tx.nominal_sinr,
                        "margin_sinr": tx.margin_predicted_sinr,
                        "sinr": tx.sinr,
                        "tx_mode": None if mode is None else mode.name,
                        "tx_threshold": None if mode is None else mode.threshold_linear,
                        "decoded": realised.decoded,
                        "credited_se": realised.credited_spectral_efficiency_bit_per_s_hz,
                    }
                )
            slots.append(
                {
                    "fraction": slot.fraction,
                    "beam_rf_w": [[list(beam), power] for beam, power in slot.beam_rf_w],
                    "certificate": {
                        "status": slot.certificate.status,
                        "residual_w": slot.certificate.residual_w,
                        "tolerance_w": slot.certificate.tolerance_w,
                    },
                    "transmissions": transmissions,
                }
            )
        boundaries.append({"time_s": boundary.time_s, "slots": slots})

    row = {
        "assignments": assignments,
        "bits": float(outcome.bits),
        "bits_exact": str(outcome.bits),
        "bits_by_user": score.bits,
        "joules": score.joules,
        "phi_preference": float(phi),
        "phi_cost_bits": float(-PRICES["kappa_bits_per_user_step"] * phi),
        "F_core": float(core),
        "F": float(full),
        "F_exact": str(full),
        "served": sum(score.served_phy.values()),
        "served_by_user": score.served_phy,
        "max_residual_w": score.certificate_residual_w,
        "guard_against_anchor": None,
        "boundaries": boundaries,
    }
    return outcome, row, tape


def _decompose(outcomes: dict[frozenset[int], NetworkOutcome]) -> dict[str, object]:
    decomposition = set_score_decomposition(
        coalition_users=(0, 1),
        outcomes_by_subset=outcomes,
        phi_difference=outcomes[frozenset((0, 1))].phi - outcomes[frozenset()].phi,
        **PRICES,
    )
    return {
        "d_core": {str(user): str(value) for user, value in decomposition.d_by_user},
        "interaction_bits": str(decomposition.interaction_bits),
        "joint_change_bits": str(decomposition.joint_change_bits),
        "c1": str(decomposition.c1),
        "factor_c1": str(decomposition.factor_c1),
        "c3": str(decomposition.c3),
        "c1_plus_c3": str(decomposition.factor_c1 + decomposition.c3),
        "shapley_interaction_by_user": {
            str(user): str(value)
            for user, value in decomposition.shapley_interaction_by_user
        },
    }


def main() -> None:
    world, anchor, profiles = interference_world()
    payload: dict[str, object] = {
        "classification": "DIAGNOSTIC_NOT_CLAIM",
        "architecture": SETTING.payload(),
        "world": world.payload(),
        "anchor": anchor,
        "profiles": profiles,
        "fields": {},
    }
    for field in ("margin", "realised"):
        assignments = {"base": anchor, **profiles}
        outcomes: dict[frozenset[int], NetworkOutcome] = {}
        rows: dict[str, dict[str, object]] = {}
        for label, assignment in assignments.items():
            subset = frozenset(
                user for user in (0, 1) if assignment[user] != anchor[user]
            )
            outcome, row, _ = _score(world, assignment, anchor, field)
            outcomes[subset] = outcome
            rows[label] = row
        base = Fraction(rows["base"]["F_exact"])  # type: ignore[arg-type]
        d = {
            user: Fraction(rows["only_A" if user == 0 else "only_B"]["F_exact"]) - base
            for user in (0, 1)
        }
        joint = Fraction(rows["joint"]["F_exact"])
        psi = joint - base - sum(d.values(), Fraction())
        delta = joint - base
        for label, row in rows.items():
            row["guard_against_anchor"] = row["served"] >= rows["base"]["served"]  # type: ignore[operator]
        # The production guard is applied to the joint candidate.  The two
        # singleton counterfactuals are retained even when they fail it.
        assert rows["joint"]["guard_against_anchor"]
        assert rows["only_A"]["bits_by_user"][1] > 0  # type: ignore[index]
        assert rows["only_B"]["bits_by_user"][1] == 0  # type: ignore[index]
        assert rows["joint"]["bits_by_user"][1] > 0  # type: ignore[index]
        assert psi > 0
        decomposition = _decompose(outcomes)
        assert Fraction(decomposition["interaction_bits"]) == psi
        assert Fraction(decomposition["c1_plus_c3"]) * PRICES["kappa_bits_per_user_step"] == delta
        payload["fields"][field] = {  # type: ignore[index]
            "evaluations": rows,
            "d": {str(user): str(value) for user, value in d.items()},
            "d_exact": {str(user): str(value) for user, value in d.items()},
            "psi": str(psi),
            "psi_exact": str(psi),
            "delta_F": str(delta),
            "delta_F_exact": str(delta),
            "decomposition": decomposition,
        }
    OUT.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()

