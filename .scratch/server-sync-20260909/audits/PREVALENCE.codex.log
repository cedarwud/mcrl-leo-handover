                step["c2_forecast_certificate"] for step in steps
            ]
            validity_pass = all(bool(certificate["valid"]) for certificate in validity_rows)
            tie_count = sum(
                bool(step["selection_approximations"]["c2_tie_diagnostic"]["FULL"]["tie_present"])
