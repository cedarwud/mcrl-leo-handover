+
+
+@dataclass(frozen=True)
+class BatchARResult:
+    bits: np.ndarray
+    joules: np.ndarray
+    pa_j: np.ndarray
+    circuit_j: np.ndarray
+    baseband_j: np.ndarray
+    decoding_time_s: np.ndarray
+    feasible: np.ndarray
+    attained: np.ndarray
