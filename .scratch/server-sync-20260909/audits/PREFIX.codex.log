new file mode 100644
index 0000000000000000000000000000000000000000..521f1b14752098ffb095cab86c0c6043ae5dbf28
--- /dev/null
+++ b/.scratch/prefix-ablation-20260910/cleared_margin_batch.py
@@ -0,0 +1,648 @@
+"""Dense catalogue evaluation for the V0.25 rate-target TDM architecture.
+
+This module is deliberately narrow: it implements the exact ``a-r`` radiation
+and integration equations for a whole configuration catalogue backed by a
+``PrimitiveStepArrays`` object.  The scalar object path remains the authority
+used by KATs; this path removes per-row Python objects from real-world units.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+
+import numpy as np
+
+from mcrl.errors import MCRLContractError
+
+from mcrl.physics_v025.acm import ACM_MODES, rate_target_mode, rate_target_sinr
+from mcrl.physics_v025.channel import fading_product_quantile_array, noise_power_w
+from mcrl.physics_v025.constants_v025 import (
+    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    CIRCUIT_POWER_PER_CHAIN_W,
+    D2_MEASUREMENT_STEP_S,
+    PA_MAX_EFFICIENCY,
+    PA_SATURATION_POWER_W,
+    POWER_SOLVER_ITERATION_CAP,
+    POWER_SOLVER_TOLERANCE_W,
+    RATE_TARGET_BPS,
+    SINR_MIN_DB,
+)
+from mcrl.physics_v025.tapes import PrimitiveStepArrays
+
+
+# Diagnostic counters are separate from the unchanged BatchARResult API.
+# A fresh process/import starts a new counter set. They do not affect choices.
+CLEARANCE_DIAGNOSTICS = {
+    "slot_configurations_refined": 0,
+    "configuration_refinement_updates": 0,
+    "maximum_refinement_updates": 0,
+    "uncertified_slot_configurations": 0,
+}
+
+
+@dataclass(frozen=True)
+class BatchARResult:
+    bits: np.ndarray
+    joules: np.ndarray
+    pa_j: np.ndarray
+    circuit_j: np.ndarray
+    baseband_j: np.ndarray
+    decoding_time_s: np.ndarray
+    feasible: np.ndarray
+    attained: np.ndarray
+    residual_w: np.ndarray
+    mode_counts: np.ndarray
+    target_mode_counts: np.ndarray
+    transmitted_mode_counts: np.ndarray
+    realised_decode_successes: np.ndarray
+    realised_decode_failures: np.ndarray
+    plateau_users: np.ndarray
+    transmissions: np.ndarray
+    cap_hits: np.ndarray
+    valid: np.ndarray
+    certificate_status: np.ndarray
+    certificate_iterations: np.ndarray
+    max_rf_power_w: np.ndarray
+    min_decoding_margin_db: np.ndarray
+    mean_acm_se_bit_s_hz: np.ndarray
+
+
+def _readonly(value: np.ndarray) -> np.ndarray:
+    result = np.asarray(value)
+    result.setflags(write=False)
+    return result
+
+
+def _slot_grid(maximum_occupancy: int) -> tuple[np.ndarray, np.ndarray]:
+    boundaries = {0.0, 1.0}
+    for occupancy in range(1, maximum_occupancy + 1):
+        boundaries.update(index / occupancy for index in range(1, occupancy))
+    ordered = np.asarray(sorted(boundaries), dtype=np.float64)
+    return (ordered[1:] - ordered[:-1], (ordered[1:] + ordered[:-1]) / 2.0)
+
+
+def _evaluate_ar_tdm_catalogue_core(
+    arrays: PrimitiveStepArrays,
+    selected_rows: np.ndarray,
+    *,
+    field: str = "realised",
+    chunk_size: int = 256,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
+    boundary_indices: tuple[int, ...] = tuple(range(48)),
+    fading_quantile_alpha: float | None = None,
+) -> BatchARResult:
+    """Evaluate ``C x U`` selected candidate-row indices without row objects.
+
+    A row index of ``-1`` is the explicit null action.  The common rational
+    TDM partition is an exact refinement of every configuration's scalar slot
+    partition, so splitting a constant slot cannot alter rates or energy.
+    """
+
+    rows_all = np.asarray(selected_rows, dtype=np.int64)
+    if rows_all.ndim != 2 or rows_all.shape[1] != arrays.users.size:
+        raise MCRLContractError("selected_rows must have shape (configurations, users)")
+    if field not in {"nominal", "margin", "realised"}:
+        raise MCRLContractError("batch field must be nominal, margin, or realised")
+    if fading_quantile_alpha is not None and (
+        not math.isfinite(fading_quantile_alpha)
+        or not 0.0 < fading_quantile_alpha < 1.0
+    ):
+        raise MCRLContractError("fading quantile alpha must lie strictly in (0,1)")
+    if field == "margin" and fading_quantile_alpha is None:
+        raise MCRLContractError("margin field requires a fading quantile alpha")
+    if (
+        not boundary_indices
+        or tuple(sorted(set(boundary_indices))) != boundary_indices
+        or boundary_indices[0] < 0
+        or boundary_indices[-1] >= 48
+    ):
+        raise MCRLContractError("boundary indices must be unique, ordered, and in 0..47")
+    configurations, users = rows_all.shape
+    modes = ACM_MODES
+    thresholds = np.asarray([row.threshold_linear for row in modes])
+    efficiencies = np.asarray([row.spectral_efficiency_bit_per_s_hz for row in modes])
+    gamma = np.asarray(
+        [0.0]
+        + [
+            np.nan if rate_target_sinr(rate_target_bps, BEAM_BANDWIDTH_HZ, n) is None
+            else float(rate_target_sinr(rate_target_bps, BEAM_BANDWIDTH_HZ, n))
+            for n in range(1, users + 1)
+        ],
+        dtype=np.float64,
+    )
+    target_mode_index = np.asarray(
+        [0]
+        + [
+            0
+            if rate_target_mode(rate_target_bps, BEAM_BANDWIDTH_HZ, n) is None
+            else ACM_MODES.index(
+                rate_target_mode(rate_target_bps, BEAM_BANDWIDTH_HZ, n)
+            )
+            + 1
+            for n in range(1, users + 1)
+        ],
+        dtype=np.int64,
+    )
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    bits = np.zeros((configurations, users), dtype=np.float64)
+    decoding = np.zeros_like(bits)
+    feasible_all = np.ones((configurations, users), dtype=np.bool_)
+    residual_max = np.zeros(configurations, dtype=np.float64)
+    components = np.zeros((configurations, 3), dtype=np.float64)
+    mode_counts = np.zeros((configurations, len(modes) + 1), dtype=np.int64)
+    target_mode_counts = np.zeros_like(mode_counts)
+    transmitted_mode_counts = np.zeros_like(mode_counts)
+    realised_decode_successes = np.zeros(configurations, dtype=np.int64)
+    realised_decode_failures = np.zeros(configurations, dtype=np.int64)
+    plateau = np.ones((configurations, users), dtype=np.bool_)
+    seen = np.zeros((configurations, users), dtype=np.bool_)
+    transmissions = np.zeros(configurations, dtype=np.int64)
+    cap_hits = np.zeros(configurations, dtype=np.int64)
+    valid_result = np.ones(configurations, dtype=np.bool_)
+    # 0=INVALID, 1=CONVERGED, 2=CONVERGED_SLOW.  A configuration receives
+    # the worst certificate observed over its slots and selected boundaries.
+    certificate_status = np.ones(configurations, dtype=np.int8)
+    certificate_iterations = np.zeros(configurations, dtype=np.int64)
+    max_rf_power_w = np.zeros(configurations, dtype=np.float64)
+    min_decoding_margin_db = np.full(configurations, np.inf, dtype=np.float64)
+    acm_se_sum = np.zeros(configurations, dtype=np.float64)
+    acm_se_count = np.zeros(configurations, dtype=np.int64)
+    row_to_aggressor = {
+        (int(identity[0]), int(identity[1])): index
+        for index, identity in enumerate(arrays.aggressor_identities)
+    }
+    row_aggressor = np.asarray(
+        [
+            row_to_aggressor.get((int(identity[0]), int(identity[1])), -1)
+            for identity in arrays.identities
+        ],
+        dtype=np.int64,
+    )
+    beam_code_of = {
+        identity: index
+        for index, identity in enumerate(
+            sorted({(int(row[0]), int(row[1])) for row in arrays.identities.tolist()})
+        )
+    }
+    row_beam_code = np.asarray(
+        [
+            beam_code_of[(int(identity[0]), int(identity[1]))]
+            for identity in arrays.identities
+        ],
+        dtype=np.int64,
+    )
+    # Keep rare high-occupancy evacuation profiles out of ordinary chunks;
+    # otherwise one such row forces every neighbouring unilateral through a
+    # much finer universal rational slot grid.
+    initial_maximum = np.zeros(configurations, dtype=np.int64)
+    for config_index, selected in enumerate(rows_all):
+        selected_codes = row_beam_code[selected[selected >= 0]]
+        if selected_codes.size:
+            initial_maximum[config_index] = int(
+                np.max(np.unique(selected_codes, return_counts=True)[1])
+            )
+    order = np.argsort(initial_maximum, kind="stable")
+    inverse_order = np.argsort(order)
+    rows_all = rows_all[order]
+    satellite_of = {
+        int(identity[0]): int(column)
+        for identity, column in zip(
+            arrays.aggressor_identities,
+            arrays.aggressor_satellite_column,
+            strict=True,
+        )
+    }
+    row_satellite = np.asarray(
+        [satellite_of.get(int(identity[0]), 0) for identity in arrays.identities],
+        dtype=np.int64,
+    )
+    user_axis = np.arange(users, dtype=np.int64)
+    lower_user = user_axis[None, None, :] < user_axis[None, :, None]
+    # Quantiles belong to immutable candidate rows, not configurations.  Build
+    # each boundary's row table once and gather from it in every catalogue
+    # chunk; recomputing unique bins over C x U selections dominated the real
+    # four-worker gate despite every scalar quantile already being cached.
+    quantile_by_boundary = (
+        {}
+        if fading_quantile_alpha is None
+        else {
+            boundary: fading_product_quantile_array(
+                arrays.elevations_deg[boundary], fading_quantile_alpha
+            )
+            for boundary in boundary_indices
+        }
+    )
+
+    for low in range(0, configurations, chunk_size):
+        high = min(configurations, low + chunk_size)
+        selected = rows_all[low:high]
+        count = high - low
+        valid_assignment = selected >= 0
+        safe_rows = np.maximum(selected, 0)
+        aggressor = row_aggressor[safe_rows]
+        safe_aggressor = np.maximum(aggressor, 0)
+        beam_code = row_beam_code[safe_rows]
+        victim_color = arrays.colors[safe_rows]
+        wanted_slot = arrays.row_wanted_slot[safe_rows]
+        aggressor_color = victim_color
+        aggressor_satellite = row_satellite[safe_rows]
+        aggressor_norad = arrays.identities[safe_rows, 0]
+        previous_rate = previous_decode = previous_energy = None
+
+        previous_boundary = None
+        for boundary in boundary_indices:
+            live = valid_assignment & arrays.visible[boundary, safe_rows] \
+                & arrays.d2_eligible[boundary, safe_rows] \
+                & arrays.cell_reachable[boundary, safe_rows]
+            same_beam = beam_code[:, :, None] == beam_code[:, None, :]
+            occupancy = np.sum(same_beam & live[:, None, :], axis=2)
+            maximum = int(np.max(occupancy, initial=1))
+            fractions, midpoints = _slot_grid(maximum)
+            boundary_rate = np.zeros((count, users), dtype=np.float64)
+            boundary_decode = np.zeros((count, users), dtype=np.bool_)
+            boundary_feasible = np.zeros((count, users), dtype=np.bool_)
+            boundary_energy = np.zeros((count, 3), dtype=np.float64)
+            rank = np.sum(same_beam & live[:, None, :] & lower_user, axis=2)
+            direct_nominal = arrays.nominal_gain[boundary, safe_rows]
+            quantile = (
+                np.ones_like(direct_nominal, dtype=np.float64)
+                if fading_quantile_alpha is None
+                else quantile_by_boundary[boundary][safe_rows]
+            )
+            direct_field = (
+                direct_nominal
+                if field == "nominal"
+                else direct_nominal * quantile
+                if field == "margin"
+                else arrays.realised_gain[boundary, safe_rows]
+            )
+            base_cross = arrays.cross_base_nominal[
+                boundary,
+                user_axis[None, :, None],
+                safe_aggressor[:, None, :],
+            ]
+            receive = arrays.receive_gain_by_wanted_slot[
+                boundary,
+                user_axis[None, :, None],
+                wanted_slot[:, :, None],
+                aggressor_satellite[:, None, :],
+            ]
+            nominal_cross = base_cross * receive
+            colour_mask = victim_color[:, :, None] == aggressor_color[:, None, :]
+            available_aggressor = aggressor[:, None, :] >= 0
+            nominal_cross *= colour_mask & ~same_beam & available_aggressor
+            if field == "realised":
+                field_cross = nominal_cross * arrays.fading_by_satellite[
+                    boundary,
+                    user_axis[None, :, None],
+                    aggressor_satellite[:, None, :],
+                ]
+            else:
+                field_cross = nominal_cross
+
+            for fraction, midpoint in zip(fractions, midpoints, strict=True):
+                active = live & (rank == np.floor(midpoint * occupancy).astype(np.int64))
+                active_pair = active[:, :, None] & active[:, None, :]
+                coupling = nominal_cross * active_pair
+                # DIAGNOSTIC VARIANT: margin_dB=-10log10(q); Gamma_margin=Gamma/q.
+                targets = gamma[np.minimum(occupancy, users)] / quantile
+                forced = active & np.isnan(targets)
+                targets = np.nan_to_num(targets, nan=1.0)
+                power = np.zeros((count, users), dtype=np.float64)
+                residual = np.full(count, math.inf, dtype=np.float64)
+                done = np.zeros(count, dtype=np.bool_)
+                invalid = np.zeros(count, dtype=np.bool_)
+                recent_changes: list[np.ndarray] = []
+                for iteration in range(1, POWER_SOLVER_ITERATION_CAP + 1):
+                    interference = np.matmul(coupling, power[..., None])[..., 0]
+                    updated = np.minimum(
+                        BEAM_RF_CAP_W,
+                        targets * (noise + interference) / direct_nominal,
+                    )
+                    updated = np.where(active, updated, 0.0)
+                    updated[forced] = BEAM_RF_CAP_W
+                    bad = ~np.all(np.isfinite(updated), axis=1) | np.any(
+                        updated + POWER_SOLVER_TOLERANCE_W < power, axis=1
+                    )
+                    invalid |= bad
+                    change = np.abs(updated - power)
+                    next_residual = np.max(change, axis=1)
+                    relative = np.max(
+                        change
+                        / np.maximum(np.abs(updated), np.finfo(float).tiny),
+                        axis=1,
+                    )
+                    newly_done = (~invalid) & (
+                        (next_residual <= POWER_SOLVER_TOLERANCE_W)
+                        | (relative <= 1.0e-9)
+                    )
+                    active_solver = ~(done | invalid)
+                    power = np.where(active_solver[:, None], updated, power)
+                    residual = np.where(active_solver, next_residual, residual)
+                    done |= newly_done
+                    recent_changes.append(next_residual.copy())
+                    if len(recent_changes) > 1_000:
+                        recent_changes.pop(0)
+                    if bool(np.all(done | invalid)):
+                        break
+                slow = np.zeros(count, dtype=np.bool_)
+                unfinished = ~(done | invalid)
+                if np.any(unfinished) and len(recent_changes) == 1_000:
+                    history = np.stack(recent_changes, axis=0)
+                    monotone = np.all(
+                        history[1:] <= history[:-1] + np.finfo(float).eps,
+                        axis=0,
+                    )
+                    slow = unfinished & (np.max(history, axis=0) < 1.0e-6) & monotone
+                    done |= slow
+                invalid |= ~done
+                slot_status = np.where(invalid, 0, np.where(slow, 2, 1)).astype(np.int8)
+                destination = slice(low, high)
+                certificate_status[destination] = np.where(
+                    (certificate_status[destination] == 0) | (slot_status == 0),
+                    0,
+                    np.maximum(certificate_status[destination], slot_status),
+                )
+                certificate_iterations[destination] += iteration
+                residual_max[low:high] = np.maximum(residual_max[low:high], residual)
+                valid_result[low:high] &= ~invalid
+                # Preserve the pre-stage-4c full-path endpoint exactly: both
+                # scalar and batch paths take one final fixed-point update
+                # before the target-clearance nudge.  Status classification
+                # still uses the bounded loop above.
+                final = np.minimum(
+                    BEAM_RF_CAP_W,
+                    targets
+                    * (
+                        noise
+                        + np.matmul(coupling, power[..., None])[..., 0]
+                    )
+                    / direct_nominal,
+                )
+                final = np.where(active, final, 0.0)
+                final[forced] = BEAM_RF_CAP_W
+                power = np.minimum(
+                    BEAM_RF_CAP_W,
+                    np.nextafter(final * (1.0 + 2.0e-9), np.inf),
+                )
+                power = np.where(active, power, 0.0)
+                power[forced] = BEAM_RF_CAP_W
+                # DIAGNOSTIC VARIANT: the inherited absolute-residual stop and
+                # single nudge do not guarantee clearance at a discrete mode
+                # threshold. Retain that solve, then verify the actual SINR
+                # arithmetic used below. Raise only deficient uncapped powers
+                # through the same monotone capped interference map and the
+                # existing 1+2e-9 numerical nudge. Capped/forced links may miss
+                # their target. No physical constant or solver limit changes.
+                occupancy_targets = target_mode_index[np.minimum(occupancy, users)]
+                target_threshold = thresholds[np.maximum(occupancy_targets - 1, 0)]
+                refinement_updates = np.zeros(count, dtype=np.int64)
+                remaining_iterations = POWER_SOLVER_ITERATION_CAP - iteration
+                clearance_failed = np.zeros(count, dtype=np.bool_)
+                for refinement_round in range(remaining_iterations + 1):
+                    clearance_interference = np.matmul(
+                        coupling, power[..., None]
+                    )[..., 0]
+                    clearance_sinr = np.where(
+                        active,
+                        power * direct_nominal / (noise + clearance_interference),
+                        0.0,
+                    )
+                    deficient = (
+                        active & ~forced & (power < BEAM_RF_CAP_W)
+                        & (
+                            (clearance_sinr < targets)
+                            | (clearance_sinr * quantile < target_threshold)
+                        )
+                    )
+                    deficient_configurations = np.any(deficient, axis=1)
+                    if not np.any(deficient_configurations):
+                        break
+                    if refinement_round == remaining_iterations:
+                        clearance_failed = deficient_configurations
+                        break
+                    required_power = (
+                        targets * (noise + clearance_interference) / direct_nominal
+                    )
+                    raised_power = np.minimum(
+                        BEAM_RF_CAP_W,
+                        np.nextafter(required_power * (1.0 + 2.0e-9), np.inf),
+                    )
+                    power = np.where(
+                        deficient, np.maximum(power, raised_power), power
+                    )
+                    refinement_updates += deficient_configurations
+                certificate_iterations[destination] += refinement_updates
+                valid_result[destination] &= ~clearance_failed
+                certificate_status[destination] = np.where(
+                    clearance_failed, 0, certificate_status[destination]
+                )
+                CLEARANCE_DIAGNOSTICS["slot_configurations_refined"] += int(
+                    np.count_nonzero(refinement_updates)
+                )
+                CLEARANCE_DIAGNOSTICS["configuration_refinement_updates"] += int(
+                    np.sum(refinement_updates)
+                )
+                CLEARANCE_DIAGNOSTICS["maximum_refinement_updates"] = max(
+                    CLEARANCE_DIAGNOSTICS["maximum_refinement_updates"],
+                    int(np.max(refinement_updates, initial=0)),
+                )
+                CLEARANCE_DIAGNOSTICS["uncertified_slot_configurations"] += int(
+                    np.count_nonzero(clearance_failed)
+                )
+                realised_interference = np.matmul(
+                    field_cross * active_pair, power[..., None]
+                )[..., 0]
+                sinr = np.where(
+                    active,
+                    power * direct_field / (noise + realised_interference),
+                    0.0,
+                )
+                safe_sinr = np.maximum(sinr, np.finfo(float).tiny)
+                max_rf_power_w[low:high] = np.maximum(
+                    max_rf_power_w[low:high], np.max(power, axis=1)
+                )
+                nominal_interference = np.matmul(
+                    nominal_cross * active_pair, power[..., None]
+                )[..., 0]
+                nominal_sinr = np.where(
+                    active,
+                    power * direct_nominal / (noise + nominal_interference),
+                    0.0,
+                )
+                predicted_sinr = nominal_sinr * quantile
+                eligible_tx_modes = (
+                    predicted_sinr[:, :, None] >= thresholds[None, None, :]
+                )
+                mode_index = np.argmax(
+                    np.where(
+                        eligible_tx_modes,
+                        efficiencies[None, None, :],
+                        -1.0,
+                    ),
+                    axis=2,
+                )
+                has_tx_mode = np.any(eligible_tx_modes, axis=2)
+                transmitted_threshold = thresholds[mode_index]
+                served = active & has_tx_mode & (sinr >= transmitted_threshold)
+                chosen_efficiency = efficiencies[mode_index]
+                slot_rate = np.where(served, chosen_efficiency * BEAM_BANDWIDTH_HZ, 0.0)
+                active_margin = np.where(
+                    active & has_tx_mode,
+                    10.0 * np.log10(safe_sinr)
+                    - 10.0 * np.log10(transmitted_threshold),
+                    np.where(active, -math.inf, np.inf),
+                )
+                min_decoding_margin_db[low:high] = np.minimum(
+                    min_decoding_margin_db[low:high],
+                    np.min(active_margin, axis=1),
+                )
+                acm_se_sum[low:high] += np.sum(
+                    np.where(active & served, chosen_efficiency, 0.0), axis=1
+                )
+                acm_se_count[low:high] += np.sum(active, axis=1)
+                boundary_rate += fraction * slot_rate
+                boundary_decode |= served
+                nominal_sinr = np.where(
+                    active,
+                    power
+                    * direct_nominal
+                    / (
+                        noise
+                        + np.matmul(coupling, power[..., None])[..., 0]
+                    ),
+                    0.0,
+                )
+                boundary_feasible |= active & ~forced & (nominal_sinr >= targets)
+                flat_config, flat_user = np.nonzero(active)
+                flat_modes = np.where(
+                    served[flat_config, flat_user],
+                    mode_index[flat_config, flat_user] + 1,
+                    0,
+                )
+                np.add.at(mode_counts[low:high], (flat_config, flat_modes), 1)
+                flat_tx_modes = np.where(
+                    has_tx_mode[flat_config, flat_user],
+                    mode_index[flat_config, flat_user] + 1,
+                    0,
+                )
+                np.add.at(
+                    transmitted_mode_counts[low:high],
+                    (flat_config, flat_tx_modes),
+                    1,
+                )
+                flat_target_modes = target_mode_index[
+                    occupancy[flat_config, flat_user]
+                ]
+                np.add.at(
+                    target_mode_counts[low:high],
+                    (flat_config, flat_target_modes),
+                    1,
+                )
+                realised_decode_successes[low:high] += np.sum(served, axis=1)
+                realised_decode_failures[low:high] += np.sum(
+                    active & ~served, axis=1
+                )
+                seen[low:high] |= active
+                top_mode_index = int(np.argmax(efficiencies))
+                plateau[low:high] &= ~active | (mode_index == top_mode_index)
+                transmissions[low:high] += np.sum(active, axis=1)
+                cap_hits[low:high] += np.sum(
+                    active & (power >= BEAM_RF_CAP_W - 1.0e-9), axis=1
+                )
+                pa_w = np.sum(
+                    np.where(
+                        active & (power > 0.0),
+                        np.sqrt(power * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY,
+                        0.0,
+                    ),
+                    axis=1,
+                )
+                circuit_w = np.sum(active & (power > 0.0), axis=1) * circuit_power_per_active_chain_w
+                same_sat = aggressor_norad[:, :, None] == aggressor_norad[:, None, :]
+                earlier_active_sat = np.any(
+                    same_sat & (active[:, None, :] & lower_user), axis=2
+                )
+                active_satellites = np.sum(active & ~earlier_active_sat, axis=1)
+                boundary_energy += fraction * np.stack(
+                    (
+                        pa_w,
+                        circuit_w,
+                        active_satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
+                    ),
+                    axis=1,
+                )
+
+            # The scalar roster path records a missing in-step transmission as
+            # infeasible, rather than silently dropping that user.
+            feasible_all[low:high] &= boundary_feasible
+            if previous_rate is not None and previous_boundary is not None:
+                elapsed_s = (boundary - previous_boundary) * D2_MEASUREMENT_STEP_S
+                bits[low:high] += 0.5 * (previous_rate + boundary_rate) * elapsed_s
+                decoding[low:high] += 0.5 * (
+                    previous_decode.astype(np.float64) + boundary_decode.astype(np.float64)
+                ) * elapsed_s
+                components[low:high] += 0.5 * (previous_energy + boundary_energy) * elapsed_s
+            previous_rate = boundary_rate
+            previous_decode = boundary_decode
+            previous_energy = boundary_energy
+            previous_boundary = boundary
+
+        # A one-boundary nominal snapshot is a decision-instant score held
+        # over the decision interval.  Multi-boundary grids use trapezoids.
+        if len(boundary_indices) == 1 and previous_rate is not None:
+            duration_s = 47 * D2_MEASUREMENT_STEP_S
+            bits[low:high] += previous_rate * duration_s
+            decoding[low:high] += previous_decode.astype(np.float64) * duration_s
+            components[low:high] += previous_energy * duration_s
+
+    joules = np.sum(components, axis=1)
+    attained = bits >= rate_target_bps * (47 * D2_MEASUREMENT_STEP_S)
+    return BatchARResult(
+        *(
+            _readonly(value)
+            for value in (
+                bits[inverse_order],
+                joules[inverse_order],
+                components[inverse_order, 0],
+                components[inverse_order, 1],
+                components[inverse_order, 2],
+                decoding[inverse_order],
+                feasible_all[inverse_order],
+                attained[inverse_order],
+                residual_max[inverse_order],
+                mode_counts[inverse_order],
+                target_mode_counts[inverse_order],
+                transmitted_mode_counts[inverse_order],
+                realised_decode_successes[inverse_order],
+                realised_decode_failures[inverse_order],
+                np.sum(plateau & seen, axis=1)[inverse_order],
+                transmissions[inverse_order],
+                cap_hits[inverse_order],
+                valid_result[inverse_order],
+                certificate_status[inverse_order],
+                certificate_iterations[inverse_order],
+                max_rf_power_w[inverse_order],
+                np.where(
+                    np.isfinite(min_decoding_margin_db[inverse_order]),
+                    min_decoding_margin_db[inverse_order],
+                    -100.0,
+                ),
+                np.divide(
+                    acm_se_sum[inverse_order],
+                    acm_se_count[inverse_order],
+                    out=np.zeros(configurations, dtype=np.float64),
+                    where=acm_se_count[inverse_order] > 0,
+                ),
+            )
+        )
+    )
+
+
+
+# Private copied evaluator: all equations unchanged except target provisioning.
+evaluate_ar_tdm_catalogue = _evaluate_ar_tdm_catalogue_core
diff --git a/scripts/run_prefix_ablation.py b/scripts/run_prefix_ablation.py
new file mode 100644
index 0000000000000000000000000000000000000000..11c9add378714bfa77c1f61a5459a4231a8826f2
--- /dev/null
+++ b/scripts/run_prefix_ablation.py
@@ -0,0 +1,1045 @@
+#!/usr/bin/env python3
+"""Prefix ablation for the bounded V0.25 set-level oracle.
+
+DIAGNOSTIC_NOT_CLAIM.  This runner performs no training or policy execution.
+It reuses the declared oracle's objective, exact tie-break, catalogue families,
+and fixed caps, changing only the configuration around which the catalogue is
+constructed for the two ablation arms.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import importlib.util
+import itertools
+import json
+import math
+import multiprocessing as mp
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+REPO = Path(__file__).resolve().parents[1]
+SCRATCH = REPO / ".scratch/prefix-ablation-20260910"
+REFERENCE_REPO = Path("/home/sat/mcrl-v025-ladder-ws")
+REFERENCE_SRC = REFERENCE_REPO / "src"
+PROBE_PATH = REFERENCE_REPO / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+MARGIN_PATH = SCRATCH / "cleared_margin_batch.py"
+ETA_REF = Fraction("19720681.00172232")
+WORLD_COUNT = 2
+ANCHORS_PER_WORLD = 4
+SELECTION_WORKERS = 2
+OCCUPANT_SUBSET_MAX_SIZE = 4
+OCCUPANT_SUBSET_TOTAL_CAP = 1_024
+JOINT_CANDIDATE_CAP = 4_096
+A4_ITERATION_CAP = 16
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ARMS = (
+    "BASELINE",
+    "UNILATERAL",
+    "ORACLE_FROM_UNI",
+    "ORACLE_FROM_BASE",
+    "ORACLE_FROM_BASE_ITERATED",
+)
+
+# The command still runs from this workspace with PYTHONPATH=src as required.
+# The exact read-only stage-4h implementation named by the task is placed first
+# only inside this diagnostic process; hashes and its git identity are recorded.
+sys.path.insert(0, str(REFERENCE_SRC))
+
+
+def _load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_module("prefix_ablation_v025_probe", PROBE_PATH)
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    if isinstance(profile, SelectionMetric):
+        return profile.served_count
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def attained(profile) -> int:
+    return sum(
+        bool(value) for value in (profile.score.rate_target_attained or {}).values()
+    )
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative(numerator: float, denominator: float) -> float | None:
+    return None if denominator == 0.0 else numerator / denominator - 1.0
+
+
+def _configuration(base, mapping: Mapping[int, tuple[int, int] | None], kind: str):
+    return probe._configuration(base, dict(mapping), kind=kind)
+
+
+@dataclass(frozen=True)
+class SelectionMetric:
+    config: object
+    bits: float
+    joules: float
+    served_count: int
+
+
+@dataclass(frozen=True)
+class CoordinateResult:
+    selected: object
+    moves: tuple[dict[str, object], ...]
+    passes: int
+    terminal_candidates: tuple[object, ...]
+    best_alternatives: Mapping[int, tuple[int, int]]
+    candidate_comparisons: int
+
+
+_WORKER_TAPE = None
+
+
+def _selection_worker(task):
+    step_index, base, configs = task
+    evaluator = probe.StepEvaluator(
+        _WORKER_TAPE,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    evaluator.evaluate_many(configs)
+    rows = []
+    for config in configs:
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is not None:
+            rows.append(SelectionMetric(config, profile.bits, profile.joules, served(profile)))
+    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations
+
+
+class ParallelSelectionEvaluator:
+    """Persistent fork workers over one tape; cache is local to one arm."""
+
+    def __init__(self, tape, step_index: int, base, pool) -> None:
+        self.tape = tape
+        self.step_index = step_index
+        self.base = base
+        self.pool = pool
+        self._evaluated: dict[str, SelectionMetric] = {}
+        self._invalid: set[str] = set()
+        self.physical_evaluations = 0
+
+    def evaluate_many(self, configs: Sequence[object]) -> None:
+        missing_by_id = {
+            row.configuration_id: row
+            for row in configs
+            if row.configuration_id not in self._evaluated
+            and row.configuration_id not in self._invalid
+        }
+        missing = tuple(missing_by_id.values())
+        if not missing:
+            return
+        shards = tuple(
+            tuple(missing[index::SELECTION_WORKERS])
+            for index in range(SELECTION_WORKERS)
+        )
+        results = (
+            [_selection_worker((self.step_index, self.base, missing))]
+            if self.pool is None
+            else self.pool.map(
+                _selection_worker,
+                tuple((self.step_index, self.base, shard) for shard in shards),
+                chunksize=1,
+            )
+        )
+        unordered = {}
+        for rows, invalid, evaluations in results:
+            unordered.update((row.config.configuration_id, row) for row in rows)
+            self._invalid.update(invalid)
+            self.physical_evaluations += evaluations
+        for config in missing:
+            if config.configuration_id in unordered:
+                self._evaluated[config.configuration_id] = unordered[config.configuration_id]
+
+    def evaluate(self, config) -> SelectionMetric:
+        self.evaluate_many((config,))
+        try:
+            return self._evaluated[config.configuration_id]
+        except KeyError:
+            raise RuntimeError(f"invalid selection configuration {config.configuration_id}") from None
+
+
+def _best_alternatives_from_cache(*, base, current, options, evaluator):
+    result: dict[int, tuple[int, int]] = {}
+    current_map = current.mapping
+    for user in sorted(options):
+        rows = []
+        for identity in options[user]:
+            if identity == current_map[user]:
+                continue
+            mapping = dict(current_map)
+            mapping[user] = identity
+            candidate = _configuration(base, mapping, "catalogue-destination-scan")
+            profile = evaluator._evaluated.get(candidate.configuration_id)
+            if profile is not None:
+                rows.append((objective(profile), candidate.configuration_id, identity))
+        if rows:
+            result[user] = min(rows, key=lambda row: (-row[0], row[1]))[2]
+    return result
+
+
+def scan_best_alternatives(*, tape, step_index: int, base, current, evaluator):
+    """One fixed-seed destination scan; no returned move is adopted."""
+
+    options, _ = probe._legal_options(tape, step_index)
+    current_map = current.mapping
+    candidates = []
+    for user in sorted(options):
+        for identity in options[user]:
+            if identity == current_map[user]:
+                continue
+            mapping = dict(current_map)
+            mapping[user] = identity
+            candidates.append(_configuration(base, mapping, "catalogue-destination-scan"))
+    evaluator.evaluate_many(candidates)
+    return (
+        _best_alternatives_from_cache(
+            base=base, current=current, options=options, evaluator=evaluator
+        ),
+        len(candidates),
+    )
+
+
+def coordinate_optimum(*, tape, step_index: int, base, evaluator, guard: int) -> CoordinateResult:
+    """Reference deterministic cyclic best response to a certified fixed point."""
+
+    options, _ = probe._legal_options(tape, step_index)
+    current = base
+    moves: list[dict[str, object]] = []
+    passes = 0
+    comparisons = 0
+    terminal: tuple[object, ...] = ()
+    while True:
+        passes += 1
+        pass_moves = 0
+        pass_candidates = []
+        for user in sorted(options):
+            current_profile = evaluator.evaluate(current)
+            current_value = objective(current_profile)
+            current_map = current.mapping
+            candidates = []
+            for identity in options[user]:
+                if identity == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = identity
+                candidates.append(_configuration(base, mapping, "unilateral-coordinate"))
+            evaluator.evaluate_many(candidates)
+            comparisons += len(candidates)
+            pass_candidates.extend(candidates)
+            best = current
+            best_profile = current_profile
+            best_value = current_value
+            for candidate in candidates:
+                profile = evaluator._evaluated.get(candidate.configuration_id)
+                if profile is None or served(profile) < guard:
+                    continue
+                value = objective(profile)
+                if value > best_value or (
+                    value == best_value
+                    and best is not current
+                    and candidate.configuration_id < best.configuration_id
+                ):
+                    best, best_profile, best_value = candidate, profile, value
+            if best.assignments != current.assignments:
+                before = current.mapping
+                after = best.mapping
+                origin = before[user]
+                destination = after[user]
+                occupancy = Counter(value for value in before.values() if value is not None)
+                moves.append(
+                    {
+                        "pass": passes,
+                        "user": user,
+                        "origin": origin,
+                        "destination": destination,
+                        "origin_occupancy": 0 if origin is None else occupancy[origin],
+                        "destination_occupancy_before": (
+                            0 if destination is None else occupancy[destination]
+                        ),
+                        "transition_type": (
+                            "null-to-beam"
+                            if origin is None
+                            else "beam-to-null"
+                            if destination is None
+                            else "same-satellite-beam-change"
+                            if origin[0] == destination[0]
+                            else "satellite-change"
+                        ),
+                        "selection_objective_gain_bits": float(best_value - current_value),
+                        "catalogue_exactly_expressible": False,
+                        "catalogue_exclusion": "catalogue rejects every <2-user change",
+                    }
+                )
+                current = best
+                pass_moves += 1
+        if pass_moves == 0:
+            terminal = tuple(pass_candidates)
+            break
+
+    # Identical to the reference: terminal alternatives are already evaluated
+    # by the no-move certificate and are ranked without applying the guard.
+    best_alternatives = _best_alternatives_from_cache(
+        base=base, current=current, options=options, evaluator=evaluator
+    )
+    return CoordinateResult(
+        current,
+        tuple(moves),
+        passes,
+        terminal,
+        best_alternatives,
+        comparisons,
+    )
+
+
+def _interference_contributors(*, tape, step_index: int, current, victim: int):
+    """Reference nominal physical-interference ordering."""
+
+    mapping = current.mapping
+    victim_beam = mapping[victim]
+    if victim_beam is None:
+        return ()
+    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
+    step = tape.steps[step_index]
+    scores = []
+    if step.arrays is not None:
+        arrays = step.arrays
+        victim_row = arrays._row_index().get((victim, victim_beam))
+        aggressor_of = arrays._aggressor_index()
+        if victim_row is None:
+            return ()
+        for user, beam in sorted(mapping.items()):
+            if user == victim or beam is None or beam == victim_beam:
+                continue
+            aggressor_index = aggressor_of.get(beam)
+            if aggressor_index is None:
+                continue
+            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
+            score = gain / occupancy[beam]
+            if score > 0.0:
+                scores.append((score, user))
+    else:
+        boundary = step.boundary_at(0)
+        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
+        victim_row = by_key.get((victim, victim_beam))
+        if victim_row is None:
+            return ()
+        cross = dict(victim_row.nominal_cross_gain_by_identity)
+        for user, beam in sorted(mapping.items()):
+            if user == victim or beam is None or beam == victim_beam:
+                continue
+            score = cross.get(beam, 0.0) / occupancy[beam]
+            if score > 0.0:
+                scores.append((score, user))
+    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))
+
+
+def build_joint_candidates(*, tape, step_index: int, base, seed, best_alternatives):
+    """Reference catalogue rules and caps, parameterised only by its seed."""
+
+    options, _ = probe._legal_options(tape, step_index)
+    current_map = seed.mapping
+    by_beam = {
+        beam: tuple(
+            user for user, identity in sorted(current_map.items()) if identity == beam
+        )
+        for beam in sorted({row for row in current_map.values() if row is not None})
+    }
+    aliases: dict[tuple, list[dict[str, object]]] = {}
+    configs: dict[tuple, object] = {}
+    family_rows = Counter()
+
+    def add(mapping, *, family: str, coalition: Sequence[int], detail: str) -> None:
+        changed = tuple(
+            user for user in sorted(current_map) if mapping[user] != current_map[user]
+        )
+        if len(changed) < 2:
+            return
+        assignments = tuple(sorted(mapping.items()))
+        aliases.setdefault(assignments, []).append(
+            {
+                "family": family,
+                "coalition_users": list(sorted(coalition)),
+                "changed_users": list(changed),
+                "detail": detail,
+            }
+        )
+        if assignments not in configs:
+            configs[assignments] = _configuration(base, mapping, family)
+            family_rows[family] += 1
+
+    occupant_rows = 0
+    for beam, occupants in by_beam.items():
+        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
+            for coalition in itertools.combinations(occupants, size):
+                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
+                    break
+                if any(user not in best_alternatives for user in coalition):
+                    continue
+                mapping = dict(current_map)
+                for user in coalition:
+                    mapping[user] = best_alternatives[user]
+                add(
+                    mapping,
+                    family="beam-occupant-subset",
+                    coalition=coalition,
+                    detail=f"origin={beam[0]}:{beam[1]};size={size}",
+                )
+                occupant_rows += 1
+            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
+                break
+        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
+            break
+
+    for victim in sorted(current_map):
+        if victim not in best_alternatives:
+            continue
+        contributors = _interference_contributors(
+            tape=tape, step_index=step_index, current=seed, victim=victim
+        )
+        for count in (2, 3):
+            if len(contributors) < count:
+                continue
+            coalition = (victim, *contributors[:count])
+            if any(user not in best_alternatives for user in coalition):
+                continue
+            mapping = dict(current_map)
+            for user in coalition:
+                mapping[user] = best_alternatives[user]
+            add(
+                mapping,
+                family=f"victim-plus-top-{count}-contributors",
+                coalition=coalition,
+                detail=f"victim={victim};contributors={','.join(map(str, contributors[:count]))}",
+            )
+
+    for beam, occupants in by_beam.items():
+        if len(occupants) < 2:
+            continue
+        common = set(options[occupants[0]])
+        for user in occupants[1:]:
+            common.intersection_update(options[user])
+        common.discard(beam)
+        for destination in sorted(common):
+            mapping = dict(current_map)
+            for user in occupants:
+                mapping[user] = destination
+            add(
+                mapping,
+                family="complete-beam-evacuation",
+                coalition=occupants,
+                detail=(
+                    f"origin={beam[0]}:{beam[1]};"
+                    f"destination={destination[0]}:{destination[1]}"
+                ),
+            )
+
+    ordered = tuple(configs[key] for key in sorted(configs))
+    if len(ordered) > JOINT_CANDIDATE_CAP:
+        raise RuntimeError(
+            f"mechanism catalogue exceeds fixed bound: {len(ordered)} > {JOINT_CANDIDATE_CAP}"
+        )
+    return (
+        ordered,
+        {key: tuple(value) for key, value in aliases.items()},
+        dict(sorted(family_rows.items())),
+        occupant_rows,
+    )
+
+
+def rank_catalogue(*, fallback, candidates, evaluator, guard: int):
+    fallback_profile = evaluator.evaluate(fallback)
+    best, best_profile = fallback, fallback_profile
+    for candidate in candidates:
+        profile = evaluator._evaluated.get(candidate.configuration_id)
+        if profile is None or served(profile) < guard:
+            continue
+        value = objective(profile)
+        best_value = objective(best_profile)
+        if value > best_value or (
+            value == best_value
+            and best is not fallback
+            and candidate.configuration_id < best.configuration_id
+        ):
+            best, best_profile = candidate, profile
+    return best, best_profile
+
+
+def arm_cost(evaluator, started: float) -> dict[str, object]:
+    return {
+        "unique_selection_configuration_evaluations": evaluator.physical_evaluations,
+        "selection_wall_seconds": time.perf_counter() - started,
+    }
+
+
+def evaluate_anchor(*, tape, world_index: int, step_index: int, pool) -> dict[str, object]:
+    setting = probe._setting("a-r0")
+    run_setting = probe.run_setting_for("a-r0")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+
+    # A0/A1/A2 are nested, so phase snapshots give their independent prefix costs
+    # without redundantly recomputing the same configurations.
+    from_uni = ParallelSelectionEvaluator(tape, step_index, base, pool)
+    uni_started = time.perf_counter()
+    base_selection = from_uni.evaluate(base)
+    guard = served(base_selection)
+    costs = {"BASELINE": arm_cost(from_uni, uni_started)}
+    coordinate = coordinate_optimum(
+        tape=tape,
+        step_index=step_index,
+        base=base,
+        evaluator=from_uni,
+        guard=guard,
+    )
+    unilateral = coordinate.selected
+    costs["UNILATERAL"] = arm_cost(from_uni, uni_started)
+    uni_candidates, uni_aliases, uni_families, uni_occupant_rows = build_joint_candidates(
+        tape=tape,
+        step_index=step_index,
+        base=base,
+        seed=unilateral,
+        best_alternatives=coordinate.best_alternatives,
+    )
+    from_uni.evaluate_many(uni_candidates)
+    oracle_uni, _ = rank_catalogue(
+        fallback=unilateral,
+        candidates=uni_candidates,
+        evaluator=from_uni,
+        guard=guard,
+    )
+    costs["ORACLE_FROM_UNI"] = arm_cost(from_uni, uni_started)
+
+    # A3 is exactly A4 round one.  One cache makes the A3 cost the first-round
+    # cumulative snapshot and the A4 cost the termination snapshot.
+    from_base = ParallelSelectionEvaluator(tape, step_index, base, pool)
+    base_started = time.perf_counter()
+    current = base
+    rounds = []
+    trajectory = []
+    base_first_candidates = ()
+    base_first_aliases = {}
+    base_first_alternatives = {}
+    terminated = False
+    for round_index in range(1, A4_ITERATION_CAP + 1):
+        before_value = objective(from_base.evaluate(current))
+        best_alternatives, alternate_comparisons = scan_best_alternatives(
+            tape=tape,
+            step_index=step_index,
+            base=base,
+            current=current,
+            evaluator=from_base,
+        )
+        candidates, aliases, families, occupant_rows = build_joint_candidates(
+            tape=tape,
+            step_index=step_index,
+            base=base,
+            seed=current,
+            best_alternatives=best_alternatives,
+        )
+        from_base.evaluate_many(candidates)
+        selected, selected_profile = rank_catalogue(
+            fallback=current,
+            candidates=candidates,
+            evaluator=from_base,
+            guard=guard,
+        )
+        improved = objective(selected_profile) > before_value
+        round_row = {
+            "round": round_index,
+            "seed_configuration_id": current.configuration_id,
+            "selected_configuration_id": selected.configuration_id,
+            "strict_improvement": improved,
+            "selection_objective_gain_bits": float(objective(selected_profile) - before_value),
+            "alternate_candidate_comparisons": alternate_comparisons,
+            "catalogue_unique": len(candidates),
+            "catalogue_aliases": sum(len(value) for value in aliases.values()),
+            "catalogue_family_unique_counts": families,
+            "occupant_subset_generation_rows": occupant_rows,
+            "cumulative_unique_selection_configuration_evaluations": from_base.physical_evaluations,
+            "cumulative_selection_wall_seconds": time.perf_counter() - base_started,
+        }
+        rounds.append(round_row)
+        trajectory.append(selected)
+        if round_index == 1:
+            oracle_base = selected
+            costs["ORACLE_FROM_BASE"] = {
+                "unique_selection_configuration_evaluations": from_base.physical_evaluations,
+                "selection_wall_seconds": round_row["cumulative_selection_wall_seconds"],
+            }
+            base_first_candidates = candidates
+            base_first_aliases = aliases
+            base_first_alternatives = dict(best_alternatives)
+        if not improved:
+            terminated = True
+            current = selected
+            break
+        current = selected
+    oracle_base_iterated = current
+    costs["ORACLE_FROM_BASE_ITERATED"] = arm_cost(from_base, base_started)
+    if not terminated:
+        costs["ORACLE_FROM_BASE_ITERATED"]["termination"] = "ITERATION_CAP_REACHED"
+
+    arm_configs = {
+        "BASELINE": base,
+        "UNILATERAL": unilateral,
+        "ORACLE_FROM_UNI": oracle_uni,
+        "ORACLE_FROM_BASE": oracle_base,
+        "ORACLE_FROM_BASE_ITERATED": oracle_base_iterated,
+    }
+    committed_counter = probe.EvaluationCounter()
+    committed = probe.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        field="realised",
+        counter=committed_counter,
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    unique_configs = {
+        config.configuration_id: config
+        for config in (*arm_configs.values(), *trajectory)
+    }
+    committed.evaluate_many(tuple(unique_configs.values()))
+    committed_profiles = {
+        name: committed.evaluate(config) for name, config in arm_configs.items()
+    }
+
+    for name, profile in committed_profiles.items():
+        costs[name]["committed_unique_configuration_evaluations_excluded_from_selector_cost"] = 1
+        costs[name]["guard_reference_count"] = guard
+
+    # Earliest A4 round whose committed EE reaches the same anchor's A1 EE.
+    a1_ee = ratio(committed_profiles["UNILATERAL"].bits, committed_profiles["UNILATERAL"].joules)
+    matched = None
+    if ratio(committed.evaluate(base).bits, committed.evaluate(base).joules) >= a1_ee:
+        matched = {"round": 0, "unique_evaluations": 1, "wall_seconds": 0.0}
+    else:
+        for round_row, config in zip(rounds, trajectory, strict=True):
+            profile = committed.evaluate(config)
+            if ratio(profile.bits, profile.joules) >= a1_ee:
+                matched = {
+                    "round": round_row["round"],
+                    "unique_evaluations": round_row[
+                        "cumulative_unique_selection_configuration_evaluations"
+                    ],
+                    "wall_seconds": round_row["cumulative_selection_wall_seconds"],
+                }
+                break
+
+    # Quantify the catalogue's one-shot destination staleness and whether the
+    # complete A1 endpoint was present in A3's initial candidate set.
+    base_alt_matches = 0
+    for move in coordinate.moves:
+        destination = move["destination"]
+        if base_first_alternatives.get(int(move["user"])) == destination:
+            base_alt_matches += 1
+    endpoint_changed = tuple(
+        user
+        for user in sorted(base.mapping)
+        if base.mapping[user] != unilateral.mapping[user]
+    )
+    endpoint_alt_matches = sum(
+        base_first_alternatives.get(user) == unilateral.mapping[user]
+        for user in endpoint_changed
+    )
+    endpoint_aliases = base_first_aliases.get(unilateral.assignments, ())
+
+    metrics = {}
+    for name, profile in committed_profiles.items():
+        metrics[name] = {
+            "configuration_id": profile.config.configuration_id,
+            "assignments": list(profile.config.assignments),
+            "bits": profile.bits,
+            "joules": profile.joules,
+            "ee_bit_per_j": ratio(profile.bits, profile.joules),
+            "served_count": served(profile),
+            "rate_target_attained_count": attained(profile),
+            **costs[name],
+        }
+
+    return {
+        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
+        "world_index": world_index,
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "guard": {
+            "definition": "selection-time served count >= BASELINE served count",
+            "reference_arm": "BASELINE",
+            "reference_count": guard,
+            "same_reference_for_all_arms_and_all_A4_rounds": True,
+        },
+        "arms": metrics,
+        "unilateral_search": {
+            "passes_to_certificate": coordinate.passes,
+            "improving_moves": len(coordinate.moves),
+            "candidate_comparisons": coordinate.candidate_comparisons,
+            "moves": list(coordinate.moves),
+        },
+        "a2_catalogue": {
+            "unique": len(uni_candidates),
+            "aliases": sum(len(value) for value in uni_aliases.values()),
+            "family_unique_counts": uni_families,
+            "occupant_subset_generation_rows": uni_occupant_rows,
+        },
+        "a3_catalogue": {
+            "unique": len(base_first_candidates),
+            "aliases": sum(len(value) for value in base_first_aliases.values()),
+            "unilateral_endpoint_present": bool(endpoint_aliases),
+            "unilateral_endpoint_aliases": list(endpoint_aliases),
+        },
+        "unilateral_vs_base_catalogue": {
+            "moves_whose_destination_matches_base_scan": base_alt_matches,
+            "total_moves": len(coordinate.moves),
+            "endpoint_changed_users": len(endpoint_changed),
+            "endpoint_destinations_matching_base_scan": endpoint_alt_matches,
+        },
+        "a4": {
+            "declared_iteration_cap": A4_ITERATION_CAP,
+            "terminated_by_no_improvement": terminated,
+            "rounds_to_termination": len(rounds) if terminated else None,
+            "improving_rounds": sum(bool(row["strict_improvement"]) for row in rounds),
+            "rounds": rounds,
+            "first_round_reaching_unilateral_committed_ee": matched,
+        },
+        "committed_unique_configurations_including_a4_trajectory": len(unique_configs),
+        "committed_physical_boundary_evaluations": committed_counter.boundary_evaluations,
+    }
+
+
+def _distribution(values: Sequence[float]) -> dict[str, float]:
+    return {
+        "minimum": min(values),
+        "mean": statistics.fmean(values),
+        "median": statistics.median(values),
+        "maximum": max(values),
+    }
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    pooled = {}
+    for name in ARMS:
+        bits = math.fsum(float(row["arms"][name]["bits"]) for row in anchors)  # type: ignore[index]
+        joules = math.fsum(float(row["arms"][name]["joules"]) for row in anchors)  # type: ignore[index]
+        ee = ratio(bits, joules)
+        pooled[name] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ee,
+            "relative_gap_to_UNILATERAL": None,
+            "relative_gap_to_BASELINE": None,
+            "served_count_sum": sum(int(row["arms"][name]["served_count"]) for row in anchors),  # type: ignore[index]
+            "rate_target_attained_count_sum": sum(int(row["arms"][name]["rate_target_attained_count"]) for row in anchors),  # type: ignore[index]
+            "anchors_worse_than_UNILATERAL_by_committed_ee": sum(
+                float(row["arms"][name]["ee_bit_per_j"])  # type: ignore[index]
+                < float(row["arms"]["UNILATERAL"]["ee_bit_per_j"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "unique_selection_configuration_evaluations_per_anchor": _distribution(
+                [float(row["arms"][name]["unique_selection_configuration_evaluations"]) for row in anchors]  # type: ignore[index]
+            ),
+            "selection_wall_seconds_per_anchor": _distribution(
+                [float(row["arms"][name]["selection_wall_seconds"]) for row in anchors]  # type: ignore[index]
+            ),
+        }
+    for name in ARMS:
+        pooled[name]["relative_gap_to_UNILATERAL"] = relative(
+            pooled[name]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        )
+        pooled[name]["relative_gap_to_BASELINE"] = relative(
+            pooled[name]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        )
+
+    moves = [move for row in anchors for move in row["unilateral_search"]["moves"]]  # type: ignore[index]
+    transition_counts = Counter(str(move["transition_type"]) for move in moves)
+    origin_counts = Counter(
+        "4+" if int(move["origin_occupancy"]) >= 4 else str(move["origin_occupancy"])
+        for move in moves
+    )
+    destination_counts = Counter(
+        "empty" if int(move["destination_occupancy_before"]) == 0 else "occupied"
+        for move in moves
+    )
+    matches = [
+        row["a4"]["first_round_reaching_unilateral_committed_ee"]  # type: ignore[index]
+        for row in anchors
+    ]
+    matched_rows = [row for row in matches if row is not None]
+    matched_quality = {
+        "anchors_reaching_or_exceeding_A1_committed_ee": len(matched_rows),
+        "anchors_total": len(anchors),
+    }
+    if matched_rows:
+        matched_quality.update(
+            {
+                "a4_first_match_unique_evaluations": _distribution(
+                    [float(row["unique_evaluations"]) for row in matched_rows]
+                ),
+                "a4_first_match_wall_seconds": _distribution(
+                    [float(row["wall_seconds"]) for row in matched_rows]
+                ),
+            }
+        )
+
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({str(row["world_domain"]) for row in anchors}),
+        "pooled": pooled,
+        "a4_termination": {
+            "terminated_anchors": sum(bool(row["a4"]["terminated_by_no_improvement"]) for row in anchors),  # type: ignore[index]
+            "rounds_to_termination": [row["a4"]["rounds_to_termination"] for row in anchors],  # type: ignore[index]
+            "improving_rounds": [row["a4"]["improving_rounds"] for row in anchors],  # type: ignore[index]
+        },
+        "unilateral_move_expressibility": {
+            "total_improving_single_user_moves": len(moves),
+            "exactly_expressible_by_catalogue": sum(bool(move["catalogue_exactly_expressible"]) for move in moves),
+            "excluded_because_catalogue_requires_at_least_two_changed_users": len(moves),
+            "transition_type_counts": dict(sorted(transition_counts.items())),
+            "origin_occupancy_counts": dict(sorted(origin_counts.items())),
+            "destination_occupancy_before_counts": dict(sorted(destination_counts.items())),
+            "move_destinations_matching_one_shot_base_alternate": sum(
+                int(row["unilateral_vs_base_catalogue"]["moves_whose_destination_matches_base_scan"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "endpoint_changed_users": sum(
+                int(row["unilateral_vs_base_catalogue"]["endpoint_changed_users"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "endpoint_destinations_matching_one_shot_base_alternate": sum(
+                int(row["unilateral_vs_base_catalogue"]["endpoint_destinations_matching_base_scan"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "anchors_with_A1_endpoint_present_in_initial_A3_catalogue": sum(
+                bool(row["a3_catalogue"]["unilateral_endpoint_present"]) for row in anchors  # type: ignore[index]
+            ),
+        },
+        "matched_quality": matched_quality,
+    }
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(["git", *args], cwd=REPO, text=True).strip()
+
+
+def run(*, worlds: int, anchors_per_world: int, provisioning_rule: str, output: Path, synthetic: bool):
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested panel exceeds declared 2-world x 4-anchor panel")
+    if provisioning_rule not in {"sealed", "margin"}:
+        raise RuntimeError("provisioning rule must be sealed or margin")
+    margin_module = _load_module("prefix_ablation_margin_batch", MARGIN_PATH)
+    sealed_batch = __import__("mcrl.physics_v025.batch", fromlist=["evaluate_ar_tdm_catalogue"])
+    probe.evaluate_ar_tdm_catalogue = (
+        margin_module.evaluate_ar_tdm_catalogue
+        if provisioning_rule == "margin"
+        else sealed_batch.evaluate_ar_tdm_catalogue
+    )
+    started = time.perf_counter()
+    anchors = []
+    worlds_out = []
+    for world_index in range(1, worlds + 1):
+        domain = (
+            probe.SYNTHETIC_WORLD_DOMAINS[world_index - 1]
+            if synthetic
+            else probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        )
+        provider = probe.TinySyntheticProvider(users=3) if synthetic else real_factory()
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=provider,
+            steps=anchors_per_world,
+            start_time_s=0.0,
+        )
+        worlds_out.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        global _WORKER_TAPE
+        _WORKER_TAPE = tape
+        pool = None
+        if not synthetic:
+            if "fork" not in mp.get_all_start_methods():
+                raise RuntimeError("parallel selector requires POSIX fork")
+            pool = mp.get_context("fork").Pool(SELECTION_WORKERS)
+        try:
+            for step_index in range(anchors_per_world):
+                row = evaluate_anchor(
+                    tape=tape,
+                    world_index=world_index,
+                    step_index=step_index,
+                    pool=pool,
+                )
+                anchors.append(row)
+                partial = {
+                    "claim_ceiling": CLAIM_CEILING,
+                    "status": "PARTIAL_RUNNING",
+                    "provisioning_rule": provisioning_rule,
+                    "worlds": worlds_out,
+                    "anchors": anchors,
+                    "summary": summarize(anchors),
+                }
+                output.with_suffix(".checkpoint.json").write_text(
+                    json.dumps(partial, indent=2, sort_keys=True, allow_nan=False) + "\n",
+                    encoding="ascii",
+                )
+                print(
+                    json.dumps(
+                        {
+                            "anchor": row["anchor_id"],
+                            "rule": provisioning_rule,
+                            "A1_moves": row["unilateral_search"]["improving_moves"],
+                            "A3_catalogue": row["a3_catalogue"]["unique"],
+                            "A4_rounds": len(row["a4"]["rounds"]),
+                            "A4_terminated": row["a4"]["terminated_by_no_improvement"],
+                        },
+                        sort_keys=True,
+                    ),
+                    flush=True,
+                )
+        finally:
+            if pool is not None:
+                pool.close()
+                pool.join()
+
+    result = {
+        "schema": "mcrl-v025-prefix-ablation-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "provisioning_rule": provisioning_rule,
+        "provisioning_definition": (
+            "Gamma_margin(e,n)=Gamma(n)/q_0.10(e)"
+            if provisioning_rule == "margin"
+            else "sealed Gamma(n)"
+        ),
+        "source_commit": _git("rev-parse", "HEAD"),
+        "source_tree": _git("rev-parse", "HEAD^{tree}"),
+        "reference_source_commit": subprocess.check_output(
+            ["git", "rev-parse", "HEAD"], cwd=REFERENCE_REPO, text=True
+        ).strip(),
+        "reference_source_tree": subprocess.check_output(
+            ["git", "rev-parse", "HEAD^{tree}"], cwd=REFERENCE_REPO, text=True
+        ).strip(),
+        "reference_source_root": str(REFERENCE_REPO),
+        "runner_sha256": file_sha256(Path(__file__).resolve()),
+        "probe_source_sha256": file_sha256(PROBE_PATH),
+        "margin_batch_source_sha256": file_sha256(MARGIN_PATH),
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "platform": platform.platform(),
+        "process_limit": 3,
+        "processes_used": 1 if synthetic else 1 + SELECTION_WORKERS,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "policy_run_used": False,
+        "training_run_used": False,
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "all arms and A4 rounds use selection-time BASELINE served count",
+        "catalogue_contract": {
+            "occupant_subset_max_size": OCCUPANT_SUBSET_MAX_SIZE,
+            "occupant_subset_generation_cap": OCCUPANT_SUBSET_TOTAL_CAP,
+            "joint_candidate_cap": JOINT_CANDIDATE_CAP,
+            "a4_declared_iteration_cap": A4_ITERATION_CAP,
+            "fallbacks": {
+                "ORACLE_FROM_UNI": "UNILATERAL",
+                "ORACLE_FROM_BASE": "BASELINE",
+                "ORACLE_FROM_BASE_ITERATED": "current round seed",
+            },
+        },
+        "worlds": worlds_out,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+        "synthetic_self_test": synthetic,
+    }
+    unsigned = json.dumps(result, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("ascii")
+    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
+    output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--provisioning-rule", choices=("sealed", "margin"), required=True)
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    result = run(
+        worlds=1 if args.self_test else args.worlds,
+        anchors_per_world=1 if args.self_test else args.anchors_per_world,
+        provisioning_rule=args.provisioning_rule,
+        output=args.output,
+        synthetic=args.self_test,
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/.scratch/prefix-ablation-20260910/cleared_margin_batch.py b/.scratch/prefix-ablation-20260910/cleared_margin_batch.py
new file mode 100644
