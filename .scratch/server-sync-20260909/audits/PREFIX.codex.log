+#!/usr/bin/env python3
+"""Prefix ablation for the bounded V0.25 set-level oracle.
+
+DIAGNOSTIC_NOT_CLAIM.  This runner performs no training or policy execution.
+It reuses the declared oracle's objective, exact tie-break, catalogue families,
+and fixed caps, changing only the configuration around which the catalogue is
+constructed for the two ablation arms.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import importlib.util
+import itertools
+import json
+import math
+import multiprocessing as mp
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+REPO = Path(__file__).resolve().parents[1]
+SCRATCH = REPO / ".scratch/prefix-ablation-20260910"
+REFERENCE_REPO = Path("/home/sat/mcrl-v025-ladder-ws")
+REFERENCE_SRC = REFERENCE_REPO / "src"
+PROBE_PATH = REFERENCE_REPO / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+MARGIN_PATH = SCRATCH / "cleared_margin_batch.py"
+ETA_REF = Fraction("19720681.00172232")
+WORLD_COUNT = 2
+ANCHORS_PER_WORLD = 4
+SELECTION_WORKERS = 2
+OCCUPANT_SUBSET_MAX_SIZE = 4
+OCCUPANT_SUBSET_TOTAL_CAP = 1_024
+JOINT_CANDIDATE_CAP = 4_096
+A4_ITERATION_CAP = 16
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ARMS = (
+    "BASELINE",
+    "UNILATERAL",
+    "ORACLE_FROM_UNI",
+    "ORACLE_FROM_BASE",
+    "ORACLE_FROM_BASE_ITERATED",
+)
+
+# The command still runs from this workspace with PYTHONPATH=src as required.
+# The exact read-only stage-4h implementation named by the task is placed first
+# only inside this diagnostic process; hashes and its git identity are recorded.
+sys.path.insert(0, str(REFERENCE_SRC))
+
+
+def _load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_module("prefix_ablation_v025_probe", PROBE_PATH)
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    if isinstance(profile, SelectionMetric):
+        return profile.served_count
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def attained(profile) -> int:
+    return sum(
+        bool(value) for value in (profile.score.rate_target_attained or {}).values()
+    )
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative(numerator: float, denominator: float) -> float | None:
+    return None if denominator == 0.0 else numerator / denominator - 1.0
+
+
+def _configuration(base, mapping: Mapping[int, tuple[int, int] | None], kind: str):
+    return probe._configuration(base, dict(mapping), kind=kind)
+
+
+@dataclass(frozen=True)
+class SelectionMetric:
+    config: object
+    bits: float
+    joules: float
+    served_count: int
+
+
+@dataclass(frozen=True)
+class CoordinateResult:
+    selected: object
+    moves: tuple[dict[str, object], ...]
+    passes: int
+    terminal_candidates: tuple[object, ...]
+    best_alternatives: Mapping[int, tuple[int, int]]
+    candidate_comparisons: int
+
+
+_WORKER_TAPE = None
+
+
+def _selection_worker(task):
+    step_index, base, configs = task
+    evaluator = probe.StepEvaluator(
+        _WORKER_TAPE,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    evaluator.evaluate_many(configs)
+    rows = []
+    for config in configs:
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is not None:
+            rows.append(SelectionMetric(config, profile.bits, profile.joules, served(profile)))
+    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations
+
+
+class ParallelSelectionEvaluator:
+    """Persistent fork workers over one tape; cache is local to one arm."""
+
+    def __init__(self, tape, step_index: int, base, pool) -> None:
+        self.tape = tape
+        self.step_index = step_index
+        self.base = base
+        self.pool = pool
+        self._evaluated: dict[str, SelectionMetric] = {}
+        self._invalid: set[str] = set()
+        self.physical_evaluations = 0
+
+    def evaluate_many(self, configs: Sequence[object]) -> None:
+        missing_by_id = {
+            row.configuration_id: row
+            for row in configs
+            if row.configuration_id not in self._evaluated
+            and row.configuration_id not in self._invalid
+        }
+        missing = tuple(missing_by_id.values())
+        if not missing:
+            return
+        shards = tuple(
+            tuple(missing[index::SELECTION_WORKERS])
+            for index in range(SELECTION_WORKERS)
+        )
+        results = (
+            [_selection_worker((self.step_index, self.base, missing))]
+            if self.pool is None
+            else self.pool.map(
+                _selection_worker,
+                tuple((self.step_index, self.base, shard) for shard in shards),
+                chunksize=1,
+            )
+        )
+        unordered = {}
+        for rows, invalid, evaluations in results:
+            unordered.update((row.config.configuration_id, row) for row in rows)
+            self._invalid.update(invalid)
+            self.physical_evaluations += evaluations
+        for config in missing:
+            if config.configuration_id in unordered:
+                self._evaluated[config.configuration_id] = unordered[config.configuration_id]
+
+    def evaluate(self, config) -> SelectionMetric:
+        self.evaluate_many((config,))
+        try:
+            return self._evaluated[config.configuration_id]
+        except KeyError:
+            raise RuntimeError(f"invalid selection configuration {config.configuration_id}") from None
+
+
+def _best_alternatives_from_cache(*, base, current, options, evaluator):
+    result: dict[int, tuple[int, int]] = {}
+    current_map = current.mapping
+    for user in sorted(options):
+        rows = []
+        for identity in options[user]:
+            if identity == current_map[user]:
+                continue
+            mapping = dict(current_map)
+            mapping[user] = identity
+            candidate = _configuration(base, mapping, "catalogue-destination-scan")
+            profile = evaluator._evaluated.get(candidate.configuration_id)
+            if profile is not None:
+                rows.append((objective(profile), candidate.configuration_id, identity))
+        if rows:
+            result[user] = min(rows, key=lambda row: (-row[0], row[1]))[2]
+    return result
+
+
+def scan_best_alternatives(*, tape, step_index: int, base, current, evaluator):
+    """One fixed-seed destination scan; no returned move is adopted."""
+
+    options, _ = probe._legal_options(tape, step_index)
+    current_map = current.mapping
+    candidates = []
+    for user in sorted(options):
+        for identity in options[user]:
+            if identity == current_map[user]:
+                continue
+            mapping = dict(current_map)
+            mapping[user] = identity
+            candidates.append(_configuration(base, mapping, "catalogue-destination-scan"))
+    evaluator.evaluate_many(candidates)
+    return (
+        _best_alternatives_from_cache(
+            base=base, current=current, options=options, evaluator=evaluator
+        ),
+        len(candidates),
+    )
+
+
+def coordinate_optimum(*, tape, step_index: int, base, evaluator, guard: int) -> CoordinateResult:
+    """Reference deterministic cyclic best response to a certified fixed point."""
+
+    options, _ = probe._legal_options(tape, step_index)
+    current = base
+    moves: list[dict[str, object]] = []
+    passes = 0
+    comparisons = 0
+    terminal: tuple[object, ...] = ()
+    while True:
+        passes += 1
+        pass_moves = 0
+        pass_candidates = []
+        for user in sorted(options):
+            current_profile = evaluator.evaluate(current)
+            current_value = objective(current_profile)
+            current_map = current.mapping
+            candidates = []
+            for identity in options[user]:
+                if identity == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = identity
+                candidates.append(_configuration(base, mapping, "unilateral-coordinate"))
+            evaluator.evaluate_many(candidates)
+            comparisons += len(candidates)
+            pass_candidates.extend(candidates)
+            best = current
+            best_profile = current_profile
+            best_value = current_value
+            for candidate in candidates:
+                profile = evaluator._evaluated.get(candidate.configuration_id)
+                if profile is None or served(profile) < guard:
+                    continue
+                value = objective(profile)
+                if value > best_value or (
+                    value == best_value
+                    and best is not current
+                    and candidate.configuration_id < best.configuration_id
+                ):
+                    best, best_profile, best_value = candidate, profile, value
+            if best.assignments != current.assignments:
+                before = current.mapping
+                after = best.mapping
+                origin = before[user]
+                destination = after[user]
+                occupancy = Counter(value for value in before.values() if value is not None)
+                moves.append(
+                    {
+                        "pass": passes,
+                        "user": user,
+                        "origin": origin,
+                        "destination": destination,
+                        "origin_occupancy": 0 if origin is None else occupancy[origin],
+                        "destination_occupancy_before": (
+                            0 if destination is None else occupancy[destination]
+                        ),
+                        "transition_type": (
+                            "null-to-beam"
+                            if origin is None
+                            else "beam-to-null"
+                            if destination is None
+                            else "same-satellite-beam-change"
+                            if origin[0] == destination[0]
+                            else "satellite-change"
+                        ),
+                        "selection_objective_gain_bits": float(best_value - current_value),
+                        "catalogue_exactly_expressible": False,
+                        "catalogue_exclusion": "catalogue rejects every <2-user change",
+                    }
+                )
+                current = best
+                pass_moves += 1
+        if pass_moves == 0:
+            terminal = tuple(pass_candidates)
+            break
+
+    # Identical to the reference: terminal alternatives are already evaluated
+    # by the no-move certificate and are ranked without applying the guard.
+    best_alternatives = _best_alternatives_from_cache(
+        base=base, current=current, options=options, evaluator=evaluator
+    )
+    return CoordinateResult(
+        current,
+        tuple(moves),
+        passes,
+        terminal,
+        best_alternatives,
+        comparisons,
+    )
+
+
+def _interference_contributors(*, tape, step_index: int, current, victim: int):
+    """Reference nominal physical-interference ordering."""
+
+    mapping = current.mapping
+    victim_beam = mapping[victim]
+    if victim_beam is None:
+        return ()
+    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
+    step = tape.steps[step_index]
+    scores = []
+    if step.arrays is not None:
+        arrays = step.arrays
+        victim_row = arrays._row_index().get((victim, victim_beam))
+        aggressor_of = arrays._aggressor_index()
+        if victim_row is None:
+            return ()
+        for user, beam in sorted(mapping.items()):
+            if user == victim or beam is None or beam == victim_beam:
+                continue
+            aggressor_index = aggressor_of.get(beam)
+            if aggressor_index is None:
+                continue
+            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
+            score = gain / occupancy[beam]
+            if score > 0.0:
+                scores.append((score, user))
+    else:
+        boundary = step.boundary_at(0)
+        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
+        victim_row = by_key.get((victim, victim_beam))
+        if victim_row is None:
+            return ()
+        cross = dict(victim_row.nominal_cross_gain_by_identity)
+        for user, beam in sorted(mapping.items()):
+            if user == victim or beam is None or beam == victim_beam:
+                continue
+            score = cross.get(beam, 0.0) / occupancy[beam]
+            if score > 0.0:
+                scores.append((score, user))
+    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))
+
+
+def build_joint_candidates(*, tape, step_index: int, base, seed, best_alternatives):
+    """Reference catalogue rules and caps, parameterised only by its seed."""
+
+    options, _ = probe._legal_options(tape, step_index)
+    current_map = seed.mapping
+    by_beam = {
+        beam: tuple(
+            user for user, identity in sorted(current_map.items()) if identity == beam
+        )
+        for beam in sorted({row for row in current_map.values() if row is not None})
+    }
+    aliases: dict[tuple, list[dict[str, object]]] = {}
+    configs: dict[tuple, object] = {}
+    family_rows = Counter()
+
+    def add(mapping, *, family: str, coalition: Sequence[int], detail: str) -> None:
+        changed = tuple(
+            user for user in sorted(current_map) if mapping[user] != current_map[user]
+        )
+        if len(changed) < 2:
+            return
+        assignments = tuple(sorted(mapping.items()))
+        aliases.setdefault(assignments, []).append(
+            {
+                "family": family,
+                "coalition_users": list(sorted(coalition)),
+                "changed_users": list(changed),
+                "detail": detail,
+            }
+        )
+        if assignments not in configs:
+            configs[assignments] = _configuration(base, mapping, family)
+            family_rows[family] += 1
+
+    occupant_rows = 0
+    for beam, occupants in by_beam.items():
+        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
+            for coalition in itertools.combinations(occupants, size):
+                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
+                    break
+                if any(user not in best_alternatives for user in coalition):
+                    continue
+                mapping = dict(current_map)
+                for user in coalition:
+                    mapping[user] = best_alternatives[user]
+                add(
+                    mapping,
+                    family="beam-occupant-subset",
+                    coalition=coalition,
+                    detail=f"origin={beam[0]}:{beam[1]};size={size}",
+                )
+                occupant_rows += 1
+            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
+                break
+        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
+            break
+
+    for victim in sorted(current_map):
+        if victim not in best_alternatives:
+            continue
+        contributors = _interference_contributors(
+            tape=tape, step_index=step_index, current=seed, victim=victim
+        )
+        for count in (2, 3):
+            if len(contributors) < count:
+                continue
+            coalition = (victim, *contributors[:count])
+            if any(user not in best_alternatives for user in coalition):
+                continue
+            mapping = dict(current_map)
+            for user in coalition:
+                mapping[user] = best_alternatives[user]
+            add(
+                mapping,
+                family=f"victim-plus-top-{count}-contributors",
+                coalition=coalition,
+                detail=f"victim={victim};contributors={','.join(map(str, contributors[:count]))}",
+            )
+
+    for beam, occupants in by_beam.items():
+        if len(occupants) < 2:
+            continue
+        common = set(options[occupants[0]])
+        for user in occupants[1:]:
+            common.intersection_update(options[user])
+        common.discard(beam)
+        for destination in sorted(common):
+            mapping = dict(current_map)
+            for user in occupants:
+                mapping[user] = destination
+            add(
+                mapping,
+                family="complete-beam-evacuation",
+                coalition=occupants,
+                detail=(
+                    f"origin={beam[0]}:{beam[1]};"
+                    f"destination={destination[0]}:{destination[1]}"
+                ),
+            )
+
+    ordered = tuple(configs[key] for key in sorted(configs))
+    if len(ordered) > JOINT_CANDIDATE_CAP:
+        raise RuntimeError(
+            f"mechanism catalogue exceeds fixed bound: {len(ordered)} > {JOINT_CANDIDATE_CAP}"
+        )
+    return (
+        ordered,
+        {key: tuple(value) for key, value in aliases.items()},
+        dict(sorted(family_rows.items())),
+        occupant_rows,
+    )
+
+
+def rank_catalogue(*, fallback, candidates, evaluator, guard: int):
+    fallback_profile = evaluator.evaluate(fallback)
+    best, best_profile = fallback, fallback_profile
+    for candidate in candidates:
+        profile = evaluator._evaluated.get(candidate.configuration_id)
+        if profile is None or served(profile) < guard:
+            continue
+        value = objective(profile)
+        best_value = objective(best_profile)
+        if value > best_value or (
+            value == best_value
+            and best is not fallback
+            and candidate.configuration_id < best.configuration_id
+        ):
+            best, best_profile = candidate, profile
+    return best, best_profile
+
+
+def arm_cost(evaluator, started: float) -> dict[str, object]:
+    return {
+        "unique_selection_configuration_evaluations": evaluator.physical_evaluations,
+        "selection_wall_seconds": time.perf_counter() - started,
+    }
+
+
+def evaluate_anchor(*, tape, world_index: int, step_index: int, pool) -> dict[str, object]:
+    setting = probe._setting("a-r0")
+    run_setting = probe.run_setting_for("a-r0")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+
+    # A0/A1/A2 are nested, so phase snapshots give their independent prefix costs
+    # without redundantly recomputing the same configurations.
+    from_uni = ParallelSelectionEvaluator(tape, step_index, base, pool)
+    uni_started = time.perf_counter()
+    base_selection = from_uni.evaluate(base)
+    guard = served(base_selection)
+    costs = {"BASELINE": arm_cost(from_uni, uni_started)}
+    coordinate = coordinate_optimum(
+        tape=tape,
+        step_index=step_index,
+        base=base,
+        evaluator=from_uni,
+        guard=guard,
+    )
+    unilateral = coordinate.selected
+    costs["UNILATERAL"] = arm_cost(from_uni, uni_started)
+    uni_candidates, uni_aliases, uni_families, uni_occupant_rows = build_joint_candidates(
+        tape=tape,
+        step_index=step_index,
+        base=base,
+        seed=unilateral,
+        best_alternatives=coordinate.best_alternatives,
+    )
+    from_uni.evaluate_many(uni_candidates)
+    oracle_uni, _ = rank_catalogue(
+        fallback=unilateral,
+        candidates=uni_candidates,
+        evaluator=from_uni,
+        guard=guard,
+    )
+    costs["ORACLE_FROM_UNI"] = arm_cost(from_uni, uni_started)
+
+    # A3 is exactly A4 round one.  One cache makes the A3 cost the first-round
+    # cumulative snapshot and the A4 cost the termination snapshot.
+    from_base = ParallelSelectionEvaluator(tape, step_index, base, pool)
+    base_started = time.perf_counter()
+    current = base
+    rounds = []
+    trajectory = []
+    base_first_candidates = ()
+    base_first_aliases = {}
+    base_first_alternatives = {}
+    terminated = False
+    for round_index in range(1, A4_ITERATION_CAP + 1):
+        before_value = objective(from_base.evaluate(current))
+        best_alternatives, alternate_comparisons = scan_best_alternatives(
+            tape=tape,
+            step_index=step_index,
+            base=base,
+            current=current,
+            evaluator=from_base,
+        )
+        candidates, aliases, families, occupant_rows = build_joint_candidates(
+            tape=tape,
+            step_index=step_index,
+            base=base,
+            seed=current,
+            best_alternatives=best_alternatives,
+        )
+        from_base.evaluate_many(candidates)
+        selected, selected_profile = rank_catalogue(
+            fallback=current,
+            candidates=candidates,
+            evaluator=from_base,
+            guard=guard,
+        )
+        improved = objective(selected_profile) > before_value
+        round_row = {
+            "round": round_index,
+            "seed_configuration_id": current.configuration_id,
+            "selected_configuration_id": selected.configuration_id,
+            "strict_improvement": improved,
+            "selection_objective_gain_bits": float(objective(selected_profile) - before_value),
+            "alternate_candidate_comparisons": alternate_comparisons,
+            "catalogue_unique": len(candidates),
+            "catalogue_aliases": sum(len(value) for value in aliases.values()),
+            "catalogue_family_unique_counts": families,
+            "occupant_subset_generation_rows": occupant_rows,
+            "cumulative_unique_selection_configuration_evaluations": from_base.physical_evaluations,
+            "cumulative_selection_wall_seconds": time.perf_counter() - base_started,
+        }
+        rounds.append(round_row)
+        trajectory.append(selected)
+        if round_index == 1:
+            oracle_base = selected
+            costs["ORACLE_FROM_BASE"] = {
+                "unique_selection_configuration_evaluations": from_base.physical_evaluations,
+                "selection_wall_seconds": round_row["cumulative_selection_wall_seconds"],
+            }
+            base_first_candidates = candidates
+            base_first_aliases = aliases
+            base_first_alternatives = dict(best_alternatives)
+        if not improved:
+            terminated = True
+            current = selected
+            break
+        current = selected
+    oracle_base_iterated = current
+    costs["ORACLE_FROM_BASE_ITERATED"] = arm_cost(from_base, base_started)
+    if not terminated:
+        costs["ORACLE_FROM_BASE_ITERATED"]["termination"] = "ITERATION_CAP_REACHED"
+
+    arm_configs = {
+        "BASELINE": base,
+        "UNILATERAL": unilateral,
+        "ORACLE_FROM_UNI": oracle_uni,
+        "ORACLE_FROM_BASE": oracle_base,
+        "ORACLE_FROM_BASE_ITERATED": oracle_base_iterated,
+    }
+    committed_counter = probe.EvaluationCounter()
+    committed = probe.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        field="realised",
+        counter=committed_counter,
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    unique_configs = {
+        config.configuration_id: config
+        for config in (*arm_configs.values(), *trajectory)
+    }
+    committed.evaluate_many(tuple(unique_configs.values()))
+    committed_profiles = {
+        name: committed.evaluate(config) for name, config in arm_configs.items()
+    }
+
+    for name, profile in committed_profiles.items():
+        costs[name]["committed_unique_configuration_evaluations_excluded_from_selector_cost"] = 1
+        costs[name]["guard_reference_count"] = guard
+
+    # Earliest A4 round whose committed EE reaches the same anchor's A1 EE.
+    a1_ee = ratio(committed_profiles["UNILATERAL"].bits, committed_profiles["UNILATERAL"].joules)
+    matched = None
+    if ratio(committed.evaluate(base).bits, committed.evaluate(base).joules) >= a1_ee:
+        matched = {"round": 0, "unique_evaluations": 1, "wall_seconds": 0.0}
+    else:
+        for round_row, config in zip(rounds, trajectory, strict=True):
+            profile = committed.evaluate(config)
+            if ratio(profile.bits, profile.joules) >= a1_ee:
+                matched = {
+                    "round": round_row["round"],
+                    "unique_evaluations": round_row[
+                        "cumulative_unique_selection_configuration_evaluations"
+                    ],
+                    "wall_seconds": round_row["cumulative_selection_wall_seconds"],
+                }
+                break
+
+    # Quantify the catalogue's one-shot destination staleness and whether the
+    # complete A1 endpoint was present in A3's initial candidate set.
+    base_alt_matches = 0
+    for move in coordinate.moves:
+        destination = move["destination"]
+        if base_first_alternatives.get(int(move["user"])) == destination:
+            base_alt_matches += 1
+    endpoint_changed = tuple(
+        user
+        for user in sorted(base.mapping)
+        if base.mapping[user] != unilateral.mapping[user]
+    )
+    endpoint_alt_matches = sum(
+        base_first_alternatives.get(user) == unilateral.mapping[user]
+        for user in endpoint_changed
+    )
+    endpoint_aliases = base_first_aliases.get(unilateral.assignments, ())
+
+    metrics = {}
+    for name, profile in committed_profiles.items():
+        metrics[name] = {
+            "configuration_id": profile.config.configuration_id,
+            "assignments": list(profile.config.assignments),
+            "bits": profile.bits,
+            "joules": profile.joules,
+            "ee_bit_per_j": ratio(profile.bits, profile.joules),
+            "served_count": served(profile),
+            "rate_target_attained_count": attained(profile),
+            **costs[name],
+        }
+
+    return {
+        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
+        "world_index": world_index,
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "guard": {
+            "definition": "selection-time served count >= BASELINE served count",
+            "reference_arm": "BASELINE",
+            "reference_count": guard,
+            "same_reference_for_all_arms_and_all_A4_rounds": True,
+        },
+        "arms": metrics,
+        "unilateral_search": {
+            "passes_to_certificate": coordinate.passes,
+            "improving_moves": len(coordinate.moves),
+            "candidate_comparisons": coordinate.candidate_comparisons,
+            "moves": list(coordinate.moves),
+        },
+        "a2_catalogue": {
+            "unique": len(uni_candidates),
+            "aliases": sum(len(value) for value in uni_aliases.values()),
+            "family_unique_counts": uni_families,
+            "occupant_subset_generation_rows": uni_occupant_rows,
+        },
+        "a3_catalogue": {
+            "unique": len(base_first_candidates),
+            "aliases": sum(len(value) for value in base_first_aliases.values()),
+            "unilateral_endpoint_present": bool(endpoint_aliases),
+            "unilateral_endpoint_aliases": list(endpoint_aliases),
+        },
+        "unilateral_vs_base_catalogue": {
+            "moves_whose_destination_matches_base_scan": base_alt_matches,
+            "total_moves": len(coordinate.moves),
+            "endpoint_changed_users": len(endpoint_changed),
+            "endpoint_destinations_matching_base_scan": endpoint_alt_matches,
+        },
+        "a4": {
+            "declared_iteration_cap": A4_ITERATION_CAP,
+            "terminated_by_no_improvement": terminated,
+            "rounds_to_termination": len(rounds) if terminated else None,
+            "improving_rounds": sum(bool(row["strict_improvement"]) for row in rounds),
+            "rounds": rounds,
+            "first_round_reaching_unilateral_committed_ee": matched,
+        },
+        "committed_unique_configurations_including_a4_trajectory": len(unique_configs),
+        "committed_physical_boundary_evaluations": committed_counter.boundary_evaluations,
+    }
+
+
+def _distribution(values: Sequence[float]) -> dict[str, float]:
+    return {
+        "minimum": min(values),
+        "mean": statistics.fmean(values),
+        "median": statistics.median(values),
+        "maximum": max(values),
+    }
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    pooled = {}
+    for name in ARMS:
+        bits = math.fsum(float(row["arms"][name]["bits"]) for row in anchors)  # type: ignore[index]
+        joules = math.fsum(float(row["arms"][name]["joules"]) for row in anchors)  # type: ignore[index]
+        ee = ratio(bits, joules)
+        pooled[name] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ee,
+            "relative_gap_to_UNILATERAL": None,
+            "relative_gap_to_BASELINE": None,
+            "served_count_sum": sum(int(row["arms"][name]["served_count"]) for row in anchors),  # type: ignore[index]
+            "rate_target_attained_count_sum": sum(int(row["arms"][name]["rate_target_attained_count"]) for row in anchors),  # type: ignore[index]
+            "anchors_worse_than_UNILATERAL_by_committed_ee": sum(
+                float(row["arms"][name]["ee_bit_per_j"])  # type: ignore[index]
+                < float(row["arms"]["UNILATERAL"]["ee_bit_per_j"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "unique_selection_configuration_evaluations_per_anchor": _distribution(
+                [float(row["arms"][name]["unique_selection_configuration_evaluations"]) for row in anchors]  # type: ignore[index]
+            ),
+            "selection_wall_seconds_per_anchor": _distribution(
+                [float(row["arms"][name]["selection_wall_seconds"]) for row in anchors]  # type: ignore[index]
+            ),
+        }
+    for name in ARMS:
+        pooled[name]["relative_gap_to_UNILATERAL"] = relative(
+            pooled[name]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        )
+        pooled[name]["relative_gap_to_BASELINE"] = relative(
+            pooled[name]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        )
+
+    moves = [move for row in anchors for move in row["unilateral_search"]["moves"]]  # type: ignore[index]
+    transition_counts = Counter(str(move["transition_type"]) for move in moves)
+    origin_counts = Counter(
+        "4+" if int(move["origin_occupancy"]) >= 4 else str(move["origin_occupancy"])
+        for move in moves
+    )
+    destination_counts = Counter(
+        "empty" if int(move["destination_occupancy_before"]) == 0 else "occupied"
+        for move in moves
+    )
+    matches = [
+        row["a4"]["first_round_reaching_unilateral_committed_ee"]  # type: ignore[index]
+        for row in anchors
+    ]
+    matched_rows = [row for row in matches if row is not None]
+    matched_quality = {
+        "anchors_reaching_or_exceeding_A1_committed_ee": len(matched_rows),
+        "anchors_total": len(anchors),
+    }
+    if matched_rows:
+        matched_quality.update(
+            {
+                "a4_first_match_unique_evaluations": _distribution(
+                    [float(row["unique_evaluations"]) for row in matched_rows]
+                ),
+                "a4_first_match_wall_seconds": _distribution(
+                    [float(row["wall_seconds"]) for row in matched_rows]
+                ),
+            }
+        )
+
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({str(row["world_domain"]) for row in anchors}),
+        "pooled": pooled,
+        "a4_termination": {
+            "terminated_anchors": sum(bool(row["a4"]["terminated_by_no_improvement"]) for row in anchors),  # type: ignore[index]
+            "rounds_to_termination": [row["a4"]["rounds_to_termination"] for row in anchors],  # type: ignore[index]
+            "improving_rounds": [row["a4"]["improving_rounds"] for row in anchors],  # type: ignore[index]
+        },
+        "unilateral_move_expressibility": {
+            "total_improving_single_user_moves": len(moves),
+            "exactly_expressible_by_catalogue": sum(bool(move["catalogue_exactly_expressible"]) for move in moves),
+            "excluded_because_catalogue_requires_at_least_two_changed_users": len(moves),
+            "transition_type_counts": dict(sorted(transition_counts.items())),
+            "origin_occupancy_counts": dict(sorted(origin_counts.items())),
+            "destination_occupancy_before_counts": dict(sorted(destination_counts.items())),
+            "move_destinations_matching_one_shot_base_alternate": sum(
+                int(row["unilateral_vs_base_catalogue"]["moves_whose_destination_matches_base_scan"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "endpoint_changed_users": sum(
+                int(row["unilateral_vs_base_catalogue"]["endpoint_changed_users"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "endpoint_destinations_matching_one_shot_base_alternate": sum(
+                int(row["unilateral_vs_base_catalogue"]["endpoint_destinations_matching_base_scan"])  # type: ignore[index]
+                for row in anchors
+            ),
+            "anchors_with_A1_endpoint_present_in_initial_A3_catalogue": sum(
+                bool(row["a3_catalogue"]["unilateral_endpoint_present"]) for row in anchors  # type: ignore[index]
+            ),
+        },
+        "matched_quality": matched_quality,
+    }
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(["git", *args], cwd=REPO, text=True).strip()
+
+
+def run(*, worlds: int, anchors_per_world: int, provisioning_rule: str, output: Path, synthetic: bool):
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested panel exceeds declared 2-world x 4-anchor panel")
+    if provisioning_rule not in {"sealed", "margin"}:
+        raise RuntimeError("provisioning rule must be sealed or margin")
+    margin_module = _load_module("prefix_ablation_margin_batch", MARGIN_PATH)
+    sealed_batch = __import__("mcrl.physics_v025.batch", fromlist=["evaluate_ar_tdm_catalogue"])
+    probe.evaluate_ar_tdm_catalogue = (
+        margin_module.evaluate_ar_tdm_catalogue
+        if provisioning_rule == "margin"
+        else sealed_batch.evaluate_ar_tdm_catalogue
+    )
+    started = time.perf_counter()
+    anchors = []
+    worlds_out = []
+    for world_index in range(1, worlds + 1):
+        domain = (
+            probe.SYNTHETIC_WORLD_DOMAINS[world_index - 1]
+            if synthetic
+            else probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        )
+        provider = probe.TinySyntheticProvider(users=3) if synthetic else real_factory()
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=provider,
+            steps=anchors_per_world,
+            start_time_s=0.0,
+        )
+        worlds_out.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        global _WORKER_TAPE
+        _WORKER_TAPE = tape
+        pool = None
+        if not synthetic:
+            if "fork" not in mp.get_all_start_methods():
+                raise RuntimeError("parallel selector requires POSIX fork")
+            pool = mp.get_context("fork").Pool(SELECTION_WORKERS)
+        try:
+            for step_index in range(anchors_per_world):
+                row = evaluate_anchor(
+                    tape=tape,
+                    world_index=world_index,
+                    step_index=step_index,
+                    pool=pool,
+                )
