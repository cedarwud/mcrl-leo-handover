    70	                    math.log1p(true_relative_gain[contrast_index])
    71	                    + date_effect[contrast_index, date_index]
    72	                    + seed_effect[contrast_index, seed_index]
    73	                )
    74	                drop_ee = 100.0 / math.exp(log_effect)
    75	                arms[arm] = AdditiveTotals(bits=drop_ee * energy, **common)
    76	            # Non-primary policies are present so these clusters can also be
    77	            # fed to report inventory paths without changing primary inference.
    78	            for arm in (*ARM_ORDER[4:], "S0", "S_UNI"):
    79	                arms[arm] = AdditiveTotals(bits=98.0 * energy, **common)
    80	            clusters[(date, 1000 + seed_index)] = arms
    81	    return clusters
    82	
    83	
    84	def crossed_inference_calibration(
    85	    *,
    86	    repetitions: int = 200,
    87	    bootstrap_draws: int = 99,
    88	    rng_seed: int = 20260908,
    89	) -> dict[str, object]:
    90	    """T3 Monte Carlo calibration from raw EvaluationRunner receipts."""
    91	
    92	    if repetitions < 200:
    93	        raise ValueError("T3 calibration requires at least 200 Monte Carlo replications")
    94	
    95	    rng = np.random.default_rng(rng_seed)
    96	    scenarios: dict[str, object] = {}
    97	    total_raw_receipts = 0
    98	    total_raw_steps = 0
    99	    for date_sd in (0.05, 0.03):
   100	        scenario_name = f"date_sd_{date_sd:.2f}_seed_sd_0.01"
   101	        scenarios[scenario_name] = {}
   102	        for seed_count in (5, 12, 16, 24):
   103	            conjunction_successes = 0
   104	            covered = 0
   105	            for repetition in range(repetitions):
   106	                date_effect = rng.normal(0.0, date_sd, (3, 160))
   107	                seed_effect = rng.normal(0.0, 0.01, (3, seed_count))
   108	                receipts: list[dict[str, object]] = []
   109	                for date_index in range(160):
   110	                    for seed_index in range(seed_count):
   111	                        for world in (0, 1):
   112	                            energy = (0.75, 1.25)[world] * (
   113	                                1.0 + 0.05 * ((date_index + seed_index) % 3)
   114	                            )
   115	                            endpoints = {"FULL": (100.0 * energy, energy)}
   116	                            for contrast_index, arm in enumerate(DROP_ARMS):
   117	                                log_effect = (
   118	                                    math.log1p(0.02)
   119	                                    + date_effect[contrast_index, date_index]
   120	                                    + seed_effect[contrast_index, seed_index]
   121	                                )
   122	                                endpoints[arm] = (
   123	                                    100.0 * energy / math.exp(log_effect),
   124	                                    energy,
   125	                                )
   126	                            receipts.append(
   127	                                EvaluationRunner.build_calibration_receipt(
   128	                                    tle_date=f"D{date_index:03d}",
   129	                                    learner_seed=1000 + seed_index,
   130	                                    world_id=(
   131	                                        f"{scenario_name}/r{repetition}/d{date_index}/"
   132	                                        f"s{seed_index}/w{world}"
   133	                                    ),
   134	                                    arm_endpoints=endpoints,
   135	                                )
   136	                            )
   137	                merged = merge_receipts(
   138	                    receipts,
   139	                    bootstrap_draws=bootstrap_draws,
   140	                    bootstrap_seed=(
   141	                        rng_seed
   142	                        + int(date_sd * 1000) * 1_000_000
   143	                        + seed_count * 10_000
   144	                        + repetition
   145	                    ),
   146	                )
   147	                total_raw_receipts += int(merged["raw_receipt_count"])
   148	                total_raw_steps += int(merged["raw_step_count"])
   149	                contrasts = merged["contrasts"]
   150	                claim = merged["claim"]
   151	                passed = tuple(
   152	                    bool(claim["per_contrast"][arm]) for arm in DROP_ARMS
   153	                )
   154	                conjunction_successes += int(all(passed))
   155	                for arm in DROP_ARMS:
   156	                    interval = contrasts[arm]["bootstrap"][
   157	                        "central_95_percentile_intervals"
   158	                    ]["ee_relative"]
   159	                    covered += int(
   160	                        interval is not None and interval[0] <= 0.02 <= interval[1]
   161	                    )
   162	            scenarios[scenario_name][str(seed_count)] = {
   163	                "interval_coverage": _binomial_uncertainty(covered, repetitions * 3),
   164	                "conjunction_power": _binomial_uncertainty(
   165	                    conjunction_successes, repetitions
   166	                ),
   167	            }
   168	
   169	    return {
   170	        "schema": "mcrl-v025-stagec-t3-calibration-v2",
   171	        "repetitions": repetitions,
   172	        "bootstrap_draws": bootstrap_draws,
   173	        "date_count": 160,
   174	        "seed_sd": 0.01,
   175	        "planning_alternative_relative": 0.02,
   176	        "claim_margin_relative": 0.005,
   177	        "scenarios": scenarios,
   178	        "seed_counts": [5, 12, 16, 24],
   179	        "raw_path": {
   180	            "emitter": "EvaluationRunner.build_calibration_receipt",
   181	            "validator_and_merger": "merge_receipts",
   182	            "reaggregation": "reaggregate_steps",
   183	            "raw_receipts_processed": total_raw_receipts,
   184	            "raw_steps_processed": total_raw_steps,
   185	        },
   186	        "simulation_uncertainty": (
   187	            "Binomial Monte Carlo uncertainty is reported as an approximate normal 95% half-width; "
   188	            "bootstrap Monte Carlo error is additionally limited by the declared draw count."
   189	        ),
   190	    }
