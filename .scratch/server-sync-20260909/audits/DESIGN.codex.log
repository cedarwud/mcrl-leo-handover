    15	def _binomial_uncertainty(successes: int, trials: int) -> dict[str, float | int]:
    16	    rate = successes / trials
    17	    half_width = 1.96 * math.sqrt(max(rate * (1.0 - rate), 0.25 / trials) / trials)
    18	    return {
    19	        "successes": successes,
    20	        "trials": trials,
    21	        "estimate": rate,
    22	        "normal_95_half_width": half_width,
    23	    }
