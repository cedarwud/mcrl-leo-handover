        evaluator=evaluator,
        calibration=context["calibration"],  # type: ignore[arg-type]
        cell_rekeyed_users=context["cell_rekeys"],  # type: ignore[arg-type]
    )
    return (
        tuple(evaluator._evaluated.values()),
        decomposition,
        singletons,
        base_decomposition,
        counter.boundary_evaluations,
    )


