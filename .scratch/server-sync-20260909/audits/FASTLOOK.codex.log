def _git(*args: str) -> str:
    return subprocess.check_output(
        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
    ).strip()


def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
    selectors = ("BASELINE", "UNILATERAL", "ORACLE_SET")
    pooled = {}
    for name in selectors:
        bits = math.fsum(float(row["committed"][name]["bits"]) for row in anchors)  # type: ignore[index]
        joules = math.fsum(float(row["committed"][name]["joules"]) for row in anchors)  # type: ignore[index]
        pooled[name] = {
            "bits": bits,
            "joules": joules,
            "ee_bit_per_j": ratio(bits, joules),
            "served_count_sum": sum(
                int(row["committed"][name]["served_count"]) for row in anchors  # type: ignore[index]
            ),
        }
    return {
        "anchor_count": len(anchors),
        "world_count": len({str(row["world_domain"]) for row in anchors}),
        "qualifying_coalition_anchor_count": sum(
            bool(row["selection"]["qualifying_coalition_existed"]) for row in anchors  # type: ignore[index]
        ),
        "pooled": pooled,
        "oracle_set_over_unilateral_relative": relative_gain(
            pooled["ORACLE_SET"]["ee_bit_per_j"],
            pooled["UNILATERAL"]["ee_bit_per_j"],
        ),
        "unilateral_over_baseline_relative": relative_gain(
            pooled["UNILATERAL"]["ee_bit_per_j"],
            pooled["BASELINE"]["ee_bit_per_j"],
        ),
        "exact_evaluation_count": {
            "unique_selection_configurations": sum(
                int(row["selection"]["unique_selection_configuration_evaluations"])  # type: ignore[index]
                for row in anchors
            ),
            "selection_boundary_evaluations": sum(
                int(row["selection"]["selection_physical_boundary_evaluations"])  # type: ignore[index]
                for row in anchors
            ),
            "committed_unique_configurations": sum(
                int(row["committed_unique_configuration_evaluations"])
                for row in anchors
            ),
            "committed_boundary_evaluations": sum(
                int(row["committed_physical_boundary_evaluations"])
                for row in anchors
            ),
            "unilateral_candidate_comparisons": sum(
                int(row["selection"]["unilateral_candidate_comparisons"])  # type: ignore[index]
                for row in anchors
            ),
            "joint_unique_candidates": sum(
                int(row["selection"]["joint_catalogue_unique"])  # type: ignore[index]
                for row in anchors
            ),
        },
    }


def _cpu_seconds() -> float:
    own = resource.getrusage(resource.RUSAGE_SELF)
    children = resource.getrusage(resource.RUSAGE_CHILDREN)
    return own.ru_utime + own.ru_stime + children.ru_utime + children.ru_stime


def _date_start(date_text: str, domain: str, anchors: int) -> dt.datetime:
    """Choose a deterministic 30.08-s-aligned epoch inside the named UTC day."""

    date = dt.date.fromisoformat(date_text)
    episode_s = (anchors + 3) * 30.08
    slot_count = int((86_400.0 - episode_s) // 30.08) + 1
    slot = probe.seed_from_domain(domain + "/epoch-slot") % slot_count
    return dt.datetime.combine(date, dt.time(), tzinfo=dt.timezone.utc) + dt.timedelta(
        seconds=slot * 30.08
    )


def _panel_for(date_text: str) -> str:
    if date_text in FULL_SPAN_DATES:
        return "FULL_SPAN"
    if date_text in SINGLE_MONTH_DATES:
        return "SINGLE_MONTH_2026_01"
    raise RuntimeError(f"date is outside the frozen 30-date plan: {date_text}")


def run_date(*, date_text: str, anchors_per_date: int, tape_root: Path) -> dict[str, object]:
    from mcrl.env.ephemeris import BlockAlternatingSplit, TRAIN
    from mcrl.env.tle import TleArchive
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    import mcrl.physics_v025.tapes as tape_module

    if date_text not in DATE_PLAN:
        raise RuntimeError(f"date is outside the frozen 30-date plan: {date_text}")
    if not 1 <= anchors_per_date <= 30:
        raise RuntimeError("anchors per date must be in 1..30")
    tle_root = Path("~/demo/tle_data/starlink/tle").expanduser()
    archive = TleArchive(tle_root)
    date = dt.date.fromisoformat(date_text)
    split = BlockAlternatingSplit.for_archive(archive)
    if not archive.has(date) or split.part_for(date) != TRAIN:
        raise RuntimeError(f"planned date is not an available TRAIN date: {date_text}")

    domain = f"V025_CEILING30/date/{date_text}"
    # The authority's tape builder fails closed to declared domain names.  Add
    # only this diagnostic identity in memory; no source or physics is changed.
    tape_module.PROBE_WORLD_DOMAINS = tuple(tape_module.PROBE_WORLD_DOMAINS) + (domain,)
    start_utc = _date_start(date_text, domain, anchors_per_date)
    provider = LegacyWorldProvider(start_utc=start_utc, steps=anchors_per_date)
    started = time.perf_counter()
    cpu_started = _cpu_seconds()
    build_started = time.perf_counter()
    tape = probe.build_world_tape(
        domain=domain,
        provider=provider,
        steps=anchors_per_date,
        start_time_s=0.0,
    )
    build_wall = time.perf_counter() - build_started

    tape_path = tape_root / f"mcrl-v025-ceiling30-{date_text}.pickle"
    # This managed workspace exposes /home/sat/bigtmp read-only (EROFS).  Keep
    # the detached tape only in RAM, one date at a time, and never serialize it
    # to the RAM-backed /tmp fallback.  The finally block releases the tape
    # before the next date process starts.
