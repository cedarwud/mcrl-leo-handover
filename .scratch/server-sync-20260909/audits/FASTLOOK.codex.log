from __future__ import annotations

import inspect
from pathlib import Path
from typing import Callable

from mcrl.physics_v025 import batch as sealed_batch


ORIGINAL_LINE = "targets = gamma[np.minimum(occupancy, users)]"
MARGIN_Q_LINE = "targets = gamma[np.minimum(occupancy, users)] / quantile"
REFERENCE_PATH = Path(
    "/home/sat/mcrl-v025-ladder-ws/.scratch/ladder-floor-20260910/margin_batch.py"
)


def build_evaluator(formulation: str) -> Callable:
    """Compile an isolated evaluator copy after one checked source edit."""

    if formulation not in {"divisor-one", "margin-q"}:
        raise ValueError(f"unknown formulation: {formulation}")
    source = inspect.getsource(sealed_batch._evaluate_ar_tdm_catalogue_core)
    if source.count(ORIGINAL_LINE) != 1:
        raise RuntimeError("sealed evaluator provisioning seam changed")
    replacement = ORIGINAL_LINE if formulation == "divisor-one" else MARGIN_Q_LINE
    copied_source = source.replace(ORIGINAL_LINE, replacement)
    namespace = dict(vars(sealed_batch))
    filename = f"<diagnostic-{formulation}-batch-copy>"
    exec(compile(copied_source, filename, "exec"), namespace)
    return namespace["_evaluate_ar_tdm_catalogue_core"]


evaluate_ar_tdm_catalogue = build_evaluator("margin-q")


__all__ = ["build_evaluator", "evaluate_ar_tdm_catalogue"]
#!/usr/bin/env python3
"""Run one frozen CEILING30 date with the private MARGIN_Q evaluator copy."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import math
from pathlib import Path
import sys
from typing import Mapping, Sequence


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
SEALED_RUNNER_PATH = REPO / ".scratch/oracle-ceiling30/run_oracle_ceiling30.py"
SEALED_RESULTS = REPO / ".scratch/oracle-ceiling30/results"
MARGIN_RESULTS = HERE / "results"
DIVISOR_ONE_RESULTS = HERE / "compat-divisor-one"


def load(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


sealed = load("ceiling30_sealed_runner", SEALED_RUNNER_PATH)
margin_batch = load("ceiling30_margin_batch_for_runner", HERE / "margin_batch.py")
from mcrl.physics_v025.batch import evaluate_ar_tdm_catalogue as original_evaluator


def configuration_from_id(base, configuration_id: str, kind: str):
    if configuration_id == base.configuration_id:
        return base
    if not configuration_id.startswith("CFG:"):
        raise RuntimeError(f"unknown configuration encoding: {configuration_id}")
    mapping = {}
    for encoded in configuration_id[4:].split(";"):
        parts = encoded.split(":")
        user = int(parts[0])
        if parts[1] == "NULL":
            identity = None
        elif len(parts) == 3:
            identity = (int(parts[1]), int(parts[2]))
        else:
            raise RuntimeError(f"malformed configuration member: {encoded}")
        mapping[user] = identity
    return sealed.probe.Configuration(
        configuration_id,
        tuple(sorted(mapping.items())),
        sum(base.mapping[user] != identity for user, identity in mapping.items()),
        kind,
    )


def profile_diagnostics(profile) -> dict[str, object]:
    attained = profile.score.rate_target_attained
    transmissions = int(profile.rf_transmission_observations)
    cap_hits = int(profile.rf_cap_hits)
    no_mode = int((profile.m_tx_counts or {}).get("NO_MODE", 0))
    return {
        "served_count": sum(bool(value) for value in profile.score.served_phy.values()),
        "rate_target_attained_count": (
            0 if attained is None else sum(bool(value) for value in attained.values())
        ),
        "transmission_boundary_attempts": transmissions,
        "rf_cap_binding_attempts": cap_hits,
        "rf_cap_binding_attempt_share": 0.0 if transmissions == 0 else cap_hits / transmissions,
        "no_eligible_mode_attempts": no_mode,
        "no_eligible_mode_attempt_share": 0.0 if transmissions == 0 else no_mode / transmissions,
        "m_target_counts": dict(sorted((profile.m_target_counts or {}).items())),
        "m_tx_counts": dict(sorted((profile.m_tx_counts or {}).items())),
    }


def evaluate_profiles(tape, step_index: int, rows: Mapping[str, Mapping[str, object]], evaluator):
    base = sealed.probe._base_configuration(tape, step_index, "nearest-eligible")
    configs = {
        name: configuration_from_id(base, str(payload["configuration_id"]), name)
        for name, payload in rows.items()
    }
    previous = sealed.probe.evaluate_ar_tdm_catalogue
    sealed.probe.evaluate_ar_tdm_catalogue = evaluator
    try:
        engine = sealed.probe.StepEvaluator(
            tape,
            sealed.probe._setting("a-r0"),
            step_index,
            transition_from=base,
            field="realised",
            run_setting=sealed.probe.run_setting_for("a-r0"),
            boundary_indices=tuple(range(48)),
            fading_quantile_alpha=0.10,
        )
        engine.evaluate_many(tuple(configs.values()))
        return {
            name: profile_diagnostics(engine.evaluate(config))
            for name, config in configs.items()
        }
    finally:
        sealed.probe.evaluate_ar_tdm_catalogue = previous


def aggregate_diagnostics(anchors: Sequence[Mapping[str, object]], key: str):
    arms = ("BASELINE", "UNILATERAL", "ORACLE_SET")
    result = {}
    for arm in arms:
        records = [row[key][arm] for row in anchors]  # type: ignore[index]
        attempts = sum(int(record["transmission_boundary_attempts"]) for record in records)
        cap_hits = sum(int(record["rf_cap_binding_attempts"]) for record in records)
        no_mode = sum(int(record["no_eligible_mode_attempts"]) for record in records)
        result[arm] = {
            "served_count_sum": sum(int(record["served_count"]) for record in records),
            "rate_target_attained_count_sum": sum(
                int(record["rate_target_attained_count"]) for record in records
            ),
            "transmission_boundary_attempts": attempts,
            "rf_cap_binding_attempts": cap_hits,
            "rf_cap_binding_attempt_share": 0.0 if attempts == 0 else cap_hits / attempts,
            "no_eligible_mode_attempts": no_mode,
            "no_eligible_mode_attempt_share": 0.0 if attempts == 0 else no_mode / attempts,
        }
    return result


def run(date_text: str, formulation: str) -> dict[str, object]:
    source_receipt = json.loads(
        (SEALED_RESULTS / f"date-{date_text}.json").read_text(encoding="ascii")
    )
    anchors = int(source_receipt["summary"]["anchor_count"])
    evaluator = margin_batch.build_evaluator(formulation)
    sealed.probe.evaluate_ar_tdm_catalogue = evaluator
    original_anchor = sealed.evaluate_anchor

    def enriched_anchor(*, tape, date_index: int, step_index: int, pool=None):
        row = original_anchor(
            tape=tape,
            date_index=date_index,
            step_index=step_index,
            pool=pool,
        )
        row["corrected_diagnostics"] = evaluate_profiles(
            tape, step_index, row["committed"], evaluator
        )
        sealed_anchor = source_receipt["anchors"][step_index]
        if (
            sealed_anchor["step_index"] != step_index
            or sealed_anchor["world_sha256"] != row["world_sha256"]
            or sealed_anchor["training_seed"] != row["training_seed"]
        ):
            raise RuntimeError("sealed comparison anchor is not the same world/seed")
        row["sealed_diagnostics"] = evaluate_profiles(
            tape, step_index, sealed_anchor["committed"], original_evaluator
        )
        return row

    sealed.evaluate_anchor = enriched_anchor
    try:
        result = sealed.run_date(
            date_text=date_text,
            anchors_per_date=anchors,
            tape_root=sealed.TAPE_ROOT,
        )
    finally:
        sealed.evaluate_anchor = original_anchor
        sealed.probe.evaluate_ar_tdm_catalogue = original_evaluator

    if (
        result["world_sha256"] != source_receipt["world_sha256"]
        or result["training_seed"] != source_receipt["training_seed"]
        or result["start_utc"] != source_receipt["start_utc"]
    ):
        raise RuntimeError("date did not reproduce the sealed world, seed, and epoch")
    if formulation == "margin-q":
        result["schema"] = "mcrl-v025-perfect-knowledge-oracle-ceiling-margin-q-date-v1"
    result["variant"] = "MARGIN_Q" if formulation == "margin-q" else "DIVISOR_ONE_COMPAT"
    result["provisioning_rule"] = (
        "Gamma / q_alpha at alpha=0.10"
        if formulation == "margin-q"
        else "Gamma / 1 (compatibility control)"
    )
    result["diagnostic_copy_only"] = True
    result["sealed_receipt_sha256_compared"] = source_receipt["receipt_sha256"]
    result["variant_runner_source_sha256"] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    result["variant_loader_source_sha256"] = hashlib.sha256(
        (HERE / "margin_batch.py").read_bytes()
    ).hexdigest()
    result["reference_margin_batch_sha256"] = hashlib.sha256(
        margin_batch.REFERENCE_PATH.read_bytes()
    ).hexdigest()
    result["summary"]["corrected_diagnostics"] = aggregate_diagnostics(
        result["anchors"], "corrected_diagnostics"
    )
    result["summary"]["sealed_diagnostics"] = aggregate_diagnostics(
        result["anchors"], "sealed_diagnostics"
    )
    result.pop("receipt_sha256", None)
    unsigned = json.dumps(
        result,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode("ascii")
    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--date", required=True, choices=sealed.DATE_PLAN)
    parser.add_argument(
        "--formulation", choices=("margin-q", "divisor-one"), default="margin-q"
    )
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    output = args.output or (
        MARGIN_RESULTS if args.formulation == "margin-q" else DIVISOR_ONE_RESULTS
    )
    path = output / f"date-{args.date}.json"
    if path.exists() or path.is_symlink():
        raise RuntimeError(f"refusing to overwrite completed date receipt: {path}")
    result = run(args.date, args.formulation)
    output.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    print(json.dumps({"path": str(path), "summary": result["summary"]}, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

