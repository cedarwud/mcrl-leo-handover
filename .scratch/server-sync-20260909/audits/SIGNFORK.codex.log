+        f"C={cells['C']['pooled_demand_capped_ee_mbit_per_j']:.6f}, and "
+        f"D={cells['D']['pooled_demand_capped_ee_mbit_per_j']:.6f} Mbit/J.**"
+    )
+    scope = results["scope"]
+    coverage = results["gate_coverage"]
+    lines = [
+        first,
+        "",
+        "# Residual sign fork — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM`",
+        "",
