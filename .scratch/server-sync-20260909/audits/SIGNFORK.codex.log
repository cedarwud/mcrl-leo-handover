@@ -0,0 +1,875 @@
+#!/usr/bin/env python3
+"""DIAGNOSTIC_NOT_CLAIM: exact residual price x production-gate fork."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import json
+import math
+import multiprocessing as mp
+import os
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-witness-ws")
+REFERENCE = Path("/home/sat/mcrl-v025-coalgen-ws")
+EXECUTION_SOURCE = REFERENCE / ".scratch/epoch-trend/clean-source/src"
+PILOT_SCRIPT = REFERENCE / "scripts/run_v025_pilot_c3.py"
+PILOT_OUTPUT = REFERENCE / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+SPEC = WORKSPACE / ".scratch/sign-fork/spec.md"
+DEFAULT_RESULTS = WORKSPACE / ".scratch/sign-fork/results.json"
+DEFAULT_REPORT = WORKSPACE / "RESIDUAL-SIGN-FORK-2026-09-10.md"
+INVOKED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+EXPECTED_PYTHON = INVOKED_PYTHON.resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS",
+    "OPENBLAS_NUM_THREADS",
+    "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS",
+    "VECLIB_MAXIMUM_THREADS",
+    "BLIS_NUM_THREADS",
+)
+WORLD_ID = "V025_PROBE/world/3"
+ANCHOR_COUNT = 8
+BOUNDARIES = tuple(range(48))
+DEMAND_CAP_BITS = Fraction(1_504_000_000)
+MAX_DINKELBACH = 128
+LABEL = "DIAGNOSTIC_NOT_CLAIM"
+WORKER_COUNT = 3
+_WORKER_PILOT = None
+_WORKER_CALIBRATION = None
+_WORKER_TAPE = None
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def exact(value: float) -> Fraction:
+    value = float(value)
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical value")
+    return Fraction.from_float(value)
+
+
+def pair(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def fmt(value: float, digits: int = 6) -> str:
+    return f"{value:.{digits}f}"
+
+
+def fmt_pct(value: float) -> str:
+    return f"{value:+.2%}"
+
+
+def load_pilot():
+    source = str(EXECUTION_SOURCE)
+    scripts = str(REFERENCE / "scripts")
+    if source not in sys.path:
+        sys.path.insert(0, source)
+    if scripts not in sys.path:
+        sys.path.insert(0, scripts)
+    import run_v025_pilot_c3 as pilot
+
+    payload = json.loads(
+        (PILOT_OUTPUT / "PILOT_NOT_CLAIM-calibration.json").read_text(encoding="ascii")
+    )
+    ratio = lambda name: Fraction(*payload[name])
+    calibration = pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+    return pilot, calibration
+
+
+def verify_runtime() -> None:
+    actual = Path(sys.executable).resolve()
+    if actual != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {actual}; expected {EXPECTED_PYTHON}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment is not pinned to one: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("process niceness is below required nice -n 15")
+    if not SPEC.is_file():
+        raise RuntimeError("precommitted experiment specification is missing")
+
+
+@dataclass(frozen=True)
+class CandidateTerms:
+    configuration_id: str
+    is_base: bool
+    changed_users: int
+    context_present: bool
+    served_count: int
+    attained_count: int
+    pilot_joint_n: Fraction
+    pilot_joint_e: Fraction
+    pilot_additive_n: Fraction
+    pilot_additive_e: Fraction
+    realised_joint_n: Fraction
+    realised_joint_e: Fraction
+    realised_additive_n: Fraction
+    realised_additive_e: Fraction
+
+    def objective_terms(self, price: str, residual: str) -> tuple[Fraction, Fraction]:
+        if price == "pilot":
+            joint_n, joint_e = self.pilot_joint_n, self.pilot_joint_e
+            additive_n, additive_e = self.pilot_additive_n, self.pilot_additive_e
+        elif price == "dinkelbach":
+            joint_n, joint_e = self.realised_joint_n, self.realised_joint_e
+            additive_n, additive_e = self.realised_additive_n, self.realised_additive_e
+        else:
+            raise ValueError(price)
+        if residual == "additive":
+            return additive_n, additive_e
+        if residual == "gated" and not self.context_present:
+            return additive_n, additive_e
+        if residual in ("gated", "ungated"):
+            return joint_n, joint_e
+        raise ValueError(residual)
+
+
+def evaluate_in_batches(evaluator, configs: Sequence[object]) -> None:
+    # The dense evaluator is vectorized over configurations.  One call avoids
+    # repeating its expensive shared setup for every artificial small batch.
+    evaluator.evaluate_many(configs)
+
+
+def profile_pilot(profile) -> tuple[Fraction, Fraction]:
+    return exact(profile.bits), exact(profile.joules)
+
+
+def profile_realised(profile) -> tuple[Fraction, Fraction, int, int]:
+    capped = sum(
+        (min(exact(value), DEMAND_CAP_BITS) for value in profile.score.bits.values()),
+        Fraction(),
+    )
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    attained_map = profile.score.rate_target_attained
+    if attained_map is None:
+        raise RuntimeError("realised profile omitted rate-target attainment")
+    attained = sum(bool(value) for value in attained_map.values())
+    threshold_attained = sum(exact(value) >= DEMAND_CAP_BITS for value in profile.score.bits.values())
+    if attained != threshold_attained:
+        raise RuntimeError("rate-target attainment disagrees with integrated-bit threshold")
+    return capped, exact(profile.joules), served, attained
+
+
+def singleton_configurations(pilot, anchor, catalogue: Sequence[object]):
+    by_key = {}
+    for config in catalogue:
+        mapping = config.mapping
+        for user in sorted(anchor.mapping):
+            if mapping[user] == anchor.mapping[user]:
+                continue
+            singleton_mapping = anchor.mapping
+            singleton_mapping[user] = mapping[user]
+            singleton = pilot.ENGINE._configuration(
+                anchor, singleton_mapping, kind="sign-fork-exact-singleton"
+            )
+            by_key[(user, mapping[user])] = singleton
+    return by_key
+
+
+def additive_terms(anchor, config, singleton_profiles, base_terms, profile_fn):
+    n, e = base_terms
+    mapping = config.mapping
+    for user in sorted(anchor.mapping):
+        if mapping[user] == anchor.mapping[user]:
+            continue
+        singleton = singleton_profiles[(user, mapping[user])]
+        sn, se = profile_fn(singleton)
+        n += sn - base_terms[0]
+        e += se - base_terms[1]
+    return n, e
+
+
+def build_anchor(pilot, calibration, tape, anchor_index: int, step_index: int, carrier: str):
+    started = time.perf_counter()
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    built = pilot._build_anchor_rows(
+        tape=tape,
+        setting=setting,
+        run_setting=run_setting,
+        calibration=calibration,
+        step_index=step_index,
+        carrier=carrier,
+        anchor_index=anchor_index,
+        include_coalition=False,
+        full_legal_actions=True,
+    )
+    anchor = built["base"]
+    incumbent = built["incumbent"]
+    nominal = built["current_evaluator"]
+    rows_by_user_action = built["rows_by_user_action"]
+    catalogue, census = pilot.ENGINE._catalogue_with_census(
+        tape,
+        step_index,
+        anchor,
+        setting=setting,
+        calibration=calibration,
+        run_setting=run_setting,
+    )
+    if not any(config.assignments == anchor.assignments for config in catalogue):
+        catalogue = (anchor, *catalogue)
+    catalogue = tuple({config.assignments: config for config in catalogue}.values())
+    catalogue = tuple(sorted(catalogue, key=lambda row: row.configuration_id))
+    singleton_by_key = singleton_configurations(pilot, anchor, catalogue)
+    all_configs = tuple(
+        {config.assignments: config for config in (*catalogue, *singleton_by_key.values())}.values()
+    )
+    evaluate_in_batches(nominal, all_configs)
+
+    realised = pilot.ENGINE.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=BOUNDARIES,
+    )
+    evaluate_in_batches(realised, all_configs)
+    if anchor.configuration_id in nominal._invalid or anchor.configuration_id in realised._invalid:
+        raise RuntimeError("anchor incumbent is invalid")
+
+    base_pilot = profile_pilot(nominal.evaluate(anchor))
+    base_realised = profile_realised(realised.evaluate(anchor))
+    base_served = base_realised[2]
+    nominal_legal = [row for row in catalogue if row.configuration_id not in nominal._invalid]
+    contexts = {}
+    for config in nominal_legal:
+        changed = tuple(
+            user for user in sorted(anchor.mapping)
+            if config.mapping[user] != anchor.mapping[user]
+        )
+        if len(changed) >= 2:
+            contexts[config.configuration_id] = pilot._coalition_context(
+                tape=tape,
+                step_index=step_index,
+                anchor=anchor,
+                selected=config,
+                rows_by_user_action=rows_by_user_action,
+            )
+
+    records = []
+    exclusion = Counter()
+    reconstruction_checks = 0
+    nominal_singleton_profiles = {
+        key: nominal.evaluate(value) for key, value in singleton_by_key.items()
+    }
+    realised_singleton_profiles = {
+        key: realised.evaluate(value) for key, value in singleton_by_key.items()
+    }
+    for config in catalogue:
+        if config.configuration_id in nominal._invalid:
+            exclusion["nominal_invalid"] += 1
+            continue
+        if config.configuration_id in realised._invalid:
+            exclusion["realised_invalid"] += 1
+            continue
+        changed_keys = [
+            (user, config.mapping[user])
+            for user in sorted(anchor.mapping)
+            if config.mapping[user] != anchor.mapping[user]
+        ]
+        if any(singleton_by_key[key].configuration_id in nominal._invalid for key in changed_keys):
+            exclusion["nominal_singleton_invalid"] += 1
+            continue
+        if any(singleton_by_key[key].configuration_id in realised._invalid for key in changed_keys):
+            exclusion["realised_singleton_invalid"] += 1
+            continue
+        r_profile = realised.evaluate(config)
+        r_joint_n, r_joint_e, served, attained = profile_realised(r_profile)
+        if served < base_served:
+            exclusion["served_guard"] += 1
+            continue
+        p_joint_n, p_joint_e = profile_pilot(nominal.evaluate(config))
+        p_add_n, p_add_e = additive_terms(
+            anchor,
+            config,
+            nominal_singleton_profiles,
+            base_pilot,
+            profile_pilot,
+        )
+        r_add_n, r_add_e = additive_terms(
+            anchor,
+            config,
+            realised_singleton_profiles,
+            base_realised[:2],
+            lambda profile: profile_realised(profile)[:2],
+        )
+        changed_count = len(changed_keys)
+        context_present = contexts.get(config.configuration_id) is not None
+        if changed_count >= 2 and not context_present:
+            raise RuntimeError("production joint context unexpectedly absent")
+        if changed_count < 2 and context_present:
+            raise RuntimeError("production context unexpectedly present below coalition size two")
+        row = CandidateTerms(
+            configuration_id=config.configuration_id,
+            is_base=config.assignments == anchor.assignments,
+            changed_users=changed_count,
+            context_present=context_present,
+            served_count=served,
+            attained_count=attained,
+            pilot_joint_n=p_joint_n,
+            pilot_joint_e=p_joint_e,
+            pilot_additive_n=p_add_n,
+            pilot_additive_e=p_add_e,
+            realised_joint_n=r_joint_n,
+            realised_joint_e=r_joint_e,
+            realised_additive_n=r_add_n,
+            realised_additive_e=r_add_e,
+        )
+        for price in ("pilot", "dinkelbach"):
+            if row.objective_terms(price, "ungated") != row.objective_terms(price, "gated"):
+                if row.context_present:
+                    raise RuntimeError("gated residual failed to include a present-context row")
+            joint = row.objective_terms(price, "ungated")
+            if joint != (
+                (row.pilot_joint_n, row.pilot_joint_e)
+                if price == "pilot"
+                else (row.realised_joint_n, row.realised_joint_e)
+            ):
+                raise RuntimeError("ungated residual did not reconstruct joint objective")
+            reconstruction_checks += 1
+        records.append(row)
+
+    base_rows = [row for row in records if row.is_base]
+    if len(base_rows) != 1:
+        raise RuntimeError(f"eligible catalogue must contain exactly one incumbent, got {len(base_rows)}")
+    nominal_none = len(nominal_legal) - len(contexts)
+    eligible_none = sum(not row.context_present for row in records)
+    result = {
+        "anchor_index": anchor_index,
+        "anchor_id": f"{tape.domain}|{step_index}|{carrier}",
+        "step_index": step_index,
+        "carrier": carrier,
+        "configuration_id": anchor.configuration_id,
+        "raw_catalogue_rows": len(catalogue),
+        "nominal_legal_rows": len(nominal_legal),
+        "eligible_rows": len(records),
+        "context_present_nominal_legal_rows": len(contexts),
+        "context_none_nominal_legal_rows": nominal_none,
+        "context_none_nominal_legal_fraction": nominal_none / len(nominal_legal),
+        "context_present_eligible_rows": len(records) - eligible_none,
+        "context_none_eligible_rows": eligible_none,
+        "context_none_eligible_fraction": eligible_none / len(records),
+        "exclusions": dict(sorted(exclusion.items())),
+        "catalogue_census": census,
+        "base_served_count": base_served,
+        "reconstruction_checks": reconstruction_checks,
+        "wall_s": time.perf_counter() - started,
+    }
+    return records, result
+
+
+def worker_build_anchor(task):
+    if _WORKER_PILOT is None or _WORKER_CALIBRATION is None or _WORKER_TAPE is None:
+        raise RuntimeError("fork worker globals were not initialized")
+    anchor_index, step_index, carrier = task
+    return build_anchor(
+        _WORKER_PILOT,
+        _WORKER_CALIBRATION,
+        _WORKER_TAPE,
+        anchor_index,
+        step_index,
+        carrier,
+    )
+
+
+def tie_key(row: CandidateTerms) -> tuple[int, str]:
+    return (0 if row.is_base else 1, row.configuration_id)
+
+
+def choose_at_price(rows: Sequence[CandidateTerms], price: str, residual: str, eta: Fraction):
+    scored = []
+    for row in rows:
+        n, e = row.objective_terms(price, residual)
+        scored.append((n - eta * e, row))
+    best = max(score for score, _row in scored)
+    tied = [row for score, row in scored if score == best]
+    return min(tied, key=tie_key), len(tied)
+
+
+def dinkelbach(anchors: Sequence[Sequence[CandidateTerms]], residual: str):
+    bases = [next(row for row in rows if row.is_base) for rows in anchors]
+    eta = sum((row.realised_joint_n for row in bases), Fraction()) / sum(
+        (row.realised_joint_e for row in bases), Fraction()
+    )
+    trace = []
+    for iteration in range(MAX_DINKELBACH):
+        selections = []
+        ties = []
+        for rows in anchors:
+            selected, tie_count = choose_at_price(rows, "dinkelbach", residual, eta)
+            selections.append(selected)
+            ties.append(tie_count)
+        pseudo_n = sum(
+            (row.objective_terms("dinkelbach", residual)[0] for row in selections),
+            Fraction(),
+        )
+        pseudo_e = sum(
+            (row.objective_terms("dinkelbach", residual)[1] for row in selections),
+            Fraction(),
+        )
+        if pseudo_e <= 0:
+            raise RuntimeError("Dinkelbach selected non-positive pooled pseudo-energy")
+        residual_value = pseudo_n - eta * pseudo_e
+        trace.append(
+            {
+                "iteration": iteration,
+                "eta": pair(eta),
+                "pooled_pseudo_numerator": pair(pseudo_n),
+                "pooled_pseudo_energy": pair(pseudo_e),
+                "surplus_residual": pair(residual_value),
+                "selected_configuration_ids": [row.configuration_id for row in selections],
+                "tie_counts": ties,
+            }
+        )
+        new_eta = pseudo_n / pseudo_e
+        if residual_value == 0:
+            return selections, trace
+        eta = new_eta
+    raise RuntimeError("Dinkelbach iteration cap reached")
+
+
+def summarize_selection(
+    selections: Sequence[CandidateTerms],
+    *,
+    selector: str,
+    price: str,
+    trace: Sequence[Mapping[str, object]] | None = None,
+):
+    bits = sum((row.realised_joint_n for row in selections), Fraction())
+    energy = sum((row.realised_joint_e for row in selections), Fraction())
+    if energy <= 0:
+        raise RuntimeError("reported pooled energy is not positive")
+    ee = bits / energy
+    return {
+        "selector": selector,
+        "price": price,
+        "pooled_demand_capped_ee_bit_per_j": pair(ee),
+        "pooled_demand_capped_ee_mbit_per_j": float(ee) / 1e6,
+        "capped_bits": pair(bits),
+        "capped_bits_float": float(bits),
+        "energy_j": pair(energy),
+        "energy_j_float": float(energy),
+        "served_count": sum(row.served_count for row in selections),
+        "rate_target_attained_count": sum(row.attained_count for row in selections),
+        "selected_configuration_ids": [row.configuration_id for row in selections],
+        "selected_changed_user_counts": [row.changed_users for row in selections],
+        "selected_size_distribution": dict(sorted(Counter(row.changed_users for row in selections).items())),
+        "dinkelbach_trace": list(trace or ()),
+    }
+
+
+def fixed_price_selection(anchors, residual: str, eta: Fraction):
+    selections, ties = [], []
+    for rows in anchors:
+        selected, tie_count = choose_at_price(rows, "pilot", residual, eta)
+        selections.append(selected)
+        ties.append(tie_count)
+    return selections, ties
+
+
+def ratio_from_pair(value: Sequence[int]) -> Fraction:
+    return Fraction(int(value[0]), int(value[1]))
+
+
+def effect(cell, baseline):
+    cell_ee = ratio_from_pair(cell["pooled_demand_capped_ee_bit_per_j"])
+    base_ee = ratio_from_pair(baseline["pooled_demand_capped_ee_bit_per_j"])
+    delta = cell_ee - base_ee
+    sign = 1 if delta > 0 else -1 if delta < 0 else 0
+    return {
+        "absolute_ee_bit_per_j": pair(delta),
+        "relative": pair(delta / base_ee),
+        "relative_float": float(delta / base_ee),
+        "sign": sign,
+        "different_anchor_decisions": sum(
+            a != b
+            for a, b in zip(
+                cell["selected_configuration_ids"], baseline["selected_configuration_ids"]
+            )
+        ),
+    }
+
+
+def classify(effects):
+    price = any(
+        effects[f"pilot_{gate}"]["sign"] * effects[f"dinkelbach_{gate}"]["sign"] == -1
+        for gate in ("gated", "ungated")
+    )
+    gating = any(
+        effects[f"{price_name}_gated"]["sign"]
+        * effects[f"{price_name}_ungated"]["sign"] == -1
+        for price_name in ("pilot", "dinkelbach")
+    )
+    if price and gating:
+        return "both", price, gating
+    if price:
+        return "price", price, gating
+    if gating:
+        return "gating", price, gating
+    return "neither", price, gating
+
+
