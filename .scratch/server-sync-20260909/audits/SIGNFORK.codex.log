+        f"Machine results: `.scratch/sign-fork/results.json` (SHA-256 `{results['custody']['results_sha256']}`). Runner SHA-256: `{results['inputs']['runner_sha256']}`; pilot script SHA-256: `{results['inputs']['pilot_script_sha256']}`; physics engine SHA-256: `{results['inputs']['engine_sha256']}`; calibration SHA-256: `{results['inputs']['calibration_sha256']}`.",
+        "",
+        f"Interpreter: `{results['runtime']['invoked_interpreter']}` (resolved `{results['runtime']['resolved_interpreter']}`); nice `{results['runtime']['nice']}`; Python-process concurrency `{results['runtime']['python_process_concurrency']}`; all recorded BLAS variables were `1`. No learner, training, optimizer, policy, test split, search grid, manifest setting, sealed constant, threshold, sign, seed, horizon, price, guard, acceptance rule, or control law was changed. The reference checkout and its virtual environment were read-only.",
+        "",
+        "Reproduction from `/home/sat/mcrl-v025-witness-ws`:",
+        "",
+        "```bash",
+        "env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \\",
+        "  NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 BLIS_NUM_THREADS=1 \\",
+        "  nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+        "  .scratch/sign-fork/run.py",
+        "```",
+    ])
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--results", type=Path, default=DEFAULT_RESULTS)
+    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
+    args = parser.parse_args(argv)
+    verify_runtime()
+    started = time.perf_counter()
+    pilot, calibration = load_pilot()
+    if WORLD_ID != pilot.EVALUATION_WORLDS[0]:
+        raise RuntimeError("fixed world is no longer the pilot's first evaluation world")
+    print(json.dumps({"event": "tape_start", "world": WORLD_ID}), flush=True)
+    tape = pilot.build_world_tape(
+        domain=WORLD_ID,
+        provider=pilot.LegacyWorldProvider(role="residual-sign-fork-diagnostic"),
+        steps=pilot.EVAL_TAPE_STEPS,
+        start_time_s=0.0,
+    )
+    print(json.dumps({"event": "tape_done", "world": WORLD_ID, "seed": tape.seed}), flush=True)
+    specs = (
+        (step, carrier)
+        for step in range(pilot.EVAL_ANCHOR_STEPS)
+        for carrier in pilot.ENGINE.REFERENCE_CARRIERS
+    )
+    anchors, anchor_receipts = [], []
+    for anchor_index, (step_index, carrier) in enumerate(specs):
+        if anchor_index >= ANCHOR_COUNT:
+            break
+        rows, receipt = build_anchor(
+            pilot, calibration, tape, anchor_index, step_index, carrier
+        )
+        anchors.append(rows)
+        anchor_receipts.append(receipt)
+        print(
+            json.dumps(
+                {
+                    "event": "anchor_done",
+                    "anchor_index": anchor_index,
+                    "anchor_id": receipt["anchor_id"],
+                    "raw_catalogue_rows": receipt["raw_catalogue_rows"],
+                    "eligible_rows": receipt["eligible_rows"],
+                    "context_none_fraction": receipt["context_none_eligible_fraction"],
+                    "wall_s": receipt["wall_s"],
+                }
+            ),
+            flush=True,
+        )
+    if len(anchors) != ANCHOR_COUNT:
+        raise RuntimeError("fixed anchor count was not met")
+
+    pilot_selections = {}
+    pilot_ties = {}
+    for residual in ("additive", "gated", "ungated"):
+        selected, ties = fixed_price_selection(anchors, residual, calibration.eta_ref)
+        pilot_selections[residual] = selected
+        pilot_ties[residual] = ties
+    dink_selections, dink_traces = {}, {}
+    for residual in ("additive", "gated", "ungated"):
+        selected, trace = dinkelbach(anchors, residual)
+        dink_selections[residual] = selected
+        dink_traces[residual] = trace
+
+    cells = {
+        "pilot_baseline": summarize_selection(
+            pilot_selections["additive"], selector="ADDITIVE_ONLY", price="pilot"
+        ),
+        "A": summarize_selection(pilot_selections["gated"], selector="GATED", price="pilot"),
+        "C": summarize_selection(pilot_selections["ungated"], selector="UNGATED", price="pilot"),
+        "dinkelbach_baseline": summarize_selection(
+            dink_selections["additive"],
+            selector="ADDITIVE_ONLY",
+            price="dinkelbach",
+            trace=dink_traces["additive"],
+        ),
+        "B": summarize_selection(
+            dink_selections["gated"],
+            selector="GATED",
+            price="dinkelbach",
+            trace=dink_traces["gated"],
+        ),
+        "D": summarize_selection(
+            dink_selections["ungated"],
+            selector="UNGATED",
+            price="dinkelbach",
+            trace=dink_traces["ungated"],
+        ),
+    }
+    cells["pilot_baseline"]["tie_counts"] = pilot_ties["additive"]
+    cells["A"]["tie_counts"] = pilot_ties["gated"]
+    cells["C"]["tie_counts"] = pilot_ties["ungated"]
+    effects = {
+        "pilot_gated": effect(cells["A"], cells["pilot_baseline"]),
+        "pilot_ungated": effect(cells["C"], cells["pilot_baseline"]),
+        "dinkelbach_gated": effect(cells["B"], cells["dinkelbach_baseline"]),
+        "dinkelbach_ungated": effect(cells["D"], cells["dinkelbach_baseline"]),
+    }
+    factor, price_matters, gating_matters = classify(effects)
+    eligible_rows = sum(row["eligible_rows"] for row in anchor_receipts)
+    eligible_none = sum(row["context_none_eligible_rows"] for row in anchor_receipts)
+    nominal_rows = sum(row["nominal_legal_rows"] for row in anchor_receipts)
+    nominal_none = sum(row["context_none_nominal_legal_rows"] for row in anchor_receipts)
+    gated_ungated_identical = sum(
+        cells[left]["selected_configuration_ids"] == cells[right]["selected_configuration_ids"]
+        for left, right in (("A", "C"), ("B", "D"))
+    )
+    if factor in ("price", "gating", "both"):
+        second_world_statement = (
+            "No second-world cell was run: the fixed first-world 2×2 already isolates at least "
+            "one requested factor, so a world effect did not turn out to be needed or established."
+        )
+    else:
+        second_world_statement = (
+            "No second-world cell was run because this table alone cannot distinguish a world "
+            "effect from a catalogue effect; claiming that the world matters would be an unsupported "
+            "inference rather than the requested conditional follow-up."
+        )
+    runner_hash = sha256(Path(__file__))
+    results = {
+        "schema": "mcrl-v025-residual-sign-fork-diagnostic-v1",
+        "artifact_label": LABEL,
+        "scope": {
+            "world_id": WORLD_ID,
