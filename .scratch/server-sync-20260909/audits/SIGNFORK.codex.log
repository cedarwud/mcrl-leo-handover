+            "anchor_count": ANCHOR_COUNT,
+            "anchor_order": "first eight, step-major then ENGINE.REFERENCE_CARRIERS order",
+            "catalogue": "pilot _build_anchor_rows(full_legal_actions=True) + ENGINE._catalogue_with_census",
+            "selection_boundary_indices": [0],
+            "reporting_boundary_indices": list(BOUNDARIES),
+            "demand_cap_bits_per_user": pair(DEMAND_CAP_BITS),
+            "eta_ref": pair(calibration.eta_ref),
+            "eligibility_guard": "nominal and realised valid; exact singleton decomposition valid; realised served >= incumbent",
+            "tie_break": "incumbent first, then lexicographic configuration_id",
+        },
+        "runtime": {
+            "invoked_interpreter": str(INVOKED_PYTHON),
+            "resolved_interpreter": str(Path(sys.executable).resolve()),
+            "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "python_process_concurrency": 1 + WORKER_COUNT,
+            "thread_environment": {name: os.environ[name] for name in THREAD_ENV},
+            "wall_s": time.perf_counter() - started,
+        },
+        "inputs": {
+            "spec_sha256": sha256(SPEC),
+            "runner_sha256": runner_hash,
+            "pilot_script_sha256": sha256(PILOT_SCRIPT),
+            "engine_sha256": sha256(pilot.ENGINE_PATH),
+            "calibration_sha256": sha256(PILOT_OUTPUT / "PILOT_NOT_CLAIM-calibration.json"),
+            "execution_source": str(EXECUTION_SOURCE),
+            "execution_coalitions_sha256": sha256(EXECUTION_SOURCE / "mcrl/stagec_v025/coalitions.py"),
+        },
+        "anchors": anchor_receipts,
+        "gate_coverage": {
+            "eligible_rows": eligible_rows,
+            "eligible_none_rows": eligible_none,
+            "eligible_present_rows": eligible_rows - eligible_none,
+            "eligible_none_fraction": eligible_none / eligible_rows,
+            "nominal_legal_rows": nominal_rows,
+            "nominal_legal_none_rows": nominal_none,
+            "nominal_legal_present_rows": nominal_rows - nominal_none,
+            "nominal_legal_none_fraction": nominal_none / nominal_rows,
+        },
+        "cells": cells,
+        "effects": effects,
+        "comparison": {
+            "gated_ungated_identical_cells": gated_ungated_identical,
+            "A_equals_C_selection": cells["A"]["selected_configuration_ids"] == cells["C"]["selected_configuration_ids"],
+            "B_equals_D_selection": cells["B"]["selected_configuration_ids"] == cells["D"]["selected_configuration_ids"],
+        },
+        "invariants": {
+            "reconstruction_checks": sum(row["reconstruction_checks"] for row in anchor_receipts),
+            "all_selected_guard_compliant": True,
+            "exact_fraction_selection": True,
+            "same_catalogue_all_cells": True,
+        },
+        "conclusion": {
+            "factor": factor,
+            "price_changes_a_sign": price_matters,
+            "gating_changes_a_sign": gating_matters,
+            "second_world_run": False,
+            "second_world_statement": second_world_statement,
+        },
+        "claim_ceiling": "Every number uses exact residual terms, so all of it is a ceiling, not an achievable value.",
+        "loss_values_used_as_ee_evidence": False,
+    }
+    args.results.parent.mkdir(parents=True, exist_ok=True)
+    provisional = json.dumps(results, sort_keys=True, indent=2, allow_nan=False) + "\n"
+    args.results.write_text(provisional, encoding="utf-8")
+    results_hash = sha256(args.results)
+    report_results = dict(results)
+    report_results["custody"] = {"results_sha256": results_hash}
+    args.report.write_text(render_report(report_results), encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "event": "complete",
+                "factor": factor,
+                "results": str(args.results),
+                "report": str(args.report),
+                "semantic_payload_sha256": results_hash,
+                "file_sha256": sha256(args.results),
+                "report_sha256": sha256(args.report),
+            }
+        ),
+        flush=True,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.scratch/sign-fork/spec.md b/.scratch/sign-fork/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..c02bc66626221dc289401332646690b46fc9d68c
--- /dev/null
+++ b/.scratch/sign-fork/spec.md
@@ -0,0 +1,64 @@
+# Residual sign-fork diagnostic specification
+
+`DIAGNOSTIC_NOT_CLAIM`
+
+This specification was written before any sign-fork selector cell was run or
+inspected.  The choice is outcome-blind and will not be changed after seeing a
+cell result.
+
+## Fixed scope
+
+- World: `V025_PROBE/world/3` (seed is whatever the sealed world builder
+  deterministically assigns to that domain).
+- Anchors: the first eight anchors in the pilot's existing deterministic order:
+  step-major, then `ENGINE.REFERENCE_CARRIERS` order.  This is the same ordering
+  used by the C3 reachability receipt.
+- Catalogue: for every anchor, the pilot's deployed
+  `_build_anchor_rows(..., full_legal_actions=True)` inputs followed by
+  `ENGINE._catalogue_with_census`, with only candidates valid in both the
+  nominal boundary-0 and realised 48-boundary evaluators and satisfying the
+  fixed served-count guard retained.
+- Eligibility guard: valid corrected solve and realised 48-boundary served
+  count no lower than the anchor incumbent's.
+- Tie-break: incumbent first on exact score ties, otherwise lexicographic
+  `configuration_id`.
+- Reporting numerator: demand-capped bits, per user capped at
+  `50,000,000 bit/s * (47 * 0.640 s) = 1,504,000,000 bits`, pooled before
+  division by pooled realised 48-boundary energy.
+- Reported fields: pooled demand-capped EE, capped bits, energy, served count,
+  and rate-target attainment.
+
+## The two controlled factors
+
+1. Price/objective:
+   - pilot: exact nominal boundary-0 `F = B - eta_ref E`, using the sealed pilot
+     `eta_ref`;
+   - pooled EE: exact-Fraction Dinkelbach using one common price across all
+     eight anchors and the realised 48-boundary demand-capped numerator.
+2. Residual object:
+   - gated: exact `joint - sum(singletons)` is added only where the production
+     `contexts.get(configuration_id)` gate is present;
+   - ungated: that same exact residual is added on every eligible row.
+
+The additive-only baseline is independently selected under both price
+definitions.  For each price definition the additive terms and residual are
+formed from the same exact objective components, so adding the ungated residual
+reconstructs the corresponding candidate joint objective exactly.  Binary64
+physics outputs are lifted with `Fraction.from_float` before decomposition,
+selection, and pooling.
+
+No learner, optimizer, training run, test split, or search grid is opened.  The
+world, anchors, catalogues, guard, tie-break, constants, horizon, provisioning,
+coupled-power solve, and reporting stay fixed.  The only selector toggles are
+the declared price/objective column and production context gate row.
+
+## Completion criterion
+
+One deterministic invocation of `.scratch/sign-fork/run.py` must write
+`.scratch/sign-fork/results.json` and `RESIDUAL-SIGN-FORK-2026-09-10.md`, cover
+all six selections (two additive baselines plus four residual cells), report
+production gate coverage, classify evidence as verified/derived/inferred, and
+validate exact reconstruction, guard compliance, tie-breaking, and output
+schema.  A second-world cell may be run only if the first-world table leaves a
+world-dependent disagreement that the requested conditional follow-up can
+quantify.

diff --git a/.scratch/sign-fork/run.py b/.scratch/sign-fork/run.py
new file mode 100644
index 0000000000000000000000000000000000000000..ec0922ba3bc3e914ecf991709194ae128cd13cd5
--- /dev/null
+++ b/.scratch/sign-fork/run.py
@@ -0,0 +1,875 @@
+#!/usr/bin/env python3
+"""DIAGNOSTIC_NOT_CLAIM: exact residual price x production-gate fork."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import json
+import math
+import multiprocessing as mp
+import os
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-witness-ws")
+REFERENCE = Path("/home/sat/mcrl-v025-coalgen-ws")
+EXECUTION_SOURCE = REFERENCE / ".scratch/epoch-trend/clean-source/src"
+PILOT_SCRIPT = REFERENCE / "scripts/run_v025_pilot_c3.py"
+PILOT_OUTPUT = REFERENCE / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+SPEC = WORKSPACE / ".scratch/sign-fork/spec.md"
+DEFAULT_RESULTS = WORKSPACE / ".scratch/sign-fork/results.json"
+DEFAULT_REPORT = WORKSPACE / "RESIDUAL-SIGN-FORK-2026-09-10.md"
+INVOKED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+EXPECTED_PYTHON = INVOKED_PYTHON.resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS",
+    "OPENBLAS_NUM_THREADS",
+    "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS",
+    "VECLIB_MAXIMUM_THREADS",
+    "BLIS_NUM_THREADS",
+)
+WORLD_ID = "V025_PROBE/world/3"
+ANCHOR_COUNT = 8
+BOUNDARIES = tuple(range(48))
+DEMAND_CAP_BITS = Fraction(1_504_000_000)
+MAX_DINKELBACH = 128
+LABEL = "DIAGNOSTIC_NOT_CLAIM"
+WORKER_COUNT = 3
+_WORKER_PILOT = None
+_WORKER_CALIBRATION = None
+_WORKER_TAPE = None
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def exact(value: float) -> Fraction:
+    value = float(value)
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical value")
+    return Fraction.from_float(value)
+
+
+def pair(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def fmt(value: float, digits: int = 6) -> str:
+    return f"{value:.{digits}f}"
+
+
+def fmt_pct(value: float) -> str:
+    return f"{value:+.2%}"
+
+
+def load_pilot():
+    source = str(EXECUTION_SOURCE)
+    scripts = str(REFERENCE / "scripts")
+    if source not in sys.path:
+        sys.path.insert(0, source)
+    if scripts not in sys.path:
+        sys.path.insert(0, scripts)
+    import run_v025_pilot_c3 as pilot
+
+    payload = json.loads(
+        (PILOT_OUTPUT / "PILOT_NOT_CLAIM-calibration.json").read_text(encoding="ascii")
+    )
+    ratio = lambda name: Fraction(*payload[name])
+    calibration = pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+    return pilot, calibration
+
+
+def verify_runtime() -> None:
+    actual = Path(sys.executable).resolve()
+    if actual != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {actual}; expected {EXPECTED_PYTHON}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"BLAS/thread environment is not pinned to one: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("process niceness is below required nice -n 15")
+    if not SPEC.is_file():
+        raise RuntimeError("precommitted experiment specification is missing")
+
+
+@dataclass(frozen=True)
+class CandidateTerms:
+    configuration_id: str
+    is_base: bool
+    changed_users: int
+    context_present: bool
+    served_count: int
+    attained_count: int
+    pilot_joint_n: Fraction
+    pilot_joint_e: Fraction
+    pilot_additive_n: Fraction
+    pilot_additive_e: Fraction
+    realised_joint_n: Fraction
+    realised_joint_e: Fraction
+    realised_additive_n: Fraction
+    realised_additive_e: Fraction
+
+    def objective_terms(self, price: str, residual: str) -> tuple[Fraction, Fraction]:
+        if price == "pilot":
+            joint_n, joint_e = self.pilot_joint_n, self.pilot_joint_e
+            additive_n, additive_e = self.pilot_additive_n, self.pilot_additive_e
+        elif price == "dinkelbach":
+            joint_n, joint_e = self.realised_joint_n, self.realised_joint_e
+            additive_n, additive_e = self.realised_additive_n, self.realised_additive_e
+        else:
+            raise ValueError(price)
+        if residual == "additive":
+            return additive_n, additive_e
+        if residual == "gated" and not self.context_present:
+            return additive_n, additive_e
+        if residual in ("gated", "ungated"):
+            return joint_n, joint_e
+        raise ValueError(residual)
+
+
+def evaluate_in_batches(evaluator, configs: Sequence[object]) -> None:
+    # The dense evaluator is vectorized over configurations.  One call avoids
+    # repeating its expensive shared setup for every artificial small batch.
+    evaluator.evaluate_many(configs)
+
+
+def profile_pilot(profile) -> tuple[Fraction, Fraction]:
+    return exact(profile.bits), exact(profile.joules)
+
+
+def profile_realised(profile) -> tuple[Fraction, Fraction, int, int]:
+    capped = sum(
+        (min(exact(value), DEMAND_CAP_BITS) for value in profile.score.bits.values()),
+        Fraction(),
+    )
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    attained_map = profile.score.rate_target_attained
+    if attained_map is None:
+        raise RuntimeError("realised profile omitted rate-target attainment")
+    attained = sum(bool(value) for value in attained_map.values())
+    threshold_attained = sum(exact(value) >= DEMAND_CAP_BITS for value in profile.score.bits.values())
+    if attained != threshold_attained:
+        raise RuntimeError("rate-target attainment disagrees with integrated-bit threshold")
+    return capped, exact(profile.joules), served, attained
+
+
+def singleton_configurations(pilot, anchor, catalogue: Sequence[object]):
+    by_key = {}
+    for config in catalogue:
+        mapping = config.mapping
+        for user in sorted(anchor.mapping):
+            if mapping[user] == anchor.mapping[user]:
+                continue
+            singleton_mapping = anchor.mapping
+            singleton_mapping[user] = mapping[user]
+            singleton = pilot.ENGINE._configuration(
+                anchor, singleton_mapping, kind="sign-fork-exact-singleton"
+            )
+            by_key[(user, mapping[user])] = singleton
+    return by_key
+
+
+def additive_terms(anchor, config, singleton_profiles, base_terms, profile_fn):
+    n, e = base_terms
+    mapping = config.mapping
+    for user in sorted(anchor.mapping):
+        if mapping[user] == anchor.mapping[user]:
+            continue
+        singleton = singleton_profiles[(user, mapping[user])]
+        sn, se = profile_fn(singleton)
+        n += sn - base_terms[0]
+        e += se - base_terms[1]
+    return n, e
+
+
+def build_anchor(pilot, calibration, tape, anchor_index: int, step_index: int, carrier: str):
+    started = time.perf_counter()
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    built = pilot._build_anchor_rows(
+        tape=tape,
+        setting=setting,
+        run_setting=run_setting,
+        calibration=calibration,
+        step_index=step_index,
+        carrier=carrier,
+        anchor_index=anchor_index,
+        include_coalition=False,
+        full_legal_actions=True,
+    )
+    anchor = built["base"]
+    incumbent = built["incumbent"]
+    nominal = built["current_evaluator"]
+    rows_by_user_action = built["rows_by_user_action"]
+    catalogue, census = pilot.ENGINE._catalogue_with_census(
+        tape,
+        step_index,
+        anchor,
+        setting=setting,
+        calibration=calibration,
+        run_setting=run_setting,
+    )
+    if not any(config.assignments == anchor.assignments for config in catalogue):
+        catalogue = (anchor, *catalogue)
+    catalogue = tuple({config.assignments: config for config in catalogue}.values())
+    catalogue = tuple(sorted(catalogue, key=lambda row: row.configuration_id))
+    singleton_by_key = singleton_configurations(pilot, anchor, catalogue)
+    all_configs = tuple(
+        {config.assignments: config for config in (*catalogue, *singleton_by_key.values())}.values()
+    )
+    evaluate_in_batches(nominal, all_configs)
+
+    realised = pilot.ENGINE.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=BOUNDARIES,
+    )
+    evaluate_in_batches(realised, all_configs)
+    if anchor.configuration_id in nominal._invalid or anchor.configuration_id in realised._invalid:
+        raise RuntimeError("anchor incumbent is invalid")
+
+    base_pilot = profile_pilot(nominal.evaluate(anchor))
+    base_realised = profile_realised(realised.evaluate(anchor))
+    base_served = base_realised[2]
+    nominal_legal = [row for row in catalogue if row.configuration_id not in nominal._invalid]
+    contexts = {}
+    for config in nominal_legal:
+        changed = tuple(
+            user for user in sorted(anchor.mapping)
+            if config.mapping[user] != anchor.mapping[user]
+        )
+        if len(changed) >= 2:
+            contexts[config.configuration_id] = pilot._coalition_context(
+                tape=tape,
+                step_index=step_index,
+                anchor=anchor,
+                selected=config,
+                rows_by_user_action=rows_by_user_action,
+            )
+
+    records = []
+    exclusion = Counter()
+    reconstruction_checks = 0
+    nominal_singleton_profiles = {
+        key: nominal.evaluate(value) for key, value in singleton_by_key.items()
+    }
+    realised_singleton_profiles = {
+        key: realised.evaluate(value) for key, value in singleton_by_key.items()
+    }
+    for config in catalogue:
+        if config.configuration_id in nominal._invalid:
+            exclusion["nominal_invalid"] += 1
+            continue
+        if config.configuration_id in realised._invalid:
+            exclusion["realised_invalid"] += 1
+            continue
+        changed_keys = [
+            (user, config.mapping[user])
+            for user in sorted(anchor.mapping)
+            if config.mapping[user] != anchor.mapping[user]
+        ]
+        if any(singleton_by_key[key].configuration_id in nominal._invalid for key in changed_keys):
+            exclusion["nominal_singleton_invalid"] += 1
+            continue
+        if any(singleton_by_key[key].configuration_id in realised._invalid for key in changed_keys):
+            exclusion["realised_singleton_invalid"] += 1
+            continue
+        r_profile = realised.evaluate(config)
+        r_joint_n, r_joint_e, served, attained = profile_realised(r_profile)
+        if served < base_served:
+            exclusion["served_guard"] += 1
+            continue
+        p_joint_n, p_joint_e = profile_pilot(nominal.evaluate(config))
+        p_add_n, p_add_e = additive_terms(
+            anchor,
+            config,
+            nominal_singleton_profiles,
+            base_pilot,
+            profile_pilot,
+        )
+        r_add_n, r_add_e = additive_terms(
+            anchor,
+            config,
+            realised_singleton_profiles,
+            base_realised[:2],
+            lambda profile: profile_realised(profile)[:2],
+        )
+        changed_count = len(changed_keys)
+        context_present = contexts.get(config.configuration_id) is not None
+        if changed_count >= 2 and not context_present:
+            raise RuntimeError("production joint context unexpectedly absent")
+        if changed_count < 2 and context_present:
+            raise RuntimeError("production context unexpectedly present below coalition size two")
+        row = CandidateTerms(
+            configuration_id=config.configuration_id,
+            is_base=config.assignments == anchor.assignments,
+            changed_users=changed_count,
+            context_present=context_present,
+            served_count=served,
+            attained_count=attained,
+            pilot_joint_n=p_joint_n,
+            pilot_joint_e=p_joint_e,
+            pilot_additive_n=p_add_n,
+            pilot_additive_e=p_add_e,
+            realised_joint_n=r_joint_n,
+            realised_joint_e=r_joint_e,
+            realised_additive_n=r_add_n,
+            realised_additive_e=r_add_e,
+        )
+        for price in ("pilot", "dinkelbach"):
+            if row.objective_terms(price, "ungated") != row.objective_terms(price, "gated"):
+                if row.context_present:
+                    raise RuntimeError("gated residual failed to include a present-context row")
+            joint = row.objective_terms(price, "ungated")
+            if joint != (
+                (row.pilot_joint_n, row.pilot_joint_e)
+                if price == "pilot"
+                else (row.realised_joint_n, row.realised_joint_e)
+            ):
+                raise RuntimeError("ungated residual did not reconstruct joint objective")
+            reconstruction_checks += 1
+        records.append(row)
+
+    base_rows = [row for row in records if row.is_base]
+    if len(base_rows) != 1:
+        raise RuntimeError(f"eligible catalogue must contain exactly one incumbent, got {len(base_rows)}")
+    nominal_none = len(nominal_legal) - len(contexts)
+    eligible_none = sum(not row.context_present for row in records)
+    result = {
+        "anchor_index": anchor_index,
+        "anchor_id": f"{tape.domain}|{step_index}|{carrier}",
+        "step_index": step_index,
+        "carrier": carrier,
+        "configuration_id": anchor.configuration_id,
+        "raw_catalogue_rows": len(catalogue),
+        "nominal_legal_rows": len(nominal_legal),
+        "eligible_rows": len(records),
+        "context_present_nominal_legal_rows": len(contexts),
+        "context_none_nominal_legal_rows": nominal_none,
+        "context_none_nominal_legal_fraction": nominal_none / len(nominal_legal),
+        "context_present_eligible_rows": len(records) - eligible_none,
+        "context_none_eligible_rows": eligible_none,
+        "context_none_eligible_fraction": eligible_none / len(records),
+        "exclusions": dict(sorted(exclusion.items())),
+        "catalogue_census": census,
+        "base_served_count": base_served,
+        "reconstruction_checks": reconstruction_checks,
+        "wall_s": time.perf_counter() - started,
+    }
+    return records, result
+
+
+def worker_build_anchor(task):
+    if _WORKER_PILOT is None or _WORKER_CALIBRATION is None or _WORKER_TAPE is None:
+        raise RuntimeError("fork worker globals were not initialized")
+    anchor_index, step_index, carrier = task
+    return build_anchor(
+        _WORKER_PILOT,
+        _WORKER_CALIBRATION,
+        _WORKER_TAPE,
+        anchor_index,
+        step_index,
+        carrier,
+    )
+
+
+def tie_key(row: CandidateTerms) -> tuple[int, str]:
+    return (0 if row.is_base else 1, row.configuration_id)
+
+
+def choose_at_price(rows: Sequence[CandidateTerms], price: str, residual: str, eta: Fraction):
+    scored = []
+    for row in rows:
+        n, e = row.objective_terms(price, residual)
+        scored.append((n - eta * e, row))
+    best = max(score for score, _row in scored)
+    tied = [row for score, row in scored if score == best]
+    return min(tied, key=tie_key), len(tied)
+
+
+def dinkelbach(anchors: Sequence[Sequence[CandidateTerms]], residual: str):
+    bases = [next(row for row in rows if row.is_base) for rows in anchors]
+    eta = sum((row.realised_joint_n for row in bases), Fraction()) / sum(
+        (row.realised_joint_e for row in bases), Fraction()
+    )
+    trace = []
+    for iteration in range(MAX_DINKELBACH):
+        selections = []
+        ties = []
+        for rows in anchors:
+            selected, tie_count = choose_at_price(rows, "dinkelbach", residual, eta)
+            selections.append(selected)
+            ties.append(tie_count)
+        pseudo_n = sum(
+            (row.objective_terms("dinkelbach", residual)[0] for row in selections),
+            Fraction(),
+        )
+        pseudo_e = sum(
+            (row.objective_terms("dinkelbach", residual)[1] for row in selections),
+            Fraction(),
+        )
+        if pseudo_e <= 0:
+            raise RuntimeError("Dinkelbach selected non-positive pooled pseudo-energy")
+        residual_value = pseudo_n - eta * pseudo_e
+        trace.append(
+            {
+                "iteration": iteration,
+                "eta": pair(eta),
+                "pooled_pseudo_numerator": pair(pseudo_n),
+                "pooled_pseudo_energy": pair(pseudo_e),
+                "surplus_residual": pair(residual_value),
+                "selected_configuration_ids": [row.configuration_id for row in selections],
+                "tie_counts": ties,
+            }
+        )
+        new_eta = pseudo_n / pseudo_e
+        if residual_value == 0:
+            return selections, trace
+        eta = new_eta
+    raise RuntimeError("Dinkelbach iteration cap reached")
+
+
+def summarize_selection(
+    selections: Sequence[CandidateTerms],
+    *,
+    selector: str,
+    price: str,
+    trace: Sequence[Mapping[str, object]] | None = None,
+):
+    bits = sum((row.realised_joint_n for row in selections), Fraction())
+    energy = sum((row.realised_joint_e for row in selections), Fraction())
+    if energy <= 0:
+        raise RuntimeError("reported pooled energy is not positive")
+    ee = bits / energy
+    return {
+        "selector": selector,
+        "price": price,
+        "pooled_demand_capped_ee_bit_per_j": pair(ee),
+        "pooled_demand_capped_ee_mbit_per_j": float(ee) / 1e6,
+        "capped_bits": pair(bits),
+        "capped_bits_float": float(bits),
+        "energy_j": pair(energy),
+        "energy_j_float": float(energy),
+        "served_count": sum(row.served_count for row in selections),
+        "rate_target_attained_count": sum(row.attained_count for row in selections),
+        "selected_configuration_ids": [row.configuration_id for row in selections],
+        "selected_changed_user_counts": [row.changed_users for row in selections],
+        "selected_size_distribution": dict(sorted(Counter(row.changed_users for row in selections).items())),
+        "dinkelbach_trace": list(trace or ()),
+    }
+
+
+def fixed_price_selection(anchors, residual: str, eta: Fraction):
+    selections, ties = [], []
+    for rows in anchors:
+        selected, tie_count = choose_at_price(rows, "pilot", residual, eta)
+        selections.append(selected)
+        ties.append(tie_count)
+    return selections, ties
+
+
+def ratio_from_pair(value: Sequence[int]) -> Fraction:
+    return Fraction(int(value[0]), int(value[1]))
+
+
+def effect(cell, baseline):
+    cell_ee = ratio_from_pair(cell["pooled_demand_capped_ee_bit_per_j"])
+    base_ee = ratio_from_pair(baseline["pooled_demand_capped_ee_bit_per_j"])
+    delta = cell_ee - base_ee
+    sign = 1 if delta > 0 else -1 if delta < 0 else 0
+    return {
+        "absolute_ee_bit_per_j": pair(delta),
+        "relative": pair(delta / base_ee),
+        "relative_float": float(delta / base_ee),
+        "sign": sign,
+        "different_anchor_decisions": sum(
+            a != b
+            for a, b in zip(
+                cell["selected_configuration_ids"], baseline["selected_configuration_ids"]
+            )
+        ),
+    }
+
+
+def classify(effects):
+    price = any(
+        effects[f"pilot_{gate}"]["sign"] * effects[f"dinkelbach_{gate}"]["sign"] == -1
+        for gate in ("gated", "ungated")
+    )
+    gating = any(
+        effects[f"{price_name}_gated"]["sign"]
+        * effects[f"{price_name}_ungated"]["sign"] == -1
+        for price_name in ("pilot", "dinkelbach")
+    )
+    if price and gating:
+        return "both", price, gating
+    if price:
+        return "price", price, gating
+    if gating:
+        return "gating", price, gating
+    return "neither", price, gating
+
+
+def render_report(results: Mapping[str, object]) -> str:
+    cells = results["cells"]
+    effects = results["effects"]
+    factor = results["conclusion"]["factor"]
+    first = (
+        f"**{factor.capitalize()} accounts for the sign disagreement on the fixed experiment: "
+        f"A={cells['A']['pooled_demand_capped_ee_mbit_per_j']:.6f}, "
+        f"B={cells['B']['pooled_demand_capped_ee_mbit_per_j']:.6f}, "
+        f"C={cells['C']['pooled_demand_capped_ee_mbit_per_j']:.6f}, and "
+        f"D={cells['D']['pooled_demand_capped_ee_mbit_per_j']:.6f} Mbit/J.**"
+    )
+    scope = results["scope"]
+    coverage = results["gate_coverage"]
+    lines = [
+        first,
+        "",
+        "# Residual sign fork — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM`",
+        "",
+        "## Verified by running code",
+        "",
+        f"Before running or inspecting any sign-fork cell, I fixed `{scope['world_id']}`, the first {scope['anchor_count']} anchors in the pilot's step-major/reference-carrier order, and the deployed `_build_anchor_rows(full_legal_actions=True)` plus `_catalogue_with_census` catalogue. That choice is preserved in `.scratch/sign-fork/spec.md` (SHA-256 `{results['inputs']['spec_sha256']}`). It was not selected to reproduce a sign.",
+        "",
+        "Every selector used the same eligible candidate rows, incumbent-relative exact singleton decomposition, valid-solve/served-count guard, incumbent-first then lexicographic tie-break, corrected provisioning, coupled-power solver, and realised 48-boundary report pooling. The pilot column ranked the exact nominal boundary-0 `F = B - eta_ref E`; the Dinkelbach column used one exact common price across anchors to target the pooled realised demand-capped EE.",
+        "",
+        "| residual object | pilot boundary-0 F | pooled-EE Dinkelbach |",
+        "| --- | ---: | ---: |",
+        f"| gated | A: **{cells['A']['pooled_demand_capped_ee_mbit_per_j']:.6f} Mbit/J** | B: **{cells['B']['pooled_demand_capped_ee_mbit_per_j']:.6f} Mbit/J** |",
+        f"| ungated | C: **{cells['C']['pooled_demand_capped_ee_mbit_per_j']:.6f} Mbit/J** | D: **{cells['D']['pooled_demand_capped_ee_mbit_per_j']:.6f} Mbit/J** |",
+        "",
+        "### Complete cell and baseline metrics",
+        "",
+        "| selection | EE (Mbit/J) | capped bits (Gbit) | energy (J) | served | rate-target attained |",
+        "| --- | ---: | ---: | ---: | ---: | ---: |",
+    ]
+    order = (
+        ("pilot_baseline", "Pilot `ADDITIVE_ONLY`"),
+        ("A", "A — pilot, gated"),
+        ("C", "C — pilot, ungated"),
+        ("dinkelbach_baseline", "Dinkelbach `ADDITIVE_ONLY`"),
+        ("B", "B — Dinkelbach, gated"),
+        ("D", "D — Dinkelbach, ungated"),
+    )
+    for key, label in order:
+        row = cells[key]
+        lines.append(
+            f"| {label} | {row['pooled_demand_capped_ee_mbit_per_j']:.6f} | "
+            f"{row['capped_bits_float']/1e9:.6f} | {row['energy_j_float']:.6f} | "
+            f"{row['served_count']} | {row['rate_target_attained_count']} |"
+        )
+    lines.extend([
+        "",
+        "### Residual effects within each price column",
+        "",
+        "| contrast | EE effect | changed anchor decisions | sign |",
+        "| --- | ---: | ---: | --- |",
+    ])
+    effect_order = (
+        ("pilot_gated", "A − pilot additive"),
+        ("pilot_ungated", "C − pilot additive"),
+        ("dinkelbach_gated", "B − Dinkelbach additive"),
+        ("dinkelbach_ungated", "D − Dinkelbach additive"),
+    )
+    sign_name = {-1: "negative", 0: "zero", 1: "positive"}
+    for key, label in effect_order:
+        row = effects[key]
+        lines.append(
+            f"| {label} | **{fmt_pct(row['relative_float'])}** | "
+            f"{row['different_anchor_decisions']}/{scope['anchor_count']} | {sign_name[row['sign']]} |"
+        )
+    lines.extend([
+        "",
+        "### Production contexts-gate coverage",
+        "",
+        f"Across the fixed eligible catalogues, `contexts.get(configuration_id)` was absent on **{coverage['eligible_none_rows']}/{coverage['eligible_rows']} rows ({coverage['eligible_none_fraction']:.3%})**. Before the shared realised-validity/served guard it was absent on **{coverage['nominal_legal_none_rows']}/{coverage['nominal_legal_rows']} nominal-legal rows ({coverage['nominal_legal_none_fraction']:.3%})**. The JSON retains per-anchor coverage and exclusions.",
+        "",
+        f"Gated and ungated choices were identical on {results['comparison']['gated_ungated_identical_cells']}/2 price columns. Exact reconstruction was checked {results['invariants']['reconstruction_checks']} times; every ungated additive-plus-residual objective equalled its joint candidate objective exactly.",
+        "",
+        "## Derived on paper",
+        "",
+        f"The per-user reporting cap is exactly `50,000,000 bit/s × (47 × 0.640 s) = {DEMAND_CAP_BITS.numerator:,} bits`. Each displayed ratio and percentage is derived from exact rational pooling of binary64 simulator outputs. Dinkelbach solves `max Σ(B_i − ηE_i)` with one common exact `η`; convergence means the selected pooled surplus is exactly zero at `η = ΣB_i/ΣE_i`.",
+        "",
+        "No loss value appears in the selector or evidence. Loss values are never evidence about EE.",
+        "",
+        "## Inferred",
+        "",
+    ])
+    if factor == "price":
+        lines.append("The residual-effect sign changes by price column and does not change by gate row, so explanation (1), the objective/price mismatch, is supported on this fixed world/catalogue; explanation (4), production context gating, is not supported here.")
+    elif factor == "gating":
+        lines.append("The residual-effect sign changes by gate row and not by price column, so explanation (4), the different residual object, is supported on this fixed world/catalogue; explanation (1) is not supported here.")
+    elif factor == "both":
+        lines.append("Both the price column and gate row change at least one residual-effect sign, so explanations (1) and (4) both matter on this fixed world/catalogue.")
+    else:
+        lines.append("Neither the price column nor gate row reproduces the prior sign disagreement on this fixed world/catalogue. This implicates explanation (2) or (3)—world or catalogue—and does not justify forcing a price/gating conclusion.")
+    lines.extend([
+        "",
+        results["conclusion"]["second_world_statement"],
+        "",
+        "Every number here uses exact residual terms, so all of it is a **ceiling, not an achievable value**. No learned-head or policy-achievability claim follows.",
+        "",
+        "## Custody and execution controls",
+        "",
+        f"Machine results: `.scratch/sign-fork/results.json` (SHA-256 `{results['custody']['results_sha256']}`). Runner SHA-256: `{results['inputs']['runner_sha256']}`; pilot script SHA-256: `{results['inputs']['pilot_script_sha256']}`; physics engine SHA-256: `{results['inputs']['engine_sha256']}`; calibration SHA-256: `{results['inputs']['calibration_sha256']}`.",
+        "",
+        f"Interpreter: `{results['runtime']['invoked_interpreter']}` (resolved `{results['runtime']['resolved_interpreter']}`); nice `{results['runtime']['nice']}`; Python-process concurrency `{results['runtime']['python_process_concurrency']}`; all recorded BLAS variables were `1`. No learner, training, optimizer, policy, test split, search grid, manifest setting, sealed constant, threshold, sign, seed, horizon, price, guard, acceptance rule, or control law was changed. The reference checkout and its virtual environment were read-only.",
+        "",
+        "Reproduction from `/home/sat/mcrl-v025-witness-ws`:",
+        "",
+        "```bash",
+        "env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \\",
+        "  NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 BLIS_NUM_THREADS=1 \\",
+        "  nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+        "  .scratch/sign-fork/run.py",
+        "```",
+    ])
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--results", type=Path, default=DEFAULT_RESULTS)
+    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
+    args = parser.parse_args(argv)
+    verify_runtime()
+    started = time.perf_counter()
+    pilot, calibration = load_pilot()
+    if WORLD_ID != pilot.EVALUATION_WORLDS[0]:
+        raise RuntimeError("fixed world is no longer the pilot's first evaluation world")
+    print(json.dumps({"event": "tape_start", "world": WORLD_ID}), flush=True)
+    tape = pilot.build_world_tape(
+        domain=WORLD_ID,
+        provider=pilot.LegacyWorldProvider(role="residual-sign-fork-diagnostic"),
+        steps=pilot.EVAL_TAPE_STEPS,
+        start_time_s=0.0,
+    )
+    print(json.dumps({"event": "tape_done", "world": WORLD_ID, "seed": tape.seed}), flush=True)
+    specs = (
+        (step, carrier)
+        for step in range(pilot.EVAL_ANCHOR_STEPS)
+        for carrier in pilot.ENGINE.REFERENCE_CARRIERS
+    )
+    tasks = []
+    for anchor_index, (step_index, carrier) in enumerate(specs):
+        if anchor_index >= ANCHOR_COUNT:
+            break
+        tasks.append((anchor_index, step_index, carrier))
+    if len(tasks) != ANCHOR_COUNT:
+        raise RuntimeError("fixed anchor count was not met")
+    global _WORKER_PILOT, _WORKER_CALIBRATION, _WORKER_TAPE
+    _WORKER_PILOT = pilot
+    _WORKER_CALIBRATION = calibration
+    _WORKER_TAPE = tape
+    completed = []
+    context = mp.get_context("fork")
+    with context.Pool(processes=WORKER_COUNT) as pool:
+        for rows, receipt in pool.imap_unordered(worker_build_anchor, tasks):
+            completed.append((receipt["anchor_index"], rows, receipt))
+            print(
+                json.dumps(
+                    {
+                        "event": "anchor_done",
+                        "anchor_index": receipt["anchor_index"],
+                        "anchor_id": receipt["anchor_id"],
+                        "raw_catalogue_rows": receipt["raw_catalogue_rows"],
+                        "eligible_rows": receipt["eligible_rows"],
+                        "context_none_fraction": receipt["context_none_eligible_fraction"],
+                        "wall_s": receipt["wall_s"],
+                    }
+                ),
+                flush=True,
+            )
+    completed.sort(key=lambda item: item[0])
+    anchors = [item[1] for item in completed]
+    anchor_receipts = [item[2] for item in completed]
+    for expected, receipt in enumerate(anchor_receipts):
+        if receipt["anchor_index"] != expected:
+            raise RuntimeError("parallel anchor ordering is incomplete")
+    if len(anchors) != ANCHOR_COUNT:
+        raise RuntimeError("fixed anchor count was not met")
+
+    pilot_selections = {}
+    pilot_ties = {}
+    for residual in ("additive", "gated", "ungated"):
+        selected, ties = fixed_price_selection(anchors, residual, calibration.eta_ref)
+        pilot_selections[residual] = selected
+        pilot_ties[residual] = ties
+    dink_selections, dink_traces = {}, {}
+    for residual in ("additive", "gated", "ungated"):
+        selected, trace = dinkelbach(anchors, residual)
+        dink_selections[residual] = selected
+        dink_traces[residual] = trace
+
+    cells = {
+        "pilot_baseline": summarize_selection(
+            pilot_selections["additive"], selector="ADDITIVE_ONLY", price="pilot"
+        ),
+        "A": summarize_selection(pilot_selections["gated"], selector="GATED", price="pilot"),
+        "C": summarize_selection(pilot_selections["ungated"], selector="UNGATED", price="pilot"),
+        "dinkelbach_baseline": summarize_selection(
+            dink_selections["additive"],
+            selector="ADDITIVE_ONLY",
+            price="dinkelbach",
+            trace=dink_traces["additive"],
+        ),
+        "B": summarize_selection(
+            dink_selections["gated"],
+            selector="GATED",
+            price="dinkelbach",
+            trace=dink_traces["gated"],
+        ),
+        "D": summarize_selection(
+            dink_selections["ungated"],
+            selector="UNGATED",
+            price="dinkelbach",
+            trace=dink_traces["ungated"],
+        ),
+    }
+    cells["pilot_baseline"]["tie_counts"] = pilot_ties["additive"]
+    cells["A"]["tie_counts"] = pilot_ties["gated"]
+    cells["C"]["tie_counts"] = pilot_ties["ungated"]
+    effects = {
+        "pilot_gated": effect(cells["A"], cells["pilot_baseline"]),
+        "pilot_ungated": effect(cells["C"], cells["pilot_baseline"]),
+        "dinkelbach_gated": effect(cells["B"], cells["dinkelbach_baseline"]),
+        "dinkelbach_ungated": effect(cells["D"], cells["dinkelbach_baseline"]),
+    }
+    factor, price_matters, gating_matters = classify(effects)
+    eligible_rows = sum(row["eligible_rows"] for row in anchor_receipts)
+    eligible_none = sum(row["context_none_eligible_rows"] for row in anchor_receipts)
+    nominal_rows = sum(row["nominal_legal_rows"] for row in anchor_receipts)
+    nominal_none = sum(row["context_none_nominal_legal_rows"] for row in anchor_receipts)
+    gated_ungated_identical = sum(
+        cells[left]["selected_configuration_ids"] == cells[right]["selected_configuration_ids"]
+        for left, right in (("A", "C"), ("B", "D"))
+    )
+    if factor in ("price", "gating", "both"):
+        second_world_statement = (
+            "No second-world cell was run: the fixed first-world 2×2 already isolates at least "
+            "one requested factor, so a world effect did not turn out to be needed or established."
+        )
+    else:
+        second_world_statement = (
+            "No second-world cell was run because this table alone cannot distinguish a world "
+            "effect from a catalogue effect; claiming that the world matters would be an unsupported "
+            "inference rather than the requested conditional follow-up."
+        )
+    runner_hash = sha256(Path(__file__))
+    results = {
+        "schema": "mcrl-v025-residual-sign-fork-diagnostic-v1",
+        "artifact_label": LABEL,
+        "scope": {
+            "world_id": WORLD_ID,
+            "world_seed": tape.seed,
+            "anchor_count": ANCHOR_COUNT,
+            "anchor_order": "first eight, step-major then ENGINE.REFERENCE_CARRIERS order",
+            "catalogue": "pilot _build_anchor_rows(full_legal_actions=True) + ENGINE._catalogue_with_census",
+            "selection_boundary_indices": [0],
+            "reporting_boundary_indices": list(BOUNDARIES),
+            "demand_cap_bits_per_user": pair(DEMAND_CAP_BITS),
+            "eta_ref": pair(calibration.eta_ref),
+            "eligibility_guard": "nominal and realised valid; exact singleton decomposition valid; realised served >= incumbent",
+            "tie_break": "incumbent first, then lexicographic configuration_id",
+        },
+        "runtime": {
+            "invoked_interpreter": str(INVOKED_PYTHON),
+            "resolved_interpreter": str(Path(sys.executable).resolve()),
+            "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "python_process_concurrency": 1 + WORKER_COUNT,
+            "thread_environment": {name: os.environ[name] for name in THREAD_ENV},
+            "wall_s": time.perf_counter() - started,
+        },
+        "inputs": {
+            "spec_sha256": sha256(SPEC),
+            "runner_sha256": runner_hash,
+            "pilot_script_sha256": sha256(PILOT_SCRIPT),
+            "engine_sha256": sha256(pilot.ENGINE_PATH),
+            "calibration_sha256": sha256(PILOT_OUTPUT / "PILOT_NOT_CLAIM-calibration.json"),
+            "execution_source": str(EXECUTION_SOURCE),
+            "execution_coalitions_sha256": sha256(EXECUTION_SOURCE / "mcrl/stagec_v025/coalitions.py"),
+        },
+        "anchors": anchor_receipts,
+        "gate_coverage": {
+            "eligible_rows": eligible_rows,
+            "eligible_none_rows": eligible_none,
+            "eligible_present_rows": eligible_rows - eligible_none,
+            "eligible_none_fraction": eligible_none / eligible_rows,
+            "nominal_legal_rows": nominal_rows,
+            "nominal_legal_none_rows": nominal_none,
+            "nominal_legal_present_rows": nominal_rows - nominal_none,
+            "nominal_legal_none_fraction": nominal_none / nominal_rows,
+        },
+        "cells": cells,
+        "effects": effects,
+        "comparison": {
+            "gated_ungated_identical_cells": gated_ungated_identical,
+            "A_equals_C_selection": cells["A"]["selected_configuration_ids"] == cells["C"]["selected_configuration_ids"],
+            "B_equals_D_selection": cells["B"]["selected_configuration_ids"] == cells["D"]["selected_configuration_ids"],
+        },
+        "invariants": {
+            "reconstruction_checks": sum(row["reconstruction_checks"] for row in anchor_receipts),
+            "all_selected_guard_compliant": True,
+            "exact_fraction_selection": True,
+            "same_catalogue_all_cells": True,
+        },
+        "conclusion": {
+            "factor": factor,
+            "price_changes_a_sign": price_matters,
+            "gating_changes_a_sign": gating_matters,
+            "second_world_run": False,
+            "second_world_statement": second_world_statement,
+        },
+        "claim_ceiling": "Every number uses exact residual terms, so all of it is a ceiling, not an achievable value.",
+        "loss_values_used_as_ee_evidence": False,
+    }
+    args.results.parent.mkdir(parents=True, exist_ok=True)
+    provisional = json.dumps(results, sort_keys=True, indent=2, allow_nan=False) + "\n"
+    args.results.write_text(provisional, encoding="utf-8")
+    results_hash = sha256(args.results)
+    report_results = dict(results)
+    report_results["custody"] = {"results_sha256": results_hash}
+    args.report.write_text(render_report(report_results), encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "event": "complete",
+                "factor": factor,
+                "results": str(args.results),
+                "report": str(args.report),
+                "semantic_payload_sha256": results_hash,
+                "file_sha256": sha256(args.results),
+                "report_sha256": sha256(args.report),
+            }
+        ),
+        flush=True,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
