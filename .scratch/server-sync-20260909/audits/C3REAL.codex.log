            "epochs": LEGACY_EPOCH_BUDGET,
            "batch": "one deterministic full-batch update per source epoch",
            "deterministic_pair_cap": PAIR_LIMIT,
            "learner_seed_domains": list(PILOT_LEARNER_DOMAINS),
            "learner_seeds": list(PILOT_LEARNER_SEEDS),
        },
        "metric_definitions": {
            "r2": "pooled held-out raw head levels, including exact-zero BASE rows; no test-time re-gauging",
            "pairwise_ordering": "all non-tied true pairs within held-out (anchor,user); prediction ties earn 0.5",
            "top1_accuracy": "stable argmax prediction is correct if its truth equals the group's maximum within 1e-12",
            "seed_summary": (
                "LOAO uses the first sealed pilot learner seed; LOWO values are arithmetic means "
