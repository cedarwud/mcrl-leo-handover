+#!/usr/bin/env python3
+"""Streaming held-out analysis for C3REAL exact catalogue rows."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+from typing import Iterable
+
+import numpy as np
+
+from mcrl.physics_v025.tapes import seed_from_domain
+from mcrl.stagec_v025.learner import AdamMLPHead, LEGACY_EPOCH_BUDGET, LEGACY_TRAINER_LITERALS
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+ROOT = Path(__file__).resolve().parents[2]
+EXPECTED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREAD_ENV = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+SEEDS = tuple(seed_from_domain(f"V025_LEARNER/seed/{index}") for index in range(1, 5))
+RIDGE_GRID = (0.01, 0.1, 1.0, 10.0, 100.0, 1000.0)
+
+
+def verify_runtime() -> None:
+    if Path(sys.executable).resolve() != EXPECTED_PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
+    if wrong:
+        raise RuntimeError(f"thread environment is not pinned: {wrong}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness below 15")
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def anchor_paths(rows: Path) -> list[Path]:
+    paths = sorted(rows.glob("world-*-step-*.npz"))
+    if not paths:
+        raise RuntimeError("no row files")
+    return paths
+
+
+def path_world(path: Path) -> int:
+    return int(path.name.split("-")[1])
+
+
+def load_anchor(path: Path, schema: str) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    cache = path.parent.parent / "fit-cache" / path.stem
+    cached = tuple(cache.with_name(f"{cache.name}-{key}.npy") for key in (
+        "target", "size", "coalition_indices", f"x_{schema}",
+    ))
+    if all(item.exists() for item in cached):
+        return tuple(np.load(item, mmap_mode="r", allow_pickle=False) for item in cached)
+    with np.load(path, allow_pickle=False) as data:
+        return (
+            np.asarray(data["target"], dtype=np.float64),
+            np.asarray(data["size"], dtype=np.int16),
+            np.asarray(data["coalition_indices"], dtype=np.int32),
+            np.asarray(data[f"x_{schema}"], dtype=np.float64),
+        )
+
+
+def load_reversed(path: Path, schema: str) -> np.ndarray | None:
+    cached = path.parent.parent / "fit-cache" / f"{path.stem}-x_{schema}_reversed.npy"
+    if cached.exists():
+        return np.load(cached, mmap_mode="r", allow_pickle=False)
+    with np.load(path, allow_pickle=False) as data:
+        key = f"x_{schema}_reversed"
+        return None if key not in data else np.asarray(data[key], dtype=np.float64)
+
+
+def split_paths(paths: list[Path], regime: str):
+    if regime == "loao":
+        return [([item for item in paths if item != test], [test], test.stem) for test in paths]
+    return [
+        ([item for item in paths if path_world(item) != world],
+         [item for item in paths if path_world(item) == world], f"world-{world}")
+        for world in (1, 2)
+    ]
+
+
+def pair_credit(truth: np.ndarray, prediction: np.ndarray) -> tuple[float, int]:
+    left, right = np.triu_indices(truth.size, 1)
+    target_delta = truth[left] - truth[right]
+    prediction_delta = prediction[left] - prediction[right]
+    keep = np.abs(target_delta) > 1e-12
+    target_delta = target_delta[keep]
+    prediction_delta = prediction_delta[keep]
+    credit = float(np.sum(np.sign(target_delta) == np.sign(prediction_delta)))
+    credit += 0.5 * float(np.sum(np.abs(prediction_delta) <= 1e-15))
+    return credit, int(target_delta.size)
+
+
+def subset_stats(truth: np.ndarray, prediction: np.ndarray) -> dict[str, float | int]:
+    credit, pairs = pair_credit(truth, prediction)
+    selected = int(np.argmax(prediction))
+    return {
+        "n": int(truth.size),
+        "sum": float(truth.sum()),
+        "sum2": float(np.square(truth).sum()),
+        "rss": float(np.square(truth - prediction).sum()),
+        "order_credit": credit,
+        "pairs": pairs,
+        "top1_hits": int(truth[selected] >= truth.max() - 1e-12),
+        "groups": 1,
+    }
+
+
+def anchor_stats(path: Path, truth: np.ndarray, size: np.ndarray, prediction: np.ndarray) -> dict[str, object]:
+    keep = size >= 2
+    return {
+        "anchor": path.stem,
+        "world": path_world(path),
+        "full": subset_stats(truth, prediction),
+        "nontrivial": subset_stats(truth[keep], prediction[keep]),
+    }
+
+
+def pooled(rows: Iterable[dict[str, object]], key: str = "full") -> dict[str, float | int]:
+    values = [row[key] for row in rows]
+    n = sum(int(row["n"]) for row in values)
+    total_ss = sum(float(row["sum2"]) for row in values) - sum(float(row["sum"]) for row in values) ** 2 / n
+    return {
+        "r2": 1.0 - sum(float(row["rss"]) for row in values) / total_ss,
+        "pairwise_ordering": sum(float(row["order_credit"]) for row in values) / sum(int(row["pairs"]) for row in values),
+        "top1_accuracy": sum(int(row["top1_hits"]) for row in values) / sum(int(row["groups"]) for row in values),
+        "rows": n,
+        "pairs": sum(int(row["pairs"]) for row in values),
+        "groups": sum(int(row["groups"]) for row in values),
+    }
+
+
+def summarize_seeds(seed_rows: list[dict[str, object]]) -> dict[str, object]:
+    metrics = [pooled(row["anchors"], "full") for row in seed_rows]
+    sensitivity = [pooled(row["anchors"], "nontrivial") for row in seed_rows]
+    result = {
+        key: float(np.mean([float(row[key]) for row in metrics]))
+        for key in ("r2", "pairwise_ordering", "top1_accuracy")
+    }
+    result["nontrivial_sensitivity"] = {
+        key: float(np.mean([float(row[key]) for row in sensitivity]))
+        for key in ("r2", "pairwise_ordering", "top1_accuracy")
+    }
+    result["per_seed"] = [
+        {"seed": row["seed"], "metrics": metric, "nontrivial_sensitivity": sense}
+        for row, metric, sense in zip(seed_rows, metrics, sensitivity, strict=True)
+    ]
+    return result
+
+
+def bootstrap(seed_rows: list[dict[str, object]], replicates: int = 2000) -> dict[str, object]:
+    names = [row["anchor"] for row in seed_rows[0]["anchors"]]
+    by_seed = [{row["anchor"]: row for row in seed["anchors"]} for seed in seed_rows]
+    rng = np.random.default_rng(seed_from_domain("C3REAL/anchor-bootstrap/2026-09-10"))
+    draws = {key: [] for key in ("r2", "pairwise_ordering", "top1_accuracy")}
+    for _ in range(replicates):
+        selected = [names[int(index)] for index in rng.integers(0, len(names), len(names))]
+        per_seed = [pooled([mapping[name] for name in selected], "full") for mapping in by_seed]
+        for key in draws:
+            draws[key].append(float(np.mean([float(row[key]) for row in per_seed])))
+    return {
+        "unit": "anchor", "clusters": len(names), "replicates": replicates,
+        "seed": seed_from_domain("C3REAL/anchor-bootstrap/2026-09-10"),
+        "intervals": {
+            key: {
+                "lower_2_5pct": float(np.quantile(values, 0.025)),
+                "upper_97_5pct": float(np.quantile(values, 0.975)),
+                "bootstrap_se": float(np.std(values, ddof=1)),
+            }
+            for key, values in draws.items()
+        },
+    }
+
+
+def fit_adam(train: list[Path], schema: str, width: int, seed: int) -> AdamMLPHead:
+    first = load_anchor(train[0], schema)[3]
+    literal = dict(LEGACY_TRAINER_LITERALS["C3"])
+    literal["hidden_layers"] = (width, width)
+    head = AdamMLPHead.create(first.shape[1], literal, np.random.default_rng(seed))
+    del first
+    for epoch in range(LEGACY_EPOCH_BUDGET):
+        grad_w = [np.zeros_like(value) for value in head.weights]
+        grad_b = [np.zeros_like(value) for value in head.biases]
+        count = 0
+        for path in train:
+            truth, _size, indices, x = load_anchor(path, schema)
+            target = truth[indices]
+            prediction, activations, preactivations = head._forward(x)
+            chunk_w, chunk_b = head._backward(activations, preactivations, prediction - target)
+            for total, chunk in zip(grad_w, chunk_w, strict=True):
+                total += chunk
+            for total, chunk in zip(grad_b, chunk_b, strict=True):
+                total += chunk
+            count += target.size
+            del truth, indices, x, target, prediction, activations, preactivations, chunk_w, chunk_b
+        scale = 2.0 * head.loss_weight / count
+        head._adam([value * scale for value in grad_w], [value * scale for value in grad_b])
+        if (epoch + 1) % 250 == 0:
+            print(json.dumps({"event": "epoch", "epoch": epoch + 1, "train_rows": count}), flush=True)
+    return head
+
+
+def predict_adam(head: AdamMLPHead, path: Path, schema: str) -> tuple[np.ndarray, float, int]:
+    truth, size, indices, x = load_anchor(path, schema)
+    prediction = np.zeros_like(truth)
+    prediction[indices] = head._forward(x)[0]
+    reversed_x = load_reversed(path, schema)
+    max_delta = 0.0
+    violations = 0
+    if reversed_x is not None:
+        reversed_prediction = head._forward(reversed_x)[0]
+        delta = np.abs(prediction[indices] - reversed_prediction)
+        max_delta = float(delta.max(initial=0.0))
+        violations = int(np.sum(delta > 1e-12))
+    return prediction, max_delta, violations
+
+
+def mean_target(paths: list[Path], *, nontrivial: bool) -> float:
+    total = 0.0
+    count = 0
+    for path in paths:
+        truth, size, _indices, _x = load_anchor(path, "v2")
+        keep = size >= 2 if nontrivial else np.ones(size.shape, dtype=bool)
+        total += float(truth[keep].sum())
+        count += int(keep.sum())
+    return total / count
+
+
+def linear_sufficient(paths: list[Path], schema: str, mean, scale):
+    dimension = load_anchor(paths[0], schema)[3].shape[1] + 1
+    gram = np.zeros((dimension, dimension), dtype=np.float64)
+    rhs = np.zeros(dimension, dtype=np.float64)
+    for path in paths:
+        truth, _size, indices, x = load_anchor(path, schema)
+        design = np.column_stack(((x - mean) / scale, np.ones(x.shape[0])))
+        gram += design.T @ design
+        rhs += design.T @ truth[indices]
+    return gram, rhs
+
+
+def linear_fit(paths: list[Path], schema: str):
+    validation_count = max(2, len(paths) // 5)
+    validation = paths[-validation_count:]
+    subtrain = paths[:-validation_count]
+    sub_mean, sub_scale = stream_mean_scale(subtrain, schema)
+    gram, rhs = linear_sufficient(subtrain, schema, sub_mean, sub_scale)
+    choices = []
+    for ridge in RIDGE_GRID:
+        coefficient = np.linalg.solve(gram + ridge * np.eye(gram.shape[0]), rhs)
+        rss = total = total2 = 0.0
+        count = 0
+        for path in validation:
+            truth, _size, indices, x = load_anchor(path, schema)
+            prediction = np.column_stack(((x - sub_mean) / sub_scale, np.ones(x.shape[0]))) @ coefficient
+            target = truth[indices]
+            rss += float(np.square(target - prediction).sum())
+            total += float(target.sum())
+            total2 += float(np.square(target).sum())
+            count += target.size
+        choices.append((1.0 - rss / (total2 - total * total / count), ridge))
+    ridge = float(max(choices, key=lambda row: (row[0], -row[1]))[1])
+    mean, scale = stream_mean_scale(paths, schema)
+    gram, rhs = linear_sufficient(paths, schema, mean, scale)
+    coefficient = np.linalg.solve(gram + ridge * np.eye(gram.shape[0]), rhs)
+    return coefficient, mean, scale, ridge
+
+
+def stream_mean_scale(paths: list[Path], schema: str) -> tuple[np.ndarray, np.ndarray]:
+    dimension = load_anchor(paths[0], schema)[3].shape[1]
+    total = np.zeros(dimension)
+    total2 = np.zeros(dimension)
+    count = 0
+    for path in paths:
+        x = load_anchor(path, schema)[3]
+        total += x.sum(axis=0)
+        total2 += np.square(x).sum(axis=0)
+        count += x.shape[0]
+    mean = total / count
+    scale = np.sqrt(np.maximum(total2 / count - np.square(mean), 0.0))
+    scale[scale == 0.0] = 1.0
+    return mean, scale
+
+
+def random_parameters(input_dim: int, seed: int):
+    rng = np.random.default_rng(seed)
+    w1 = rng.normal(0.0, math.sqrt(2.0 / input_dim), (input_dim, 256))
+    b1 = rng.normal(0.0, 0.1, 256)
+    w2 = rng.normal(0.0, math.sqrt(2.0 / 256), (256, 256))
+    b2 = rng.normal(0.0, 0.1, 256)
+    return w1, b1, w2, b2
+
+
+def random_design(x: np.ndarray, mean: np.ndarray, scale: np.ndarray, parameters) -> np.ndarray:
+    normalized = (x - mean) / scale
+    w1, b1, w2, b2 = parameters
+    hidden1 = np.maximum(normalized @ w1 + b1, 0.0)
+    hidden2 = np.maximum(hidden1 @ w2 + b2, 0.0)
+    return np.column_stack((normalized, hidden1, hidden2, np.ones(x.shape[0])))
+
+
+def rf_sufficient(paths: list[Path], schema: str, mean, scale, parameters):
+    dimension = mean.size + 513
+    gram = np.zeros((dimension, dimension))
+    rhs = np.zeros(dimension)
+    for path in paths:
+        truth, _size, indices, x = load_anchor(path, schema)
+        design = random_design(x, mean, scale, parameters)
+        gram += design.T @ design
+        rhs += design.T @ truth[indices]
+    return gram, rhs
+
+
+def high_capacity_fit(train: list[Path], schema: str, seed: int):
+    validation_count = max(2, len(train) // 5)
+    validation = train[-validation_count:]
+    subtrain = train[:-validation_count]
+    input_dim = load_anchor(train[0], schema)[3].shape[1]
+    parameters = random_parameters(input_dim, seed)
+    sub_mean, sub_scale = stream_mean_scale(subtrain, schema)
+    gram, rhs = rf_sufficient(subtrain, schema, sub_mean, sub_scale, parameters)
+    eigenvalues, eigenvectors = np.linalg.eigh(gram)
+    projected_rhs = eigenvectors.T @ rhs
+    validation_scores = []
+    for ridge in RIDGE_GRID:
+        coefficient = eigenvectors @ (projected_rhs / (eigenvalues + ridge))
+        rss = total = total2 = 0.0
+        count = 0
+        for path in validation:
+            truth, _size, indices, x = load_anchor(path, schema)
+            prediction = random_design(x, sub_mean, sub_scale, parameters) @ coefficient
+            target = truth[indices]
+            rss += float(np.square(target - prediction).sum())
+            total += float(target.sum())
+            total2 += float(np.square(target).sum())
+            count += target.size
+        tss = total2 - total * total / count
+        validation_scores.append((1.0 - rss / tss, ridge))
+    ridge = float(max(validation_scores, key=lambda row: (row[0], -row[1]))[1])
+    mean, scale = stream_mean_scale(train, schema)
+    gram, rhs = rf_sufficient(train, schema, mean, scale, parameters)
+    coefficient = np.linalg.solve(gram + ridge * np.eye(gram.shape[0]), rhs)
+    return mean, scale, parameters, coefficient, ridge
+
+
+def run(args, paths: list[Path]) -> dict[str, object]:
+    seeds = SEEDS[:1] if args.regime == "loao" else SEEDS
+    seed_outputs = []
+    invariant_max = 0.0
+    invariant_violations = 0
+    ridge_choices = []
+    started = time.perf_counter()
+    for seed in seeds:
+        stats = []
+        for fold_index, (train, test, fold) in enumerate(split_paths(paths, args.regime)):
+            fit_started = time.perf_counter()
+            if args.model == "adam":
+                fitted = fit_adam(train, args.schema, args.width, seed)
+            elif args.model == "linear":
+                fitted = linear_fit(train, args.schema)
+                ridge_choices.append(fitted[-1])
+            elif args.model == "high_capacity":
+                fitted = high_capacity_fit(train, args.schema, seed)
+                ridge_choices.append(fitted[-1])
+            elif args.model in {"constant", "anchored_constant"}:
+                fitted = mean_target(train, nontrivial=args.model == "anchored_constant")
+            else:
+                raise RuntimeError("unknown model")
+            for path in test:
+                truth, size, indices, x = load_anchor(path, args.schema)
+                if args.model == "adam":
+                    prediction, delta, violations = predict_adam(fitted, path, args.schema)
+                    invariant_max = max(invariant_max, delta)
+                    invariant_violations += violations
+                elif args.model == "linear":
+                    prediction = np.zeros_like(truth)
+                    coefficient, mean, scale, _ridge = fitted
+                    prediction[indices] = np.column_stack(((x - mean) / scale, np.ones(x.shape[0]))) @ coefficient
+                elif args.model == "high_capacity":
+                    mean, scale, parameters, coefficient, _ridge = fitted
+                    prediction = np.zeros_like(truth)
+                    prediction[indices] = random_design(x, mean, scale, parameters) @ coefficient
+                elif args.model == "constant":
+                    prediction = np.full_like(truth, fitted)
+                else:
+                    prediction = np.zeros_like(truth)
+                    prediction[indices] = fitted
+                stats.append(anchor_stats(path, truth, size, prediction))
+            print(json.dumps({
+                "event": "fold", "seed": seed, "fold": fold,
+                "fold_index": fold_index, "fit_wall_s": time.perf_counter() - fit_started,
+            }), flush=True)
+        seed_outputs.append({"seed": seed, "anchors": stats})
+    summary = summarize_seeds(seed_outputs)
+    result = {
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "schema": args.schema,
+        "model": args.model,
+        "width": args.width if args.model == "adam" else None,
+        "regime": args.regime,
+        "epochs": LEGACY_EPOCH_BUDGET if args.model == "adam" else None,
+        "seeds": list(seeds),
+        "metrics": summary,
+        "anchor_bootstrap": bootstrap(seed_outputs),
+        "permutation_invariance": {
+            "member_reversal_score_max_abs": invariant_max,
+            "violations_over_1e-12": invariant_violations,
+        } if args.model == "adam" else None,
+        "ridge_choices": ridge_choices,
+        "wall_s": time.perf_counter() - started,
+        "input_sha256": {path.name: file_sha256(path) for path in paths},
+    }
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--rows", type=Path, required=True)
+    parser.add_argument("--schema", choices=("v1", "v2"), required=True)
+    parser.add_argument("--model", choices=("adam", "linear", "constant", "anchored_constant", "high_capacity"), required=True)
+    parser.add_argument("--width", type=int, default=64)
+    parser.add_argument("--regime", choices=("loao", "lowo"), required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    verify_runtime()
+    paths = anchor_paths(args.rows)
+    result = run(args, paths)
+    peak = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    result["resource_policy"] = {
+        "python_processes": 1, "nice": os.nice(0), "blas_threads": 1,
+        "rlimit_as_bytes": RSS_LIMIT_BYTES, "peak_rss_kb": peak,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(f"PEAK_RSS_KB={peak}", flush=True)
+    print(json.dumps({"written": str(args.output), "metrics": result["metrics"]}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
