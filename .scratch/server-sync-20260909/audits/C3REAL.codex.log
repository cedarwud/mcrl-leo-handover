        ),
        "input_sha256": {
            str(path.resolve().relative_to(ROOT)): file_sha256(path) for path in args.inputs
        },
        "shortfall_reason": (
            "Exact anchors stabilized near 6-8 minutes and one shutdown-race anchor took 1721.8 s; "
