def phi_cv(data: Dataset, regime: str) -> tuple[dict[str, object], np.ndarray]:
    prediction = data.phi.copy()
    return metric(prediction, data.declared_y, data.group), prediction


def random_feature_map(x: np.ndarray, mean: np.ndarray, scale: np.ndarray, seed: int) -> np.ndarray:
    normalized = (x - mean) / scale
    rng = np.random.default_rng(seed)
    w1 = rng.normal(0.0, math.sqrt(2.0 / x.shape[1]), (x.shape[1], 256))
    b1 = rng.normal(0.0, 0.1, 256)
    hidden1 = np.maximum(normalized @ w1 + b1, 0.0)
    w2 = rng.normal(0.0, math.sqrt(2.0 / 256), (256, 256))
    b2 = rng.normal(0.0, 0.1, 256)
    hidden2 = np.maximum(hidden1 @ w2 + b2, 0.0)
    return np.column_stack((normalized, hidden1, hidden2, np.ones(x.shape[0])))


def high_capacity_cv(
    data: Dataset, regime: str, *, keep_models: bool = False
) -> tuple[dict[str, object], np.ndarray, list[dict[str, object]]]:
    x, y = data.exact_x, data.declared_y
