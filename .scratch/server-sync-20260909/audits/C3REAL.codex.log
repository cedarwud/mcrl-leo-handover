new file mode 100644
index 0000000000000000000000000000000000000000..3fe6739be62139012d406cfb195ffb27a96b706e
--- /dev/null
+++ b/.scratch/c3-declared/verify_final.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Final streaming consistency check for the C3REAL diagnostic."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import resource
+import sys
+
+import numpy as np
+
+
+LIMIT = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (LIMIT, LIMIT))
+ROOT = Path(__file__).resolve().parents[2]
+BASE = ROOT / ".scratch/c3-declared"
+EXPECTED = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREADS = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    if Path(sys.executable).resolve() != EXPECTED:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness below 15")
+    wrong = {key: os.environ.get(key) for key in THREADS if os.environ.get(key) != "1"}
+    if wrong:
+        raise RuntimeError(f"thread environment is not pinned: {wrong}")
+    rows = sorted((BASE / "rows").glob("world-*-step-*.npz"))
+    assert len(rows) == 37
+    histogram: dict[int, int] = {}
+    singleton_max = 0.0
+    total = 0
+    for path in rows:
+        with np.load(path, allow_pickle=False) as data:
+            target = np.asarray(data["target"])
+            size = np.asarray(data["size"])
+            assert data["x_v1"].shape[1] == 328
+            assert data["x_v2"].shape[1] == 324
+        total += target.size
+        for value, count in zip(*np.unique(size, return_counts=True), strict=True):
+            histogram[int(value)] = histogram.get(int(value), 0) + int(count)
+        singleton_max = max(singleton_max, float(np.abs(target[size == 1]).max(initial=0.0)))
+        del target, size
+    summary = json.loads((BASE / "row-summary.json").read_text())
+    assert total == summary["rows"] == 36788
+    assert {str(k): v for k, v in histogram.items()} == summary["size_histogram"]
+    assert singleton_max == summary["max_singleton"] == 0.0
+    required = []
+    for schema in ("v1", "v2"):
+        for model in ("linear", "high_capacity"):
+            for regime in ("loao", "lowo"):
+                required.append(BASE / "results" / f"{schema}-{model}-{regime}.json")
+        for regime in ("loao", "lowo"):
+            required.append(BASE / "results" / f"{schema}-adam64-{regime}.json")
+    required.extend([
+        BASE / "results/v2-constant-loao.json",
+        BASE / "results/v2-constant-lowo.json",
+        BASE / "results/v2-anchored_constant-loao.json",
+        BASE / "results/v2-anchored_constant-lowo.json",
+        BASE / "results/v2-adam96-lowo.json",
+        BASE / "results/v2-adam128-lowo.json",
+    ])
+    for path in required:
+        payload = json.loads(path.read_text())
+        assert payload["anchor_bootstrap"]["replicates"] == 2000
+        assert payload["resource_policy"]["peak_rss_kb"] < 5 * 1024**2
+    report = (ROOT / "C3-DECLARED-TARGET-LEARNABILITY-2026-09-10.md").read_text()
+    assert report.startswith("**On repaired v2")
+    assert "PENDING" not in report
+    watched = {
+        "pilot": ROOT / "scripts/run_v025_pilot_c3.py",
+        "learner": ROOT / "src/mcrl/stagec_v025/learner.py",
+        "coalitions": ROOT / "src/mcrl/stagec_v025/coalitions.py",
+        "state": ROOT / "src/mcrl/stagec_v025/state.py",
+        "v2": Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py"),
+    }
+    current = {key: sha256(path) for key, path in watched.items()}
+    expected = {
+        "pilot": "95103bb96caaa130659fa0d509f19409574b406798a173e278a7d9dac12b7435",
+        "learner": "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+        "coalitions": "20ba106f3ec9cacf894364849b42784e70e63982ade0963d861edfa73e19ec0f",
+        "state": "fe39e9c5b945358fe1851aebaa99ca673540a50ab6d0a6f7080664d1614e3f58",
+        "v2": "300c74174efb4c518011a1bfc4186d5036c0ecfac809f6bdf0dcfe4744430c06",
+    }
+    assert current == expected
+    peak = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    print(json.dumps({"status": "PASS", "anchors": len(rows), "rows": total, "histogram": histogram, "result_files": len(required)}))
+    print(f"PEAK_RSS_KB={peak}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/C3-DECLARED-TARGET-LEARNABILITY-2026-09-10.md b/C3-DECLARED-TARGET-LEARNABILITY-2026-09-10.md
new file mode 100644
index 0000000000000000000000000000000000000000..a7db4b79c92e07232921659234b3ca89fc62aa53
--- /dev/null
+++ b/C3-DECLARED-TARGET-LEARNABILITY-2026-09-10.md
@@ -0,0 +1,307 @@
+**On repaired v2, the sealed C3 head's LOAO ordering is `0.5484` (`0.5797` on `|A|>=2`), level `R²` is `-0.0685`, and top-1 is `0.3243` versus the anchor-respecting constant floor `0.2973`; the catalogue sizes are `{0:37, 1:28,960, 2:7,104, 3:292, 4:177, 5:125, 6:4, 7:12, 8:3, 100:74}`, and the empirical ceiling is mixed—architectural/optimization-limited for level calibration but informational-looking for coalition selection.**
+
+`DIAGNOSTIC_NOT_CLAIM`
+
+## Structural result before model statistics
+
+[RUN] The exact bounded catalogue contains 36,788 candidates at 37 anchors.
+The coalition-size distribution is:
+
+| `|A|` | rows | share of full catalogue |
+|---:|---:|---:|
+| 0 | 37 | 0.101% |
+| 1 | 28,960 | 78.721% |
+| 2 | 7,104 | 19.311% |
+| 3 | 292 | 0.794% |
+| 4 | 177 | 0.481% |
+| 5 | 125 | 0.340% |
+| 6 | 4 | 0.011% |
+| 7 | 12 | 0.033% |
+| 8 | 3 | 0.008% |
+| 100 | 74 | 0.201% |
+
+[DERIVED] Empty sets and singletons are 28,997/36,788 = 78.822% of the
+full evaluation support. They are not optimizer rows: the declared head returns
+zero without calling its network for `|A| <= 1`. The actual scalar-fit support
+is 7,791 rows with `|A| >= 2`; 7,104/7,791 = 91.181% of those rows are pairs.
+Thus the full support is dominated by trivial structural zeros and even the
+nontrivial support is dominated by pairs. Full-support fit statistics cannot be
+read as broad evidence about large coalitions. I therefore report the requested
+full-catalogue metrics and an explicit `|A| >= 2` sensitivity beside them.
+
+[RUN] Before fitting, all 28,960 singleton targets were exactly zero (maximum
+absolute value `0.0`); all 37 empty targets were also exactly zero. The maximum
+absolute residual in the normalized identity
+`joint/kappa - additive/kappa - Psi_A/kappa` was `2.8422e-14` over all 36,788
+candidates.
+
+## Answer
+
+[RUN] The declared target is only **weakly and metric-dependently learnable** on
+the repaired schema. V2 LOAO ordering is above chance and its bootstrap interval
+excludes 0.5, but level `R²` is negative and its interval crosses zero. Top-1 is
+`0.3243`, only `+0.0270` above the anchor-respecting constant floor, with
+overlapping intervals. The two-world LOWO check is more favorable for levels
+(`R² = 0.3328`) but full-support ordering is `0.4913`; removing the structural
+zero stratum changes that ordering to `0.5578`.
+
+[INFERRED] This is not a clean “unlearnable” result, but it is not a robust
+positive learnability result either. The route contains transferable level
+information, while reliable within-anchor coalition selection remains weak.
+
+## Evidence labels and scope
+
+- `[RUN]` means verified by running the required interpreter against the current
+  exact-path code and generated rows.
+- `[DERIVED]` means arithmetic or algebra applied to run outputs and declarations.
+- `[INFERRED]` is the stated interpretation of those measurements.
+
+[RUN] This was a declared-target predictive-quality diagnostic only. It ran no
+production training, policy, acceptance test, or EE endpoint. Loss values are
+never evidence about EE, no loss is used as such here, and this report makes no
+EE claim. No sealed source, constant, schema, threshold, sign, seed, horizon,
+price, control law, or optimizer setting was changed.
+
