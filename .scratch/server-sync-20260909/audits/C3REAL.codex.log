            ),
        },
        "models": models,
        "capacity": {"widths": capacity_widths, "high_capacity": high_capacity},
        "slot_audit": slot_audit(data),
        "permutation_importance": permutation,
        "primary_loao_anchor_bootstrap": bootstrap,
        "limitations": [
