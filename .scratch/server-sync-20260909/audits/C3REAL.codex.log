        ),
        "power": {
            "analyzed_anchor_clusters": int(len(np.unique(data.anchor))),
            "generated_anchor_clusters": len(all_generated),
            "world_clusters": int(len(np.unique(data.world))),
            "user_option_groups": int(len(np.unique(data.group))),
            "note": (
                "Anchor-level replication is 37, but LOWO has only two world clusters and therefore "
                "no powered population-of-worlds inference."
            ),
        },
    }
    result = {
        "schema": "c1-declared-target-learnability-diagnostic-v1",
        "status": "DIAGNOSTIC_NOT_CLAIM",
        "generated_utc_date": "2026-09-10",
        "generation": generation,
        "learner_contract": {
            "hidden_layers": [8],
            "activation": "relu",
            "learning_rate": 1e-2,
            "gauge_beta": 0.2,
