index 0000000000000000000000000000000000000000..0e463020a497512b8a82a7fa91468b30414e4ac3
--- /dev/null
+++ b/.scratch/c3-declared/verify_final.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Final streaming consistency check for the C3REAL diagnostic."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import resource
+import sys
+
+import numpy as np
+
+
+LIMIT = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (LIMIT, LIMIT))
+ROOT = Path(__file__).resolve().parents[2]
+BASE = ROOT / ".scratch/c3-declared"
+EXPECTED = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREADS = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    if Path(sys.executable).resolve() != EXPECTED:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness below 15")
+    wrong = {key: os.environ.get(key) for key in THREADS if os.environ.get(key) != "1"}
+    if wrong:
+        raise RuntimeError(f"thread environment is not pinned: {wrong}")
+    rows = sorted((BASE / "rows").glob("world-*-step-*.npz"))
+    assert len(rows) == 37
+    histogram: dict[int, int] = {}
+    singleton_max = 0.0
+    total = 0
+    for path in rows:
+        with np.load(path, allow_pickle=False) as data:
+            target = np.asarray(data["target"])
+            size = np.asarray(data["size"])
+            assert data["x_v1"].shape[1] == 328
+            assert data["x_v2"].shape[1] == 324
+        total += target.size
+        for value, count in zip(*np.unique(size, return_counts=True), strict=True):
+            histogram[int(value)] = histogram.get(int(value), 0) + int(count)
+        singleton_max = max(singleton_max, float(np.abs(target[size == 1]).max(initial=0.0)))
+        del target, size
+    summary = json.loads((BASE / "row-summary.json").read_text())
+    assert total == summary["rows"] == 36788
+    assert {str(k): v for k, v in histogram.items()} == summary["size_histogram"]
+    assert singleton_max == summary["max_singleton"] == 0.0
+    required = []
+    for schema in ("v1", "v2"):
+        for model in ("linear", "high_capacity"):
+            for regime in ("loao", "lowo"):
+                required.append(BASE / "results" / f"{schema}-{model}-{regime}.json")
+        for regime in ("loao", "lowo"):
+            required.append(BASE / "results" / f"{schema}-adam64-{regime}.json")
+    required.extend([
+        BASE / "results/v2-constant-loao.json",
+        BASE / "results/v2-constant-lowo.json",
+        BASE / "results/v2-anchored_constant-loao.json",
+        BASE / "results/v2-anchored_constant-lowo.json",
+        BASE / "results/v2-adam128-lowo.json",
+    ])
+    for path in required:
+        payload = json.loads(path.read_text())
+        assert payload["anchor_bootstrap"]["replicates"] == 2000
+        assert payload["resource_policy"]["peak_rss_kb"] < 5 * 1024**2
+    report = (ROOT / "C3-DECLARED-TARGET-LEARNABILITY-2026-09-10.md").read_text()
+    assert report.startswith("**On repaired v2")
+    assert "PENDING" not in report
+    watched = {
+        "pilot": ROOT / "scripts/run_v025_pilot_c3.py",
+        "learner": ROOT / "src/mcrl/stagec_v025/learner.py",
+        "coalitions": ROOT / "src/mcrl/stagec_v025/coalitions.py",
+        "state": ROOT / "src/mcrl/stagec_v025/state.py",
+        "v2": Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py"),
+    }
+    current = {key: sha256(path) for key, path in watched.items()}
+    expected = {
+        "pilot": "95103bb96caaa130659fa0d509f19409574b406798a173e278a7d9dac12b7435",
+        "learner": "09fc781b273f42fce3913c57150187a18f05b100155027c53e023abae3f46a01",
+        "coalitions": "20ba106f3ec9cacf894364849b42784e70e63982ade0963d861edfa73e19ec0f",
+        "state": "fe39e9c5b945358fe1851aebaa99ca673540a50ab6d0a6f7080664d1614e3f58",
+        "v2": "300c74174efb4c518011a1bfc4186d5036c0ecfac809f6bdf0dcfe4744430c06",
+    }
+    assert current == expected
+    peak = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    print(json.dumps({"status": "PASS", "anchors": len(rows), "rows": total, "histogram": histogram, "result_files": len(required)}))
+    print(f"PEAK_RSS_KB={peak}")
+
+
+if __name__ == "__main__":
+    main()
