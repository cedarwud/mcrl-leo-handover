+#!/usr/bin/env python3
+"""Expand each exact-row archive separately for low-memory repeated fit reads."""
+
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path
+import resource
+import sys
+
+import numpy as np
+
+
+LIMIT = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (LIMIT, LIMIT))
+EXPECTED = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
+THREADS = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS")
+KEYS = ("target", "size", "coalition_indices", "x_v1", "x_v2", "x_v1_reversed", "x_v2_reversed")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--rows", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if Path(sys.executable).resolve() != EXPECTED:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness below 15")
+    wrong = {key: os.environ.get(key) for key in THREADS if os.environ.get(key) != "1"}
+    if wrong:
+        raise RuntimeError(f"thread environment is not pinned: {wrong}")
+    args.output.mkdir(parents=True, exist_ok=True)
+    count = 0
+    for source in sorted(args.rows.glob("world-*-step-*.npz")):
+        with np.load(source, allow_pickle=False) as data:
+            arrays = {key: np.asarray(data[key]) for key in KEYS}
+        for key, value in arrays.items():
+            np.save(args.output / f"{source.stem}-{key}.npy", value, allow_pickle=False)
+        del arrays
+        count += 1
+    peak = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    print(f"CACHED_ANCHORS={count}")
+    print(f"PEAK_RSS_KB={peak}")
+
+
+if __name__ == "__main__":
+    main()
