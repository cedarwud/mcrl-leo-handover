# C3 argmax reachability diagnostic

Completion criterion: one deterministic invocation of `measure.py` must write
`results.json` and `C3-ARGMAX-REACHABILITY-2026-09-10.md` after measuring at
least 20 real pilot anchors.  It must compare the same FULL-model additive
scores with no interaction, learned interaction, and exact `_exact_interactions`
Psi; reproduce the deployed lexicographic tie-break; classify one-ULP ties;
and evaluate both choices from every changed decision over all 48 committed
boundaries with the per-user `50 Mbit/s * 30.08 s` numerator cap.

The diagnostic is read-only except for its two requested outputs.  It uses the
final epoch-2000 FULL checkpoints already present in the pilot artifact and
does not train, alter a sealed setting, or open a claim/test split.
#!/usr/bin/env python3
"""DIAGNOSTIC_NOT_CLAIM: measure C3 catalogue-argmax reachability."""

from __future__ import annotations

import argparse
from collections import Counter
import hashlib
import json
import math
import os
from pathlib import Path
import sys
import time
from typing import Iterable, Mapping, Sequence


ROOT = Path(__file__).resolve().parents[2]
INVOKED_PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
EXPECTED_PYTHON = INVOKED_PYTHON.resolve()
PILOT_OUTPUT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
EXECUTION_SOURCE = ROOT / ".scratch/epoch-trend/clean-source/src"
DEFAULT_RESULTS = ROOT / ".scratch/c3-reach/results.json"
DEFAULT_REPORT = ROOT / "C3-ARGMAX-REACHABILITY-2026-09-10.md"
THREAD_ENV = (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
)
DEMAND_RATE_BPS = 50_000_000.0
DECISION_INTERVAL_S = 47 * 0.640
DEMAND_CAP_BITS = DEMAND_RATE_BPS * DECISION_INTERVAL_S
MODEL_EPOCH = 2_000
MODEL_BATCH_ANCHORS_FOR_RESTORE = 5
LABEL = "DIAGNOSTIC_NOT_CLAIM"


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def quantiles(values: Iterable[float]) -> dict[str, float | None]:
    ordered = sorted(float(value) for value in values)
    if not ordered:
        return {key: None for key in ("min", "p05", "p50", "p95", "max")}

    def linear(q: float) -> float:
        position = q * (len(ordered) - 1)
        low = int(math.floor(position))
        high = int(math.ceil(position))
        if low == high:
            return ordered[low]
        return ordered[low] + (ordered[high] - ordered[low]) * (position - low)

    return {
        "min": ordered[0],
        "p05": linear(0.05),
        "p50": linear(0.50),
        "p95": linear(0.95),
        "max": ordered[-1],
    }


def fmt(value: float | None, digits: int = 6) -> str:
    return "NA" if value is None else f"{value:.{digits}g}"


def within_one_ulp(first: float, second: float) -> bool:
    return abs(first - second) <= max(math.ulp(first), math.ulp(second))


def rank(scores: Mapping[str, float]) -> list[tuple[str, float]]:
    return sorted(scores.items(), key=lambda row: (-row[1], row[0]))


def spread(scores: Mapping[str, float]) -> dict[str, object]:
    ordered = rank(scores)
    top_id, top = ordered[0]
    second_id, second = ordered[1]
    bottom = ordered[-1][1]
    gap = top - second
    return {
        "argmax_configuration_id": top_id,
        "top_score": top,
        "top_score_hex": top.hex(),
        "second_configuration_id": second_id,
        "second_score": second,
        "second_score_hex": second.hex(),
        "max_minus_second_max": gap,
        "max_minus_second_max_hex": gap.hex(),
        "full_range": top - bottom,
        "full_range_hex": (top - bottom).hex(),
        "top_two_exactly_equal": top == second,
        "top_two_within_one_ulp": within_one_ulp(top, second),
    }


def choice_change(
    additive_scores: Mapping[str, float],
    with_scores: Mapping[str, float],
) -> dict[str, object]:
    without = rank(additive_scores)[0][0]
    with_term = rank(with_scores)[0][0]
    changed = without != with_term
    with_margin = with_scores[with_term] - with_scores[without]
    without_margin = additive_scores[without] - additive_scores[with_term]
    with_tie = changed and with_scores[with_term] == with_scores[without]
    without_tie = changed and additive_scores[without] == additive_scores[with_term]
    return {
        "changed": changed,
        "without_configuration_id": without,
        "with_configuration_id": with_term,
        "with_winner_margin_over_without_choice": with_margin,
        "without_winner_margin_over_with_choice": without_margin,
        "final_ranking_tie_break_flip": bool(with_tie),
        "involves_any_exact_tie": bool(with_tie or without_tie),
        "involves_any_within_one_ulp": bool(
            changed
            and (
                within_one_ulp(with_scores[with_term], with_scores[without])
                or within_one_ulp(additive_scores[without], additive_scores[with_term])
            )
        ),
    }


def score_terms(terms: Mapping[str, float]) -> dict[str, object]:
    result = spread(terms)
    result["min"] = min(terms.values())
    result["max"] = max(terms.values())
    return result


def profile_receipt(profile) -> dict[str, float]:
    capped = math.fsum(min(float(value), DEMAND_CAP_BITS) for value in profile.score.bits.values())
    joules = float(profile.joules)
    return {
        "reported_capped_bits": capped,
        "uncapped_bits_diagnostic_only": float(profile.bits),
        "joules": joules,
        "reported_ee_bits_per_j": capped / joules,
    }


def pooled_ee(events: Sequence[Mapping[str, object]], side: str) -> dict[str, object]:
    profiles = [event[side] for event in events]
    bits = math.fsum(float(row["reported_capped_bits"]) for row in profiles)
    joules = math.fsum(float(row["joules"]) for row in profiles)
    return {
        "event_count": len(profiles),
        "reported_capped_bits": bits,
        "joules": joules,
        "pooled_reported_ee_bits_per_j": None if not profiles else bits / joules,
    }


def load_pilot():
    source = str(EXECUTION_SOURCE)
    scripts = str(ROOT / "scripts")
    if source not in sys.path:
        sys.path.insert(0, source)
    if scripts not in sys.path:
        sys.path.insert(0, scripts)
    import run_v025_pilot_c3 as pilot

    pilot.LEARNER_SEEDS = tuple(pilot.LEARNER_SEEDS)
    pilot.PILOT_ARMS = ("FULL",)
    pilot.EVAL_EPOCH = MODEL_EPOCH
    pilot.ROW_WORLD_GLOB = "world-1"
    pilot.ROW_ANCHOR_LIMIT = MODEL_BATCH_ANCHORS_FOR_RESTORE
    _rows, _training, calibration, payloads, batches = pilot._load_completed_training(
        PILOT_OUTPUT
    )
    models = pilot._restore_models(payloads, batches)
    return pilot, calibration, models


def verify_runtime() -> None:
    actual = Path(sys.executable).resolve()
    if actual != EXPECTED_PYTHON:
        raise RuntimeError(f"wrong interpreter: {actual}; expected {EXPECTED_PYTHON}")
    wrong = {name: os.environ.get(name) for name in THREAD_ENV if os.environ.get(name) != "1"}
    if wrong:
        raise RuntimeError(f"BLAS/thread environment is not pinned to one: {wrong}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below required nice -n 15")


def model_provenance(pilot) -> list[dict[str, object]]:
    rows = []
    for seed in pilot.LEARNER_SEEDS:
        path = PILOT_OUTPUT / "checkpoints" / (
            f"PILOT_NOT_CLAIM-seed-{seed}-FULL-epoch-{MODEL_EPOCH:04d}.json"
        )
        sidecar = Path(str(path) + ".sha256")
        digest = sha256(path)
        declared = sidecar.read_text(encoding="ascii").split()[0]
        if digest != declared:
            raise RuntimeError(f"checkpoint sidecar mismatch: {path}")
        payload = json.loads(path.read_text(encoding="ascii"))
        if payload["learner_seed"] != seed or payload["arm"] != "FULL":
            raise RuntimeError(f"checkpoint identity mismatch: {path}")
        if payload["completed_source_epochs"] != MODEL_EPOCH:
            raise RuntimeError(f"checkpoint epoch mismatch: {path}")
        rows.append({"learner_seed": seed, "path": str(path.relative_to(ROOT)), "sha256": digest})
    return rows


def measure_anchor(pilot, calibration, models, tape, anchor_index: int, step_index: int, carrier: str):
    started = time.perf_counter()
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    built = pilot._build_anchor_rows(
        tape=tape,
        setting=setting,
        run_setting=run_setting,
        calibration=calibration,
        step_index=step_index,
        carrier=carrier,
        anchor_index=anchor_index,
        include_coalition=False,
        full_legal_actions=True,
    )
    anchor = built["base"]
    incumbent = built["incumbent"]
    rows_by_user_action = built["rows_by_user_action"]
    selection_evaluator = built["current_evaluator"]
    catalogue_started = time.perf_counter()
    catalogue, catalogue_census = pilot.ENGINE._catalogue_with_census(
        tape,
        step_index,
        anchor,
        setting=setting,
        calibration=calibration,
        run_setting=run_setting,
    )
    raw_catalogue_size = len(catalogue)
    exact = pilot._exact_interactions(
        anchor, incumbent, catalogue, selection_evaluator, calibration
    )
    legal_catalogue = tuple(row for row in catalogue if row.configuration_id in exact)
    contexts = {
        config.configuration_id: pilot._coalition_context(
            tape=tape,
            step_index=step_index,
            anchor=anchor,
            selected=config,
            rows_by_user_action=rows_by_user_action,
        )
        for config in legal_catalogue
        if len(exact[config.configuration_id]["changed"]) >= 2
    }
    by_id = {row.configuration_id: row for row in legal_catalogue}
    exact_terms = {row.configuration_id: float(exact[row.configuration_id]["psi"]) for row in legal_catalogue}
