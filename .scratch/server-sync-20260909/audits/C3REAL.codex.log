#!/usr/bin/env python3
"""Generate compact C1 rows through the dormant declared-target pilot branch."""

from __future__ import annotations

import argparse
from fractions import Fraction
import json
from pathlib import Path
import time

from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
from mcrl.physics_v025.targets import c1_difference_surplus
from mcrl.stagec_v025.canonical import parse_float_hex

import scripts.run_v025_pilot_c3 as pilot


ROOT = Path(__file__).resolve().parents[2]
DEFAULT_CALIBRATION = (
    ROOT
    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
    / "PILOT_NOT_CLAIM-calibration.json"
)


def _ratio(payload: dict[str, object], key: str) -> Fraction:
    values = payload[key]
    assert isinstance(values, list) and len(values) == 2
    return Fraction(int(values[0]), int(values[1]))


def load_calibration(path: Path) -> pilot.PilotCalibration:
    payload = json.loads(path.read_text(encoding="ascii"))
    return pilot.PilotCalibration(
        eta_ref=_ratio(payload, "eta_ref"),
        lambda_bits_per_j=_ratio(payload, "lambda_bits_per_j"),
        kappa_bits_per_user_step=_ratio(payload, "kappa_bits_per_user_step"),
        bits_ref=_ratio(payload, "bits_ref"),
        joules_ref=_ratio(payload, "joules_ref"),
        users=int(payload["users"]),
    )


def identity(row) -> tuple[int, int] | None:
    if row.action.is_null:
        return None
    return (int(row.action.norad_id), int(row.action.beam_chain_id))


def generate(world_index: int, start_step: int, stop_step: int, output: Path) -> None:
    domain = DEVELOPMENT_WORLD_DOMAINS[world_index - 1]
    if domain not in {"V025_PROBE/world/1", "V025_PROBE/world/2"}:
        raise RuntimeError(f"unexpected world domain: {domain}")
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    calibration = load_calibration(DEFAULT_CALIBRATION)

    provider_started = time.perf_counter()
    tape = build_world_tape(
        domain=domain,
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=33,
        start_time_s=0.0,
    )
    provider_wall_s = time.perf_counter() - provider_started
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("w", encoding="utf-8") as handle:
        meta = {
            "kind": "metadata",
            "status": "DIAGNOSTIC_NOT_CLAIM",
            "world_id": domain,
            "world_index": world_index,
            "world_seed": tape.seed,
            "provider_wall_s": provider_wall_s,
            "calibration_path": str(DEFAULT_CALIBRATION.relative_to(ROOT)),
            "calibration_digest": calibration.digest,
            "carrier": "nearest-eligible",
            "steps": [start_step, stop_step],
            "pilot_flag_on_disk": True,
            "pilot_flag_set_in_process_for_declared": False,
            "selection_boundary_indices": list(pilot.ENGINE.SELECTION_BOUNDARY_INDICES),
        }
        handle.write(json.dumps(meta, sort_keys=True) + "\n")
        handle.flush()

        for step_index in range(start_step, stop_step):
            anchor_started = time.perf_counter()

            # The requested dormant path switch. This mutates only the imported
            # module object in this diagnostic process; the source file is untouched.
            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
            exact = pilot._build_anchor_rows(
                tape=tape,
                setting=setting,
                run_setting=run_setting,
                calibration=calibration,
                step_index=step_index,
                carrier="nearest-eligible",
                anchor_index=step_index,
                include_coalition=False,
                full_legal_actions=False,
            )
            exact_wall_s = time.perf_counter() - anchor_started

            surrogate_started = time.perf_counter()
            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = True
            surrogate = pilot._build_anchor_rows(
                tape=tape,
                setting=setting,
                run_setting=run_setting,
                calibration=calibration,
                step_index=step_index,
                carrier="nearest-eligible",
                anchor_index=step_index,
                include_coalition=False,
                full_legal_actions=False,
            )
            surrogate_wall_s = time.perf_counter() - surrogate_started
            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False

            surrogate_by_key = {
                (int(row.user_id), identity(row)): row for row in surrogate["rows"]
            }
            base = exact["base"]
            incumbent = exact["incumbent"]
            evaluator = exact["current_evaluator"]
            base_profile = evaluator.evaluate(base)
            base_phi = pilot.ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
            )
            rows = []
            gauge_max = 0.0
            decomposition_max = 0.0
            helper_max = 0.0
            for row in exact["rows"]:
                action_identity = identity(row)
                mapping = base.mapping
                mapping[int(row.user_id)] = action_identity
                config = pilot.ENGINE._configuration(
                    base, mapping, kind="c1-declared-learnability-verification"
                )
                profile = evaluator.evaluate(config)
                phi = pilot.ENGINE._phi_for(
                    incumbent,
                    config,
                    cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
                )
                stored_core = parse_float_hex(row.c1_label_bits_hex, field="c1 core")
                stored_phi = parse_float_hex(row.c1_phi_difference_hex, field="c1 phi")
                stored_total = parse_float_hex(
                    row.c1_label_normalized_hex, field="c1 normalized"
                )
                recomputed_core = (
                    Fraction(str(profile.bits - base_profile.bits))
                    - calibration.eta_ref
                    * Fraction(str(profile.joules - base_profile.joules))
                )
                recomputed_phi = Fraction(str(phi - base_phi))
                recomposed = float(
                    recomputed_core / calibration.kappa_bits_per_user_step
                    + recomputed_phi
                )
                decomposition_max = max(
                    decomposition_max,
                    abs(stored_core - float(recomputed_core)),
                    abs(stored_phi - float(recomputed_phi)),
                    abs(stored_total - recomposed),
                )
                helper = c1_difference_surplus(
                    profile.outcome(phi=phi),
                    base_profile.outcome(phi=base_phi),
                    lambda_bits_per_j=calibration.lambda_bits_per_j,
                    eta_ref=calibration.eta_ref,
                    kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
                )
                helper_max = max(helper_max, abs(stored_total - float(helper.normalized_total)))
                if row.reference_action:
                    gauge_max = max(gauge_max, abs(stored_total))

                surrogate_row = surrogate_by_key[(int(row.user_id), action_identity)]
                rows.append(
                    {
                        "user_id": int(row.user_id),
                        "action_index": int(row.action_index),
                        "identity": None
                        if action_identity is None
                        else [action_identity[0], action_identity[1]],
                        "reference": bool(row.reference_action),
                        "q1": [float(value) for value in row.q1_state],
                        "declared": stored_total,
                        "core_bits": stored_core,
                        "phi": stored_phi,
                        "surrogate_q1": [float(value) for value in surrogate_row.q1_state],
                        "surrogate": parse_float_hex(
                            surrogate_row.c1_label_normalized_hex,
                            field="surrogate c1 normalized",
                        ),
                    }
                )

            record = {
                "kind": "anchor",
                "world_id": domain,
                "world_seed": tape.seed,
                "anchor_id": f"{domain}|{step_index}|nearest-eligible",
                "anchor_index": step_index,
                "step_index": step_index,
                "carrier": "nearest-eligible",
                "exact_wall_s": exact_wall_s,
                "surrogate_wall_s": surrogate_wall_s,
                "physics_calls": int(exact["physics_calls"]),
                "skipped_invalid": int(exact["skipped_invalid"]),
                "gauge_max_abs": gauge_max,
                "decomposition_max_abs": decomposition_max,
                "target_helper_max_abs": helper_max,
                "rows": rows,
            }
            handle.write(json.dumps(record, separators=(",", ":"), sort_keys=True) + "\n")
            handle.flush()
            print(
                json.dumps(
                    {
                        "world": world_index,
                        "step": step_index,
                        "exact_wall_s": exact_wall_s,
                        "surrogate_wall_s": surrogate_wall_s,
                        "rows": len(rows),
                        "gauge": gauge_max,
                        "decomposition": decomposition_max,
                        "helper": helper_max,
                    },
                    sort_keys=True,
                ),
                flush=True,
            )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--world-index", type=int, choices=(1, 2), required=True)
    parser.add_argument("--start-step", type=int, default=0)
    parser.add_argument("--stop-step", type=int, default=30)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if not 0 <= args.start_step < args.stop_step <= 30:
        raise SystemExit("step interval must satisfy 0 <= start < stop <= 30")
    generate(args.world_index, args.start_step, args.stop_step, args.output)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Held-out learnability analysis for exact-path C1 rows."""

from __future__ import annotations

import argparse
from concurrent.futures import ProcessPoolExecutor, as_completed
from dataclasses import dataclass
import hashlib
import json
import math
import multiprocessing as mp
import os
from pathlib import Path
import time
from types import SimpleNamespace
from typing import Iterable

import numpy as np

from mcrl.stagec_v025.learner import (
    AdamMLPHead,
    LEGACY_EPOCH_BUDGET,
    LEGACY_TRAINER_LITERALS,
)
from mcrl.stagec_v025.state import Q1_FEATURES
from mcrl.physics_v025.tapes import seed_from_domain


ROOT = Path(__file__).resolve().parents[2]
SCRATCH = ROOT / ".scratch/c1-declared"
PAIR_LIMIT = 4_096
PILOT_LEARNER_DOMAINS = tuple(f"V025_LEARNER/seed/{i}" for i in range(1, 5))
PILOT_LEARNER_SEEDS = tuple(seed_from_domain(value) for value in PILOT_LEARNER_DOMAINS)
_WORKER_DATA: Dataset | None = None


@dataclass(frozen=True)
class Dataset:
    exact_x: np.ndarray
    surrogate_x: np.ndarray
    declared_y: np.ndarray
    surrogate_y: np.ndarray
    phi: np.ndarray
    reference: np.ndarray
    anchor: np.ndarray
    world: np.ndarray
    group: np.ndarray
    action_index: np.ndarray
    anchor_records: tuple[dict[str, object], ...]
    metadata: tuple[dict[str, object], ...]


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def generated_anchor_count(paths: Iterable[Path]) -> int:
    count = 0
    for path in paths:
        with path.open(encoding="utf-8") as handle:
            count += sum(json.loads(line)["kind"] == "anchor" for line in handle)
    return count


def generated_anchor_records(paths: Iterable[Path]) -> list[dict[str, object]]:
    records = []
    for path in paths:
        with path.open(encoding="utf-8") as handle:
            records.extend(
                record
                for record in (json.loads(line) for line in handle)
                if record["kind"] == "anchor"
            )
    return records


def load_dataset(paths: Iterable[Path], max_anchor_index: dict[str, int]) -> Dataset:
    metadata: list[dict[str, object]] = []
    anchors: list[dict[str, object]] = []
    rows: list[dict[str, object]] = []
    for path in paths:
        with path.open(encoding="utf-8") as handle:
            for line in handle:
                record = json.loads(line)
                if record["kind"] == "metadata":
                    metadata.append(record)
                    continue
                if int(record["anchor_index"]) > max_anchor_index[str(record["world_id"])]:
                    continue
                anchors.append(record)
                for row in record["rows"]:
                    rows.append({**row, "anchor_id": record["anchor_id"], "world_id": record["world_id"]})
    anchor_names = sorted({str(row["anchor_id"]) for row in rows})
    anchor_code = {value: index for index, value in enumerate(anchor_names)}
    world_names = sorted({str(row["world_id"]) for row in rows})
    world_code = {value: index for index, value in enumerate(world_names)}
    group_names = sorted({f'{row["anchor_id"]}|user/{row["user_id"]}' for row in rows})
    group_code = {value: index for index, value in enumerate(group_names)}
    return Dataset(
        exact_x=np.asarray([row["q1"] for row in rows], dtype=np.float64),
        surrogate_x=np.asarray([row["surrogate_q1"] for row in rows], dtype=np.float64),
        declared_y=np.asarray([row["declared"] for row in rows], dtype=np.float64),
        surrogate_y=np.asarray([row["surrogate"] for row in rows], dtype=np.float64),
        phi=np.asarray([row["phi"] for row in rows], dtype=np.float64),
        reference=np.asarray([row["reference"] for row in rows], dtype=bool),
        anchor=np.asarray([anchor_code[str(row["anchor_id"])] for row in rows], dtype=np.int32),
        world=np.asarray([world_code[str(row["world_id"])] for row in rows], dtype=np.int8),
        group=np.asarray(
            [group_code[f'{row["anchor_id"]}|user/{row["user_id"]}'] for row in rows],
            dtype=np.int32,
        ),
        action_index=np.asarray([row["action_index"] for row in rows], dtype=np.int16),
        anchor_records=tuple(anchors),
        metadata=tuple(metadata),
    )


def splits(data: Dataset, regime: str) -> list[tuple[np.ndarray, np.ndarray, str]]:
    key = data.anchor if regime == "leave_one_anchor_out" else data.world
    result = []
    for value in np.unique(key):
        test = key == value
        result.append((~test, test, str(int(value))))
    return result


def build_pair_batch(
    x: np.ndarray,
    y: np.ndarray,
    group: np.ndarray,
    reference: np.ndarray,
    train: np.ndarray,
) -> SimpleNamespace:
    ref_by_group = {int(group[index]): int(index) for index in np.flatnonzero(train & reference)}
    candidates = np.flatnonzero(train & ~reference)
    references = np.asarray([ref_by_group[int(group[index])] for index in candidates], dtype=np.int64)
    if candidates.size > PAIR_LIMIT:
        chosen = np.linspace(0, candidates.size - 1, PAIR_LIMIT, dtype=np.int64)
        candidates = candidates[chosen]
        references = references[chosen]
    return SimpleNamespace(
        reference_states=x[references],
        candidate_states=x[candidates],
        target_deltas=y[candidates] - y[references],
    )


def metric(prediction: np.ndarray, truth: np.ndarray, group: np.ndarray) -> dict[str, object]:
    residual_ss = float(np.square(truth - prediction).sum())
    total_ss = float(np.square(truth - truth.mean()).sum())
    r2 = 1.0 - residual_ss / total_ss if total_ss else math.nan
    concordant = 0.0
    comparable = 0
    top1_hits = 0
    groups = 0
    for group_id in np.unique(group):
        indices = np.flatnonzero(group == group_id)
        if indices.size < 2:
            continue
        target = truth[indices]
        score = prediction[indices]
        left, right = np.triu_indices(indices.size, 1)
        target_delta = target[left] - target[right]
        score_delta = score[left] - score[right]
        keep = np.abs(target_delta) > 1e-12
        target_delta = target_delta[keep]
        score_delta = score_delta[keep]
        comparable += int(target_delta.size)
        concordant += float(np.sum(np.sign(target_delta) == np.sign(score_delta)))
        concordant += 0.5 * float(np.sum(np.abs(score_delta) <= 1e-15))
        selected = int(np.argmax(score))
        top1_hits += int(target[selected] >= target.max() - 1e-12)
        groups += 1
    return {
        "r2": r2,
        "pairwise_ordering": concordant / comparable if comparable else math.nan,
        "top1_accuracy": top1_hits / groups if groups else math.nan,
        "rows": int(truth.size),
        "pairs": comparable,
        "groups": groups,
    }


def aggregate_seed_metrics(items: list[dict[str, object]]) -> dict[str, object]:
    fields = ("r2", "pairwise_ordering", "top1_accuracy")
    result: dict[str, object] = {}
    for field in fields:
        values = np.asarray([float(row[field]) for row in items])
        result[field] = float(values.mean())
        result[f"{field}_median"] = float(np.median(values))
        result[f"{field}_min"] = float(values.min())
        result[f"{field}_max"] = float(values.max())
    result["seeds"] = len(items)
    result["per_seed"] = items
    return result


def run_adam_task(task: tuple[str, str, int, int]) -> dict[str, object]:
    target_name, regime, width, seed = task
    data = _WORKER_DATA
    if data is None:
        raise RuntimeError("forked Adam worker did not inherit the dataset")
    if target_name == "declared":
        x, y = data.exact_x, data.declared_y
    else:
        x, y = data.surrogate_x, data.surrogate_y
    literal = dict(LEGACY_TRAINER_LITERALS["C1"])
    literal["hidden_layers"] = (width,)
    prediction = np.empty_like(y)
    fold_rows = []
    started = time.perf_counter()
    for train, test, fold in splits(data, regime):
        batch = build_pair_batch(x, y, data.group, data.reference, train)
        head = AdamMLPHead.create(x.shape[1], literal, np.random.default_rng(seed))
        for _epoch in range(LEGACY_EPOCH_BUDGET):
            head.update(batch)
        prediction[test] = head._forward(x[test])[0]
        fold_rows.append({"fold": fold, "train_pairs": int(batch.target_deltas.size), "test_rows": int(test.sum())})
    result = metric(prediction, y, data.group)
    result.update(
        {
            "target": target_name,
            "regime": regime,
            "width": width,
            "seed": seed,
            "epochs": LEGACY_EPOCH_BUDGET,
            "pair_limit": PAIR_LIMIT,
            "wall_s": time.perf_counter() - started,
            "folds": fold_rows,
            "prediction": prediction,
        }
    )
    return result


def linear_cv(data: Dataset, regime: str) -> tuple[dict[str, object], np.ndarray]:
    x, y = data.exact_x, data.declared_y
    prediction = np.empty_like(y)
    for train, test, _fold in splits(data, regime):
        batch = build_pair_batch(x, y, data.group, data.reference, train)
        difference = batch.candidate_states - batch.reference_states
        pair_design = np.column_stack((difference, np.zeros(difference.shape[0])))
        gauge_design = np.column_stack((batch.reference_states, np.ones(batch.reference_states.shape[0])))
        design = np.vstack((pair_design, math.sqrt(0.2) * gauge_design))
        target = np.concatenate((batch.target_deltas, np.zeros(gauge_design.shape[0])))
        coefficient = np.linalg.lstsq(design, target, rcond=None)[0]
        prediction[test] = np.column_stack((x[test], np.ones(test.sum()))) @ coefficient
    result = metric(prediction, y, data.group)
    result.update({"fit": "closed-form pairwise least squares plus gauge_beta=0.2", "pair_limit": PAIR_LIMIT})
    return result, prediction


