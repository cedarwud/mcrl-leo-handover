#!/usr/bin/env python3
"""Project the cached verified exact-path C1 rows onto the Q1 v2 schema."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import resource
from types import SimpleNamespace


RSS_LIMIT_BYTES = 5 * 1024**3
resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))

ROOT = Path(__file__).resolve().parents[2]
V2_ROOT = Path("/home/sat/mcrl-v025-design-ws")
V2_PATH = V2_ROOT / "q1_schema_v2.py"
PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
EXPECTED_SCHEMA_SHA256 = (
    "66ed4a3f9222ac7f20f4334ffab92f6164d2dad203cbac7f7d4e1728ae4ad654"
)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def load_records(path: Path) -> tuple[dict[str, object], list[dict[str, object]]]:
    metadata = None
    anchors = []
    with path.open(encoding="utf-8") as stream:
        for line in stream:
            record = json.loads(line)
            if record["kind"] == "metadata":
                metadata = record
            elif record["kind"] == "anchor":
                anchors.append(record)
            else:
                raise RuntimeError(f"unknown record kind in {path}")
    if metadata is None:
        raise RuntimeError(f"metadata missing from {path}")
    return metadata, anchors


def row_proxy(row: dict[str, object]) -> SimpleNamespace:
    identity = row["identity"]
    if identity is None:
        action = SimpleNamespace(norad_id=None, beam_chain_id=None)
    else:
        action = SimpleNamespace(norad_id=int(identity[0]), beam_chain_id=int(identity[1]))
    return SimpleNamespace(
        null_action=identity is None,
        user_id=int(row["user_id"]),
        action=action,
    )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--inputs", type=Path, nargs=2, required=True)
    parser.add_argument("--outputs", type=Path, nargs=2, required=True)
    parser.add_argument("--receipt", type=Path, required=True)
    args = parser.parse_args()

    sealed_paths = (
        PILOT_PATH,
        V2_PATH,
        ROOT / "src/mcrl/stagec_v025/learner.py",
        ROOT / "src/mcrl/physics_v025/targets.py",
        *args.inputs,
    )
    before = {str(path): sha256(path) for path in sealed_paths}

    import q1_schema_v2 as v2
    import scripts.run_v025_pilot_c3 as pilot
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape

    if Path(v2.__file__).resolve() != V2_PATH:
        raise RuntimeError(f"wrong q1_schema_v2 import: {v2.__file__}")
    if v2.Q1_V2_SCHEMA_SHA256 != EXPECTED_SCHEMA_SHA256:
        raise RuntimeError("Q1 v2 schema digest mismatch")

    original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
    worlds = []
    maximum_elevation_error = 0.0
    total_rows = 0
    total_anchors = 0
    try:
        # The cached parents were generated under this exact-path module flag.
        # Keep the imported module in that state while applying the exact v2
        # projection; restore it before exit and prove the file did not change.
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
        for world_index, (input_path, output_path) in enumerate(
            zip(args.inputs, args.outputs, strict=True), start=1
        ):
            source_metadata, anchors = load_records(input_path)
            domain = DEVELOPMENT_WORLD_DOMAINS[world_index - 1]
            if source_metadata["world_id"] != domain:
                raise RuntimeError("world ordering mismatch")
            provider = LegacyWorldProvider(role="pilot-source")
            tape = build_world_tape(
                domain=domain,
                provider=provider,
                steps=33,
                start_time_s=0.0,
            )
            output_path.parent.mkdir(parents=True, exist_ok=True)
            with output_path.open("w", encoding="utf-8") as stream:
                projected_metadata = {
                    **source_metadata,
                    "projection": "cached verified exact-path v1 parent plus q1_schema_v2 geometry projection",
                    "parent_input": str(input_path.resolve().relative_to(ROOT)),
                    "parent_sha256": before[str(input_path)],
                    "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
                    "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
                    "q1_shape": [len(v2.Q1_V2_FEATURES)],
                    "pilot_flag_set_in_process_for_declared": False,
                }
                stream.write(json.dumps(projected_metadata, sort_keys=True) + "\n")
                for anchor in anchors:
                    step_index = int(anchor["step_index"])
                    resolver = v2.DecisionGeometryResolverV2(tape, provider, step_index)
                    maximum_elevation_error = max(
                        maximum_elevation_error,
                        float(resolver.maximum_elevation_crosscheck_error_deg),
                    )
                    projected_rows = []
                    for row in anchor["rows"]:
                        proxy = row_proxy(row)
                        angle, elevation = resolver(proxy)
                        old_exact = tuple(float(value) for value in row["q1"])
                        old_surrogate = tuple(float(value) for value in row["surrogate_q1"])
                        exact_v2 = v2.upgrade_q1_state_v2(
                            old_exact,
                            off_axis_angle_rad=angle,
                            focal_elevation_deg=elevation,
                            null_action=proxy.null_action,
                        )
                        surrogate_v2 = v2.upgrade_q1_state_v2(
                            old_surrogate,
                            off_axis_angle_rad=angle,
                            focal_elevation_deg=elevation,
                            null_action=proxy.null_action,
                        )
                        if len(exact_v2) != 15 or len(surrogate_v2) != 15:
                            raise RuntimeError("v2 projection shape drifted")
                        projected_rows.append(
                            {
                                **row,
                                "q1_v1": list(old_exact),
                                "surrogate_q1_v1": list(old_surrogate),
                                "q1": list(exact_v2),
                                "surrogate_q1": list(surrogate_v2),
                                "off_axis_angle_rad": angle,
                                "focal_link_elevation_deg": elevation,
                                "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
                            }
                        )
                    projected_anchor = {**anchor, "rows": projected_rows}
                    stream.write(
                        json.dumps(projected_anchor, separators=(",", ":"), sort_keys=True)
                        + "\n"
                    )
                    stream.flush()
                    total_rows += len(projected_rows)
                    total_anchors += 1
                    print(
                        json.dumps(
                            {
                                "projected_world": world_index,
                                "step": step_index,
                                "rows": len(projected_rows),
                            },
                            sort_keys=True,
                        ),
                        flush=True,
                    )
            worlds.append(
                {
                    "world_id": domain,
                    "anchors": len(anchors),
                    "rows": sum(len(anchor["rows"]) for anchor in anchors),
                    "output": str(output_path.resolve().relative_to(ROOT)),
                    "output_sha256": sha256(output_path),
                }
            )
            del tape, provider
    finally:
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = original_flag

    after = {str(path): sha256(path) for path in sealed_paths}
    changed = [path for path in before if before[path] != after[path]]
    if changed:
        raise RuntimeError(f"sealed inputs changed: {changed}")
    peak_rss_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
    receipt = {
        "artifact": "C1_DECLARED_TARGET_LEARNABILITY_V2_PROJECTION",
        "status": "DIAGNOSTIC_NOT_CLAIM",
        "interpreter": __import__("sys").executable,
        "resource_policy": {
            "python_processes": 1,
            "nice": __import__("os").nice(0),
            "blas_threads": 1,
            "rlimit_as_bytes": RSS_LIMIT_BYTES,
            "peak_rss_kb": peak_rss_kb,
        },
        "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
        "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
        "q1_schema_file_sha256": before[str(V2_PATH)],
        "pilot_flag_original": original_flag,
        "pilot_flag_during_projection": False,
        "pilot_flag_restored": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
        "sealed_file_sha256_before": before,
        "sealed_file_sha256_after": after,
        "changed_files": changed,
        "maximum_elevation_crosscheck_error_deg": maximum_elevation_error,
        "anchors": total_anchors,
        "rows": total_rows,
        "worlds": worlds,
    }
    args.receipt.parent.mkdir(parents=True, exist_ok=True)
    args.receipt.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
    print(f"PEAK_RSS_KB={peak_rss_kb}", flush=True)
    print(json.dumps({"written": str(args.receipt), "anchors": total_anchors, "rows": total_rows}))


if __name__ == "__main__":
    main()
"""Versioned Q1 feature-schema successor; the sealed v1 code stays untouched.

The module is intentionally a projection layer.  Both sealed pilot builders
may produce their authenticated v1 rows first; this layer replaces the dead
geometry coordinate with decision-time geometry, adds focal elevation, removes
two exact indicator duplicates, and emits a row/shard identity that cannot be
mistaken for v1.
"""

from __future__ import annotations

from dataclasses import dataclass
from hashlib import sha256
import json
import math
from typing import Any, Callable, Iterable, Mapping, Sequence


Q1_V1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
Q1_V1_SCHEMA_SHA256 = "c002ea883a4ab727f9e00cc15866f5b9d37abca645963fd3db2f2db7c6cc887a"
Q1_V2_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v2"
ROW_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-row-v2"
SHARD_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-shard-v2"


class Q1SchemaV2Error(RuntimeError):
    """A v2 schema/projection invariant failed closed."""


def canonical_json_bytes(value: Any) -> bytes:
    try:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
            allow_nan=False,
        ).encode("ascii")
    except (TypeError, ValueError, UnicodeEncodeError) as error:
        raise Q1SchemaV2Error("value is not canonical finite JSON") from error


def canonical_sha256(value: Any) -> str:
    return sha256(canonical_json_bytes(value)).hexdigest()


def float_hex(value: float | int) -> str:
    number = float(value)
    if not math.isfinite(number):
        raise Q1SchemaV2Error("schema floats must be finite")
    return number.hex()


def parse_float_hex(value: object, *, field: str) -> float:
    if not isinstance(value, str):
        raise Q1SchemaV2Error(f"{field} must be a hexadecimal float string")
    try:
        number = float.fromhex(value)
    except ValueError as error:
        raise Q1SchemaV2Error(f"{field} is not a hexadecimal float") from error
    if not math.isfinite(number) or number.hex() != value:
        raise Q1SchemaV2Error(f"{field} is not a canonical finite float")
    return number


@dataclass(frozen=True, slots=True)
class FeatureSpec:
    name: str
    unit: str
    scale: float


# The two exact indicators from v1 are deliberately absent:
#   beam_active_before_focal == 1[background occupancy > 0]
#   previous_beam_active_for_action == 1[previous served load > 0]
Q1_V2_FEATURES = (
    FeatureSpec("nominal_sinr_margin_at_rate_target", "dB", 20.0),
    FeatureSpec("nominal_required_power_over_cap", "ratio", 1.0),
    FeatureSpec("nominal_mode_spectral_efficiency", "bit/s/Hz", 4.0),
    FeatureSpec("background_occupancy_excluding_focal", "user", 10.0),
    FeatureSpec("satellite_active_before_focal", "boolean", 1.0),
    FeatureSpec("off_axis_angle", "rad", 1.0),
    FeatureSpec("focal_link_elevation", "deg", 90.0),
    FeatureSpec("remaining_d2_time", "s", 120.0),
    FeatureSpec("remaining_visibility_time", "s", 120.0),
    FeatureSpec("refresh_phase", "decision", 3.0),
    FeatureSpec("previous_served_association_for_action", "boolean", 1.0),
    FeatureSpec("previous_served_load_for_action", "user", 10.0),
    FeatureSpec("previous_satellite_active_for_action", "boolean", 1.0),
    FeatureSpec("previous_beam_max_rf_over_cap", "ratio", 1.0),
    FeatureSpec("missing_incumbent", "boolean", 1.0),
)
Q1_V2_FEATURE_NAMES = tuple(feature.name for feature in Q1_V2_FEATURES)


Q1_V2_SCHEMA = {
    "schema": Q1_V2_SCHEMA_VERSION,
    "successor_of": {
        "schema": Q1_V1_SCHEMA_VERSION,
        "sha256": Q1_V1_SCHEMA_SHA256,
    },
    "normalization": "raw_value / positive_frozen_scale; signed values retained",
    "shape": [len(Q1_V2_FEATURES)],
    "features": [
        {
            "name": feature.name,
            "unit": feature.unit,
            "scale_hex": float_hex(feature.scale),
        }
        for feature in Q1_V2_FEATURES
    ],
    "changes": {
        "repaired": [
            "off_axis_angle: true satellite-to-(beam centre,user) angle at decision boundary 0, converted from physics degrees to schema radians"
        ],
        "added": [
            "focal_link_elevation: provider boundary-0 elevation in the physics degree convention"
        ],
        "removed_exact_redundancies": [
            "beam_active_before_focal",
            "previous_beam_active_for_action",
        ],
        "retained_structural_coordinate": [
            "missing_incumbent: meaningful for tapes with an unserved prior mapping; structurally zero on the measured pilot tapes"
        ],
        "null_action_geometry": (
            "off_axis_angle and focal_link_elevation are 0 only when the row-level "
            "null_action flag says that no focal link exists"
        ),
    },
    "removed_legacy": ["recurrence_power", "entry_gain_ratio", "segment_age"],
}
Q1_V2_SCHEMA_SHA256 = canonical_sha256(Q1_V2_SCHEMA)


def upgrade_q1_state_v2(
    q1_state_v1: Sequence[float],
    *,
    off_axis_angle_rad: float,
    focal_elevation_deg: float,
    null_action: bool,
) -> tuple[float, ...]:
    """Project one learner-normalized v1 vector to learner-normalized v2."""

    if len(q1_state_v1) != 16:
        raise Q1SchemaV2Error("v1 Q1 state must have exactly 16 slots")
    old = tuple(float(value) for value in q1_state_v1)
    if not all(math.isfinite(value) for value in old):
        raise Q1SchemaV2Error("v1 Q1 state contains a non-finite value")
    angle = float(off_axis_angle_rad)
    elevation = float(focal_elevation_deg)
    if not math.isfinite(angle) or not math.isfinite(elevation):
        raise Q1SchemaV2Error("decision geometry must be finite")
    if null_action:
        if angle != 0.0 or elevation != 0.0:
            raise Q1SchemaV2Error("null action geometry must use the explicit absent-link zeros")
    elif not (0.0 <= angle <= math.pi and -90.0 <= elevation <= 90.0):
        raise Q1SchemaV2Error("non-null decision geometry is outside physical bounds")

    # Old slots 4 and 12 are excluded. Old slot 6 is replaced, not reused.
    projected = (
        *old[0:4],
        old[5],
        angle,
        elevation / 90.0,
        *old[7:12],
        *old[13:16],
    )
    if len(projected) != len(Q1_V2_FEATURES):
        raise AssertionError("internal v2 projection length drifted")
    return projected


def project_row_payload_v2(
    parent_payload: Mapping[str, object],
    *,
    off_axis_angle_rad: float,
    focal_elevation_deg: float,
    geometry_source: str,
) -> dict[str, object]:
    """Create an authenticated v2 row payload from a readable sealed v1 row."""

    if parent_payload.get("q1_schema_sha256") != Q1_V1_SCHEMA_SHA256:
        raise Q1SchemaV2Error("parent row is not the sealed Q1 v1 schema")
    raw_state = parent_payload.get("q1_state")
    if not isinstance(raw_state, list) or len(raw_state) != 16:
        raise Q1SchemaV2Error("parent q1_state is malformed")
    old = tuple(parse_float_hex(value, field="q1_state") for value in raw_state)
    null_action = parent_payload.get("null_action")
    if type(null_action) is not bool:
        raise Q1SchemaV2Error("parent null_action is not boolean")
    state = upgrade_q1_state_v2(
        old,
        off_axis_angle_rad=off_axis_angle_rad,
        focal_elevation_deg=focal_elevation_deg,
        null_action=null_action,
    )
    if not geometry_source:
        raise Q1SchemaV2Error("geometry source must be named")

    result = dict(parent_payload)
    result["schema"] = ROW_V2_SCHEMA_VERSION
    result["q1_state"] = [float_hex(value) for value in state]
    result["q1_schema_sha256"] = Q1_V2_SCHEMA_SHA256
    result["q1_v1_parent_row_sha256"] = canonical_sha256(parent_payload)
    result["q1_geometry_source"] = geometry_source
    result["q1_visible_primitives_sha256"] = canonical_sha256(
        {
            "parent_visible_primitives_sha256": parent_payload.get(
                "visible_primitives_sha256"
            ),
            "off_axis_angle_rad_hex": float_hex(off_axis_angle_rad),
            "focal_elevation_deg_hex": float_hex(focal_elevation_deg),
            "geometry_source": geometry_source,
        }
    )
    validate_v2_row_payload(result)
    return result


def validate_v2_row_payload(payload: Mapping[str, object]) -> None:
    if payload.get("schema") != ROW_V2_SCHEMA_VERSION:
        raise Q1SchemaV2Error("row schema is not Q1 v2")
    if payload.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256:
        raise Q1SchemaV2Error("row Q1 digest is not Q1 v2")
    state = payload.get("q1_state")
    if not isinstance(state, list) or len(state) != len(Q1_V2_FEATURES):
        raise Q1SchemaV2Error("v2 row state dimension drifted")
    for value in state:
        parse_float_hex(value, field="q1_state")
    for field in ("q1_v1_parent_row_sha256", "q1_visible_primitives_sha256"):
        digest = payload.get(field)
        if (
            not isinstance(digest, str)
            or len(digest) != 64
            or any(character not in "0123456789abcdef" for character in digest)
        ):
            raise Q1SchemaV2Error(f"{field} is not a lowercase SHA-256")


def encode_v2_shard(rows: Iterable[Mapping[str, object]]) -> bytes:
    """Serialize a canonical v2 shard with its own digest in every row/header."""

    material = [dict(row) for row in rows]
    if not material:
        raise Q1SchemaV2Error("cannot encode an empty v2 shard")
    for row in material:
        validate_v2_row_payload(row)
    q2_digests = {row.get("q2_schema_sha256") for row in material}
    if len(q2_digests) != 1:
        raise Q1SchemaV2Error("v2 shard rows disagree on Q2 schema")
    header = {
        "schema": SHARD_V2_SCHEMA_VERSION,
        "row_count": len(material),
        "rows_sha256": canonical_sha256(material),
        "q1_schema_sha256": Q1_V2_SCHEMA_SHA256,
        "q2_schema_sha256": next(iter(q2_digests)),
    }
    return b"\n".join(canonical_json_bytes(value) for value in (header, *material)) + b"\n"


def decode_v2_shard(encoded: bytes) -> tuple[dict[str, object], ...]:
    """Read and re-check a canonical v2 shard; v1 remains owned by its reader."""

    try:
        values = [json.loads(line.decode("ascii")) for line in encoded.splitlines()]
    except (UnicodeError, json.JSONDecodeError) as error:
        raise Q1SchemaV2Error("cannot parse v2 shard") from error
    if not values or not isinstance(values[0], dict):
        raise Q1SchemaV2Error("v2 shard header is missing")
    if encoded != b"\n".join(canonical_json_bytes(value) for value in values) + b"\n":
        raise Q1SchemaV2Error("v2 shard is not canonical JSONL")
    header, rows = values[0], values[1:]
    if (
        header.get("schema") != SHARD_V2_SCHEMA_VERSION
        or header.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256
        or header.get("row_count") != len(rows)
        or header.get("rows_sha256") != canonical_sha256(rows)
    ):
        raise Q1SchemaV2Error("v2 shard header/digest check failed")
    for row in rows:
        if not isinstance(row, dict):
            raise Q1SchemaV2Error("v2 shard row is not an object")
        validate_v2_row_payload(row)
    return tuple(rows)


GeometryLookup = Callable[[object], tuple[float, float]]


def decision_geometry_from_ecef(
    *,
    satellite_ecef_km: Sequence[float],
    beam_centre_ecef_km: Sequence[float],
    user_ecef_km: Sequence[float],
) -> tuple[float, float]:
    """Return (off-axis radians, elevation degrees) from decision-time ECEF.

    Off-axis is the angle at the satellite between the satellite-to-cell
    boresight and satellite-to-user link. Elevation uses the spherical-Earth
    local-up convention used by the provider/channel path.
    """

    satellite = tuple(float(value) for value in satellite_ecef_km)
    centre = tuple(float(value) for value in beam_centre_ecef_km)
    user = tuple(float(value) for value in user_ecef_km)
    if any(len(vector) != 3 for vector in (satellite, centre, user)):
        raise Q1SchemaV2Error("ECEF geometry vectors must have length three")
    if not all(math.isfinite(value) for vector in (satellite, centre, user) for value in vector):
        raise Q1SchemaV2Error("ECEF geometry must be finite")

    boresight = tuple(c - s for c, s in zip(centre, satellite, strict=True))
    link_from_satellite = tuple(u - s for u, s in zip(user, satellite, strict=True))
    link_from_user = tuple(s - u for s, u in zip(satellite, user, strict=True))

    def norm(vector: Sequence[float]) -> float:
        return math.sqrt(sum(value * value for value in vector))

    boresight_norm = norm(boresight)
    satellite_link_norm = norm(link_from_satellite)
    user_norm = norm(user)
    if min(boresight_norm, satellite_link_norm, user_norm) <= 0.0:
        raise Q1SchemaV2Error("ECEF geometry contains a zero-length direction")
    cosine = sum(
        left * right for left, right in zip(boresight, link_from_satellite, strict=True)
    ) / (boresight_norm * satellite_link_norm)
    off_axis_rad = math.acos(max(-1.0, min(1.0, cosine)))
    sine_elevation = sum(
        delta * up for delta, up in zip(link_from_user, user, strict=True)
    ) / (satellite_link_norm * user_norm)
    elevation_deg = math.degrees(math.asin(max(-1.0, min(1.0, sine_elevation))))
    return off_axis_rad, elevation_deg


class DecisionGeometryResolverV2:
    """Resolve true focal geometry for one tape step through public seams."""

    def __init__(self, tape: object, provider: object, step_index: int) -> None:
        # Imports stay local so the schema/digest itself has no dependency on
        # the sealed implementation. The caller chooses which readable v1
        # provider supplies the successor's geometry.
        import numpy as np
        from mcrl.env.cells import build_cell_grid
        from mcrl.env.geometry import geodetic_to_ecef
        from mcrl.env.scenario import NOMINAL_GRID_ALTITUDE_KM

        step = tape.steps[step_index]
        arrays = step.arrays
        if arrays is None:
            raise Q1SchemaV2Error(
                "v2 off-axis requires the provider array/ECEF seam; object-only tape is insufficient"
            )
        layouts = (
            tape.step_user_layouts[step_index]
            if tape.step_user_layouts
            else tape.user_layout
        )
        ordered = sorted(layouts, key=lambda item: item.user_id)
        user_ids = np.asarray([item.user_id for item in ordered], dtype=np.int64)
        user_ecef = geodetic_to_ecef(
                    "source_beam_key": source,
                    "target_beam_key": target,
                    "gain_hex": float_hex(gain),
                }
                for source, target, gain in self.pairwise_cross_gain_terms
            ],
        }

    def _bounded_pairwise_cross_gain_terms(
        self,
    ) -> tuple[tuple[tuple[str, str, float], ...], float]:
        """Top-K by magnitude, returned in canonical key order plus residual sum."""

        ranked = sorted(
            self.pairwise_cross_gain_terms,
            key=lambda row: (-abs(row[2]), row[0], row[1]),
        )
        retained = tuple(
            sorted(
                ranked[:PAIRWISE_CROSS_GAIN_TOP_K],
                key=lambda row: (row[0], row[1]),
            )
        )
        residual_sum = math.fsum(row[2] for row in ranked[PAIRWISE_CROSS_GAIN_TOP_K:])
        return retained, residual_sum

    def pairwise_cross_gain_vector(self) -> np.ndarray:
        """Fixed-width ordered pair block used by the interaction encoder."""

        retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
        block = np.zeros((PAIRWISE_CROSS_GAIN_TOP_K, 4), dtype=np.float64)
        for index, (source, target, gain) in enumerate(retained):
            block[index] = (
                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
                gain,
                1.0,
            )
        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))

    def invariant_vector(self, *, member_width: int) -> np.ndarray:
        """DeepSets-style deterministic encoding; IDs/order are not features."""

        if len(self.members) <= 1:
            # Empty and singleton values are hard anchored by the head, but a
            # stable vector remains useful for schema and KAT checks.
            member_matrix = np.zeros((1, member_width), dtype=np.float64)
        else:
            member_matrix = np.asarray(
                [member.invariant_features for member in self.members],
                dtype=np.float64,
            )
            if member_matrix.shape[1] != member_width:
                raise StageCContractError("coalition member feature width drifted")
        beams = tuple(sorted(self.affected_beams, key=lambda beam: beam.beam_key))
        beam_features = np.asarray([
            [
                beam.occupancy_before,
                beam.occupancy_after,
                float(beam.active_after) - float(beam.active_before),
                beam.shared_capacity,
                beam.interference_summary,
                beam.capacity_margin,
                1.0,
            ]
            for beam in beams
        ], dtype=np.float64)
        beam_pool = np.concatenate(
            (
                beam_features.sum(axis=0),
                beam_features.max(axis=0),
                beam_features.min(axis=0),
                beam_features.mean(axis=0),
            )
        )
        vector = np.concatenate(
            (
                np.asarray([float(len(self.members))], dtype=np.float64),
                member_matrix.sum(axis=0),
                member_matrix.max(axis=0),
                beam_pool,
                self.pairwise_cross_gain_vector(),
                np.asarray(self.global_resource_features, dtype=np.float64),
            )
        )
        if not np.isfinite(vector).all():
            raise StageCContractError("coalition invariant encoding is non-finite")
        return vector


