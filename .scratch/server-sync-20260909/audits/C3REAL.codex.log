        scale[scale == 0.0] = 1.0
        z_train = random_feature_map(x[train], mean, scale, seed)
        z_test = random_feature_map(x[test], mean, scale, seed)
        # Select regularization using anchors inside the outer training set;
        # the outer held-out anchor/world never participates in selection.
        training_anchors = np.unique(data.anchor[train])
        validation_anchors = training_anchors[-max(2, len(training_anchors) // 5):]
        validation = train & np.isin(data.anchor, validation_anchors)
        subtrain = train & ~validation
        sub_mean = x[subtrain].mean(axis=0)
        sub_scale = x[subtrain].std(axis=0)
        sub_scale[sub_scale == 0.0] = 1.0
        z_subtrain = random_feature_map(x[subtrain], sub_mean, sub_scale, seed)
        z_validation = random_feature_map(x[validation], sub_mean, sub_scale, seed)
        sub_gram = z_subtrain.T @ z_subtrain
        sub_rhs = z_subtrain.T @ y[subtrain]
        ridge_grid = (0.01, 0.1, 1.0, 10.0, 100.0, 1000.0)
        validation_rows = []
        eigenvalues, eigenvectors = np.linalg.eigh(sub_gram)
        projected_rhs = eigenvectors.T @ sub_rhs
        for candidate_ridge in ridge_grid:
            candidate_coefficient = eigenvectors @ (
                projected_rhs / (eigenvalues + candidate_ridge)
            )
            candidate_prediction = z_validation @ candidate_coefficient
            validation_rows.append(
                (metric(candidate_prediction, y[validation], data.group[validation])["r2"], candidate_ridge)
            )
        ridge = float(max(validation_rows, key=lambda row: (row[0], -row[1]))[1])
        gram = z_train.T @ z_train
        coefficient = np.linalg.solve(
            gram + ridge * np.eye(gram.shape[0]), z_train.T @ y[train]
        )
        prediction[test] = z_test @ coefficient
        if keep_models:
            models.append(
                {
                    "fold": fold,
                    "test": test,
                    "mean": mean,
                    "scale": scale,
                    "coefficient": coefficient,
                    "ridge": ridge,
                }
            )
    result = metric(prediction, y, data.group)
    result.update(
        {
            "architecture": "fixed-seed 16-256-256 ReLU random features plus raw slots and ridge output",
            "trainable_output_parameters": 529,
            "random_seed": seed,
            "ridge": "training-only nested choice from [0.01,0.1,1,10,100,1000]",
            "wall_s": time.perf_counter() - started,
        }
    )
    return result, prediction, models


def permutation_importance(
    data: Dataset,
    baseline: dict[str, object],
    models: list[dict[str, object]],
) -> dict[str, object]:
    rows = []
    seed = seed_from_domain("C1REAL/permutation/2026-09-10")
    for slot in range(data.exact_x.shape[1]):
        permuted_prediction = np.empty_like(data.declared_y)
        for model in models:
            test = model["test"]
            x_test = data.exact_x[test].copy()
            rng = np.random.default_rng(seed + slot)
            x_test[:, slot] = x_test[rng.permutation(x_test.shape[0]), slot]
            z = random_feature_map(
                x_test, model["mean"], model["scale"], PILOT_LEARNER_SEEDS[0]
            )
            permuted_prediction[test] = z @ model["coefficient"]
        permuted = metric(permuted_prediction, data.declared_y, data.group)
        rows.append(
            {
                "slot": slot,
                "name": Q1_FEATURES[slot].name,
                "r2_drop": float(baseline["r2"]) - float(permuted["r2"]),
                "pairwise_ordering_drop": float(baseline["pairwise_ordering"])
                - float(permuted["pairwise_ordering"]),
                "top1_accuracy_drop": float(baseline["top1_accuracy"])
                - float(permuted["top1_accuracy"]),
                "permuted_metrics": permuted,
            }
        )
    return {
        "model": "high_capacity",
        "regime": "leave_one_world_out",
        "method": "globally permute one slot within each held-out world fold",
        "seed": seed,
        "slots": rows,
    }


def slot_audit(data: Dataset) -> dict[str, object]:
    x = data.exact_x
    return {
        "constant_slots": {
            "6": {"minimum": float(x[:, 6].min()), "maximum": float(x[:, 6].max())},
            "15": {"minimum": float(x[:, 15].min()), "maximum": float(x[:, 15].max())},
        },
        "indicator_violations": {
            "slot_4_equals_indicator_slot_3_positive": int(np.sum(x[:, 4] != (x[:, 3] > 0.0))),
            "slot_12_equals_indicator_slot_11_positive": int(np.sum(x[:, 12] != (x[:, 11] > 0.0))),
        },
        "nominal_dimension": 16,
        "effective_dimension": 12,
        "indexing": "zero-based",
    }


def anchor_bootstrap(
    prediction: np.ndarray,
    data: Dataset,
    *,
    replicates: int = 2000,
) -> dict[str, object]:
    statistics = []
    for anchor_id in np.unique(data.anchor):
        mask = data.anchor == anchor_id
        truth = data.declared_y[mask]
        pred = prediction[mask]
        groups = data.group[mask]
        residual_ss = float(np.square(truth - pred).sum())
        order_credit = 0.0
        pairs = 0
        top1_hits = 0
        group_count = 0
        for group_id in np.unique(groups):
            indices = np.flatnonzero(groups == group_id)
            target = truth[indices]
            score = pred[indices]
            left, right = np.triu_indices(indices.size, 1)
            target_delta = target[left] - target[right]
            score_delta = score[left] - score[right]
            keep = np.abs(target_delta) > 1e-12
            target_delta = target_delta[keep]
            score_delta = score_delta[keep]
            pairs += int(target_delta.size)
            order_credit += float(np.sum(np.sign(target_delta) == np.sign(score_delta)))
            order_credit += 0.5 * float(np.sum(np.abs(score_delta) <= 1e-15))
            top1_hits += int(target[int(np.argmax(score))] >= target.max() - 1e-12)
            group_count += 1
        statistics.append(
            {
                "n": int(truth.size),
                "sum": float(truth.sum()),
                "sum2": float(np.square(truth).sum()),
                "rss": residual_ss,
                "order_credit": order_credit,
                "pairs": pairs,
                "top1_hits": top1_hits,
                "groups": group_count,
            }
        )
    rng = np.random.default_rng(seed_from_domain("C1REAL/anchor-bootstrap/2026-09-10"))
    draws = {"r2": [], "pairwise_ordering": [], "top1_accuracy": []}
    for _ in range(replicates):
        sample = rng.integers(0, len(statistics), len(statistics))
        selected = [statistics[int(index)] for index in sample]
        n = sum(row["n"] for row in selected)
        total_ss = sum(row["sum2"] for row in selected) - (
            sum(row["sum"] for row in selected) ** 2 / n
        )
        draws["r2"].append(1.0 - sum(row["rss"] for row in selected) / total_ss)
        draws["pairwise_ordering"].append(
            sum(row["order_credit"] for row in selected) / sum(row["pairs"] for row in selected)
        )
        draws["top1_accuracy"].append(
            sum(row["top1_hits"] for row in selected) / sum(row["groups"] for row in selected)
        )
    return {
        "unit": "anchor",
        "clusters": len(statistics),
        "replicates": replicates,
        "seed": seed_from_domain("C1REAL/anchor-bootstrap/2026-09-10"),
        "intervals": {
            key: {
                "lower_2_5pct": float(np.quantile(values, 0.025)),
                "upper_97_5pct": float(np.quantile(values, 0.975)),
                "bootstrap_se": float(np.std(values, ddof=1)),
            }
            for key, values in draws.items()
        },
    }


def clean_metric(value: dict[str, object]) -> dict[str, object]:
    return {key: item for key, item in value.items() if key != "prediction"}


def main() -> None:
    global _WORKER_DATA
    parser = argparse.ArgumentParser()
    parser.add_argument("--inputs", type=Path, nargs="+", required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--max-anchor-indices",
        type=int,
        nargs=2,
        default=(17, 18),
        metavar=("WORLD1_MAX", "WORLD2_MAX"),
        help="inclusive prefix used for one coherent model snapshot",
    )
    args = parser.parse_args()
    max_anchor_index = {
        "V025_PROBE/world/1": args.max_anchor_indices[0],
        "V025_PROBE/world/2": args.max_anchor_indices[1],
    }
    data = load_dataset(args.inputs, max_anchor_index)
    _WORKER_DATA = data
    if len(np.unique(data.anchor)) < 2 or len(np.unique(data.world)) != 2:
        raise RuntimeError("analysis requires at least two anchors and exactly two worlds")

    tasks = []
    for target in ("declared", "surrogate"):
        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
            seeds = PILOT_LEARNER_SEEDS[:1] if regime == "leave_one_anchor_out" else PILOT_LEARNER_SEEDS
            for seed in seeds:
                tasks.append((target, regime, 8, seed))
    for width in (32, 128):
        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
            seeds = PILOT_LEARNER_SEEDS[:1] if regime == "leave_one_anchor_out" else PILOT_LEARNER_SEEDS
            for seed in seeds:
                tasks.append(("declared", regime, width, seed))

    cache_path = SCRATCH / "adam_cache.json"
    if cache_path.exists():
        adam_results = json.loads(cache_path.read_text(encoding="utf-8"))
        print(json.dumps({"loaded_adam_cache": str(cache_path), "tasks": len(adam_results)}), flush=True)
    else:
        adam_results = []
        # Parent + two children = three concurrent Python processes, the hard cap.
        with ProcessPoolExecutor(max_workers=2, mp_context=mp.get_context("fork")) as executor:
            future_map = {executor.submit(run_adam_task, task): task[:4] for task in tasks}
            for future in as_completed(future_map):
                row = future.result()
                adam_results.append(row)
                print(
                    json.dumps(
                        {
                            "finished": future_map[future],
                            "r2": row["r2"],
                            "ordering": row["pairwise_ordering"],
                            "top1": row["top1_accuracy"],
                            "wall_s": row["wall_s"],
                        }
                    ),
                    flush=True,
                )
        cache_path.write_text(
            json.dumps([clean_metric(row) for row in adam_results], indent=2) + "\n",
            encoding="utf-8",
        )

    models: dict[str, dict[str, object]] = {}
    for target, name in (("declared", "sealed_declared_width_8"), ("surrogate", "sealed_surrogate_width_8")):
        models[name] = {}
        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
            selected = [
                row for row in adam_results
                if row["target"] == target and row["width"] == 8 and row["regime"] == regime
            ]
            metrics = [clean_metric(row) for row in selected]
            models[name][regime] = aggregate_seed_metrics(metrics)

    capacity_widths: dict[str, object] = {}
    for width in (8, 32, 128):
        capacity_widths[str(width)] = {}
        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
            selected = [
                row for row in adam_results
                if row["target"] == "declared" and row["width"] == width and row["regime"] == regime
            ]
            capacity_widths[str(width)][regime] = aggregate_seed_metrics(
                [clean_metric(row) for row in selected]
            )

    for name, runner in (("linear_declared", linear_cv), ("phi_only", phi_cv), ("constant", constant_cv)):
        models[name] = {}
        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
            metrics, _prediction = runner(data, regime)
            models[name][regime] = metrics

    high_capacity: dict[str, object] = {}
    high_models: list[dict[str, object]] = []
    for regime in ("leave_one_anchor_out", "leave_one_world_out"):
        metrics, _prediction, fold_models = high_capacity_cv(
            data, regime, keep_models=regime == "leave_one_world_out"
        )
        high_capacity[regime] = metrics
        if fold_models:
            high_models = fold_models
        print(json.dumps({"high_capacity": regime, **metrics}), flush=True)

    permutation = permutation_importance(
        data, high_capacity["leave_one_world_out"], high_models
    )
    primary_recheck = run_adam_task(
        ("declared", "leave_one_anchor_out", 8, PILOT_LEARNER_SEEDS[0])
    )
    expected_primary = models["sealed_declared_width_8"]["leave_one_anchor_out"]
    for field in ("r2", "pairwise_ordering", "top1_accuracy"):
        if float(primary_recheck[field]) != float(expected_primary[field]):
            raise RuntimeError(f"primary cached metric mismatch for {field}")
    bootstrap = anchor_bootstrap(primary_recheck["prediction"], data)
    all_generated = generated_anchor_records(args.inputs)
    generation = {
        "worlds": sorted({str(row["world_id"]) for row in data.metadata}),
        "anchors": int(len(np.unique(data.anchor))),
        "anchors_generated": len(all_generated),
        "analysis_prefix_max_anchor_index": max_anchor_index,
        "rows": int(data.declared_y.size),
        "anchor_user_groups": int(len(np.unique(data.group))),
        "rows_generated": int(sum(len(row["rows"]) for row in all_generated)),
