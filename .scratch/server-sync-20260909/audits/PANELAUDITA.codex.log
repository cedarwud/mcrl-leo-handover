 343 def select_then_realise(
 344     plans: Sequence[ArmPlan],
 345     *,
 346     key_for: Callable[[str, Assignment], PhysicalCacheKey],
 347     evaluate: Callable[[PhysicalCacheKey], OutcomeT],
 348     cache: PhysicalOutcomeCache[OutcomeT],
 349 ) -> dict[str, object]:
 350     """Select from arm-owned catalogues, then realise the chosen-key union."""
 351 
 352     if tuple(plan.arm for plan in plans) != PANEL_ARM_ORDER:
 353         raise StageCContractError("panel plans must contain every arm in declared order")
 354     cache.begin_selection()
 355     selected = {plan.arm: _select(plan) for plan in plans}
 356     # This barrier is the anti-leak invariant.  No cache method is called in
 357     # the selection loop above, and the cache itself rejects such a call.
 358     cache.seal_selection()
 359     keys = {arm: key_for(arm, row.assignment) for arm, row in selected.items()}
 360     realised_by_key = {
 361         key.digest: cache.realise(key, evaluate)
 362         for key in {value.digest: value for value in keys.values()}.values()
 363     }
 364     return {
 365         "selected": {arm: row.assignment for arm, row in selected.items()},
 366         "outcomes": {arm: realised_by_key[keys[arm].digest] for arm in PANEL_ARM_ORDER},
 367         "seed_sha256": {plan.arm: plan.seed_sha256 for plan in plans},
 368         "catalogue_sha256": {plan.arm: plan.catalogue_sha256 for plan in plans},
 369         "selection_completed_before_cache_lookups": True,
 370         "chosen_configurations": len(selected),
 371         "union_realised_configurations": len(realised_by_key),
 372         "cache_hits": cache.hits,
 373         "cache_misses": cache.misses,
 374         "search": "ordered_first_strict_improvement",
 375     }
