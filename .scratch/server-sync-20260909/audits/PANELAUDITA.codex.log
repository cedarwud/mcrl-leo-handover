 125 def construct_reference_proposal(
 126     *,
 127     model: ThreeRouteModel,
 128     tables: Sequence[UserActionTable],
 129     catalogue: Sequence[Profile],
 130     jointly_legal: Callable[[Profile], bool],
 131 ) -> Profile:
 132     """Build A3's Q1+Q2 proposal and deterministically repair joint conflicts."""
 133 
 134     independent = independent_two_head_profile(model, tables)
 135     if jointly_legal(independent):
 136         return independent
 137     best: Profile | None = None
 138     best_score = float("-inf")
 139     for profile in catalogue:
 140         if len(profile) != len(tables) or not jointly_legal(profile):
 141             continue
 142         score = DeploymentAdapter._profile_q12(model, tables, profile)
 143         if score > best_score:
 144             best, best_score = profile, score
 145     if best is None:
 146         raise StageCContractError("joint conflict repair found no legal complete profile")
 147     return best
