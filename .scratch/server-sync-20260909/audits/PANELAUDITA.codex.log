 147     def neutral(
 148         self, definition: "NeutralSourceDefinition | None" = None
 149     ) -> "PairwiseBatch":
 150         if definition is not None and definition.route != self.route:
 151             raise StageCContractError("neutral source route disagrees with batch")
 152         return PairwiseBatch.create(
 153             self.route,
 154             self.reference_states,
 155             self.candidate_states,
 156             np.zeros_like(self.target_deltas),
 157             self.row_identities,
 158             self.source_authority_sha256,
 159             source_identity=(
 160                 "neutral:legacy"
 161                 if definition is None
 162                 else f"neutral:{definition.digest}"
 163             ),
 164             physics_digest=self.physics_digest,
 165         )
