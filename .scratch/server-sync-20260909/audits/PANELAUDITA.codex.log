 462 class RuleEvaluator:
 463     """Single-child client for one verified sealed provisioning rule."""
 464 
 465     def __init__(self, rule: str, world: str, carrier: str) -> None:
 466         env = dict(os.environ)
 467         env.update(
 468             {
 469                 "OMP_NUM_THREADS": "1",
 470                 "OPENBLAS_NUM_THREADS": "1",
 471                 "MKL_NUM_THREADS": "1",
 472                 "NUMEXPR_NUM_THREADS": "1",
 473             }
 474         )
 475         self.process = subprocess.Popen(
 476             (
 477                 sys.executable,
 478                 str(RULE_EVALUATOR),
 479                 "--variant",
 480                 rule,
 481                 "--world",
 482                 world,
 483                 "--steps",
 484                 "5",
 485                 "--step",
 486                 "0",
 487                 "--carrier",
 488                 carrier,
 489                 "--setting",
 490                 "a-r0",
 491             ),
 492             cwd=ROOT,
 493             env=env,
 494             stdin=subprocess.PIPE,
 495             stdout=subprocess.PIPE,
 496             text=True,
 497             encoding="ascii",
 498         )
 499         if self.process.stdout is None or self.process.stdin is None:
 500             raise RuntimeError("failed to open rule-evaluator pipes")
 501         self.ready = json.loads(self.process.stdout.readline())
 502         if self.ready.get("variant") != rule or self.ready.get("ready") is not True:
 503             raise RuntimeError(f"rule evaluator did not authenticate {rule}")
 504 
 505     def evaluate(self, assignment) -> dict[str, float | bool]:
 506         assert self.process.stdin is not None and self.process.stdout is not None
 507         self.process.stdin.write(json.dumps({"assignment": assignment}) + "\n")
 508         self.process.stdin.flush()
 509         response = json.loads(self.process.stdout.readline())
 510         if response.get("valid") is not True:
 511             raise RuntimeError("selected physical configuration is invalid")
 512         return response
 513 
 514     def close(self) -> None:
 515         if self.process.stdin is not None:
 516             self.process.stdin.close()
 517         return_code = self.process.wait()
 518         if return_code != 0:
 519             raise RuntimeError(f"rule evaluator exited {return_code}")
