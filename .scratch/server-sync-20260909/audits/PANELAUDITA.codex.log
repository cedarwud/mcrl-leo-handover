   294	        self._selection_sealed = False
   295	        self.hits = 0
   296	        self.misses = 0
   297	
   298	    def begin_selection(self) -> None:
   299	        self._selection_sealed = False
   300	
   301	    def seal_selection(self) -> None:
   302	        self._selection_sealed = True
   303	
   304	    def realise(
   305	        self, key: PhysicalCacheKey, evaluate: Callable[[PhysicalCacheKey], OutcomeT]
   306	    ) -> OutcomeT:
   307	        if not self._selection_sealed:
   308	            raise StageCContractError("realised outcome cache accessed before all selections sealed")
   309	        if key.digest in self._rows:
   310	            self.hits += 1
