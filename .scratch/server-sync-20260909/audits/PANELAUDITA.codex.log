 112 def independent_two_head_profile(
 113     model: ThreeRouteModel, tables: Sequence[UserActionTable]
 114 ) -> Profile:
 115     selected: list[int] = []
 116     for table in tables:
 117         scores = [
 118             model.score("C1", q1) + model.score("C2", q2)
 119             for q1, q2 in zip(table.q1_states, table.q2_states, strict=True)
 120         ]
 121         selected.append(masked_argmax(scores, table.action_mask))
 122     return tuple(selected)
