 824 _CROSS_GAIN_CACHE = {}
 825 
 826 
 827 def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
 828     step = tape.steps[step_index]
 829     if step.arrays is None:
 830         return ()
 831     arrays = step.arrays
 832     cache_key = (tape.seed, step_index)
 833     cached = _CROSS_GAIN_CACHE.get(cache_key)
 834     if cached is None:
 835         aggressors = {
 836             tuple(int(value) for value in identity): index
 837             for index, identity in enumerate(arrays.aggressor_identities)
 838         }
 839         victim_columns = {}
 840         for row, identity in enumerate(arrays.identities.tolist()):
 841             key = tuple(int(value) for value in identity)
 842             victim_columns.setdefault(key, []).append(
 843                 int(arrays.row_user_column[row])
 844             )
 845         cached = (aggressors, victim_columns, {})
 846         _CROSS_GAIN_CACHE[cache_key] = cached
 847     aggressors, victim_columns, pair_cache = cached
 848     result = []
 849     for source, target in itertools.permutations(sorted(set(affected)), 2):
 850         relation = (source, target)
 851         gain = pair_cache.get(relation)
 852         if gain is None:
 853             column = aggressors.get(source)
 854             gain = 0.0 if column is None else max(
 855                 (
 856                     float(arrays.cross_base_nominal[0, user, column])
 857                     for user in victim_columns.get(target, ())
 858                 ),
 859                 default=0.0,
 860             )
 861             pair_cache[relation] = gain
 862         result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
 863     return tuple(result)
