   1 """Named encoder-variant seam for the Stage-C per-action feature vectors.
   2 
   3 Everything about *which* scalars enter ``q1_state``/``q2_state``, in what
   4 order and at what frozen scale lives behind a named :class:`EncoderVariant`.
   5 Row building, serialization, read-back, training and evaluation discover the
   6 feature width and the schema digests from the variant, so no downstream module
   7 hardcodes 16 or 22.
   8 
   9 Registration invariants that make a row impossible to misattribute:
  10 
  11 * every variant's ``(q1_schema_sha256, q2_schema_sha256)`` pair is unique --
  12   registration fails loudly on collision, so the digests a row already carries
  13   resolve back to exactly one variant name via :func:`variant_for_digests`;
  14 * the *default* variant's schema payload is byte-frozen (it omits the
  15   ``encoder_variant`` key) because its digests are already published in sealed
  16   shards, checkpoints and terminal reports.  Every other variant carries its
  17   name inside the hashed payload, which is what makes the pair unique by
  18   construction.
  19 
  20 The extractor callables take one engine-neutral action evaluation and are only
  21 ever read attribute-wise, so this module deliberately imports nothing from
  22 ``state`` -- that is what keeps the import graph acyclic.
  23 """
  24 
  25 from __future__ import annotations
  26 
  27 from dataclasses import dataclass, field
  28 import importlib
  29 import math
  30 import os
  31 from typing import Callable, Mapping, Sequence
  32 
  33 from .canonical import StageCContractError, canonical_sha256, float_hex
  34 
  35 
  36 Q1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
  37 Q2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"
  38 
  39 #: The production encoder as shipped in contract v1.  Selecting it must yield
  40 #: rows byte-identical to the pre-seam code.
  41 DEFAULT_ENCODER_VARIANT = "V025_CONTRACT_V1"
  42 
  43 #: Process-wide selection levers used by the comparison runner.  ``_MODULES_ENV``
  44 #: names importable modules whose import side effect is variant registration,
  45 #: so a new variant never requires editing training or evaluation code.
  46 _VARIANT_ENV = "MCRL_STAGEC_ENCODER_VARIANT"
  47 _MODULES_ENV = "MCRL_STAGEC_ENCODER_MODULES"
  48 _DEFAULT_PLUGIN_MODULES = ("mcrl.stagec_v025.encoder_variants",)
  49 
  50 
  51 @dataclass(frozen=True, slots=True)
  52 class FeatureSpec:
  53     name: str
  54     unit: str
  55     scale: float
  56 
  57 
  58 def _schema_payload(
  59     version: str, features: Sequence[FeatureSpec], *, variant: str
  60 ) -> dict[str, object]:
  61     payload: dict[str, object] = {
  62         "schema": version,
  63         "normalization": "raw_value / positive_frozen_scale; signed values retained",
  64         "shape": [len(features)],
  65         "features": [
  66             {"name": item.name, "unit": item.unit, "scale_hex": float_hex(item.scale)}
  67             for item in features
  68         ],
  69         "removed": ["recurrence_power", "entry_gain_ratio", "segment_age"],
  70     }
  71     if variant != DEFAULT_ENCODER_VARIANT:
  72         # Deliberate asymmetry: the default payload is frozen byte-for-byte
  73         # because its digest is already sealed into published artefacts.  Any
  74         # other variant binds its name into the hashed payload, which makes the
  75         # digest pair unique by construction rather than by luck.
  76         payload["encoder_variant"] = variant
  77     return payload
  78 
  79 
  80 def _normalize(
  81     raw: Sequence[float], specs: Sequence[FeatureSpec]
  82 ) -> tuple[float, ...]:
  83     if len(raw) != len(specs):
  84         raise StageCContractError("state field count disagrees with schema")
  85     result = tuple(float(value) / spec.scale for value, spec in zip(raw, specs, strict=True))
  86     if not all(math.isfinite(value) for value in result):
  87         raise StageCContractError("state values must be finite")
  88     return result
  89 
  90 
  91 @dataclass(frozen=True, slots=True)
  92 class EncoderVariant:
  93     """One named way of turning an action evaluation into the two vectors."""
  94 
  95     name: str
  96     q1_features: tuple[FeatureSpec, ...]
  97     q2_features: tuple[FeatureSpec, ...]
  98     q1_raw: Callable[[object], Sequence[float]]
  99     q2_raw: Callable[[object], Sequence[float]]
 100     q1_schema: Mapping[str, object] = field(repr=False)

