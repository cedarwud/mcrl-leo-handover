 284 def _action_tables(built) -> tuple[UserActionTable, ...]:
 285     grouped = defaultdict(list)
 286     for row in built["rows"]:
 287         grouped[row.user_id].append(row)
 288     tables = []
 289     for user, rows in sorted(grouped.items()):
 290         ordered = tuple(sorted(rows, key=lambda row: row.action_index))
 291         if tuple(row.action_index for row in ordered) != tuple(range(len(ordered))):
 292             raise AssertionError("exact source action indices are not contiguous")
 293         tables.append(
 294             UserActionTable(
 295                 user,
 296                 tuple(row.action for row in ordered),
 297                 ordered[0].action_mask,
 298                 tuple(row.q1_state for row in ordered),
 299                 tuple(row.q2_state for row in ordered),
 300             )
 301         )
 302     return tuple(tables)
 303 
 304 
 305 def _arm_owned_plans(*, trainer, built, tape, setting, run_setting, calibration):
 306     """Connect each trained model to its production proposal and bounded catalogue."""
 307 
 308     tables = _action_tables(built)
 309     carrier_base = built["base"]
 310     incumbent = built["incumbent"]
 311 
 312     def configuration(profile, kind):
 313         mapping = {
 314             table.user_id: (
 315                 None
 316                 if table.actions[index].is_null
 317                 else (
 318                     table.actions[index].norad_id,
 319                     table.actions[index].beam_chain_id,
 320                 )
 321             )
 322             for table, index in zip(tables, profile, strict=True)
 323         }
 324         return pilot.ENGINE._configuration(carrier_base, mapping, kind=kind)
 325 
 326     plans = []
 327     diagnostics = {}
 328     for arm in PANEL_LEARNED_ARMS:
 329         model = trainer.models[arm]
 330         proposal = tuple(
 331             masked_argmax(
 332                 tuple(
 333                     model.score("C1", q1) + model.score("C2", q2)
 334                     for q1, q2 in zip(
 335                         table.q1_states, table.q2_states, strict=True
 336                     )
 337                 ),
 338                 table.action_mask,
 339             )
 340             for table in tables
 341         )
 342         proposal_config = configuration(proposal, f"c3-smoke-{arm}-proposal")
 343         validator = pilot.ENGINE.StepEvaluator(
 344             tape,
 345             setting,
 346             0,
 347             transition_from=incumbent,
 348             field="nominal",
 349             run_setting=run_setting,
 350         )
 351         repair_counter = pilot.ENGINE.EvaluationCounter()
 352         repair_catalogue, _repair_census = pilot.ENGINE._catalogue_with_census(
 353             tape,
 354             0,
 355             carrier_base,
 356             setting=setting,
 357             calibration=calibration,
 358             counter=repair_counter,
 359             run_setting=run_setting,
 360         )
 361         validator.evaluate_many((*repair_catalogue, proposal_config))
 362         carrier_profile = validator.evaluate(carrier_base)
 363         carrier_served = sum(carrier_profile.score.served_phy.values())
 364         action_indices = {
 365             table.user_id: {
 366                 pilot._identity(action): index
 367                 for index, action in enumerate(table.actions)
 368             }
 369             for table in tables
 370         }
 371 
 372         def profile_for(config):
 373             return tuple(
