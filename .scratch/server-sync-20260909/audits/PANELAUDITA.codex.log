 155 def test_shared_physical_cache_cannot_leak_into_selection() -> None:
 156     plans = tuple(_plan(arm, selected=1 if index < 5 else 2) for index, arm in enumerate(PANEL_ARM_ORDER))
 157     key_calls = 0
 158 
 159     class BarrierCache(PhysicalOutcomeCache[dict]):
 160         def realise(self, key, evaluate):
 161             # If realisation is moved inside the per-arm selection loop this
 162             # test fails on the first arm, before all nine keys exist.
 163             assert key_calls == len(PANEL_ARM_ORDER)
 164             return super().realise(key, evaluate)
 165 
 166     cache = BarrierCache()
 167 
 168     def key_for(arm, assignment):
 169         nonlocal key_calls
 170         key_calls += 1
 171         return _key(arm, assignment)
 172 
 173     receipt = select_then_realise(
 174         plans,
 175         key_for=key_for,
 176         evaluate=lambda key: {"poison": -10_000 if key.assignment == _assignment(1) else 10_000},
 177         cache=cache,
 178     )
 179     assert receipt["selection_completed_before_cache_lookups"] is True
 180     assert receipt["union_realised_configurations"] == 2
 181     assert receipt["cache_misses"] == 2
 182     assert all(receipt["selected"][arm] == plans[index].catalogue[1].assignment for index, arm in enumerate(PANEL_ARM_ORDER))
 183 
 184     unsealed = PhysicalOutcomeCache()
 185     with pytest.raises(StageCContractError, match="before all selections sealed"):
 186         unsealed.realise(_key("FULL", _assignment(1)), lambda _key: {})
