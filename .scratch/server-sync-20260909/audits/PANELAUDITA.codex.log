 304 def _action_configs(tape, step_index: int, base, run_setting, *, full_legal: bool):
 305     if full_legal:
 306         options, census = ENGINE._legal_options(tape, step_index)
 307     else:
 308         options, census = ENGINE._selection_shortlist(
 309             tape, step_index, run_setting=run_setting
 310         )
 311     by_user: dict[int, tuple[tuple[int, int] | None, ...]] = {}
 312     configs: dict[tuple[int, tuple[int, int] | None], object] = {}
 313     for user in sorted(base.mapping):
 314         ordered = []
 315         for identity in (base.mapping[user], *options[user], None):
 316             if identity not in ordered:
 317                 ordered.append(identity)
 318         by_user[user] = tuple(ordered)
 319         for identity in ordered:
 320             mapping = base.mapping
 321             mapping[user] = identity
 322             configs[(user, identity)] = ENGINE._configuration(
 323                 base, mapping, kind="pilot-shortlisted-unilateral"
 324             )
 325     return by_user, configs, census
