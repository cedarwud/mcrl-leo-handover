 866 def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
 867     changed = tuple(
 868         user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
 869     )
 870     members = tuple(
 871         CoalitionMember(
 872             user_id=user,
 873             reference_action=_physical_action(anchor.mapping[user]),
 874             selected_action=_physical_action(selected.mapping[user]),
 875             selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
 876             incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
 877             missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
 878         )
 879         for user in changed
 880     )
 881     affected = sorted(
 882         {
 883             identity
 884             for user in changed
 885             for identity in (anchor.mapping[user], selected.mapping[user])
 886             if identity is not None
 887         }
 888     )
 889     before_counts: dict[tuple[int, int], int] = {}
 890     after_counts: dict[tuple[int, int], int] = {}
 891     for identity in anchor.mapping.values():
 892         if identity is not None:
 893             before_counts[identity] = before_counts.get(identity, 0) + 1
 894     for identity in selected.mapping.values():
 895         if identity is not None:
 896             after_counts[identity] = after_counts.get(identity, 0) + 1
 897     relations = _cross_gain_terms(tape, step_index, affected)
 898     beams = tuple(
 899         AffectedBeamContext(
 900             beam_key=f"{identity[0]}:{identity[1]}",
 901             occupancy_before=before_counts.get(identity, 0),
 902             occupancy_after=after_counts.get(identity, 0),
 903             active_before=before_counts.get(identity, 0) > 0,
 904             active_after=after_counts.get(identity, 0) > 0,
 905             shared_capacity=1.0,
 906             interference_summary=math.fsum(
 907                 gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
 908             ),
 909             capacity_margin=float(10 - after_counts.get(identity, 0)),
 910         )
 911         for identity in affected
 912     )
 913     return CoalitionContext(
 914         anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
 915         reference_profile=tuple(
 916             (user, _physical_action(identity)) for user, identity in anchor.assignments
 917         ),
 918         members=members,
 919         affected_beams=beams,
 920         global_resource_features=(
 921             len(changed) / max(1, len(anchor.assignments)),
 922             len(affected) / max(1, len(anchor.assignments)),
 923             math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
 924             math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
 925             math.fsum(gain for _source, _target, gain in relations),
 926             max((gain for _source, _target, gain in relations), default=0.0),
 927         ),
 928         pairwise_cross_gain_terms=relations,
 929     )
