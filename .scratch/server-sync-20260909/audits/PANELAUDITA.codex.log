FILE scripts/run_c3_rule_evaluator.py
   1 #!/usr/bin/env python3
   2 """Line-oriented adapter to the read-only sealed SEALED/MARGIN_Q evaluators.
   3 
   4 The parent sends complete physical assignments on stdin and receives exact
   5 realised outcomes on stdout.  One long-lived child owns one tape and one rule;
   6 there is no process pool and parent plus child use two processes at most.
   7 """
   8 
   9 from __future__ import annotations
  10 
  11 import argparse
  12 import hashlib
  13 import json
  14 from pathlib import Path
  15 import sys
  16 
  17 
  18 SIBLING = Path(__file__).resolve().parents[2] / "mcrl-v025-harness-ws"
  19 if str(SIBLING) not in sys.path:
  20     sys.path.insert(0, str(SIBLING))
  21 
  22 from harness import sealed as sealed_module  # noqa: E402
  23 from harness import variants as variants_module  # noqa: E402
  24 
  25 
  26 def main() -> None:
  27     parser = argparse.ArgumentParser()
  28     parser.add_argument("--variant", choices=("SEALED", "MARGIN_Q"), required=True)
  29     parser.add_argument("--world", required=True)
  30     parser.add_argument("--steps", type=int, required=True)
  31     parser.add_argument("--step", type=int, required=True)
  32     parser.add_argument("--carrier", required=True)
  33     parser.add_argument("--setting", required=True)
  34     args = parser.parse_args()
  35 
  36     tree = sealed_module.verify()
  37     reference = sealed_module.reference_runner()
  38     variant = variants_module.get(args.variant)
  39     installed = variant.build(sealed_module)
  40     reference.probe.evaluate_ar_tdm_catalogue = installed
  41 
  42     from mcrl.physics_v025.provider_legacy import factory
  43     from mcrl.physics_v025.tapes import build_world_tape
  44 
  45     tape = build_world_tape(
  46         domain=args.world,
  47         provider=factory(),
  48         steps=args.steps,
  49         start_time_s=0.0,
  50     )
  51     probe = reference.probe
  52     setting = probe._setting(args.setting)
  53     run_setting = probe.run_setting_for(args.setting)
  54     base = probe._base_configuration(tape, args.step, args.carrier)
  55     incumbent = probe._base_configuration(
  56         tape, max(0, args.step - 1), args.carrier
  57     )
  58     evaluator = probe.StepEvaluator(
  59         tape,
  60         setting,
  61         args.step,
  62         transition_from=incumbent,
  63         cell_rekeyed_users=probe._rekeyed_users(tape, args.step),
  64         field="realised",
  65         run_setting=run_setting,
  66         fading_quantile_alpha=0.10,
  67     )
  68     evaluator_sha256 = hashlib.sha256(
  69         tree.manifest_sha256.encode("ascii")
  70         + args.variant.encode("ascii")
  71         + variant.description.encode("utf-8")
  72         + variant.source_sha256.encode("ascii")
  73     ).hexdigest()
  74     print(
  75         json.dumps(
  76             {
  77                 "ready": True,
  78                 "variant": args.variant,
  79                 "sealed_manifest_sha256": tree.manifest_sha256,
  80                 "evaluator_sha256": evaluator_sha256,
  81                 "tape_sha256": tape.digest,
  82                 "run_setting_sha256": run_setting.digest,
  83                 "boundary_indices": list(evaluator.boundary_indices),
  84                 "processes": 1,
  85             },
  86             sort_keys=True,
  87         ),
  88         flush=True,
  89     )
  90 
  91     for line in sys.stdin:
  92         request = json.loads(line)
  93         assignment = tuple(
  94             (int(user), None if identity is None else tuple(int(x) for x in identity))
  95             for user, identity in request["assignment"]
  96         )
  97         config = probe._configuration(
  98             base, dict(assignment), kind=f"c3-panel-{args.variant.lower()}"
  99         )
 100         profile = evaluator.evaluate(config)
 101         print(
 102             json.dumps(
 103                 {
 104                     "bits": profile.bits,
 105                     "joules": profile.joules,
 106                     "valid": config.configuration_id not in evaluator._invalid,
 107                 },
 108                 sort_keys=True,
 109                 allow_nan=False,
 110             ),
 111             flush=True,
 112         )
 113 
 114 
 115 if __name__ == "__main__":
 116     main()

