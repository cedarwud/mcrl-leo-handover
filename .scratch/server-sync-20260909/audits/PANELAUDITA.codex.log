   207	
   208	def surrogate_differences(exact_builds, primitive_builds) -> dict[str, int]:
   209	    variant = active_encoder_variant()
   210	    q1 = {feature.name: index for index, feature in enumerate(variant.q1_features)}
   211	    q2 = {feature.name: index for index, feature in enumerate(variant.q2_features)}
   212	    groups = {
   213	        "current_margin": ("q1", (q1["nominal_sinr_margin_at_rate_target"], q2["candidate_current_nominal_decoding_margin"])),
   214	        "required_power": ("mixed", (q1["nominal_required_power_over_cap"], q2["required_power_cap_margin"])),
   215	        "previous_beam_rf": ("q1", (q1["previous_beam_max_rf_over_cap"],)),
   216	        "current_acm_se": ("q1", (q1["nominal_mode_spectral_efficiency"],)),
   217	        "forecast_margin": ("q2", tuple(q2[f"offset_{offset}_minimum_decoding_margin"] for offset in (1, 2, 3))),
   218	        "forecast_acm_se": ("q2", tuple(q2[f"offset_{offset}_mean_acm_spectral_efficiency"] for offset in (1, 2, 3))),
   219	        "forecast_se_trend": ("q2", (q2["forecast_se_trend"],)),
   220	    }
   221	    counts = {name: 0 for name in (*groups, "validity_survival", "c1_label", "c1_phi", "c2_label", "outage", "coalition_identity")}
   222	    for exact, primitive in zip(exact_builds, primitive_builds, strict=True):
   223	        exact_rows = {_row_key(row): row for row in exact["rows"]}
   224	        primitive_rows = {_row_key(row): row for row in primitive["rows"]}
   225	        for key in exact_rows.keys() & primitive_rows.keys():
   226	            left, right = exact_rows[key], primitive_rows[key]
   227	            for name, (where, indices) in groups.items():
   228	                if where == "q1":
   229	                    differs = any(left.q1_state[index] != right.q1_state[index] for index in indices)
   230	                elif where == "q2":
   231	                    differs = any(left.q2_state[index] != right.q2_state[index] for index in indices)
   232	                else:
   233	                    differs = (
   234	                        left.q1_state[indices[0]] != right.q1_state[indices[0]]
   235	                        or left.q2_state[indices[1]] != right.q2_state[indices[1]]
   236	                    )
   237	                counts[name] += int(differs)
   238	            counts["validity_survival"] += int(any(
   239	                left.q2_state[q2[f"offset_{offset}_{field}"]] != right.q2_state[q2[f"offset_{offset}_{field}"]]
   240	                for offset in (1, 2, 3) for field in ("valid", "survival")
   241	            ))
   242	            counts["c1_label"] += int(left.c1_label_bits_hex != right.c1_label_bits_hex)
   243	            counts["c1_phi"] += int(left.c1_phi_difference_hex != right.c1_phi_difference_hex)
   244	            counts["c2_label"] += int(left.c2_label_bits_hex != right.c2_label_bits_hex)
   245	            counts["outage"] += int(left.outage != right.outage)
   246	        exact_members = tuple(
   247	            (member.user_id, member.selected_action.payload())
   248	            for member in exact["coalition_row"].context.members
   249	        )
   250	        primitive_members = tuple(
   251	            (member.user_id, member.selected_action.payload())
   252	            for member in primitive["coalition_row"].context.members
   253	        )
   254	        counts["coalition_identity"] += int(exact_members != primitive_members)
   255	    # This development world's sampled steps contain no rekey events, so the
   256	    # rekey-aware and rekey-blind Phi values coincide.  The exact call-path
   257	    # assertion is counted separately by EngineCapture.
   258	    missing = [name for name, count in counts.items() if count == 0 and name != "c1_phi"]
   259	    if missing:
   260	        raise AssertionError(f"real-anchor exact/surrogate difference was not witnessed for {missing}")
