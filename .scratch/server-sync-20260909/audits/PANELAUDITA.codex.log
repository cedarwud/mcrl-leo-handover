 328 def _primitive_metrics(tape, step_index: int, user: int, identity, indices):
 329     if identity is None:
 330         return {
 331             "legal": False, "gain": 0.0, "remaining_d2": 0.0,
 332             "remaining_visibility": 0.0,
 333         }
 334     arrays = tape.steps[step_index].arrays
 335     if arrays is None:
 336         candidate = next(
 337             (row for row in tape.steps[step_index].boundaries[0].candidates
 338              if row.user_id == user and row.identity == identity),
 339             None,
 340         )
 341         if candidate is None:
 342             return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
 343         return {
 344             "legal": candidate.legal,
 345             "gain": candidate.nominal_gain,
