 168 def _route_state(row: SourceRow, route: Route) -> tuple[float, ...]:
 169     if route == "C1":
 170         return row.q1_state
 171     if route == "C2":
 172         return row.q2_state
 173     return (*row.q1_state, *row.q2_state)
