 116 def _sha_files(paths: Iterable[Path]) -> str:
 117     digest = hashlib.sha256()
 118     for path in sorted(paths):
 119         digest.update(path.relative_to(ROOT).as_posix().encode())
 120         digest.update(b"\0")
 121         digest.update(path.read_bytes())
 122         digest.update(b"\0")
 123     return digest.hexdigest()
 124 
