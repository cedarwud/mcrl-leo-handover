 233 class DeploymentAdapter:
 234     def __init__(self, *, deadline_s: float = DEPLOYMENT_DEADLINE_S) -> None:
 235         if deadline_s <= 0.0:
 236             raise StageCContractError("deployment deadline must be positive")
 237         self.deadline_s = float(deadline_s)
 238 
 239     def select(
 240         self,
 241         *,
 242         model: ThreeRouteModel,
 243         tables: Sequence[UserActionTable],
 244         base_profile: Profile,
 245         catalogue: Sequence[Profile],
 246         jointly_legal: Callable[[Profile], bool],
 247         resolve_profile: Callable[[Profile], ResolvedProfile],
 248         coordinator: CoordinatorHook = learned_c3_score,
 249         clock: Callable[[], float] = time.monotonic,
 250         _started_at: float | None = None,
 251     ) -> DeploymentDecision:
 252         started = clock() if _started_at is None else _started_at
 253         if len(base_profile) != len(tables) or not jointly_legal(base_profile):
 254             raise StageCContractError("BASE must be a complete jointly legal profile")
 255         independent = base_profile
 256 
 257         def fallback(reason: str) -> DeploymentDecision:
 258             return DeploymentDecision(
 259                 base_profile,
 260                 independent,
 261                 True,
 262                 reason,
 263                 max(0.0, clock() - started),
 264                 True,
 265                 True,
 266             )
 267 
 268         def deadline_expired() -> bool:
 269             return clock() - started > self.deadline_s
 270 
 271         try:
 272             independent = independent_two_head_profile(model, tables)
 273             if deadline_expired():
 274                 return fallback("deadline")
 275             independent_legal = jointly_legal(independent)
 276             base_resolution = resolve_profile(base_profile)
 277             if (
 278                 base_resolution.profile != base_profile
 279                 or base_resolution.served_count < 0
 280             ):
 281                 return fallback("base_resolution_validation")
 282             if deadline_expired():
 283                 return fallback("deadline")
 284             best = base_profile
 285             best_score = self._profile_q12(model, tables, base_profile) + coordinator(
 286                 profile=base_profile, tables=tables, model=model
 287             )
 288             if deadline_expired():
 289                 return fallback("deadline")
 290             fallback_reason: str | None = (
 291                 None
 292                 if independent_legal
 293                 else "independent_profile_jointly_infeasible"
 294             )
 295             # BASE is first and strict improvement is required, so BASE wins ties.
 296             ordered = [base_profile, *catalogue]
 297             if independent not in ordered:
 298                 ordered.append(independent)
 299             seen: set[Profile] = set()
 300             for profile in ordered:
 301                 if profile in seen:
 302                     continue
 303                 seen.add(profile)
 304                 if deadline_expired():
 305                     return fallback("deadline")
 306                 if len(profile) != len(tables) or not jointly_legal(profile):
 307                     continue
 308                 resolved = resolve_profile(profile)
 309                 if deadline_expired():
 310                     return fallback("deadline")

codex
I found a concrete route to a vacuous C3 contrast: the search starts from a Q1+Q2 proposal, permits only one-user moves, and gives C3 exactly zero on singleton coalitions. If that proposal is already a Q1+Q2 local optimum, neither C3 variant can take a first step, even when C3 strongly favors a two-user change.

The integration also builds plans once before switching provisioning rules. I’m tracing the consequences and checking the remaining row and reporting paths.

