  97 def _engine() -> ModuleType:
  98     name = "mcrl_v025_pilot_matrix_engine"
  99     if name in sys.modules:
 100         return sys.modules[name]
 101     spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
 102     if spec is None or spec.loader is None:
 103         raise RuntimeError(f"cannot load engine at {ENGINE_PATH}")
 104     module = importlib.util.module_from_spec(spec)
 105     sys.modules[name] = module
 106     spec.loader.exec_module(module)
 107     return module
 108 
