 318 def _select(plan: ArmPlan) -> ScoredConfiguration:
 319     seed = next(row for row in plan.catalogue if row.assignment == plan.seed)
 320 
 321     def unilateral_neighbours(
 322         current: ScoredConfiguration,
 323     ) -> tuple[ScoredConfiguration, ...]:
 324         current_map = dict(current.assignment)
 325         return tuple(
 326             row
 327             for row in plan.catalogue
 328             if row.eligible
 329             and row.assignment != current.assignment
 330             and sum(
 331                 current_map[user] != identity
 332                 for user, identity in row.assignment
 333             )
 334             == 1
 335         )
 336 
 337     # Catalogue order supplies the declared stable order.  Realised outcomes
 338     # are structurally unavailable until every arm reaches its fixed point.
 339     selected, _accepted = first_improvement(seed, unilateral_neighbours)
 340     return selected
