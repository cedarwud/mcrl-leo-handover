 395 def degeneracy_report(
 396     anchors: Sequence[Mapping[str, object]],
 397     contrasts: Sequence[tuple[str, str, str]],
 398 ) -> dict[str, object]:
 399     """Report exact-sign reference status and both pooled contrast marginals.
 400 
 401     Each anchor must contain ``outcomes`` (arm -> {bits, joules}) and a
 402     head-independent certified ``reference`` outcome.  No row is removed from
 403     the returned all-anchor material; the restricted view is supplementary.
 404     """
 405 
 406     if not anchors:
 407         raise StageCContractError("degeneracy report needs at least one anchor")
 408     status: dict[str, dict[str, bool]] = {}
 409     for row in anchors:
 410         anchor_id = str(row["anchor_id"])
 411         outcomes = row["outcomes"]
 412         reference = row["reference"]
 413         if not isinstance(outcomes, Mapping) or not isinstance(reference, Mapping):
 414             raise StageCContractError("malformed degeneracy-report anchor")
 415         certificate = reference.get("certificate_sha256")
 416         if (
 417             reference.get("head_independent") is not True
 418             or reference.get("fixed_point_certified") is not True
 419             or not isinstance(certificate, str)
 420             or len(certificate) != 64
 421             or any(c not in "0123456789abcdef" for c in certificate)
 422         ):
 423             raise StageCContractError(
 424                 "reference must carry a head-independent fixed-point certificate"
 425             )
 426         ref_bits, ref_joules = reference["bits"], reference["joules"]
 427         status[anchor_id] = {}
 428         for arm, outcome in outcomes.items():
 429             if not isinstance(outcome, Mapping):
 430                 raise StageCContractError("malformed arm outcome")
 431             # Cross multiplication gives the exact sign in integer/rational or
 432             # exact binary64 arithmetic; there is no tolerance or threshold.
 433             below = (
 434                 _fraction(outcome["bits"]) * _fraction(ref_joules)
 435                 < _fraction(ref_bits) * _fraction(outcome["joules"])
 436             )
 437             status[anchor_id][str(arm)] = below
 438 
 439     def pooled(rows: Sequence[Mapping[str, object]], arm: str) -> Fraction:
 440         bits = sum((_fraction(row["outcomes"][arm]["bits"]) for row in rows), Fraction())
 441         joules = sum((_fraction(row["outcomes"][arm]["joules"]) for row in rows), Fraction())
 442         return _ratio(bits, joules)
 443 
 444     arm_names = tuple(sorted(status[next(iter(status))]))
 445     if any(tuple(sorted(row)) != arm_names for row in status.values()):
 446         raise StageCContractError("degeneracy-report arm inventory differs by anchor")
 447     per_arm = {}
 448     for arm in arm_names:
 449         below_rows = [
 450             row for row in anchors if status[str(row["anchor_id"])][arm]
 451         ]
 452         shortfalls = []
 453         for row in below_rows:
 454             reference = row["reference"]
 455             outcome = row["outcomes"][arm]
 456             shortfalls.append(
 457                 _ratio(reference["bits"], reference["joules"])
 458                 - _ratio(outcome["bits"], outcome["joules"])
 459             )
 460         ordered = sorted(shortfalls)
 461         per_arm[arm] = {
 462             "anchor_count": len(anchors),
 463             "below_reference_count": len(below_rows),
 464             "below_reference_fraction": len(below_rows) / len(anchors),
 465             "shortfall_bits_per_j": [float(value) for value in ordered],
 466             "shortfall_min_bits_per_j": None if not ordered else float(ordered[0]),
 467             "shortfall_max_bits_per_j": None if not ordered else float(ordered[-1]),
 468         }
 469 
 470     reports: dict[str, object] = {}
 471     for name, left, right in contrasts:
 472         if any(left not in row["outcomes"] or right not in row["outcomes"] for row in anchors):
 473             raise StageCContractError(f"contrast {name} names an absent arm")
 474         restricted = [
 475             row
 476             for row in anchors
 477             if not status[str(row["anchor_id"])][left]
 478             and not status[str(row["anchor_id"])][right]
 479         ]
 480 
 481         def marginal(rows: Sequence[Mapping[str, object]]) -> float | None:
 482             if not rows:
 483                 return None
 484             denominator = pooled(rows, right)
 485             return None if denominator == 0 else float(pooled(rows, left) / denominator - 1)
 486 
 487         reports[name] = {
 488             "arms": [left, right],
 489             "all_anchor": {
 490                 "anchor_count": len(anchors),
 491                 "marginal_relative_pooled_ee": marginal(anchors),
 492             },
 493             "all_arms_at_or_above_reference": {
 494                 "anchor_count": len(restricted),
 495                 "anchor_ids": [str(row["anchor_id"]) for row in restricted],
 496                 "marginal_relative_pooled_ee": marginal(restricted),
 497             },
 498         }
 499     return {
 500         "screen": "exact sign against head-independent certified fixed point",
 501         "role": "REPORTING_ONLY_NOT_A_FILTER",
 502         "anchors_retained": len(anchors),
 503         "below_reference": status,
 504         "per_arm": per_arm,
 505         "contrasts": reports,
 506     }
 507 
