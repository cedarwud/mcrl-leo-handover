 388 def _ratio(bits: int | float | Fraction, joules: int | float | Fraction) -> Fraction:
 389     energy = _fraction(joules)
 390     if energy <= 0:
 391         raise StageCContractError("reporting energy must be positive")
 392     return _fraction(bits) / energy
