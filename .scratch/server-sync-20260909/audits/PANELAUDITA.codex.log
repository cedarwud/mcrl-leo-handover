 969 class V1LineageOrchestrator:
 970     """C7 matched five-arm learner with a scalar set-conditioned C3 route."""
 971 
 972     def __init__(
 973         self,
 974         *,
 975         learner_seed: int,
 976         q1_batch: PairwiseBatch,
 977         q2_batch: PairwiseBatch,
 978         c3_batch: CoalitionBatch,
 979         neutral_sources: Mapping[Route, NeutralSourceDefinition],
 980     ) -> None:
 981         if q1_batch.route != "C1" or q2_batch.route != "C2":
 982             raise StageCContractError("v1 action batches must be C1 then C2")
 983         if set(neutral_sources) != set(ROUTES) or any(
 984             neutral_sources[route].route != route for route in ROUTES
 985         ):
 986             raise StageCContractError("all three sealed neutral-source definitions are required")
 987         if len({q1_batch.physics_digest, q2_batch.physics_digest, c3_batch.physics_digest}) != 1:
 988             raise StageCContractError("C1/C2/C3 training physics digests disagree")
 989         self.learner_seed = int(learner_seed)
 990         self.q1_batch = q1_batch
 991         self.q2_batch = q2_batch
 992         self.c3_batch = c3_batch
 993         self.neutral_sources = dict(neutral_sources)
 994         self.physics_digest = q1_batch.physics_digest
 995         rng = np.random.default_rng(self.learner_seed)
 996         template = V1ThreeRouteModel(
 997             AdamMLPHead.create(
 998                 q1_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C1"], rng
 999             ),
1000             AdamMLPHead.create(
1001                 q2_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C2"], rng
1002             ),
1003             AdamSetInteractionHead(
1004                 AdamMLPHead.create(
1005                     c3_batch.invariant_states.shape[1], LEGACY_TRAINER_LITERALS["C3"], rng
1006                 ),
1007                 c3_batch.member_width,
1008             ),
1009         )
1010         self.initialization_payload = template.payload()
1011         self.initialization_sha256 = canonical_sha256(self.initialization_payload)
1012         self.models = {arm: template.clone() for arm in LEARNED_ARMS}
1013         # Engineering-only pilot lever: neutral batches are immutable and
1014         # identical for every source epoch, so materialise them once rather
1015         # than allocating and hashing them inside the hot epoch loop.
1016         self._neutral_q1 = q1_batch.neutral(self.neutral_sources["C1"])
1017         self._neutral_q2 = q2_batch.neutral(self.neutral_sources["C2"])
1018         self._neutral_c3 = c3_batch.neutral(self.neutral_sources["C3"])
1019         self.completed_source_epochs = 0
1020         self.route_update_count = 0
1021 
1022     def train_epoch(self) -> dict[str, dict[str, float]]:
1023         if self.completed_source_epochs >= LEGACY_EPOCH_BUDGET:
1024             raise StageCContractError("legacy exact epoch budget is already complete")
1025         losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
1026         for route, informed in (("C1", self.q1_batch), ("C2", self.q2_batch)):
1027             neutral = self._neutral_q1 if route == "C1" else self._neutral_q2
1028             for arm in LEARNED_ARMS:
1029                 batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
1030                 head = self.models[arm].q1 if route == "C1" else self.models[arm].q2
1031                 assert isinstance(head, AdamMLPHead)
1032                 losses[arm][route] = head.update(batch)
1033             self.route_update_count += 1
1034         for arm in LEARNED_ARMS:
1035             batch = self.c3_batch if SOURCE_MAP[arm]["C3"] == "informed" else self._neutral_c3
1036             head = self.models[arm].psi
1037             assert isinstance(head, AdamSetInteractionHead)
1038             losses[arm]["C3"] = head.update(batch)
1039         self.route_update_count += 1
1040         self.completed_source_epochs += 1
1041         return losses
1042 
1043     def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
1044         if isinstance(epochs, bool) or not isinstance(epochs, int) or epochs < 0:
1045             raise StageCContractError("epochs must be a nonnegative integer")
1046         if self.completed_source_epochs + epochs > LEGACY_EPOCH_BUDGET:
1047             raise StageCContractError("legacy exact epoch budget would be exceeded")
1048         for _ in range(epochs):
1049             self.train_epoch()
1050             if (
1051                 checkpoint_directory is not None
1052                 and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
1053             ):
1054                 self.write_checkpoint(
1055                     Path(checkpoint_directory)
1056                     / f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
1057                 )
1058 
1059     def fit_to_budget(self, *, checkpoint_directory: str | Path) -> None:
1060         """Production fit: exhaust the frozen budget and checkpoint every 100 epochs."""
1061 
1062         self.train(
1063             LEGACY_EPOCH_BUDGET - self.completed_source_epochs,
1064             checkpoint_directory=checkpoint_directory,
1065         )
1066 
1067     def checkpoint_payload(self) -> dict[str, object]:
