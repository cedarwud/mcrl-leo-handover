    98	def exact_nonfallback_builder(capture: EngineCapture):
    99	    """Execute the existing dispatcher's non-fallback branch privately."""
   100	
   101	    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
   102	        raise AssertionError("PILOT_PRIMITIVE_SOURCE_FALLBACK was not found unchanged")
   103	    namespace = dict(pilot._build_anchor_rows.__globals__)
   104	    namespace["PILOT_PRIMITIVE_SOURCE_FALLBACK"] = False
   105	    namespace["ENGINE"] = capture
   106	    return FunctionType(
   107	        pilot._build_anchor_rows.__code__,
   108	        namespace,
   109	        name="_build_anchor_rows_nonfallback_c3_panel_smoke",
   110	        argdefs=pilot._build_anchor_rows.__defaults__,
   111	        closure=pilot._build_anchor_rows.__closure__,
   112	    )
   113	
   114	
   115	def calibration() -> pilot.PilotCalibration:
   116	    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
   117	    fraction = lambda name: Fraction(*payload[name])
   118	    return pilot.PilotCalibration(
   119	        eta_ref=fraction("eta_ref"),
   120	        lambda_bits_per_j=fraction("lambda_bits_per_j"),
   121	        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
   122	        bits_ref=fraction("bits_ref"),
   123	        joules_ref=fraction("joules_ref"),
   124	        users=int(payload["users"]),
   125	    )
   126	
   127	
   128	def _row_key(row) -> tuple[int, int | None, int | None]:
   129	    return row.user_id, row.action.norad_id, row.action.beam_chain_id
   130	
   131	
   132	def assert_exact_targets(built: dict, forecasts: dict, cal) -> dict[str, int]:
   133	    base = built["base"]
   134	    incumbent = built["incumbent"]
   135	    current = built["current_evaluator"]
   136	    base_profile = current.evaluate(base)
   137	    base_forecasts = forecasts[base.configuration_id]
   138	    flags = labels = outages = 0
   139	    for row in built["rows"]:
   140	        mapping = base.mapping
   141	        mapping[row.user_id] = pilot._identity(row.action)
   142	        config = pilot.ENGINE._configuration(base, mapping, kind="c3-panel-assertion")
   143	        profile = current.evaluate(config)
   144	        projections = forecasts[config.configuration_id]
   145	        for offset, projection in enumerate(projections):
   146	            assert bool(row.q2_state[10 + 4 * offset]) is projection.valid
   147	            assert bool(row.q2_state[11 + 4 * offset]) is projection.survives
   148	            flags += 2
   149	
   150	        candidate_phi = pilot.ENGINE._phi_for(
   151	            incumbent,
   152	            config,
   153	            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
   154	                pilot.ENGINE._WORKER_TAPE if hasattr(pilot.ENGINE, "_WORKER_TAPE") else current.tape,
   155	                current.step_index,
   156	            ),
   157	        )
   158	        base_phi = pilot.ENGINE._phi_for(
   159	            incumbent,
   160	            base,
   161	            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
   162	                pilot.ENGINE._WORKER_TAPE if hasattr(pilot.ENGINE, "_WORKER_TAPE") else current.tape,
   163	                current.step_index,
   164	            ),
   165	        )
   166	        c1 = c1_difference_surplus(
   167	            NetworkOutcome.build(
   168	                bits=profile.bits,
   169	                joules=profile.joules,
   170	                phi=candidate_phi,
   171	                decoding_availability=1.0,
   172	                useful_availability=1.0,
   173	            ),
   174	            NetworkOutcome.build(
   175	                bits=base_profile.bits,
   176	                joules=base_profile.joules,
   177	                phi=base_phi,
   178	                decoding_availability=1.0,
   179	                useful_availability=1.0,
   180	            ),
   181	            lambda_bits_per_j=cal.lambda_bits_per_j,
   182	            eta_ref=cal.eta_ref,
   183	            kappa_bits_per_user_step=cal.kappa_bits_per_user_step,
   184	        )
   185	        assert float.fromhex(row.c1_label_bits_hex) == float(c1.difference_surplus_bits)
   186	        assert float.fromhex(row.c1_phi_difference_hex) == float(c1.phi_difference)
   187	        labels += 1
   188	
   189	        c2 = c2_persistence_forecast(
   190	            projections,
   191	            base_forecasts,
   192	            lambda_bits_per_j=cal.lambda_bits_per_j,
   193	            eta_ref=cal.eta_ref,
   194	            kappa_bits_per_user_step=cal.kappa_bits_per_user_step,
   195	        )
   196	        expected_c2 = float(c2.forecast_surplus_bits - c2.persistence_penalty_bits)
   197	        assert float.fromhex(row.c2_label_bits_hex) == expected_c2
   198	        labels += 1
   199	        assert row.outage is (not bool(profile.score.served_phy.get(row.user_id, False)))
   200	        outages += 1
   201	    return {
   202	        "validity_survival_assertions": flags,
   203	        "production_target_label_assertions": labels,
   204	        "exact_outage_assertions": outages,
   205	    }
