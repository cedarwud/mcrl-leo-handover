 660 class AdamMLPHead:
 661     """Legacy-shaped MLP trained by a literal Adam pairwise objective."""
 662 
 663     weights: list[np.ndarray]
 664     biases: list[np.ndarray]
 665     first_moment_w: list[np.ndarray]
 666     second_moment_w: list[np.ndarray]
 667     first_moment_b: list[np.ndarray]
 668     second_moment_b: list[np.ndarray]
 669     activation: str
 670     learning_rate: float
 671     beta1: float
 672     beta2: float
 673     epsilon: float
 674     weight_decay: float
 675     gauge_beta: float
 676     loss_weight: float
 677     adam_step: int = 0
 678 
 679     @classmethod
 680     def create(cls, input_dim: int, literal: Mapping[str, object], rng: np.random.Generator) -> "AdamMLPHead":
 681         widths = (input_dim, *tuple(int(value) for value in literal["hidden_layers"]), 1)
 682         weights = [
 683             rng.normal(0.0, np.sqrt(2.0 / max(1, left)), (left, right))
 684             for left, right in zip(widths[:-1], widths[1:], strict=True)
 685         ]
 686         biases = [np.zeros(right, dtype=np.float64) for right in widths[1:]]
 687         return cls(
 688             weights=weights,
 689             biases=biases,
 690             first_moment_w=[np.zeros_like(value) for value in weights],
 691             second_moment_w=[np.zeros_like(value) for value in weights],
 692             first_moment_b=[np.zeros_like(value) for value in biases],
 693             second_moment_b=[np.zeros_like(value) for value in biases],
 694             activation=str(literal["activation"]),
 695             learning_rate=float(literal["learning_rate"]),
 696             beta1=float(tuple(literal["adam_betas"])[0]),
 697             beta2=float(tuple(literal["adam_betas"])[1]),
 698             epsilon=float(literal["adam_epsilon"]),
 699             weight_decay=float(literal["weight_decay"]),
 700             gauge_beta=float(literal.get("gauge_beta", 0.0)),
 701             loss_weight=float(literal["loss_weight"]),
 702         )
 703 
 704     def clone(self) -> "AdamMLPHead":
 705         return AdamMLPHead(
 706             *(
 707                 [[value.copy() for value in group] for group in (
 708                     self.weights, self.biases, self.first_moment_w, self.second_moment_w,
 709                     self.first_moment_b, self.second_moment_b,
 710                 )]
 711             ),
 712             self.activation, self.learning_rate, self.beta1, self.beta2,
 713             self.epsilon, self.weight_decay, self.gauge_beta, self.loss_weight,
 714             self.adam_step,
 715         )
 716 
 717     def _forward(self, values: np.ndarray) -> tuple[np.ndarray, list[np.ndarray], list[np.ndarray]]:
 718         current = np.asarray(values, dtype=np.float64)
 719         activations = [current]
 720         preactivations: list[np.ndarray] = []
 721         for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
 722             pre = current @ weights + bias
 723             preactivations.append(pre)
 724             if index == len(self.weights) - 1:
 725                 current = pre
 726             elif self.activation == "relu":
 727                 current = np.maximum(pre, 0.0)
 728             else:
 729                 current = np.tanh(pre)
 730             activations.append(current)
 731         return current[:, 0], activations, preactivations
 732 
 733     def score(self, state: Sequence[float]) -> float:
 734         value, _, _ = self._forward(np.asarray(state, dtype=np.float64)[None, :])
 735         return float(value[0])
 736 
 737     def _backward(
 738         self, activations: list[np.ndarray], preactivations: list[np.ndarray], output_gradient: np.ndarray
 739     ) -> tuple[list[np.ndarray], list[np.ndarray]]:
 740         gradient = output_gradient[:, None]
 741         weight_gradients = [np.empty_like(value) for value in self.weights]
 742         bias_gradients = [np.empty_like(value) for value in self.biases]
 743         for index in reversed(range(len(self.weights))):
 744             weight_gradients[index] = activations[index].T @ gradient
 745             bias_gradients[index] = gradient.sum(axis=0)
 746             if index:
 747                 gradient = gradient @ self.weights[index].T
 748                 if self.activation == "relu":
 749                     gradient *= preactivations[index - 1] > 0.0
 750                 else:
 751                     hidden = activations[index]
 752                     gradient *= 1.0 - hidden * hidden
 753         return weight_gradients, bias_gradients
 754 
 755     def _adam(self, grad_w: list[np.ndarray], grad_b: list[np.ndarray]) -> None:
 756         self.adam_step += 1
 757         for parameter, gradient, first, second in zip(
 758             self.weights, grad_w, self.first_moment_w, self.second_moment_w, strict=True
 759         ):
 760             gradient = gradient + self.weight_decay * parameter
 761             first *= self.beta1
 762             first += (1.0 - self.beta1) * gradient
 763             second *= self.beta2
 764             second += (1.0 - self.beta2) * gradient * gradient
 765             corrected_m = first / (1.0 - self.beta1**self.adam_step)
 766             corrected_v = second / (1.0 - self.beta2**self.adam_step)
 767             parameter -= self.learning_rate * corrected_m / (np.sqrt(corrected_v) + self.epsilon)
 768         for parameter, gradient, first, second in zip(
 769             self.biases, grad_b, self.first_moment_b, self.second_moment_b, strict=True
 770         ):
 771             first *= self.beta1
 772             first += (1.0 - self.beta1) * gradient
 773             second *= self.beta2
 774             second += (1.0 - self.beta2) * gradient * gradient
 775             parameter -= self.learning_rate * (first / (1.0 - self.beta1**self.adam_step)) / (
 776                 np.sqrt(second / (1.0 - self.beta2**self.adam_step)) + self.epsilon
 777             )
 778 
 779     def update(self, batch: PairwiseBatch) -> float:
 780         reference, ref_a, ref_z = self._forward(batch.reference_states)
 781         candidate, cand_a, cand_z = self._forward(batch.candidate_states)
 782         residual = candidate - reference - batch.target_deltas
 783         count = float(len(residual))
 784         scale = 2.0 * self.loss_weight / count
 785         cand_w, cand_b = self._backward(cand_a, cand_z, scale * residual)
 786         ref_gradient = scale * (-residual + self.gauge_beta * reference)
 787         ref_w, ref_b = self._backward(ref_a, ref_z, ref_gradient)
 788         self._adam(
 789             [left + right for left, right in zip(cand_w, ref_w, strict=True)],
 790             [left + right for left, right in zip(cand_b, ref_b, strict=True)],
 791         )
 792         return float(self.loss_weight * np.mean(residual * residual + self.gauge_beta * reference * reference))
 793 
 794     def update_scalar(self, states: np.ndarray, targets: np.ndarray) -> float:
 795         prediction, activations, preactivations = self._forward(states)
 796         residual = prediction - targets
 797         scale = 2.0 * self.loss_weight / float(len(residual))
 798         gradients = self._backward(activations, preactivations, scale * residual)
 799         self._adam(*gradients)
 800         return float(self.loss_weight * np.mean(residual * residual))
 801 
 802     def payload(self) -> dict[str, object]:
 803         encode = lambda arrays: [
 804             [[float_hex(value) for value in row] for row in array]
 805             if array.ndim == 2 else [float_hex(value) for value in array]
 806             for array in arrays
 807         ]
 808         return {
 809             "kind": "legacy_heterogeneous_adam_mlp",
 810             "activation": self.activation,
 811             "weights_hex": encode(self.weights),
 812             "biases_hex": encode(self.biases),
 813             "adam_first_moment_weights_hex": encode(self.first_moment_w),
 814             "adam_second_moment_weights_hex": encode(self.second_moment_w),
 815             "adam_first_moment_biases_hex": encode(self.first_moment_b),
 816             "adam_second_moment_biases_hex": encode(self.second_moment_b),
 817             "adam_step": self.adam_step,
 818             "optimizer": {
 819                 "kind": "Adam", "learning_rate": self.learning_rate,
 820                 "betas": [self.beta1, self.beta2], "epsilon": self.epsilon,
 821                 "weight_decay": self.weight_decay,
 822             },
 823             "gauge_beta": self.gauge_beta,
 824             "loss_weight": self.loss_weight,
 825         }
