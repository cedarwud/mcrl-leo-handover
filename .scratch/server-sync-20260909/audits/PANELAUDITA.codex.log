 378 def _fraction(value: int | float | Fraction) -> Fraction:
 379     if isinstance(value, Fraction):
 380         return value
 381     if isinstance(value, int):
 382         return Fraction(value)
 383     if not math.isfinite(value):
 384         raise StageCContractError("reporting outcome must be finite")
 385     return Fraction.from_float(value)
