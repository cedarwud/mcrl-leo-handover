 123 def test_panel_selection_uses_unilateral_first_improvement_to_fixed_point() -> None:
 124     # Catalogue order offers score 1 before score 3.  First-improvement must
 125     # take that move and then its score-2 neighbour; a global argmax would
 126     # incorrectly jump directly to score 3.
 127     seed = canonical_assignment({0: (100, 10), 1: (200, 20)})
 128     first = canonical_assignment({0: (101, 11), 1: (200, 20)})
 129     fixed = canonical_assignment({0: (101, 11), 1: (201, 21)})
 130     global_best = canonical_assignment({0: (102, 12), 1: (202, 22)})
 131     plans = []
 132     for arm in PANEL_ARM_ORDER:
 133         plans.append(
 134             ArmPlan(
 135                 arm,
 136                 seed,
 137                 (
 138                     ScoredConfiguration(seed, 0.0),
 139                     ScoredConfiguration(first, 1.0),
 140                     ScoredConfiguration(fixed, 2.0),
 141                     ScoredConfiguration(global_best, 3.0),
 142                 ),
 143                 True,
 144             )
 145         )
 146     receipt = select_then_realise(
 147         tuple(plans),
 148         key_for=_key,
 149         evaluate=lambda _key: {},
 150         cache=PhysicalOutcomeCache(),
 151     )
 152     assert all(value == fixed for value in receipt["selected"].values())
