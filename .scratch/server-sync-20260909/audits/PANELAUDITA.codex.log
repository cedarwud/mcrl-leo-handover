 279 def _pilot_calibration(tape, setting, run_setting) -> PilotCalibration:
 280     base = ENGINE._base_configuration(tape, 0, "nearest-eligible")
 281     evaluator = ENGINE.StepEvaluator(
 282         tape,
 283         setting,
 284         0,
 285         transition_from=base,
 286         field="realised",
 287         run_setting=run_setting,
 288     )
 289     profile = evaluator.evaluate(base)
 290     bits = Fraction(str(profile.bits))
 291     joules = Fraction(str(profile.joules))
 292     if bits <= 0 or joules <= 0:
 293         raise RuntimeError("pilot calibration proxy has a nonpositive endpoint")
 294     return PilotCalibration(
 295         eta_ref=bits / joules,
 296         lambda_bits_per_j=bits / joules,
 297         kappa_bits_per_user_step=bits / len(tape.user_layout),
 298         bits_ref=bits,
 299         joules_ref=joules,
 300         users=len(tape.user_layout),
 301     )
