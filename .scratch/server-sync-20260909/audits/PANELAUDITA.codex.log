 176 def _route_label(row: SourceRow, route: Route) -> float:
 177     if route == "C3":
 178         # Compatibility-only build-1 synthetic batch.  Contract-v1 training
 179         # uses CoalitionBatch and never consumes a per-action C3 label.
 180         return 0.0
 181     field = {
 182         "C1": row.c1_label_normalized_hex,
 183         "C2": row.c2_label_normalized_hex,
 184     }[route]
 185     return parse_float_hex(field, field=f"{route}.normalized_label")

