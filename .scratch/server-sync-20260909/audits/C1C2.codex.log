  1383	def _structural_interactions(anchor, catalogue):
  1384	    return {
  1385	        config.configuration_id: {
  1386	            "changed": tuple(
  1387	                user for user in anchor.mapping
  1388	                if config.mapping[user] != anchor.mapping[user]
  1389	            ),
  1390	            "joint": 0.0, "additive": 0.0, "psi": 0.0,
  1391	        }
  1392	        for config in catalogue
  1393	    }
