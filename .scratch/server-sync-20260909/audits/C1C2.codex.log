   270	def test_two_user_independent_argmax_cannot_commit_jointly_infeasible_profile() -> None:
   271	    q1_dimension = len(Q1_FEATURES)
   272	    q2_dimension = len(Q2_FEATURES)
   273	    c3_dimension = q1_dimension + q2_dimension
   274	    model = ThreeRouteModel(
   275	        {
   276	            "C1": LinearHead(np.ones(q1_dimension), 0.0),
   277	            "C2": LinearHead(np.ones(q2_dimension), 0.0),
   278	            "C3": LinearHead(np.zeros(c3_dimension), 0.0),
   279	        }
   280	    )
   281	    tables = tuple(
   282	        UserActionTable(
   283	            user_id=user,
   284	            actions=(
   285	                PhysicalAction(100 + user, 10 + user),
   286	                PhysicalAction(200 + user, 20 + user),
   287	                PhysicalAction(None, None),
   288	            ),
   289	            action_mask=(True, True, True),
   290	            q1_states=(
   291	                tuple(np.zeros(q1_dimension)),
   292	                tuple(np.ones(q1_dimension)),
   293	                tuple(np.zeros(q1_dimension)),
   294	            ),
   295	            q2_states=(
   296	                tuple(np.zeros(q2_dimension)),
   297	                tuple(np.ones(q2_dimension)),
   298	                tuple(np.zeros(q2_dimension)),
   299	            ),
   300	        )
   301	        for user in range(2)
   302	    )
   303	    decision = DeploymentAdapter().select(
   304	        model=model,
   305	        tables=tables,
   306	        base_profile=(0, 0),
   307	        catalogue=((0, 0),),
   308	        jointly_legal=lambda profile: profile != (1, 1),
   309	        resolve_profile=lambda profile: ResolvedProfile(profile, 2),
   310	    )
   311	
   312	    assert decision.independent_profile == (1, 1)
   313	    assert decision.profile == (0, 0)
   314	    assert decision.jointly_legal is True
   315	    assert decision.used_fallback is True
   316	    assert decision.fallback_reason == "independent_profile_jointly_infeasible"
