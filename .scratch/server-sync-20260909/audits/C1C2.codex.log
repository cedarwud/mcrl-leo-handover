   152	    code_digest: str,
   153	    physics_digest: str,
   154	    catalogue_digest: str,
   155	    telemetry_sources_and_ages: Mapping[str, str] | None = None,
   156	    roster_and_cross_gain_coverage: str = "synthetic_complete_roster_and_beam_specific_cross_gains",
   157	    model_assumptions: Sequence[str] = ("nominal_no_realised_fading",),
