   983	def test_T3_crossed_cluster_real_merger_coverage_and_power(tmp_path) -> None:
   984	    units = tuple(
   985	        _unit(date, seed, world)
   986	        for date in ("2026-01-01", "2026-01-02", "2026-01-03")
   987	        for seed in (5, 12)
   988	        for world in (1, 2)
   989	    )
   990	    manifest = AllocationManifest.create(
   991	        units, bootstrap_draws=79, bootstrap_seed=31,
   992	        experiment_bindings=(_T3_BINDING,),
   993	        training_physics_digest=_digest("physics"),
   994	        baseline_implementation_sha256=_digest("baseline"),
   995	    )
   996	    evaluator = _ReceiptEvaluator()
   997	    dummy = ThreeRouteModel(
   998	        {route: LinearHead(np.zeros(1), 0.0) for route in ("C1", "C2", "C3")}
   999	    )
  1000	    models = {arm: dummy for arm in LEARNED_ARMS}
  1001	    conformance_runner = EvaluationRunner(
  1002	        manifest=manifest, registry=AttemptRegistry(tmp_path / "conformance.jsonl"),
  1003	        evaluator=evaluator, initial_temporal_state=evaluator.initial,
  1004	        output_directory=tmp_path / "conformance", steps=1,
  1005	    )
  1006	    conformance = conformance_runner.conformance_suite(unit=units[0], models=models)
  1007	    registry = AttemptRegistry(tmp_path / "attempts.jsonl")
  1008	    runner = EvaluationRunner(
  1009	        manifest=manifest, registry=registry, evaluator=evaluator,
