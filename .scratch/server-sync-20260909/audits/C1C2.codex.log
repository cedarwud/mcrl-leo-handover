   110	def _context(
   111	    kind: str,
   112	    members: tuple[int, ...],
   113	    *,
   114	    relabel: int = 0,
   115	    omit_joint_context: bool = False,
   116	    signal_scale: float = 1.0,
   117	) -> CoalitionContext:
   118	    base = tuple(
   119	        (user, PhysicalAction(None, None))
   120	        for user in range(max(3, max(members, default=-1) + 1))
   121	    )
   122	    del omit_joint_context
   123	    pairwise = {
   124	        # Same total cross-gain (0.9): one dominant aggressor versus three
   125	        # weak aggressors.  No scalar feature below discloses the distribution.
   126	        "synergy": (
   127	            ("beam-a", "victim", 0.7),
   128	            ("beam-b", "victim", 0.1),
   129	            ("beam-c", "victim", 0.1),
   130	        ),
   131	        "antagonistic": (
   132	            ("beam-a", "victim", 0.3),
   133	            ("beam-b", "victim", 0.3),
   134	            ("beam-c", "victim", 0.3),
   135	        ),
   136	        "additive": (
   137	            ("beam-a", "victim", 0.3),
   138	            ("beam-b", "victim", 0.3),
   139	            ("beam-c", "victim", 0.3),
   140	        ),
   141	    }[kind]
   142	    pairwise = tuple(
   143	        (source, target, signal_scale * gain) for source, target, gain in pairwise
   144	    )
   145	    return CoalitionContext(
   146	        anchor_id="information-twin-anchor",
   147	        reference_profile=base,
   148	        members=tuple(
   149	            CoalitionMember(
   150	                user_id=user,
   151	                reference_action=base[user][1],
   152	                selected_action=PhysicalAction(2000 + relabel + user, 20 + user),
   153	                selected_q1_row=(1.0,),
   154	                incumbent_q1_row=(float(user == 0),),
   155	                missing_incumbent=False,
   156	            )
   157	            for user in members
   158	        ),
   159	        affected_beams=tuple(
   160	            AffectedBeamContext(
   161	                beam_key,
   162	                0,
   163	                len(members),
   164	                False,
   165	                bool(members),
   166	                2.0,
   167	                0.9 * signal_scale if beam_key == "victim" else 0.0,
   168	            )
   169	            for beam_key in ("beam-a", "beam-b", "beam-c", "victim")
   170	        ),
   171	        global_resource_features=(0.5, 0.5, 0.5),
   172	        pairwise_cross_gain_terms=pairwise,
   173	    )
   174	
   175	
   176	def _coalition_row(
   177	    kind: str, *, tmp_count: int = 2, members: tuple[int, ...] = (0, 1),
   178	    signal_scale: float = 1.0,
   179	):
   180	    context = _context(kind, members, signal_scale=signal_scale)
   181	    joint = {
   182	        "synergy": _outcome(physical_f=4.0, phi=-1.0),       # F=+2
   183	        "antagonistic": _outcome(physical_f=-2.0, phi=-1.0), # F=-4
   184	        "additive": _outcome(physical_f=-2.0, phi=0.0),      # F=-2
   185	    }[kind]
   186	    return build_coalition_row(
   187	        context=context,
   188	        reference_outcome=_outcome(physical_f=0.0),
   189	        unilateral_outcomes={
   190	            user: (
   191	                _outcome(physical_f=0.0, phi=-0.5)
   192	                if user == 0
   193	                else _outcome(physical_f=-1.0)
   194	                if user == 1
   195	                else _outcome(physical_f=0.0)
   196	            )
   197	            for user in members
   198	        },
   199	        coalition_outcome=joint,
   200	        original_changed_user_count=tmp_count,
   201	        original_changed_users=tuple(range(tmp_count)),
   202	        world_id=f"synthetic/{kind}/{signal_scale.hex()}",
   203	        world_seed=11,
   204	        anchor_index=0,
   205	        decision_time_utc="2026-01-01T00:00:00Z",
   206	        decision_time_ns=0,
   207	        setting_id="synthetic",
   208	        lambda_bits_per_j=1.0,
   209	        eta_ref_bits_per_j=1.0,
   210	        kappa_normalization_bits=2.0,
   211	        code_digest=_digest("code"),
   212	        physics_digest=_digest("physics"),
   213	        catalogue_digest=_digest("catalogue"),
   214	        setting_digest=_digest("setting"),
   215	        calibration_digest=_digest("calibration"),
   216	        allocation_manifest_digest=_digest("allocation"),
   217	    )
   218	
   219	
   220	def _tables(*, relabel: int = 0) -> tuple[UserActionTable, ...]:
   221	    result = []
   222	    for user in range(3):
   223	        delta = -0.5 if user < 2 else 0.0
   224	        result.append(
   225	            UserActionTable(
   226	                user_id=user,
   227	                actions=(
   228	                    PhysicalAction(None, None),
   229	                    PhysicalAction(2000 + relabel + user, 20 + user),
   230	                ),
   231	                action_mask=(True, True),
   232	                q1_states=(
   233	                    tuple(0.0 for _ in Q1_FEATURES),
   234	                    (delta, *tuple(0.0 for _ in Q1_FEATURES[1:])),
   235	                ),
   236	                q2_states=(
   237	                    tuple(0.0 for _ in Q2_FEATURES),
   238	                    tuple(0.0 for _ in Q2_FEATURES),
   239	                ),
   240	            )
   241	        )
   242	    return tuple(result)
   243	
   244	
   245	def _profile_contexts(kind: str, *, relabel: int = 0, omit: bool = False):
   246	    result = {}
   247	    for profile in product((0, 1), repeat=3):
   248	        members = tuple(index for index, action in enumerate(profile) if action == 1)
   249	        result[profile] = _context(kind, members, relabel=relabel, omit_joint_context=omit)
   250	    return result
   251	
   252	
   253	def _pair(route: str) -> PairwiseBatch:
   254	    width = len(Q1_FEATURES) if route == "C1" else len(Q2_FEATURES)
   255	    reference = tuple(0.0 for _ in range(width))
   256	    candidate = (-0.5, *tuple(0.0 for _ in range(width - 1)))
   257	    return PairwiseBatch.create(
   258	        route,
   259	        (reference, reference),
   260	        (candidate, candidate),
   261	        (-0.5, -0.5),
   262	        (f"{route}-0", f"{route}-1"),
   263	        _digest("action-source"),
   264	        physics_digest=_digest("physics"),
   265	    )
   266	
   267	
   268	def _model_from_batch(
   269	    batch: CoalitionBatch, tmp_path, *, epochs: int = 800
   270	) -> V1ThreeRouteModel:
   271	    source_rows = tuple(
   272	        replace(row, physics_digest=batch.physics_digest)
   273	        for anchor in make_synthetic_anchors()
   274	        for row in extract_source_rows(anchor)
   275	    )
   276	    source_shard = write_source_shard(
   277	        tmp_path / f"source-{batch.digest[:12]}.jsonl", source_rows
   278	    )
   279	    pairs = build_pairwise_batches((source_shard,))
   280	    orchestrator = V1LineageOrchestrator(
   281	        learner_seed=17,
   282	        q1_batch=pairs["C1"],
   283	        q2_batch=pairs["C2"],
   284	        c3_batch=batch,
   285	        neutral_sources=default_synthetic_neutral_sources(),
   286	    )
   287	    orchestrator.train(epochs)
   288	    orchestrator.bind_checkpoint_identity()
   289	    return orchestrator.models["FULL"]
   290	
   291	
   292	def _held_out_training_batch(tmp_path, name: str) -> CoalitionBatch:
   293	    """Train on bracketing twins; the asserted scale=1.0 twins stay held out."""
   294	
   295	    rows = tuple(
   296	        _coalition_row(kind, signal_scale=scale)
   297	        for scale in (0.75, 1.25)
   298	        for kind in ("synergy", "antagonistic", "additive")
   299	    )
   300	    return CoalitionBatch.create((write_coalition_shard(tmp_path / name, rows),))
   301	
