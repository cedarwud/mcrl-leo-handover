    97	def _outcome(*, physical_f: float, phi: float = 0.0, kappa: float = 2.0) -> NetworkOutcome:
    98	    # eta=1, E=100, so physical objective is bits-100.  The signed preference
    99	    # enters F as +kappa*phi exactly once.
   100	    del kappa
   101	    return NetworkOutcome.build(
   102	        bits=100.0 + physical_f,
   103	        joules=100.0,
   104	        phi=phi,
   105	        decoding_availability=1.0,
   106	        useful_availability=1.0,
   107	    )
