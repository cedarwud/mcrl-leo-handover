   303	def _selector_authority(
   304	    tables: tuple[UserActionTable, ...],
   305	    catalogue: tuple[tuple[int, ...], ...],
   306	    *,
   307	    anchor_id: str,
   308	    base: tuple[int, ...] = (0, 0, 0),
   309	):
   310	    profiles = tuple(CatalogueProfile(tuple(
   311	        (table.user_id, table.actions[action])
   312	        for table, action in zip(tables, profile, strict=True)
   313	    )) for profile in catalogue)
   314	    catalogue_digest = canonical_sha256([profile.payload() for profile in profiles])
   315	    source = _digest("source-provenance")
   316	    coordinator = CoordinatorInformation(
   317	        anchor_id=anchor_id, decision_time_ns=0,
   318	        global_nominal_geometry_sha256=_digest("global-geometry"),
   319	        beam_specific_cross_gains_sha256=_digest("cross-gains"),
   320	        legal_sets_sha256=_digest("legal-sets"), previous_committed_sha256=_digest("previous"),
   321	        references=ReferenceProfiles(
   322	            tuple(table.actions[index] for table, index in zip(tables, base, strict=True)),
   323	            tuple(table.actions[index] for table, index in zip(tables, base, strict=True)),
   324	        ),
   325	        catalogue=profiles, catalogue_sha256=catalogue_digest,
   326	        nominal_model_sha256=_digest("nominal-model"),
   327	        source_provenance_sha256=source, forecast_method_sha256=_digest("forecast"),
   328	        nominal_outputs=tuple(NominalProfileOutput(
   329	            profile_sha256=canonical_sha256(profile.payload()),
   330	            joint_load=(("b", 0.0),), coupled_powers_w=(("b", 0.0),),
   331	            interference_w=(("b", 0.0),), activation=(("b", False),),
   332	            service_by_user=tuple((table.user_id, True) for table in tables),
   333	            bits=0.0, energy_j=0.0, continuation_normalized=0.0,
   334	        ) for profile in profiles),
   335	    )
   336	    interfaces = {arm: ArmInformationInterface(
   337	        arm=arm, anchor_id=anchor_id, decision_time_ns=0,
   338	        primitive_access_sha256=_digest("primitive"), forecast_method_sha256=_digest("forecast"),
   339	        physical_identity_schema_sha256=_digest("identity"), catalogue_sha256=catalogue_digest,
   340	        joint_search_sha256=_digest("search"), guards_sha256=_digest("guards"),
   341	        tie_breaking_sha256=_digest("ties"), validation_sha256=_digest("validation"),
   342	        deadline_sha256=_digest("deadline"), fallback_sha256=_digest("fallback"),
   343	        source_provenance_sha256=source, learned_pruning=False,
   344	    ) for arm in ("FULL", "DROP_C1", "DROP_C2", "DROP_C3", "ALL_NEUTRAL_CONTROL", "BASELINE", "S0", "S_UNI")}
   345	    matched = authenticate_matched_catalogues(interfaces, required_arms=tuple(interfaces))
   346	    return {
   347	        "coordinator_information": coordinator,
   348	        "arm_information_interfaces": interfaces,
   349	        "matched_information_sha256": matched,
   350	    }
