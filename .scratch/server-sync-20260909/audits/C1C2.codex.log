   176	def _coalition_row(
   177	    kind: str, *, tmp_count: int = 2, members: tuple[int, ...] = (0, 1),
   178	    signal_scale: float = 1.0,
   179	):
   180	    context = _context(kind, members, signal_scale=signal_scale)
   181	    joint = {
   182	        "synergy": _outcome(physical_f=4.0, phi=-1.0),       # F=+2
   183	        "antagonistic": _outcome(physical_f=-2.0, phi=-1.0), # F=-4
   184	        "additive": _outcome(physical_f=-2.0, phi=0.0),      # F=-2
   185	    }[kind]
   186	    return build_coalition_row(
   187	        context=context,
   188	        reference_outcome=_outcome(physical_f=0.0),
   189	        unilateral_outcomes={
   190	            user: (
   191	                _outcome(physical_f=0.0, phi=-0.5)
   192	                if user == 0
   193	                else _outcome(physical_f=-1.0)
   194	                if user == 1
   195	                else _outcome(physical_f=0.0)
   196	            )
   197	            for user in members
   198	        },
   199	        coalition_outcome=joint,
   200	        original_changed_user_count=tmp_count,
   201	        original_changed_users=tuple(range(tmp_count)),
   202	        world_id=f"synthetic/{kind}/{signal_scale.hex()}",
   203	        world_seed=11,
   204	        anchor_index=0,
   205	        decision_time_utc="2026-01-01T00:00:00Z",
   206	        decision_time_ns=0,
   207	        setting_id="synthetic",
   208	        lambda_bits_per_j=1.0,
   209	        eta_ref_bits_per_j=1.0,
   210	        kappa_normalization_bits=2.0,
   211	        code_digest=_digest("code"),
   212	        physics_digest=_digest("physics"),
   213	        catalogue_digest=_digest("catalogue"),
   214	        setting_digest=_digest("setting"),
   215	        calibration_digest=_digest("calibration"),
   216	        allocation_manifest_digest=_digest("allocation"),
   217	    )
