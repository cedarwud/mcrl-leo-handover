   924	class _ReceiptEvaluator:
   925	    action = PhysicalAction(1, 1)
   926	
   927	    @classmethod
   928	    def initial(cls, *, unit, arm):
   929	        del unit, arm
   930	        return InitialTemporalState((cls.action,), frozenset({0}))
   931	
   932	    def __call__(self, *, unit, arm, model, step_index, previous_profile):
   933	        del model, step_index, previous_profile
   934	        energy = 1.0 if unit.world_seed % 2 else 4.0
   935	        ee = 10.0
   936	        if arm in {"DROP_C1", "FULL"}:
   937	            bits = ee * energy
   938	        elif arm == "DROP_C2":
   939	            bits = 0.0
   940	        elif arm == "DROP_C3":
   941	            bits, energy = 0.0, 0.0
   942	        else:
   943	            bits = 9.0 * energy
   944	        return StepOutcome(
   945	            bits=bits, energy_components_j={"total": energy}, user_ids=(0,),
   946	            profile=(self.action,), complete_service=(True,), decoding_user_seconds=1.0,
   947	            useful_user_seconds=1.0, opportunity_user_seconds=1.0, jointly_legal=True,
   948	            coordinator_latency_s=0.001,
   949	            selected_profile_differs_from_additive=arm == "FULL",
   950	            rejected_harmful_joint_move=arm == "FULL",
   951	        )
   952	
