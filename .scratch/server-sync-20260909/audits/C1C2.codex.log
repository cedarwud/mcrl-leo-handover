   157	def _action_visible_payload(item: ActionEvaluation) -> dict[str, object]:
   158	    """Exact B1 dependency allowlist: every value consumed by Q1/Q2/labels."""
   159	
   160	    omitted = {
   161	        "source_provenance_sha256",
   162	        "forecast_method_sha256",
   163	        "visible_primitives_sha256",
   164	        "tle_provenance",
   165	        "future_tle_access",
   166	    }
   167	    payload = {
   168	        name: value
   169	        for name, value in asdict(item).items()
   170	        if name not in omitted
   171	    }
   172	    payload["action"] = item.action.payload()
   173	    return payload
