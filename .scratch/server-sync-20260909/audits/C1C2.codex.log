   162	    solver_limits: Mapping[str, object] | None = None,
   163	    memory_limit_bytes: int = 1_073_741_824,
   164	    missing_data_handling: str = "reject_and_execute_prevalidated_base",
   165	    measured_end_to_end_latency_s: Sequence[float],
   166	) -> dict[str, object]:
   167	    for name, digest in (
   168	        ("code_digest", code_digest),
   169	        ("physics_digest", physics_digest),
   170	        ("catalogue_digest", catalogue_digest),
   171	    ):
   172	        if not isinstance(digest, str) or len(digest) != 64 or any(
   173	            char not in "0123456789abcdef" for char in digest
   174	        ):
   175	            raise StageCContractError(f"{name} must be a lowercase SHA-256")
   176	    if worker_count < 1 or memory_limit_bytes < 1:
   177	        raise StageCContractError("capability worker and memory limits must be positive")
   178	    latency = tuple(float(value) for value in measured_end_to_end_latency_s)
   179	    if not latency or any(not math.isfinite(value) or value < 0.0 for value in latency):
   180	        raise StageCContractError("capability requires nonempty nonnegative latency observations")
   181	    payload: dict[str, object] = {
   182	        "schema": "mcrl-v025-stagec-deployment-capability-v1",
   183	        "code_digest": code_digest,
   184	        "physics_digest": physics_digest,
   185	        "catalogue_digest": catalogue_digest,
   186	        "coordinator_compute_budget_wall_s": DEPLOYMENT_DEADLINE_S,
   187	        "decision_interval_s": 30.08,
   188	        "reserved_interval_use": "sensing_transport_validation_and_atomic_commit",
   189	        "inputs": [
