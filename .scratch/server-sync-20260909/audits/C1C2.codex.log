    71	    assert report["synthetic"]["learned_arms_per_seed"] == 5
    72	    assert report["synthetic"]["external_baseline_per_seed"] == 1
    73	    assert report["synthetic"]["conformance"]["null_equals_base"] is True
    74	    assert report["synthetic"]["conformance"]["real_step_arms"] == [
