   306	def _validate_anchor(anchor: PerAnchorEvaluation) -> None:
   307	    if anchor.split != "TRAIN":
   308	        raise StageCContractError("Stage C source construction is TRAIN-only")
   309	    if not anchor.actions:
   310	        raise StageCContractError("anchor must carry at least the explicit null action")
   311	    if not 0 <= anchor.base_action_index < len(anchor.actions):
   312	        raise StageCContractError("base_action_index is outside the action table")
   313	    if not anchor.actions[anchor.base_action_index].legal:
   314	        raise StageCContractError("BASE action must be legal")
   315	    if not any(item.legal and item.action.is_null for item in anchor.actions):
   316	        raise StageCContractError("anchor must include an explicit legal null action")
   317	    if (
   318	        not math.isfinite(anchor.kappa_normalization_bits)
   319	        or anchor.kappa_normalization_bits <= 0.0
   320	    ):
   321	        raise StageCContractError("normalization kappa must be a positive bit scale")
   322	    if (
   323	        not math.isfinite(anchor.lambda_bits_per_j)
   324	        or anchor.lambda_bits_per_j <= 0.0
   325	        or anchor.lambda_bits_per_j != anchor.eta_ref_bits_per_j
   326	    ):
   327	        raise StageCContractError("lambda and eta_ref must be identical")
   328	    if anchor.anchor_index < 0 or anchor.decision_time_ns < 0:
   329	        raise StageCContractError("anchor indices/times must be nonnegative")
   330	    identities = [item.action for item in anchor.actions]
   331	    if len(set(identities)) != len(identities):
   332	        raise StageCContractError("anchor has duplicate physical actions")
   333	    for field in (
   334	        "code_digest",
   335	        "physics_digest",
   336	        "launch_digest",
   337	        "catalogue_digest",
   338	        "setting_digest",
   339	        "calibration_digest",
   340	        "provider_digest",
   341	        "archive_digest",
   342	        "allocation_manifest_digest",
   343	    ):
   344	        digest = getattr(anchor, field)
   345	        if (
   346	            len(digest) != 64
   347	            or any(character not in "0123456789abcdef" for character in digest)
   348	        ):
   349	            raise StageCContractError(f"{field} must be a lowercase SHA-256")
   350	    try:
   351	        parsed = datetime.fromisoformat(anchor.decision_time_utc.replace("Z", "+00:00"))
   352	    except ValueError as error:
   353	        raise StageCContractError("decision_time_utc must be RFC3339") from error
   354	    if parsed.tzinfo is None:
   355	        raise StageCContractError("decision_time_utc must include a timezone")
