   167	def _route_state(row: SourceRow, route: Route) -> tuple[float, ...]:
   168	    if route == "C1":
   169	        return row.q1_state
   170	    if route == "C2":
   171	        return row.q2_state
   172	    return (*row.q1_state, *row.q2_state)
   173	
   174	
   175	def _route_label(row: SourceRow, route: Route) -> float:
   176	    if route == "C3":
   177	        # Compatibility-only build-1 synthetic batch.  Contract-v1 training
   178	        # uses CoalitionBatch and never consumes a per-action C3 label.
   179	        return 0.0
   180	    field = {
   181	        "C1": row.c1_label_normalized_hex,
   182	        "C2": row.c2_label_normalized_hex,
   183	    }[route]
   184	    return parse_float_hex(field, field=f"{route}.normalized_label")
   185	
   186	
   187	def build_pairwise_batches(shards: Sequence[SourceShard]) -> dict[Route, PairwiseBatch]:
   188	    rows = tuple(row for shard in shards for row in shard.rows)
   189	    physics = {row.physics_digest for row in rows}
   190	    if len(physics) != 1:
   191	        raise StageCContractError("pairwise source shards mix physics digests")
   192	    physics_digest = next(iter(physics))
   193	    source_authority_sha256 = canonical_sha256(
   194	        {
   195	            "schema": "mcrl-v025-stagec-source-authority-v1",
   196	            "shards": [shard.file_sha256 for shard in shards],
   197	            "authorities": sorted(
   198	                {
   199	                    (
   200	                        row.code_digest,
   201	                        row.physics_digest,
   202	                        row.launch_digest,
   203	                        row.catalogue_digest,
   204	                        row.provider_digest,
   205	                        row.archive_digest,
   206	                        row.setting_digest,
   207	                        row.calibration_digest,
   208	                        row.allocation_manifest_digest,
   209	                        row.q1_schema_sha256,
   210	                        row.q2_schema_sha256,
   211	                    )
   212	                    for row in rows
   213	                }
   214	            ),
   215	        }
   216	    )
   217	    groups: dict[tuple[str, str, int], list[SourceRow]] = {}
   218	    for row in rows:
   219	        groups.setdefault((row.world_id, row.anchor_id, row.user_id), []).append(row)
   220	    by_route: dict[Route, PairwiseBatch] = {}
   221	    for route in ROUTES:
   222	        references: list[tuple[float, ...]] = []
   223	        candidates: list[tuple[float, ...]] = []
   224	        targets: list[float] = []
   225	        identities: list[str] = []
   226	        for key in sorted(groups):
   227	            ordered = sorted(groups[key], key=lambda row: row.action_index)
   228	            shared_mask = ordered[0].action_mask
   229	            if any(row.action_mask != shared_mask for row in ordered):
   230	                raise StageCContractError("user-anchor rows disagree on the legal mask")
   231	            expected_indices = [
   232	                index for index, enabled in enumerate(shared_mask) if enabled
   233	            ]
   234	            if [row.action_index for row in ordered] != expected_indices:
   235	                raise StageCContractError("user-anchor rows do not cover each legal action once")
   236	            if sum(row.null_action for row in ordered) != 1:
   237	                raise StageCContractError("user-anchor requires exactly one legal null action")
   238	            reference_rows = [row for row in ordered if row.reference_action]
   239	            if len(reference_rows) != 1:
   240	                raise StageCContractError("every user-anchor requires exactly one BASE row")
   241	            reference = reference_rows[0]
   242	            for candidate in ordered:
   243	                if candidate.reference_action or not candidate.action_mask[candidate.action_index]:
   244	                    continue
   245	                references.append(_route_state(reference, route))
   246	                candidates.append(_route_state(candidate, route))
   247	                targets.append(_route_label(candidate, route) - _route_label(reference, route))
   248	                identities.append(
   249	                    f"{candidate.world_id}|{candidate.anchor_id}|{candidate.user_id}|{candidate.action_index}"
   250	                )
   251	        by_route[route] = PairwiseBatch.create(
   252	            route,
   253	            references,
   254	            candidates,
   255	            targets,
   256	            identities,
   257	            source_authority_sha256,
   258	            physics_digest=physics_digest,
   259	        )
   260	    return by_route
   261	
   262	
   263	@dataclass(slots=True)
   264	class LinearHead:
   265	    weights: np.ndarray
   266	    bias: float
   267	
   268	    def clone(self) -> "LinearHead":
   269	        return LinearHead(self.weights.copy(), float(self.bias))
   270	
   271	    def score(self, state: Sequence[float]) -> float:
   272	        values = np.asarray(state, dtype=np.float64)
   273	        if values.shape != self.weights.shape:
   274	            raise StageCContractError("learner state shape drifted")
   275	        return float(values @ self.weights + self.bias)
   276	
   277	    def update(self, batch: PairwiseBatch, *, learning_rate: float, gauge_weight: float) -> float:
   278	        # Pairwise fixed-target regression with a reference-zero gauge. No
   279	        # reward, next state, target network, discount, or bootstrap exists.
   280	        reference_q = batch.reference_states @ self.weights + self.bias
   281	        candidate_q = batch.candidate_states @ self.weights + self.bias
   282	        residual = candidate_q - reference_q - batch.target_deltas
   283	        count = float(batch.target_deltas.size)
   284	        gradient_w = (2.0 / count) * ((batch.candidate_states - batch.reference_states).T @ residual)
   285	        gradient_w += (2.0 * gauge_weight / count) * (batch.reference_states.T @ reference_q)
   286	        gradient_b = float((2.0 * gauge_weight / count) * reference_q.sum())
   287	        self.weights -= learning_rate * gradient_w
   288	        self.bias -= learning_rate * gradient_b
   289	        loss = float(np.mean(residual * residual) + gauge_weight * np.mean(reference_q * reference_q))
   290	        if not np.isfinite(self.weights).all() or not np.isfinite(self.bias) or not np.isfinite(loss):
   291	            raise StageCContractError("non-finite learner update")
   292	        return loss
   293	
   294	
   295	@dataclass(slots=True)
   296	class ThreeRouteModel:
   297	    heads: dict[Route, LinearHead]
   298	
   299	    def clone(self) -> "ThreeRouteModel":
   300	        return ThreeRouteModel({route: head.clone() for route, head in self.heads.items()})
   301	
   302	    def score(self, route: Route, state: Sequence[float]) -> float:
   303	        return self.heads[route].score(state)
   304	
   305	    def payload(self) -> dict[str, object]:
   306	        return {
   307	            route: {
   308	                "weights_hex": [float_hex(value) for value in self.heads[route].weights],
   309	                "bias_hex": float_hex(self.heads[route].bias),
   310	            }
   311	            for route in ROUTES
   312	        }
   313	
   314	
   315	def _initial_model(seed: int, dimensions: Mapping[Route, int]) -> ThreeRouteModel:
   316	    rng = np.random.default_rng(seed)
   317	    return ThreeRouteModel(
   318	        {
   319	            route: LinearHead(rng.normal(0.0, 0.01, dimensions[route]), 0.0)
   320	            for route in ROUTES
   321	        }
   322	    )
