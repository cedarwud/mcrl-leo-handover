   191	            "per_user_legal_physical_actions",
   192	            "previous_committed_physical_profile",
   193	            "beam_specific_cross_gains",
   194	            "nominal_forecasts",
   195	            "sealed_calibration",
   196	        ],
   197	        "capabilities": [
   198	            "construct_complete_simultaneous_profiles",
   199	            "resolve_joint_nominal_physics",
   200	            "evaluate_sealed_bounded_catalogue",
   201	            "validate_joint_legality",
   202	            "enforce_no_served_count_decrease_vs_base",
   203	            "atomically_commit_or_base_fallback",
   204	        ],
   205	        "timer_enforcement": "runner_process_deadline_kill_join",
   206	        "base_first": "computed_validated_and_repaired_before_coordinator_timer",
   207	        "deadline_fallback": "execute_prevalidated_a0",
   208	        "telemetry_sources_and_ages": dict(
   209	            telemetry_sources_and_ages
   210	            or {"synthetic_fixture": "age_0_at_declared_decision_time"}
   211	        ),
   212	        "roster_and_cross_gain_coverage": roster_and_cross_gain_coverage,
   213	        "model_assumptions": list(model_assumptions),
   214	        "calibration_source": calibration_source,
   215	        "worker_hardware": worker_hardware,
   216	        "worker_count": worker_count,
   217	        "cache_policy": "cold_per_anchor_no_warm_cache",
   218	        "catalogue_bounds": dict(catalogue_bounds or {"profiles": 64, "coalition_size": 4}),
   219	        "solver_limits": dict(solver_limits or {"wall_s": DEPLOYMENT_DEADLINE_S}),
   220	        "memory_limit_bytes": memory_limit_bytes,
   221	        "missing_data_handling": missing_data_handling,
   222	        "measured_end_to_end_latency_distribution_s": {
   223	            "samples": list(latency),
   224	            "count": len(latency),
   225	            "p50": None if not latency else float(sorted(latency)[len(latency) // 2]),
   226	            "max": None if not latency else max(latency),
   227	        },
   228	    }
   229	    payload["manifest_sha256"] = canonical_sha256(payload)
   230	    return payload
