   353	def test_T1_exhaustive_decomposition_and_intervention(tmp_path) -> None:
   354	    synergy = _coalition_row("synergy")
   355	    antagonistic = _coalition_row("antagonistic")
   356	    additive = _coalition_row("additive")
   357	
   358	    # Exact B4 identity with nonzero Phi charged once, and the second physical
   359	    # identity without Phi.  Values are normalized by kappa=2.
   360	    assert float.fromhex(synergy.c1_normalized_hex) == -1.0
   361	    assert float.fromhex(synergy.psi_normalized_hex) == 2.0
   362	    assert float.fromhex(synergy.objective_delta_normalized_hex) == 1.0
   363	    assert float.fromhex(synergy.physical_c1_normalized_hex) == -0.5
   364	    assert float.fromhex(synergy.physical_psi_normalized_hex) == 2.5
   365	    assert float.fromhex(synergy.physical_delta_normalized_hex) == 2.0
   366	    assert float.fromhex(antagonistic.psi_normalized_hex) == -1.0
   367	    assert float.fromhex(additive.psi_normalized_hex) == 0.0
   368	    # Exhaust all 2^3 profiles at each of the three hand-computed steps.  User
   369	    # 2 is a dummy, so toggling only that bit never changes F or Psi.
   370	    joint_f = {"additive": -2.0, "synergy": 2.0, "antagonistic": -4.0}
   371	    for kind, profile in product(joint_f, product((0, 1), repeat=3)):
   372	        u0, u1, dummy = profile
   373	        value = joint_f[kind] if u0 and u1 else -float(u0 + u1)
   374	        without_dummy = (u0, u1, 0)
   375	        value_without_dummy = (
   376	            joint_f[kind]
   377	            if without_dummy[0] and without_dummy[1]
   378	            else -float(without_dummy[0] + without_dummy[1])
   379	        )
   380	        assert value == value_without_dummy
   381	        psi = value - (-float(u0)) - (-float(u1))
   382	        assert psi == (joint_f[kind] + 2.0 if u0 and u1 else 0.0)
   383	    assert kappa_normalization_bits(2.0) == pytest.approx(60.16)
   384	    reporting_credit = pair_reporting_credit(
   385	        psi_normalized=2.0, coalition_users=(0, 1), roster=(0, 1, 2)
   386	    )
   387	    assert reporting_credit == {0: 1.0, 1: 1.0, 2: 0.0}
   388	    shapley = exact_shapley_reporting_credit(
   389	        coalition_users=(0, 1),
   390	        subset_values={
   391	            frozenset(): 0.0,
   392	            frozenset({0}): -1.0,
   393	            frozenset({1}): -1.0,
   394	            frozenset({0, 1}): 2.0,
   395	        },
   396	        roster=(0, 1, 2),
   397	    )
   398	    assert shapley == {0: 1.0, 1: 1.0, 2: 0.0}
   399	    dummy_row = _coalition_row("synergy", tmp_count=3, members=(0, 1, 2))
   400	    assert float.fromhex(dummy_row.psi_normalized_hex) == 2.0
   401	    assert float.fromhex(dummy_row.objective_delta_normalized_hex) == 1.0
   402	    uncapped = _coalition_row("synergy", tmp_count=5, members=(0, 1, 2, 3, 4))
   403	    assert uncapped.capped_decomposition is False
   404	    assert uncapped.credit_split == "NOT_COMPUTED_LARGE_SET"
   405	    assert float.fromhex(uncapped.decomposition_weight_hex) == 1.0
   406	    decomposition = capped_coalition_decomposition(tuple(range(5)))
   407	    assert decomposition == ((tuple(range(5)), 1.0),)
   408	    uncapped_rows = tuple(
   409	        _coalition_row("synergy", tmp_count=5, members=users)
   410	        for users, _weight in decomposition
   411	    )
   412	    assert len(uncapped_rows) == 1
   413	    assert sum(float.fromhex(row.decomposition_weight_hex) for row in uncapped_rows) == 1.0
   414	
   415	    def projection(index: int, *, survives: bool) -> OffsetProjection:
   416	        return OffsetProjection(
   417	            offset_index=index,
   418	            valid=True,
   419	            survives=survives,
   420	            outcome=_outcome(physical_f=0.0),
   421	            background_power_recomputed=True,
   422	            required_power_w=0.5,
   423	            power_cap_w=1.0,
   424	            min_decoding_margin_db=1.0,
   425	            mean_acm_se_bit_s_hz=1.0,
   426	        )
   427	
   428	    future = c2_persistence_forecast(
   429	        (projection(1, survives=True), projection(2, survives=False), projection(3, survives=True)),
   430	        tuple(projection(index, survives=True) for index in (1, 2, 3)),
   431	        lambda_bits_per_j=1,
   432	        eta_ref=1,
   433	        kappa_bits_per_user_s=2,
   434	    )
   435	    assert future.lost_offsets == 2
   436	    assert future.normalized_total == -2
   437	
   438	    shard = write_coalition_shard(tmp_path / "c3.jsonl", (synergy, antagonistic, additive))
   439	    reopened = read_coalition_shard(shard.path)
   440	    assert reopened.rows == shard.rows
   441	    batch = CoalitionBatch.create((reopened,))
   442	    training_batch = _held_out_training_batch(tmp_path, "c3-training.jsonl")
   443	    model = _model_from_batch(training_batch, tmp_path)
   444	    assert LEGACY_EPOCH_BUDGET == 2000
   445	    assert LEGACY_TRAINER_LITERALS["C1"]["hidden_layers"] == (8,)
   446	    assert LEGACY_TRAINER_LITERALS["C2"]["hidden_layers"] == (100, 50, 50)
   447	    assert LEGACY_TRAINER_LITERALS["C3"]["hidden_layers"] == (64, 64)
   448	    assert [weights.shape for weights in model.q1.weights] == [(16, 8), (8, 1)]
   449	    assert [weights.shape for weights in model.q2.weights] == [
   450	        (22, 100), (100, 50), (50, 50), (50, 1)
   451	    ]
   452	    assert [weights.shape for weights in model.psi.network.weights][-1] == (64, 1)
   453	    tables = _tables()
   454	    catalogue = tuple(product((0, 1), repeat=3))
   455	    legal = lambda profile: profile in catalogue
   456	    guard = lambda profile: True
   457	    exact_synergy = lambda profile: 2.0 if profile[0] == profile[1] == 1 else 0.0
   458	    exact_antagonistic = lambda profile: -1.0 if profile[0] == profile[1] == 1 else 0.0
   459	    s0 = ProfileSelector("S0")
   460	    assert s0.select(
   461	        base_profile=(0, 0, 0), tables=tables, catalogue=catalogue,
   462	        jointly_legal=legal, service_guard=guard, model=model,
   463	        coalition_context=_profile_contexts("synergy"), exact_psi=exact_synergy,
   464	        **_selector_authority(tables, catalogue, anchor_id="information-twin-anchor"),
   465	    ).profile == (1, 1, 0)
   466	    assert s0.select(
   467	        base_profile=(0, 0, 0), tables=tables, catalogue=catalogue,
   468	        jointly_legal=legal, service_guard=guard, model=model,
   469	        coalition_context=_profile_contexts("antagonistic"), exact_psi=exact_antagonistic,
   470	        **_selector_authority(tables, catalogue, anchor_id="information-twin-anchor"),
   471	    ).profile == (0, 0, 0)
   472	    knockout = CheckpointKnockoutExperiment(
   473	        "mcrl-v025-checkpoint-knockout-v1",
   474	        model.checkpoint_sha256,
   475	        ("C1", "C2", "C3"),
   476	        True,
   477	    )
   478	    assert s0.select(
   479	        base_profile=(0, 0, 0), tables=tables, catalogue=catalogue,
   480	        jointly_legal=legal, service_guard=guard, model=model,
   481	        coalition_context=_profile_contexts("synergy"), exact_psi=exact_synergy,
   482	        knockout_route="C3", knockout_experiment=knockout,
   483	        model_checkpoint_sha256=model.checkpoint_sha256,
   484	        **_selector_authority(tables, catalogue, anchor_id="information-twin-anchor"),
   485	    ).profile == (0, 0, 0)
   486	
   487	    # Separately decisive additive factors exercise the other oracle DROPs.
   488	    positive_tables = tuple(
   489	        replace(
   490	            table,
   491	            q1_states=(tuple(0.0 for _ in Q1_FEATURES), (1.0, *tuple(0.0 for _ in Q1_FEATURES[1:]))),
   492	            q2_states=(tuple(0.0 for _ in Q2_FEATURES), (1.0, *tuple(0.0 for _ in Q2_FEATURES[1:]))),
   493	        )
   494	        if table.user_id == 0 else table
   495	        for table in tables
   496	    )
   497	    one_move_catalogue = ((0, 0, 0), (1, 0, 0))
   498	    for route in ("C1", "C2"):
   499	        route_model = V1ThreeRouteModel(
   500	            LinearHead(np.asarray([1.0 if route == "C1" else 0.0] + [0.0] * (len(Q1_FEATURES) - 1)), 0.0),
   501	            LinearHead(np.asarray([1.0 if route == "C2" else 0.0] + [0.0] * (len(Q2_FEATURES) - 1)), 0.0),
   502	            model.psi.clone(),
   503	            model.checkpoint_sha256,
   504	        )
   505	        contexts = {profile: _profile_contexts("additive")[profile] for profile in one_move_catalogue}
   506	        kwargs = dict(
   507	            base_profile=(0, 0, 0), tables=positive_tables,
   508	            catalogue=one_move_catalogue, jointly_legal=lambda profile: True,
   509	            service_guard=lambda profile: True, model=route_model,
   510	            coalition_context=contexts, exact_psi=lambda profile: 0.0,
   511	            **_selector_authority(positive_tables, one_move_catalogue, anchor_id="information-twin-anchor"),
   512	        )
   513	        assert s0.select(**kwargs).profile == (1, 0, 0)
