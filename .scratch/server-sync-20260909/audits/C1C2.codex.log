   176	def seal_action_evaluation(
   177	    item: ActionEvaluation,
   178	    *,
   179	    source_provenance_sha256: str,
   180	    forecast_method_sha256: str,
   181	    tle_provenance: str = "nearest_epoch_retrospective_benchmark",
   182	    future_tle_access: str = "declared_forecast_horizon_only",
   183	) -> ActionEvaluation:
   184	    """Bind one engine-adapter row to the exact visible primitive values."""
   185	
   186	    for field, value in (
   187	        ("source_provenance_sha256", source_provenance_sha256),
   188	        ("forecast_method_sha256", forecast_method_sha256),
   189	    ):
   190	        if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
   191	            raise StageCContractError(f"{field} must be a lowercase SHA-256")
   192	    return replace(
   193	        item,
   194	        source_provenance_sha256=source_provenance_sha256,
   195	        forecast_method_sha256=forecast_method_sha256,
   196	        visible_primitives_sha256=canonical_sha256(_action_visible_payload(item)),
   197	        tle_provenance=tle_provenance,
   198	        future_tle_access=future_tle_access,
   199	    )
