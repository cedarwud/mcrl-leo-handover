    41	
    42	class CheckpointClosureError(RuntimeError):
    43	    """The launch bundle cannot prove one checkpoint authority."""
    44	
    45	
    46	def sha256_file(path: Path) -> str:
    47	    if path.is_symlink() or not path.is_file():
    48	        raise CheckpointClosureError(f"expected regular file: {path}")
    49	    digest = hashlib.sha256()
    50	    with path.open("rb") as handle:
    51	        for block in iter(lambda: handle.read(1024 * 1024), b""):
    52	            digest.update(block)
    53	    return digest.hexdigest()
    54	
    55	
    56	def _canonical_json(path: Path) -> dict[str, Any]:
    57	    if path.is_symlink() or not path.is_file():
    58	        raise CheckpointClosureError(f"missing JSON file: {path}")
    59	    raw = path.read_bytes()
