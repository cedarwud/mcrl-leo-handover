    89	def learned_c3_score(
    90	    *, profile: Profile, tables: Sequence[UserActionTable], model: ThreeRouteModel
    91	) -> float:
    92	    total = 0.0
    93	    for table, action_index in zip(tables, profile, strict=True):
    94	        total += model.score(
    95	            "C3",
    96	            (*table.q1_states[action_index], *table.q2_states[action_index]),
    97	        )
    98	    return total
