    70	@dataclass(frozen=True, slots=True)
    71	class PairwiseBatch:
    72	    """A typed fixed aggregate batch. There is intentionally no next state."""
    73	
    74	    route: Route
    75	    reference_states: np.ndarray
    76	    candidate_states: np.ndarray
    77	    target_deltas: np.ndarray
    78	    row_identities: tuple[str, ...]
    79	    source_authority_sha256: str
    80	    source_identity: str
    81	    physics_digest: str
    82	    digest: str
    83	
    84	    @classmethod
    85	    def create(
    86	        cls,
    87	        route: Route,
    88	        reference_states: Sequence[Sequence[float]],
    89	        candidate_states: Sequence[Sequence[float]],
    90	        target_deltas: Sequence[float],
    91	        row_identities: Sequence[str],
    92	        source_authority_sha256: str,
    93	        *,
    94	        source_identity: str = "informed",
    95	        physics_digest: str,
    96	    ) -> "PairwiseBatch":
    97	        reference = np.asarray(reference_states, dtype=np.float64)
    98	        candidate = np.asarray(candidate_states, dtype=np.float64)
    99	        targets = np.asarray(target_deltas, dtype=np.float64)
   100	        identities = tuple(row_identities)
   101	        if route not in ROUTES:
   102	            raise StageCContractError("unknown pairwise route")
   103	        if reference.ndim != 2 or candidate.shape != reference.shape:
   104	            raise StageCContractError("pairwise state tensors must be equal rank-2 arrays")
   105	        if targets.shape != (reference.shape[0],) or len(identities) != reference.shape[0]:
   106	            raise StageCContractError("pairwise target/identity count drifted")
   107	        if (
   108	            reference.shape[0] < 1
   109	            or not np.isfinite(reference).all()
   110	            or not np.isfinite(candidate).all()
   111	            or not np.isfinite(targets).all()
   112	        ):
   113	            raise StageCContractError("pairwise batch must be nonempty and finite")
   114	        if len(source_authority_sha256) != 64 or any(
   115	            character not in "0123456789abcdef"
   116	            for character in source_authority_sha256
   117	        ):
   118	            raise StageCContractError("source authority must be a lowercase SHA-256")
   119	        if len(physics_digest) != 64 or any(character not in "0123456789abcdef" for character in physics_digest):
   120	            raise StageCContractError("pairwise batch physics digest is invalid")
   121	        payload = {
   122	            "schema": "mcrl-v025-stagec-pairwise-batch-v1",
   123	            "route": route,
   124	            "shape": list(reference.shape),
   125	            "reference": [[float_hex(v) for v in row] for row in reference],
   126	            "candidate": [[float_hex(v) for v in row] for row in candidate],
   127	            "targets": [float_hex(v) for v in targets],
   128	            "row_identities": list(identities),
   129	            "source_authority_sha256": source_authority_sha256,
   130	            "source_identity": source_identity,
   131	            "physics_digest": physics_digest,
   132	            "zero_bootstrap": True,
   133	        }
   134	        return cls(
   135	            route,
   136	            reference,
   137	            candidate,
   138	            targets,
   139	            identities,
   140	            source_authority_sha256,
   141	            source_identity,
   142	            physics_digest,
   143	            canonical_sha256(payload),
   144	        )
   145	
   146	    def neutral(
   147	        self, definition: "NeutralSourceDefinition | None" = None
   148	    ) -> "PairwiseBatch":
   149	        if definition is not None and definition.route != self.route:
   150	            raise StageCContractError("neutral source route disagrees with batch")
   151	        return PairwiseBatch.create(
   152	            self.route,
   153	            self.reference_states,
   154	            self.candidate_states,
   155	            np.zeros_like(self.target_deltas),
   156	            self.row_identities,
   157	            self.source_authority_sha256,
   158	            source_identity=(
   159	                "neutral:legacy"
   160	                if definition is None
   161	                else f"neutral:{definition.digest}"
   162	            ),
   163	            physics_digest=self.physics_digest,
   164	        )
