   988	        self.learner_seed = int(learner_seed)
   989	        self.q1_batch = q1_batch
   990	        self.q2_batch = q2_batch
   991	        self.c3_batch = c3_batch
   992	        self.neutral_sources = dict(neutral_sources)
   993	        self.physics_digest = q1_batch.physics_digest
   994	        rng = np.random.default_rng(self.learner_seed)
   995	        template = V1ThreeRouteModel(
