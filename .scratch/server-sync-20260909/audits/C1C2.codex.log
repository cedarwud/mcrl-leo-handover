   391	def test_summary_mutation_is_rejected_even_when_receipt_hash_is_recomputed(
   392	    tmp_path: Path,
   393	) -> None:
   394	    original_root = tmp_path / "original"
   395	    run_synthetic_pipeline(original_root, epochs=1, bootstrap_draws=8)
   396	    allocation_payload = read_verified_json(original_root / "allocation-manifest.json")
   397	    units = tuple(
   398	        AllocationUnit(**payload) for payload in allocation_payload["units"]
   399	    )
   400	    manifest = AllocationManifest.create(
   401	        units,
   402	        bootstrap_draws=int(allocation_payload["bootstrap_draws"]),
   403	        bootstrap_seed=int(allocation_payload["bootstrap_seed"]),
   404	        experiment_bindings=tuple(
   405	            BoundExperiment(**payload)
   406	            for payload in allocation_payload["experiment_bindings"]
   407	        ),
   408	        training_physics_digest=str(allocation_payload["training_physics_digest"]),
   409	        baseline_implementation_sha256=str(allocation_payload["baseline_implementation_sha256"]),
   410	        successor_development_dates=allocation_payload["successor_development_dates"],
   411	    )
   412	    assert manifest.digest == allocation_payload["allocation_manifest_sha256"]
   413	
   414	    replacement_root = tmp_path / "mutated"
   415	    replacement_registry = AttemptRegistry(replacement_root / "attempts.jsonl")
   416	    replacement_receipts: list[Path] = []
   417	    for index, unit in enumerate(units):
   418	        source = original_root / "receipts" / f"{unit.unit_id}.receipt.json"
   419	        payload = read_verified_json(source)
   420	        if index == 0:
   421	            payload["summary"]["FULL"]["bits_hex"] = float(999999.0).hex()
   422	        destination = replacement_root / "receipts" / source.name
   423	        replacement_registry.append(
   424	            status="STARTED",
   425	            unit=unit,
   426	            allocation_manifest_digest=manifest.digest,
   427	        )
   428	        digest = write_once_json(destination, payload)
   429	        replacement_registry.append(
   430	            status="DONE",
   431	            unit=unit,
   432	            allocation_manifest_digest=manifest.digest,
   433	            receipt_sha256=digest,
   434	        )
   435	        replacement_receipts.append(destination)
   436	
   437	    with pytest.raises(StageCContractError, match="summary disagrees with rows"):
   438	        merge_receipts(
   439	            replacement_receipts,
   440	            manifest=manifest,
   441	            registry=replacement_registry,
   442	            bootstrap_draws=8,
