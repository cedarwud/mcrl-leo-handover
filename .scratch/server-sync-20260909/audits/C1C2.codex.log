   220	def _tables(*, relabel: int = 0) -> tuple[UserActionTable, ...]:
   340	        joint_search_sha256=_digest("search"), guards_sha256=_digest("guards"),
   341	        tie_breaking_sha256=_digest("ties"), validation_sha256=_digest("validation"),
   342	        deadline_sha256=_digest("deadline"), fallback_sha256=_digest("fallback"),
   343	        source_provenance_sha256=source, learned_pruning=False,
   344	    ) for arm in ("FULL", "DROP_C1", "DROP_C2", "DROP_C3", "ALL_NEUTRAL_CONTROL", "BASELINE", "S0", "S_UNI")}
   345	    matched = authenticate_matched_catalogues(interfaces, required_arms=tuple(interfaces))
   346	    return {
   347	        "coordinator_information": coordinator,
   348	        "arm_information_interfaces": interfaces,
   349	        "matched_information_sha256": matched,
   350	    }
