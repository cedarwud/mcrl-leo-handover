   288	def _normalize(raw: Sequence[float], specs: Sequence[FeatureSpec]) -> tuple[float, ...]:
   289	    if len(raw) != len(specs):
   290	        raise StageCContractError("state field count disagrees with schema")
   291	    result = tuple(float(value) / spec.scale for value, spec in zip(raw, specs, strict=True))
   292	    if not all(math.isfinite(value) for value in result):
   293	        raise StageCContractError("state values must be finite")
   294	    return result
   295	
   296	
   297	def kappa_normalization_bits(kappa_bits_per_user_s: float) -> float:
   298	    """Controller-sealed conversion from calibration rate to one user-step."""
   299	
   300	    value = float(kappa_bits_per_user_s)
   301	    if not math.isfinite(value) or value <= 0.0:
   302	        raise StageCContractError("kappa bits/user-second must be positive and finite")
   303	    return value * DECISION_INTERVAL_S
