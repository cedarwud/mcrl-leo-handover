  1239	    )
  1240	    calibration_payload = json.loads(
  1280	    restored = {}
  1281	    for (seed, arm), payload in payloads.items():
  1282	        orchestrator = V1LineageOrchestrator(
  1283	            learner_seed=seed,
  1284	            q1_batch=q1,
  1285	            q2_batch=q2,
