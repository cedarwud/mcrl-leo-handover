   140	    launcher = (root / LAUNCHER.relative_to(REPO)).read_text(encoding="utf-8")
   141	    adapter = (root / TARGET_ADAPTER.relative_to(REPO)).read_text(encoding="utf-8")
   142	    if "D40_CHECKPOINT_PATH" not in generator or "authenticate_d40_checkpoint" not in generator:
   143	        raise CheckpointClosureError("target generator lacks d40 checkpoint authentication")
   144	    if "D40CheckpointRuntimeAdapter" not in generator:
