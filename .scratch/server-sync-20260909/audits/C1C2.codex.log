   998	            ),
   999	            AdamMLPHead.create(
  1000	                q2_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C2"], rng
  1001	            ),
  1002	            AdamSetInteractionHead(
  1003	                AdamMLPHead.create(
  1004	                    c3_batch.invariant_states.shape[1], LEGACY_TRAINER_LITERALS["C3"], rng
  1005	                ),
  1006	                c3_batch.member_width,
  1007	            ),
  1008	        )
  1009	        self.initialization_payload = template.payload()
  1010	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
  1011	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
  1012	        # Engineering-only pilot lever: neutral batches are immutable and
  1013	        # identical for every source epoch, so materialise them once rather
  1014	        # than allocating and hashing them inside the hot epoch loop.
  1015	        self._neutral_q1 = q1_batch.neutral(self.neutral_sources["C1"])
  1016	        self._neutral_q2 = q2_batch.neutral(self.neutral_sources["C2"])
