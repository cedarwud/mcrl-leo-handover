  1166	def train(output: Path, source_shards, coalition_shards):
  1167	    global _TRAIN_Q1, _TRAIN_Q2, _TRAIN_C3, _TRAIN_NEUTRAL, _TRAIN_OUTPUT
  1168	    phase_started = time.perf_counter()
  1169	    q_batches = {
  1170	        route: _aggregate_pair_batch(batch)
  1171	        for route, batch in build_pairwise_batches(source_shards).items()
  1172	    }
  1173	    _TRAIN_Q1, _TRAIN_Q2 = q_batches["C1"], q_batches["C2"]
  1174	    _TRAIN_C3 = CoalitionBatch.create(coalition_shards)
  1175	    _TRAIN_NEUTRAL = default_synthetic_neutral_sources()
  1176	    _TRAIN_OUTPUT = str(output)
  1177	    tasks = [(seed, arm) for seed in LEARNER_SEEDS for arm in LEARNED_ARMS]
  1178	    results = []
  1179	    context = mp.get_context("fork")
  1180	    with ProcessPoolExecutor(max_workers=16, mp_context=context) as executor:
  1181	        future_to_task = {executor.submit(_train_one, task): task for task in tasks}
  1182	        for future in as_completed(future_to_task):
  1183	            result = future.result()
  1184	            results.append(result)
  1185	            print(
  1186	                json.dumps(
  1187	                    {
  1188	                        "artifact_label": LABEL,
  1189	                        "phase": "train",
  1190	                        "arm": result["arm"],
  1191	                        "learner_seed": result["learner_seed"],
  1192	                        "completed": len(results),
  1193	                        "total": len(tasks),
  1194	                    }
  1195	                ),
  1196	                flush=True,
  1197	            )
  1198	    baseline = [
  1199	        {
  1200	            "artifact_label": LABEL,
  1201	            "arm": "BASELINE",
  1202	            "learner_seed": seed,
  1203	            "completed_source_epochs": 0,
  1204	            "external_policy": "fixed carrier proposal",
  1205	            "wall_s": 0.0,
  1206	            "core_s": 0.0,
  1207	            "checkpoint_count": 0,
  1208	        }
  1209	        for seed in LEARNER_SEEDS
  1210	    ]
  1211	    serializable = [{key: value for key, value in row.items() if key != "model_payload"} for row in results]
  1212	    manifest = {
  1213	        "schema": f"{PILOT_SCHEMA}-training-manifest-v1",
  1214	        "artifact_label": LABEL,
  1215	        "concurrency": 16,
  1216	        "neutral_batches_hoisted": True,
  1217	        "pilot_aggregate_pair_limit": PILOT_AGGREGATE_PAIR_LIMIT,
  1218	        "aggregate_batch_rows": {
  1219	            "C1": int(_TRAIN_Q1.target_deltas.size),
  1220	            "C2": int(_TRAIN_Q2.target_deltas.size),
  1221	            "C3": int(_TRAIN_C3.target_psi.size),
  1222	        },
  1223	        "phase_wall_s": time.perf_counter() - phase_started,
  1224	        "phase_core_s": sum(float(row["core_s"]) for row in results),
  1225	        "learner_seed_domains": list(LEARNER_DOMAINS),
  1226	        "lineages": sorted(serializable + baseline, key=lambda row: (row["learner_seed"], row["arm"])),
  1227	    }
  1228	    _write_phase_manifest(output / f"{LABEL}-training-manifest.json", manifest)
  1229	    models = {(row["learner_seed"], row["arm"]): row["model_payload"] for row in results}
  1230	    return models, manifest, (_TRAIN_Q1, _TRAIN_Q2, _TRAIN_C3, _TRAIN_NEUTRAL)
