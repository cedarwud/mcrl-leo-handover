   319	def test_deployment_validation_exception_commits_base_atomically() -> None:
   320	    dimension_q1 = len(Q1_FEATURES)
   321	    dimension_q2 = len(Q2_FEATURES)
   322	    model = ThreeRouteModel(
   323	        {
   324	            "C1": LinearHead(np.ones(dimension_q1), 0.0),
   325	            "C2": LinearHead(np.ones(dimension_q2), 0.0),
   326	            "C3": LinearHead(np.zeros(dimension_q1 + dimension_q2), 0.0),
   327	        }
   328	    )
   329	    table = UserActionTable(
   330	        user_id=8,
   331	        actions=(PhysicalAction(1, 1), PhysicalAction(2, 2), PhysicalAction(None, None)),
   332	        action_mask=(True, True, True),
   333	        q1_states=(
   334	            tuple(np.zeros(dimension_q1)),
   335	            tuple(np.ones(dimension_q1)),
   336	            tuple(np.zeros(dimension_q1)),
   337	        ),
   338	        q2_states=(
   339	            tuple(np.zeros(dimension_q2)),
   340	            tuple(np.ones(dimension_q2)),
   341	            tuple(np.zeros(dimension_q2)),
   342	        ),
   343	    )
   344	
   345	    def resolve(profile: tuple[int, ...]) -> ResolvedProfile:
   346	        if profile == (1,):
   347	            raise RuntimeError("synthetic resolver failure")
   348	        return ResolvedProfile(profile, 1)
   349	
   350	    decision = DeploymentAdapter().select(
   351	        model=model,
   352	        tables=(table,),
   353	        base_profile=(0,),
   354	        catalogue=((1,),),
   355	        jointly_legal=lambda profile: profile in {(0,), (1,)},
   356	        resolve_profile=resolve,
   357	    )
   358	
   359	    assert decision.profile == (0,)
   360	    assert decision.used_fallback is True
   361	    assert decision.fallback_reason == "validation_failure:RuntimeError"
