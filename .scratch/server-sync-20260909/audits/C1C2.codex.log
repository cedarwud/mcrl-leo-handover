   103	        useful_availability: int | float | str | Fraction,
   104	        per_user_bits: Mapping[int, int | float | str | Fraction] | None = None,
   105	    ) -> "NetworkOutcome":
   106	        result = cls(
   107	            exact(bits),
   108	            exact(joules),
   109	            exact(phi),
   110	            exact(decoding_availability),
   111	            exact(useful_availability),
