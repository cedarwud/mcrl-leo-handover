   957	    tuple((route, source.digest) for route, source in sorted(default_synthetic_neutral_sources().items())),
   958	    True,
   959	    "informative source training improved pooled EE relative to the specified neutral source",
   960	)
   961	_T3_BINDING = bind_experiment("T3", _T3_EXPERIMENT)
