    84	class MODQNTrainer:
    85	    """Multi-Objective DQN trainer per PAP-2024-MORL-MULTIBEAM.
    86	
    87	    Usage::
    88	
    89	        env = StepEnvironment(...)
    90	        trainer = MODQNTrainer(env, config, ...)
    91	        logs = trainer.train()
    92	    """
    93	
    94	    def __init__(
    95	        self,
    96	        env: StepEnvironment,
    97	        config: TrainerConfig,
    98	        train_seed: int = 42,
    99	        env_seed: int = 1337,
   100	        mobility_seed: int = 7,
   101	        device: str = "cpu",
   102	        runtime_real_emission_collector: Any | None = None,
   103	    ) -> None:
   104	        self.env = env
   105	        self.config = config
   106	        self.device = torch.device(device)
   107	        self.train_seed = train_seed
   108	        self.env_seed = env_seed
   109	        self.mobility_seed = mobility_seed
   110	
   111	        self.num_beams = env.num_beams_total
   112	        self.num_users = env.config.num_users
   113	        self.state_dim = state_dim_for(self.num_beams)
   114	        self.action_dim = self.num_beams
   115	
   116	        # Deterministic seed path (ASSUME-MODQN-REP-018)
   117	        torch.manual_seed(train_seed)
   118	        self._train_rng = np.random.default_rng(train_seed)
   119	        self._env_rng = np.random.default_rng(env_seed)
   120	        self._mobility_rng = np.random.default_rng(mobility_seed)
   121	
   122	        # 3 parallel DQNs: Q1 (throughput), Q2 (handover), Q3 (load balance)
   123	        self.q_nets = nn.ModuleList([
   124	            DQNNetwork(
   125	                self.state_dim, self.action_dim,
   126	                config.hidden_layers, config.activation,
   127	            ).to(self.device)
   128	            for _ in range(3)
   129	        ])
   130	        self.target_nets = nn.ModuleList([
   131	            copy.deepcopy(q).to(self.device) for q in self.q_nets
   132	        ])
   133	        for t in self.target_nets:
   134	            t.eval()
   135	
   136	        # Per-objective optimizers
   137	        self.optimizers = [
   138	            optim.Adam(self.q_nets[i].parameters(), lr=config.learning_rate)
   139	            for i in range(3)
   140	        ]
   141	
   142	        # Replay buffer (ASSUME-MODQN-REP-006)
   143	        self.replay = ReplayBuffer(config.replay_capacity)
   144	
   145	        self._loss_fn = nn.MSELoss()
   146	        self._loaded_checkpoint_metadata: dict[str, Any] | None = None
   147	        self._secondary_checkpoint_enabled: bool = False
   148	        self._secondary_checkpoint_status: str = (
