   213	def _reject_duplicate_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
   214	    result: dict[str, Any] = {}
   215	    for key, value in pairs:
   216	        if key in result:
   217	            raise ValueError(f"duplicate JSON key {key!r}")
   218	        result[key] = value
   219	    return result
   220	
   221	
   222	def _reject_json_constant(value: str) -> None:
   223	    raise ValueError(f"non-standard JSON constant {value!r}")
   224	
   225	
   226	def _parse_status(status_bytes: bytes) -> dict[str, Any]:
   227	    try:
   228	        status = json.loads(
   229	            status_bytes.decode("utf-8"),
   230	            object_pairs_hook=_reject_duplicate_pairs,
   231	            parse_constant=_reject_json_constant,
   232	        )
   233	    except (UnicodeDecodeError, ValueError, json.JSONDecodeError) as exc:
   234	        raise BaselineAdapterError("status.json is not strict UTF-8 JSON") from exc
   235	    if type(status) is not dict:
   236	        raise BaselineAdapterError("status.json root must be an object")
   237	    return status
