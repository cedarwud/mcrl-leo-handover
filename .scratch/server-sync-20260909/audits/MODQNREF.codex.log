   131	def state_dim_for(
   132	    num_beams_total: int, *, include_contract_block: bool = False
   133	) -> int:
   134	    """Flat state dimension: ``4C`` — **112** at the frozen ``C = 28``.
   135	
   136	    That is (4.1) and ch5 §5.1, and ruling C-1 makes it the live value.  The
   137	    ablation adds 13 and is off by default.
   138	    """
   139	    return 4 * num_beams_total + (
   140	        CONTRACT_STATE_DIM if include_contract_block else 0
   141	    )
