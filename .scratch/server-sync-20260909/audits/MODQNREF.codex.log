   240	def _require_exact_field(
   241	    mapping: Mapping[str, Any], field: str, expected: Any, *, label: str
   242	) -> None:
   243	    if field not in mapping or not _exact_value(mapping[field], expected):
   244	        actual = mapping.get(field, "<missing>")
   245	        raise BaselineAdapterError(
   246	            f"{label}.{field} drifted: expected {expected!r}, got {actual!r}"
   247	        )
