   240	    def epsilon(self, episode: int) -> float:
   241	        """Linear epsilon decay from start to end over decay_episodes."""
   242	        cfg = self.config
   243	        if episode >= cfg.epsilon_decay_episodes:
   244	            return cfg.epsilon_end
   245	        frac = episode / cfg.epsilon_decay_episodes
   246	        return cfg.epsilon_start + (cfg.epsilon_end - cfg.epsilon_start) * frac
