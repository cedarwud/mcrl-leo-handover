   166	    def reset(
   167	        self,
   168	        env_rng: np.random.Generator,
   169	        mobility_rng: np.random.Generator,
   170	    ) -> tuple[list[UserState], list[ActionMask], StepObservation]:
   171	        """Draw an epoch, reset, and hand back the step-0 observation.
   172	
   173	        The third element is the whole :class:`StepObservation`.  The trainer
   174	        binds it to ``_diag`` and ignores it; a probe or a run logger wants
   175	        the candidate table, the masks and the SINR block, and returning the
   176	        object costs nothing versus rebuilding it.
   177	        """
   178	        self._epoch = self.sampler.draw(env_rng)
   179	        observation = self.environment.reset(
   180	            self._epoch, env_rng, mobility_rng=mobility_rng
   181	        )
   182	        self._last_outcome = None
   183	        return (
   184	            list(observation.user_states),
   185	            _masks(observation),
   186	            observation,
   187	        )
