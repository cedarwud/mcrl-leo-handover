   189	    def step(
   190	        self, actions: np.ndarray, env_rng: np.random.Generator
   191	    ) -> StepResult:
   192	        """One slot, returned in the container the trainer destructures."""
   193	        if self._epoch is None:
   194	            raise MCRLContractError("the environment has not been reset")
   195	        outcome = self.environment.step(actions, env_rng)
   196	        return self._record_outcome(outcome)
