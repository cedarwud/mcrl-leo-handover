   163	    def get_masking_diagnostics(self) -> dict[str, int]:
   164	        """Replay-exclusion counts owned by PATCH P-03 (SDD §4A.5a(4)).
   165	
   166	        ``no_op_transitions_skipped``  — steps where the user had no valid
   167	        action at all (``mask_t`` empty), executed a no-op, and contributed
   168	        no transition.
   169	        ``all_invalid_next_transitions_skipped`` — non-terminal steps whose
   170	        successor mask was empty, so the bootstrap target was undefined.
   171	        ``decision_steps_seen`` — the denominator: every (user, step) pair
   172	        the training loop reached.
   173	
   174	        Probe P1 reports all three.  See
   175	        ``mcrl.runtime.outage_gate.evaluate_outage_gate`` for what the rate
   176	        obliges: dropping is only admissible while outage is rare, because
   177	        it does not merely lose data — it makes outage **free**.
   178	        """
   179	        return {
   180	            "no_op_transitions_skipped": int(self._no_op_transitions_skipped),
   181	            "all_invalid_next_transitions_skipped": int(
   182	                self._all_invalid_next_transitions_skipped
   183	            ),
   184	            "decision_steps_seen": int(self._decision_steps_seen),
   185	        }
