    20	def encode_state(
    21	    user_state: UserState,
    22	    num_users: int,
    23	    config: TrainerConfig,
    24	    *,
    25	    include_contract_block: bool = False,
    26	) -> np.ndarray:
    27	    """Encode a UserState into a flat numpy vector.
    28	
    29	    ASSUME-MODQN-REP-013 state encoding contract, extended by SDD §4A.6:
    30	        [access_vector, encoded_snr, theta_rad, encoded_loads, contract]
    31	
    32	    PATCH P-10, revised by ruling C-1 (2026-08-22): the state is **112** on
    33	    the live path.  The 13-dimensional §4A.6 block is an **ablation switch**,
    34	    off by default, exactly as ``χ_u`` was handled — kept in the code, absent
    35	    from the paper.
    36	
    37	    The precedent is the point: ``χ_u`` (84 dims) was deleted from the paper
    38	    on the same day while being explicitly retained as a code-level ablation
    39	    switch.  The contract block is the same kind of thing — a state extension
    40	    with an implementation rationale that (4.1) does not contain — so it gets
    41	    the same treatment rather than re-entering by another door.
    42	
    43	    Where the four fields went instead of into ``s_u``:
    44	
    45	    * ``d2_ttt_counter`` and ``dwell_phase`` are **environment accounting**;
    46	      D2's trigger condition belongs to the mask ``A_u(t)``, and the re-key
    47	      boundary to the dwell controller.  Both already live there.
    48	    * ``radial_rate`` is a convenience feature, not a Markov necessity: the
    49	      rate of change of ``θ`` is recoverable from two consecutive steps.
    50	    * ``is_incumbent`` is the one that carried weight, and the controller
    51	      agreed — but the resolution is a wording fix in (4.1) rather than an
    52	      extra dimension.  See :func:`assert_incumbent_is_recoverable`.
    53	
    54	    Encoding rules (all explicitly configured, no hidden transforms):
    55	        - access_vector: raw one-hot (already 0/1)
    56	        - channel_quality: log1p(snr_linear) — bounded, monotonic
    57	        - beam_offsets: one off-axis angle in radians per candidate beam;
    58	          the legacy field name is retained at the UserState boundary
    59	        - beam_loads: global, ungated per-beam demand / num_users
    60	
    61	    A two-column ``beam_offsets`` array is accepted only as a legacy
    62	    compatibility path for pre-M-04 fixtures and returns the historical
    63	    5*N representation.  Current environment producers emit one-dimensional
    64	    theta arrays and therefore use the 4*N representation below.
    65	    """
    66	    access = user_state.access_vector.astype(np.float32)
    67	
    68	    snr = user_state.channel_quality.astype(np.float64)
    69	    if config.snr_encoding == "log1p":
    70	        snr = np.log1p(np.maximum(snr, 0.0)).astype(np.float32)
    71	    else:
    72	        snr = snr.astype(np.float32)
    73	
    74	    offsets = np.asarray(user_state.beam_offsets, dtype=np.float32)
    75	    legacy_offsets = False
    76	    if offsets.ndim == 1:
    77	        if config.theta_encoding != "raw_radians":
    78	            raise ValueError(
    79	                "current theta observations require theta_encoding='raw_radians'"
    80	            )
    81	        theta = offsets
    82	    elif offsets.ndim == 2 and offsets.shape[1] == 2:
    83	        # Historical pre-M-04 fixture compatibility.  No current producer
    84	        # may reach this branch; keeping it preserves old artifact replay.
    85	        if config.offset_scale_km > 0:
    86	            offsets = offsets / config.offset_scale_km
    87	        legacy_offsets = True
    88	        theta = offsets.reshape(-1)
    89	    else:
    90	        raise ValueError(
    91	            "UserState.beam_offsets must have shape (N,) for theta radians "
    92	            "or legacy shape (N, 2); got "
    93	            f"{offsets.shape!r}"
    94	        )
    95	
    96	    loads = user_state.beam_loads.astype(np.float32)
    97	    if config.load_normalization == "divide_by_num_users" and num_users > 0:
    98	        loads = loads / num_users
    99	
   100	    # Ruling C-1: the contract block is an ablation switch, not part of s_u.
   101	    # Absent is the normal case and must NOT raise.
   102	    contract = np.zeros(0, dtype=np.float32)
   103	    if include_contract_block:
   104	        if user_state.contract_fields is None:
   105	            raise MCRLContractError(
   106	                "the contract-block ablation is enabled but the state carries "
   107	                "no contract_fields; build them with "
   108	                "mcrl.env.action_contract.contract_state_fields()"
   109	            )
   110	        contract = np.asarray(user_state.contract_fields, dtype=np.float32)
   111	        if contract.shape != (CONTRACT_STATE_DIM,):
   112	            raise MCRLContractError(
   113	                f"contract_fields must have shape ({CONTRACT_STATE_DIM},), "
   114	                f"got {contract.shape}"
   115	            )
   116	
   117	    if not (access.size == snr.size == loads.size):
   118	        raise ValueError(
   119	            "UserState beam-indexed arrays must have equal lengths: "
   120	            f"access={access.size}, snr={snr.size}, theta={theta.size}, "
   121	            f"loads={loads.size}"
   122	        )
   123	    if not legacy_offsets and theta.size != access.size:
   124	        raise ValueError(
   125	            "Current theta observations must have one value per beam: "
   126	            f"access={access.size}, theta={theta.size}"
   127	        )
   128	    return np.concatenate([access, snr, theta, loads, contract])
