   161	def test_random_native_encodings_are_bit_identical_with_contract_fields(adapter):
   162	    rng = np.random.default_rng(2927175120652069826)
   163	    for _ in range(64):
   164	        num_users = int(rng.integers(1, 257))
   165	        access = np.zeros(EXPECTED_ACTION_DIM, dtype=np.float32)
   166	        if bool(rng.integers(0, 2)):
   167	            access[int(rng.integers(0, EXPECTED_ACTION_DIM))] = 1.0
   168	        state = UserState(
   169	            access_vector=access,
   170	            channel_quality=rng.uniform(
   171	                0.0, 1.0e4, EXPECTED_ACTION_DIM
   172	            ).astype(np.float32),
   173	            beam_offsets=rng.uniform(
   174	                -np.pi, np.pi, EXPECTED_ACTION_DIM
   175	            ).astype(np.float32),
   176	            beam_loads=rng.integers(
   177	                0, num_users + 1, EXPECTED_ACTION_DIM
   178	            ).astype(np.float32),
   179	            contract_fields=None,
   180	        )
   181	        populated = _with_contract_fields(
   182	            state, rng.normal(size=CONTRACT_STATE_DIM).astype(np.float32)
   183	        )
   184	
   185	        absent_encoding = adapter.encode_user_state(state, num_users=num_users)
   186	        populated_encoding = adapter.encode_user_state(
   187	            populated, num_users=num_users
   188	        )
   189	
   190	        assert absent_encoding.shape == (EXPECTED_STATE_DIM,)
   191	        assert absent_encoding.tobytes(order="C") == populated_encoding.tobytes(
   192	            order="C"
   193	        )
