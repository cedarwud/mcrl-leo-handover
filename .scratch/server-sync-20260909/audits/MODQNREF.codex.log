   159	    @property
   160	    def epoch(self) -> dt.datetime:
   161	        """The epoch the current episode was drawn at.  For the run log."""
   162	        if self._epoch is None:
   163	            raise MCRLContractError("no episode has been started")
   164	        return self._epoch
