   250	def _validate_status(
   251	    status: Mapping[str, Any], *, checkpoint_path: Path
   252	) -> None:
   253	    """Admit only the completed 9000-episode Main status receipt."""
   254	
   255	    for field, expected in (
   256	        ("status", "complete"),
   257	        ("episodes_completed", EXPECTED_EPISODES),
   258	        ("checkpoint_sha256", EXPECTED_CHECKPOINT_SHA256),
   259	        ("role", "main-training"),
   260	        ("resumed", False),
   261	        ("resume_next_episode", EXPECTED_EPISODES),
   262	    ):
   263	        _require_exact_field(status, field, expected, label="status")
   264	
   265	    checkpoint_ref = status.get("checkpoint")
   266	    if type(checkpoint_ref) is not str:
   267	        raise BaselineAdapterError("status.checkpoint must be a string")
   268	    if Path(checkpoint_ref).name != checkpoint_path.name:
   269	        raise BaselineAdapterError(
   270	            "status.checkpoint does not identify the requested final checkpoint"
   271	        )
   272	
   273	    collapse_summary = status.get("collapse_summary")
   274	    if not isinstance(collapse_summary, Mapping):
   275	        raise BaselineAdapterError("status.collapse_summary must be an object")
   276	    _require_exact_field(
   277	        collapse_summary,
   278	        "episodes",
   279	        EXPECTED_EPISODES,
   280	        label="status.collapse_summary",
   281	    )
   282	
   283	    fingerprint = status.get("run_fingerprint")
   284	    if not isinstance(fingerprint, Mapping):
   285	        raise BaselineAdapterError("status.run_fingerprint must be an object")
   286	    _require_exact_field(
   287	        fingerprint,
   288	        "trainer_config_sha256",
