   184	
   185	def _read_regular_file(path: str | Path, *, label: str) -> bytes:
   186	    """Read one regular, non-symlink file through a no-follow descriptor."""
   187	
   188	    candidate = Path(path)
   189	    absolute = Path(os.path.abspath(candidate))
   190	    resolved = Path(os.path.realpath(candidate))
   191	    if resolved != absolute:
   192	        raise BaselineAdapterError(f"{label} path contains a symlink: {candidate}")
   193	
   194	    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
   195	    descriptor = -1
   196	    try:
   197	        descriptor = os.open(os.fspath(candidate), flags)
   198	        file_stat = os.fstat(descriptor)
   199	        if not stat.S_ISREG(file_stat.st_mode):
   200	            raise BaselineAdapterError(f"{label} must be a regular file: {candidate}")
   201	        with os.fdopen(descriptor, "rb") as stream:
   202	            descriptor = -1
   203	            return stream.read()
   204	    except BaselineAdapterError:
   205	        raise
   206	    except OSError as exc:
   207	        raise BaselineAdapterError(f"could not read {label}: {candidate}") from exc
   208	    finally:
   209	        if descriptor != -1:
   210	            os.close(descriptor)
   211	
