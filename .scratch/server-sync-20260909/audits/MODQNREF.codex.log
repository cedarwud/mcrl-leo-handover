    36	# ---------------------------------------------------------------------------
    37	# Index layout (§4A.1)
    38	# ---------------------------------------------------------------------------
    39	
    40	NUM_SATELLITE_SLOTS: int = 4
    41	"""``L_w`` — SDD B12, matching MODQN §IV's four satellites."""
    42	
    43	NUM_BEAM_SLOTS: int = 7
    44	"""``J_w`` — the anchor cell plus its six canonical neighbours (§4A.2).
    45	
    46	⚠ **This 7 is not MODQN Table I's ``V = 7``.  The match is a coincidence.**
    47	
    48	Table I's ``V = 7`` is ``|𝒱|`` at *their* granularity: how many beam
    49	positions one satellite has in total.  In Sun-2024 a "beam" has no geometry
    50	at all — a full-text grep finds zero hits for off-axis, boresight, pointing,
    51	3 dB, half-power, footprint, steer, or earth-fixed — so a beam there is a
    52	non-spatial load channel and the number could have been 7, 3 or 70 without
    53	changing anything.
    54	
    55	This paper adds the geometry they lacked, and once a beam has a pointing and
    56	a 3 dB footprint it has to cover ground: at the measured 485 km, 95%
    57	coverage needs 39 cells.  So Table I's ``V = 7`` is **superseded by this
    58	paper's ``V`` (39, F5 pending)** — that is where it went; it was not left
    59	homeless.
    60	
    61	``J_w = 7`` is a different quantity entirely: how many cells one *user*
    62	can reach (their own plus the six neighbours), from the hex-neighbourhood
    63	argument in §3.3.  **The two must never be substituted for each other**, and
    64	there is deliberately no per-satellite beam-count constant anywhere in this
    65	project (ruling 2026-08-22 §7.2-7.3).
    66	"""
    67	
    68	NUM_ACTIONS: int = NUM_SATELLITE_SLOTS * NUM_BEAM_SLOTS
    69	"""``C = 28`` — the flat output width.  Frozen; the network is not touched."""
    70	
    71	NO_OP_ACTION: int = -1
    72	"""Emitted when a user's decision mask is empty (SDD §4A.5a(1)).
    73	
    74	Not a beam index and not maskable: it is the absence of a decision.
    75	
    76	Obligations on the environment:
    77	
    78	1. ``env.step`` leaves that user **unserved** — no beam activation, no power,
    79	   no contribution to ``beam_load_b`` or ``U_{b_u}`` (P-6, the single load
    80	   semantics the counting-form ``r3`` rests on);
    81	2. the handover ledger records ``Ψ = 0`` for the unserved step and ``φ2`` on
    82	   the next served step (§4A.4 boundary table; T5/T8);
    83	3. the transition never reaches replay (§4A.5a(2); enforced trainer-side,
    84	   ``docs/PATCH-LEDGER.md`` P-03).
    85	
    86	The sentinel is negative on purpose — a hard trip-wire.  Any code that
    87	treats actions as indices (``np.bincount``, ``gather``, direct indexing)
    88	fails loudly instead of silently aliasing onto the last beam.
    89	"""
    90	
    91	UNSERVED_CELL: int = -1
    92	"""Cell component of a slot entry that cannot be pointed at."""
    93	
    94	
    95	def is_no_op(action: SupportsInt) -> bool:
    96	    return int(action) == NO_OP_ACTION
    97	
    98	
    99	def no_op_actions(num_users: int) -> np.ndarray:
   100	    return np.full(int(num_users), NO_OP_ACTION, dtype=np.int32)
   101	
   102	
   103	def served_mask(actions: np.ndarray) -> np.ndarray:
   104	    return np.asarray(actions) != NO_OP_ACTION
   105	
   106	
   107	def action_index(satellite_slot: int, beam_slot: int) -> int:
   108	    """``a = 7·l + j`` with range checks."""
   109	    if not 0 <= satellite_slot < NUM_SATELLITE_SLOTS:
   110	        raise ValueError(f"satellite slot {satellite_slot} out of range")
   111	    if not 0 <= beam_slot < NUM_BEAM_SLOTS:
   112	        raise ValueError(f"beam slot {beam_slot} out of range")
   113	    return NUM_BEAM_SLOTS * satellite_slot + beam_slot
   114	
   115	
   116	def decode_action(action: SupportsInt) -> tuple[int, int]:
   117	    """Inverse of :func:`action_index`.  Rejects the no-op sentinel."""
   118	    value = int(action)
   119	    if value == NO_OP_ACTION:
   120	        raise MCRLContractError("NO_OP_ACTION has no (l, j) decomposition")
   121	    if not 0 <= value < NUM_ACTIONS:
   122	        raise ValueError(f"action {value} out of range [0,{NUM_ACTIONS})")
   123	    return divmod(value, NUM_BEAM_SLOTS)
