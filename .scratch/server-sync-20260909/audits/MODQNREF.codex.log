   165	def _exact_value(actual: Any, expected: Any) -> bool:
   166	    """Compare nested checkpoint values without coercing types."""
   167	
   168	    if isinstance(expected, Mapping):
   169	        if not isinstance(actual, Mapping):
   170	            return False
   171	        if set(actual) != set(expected):
   172	            return False
   173	        return all(_exact_value(actual[key], expected[key]) for key in expected)
   174	    if isinstance(expected, tuple):
   175	        return (
   176	            type(actual) is tuple
   177	            and len(actual) == len(expected)
   178	            and all(_exact_value(a, e) for a, e in zip(actual, expected))
   179	        )
   180	    if type(actual) is not type(expected):
   181	        return False
   182	    return actual == expected
