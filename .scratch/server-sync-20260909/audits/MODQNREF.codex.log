  1486	        proposals = [
  1487	            row for row in unilateral
  1488	            if row.mapping[user] != base.mapping[user]
  1489	        ]
  1490	        ranked = sorted(
  1491	            proposals,
  1492	            key=lambda row: (
  1493	                -(
  1494	                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
  1495	                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
  1496	                ),
  1497	                row.configuration_id,
  1498	            ),
  1499	        )[: ENGINE.TOP_PROPOSALS]
  1500	        top_ids.extend(row.configuration_id for row in ranked)
  1501	    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
  1502	    allowed.extend(
  1503	        row for row in catalogue
  1504	        if row.changed_users > 1
  1505	        and all(
  1506	            any(
  1507	                proposal.mapping[user] == identity
  1508	                for proposal in unilateral
  1509	                if proposal.configuration_id in top_ids
  1510	            )
  1511	            for user, identity in row.assignments
  1512	            if identity != base.mapping[user]
  1513	        )
  1514	    )
  1515	    evaluator.evaluate_many(tuple(allowed))
  1516	    allowed = [
  1517	        row for row in allowed if row.configuration_id not in evaluator._invalid
  1518	    ]
  1519	    return min(
  1520	        allowed,
  1521	        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
  1522	    )
