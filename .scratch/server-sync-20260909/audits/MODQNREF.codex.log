   248	    # -- action selection ---------------------------------------------------
   249	
   250	    def _predict_objective_q_values(
   251	        self,
   252	        states_encoded: np.ndarray,
   253	    ) -> list[np.ndarray]:
   254	        """Run the three objective networks on a batch of encoded states."""
   255	        with torch.no_grad():
   256	            st = torch.tensor(
   257	                states_encoded, dtype=torch.float32, device=self.device
   258	            )
   259	            return [self.q_nets[i](st).cpu().numpy() for i in range(3)]
   260	
   261	    def _scalarize_q_values(
   262	        self,
   263	        q_values: list[np.ndarray],
   264	        objective_weights: tuple[float, float, float],
   265	    ) -> np.ndarray:
   266	        """Scalarize the three objective-Q tables with one weight row."""
   267	        return (
   268	            objective_weights[0] * q_values[0]
   269	            + objective_weights[1] * q_values[1]
   270	            + objective_weights[2] * q_values[2]
   271	        )
   272	
   273	    def scalarized_q_values(
   274	        self,
   275	        states_encoded: np.ndarray,
   276	        *,
   277	        objective_weights: tuple[float, float, float] | None = None,
   278	    ) -> np.ndarray:
   279	        """Return the scalarized Q surface for diagnostics/evaluation.
   280	
   281	        P6 needs the full valid-action ranking for its random-near-tie and
   282	        perturbation controls.  Exposing this one read-only composition keeps
   283	        those diagnostics on the exact same objective networks and weights as
   284	        the policy instead of duplicating scalarization in a server script.
   285	        """
   286	        weights = objective_weights or self.config.objective_weights
   287	        return self._scalarize_q_values(
   288	            self._predict_objective_q_values(states_encoded), weights
   289	        )
   290	
   291	    def _select_masked_greedy_action(
   292	        self,
   293	        scalarized_row: np.ndarray,
   294	        mask: np.ndarray,
   295	    ) -> int | None:
   296	        """Return the greedy masked action or ``None`` when no action is valid."""
   297	        valid = np.flatnonzero(mask)
   298	        if valid.size == 0:
   299	            return None
   300	        q_row = scalarized_row.copy()
   301	        q_row[~mask] = -np.inf
   302	        return int(np.argmax(q_row))
   303	
   304	    def _rank_masked_actions(
   305	        self,
   306	        scalarized_row: np.ndarray,
   307	        mask: np.ndarray,
   308	    ) -> list[int]:
   309	        """Return valid actions sorted by scalarized-Q then beam index."""
   310	        valid = np.flatnonzero(mask)
   311	        return sorted(
   312	            (int(action) for action in valid.tolist()),
   313	            key=lambda action: (-float(scalarized_row[action]), int(action)),
   314	        )
   315	
   316	    def _select_unconstrained_actions(
   317	        self,
   318	        scalarized: np.ndarray,
   319	        masks: list[ActionMask],
   320	        eps: float,
   321	    ) -> np.ndarray:
   322	        """Return the normal MODQN epsilon-greedy actions.
   323	
   324	        PATCH P-01 (L-1, SDD §4A.5a(1)): an empty decision mask yields
   325	        ``NO_OP_ACTION``, never index 0.  Exploration stays masked (P-9).
   326	        """
   327	        U = len(masks)
   328	        actions = no_op_actions(U)
   329	        for uid in range(U):
   330	            valid = np.where(masks[uid].mask)[0]
   331	            if len(valid) == 0:
   332	                # PATCH P-01: no valid action -> no-op, user unserved this
   333	                # step.  Never fall back to any index.
   334	                actions[uid] = NO_OP_ACTION
   335	                continue
   336	
   337	            if self._train_rng.random() < eps:
   338	                actions[uid] = self._train_rng.choice(valid)
   339	            else:
   340	                selected_action = self._select_masked_greedy_action(
   341	                    scalarized[uid],
   342	                    masks[uid].mask,
   343	                )
   344	                if selected_action is None:
   345	                    # Structurally unreachable: ``valid`` is non-empty here.
   346	                    # Fail loudly rather than restore the index-0 fallback.
   347	                    raise MCRLContractError(
   348	                        "masked greedy selection returned None for user "
   349	                        f"{uid} despite {valid.size} valid actions"
   350	                    )
   351	                actions[uid] = selected_action
   352	
   353	        return actions
   354	
   355	    def select_actions(
   356	        self,
   357	        states_encoded: np.ndarray,
   358	        masks: list[ActionMask],
   359	        eps: float,
   360	        *,
   361	        objective_weights: tuple[float, float, float] | None = None,
   362	        raw_states: list[UserState] | None = None,
   363	    ) -> np.ndarray:
   364	        """Epsilon-greedy masked action selection with scalarized Q.
   365	
   366	        At each decision step:
   367	        1. Compute Q1, Q2, Q3 for each user
   368	        2. Scalarize: Q_scalar = w1*Q1 + w2*Q2 + w3*Q3
   369	        3. Mask invalid actions to -inf
   370	        4. epsilon-greedy over the masked scalarized Q
   371	
   372	        Returns actions array shape (num_users,).
   373	
   374	        PATCH P-05 (W-09): there is exactly one selection path.  The
   375	        capacity-aware and QoS-sticky branches, and the config switch that
   376	        dispatched to them, are gone — SDD §2.2 deletes that family of
   377	        ceilings, and the 2026-08-22 ruling forbids leaving a socket for a
   378	        deleted mechanism.
   379	        ``raw_states`` is retained only because callers pass it positionally;
   380	        nothing reads it.
   381	        """
   382	        del raw_states
   383	        w = objective_weights or self.config.objective_weights
   384	        scalarized = self.scalarized_q_values(
   385	            states_encoded, objective_weights=w
   386	        )
   387	        return self._select_unconstrained_actions(scalarized, masks, eps)
