   103	    def training_state_dict(self) -> dict[str, object]:
   104	        """Delegate the persistent resume seam to ``StepEnvironment``.
   105	
   106	        The sampler epoch and the last outcome are episode-local and are
   107	        intentionally omitted: the next call to ``reset`` draws a fresh
   108	        epoch from the trainer's restored environment RNG.  The wrapped
   109	        environment owns the only cross-episode stream, ``_age_rng``.
   110	        """
   111	
   112	        method = getattr(self.environment, "training_state_dict", None)
   113	        if not callable(method):
   114	            raise TypeError(
   115	                "wrapped StepEnvironment does not expose training_state_dict"
   116	            )
   117	        state = method()
   118	        if not isinstance(state, Mapping):
   119	            raise TypeError("wrapped environment training state must be a mapping")
   120	        return dict(state)
   121	
   122	    def load_training_state_dict(self, state: Mapping[str, object]) -> None:
   123	        """Restore the wrapped environment's persistent resume state."""
   124	
   125	        if not isinstance(state, Mapping):
   126	            raise TypeError("TrainerEnvironment training state must be a mapping")
   127	        method = getattr(self.environment, "load_training_state_dict", None)
   128	        if not callable(method):
   129	            raise TypeError(
   130	                "wrapped StepEnvironment does not expose load_training_state_dict"
   131	            )
   132	        method(state)
