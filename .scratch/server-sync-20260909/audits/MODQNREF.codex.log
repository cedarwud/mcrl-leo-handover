   119	def test_native_112d_encoding_and_weighted_masked_selection(adapter):
   120	    state = _synthetic_state()
   121	    encoded = adapter.encode_states([state, state])
   122	    expected = np.concatenate(
   123	        [
   124	            state.access_vector,
   125	            np.log1p(state.channel_quality).astype(np.float32),
   126	            state.beam_offsets,
   127	            state.beam_loads / 2.0,
   128	        ]
   129	    ).astype(np.float32)
   130	    assert encoded.shape == (2, EXPECTED_STATE_DIM)
   131	    np.testing.assert_array_equal(encoded[0], expected)
   132	
   133	    first_mask = _mask(0, 7, 19)
   134	    second_mask = ActionMask(
   135	        mask=np.zeros(EXPECTED_ACTION_DIM, dtype=bool)
   136	    )
   137	    actions = adapter.select_actions([state, state], [first_mask, second_mask])
   138	
