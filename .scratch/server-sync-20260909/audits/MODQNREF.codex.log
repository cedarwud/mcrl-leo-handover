   140	        state_tensor = torch.tensor(encoded, dtype=torch.float32)
   141	        q_values = np.stack(
   142	            [
   143	                network(state_tensor).detach().cpu().numpy()
   144	                for network in adapter._q_networks
   145	            ],
   146	            axis=0,
   147	        )
   148	    scalarized = sum(
   149	        weight * q_values[index]
   150	        for index, weight in enumerate(EXPECTED_OBJECTIVE_WEIGHTS)
   151	    )
   152	    valid = first_mask.mask
   153	    masked = scalarized[0].copy()
   154	    masked[~valid] = -np.inf
   155	    assert int(actions[0]) == int(np.argmax(masked))
   156	    assert bool(first_mask.mask[actions[0]])
   157	    assert int(actions[1]) == NO_OP_ACTION
   158	    assert adapter.select_action(state, first_mask, num_users=2) == int(actions[0])
