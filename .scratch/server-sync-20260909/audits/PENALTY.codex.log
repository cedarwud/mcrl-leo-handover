/home/sat/.codex/sessions/2026/09/10/rollout-2026-09-10T18-04-05-01a08c7d-bb2c-74b0-bfda-4a795583216f.jsonl:47:{"timestamp":"2026-09-10T18:04:52.724Z","ordinal":46,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a08c7e-7474-7301-bcd6-cb8aeaf1f755","call_id":"call_LiM7Zxbk1Hwrqi002CqEjiX2","output":[{"type":"input_text","text":"Script completed\nWall time 3.6 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 15762)\nTotal output lines: 545\n\n     1\t\"\"\"Local copy of the declared capacity-penalty math for the new sibling seam.\n     2\t\n     3\tThe formula is the same top-k physical-beam intent-tail regularizer used by\n     4\tthe current treatment design.  It is kept local so this trainer does not\n     5\timport the Route-B/shared-Q bundle or its decoder machinery.  It receives the\n     6\tcurrent population's *candidate* mask and slot-to-cell map, computes a\n     7\tdifferentiable penalty over the three main Q heads, and never changes the\n     8\tenvironment's actual power/EE calculation.\n     9\t\"\"\"\n    10\t\n    11\tfrom __future__ import annotations\n    12\t\n    13\tfrom typing import Any\n    14\t\n    15\timport numpy as np\n    16\timport torch\n    17\t\n    18\t\n    19\tdef capacity_penalty_loss(\n    20\t    q_nets: list[torch.nn.Module] | torch.nn.ModuleList,\n    21\t    encoded: np.ndarray,\n    22\t    action_mask: np.ndarray,\n    23\t    slot_cell: np.ndarray,\n    24\t    *,\n    25\t    weights: np.ndarray,\n    26\t    l_w: int,\n    27\t    grid_count: int,\n    28\t    k_cap: int,\n    29\t    lam: float,\n    30\t    tau: float,\n    31\t    device: torch.device | str = \"cpu\",\n    32\t) -> tuple[torch.Tensor, float] | None:\n    33\t    \"\"\"Return ``(loss, raw_tail_sum)`` or ``None`` when the tail is zero.\n    34\t\n    35\t    ``encoded`` is the exact population input used for the main behavior\n    36\t    decision (raw, z, or concat); no replay bundle or action decoder is needed.\n    37\t    \"\"\"\n    38\t\n    39\t    if float(lam) < 0.0 or float(tau) <= 0.0:\n    40\t        raise ValueError(\"capacity penalty requires lam >= 0 and tau > 0\")\n    41\t    x_np = np.asarray(encoded, dtype=np.float32)\n    42\t    mask_np = np.asarray(action_mask, dtype=bool)\n    43\t    cell_np = np.asarray(slot_cell, dtype=np.int64)\n    44\t    if x_np.ndim != 2 or mask_np.ndim != 2 or cell_np.ndim != 2:\n    45\t        raise ValueError(\"capacity penalty inputs must be two-dimensional\")\n    46\t    if x_np.shape[0] != mask_np.shape[0] or mask_np.shape != cell_np.shape:\n    47\t        raise ValueError(\"capacity penalty population axes do not match\")\n    48\t    if x_np.shape[1] < 1 or mask_np.shape[1] < 1:\n    49\t        raise ValueError(\"capacity penalty requires non-empty population/action axes\")\n    50\t    if int(l_w) < 1 or int(grid_count) < 1 or int(k_cap) < 1:\n    51\t        raise ValueError(\"capacity penalty topology values must be positive\")\n    52\t    if np.any(cell_np < 0) or np.any(cell_np >= int(grid_count)):\n    53\t        raise ValueError(\"slot_cell contains a cell outside grid_count\")\n    54\t    w = np.asarray(weights, dtype=np.float64).reshape(-1)\n    55\t    if w.shape != (3,):\n    56\t        raise ValueError(\"weights must have shape (3,)\")\n    57\t    if len(q_nets) != 3:\n    58\t        raise ValueError(\"capacity penalty requires exactly three Q heads\")\n    59\t\n    60\t    x = torch.from_numpy(np.ascontiguousarray(x_np)).to(device)\n    61\t    values = sum(float(w[idx]) * q_nets[idx](x) for idx in range(3))\n    62\t    mask_t = torch.from_numpy(mask_np).to(values.device)\n    63\t    # Per-user normalization over valid candidate actions only.\n    64\t    valid_values = values.masked_fill(~mask_t, 0.0)\n    65\t    n_valid = mask_t.sum(dim=1, keepdim=True).clamp(min=1)\n    66\t    mean = valid_values.sum(dim=1, keepdim=True) / n_valid\n    67\t    variance = (((values - mean) * mask_t).pow(2).sum(dim=1, keepdim=True)) / n_valid\n    68\t    normalized = (values - mean) / (variance.sqrt() + 1.0e-6)\n    69\t    logits = normalized.masked_fill(~mask_t, float(\"-inf\")) / float(tau)\n    70\t    intent = torch.softmax(logits, dim=1)\n    71\t\n    72\t    users, actions = intent.shape\n    73\t    if actions % 7 != 0:\n    74\t        raise ValueError(\"Family-B candidate action axis must be grouped into 7 beams per satellite\")\n    75\t    beams_per_satellite = 7\n    76\t    beam_rank = (\n    77\t        torch.arange(actions, device=intent.device, dtype=torch.long)\n    78\t        // beams_per_satellite\n    79\t    ).unsqueeze(0).expand(users, actions)\n    80\t    cells = torch.from_numpy(cell_np).to(intent.device)\n    81\t    physical_key = (beam_rank * int(grid_count) + cells).reshape(-1)\n    82\t    pressure = torch.zeros(\n    83\t        int(l_w) * int(grid_count), dtype=intent.dtype, device=intent.device\n    84\t    )\n    85\t    pressure = pressure.index_add(0, physical_key, intent.reshape(-1))\n    86\t    pressure_lc = pressure.view(int(l_w), int(grid_count))\n    87\t    topk_sum = torch.topk(\n    88\t        pressure_lc,\n    89\t        k=min(int(k_cap), int(grid_count)),\n    90\t        dim=1,\n    91\t    ).values.sum(dim=1)\n    92\t    tail = pressure_lc.sum(dim=1) - topk_sum\n    93\t    tail_sum = float(tail.detach().sum().item())\n    94\t    loss = float(lam) * ((tail.clamp(min=0.0) / max(int(users), 1)) ** 2).sum()\n    95\t    if float(loss.detach().item()) == 0.0:\n    96\t        return None\n    97\t    return loss, tail_sum\n    98\t\n    99\t\n   100\tdef ignition_selftest(\n   101\t    *,\n   102\t    l_w: int = 4,\n   103\t    grid_count: int = 30,\n   104\t    k_cap: int = 3,\n   105\t    users: int = 20,\n   106\t    actions: int = 28,\n   107\t) -> dict[str, Any]:\n   108\t    \"\"\"Deterministic local check that the penalty can actually fire.\"\"\"\n   109\t\n   110\t    torch.manual_seed(0)\n   111\t    rng = np.random.default_rng(0)\n   112\t    encoded = rng.normal(size=(users, 16)).astype(np.float32)\n   113\t    mask = np.ones((users, actions), dtype=bool)\n   114\t    q_nets = [torch.nn.Linear(16, actions) for _ in range(3)]\n   115\t    weights = np.asarray((0.5, 0.3, 0.2), dtype=np.float64)\n   116\t    spread = np.tile(np.arange(actions) % 7, (users, 1)).astype(np.int64)\n   117\t    concentrated = np.tile((np.arange(actions) % 7) % k_cap, (users, 1)).astype(np.int64)\n   118\t    bad = capacity_penalty_loss(\n   119\t        q_nets,\n   120\t        encoded,\n   121\t        mask,\n   122\t        spread,\n   123\t        weights=weights,\n   124\t        l_w=l_w,\n   125\t        grid_count=grid_count,\n   126\t        k_cap=k_cap,\n   127\t        lam=1.0,\n   128\t        tau=1.0,\n   129\t    )\n   130\t    if bad is None:\n   131\t        raise AssertionError(\"capacity penalty ignition failed: spread produced zero\")\n   132\t    bad_loss, _ = bad\n   133\t    bad_loss.backward()\n   134\t    grad_norm = sum(\n   135\t        float(param.grad.detach().norm().item())\n   136\t        for net in q_nets\n   137\t        for param in net.parameters()\n   138\t        if param.grad is not None\n   139\t    )\n   140\t    good = capacity_penalty_loss(\n   141\t        q_nets,\n   142\t        encoded,\n   143\t        mask,\n   144\t        concentrated,\n   145\t        weights=weights,\n   146\t        l_w=l_w,\n   147\t        grid_count=grid_count,\n   148\t        k_cap=k_cap,\n   149\t        lam=1.0,\n   150\t        tau=1.0,\n   151\t    )\n   152\t    good_value = 0.0 if good is None else float(good[0].detach().item())\n   153\t    if not np.isfinite(grad_norm) or grad_norm <= 0.0:\n   154\t        raise AssertionError(\"capacity penalty ignition produced no finite gradient\")\n   155\t    if good_value != 0.0:\n   156\t        raise AssertionError(f\"capacity penalty concentrated control should be zero, got {good_value}\")\n   157\t    return {\n   158\t        \"spread_loss\": float(bad_loss.detach().item()),\n   159\t        \"concentrated_loss\": good_value,\n   160\t        \"grad_norm\": float(grad_norm),\n   161\t        \"PASS\": True,\n   162\t    }\n   163\t\n   164\t\n   165\t__all__ = [\"capacity_penalty_loss\", \"ignition_selftest\"]\n      1 learner-5166716249291843642-epoch-000300.json.sha256\n      1 learner-5166716249291843642-epoch-000400.json\n      1 learner-5166716249291843642-epoch-000400.json.sha256\n      1 learner-5166716249291843642-epoch-000500.json\n      1 learner-5166716249291843642-epoch-000500.json.sha256\n      1 learner-5683607794651051129-epoch-000100.json\n      1 learner-5683607794651051129-epoch-000100.json.sha256\n      1 learner-5683607794651051129-epoch-000200.json\n      1 learner-5683607794651051129-epoch-000200.json.sha256\n      1 learner-5683607794651051129-epoch-000300.json\n      1 learner-5683607794651051129-epoch-000300.json.sha256\n      1 learner-5683607794651051129-epoch-000400.json\n      1 learner-5683607794651051129-epoch-000400.json.sha256\n      1 learner-5683607794651051129-epoch-000500.json\n      1 learner-5683607794651051129-epoch-000500.json.sha256\n      1 learner-6114226365011333154-epoch-000100.json\n      1 learner-6114226365011333154-epoch-000100.json.sha256\n      1 learner-6114226365011333154-epoch-000200.json\n      1 learner-6114226365011333154-epoch-000200.json.sha256\n      1 learner-6114226365011333154-epoch-000300.json\n      1 learner-6114226365011333154-epoch-000300.json.sha256\n      1 learner-6114226365011333154-epoch-000400.json\n      1 learner-6114226365011333154-epoch-000400.json.sha256\n      1 learner-6114226365011333154-epoch-000500.json\n      1 learner-6114226365011333154-epoch-000500.json.sha256\n      2 learner-6407676579069309528-epoch-000100.json\n      2 learner-6407676579069309528-epoch-000100.json.sha256\n      1 learner-6407676579069309528-epoch-000200.json\n      1 learner-640