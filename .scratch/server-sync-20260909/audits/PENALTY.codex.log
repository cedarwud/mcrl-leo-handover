def _validate_pilot_prereg(
    pilot: Mapping[str, Any],
    *,
    path: Path,
    sha256: str,
) -> None:
    """Validate the frozen LR-pilot contract before resolving a YAML arm.

    The pilot JSON is a controller-owned protocol, not an optional metadata
    note.  Every value that controls the 9-cell matrix and its artifact
    cadence is checked here so a copied/edited JSON cannot silently widen the
    run.
    """

    if sha256 != PILOT_PREREG_SHA256:
        raise ValueError(
            f"pilot prereg sha mismatch for {path}: expected {PILOT_PREREG_SHA256}, got {sha256}"
        )
    if pilot.get("schema") != "modqn-faithful-lr-pilot-prereg-v1":
        raise ValueError("pilot prereg schema changed")
    if str(pilot.get("status", "")).startswith("FROZEN DATA-BLIND") is not True:
        raise ValueError("pilot prereg is not the frozen data-blind protocol")
    human = pilot.get("human_protocol")
    parent = pilot.get("parent_protocol")
    surfaces = pilot.get("canonical_frozen_surfaces")
    substrate = pilot.get("faithful_substrate")
    matrix = pilot.get("pilot_matrix")
    artifact = pilot.get("artifact_contract")
    if not all(isinstance(block, Mapping) for block in (human, parent, surfaces, substrate, matrix, artifact)):
        raise ValueError("pilot prereg is missing a required protocol block")
    assert isinstance(human, Mapping)
    assert isinstance(parent, Mapping)
    assert isinstance(surfaces, Mapping)
    assert isinstance(substrate, Mapping)
    assert isinstance(matrix, Mapping)
    assert isinstance(artifact, Mapping)
    if human.get("path") != str(PILOT_PROTOCOL_REL) or human.get("sha256") != PILOT_PROTOCOL_SHA256:
        raise ValueError("pilot prereg human protocol path/hash changed")
    if parent.get("path") != str(CURRENT_PREREG_REL) or parent.get("sha256") != CURRENT_PREREG_SHA256:
        raise ValueError("pilot prereg parent prereg path/hash changed")
    expected_surfaces = {
        "angle_aware_ee_contract_version": CURRENT_EEV1_CONTRACT,
        "canonical_runtime_path": "src/modqn_paper_reproduction/runtime/angle_aware_ee.py",
        "canonical_runtime_sha256": CURRENT_RUNTIME_SHA256,
        "golden_vectors_path": "tests/fixtures/angle-aware-ee-v1/golden-vectors.json",
        "golden_vectors_sha256": "2d9de6552e9a8ad037b8d76999fd291938f6fefe64f6ec075b2ea19d76070519",
        "calibration_artifact_path": "docs/research/env-foundation/l4-4-full-angle-aware-ee-scales-2026-08-07.json",
        "calibration_artifact_sha256": "e5f933a141a464aaf497ca5fbb6fb50f2e688ec3a7ecbf5867cab1a5b59d796e",
        "r1_reward_mode": CURRENT_R1_REWARD_MODE,
    }
    for key, expected in expected_surfaces.items():
        if surfaces.get(key) != expected:
            raise ValueError(f"pilot prereg canonical surface changed: {key}")
    if tuple(float(v) for v in surfaces.get("calibration_scales_r1_r2_r3", ())) != CURRENT_CALIBRATION_SCALES:
        raise ValueError("pilot prereg calibration scales changed")
    if tuple(float(v) for v in surfaces.get("objective_weights", ())) != CURRENT_OBJECTIVE_WEIGHTS:
        raise ValueError("pilot prereg objective weights changed")
    expected_env = {
        "num_users": 100,
        "candidate_actions_per_user": 28,
        "fixed_rf_slots": 12,
        "l_w": 4,
        "k_cap": 3,
        "steps_per_episode": 10,
        "qos_floor_bps": 1_000_000.0,
    }
    got_env = surfaces.get("environment")
    if not isinstance(got_env, Mapping) or {
        "num_users": int(got_env.get("num_users", -1)),
        "candidate_actions_per_user": int(got_env.get("candidate_actions_per_user", -1)),
        "fixed_rf_slots": int(got_env.get("fixed_rf_slots", -1)),
        "l_w": int(got_env.get("l_w", -1)),
        "k_cap": int(got_env.get("k_cap", -1)),
        "steps_per_episode": int(got_env.get("steps_per_episode", -1)),
        "qos_floor_bps": float(got_env.get("qos_floor_bps", -1.0)),
    } != expected_env:
        raise ValueError("pilot prereg environment stamp changed")
    expected_substrate = {
        "arm": "modqn_z",
        "transition_unit": "one user item",
        "main_replay_memories": 3,
        "replay_sampling": "independent per objective",
        "td_target": "each objective head independently masked-maxes its own target network",
        "deployment": "independent weighted per-user argmax",
        "auction_or_coordinator": False,
        "capacity_penalty_enabled": False,
        "catfish_exp_enabled": False,
        "acrm_enabled": False,
    }
    for key, expected in expected_substrate.items():
        if substrate.get(key) != expected:
            raise ValueError(f"pilot prereg faithful substrate changed: {key}")
    input_block = substrate.get("input")
    if not isinstance(input_block, Mapping) or input_block.get("raw_dimension") != 112 or input_block.get("z_enabled_dimension") != 224 or input_block.get("representation") != "raw || same-step cross-user per-feature z-score" or input_block.get("congestion_context_feature_block") is not False:
        raise ValueError("pilot prereg input representation changed")
    expected_matrix = {
        "learning_rates": [0.001, 0.003, 0.01],
        "pilot_training_seeds": list(PILOT_SEED_SET),
        "job_count": 9,
        "episodes": 3000,
        "steps_per_episode": 10,
        "threads_per_process": 1,
        "checkpoint_every_completed_episodes": 100,
        "expected_periodic_checkpoints_per_job": 30,
        "progress_every_completed_episodes": 100,
    }
    for key, expected in expected_matrix.items():
        actual = matrix.get(key)
        if key == "learning_rates":
            actual = [float(v) for v in (actual or [])]
        elif key == "pilot_training_seeds":
            actual = [int(v) for v in (actual or [])]
        if actual != expected:
            raise ValueError(f"pilot prereg matrix changed: {key}")
    expected_metrics = {
        "system_ee_ratio_of_sums_bits_per_j",
        "delivered_bits_sum",
        "consumed_energy_sum_j",
        "qos_served_fraction_1mbps",
        "outage_fraction_1mbps",
        "handover_count",
        "handover_rate",
        "load_fairness",
        "mean_step_system_ee_bits_per_j_diagnostic_only",
    }
    if set(artifact.get("required_100_episode_window_metrics", ())) != expected_metrics:
        raise ValueError("pilot prereg window metric schema changed")
    if artifact.get("checkpoint_names") != "ep-00100.pt through ep-03000.pt":
        raise ValueError("pilot prereg checkpoint naming changed")
    if "INCOMPLETE staging" not in str(artifact.get("checkpoint_write_rule", "")):
        raise ValueError("pilot prereg checkpoint staging rule changed")


def load_ablation_config(
    path: str | Path,
    *,
    repo_root: str | Path | None = None,
) -> tuple[MODQNFaithfulAblationConfig, dict[str, Any]]:
    """Load one YAML arm and validate its inherited current-protocol stamps.
        self,
        bank: ObjectiveReplayBank,
        *,
        q_nets: nn.ModuleList,
        target_nets: nn.ModuleList,
        optimizers_: list[optim.Optimizer],
        discount_factor: float,
        trace_context: str | None = None,
    ) -> tuple[float, float, float]:
        if len(bank) < int(self.config.batch_size):
            return (0.0, 0.0, 0.0)
        batches = [
            bank.sample_objective(
                objective,
                int(self.config.batch_size),
                purpose=trace_context,
                step=self._lineage_step,
            )
            for objective in range(NUM_OBJECTIVES)
        ]
        if any(batch is None for batch in batches):
            return (0.0, 0.0, 0.0)
        return self._update_objective_batches(
            [batch for batch in batches if batch is not None],
            q_nets=q_nets,
            target_nets=target_nets,
            optimizers_=optimizers_,
            discount_factor=discount_factor,
            trace_context=trace_context,
        )

    def _update_main(self) -> tuple[float, float, float]:
        # M4 route-update parity: the capacity optimizer step consumes the
        # action-time population context and runs before the TD optimizer step.
        self._apply_capacity_penalty()
        losses = self._update_bank(
            self.replay,
            q_nets=self.q_nets,
            target_nets=self.target_nets,
            optimizers_=self.optimizers,
            discount_factor=self.config.discount_factor,
            trace_context="ordinary_main",
        )
        return losses

    def _apply_capacity_penalty(self) -> None:
        if not self.ablation_config.treatment.penalty_enabled:
            return
        self.capacity_route_update_calls += 1
        if self._capacity_context is None:
            self.capacity_missing_context_skips += 1
            return
        encoded, masks, slot_cells = self._capacity_context
        self._capacity_context = None
        self.capacity_update_count += 1
        if self.capacity_update_count % int(self.ablation_config.capacity_every) != 0:
            self.capacity_cadence_skips += 1
            return
        result = capacity_penalty_loss(
            self.q_nets,
            encoded,
            masks,
            slot_cells,
            weights=np.asarray(self.config.objective_weights, dtype=np.float64),
            l_w=int(self.env.config.l_w),
            grid_count=int(self.env.grid.count),
            k_cap=int(self.env.config.k_cap),
            lam=float(self.ablation_config.capacity_lam),
            tau=float(self.ablation_config.capacity_tau),
            device=self.device,
        )
        if result is None:
            self.capacity_zero_tail_skips += 1
            return
        loss, tail_sum = result
        for optimizer in self.optimizers:
            optimizer.zero_grad()
        loss.backward()
        for optimizer in self.optimizers:
            optimizer.step()
        self._capacity_tail_sum += float(tail_sum)
        self.capacity_fired_count += 1

    def sync_targets(self) -> None:
        for objective in range(NUM_OBJECTIVES):
            self.target_nets[objective].load_state_dict(
                self.q_nets[objective].state_dict()
            )
            if self.catfish_target_nets is not None and self.catfish_q_nets is not None:
                self.catfish_target_nets[objective].load_state_dict(
                    self.catfish_q_nets[objective].state_dict()
            epsilon=float(epsilon),
            r1_mean=float(avg[0]),
            r2_mean=float(avg[1]),
            r3_mean=float(avg[2]),
            scalar_reward=float(scalarize_objectives(avg, objective_weights)),
            total_handovers=int(handovers),
            replay_size=int(replay_size),
            losses=(float(losses[0]), float(losses[1]), float(losses[2])),
        )

    def run_diagnostics_summary(self) -> dict[str, Any]:
        record = self._run_accumulator.as_record(
            arm=self.ablation_config.arm,
            input_mode=self.input_mode,
            treatment=self.ablation_config.treatment.mechanism_labels,
        )
        record["claim_scope"] = "training-diagnostics-only"
        return record

    def capacity_penalty_diagnostics(self) -> dict[str, Any]:
        """M4 telemetry with attempted calls separated from applied updates."""

        return {
            "enabled": bool(self.ablation_config.treatment.penalty_enabled),
            "route_update_calls": int(self.capacity_route_update_calls),
            "fired": int(self.capacity_fired_count),
            "zero_tail_skips": int(self.capacity_zero_tail_skips),
            "cadence_skips": int(self.capacity_cadence_skips),
            "ctx_missing_skips": int(self.capacity_missing_context_skips),
            "updates_seen": int(self.capacity_update_count),
            "tail_sum": float(self._capacity_tail_sum),
            "label": "M4 capacity-penalty training diagnostic; not formal evaluation",
        }


