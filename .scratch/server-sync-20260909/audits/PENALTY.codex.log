#!/usr/bin/env python3
"""Read-only compatibility probe for the sibling intent-tail penalty.

This probe deliberately stops before score or physics evaluation when the exact
sibling inputs cannot be recovered from the sealed V0.25 checkpoint/corpus
interface.  It does not train, select an action, calculate EE, or read an
evaluation-only date.
"""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import resource
import sys
import time


RUN = Path(
    "/home/sat/mcrl-v025-retrain-ws/artifacts/"
    "firstrun-500ep-20260910T1355Z"
)
NAMED_SIBLING_SOURCE = Path(
    "/home/u24/papers/modqn-paper-reproduction/src/modqn_paper_reproduction/"
    "modqn_faithful_ablation/capacity_penalty.py"
)
MIRROR_SIBLING_SOURCE = Path(
    "/home/sat/papers/modqn-paper-reproduction/src/modqn_paper_reproduction/"
    "modqn_faithful_ablation/capacity_penalty.py"
)
EXPECTED_WORLD = "V025_PROBE/world/1"
MISSING_TOPOLOGY_FIELDS = {"slot_cell", "grid_count", "beam_rank"}


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def peak_rss_bytes() -> int:
    # Linux reports ru_maxrss in KiB.
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def progress(message: str) -> None:
    print(f"[progress] {message}; peak_rss_bytes={peak_rss_bytes()}", flush=True)


def read_json(path: Path) -> dict[str, object]:
    with path.open("r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise RuntimeError(f"expected JSON object: {path}")
    return value


def verify_sidecar(path: Path) -> bool:
    sidecar = Path(f"{path}.sha256")
    if not sidecar.is_file():
        return False
    expected = sidecar.read_text(encoding="utf-8").strip().split()[0]
    return sha256(path) == expected


def main() -> int:
    # Fail below the requested 5 GB ceiling even if this small streaming probe
    # regresses later. RLIMIT_AS is a virtual-address ceiling; observed RSS is
    # reported separately.
    ceiling = 4_900_000_000
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    new_soft = ceiling if soft == resource.RLIM_INFINITY else min(soft, ceiling)
    new_hard = hard
    if hard == resource.RLIM_INFINITY or hard >= new_soft:
        resource.setrlimit(resource.RLIMIT_AS, (new_soft, new_hard))

    started = time.monotonic()
    progress(
        f"start pid={os.getpid()} nice={os.getpriority(os.PRIO_PROCESS, 0)} "
        f"python={sys.executable}"
    )

    training_result = read_json(RUN / "training-result.json")
    launch = read_json(RUN / "launch-receipt.json")
    corpus = launch["corpus"]
    if not isinstance(corpus, dict):
        raise RuntimeError("launch receipt corpus is not an object")
    anchors = corpus["anchor_list"]
    files = corpus["files"]
    if not isinstance(anchors, list) or not isinstance(files, list):
        raise RuntimeError("launch receipt corpus lists are malformed")
    if not anchors or any(row.get("world_id") != EXPECTED_WORLD for row in anchors):
        raise RuntimeError("refusing non-development or mixed-world anchor list")

    corpus_root = Path(str(corpus["root"]))
    declared = {str(item["path"]): str(item["sha256"]) for item in files}
    source_paths = sorted(
        path for path in declared if "BUILD_NOT_CLAIM-exact-source-anchor-" in path
    )
    if len(source_paths) != len(anchors):
        raise RuntimeError("one exact source shard per development anchor was expected")

    total_rows = 0
    split_values: set[str] = set()
    world_values: set[str] = set()
    action_mask_widths: set[int] = set()
    per_user_action_counts: set[int] = set()
    q1_widths: set[int] = set()
    q2_widths: set[int] = set()
    row_field_intersection: set[str] | None = None
    null_actions = 0
    physical_actions = 0
    source_hashes_verified = 0

    for ordinal, relative in enumerate(source_paths, start=1):
        path = corpus_root / relative
        if sha256(path) != declared[relative]:
            raise RuntimeError(f"source digest mismatch: {relative}")
        source_hashes_verified += 1
        users: dict[str, int] = {}
        with path.open("r", encoding="utf-8") as handle:
            header = json.loads(next(handle))
            if header.get("world_id") != EXPECTED_WORLD:
                raise RuntimeError(f"refusing non-development shard: {relative}")
            for line in handle:
                row = json.loads(line)
                if row.get("schema") != "mcrl-v025-stagec-source-row-v1":
                    raise RuntimeError(f"unexpected row schema: {relative}")
                total_rows += 1
                split_values.add(str(row.get("split")))
                world_values.add(str(row.get("world_id")))
                fields = set(row)
                row_field_intersection = (
                    fields if row_field_intersection is None else row_field_intersection & fields
                )
                mask = row.get("action_mask")
                if not isinstance(mask, list):
                    raise RuntimeError(f"missing native action mask: {relative}")
                action_mask_widths.add(len(mask))
                q1_widths.add(len(row.get("q1_state", [])))
                q2_widths.add(len(row.get("q2_state", [])))
                user_id = str(row.get("user_id"))
                users[user_id] = users.get(user_id, 0) + 1
                action = row.get("action")
                if not isinstance(action, dict):
                    raise RuntimeError(f"missing physical action object: {relative}")
                if action.get("norad_id") is None:
                    if action.get("beam_chain_id") is not None:
                        raise RuntimeError(f"half-null physical action: {relative}")
                    null_actions += 1
                else:
                    if action.get("beam_chain_id") is None:
                        raise RuntimeError(f"half-null physical action: {relative}")
                    physical_actions += 1
        per_user_action_counts.update(users.values())
        progress(f"development anchor {ordinal}/{len(source_paths)} verified")

    if split_values != {"TRAIN"} or world_values != {EXPECTED_WORLD}:
        raise RuntimeError("refusing source outside TRAIN development scope")
    present_fields = row_field_intersection or set()
    topology_fields_present = sorted(MISSING_TOPOLOGY_FIELDS & present_fields)

    checkpoints = training_result["checkpoints"]
    if not isinstance(checkpoints, list):
        raise RuntimeError("training checkpoint inventory is malformed")
    latest_entries = [
        row for row in checkpoints if int(row.get("completed_source_epochs", -1)) == 500
    ]
    checkpoint_hashes_verified = 0
    c1_kinds: set[str] = set()
    c2_kinds: set[str] = set()
    c3_kinds: set[str] = set()
    c3_architectures: set[str] = set()
    c3_member_widths: set[int] = set()
    output_bias_widths: dict[str, set[int]] = {"C1": set(), "C2": set(), "C3": set()}
    for ordinal, entry in enumerate(latest_entries, start=1):
        checkpoint = Path(str(entry["path"]))
        if not verify_sidecar(checkpoint):
            raise RuntimeError(f"checkpoint sidecar verification failed: {checkpoint}")
        checkpoint_hashes_verified += 1
        payload = read_json(checkpoint)
        full = payload["arms"]["FULL"]
        c1_kinds.add(str(full["C1"]["kind"]))
        c2_kinds.add(str(full["C2"]["kind"]))
        c3_kinds.add(str(full["C3"]["kind"]))
        c3_architectures.add(str(full["C3"]["architecture"]))
        c3_member_widths.add(int(full["C3"]["member_width"]))
        for head in ("C1", "C2", "C3"):
            biases = full[head].get("biases_hex", [])
            if not isinstance(biases, list) or not biases:
                raise RuntimeError(f"missing serialized biases for {head}: {checkpoint}")
            output_bias_widths[head].add(len(biases[-1]))
        progress(f"epoch-500 checkpoint {ordinal}/{len(latest_entries)} verified")

    mirror_hash = sha256(MIRROR_SIBLING_SOURCE)
    named_hash = sha256(NAMED_SIBLING_SOURCE) if NAMED_SIBLING_SOURCE.is_file() else None

    blockers = [
        "C3 is a set-conditioned scalar interaction head, not a per-user/per-candidate Q tensor",
        "the sealed source-row interface has no slot_cell field",
        "the sealed source-row interface has no grid_count field",
        "the sealed source-row interface has no beam_rank field",
        "the native candidate axis has width 10, not the sibling's required 7*l_w grouping",
        "action_index is shortlist-local; physical identity is the (norad_id, beam_chain_id) pair",
    ]
    result = {
        "schema": "mcrl-v025-intent-tail-compatibility-probe-v1",
        "status": "MAPPING_UNAVAILABLE",
        "can_instantiate_or_fire_as_specified": False,
        "tail_at_current_policy": None,
        "tail_units": "intent mass",
        "tail_ee_correlation_across_anchors": None,
        "not_computed_reason": blockers,
        "no_ee_computed": True,
        "loss_used_as_ee_evidence": False,
        "evaluation_only_claim_dates_read": False,
        "development_scope": {
            "worlds": sorted(world_values),
            "splits": sorted(split_values),
            "anchors": len(source_paths),
            "source_rows": total_rows,
            "source_hashes_verified": source_hashes_verified,
        },
        "available_inputs": {
            "action_mask": True,
            "physical_action_fields": ["action.norad_id", "action.beam_chain_id"],
            "q1_state_widths": sorted(q1_widths),
            "q2_state_widths": sorted(q2_widths),
        },
        "unavailable_exact_sibling_inputs": {
            "aligned_third_candidate_head": True,
            "slot_cell": "absent",
            "grid_count": "absent",
            "beam_rank": "absent",
            "topology_fields_present": topology_fields_present,
        },
        "candidate_surface": {
            "native_action_mask_widths": sorted(action_mask_widths),
            "per_user_serialized_action_counts": sorted(per_user_action_counts),
            "physical_action_rows": physical_actions,
            "null_action_rows": null_actions,
        },
        "frozen_checkpoints": {
            "epoch": 500,
            "count": len(latest_entries),
            "hash_sidecars_verified": checkpoint_hashes_verified,
            "full_c1_kinds": sorted(c1_kinds),
            "full_c2_kinds": sorted(c2_kinds),
            "full_c3_kinds": sorted(c3_kinds),
            "full_c3_architectures": sorted(c3_architectures),
            "full_c3_member_widths": sorted(c3_member_widths),
            "serialized_final_bias_widths": {
                key: sorted(value) for key, value in output_bias_widths.items()
            },
        },
        "sibling_source": {
            "requested_path_reachable": NAMED_SIBLING_SOURCE.is_file(),
            "requested_path_sha256": named_hash,
            "mirror_path": str(MIRROR_SIBLING_SOURCE),
            "mirror_sha256": mirror_hash,
        },
        "runtime": {
            "python": sys.executable,
            "nice": os.getpriority(os.PRIO_PROCESS, 0),
            "blas_thread_environment": {
                key: os.environ.get(key)
                for key in (
                    "OMP_NUM_THREADS",
                    "OPENBLAS_NUM_THREADS",
                    "MKL_NUM_THREADS",
                    "NUMEXPR_NUM_THREADS",
                    "BLIS_NUM_THREADS",
                    "VECLIB_MAXIMUM_THREADS",
                )
            },
            "processes_spawned": 0,
            "elapsed_seconds": time.monotonic() - started,
            "peak_rss_bytes": peak_rss_bytes(),
            "rss_limit_bytes": 5_000_000_000,
        },
    }
    progress("probe complete")
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
