            "admitted_items": int(trainer.exp_admitted_count),
            "rejected_items": int(trainer.exp_rejected_count),
            "catfish_updates": int(trainer.catfish_update_count),
            "interventions": int(trainer.exp_intervention_count),
            "intervention_skipped": int(trainer.exp_intervention_skipped_count),
            "catfish_faithful_config": dataclasses.asdict(trainer.catfish_config)
            if config.treatment.exp_enabled
            else None,
            "catfish_replay_shaped": (
                trainer.catfish_replay.independent_sampling_stamp()
                if trainer.catfish_replay is not None
                else None
            ),
            "catfish_replay_raw": (
                trainer.catfish_replay_raw.independent_sampling_stamp()
                if trainer.catfish_replay_raw is not None
                else None
            ),
            "reward_containment": {
                "catfish_critic": "shaped calibrated catfish replay",
                "main_intervention": "raw unshaped calibrated catfish replay",
                "main_hard_mid_cross_route": "raw unshaped calibrated catfish replay",
            },
            "stratification": (
                trainer._stratifier.diagnostics()  # noqa: SLF001
                if trainer._stratifier is not None
                else None
            ),
        },
        "capacity_penalty_diagnostics": trainer.capacity_penalty_diagnostics(),
        "pilot": {
            "enabled": bool(config.pilot),
            "seed_set": list(config.pilot_seed_set),
            "learning_rate_set": [0.001, 0.003, 0.01] if config.pilot else [float(config.learning_rate)] if config.learning_rate is not None else [],
            "expected_matrix_cells": 9 if config.pilot else None,
            "protocol_path": config.pilot_protocol,
            "protocol_sha256": config.pilot_protocol_sha256,
            "prereg_path": config.pilot_prereg,
            "prereg_sha256": config.pilot_prereg_sha256,
            "episodes": int(declared_episodes),
            "threads_per_process": 1,
            "checkpoint_every_completed_episodes": int(config.checkpoint_every_episodes),
            "expected_periodic_checkpoints": 30 if config.pilot and not smoke else len(periodic_paths),
        },
    }
    write_json(final_seed_dir / "run_metadata.json", metadata)
    return metadata


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True)
    parser.add_argument("--seed", type=int, required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--progress-every", type=int, default=100)
    parser.add_argument(
        "--smoke",
        action="store_true",
        help="explicit readiness smoke mode; artifacts are never formal",
    )
            raise ValueError("Phase-I job must bind a Source Gate A receipt")
        if treatment.phase1_arm in {"B", "C"}:
            if not self.source_thresholds_path or not self.source_thresholds_sha256:
                raise ValueError("arms B/C require the frozen source thresholds")
        elif self.source_thresholds_path is not None or self.source_thresholds_sha256 is not None:
            raise ValueError("arms N/A must not consume fixed source thresholds")
        if treatment.phase1_arm == "C":
            if not self.source_pool_path or not self.source_pool_sha256:
                raise ValueError("arm C requires the immutable Phase-I source pool")
        elif self.source_pool_path is not None or self.source_pool_sha256 is not None:
            raise ValueError("only arm C may read the Phase-I source pool")

    @property
    def treatment(self) -> Phase1TreatmentSpec:
        return phase1_treatment(self.arm)

    @property
    def fixed_strata(self) -> bool:
        return self.arm in {"B", "C"}

    @property
    def prefill_enabled(self) -> bool:
        return self.arm == "C"

    def checkpoint_due(self, episode_index: int) -> bool:
        return (int(episode_index) + 1) % self.checkpoint_every_episodes == 0

    def stamp(self, *, prereg_sha256: str | None = None) -> dict[str, Any]:
        return {
            "schema": "modqn-faithful-phase1-diagnostic-config-v1",
            "arm": self.arm,
            "input_mode": self.input_mode,
            "treatment": {
                "P_capacity_penalty": False,
                "EXP_item_replay_catfish": self.treatment.exp_enabled,
                "ACRM_matched_counterfactual": False,
                "fixed_strata": self.fixed_strata,
                "phase1_prefill": self.prefill_enabled,
                "mechanisms": list(self.treatment.mechanism_labels),
            },
            "protocol": {
                "prereg_path": self.prereg_path,
                "prereg_sha256": prereg_sha256 or self.prereg_sha256,
                "parent_prereg_path": str(CURRENT_PREREG_REL),
                "parent_prereg_sha256": CURRENT_PREREG_SHA256,
                "r1_reward_mode": self.r1_reward_mode,
                "angle_aware_ee_contract_version": self.angle_aware_ee_contract_version,
                "canonical_runtime_sha256": CURRENT_RUNTIME_SHA256,
                "calibration_scales": list(self.calibration_scales),
                "objective_weights": list(self.objective_weights),
                "rng_rule": self.rng_rule,
                "environment": dict(self.environment),
            },
            "artifacts": {
                "source_gate_path": self.source_gate_path,
                "source_gate_sha256": self.source_gate_sha256,
                "source_pool_path": self.source_pool_path,
                "source_pool_sha256": self.source_pool_sha256,
                "source_thresholds_path": self.source_thresholds_path,
                "source_thresholds_sha256": self.source_thresholds_sha256,
            },
        PHASE1_QUARANTINED_SOURCE_SEEDS,
        "seed_domains.quarantined",
    )
    production = {
        *PHASE1_SOURCE_SEEDS,
        *PHASE1_TRAINING_SEEDS,
        *PHASE1_EVALUATION_SEEDS,
    }
    if production & PHASE1_FORBIDDEN_SEEDS:
        raise ValueError("Phase-I production seeds overlap smoke/quarantined seeds")
    if len(production) != len(PHASE1_ALL_PRODUCTION_SEEDS):
        raise ValueError("Phase-I source/training/evaluation seed domains overlap")
    # Keep the duplicated operational fields bound to the same domains; this
    # prevents a receipt from being made internally self-consistent with a
    # different set of seeds than the transfer matrix.
    _expect_sequence(source.get("seeds"), PHASE1_SOURCE_SEEDS, "source seeds")
    _expect_sequence(matrix.get("training_seeds"), PHASE1_TRAINING_SEEDS, "training seeds")
    _expect_sequence(matrix.get("evaluation_seeds"), PHASE1_EVALUATION_SEEDS, "evaluation seeds")


def _validate_treatment_matrix(matrix: Mapping[str, Any]) -> None:
    expected = {
        "N": {
            "exp": False,
            "thresholds": "none",
            "prefill": "none",
            "capacity_penalty": False,
            "acrm": False,
        },
        "A": {
            "exp": True,
            "thresholds": "rolling-q80-q50",
            "prefill": "none",
            "capacity_penalty": False,
            "acrm": False,
        },
        "B": {
            "exp": True,
            "thresholds": "frozen-source-gate-a-q80-q50",
            "prefill": "none",
            "capacity_penalty": False,
            "acrm": False,
        },
        "C": {
            "exp": True,
            "thresholds": "frozen-source-gate-a-q80-q50",
            "prefill": "greedy-high-to-catfish-raw-shaped;greedy-mid-to-main",
            "capacity_penalty": False,
            "acrm": False,
        },
    }
    declared = _mapping(matrix.get("treatment_matrix"), "transfer_pilot.treatment_matrix")
    if set(declared) != set(expected):
        raise ValueError("Phase-I treatment matrix must contain exactly N, A, B, C")
    for arm, values in expected.items():
        row = _mapping(declared.get(arm), f"treatment_matrix.{arm}")
        if dict(row) != values:
            raise ValueError(f"Phase-I treatment mismatch for arm {arm}")


def validate_phase1_prereg(
# MODQN-faithful LR pilot protocol (data-blind design)

Status: `DESIGN-FROZEN-BEFORE-PILOT-EPISODE-0`

Claim ceiling: diagnostic learning-rate selection only. This pilot cannot support a Chapter 5 result, an arm ranking, an MCRL effectiveness claim, or a collapse-root-cause verdict.

## Root question and decision-tree node

The project root question remains whether MODQN collapse is environment-, state/input-, or algorithm-rooted. This pilot is a bounded substrate check inside the state/input and optimizer branches: it asks whether a paper-faithful MODQN update remains numerically stable and shows useful learning progress under the current canonical Family-B environment when the learning rate changes. It does not resolve the root question by itself.

## Fixed scientific boundary

- Canonical angle-aware EE formula, runtime, contract, golden vectors, environment reward definitions, calibration constants, objective weights, action execution, QoS threshold, power constants, cap semantics, and evaluation identity are unchanged.
- Canonical runtime SHA-256: `e838246b7c82e4ccb01b323d92d5e49ab3f849039e31312f20a96adc52154131`.
- Golden-vector SHA-256: `2d9de6552e9a8ad037b8d76999fd291938f6fefe64f6ec075b2ea19d76070519`.
- Base frozen preregistration SHA-256: `71e8bd6628af4dae9d673d96e30e46589fdeeacd14edc26df7774a2d25ac2af0`.
- Calibration scales remain `(117217362.20189127, 287.27125, 166310676.7672135)`.
- Objective weights remain `[0.5, 0.3, 0.2]`.
- No checkpoint, replay memory, pool, scale, or output root may be resumed or reused.

## Faithful MODQN substrate under test

- Deployment/action selection remains an independent per-user weighted `argmax`; there is no auction, coordinator, decoder, or joint allocator.
- A transition is one user item, not an all-user step bundle.
- The three objectives have three separate replay memories and independently sampled batches.
- Each objective head computes its own masked maximum from its own target network. There is no shared scalarized next action in the TD target.
- No congestion-context feature block is appended.
- The pilot uses the z-enabled matched control: the 112-dimensional raw state is concatenated with its same-step cross-user per-feature z-score, yielding 224 dimensions. The raw-only 112-dimensional control is not part of the LR pilot.
- Capacity penalty, Catfish EXP, and ACRM are all disabled. Therefore the pilot isolates the common MODQN substrate and learning rate.

## Pilot matrix

Nine independent jobs start from episode 0:

| Factor | Frozen values |
|---|---|
| Arm | `modqn_z` only |
| Learning rate | `0.001`, `0.003`, `0.01` |
| Pilot-only training seeds | `31415`, `27182`, `16180` |
| Episodes | `3000` |
| Steps per episode | `10` |
| Threads per process | `1` |
| Checkpoint cadence | every `100` completed episodes |
| Concurrency | at most `nproc-2`; independent jobs may run concurrently |

The pilot seeds are disjoint from the six future formal arm seeds, checkpoint-selection seeds, held-out evaluation seeds, and even/odd calibration seeds. A learning rate selected with these pilot roots must be frozen before the later formal comparison; the pilot roots must not then be promoted into that formal comparison.

## Trend and validity records

At every 100-episode boundary the runner must save both a checkpoint and a diagnostic training-window record. The window record must include:

- canonical ratio-of-sums EE: total delivered bits divided by total consumed joules over matched durations;
- QoS/outage at 1 Mbit/s, handover count/rate, and load fairness;
- finite/non-negative throughput, rate, power, and reward checks;
- rejection of positive throughput with zero power;
- the additive instantaneous EE identity;
- replay/target-rule/input-mode/treatment/config/source hashes;
- explicit labels distinguishing training-window diagnostics, mean-step EE diagnostics, and formal fixed-policy evaluation.

Training-window curves are diagnostics because the policy changes throughout the window. Checkpoints are retained so a later read-only post-hoc evaluator can compare fixed policies at selected episodes without retraining. Formal Chapter 5 EE remains fixed-policy ratio-of-sums evaluation under a separately frozen protocol.

## Pre-launch gates

Before launch, a fresh process must prove:

1. the original canonical runtime, golden, calibration artifact, base preregistration, and full source fences still match;
2. the three resolved pilot configs differ only in learning rate and their own config hash;
3. all nine `(learning rate, seed)` output targets are absent and no writer or tmux session overlaps them;
4. a short deterministic smoke reaches the real item-replay, independent-head target, periodic-checkpoint, metric-window, and artifact-validation paths without changing any frozen surface;
5. each process is pinned to one thread and the launch inventory is no larger than `nproc-2`.

Any fence mismatch, stale artifact reuse, non-finite quantity, schema omission, or identity failure is `PROTOCOL-FAIL`; do not change the formula, runtime, golden data, thresholds, or hashes to force a pass.

## LR selection rule

The pilot is not a search for the largest endpoint. Reject a learning rate if any seed shows numerical failure, persistent Q/target explosion, invalid physical metrics, or late-window collapse. Among remaining rates, prefer the smallest rate whose three-seed learning progress is consistently better by 3000 episodes and whose 100-episode ratio-of-sums trend has not already turned into a sustained decline. If the evidence is mixed, retain `0.001` as the conservative control and report that 3000 episodes did not identify a safe faster rate.

