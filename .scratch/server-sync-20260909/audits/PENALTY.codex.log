   140	@dataclass(frozen=True)
   141	class MODQNFaithfulAblationConfig:
   142	    """Configuration after YAML resolution and current-protocol validation.
   143	
   144	    ``episodes`` and ``learning_rate`` are optional overrides over the frozen
   145	    prereg.  The prospective LR pilot sets both explicitly in YAML and is
   146	    marked ``pilot=True``; scored/current-protocol callers may leave them null.
   147	    """
   148	
   149	    arm: ArmName
   150	    input_mode: InputMode
   151	    base_prereg: str = str(CURRENT_PREREG_REL)
   152	    base_prereg_sha256: str = CURRENT_PREREG_SHA256
   153	    episodes: int | None = None
   154	    learning_rate: float | None = None
   155	    checkpoint_every_episodes: int = CHECKPOINT_EVERY_EPISODES
   156	    threads: int = 1
   157	    pilot: bool = False
   158	    pilot_seed_set: tuple[int, ...] = PILOT_SEED_SET
   159	    pilot_protocol: str | None = None
   160	    pilot_protocol_sha256: str | None = None
   161	    pilot_prereg: str | None = None
   162	    pilot_prereg_sha256: str | None = None
   163	    no_resume: bool = True
   164	    no_reuse: bool = True
   165	    zscore_eps: float = 1.0e-6
   166	    capacity_lam: float = 0.05
   167	    capacity_tau: float = 1.0
   168	    capacity_every: int = 1
   169	    # Protocol stamps are intentionally visible rather than inferred only from
   170	    # the prereg.  Validation requires exact current values.
   171	    r1_reward_mode: str = CURRENT_R1_REWARD_MODE
   172	    angle_aware_ee_contract_version: str = CURRENT_EEV1_CONTRACT
   173	    calibration_scales: tuple[float, float, float] = CURRENT_CALIBRATION_SCALES
   174	    objective_weights: tuple[float, float, float] = CURRENT_OBJECTIVE_WEIGHTS
   175	    rng_rule: str = CURRENT_RNG_RULE
   176	    environment: Mapping[str, int] = field(
   177	        default_factory=lambda: dict(CURRENT_ENVIRONMENT)
   178	    )
   179	    readiness_only: bool = True
   180	    # The accepted Family-B state path keeps the defense-in-depth offset mask
   181	    # enabled.  This is not an ablation treatment and cannot be toggled here.
   182	    offset_mask_enabled: bool = True
   183	    max_reachable_offset_km: float = 1000.0
   184	
   185	    def __post_init__(self) -> None:
   186	        spec = treatment_spec(self.arm)
   187	        if self.input_mode != spec.input_mode:
   188	            raise ValueError(
   189	                f"arm {self.arm!r} requires input_mode={spec.input_mode!r}; "
   190	                f"got {self.input_mode!r}"
   191	            )
   192	        if self.threads != 1:
   193	            raise ValueError("MODQN-faithful Family-B runs require threads=1")
   194	        if self.checkpoint_every_episodes < 1:
   195	            raise ValueError("checkpoint_every_episodes must be >= 1")
   196	        if self.episodes is not None and self.episodes < 1:
   197	            raise ValueError("episodes override must be >= 1")
   198	        if self.learning_rate is not None and self.learning_rate <= 0.0:
   199	            raise ValueError("learning_rate override must be positive")
   200	        if self.zscore_eps <= 0.0:
   201	            raise ValueError("zscore_eps must be positive")
   202	        if self.capacity_lam < 0.0 or self.capacity_tau <= 0.0:
   203	            raise ValueError("capacity_lam must be >= 0 and capacity_tau > 0")
   204	        if self.capacity_every < 1:
   205	            raise ValueError("capacity_every must be >= 1")
   206	        if self.no_resume is not True or self.no_reuse is not True:
   207	            raise ValueError("MODQN-faithful runs fail closed on resume/reuse")
   208	        if self.offset_mask_enabled is not True:
   209	            raise ValueError("the accepted Family-B offset mask must remain enabled")
   210	        if float(self.max_reachable_offset_km) != 1000.0:
   211	            raise ValueError(
   212	                "the accepted Family-B reachable-offset threshold is fixed to 1000 km"
   213	            )
   214	        if self.r1_reward_mode != CURRENT_R1_REWARD_MODE:
   215	            raise ValueError("the active Family-B r1 mode is fixed to system-ee-contribution")
   216	        if self.angle_aware_ee_contract_version != CURRENT_EEV1_CONTRACT:
   217	            raise ValueError(
   218	                "the active Family-B angle-aware EE contract is fixed to "
   219	                f"{CURRENT_EEV1_CONTRACT!r}"
   220	            )
