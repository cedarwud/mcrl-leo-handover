"""Local copy of the declared capacity-penalty math for the new sibling seam.

The formula is the same top-k physical-beam intent-tail regularizer used by
the current treatment design.  It is kept local so this trainer does not
import the Route-B/shared-Q bundle or its decoder machinery.  It receives the
current population's *candidate* mask and slot-to-cell map, computes a
differentiable penalty over the three main Q heads, and never changes the
environment's actual power/EE calculation.
"""

from __future__ import annotations

from typing import Any

import numpy as np
import torch


def capacity_penalty_loss(
    q_nets: list[torch.nn.Module] | torch.nn.ModuleList,
    encoded: np.ndarray,
    action_mask: np.ndarray,
    slot_cell: np.ndarray,
    *,
    weights: np.ndarray,
    l_w: int,
    grid_count: int,
    k_cap: int,
    lam: float,
    tau: float,
    device: torch.device | str = "cpu",
) -> tuple[torch.Tensor, float] | None:
    """Return ``(loss, raw_tail_sum)`` or ``None`` when the tail is zero.

    ``encoded`` is the exact population input used for the main behavior
    decision (raw, z, or concat); no replay bundle or action decoder is needed.
    """

    if float(lam) < 0.0 or float(tau) <= 0.0:
        raise ValueError("capacity penalty requires lam >= 0 and tau > 0")
    x_np = np.asarray(encoded, dtype=np.float32)
    mask_np = np.asarray(action_mask, dtype=bool)
    cell_np = np.asarray(slot_cell, dtype=np.int64)
    if x_np.ndim != 2 or mask_np.ndim != 2 or cell_np.ndim != 2:
        raise ValueError("capacity penalty inputs must be two-dimensional")
    if x_np.shape[0] != mask_np.shape[0] or mask_np.shape != cell_np.shape:
        raise ValueError("capacity penalty population axes do not match")
    if x_np.shape[1] < 1 or mask_np.shape[1] < 1:
        raise ValueError("capacity penalty requires non-empty population/action axes")
    if int(l_w) < 1 or int(grid_count) < 1 or int(k_cap) < 1:
        raise ValueError("capacity penalty topology values must be positive")
    if np.any(cell_np < 0) or np.any(cell_np >= int(grid_count)):
        raise ValueError("slot_cell contains a cell outside grid_count")
    w = np.asarray(weights, dtype=np.float64).reshape(-1)
    if w.shape != (3,):
        raise ValueError("weights must have shape (3,)")
    if len(q_nets) != 3:
        raise ValueError("capacity penalty requires exactly three Q heads")

    x = torch.from_numpy(np.ascontiguousarray(x_np)).to(device)
    values = sum(float(w[idx]) * q_nets[idx](x) for idx in range(3))
    mask_t = torch.from_numpy(mask_np).to(values.device)
    # Per-user normalization over valid candidate actions only.
    valid_values = values.masked_fill(~mask_t, 0.0)
    n_valid = mask_t.sum(dim=1, keepdim=True).clamp(min=1)
    mean = valid_values.sum(dim=1, keepdim=True) / n_valid
    variance = (((values - mean) * mask_t).pow(2).sum(dim=1, keepdim=True)) / n_valid
    normalized = (values - mean) / (variance.sqrt() + 1.0e-6)
    logits = normalized.masked_fill(~mask_t, float("-inf")) / float(tau)
    intent = torch.softmax(logits, dim=1)

    users, actions = intent.shape
    if actions % 7 != 0:
        raise ValueError("Family-B candidate action axis must be grouped into 7 beams per satellite")
    beams_per_satellite = 7
    beam_rank = (
        torch.arange(actions, device=intent.device, dtype=torch.long)
        // beams_per_satellite
    ).unsqueeze(0).expand(users, actions)
    cells = torch.from_numpy(cell_np).to(intent.device)
    physical_key = (beam_rank * int(grid_count) + cells).reshape(-1)
    pressure = torch.zeros(
        int(l_w) * int(grid_count), dtype=intent.dtype, device=intent.device
    )
    pressure = pressure.index_add(0, physical_key, intent.reshape(-1))
    pressure_lc = pressure.view(int(l_w), int(grid_count))
    topk_sum = torch.topk(
        pressure_lc,
        k=min(int(k_cap), int(grid_count)),
        dim=1,
    ).values.sum(dim=1)
    tail = pressure_lc.sum(dim=1) - topk_sum
    tail_sum = float(tail.detach().sum().item())
    loss = float(lam) * ((tail.clamp(min=0.0) / max(int(users), 1)) ** 2).sum()
    if float(loss.detach().item()) == 0.0:
        return None
    return loss, tail_sum


def ignition_selftest(
    *,
    l_w: int = 4,
    grid_count: int = 30,
    k_cap: int = 3,
    users: int = 20,
    actions: int = 28,
) -> dict[str, Any]:
    """Deterministic local check that the penalty can actually fire."""

    torch.manual_seed(0)
    rng = np.random.default_rng(0)
    encoded = rng.normal(size=(users, 16)).astype(np.float32)
    mask = np.ones((users, actions), dtype=bool)
    q_nets = [torch.nn.Linear(16, actions) for _ in range(3)]
    weights = np.asarray((0.5, 0.3, 0.2), dtype=np.float64)
    spread = np.tile(np.arange(actions) % 7, (users, 1)).astype(np.int64)
    concentrated = np.tile((np.arange(actions) % 7) % k_cap, (users, 1)).astype(np.int64)
    bad = capacity_penalty_loss(
        q_nets,
        encoded,
        mask,
        spread,
        weights=weights,
        l_w=l_w,
        grid_count=grid_count,
        k_cap=k_cap,
        lam=1.0,
        tau=1.0,
    )
    if bad is None:
        raise AssertionError("capacity penalty ignition failed: spread produced zero")
    bad_loss, _ = bad
    bad_loss.backward()
    grad_norm = sum(
        float(param.grad.detach().norm().item())
        for net in q_nets
        for param in net.parameters()
        if param.grad is not None
    )
    good = capacity_penalty_loss(
        q_nets,
        encoded,
        mask,
        concentrated,
        weights=weights,
        l_w=l_w,
        grid_count=grid_count,
        k_cap=k_cap,
        lam=1.0,
        tau=1.0,
    )
    good_value = 0.0 if good is None else float(good[0].detach().item())
    if not np.isfinite(grad_norm) or grad_norm <= 0.0:
        raise AssertionError("capacity penalty ignition produced no finite gradient")
    if good_value != 0.0:
        raise AssertionError(f"capacity penalty concentrated control should be zero, got {good_value}")
    return {
        "spread_loss": float(bad_loss.detach().item()),
        "concentrated_loss": good_value,
        "grad_norm": float(grad_norm),
        "PASS": True,
    }


__all__ = ["capacity_penalty_loss", "ignition_selftest"]
