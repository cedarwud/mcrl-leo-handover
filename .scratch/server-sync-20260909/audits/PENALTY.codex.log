    89	@dataclass(frozen=True)
    90	class TreatmentSpec:
    91	    """Resolved method treatment for one arm."""
    92	
    93	    name: ArmName
    94	    input_mode: InputMode
    95	    penalty_enabled: bool
    96	    exp_enabled: bool
    97	    acrm_enabled: bool
    98	
    99	    @property
   100	    def catfish_enabled(self) -> bool:
   101	        return self.exp_enabled
   102	
   103	    @property
   104	    def mechanism_labels(self) -> tuple[str, ...]:
   105	        labels: list[str] = []
   106	        if self.penalty_enabled:
   107	            labels.append("P")
   108	        if self.exp_enabled:
   109	            labels.append("EXP")
   110	        if self.acrm_enabled:
   111	            labels.append("ACRM")
   112	        return tuple(labels)
   113	
   114	
   115	# Keep this as data, not a collection of ad-hoc conditional branches.  The
   116	# runner and tests stamp this exact matrix into metadata.
   117	TREATMENT_MATRIX: dict[str, TreatmentSpec] = {
   118	    "modqn_raw": TreatmentSpec("modqn_raw", "raw", False, False, False),
   119	    # concat = raw || same-step cross-user z; pure-z is not an arm.
   120	    "modqn_z": TreatmentSpec("modqn_z", "concat", False, False, False),
   121	    "full": TreatmentSpec("full", "concat", True, True, True),
   122	    "wo_penalty": TreatmentSpec("wo_penalty", "concat", False, True, True),
   123	    # Explicitly P-only: no EXP means no catfish agent and therefore no ACRM.
   124	    "wo_exp": TreatmentSpec("wo_exp", "concat", True, False, False),
   125	    "wo_acrm": TreatmentSpec("wo_acrm", "concat", True, True, False),
   126	}
   127	
   128	
   129	def treatment_spec(name: str) -> TreatmentSpec:
   130	    key = str(name).strip()
   131	    try:
   132	        return TREATMENT_MATRIX[key]
   133	    except KeyError as exc:
   134	        raise ValueError(
   135	            f"unknown MODQN-faithful ablation arm {name!r}; "
   136	            f"expected one of {sorted(TREATMENT_MATRIX)}"
   137	        ) from exc
