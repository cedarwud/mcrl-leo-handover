def _physical_action(identity: tuple[int, int] | None) -> PhysicalAction:
    return PhysicalAction(None, None) if identity is None else PhysicalAction(*identity)


def _identity(action: PhysicalAction) -> tuple[int, int] | None:
    if action.is_null:
        return None
    assert action.norad_id is not None and action.beam_chain_id is not None
    return (action.norad_id, action.beam_chain_id)


def _utc_at(tape, step_index: int) -> str:
    start = dt.datetime.fromisoformat(tape.protocol.start_utc.replace("Z", "+00:00"))
    return (start + dt.timedelta(seconds=step_index * DECISION_INTERVAL_S)).isoformat()


def _counts(mapping: Mapping[int, tuple[int, int] | None], focal: int) -> tuple[dict, dict]:
    beam: dict[tuple[int, int], int] = {}
    satellite: dict[int, int] = {}
    for user, identity in mapping.items():
        if user == focal or identity is None:
            continue
        beam[identity] = beam.get(identity, 0) + 1
        satellite[identity[0]] = satellite.get(identity[0], 0) + 1
    return beam, satellite


def _candidate_primitives(
    tape, step_index: int, user: int, identity, *, row_index=None
):
    if identity is None:
        return None
    step = tape.steps[step_index]
    if step.arrays is not None:
        arrays = step.arrays
        try:
            row = (arrays._row_index() if row_index is None else row_index)[
                (user, identity)
            ]
        except KeyError:
            return None
        return {
            "remaining_d2": float(arrays.remaining_d2_s[0, row]),
            "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
        }
    row = next(
        (
            value
            for value in step.boundaries[0].candidates
            if value.user_id == user and value.identity == identity
        ),
        None,
    )
    if row is None:
        return None
    return {
        "remaining_d2": row.remaining_d2_s,
        "remaining_visibility": row.remaining_visibility_s,
    }


def _archive_digest(tape) -> str:
    return canonical_sha256({"tle_files": list(tape.protocol.tle_files)})


def _pilot_calibration(tape, setting, run_setting) -> PilotCalibration:
    base = ENGINE._base_configuration(tape, 0, "nearest-eligible")
    evaluator = ENGINE.StepEvaluator(
        tape,
        setting,
        0,
        transition_from=base,
        field="realised",
        run_setting=run_setting,
    )
    profile = evaluator.evaluate(base)
    bits = Fraction(str(profile.bits))
    joules = Fraction(str(profile.joules))
    if bits <= 0 or joules <= 0:
        raise RuntimeError("pilot calibration proxy has a nonpositive endpoint")
    return PilotCalibration(
        eta_ref=bits / joules,
        lambda_bits_per_j=bits / joules,
        kappa_bits_per_user_step=bits / len(tape.user_layout),
        bits_ref=bits,
        joules_ref=joules,
        users=len(tape.user_layout),
    )


def _action_configs(tape, step_index: int, base, run_setting, *, full_legal: bool):
    if full_legal:
        options, census = ENGINE._legal_options(tape, step_index)
    else:
        options, census = ENGINE._selection_shortlist(
            tape, step_index, run_setting=run_setting
        )
    by_user: dict[int, tuple[tuple[int, int] | None, ...]] = {}
    configs: dict[tuple[int, tuple[int, int] | None], object] = {}
    for user in sorted(base.mapping):
        ordered = []
        for identity in (base.mapping[user], *options[user], None):
            if identity not in ordered:
                ordered.append(identity)
        by_user[user] = tuple(ordered)
        for identity in ordered:
            mapping = base.mapping
            mapping[user] = identity
            configs[(user, identity)] = ENGINE._configuration(
                base, mapping, kind="pilot-shortlisted-unilateral"
            )
    return by_user, configs, census


def _primitive_metrics(tape, step_index: int, user: int, identity, indices):
    if identity is None:
        return {
            "legal": False, "gain": 0.0, "remaining_d2": 0.0,
            "remaining_visibility": 0.0,
        }
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        candidate = next(
            (row for row in tape.steps[step_index].boundaries[0].candidates
             if row.user_id == user and row.identity == identity),
            None,
        )
        if candidate is None:
            return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
        return {
            "legal": candidate.legal,
            "gain": candidate.nominal_gain,
            "remaining_d2": candidate.remaining_d2_s,
            "remaining_visibility": candidate.remaining_visibility_s,
        }
    row = indices[step_index].get((user, identity))
    if row is None:
        return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
    return {
        "legal": bool(arrays.visible[0, row] and arrays.d2_eligible[0, row] and arrays.cell_reachable[0, row]),
        "gain": float(arrays.nominal_gain[0, row]),
        "remaining_d2": float(arrays.remaining_d2_s[0, row]),
        "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
    }


