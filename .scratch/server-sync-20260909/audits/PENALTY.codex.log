   156	  lam: 0.05          # λ；0.0 = 硬關閉（bit-identity 路徑）
   157	  tau: 1.0           # 尺度正規化【之後】的 softmax 溫度
   158	  every: 1           # 每 N 次 _route_update 施加一次
