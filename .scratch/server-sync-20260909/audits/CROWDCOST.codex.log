   146	def schedule_energy(
   147	    inventory: HardwareInventory,
   148	    slots: Iterable[tuple[float, Mapping[BeamIdentity, float]]],
   149	    *,
   150	    duration_s: float,
   151	    idle_power_w: float = PRIMARY_IDLE_POWER_W,
   152	    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
   153	) -> EnergyReceipt:
   154	    """Integrate a slot schedule, preserving nonlinear PA averaging."""
   155	
   156	    schedule = tuple(slots)
   157	    if any(not math.isfinite(fraction) or fraction < 0.0 for fraction, _ in schedule):
   158	        raise MCRLContractError("slot fractions must be finite and nonnegative")
   159	    if not math.isclose(math.fsum(fraction for fraction, _ in schedule), 1.0, rel_tol=0.0, abs_tol=1e-12):
   160	        raise MCRLContractError("slot fractions must sum to one")
   161	    receipts = [
   162	        interval_energy(
   163	            inventory,
   164	            EnergyInterval(duration_s * fraction, beam_rf),
   165	            idle_power_w=idle_power_w,
   166	            circuit_power_per_active_chain_w=circuit_power_per_active_chain_w,
   167	        )
   168	        for fraction, beam_rf in schedule
   169	    ]
   170	    result = EnergyReceipt(
   171	        *(math.fsum(getattr(receipt, field) for receipt in receipts) for field in (
   172	            "joules", "pa_j", "circuit_j", "standby_j", "baseband_j", "bus_j"
   173	        ))
   174	    )
   175	    result.verify()
   176	    return result
