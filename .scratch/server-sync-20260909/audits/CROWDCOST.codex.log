     1	"""Exact pooled-EE, reward-core, and service endpoint accounting."""
     2	
     3	from __future__ import annotations
     4	
     5	from dataclasses import dataclass
     6	from fractions import Fraction
     7	import math
     8	from typing import Iterable
     9	
    10	from mcrl.errors import MCRLContractError
    11	
    12	
    13	Number = int | float | str | Fraction
    14	
    15	
    16	def exact(value: Number) -> Fraction:
    17	    """Convert declared decimal inputs to rational values without float summing."""
    18	
    19	    if isinstance(value, bool):
    20	        raise MCRLContractError("Boolean is not an endpoint quantity")
    21	    if isinstance(value, Fraction):
    22	        return value
    23	    if isinstance(value, int):
    24	        return Fraction(value)
    25	    if isinstance(value, float):
    26	        if not math.isfinite(value):
    27	            raise MCRLContractError("endpoint quantities must be finite")
    28	        return Fraction(str(value))
    29	    return Fraction(value)
    30	
    31	
    32	@dataclass(frozen=True)
    33	class StepEndpoint:
    34	    bits: Fraction
    35	    joules: Fraction
    36	    decoding_user_seconds: Fraction
    37	    useful_user_seconds: Fraction
    38	    opportunity_user_seconds: Fraction
    39	    complete_service_user_steps: int
    40	    user_steps: int
    41	
    42	    @classmethod
    43	    def build(
    44	        cls,
    45	        *,
    46	        bits: Number,
    47	        joules: Number,
    48	        decoding_user_seconds: Number,
    49	        useful_user_seconds: Number,
    50	        opportunity_user_seconds: Number,
    51	        complete_service_user_steps: int,
    52	        user_steps: int,
    53	    ) -> "StepEndpoint":
    54	        result = cls(
    55	            exact(bits),
    56	            exact(joules),
    57	            exact(decoding_user_seconds),
    58	            exact(useful_user_seconds),
    59	            exact(opportunity_user_seconds),
    60	            int(complete_service_user_steps),
    61	            int(user_steps),
    62	        )
    63	        result.verify()
    64	        return result
    65	
    66	    def verify(self) -> None:
    67	        if self.bits < 0 or self.joules < 0:
    68	            raise MCRLContractError("bits and joules must be nonnegative")
    69	        if self.joules == 0 and self.bits > 0:
    70	            raise MCRLContractError("positive bits at zero energy is invalid")
    71	        if not 0 <= self.decoding_user_seconds <= self.opportunity_user_seconds:
    72	            raise MCRLContractError("decoding availability is outside its opportunity time")
    73	        if not 0 <= self.useful_user_seconds <= self.decoding_user_seconds:
    74	            raise MCRLContractError("useful time is outside decoding time")
    75	        if not 0 <= self.complete_service_user_steps <= self.user_steps:
    76	            raise MCRLContractError("complete-service count is outside user steps")
    77	
    78	
    79	@dataclass(frozen=True)
    80	class EndpointTotals:
    81	    bits: Fraction
    82	    joules: Fraction
    83	    pooled_ee: Fraction | None
    84	    decoding_availability: Fraction
    85	    useful_availability: Fraction
    86	    complete_service_user_steps: int
    87	    user_steps: int
    88	
    89	
    90	def pool(steps: Iterable[StepEndpoint]) -> EndpointTotals:
    91	    """Ratio of sums; all-dark is explicitly undefined rather than dropped."""
    92	
    93	    rows = tuple(steps)
    94	    for row in rows:
    95	        row.verify()
    96	    bits = sum((row.bits for row in rows), Fraction())
    97	    joules = sum((row.joules for row in rows), Fraction())
    98	    opportunity = sum((row.opportunity_user_seconds for row in rows), Fraction())
    99	    decoding = sum((row.decoding_user_seconds for row in rows), Fraction())
   100	    useful = sum((row.useful_user_seconds for row in rows), Fraction())
   101	    return EndpointTotals(
   102	        bits,
   103	        joules,
   104	        None if joules == 0 else bits / joules,
   105	        Fraction() if opportunity == 0 else decoding / opportunity,
   106	        Fraction() if opportunity == 0 else useful / opportunity,
   107	        sum(row.complete_service_user_steps for row in rows),
   108	        sum(row.user_steps for row in rows),
   109	    )
   110	
   111	
   112	def reward_core(
   113	    endpoint: StepEndpoint | EndpointTotals,
   114	    *,
   115	    eta_ref: Number,
   116	) -> Fraction:
   117	    """Return ``B - eta_ref*E`` for either one step or its pooled endpoint."""
   118	
   119	    if isinstance(endpoint, StepEndpoint):
   120	        endpoint.verify()
   121	    b, e, eta = endpoint.bits, endpoint.joules, exact(eta_ref)
   122	    if b < 0 or e < 0 or eta <= 0:
   123	        raise MCRLContractError("reward inputs require B,E>=0 and eta_ref>0")
   124	    return b - eta * e
   125	
   126	
   127	def assert_same_energy_price(
   128	    *,
   129	    lambda_bits_per_j: Number,
   130	    eta_ref: Number,
   131	) -> Fraction:
   132	    """Fail closed unless explicit target lambda and endpoint eta are identical."""
   133	
   134	    target_price = exact(lambda_bits_per_j)
   135	    endpoint_price = exact(eta_ref)
   136	    if target_price <= 0 or endpoint_price <= 0:
   137	        raise MCRLContractError("lambda and eta_ref must both be positive")
   138	    if target_price != endpoint_price:
   139	        raise MCRLContractError("target lambda and endpoint eta_ref do not match")
   140	    return endpoint_price
   141	
   142	
   143	def calibration(
   144	    bits: Number,
   145	    joules: Number,
   146	    *,
   147	    users: int,
   148	    decision_steps: int | None = None,
   149	    time_s: Number | None = None,
   150	) -> tuple[Fraction, Fraction]:
   151	    """Return ``(eta_ref, kappa)`` with κ measured in bits/user-step.
   152	
   153	    ``time_s`` is accepted only as a compatibility audit field.  It never
   154	    enters κ: changing the physical decision duration cannot change the
   155	    normalisation of one decision step.
   156	    """
   157	
   158	    b, e = exact(bits), exact(joules)
   159	    steps = 1 if decision_steps is None else decision_steps
   160	    if type(steps) is not int or b <= 0 or e <= 0 or users <= 0 or steps <= 0:
   161	        raise MCRLContractError("calibration totals, users, and decision steps must be positive")
   162	    if time_s is not None and exact(time_s) <= 0:
   163	        raise MCRLContractError("calibration audit duration must be positive")
   164	    return b / e, b / (users * steps)
   165	
