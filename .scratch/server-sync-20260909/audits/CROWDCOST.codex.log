   384	        # A monotone fixed-point sequence approaches the threshold from below.
   385	        # Preserve the established full-path endpoint by taking one final
   386	        # update, then move one negligible solver-scale step into the
   387	        # certified feasible half-space.
   388	        power = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   389	        power[forced] = caps[forced]
   390	        power = np.minimum(caps, np.nextafter(power * (1.0 + 2.0e-9), np.inf))
   391	        power[forced] = caps[forced]
   392	    return power, PowerCertificate(
   393	        status,
   394	        iteration,
   395	        residual,
   396	        config.solver_tolerance_w,
   397	        tuple(active_user_ids[index] for index in np.flatnonzero(power >= caps - config.solver_tolerance_w)),
   398	    )
