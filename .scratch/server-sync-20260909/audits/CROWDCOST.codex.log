@@ -0,0 +1,648 @@
+#!/usr/bin/env python3
+"""Measure crowding cost on the frozen V0.25 development-anchor prefix.
+
+DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM.  This imports the sealed source tree and
+interpreter read-only and writes only the local receipt.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import gc
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-crowd-ws")
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2suff-ws")
+PILOT_PATH = SOURCE_ROOT / "scripts/run_v025_pilot_c3.py"
+ENGINE_PATH = SOURCE_ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+OUTPUT = WORKSPACE / ".scratch/crowding-cost/crowding-cost-receipt.json"
+PARTIAL_OUTPUT = WORKSPACE / ".scratch/crowding-cost/crowding-cost-partial.json"
+OPTIONS_CACHE = WORKSPACE / ".scratch/crowding-cost/development-legal-options.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+CARRIERS = ("nearest-eligible", "stay-if-possible", "random-masked")
+QUANTILES = tuple(index / 10.0 for index in range(11))
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def assert_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS is not below 5 GB")
+
+
+def load_pilot():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    name = "crowding_cost_v025_pilot"
+    spec = importlib.util.spec_from_file_location(name, PILOT_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load V0.25 pilot adapter")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def maximum_matching(
+    options: Mapping[int, Sequence[tuple[int, int]]],
+    allowed_beams: Iterable[tuple[int, int]] | None = None,
+) -> dict[int, tuple[int, int]]:
+    """Deterministic maximum user-to-distinct-beam matching."""
+
+    allowed = None if allowed_beams is None else frozenset(allowed_beams)
+    beam_to_user: dict[tuple[int, int], int] = {}
+
+    def augment(user: int, seen: set[tuple[int, int]]) -> bool:
+        for beam in sorted(options[user]):
+            if (allowed is not None and beam not in allowed) or beam in seen:
+                continue
+            seen.add(beam)
+            incumbent = beam_to_user.get(beam)
+            if incumbent is None or augment(incumbent, seen):
+                beam_to_user[beam] = user
+                return True
+        return False
+
+    for user in sorted(options):
+        augment(user, set())
+    return {user: beam for beam, user in beam_to_user.items()}
+
+
+def greedy_cover(
+    users: frozenset[int], beam_users: Mapping[tuple[int, int], frozenset[int]]
+) -> tuple[tuple[int, int], ...]:
+    uncovered = set(users)
+    chosen: list[tuple[int, int]] = []
+    while uncovered:
+        beam = min(
+            beam_users,
+            key=lambda value: (-len(beam_users[value] & uncovered), value),
+        )
+        gain = beam_users[beam] & uncovered
+        if not gain:
+            raise RuntimeError("legal-option graph does not cover every user")
+        chosen.append(beam)
+        uncovered -= gain
+    return tuple(chosen)
+
+
+def minimum_cover(
+    options: Mapping[int, Sequence[tuple[int, int]]]
+) -> tuple[tuple[int, int], ...]:
+    """Exact minimum set cover using dominated-set pruning and integer bitsets."""
+
+    users = tuple(sorted(user for user, rows in options.items() if rows))
+    user_index = {user: index for index, user in enumerate(users)}
+    by_beam: dict[tuple[int, int], int] = {}
+    for user in users:
+        bit = 1 << user_index[user]
+        for beam in options[user]:
+            by_beam[beam] = by_beam.get(beam, 0) | bit
+
+    # Equal and strict-subset coverage sets never improve minimum cardinality.
+    # Keep one deterministic beam for each coverage mask, then only maximal masks.
+    mask_to_beam: dict[int, tuple[int, int]] = {}
+    for beam, mask in sorted(by_beam.items()):
+        mask_to_beam.setdefault(mask, beam)
+    unique = sorted(mask_to_beam.items(), key=lambda item: (-item[0].bit_count(), item[1]))
+    maximal: list[tuple[int, tuple[int, int]]] = []
+    for mask, beam in unique:
+        if any(mask | kept_mask == kept_mask for kept_mask, _ in maximal):
+            continue
+        maximal.append((mask, beam))
+    masks = tuple(mask for mask, _ in maximal)
+    beams = tuple(beam for _, beam in maximal)
+    universe = (1 << len(users)) - 1
+
+    beam_users = {
+        beam: frozenset(user for user in users if mask & (1 << user_index[user]))
+        for mask, beam in maximal
+    }
+    greedy = greedy_cover(frozenset(users), beam_users)
+
+    # Candidate indices for each user bit. Search only the smallest branching pivot.
+    candidates_by_bit = {
+        bit: tuple(index for index, mask in enumerate(masks) if mask & bit)
+        for bit in (1 << index for index in range(len(users)))
+    }
+
+    def solve(limit: int) -> tuple[int, ...] | None:
+        failed: set[tuple[int, int]] = set()
+
+        def search(uncovered: int, remaining: int) -> tuple[int, ...] | None:
+            if uncovered == 0:
+                return ()
+            if remaining == 0 or (uncovered, remaining) in failed:
+                return None
+            gains = tuple((mask & uncovered).bit_count() for mask in masks)
+            max_gain = max(gains, default=0)
+            if max_gain == 0 or math.ceil(uncovered.bit_count() / max_gain) > remaining:
+                failed.add((uncovered, remaining))
+                return None
+            uncovered_bits = tuple(
+                1 << index for index in range(len(users)) if uncovered & (1 << index)
+            )
+            pivot = min(
+                uncovered_bits,
+                key=lambda bit: (
+                    sum(gains[index] > 0 for index in candidates_by_bit[bit]), bit,
+                ),
+            )
+            candidates = sorted(
+                (index for index in candidates_by_bit[pivot] if gains[index] > 0),
+                key=lambda index: (-gains[index], beams[index]),
+            )
+            for index in candidates:
+                suffix = search(uncovered & ~masks[index], remaining - 1)
+                if suffix is not None:
+                    return (index, *suffix)
+            failed.add((uncovered, remaining))
+            return None
+
+        return search(universe, limit)
+
+    solution: tuple[int, ...] | None = None
+    for limit in range(1, len(greedy) + 1):
+        solution = solve(limit)
+        if solution is not None:
+            break
+    if solution is None:
+        raise RuntimeError("exact set-cover search failed despite a greedy upper bound")
+    best = tuple(sorted(beams[index] for index in solution))
+    # Minimal covers have a private witness per beam, hence are matchable.
+    if len(maximum_matching(options, best)) != len(best):
+        raise RuntimeError("minimum cover lacks a distinct witness for every beam")
+    return best
+
+
+def nested_beam_sets(
+    options: Mapping[int, Sequence[tuple[int, int]]]
+) -> list[tuple[tuple[int, int], ...]]:
+    """31 graded independent supersets from exact min cover to exact matching rank."""
+
+    phase_started = time.perf_counter()
+    minimum = minimum_cover(options)
+    maximum_rank = len(maximum_matching(options))
+    all_beams = tuple(sorted({beam for rows in options.values() for beam in rows}))
+    print(
+        f"  endpoint cover={len(minimum)} matching-rank={maximum_rank} "
+        f"beams={len(all_beams)} solve_s={time.perf_counter()-phase_started:.3f}",
+        flush=True,
+    )
+    selected = set(minimum)
+    beam_users = {
+        beam: tuple(sorted(user for user, rows in options.items() if beam in rows))
+        for beam in all_beams
+    }
+    beam_to_user: dict[tuple[int, int], int] = {}
+    user_to_beam: dict[int, tuple[int, int]] = {}
+
+    def augment(start: tuple[int, int]) -> bool:
+        seen_users: set[int] = set()
+
+        def visit(beam: tuple[int, int]) -> bool:
+            for user in beam_users[beam]:
+                if user in seen_users:
+                    continue
+                seen_users.add(user)
+                incumbent = user_to_beam.get(user)
+                if incumbent is None or visit(incumbent):
+                    beam_to_user[beam] = user
+                    user_to_beam[user] = beam
+                    return True
+            return False
+
+        return visit(start)
+
+    for beam in sorted(minimum):
+        if not augment(beam):
+            raise RuntimeError("minimum cover is unexpectedly not beam-matchable")
+
+    sample_count = min(31, maximum_rank - len(minimum) + 1)
+    targets = sorted({
+        round(len(minimum) + index * (maximum_rank - len(minimum)) / (sample_count - 1))
+        for index in range(sample_count)
+    }) if sample_count > 1 else [len(minimum)]
+    result_by_size = {len(selected): tuple(sorted(selected))}
+    coverage = {beam: len(beam_users[beam]) for beam in all_beams}
+    for beam in sorted(all_beams, key=lambda value: (coverage[value], value)):
+        if beam in selected:
+            continue
+        if augment(beam):
+            selected.add(beam)
+            if len(selected) in targets:
+                result_by_size[len(selected)] = tuple(sorted(selected))
+            if len(selected) == maximum_rank:
+                break
+    if len(selected) != maximum_rank:
+        raise RuntimeError("transversal-matroid basis extension did not reach maximum rank")
+    if maximum_rank not in result_by_size:
+        result_by_size[maximum_rank] = tuple(sorted(selected))
+    return [result_by_size[size] for size in targets]
+
+
+def assignment_for_beams(
+    options: Mapping[int, Sequence[tuple[int, int]]],
+    beams: Sequence[tuple[int, int]],
+) -> dict[int, tuple[int, int] | None]:
+    """Use every selected beam once, then crowd remaining users coverage-first."""
+
+    selected = frozenset(beams)
+    matched = maximum_matching(options, selected)
+    if len(matched) != len(selected):
+        raise RuntimeError("selected beam set cannot be fully activated")
+    coverage = {
+        beam: sum(beam in options[user] for user in options)
+        for beam in selected
+    }
+    mapping: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(options):
+        if not options[user]:
+            mapping[user] = None
+        elif user in matched:
+            mapping[user] = matched[user]
+        else:
+            choices = [beam for beam in options[user] if beam in selected]
+            if not choices:
+                raise RuntimeError("selected cover omitted a legal user")
+            mapping[user] = min(choices, key=lambda beam: (-coverage[beam], beam))
+    return mapping
+
+
+def concentration(mapping: Mapping[int, tuple[int, int] | None]) -> dict[str, object]:
+    counts = Counter(identity for identity in mapping.values() if identity is not None)
+    assigned = sum(counts.values())
+    return {
+        "assigned": assigned,
+        "active": len(counts),
+        "modal_count": max(counts.values(), default=0),
+        "modal_frac": 0.0 if assigned == 0 else max(counts.values()) / assigned,
+        "occupancies": sorted(counts.values(), reverse=True),
+    }
+
+
+def profile_row(profile, mapping) -> dict[str, object]:
+    metrics = concentration(mapping)
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        **metrics,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served": served,
+        "pa_j": profile.energy_components["pa_j"],
+        "circuit_j": profile.energy_components["circuit_j"],
+        "baseband_j": profile.energy_components["baseband_j"],
+        "standby_j": profile.energy_components["standby_j"],
+        "bus_j": profile.energy_components["bus_j"],
+        "mean_radiating_beams": profile.lit_beam_seconds / 30.08,
+        "mean_active_satellites": profile.lit_satellite_seconds / 30.08,
+        "rf_cap_hits": profile.rf_cap_hits,
+        "rf_transmission_observations": profile.rf_transmission_observations,
+        "max_rf_power_w": profile.required_power_w_max,
+    }
+
+
+def pool(rows: Sequence[Mapping[str, object]], label: str, quantile: float) -> dict[str, object]:
+    bits = math.fsum(float(row["bits"]) for row in rows)
+    joules = math.fsum(float(row["joules"]) for row in rows)
+    assigned = sum(int(row["assigned"]) for row in rows)
+    modal = sum(int(row["modal_count"]) for row in rows)
+    active = sum(int(row["active"]) for row in rows)
+    pa = math.fsum(float(row["pa_j"]) for row in rows)
+    return {
+        "label": label,
+        "concentration_quantile": quantile,
+        "modal_frac": modal / assigned,
+        "active_beam_anchor_total": active,
+        "active_mean_per_anchor": active / len(rows),
+        "active_range": [min(int(row["active"]) for row in rows), max(int(row["active"]) for row in rows)],
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served": sum(int(row["served"]) for row in rows),
+        "assigned": assigned,
+        "pa_j": pa,
+        "pa_share": pa / joules,
+        "circuit_j": math.fsum(float(row["circuit_j"]) for row in rows),
+        "baseband_j": math.fsum(float(row["baseband_j"]) for row in rows),
+        "rf_cap_hits": sum(int(row["rf_cap_hits"]) for row in rows),
+        "rf_transmission_observations": sum(int(row["rf_transmission_observations"]) for row in rows),
+        "max_rf_power_w": max(float(row["max_rf_power_w"]) for row in rows),
+    }
+
+
+def controlled_groups(options: Mapping[int, Sequence[tuple[int, int]]]) -> tuple[tuple[int, int], list[tuple[int, tuple[int, int]]]]:
+    """Find one common beam and maximum distinct non-common private matching."""
+
+    beams = sorted({beam for rows in options.values() for beam in rows})
+    candidates = []
+    for common in beams:
+        eligible_users = {
+            user: tuple(beam for beam in options[user] if beam != common)
+            for user in options
+            if common in options[user]
+        }
+        eligible_users = {user: rows for user, rows in eligible_users.items() if rows}
+        matched = maximum_matching(eligible_users)
+        pairs = sorted(matched.items())
+        candidates.append((len(pairs), common, pairs))
+    count, common, pairs = min(candidates, key=lambda row: (-row[0], row[1]))
+    if count < 2:
+        raise RuntimeError("anchor has no legal shared/private two-user comparator")
+    return common, pairs
+
+
+def main() -> int:
+    assert_runtime()
+    started = time.perf_counter()
+    pilot = load_pilot()
+    runner = pilot.ENGINE
+    run_setting = runner.run_setting_for("a-r0")
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33,
+        start_time_s=0.0,
+    )
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("tape construction exceeded RSS cap")
+
+    options_by_step: dict[int, tuple[Mapping[int, Sequence[tuple[int, int]]], object]] = {}
+    options_payload: dict[str, object] = {}
+    for step_index in range(4):
+        options, census = runner._legal_options(tape, step_index)
+        options_by_step[step_index] = (options, census)
+        options_payload[str(step_index)] = {
+            "census": census,
+            "options": {
+                str(user): [list(beam) for beam in rows]
+                for user, rows in options.items()
+            },
+        }
+    OPTIONS_CACHE.write_text(
+        json.dumps(options_payload, sort_keys=True, separators=(",", ":")) + "\n",
+        encoding="utf-8",
+    )
+    print(f"cached development legal graphs at {OPTIONS_CACHE}", flush=True)
+
+    anchors: list[dict[str, object]] = []
+    base_rows: list[dict[str, object]] = []
+    by_quantile: dict[float, list[dict[str, object]]] = {q: [] for q in QUANTILES}
+    controlled: list[dict[str, object]] = []
+    panel = [(step, carrier) for step in range(4) for carrier in CARRIERS]
+    beam_sets_by_step: dict[int, list[tuple[tuple[int, int], ...]]] = {}
+
+    for position, (step_index, carrier) in enumerate(panel, 1):
+        print(f"anchor {position}/{len(panel)} start step={step_index} carrier={carrier}", flush=True)
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        options, census = options_by_step[step_index]
+        if step_index not in beam_sets_by_step:
+            beam_sets_by_step[step_index] = nested_beam_sets(options)
+        beam_sets = beam_sets_by_step[step_index]
+        configs = []
+        mappings = []
+        for beams in beam_sets:
+            mapping = assignment_for_beams(options, beams)
+            configs.append(runner._configuration(base, mapping, kind="crowding-cost-ladder"))
+            mappings.append(mapping)
+        evaluator = runner.StepEvaluator(
+            tape, runner._setting("a-r0"), step_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+            field="realised", run_setting=run_setting,
+            boundary_indices=tuple(range(48)),
+        )
+        evaluator.evaluate_many([base, *configs])
+        base_profile = evaluator.evaluate(base)
+        base_row = profile_row(base_profile, base.mapping)
+        base_guard = int(base_row["served"])
+        base_rows.append(base_row)
+        ladder: list[dict[str, object]] = []
+        for config, mapping in zip(configs, mappings, strict=True):
+            if config.configuration_id in evaluator._invalid:
+                continue
+            row = profile_row(evaluator.evaluate(config), mapping)
+            row["passes_base_served_guard"] = int(row["served"]) >= base_guard
+            if row["passes_base_served_guard"]:
+                ladder.append(row)
+        if not ladder:
+            raise RuntimeError(f"no served-guard ladder member at anchor {position}")
+        ladder.sort(key=lambda row: int(row["active"]))
+        for left, right in zip(ladder, ladder[1:]):
+            if int(right["active"]) <= int(left["active"]):
+                raise RuntimeError("graded active-beam samples are not strictly increasing")
+        for quantile in QUANTILES:
+            target = int(round((1.0 - quantile) * (len(ladder) - 1)))
+            # q=1 is the most crowded endpoint; q=0 is the most spread endpoint.
+            by_quantile[quantile].append(dict(ladder[target]))
+
+        anchor_row: dict[str, object] = {
+            "anchor_index": position - 1,
+            "anchor_id": f"{tape.domain}|{step_index}|{carrier}",
+            "step_index": step_index,
+            "carrier": carrier,
+            "legal_option_census": census,
+            "base": base_row,
+            "base_served_guard": base_guard,
+            "mask_minimum_active": len(beam_sets[0]),
+            "mask_maximum_active": len(beam_sets[-1]),
+            "guarded_minimum_active": int(ladder[0]["active"]),
+            "guarded_maximum_active": int(ladder[-1]["active"]),
+            "ladder": ladder,
+        }
+
+        if position == 1:
+            common, private_pairs = controlled_groups(options)
+            max_n = min(16, len(private_pairs))
+            for n in (2, 4, 8, 16):
+                if n > max_n:
+                    continue
+                chosen = private_pairs[:n]
+                shared_mapping = {user: None for user in options}
+                spread_mapping = dict(shared_mapping)
+                for user, private in chosen:
+                    shared_mapping[user] = common
+                    spread_mapping[user] = private
+                shared_config = runner._configuration(base, shared_mapping, kind="controlled-shared")
+                spread_config = runner._configuration(base, spread_mapping, kind="controlled-spread")
+                evaluator.evaluate_many((shared_config, spread_config))
+                if shared_config.configuration_id in evaluator._invalid or spread_config.configuration_id in evaluator._invalid:
+                    raise RuntimeError("controlled configuration was physically invalid")
+                shared_row = profile_row(evaluator.evaluate(shared_config), shared_mapping)
+                spread_row = profile_row(evaluator.evaluate(spread_config), spread_mapping)
+                controlled.append({
+                    "n": n,
+                    "anchor_id": anchor_row["anchor_id"],
+                    "common_beam": list(common),
+                    "users_and_private_beams": [[user, list(private)] for user, private in chosen],
+                    "shared": shared_row,
+                    "spread": spread_row,
+                    "all_focal_served": (
+                        int(shared_row["served"]) == n and int(spread_row["served"]) == n
+                    ),
+                    "delta_spread_minus_shared": {
+                        "bits": float(spread_row["bits"]) - float(shared_row["bits"]),
+                        "joules": float(spread_row["joules"]) - float(shared_row["joules"]),
+                        "ee_bits_per_j": float(spread_row["ee_bits_per_j"]) - float(shared_row["ee_bits_per_j"]),
+                        "ee_fraction": float(spread_row["ee_bits_per_j"]) / float(shared_row["ee_bits_per_j"]) - 1.0,
+                    },
+                })
+            anchor_row["controlled_group_capacity"] = len(private_pairs)
+        anchors.append(anchor_row)
+        PARTIAL_OUTPUT.write_text(json.dumps({
+            "status": "PARTIAL",
+            "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
+            "completed_anchors": len(anchors),
+            "peak_rss_bytes": peak_rss_bytes(),
+            "anchors": anchors,
+            "controlled": controlled,
+        }, sort_keys=True, indent=2, allow_nan=False) + "\n", encoding="utf-8")
+        del evaluator, configs, mappings
+        gc.collect()
+        if peak_rss_bytes() >= MAX_RSS_BYTES:
+            raise MemoryError("anchor evaluation exceeded RSS cap")
+        print(
+            f"anchor {position}/{len(panel)} complete peak RSS {peak_rss_bytes()/2**30:.3f} GiB "
+            f"active={ladder[0]['active']}..{ladder[-1]['active']} guard={base_guard}",
+            flush=True,
+        )
+
+    pooled = [
+        pool(by_quantile[q], f"Q{int(q*100):03d}", q)
+        for q in QUANTILES
+    ]
+    # Order the reported curve from crowded to spread (increasing active).
+    pooled.sort(key=lambda row: float(row["active_mean_per_anchor"]))
+    adjacent = []
+    for left, right in zip(pooled, pooled[1:]):
+        delta_active = float(right["active_mean_per_anchor"]) - float(left["active_mean_per_anchor"])
+        delta_ee = float(right["ee_bits_per_j"]) - float(left["ee_bits_per_j"])
+        adjacent.append({
+            "active_left": left["active_mean_per_anchor"],
+            "active_right": right["active_mean_per_anchor"],
+            "slope_bits_per_j_per_active_beam": delta_ee / delta_active,
+            "fractional_slope_per_beam_at_left": delta_ee / delta_active / float(left["ee_bits_per_j"]),
+        })
+    crowded, spread = pooled[0], pooled[-1]
+    active_span = float(spread["active_mean_per_anchor"]) - float(crowded["active_mean_per_anchor"])
+    secant = (
+        float(spread["ee_bits_per_j"]) - float(crowded["ee_bits_per_j"])
+    ) / active_span
+    base_pooled = pool(base_rows, "GEOMETRIC_BASE", math.nan)
+    base_pooled.pop("concentration_quantile")
+    all_family = [row for rows in by_quantile.values() for row in rows]
+    receipt: dict[str, object] = {
+        "schema": "mcrl-v025-crowding-cost-design-measurement-v1",
+        "status": "COMPLETE",
+        "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
+        "panel": {
+            "domain": tape.domain,
+            "world_tape_digest": tape.digest,
+            "anchors": 12,
+            "rule": "steps 0..3 x nearest-eligible, stay-if-possible, random-masked",
+            "evaluation_boundaries": list(range(48)),
+            "numerator": "saturated full-buffer decoded information bits; no demand cap",
+        },
+        "construction_rule": (
+            "exact minimum legal-beam set cover; add beams one at a time while preserving a "
+            "beam-saturating matching until the exact maximum matching rank; activate each beam "
+            "with a distinct witness, then map remaining users to the selected legal beam with "
+            "largest panel-anchor coverage; retain only rows meeting the carrier-BASE PHY-served guard"
+        ),
+        "source": {
+            "root": str(SOURCE_ROOT),
+            "pilot": str(PILOT_PATH),
+            "pilot_sha256": sha256(PILOT_PATH),
+            "engine": str(ENGINE_PATH),
+            "engine_sha256": sha256(ENGINE_PATH),
+            "batch_sha256": sha256(SOURCE_ROOT / "src/mcrl/physics_v025/batch.py"),
+            "energy_sha256": sha256(SOURCE_ROOT / "src/mcrl/physics_v025/energy.py"),
+            "targets_sha256": sha256(SOURCE_ROOT / "src/mcrl/physics_v025/targets.py"),
+        },
+        "runtime": {
+            "python": sys.executable,
+            "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+            "processes": 1,
+            "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+            "peak_rss_bytes": peak_rss_bytes(),
+            "wall_seconds": time.perf_counter() - started,
+        },
+        "geometric_base_pooled": base_pooled,
+        "family_pooled": pooled,
+        "adjacent_slopes": adjacent,
+        "secant": {
+            "active_mean_range": [crowded["active_mean_per_anchor"], spread["active_mean_per_anchor"]],
+            "slope_bits_per_j_per_active_beam": secant,
+            "fractional_slope_per_beam_at_crowded_endpoint": secant / float(crowded["ee_bits_per_j"]),
+            "endpoint_ee_fraction_spread_minus_crowded": float(spread["ee_bits_per_j"]) / float(crowded["ee_bits_per_j"]) - 1.0,
+        },
+        "operating_range": {
+            "max_rf_power_w": max(float(row["max_rf_power_w"]) for row in all_family),
+            "rf_cap_hits": sum(int(row["rf_cap_hits"]) for row in all_family),
+            "rf_transmission_observations": sum(int(row["rf_transmission_observations"]) for row in all_family),
+            "pa_share_range_over_pooled_family": [
+                min(float(row["pa_share"]) for row in pooled),
+                max(float(row["pa_share"]) for row in pooled),
+            ],
+        },
+        "controlled": controlled,
+        "anchors": anchors,
+    }
+    receipt["receipt_sha256"] = canonical_digest(receipt)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    OUTPUT.write_text(json.dumps(receipt, sort_keys=True, indent=2, allow_nan=False) + "\n", encoding="utf-8")
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(json.dumps({"secant": receipt["secant"], "controlled": controlled}, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.scratch/crowding-cost/spec.md b/.scratch/crowding-cost/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..f6547d1cd4fb16b50e628509759ce0c400e22727
--- /dev/null
+++ b/.scratch/crowding-cost/spec.md
@@ -0,0 +1,21 @@
+# CROWDCOST measurement criterion
+
+DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM.
+
+The run is complete when one deterministic, single-process harness:
+
+1. regenerates only the frozen 12-anchor development prefix
+   `V025_PROBE/world/1` (steps 0--3 x three carriers);
+2. constructs, at every anchor, an exact mask-minimum beam cover and an exact
+   mask-maximum distinct-beam matching, plus every integer active-beam level
+   between them;
+3. rejects any family row serving fewer PHY users than that anchor's geometric
+   carrier BASE;
+4. evaluates full-buffer decoded bits and partial-payload joules through the
+   production dense `a-r0`/48-boundary path;
+5. runs isolated shared-versus-private experiments for 2, 4, 8, and 16 legal
+   users where the anchor masks permit; and
+6. writes a hash-bound JSON receipt, prints `anchor k/12` progress and peak RSS,
+   and fails unless niceness, interpreter, single-thread pins, and RSS < 5 GB
+   hold.
+

diff --git a/.scratch/crowding-cost/run_crowding_cost.py b/.scratch/crowding-cost/run_crowding_cost.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c041a82864e0f88393f708c2fc60d5d032df10b
--- /dev/null
+++ b/.scratch/crowding-cost/run_crowding_cost.py
@@ -0,0 +1,648 @@
+#!/usr/bin/env python3
+"""Measure crowding cost on the frozen V0.25 development-anchor prefix.
+
+DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM.  This imports the sealed source tree and
+interpreter read-only and writes only the local receipt.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import gc
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-crowd-ws")
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2suff-ws")
+PILOT_PATH = SOURCE_ROOT / "scripts/run_v025_pilot_c3.py"
+ENGINE_PATH = SOURCE_ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+OUTPUT = WORKSPACE / ".scratch/crowding-cost/crowding-cost-receipt.json"
+PARTIAL_OUTPUT = WORKSPACE / ".scratch/crowding-cost/crowding-cost-partial.json"
+OPTIONS_CACHE = WORKSPACE / ".scratch/crowding-cost/development-legal-options.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+CARRIERS = ("nearest-eligible", "stay-if-possible", "random-masked")
+QUANTILES = tuple(index / 10.0 for index in range(11))
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def assert_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS is not below 5 GB")
+
+
+def load_pilot():
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    name = "crowding_cost_v025_pilot"
+    spec = importlib.util.spec_from_file_location(name, PILOT_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load V0.25 pilot adapter")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def maximum_matching(
+    options: Mapping[int, Sequence[tuple[int, int]]],
+    allowed_beams: Iterable[tuple[int, int]] | None = None,
+) -> dict[int, tuple[int, int]]:
+    """Deterministic maximum user-to-distinct-beam matching."""
+
+    allowed = None if allowed_beams is None else frozenset(allowed_beams)
+    beam_to_user: dict[tuple[int, int], int] = {}
+
+    def augment(user: int, seen: set[tuple[int, int]]) -> bool:
+        for beam in sorted(options[user]):
+            if (allowed is not None and beam not in allowed) or beam in seen:
+                continue
+            seen.add(beam)
+            incumbent = beam_to_user.get(beam)
+            if incumbent is None or augment(incumbent, seen):
+                beam_to_user[beam] = user
+                return True
+        return False
+
+    for user in sorted(options):
+        augment(user, set())
+    return {user: beam for beam, user in beam_to_user.items()}
+
+
+def greedy_cover(
+    users: frozenset[int], beam_users: Mapping[tuple[int, int], frozenset[int]]
+) -> tuple[tuple[int, int], ...]:
+    uncovered = set(users)
+    chosen: list[tuple[int, int]] = []
+    while uncovered:
+        beam = min(
+            beam_users,
+            key=lambda value: (-len(beam_users[value] & uncovered), value),
+        )
+        gain = beam_users[beam] & uncovered
+        if not gain:
+            raise RuntimeError("legal-option graph does not cover every user")
+        chosen.append(beam)
+        uncovered -= gain
+    return tuple(chosen)
+
+
+def minimum_cover(
+    options: Mapping[int, Sequence[tuple[int, int]]]
+) -> tuple[tuple[int, int], ...]:
+    """Exact minimum set cover using dominated-set pruning and integer bitsets."""
+
+    users = tuple(sorted(user for user, rows in options.items() if rows))
+    user_index = {user: index for index, user in enumerate(users)}
+    by_beam: dict[tuple[int, int], int] = {}
+    for user in users:
+        bit = 1 << user_index[user]
+        for beam in options[user]:
+            by_beam[beam] = by_beam.get(beam, 0) | bit
+
+    # Equal and strict-subset coverage sets never improve minimum cardinality.
+    # Keep one deterministic beam for each coverage mask, then only maximal masks.
+    mask_to_beam: dict[int, tuple[int, int]] = {}
+    for beam, mask in sorted(by_beam.items()):
+        mask_to_beam.setdefault(mask, beam)
+    unique = sorted(mask_to_beam.items(), key=lambda item: (-item[0].bit_count(), item[1]))
+    maximal: list[tuple[int, tuple[int, int]]] = []
+    for mask, beam in unique:
+        if any(mask | kept_mask == kept_mask for kept_mask, _ in maximal):
+            continue
+        maximal.append((mask, beam))
+    masks = tuple(mask for mask, _ in maximal)
+    beams = tuple(beam for _, beam in maximal)
+    universe = (1 << len(users)) - 1
+
+    beam_users = {
+        beam: frozenset(user for user in users if mask & (1 << user_index[user]))
+        for mask, beam in maximal
+    }
+    greedy = greedy_cover(frozenset(users), beam_users)
+
+    # Candidate indices for each user bit. Search only the smallest branching pivot.
+    candidates_by_bit = {
+        bit: tuple(index for index, mask in enumerate(masks) if mask & bit)
+        for bit in (1 << index for index in range(len(users)))
+    }
+
+    def solve(limit: int) -> tuple[int, ...] | None:
+        failed: set[tuple[int, int]] = set()
+
+        def search(uncovered: int, remaining: int) -> tuple[int, ...] | None:
+            if uncovered == 0:
+                return ()
+            if remaining == 0 or (uncovered, remaining) in failed:
+                return None
+            gains = tuple((mask & uncovered).bit_count() for mask in masks)
+            max_gain = max(gains, default=0)
+            if max_gain == 0 or math.ceil(uncovered.bit_count() / max_gain) > remaining:
+                failed.add((uncovered, remaining))
+                return None
+            uncovered_bits = tuple(
+                1 << index for index in range(len(users)) if uncovered & (1 << index)
+            )
+            pivot = min(
+                uncovered_bits,
+                key=lambda bit: (
+                    sum(gains[index] > 0 for index in candidates_by_bit[bit]), bit,
+                ),
+            )
+            candidates = sorted(
+                (index for index in candidates_by_bit[pivot] if gains[index] > 0),
+                key=lambda index: (-gains[index], beams[index]),
+            )
+            for index in candidates:
+                suffix = search(uncovered & ~masks[index], remaining - 1)
+                if suffix is not None:
+                    return (index, *suffix)
+            failed.add((uncovered, remaining))
+            return None
+
+        return search(universe, limit)
+
+    solution: tuple[int, ...] | None = None
+    for limit in range(1, len(greedy) + 1):
+        solution = solve(limit)
+        if solution is not None:
+            break
+    if solution is None:
+        raise RuntimeError("exact set-cover search failed despite a greedy upper bound")
+    best = tuple(sorted(beams[index] for index in solution))
+    # Minimal covers have a private witness per beam, hence are matchable.
+    if len(maximum_matching(options, best)) != len(best):
+        raise RuntimeError("minimum cover lacks a distinct witness for every beam")
+    return best
+
+
+def nested_beam_sets(
+    options: Mapping[int, Sequence[tuple[int, int]]]
+) -> list[tuple[tuple[int, int], ...]]:
+    """31 graded independent supersets from exact min cover to exact matching rank."""
+
+    phase_started = time.perf_counter()
+    minimum = minimum_cover(options)
+    maximum_rank = len(maximum_matching(options))
+    all_beams = tuple(sorted({beam for rows in options.values() for beam in rows}))
+    print(
+        f"  endpoint cover={len(minimum)} matching-rank={maximum_rank} "
+        f"beams={len(all_beams)} solve_s={time.perf_counter()-phase_started:.3f}",
+        flush=True,
+    )
+    selected = set(minimum)
+    beam_users = {
+        beam: tuple(sorted(user for user, rows in options.items() if beam in rows))
+        for beam in all_beams
+    }
+    beam_to_user: dict[tuple[int, int], int] = {}
+    user_to_beam: dict[int, tuple[int, int]] = {}
+
+    def augment(start: tuple[int, int]) -> bool:
+        seen_users: set[int] = set()
+
+        def visit(beam: tuple[int, int]) -> bool:
+            for user in beam_users[beam]:
+                if user in seen_users:
+                    continue
+                seen_users.add(user)
+                incumbent = user_to_beam.get(user)
+                if incumbent is None or visit(incumbent):
+                    beam_to_user[beam] = user
+                    user_to_beam[user] = beam
+                    return True
+            return False
+
+        return visit(start)
+
+    for beam in sorted(minimum):
+        if not augment(beam):
+            raise RuntimeError("minimum cover is unexpectedly not beam-matchable")
+
+    sample_count = min(31, maximum_rank - len(minimum) + 1)
+    targets = sorted({
+        round(len(minimum) + index * (maximum_rank - len(minimum)) / (sample_count - 1))
+        for index in range(sample_count)
+    }) if sample_count > 1 else [len(minimum)]
+    result_by_size = {len(selected): tuple(sorted(selected))}
+    coverage = {beam: len(beam_users[beam]) for beam in all_beams}
+    for beam in sorted(all_beams, key=lambda value: (coverage[value], value)):
+        if beam in selected:
+            continue
+        if augment(beam):
+            selected.add(beam)
+            if len(selected) in targets:
+                result_by_size[len(selected)] = tuple(sorted(selected))
+            if len(selected) == maximum_rank:
+                break
+    if len(selected) != maximum_rank:
+        raise RuntimeError("transversal-matroid basis extension did not reach maximum rank")
+    if maximum_rank not in result_by_size:
+        result_by_size[maximum_rank] = tuple(sorted(selected))
+    return [result_by_size[size] for size in targets]
+
+
+def assignment_for_beams(
+    options: Mapping[int, Sequence[tuple[int, int]]],
+    beams: Sequence[tuple[int, int]],
+) -> dict[int, tuple[int, int] | None]:
+    """Use every selected beam once, then crowd remaining users coverage-first."""
+
+    selected = frozenset(beams)
+    matched = maximum_matching(options, selected)
+    if len(matched) != len(selected):
+        raise RuntimeError("selected beam set cannot be fully activated")
+    coverage = {
+        beam: sum(beam in options[user] for user in options)
+        for beam in selected
+    }
+    mapping: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(options):
+        if not options[user]:
+            mapping[user] = None
+        elif user in matched:
+            mapping[user] = matched[user]
+        else:
+            choices = [beam for beam in options[user] if beam in selected]
+            if not choices:
+                raise RuntimeError("selected cover omitted a legal user")
+            mapping[user] = min(choices, key=lambda beam: (-coverage[beam], beam))
+    return mapping
+
+
+def concentration(mapping: Mapping[int, tuple[int, int] | None]) -> dict[str, object]:
+    counts = Counter(identity for identity in mapping.values() if identity is not None)
+    assigned = sum(counts.values())
+    return {
+        "assigned": assigned,
+        "active": len(counts),
+        "modal_count": max(counts.values(), default=0),
+        "modal_frac": 0.0 if assigned == 0 else max(counts.values()) / assigned,
+        "occupancies": sorted(counts.values(), reverse=True),
+    }
+
+
+def profile_row(profile, mapping) -> dict[str, object]:
+    metrics = concentration(mapping)
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        **metrics,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served": served,
+        "pa_j": profile.energy_components["pa_j"],
+        "circuit_j": profile.energy_components["circuit_j"],
+        "baseband_j": profile.energy_components["baseband_j"],
+        "standby_j": profile.energy_components["standby_j"],
+        "bus_j": profile.energy_components["bus_j"],
+        "mean_radiating_beams": profile.lit_beam_seconds / 30.08,
+        "mean_active_satellites": profile.lit_satellite_seconds / 30.08,
+        "rf_cap_hits": profile.rf_cap_hits,
+        "rf_transmission_observations": profile.rf_transmission_observations,
+        "max_rf_power_w": profile.required_power_w_max,
+    }
+
+
+def pool(rows: Sequence[Mapping[str, object]], label: str, quantile: float) -> dict[str, object]:
+    bits = math.fsum(float(row["bits"]) for row in rows)
+    joules = math.fsum(float(row["joules"]) for row in rows)
+    assigned = sum(int(row["assigned"]) for row in rows)
+    modal = sum(int(row["modal_count"]) for row in rows)
+    active = sum(int(row["active"]) for row in rows)
+    pa = math.fsum(float(row["pa_j"]) for row in rows)
+    return {
+        "label": label,
+        "concentration_quantile": quantile,
+        "modal_frac": modal / assigned,
+        "active_beam_anchor_total": active,
+        "active_mean_per_anchor": active / len(rows),
+        "active_range": [min(int(row["active"]) for row in rows), max(int(row["active"]) for row in rows)],
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served": sum(int(row["served"]) for row in rows),
+        "assigned": assigned,
+        "pa_j": pa,
+        "pa_share": pa / joules,
+        "circuit_j": math.fsum(float(row["circuit_j"]) for row in rows),
+        "baseband_j": math.fsum(float(row["baseband_j"]) for row in rows),
+        "rf_cap_hits": sum(int(row["rf_cap_hits"]) for row in rows),
+        "rf_transmission_observations": sum(int(row["rf_transmission_observations"]) for row in rows),
+        "max_rf_power_w": max(float(row["max_rf_power_w"]) for row in rows),
+    }
+
+
+def controlled_groups(options: Mapping[int, Sequence[tuple[int, int]]]) -> tuple[tuple[int, int], list[tuple[int, tuple[int, int]]]]:
+    """Find one common beam and maximum distinct non-common private matching."""
+
+    beams = sorted({beam for rows in options.values() for beam in rows})
+    candidates = []
+    for common in beams:
+        eligible_users = {
+            user: tuple(beam for beam in options[user] if beam != common)
+            for user in options
+            if common in options[user]
+        }
+        eligible_users = {user: rows for user, rows in eligible_users.items() if rows}
+        matched = maximum_matching(eligible_users)
+        pairs = sorted(matched.items())
+        candidates.append((len(pairs), common, pairs))
+    count, common, pairs = min(candidates, key=lambda row: (-row[0], row[1]))
+    if count < 2:
+        raise RuntimeError("anchor has no legal shared/private two-user comparator")
+    return common, pairs
+
+
+def main() -> int:
+    assert_runtime()
+    started = time.perf_counter()
+    pilot = load_pilot()
+    runner = pilot.ENGINE
+    run_setting = runner.run_setting_for("a-r0")
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33,
+        start_time_s=0.0,
+    )
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("tape construction exceeded RSS cap")
+
+    options_by_step: dict[int, tuple[Mapping[int, Sequence[tuple[int, int]]], object]] = {}
+    options_payload: dict[str, object] = {}
+    for step_index in range(4):
+        options, census = runner._legal_options(tape, step_index)
+        options_by_step[step_index] = (options, census)
+        options_payload[str(step_index)] = {
+            "census": census,
+            "options": {
+                str(user): [list(beam) for beam in rows]
+                for user, rows in options.items()
+            },
+        }
+    OPTIONS_CACHE.write_text(
+        json.dumps(options_payload, sort_keys=True, separators=(",", ":")) + "\n",
+        encoding="utf-8",
+    )
+    print(f"cached development legal graphs at {OPTIONS_CACHE}", flush=True)
+
+    anchors: list[dict[str, object]] = []
+    base_rows: list[dict[str, object]] = []
+    by_quantile: dict[float, list[dict[str, object]]] = {q: [] for q in QUANTILES}
+    controlled: list[dict[str, object]] = []
+    panel = [(step, carrier) for step in range(4) for carrier in CARRIERS]
+    beam_sets_by_step: dict[int, list[tuple[tuple[int, int], ...]]] = {}
+
+    for position, (step_index, carrier) in enumerate(panel, 1):
+        print(f"anchor {position}/{len(panel)} start step={step_index} carrier={carrier}", flush=True)
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        options, census = options_by_step[step_index]
+        if step_index not in beam_sets_by_step:
+            beam_sets_by_step[step_index] = nested_beam_sets(options)
+        beam_sets = beam_sets_by_step[step_index]
+        configs = []
+        mappings = []
+        for beams in beam_sets:
+            mapping = assignment_for_beams(options, beams)
+            configs.append(runner._configuration(base, mapping, kind="crowding-cost-ladder"))
+            mappings.append(mapping)
+        evaluator = runner.StepEvaluator(
+            tape, runner._setting("a-r0"), step_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+            field="realised", run_setting=run_setting,
+            boundary_indices=tuple(range(48)),
+        )
+        evaluator.evaluate_many([base, *configs])
+        base_profile = evaluator.evaluate(base)
+        base_row = profile_row(base_profile, base.mapping)
+        base_guard = int(base_row["served"])
+        base_rows.append(base_row)
+        ladder: list[dict[str, object]] = []
+        for config, mapping in zip(configs, mappings, strict=True):
+            if config.configuration_id in evaluator._invalid:
+                continue
+            row = profile_row(evaluator.evaluate(config), mapping)
+            row["passes_base_served_guard"] = int(row["served"]) >= base_guard
+            if row["passes_base_served_guard"]:
+                ladder.append(row)
+        if not ladder:
+            raise RuntimeError(f"no served-guard ladder member at anchor {position}")
+        ladder.sort(key=lambda row: int(row["active"]))
+        for left, right in zip(ladder, ladder[1:]):
+            if int(right["active"]) <= int(left["active"]):
+                raise RuntimeError("graded active-beam samples are not strictly increasing")
+        for quantile in QUANTILES:
+            target = int(round((1.0 - quantile) * (len(ladder) - 1)))
+            # q=1 is the most crowded endpoint; q=0 is the most spread endpoint.
+            by_quantile[quantile].append(dict(ladder[target]))
+
+        anchor_row: dict[str, object] = {
+            "anchor_index": position - 1,
+            "anchor_id": f"{tape.domain}|{step_index}|{carrier}",
+            "step_index": step_index,
+            "carrier": carrier,
+            "legal_option_census": census,
+            "base": base_row,
+            "base_served_guard": base_guard,
+            "mask_minimum_active": len(beam_sets[0]),
+            "mask_maximum_active": len(beam_sets[-1]),
+            "guarded_minimum_active": int(ladder[0]["active"]),
+            "guarded_maximum_active": int(ladder[-1]["active"]),
+            "ladder": ladder,
+        }
+
+        if position == 1:
+            common, private_pairs = controlled_groups(options)
+            max_n = min(16, len(private_pairs))
+            for n in (2, 4, 8, 16):
+                if n > max_n:
+                    continue
+                chosen = private_pairs[:n]
+                shared_mapping = {user: None for user in options}
+                spread_mapping = dict(shared_mapping)
+                for user, private in chosen:
+                    shared_mapping[user] = common
+                    spread_mapping[user] = private
+                shared_config = runner._configuration(base, shared_mapping, kind="controlled-shared")
+                spread_config = runner._configuration(base, spread_mapping, kind="controlled-spread")
+                evaluator.evaluate_many((shared_config, spread_config))
+                if shared_config.configuration_id in evaluator._invalid or spread_config.configuration_id in evaluator._invalid:
+                    raise RuntimeError("controlled configuration was physically invalid")
+                shared_row = profile_row(evaluator.evaluate(shared_config), shared_mapping)
+                spread_row = profile_row(evaluator.evaluate(spread_config), spread_mapping)
+                controlled.append({
+                    "n": n,
+                    "anchor_id": anchor_row["anchor_id"],
+                    "common_beam": list(common),
+                    "users_and_private_beams": [[user, list(private)] for user, private in chosen],
+                    "shared": shared_row,
+                    "spread": spread_row,
+                    "all_focal_served": (
+                        int(shared_row["served"]) == n and int(spread_row["served"]) == n
+                    ),
+                    "delta_spread_minus_shared": {
+                        "bits": float(spread_row["bits"]) - float(shared_row["bits"]),
+                        "joules": float(spread_row["joules"]) - float(shared_row["joules"]),
+                        "ee_bits_per_j": float(spread_row["ee_bits_per_j"]) - float(shared_row["ee_bits_per_j"]),
+                        "ee_fraction": float(spread_row["ee_bits_per_j"]) / float(shared_row["ee_bits_per_j"]) - 1.0,
+                    },
+                })
+            anchor_row["controlled_group_capacity"] = len(private_pairs)
+        anchors.append(anchor_row)
+        PARTIAL_OUTPUT.write_text(json.dumps({
+            "status": "PARTIAL",
+            "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
+            "completed_anchors": len(anchors),
+            "peak_rss_bytes": peak_rss_bytes(),
+            "anchors": anchors,
+            "controlled": controlled,
+        }, sort_keys=True, indent=2, allow_nan=False) + "\n", encoding="utf-8")
+        del evaluator, configs, mappings
+        gc.collect()
+        if peak_rss_bytes() >= MAX_RSS_BYTES:
+            raise MemoryError("anchor evaluation exceeded RSS cap")
+        print(
+            f"anchor {position}/{len(panel)} complete peak RSS {peak_rss_bytes()/2**30:.3f} GiB "
+            f"active={ladder[0]['active']}..{ladder[-1]['active']} guard={base_guard}",
+            flush=True,
+        )
+
+    pooled = [
+        pool(by_quantile[q], f"Q{int(q*100):03d}", q)
+        for q in QUANTILES
+    ]
+    # Order the reported curve from crowded to spread (increasing active).
+    pooled.sort(key=lambda row: float(row["active_mean_per_anchor"]))
+    adjacent = []
+    for left, right in zip(pooled, pooled[1:]):
+        delta_active = float(right["active_mean_per_anchor"]) - float(left["active_mean_per_anchor"])
+        delta_ee = float(right["ee_bits_per_j"]) - float(left["ee_bits_per_j"])
+        adjacent.append({
+            "active_left": left["active_mean_per_anchor"],
+            "active_right": right["active_mean_per_anchor"],
+            "slope_bits_per_j_per_active_beam": delta_ee / delta_active,
+            "fractional_slope_per_beam_at_left": delta_ee / delta_active / float(left["ee_bits_per_j"]),
+        })
+    crowded, spread = pooled[0], pooled[-1]
+    active_span = float(spread["active_mean_per_anchor"]) - float(crowded["active_mean_per_anchor"])
+    secant = (
+        float(spread["ee_bits_per_j"]) - float(crowded["ee_bits_per_j"])
+    ) / active_span
+    base_pooled = pool(base_rows, "GEOMETRIC_BASE", math.nan)
+    base_pooled.pop("concentration_quantile")
+    all_family = [row for rows in by_quantile.values() for row in rows]
+    receipt: dict[str, object] = {
+        "schema": "mcrl-v025-crowding-cost-design-measurement-v1",
+        "status": "COMPLETE",
+        "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
+        "panel": {
+            "domain": tape.domain,
+            "world_tape_digest": tape.digest,
+            "anchors": 12,
+            "rule": "steps 0..3 x nearest-eligible, stay-if-possible, random-masked",
+            "evaluation_boundaries": list(range(48)),
+            "numerator": "saturated full-buffer decoded information bits; no demand cap",
+        },
+        "construction_rule": (
+            "exact minimum legal-beam set cover; add beams one at a time while preserving a "
+            "beam-saturating matching until the exact maximum matching rank; activate each beam "
+            "with a distinct witness, then map remaining users to the selected legal beam with "
+            "largest panel-anchor coverage; retain only rows meeting the carrier-BASE PHY-served guard"
+        ),
+        "source": {
+            "root": str(SOURCE_ROOT),
+            "pilot": str(PILOT_PATH),
+            "pilot_sha256": sha256(PILOT_PATH),
+            "engine": str(ENGINE_PATH),
+            "engine_sha256": sha256(ENGINE_PATH),
+            "batch_sha256": sha256(SOURCE_ROOT / "src/mcrl/physics_v025/batch.py"),
+            "energy_sha256": sha256(SOURCE_ROOT / "src/mcrl/physics_v025/energy.py"),
+            "targets_sha256": sha256(SOURCE_ROOT / "src/mcrl/physics_v025/targets.py"),
+        },
+        "runtime": {
+            "python": sys.executable,
+            "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+            "processes": 1,
+            "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+            "peak_rss_bytes": peak_rss_bytes(),
+            "wall_seconds": time.perf_counter() - started,
+        },
+        "geometric_base_pooled": base_pooled,
+        "family_pooled": pooled,
+        "adjacent_slopes": adjacent,
+        "secant": {
+            "active_mean_range": [crowded["active_mean_per_anchor"], spread["active_mean_per_anchor"]],
+            "slope_bits_per_j_per_active_beam": secant,
+            "fractional_slope_per_beam_at_crowded_endpoint": secant / float(crowded["ee_bits_per_j"]),
+            "endpoint_ee_fraction_spread_minus_crowded": float(spread["ee_bits_per_j"]) / float(crowded["ee_bits_per_j"]) - 1.0,
+        },
+        "operating_range": {
+            "max_rf_power_w": max(float(row["max_rf_power_w"]) for row in all_family),
+            "rf_cap_hits": sum(int(row["rf_cap_hits"]) for row in all_family),
+            "rf_transmission_observations": sum(int(row["rf_transmission_observations"]) for row in all_family),
+            "pa_share_range_over_pooled_family": [
+                min(float(row["pa_share"]) for row in pooled),
+                max(float(row["pa_share"]) for row in pooled),
+            ],
+        },
+        "controlled": controlled,
+        "anchors": anchors,
+    }
+    receipt["receipt_sha256"] = canonical_digest(receipt)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    OUTPUT.write_text(json.dumps(receipt, sort_keys=True, indent=2, allow_nan=False) + "\n", encoding="utf-8")
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(json.dumps({"secant": receipt["secant"], "controlled": controlled}, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
