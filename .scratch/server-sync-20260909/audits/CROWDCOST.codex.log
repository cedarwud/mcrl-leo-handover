   564	    def radiate(
   565	        self, config: RadiationConfig, geometry: Geometry, nominal_or_realised: FieldKind
   566	    ) -> RadiationResult:
   567	        members = _beam_members(geometry)
   568	        active = tuple(index for beam in members.values() for index in beam)
   569	        subband_by_index: dict[int, tuple[float, float]] = {}
   570	        cap_by_index: dict[int, float] = {}
   571	        for beam_members in members.values():
   572	            width = config.bandwidth_hz / len(beam_members)
   573	            for position, index in enumerate(beam_members):
   574	                subband_by_index[index] = (position * width, (position + 1) * width)
   575	                cap_by_index[index] = config.beam_cap_w / len(beam_members)
   576	        subbands = tuple(subband_by_index[index] for index in active)
   577	        bandwidth = np.asarray([high - low for low, high in subbands], dtype=np.float64)
   578	        overlap = np.zeros((len(active), len(active)), dtype=np.float64)
   579	        for row, (victim_low, victim_high) in enumerate(subbands):
   580	            for column, (aggressor_low, aggressor_high) in enumerate(subbands):
   581	                overlap_hz = max(0.0, min(victim_high, aggressor_high) - max(victim_low, aggressor_low))
   582	                aggressor_bandwidth = aggressor_high - aggressor_low
   583	                overlap[row, column] = overlap_hz / aggressor_bandwidth
   584	        nominal_coupling = _masked_coupling(geometry, active, "nominal", overlap)
   585	        noise = np.asarray([noise_power_w(value) for value in bandwidth])
   586	        power, certificate = _solve_power(
   587	            geometry.gains("nominal")[list(active)] if active else np.zeros(0),
   588	            nominal_coupling,
