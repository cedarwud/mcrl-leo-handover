   543	def _catalogue_with_census(
   544	    tape: ExogenousWorldTape,
   545	    step_index: int,
   546	    base: Configuration,
   547	    *,
   548	    setting: PhysicsSetting | None = None,
   549	    calibration: CalibrationValues | None = None,
   550	    counter: EvaluationCounter | None = None,
   551	    run_setting: SealedRunSetting | None = None,
   552	) -> tuple[tuple[Configuration, ...], dict[str, object]]:
   553	    users = tuple(sorted(user.user_id for user in tape.user_layout))
   554	    active_run = run_setting_for("a-r0") if run_setting is None else run_setting
   555	    all_options, raw_census = _legal_options(tape, step_index)
   556	    product_size = math.prod(
   557	        len(all_options[user]) if all_options[user] else 1 for user in users
   558	    )
   559	    if product_size <= COMPLETE_CATALOGUE_LIMIT:
   560	        options, census = all_options, raw_census
