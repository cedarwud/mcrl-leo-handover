   562	        options, census = _selection_shortlist(
   563	            tape, step_index, run_setting=active_run
   564	        )
   565	    factors = tuple(options[user] if options[user] else (None,) for user in users)
   566	    rows: list[Configuration] = [base]
   567	    base_map = base.mapping
   568	    if product_size <= COMPLETE_CATALOGUE_LIMIT:
   569	        for product in itertools.product(*factors):
   570	            mapping = dict(zip(users, product, strict=True))
   571	            if mapping == base_map:
   572	                continue
   573	            rows.append(_configuration(base, mapping, kind="complete-cartesian"))
   574	        mode = "complete-cartesian"
   575	    else:
   576	        # (i) every legal unilateral move; an option-less user keeps the
   577	        # explicit null action and never collapses the other users' catalogue.
   578	        unilaterals: dict[int, list[Configuration]] = {user: [] for user in users}
   579	        for user in users:
   580	            for identity in options[user]:
   581	                if identity == base_map[user]:
   582	                    continue
   583	                mapping = dict(base_map)
   584	                mapping[user] = identity
   585	                row = _configuration(base, mapping, kind="unilateral")
   586	                rows.append(row)
   587	                unilaterals[user].append(row)
   588	
   589	        # Rank users by the best exact nonlinear nominal single-user surplus
   590	        # at the decision instant.  The one-boundary result is held over the
   591	        # step only for this causal selection-time ranking.
   592	        rank_setting = _setting("a-r0") if setting is None else setting
   593	        nominal = StepEvaluator(
   594	            tape,
   595	            rank_setting,
   596	            step_index,
   597	            transition_from=base,
   598	            field="nominal",
   599	            counter=counter,
   600	            run_setting=active_run,
   601	            boundary_indices=(0,),
   602	        )
   603	        rank_rows = [base] + [row for values in unilaterals.values() for row in values]
   604	        nominal.evaluate_many(rank_rows)
   605	        nominal_base = nominal.evaluate(base)
   606	        eta = Fraction() if calibration is None else calibration.eta_ref
   607	        kappa = Fraction(1) if calibration is None else calibration.kappa_bits_per_user_step
   608	        best_surplus = {}
   609	        for user in users:
   610	            values = []
   611	            for row in unilaterals[user]:
   612	                profile = nominal.evaluate(row)
   613	                core = Fraction(str(profile.bits - nominal_base.bits)) - eta * Fraction(
   614	                    str(profile.joules - nominal_base.joules)
   615	                )
   616	                core += kappa * _phi_for(base, row)
   617	                values.append(core)
   618	            best_surplus[user] = max(values, default=Fraction(-10**30))
   619	        ranked_users = sorted(
   620	            users,
   621	            key=lambda user: (-best_surplus[user], user),
   622	        )[:PAIRWISE_TOP_K_USERS]
   623	
   624	        # (ii) S0 top-two proposals assembled as complete deployable profiles.
   625	        for proposal_rank in range(TOP_PROPOSALS):
   626	            mapping = dict(base_map)
   627	            for user in users:
   628	                if len(unilaterals[user]) > proposal_rank:
   629	                    mapping[user] = unilaterals[user][proposal_rank].mapping[user]
   630	            if mapping != base_map:
   631	                rows.append(_configuration(base, mapping, kind="s0-top-two"))
   632	
   633	        # (iii) pairwise moves among top K, over each user's top two options.
   634	        for first, second in itertools.combinations(ranked_users, 2):
   635	            for first_row in unilaterals[first][:TOP_PROPOSALS]:
   636	                for second_row in unilaterals[second][:TOP_PROPOSALS]:
   637	                    mapping = dict(base_map)
   638	                    mapping[first] = first_row.mapping[first]
   639	                    mapping[second] = second_row.mapping[second]
   640	                    rows.append(_configuration(base, mapping, kind="pairwise-top10-top2"))
   641	
   642	        # (iv) one evacuation set per active beam, every incumbent user moved
   643	        # to its best live legal alternative (or explicit null if none).
   644	        for beam in sorted({identity for identity in base_map.values() if identity is not None}):
   645	            mapping = dict(base_map)
   646	            affected = [user for user in users if base_map[user] == beam]
   647	            for user in affected:
   648	                mapping[user] = next(
   649	                    (identity for identity in options[user] if identity != beam),
   650	                    None,
   651	                )
   652	            if mapping != base_map:
   653	                rows.append(_configuration(base, mapping, kind="beam-evacuation"))
   654	        mode = "bounded-union-v2"
   655	
   656	    unique = {row.assignments: row for row in rows}
   657	    ordered = (base,) + tuple(
   658	        sorted(
   659	            (row for assignments, row in unique.items() if assignments != base.assignments),
   660	            key=lambda row: row.configuration_id,
   661	        )
   662	    )
   663	    if mode != "complete-cartesian" and len(ordered) > CATALOGUE_CAP:
