   496	def supply_power_w(
   497	    beam_power_w: np.ndarray, efficiency: np.ndarray
   498	) -> np.ndarray:
   499	    """Paper eq. (3.15): ``P^p_{s,v} = p_{s,v} / ξ_{s,v}``.
   500	
   501	    **Per beam, no ``u`` index** (ruling F-2), matching :func:`pa_efficiency`
   502	    above.  One beam, one amplifier, one supply draw — "一支已啟用的波束以
   503	    單一功率發射,不論其上載有幾位使用者".
   504	
   505	    Fail-closed on a dead amplifier: zero efficiency with positive radiated
   506	    power is not a large number, it is a contradiction.
   507	    """
   508	    power = np.asarray(beam_power_w, dtype=np.float64)
   509	    xi = np.asarray(efficiency, dtype=np.float64)
   510	    if np.any(power < 0.0) or np.any(xi < 0.0):
   511	        raise MCRLContractError("power and efficiency must be non-negative")
   512	    starved = (xi <= 0.0) & (power > 0.0)
   513	    if np.any(starved):
   514	        raise MCRLContractError(
   515	            "positive radiated power at zero PA efficiency is impossible; "
   516	            "P-7 forbids flooring the denominator to make it finite"
   517	        )
   518	    return np.where(xi > 0.0, power / np.where(xi > 0.0, xi, 1.0), 0.0)
