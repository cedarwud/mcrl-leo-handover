   411	def classify_link_power_feasibility(
   412	    required_power_w: np.ndarray,
   413	    *,
   414	    max_power_w: float = BEAM_POWER_MAX_W,
   415	) -> np.ndarray:
   416	    """``p > p_max`` — the per-link admission test, **outside** the recurrence.
   417	
   418	    Ruling C-2 is explicit that eq. (3.11) introduces no cap, clamp or
   419	    min/max projection; this is the one ceiling that remains, and it sits
   420	    after the recurrence rather than inside it.  A link whose recurrence
   421	    power exceeds the per-beam RF ceiling is infeasible and that user is in
   422	    outage for the step — per link, so a demanding link drops out while its
   423	    neighbours on the same beam keep service, and there is no cliff.
   424	
   425	    There is no per-satellite beam-count ceiling anywhere in this project
   426	    (ruling 2026-08-22); any count-based cap darkens whole beams at once,
   427	    which is exactly the cliff this avoids.
   428	    """
   429	    required = np.asarray(required_power_w, dtype=np.float64)
   430	    if np.any(required < 0.0):
   431	        raise MCRLContractError("required power must be non-negative")
   432	    if not np.all(np.isfinite(required)):
   433	        raise MCRLContractError("required power must be finite")
   434	    if max_power_w <= 0.0:
   435	        raise ValueError("max_power_w must be positive")
   436	    return required > max_power_w
