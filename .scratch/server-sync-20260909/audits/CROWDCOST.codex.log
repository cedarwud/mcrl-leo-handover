    26	@dataclass(frozen=True)
    27	class ResolutionResult:
    28	    radiation: RadiationResult
    29	    average_rate_bps: dict[int, float] | None
    30	    bits: dict[int, float] | None
    31	    decoding_time_fraction: dict[int, float] | None
    32	    complete_service: dict[int, bool] | None
    33	    rate_target_attained: dict[int, bool] | None
    34	    rate_target_feasible: dict[int, bool] | None
    35	    energy: EnergyReceipt | None
    36	
    37	    @property
    38	    def valid(self) -> bool:
    39	        return self.radiation.valid
    40	
    41	
    42	def resolve_configuration(
    43	    architecture: RadiationArchitecture | None = None,
    44	    radiation_config: RadiationConfig | None = None,
    45	    geometry: Geometry | None = None,
    46	    rate_model: RateModel | None = None,
    47	    inventory: HardwareInventory | None = None,
    48	    *,
    49	    duration_s: float | None = None,
    50	    field: FieldKind = "realised",
    51	    idle_power_w: float = 0.0,
    52	    batch_arrays: PrimitiveStepArrays | None = None,
    53	    batch_selected_rows: np.ndarray | None = None,
    54	    batch_chunk_size: int = 256,
    55	    batch_rate_target_bps: float | None = None,
    56	    batch_circuit_power_per_active_chain_w: float | None = None,
    57	    batch_boundary_indices: tuple[int, ...] = tuple(range(48)),
    58	) -> ResolutionResult | "BatchARResult":
    59	    """Resolve one scalar configuration or one dense catalogue request."""
    60	
    61	    if batch_arrays is not None or batch_selected_rows is not None:
    62	        if batch_arrays is None or batch_selected_rows is None:
    63	            raise ValueError("dense resolution needs arrays and selected rows together")
    64	        if any(
    65	            value is not None
    66	            for value in (architecture, radiation_config, geometry, rate_model, inventory)
    67	        ) or duration_s is not None:
    68	            raise ValueError("dense and scalar resolution inputs cannot be mixed")
    69	        if idle_power_w != 0.0:
    70	            raise ValueError("idle_power_w is a scalar-only resolution input")
    71	        from .batch import _evaluate_ar_tdm_catalogue_core
    72	
    73	        kwargs: dict[str, object] = {
    74	            "field": field,
    75	            "chunk_size": batch_chunk_size,
    76	            "boundary_indices": batch_boundary_indices,
    77	        }
    78	        if batch_rate_target_bps is not None:
    79	            kwargs["rate_target_bps"] = batch_rate_target_bps
    80	        if batch_circuit_power_per_active_chain_w is not None:
    81	            kwargs["circuit_power_per_active_chain_w"] = (
    82	                batch_circuit_power_per_active_chain_w
    83	            )
    84	        return _evaluate_ar_tdm_catalogue_core(
    85	            batch_arrays,
    86	            batch_selected_rows,
    87	            **kwargs,
    88	        )
    89	
    90	    if (
    91	        batch_chunk_size != 256
    92	        or batch_rate_target_bps is not None
    93	        or batch_circuit_power_per_active_chain_w is not None
    94	        or batch_boundary_indices != tuple(range(48))
    95	    ):
    96	        raise ValueError("batch resolution inputs require arrays and selected rows")
    97	
    98	    if any(
    99	        value is None
   100	        for value in (
   101	            architecture,
   102	            radiation_config,
   103	            geometry,
   104	            rate_model,
   105	            inventory,
   106	            duration_s,
   107	        )
   108	    ):
   109	        raise ValueError("scalar resolution inputs are incomplete")
   110	
   111	    if not math.isfinite(duration_s) or duration_s < 0.0:
   112	        raise ValueError("duration_s must be finite and nonnegative")
   113	    radiation = architecture.radiate(radiation_config, geometry, field)
   114	    if not radiation.valid:
   115	        return ResolutionResult(radiation, None, None, None, None, None, None, None)
   116	
   117	    rates = {link.user_id: 0.0 for link in geometry.links}
   118	    served_fraction = {link.user_id: 0.0 for link in geometry.links}
   119	    allocated_fraction = {link.user_id: 0.0 for link in geometry.links}
   120	    for slot in radiation.slots:
   121	        for transmission in slot.transmissions:
   122	            allocated_fraction[transmission.user_id] += slot.fraction
   123	            served = rate_model.served(transmission.sinr, allocated=True)
   124	            if served:
   125	                served_fraction[transmission.user_id] += slot.fraction
   126	                rates[transmission.user_id] += slot.fraction * rate_model.rate_bps(
   127	                    transmission.sinr, transmission.bandwidth_hz
   128	                )
   129	            # No branch edits radiation: an unsuccessful attempt continues to
   130	            # interfere and consume exactly the energy already scheduled.
   131	    energy = schedule_energy(
   132	        inventory,
   133	        (
   134	            (slot.fraction, dict(slot.beam_rf_w))
   135	            for slot in radiation.slots
   136	        ),
   137	        duration_s=duration_s,
   138	        idle_power_w=idle_power_w,
   139	    )
   140	    bits = {user: rate * duration_s for user, rate in rates.items()}
   141	    complete = {
   142	        user: allocated_fraction[user] > 0.0
   143	        and math.isclose(served_fraction[user], allocated_fraction[user], rel_tol=0.0, abs_tol=1.0e-15)
   144	        for user in rates
   145	    }
   146	    return ResolutionResult(
   147	        radiation,
   148	        rates,
   149	        bits,
   150	        served_fraction,
   151	        complete,
   152	        radiation.rate_target_attained,
   153	        radiation.per_user_rate_target_feasible,
   154	        energy,
   155	    )
