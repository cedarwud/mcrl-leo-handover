   439	def beam_power_w(
   440	    link_power_w: np.ndarray, served: np.ndarray, beam_index: np.ndarray, num_beams: int
   441	) -> np.ndarray:
   442	    """Paper (3.12a) preamble: ``p_{s,v} = max_{u : x=1} p_{u,s,v}``.
   443	
   444	    "一支已啟用的波束以單一功率發射,不論其上載有幾位使用者" — the beam
   445	    radiates one power regardless of how many users it carries, so the
   446	    aggregation is a **max over served users**, never a sum or a mean.
   447	    A beam with no served user radiates nothing.
   448	    """
   449	    power = np.asarray(link_power_w, dtype=np.float64)
   450	    active = np.asarray(served, dtype=bool)
   451	    index = np.asarray(beam_index, dtype=np.int64)
   452	    if power.shape != active.shape or power.shape != index.shape:
   453	        raise MCRLContractError(
   454	            "link_power_w, served and beam_index must share a shape"
   455	        )
   456	    if np.any(power < 0.0):
   457	        raise MCRLContractError("link powers must be non-negative")
   458	    out = np.zeros(int(num_beams), dtype=np.float64)
   459	    for value, is_served, beam in zip(
   460	        power.tolist(), active.tolist(), index.tolist()
   461	    ):
   462	        if not is_served or beam < 0:
   463	            continue
   464	        out[beam] = max(out[beam], value)
   465	    return out
