    85	class NetworkOutcome:
    86	    """One whole-network physical profile used by every teacher."""
    87	
    88	    bits: Fraction
    89	    joules: Fraction
    90	    phi: Fraction
    91	    decoding_availability: Fraction
    92	    useful_availability: Fraction
    93	    per_user_bits: tuple[tuple[int, Fraction], ...] = ()
    94	
    95	    @classmethod
    96	    def build(
    97	        cls,
    98	        *,
    99	        bits: int | float | str | Fraction,
   100	        joules: int | float | str | Fraction,
   101	        phi: int | float | str | Fraction,
   102	        decoding_availability: int | float | str | Fraction,
   103	        useful_availability: int | float | str | Fraction,
   104	        per_user_bits: Mapping[int, int | float | str | Fraction] | None = None,
   105	    ) -> "NetworkOutcome":
   106	        result = cls(
   107	            exact(bits),
   108	            exact(joules),
   109	            exact(phi),
   110	            exact(decoding_availability),
   111	            exact(useful_availability),
   112	            tuple(
   113	                sorted(
   114	                    (int(user), exact(value))
   115	                    for user, value in ({} if per_user_bits is None else per_user_bits).items()
   116	                )
   117	            ),
   118	        )
   119	        if result.bits < 0 or result.joules < 0:
   120	            raise MCRLContractError("network bits/joules must be nonnegative")
   121	        if result.bits > 0 and result.joules == 0:
   122	            raise MCRLContractError("positive network bits at zero energy is invalid")
   123	        if not 0 <= result.useful_availability <= result.decoding_availability <= 1:
   124	            raise MCRLContractError("network availability is outside [0,1]")
   125	        if result.per_user_bits and sum((value for _, value in result.per_user_bits), Fraction()) != result.bits:
   126	            raise MCRLContractError("per-user bits do not sum to whole-network bits")
   127	        return result
