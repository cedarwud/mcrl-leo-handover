   590	def shannon_rate_bps(
   591	    sinr_linear: np.ndarray,
   592	    *,
   593	    beam_load: np.ndarray,
   594	    bandwidth_hz: float = BEAM_BANDWIDTH_HZ,
   595	) -> np.ndarray:
   596	    """Paper eq. (3.14): ``R = (B^w / U_{s,v}) · log₂(1 + γ)``.
   597	
   598	    The beam is time-shared, so its bandwidth is divided by the number of
   599	    users it serves.  ``beam_load`` is **keyword-only and required**: an
   600	    earlier version defaulted the bandwidth to the whole ``B^w`` and left
   601	    the divisor to the caller, which returns a rate exactly ``U`` times too
   602	    high for anyone who forgets — silently, and in the direction that
   603	    flatters the result.
   604	
   605	    A zero-load beam has no rate rather than an infinite one.
   606	    """
   607	    sinr = np.asarray(sinr_linear, dtype=np.float64)
   608	    load = np.asarray(beam_load, dtype=np.float64)
   609	    if np.any(sinr < 0.0):
   610	        raise MCRLContractError("SINR must be non-negative")
   611	    if np.any(load < 0.0):
   612	        raise MCRLContractError("beam load must be non-negative")
   613	    if bandwidth_hz <= 0.0:
   614	        raise ValueError("bandwidth must be positive")
   615	    shared = np.where(load > 0.0, bandwidth_hz / np.maximum(load, 1.0), 0.0)
   616	    return shared * np.log2(1.0 + sinr)
