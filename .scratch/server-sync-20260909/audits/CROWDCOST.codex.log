   539	class MatchedAnchorDecomposition:
   540	    eta0: Fraction
   541	    additive: Fraction
   542	    interaction: Fraction
   543	    joint_change: Fraction
   544	    denominator: Fraction
   545	    g_additive: Fraction
   546	    g_interaction: Fraction
