   549	def system_power_w(
   550	    supply_power_per_beam_w: np.ndarray,
   551	    radiating_beams_by_satellite: np.ndarray,
   552	) -> float:
   553	    """Paper eq. (3.16): ``P^N = P^f + Σ_s Σ_v z_{s,v}·P^p_{s,v}``.
   554	
   555	    **A double sum over beams, not a triple sum over links** (ruling F-2).
   556	    The paper wrote ``Σ_{u'} Σ_{s'} Σ_{v'} x_{u',s',v'}·P^p_{u',s',v'}``,
   557	    which charges one amplifier once per user sitting on it.  The over-count
   558	    is exactly ``Σ_{s,v} (U_{s,v} − 1)·P^p_{s,v}``, so the ratio between the
   559	    two forms is the load-weighted mean occupancy — measured at 2.28x for
   560	    100 users and 1.41x for 20, which is what identified the defect.
   561	
   562	    The damage was not the scale.  The extra term rises monotonically with
   563	    occupancy and sits in ``r1``'s **denominator**, so "a busier beam is
   564	    less efficient" — which is ``r3``'s job.  A constant offset would not
   565	    move an argmax; a load-dependent one makes the first and third
   566	    objectives inseparable and voids the reading of ``Ω = (0.5, 0.3, 0.2)``.
   567	
   568	    ``z`` rather than ``x`` is the correct filter and is satisfied by
   569	    construction: a beam appears in the array iff it radiates.
   570	
   571	    The fixed term is included: it was omitted while unsourced, and You et
   572	    al. Table II supplied the source (ruling C-6).  Eq. (3.16a) needed no
   573	    change — it was already per beam, and its own text warns against exactly
   574	    this double count ("每顆衛星只計一次,不會重複計入") for ``P_BB``.
   575	    """
   576	    supply = np.asarray(supply_power_per_beam_w, dtype=np.float64)
   577	    if supply.ndim != 1:
   578	        raise MCRLContractError("supply power must be one per radiating beam")
   579	    if np.any(supply < 0.0):
   580	        raise MCRLContractError("supply power must be non-negative")
   581	    counts = np.asarray(radiating_beams_by_satellite, dtype=np.float64)
   582	    if float(counts.sum()) != float(supply.size):
   583	        raise MCRLContractError(
   584	            f"{supply.size} radiating beams but the per-satellite tally sums "
   585	            f"to {float(counts.sum())}; the two describe different steps"
   586	        )
   587	    return fixed_power_w(counts) + float(supply.sum())
