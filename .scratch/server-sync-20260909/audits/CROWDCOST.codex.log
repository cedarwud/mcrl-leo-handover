   468	def pa_efficiency(
   469	    beam_power: np.ndarray,
   470	    *,
   471	    max_efficiency: float = PA_MAX_EFFICIENCY,
   472	    saturation_power_w: float = PA_SATURATION_POWER_W,
   473	) -> np.ndarray:
   474	    """Paper eq. (3.15a): ``ξ_{s,v} = min{ξ_max, ξ_max·√(p_{s,v}/p_sat)}``.
   475	
   476	    **Per beam, no ``u`` index** (ruling F-2).  The paper wrote ``ξ_{u,s,v}``
   477	    on the left while its only argument on the right was the beam power
   478	    ``p_{s,v}`` — ``u`` had nothing to correspond to.  An amplifier belongs
   479	    to a beam, not to a user of it.
   480	
   481	    The square root is the class-B idealisation: RF output goes as ``V_o²``
   482	    while DC input goes as ``V_o``, so ``ξ ∝ √P_RF``.  Its consequence is
   483	    the reason ``r1`` is an efficiency rather than a power — "由於低輸出時
   484	    效率較差,把發射功率壓低並不會等比例降低功率消耗".
   485	    """
   486	    power = np.asarray(beam_power, dtype=np.float64)
   487	    if np.any(power < 0.0):
   488	        raise MCRLContractError("beam power must be non-negative")
   489	    if max_efficiency <= 0.0 or saturation_power_w <= 0.0:
   490	        raise ValueError("efficiency and saturation power must be positive")
   491	    return np.minimum(
   492	        max_efficiency, max_efficiency * np.sqrt(power / saturation_power_w)
   493	    )
