   379	def recurrence_power_w(
   380	    segment_start_gain: np.ndarray,
   381	    current_gain: np.ndarray,
   382	    *,
   383	    p0_w: float = SEGMENT_START_POWER_W,
   384	) -> np.ndarray:
   385	    """Paper eq. (3.12): ``p(t) = p⁰ · G^T(θ(τ)) / G^T(θ(t))``.
   386	
   387	    The invariant inside one served segment is the **product** ``p·G^T``,
   388	    not ``p`` itself — the rule compensates the transmit-side angle gain
   389	    and claims nothing about holding SINR or throughput fixed.  This closed
   390	    form is a telescoped identity over (3.11), **not stored state**: it is
   391	    valid only while the same physical link has been served at every step
   392	    from ``τ`` to ``t``, so a caller must not carry it across a break.
   393	
   394	    No target-SINR inversion, no cap, no clamp, no min/max projection —
   395	    (3.11)'s text rules all four out.
   396	    """
   397	    start = np.asarray(segment_start_gain, dtype=np.float64)
   398	    now = np.asarray(current_gain, dtype=np.float64)
   399	    if p0_w <= 0.0:
   400	        raise ValueError("p0_w must be positive")
   401	    if np.any(start < 0.0) or np.any(now < 0.0):
   402	        raise MCRLContractError("transmit gains must be non-negative")
   403	    if np.any(now <= 0.0):
   404	        raise MCRLContractError(
   405	            "eq. (3.11) requires G^T(θ(t)) > 0; a null-pointing link has no "
   406	            "recurrence power"
   407	        )
   408	    return p0_w * start / now
