   679	def _energy_fields(
   680	    shared,
   681	    setting: PhysicsSetting,
   682	    *,
   683	    circuit_power_per_active_chain_w: float = 0.338,
   684	) -> tuple[dict[str, float], float, float]:
   685	    idle = SENSITIVITY_IDLE_POWER_W if setting.standby == "f" else PRIMARY_IDLE_POWER_W
   686	    boundary = []
   687	    for item in shared.integrated:
   688	        receipt = schedule_energy(
   689	            shared.inventory,
   690	            ((slot.fraction, dict(slot.beam_rf_w)) for slot in item.radiation.slots),
   691	            duration_s=1.0,
   692	            idle_power_w=idle,
   693	            circuit_power_per_active_chain_w=circuit_power_per_active_chain_w,
   694	        )
   695	        beams = {beam for slot in item.radiation.slots for beam, rf in slot.beam_rf_w if rf > 0.0}
   696	        satellites = {beam[0] for beam in beams}
   697	        boundary.append((receipt, float(len(beams)), float(len(satellites))))
   698	    fields = ("pa_j", "circuit_j", "standby_j", "baseband_j", "bus_j")
   699	    if setting.integration == "T":
   700	        receipt, beams, satellites = boundary[0]
   701	        return (
   702	            {name: getattr(receipt, name) * DECISION_INTERVAL_S for name in fields},
   703	            beams * DECISION_INTERVAL_S,
   704	            satellites * DECISION_INTERVAL_S,
   705	        )
   706	    components = {name: 0.0 for name in fields}
   707	    beam_seconds = satellite_seconds = 0.0
   708	    for left, right in zip(boundary, boundary[1:]):
   709	        for name in fields:
   710	            components[name] += 0.5 * (getattr(left[0], name) + getattr(right[0], name)) * 0.640
   711	        beam_seconds += 0.5 * (left[1] + right[1]) * 0.640
   712	        satellite_seconds += 0.5 * (left[2] + right[2]) * 0.640
   713	    return components, beam_seconds, satellite_seconds
