   504	            max_n = min(16, len(private_pairs))
   505	            for n in (2, 4, 8, 16):
   565	    for left, right in zip(pooled, pooled[1:]):
   566	        delta_active = float(right["active_mean_per_anchor"]) - float(left["active_mean_per_anchor"])
