   401	def _transmissions(
   402	    geometry: Geometry,
   403	    active: tuple[int, ...],
   404	    power: np.ndarray,
   405	    direct: np.ndarray,
   406	    coupling: np.ndarray,
   407	    noise: np.ndarray,
   408	    bandwidth: np.ndarray,
   409	    subbands: tuple[tuple[float, float], ...],
   410	    *,
   411	    rate_target_bps: float | None = None,
   412	    rate_target_sinr_values: tuple[float | None, ...] | None = None,
   413	    rate_target_feasible: tuple[bool, ...] | None = None,
   414	) -> tuple[Transmission, ...]:
   415	    rows = []
   416	    for row, index in enumerate(active):
   417	        link = geometry.links[index]
   418	        intra = 0.0
   419	        inter = 0.0
   420	        for column, aggressor in enumerate(active):
   421	            term = coupling[row, column] * power[column]
   422	            if geometry.links[aggressor].beam[0] == link.beam[0]:
   423	                intra += term
   424	            else:
   425	                inter += term
   426	        rows.append(
   427	            Transmission(
   428	                user_id=link.user_id,
   429	                beam=link.beam,
   430	                rf_power_w=float(power[row]),
   431	                wanted_w=float(power[row] * direct[row]),
   432	                intra_interference_w=float(intra),
   433	                inter_interference_w=float(inter),
   434	                noise_w=float(noise[row]),
   435	                bandwidth_hz=float(bandwidth[row]),
   436	                subband=subbands[row],
   437	                rate_target_bps=rate_target_bps,
   438	                rate_target_sinr=(
   439	                    None if rate_target_sinr_values is None else rate_target_sinr_values[row]
   440	                ),
   441	                rate_target_feasible=(
   442	                    None if rate_target_feasible is None else rate_target_feasible[row]
   443	                ),
   444	            )
   445	        )
   446	    return tuple(rows)
   447	
   448	
   449	def _aggregate_certificates(certificates: list[PowerCertificate]) -> PowerCertificate:
   450	    if not certificates:
   451	        return PowerCertificate("FIXED", 0, 0.0, POWER_SOLVER_TOLERANCE_W)
   452	    invalid = any(c.status == "INVALID" for c in certificates)
   453	    statuses = {c.status for c in certificates}
   454	    status: Literal["FIXED", "CONVERGED", "CONVERGED_SLOW", "INVALID"] = (
   455	        "INVALID"
   456	        if invalid
   457	        else "FIXED"
   458	        if statuses == {"FIXED"}
   459	        else "CONVERGED_SLOW"
   460	        if "CONVERGED_SLOW" in statuses
   461	        else "CONVERGED"
   462	    )
   463	    return PowerCertificate(
   464	        status,
   465	        sum(c.iterations for c in certificates),
   466	        max(c.residual_w for c in certificates),
   467	        certificates[0].tolerance_w,
   468	        tuple(sorted({uid for c in certificates for uid in c.saturated_users})),
   469	    )
