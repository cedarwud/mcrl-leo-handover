   422	def _legal_options(
   423	    tape: ExogenousWorldTape, step_index: int
   424	) -> tuple[dict[int, tuple[tuple[int, int], ...]], dict[str, int]]:
   425	    """Return decision-instant legal options without materialising array rows."""
   426	
   427	    step = tape.steps[step_index]
   428	    users = tuple(sorted(user.user_id for user in tape.user_layout))
   429	    if step.arrays is not None:
   430	        arrays = step.arrays
   431	        live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
   432	        options: dict[int, list[tuple[float, tuple[int, int]]]] = {user: [] for user in users}
   433	        for row in np.flatnonzero(live).tolist():
   434	            user = int(arrays.users[int(arrays.row_user_column[row])])
   435	            identity = tuple(int(value) for value in arrays.identities[row])
   436	            options[user].append((float(arrays.slants_km[0, row]), identity))
   437	        resolved = {
   438	            user: tuple(identity for _slant, identity in sorted(set(rows)))
   439	            for user, rows in options.items()
   440	        }
   441	        legal_count = int(np.count_nonzero(live))
   442	        return resolved, {
   443	            "coarse_shortlist_count": int(len(arrays.identities)),
   444	            "full_successor_legal_count": legal_count,
   445	            "candidate_shortlist_miss_count": 0,
   446	        }
   447	    first = step.boundaries[0]
   448	    full_legal = {(row.user_id, row.identity) for row in first.candidates if row.legal}
   449	    resolved = {
   450	        user: tuple(
   451	            row.identity
   452	            for row in sorted(
   453	                (
   454	                    row
   455	                    for row in first.candidates
   456	                    if row.user_id == user
   457	                    and row.legal
   458	                ),
   459	                key=lambda row: (row.slant_km, row.identity),
   460	            )
   461	        )
   462	        for user in users
   463	    }
   464	    return resolved, {
   465	        "coarse_shortlist_count": len(_candidate_shortlist(first)),
   466	        "full_successor_legal_count": len(full_legal),
   467	        "candidate_shortlist_miss_count": len(
   468	            full_legal - _candidate_shortlist(first)
   469	        ),
