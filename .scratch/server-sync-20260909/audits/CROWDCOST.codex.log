     1	"""V0.25 DVB-S2 ACM selection and the separately named U diagnostic."""
     2	
     3	from __future__ import annotations
     4	
     5	from dataclasses import dataclass
     6	import math
     7	from typing import Protocol
     8	
     9	from mcrl.errors import MCRLContractError
    10	
    11	from .constants_v025 import (
    12	    ACM_TABLE,
    13	    IMPLEMENTATION_MARGIN_DB,
    14	    ROLL_OFF,
    15	    SHANNON_MIN,
    16	    SINR_MIN,
    17	)
    18	
    19	
    20	@dataclass(frozen=True)
    21	class ACMMode:
    22	    name: str
    23	    efficiency_bit_per_symbol: float
    24	    ideal_esn0_db: float
    25	    spectral_efficiency_bit_per_s_hz: float
    26	    threshold_db: float
    27	    threshold_linear: float
    28	
    29	
    30	def _mode(row: tuple[str, float, float]) -> ACMMode:
    31	    name, efficiency, ideal = row
    32	    spectral_efficiency = efficiency / (1.0 + ROLL_OFF)
    33	    threshold_db = ideal + IMPLEMENTATION_MARGIN_DB - 10.0 * math.log10(1.0 + ROLL_OFF)
    34	    return ACMMode(
    35	        name,
    36	        efficiency,
    37	        ideal,
    38	        spectral_efficiency,
    39	        threshold_db,
    40	        10.0 ** (threshold_db / 10.0),
    41	    )
    42	
    43	
    44	ACM_MODES = tuple(_mode(row) for row in ACM_TABLE)
    45	
    46	
    47	def served_phy(sinr_linear: float, *, allocated: bool = True) -> bool:
    48	    """The service endpoint: allocated and at or above the lowest threshold."""
    49	
    50	    if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
    51	        raise MCRLContractError("SINR must be finite and nonnegative")
    52	    return bool(allocated and sinr_linear >= SINR_MIN)
    53	
    54	
    55	def select_mode(sinr_linear: float) -> ACMMode | None:
    56	    """Select the eligible mode with greatest efficiency, not table position."""
    57	
    58	    if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
    59	        raise MCRLContractError("SINR must be finite and nonnegative")
    60	    eligible = [mode for mode in ACM_MODES if sinr_linear >= mode.threshold_linear]
    61	    return max(eligible, key=lambda mode: mode.efficiency_bit_per_symbol) if eligible else None
    62	
    63	
    64	def select_mode_margin_off(sinr_linear: float) -> ACMMode | None:
    65	    """Greatest-efficiency ACM mode with only the common 1.7-dB margin removed."""
    66	
    67	    if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
    68	        raise MCRLContractError("SINR must be finite and nonnegative")
    69	    eligible = [
    70	        mode
    71	        for mode in ACM_MODES
    72	        if sinr_linear >= 10.0 ** ((mode.threshold_db - IMPLEMENTATION_MARGIN_DB) / 10.0)
    73	    ]
    74	    return max(eligible, key=lambda mode: mode.efficiency_bit_per_symbol) if eligible else None
    75	
    76	
    77	def rate_target_mode(
    78	    rate_target_bps: float,
    79	    full_bandwidth_hz: float,
    80	    occupancy: int,
    81	) -> ACMMode | None:
    82	    """Return the lowest-threshold frozen ACM mode that meets ``r*``.
    83	
    84	    For TDM, ``full_bandwidth_hz / occupancy`` is effective airtime
    85	    bandwidth.  For FDM it is the physical sub-band bandwidth.  Both therefore
    86	    implement the sealed ``Gamma_r(n_b)`` definition with one helper.
    87	    """
    88	
    89	    if not math.isfinite(rate_target_bps) or rate_target_bps <= 0.0:
    90	        raise MCRLContractError("rate target must be finite and positive")
    91	    if not math.isfinite(full_bandwidth_hz) or full_bandwidth_hz <= 0.0:
    92	        raise MCRLContractError("full bandwidth must be finite and positive")
    93	    if type(occupancy) is not int or occupancy < 1:
    94	        raise MCRLContractError("occupancy must be a positive exact integer")
    95	    required_se = rate_target_bps * occupancy / full_bandwidth_hz
    96	    eligible = [
    97	        mode
    98	        for mode in ACM_MODES
    99	        if mode.spectral_efficiency_bit_per_s_hz >= required_se
   100	    ]
   101	    return min(eligible, key=lambda mode: mode.threshold_linear) if eligible else None
   102	
   103	
   104	def rate_target_sinr(
   105	    rate_target_bps: float,
   106	    full_bandwidth_hz: float,
   107	    occupancy: int,
   108	) -> float | None:
   109	    """Return ``Gamma_r(n_b)`` or ``None`` when the ACM table cannot meet it."""
   110	
   111	    mode = rate_target_mode(rate_target_bps, full_bandwidth_hz, occupancy)
   112	    if mode is None:
   113	        return None
   114	    # The separately frozen PHY service floor is rounded at its declared dB
   115	    # precision and is a few parts in 1e10 above the derived first-mode value.
   116	    # A controller target must clear both gates to avoid reporting a nominally
   117	    # selected QPSK 1/4 mode as unserved.
   118	    return max(mode.threshold_linear, SINR_MIN)
   119	
   120	
   121	class RateModel(Protocol):
   122	    name: str
   123	
   124	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float: ...
   125	
   126	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool: ...
   127	
   128	
   129	@dataclass(frozen=True)
   130	class ACMRate:
   131	    """Capped, margin-bearing DVB-S2 ACM model."""
   132	
   133	    name: str = "ACM"
   134	
   135	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float:
   136	        if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
   137	            raise MCRLContractError("bandwidth must be finite and positive")
   138	        if not served_phy(sinr_linear):
   139	            return 0.0
   140	        mode = select_mode(sinr_linear)
   141	        return 0.0 if mode is None else bandwidth_hz * mode.spectral_efficiency_bit_per_s_hz
   142	
   143	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool:
   144	        return served_phy(sinr_linear, allocated=allocated)
   145	
   146	
   147	@dataclass(frozen=True)
   148	class UncappedShannonDiagnosticRate:
   149	    """Treatment U: uncapped Shannon rate with the common margin removed.
   150	
   151	    This is a diagnostic upper bound, not an ACM profile and not eligible as
   152	    the primary model.  Its allocation boundary is the lowest ideal table
   153	    threshold after the symbol-rate/bandwidth conversion, with margin off.
   154	    """
   155	
   156	    name: str = "U_UNCAPPED_SHANNON_MARGIN_OFF"
   157	
   158	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float:
   159	        if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
   160	            raise MCRLContractError("SINR must be finite and nonnegative")
   161	        if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
   162	            raise MCRLContractError("bandwidth must be finite and positive")
   163	        if sinr_linear < SHANNON_MIN:
   164	            return 0.0
   165	        return bandwidth_hz * math.log2(1.0 + sinr_linear)
   166	
   167	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool:
   168	        if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
   169	            raise MCRLContractError("SINR must be finite and nonnegative")
   170	        return bool(allocated and sinr_linear >= SHANNON_MIN)
   171	
   172	
   173	@dataclass(frozen=True)
   174	class UncappedShannonMarginKeptRate:
   175	    """U-cap: remove the SE ceiling while retaining the common margin floor."""
   176	
   177	    name: str = "U_CAP_UNCAPPED_SHANNON_MARGIN_KEPT"
   178	
   179	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float:
   180	        if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
   181	            raise MCRLContractError("SINR must be finite and nonnegative")
   182	        if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
   183	            raise MCRLContractError("bandwidth must be finite and positive")
   184	        if sinr_linear < SINR_MIN:
   185	            return 0.0
   186	        margin_linear = 10.0 ** (IMPLEMENTATION_MARGIN_DB / 10.0)
   187	        return bandwidth_hz * math.log2(1.0 + sinr_linear / margin_linear)
   188	
   189	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool:
   190	        if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
   191	            raise MCRLContractError("SINR must be finite and nonnegative")
   192	        return bool(allocated and sinr_linear >= SINR_MIN)
   193	
   194	
   195	@dataclass(frozen=True)
   196	class CappedACMMarginOffRate:
   197	    """U-margin: retain the ACM SE ceiling while removing the common margin."""
   198	
   199	    name: str = "U_MARGIN_CAPPED_ACM_MARGIN_OFF"
   200	
   201	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float:
   202	        if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
   203	            raise MCRLContractError("bandwidth must be finite and positive")
   204	        mode = select_mode_margin_off(sinr_linear)
   205	        return 0.0 if mode is None else bandwidth_hz * mode.spectral_efficiency_bit_per_s_hz
   206	
   207	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool:
   208	        return bool(allocated and select_mode_margin_off(sinr_linear) is not None)
   209	
   210	
   211	def rate_model(name: str) -> RateModel:
   212	    if name == "ACM":
   213	        return ACMRate()
   214	    if name == "U":
   215	        return UncappedShannonDiagnosticRate()
   216	    if name == "U-cap":
   217	        return UncappedShannonMarginKeptRate()
   218	    if name == "U-margin":
   219	        return CappedACMMarginOffRate()
   220	    raise MCRLContractError(f"unknown V0.25 rate model {name!r}")
   221	
