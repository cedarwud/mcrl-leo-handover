   521	def fixed_power_w(
   522	    radiating_beams_by_satellite: np.ndarray,  # noqa: E501 - name is deliberate
   523	    *,
   524	    circuit_power_w: float = CIRCUIT_POWER_PER_BEAM_W,
   525	    baseband_power_w: float = BASEBAND_POWER_PER_SATELLITE_W,
   526	) -> float:
   527	    """Paper eq. (3.16a): ``P^f = Σ_s (N^act_s·P_cir + 1{N^act_s>0}·P_BB)``.
   528	
   529	    The baseband term is charged **once per satellite**, not once per beam,
   530	    because a satellite's active beams share it.  Note this is a *partial*
   531	    payload-power model: You et al. also count local-oscillator and
   532	    phase-shifter power, which the paper excludes.
   533	
   534	    The argument is named "radiating beams **by** satellite" rather than
   535	    "per satellite" on purpose: it is a tally the power sum consumes, and
   536	    the G-6 gate rejects the ceiling vocabulary outright so that a count
   537	    sitting next to the power model can never be mistaken for a limit
   538	    (ruling C-6 — the beam↔RF-chain mapping must not reintroduce one).
   539	    """
   540	    counts = np.asarray(radiating_beams_by_satellite, dtype=np.float64)
