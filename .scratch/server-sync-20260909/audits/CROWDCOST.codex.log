   255	"""``ξ_max`` — **S**, eq. (3.15a)."""
   256	
   257	PA_OUTPUT_BACKOFF_DB: float = 5.0
   258	"""``BO`` — **S**, eq. (3.15a)."""
   259	
   260	PA_SATURATION_POWER_W: float = BEAM_POWER_MAX_W * 10.0 ** (
   261	    PA_OUTPUT_BACKOFF_DB / 10.0
   262	)
   263	"""``p_sat = p_max·10^(BO/10)`` — **D**, 5.218 W.
   264	
   265	Reassuringly, that is exactly ch5's legacy ``P_0 = 5.218 W``: the legacy
   266	"PA reference output power" was this same saturation point, so the two
   267	tables are consistent even though only one of them is active.
   268	"""
   269	
   270	CIRCUIT_POWER_PER_BEAM_W: float = 0.338
   271	"""``P_cir`` — **P'**, You et al. Table II (300 + 19 + 14 + 5 mW)."""
   272	
   273	BASEBAND_POWER_PER_SATELLITE_W: float = 0.200
   274	"""``P_BB`` — **P'**, You et al. Table II.  Shared by a satellite's beams."""
   275	
   276	BEAM_TO_RF_CHAIN_IS_SOURCED: bool = False
   277	"""One active beam ↔ one RF chain is a **modelling assumption**, not a fact.
   278	
   279	You et al. Table II supplies per-chain circuit power; it does **not**
   280	establish the correspondence.  Ruling C-6: disclose it as **S**, and SDD
   281	§2.6's prohibition stands — this mapping must never be used to argue a
   282	beam-count or per-satellite chain-count ceiling, which was deleted on
   283	2026-08-22 and must not return through the power model.
   284	"""
   285	
   286	RICIAN_K_FACTOR_DB: float = 20.0
   287	"""``K_R`` — **D⚠**, ch5 Table 5-2.
   288	
   289	Table I's row reads ``φ = 20 dB [5]``; reading ``φ`` as the Rician K factor
   290	is this project's interpretation and must be disclosed as such.  K = 100
   291	means a 100:1 LoS-to-scatter ratio, so the fading is shallow (about ±1 dB)
   292	— it will not swamp a probe, but it **is** a random draw and therefore
   293	belongs in the PREREG's frozen seed set.
   294	"""
   295	
   296	
   297	def rician_fading_gain(
   298	    rng: np.random.Generator,
   299	    size: tuple[int, ...],
   300	    *,
   301	    k_factor_db: float = RICIAN_K_FACTOR_DB,
   302	) -> np.ndarray:
   303	    """Rician small-scale power gain with **unit mean**, part of ``H``.
   304	
   305	    Unit mean matters: the fading must redistribute power around the
   306	    deterministic link budget, not shift it.  A draw whose mean differed
   307	    from 1 would bias every EE number in one direction while looking like
   308	    noise.
   309	    """
   310	    k_linear = 10.0 ** (float(k_factor_db) / 10.0)
   311	    if k_linear < 0.0:
   312	        raise ValueError("the K factor must be non-negative")
   313	    line_of_sight = np.sqrt(k_linear / (k_linear + 1.0))
   314	    scatter_sigma = np.sqrt(1.0 / (2.0 * (k_linear + 1.0)))
   315	    real = line_of_sight + scatter_sigma * rng.standard_normal(size)
   316	    imaginary = scatter_sigma * rng.standard_normal(size)
   317	    return real * real + imaginary * imaginary
   318	
   319	
   320	def free_space_path_gain(slant_km: np.ndarray) -> np.ndarray:
   321	    """Linear FSPL gain ``(λ/4πd)²``.  Multiply, do not divide."""
   322	    slant = np.asarray(slant_km, dtype=np.float64)
   323	    if np.any(slant <= 0.0):
   324	        raise MCRLContractError("slant range must be positive")
   325	    wavelength_m = SPEED_OF_LIGHT_M_S / CARRIER_FREQ_HZ
   326	    return (wavelength_m / (4.0 * math.pi * slant * 1000.0)) ** 2
   327	
   328	
   329	def atmospheric_loss_db(elevation_deg: np.ndarray) -> np.ndarray:
   330	    """TR 38.811 eq. (6.6-8): ``A_zenith / sin(elevation)``, dB, positive."""
   331	    elevation = np.asarray(elevation_deg, dtype=np.float64)
   332	    if np.any(elevation < -90.0) or np.any(elevation > 90.0):
   333	        raise MCRLContractError("elevation must lie in [-90, 90] degrees")
   334	    sin_elevation = np.maximum(
   335	        np.sin(np.radians(elevation)), _MIN_SIN_ELEVATION
   336	    )
   337	    return ZENITH_GASEOUS_LOSS_DB / sin_elevation
   338	
   339	
   340	def total_path_loss_db(
   120	
   121	    The population (4.5a)'s follow-on sentence describes: the recurrence
   122	    power exceeded the per-beam RF ceiling, so the user is in outage for
   123	    this step.  Its rate must be reported — a large one means the geometry
   124	    is outrunning the power budget rather than the policy choosing badly.
   125	    """
   126	
   127	    @property
   128	    def served_count(self) -> int:
   129	        return int(np.count_nonzero(self.served))
   130	
   131	    @property
   132	    def active_beams(self) -> tuple[tuple[int, int], ...]:
   133	        """Beams with positive eligible load, as sorted ``(norad_id, cell_id)``.
   134	
   135	        ``z_{s,v}(t) = 1{ U_{s,v}(t) > 0 }`` — activation is **derived, not
   136	        chosen** (ruling 2026-08-22 §7.4).  There is no selection step, no
   137	        ranking, and no ceiling: every cell with at least one served user is
   138	        lit, always.
   139	
   140	        The alternative was measured once already: the repo-invented
   141	        activation ceiling of 2026-07-15 darkened beams by demand rank and
   142	        starved 68 of 100 users, inverting the congestion incentive.  It
   143	        would also fight ``r3 = −U_{b_u}``, which rewards moving to a
   144	        *quieter* beam, while any demand-ranked darkening rule extinguishes
   145	        the quiet beams first.
   146	        """
   147	        return tuple(sorted(self.eligible_load_by_beam))
   148	
   149	    def activation_vector(
   150	        self, beam_keys: Sequence[tuple[int, int]]
   151	    ) -> np.ndarray:
   152	        """``z`` over an explicit beam ordering, derived from the loads alone."""
   153	        return np.array(
   154	            [
   155	                self.eligible_load_by_beam.get(
   156	                    (int(norad), int(cell)), 0
   157	                )
   158	                > 0
   159	                for norad, cell in beam_keys
   160	            ],
   161	            dtype=bool,
   162	        )
   163	
   164	    def user_beam_load(self) -> np.ndarray:
   165	        """``U_{b_u}`` per user: the eligible load of the beam serving them.
   166	
   167	        Zero for an unserved user — they are on no beam, so they contribute
   168	        nothing and are charged nothing (consistent with ``Ψ = 0`` and
   169	        ``r1 ≈ 0`` for the same step).
   170	        """
   171	        loads = np.zeros(self.served.size, dtype=np.float64)
   172	        for uid in range(self.served.size):
   173	            if self.served[uid]:
   174	                loads[uid] = float(
   175	                    self.eligible_load_by_beam[
   176	                        (
   177	                            int(self.serving_satellite[uid]),
   178	                            int(self.serving_cell[uid]),
   179	                        )
   180	                    ]
   181	                )
   182	        return loads
   183	
   184	
   185	def resolve_service(
   186	    actions: np.ndarray,
   187	    decision_tables: Sequence[SlotTable],
   188	    link_infeasible: np.ndarray,
   189	) -> ServiceResolution:
   190	    """Resolve one step: ``x = a · z``, then per-link feasibility.
   191	
   192	    ``decision_tables`` are the slot tables the actions were chosen against.
   193	    ``link_infeasible`` is ``(U,)`` — whether each user's chosen link needs
   194	    more power than the per-beam ceiling allows.  Infeasible users are
   195	    excluded from load, activation and power, while their pre-admission
   196	    demand still appears in ``demand_by_beam``.
   197	
   198	    The ``z`` gate is satisfied by construction: a beam radiates iff someone
   199	    selects it (3.4), so anyone who selected it and is feasible connects.
   200	    Writing it out anyway keeps (4.5a) visible in the code.
   201	    """
   202	    selected = np.asarray(actions)
   203	    if selected.dtype.kind not in "iu":
   204	        raise MCRLContractError("actions must be integers")
   205	    users = selected.size
   206	    if len(decision_tables) != users:
   207	        raise MCRLContractError("one decision slot table per user is required")
   208	    infeasible = np.asarray(link_infeasible, dtype=bool)
   209	    if infeasible.shape != (users,):
   210	        raise MCRLContractError(
   211	            f"link_infeasible must have shape ({users},), got {infeasible.shape}"
   212	        )
   213	
   214	    served = np.zeros(users, dtype=bool)
   215	    no_op = np.zeros(users, dtype=bool)
   216	    outage = np.zeros(users, dtype=bool)
   217	    serving_cell = np.full(users, -1, dtype=np.int64)
   218	    serving_satellite = np.full(users, -1, dtype=np.int64)
   219	    demand: dict[tuple[int, int], int] = {}
   220	    eligible: dict[tuple[int, int], int] = {}
   221	
   222	    for uid in range(users):
   223	        action = int(selected[uid])
   224	        if action == NO_OP_ACTION:
   225	            no_op[uid] = True
   226	            continue
   227	        if not 0 <= action < NUM_ACTIONS:
   228	            raise MCRLContractError(f"user {uid} action {action} out of range")
   229	        table = decision_tables[uid]
   230	        if not bool(table.mask[action]):
   231	            raise MCRLContractError(
   232	                f"user {uid} action {action} was invalid at decision time; "
   233	                "P-4 should have caught this before execution"
   234	            )
   235	
   236	        association = table.association(action)
   237	        cell = association.cell_id
   238	        beam = (association.norad_id, cell)
   239	        # Pre-admission demand counts every intent, gated or not.
   240	        demand[beam] = demand.get(beam, 0) + 1
   241	
   242	        if bool(infeasible[uid]):
   243	            # (4.5a)'s follow-on: connected, but the link needs more power
   244	            # than the beam ceiling allows, so this step is an outage.
   245	            outage[uid] = True
   246	            continue
   247	
   248	        served[uid] = True
   249	        serving_cell[uid] = cell
   250	        serving_satellite[uid] = association.norad_id
   251	        eligible[beam] = eligible.get(beam, 0) + 1
   252	
   253	    return ServiceResolution(
   254	        served=served,
   255	        serving_cell=serving_cell,
   256	        serving_satellite=serving_satellite,
   257	        demand_by_beam=demand,
   258	        eligible_load_by_beam=eligible,
   259	        no_op_users=no_op,
   260	        outage_infeasible=outage,
   261	    )
   262	
   263	
   264	def r3_counting(resolution: ServiceResolution) -> np.ndarray:
   265	    """B13: ``r3,u(t) = −U_{b_u}(t)``.
   266	
   267	    G-4 (decomposability): each user's value depends **only** on the load of
   268	    the beam they chose.  No global scalar appears, so one user's reward
   269	    cannot move because a beam they are not on got busier.
   270	
   271	    Algebraically ``Σ_u U_{b_u} = Σ_b U_b²``, which for a fixed total is
   272	    minimised by a perfectly even spread — so maximising ``Σ_u r3,u`` is
   273	    load balancing, and with empty beams present it degenerates to min-max
   274	    balancing.  Both are legitimate objectives; the old form was blind to
   275	    load because ``U_{s,v}`` cancelled out of it entirely.
   276	    """
   277	    return -resolution.user_beam_load()
   278	
   279	
   280	def load_balance_identity(resolution: ServiceResolution) -> tuple[float, float]:
   281	    """Return ``(Σ_u U_{b_u}, Σ_b U_b²)`` — equal by construction."""
   282	    per_user = float(resolution.user_beam_load().sum())
   283	    per_beam = float(
   284	        sum(count * count for count in resolution.eligible_load_by_beam.values())
   285	    )
   286	    return per_user, per_beam
   287	
   288	
   289	# PATCH P-22 (W-26): ``required_sinr()`` is deleted.
   290	#
   291	# It computed ``γ_req(U) = 2^(R^m·U/B^w) − 1``, the SINR needed to hold a
   292	# minimum rate at a given load.  Three reasons, any one of which would do:
   293	#
   294	#   * **zero live consumers** — only tests called it;
   295	#   * ``R^m = 1 Mbit/s`` is a **legacy-only** parameter (ruling C-12), and
   296	#     the active contract "明文排除最低速率反推";
   297	#   * ruling C-2 forbids target-SINR inversion outright, and this is its
   298	#     first half sitting in the tree with nothing but tests holding it up.
   299	#
   300	# The PREREG had it frozen as a live consumer of the eligible load, which
   301	# is how a dead surface becomes a permanent claim about the system.
   302	
   303	@dataclass(frozen=True)
   304	class R3CalibrationSample:
   305	    """One step's ``r3`` statistics, for the Q-D scale decision."""
   306	
   307	    served: int
   308	    mean_abs_r3: float
   309	    max_abs_r3: float
   310	    spread: float
   311	    """Width of ``U_{b_u}`` across the population — P3's discriminability input."""
   312	
   313	
   314	def sample_r3_calibration(resolution: ServiceResolution) -> R3CalibrationSample:
   315	    """Collect what Q-D needs, without choosing the scale.
   316	
   317	    While Q-D was open, this deliberately reported statistics rather than
   318	    returning a scale: picking one from data the probe has already seen is
   319	    exactly the adaptive-leak §7.1 forbids.
   320	    """
   321	    values = np.abs(r3_counting(resolution))
   322	    served = resolution.served_count
   323	    if served == 0:
   324	        return R3CalibrationSample(0, 0.0, 0.0, 0.0)
   325	    served_values = values[resolution.served]
   326	    return R3CalibrationSample(
   327	        served=served,
   328	        mean_abs_r3=float(served_values.mean()),
   329	        max_abs_r3=float(served_values.max()),
   330	        spread=float(served_values.max() - served_values.min()),
   331	    )
   332	
   333	
   334	def old_r3_is_load_blind(
   335	    loads: Sequence[float], *, spectral_efficiency: float = 1.0
   336	) -> bool:
   337	    """Demonstrate the defect B13 fixed: ``U_{s,v}`` cancels out of the old form.
   338	
   339	    The old ``r3`` was ``R̃ = B^w · mean_u log₂(1 + γ_u)``.  Per-user rate is
   340	    ``(B/U)·log₂(1+γ)`` and the mean over the beam's ``U`` users multiplies
   341	    it straight back by ``U``, so the load disappears and the reward cannot
   342	    see it.  Returns True when the old form gives the same value for every
   343	    load — which it always does.
   344	    """
   345	    values = set()
   346	    for load in loads:
   347	        if load <= 0:
   348	            continue
   349	        per_user_rate = spectral_efficiency / load
   350	        values.add(round(per_user_rate * load, 12))
   351	    return len(values) <= 1
     1	"""``StepEnvironment`` — the whole chain, from ephemeris to reward vector.
     2	
     3	Everything below this file was already built and tested in isolation; this
     4	is where the pieces are wired into one step function and where the physics
     5	finally produces numbers instead of interfaces.
     6	
     7	The order inside one step is not arbitrary, and getting it wrong is the
     8	classic way to build an environment that looks right and is not::
     9	
    10	    actions (validated against the DECISION-time mask)
    11	      -> per-link recurrence power p_{u,s,v}          (3.11)/(3.12)
    12	      -> per-link feasibility, p > p_max              -> outage
    13	      -> service resolution, x = a·z                  (3.1)-(3.4), C-11
    14	      -> loads U_{s,v}, activation z = 1{U > 0}       (3.3)/(3.4)
    15	      -> beam power p_{s,v} = max over served users   (3.12a preamble)
    16	      -> interference I^intra + I^inter               (3.12a)/(3.12b)
    17	      -> SINR gamma                                   (3.13)
    18	      -> rate R = (B^w/U)·log2(1+gamma)               (3.14)
    19	      -> supply power P^p = p/xi, fixed P^f, total P^N (3.15)-(3.16a)
    20	      -> r1 = R/P^N, r2 = -Psi, r3 = -U_{b_u}         (3.25)/(3.27)/(3.28)
    21	
    22	**There is no fixed point in that chain, and that is a property worth
    23	knowing.**  ``p`` depends only on the off-axis angle, never on load or on
    24	interference, so the power model cannot chase the SINR it produces.  An
    25	implementation that made ``p`` depend on ``γ`` — a target-SINR inversion,
    26	say — would need to iterate, and ruling C-2 forbids exactly that.
    27	
    28	**Two SINRs, deliberately different, never interchangeable.**  The realised
    29	link SINR of (3.13) is what the reward is built from.  The state's ``γ``
    30	block (4.1) is a *pre-action* quantity over all 28 candidates and cannot see
    31	this step's activations, so it is built against the previous step's
    32	radiating set under a named provenance
    33	(:data:`~mcrl.env.interference.CANDIDATE_SINR_PROVENANCE`).  Quoting one as
    34	the other would be a leak of post-action information into the state.
    35	
    36	Each served segment starts at ``p⁰ = p_max/2 = 0.825 W``, leaving the frozen
    37	3 dB in-segment gain budget below ``p_max = 1.65 W``.  Link feasibility still
    38	fails loudly whenever the angle recurrence requires more than the ceiling;
    39	:meth:`StepEnvironment.assert_ready_to_train` verifies the adopted mapping
    40	before a training run.
    41	"""
