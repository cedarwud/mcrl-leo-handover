/bin/bash -lc "env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python - <<'PY'
import hashlib, json, math, pathlib, struct
root = pathlib.Path('/home/sat/mcrl-v025-rank-ws')
p = root/'.scratch/multistart-capped/rescored.json'
d = json.loads(p.read_text(encoding='ascii'))
assert d['schema'] == 'mcrl-v025-multistart-demand-capped-v2'
assert d['claim'] == 'DIAGNOSTIC_NOT_CLAIM'
assert len(d['anchors']) == 16
assert sum(len(a['endpoints']) for a in d['anchors']) == 128
assert d['serialized_records_verification']['passed']
assert d['serialized_records_verification']['endpoint_count'] == 128
assert d['serialized_records_verification']['user_endpoint_count'] == 12800
assert d['provenance']['rescore_runner_sha256'] == hashlib.sha256((root/'.scratch/multistart-capped/rescore_multistart.py').read_bytes()).hexdigest()

def ordered(x):
    b = struct.unpack('>Q', struct.pack('>d', float(x)))[0]
    return ((~b)&((1<<64)-1)) if b&(1<<63) else b|(1<<63)

dists=[]
for a in d['anchors']:
    for e in a['endpoints']:
        for key in ('endpoint_capacity_parity','recorded_F_best_swap_capacity_parity'):
            rows=e[key]
            assert rows is not None
            assert rows['served_count']['exact_equal']
            for f in ('bits','joules','ee_bit_per_j'):
                q=rows[f]
                dist=abs(ordered(q['actual'])-ordered(q['expected']))
                assert dist == q['ulp_distance_from_receipt'] and dist <= 2
                dists.append(dist)
        m=e['endpoint']
        u=m['per_user_bits']
        assert len(u)==100
        cap=math.fsum(u)
        capped=math.fsum(min(x,1.504e9) for x in u)
        attained=math.fsum(x for x in u if x>=1.504e9)
        assert cap == m['accounting']['CAPACITY']['credited_bits'] == m['bits']
        assert capped == m['accounting']['DEMAND_CAPPED']['credited_bits']
        assert attained == m['accounting']['ATTAINMENT_ONLY']['credited_bits']
        assert capped <= cap
assert len(dists)==768 and dists.count(1)==9 and sum(x>1 for x in dists)==0
s={x['rule']:x for x in d['summaries']}
expected={'SEALED':(34570961.435797244,38356680.122798525),'MARGIN_Q':(47120579.60864339,48608740.58470494)}
for rule,(ref,best) in expected.items():
    n=s[rule]['numerators']['CAPACITY']
    assert n['nearest_start_reference']['efficiency_bit_per_j']==ref
    assert n['pooled_best_found_including_recorded_F_best_swaps']['efficiency_bit_per_j']==best
assert round(100*s['SEALED']['numerators']['DEMAND_CAPPED']['reference_below_best_found'],4)==9.8698
