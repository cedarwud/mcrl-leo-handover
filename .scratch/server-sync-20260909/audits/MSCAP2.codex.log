    by_id = {}
    pair_by_id = {}
    pair_count = 0
    for left_index, left in enumerate(users):
        left_identity = current[left]
        for right in users[left_index + 1 :]:
            right_identity = current[right]
            if left_identity == right_identity or left_identity is None or right_identity is None:
                continue
            if right_identity not in options[left] or left_identity not in options[right]:
                continue
            swapped = dict(current)
            swapped[left], swapped[right] = right_identity, left_identity
            candidate = reference._configuration(true_base, swapped, "demand-capped-two-user-swap-audit")
            pair_count += 1
            by_id.setdefault(candidate.configuration_id, candidate)
            pair_by_id.setdefault(candidate.configuration_id, (left, right))
    return tuple(by_id.values()), pair_by_id, pair_count


def swap_audit(reference, tape, step, true_base, endpoint, endpoint_metric, options, guard, receipt_swap):
    candidates, pair_by_id, pair_count = swap_candidates(reference, true_base, endpoint, options)
    if pair_count != int(receipt_swap["legal_swap_pair_count"]):
        raise RuntimeError(f"swap pair count mismatch: {pair_count}")
    selection = reference.probe.StepEvaluator(
        tape,
        reference.probe._setting("a-r0"),
        step,
        transition_from=true_base,
        field="realised",
        run_setting=reference.probe.run_setting_for("a-r0"),
        boundary_indices=(0,),
        fading_quantile_alpha=0.10,
    )
    selection.evaluate_many(candidates)
    eligible = []
    invalid = 0
    below_guard = 0
    for candidate in candidates:
        profile = selection._evaluated.get(candidate.configuration_id)
        if profile is None:
            invalid += 1
        elif reference.served(profile) < guard:
            below_guard += 1
        else:
            eligible.append(candidate)

    committed = reference.probe.StepEvaluator(
        tape,
        reference.probe._setting("a-r0"),
        step,
        transition_from=true_base,
        field="realised",
        run_setting=reference.probe.run_setting_for("a-r0"),
        boundary_indices=BOUNDARIES,
        fading_quantile_alpha=0.10,
    )
    committed.evaluate_many(tuple(eligible))
    current_ee = endpoint_metric["accounting"]["DEMAND_CAPPED"]["efficiency_bit_per_j"]
    improving = []
    for candidate in eligible:
        profile = committed._evaluated.get(candidate.configuration_id)
        if profile is None:
            invalid += 1
            continue
        values = [float(profile.score.bits[user]) for user in sorted(profile.score.bits)]
        candidate_ee = accounting(values, float(profile.joules))["DEMAND_CAPPED"][
            "efficiency_bit_per_j"
        ]
        if candidate_ee > current_ee:
            improving.append((candidate_ee, candidate.configuration_id, pair_by_id[candidate.configuration_id]))
    best = max(improving, default=None, key=lambda row: (row[0], tuple(-x for x in row[2])))
    return {
        "predeclared_subset_member": True,
        "legal_swap_pair_count": pair_count,
        "unique_legal_swap_configuration_count": len(candidates),
        "physically_invalid_count": invalid,
        "below_unchanged_selection_served_guard_count": below_guard,
        "eligible_committed_swap_count": len(eligible),
        "strictly_demand_capped_improving_swap_count": len(improving),
        "is_demand_capped_two_swap_optimal": not improving,
        "endpoint_demand_capped_efficiency_bit_per_j": current_ee,
        "best_improving_swap": None
        if best is None
        else {
            "users": list(best[2]),
            "configuration_id": best[1],
            "demand_capped_efficiency_bit_per_j": best[0],
            "relative_gain_over_endpoint": best[0] / current_ee - 1.0,
        },
        "receipt_F_is_two_swap_optimal": bool(receipt_swap["is_two_swap_optimal"]),
        "receipt_F_feasible_improving_swap_count": int(
            receipt_swap["feasible_improving_swap_count"]
        ),
    }


def run_anchor_job(task):
    rule, world, step = task
    started = time.perf_counter()
    if str(HARNESS) not in sys.path:
        sys.path.insert(0, str(HARNESS))
    from harness.runner import install_variant
    from harness import sealed as sealed_module

    sealed_module.verify()
    reference = sealed_module.reference_runner()
    receipt_file = receipt_path(rule, world, step)
    source = load_receipt(receipt_file)
    source_anytime = load_receipt(
        HARNESS
        / "receipts"
        / ("anytime-sealed-full20.json" if rule == "SEALED" else "anytime-margin-q-full20.json")
    )
    world_row = next(row for row in source_anytime["worlds"] if int(row["world_index"]) == world)
    tape_path = HARNESS / ".harness-cache/worlds" / f"{world_row['cache_key']}.pickle"
    tape = pickle.loads(tape_path.read_bytes())
    if tape.digest != source["world_sha256"]:
        raise RuntimeError("world digest mismatch")

    install_variant(rule)
    true_base = reference.probe._base_configuration(tape, step, "nearest-eligible")
    options, _census = reference.probe._legal_options(tape, step)
    arrays = tape.steps[step].arrays
    if arrays is None:
        raise RuntimeError("world step lacks primitive arrays")
    module = instrumented_module(
        SEALED_BATCH if rule == "SEALED" else MARGIN_BATCH,
        f"rescoring_{rule.lower()}_{world}_{step}_{os.getpid()}",
    )
    run_setting = reference.probe.run_setting_for("a-r0")

    evaluated = []
    for endpoint_row in source["endpoints"]:
        start_index = int(endpoint_row["start_index"])
        expected = endpoint_row["endpoint"]
        config = reconstruct(reference, true_base, expected, "recorded-multistart-endpoint-replay")
        actual = run_instrumented(module, arrays, config, run_setting)
        endpoint_parity = parity(actual, expected)

        swap = endpoint_row["two_swap"]["best_improving_swap"]
        swap_result = None
        swap_parity = None
        if swap is not None:
            swap_expected = swap["committed"]
            swap_config = reconstruct(
                reference, true_base, swap_expected, "recorded-F-best-two-swap-replay"
            )
            swap_result = original_profile(reference, tape, step, true_base, swap_config)
            if swap_result is None:
                raise RuntimeError("recorded committed swap became invalid")
            swap_parity = parity(swap_result, swap_expected)
            swap_result.update(
                {
                    "configuration_id": swap_expected["configuration_id"],
                    "users": swap["users"],
                    "source": "recorded F-best swap only; no swap search rerun",
                }
            )

        audit = None
        if (rule, world, step, start_index) in SWAP_AUDIT_SUBSET:
            audit = swap_audit(
                reference,
                tape,
                step,
                true_base,
                config,
                actual,
                options,
                int(source["baseline_served_guard"]),
                endpoint_row["two_swap"],
            )

        evaluated.append(
            {
                "start_index": start_index,
                "configuration_id": expected["configuration_id"],
                "endpoint": actual,
                "endpoint_capacity_parity": endpoint_parity,
                "recorded_F_best_swap": swap_result,
                "recorded_F_best_swap_capacity_parity": swap_parity,
                "demand_capped_swap_audit": audit,
                "receipt_F_two_swap": {
                    "is_two_swap_optimal": endpoint_row["two_swap"]["is_two_swap_optimal"],
                    "feasible_improving_swap_count": endpoint_row["two_swap"][
                        "feasible_improving_swap_count"
                    ],
                    "legal_swap_pair_count": endpoint_row["two_swap"]["legal_swap_pair_count"],
                },
            }
        )
    result = {
        "rule": rule,
        "anchor": anchor_name(world, step),
        "anchor_id": source["anchor_id"],
        "world_index": world,
        "step_index": step,
        "world_sha256": source["world_sha256"],
        "receipt_path": str(receipt_file),
        "receipt_sha256": source["receipt_sha256"],
        "baseline_served_guard": source["baseline_served_guard"],
        "endpoints": evaluated,
        "wall_seconds": time.perf_counter() - started,
    }
    partial = OUTPUT_ROOT / f"partial-{rule.lower()}-w{world}-s{step}.json"
    partial.write_text(
        json.dumps(result, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
        encoding="ascii",
    )
    return str(partial), result["wall_seconds"]


def endpoint_candidate_rows(anchor: Mapping[str, object], numerator: str, include_swaps: bool):
    rows = []
    for endpoint in anchor["endpoints"]:
        metric = endpoint["endpoint"]
        rows.append(
            {
                "kind": "endpoint",
                "start_index": endpoint["start_index"],
                "configuration_id": endpoint["configuration_id"],
                "metric": metric,
                "ee": metric["accounting"][numerator]["efficiency_bit_per_j"],
            }
        )
        if include_swaps and endpoint["recorded_F_best_swap"] is not None:
            swap = endpoint["recorded_F_best_swap"]
            rows.append(
                {
                    "kind": "recorded_F_best_swap",
                    "start_index": endpoint["start_index"],
                    "configuration_id": swap["configuration_id"],
                    "metric": swap,
                    "ee": swap["accounting"][numerator]["efficiency_bit_per_j"],
                }
            )
    return rows


def select_best(rows):
    return min(rows, key=lambda row: (-row["ee"], row["configuration_id"]))


def pooled(selected, numerator: str):
    bits = math.fsum(row["metric"]["accounting"][numerator]["credited_bits"] for row in selected)
    joules = math.fsum(row["metric"]["joules"] for row in selected)
    return {"credited_bits": bits, "joules": joules, "efficiency_bit_per_j": bits / joules}


def summarize_rule(anchors, rule: str):
    rule_anchors = [row for row in anchors if row["rule"] == rule]
    by_key = {(row["world_index"], row["step_index"]): row for row in rule_anchors}
    ordered = [by_key[key] for key in ANCHORS]
    numerators = {}
    for numerator in ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY"):
        nearest_rows = [
            {
                "metric": next(e for e in anchor["endpoints"] if e["start_index"] == 0)["endpoint"]
            }
            for anchor in ordered
        ]
        nearest = pooled(nearest_rows, numerator)
        same_index = []
        for start in STARTS:
            rows = [
                {
                    "metric": next(e for e in anchor["endpoints"] if e["start_index"] == start)[
                        "endpoint"
                    ]
                }
                for anchor in ordered
            ]
            same_index.append({"start_index": start, **pooled(rows, numerator)})
        endpoint_best_rows = [
            select_best(endpoint_candidate_rows(anchor, numerator, False)) for anchor in ordered
        ]
        best_of_8 = pooled(endpoint_best_rows, numerator)
        found_rows = [
            select_best(endpoint_candidate_rows(anchor, numerator, True)) for anchor in ordered
        ]
        best_found = pooled(found_rows, numerator)
        capacity_choice_rows = [
            select_best(endpoint_candidate_rows(anchor, "CAPACITY", True)) for anchor in ordered
        ]
        capacity_choice_rescore = pooled(capacity_choice_rows, numerator)
        anchor_spreads = []
        for anchor in ordered:
            values = [
                endpoint["endpoint"]["accounting"][numerator]["efficiency_bit_per_j"]
                for endpoint in anchor["endpoints"]
            ]
            anchor_spreads.append(
                {
                    "anchor": anchor["anchor"],
                    "relative_spread_max_over_min_minus_one": max(values) / min(values) - 1.0,
                }
            )
        same_values = [row["efficiency_bit_per_j"] for row in same_index]
        numerators[numerator] = {
            "nearest_start_reference": nearest,
            "pooled_same_index_starts": same_index,
            "pooled_same_index_start_spread_max_over_min_minus_one": max(same_values)
            / min(same_values)
            - 1.0,
            "anchor_start_spreads": anchor_spreads,
            "maximum_anchor_spread_max_over_min_minus_one": max(
                row["relative_spread_max_over_min_minus_one"] for row in anchor_spreads
            ),
            "pooled_per_anchor_best_of_8": best_of_8,
            "pooled_best_found_including_recorded_F_best_swaps": best_found,
            "best_found_selection": [
                {
                    "anchor": anchor["anchor"],
                    "kind": row["kind"],
                    "start_index": row["start_index"],
                    "configuration_id": row["configuration_id"],
                }
                for anchor, row in zip(ordered, found_rows, strict=True)
            ],
            "best_found_exceeds_reference": best_found["efficiency_bit_per_j"]
            / nearest["efficiency_bit_per_j"]
            - 1.0,
            "best_found_exceeds_reference_denominator": "nearest_start_reference_efficiency",
            "reference_below_best_found": 1.0
            - nearest["efficiency_bit_per_j"] / best_found["efficiency_bit_per_j"],
            "reference_below_best_found_denominator": "best_found_efficiency",
            "frozen_capacity_selected_best_found_rescore": capacity_choice_rescore,
        }

    split = {
        "nearest_reference_attainers": {
            "user_anchor_count": 0,
            "capacity_extra_bits": 0.0,
            "demand_capped_extra_bits": 0.0,
        },
        "nearest_reference_non_attainers": {
            "user_anchor_count": 0,
            "capacity_extra_bits": 0.0,
            "demand_capped_extra_bits": 0.0,
        },
    }
    for anchor in ordered:
        reference_metric = next(e for e in anchor["endpoints"] if e["start_index"] == 0)[
            "endpoint"
        ]
        best = select_best(endpoint_candidate_rows(anchor, "CAPACITY", True))["metric"]
        for reference_bits, best_bits in zip(
            reference_metric["per_user_bits"], best["per_user_bits"], strict=True
        ):
            cohort = (
                "nearest_reference_attainers"
                if reference_bits >= DEMAND_BITS
                else "nearest_reference_non_attainers"
            )
            split[cohort]["user_anchor_count"] += 1
            split[cohort]["capacity_extra_bits"] += best_bits - reference_bits
            split[cohort]["demand_capped_extra_bits"] += min(best_bits, DEMAND_BITS) - min(
                reference_bits, DEMAND_BITS
            )
    total = math.fsum(row["capacity_extra_bits"] for row in split.values())
    for row in split.values():
        row["share_of_capacity_increment"] = row["capacity_extra_bits"] / total
    return {"rule": rule, "numerators": numerators, "extra_capacity_cohorts": split}


def pct(value: float, digits: int = 4) -> str:
    return f"{100.0 * value:.{digits}f}%"


def signed_pct(value: float, digits: int = 4) -> str:
    return f"{100.0 * value:+.{digits}f}%"


def ee(value: float) -> str:
    return f"{value / 1e6:.6f}"


def gbit(value: float) -> str:
    return f"{value / 1e9:.6f}"


