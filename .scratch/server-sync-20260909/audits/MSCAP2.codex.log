def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")


def digest(value: object) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def receipt_digest(payload: Mapping[str, object]) -> str:
    unsigned = dict(payload)
    unsigned.pop("receipt_sha256", None)
    return digest(unsigned)


def load_receipt(path: Path) -> dict:
    payload = json.loads(path.read_text(encoding="ascii"))
    actual = receipt_digest(payload)
    if actual != payload.get("receipt_sha256"):
        raise RuntimeError(f"receipt digest mismatch: {path}: {actual}")
    return payload


def anchor_name(world: int, step: int) -> str:
    return f"w{world}/s{step}"


def receipt_path(rule: str, world: int, step: int) -> Path:
    return SOURCE_ROOT / f"{rule.lower()}-w{world}-s{step}.json"


def mapping(metric: Mapping[str, object]) -> dict[int, tuple[int, int] | None]:
    return {
        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
        for user, identity in metric["assignments"]
    }


def float_bits(value: float) -> str:
    return struct.pack(">d", float(value)).hex()


def equality_row(actual: float, expected: float) -> dict[str, object]:
    return {
        "actual": actual,
        "expected": expected,
        "actual_binary64_hex": float_bits(actual),
        "expected_binary64_hex": float_bits(expected),
        "exact_binary64_equal": actual == expected,
        "absolute_difference": actual - expected,
    }


def accounting(per_user_bits: Sequence[float], joules: float) -> dict[str, dict[str, float]]:
    attained = tuple(value >= DEMAND_BITS for value in per_user_bits)
    credited = {
        "CAPACITY": math.fsum(per_user_bits),
        "DEMAND_CAPPED": math.fsum(min(value, DEMAND_BITS) for value in per_user_bits),
        "ATTAINMENT_ONLY": math.fsum(
            value for value, flag in zip(per_user_bits, attained, strict=True) if flag
        ),
    }
    return {
        name: {"credited_bits": bits, "efficiency_bit_per_j": bits / joules}
        for name, bits in credited.items()
    }


class SubslotRecorder:
    def __init__(self, arrays, selected_rows) -> None:
        self.users = tuple(int(value) for value in arrays.users)
        self.identities = tuple(
            None
            if int(row) < 0
            else (
                int(arrays.identities[int(row), 0]),
                int(arrays.identities[int(row), 1]),
            )
            for row in selected_rows[0]
        )
        self.boundaries: list[dict[str, object]] = []
        self._boundary = -1
        self._cursor = Fraction(0, 1)

    def __call__(
        self,
        boundary,
        fraction,
        midpoint,
        active,
        slot_rate,
        power,
        mode_index,
        has_tx_mode,
        served,
    ) -> None:
        boundary = int(boundary)
        if boundary != self._boundary:
            if self._boundary >= 0 and self._cursor != 1:
                raise RuntimeError(f"subslots did not partition boundary {self._boundary}")
            self._boundary = boundary
            self._cursor = Fraction(0, 1)
            self.boundaries.append(
                {
                    "boundary_index": boundary,
                    "boundary_time_s": float(boundary * BOUNDARY_STEP_S),
                    "endpoint_trapezoid_weight": 0.5 if boundary in {0, 47} else 1.0,
                    "subslots": [],
                }
            )
        exact_fraction = Fraction(float(fraction)).limit_denominator(1_000_000)
        start = self._cursor
        end = start + exact_fraction
        transmissions = []
        for column, flag in enumerate(active):
            if not bool(flag):
                continue
            identity = self.identities[column]
            if identity is None:
                raise RuntimeError("active user has NULL identity")
            delivered = float(float(fraction) * float(slot_rate[column]) * BOUNDARY_STEP_S)
            transmissions.append(
                [
                    self.users[column],
                    identity[0],
                    identity[1],
                    delivered,
                    float(power[column]),
                    int(mode_index[column]) if bool(has_tx_mode[column]) else -1,
                    bool(served[column]),
                ]
            )
        self.boundaries[-1]["subslots"].append(
            {
                "rational_subslot_start": [start.numerator, start.denominator],
                "rational_subslot_end": [end.numerator, end.denominator],
                "midpoint_binary64": float(midpoint),
                "transmissions": transmissions,
            }
        )
        self._cursor = end

    def finish(self) -> list[dict[str, object]]:
        if self._boundary != 47 or self._cursor != 1:
            raise RuntimeError("recording did not finish a complete 48-boundary endpoint")
        if [row["boundary_index"] for row in self.boundaries] != list(BOUNDARIES):
            raise RuntimeError("recording boundary order is incomplete")
        return self.boundaries


def instrumented_module(path: Path, name: str):
    """Load an in-memory copy with one post-rate callback and no equation edits."""

    source = path.read_text(encoding="utf-8")
    import_needle = "import numpy as np\n"
    if source.count(import_needle) != 1:
        raise RuntimeError(f"unexpected NumPy import seam in {path}")
    source = source.replace(import_needle, import_needle + "\n_RECORD_CALLBACK = None\n", 1)
    rate_needle = (
        "                slot_rate = np.where(served, chosen_efficiency * "
        "BEAM_BANDWIDTH_HZ, 0.0)\n"
    )
    if source.count(rate_needle) != 1:
        raise RuntimeError(f"unexpected slot-rate seam in {path}")
    callback = (
        rate_needle
        + "                if _RECORD_CALLBACK is not None:\n"
        + "                    _RECORD_CALLBACK(\n"
        + "                        boundary, fraction, midpoint, active[0].copy(),\n"
        + "                        slot_rate[0].copy(), power[0].copy(),\n"
        + "                        mode_index[0].copy(), has_tx_mode[0].copy(),\n"
        + "                        served[0].copy(),\n"
        + "                    )\n"
    )
    source = source.replace(rate_needle, callback, 1)
    module = types.ModuleType(name)
    module.__file__ = str(path)
    module.__package__ = "mcrl.physics_v025"
    sys.modules[name] = module
    exec(compile(source, str(path), "exec"), module.__dict__)
    return module


def selected_rows(arrays, config) -> object:
    import numpy as np

    row_of = arrays._row_index()
    users = tuple(int(value) for value in arrays.users)
    result = np.full((1, len(users)), -1, dtype=np.int64)
    for column, user in enumerate(users):
        identity = config.mapping[user]
        if identity is not None:
            row = row_of.get((user, identity))
            if row is None:
                raise RuntimeError(f"assignment absent from primitive rows: {user}: {identity}")
            result[0, column] = row
    return result


def run_instrumented(module, arrays, config, run_setting):
    selected = selected_rows(arrays, config)
    recorder = SubslotRecorder(arrays, selected)
    module._RECORD_CALLBACK = recorder
    try:
        result = module._evaluate_ar_tdm_catalogue_core(
            arrays,
            selected,
            field="realised",
            rate_target_bps=run_setting.rate_target_bps,
            circuit_power_per_active_chain_w=run_setting.circuit_power_per_active_chain_w,
            boundary_indices=BOUNDARIES,
            fading_quantile_alpha=0.10,
        )
    finally:
        module._RECORD_CALLBACK = None
    if not bool(result.valid[0]):
        raise RuntimeError(f"recorded endpoint became invalid: {config.configuration_id}")
    users = tuple(int(value) for value in arrays.users)
    per_user = tuple(float(value) for value in result.bits[0])
    total_bits = math.fsum(per_user)
    joules = float(result.joules[0])
    served_count = sum(float(value) > 0.0 for value in result.decoding_time_s[0])
    attained = tuple(value >= DEMAND_BITS for value in per_user)
    records = {
        "compact_transmission_columns": [
            "user_id",
            "norad_id",
            "beam_id",
            "delivered_bits_for_one_boundary_interval_s",
            "radiated_power_w",
            "transmitted_mode_index_minus_one_for_none",
            "realised_decoded",
        ],
        "delivery_field_definition": (
            "rational_subslot_fraction * realised delivered ACM rate_bps * 0.640 s; "
            "endpoint delivery uses 0.5 weights at boundaries 0 and 47 and weight 1 otherwise"
        ),
        "per_user_endpoint": [
            {
                "user_id": user,
                "delivered_bits_over_endpoint": per_user[index],
                "rate_target_attained": attained[index],
            }
            for index, user in enumerate(users)
        ],
        "boundaries": recorder.finish(),
    }
    return {
        "bits": total_bits,
        "joules": joules,
        "ee_bit_per_j": total_bits / joules,
        "served_count": served_count,
        "attained_count": sum(attained),
        "per_user_bits": list(per_user),
        "accounting": accounting(per_user, joules),
        "records": records,
        "records_sha256": digest(records),
    }


def original_profile(reference, tape, step: int, true_base, config, boundaries=BOUNDARIES):
    evaluator = reference.probe.StepEvaluator(
        tape,
        reference.probe._setting("a-r0"),
        step,
        transition_from=true_base,
        field="realised",
        run_setting=reference.probe.run_setting_for("a-r0"),
        boundary_indices=tuple(boundaries),
        fading_quantile_alpha=0.10,
    )
    evaluator.evaluate_many((config,))
    profile = evaluator._evaluated.get(config.configuration_id)
    if profile is None:
        return None
    per_user = [float(profile.score.bits[user]) for user in sorted(profile.score.bits)]
    return {
        "bits": float(profile.bits),
        "joules": float(profile.joules),
        "ee_bit_per_j": float(reference.ratio(profile.bits, profile.joules)),
        "served_count": int(reference.served(profile)),
        "per_user_bits": per_user,
        "accounting": accounting(per_user, float(profile.joules)),
    }


def reconstruct(reference, true_base, metric: Mapping[str, object], kind: str):
    config = reference._configuration(true_base, mapping(metric), kind)
    if config.configuration_id != metric["configuration_id"]:
        raise RuntimeError(
            f"configuration reconstruction mismatch: {config.configuration_id} != "
            f"{metric['configuration_id']}"
        )
    return config


