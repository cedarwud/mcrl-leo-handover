+def spread_max_over_min(values: Sequence[float]) -> tuple[float | None, bool]:
+    minimum = min(values)
+    maximum = max(values)
+    if minimum == 0.0:
+        return (0.0, False) if maximum == 0.0 else (None, True)
+    return maximum / minimum - 1.0, False
+
