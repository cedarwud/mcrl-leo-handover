+def spread_max_over_min(values: Sequence[float]) -> tuple[float | None, bool]:
+    minimum = min(values)
+    maximum = max(values)
+    if minimum == 0.0:
+        return (0.0, False) if maximum == 0.0 else (None, True)
+    return maximum / minimum - 1.0, False
+
+
+def best_exceeds_reference_ratio(best: float, reference: float) -> tuple[float | None, bool, bool]:
+    if reference == 0.0:
+        return None, best > 0.0, best == 0.0
+    return best / reference - 1.0, False, False
+
+
+def reference_below_best_ratio(best: float, reference: float) -> tuple[float | None, bool]:
+    if best == 0.0:
+        return None, True
+    return 1.0 - reference / best, False
+
