def parity_stop() -> int:
    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)
    for variable in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
        if os.environ.get(variable) != "1":
            raise RuntimeError(f"{variable}=1 is required")
    tasks = [(rule, world, step) for rule in RULES for world, step in ANCHORS]
    rows = []
    with ProcessPoolExecutor(max_workers=MAX_WORKERS) as pool:
        futures = {pool.submit(parity_scan_anchor, task): task for task in tasks}
        for future in as_completed(futures):
            result = future.result()
            rows.extend(result)
            print(json.dumps({"parity_completed": futures[future]}), flush=True)
    rows.sort(key=lambda row: (RULES.index(row["rule"]), ANCHORS.index(tuple(int(x) for x in (row["anchor"][1], row["anchor"][-1]))), row["start_index"]))
    mismatches = []
    exact = 0
    for row in rows:
        if row["invalid_on_replay"]:
            mismatches.append(row)
            continue
        all_equal = all(
            comparison.get("exact_binary64_equal", comparison.get("exact_equal"))
            for comparison in row["comparisons"].values()
        )
        if all_equal:
            exact += 1
        else:
            mismatches.append(row)
    data = {
        "schema": "mcrl-v025-multistart-demand-capped-parity-failure-v1",
        "claim": CLAIM,
        "safe_to_rescore": False,
        "capacity_parity_gate": {
            "passed": False,
            "endpoint_count": len(rows),
            "exact_endpoint_count": exact,
            "mismatch_endpoint_count": len(mismatches),
            "mismatches": mismatches,
        },
        "downstream_results": None,
        "stop_reason": (
            "At least one recorded endpoint did not reproduce receipt capacity fields at exact binary64; "
            "all downstream numerator substitutions are unsafe."
        ),
        "swap_audit_subset_predeclared": [
            {"rule": rule, "world_index": world, "step_index": step, "start_index": start}
            for rule, world, step, start in SWAP_AUDIT_SUBSET
        ],
        "provenance": {
            "source_report": str(SOURCE_REPORT),
            "source_report_sha256": sha256(SOURCE_REPORT),
            "source_receipt_root": str(SOURCE_ROOT),
            "multistart_runner": str(MULTISTART_RUNNER),
            "multistart_runner_sha256": sha256(MULTISTART_RUNNER),
            "rescore_runner": str(Path(__file__).resolve()),
            "rescore_runner_sha256": sha256(Path(__file__).resolve()),
            "python": str(PYTHON),
            "process_model": "one parent plus at most three workers",
            "max_concurrent_python_processes": 4,
            "numerical_threads_per_process": 1,
            "parity_path": "original public StepEvaluator dense evaluator, singleton configurations",
        },
    }
    OUTPUT_PATH.write_text(
        json.dumps(data, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    report = parity_stop_report(data)
    REPORT_PATH.write_text(report, encoding="utf-8")
    print(report, end="")
    return 2


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("run", "parity-stop"))
    args = parser.parse_args()
    if args.command == "run":
        return run()
    if args.command == "parity-stop":
        return parity_stop()
    raise AssertionError(args.command)


if __name__ == "__main__":
    raise SystemExit(main())

