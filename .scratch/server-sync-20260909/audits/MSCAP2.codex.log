def verify_serialized_records(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
    maximum_absolute_error = 0.0
    maximum_relative_error = 0.0
    endpoint_count = 0
    user_endpoint_count = 0
    subslot_count = 0
    transmission_count = 0
    for anchor in anchors:
        for endpoint in anchor["endpoints"]:
            endpoint_count += 1
            metric = endpoint["endpoint"]
            records = metric["records"]
            if digest(records) != metric["records_sha256"]:
                raise RuntimeError("serialized record digest mismatch")
            reconstructed = {user: [] for user in range(100)}
            boundaries = records["boundaries"]
            if [row["boundary_index"] for row in boundaries] != list(BOUNDARIES):
                raise RuntimeError("serialized boundary coverage mismatch")
            for boundary in boundaries:
                cursor = Fraction(0, 1)
                for subslot in boundary["subslots"]:
                    subslot_count += 1
                    start = Fraction(*subslot["rational_subslot_start"])
                    end = Fraction(*subslot["rational_subslot_end"])
                    if start != cursor or end <= start:
                        raise RuntimeError("serialized rational subslot partition mismatch")
                    cursor = end
                    identities = set()
                    for transmission in subslot["transmissions"]:
                        transmission_count += 1
                        user, norad, beam, delivered = (
                            int(transmission[0]),
                            int(transmission[1]),
                            int(transmission[2]),
                            float(transmission[3]),
                        )
                        identity = (norad, beam)
                        if identity in identities:
                            raise RuntimeError("duplicate active beam identity in subslot")
                        identities.add(identity)
                        reconstructed[user].append(
                            float(boundary["endpoint_trapezoid_weight"]) * delivered
                        )
                if cursor != 1:
                    raise RuntimeError("serialized rational subslots do not sum to one")
            rows = records["per_user_endpoint"]
            if [row["user_id"] for row in rows] != list(range(100)):
                raise RuntimeError("serialized per-user endpoint roster mismatch")
            for row in rows:
                user_endpoint_count += 1
                actual = math.fsum(reconstructed[int(row["user_id"])])
                expected = float(row["delivered_bits_over_endpoint"])
                error = abs(actual - expected)
                relative = error / max(abs(expected), 1.0)
                maximum_absolute_error = max(maximum_absolute_error, error)
                maximum_relative_error = max(maximum_relative_error, relative)
                if not math.isclose(actual, expected, rel_tol=4e-15, abs_tol=2e-6):
                    raise RuntimeError(
                        f"serialized per-user reconstruction mismatch: {anchor['rule']} "
                        f"{anchor['anchor']} start {endpoint['start_index']} user {row['user_id']}: "
                        f"{actual} != {expected}"
                    )
                if bool(row["rate_target_attained"]) != (expected >= DEMAND_BITS):
                    raise RuntimeError("serialized attainment flag mismatch")
            if math.fsum(float(row["delivered_bits_over_endpoint"]) for row in rows) != float(
                metric["bits"]
            ):
                raise RuntimeError("per-user authoritative total does not exactly reproduce bits")
    return {
        "passed": True,
        "endpoint_count": endpoint_count,
        "user_endpoint_count": user_endpoint_count,
        "subslot_count": subslot_count,
        "transmission_count": transmission_count,
        "maximum_absolute_reconstruction_error_bits": maximum_absolute_error,
        "maximum_relative_reconstruction_error": maximum_relative_error,
        "reconstruction_tolerance": {"relative": 4e-15, "absolute_bits": 2e-6},
    }


def build_final(partials: Sequence[Path]) -> dict:
    anchors = [json.loads(path.read_text(encoding="ascii")) for path in partials]
    anchors.sort(key=lambda row: (RULES.index(row["rule"]), ANCHORS.index((row["world_index"], row["step_index"]))))
    summaries = [summarize_rule(anchors, rule) for rule in RULES]
    all_endpoint_parity = [
        endpoint["endpoint_capacity_parity"]
        for anchor in anchors
        for endpoint in anchor["endpoints"]
    ]
    all_swap_parity = [
        endpoint["recorded_F_best_swap_capacity_parity"]
        for anchor in anchors
        for endpoint in anchor["endpoints"]
        if endpoint["recorded_F_best_swap_capacity_parity"] is not None
    ]
    if len(all_endpoint_parity) != 128 or len(all_swap_parity) != 128:
        raise RuntimeError("expected 128 endpoint and 128 recorded-swap parity rows")
    records_verification = verify_serialized_records(anchors)
    return {
        "schema": "mcrl-v025-multistart-demand-capped-v1",
        "claim": CLAIM,
        "capacity_parity_gate": {
            "passed": True,
            "endpoint_count": len(all_endpoint_parity),
            "recorded_F_best_swap_count": len(all_swap_parity),
            "all_bits_exact_binary64": True,
            "all_joules_exact_binary64": True,
            "all_ee_exact_binary64": True,
            "all_served_counts_exact": True,
            "maximum_absolute_difference": {"bits": 0.0, "joules": 0.0, "ee_bit_per_j": 0.0},
        },
        "accounting_definitions": {
            "endpoint_duration_s": 30.08,
            "per_user_demand_bits": DEMAND_BITS,
            "CAPACITY": "sum integrated delivered ACM-capacity bits",
            "DEMAND_CAPPED": "sum min(per-user integrated delivery, 1.504 Gbit)",
            "ATTAINMENT_ONLY": "sum uncapped integrated delivery only for users at or above 1.504 Gbit",
        },
        "serialized_records_verification": records_verification,
        "selection_convention": (
            "For each numerator, per-anchor best-of-8 and best-found are selected by that numerator's "
            "committed EE among recorded configurations only; frozen CAPACITY-choice rescoring is retained."
        ),
        "swap_audit_subset_predeclared": [
            {"rule": rule, "world_index": world, "step_index": step, "start_index": start}
            for rule, world, step, start in SWAP_AUDIT_SUBSET
        ],
        "summaries": summaries,
        "anchors": anchors,
        "provenance": {
            "source_report": str(SOURCE_REPORT),
            "source_report_sha256": sha256(SOURCE_REPORT),
            "source_receipt_root": str(SOURCE_ROOT),
            "multistart_runner": str(MULTISTART_RUNNER),
            "multistart_runner_sha256": sha256(MULTISTART_RUNNER),
            "sealed_batch": str(SEALED_BATCH),
            "sealed_batch_sha256": sha256(SEALED_BATCH),
            "margin_batch": str(MARGIN_BATCH),
            "margin_batch_sha256": sha256(MARGIN_BATCH),
            "rescore_runner": str(Path(__file__).resolve()),
            "rescore_runner_sha256": sha256(Path(__file__).resolve()),
            "python": str(PYTHON),
            "python_version": sys.version,
            "process_model": "one parent plus at most three workers",
            "max_concurrent_python_processes": 4,
            "numerical_threads_per_process": 1,
            "instrumentation": (
                "in-memory source copy; one callback inserted immediately after slot_rate computation; "
                "no evaluator equation or input changed"
            ),
        },
    }


def run() -> int:
    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)
    for variable in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
        if os.environ.get(variable) != "1":
            raise RuntimeError(f"{variable}=1 is required")
    tasks = [(rule, world, step) for rule in RULES for world, step in ANCHORS]
    partials = []
    with ProcessPoolExecutor(max_workers=MAX_WORKERS) as pool:
        futures = {pool.submit(run_anchor_job, task): task for task in tasks}
        for future in as_completed(futures):
            path, seconds = future.result()
            partials.append(Path(path))
            print(json.dumps({"completed": futures[future], "wall_seconds": seconds}), flush=True)
    final = build_final(partials)
    OUTPUT_PATH.write_text(
        json.dumps(final, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    report = render_report(final)
    REPORT_PATH.write_text(report, encoding="utf-8")
    print(report, end="")
    return 0


def parity_scan_anchor(task):
    rule, world, step = task
    if str(HARNESS) not in sys.path:
        sys.path.insert(0, str(HARNESS))
    from harness.runner import install_variant
    from harness import sealed as sealed_module

    sealed_module.verify()
    reference = sealed_module.reference_runner()
    source = load_receipt(receipt_path(rule, world, step))
    source_anytime = load_receipt(
        HARNESS
        / "receipts"
        / ("anytime-sealed-full20.json" if rule == "SEALED" else "anytime-margin-q-full20.json")
    )
    world_row = next(row for row in source_anytime["worlds"] if int(row["world_index"]) == world)
    tape = pickle.loads(
        (HARNESS / ".harness-cache/worlds" / f"{world_row['cache_key']}.pickle").read_bytes()
    )
    install_variant(rule)
    true_base = reference.probe._base_configuration(tape, step, "nearest-eligible")
    rows = []
    for endpoint_row in source["endpoints"]:
        expected = endpoint_row["endpoint"]
        config = reconstruct(reference, true_base, expected, "capacity-parity-only")
        actual = original_profile(reference, tape, step, true_base, config)
        if actual is None:
            rows.append(
                {
                    "rule": rule,
                    "anchor": anchor_name(world, step),
                    "start_index": endpoint_row["start_index"],
                    "configuration_id": expected["configuration_id"],
                    "invalid_on_replay": True,
                }
            )
            continue
        comparisons = {
            field: equality_row(float(actual[field]), float(expected[field]))
            for field in ("bits", "joules", "ee_bit_per_j")
        }
        comparisons["served_count"] = {
            "actual": int(actual["served_count"]),
            "expected": int(expected["served_count"]),
            "exact_equal": int(actual["served_count"]) == int(expected["served_count"]),
        }
        rows.append(
            {
                "rule": rule,
                "anchor": anchor_name(world, step),
                "start_index": endpoint_row["start_index"],
                "configuration_id": expected["configuration_id"],
                "invalid_on_replay": False,
                "comparisons": comparisons,
            }
        )
    return rows


