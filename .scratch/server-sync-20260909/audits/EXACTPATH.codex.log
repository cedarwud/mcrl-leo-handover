  1035	    def required_power(self, config: Configuration) -> tuple[float, float]:
  1036	        profile = self.evaluate(config)
  1037	        if config.configuration_id not in self._shared:
  1038	            return profile.required_power_w_max, BEAM_RF_CAP_W
  1039	        shared = self._shared[config.configuration_id]
  1040	        powers = [
  1041	            tx.rf_power_w
  1042	            for boundary in shared.integrated  # type: ignore[attr-defined]
  1043	            for slot in boundary.radiation.slots
  1044	            for tx in slot.transmissions
  1045	        ]
  1046	        return (max(powers, default=0.0), BEAM_RF_CAP_W)
