+#!/usr/bin/env python3
+"""Measure exact versus primitive V0.25 source-row construction.
+
+DIAGNOSTIC_NOT_CLAIM.  This does not train, run a policy, or invoke acceptance
+tests.  It leaves PILOT_PRIMITIVE_SOURCE_FALLBACK unchanged: the exact branch
+is reached by cloning the existing function with a private globals mapping.
+"""
+
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+import threading
+import time
+from types import FunctionType
+
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / ".scratch/exact-row-path-cost/results.json"
+sys.path.insert(0, str(ROOT / "scripts"))
+
+import run_v025_pilot_c3 as pilot  # noqa: E402
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider  # noqa: E402
+from mcrl.physics_v025.tapes import (  # noqa: E402
+    DEVELOPMENT_WORLD_DOMAINS,
+    REFERENCE_CARRIERS,
+    build_world_tape,
+)
+
+
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+    / "PILOT_NOT_CLAIM-calibration.json"
+)
+ANCHORS = (0, 1)
+PATHS = ("primitive", "exact")
+PANEL_ANCHORS = 20
+PANEL_SEEDS = 12
+PANEL_ARMS = 9
+
+
+def _rss_bytes() -> int:
+    for line in Path("/proc/self/status").read_text().splitlines():
+        if line.startswith("VmRSS:"):
+            return int(line.split()[1]) * 1024
+    raise RuntimeError("VmRSS is absent from /proc/self/status")
+
+
+class _PeakRss:
+    def __init__(self) -> None:
+        self.peak = _rss_bytes()
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._sample, daemon=True)
+
+    def _sample(self) -> None:
+        while not self._stop.is_set():
+            self.peak = max(self.peak, _rss_bytes())
+            self._stop.wait(0.001)
+
+    def __enter__(self) -> "_PeakRss":
+        self._thread.start()
+        return self
+
+    def __exit__(self, *_args: object) -> None:
+        self.peak = max(self.peak, _rss_bytes())
+        self._stop.set()
+        self._thread.join()
+
+
+class _EngineCapture:
+    """Transparent engine proxy that retains production forecast outputs."""
+
+    def __init__(self, engine: object) -> None:
+        self._engine = engine
+        self.forecasts = None
+
+    def __getattr__(self, name: str) -> object:
+        return getattr(self._engine, name)
+
+    def _batched_stage2_forecasts(self, **kwargs: object):
+        result = self._engine._batched_stage2_forecasts(**kwargs)
+        self.forecasts = result[0]
+        return result
+
+
+def _calibration() -> pilot.PilotCalibration:
+    from fractions import Fraction
+
+    payload = json.loads(CALIBRATION_PATH.read_text())
+
+    def fraction(name: str) -> Fraction:
+        numerator, denominator = payload[name]
+        return Fraction(numerator, denominator)
+
+    return pilot.PilotCalibration(
+        eta_ref=fraction("eta_ref"),
+        lambda_bits_per_j=fraction("lambda_bits_per_j"),
+        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
+        bits_ref=fraction("bits_ref"),
+        joules_ref=fraction("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def _exact_builder(capture: _EngineCapture):
+    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
+        raise AssertionError("the source fallback constant was not found True")
+    private_globals = dict(pilot._build_anchor_rows.__globals__)
+    private_globals["PILOT_PRIMITIVE_SOURCE_FALLBACK"] = False
+    private_globals["ENGINE"] = capture
+    return FunctionType(
+        pilot._build_anchor_rows.__code__,
+        private_globals,
+        name="_build_anchor_rows_exact_diagnostic_clone",
+        argdefs=pilot._build_anchor_rows.__defaults__,
+        closure=pilot._build_anchor_rows.__closure__,
+    )
+
+
+def _assert_exact_pass_through(built: dict[str, object], forecasts: dict) -> int:
+    base = built["base"]
+    checked = 0
+    for row in built["rows"]:
+        mapping = base.mapping
+        mapping[row.user_id] = pilot._identity(row.action)
+        config = pilot.ENGINE._configuration(base, mapping, kind="cost-audit-replay")
+        projections = forecasts[config.configuration_id]
+        for offset, projection in enumerate(projections):
+            assert bool(row.q2_state[10 + 4 * offset]) is projection.valid
+            assert bool(row.q2_state[11 + 4 * offset]) is projection.survives
+            checked += 2
+    return checked
+
+
+def worker(path_name: str, anchor_index: int) -> dict[str, object]:
+    if path_name not in PATHS or anchor_index not in ANCHORS:
+        raise ValueError("unsupported worker request")
+    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
+        raise AssertionError("PILOT_PRIMITIVE_SOURCE_FALLBACK changed before measurement")
+
+    # Four steps are the minimum for an anchor at step zero plus offsets 1,2,3.
+    tape_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=4,
+        start_time_s=0.0,
+    )
+    tape_wall_s = time.perf_counter() - tape_started
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    calibration = _calibration()
+    carrier = REFERENCE_CARRIERS[anchor_index]
+
+    capture = _EngineCapture(pilot.ENGINE)
+    builder = pilot._build_anchor_rows if path_name == "primitive" else _exact_builder(capture)
+    gc.collect()
+    baseline_rss = _rss_bytes()
+    started = time.perf_counter()
+    with _PeakRss() as memory:
+        built = builder(
+            tape=tape,
+            setting=setting,
+            run_setting=run_setting,
+            calibration=calibration,
+            step_index=0,
+            carrier=carrier,
+            anchor_index=anchor_index,
+            include_coalition=False,
+            full_legal_actions=False,
+        )
+    wall_s = time.perf_counter() - started
+
+    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
+        raise AssertionError("measurement mutated PILOT_PRIMITIVE_SOURCE_FALLBACK")
+    current = built["current_evaluator"]
+    exact_flags_checked = 0
+    if path_name == "exact":
+        assert capture.forecasts is not None
+        exact_flags_checked = _assert_exact_pass_through(built, capture.forecasts)
+
+    rows = tuple(built["rows"])
+    reference_rows = sum(bool(row.reference_action) for row in rows)
+    result = {
+        "path": path_name,
+        "anchor_index": anchor_index,
+        "step_index": 0,
+        "carrier": carrier,
+        "world": tape.domain,
+        "world_seed": tape.seed,
+        "tape_steps": len(tape.steps),
+        "users": len(tape.user_layout),
+        "include_coalition": False,
+        "full_legal_actions": False,
+        "forecast_boundaries": list(pilot.ENGINE.SELECTION_BOUNDARY_INDICES),
+        "tape_build_wall_s_excluded": tape_wall_s,
+        "row_build_wall_s": wall_s,
+        "baseline_rss_bytes": baseline_rss,
+        "peak_rss_bytes": memory.peak,
+        "incremental_peak_rss_bytes": max(0, memory.peak - baseline_rss),
+        "source_rows": len(rows),
+        "reference_rows": reference_rows,
+        "nonreference_rows": len(rows) - reference_rows,
+        "current_configuration_boundary_evaluations": current.physical_evaluations,
+        "forecast_configuration_boundary_evaluations": (
+            int(built["physics_calls"]) - current.physical_evaluations
+        ),
+        "total_configuration_boundary_evaluations": int(built["physics_calls"]),
+        "current_cached_valid_configurations": len(current._evaluated),
+        "current_invalid_configurations": len(current._invalid),
+        "skipped_invalid_action_rows": int(built["skipped_invalid"]),
+        "exact_validity_survival_flags_checked": exact_flags_checked,
+        "fallback_constant_before_and_after": True,
+    }
+    return result
+
+
+def _run_worker(path_name: str, anchor_index: int) -> dict[str, object]:
+    command = [
+        sys.executable,
+        str(Path(__file__).resolve()),
+        "--worker",
+        path_name,
+        "--anchor",
+        str(anchor_index),
+    ]
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        check=True,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        env={**os.environ, "PYTHONPATH": "src"},
+    )
+    if completed.stderr:
+        print(completed.stderr, file=sys.stderr, end="")
+    return json.loads(completed.stdout)
+
+
+def coordinator() -> dict[str, object]:
+    measurements = []
+    for anchor_index in ANCHORS:
+        for path_name in PATHS:
+            row = _run_worker(path_name, anchor_index)
+            measurements.append(row)
+            print(json.dumps({"completed": [anchor_index, path_name], "row_build_wall_s": row["row_build_wall_s"]}), flush=True)
+
+    pairs = {}
+    for anchor_index in ANCHORS:
+        primitive = next(
+            row for row in measurements
+            if row["anchor_index"] == anchor_index and row["path"] == "primitive"
+        )
+        exact = next(
+            row for row in measurements
+            if row["anchor_index"] == anchor_index and row["path"] == "exact"
+        )
+        pairs[str(anchor_index)] = {
+            "wall_ratio_exact_over_primitive": exact["row_build_wall_s"] / primitive["row_build_wall_s"],
+            "evaluation_ratio_exact_over_primitive": (
+                exact["total_configuration_boundary_evaluations"]
+                / primitive["total_configuration_boundary_evaluations"]
+            ),
+            "peak_rss_ratio_exact_over_primitive": exact["peak_rss_bytes"] / primitive["peak_rss_bytes"],
+            "incremental_peak_rss_ratio_exact_over_primitive": (
+                None
+                if primitive["incremental_peak_rss_bytes"] == 0
+                else exact["incremental_peak_rss_bytes"] / primitive["incremental_peak_rss_bytes"]
+            ),
+        }
+
+    by_path = {
+        path_name: [row for row in measurements if row["path"] == path_name]
+        for path_name in PATHS
+    }
+    means = {}
+    for path_name, rows in by_path.items():
+        means[path_name] = {
+            "row_build_wall_s": statistics.fmean(row["row_build_wall_s"] for row in rows),
+            "peak_rss_bytes": statistics.fmean(row["peak_rss_bytes"] for row in rows),
+            "incremental_peak_rss_bytes": statistics.fmean(row["incremental_peak_rss_bytes"] for row in rows),
+            "total_configuration_boundary_evaluations": statistics.fmean(
+                row["total_configuration_boundary_evaluations"] for row in rows
+            ),
+        }
+
+    builds = PANEL_ANCHORS * PANEL_SEEDS * PANEL_ARMS
+    shared_builds = PANEL_ANCHORS * PANEL_SEEDS
+    exact_mean = means["exact"]["row_build_wall_s"]
+    primitive_mean = means["primitive"]["row_build_wall_s"]
+    projection = {
+        "panel_anchors": PANEL_ANCHORS,
+        "panel_seeds": PANEL_SEEDS,
+        "panel_arms": PANEL_ARMS,
+        "anchor_seed_pairs": shared_builds,
+        "arm_anchor_seed_builds_no_cross_arm_reuse": builds,
+        "no_cross_arm_reuse": {
+            "exact_wall_s": builds * exact_mean,
+            "primitive_wall_s": builds * primitive_mean,
+            "surrogate_wall_saved_s": builds * (exact_mean - primitive_mean),
+            "exact_boundary_evaluations": builds * means["exact"]["total_configuration_boundary_evaluations"],
+            "primitive_boundary_evaluations": builds * means["primitive"]["total_configuration_boundary_evaluations"],
+            "surrogate_boundary_evaluations_saved": builds * (
+                means["exact"]["total_configuration_boundary_evaluations"]
+                - means["primitive"]["total_configuration_boundary_evaluations"]
+            ),
+        },
+        "perfect_nine_arm_physical_reuse_lower_bound": {
+            "exact_wall_s_if_whole_build_reused": shared_builds * exact_mean,
+            "primitive_wall_s_if_whole_build_reused": shared_builds * primitive_mean,
+            "note": "Arithmetic lower bound only; each arm keeps its own seed/catalogue, so whole-build reuse is not established.",
+        },
+    }
+    payload = {
+        "schema": "exact-row-path-cost-diagnostic-v1",
+        "label": "DIAGNOSTIC_NOT_CLAIM",
+        "command_interpreter": sys.executable,
+        "fallback_constant_source_value": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
+        "measurements": measurements,
+        "per_anchor_ratios": pairs,
+        "two_anchor_means": means,
+        "two_anchor_mean_wall_ratio_exact_over_primitive": exact_mean / primitive_mean,
+        "panel_projection": projection,
+    }
+    OUT.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n")
+    return payload
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--worker", choices=PATHS)
+    parser.add_argument("--anchor", type=int, choices=ANCHORS)
+    args = parser.parse_args()
+    if args.worker is not None:
+        if args.anchor is None:
+            parser.error("--worker requires --anchor")
+        print(json.dumps(worker(args.worker, args.anchor), sort_keys=True))
+        return 0
+    if args.anchor is not None:
+        parser.error("--anchor requires --worker")
+    coordinator()
+    print(OUT)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

