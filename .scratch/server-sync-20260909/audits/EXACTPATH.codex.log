   242	@dataclass(frozen=True)
   243	class C2Label:
   244	    forecast_surplus_bits: Fraction
   245	    lost_offsets: int
   246	    persistence_penalty_bits: Fraction
   247	    normalized_total: Fraction
   248	    projections: tuple[OffsetProjection, ...]
   249	
   250	
   251	def c2_persistence_forecast(
   252	    candidate: Sequence[OffsetProjection],
   253	    default: Sequence[OffsetProjection],
   254	    *,
   255	    lambda_bits_per_j: int | float | str | Fraction,
   256	    eta_ref: int | float | str | Fraction,
   257	    kappa_bits_per_user_step: int | float | str | Fraction | None = None,
   258	    kappa_bits_per_user_s: int | float | str | Fraction | None = None,
   259	    horizon_offsets: int = FORECAST_OFFSETS,
   260	) -> C2Label:
   261	    """OPS-3-style absorbing persistence with one -kappa per lost offset.
   262	
   263	    The failed offset's attempted transmission is already present in its
   264	    ``NetworkOutcome``.  Only later offsets are made absorbing losses; live
   265	    recovery outside this forecast remains possible.
   266	    """
   267	
   268	    if (kappa_bits_per_user_step is None) == (kappa_bits_per_user_s is None):
   269	        raise MCRLContractError("supply exactly one kappa normalization keyword")
   270	    kappa_value = (
   271	        kappa_bits_per_user_step
   272	        if kappa_bits_per_user_step is not None
   273	        else kappa_bits_per_user_s
