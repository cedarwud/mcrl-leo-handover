   903	    def evaluate(self, config: Configuration) -> EvaluatedProfile:
   904	        if config.configuration_id in self._evaluated:
   905	            return self._evaluated[config.configuration_id]
   906	        geometry = self.tape.geometry_for(step_index=self.step_index, assignments=config.mapping)
   907	        shared = build_shared_tape(
   908	            self.setting.architecture,
   909	            geometry,
   910	            self.tape.inventory,
   911	            field=self.field,  # type: ignore[arg-type]
   912	            roster=tuple(user.user_id for user in self.tape.user_layout),
   913	            config=RadiationConfig(rate_target_bps=self.run_setting.rate_target_bps),
   914	            circuit_power_per_active_chain_w=self.run_setting.circuit_power_per_active_chain_w,
   915	        )
   916	        event_ledger = _interruption_events(
   917	            self.transition_from,
   918	            config,
   919	            shared.integrated[0].time_s,
   920	            cell_rekeyed_users=self.cell_rekeyed_users,
   921	        )
   922	        score = score_setting(
   923	            shared,
   924	            self.setting,
   925	            discontinuities=discontinuities_from_event_ledger(
   926	                shared, event_ledger
   927	            ),
   928	            interruptions=event_ledger,
   929	        )
   930	        if not score.valid:
   931	            raise ProbeError(f"invalid power certificate for {config.configuration_id}")
   932	        components, beam_seconds, satellite_seconds = _energy_fields(
   933	            shared,
   934	            self.setting,
   935	            circuit_power_per_active_chain_w=self.run_setting.circuit_power_per_active_chain_w,
   936	        )
   937	        if not math.isclose(math.fsum(components.values()), score.joules, rel_tol=1e-10, abs_tol=1e-8):
   938	            raise ProbeError("energy-component reconstruction disagrees with cell score")
   939	        mode_counts: dict[str, int] = {}
   940	        cap_hits = transmissions = 0
   941	        top_mode = max(ACM_MODES, key=lambda row: row.efficiency_bit_per_symbol)
   942	        user_on_plateau: dict[int, bool] = {}
   943	        for boundary in shared.integrated:
   944	            for slot in boundary.radiation.slots:
   945	                for tx in slot.transmissions:
   946	                    mode = select_mode(tx.sinr)
   947	                    name = "NO_MODE" if mode is None else mode.name
   948	                    mode_counts[name] = mode_counts.get(name, 0) + 1
   949	                    user_on_plateau[tx.user_id] = user_on_plateau.get(tx.user_id, True) and mode == top_mode
   950	                    transmissions += 1
   951	                    cap_hits += int(math.isclose(tx.rf_power_w, BEAM_RF_CAP_W, rel_tol=0.0, abs_tol=1e-9))
   952	        t_comparison = None
   953	        if self.setting.integration == "T":
   954	            integral_setting = next(
   955	                row
   956	                for row in MATRIX_SETTINGS
   957	                if row.architecture == self.setting.architecture and row.treatment == "0"
   958	            )
   959	            integral_score = score_setting(
   960	                shared,
   961	                integral_setting,
   962	                discontinuities=discontinuities_from_event_ledger(
   963	                    shared, event_ledger
   964	                ),
   965	                interruptions=event_ledger,
   966	            )
   967	            t_comparison = {
   968	                "snapshot_convention": "left-endpoint decision-time zero-order hold",
   969	                "same_instant_integral": {
   970	                    "bits": math.fsum(integral_score.bits.values()),
   971	                    "joules": integral_score.joules,
   972	                },
   973	                "left_snapshot": {"bits": math.fsum(score.bits.values()), "joules": score.joules},
   974	            }
   975	        result = EvaluatedProfile(
   976	            config,
   977	            score,
   978	            components,
   979	            beam_seconds,
   980	            satellite_seconds,
   981	            mode_counts,
   982	            sum(user_on_plateau.values()),
   983	            len(user_on_plateau),
   984	            cap_hits,
   985	            transmissions,
   986	            t_comparison,
   987	            max(
   988	                (
   989	                    boundary.radiation.certificate.status
   990	                    for boundary in shared.integrated
   991	                ),
   992	                key=lambda value: {"FIXED": 0, "CONVERGED": 1, "CONVERGED_SLOW": 2, "INVALID": 3}[value],
   993	            ),
   994	            sum(boundary.radiation.certificate.iterations for boundary in shared.integrated),
   995	            max(
   996	                (
   997	                    tx.rf_power_w
   998	                    for boundary in shared.integrated
   999	                    for slot in boundary.radiation.slots
  1000	                    for tx in slot.transmissions
  1001	                ),
  1002	                default=0.0,
  1003	            ),
  1004	            min(
  1005	                (
  1006	                    10.0 * math.log10(tx.sinr) - SINR_MIN_DB
  1007	                    for boundary in shared.integrated
  1008	                    for slot in boundary.radiation.slots
  1009	                    for tx in slot.transmissions
  1010	                ),
  1011	                default=-100.0,
  1012	            ),
  1013	            math.fsum(
  1014	                rate_model(self.setting.rate).rate_bps(tx.sinr, tx.bandwidth_hz) / tx.bandwidth_hz
  1015	                for boundary in shared.integrated
  1016	                for slot in boundary.radiation.slots
  1017	                for tx in slot.transmissions
  1018	            ) / max(
  1019	                1,
  1020	                sum(
  1021	                    1
  1022	                    for boundary in shared.integrated
  1023	                    for slot in boundary.radiation.slots
  1024	                    for _tx in slot.transmissions
  1025	                ),
  1026	            ),
  1027	        )
  1028	        self._shared[config.configuration_id] = shared
  1029	        self._evaluated[config.configuration_id] = result
  1030	        self.physical_evaluations += len(shared.integrated)
  1031	        if self.counter is not None:
  1032	            self.counter.boundary_evaluations += len(shared.integrated)
