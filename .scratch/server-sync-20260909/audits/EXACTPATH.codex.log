   554	    neighbors: int,
   555	    chunk_size: int = 128,
   556	) -> np.ndarray:
   557	    predictions = []
   558	    k = min(neighbors, len(train_x))
   559	    train_norm = np.einsum("ij,ij->i", train_x, train_x)
   560	    for start in range(0, len(test_x), chunk_size):
   561	        chunk = test_x[start : start + chunk_size]
   562	        distances = (
   563	            np.einsum("ij,ij->i", chunk, chunk)[:, None]
   564	            + train_norm[None, :]
