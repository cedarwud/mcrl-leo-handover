  1249	def _factor_scores(
  1250	    *,
  1251	    tape: ExogenousWorldTape,
  1252	    setting: PhysicsSetting,
  1253	    step_index: int,
  1254	    carrier: str,
  1255	    base: Configuration,
  1256	    incumbent: Configuration,
  1257	    catalog: Sequence[Configuration],
  1258	    evaluated: Mapping[str, EvaluatedProfile],
  1259	    calibration: CalibrationValues,
  1260	    counter: EvaluationCounter,
  1540	            - base_core
  1541	        )
  1542	        additive = sum((value for _user, value in d_rows), Fraction())
  1543	        psi = joint - additive
  1544	        phi = _phi_for(
  1545	            incumbent, config, cell_rekeyed_users=cell_rekeyed_users
  1546	        ) - _phi_for(
  1547	            incumbent, base, cell_rekeyed_users=cell_rekeyed_users
  1548	        )
