  1592	def _batched_stage2_forecasts(
  1593	    *,
  1594	    tape: ExogenousWorldTape,
  1595	    setting: PhysicsSetting,
  1596	    anchor_step: int,
  1597	    carrier: str,
  1598	    configs: Sequence[Configuration],
  1599	    counter: EvaluationCounter,
  1600	    calibration: CalibrationValues,
  1601	    run_setting: SealedRunSetting,
  1602	) -> tuple[
  1603	    dict[str, tuple[OffsetProjection, ...]],
  1604	    tuple[dict[str, object], ...],
  1605	]:
  1606	    """Evaluate configuration × offset × coarse-boundary forecasts in batches."""
  1607	
  1608	    by_config: dict[str, list[OffsetProjection]] = {
  1609	        row.configuration_id: [] for row in configs
  1610	    }
  1611	    receipts: list[dict[str, object]] = []
  1612	    for offset in (1, 2, 3):
  1613	        projected_step = anchor_step + offset
  1614	        transition = _base_configuration(tape, projected_step, carrier)
  1615	        evaluator = StepEvaluator(
  1616	            tape,
  1617	            setting,
  1618	            projected_step,
  1619	            transition_from=transition,
  1620	            field="nominal",
  1621	            counter=counter,
  1622	            run_setting=run_setting,
  1623	            boundary_indices=SELECTION_BOUNDARY_INDICES,
  1624	        )
  1625	        evaluator.evaluate_many(configs)
  1626	        for config in configs:
  1627	            profile = evaluator._evaluated.get(config.configuration_id)
  1628	            changed = tuple(
  1629	                user
  1630	                for user in config.mapping
  1631	                if config.mapping[user] != transition.mapping.get(user)
  1632	            )
  1633	            survives = profile is not None and all(
  1634	                profile.score.served_phy.get(user, False) for user in changed
  1635	            )
  1636	            projection = _projection_from_profile(
  1637	                offset=offset, profile=profile, survives=survives
  1638	            )
  1639	            by_config[config.configuration_id].append(projection)
  1640	            receipts.append(
  1641	                {
  1642	                    "schema": f"{SCHEMA}-forecast-margin-row-v1",
  1643	                    "configuration_id": config.configuration_id,
  1644	                    "offset": offset,
  1645	                    "valid": projection.valid,
  1646	                    "survives": projection.survives,
  1647	                    "required_power_w": projection.required_power_w,
  1648	                    "power_cap_w": projection.power_cap_w,
  1649	                    "required_power_cap_margin_w": projection.required_power_cap_margin_w,
  1650	                    "min_decoding_margin_db": projection.min_decoding_margin_db,
  1651	                    "mean_acm_se_bit_s_hz": projection.mean_acm_se_bit_s_hz,
  1652	                }
  1653	            )
  1654	    validated: dict[str, tuple[OffsetProjection, ...]] = {}
  1655	    for config in configs:
  1656	        rows = tuple(by_config[config.configuration_id])
  1657	        if all(row.valid for row in rows):
  1658	            def replay_projection(
  1659	                index: int,
  1660	                _time_s: float,
  1661	                assignments: Mapping[int, tuple[int, int] | None],
  1662	                recompute_background: bool,
  1663	                *,
  1664	                expected_assignments: Mapping[int, tuple[int, int] | None] = config.mapping,
  1665	                projections: tuple[OffsetProjection, ...] = rows,
  1666	            ) -> OffsetProjection:
  1667	                if assignments != expected_assignments or not recompute_background:
  1668	                    raise ProbeError("forecast projection replay contract drifted")
  1669	                return projections[index - 1]
  1670	
  1671	            rows = project_three_offsets(
  1672	                assignments=config.mapping,
  1673	                evaluator=replay_projection,
  1674	                architecture=setting.architecture,
  1675	                lambda_bits_per_j=calibration.lambda_bits_per_j,
  1676	                eta_ref=calibration.eta_ref,
  1677	                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1678	            )
  1679	        validated[config.configuration_id] = rows
  1680	    return validated, tuple(receipts)
  1681	
  1682	
  1683	def _attach_stage2_c2(
  1684	    *,
  1685	    factors: dict[str, dict[str, object]],
  1686	    forecasts: Mapping[str, tuple[OffsetProjection, ...]],
  1687	    base: Configuration,
  1688	    calibration: CalibrationValues,
  1689	    horizon_offsets: int,
  1690	) -> None:
   165	        lambda_bits_per_j=lambda_bits_per_j,
   166	        eta_ref=eta_ref,
   167	        kappa_bits_per_user_step=kappa_bits_per_user_step,
   168	    )
   169	    core = (candidate.bits - default.bits) - eta * (candidate.joules - default.joules)
   170	    # Phi_1=.5 and Phi_2=1 are prices in κ-bit units.  Dividing the physical
   171	    # surplus by κ and then adding Phi therefore keeps the target dimensionless.
   172	    phi = candidate.phi - default.phi
   173	    return C1Label(core, phi, core / kappa + phi)
