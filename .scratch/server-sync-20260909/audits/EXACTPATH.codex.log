   542	def _standardize(train: np.ndarray, other: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
   543	    mean = train.mean(axis=0)
   544	    scale = train.std(axis=0)
   545	    scale[scale < 1e-12] = 1.0
