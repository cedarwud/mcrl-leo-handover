   176	@dataclass(frozen=True)
   177	class OffsetProjection:
   178	    offset_index: int
   179	    valid: bool
   180	    survives: bool
   181	    outcome: NetworkOutcome
   182	    background_power_recomputed: bool
   183	    required_power_w: float | None
   184	    power_cap_w: float | None
   185	    min_decoding_margin_db: float
   186	    mean_acm_se_bit_s_hz: float
   187	
   188	    def __post_init__(self) -> None:
   189	        if self.offset_index not in range(1, FORECAST_OFFSETS + 1):
   190	            raise MCRLContractError("forecast offset is outside the frozen three offsets")
   191	        if not self.background_power_recomputed:
   192	            raise MCRLContractError("projection reused stale background powers")
   193	        if not math.isfinite(self.min_decoding_margin_db) or not math.isfinite(self.mean_acm_se_bit_s_hz):
   194	            raise MCRLContractError("projection margin/SE must be finite")
   195	        if (self.required_power_w is None) != (self.power_cap_w is None):
   196	            raise MCRLContractError("required power and cap must be supplied together")
   197	        if self.required_power_w is not None and (
   198	            not math.isfinite(self.required_power_w)
   199	            or not math.isfinite(self.power_cap_w)
   200	            or self.required_power_w < 0.0
   201	            or self.power_cap_w <= 0.0
   202	        ):
   203	            raise MCRLContractError("invalid projected required-power/cap values")
   204	
   205	    @property
   206	    def required_power_cap_margin_w(self) -> float | None:
   207	        if self.required_power_w is None or self.power_cap_w is None:
   208	            return None
   209	        return self.power_cap_w - self.required_power_w
   210	
   211	
   212	ProjectionEvaluator = Callable[[int, float, Mapping[int, PhysicalIdentity | None], bool], OffsetProjection]
   213	
   214	
   215	def project_three_offsets(
   216	    *,
   217	    assignments: Mapping[int, PhysicalIdentity | None],
   218	    evaluator: ProjectionEvaluator,
   219	    architecture: str,
   220	    lambda_bits_per_j: int | float | str | Fraction,
   221	    eta_ref: int | float | str | Fraction,
   222	    kappa_bits_per_user_step: int | float | str | Fraction,
   223	) -> tuple[OffsetProjection, ...]:
   224	    """Project three physical offsets and force background re-optimisation."""
   225	
   226	    assert_calibration_prices(
   227	        lambda_bits_per_j=lambda_bits_per_j,
   228	        eta_ref=eta_ref,
   229	        kappa_bits_per_user_step=kappa_bits_per_user_step,
   230	    )
   231	    rows = tuple(
   232	        evaluator(index, index * DECISION_INTERVAL_S, assignments, True)
   233	        for index in range(1, FORECAST_OFFSETS + 1)
   234	    )
   235	    if architecture in {"a-r", "a′-r"} and any(
   236	        row.required_power_w is None or row.power_cap_w is None for row in rows
   237	    ):
   238	        raise MCRLContractError("rate-target forecast lacks required-power/cap fields")
   239	    return rows
   240	
