  1177	def _forecast_rows(
  1178	    *,
  1179	    tape: ExogenousWorldTape,
  1180	    setting: PhysicsSetting,
  1181	    anchor_step: int,
  1182	    config: Configuration,
  1183	    carrier: str,
  1184	    counter: EvaluationCounter,
  1185	    focal_user: int,
  1186	    run_setting: SealedRunSetting | None = None,
  1187	) -> tuple[OffsetProjection, ...]:
  1188	    rows = []
  1189	    for offset in range(1, 4):
  1190	        projected_step = anchor_step + offset
  1191	        base = _base_configuration(tape, projected_step, carrier)
  1192	        # Persist physical identities; Geometry is rebuilt at the projected boundary.
  1193	        persisted = Configuration(config.configuration_id, config.assignments, config.changed_users, config.kind)
  1194	        evaluator = StepEvaluator(
  1195	            tape,
  1196	            setting,
  1197	            projected_step,
  1198	            transition_from=base,
  1199	            cell_rekeyed_users=_rekeyed_users(tape, projected_step),
  1200	            field="nominal",
  1201	            counter=counter,
  1202	            run_setting=run_setting,
  1203	        )
  1204	        try:
  1205	            result = evaluator.evaluate(persisted)
  1206	            valid = True
  1207	        except (MCRLContractError, ProbeError):
  1208	            result = None
  1209	            valid = False
  1210	        required, cap = 0.0, BEAM_RF_CAP_W
  1211	        margins = []
  1212	        ses = []
  1213	        if valid and result is not None:
  1214	            required, cap = evaluator.required_power(result.config)
  1215	            shared = evaluator._shared[result.config.configuration_id]
  1216	            model = rate_model(setting.rate)
  1217	            for boundary in shared.integrated:  # type: ignore[attr-defined]
  1218	                for slot in boundary.radiation.slots:
  1219	                    for tx in slot.transmissions:
  1220	                        margins.append(10.0 * math.log10(tx.sinr) - SINR_MIN_DB)
  1221	                        ses.append(model.rate_bps(tx.sinr, tx.bandwidth_hz) / tx.bandwidth_hz)
  1222	            survives = bool(result.score.served_phy.get(focal_user, False))
  1223	            outcome = result.outcome()
  1224	        else:
  1225	            survives = False
  1226	            outcome = NetworkOutcome.build(
  1227	                bits=0,
  1228	                joules=0,
  1229	                phi=0,
  1230	                decoding_availability=0,
  1231	                useful_availability=0,
  1232	            )
  1233	        rows.append(
  1234	            OffsetProjection(
  1235	                offset,
  1236	                valid,
  1237	                survives,
  1238	                outcome,
  1239	                True,
  1240	                required if setting.architecture in {"a-r", "a′-r"} else None,
  1241	                cap if setting.architecture in {"a-r", "a′-r"} else None,
  1242	                min(margins, default=-math.inf) if margins else -100.0,
  1243	                math.fsum(ses) / len(ses) if ses else 0.0,
  1244	            )
  1245	        )
  1246	    return tuple(rows)
