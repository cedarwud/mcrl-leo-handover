def _network(bits: int, joules: int, *, phi: str = "0") -> NetworkOutcome:
    return NetworkOutcome.build(
        bits=bits,
        joules=joules,
        phi=phi,
        decoding_availability=1,
        useful_availability=1,
        per_user_bits={0: bits // 2, 1: bits - bits // 2},
    )


def _projection(
    index: int,
    outcome: NetworkOutcome,
    *,
    required_power_w: float,
) -> OffsetProjection:
    return OffsetProjection(
        offset_index=index,
        valid=True,
        survives=True,
        outcome=outcome,
        background_power_recomputed=True,
        required_power_w=required_power_w,
        power_cap_w=1.65,
        min_decoding_margin_db=4.0 - index,
        mean_acm_se_bit_s_hz=2.0,
    )


def _encoded_row(*, c1_bits: Fraction, c1_phi: Fraction, c2_bits: Fraction):
    forecasts = tuple(
        ForecastObservation(True, True, 4.0 - index, 2.0)
        for index in (1, 2, 3)
    )
    common = ActionEvaluation(
        action=PhysicalAction(1001, 7),
        nominal_sinr_margin_at_rate_target_db=4.0,
        nominal_required_power_over_cap=0.5,
        nominal_mode_spectral_efficiency=2.0,
        background_occupancy_excluding_focal=1,
        beam_active_before_focal=True,
        satellite_active_before_focal=True,
        off_axis_angle_rad=0.25,
        remaining_d2_time_s=60.0,
        remaining_visibility_time_s=90.0,
        refresh_phase=2,
        previous_served_association_for_action=False,
        previous_served_load_for_action=1,
        previous_beam_active_for_action=True,
        previous_satellite_active_for_action=True,
        previous_beam_max_rf_over_cap=0.4,
        missing_incumbent=False,
        candidate_current_nominal_decoding_margin_db=4.0,
        incumbent_nominal_decoding_margin_db=3.0,
        forecast_se_trend_bit_s_hz_per_s=0.0,
        required_power_cap_margin_w=0.825,
        forecasts=forecasts,
        c1_label_bits=float(c1_bits),
        c1_phi_difference=float(c1_phi),
        c2_label_bits=float(c2_bits),
    )
    candidate = seal_action_evaluation(
        common,
        source_provenance_sha256=canonical_sha256(
            {"source": "c1c2-sufficiency-collision", "labels": [str(c1_bits), str(c2_bits)]}
        ),
        forecast_method_sha256=canonical_sha256({"method": "three-offset-exact"}),
    )
    null = seal_action_evaluation(
        replace(
            common,
            action=PhysicalAction(None, None),
            background_occupancy_excluding_focal=0,
            beam_active_before_focal=False,
            satellite_active_before_focal=False,
            previous_served_load_for_action=0,
            previous_beam_active_for_action=False,
            previous_satellite_active_for_action=False,
            c1_label_bits=0.0,
            c1_phi_difference=0.0,
            c2_label_bits=0.0,
        ),
        source_provenance_sha256=canonical_sha256({"source": "collision-null"}),
        forecast_method_sha256=canonical_sha256({"method": "three-offset-exact"}),
    )
    envelope = pilot.AnchorEnvelope(
        world_id="C1C2_COLLISION/world",
        split="TRAIN",
        world_seed=1,
        anchor_id="collision-anchor",
        anchor_index=0,
        decision_time_utc="2026-01-01T00:00:00+00:00",
        decision_time_ns=0,
        user_id=0,
        setting_id="a-r0",
        code_digest=ZERO_DIGEST,
        physics_digest=ZERO_DIGEST,
        launch_digest=ZERO_DIGEST,
        catalogue_digest=ZERO_DIGEST,
        setting_digest=ZERO_DIGEST,
        calibration_digest=ZERO_DIGEST,
        provider_digest=ZERO_DIGEST,
        archive_digest=ZERO_DIGEST,
        allocation_manifest_digest=ZERO_DIGEST,
        lambda_bits_per_j=float(ETA),
        eta_ref_bits_per_j=float(ETA),
        kappa_normalization_bits=float(KAPPA),
        base_action_index=0,
        actions=(null, candidate),
    )
    return extract_source_rows(envelope)[1]


def _packed_hex(values: Iterable[float]) -> str:
    numbers = tuple(values)
    return struct.pack(f">{len(numbers)}d", *numbers).hex()


def collision_witnesses() -> dict[str, object]:
    default = _network(200, 20)
    c1_a = c1_difference_surplus(
        _network(220, 22, phi="-0.5"),
        default,
        lambda_bits_per_j=ETA,
        eta_ref=ETA,
        kappa_bits_per_user_step=KAPPA,
    )
    c1_b = c1_difference_surplus(
        _network(180, 24, phi="-0.5"),
        default,
        lambda_bits_per_j=ETA,
        eta_ref=ETA,
        kappa_bits_per_user_step=KAPPA,
    )
    c1_row_a = _encoded_row(
        c1_bits=c1_a.difference_surplus_bits,
        c1_phi=c1_a.phi_difference,
        c2_bits=Fraction(),
    )
    c1_row_b = _encoded_row(
        c1_bits=c1_b.difference_surplus_bits,
        c1_phi=c1_b.phi_difference,
        c2_bits=Fraction(),
    )

    default_future = tuple(_projection(i, default, required_power_w=0.8) for i in (1, 2, 3))
    candidate_a = tuple(
        _projection(i, _network(210, 21), required_power_w=0.9)
        for i in (1, 2, 3)
    )
    candidate_b = (
        _projection(1, _network(180, 25), required_power_w=1.4),
        _projection(2, _network(190, 24), required_power_w=1.3),
        _projection(3, _network(195, 23), required_power_w=1.2),
    )
    c2_a = c2_persistence_forecast(
        candidate_a,
        default_future,
        lambda_bits_per_j=ETA,
        eta_ref=ETA,
        kappa_bits_per_user_step=KAPPA,
    )
    c2_b = c2_persistence_forecast(
        candidate_b,
        default_future,
        lambda_bits_per_j=ETA,
        eta_ref=ETA,
        kappa_bits_per_user_step=KAPPA,
    )
    c2_row_a = _encoded_row(
        c1_bits=Fraction(), c1_phi=Fraction(),
        c2_bits=c2_a.forecast_surplus_bits - c2_a.persistence_penalty_bits,
    )
    c2_row_b = _encoded_row(
        c1_bits=Fraction(), c1_phi=Fraction(),
        c2_bits=c2_b.forecast_surplus_bits - c2_b.persistence_penalty_bits,
    )

    assert c1_row_a.q1_state == c1_row_b.q1_state
    assert c1_row_a.q2_state == c1_row_b.q2_state
    assert c2_row_a.q1_state == c2_row_b.q1_state
    assert c2_row_a.q2_state == c2_row_b.q2_state
    assert c1_a.normalized_total != c1_b.normalized_total
    assert c2_a.normalized_total != c2_b.normalized_total

    q1_bytes = _packed_hex(c1_row_a.q1_state)
    q2_bytes = _packed_hex(c1_row_a.q2_state)
    return {
        "head_auxiliary_inputs": [],
        "q1_float_hex": [value.hex() for value in c1_row_a.q1_state],
        "q1_big_endian_float64_bytes_hex": q1_bytes,
        "q1_bytes_sha256": canonical_sha256({"bytes_hex": q1_bytes}),
        "q2_float_hex": [value.hex() for value in c1_row_a.q2_state],
        "q2_big_endian_float64_bytes_hex": q2_bytes,
        "q2_bytes_sha256": canonical_sha256({"bytes_hex": q2_bytes}),
        "c1": {
            "state_a": {
                "background_associations": {"1": [1001, 7], "2": [2002, 4]},
                "background_cross_gains_linear": {"1_to_focal": 1e-13, "2_to_focal": 2e-14},
                "coupled_power_w": {"focal": 0.8, "1": 0.4, "2": 0.3},
                "candidate_outcome": {"bits": 220, "joules": 22, "phi": -0.5},
