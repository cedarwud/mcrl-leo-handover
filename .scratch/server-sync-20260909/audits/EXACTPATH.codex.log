   895	                float(result.mean_acm_se_bit_s_hz[index]),
   896	            )
   897	            self._evaluated[config.configuration_id] = profile
   898	        evaluations = len(missing) * len(self.boundary_indices)
   899	        self.physical_evaluations += evaluations
   900	        if self.counter is not None:
   901	            self.counter.boundary_evaluations += evaluations
