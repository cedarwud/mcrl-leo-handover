@@ -0,0 +1,327 @@
+#!/usr/bin/env python3
+"""Fixed-configuration circuit-power sensitivity for the oracle receipt.
+
+This script does not evaluate propagation, power control, ACM, decoding, or
+selection.  It reconstructs active-chain and active-satellite exposure from
+the recorded assignments and the immutable exogenous-tape legality masks,
+then changes only the two linear fixed-power accounting terms.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import Mapping
+
+import numpy as np
+
+from mcrl.physics_v025.constants_v025 import D2_MEASUREMENT_STEP_S
+from mcrl.physics_v025.provider_legacy import factory as real_factory
+from mcrl.physics_v025.tapes import PROBE_WORLD_DOMAINS, build_world_tape
+
+
+CURRENT_CHAIN_W = 0.338
+CURRENT_SATELLITE_W = 0.200
+CHAIN_SWEEP_W = (0.0, 0.338, 1.0, 3.0, 7.0, 15.0)
+SATELLITE_SWEEP_W = (0.0, 0.200, 2.0)
+SELECTORS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
+
+
+def canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+
+
+def verify_source_receipt(payload: Mapping[str, object]) -> str:
+    declared = str(payload["receipt_sha256"])
+    unsigned = dict(payload)
+    del unsigned["receipt_sha256"]
+    actual = hashlib.sha256(canonical_bytes(unsigned)).hexdigest()
+    if actual != declared:
+        raise RuntimeError(f"source receipt hash mismatch: {actual} != {declared}")
+    return actual
+
+
+def parse_configuration_id(configuration_id: str) -> dict[int, tuple[int, int] | None]:
+    if not configuration_id.startswith("CFG:"):
+        raise ValueError(f"configuration does not encode assignments: {configuration_id}")
+    mapping: dict[int, tuple[int, int] | None] = {}
+    for encoded in configuration_id.removeprefix("CFG:").split(";"):
+        fields = encoded.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            if len(fields) != 2:
+                raise ValueError(f"malformed NULL assignment: {encoded}")
+            mapping[user] = None
+        else:
+            if len(fields) != 3:
+                raise ValueError(f"malformed physical assignment: {encoded}")
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    return mapping
+
+
+def baseline_mapping(tape, step_index: int) -> dict[int, tuple[int, int] | None]:
+    carrier = next(
+        row
+        for row in tape.carriers
+        if row.step_index == step_index and row.carrier == "nearest-eligible"
+    )
+    mapping = dict(carrier.assignments)
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("real oracle tape unexpectedly lacks compact arrays")
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    users_with_legal = {
+        int(arrays.users[int(arrays.row_user_column[row])])
+        for row in np.flatnonzero(live).tolist()
+    }
+    for user in mapping:
+        if user not in users_with_legal:
+            mapping[user] = None
+    return mapping
+
+
+def exposures(tape, step_index: int, mapping: Mapping[int, tuple[int, int] | None]) -> tuple[float, float]:
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("real oracle tape unexpectedly lacks compact arrays")
+    row_of = arrays._row_index()
+    rows: list[tuple[int, tuple[int, int]]] = []
+    for user, identity in sorted(mapping.items()):
+        if identity is None:
+            continue
+        try:
+            rows.append((row_of[(user, identity)], identity))
+        except KeyError:
+            raise RuntimeError(f"recorded assignment absent from tape: {user=} {identity=}") from None
+
+    beam_counts: list[int] = []
+    satellite_counts: list[int] = []
+    for boundary in range(48):
+        active_beams = {
+            identity
+            for row, identity in rows
+            if bool(arrays.visible[boundary, row])
+            and bool(arrays.d2_eligible[boundary, row])
+            and bool(arrays.cell_reachable[boundary, row])
+        }
+        beam_counts.append(len(active_beams))
+        satellite_counts.append(len({identity[0] for identity in active_beams}))
+
+    beam_seconds = math.fsum(
+        0.5 * (left + right) * D2_MEASUREMENT_STEP_S
+        for left, right in zip(beam_counts, beam_counts[1:])
+    )
+    satellite_seconds = math.fsum(
+        0.5 * (left + right) * D2_MEASUREMENT_STEP_S
+        for left, right in zip(satellite_counts, satellite_counts[1:])
+    )
+    return beam_seconds, satellite_seconds
+
+
+def selected_family(anchor: Mapping[str, object]) -> str:
+    selection = anchor["selection"]
+    assert isinstance(selection, Mapping)
+    aliases = selection["selected_candidate_aliases"]
+    assert isinstance(aliases, list) and aliases
+    first = aliases[0]
+    assert isinstance(first, Mapping)
+    return str(first["family"])
+
+
+def pooled(rows: list[dict[str, object]], selector: str, chain_w: float, satellite_w: float) -> dict[str, object]:
+    bits = math.fsum(float(row["selectors"][selector]["bits"]) for row in rows)  # type: ignore[index]
+    nonfixed_j = math.fsum(float(row["selectors"][selector]["nonfixed_j"]) for row in rows)  # type: ignore[index]
+    beam_seconds = math.fsum(float(row["selectors"][selector]["beam_seconds"]) for row in rows)  # type: ignore[index]
+    satellite_seconds = math.fsum(float(row["selectors"][selector]["satellite_seconds"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum((nonfixed_j, chain_w * beam_seconds, satellite_w * satellite_seconds))
+    served = sum(int(row["selectors"][selector]["served_count"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "nonfixed_j": nonfixed_j,
+        "beam_seconds": beam_seconds,
+        "satellite_seconds": satellite_seconds,
+        "chain_j": chain_w * beam_seconds,
+        "satellite_j": satellite_w * satellite_seconds,
+        "joules": joules,
+        "ee_bit_per_j": bits / joules,
+        "served_count_sum": served,
+    }
+
+
+def sweep(rows: list[dict[str, object]]) -> list[dict[str, object]]:
+    result = []
+    for chain_w in CHAIN_SWEEP_W:
+        for satellite_w in SATELLITE_SWEEP_W:
+            selectors = {
+                selector: pooled(rows, selector, chain_w, satellite_w)
+                for selector in SELECTORS
+            }
+            gain = (
+                float(selectors["ORACLE_SET"]["ee_bit_per_j"])
+                / float(selectors["UNILATERAL"]["ee_bit_per_j"])
+                - 1.0
+            )
+            result.append(
+                {
+                    "chain_w": chain_w,
+                    "satellite_w": satellite_w,
+                    "selectors": selectors,
+                    "oracle_over_unilateral_relative": gain,
+                }
+            )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    source_bytes = args.source.read_bytes()
+    source = json.loads(source_bytes)
+    source_receipt = verify_source_receipt(source)
+    anchors_by_key = {
+        (int(row["world_index"]), int(row["step_index"])): row
+        for row in source["anchors"]
+    }
+    rows: list[dict[str, object]] = []
+
+    for world_index, domain in enumerate(PROBE_WORLD_DOMAINS, start=1):
+        tape = build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=5,
+            start_time_s=0.0,
+        )
+        expected_world = next(row for row in source["worlds"] if int(row["world_index"]) == world_index)
+        if tape.digest != expected_world["world_sha256"]:
+            raise RuntimeError(f"world {world_index} tape digest mismatch")
+        for step_index in range(5):
+            anchor = anchors_by_key[(world_index, step_index)]
+            family = selected_family(anchor)
+            selector_rows: dict[str, object] = {}
+            for selector in SELECTORS:
+                committed = anchor["committed"][selector]
+                config_id = str(committed["configuration_id"])
+                mapping = (
+                    baseline_mapping(tape, step_index)
+                    if selector == "BASELINE"
+                    else parse_configuration_id(config_id)
+                )
+                beam_seconds, satellite_seconds = exposures(tape, step_index, mapping)
+                current_j = float(committed["joules"])
+                nonfixed_j = math.fsum(
+                    (
+                        current_j,
+                        -CURRENT_CHAIN_W * beam_seconds,
+                        -CURRENT_SATELLITE_W * satellite_seconds,
+                    )
+                )
+                reconstructed = math.fsum(
+                    (
+                        nonfixed_j,
+                        CURRENT_CHAIN_W * beam_seconds,
+                        CURRENT_SATELLITE_W * satellite_seconds,
+                    )
+                )
+                if not math.isclose(reconstructed, current_j, rel_tol=0.0, abs_tol=2.0e-11):
+                    raise RuntimeError("current-energy algebra did not close")
+                if nonfixed_j <= 0.0:
+                    raise RuntimeError("nonfixed energy is not positive")
+                selector_rows[selector] = {
+                    "configuration_id": config_id,
+                    "bits": float(committed["bits"]),
+                    "recorded_joules": current_j,
+                    "served_count": int(committed["served_count"]),
+                    "beam_seconds": beam_seconds,
+                    "satellite_seconds": satellite_seconds,
+                    "current_chain_j": CURRENT_CHAIN_W * beam_seconds,
+                    "current_satellite_j": CURRENT_SATELLITE_W * satellite_seconds,
+                    "nonfixed_j": nonfixed_j,
+                }
+            rows.append(
+                {
+                    "anchor_id": anchor["anchor_id"],
+                    "world_index": world_index,
+                    "step_index": step_index,
+                    "selected_family": family,
+                    "selected_alias_families": sorted(
+                        {alias["family"] for alias in anchor["selection"]["selected_candidate_aliases"]}
+                    ),
+                    "selectors": selector_rows,
+                }
+            )
+
+    current = {
+        selector: pooled(rows, selector, CURRENT_CHAIN_W, CURRENT_SATELLITE_W)
+        for selector in SELECTORS
+    }
+    for selector in SELECTORS:
+        expected = source["summary"]["pooled"][selector]
+        for key in ("bits", "joules", "ee_bit_per_j"):
+            if not math.isclose(float(current[selector][key]), float(expected[key]), rel_tol=2.0e-15, abs_tol=2.0e-8):
+                raise RuntimeError(f"current pooled {selector} {key} mismatch")
+        if current[selector]["served_count_sum"] != expected["served_count_sum"]:
+            raise RuntimeError(f"current pooled {selector} served mismatch")
+
+    family_rows = {
+        "complete-beam-evacuation": [
+            row for row in rows if row["selected_family"] == "complete-beam-evacuation"
+        ],
+        "other": [
+            row for row in rows if row["selected_family"] != "complete-beam-evacuation"
+        ],
+    }
+    payload: dict[str, object] = {
+        "schema": "mcrl-v025-fixed-configuration-circuit-sensitivity-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "source_file": str(args.source),
+        "source_file_sha256": hashlib.sha256(source_bytes).hexdigest(),
+        "source_receipt_sha256": source_receipt,
+        "method": (
+            "Recorded bits, served counts, and assignments are fixed. Active beam-seconds and "
+            "satellite-seconds are reconstructed only from immutable tape legality masks. "
+            "Recorded joules less the sealed 0.338*beam-seconds and 0.200*satellite-seconds "
+            "are held fixed; swept linear terms are then added. No propagation, power-control, "
+            "ACM, decoding, selection, threshold, or acceptance computation is rerun."
+        ),
+        "current_constants_w": {"chain": CURRENT_CHAIN_W, "satellite": CURRENT_SATELLITE_W},
+        "sweep_constants_w": {"chain": list(CHAIN_SWEEP_W), "satellite": list(SATELLITE_SWEEP_W)},
+        "anchor_count": len(rows),
+        "family_anchor_counts": {name: len(value) for name, value in family_rows.items()},
+        "dual_alias_anchor_count": sum(len(row["selected_alias_families"]) > 1 for row in rows),
+        "anchors": rows,
+        "sweep": sweep(rows),
+        "family_sweeps": {name: sweep(value) for name, value in family_rows.items()},
+        "current_reconstruction": current,
+        "checks": {
+            "source_receipt_hash_verified": True,
+            "world_tape_digests_verified": True,
+            "current_pooled_totals_reproduced": True,
+            "physics_rerun": False,
+            "selection_rerun": False,
+        },
+    }
+    unsigned = canonical_bytes(payload)
+    payload["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
+    args.output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="ascii")
+    print(json.dumps({
+        "receipt_sha256": payload["receipt_sha256"],
+        "anchor_count": len(rows),
+        "family_anchor_counts": payload["family_anchor_counts"],
+        "current": current,
+    }, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
