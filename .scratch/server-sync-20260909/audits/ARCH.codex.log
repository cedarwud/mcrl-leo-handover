            "C2": self.q2.payload() if isinstance(self.q2, AdamMLPHead) else {
                "kind": "pairwise_zero_bootstrap_linear",
                "weights_hex": [float_hex(value) for value in self.q2.weights],
                "bias_hex": float_hex(self.q2.bias),
            },
            "C3": self.psi.payload(),
        }


