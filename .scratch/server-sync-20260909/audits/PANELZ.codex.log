#!/usr/bin/env python3
"""Rebuild only the Stage-C view layer as [raw || live cross-user z]."""

from __future__ import annotations

from collections import Counter, defaultdict
import hashlib
import importlib.util
import json
import math
import os
from pathlib import Path
import resource
import sys
import time
from typing import Mapping, Sequence


THREAD_VARS = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)
for _name in THREAD_VARS:
    os.environ[_name] = "1"

import numpy as np  # noqa: E402

import q1_schema_v2 as q1v2  # noqa: E402
import zscore_view as zview  # noqa: E402


ROOT = Path("/home/sat/mcrl-v025-design-ws")
PARENT = ROOT / "artifacts/v025-stagec-c3-coalition-q1v2-20260910-BUILD_NOT_CLAIM"
PARENT_CORPUS = PARENT / "corpus"
OUTPUT = ROOT / "artifacts/v025-stagec-c3-coalition-q1v2z-20260910-BUILD_NOT_CLAIM"
CORPUS = OUTPUT / "corpus"
RECEIPT = OUTPUT / "BUILD_NOT_CLAIM-zscore-view-verification.json"
RUNNER_PATH = Path("/home/sat/mcrl-v025-retrain-ws/scripts/run_stagec_training.py")
PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
SOURCE_SCHEMA = "mcrl-v025-exact-source-view-shard-v1"
COALITION_SCHEMA = "mcrl-v025-stagec-c3-coalition-shard-v2"
MAX_AS_BYTES = 4_900_000_000


def canonical_bytes(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True,
                      allow_nan=False).encode("ascii")


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def python_processes() -> tuple[tuple[int, str], ...]:
    rows = []
    for path in Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            name = (path / "comm").read_text(encoding="ascii").strip()
        except (OSError, UnicodeError):
            continue
        if name.startswith("python"):
            rows.append((int(path.name), name))
    return tuple(sorted(rows))


def enforce_resources() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"thread pins drifted: {bad}")
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
    if len(python_processes()) > 3:
        raise RuntimeError(f"python-process cap exceeded: {python_processes()}")


def verify_sidecar(path: Path) -> str:
    fields = path.with_suffix(path.suffix + ".sha256").read_text(encoding="ascii").split()
    actual = file_sha256(path)
    if len(fields) != 2 or fields[0] != actual or fields[1] != path.name:
        raise RuntimeError(f"SHA-256 sidecar disagreement: {path}")
    return actual


def write_jsonl(path: Path, rows: Sequence[Mapping[str, object]]) -> str:
    if path.exists() or path.with_suffix(path.suffix + ".sha256").exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    digest = hashlib.sha256()
    with temp.open("wb") as handle:
        for row in rows:
            encoded = canonical_bytes(row) + b"\n"
            handle.write(encoded)
            digest.update(encoded)
        handle.flush()
        os.fsync(handle.fileno())
    temp.replace(path)
    hexdigest = digest.hexdigest()
    path.with_suffix(path.suffix + ".sha256").write_text(
        f"{hexdigest}  {path.name}\n", encoding="ascii"
    )
    if verify_sidecar(path) != hexdigest:
        raise RuntimeError("new sidecar did not round trip")
    return hexdigest


def write_json(path: Path, payload: object) -> None:
    if path.exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temp.open("wb") as handle:
        handle.write(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False).encode("ascii"))
        handle.write(b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temp.replace(path)


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def feature_material():
    sys.path.insert(0, "/home/sat/mcrl-v025-retrain-ws/src")
    import mcrl.stagec_v025.encoders as encoders
    default = encoders.encoder_variant()
    q1_schema, q2_schema, q1_digest, q2_digest = zview.schemas(
        q1v2.Q1_V2_FEATURES, q1v2.Q1_V2_SCHEMA_SHA256, default
    )
    return encoders, default, q1_schema, q2_schema, q1_digest, q2_digest


def install_reader_adapter(runner: object) -> dict[str, object]:
    encoders, default, q1_schema, q2_schema, q1_digest, q2_digest = feature_material()
    name = zview.ENCODER_NAME
    key = (q1_digest, q2_digest)
    if name in encoders._REGISTRY or key in encoders._DIGEST_INDEX:
        raise RuntimeError("z-score reader adapter unexpectedly pre-exists")
    q1_features = tuple(
        [encoders.FeatureSpec(f"raw__{item.name}", item.unit, item.scale)
         for item in q1v2.Q1_V2_FEATURES]
        + [encoders.FeatureSpec(f"z__{item.name}", "population standard deviation", 1.0)
           for item in q1v2.Q1_V2_FEATURES]
    )
    q2_features = tuple(
        [encoders.FeatureSpec(f"raw__{item.name}", item.unit, item.scale)
         for item in default.q2_features]
        + [encoders.FeatureSpec(f"z__{item.name}", "population standard deviation", 1.0)
           for item in default.q2_features]
    )
    variant = encoders.EncoderVariant(
        name=name,
        q1_features=q1_features,
        q2_features=q2_features,
        q1_raw=lambda _item: (),
        q2_raw=lambda _item: (),
        q1_schema=q1_schema,
        q2_schema=q2_schema,
        q1_schema_sha256=q1_digest,
        q2_schema_sha256=q2_digest,
    )
    encoders._REGISTRY[name] = variant
    encoders._DIGEST_INDEX[key] = name
    if runner.variant_for_digests(*key) is not variant:
        raise RuntimeError("production reader did not resolve z-score adapter")
    return {
        "name": name,
        "method": "in-process registration in the production runner encoder registry",
        "persistent_source_edits": False,
        "q1_schema": q1_schema,
        "q2_schema": q2_schema,
        "q1_schema_sha256": q1_digest,
        "q2_schema_sha256": q2_digest,
        "q1_width": len(q1_features),
        "q2_width": len(q2_features),
    }


def action_key(row: Mapping[str, object]) -> tuple[int | None, int | None]:
    action = row["action"]
    assert isinstance(action, Mapping)
    return (
        None if action["norad_id"] is None else int(action["norad_id"]),
        None if action["beam_chain_id"] is None else int(action["beam_chain_id"]),
    )


def parse_state(row: Mapping[str, object], name: str, width: int) -> np.ndarray:
    raw = row[name]
    if not isinstance(raw, list) or len(raw) != width:
        raise RuntimeError(f"{name} width drifted")
    values = np.asarray([float.fromhex(str(value)) for value in raw], dtype=np.float64)
    if not np.isfinite(values).all():
        raise RuntimeError(f"{name} contains nonfinite data")
    return values


def zscore_rows(
    rows: list[dict[str, object]],
    *,
    q1_digest: str,
    q2_digest: str,
    all_q1: list[np.ndarray],
    all_q2: list[np.ndarray],
    zero_counts: dict[str, np.ndarray],
) -> tuple[dict[tuple[int, tuple[int | None, int | None]], tuple[list[str], list[str]]], dict]:
    grouped: dict[tuple[int | None, int | None], list[int]] = defaultdict(list)
    seen: set[tuple[int, tuple[int | None, int | None]]] = set()
    for index, row in enumerate(rows):
        key = (int(row["user_id"]), action_key(row))
        if key in seen:
            raise RuntimeError("a user contributes twice to one anchor/action population")
        seen.add(key)
        grouped[key[1]].append(index)
    transformed: dict[tuple[int, tuple[int | None, int | None]], tuple[list[str], list[str]]] = {}
    group_sizes = []
    for action, indices in sorted(grouped.items(), key=lambda item: str(item[0])):
        q1_raw = np.stack([parse_state(rows[index], "q1_state", 15) for index in indices])
        q2_raw = np.stack([parse_state(rows[index], "q2_state", 22) for index in indices])
        q1_mean, q2_mean = q1_raw.mean(axis=0), q2_raw.mean(axis=0)
        q1_sigma, q2_sigma = q1_raw.std(axis=0, ddof=0), q2_raw.std(axis=0, ddof=0)
        q1_constant = np.all(q1_raw == q1_raw[0], axis=0)
        q2_constant = np.all(q2_raw == q2_raw[0], axis=0)
        q1_sigma = np.where(q1_constant, 0.0, q1_sigma)
        q2_sigma = np.where(q2_constant, 0.0, q2_sigma)
        zero_counts["q1_groups"] += q1_sigma == 0.0
        zero_counts["q2_groups"] += q2_sigma == 0.0
        zero_counts["q1_rows"] += len(indices) * (q1_sigma == 0.0)
        zero_counts["q2_rows"] += len(indices) * (q2_sigma == 0.0)
        group_sizes.append(len(indices))
        for local, index in enumerate(indices):
            q1_z = np.zeros(15, dtype=np.float64)
            q2_z = np.zeros(22, dtype=np.float64)
            np.divide(q1_raw[local] - q1_mean, q1_sigma, out=q1_z, where=q1_sigma != 0.0)
            np.divide(q2_raw[local] - q2_mean, q2_sigma, out=q2_z, where=q2_sigma != 0.0)
            if not np.isfinite(q1_z).all() or not np.isfinite(q2_z).all():
                raise RuntimeError("z-score produced nonfinite data")
            q1 = np.concatenate((q1_raw[local], q1_z))
            q2 = np.concatenate((q2_raw[local], q2_z))
            row = rows[index]
            parent_lineage = {
                "parent_row_sha256": canonical_sha256(row),
                "population_action": list(action),
                "population_users": [int(rows[item]["user_id"]) for item in indices],
                "q1_mean_hex": [float(value).hex() for value in q1_mean],
                "q1_sigma_hex": [float(value).hex() for value in q1_sigma],
                "q2_mean_hex": [float(value).hex() for value in q2_mean],
                "q2_sigma_hex": [float(value).hex() for value in q2_sigma],
                "population_rule": zview.POPULATION_RULE,
                "sigma_zero_rule": zview.ZERO_SIGMA_RULE,
            }
            row["q1_state"] = [float(value).hex() for value in q1]
            row["q2_state"] = [float(value).hex() for value in q2]
            row["q1_schema_sha256"] = q1_digest
            row["q2_schema_sha256"] = q2_digest
            row["visible_primitives_sha256"] = canonical_sha256(parent_lineage)
            transformed[(int(row["user_id"]), action)] = (
                list(row["q1_state"]), list(row["q2_state"])
            )
            all_q1.append(q1)
            all_q2.append(q2)
    return transformed, {
        "populations": len(grouped),
        "minimum_users": min(group_sizes),
        "maximum_users": max(group_sizes),
        "mean_users": math.fsum(group_sizes) / len(group_sizes),
    }


def matrix_census(matrix: np.ndarray, features: Sequence[object], zero_group: np.ndarray,
                  zero_rows: np.ndarray, group_count: int) -> dict[str, object]:
    width = len(features)
    centered = matrix - matrix.mean(axis=0)
    singular = np.linalg.svd(centered, compute_uv=False)
    positive = singular[singular > np.finfo(np.float64).eps * max(matrix.shape) * singular[0]]
    weights = positive * positive
    weights = weights / weights.sum()
    entropy_rank = float(np.exp(-np.sum(weights * np.log(weights))))
    slots = []
    for index, feature in enumerate(features):
        raw = matrix[:, index]
        z = matrix[:, index + width]
        if raw.std() == 0.0 or z.std() == 0.0:
            corr = None
            reason = "undefined because the corpus-wide raw or z column is constant"
        else:
            corr = float(np.corrcoef(raw, z)[0, 1])
            reason = None
        slots.append({
            "index": index,
            "name": feature.name,
            "raw_minimum": float(raw.min()),
            "raw_maximum": float(raw.max()),
            "raw_mean": float(raw.mean()),
            "raw_std": float(raw.std(ddof=0)),
            "z_minimum": float(z.min()),
            "z_maximum": float(z.max()),
            "z_mean": float(z.mean()),
            "z_std": float(z.std(ddof=0)),
            "sigma_zero_population_count": int(zero_group[index]),
            "sigma_zero_population_fraction": float(zero_group[index] / group_count),
            "sigma_zero_row_count": int(zero_rows[index]),
            "sigma_zero_row_fraction": float(zero_rows[index] / matrix.shape[0]),
            "raw_own_z_correlation": corr,
            "raw_own_z_correlation_note": reason,
        })
    return {
        "rows": int(matrix.shape[0]),
        "serialized_dimension": int(matrix.shape[1]),
        "matrix_rank": int(np.linalg.matrix_rank(matrix)),
        "mean_centered_matrix_rank_effective_dimension": int(np.linalg.matrix_rank(centered)),
        "entropy_effective_rank": entropy_rank,
        "slots": slots,
    }


def main() -> int:
    sys.dont_write_bytecode = True
    enforce_resources()
    if OUTPUT.exists():
        raise RuntimeError(f"output already exists: {OUTPUT}")
    if not PARENT_CORPUS.is_dir():
        raise RuntimeError(f"parent corpus absent: {PARENT_CORPUS}")
    runner = load_module("zscore_production_runner", RUNNER_PATH)
    _encoders, _default, _q1_schema, _q2_schema, q1_digest, q2_digest = feature_material()
    watched = {str(path): file_sha256(path) for path in (RUNNER_PATH, PARENT / "BUILD_NOT_CLAIM-corpus-v2-verification.json")}
    OUTPUT.mkdir(parents=True)
    source_files = sorted(PARENT_CORPUS.rglob("*exact-source*.jsonl"))
    coalition_files = sorted(PARENT_CORPUS.rglob("*COALITION*.jsonl"))
    if len(source_files) != 22 or len(coalition_files) != 22:
        raise RuntimeError("parent corpus anchor inventory drifted")
    all_q1: list[np.ndarray] = []
    all_q2: list[np.ndarray] = []
    zero_counts = {
        "q1_groups": np.zeros(15, dtype=np.int64),
        "q2_groups": np.zeros(22, dtype=np.int64),
        "q1_rows": np.zeros(15, dtype=np.int64),
        "q2_rows": np.zeros(22, dtype=np.int64),
    }
    anchor_receipts = []
    total_groups = 0
    started = time.perf_counter()
    for position, (source, coalition) in enumerate(zip(source_files, coalition_files, strict=True), 1):
        source_parent_digest = verify_sidecar(source)
        coalition_parent_digest = verify_sidecar(coalition)
        source_values = [json.loads(line) for line in source.read_text(encoding="ascii").splitlines()]
        header, rows = source_values[0], source_values[1:]
        if header.get("schema") != SOURCE_SCHEMA or header.get("q1_slots") != 15 or header.get("q2_slots") != 22:
            raise RuntimeError("parent source schema drifted")
        if len(rows) != int(header["row_count"]):
            raise RuntimeError("parent source row count drifted")
