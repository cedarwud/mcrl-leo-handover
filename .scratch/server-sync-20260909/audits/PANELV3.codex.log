            "parent_q1_v1_visible_primitives_sha256": parent_visible,
            "q1_v2_parent_schema_sha256": q1v3.Q1_V2_SCHEMA_SHA256,
            "row_key": row_key,
            "boundary_offset": 0,
            "off_axis_angle_rad_hex": float.hex(angle),
            "focal_elevation_deg_hex": float.hex(elevation),
            "nominal_gain_hex": None if nominal_gain is None else float.hex(nominal_gain),
        }
        v3_row = dict(row)
        v3_row["q1_state"] = [float.hex(value) for value in v3_state]
        v3_row["q1_schema_sha256"] = q1v3.Q1_V3_SCHEMA_SHA256
        v3_row["visible_primitives_sha256"] = canonical_sha256(
            {**common_lineage, "projection": "10*log10(nominal_gain)/100"}
