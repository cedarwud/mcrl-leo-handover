                    "exact_hex": row["c2_label_normalized_hex"],
                    "surrogate_hex": surrogate["c2_normalized_total_hex"],
                    "identity": c2_ok,
                }
            )

    output_header = dict(header)
    output_header["q1_slots"] = len(q1v3.Q1_V3_FEATURES)
    destinations = []
