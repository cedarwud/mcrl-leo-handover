+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Verify Q1-v3/control panels without making an EE or route claim."""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+
+
+PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+ROOT = Path("/home/sat/mcrl-v025-panelv3-ws")
+ORIGINAL = Path(
+    "/home/sat/mcrl-v025-witness-ws/artifacts/"
+    "stagec-scoring-panel-first20-v1.json"
+)
+Q1V2_PANEL = Path("/home/sat/mcrl-v025-panelfix-ws/artifacts/panel-q1v2.json")
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+C3_GAIN_COORDINATES = {16, 32, 54, 70}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_sha256(value: object) -> str:
+    return hashlib.sha256(json.dumps(
+        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("ascii")).hexdigest()
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise RuntimeError(message)
+
+
+def csv_rows(path: Path) -> int:
+    with path.open(newline="", encoding="utf-8") as handle:
+        return sum(1 for _row in csv.DictReader(handle))
+
+
+def checkpoint_identity(path: Path) -> dict[str, object]:
+    payload = json.loads(path.read_text(encoding="ascii"))
+    widths = {
+        route: {
+            len(payload["arms"][arm][route]["weights_hex"][0])
+            for arm in payload["arms"]
+        }
+        for route in ("C1", "C2", "C3")
+    }
+    members = {payload["arms"][arm]["C3"]["member_width"] for arm in payload["arms"]}
+    require(widths == {"C1": {16}, "C2": {22}, "C3": {240}}, "checkpoint widths drifted")
+    require(members == {38}, "checkpoint member width drifted")
+    return {
+        "path": str(path),
+        "sha256": sha256(path),
+        "learner_seed": int(payload["learner_seed"]),
+        "completed_source_epochs": int(payload["completed_source_epochs"]),
+    }
+
+
+def score_identity(score_dir: Path, panel: Path, checkpoint: dict[str, object]) -> dict[str, object]:
+    score_path = score_dir / "dual-axis-scores.json"
+    payload = json.loads(score_path.read_text(encoding="ascii"))
+    counts = {key: len(value) for key, value in payload["tables"].items()}
+    expected = {"F6_ablation": 9, "F7_training_trajectory": 5, "F8_recovered_fraction": 5}
+    require(counts == expected, f"score row counts drifted: {counts}")
+    require(payload["panel"]["sha256"] == sha256(panel), "score does not bind panel")
+    require(
+        payload["checkpoints"][0]["checkpoint"]["sha256"] == checkpoint["sha256"],
+        "score does not bind checkpoint",
+    )
+    require(csv_rows(score_dir / "F6-ablation.csv") == 9, "F6 CSV count drifted")
+    require(csv_rows(score_dir / "F7-training-trajectory.csv") == 5, "F7 CSV count drifted")
+    require(csv_rows(score_dir / "F8-recovered-fraction.csv") == 5, "F8 CSV count drifted")
+    resources = payload["resource_limits"]
+    require(resources["python_processes_used"] == 1, "scorer process count drifted")
+    require(int(resources["nice"]) >= 16, "scorer niceness drifted")
+    require(set(resources["blas_threads"].values()) == {"1"}, "scorer thread pins drifted")
+    require(int(resources["peak_rss_bytes"]) < 5_000_000_000, "scorer RSS cap exceeded")
+    return {
+        "path": str(score_path),
+        "sha256": sha256(score_path),
+        "row_counts": {"F6": 9, "F7": 5, "F8": 5},
+        "peak_rss_bytes": int(resources["peak_rss_bytes"]),
+        "exit_status": 0,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--v3-panel", type=Path, required=True)
+    parser.add_argument("--control-panel", type=Path, required=True)
+    parser.add_argument("--v3-checkpoint", type=Path, required=True)
+    parser.add_argument("--control-checkpoint", type=Path, required=True)
+    parser.add_argument("--v3-score", type=Path, required=True)
+    parser.add_argument("--control-score", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    require(Path(sys.executable).resolve() == PYTHON.resolve(), "wrong interpreter")
+    require(all(os.environ.get(name) == "1" for name in THREAD_VARS), "thread pins drifted")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 16:
+        os.nice(16 - os.getpriority(os.PRIO_PROCESS, 0))
+    require(os.getpriority(os.PRIO_PROCESS, 0) == 16, "niceness drifted")
+    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    cap = 4_900_000_000 if hard == resource.RLIM_INFINITY else min(hard, 4_900_000_000)
+    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
+    require(args.output.resolve().is_relative_to(ROOT.resolve()), "verification output outside workspace")
+    require(not args.output.exists(), "refusing to overwrite verification output")
+
+    original = json.loads(ORIGINAL.read_text(encoding="ascii"))
+    q1v2 = json.loads(Q1V2_PANEL.read_text(encoding="ascii"))
+    panels = {
+        "v3": json.loads(args.v3_panel.read_text(encoding="ascii")),
+        "v3_control": json.loads(args.control_panel.read_text(encoding="ascii")),
+    }
+    profile_count = 0
+    informative_nonzero_c1 = 0
+    informative_nonzero_c3 = 0
+    for index, rows in enumerate(zip(
+        original["anchors"], q1v2["anchors"], panels["v3"]["anchors"],
+        panels["v3_control"]["anchors"], strict=True,
+    ), 1):
+        prior, v2_anchor, v3_anchor, control_anchor = rows
+        prior_meta = {key: value for key, value in prior.items() if key != "profiles"}
+        for label, anchor in (("v3", v3_anchor), ("v3_control", control_anchor)):
+            require(
+                {key: value for key, value in anchor.items() if key != "profiles"} == prior_meta,
+                f"{label} anchor metadata drifted at {index - 1}",
+            )
+        require(len(prior["profiles"]) == len(v3_anchor["profiles"]) == len(control_anchor["profiles"]),
+                f"catalogue size drifted at {index - 1}")
+        for prior_profile, v2_profile, v3_profile, control_profile in zip(
+            prior["profiles"], v2_anchor["profiles"], v3_anchor["profiles"],
+            control_anchor["profiles"], strict=True,
+        ):
+            profile_count += 1
+            for current in (v3_profile, control_profile):
+                for field in ("profile_id", "catalogue_order", "outcome"):
+                    require(current[field] == prior_profile[field], f"physical core changed: {field}")
+                require(current["C2"] == prior_profile["C2"], "C2 state changed")
+                require(len(current["C3"]["invariant_state"]) == 240, "C3 width drifted")
