        )
        if v3_state[:15] != control_state[:15] or control_state[-1] != 0.0:
            raise RuntimeError("paired-control construction drifted")
        if not null_action:
            expected_added = float(log_gain_db) / q1v3.NOMINAL_GAIN_DB_SCALE
