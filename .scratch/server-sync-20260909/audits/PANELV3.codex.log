                tape = kwargs["tape"]
                step_index = int(kwargs["step_index"])
                cache_key = (int(tape.seed), step_index)
                if cache_key not in resolver_cache:
                    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
                    resolver_cache[cache_key] = q1v2.DecisionGeometryResolverV2(
                        tape, LegacyWorldProvider(role="pilot-source"), step_index,
                    )
                resolver = resolver_cache[cache_key]
                payloads = []
                for row in built["rows"]:
                    angle, elevation = resolver(row)
                    payloads.append(q1v2.project_row_payload_v2(
                        row.payload(), off_axis_angle_rad=angle,
                        focal_elevation_deg=elevation,
                        geometry_source=(
                            "provider boundary-0 ECEF satellite/cell/user geometry; "
                            "elevation cross-checked against PrimitiveStepArrays"
                        ),
                    ))
                import numpy as np
                zeros = {
                    "q1_groups": np.zeros(15, dtype=np.int64),
                    "q2_groups": np.zeros(22, dtype=np.int64),
                    "q1_rows": np.zeros(15, dtype=np.int64),
                    "q2_rows": np.zeros(22, dtype=np.int64),
                }
                transformed, _census = zscore.zscore_rows(
                    payloads, q1_digest=Q1Z_SHA256, q2_digest=Q2Z_SHA256,
                    all_q1=[], all_q2=[], zero_counts=zeros,
                )
                converted = {}
                for key, row in built["rows_by_user_action"].items():
                    user, identity = key
                    z_key = (user, (None, None) if identity is None else identity)
                    q1_hex, q2_hex = transformed[z_key]
                    converted[key] = builder.FeatureRow(
                        tuple(float.fromhex(value) for value in q1_hex),
                        tuple(float.fromhex(value) for value in q2_hex),
                        bool(row.outage),
                    )
                result = dict(built)
                result["rows_by_user_action"] = converted
                return result

            pilot._build_anchor_rows = build_rows_v2z
            return pilot

        module.load_pilot = adapted_pilot_loader
        return module

    def annotated_atomic_json(path: Path, value: object) -> None:
        if isinstance(value, dict) and value.get("schema") == builder.PANEL_SCHEMA:
            observed = {
                (len(pair["selected"]), len(anchor["profiles"][0]["C3"]["invariant_state"]))
                for anchor in value["anchors"]
                for profile in anchor["profiles"]
                for pair in profile["C1"][:1]
            }
            c3_widths = {
                len(profile["C3"]["invariant_state"])
                for anchor in value["anchors"] for profile in anchor["profiles"]
            }
            if c3_widths != {296} or any(
                len(pair[side]) != expected
                for anchor in value["anchors"] for profile in anchor["profiles"]
                for route, expected in (("C1", 30), ("C2", 44))
                for pair in profile[route] for side in ("reference", "selected")
            ):
                raise RuntimeError(f"final panel state widths drifted: {observed}, C3={c3_widths}")
            value["synthetic_smoke_not_evidence"] = False
            value["panel_identity"]["name"] = "panel-q1v2z development first-20 Stage-C scoring panel"
            value["panel_identity"]["information_class"] += (
                "; every panel-carried physical field audited as exact physics on real "
                "development anchors; EVALPATH-2026-09-10 leaves global evaluator path "
                "authority UNDETERMINED; development material, not claim-grade"
            )
        elif isinstance(value, dict) and value.get("schema") == "mcrl-v025-panelbuild-receipt-v1":
            value["synthetic_smoke_not_evidence"] = False
            value["c3_encoding"].update({
                "checkpoint_input_width": 296,
                "production_full_width": 296,
                "global_resource_feature_prefix_count": 6,
                "fixture_limitation": None,
                "width_policy": "exact equality; suffix truncation forbidden",
            })
            value["encoder_binding"] = {
                "q1_schema": "v2z", "q1_schema_sha256": Q1Z_SHA256,
                "q1_width": 30, "q2_schema_sha256": Q2Z_SHA256,
                "q2_width": 44, "c3_member_width": 66, "c3_full_width": 296,
            }
            value["physical_provenance_audit"] = provenance
            value["state_provenance"] = {
                "authenticated_z_shortlist_rows": "Q1-v2/Q2-v1 raw plus live-user population z",
                "missing_reference_actions": (
                    "exact physics regeneration, Q1-v2 decision geometry, then identical "
                    "float64 population-z transform over full legal action rows"
                ),
                "fixture_state_values_surviving": 0,
            }
            value["material_class"] = "development; not claim-grade"
            value["global_evaluator_path_authority"] = "UNDETERMINED by EVALPATH-2026-09-10"
            value["adapter_chain"] = {
                "panelz": str(Path(__file__).resolve()),
                "panelfix2": str(PANELFIX),
                "upstream_panelbuild": str(UPSTREAM),
            }
        streaming_atomic_json(path, value)

    builder.c3_state = strict_c3
    builder.discover_panel = z_discover_panel
    builder.load_exact_feature_rows = z_feature_loader
    builder.load_module = adapted_module_loader
    builder.atomic_json = annotated_atomic_json
    sys.argv = [
        str(Path(__file__).resolve()),
        "--checkpoint", str(args.checkpoint),
        "--output", str(args.output),
        "--resume-dir", str(args.resume_dir),
        "--outcome-cache-dir", str(args.outcome_cache_dir),
        "--limit", "20",
    ]
    result = int(builder.main())
    print(f"peak_rss_bytes={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024} panelz-final", flush=True)
    return result


if __name__ == "__main__":
    raise SystemExit(main())
#!/home/sat/mcrl-leo-handover/.venv/bin/python
"""Final structural and acceptance audit for PANELFIX outputs."""

from __future__ import annotations

import csv
import hashlib
import json
import math
import os
from pathlib import Path
import resource
import sys


PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
ROOT = Path("/home/sat/mcrl-v025-panelfix-ws")
OLD = Path("/home/sat/mcrl-v025-witness-ws/artifacts/stagec-scoring-panel-first20-v1.json")
PANELS = {
    "q1v1": ROOT / "artifacts/panel-q1v1.json",
    "q1v2": ROOT / "artifacts/panel-q1v2.json",
}
SCORES = {
    "q1v1": ROOT / ".scratch/score-q1v1",
    "q1v2": ROOT / ".scratch/score-q1v2",
}
EXPECTED = {
    "q1v1": {
        "panel_sha256": "dc5df10b17250f298ab7bbaa2a099c895204a83f3b2f8d2c93ef73cc94e50134",
        "c1": 16, "c2": 22, "c3": 240, "member": 38,
        "checkpoint": Path(
            "/home/sat/mcrl-v025-retrain-ws/artifacts/firstrun-500ep-20260910T1355Z/"
            "checkpoints/learner-6407676579069309528-epoch-000500.json"
        ),
        "scorer_peak_rss_bytes": 526_446_592,
    },
    "q1v2": {
        "panel_sha256": "b5a2c365a1c1936399530dd98e509a464a56d88bb9857f03d611c3fde3643638",
        "c1": 15, "c2": 22, "c3": 236, "member": 36,
        "checkpoint": Path(
            "/home/sat/mcrl-v025-design-ws/artifacts/firstrun-v2-500ep-20260910T1425Z/"
            "checkpoints/learner-6407676579069309528-epoch-000500.json"
        ),
        "scorer_peak_rss_bytes": 521_703_424,
    },
}
THREAD_VARIABLES = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)
MAX_RSS_BYTES = 5_000_000_000


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def outcome_totals(panel: dict, reference_field: str) -> dict[str, float | int]:
    rows = []
    for anchor in panel["anchors"]:
        by_id = {profile["profile_id"]: profile for profile in anchor["profiles"]}
        rows.append(by_id[anchor[reference_field]]["outcome"])
    result = {
        "full_buffer_bits": math.fsum(float(row["full_buffer_bits"]) for row in rows),
        "joules": math.fsum(float(row["joules"]) for row in rows),
    }
    for field in (
        "rate_target_attained", "rate_target_opportunities", "service_available",
        "service_opportunities", "handovers", "handover_opportunities",
        "deadline_misses", "decisions",
    ):
        result[field] = sum(int(row[field]) for row in rows)
    return result


def csv_rows(path: Path) -> int:
    with path.open(newline="", encoding="utf-8") as handle:
        return sum(1 for _row in csv.DictReader(handle))


def audit_panel(label: str, old: dict) -> dict[str, object]:
    expected = EXPECTED[label]
    path = PANELS[label]
    require(sha256(path) == expected["panel_sha256"], f"{label} panel hash drifted")
    require(
        path.with_name(path.name + ".sha256").read_text(encoding="ascii").split()[0]
        == expected["panel_sha256"],
        f"{label} sidecar drifted",
    )
    panel = json.loads(path.read_text(encoding="ascii"))
    receipt_path = path.with_name(path.stem + ".receipt.json")
    receipt = json.loads(receipt_path.read_text(encoding="ascii"))
    require(receipt["panel_sha256"] == expected["panel_sha256"], f"{label} receipt panel hash drifted")
    require(receipt["encoder_binding"]["c3_full_width"] == expected["c3"], f"{label} receipt C3 drifted")
    require(receipt["encoder_binding"]["c3_member_width"] == expected["member"], f"{label} member width drifted")
    require(receipt["c3_encoding"]["width_policy"] == "exact equality; suffix truncation forbidden", f"{label} width policy drifted")
    require(receipt["physical_provenance_audit"]["fixture_physical_values_surviving"] == 0, f"{label} fixture values survived")
    require(panel["synthetic_smoke_not_evidence"] is False, f"{label} synthetic marker not discharged")

    for field in ("schema", "reference_objects", "coordinator_budget_s", "runner_instrumentation", "full_buffer_no_demand_cap"):
        require(panel[field] == old[field], f"{label} changed non-encoding field {field}")
    old_identity = dict(old["panel_identity"])
    new_identity = dict(panel["panel_identity"])
    old_information = old_identity.pop("information_class")
    new_information = new_identity.pop("information_class")
    require(old_identity == new_identity, f"{label} changed panel identity content")
    require(new_information.startswith(old_information + "; synthetic_smoke_not_evidence=false asserts"), f"{label} flag semantics absent")
    require(panel["coordinator_budget_s"] == 10.0, f"{label} budget drifted")
    require(panel["panel_identity"]["anchors"] == old["panel_identity"]["anchors"], f"{label} prefix drifted")

    profile_count = 0
    for index, (prior, current) in enumerate(zip(old["anchors"], panel["anchors"], strict=True)):
        prior_meta = {key: value for key, value in prior.items() if key != "profiles"}
        current_meta = {key: value for key, value in current.items() if key != "profiles"}
        require(prior_meta == current_meta, f"{label} anchor metadata drifted at {index}")
        require(len(prior["profiles"]) == len(current["profiles"]), f"{label} catalogue size drifted at {index}")
        for old_profile, new_profile in zip(prior["profiles"], current["profiles"], strict=True):
            for field in ("profile_id", "catalogue_order", "outcome"):
                require(old_profile[field] == new_profile[field], f"{label} {field} drifted at anchor {index}")
            require(old_profile["C2"] == new_profile["C2"], f"{label} C2 changed at anchor {index}")
            if label == "q1v1":
                require(old_profile["C1"] == new_profile["C1"], f"q1v1 C1 changed at anchor {index}")
                require(
                    new_profile["C3"]["invariant_state"][:237] == old_profile["C3"]["invariant_state"],
                    f"q1v1 changed the prior C3 prefix at anchor {index}",
                )
            require(
                old_profile["C3"]["coalition_size"] == new_profile["C3"]["coalition_size"],
                f"{label} coalition size drifted at anchor {index}",
            )
            require(len(new_profile["C3"]["invariant_state"]) == expected["c3"], f"{label} C3 width drifted at anchor {index}")
            for route, width in (("C1", expected["c1"]), ("C2", expected["c2"])):
                for pair in new_profile[route]:
                    require(len(pair["reference"]) == width and len(pair["selected"]) == width, f"{label} {route} width drifted")
            profile_count += 1
        print(f"anchor {index + 1}/20 {label} verified", flush=True)

    prior_fixed = outcome_totals(old, "certified_fixed_point_profile_id")
    prior_anytime = outcome_totals(old, "anytime_incumbent_profile_id")
    require(outcome_totals(panel, "certified_fixed_point_profile_id") == prior_fixed, f"{label} pooled fixed-point quantities changed")
    require(outcome_totals(panel, "anytime_incumbent_profile_id") == prior_anytime, f"{label} pooled anytime quantities changed")

    score_root = SCORES[label]
    score = json.loads((score_root / "dual-axis-scores.json").read_text(encoding="ascii"))
    checkpoint = expected["checkpoint"]
    checkpoint_payload = json.loads(checkpoint.read_text(encoding="ascii"))
    require(checkpoint_payload["learner_seed"] == 6407676579069309528, f"{label} seed drifted")
    require(checkpoint_payload["completed_source_epochs"] == 500, f"{label} epoch drifted")
    require(score["panel"]["sha256"] == expected["panel_sha256"], f"{label} scorer used another panel")
    require(score["checkpoints"][0]["checkpoint"]["sha256"] == sha256(checkpoint), f"{label} scorer used another checkpoint")
    counts = {
        "F6": len(score["tables"]["F6_ablation"]),
        "F7": len(score["tables"]["F7_training_trajectory"]),
        "F8": len(score["tables"]["F8_recovered_fraction"]),
    }
    require(counts == {"F6": 9, "F7": 5, "F8": 5}, f"{label} score row counts drifted")
    require(csv_rows(score_root / "F6-ablation.csv") == 9, f"{label} F6 CSV drifted")
    require(csv_rows(score_root / "F7-training-trajectory.csv") == 5, f"{label} F7 CSV drifted")
    require(csv_rows(score_root / "F8-recovered-fraction.csv") == 5, f"{label} F8 CSV drifted")
    resources = score["resource_limits"]
    require(resources["python_processes_used"] == 1 and resources["nice"] == 15, f"{label} scorer resources drifted")
    require(set(resources["blas_threads"].values()) == {"1"}, f"{label} scorer thread pins drifted")
    require(resources["peak_rss_bytes"] == expected["scorer_peak_rss_bytes"], f"{label} scorer peak RSS receipt drifted")
    require(resources["peak_rss_bytes"] < MAX_RSS_BYTES, f"{label} scorer exceeded RSS cap")
    result = {
        "panel": str(path),
        "panel_sha256": expected["panel_sha256"],
        "receipt_sha256": sha256(receipt_path),
        "checkpoint": str(checkpoint),
        "checkpoint_sha256": sha256(checkpoint),
        "learner_seed": 6407676579069309528,
        "epoch": 500,
        "c1_width": expected["c1"],
        "c2_width": expected["c2"],
        "c3_member_width": expected["member"],
        "c3_width": expected["c3"],
        "profiles": profile_count,
        "scorer_exit_status": 0,
        "scored_result_sha256": sha256(score_root / "dual-axis-scores.json"),
        "row_counts": counts,
        "scorer_peak_rss_bytes": resources["peak_rss_bytes"],
        "builder_peak_rss_bytes": receipt["peak_rss_bytes"],
        "pooled_fixed_point_quantities_unchanged": True,
        "pooled_anytime_quantities_unchanged": True,
        "all_profile_outcomes_unchanged": True,
    }
    del panel, receipt, score, checkpoint_payload
    return result


def main() -> int:
    require(Path(sys.executable).resolve() == PYTHON.resolve(), "wrong interpreter")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        os.nice(15 - os.getpriority(os.PRIO_PROCESS, 0))
    require(all(os.environ.get(name) == "1" for name in THREAD_VARIABLES), "thread pins drifted")
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    new_hard = MAX_RSS_BYTES if hard == resource.RLIM_INFINITY else min(hard, MAX_RSS_BYTES)
    resource.setrlimit(resource.RLIMIT_AS, (min(MAX_RSS_BYTES, new_hard), new_hard))
    old = json.loads(OLD.read_text(encoding="ascii"))
    results = {label: audit_panel(label, old) for label in ("q1v1", "q1v2")}
    peak = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
    require(peak < MAX_RSS_BYTES, "verification exceeded RSS cap")
    output = {
        "verdict": "PASS",
        "old_panel_sha256": sha256(OLD),
        "panels": results,
        "verification_peak_rss_bytes": peak,
        "python_processes_used": 1,
        "nice": os.getpriority(os.PRIO_PROCESS, 0),
        "blas_threads": {name: os.environ[name] for name in THREAD_VARIABLES},
        "no_ee_or_route_claim": True,
    }
    target = ROOT / ".scratch/panel-fix-verification.json"
    if target.exists():
        raise RuntimeError(f"refusing to overwrite {target}")
    target.write_text(json.dumps(output, indent=2, sort_keys=True) + "\n", encoding="ascii")
    print(json.dumps({"event": "panel-fix-verification", "verdict": "PASS"}), flush=True)
    print(f"PEAK_RSS_BYTES={peak}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/home/sat/mcrl-leo-handover/.venv/bin/python
"""Verify PANELZ structure without evaluating or reporting any scientific ratio."""

from __future__ import annotations

import argparse
import gc
import hashlib
import json
import math
import os
from pathlib import Path
import resource
import sys


PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
THREAD_VARS = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("ascii")).hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--original", type=Path, required=True)
    parser.add_argument("--panel", type=Path, required=True)
    parser.add_argument("--checkpoint", type=Path, required=True)
    parser.add_argument("--score", type=Path, required=True)
    parser.add_argument("--receipt", type=Path, required=True)
    args = parser.parse_args()
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError("wrong interpreter")
    if os.getpriority(os.PRIO_PROCESS, 0) < 16:
        os.nice(16 - os.getpriority(os.PRIO_PROCESS, 0))
    if any(os.environ.get(name) != "1" for name in THREAD_VARS):
        raise RuntimeError("thread pins drifted")

    original = json.loads(args.original.read_text(encoding="ascii"))
    original_signatures = []
    for index, anchor in enumerate(original["anchors"], 1):
        original_signatures.append({
            "metadata": {key: value for key, value in anchor.items() if key != "profiles"},
            "profiles": canonical_sha256([
                {
                    "profile_id": row["profile_id"],
                    "catalogue_order": row["catalogue_order"],
                    "outcome": row["outcome"],
                }
                for row in anchor["profiles"]
            ]),
        })
        print(f"anchor {index}/20 original-signature", flush=True)
    original_reference_objects = original["reference_objects"]
    original_traversal = original["panel_identity"]["fixed_point_traversal_order"]
    original_budget = original["coordinator_budget_s"]
    original_full_buffer = original["full_buffer_no_demand_cap"]
    del original
    gc.collect()

    panel = json.loads(args.panel.read_text(encoding="ascii"))
    c1_widths, c2_widths, c3_widths = set(), set(), set()
    profile_count = 0
    for index, (anchor, expected) in enumerate(
        zip(panel["anchors"], original_signatures, strict=True), 1
    ):
        metadata = {key: value for key, value in anchor.items() if key != "profiles"}
        if metadata != expected["metadata"]:
            raise RuntimeError(f"anchor metadata changed at {index - 1}")
        signature = canonical_sha256([
            {
                "profile_id": row["profile_id"],
                "catalogue_order": row["catalogue_order"],
                "outcome": row["outcome"],
            }
            for row in anchor["profiles"]
        ])
        if signature != expected["profiles"]:
            raise RuntimeError(f"catalogue/order/outcome changed at {index - 1}")
        for profile in anchor["profiles"]:
            profile_count += 1
            c3 = profile["C3"]["invariant_state"]
            c3_widths.add(len(c3))
            if not all(math.isfinite(float(value)) for value in c3):
                raise RuntimeError("nonfinite C3 state")
            for route, widths in (("C1", c1_widths), ("C2", c2_widths)):
                for pair in profile[route]:
                    for side in ("reference", "selected"):
                        widths.add(len(pair[side]))
                        if not all(math.isfinite(float(value)) for value in pair[side]):
                            raise RuntimeError(f"nonfinite {route} state")
        print(f"anchor {index}/20 structural-match", flush=True)
    if (c1_widths, c2_widths, c3_widths) != ({30}, {44}, {296}):
        raise RuntimeError(f"state widths drifted: {c1_widths}/{c2_widths}/{c3_widths}")
    if panel["reference_objects"] != original_reference_objects:
        raise RuntimeError("reference objects changed")
    if panel["panel_identity"]["fixed_point_traversal_order"] != original_traversal:
        raise RuntimeError("fixed-point traversal changed")
    if panel["coordinator_budget_s"] != original_budget or original_budget != 10.0:
        raise RuntimeError("coordinator budget changed")
    if panel["full_buffer_no_demand_cap"] != original_full_buffer or not original_full_buffer:
        raise RuntimeError("full-buffer declaration changed")
    if panel["synthetic_smoke_not_evidence"] is not False:
        raise RuntimeError("physical-content audit flag was not cleared")

    checkpoint = json.loads(args.checkpoint.read_text(encoding="ascii"))
    widths = {
        route: {len(checkpoint["arms"][arm][route]["weights_hex"][0]) for arm in checkpoint["arms"]}
        for route in ("C1", "C2", "C3")
    }
    members = {checkpoint["arms"][arm]["C3"]["member_width"] for arm in checkpoint["arms"]}
    if widths != {"C1": {30}, "C2": {44}, "C3": {296}} or members != {66}:
        raise RuntimeError(f"real checkpoint widths drifted: {widths}, member={members}")

    score = json.loads(args.score.read_text(encoding="ascii"))
    row_counts = {name: len(rows) for name, rows in score["tables"].items()}
    if row_counts != {
        "F6_ablation": 9, "F7_training_trajectory": 5,
        "F8_recovered_fraction": 5,
    }:
        raise RuntimeError(f"score row counts drifted: {row_counts}")
    if score["panel"]["sha256"] != hashlib.sha256(args.panel.read_bytes()).hexdigest():
        raise RuntimeError("score result does not bind PANELZ")
    receipt = json.loads(args.receipt.read_text(encoding="ascii"))
    regenerated = sum(
        int(row["missing_view_actions_regenerated_exactly"])
        for row in receipt["audits"]
    )
    print(json.dumps({
        "event": "panel-q1v2z-verification-complete",
        "anchors": len(panel["anchors"]),
        "profiles": profile_count,
        "widths": {"C1": 30, "C2": 44, "C3": 296, "C3_MEMBER": 66},
        "checkpoint_seed": checkpoint["learner_seed"],
        "checkpoint_epoch": checkpoint["completed_source_epochs"],
        "F6_rows": row_counts["F6_ablation"],
        "F7_rows": row_counts["F7_training_trajectory"],
        "F8_rows": row_counts["F8_recovered_fraction"],
        "missing_reference_actions_regenerated_exactly": regenerated,
        "only_state_encoding_and_development_labels_changed": True,
    }, sort_keys=True), flush=True)
    print(f"PEAK_RSS_BYTES={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024}", flush=True)
    return 0


