            gain_db_min = min(gain_db_min, log_gain_db)
            gain_db_max = max(gain_db_max, log_gain_db)

        old = tuple(float.fromhex(str(value)) for value in row["q1_state"])
        v3_state = q1v3.q1_v3_state_from_v1(
            old,
            off_axis_angle_rad=angle,
            focal_elevation_deg=elevation,
            nominal_gain=nominal_gain,
            null_action=null_action,
        )
        control_state = q1v3.q1_v3_state_from_v1(
