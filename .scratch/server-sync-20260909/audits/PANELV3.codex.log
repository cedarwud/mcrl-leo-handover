+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Build Q1-v3 scoring panels through the PANELFIX2/PANELZ adapter seam."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+from typing import Mapping
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-panelv3-ws")
+PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+PANELFIX = Path("/home/sat/mcrl-v025-panelfix-ws/scripts/build_stagec_scoring_panel.py")
+UPSTREAM = Path("/home/sat/mcrl-v025-witness-ws/scripts/build_stagec_scoring_panel.py")
+ORIGINAL_RECEIPT = Path(
+    "/home/sat/mcrl-v025-witness-ws/artifacts/"
+    "stagec-scoring-panel-first20-v1.receipt.json"
+)
+Q1V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+Q1V3_PATH = Path("/home/sat/mcrl-v025-q1v3-ws/q1_schema_v3.py")
+Q1V3_BUILD_PATH = Path("/home/sat/mcrl-v025-q1v3-ws/build_q1_v3_corpora.py")
+V3_ROOT = Path(
+    "/home/sat/mcrl-v025-q1v3-ws/artifacts/"
+    "q1-v3-exact-label-corpus-20260910"
+)
+CONTROL_ROOT = Path(
+    "/home/sat/mcrl-v025-q1v3-ws/artifacts/"
+    "q1-v3-control-exact-label-corpus-20260910"
+)
+Q1_V3_SHA256 = "3850d23fa9cd5a5c2744e60c57e103766ecc73cf46cdf8755382e61e3aaafc01"
+Q1_V3_CONTROL_SHA256 = "ee6baea90d824d52bfa1e7c3a775fa191235e6f6db9d85c32674c608740cfc8f"
+Q2_V1_SHA256 = "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c"
+EXPECTED_WIDTHS = {"C1": 16, "C2": 22, "C3": 240, "C3_MEMBER": 38}
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+FLAG_ASSERTION = (
+    "synthetic_smoke_not_evidence=false asserts that every panel-carried "
+    "physical field comes from exact physics on real development anchors; it "
+    "does not validate the contaminated reference-object selection path, "
+    "determine global evaluator-path authority, or make this development panel claim-grade"
+)
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def verify_sidecar(path: Path) -> str:
+    actual = sha256(path)
+    sidecar = path.with_name(path.name + ".sha256")
+    if not sidecar.is_file() or sidecar.read_text(encoding="ascii").split()[0] != actual:
+        raise RuntimeError(f"sidecar mismatch: {path}")
+    return actual
+
+
+def beneath_workspace(path: Path) -> bool:
+    try:
+        path.resolve().relative_to(WORKSPACE.resolve())
+    except ValueError:
+        return False
+    return True
+
+
+def enforce_runtime() -> None:
+    if Path(sys.executable).resolve() != PYTHON.resolve():
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if any(os.environ.get(name) != "1" for name in THREAD_VARS):
+        raise RuntimeError("all BLAS thread variables must equal 1")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 16:
+        os.nice(16 - os.getpriority(os.PRIO_PROCESS, 0))
+    if os.getpriority(os.PRIO_PROCESS, 0) != 16:
+        raise RuntimeError("could not enforce nice -n 16")
+    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    cap = 4_900_000_000 if hard == resource.RLIM_INFINITY else min(hard, 4_900_000_000)
+    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--view", choices=("v3", "v3_control"), required=True)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--resume-dir", type=Path, required=True)
+    parser.add_argument("--outcome-cache-dir", type=Path, required=True)
+    args = parser.parse_args()
+    enforce_runtime()
+    if not beneath_workspace(args.output) or not beneath_workspace(args.resume_dir):
+        raise RuntimeError("writes must remain below PANELV3 workspace")
+    if args.output.exists():
+        raise RuntimeError(f"refusing to overwrite {args.output}")
+
+    panelfix = load_module("panelv3_panelfix", PANELFIX)
+    provenance = panelfix.audit_physical_provenance()
+    if provenance.get("fixture_physical_values_surviving") != 0:
+        raise RuntimeError("fixture physical value survived PANELFIX2 audit")
+    provenance = dict(provenance)
+    provenance.update({
+        "q1_v3_gain_field": (
+            "authenticated boundary-0 nominal_gain, independently formula-checked by "
+            "Q1-v3 corpus builder and rechecked here row by row"
+        ),
+        "fixture_physical_values_surviving": 0,
+    })
+    print("physical provenance PASS: no fixture value survives", flush=True)
+
+    builder = load_module("panelv3_upstream", UPSTREAM)
+    q1v2 = load_module("panelv3_q1v2", Q1V2_PATH)
+    q1v3 = load_module("panelv3_q1v3", Q1V3_PATH)
+    q1build = load_module("panelv3_q1build", Q1V3_BUILD_PATH)
+    original_load_module = builder.load_module
+    root = V3_ROOT if args.view == "v3" else CONTROL_ROOT
+    q1_digest = Q1_V3_SHA256 if args.view == "v3" else Q1_V3_CONTROL_SHA256
+    control = args.view == "v3_control"
+    upstream_receipt = json.loads(ORIGINAL_RECEIPT.read_text(encoding="ascii"))
+
+    def streaming_atomic_json(path: Path, value: object) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+        encoder = json.JSONEncoder(
+            indent=2, sort_keys=True, allow_nan=False, ensure_ascii=True,
+        )
+        with temporary.open("w", encoding="ascii") as handle:
+            for chunk in encoder.iterencode(value):
+                handle.write(chunk)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        temporary.replace(path)
+
+    def discover_panel(limit: int):
+        if limit != 20:
+            raise RuntimeError("PANELV3 requires exactly global anchors 000--019")
+        parents = upstream_receipt["run_identity"]["sources"]
+        if [int(row["index"]) for row in parents] != list(range(20)):
+            raise RuntimeError("PANELBUILD source prefix drifted")
+        sources = []
+        for index, parent in enumerate(parents):
+            view = (
+                root / "views/world-1"
+                / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
+            )
+            digest = verify_sidecar(view)
+            header = json.loads(view.read_bytes().splitlines()[0])
+            actual = (
+                int(header["global_anchor_index"]), int(header["step_index"]),
+                int(header["carrier_index"]), int(header["q1_slots"]),
+                int(header["q2_slots"]),
+            )
+            expected = (index, index // 3, index % 3, 16, 22)
+            if actual != expected:
+                raise RuntimeError(f"Q1-v3 anchor generation order/width drifted at {index}")
+            sources.append({
+                **parent,
+                "view_path": str(view),
+                "view_sha256": digest,
+                "state_view_schema": args.view,
+                "q1_schema_sha256": q1_digest,
+            })
+        return sources
+
+    def strict_c3(pilot, tape, step_index, base, config, rows_by_action,
+                  width: int, member_width: int):
+        changed = tuple(
+            user for user in sorted(base.mapping)
+            if base.mapping[user] != config.mapping[user]
+        )
+        if len(changed) <= 1:
+            return len(changed), [0.0] * width
+        context = pilot._coalition_context(
+            tape=tape, step_index=step_index, anchor=base, selected=config,
+            rows_by_user_action=rows_by_action,
+        )
+        full = context.invariant_vector(member_width=member_width).tolist()
+        if len(full) != width:
+            raise RuntimeError(
+                f"checkpoint C3 width {width} differs from complete bound encoder "
+                f"width {len(full)}; truncation is forbidden"
+            )
+        return len(changed), full
+
+    def feature_loader(source: Mapping[str, object], widths: Mapping[str, int]):
+        if dict(widths) != EXPECTED_WIDTHS:
+            raise RuntimeError(f"Q1-v3 checkpoint shape drifted: {dict(widths)!r}")
+        index = int(source["index"])
+        path = (
+            root / "views/world-1"
+            / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
+        )
+        verify_sidecar(path)
+        raw_lines = path.read_bytes().splitlines()
+        values = [json.loads(line.decode("ascii")) for line in raw_lines]
+        header = values[0]
+        if (
+            header.get("schema") != "mcrl-v025-exact-source-view-shard-v1"
+            or header.get("global_anchor_index") != index
+            or header.get("q1_slots") != 16
+            or header.get("q2_slots") != 22
+        ):
+            raise RuntimeError(f"Q1-v3 exact-view header drifted: {path}")
+        geometry, _physics_digest = q1build.load_physics_geometry(index, len(values) - 1)
+        result = {}
+        for raw, payload in zip(raw_lines[1:], values[1:], strict=True):
+            canonical = json.dumps(
+                payload, sort_keys=True, separators=(",", ":"), allow_nan=False,
+            ).encode("ascii")
+            if raw != canonical or "exact_source_view" not in payload:
+                raise RuntimeError("Q1-v3 exact-source row is unauthenticated")
+            if (
+                payload.get("q1_schema_sha256") != q1_digest
+                or payload.get("q2_schema_sha256") != Q2_V1_SHA256
+            ):
+                raise RuntimeError("Q1-v3 row schema digest drifted")
+            action = payload["action"]
+            identity = None if action["norad_id"] is None else (
+                int(action["norad_id"]), int(action["beam_chain_id"])
+            )
+            key = (int(payload["user_id"]), identity)
+            q1 = tuple(float.fromhex(value) for value in payload["q1_state"])
+            q2 = tuple(float.fromhex(value) for value in payload["q2_state"])
+            if len(q1) != 16 or len(q2) != 22 or key in result:
+                raise RuntimeError("Q1-v3 source row width or identity drifted")
+            candidate = geometry[str(payload["exact_source_view"]["row_key"])]
+            if bool(payload["null_action"]):
+                expected_gain_coordinate = 0.0
+                if candidate.get("identity") is not None:
+                    raise RuntimeError("null row retained physical focal-link geometry")
+            else:
+                nominal_gain = float.fromhex(str(candidate["nominal_gain_hex"]))
+                recomputed = q1build.independently_recompute_nominal_gain(candidate)
+                if abs(recomputed - nominal_gain) / nominal_gain > 2e-14:
+                    raise RuntimeError("nominal-gain physical formula audit failed")
+                expected_gain_coordinate = (
+                    q1v3.decision_boundary_log_nominal_gain_db(nominal_gain)
+                    / q1v3.NOMINAL_GAIN_DB_SCALE
+                )
+            if q1[-1] != (0.0 if control else expected_gain_coordinate):
+                raise RuntimeError("Q1-v3 gain coordinate provenance failed")
+            result[key] = builder.FeatureRow(q1, q2, bool(payload["outage"]))
+        if len(result) != int(header["row_count"]):
+            raise RuntimeError("Q1-v3 source row count drifted")
+        return result
+
+    def adapted_module_loader(name: str, path: Path):
+        module = original_load_module(name, path)
+        if path != builder.PANELCEIL_PATH:
+            return module
+        original_pilot_loader = module.load_pilot
+
+        def adapted_pilot_loader():
+            pilot = original_pilot_loader()
+            original_build_rows = pilot._build_anchor_rows
+            resolver_cache = {}
+
+            def build_rows_v3(**kwargs):
+                built = original_build_rows(**kwargs)
+                tape = kwargs["tape"]
+                step_index = int(kwargs["step_index"])
+                cache_key = (int(tape.seed), step_index)
+                if cache_key not in resolver_cache:
+                    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+                    resolver_cache[cache_key] = q1v2.DecisionGeometryResolverV2(
+                        tape, LegacyWorldProvider(role="pilot-source"), step_index,
+                    )
+                resolver = resolver_cache[cache_key]
+                arrays = tape.steps[step_index].arrays
+                if arrays is None:
+                    raise RuntimeError("Q1-v3 exact regeneration requires provider arrays")
+                row_index = arrays._row_index()
+                converted = {}
+                for key, row in built["rows_by_user_action"].items():
+                    angle, elevation = resolver(row)
+                    if bool(row.null_action):
+                        nominal_gain = None
+                    else:
+                        user, identity = key
+                        array_row = row_index[(user, identity)]
+                        nominal_gain = float(arrays.nominal_gain[0, array_row])
+                        slant = float(arrays.slants_km[0, array_row])
+                        peak_receive = 10.0 ** (q1build.RX_GAIN_MAX_DBI / 10.0)
+                        path_factor = q1build.LegacyWorldProvider._nominal_path_without_scintillation(
+                            q1build.np.asarray(slant), q1build.np.asarray(elevation),
+                            q1build.np.asarray(peak_receive),
+                        )
+                        recomputed = float(
+                            q1build.transmit_gain_linear(q1build.np.asarray(math.degrees(angle)))
+                            * path_factor
+                        )
+                        if abs(recomputed - nominal_gain) / nominal_gain > 2e-14:
+                            raise RuntimeError("regenerated nominal-gain formula audit failed")
+                    q1 = q1v3.q1_v3_state_from_v1(
+                        row.q1_state,
+                        off_axis_angle_rad=angle,
+                        focal_elevation_deg=elevation,
+                        nominal_gain=nominal_gain,
+                        null_action=bool(row.null_action),
+                        control=control,
+                    )
+                    converted[key] = builder.FeatureRow(
+                        q1, tuple(row.q2_state), bool(row.outage),
+                    )
+                result = dict(built)
+                result["rows_by_user_action"] = converted
+                return result
+
+            pilot._build_anchor_rows = build_rows_v3
+            return pilot
+
+        module.load_pilot = adapted_pilot_loader
+        return module
+
+    def annotated_atomic_json(path: Path, value: object) -> None:
+        if isinstance(value, dict) and value.get("schema") == builder.PANEL_SCHEMA:
+            c1_widths, c2_widths, c3_widths = set(), set(), set()
+            for anchor in value["anchors"]:
+                for profile in anchor["profiles"]:
+                    c3_widths.add(len(profile["C3"]["invariant_state"]))
+                    for route, widths in (("C1", c1_widths), ("C2", c2_widths)):
+                        for pair in profile[route]:
+                            widths.update((len(pair["reference"]), len(pair["selected"])))
+            if (c1_widths, c2_widths, c3_widths) != ({16}, {22}, {240}):
+                raise RuntimeError(
+                    f"final panel state widths drifted: {c1_widths}/{c2_widths}/{c3_widths}"
+                )
+            value["synthetic_smoke_not_evidence"] = False
+            value["panel_identity"]["name"] = (
+                f"panel-q1{args.view} development first-20 Stage-C scoring panel"
+            )
+            value["panel_identity"]["information_class"] += "; " + FLAG_ASSERTION
+        elif isinstance(value, dict) and value.get("schema") == "mcrl-v025-panelbuild-receipt-v1":
+            value["synthetic_smoke_not_evidence"] = False
+            value["c3_encoding"].update({
+                "checkpoint_input_width": 240,
+                "production_full_width": 240,
+                "global_resource_feature_prefix_count": 6,
+                "fixture_limitation": None,
+                "width_policy": "exact equality; suffix truncation forbidden",
+            })
+            value["encoder_binding"] = {
+                "view": args.view,
+                "q1_schema_sha256": q1_digest,
+                "q1_width": 16,
+                "q2_schema_sha256": Q2_V1_SHA256,
+                "q2_width": 22,
+                "c3_member_width": 38,
+                "c3_full_width": 240,
+            }
+            value["physical_provenance_audit"] = provenance
+            value["state_provenance"] = {
+                "authenticated_rows": (
+                    "Q1-v3 corpus rows; gain coordinate rechecked against authenticated "
+                    "nominal_gain and provider formula"
+                ),
+                "missing_reference_actions": (
+                    "exact non-primitive evaluator regeneration; Q1-v2 decision geometry; "
+                    "provider-array nominal gain; identical Q1-v3 projection"
+                ),
+                "fixture_state_values_surviving": 0,
+            }
+            value["reference_object_provenance"] = {
+                "total_objects": 40,
+                "panelceil_reused": 24,
+                "panelceil_anchor_indices": list(range(12)),
+                "producer_computed": 16,
+                "producer_anchor_indices": list(range(12, 20)),
+                "objects_per_anchor": ["certified_fixed_point", "anytime_incumbent_10s"],
+                "selection_evaluator_path": (
+                    "PANELCEIL first_improvement: fresh realised boundary_indices=(0,) "
+                    "StepEvaluator; scalar evaluate(BASE) cache fill, then dense evaluate_many "
+                    "candidate microbatches; contaminated mixed path"
+                ),
+            }
+            value["synthetic_flag_semantics"] = FLAG_ASSERTION
+            value["material_class"] = "development; not claim-grade"
+            value["global_evaluator_path_authority"] = "UNDETERMINED by EVALPATH-2026-09-10"
+            value["adapter_chain"] = {
+                "panelv3": str(Path(__file__).resolve()),
+                "panelfix2": str(PANELFIX),
+                "panelz_exact_equality_pattern": (
+                    "/home/sat/mcrl-v025-panelz-ws/scripts/build_panel_q1v2z.py"
+                ),
+                "upstream_panelbuild": str(UPSTREAM),
+            }
+        streaming_atomic_json(path, value)
+
+    builder.c3_state = strict_c3
+    builder.discover_panel = discover_panel
+    builder.load_exact_feature_rows = feature_loader
+    builder.load_module = adapted_module_loader
+    builder.atomic_json = annotated_atomic_json
+    sys.argv = [
+        str(Path(__file__).resolve()),
+        "--checkpoint", str(args.checkpoint),
+        "--output", str(args.output),
+        "--resume-dir", str(args.resume_dir),
+        "--outcome-cache-dir", str(args.outcome_cache_dir),
+        "--limit", "20",
+    ]
+    result = int(builder.main())
+    print(
+        f"PEAK_RSS_BYTES={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024}",
+        flush=True,
+    )
+    return result
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
