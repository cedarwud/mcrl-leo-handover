    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("ascii")).hexdigest()


def verify_sidecar(path: Path) -> str:
    actual = sha256(path)
    fields = path.with_name(path.name + ".sha256").read_text(encoding="ascii").split()
    if not fields or fields[0] != actual:
        raise RuntimeError(f"sidecar mismatch: {path}")
    return actual


def audit_physical_cache(outcome_cache_dir: Path) -> dict[str, object]:
    if sha256(ORIGINAL_PANEL) != EXPECTED_PANEL_SHA256:
        raise RuntimeError("PANELBUILD panel bytes drifted")
    panel = json.loads(ORIGINAL_PANEL.read_text(encoding="ascii"))
    receipt = json.loads(ORIGINAL_RECEIPT.read_text(encoding="ascii"))
    if receipt.get("panel_sha256") != EXPECTED_PANEL_SHA256:
        raise RuntimeError("PANELBUILD receipt does not bind the panel")
    anchors = panel.get("anchors")
    if not isinstance(anchors, list) or len(anchors) != 20:
        raise RuntimeError("PANELBUILD anchor inventory drifted")
    if {str(row["date"])[:10] for row in anchors} != {"2026-01-07"}:
        raise RuntimeError("panel contains a non-development date")
    cache = receipt["run_identity"]["outcome_cache"]
    if outcome_cache_dir.resolve() != Path(cache["path"]).resolve():
        raise RuntimeError("requested outcome cache differs from authenticated cache")
    files = cache["files"]
    exact_evaluations = 0
    for index, record in enumerate(files):
        if record["name"] != f"anchor-{index:03d}.json":
            raise RuntimeError("outcome cache ordering drifted")
        path = outcome_cache_dir / record["name"]
        if sha256(path) != record["sha256"]:
            raise RuntimeError(f"outcome cache digest drifted at anchor {index}")
        cached = json.loads(path.read_text(encoding="ascii"))
        current = anchors[index]
        if cached["anchor"]["anchor_id"] != current["anchor_id"]:
            raise RuntimeError(f"cached anchor identity drifted at {index}")
        if [row["profile_id"] for row in cached["anchor"]["profiles"]] != [
            row["profile_id"] for row in current["profiles"]
        ]:
            raise RuntimeError(f"cached catalogue drifted at {index}")
        if [row["outcome"] for row in cached["anchor"]["profiles"]] != [
            row["outcome"] for row in current["profiles"]
        ]:
            raise RuntimeError(f"cached physical outcomes drifted at {index}")
        audit = cached["audit"]
        if audit["invalid_profiles"] != 0 or audit["fixed_point_certificate_complete"] is not True:
            raise RuntimeError(f"cached physical/certificate audit failed at {index}")
        exact_evaluations += int(audit["outcome_physics_boundary_evaluations"])
    if sha256(PANELCEIL_RECEIPT) != EXPECTED_PANELCEIL_SHA256:
        raise RuntimeError("PANELCEIL receipt bytes drifted")
    ceiling = json.loads(PANELCEIL_RECEIPT.read_text(encoding="ascii"))
    unsigned = dict(ceiling)
    claimed = unsigned.pop("receipt_sha256", None)
    if ceiling.get("status") != "COMPLETE" or claimed != canonical_sha256(unsigned):
        raise RuntimeError("PANELCEIL receipt is incomplete or unauthenticated")
    return {
        "verdict": "PASS_EXACT_PHYSICS_REAL_DEVELOPMENT_ANCHORS",
        "anchor_indices": list(range(20)),
        "development_dates": ["2026-01-07"],
        "catalogue_and_outcomes": "authenticated field-for-field against PANELBUILD",
        "fixed_points": "12 PANELCEIL plus 8 complete producer certificates",
        "exact_outcome_boundary_evaluations": exact_evaluations,
        "fixture_physical_values_surviving": 0,
    }


def beneath_workspace(path: Path) -> bool:
    try:
        path.resolve().relative_to(WORKSPACE.resolve())
    except ValueError:
        return False
    return True


def enforce_runtime() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if any(os.environ.get(name) != "1" for name in THREAD_VARS):
        raise RuntimeError("all BLAS thread variables must equal 1")
    if os.getpriority(os.PRIO_PROCESS, 0) < 16:
        os.nice(16 - os.getpriority(os.PRIO_PROCESS, 0))
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    cap = 4_900_000_000 if hard == resource.RLIM_INFINITY else min(hard, 4_900_000_000)
    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--checkpoint", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--resume-dir", type=Path, required=True)
    parser.add_argument("--outcome-cache-dir", type=Path, required=True)
    args = parser.parse_args()
    enforce_runtime()
    if not beneath_workspace(args.output) or not beneath_workspace(args.resume_dir):
        raise RuntimeError("writes must remain below PANELZ workspace")
    if args.output.exists():
        raise RuntimeError(f"refusing to overwrite {args.output}")

    provenance = audit_physical_cache(args.outcome_cache_dir)
    if provenance.get("fixture_physical_values_surviving") != 0:
        raise RuntimeError("fixture physical value survived provenance audit")
    print("physical provenance PASS: no fixture value survives", flush=True)

    builder = load_module("panelz_upstream", UPSTREAM)
    sys.path.insert(0, str(Q1V2_PATH.parent))
    q1v2 = load_module("panelz_q1v2", Q1V2_PATH)
    zscore = load_module("panelz_zscore", ZSCORE_BUILDER_PATH)
    original_atomic_json = builder.atomic_json
    original_load_module = builder.load_module

    def streaming_atomic_json(path: Path, value: object) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
        encoder = json.JSONEncoder(
            indent=2, sort_keys=True, allow_nan=False, ensure_ascii=True,
        )
        with temporary.open("w", encoding="ascii") as handle:
            for chunk in encoder.iterencode(value):
                handle.write(chunk)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        temporary.replace(path)

    def z_discover_panel(limit: int):
        if limit != 20:
            raise RuntimeError("PANELZ requires exactly the global 000--019 prefix")
        upstream_receipt = json.loads(ORIGINAL_RECEIPT.read_text(encoding="ascii"))
        parents = upstream_receipt["run_identity"]["sources"]
        if [int(row["index"]) for row in parents] != list(range(20)):
            raise RuntimeError("PANELBUILD source prefix drifted")
        sources = []
        for index, parent in enumerate(parents):
            view = (
                ZSCORE_ROOT / f"global-{index:03d}" / "views" / "world-1"
                / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
            )
            digest = verify_sidecar(view)
            header = json.loads(view.read_bytes().splitlines()[0])
            expected = (index, index // 3, index % 3)
            actual = (
                int(header["global_anchor_index"]), int(header["step_index"]),
                int(header["carrier_index"]),
            )
            if actual != expected:
                raise RuntimeError(f"z anchor generation order drifted at {index}")
            sources.append({
                **parent,
                "view_path": str(view),
                "view_sha256": digest,
                "state_view_schema": "Q1-v2/Q2-v1 raw-plus-live-user-z",
            })
        return sources

    def strict_c3(pilot, tape, step_index, base, config, rows_by_action,
                  width: int, member_width: int):
        changed = tuple(
            user for user in sorted(base.mapping)
            if base.mapping[user] != config.mapping[user]
        )
        if len(changed) <= 1:
            return len(changed), [0.0] * width
        context = pilot._coalition_context(
            tape=tape, step_index=step_index, anchor=base, selected=config,
            rows_by_user_action=rows_by_action,
        )
        full = context.invariant_vector(member_width=member_width).tolist()
        if len(full) != width:
            raise RuntimeError(
                f"checkpoint C3 width {width} differs from complete bound encoder "
                f"width {len(full)}; truncation is forbidden"
            )
        return len(changed), full

    def z_feature_loader(source: Mapping[str, object], widths: Mapping[str, int]):
        if dict(widths) != EXPECTED_WIDTHS:
            raise RuntimeError(f"z checkpoint shape drifted: {dict(widths)!r}")
        index = int(source["index"])
        path = (
            ZSCORE_ROOT / f"global-{index:03d}" / "views" / "world-1"
            / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
        )
        verify_sidecar(path)
        lines = path.read_bytes().splitlines()
        values = [json.loads(line.decode("ascii")) for line in lines]
        header = values[0]
        if (
            header.get("schema") != "mcrl-v025-exact-source-view-shard-v1"
            or header.get("global_anchor_index") != index
            or header.get("q1_slots") != 30
            or header.get("q2_slots") != 44
        ):
            raise RuntimeError(f"z exact-view header drifted: {path}")
        result = {}
        for raw, payload in zip(lines[1:], values[1:], strict=True):
            canonical = json.dumps(
                payload, sort_keys=True, separators=(",", ":"), allow_nan=False,
            ).encode("ascii")
            if raw != canonical or "exact_source_view" not in payload:
                raise RuntimeError("z exact-source row is unauthenticated")
            if (
                payload.get("q1_schema_sha256") != Q1Z_SHA256
                or payload.get("q2_schema_sha256") != Q2Z_SHA256
            ):
                raise RuntimeError("z row schema digest drifted")
            action = payload["action"]
            identity = None if action["norad_id"] is None else (
                int(action["norad_id"]), int(action["beam_chain_id"])
            )
            key = (int(payload["user_id"]), identity)
            q1 = tuple(float.fromhex(value) for value in payload["q1_state"])
            q2 = tuple(float.fromhex(value) for value in payload["q2_state"])
            if len(q1) != 30 or len(q2) != 44 or key in result:
                raise RuntimeError("z source row width or identity drifted")
            result[key] = builder.FeatureRow(q1, q2, bool(payload["outage"]))
        if len(result) != int(header["row_count"]):
            raise RuntimeError("z source row count drifted")
        return result

    def adapted_module_loader(name: str, path: Path):
        module = original_load_module(name, path)
        if path != builder.PANELCEIL_PATH:
            return module
        original_pilot_loader = module.load_pilot

        def adapted_pilot_loader():
            pilot = original_pilot_loader()
            original_build_rows = pilot._build_anchor_rows
            resolver_cache = {}

            def build_rows_v2z(**kwargs):
                built = original_build_rows(**kwargs)
                tape = kwargs["tape"]
                step_index = int(kwargs["step_index"])
                cache_key = (int(tape.seed), step_index)
                if cache_key not in resolver_cache:
                    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
                    resolver_cache[cache_key] = q1v2.DecisionGeometryResolverV2(
                        tape, LegacyWorldProvider(role="pilot-source"), step_index,
                    )
                resolver = resolver_cache[cache_key]
                payloads = []
                for row in built["rows"]:
                    angle, elevation = resolver(row)
                    payloads.append(q1v2.project_row_payload_v2(
                        row.payload(), off_axis_angle_rad=angle,
                        focal_elevation_deg=elevation,
                        geometry_source=(
                            "provider boundary-0 ECEF satellite/cell/user geometry; "
                            "elevation cross-checked against PrimitiveStepArrays"
                        ),
                    ))
                import numpy as np
                zeros = {
                    "q1_groups": np.zeros(15, dtype=np.int64),
                    "q2_groups": np.zeros(22, dtype=np.int64),
                    "q1_rows": np.zeros(15, dtype=np.int64),
                    "q2_rows": np.zeros(22, dtype=np.int64),
                }
                transformed, _census = zscore.zscore_rows(
                    payloads, q1_digest=Q1Z_SHA256, q2_digest=Q2Z_SHA256,
                    all_q1=[], all_q2=[], zero_counts=zeros,
                )
                converted = {}
                for key, row in built["rows_by_user_action"].items():
                    user, identity = key
                    z_key = (user, (None, None) if identity is None else identity)
                    q1_hex, q2_hex = transformed[z_key]
                    converted[key] = builder.FeatureRow(
                        tuple(float.fromhex(value) for value in q1_hex),
                        tuple(float.fromhex(value) for value in q2_hex),
                        bool(row.outage),
                    )
                result = dict(built)
                result["rows_by_user_action"] = converted
                return result

            pilot._build_anchor_rows = build_rows_v2z
            return pilot

        module.load_pilot = adapted_pilot_loader
        return module

    def annotated_atomic_json(path: Path, value: object) -> None:
        if isinstance(value, dict) and value.get("schema") == builder.PANEL_SCHEMA:
            observed = {
                (len(pair["selected"]), len(anchor["profiles"][0]["C3"]["invariant_state"]))
                for anchor in value["anchors"]
                for profile in anchor["profiles"]
                for pair in profile["C1"][:1]
            }
            c3_widths = {
                len(profile["C3"]["invariant_state"])
                for anchor in value["anchors"] for profile in anchor["profiles"]
            }
            if c3_widths != {296} or any(
                len(pair[side]) != expected
                for anchor in value["anchors"] for profile in anchor["profiles"]
                for route, expected in (("C1", 30), ("C2", 44))
                for pair in profile[route] for side in ("reference", "selected")
            ):
                raise RuntimeError(f"final panel state widths drifted: {observed}, C3={c3_widths}")
            value["synthetic_smoke_not_evidence"] = False
            value["panel_identity"]["name"] = "panel-q1v2z development first-20 Stage-C scoring panel"
            value["panel_identity"]["information_class"] += (
                "; every panel-carried physical field audited as exact physics on real "
                "development anchors; EVALPATH-2026-09-10 leaves global evaluator path "
                "authority UNDETERMINED; development material, not claim-grade"
            )
        elif isinstance(value, dict) and value.get("schema") == "mcrl-v025-panelbuild-receipt-v1":
            value["synthetic_smoke_not_evidence"] = False
            value["c3_encoding"].update({
                "checkpoint_input_width": 296,
                "production_full_width": 296,
                "global_resource_feature_prefix_count": 6,
                "fixture_limitation": None,
                "width_policy": "exact equality; suffix truncation forbidden",
            })
            value["encoder_binding"] = {
                "q1_schema": "v2z", "q1_schema_sha256": Q1Z_SHA256,
                "q1_width": 30, "q2_schema_sha256": Q2Z_SHA256,
                "q2_width": 44, "c3_member_width": 66, "c3_full_width": 296,
            }
            value["physical_provenance_audit"] = provenance
            value["state_provenance"] = {
                "authenticated_z_shortlist_rows": "Q1-v2/Q2-v1 raw plus live-user population z",
                "missing_reference_actions": (
                    "exact physics regeneration, Q1-v2 decision geometry, then identical "
                    "float64 population-z transform over full legal action rows"
                ),
                "fixture_state_values_surviving": 0,
            }
            value["material_class"] = "development; not claim-grade"
            value["global_evaluator_path_authority"] = "UNDETERMINED by EVALPATH-2026-09-10"
            value["adapter_chain"] = {
                "panelz": str(Path(__file__).resolve()),
                "panelfix2": str(PANELFIX),
                "upstream_panelbuild": str(UPSTREAM),
            }
        streaming_atomic_json(path, value)

    builder.c3_state = strict_c3
    builder.discover_panel = z_discover_panel
    builder.load_exact_feature_rows = z_feature_loader
    builder.load_module = adapted_module_loader
    builder.atomic_json = annotated_atomic_json
    sys.argv = [
        str(Path(__file__).resolve()),
        "--checkpoint", str(args.checkpoint),
        "--output", str(args.output),
        "--resume-dir", str(args.resume_dir),
        "--outcome-cache-dir", str(args.outcome_cache_dir),
        "--limit", "20",
    ]
    result = int(builder.main())
    print(f"peak_rss_bytes={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024} panelz-final", flush=True)
    return result


if __name__ == "__main__":
    raise SystemExit(main())

