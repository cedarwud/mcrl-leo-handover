    )


def physics_path(index: int) -> Path:
    return PHYSICS_ROOT / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"


def action_key(user_id: int, action: Mapping[str, object]) -> tuple[int, int | None, int | None]:
    norad = action["norad_id"]
    beam = action["beam_chain_id"]
    return (
        int(user_id),
        None if norad is None else int(norad),
        None if beam is None else int(beam),
    )


def fraction(payload: Mapping[str, object]) -> Fraction:
    raw = payload["fraction"]
    if not isinstance(raw, list) or len(raw) != 2:
        raise RuntimeError("malformed exact rational extension")
    value = Fraction(int(raw[0]), int(raw[1]))
    if payload["float_hex"] != float.hex(float(value)):
        raise RuntimeError("exact rational/float-hex disagreement")
    return value


def load_physics_geometry(index: int, expected_rows: int) -> tuple[dict[str, dict[str, object]], str]:
    path = physics_path(index)
    digest = verify_sidecar(path)
    rows: dict[str, dict[str, object]] = {}
    with path.open("r", encoding="ascii") as handle:
        header = json.loads(next(handle))
        if header.get("schema") != PHYSICS_HEADER_SCHEMA:
            raise RuntimeError(f"physics header schema drifted at global-{index:03d}")
        if int(header["global_anchor_index"]) != index:
            raise RuntimeError("physics anchor index drifted")
        for line in handle:
            if f'"schema":"{PHYSICS_ROW_SCHEMA}"' not in line:
                continue
            payload = json.loads(line)
            geometry = payload["candidate_geometry_offsets_0_1_2_3"][0]
            row_key = str(payload["row_key"])
            if row_key in rows:
                raise RuntimeError("duplicate physics row key")
            rows[row_key] = geometry
    if len(rows) != expected_rows:
        raise RuntimeError(
            f"physics/source row inventory mismatch at {index}: {len(rows)} != {expected_rows}"
        )
    return rows, digest


def independently_recompute_nominal_gain(geometry: Mapping[str, object]) -> float:
    angle = float.fromhex(str(geometry["true_off_axis_angle_deg_hex"]))
    slant = float.fromhex(str(geometry["slant_km_hex"]))
    elevation = float.fromhex(str(geometry["elevation_deg_hex"]))
    peak_receive = 10.0 ** (RX_GAIN_MAX_DBI / 10.0)
    path = LegacyWorldProvider._nominal_path_without_scintillation(
        np.asarray(slant), np.asarray(elevation), np.asarray(peak_receive)
    )
    return float(transmit_gain_linear(np.asarray(angle)) * path)


def assert_only_source_view_changes(
    parent: Mapping[str, object], child: Mapping[str, object]
) -> None:
    permitted = {"q1_state", "q1_schema_sha256", "visible_primitives_sha256"}
    if set(parent) != set(child):
        raise RuntimeError("source row field inventory changed")
    if any(parent[key] != child[key] for key in set(parent) - permitted):
        raise RuntimeError("a source row field outside the Q1 view changed")


def label_identity(row: Mapping[str, object]) -> tuple[bool, bool]:
    extension = row["exact_source_view"]
    c1 = extension["c1_difference_surplus"]
    c2 = extension["c2_persistence_forecast"]
    c1_residual = abs(
        float.fromhex(str(row["c1_label_normalized_hex"]))
        - float.fromhex(str(c1["normalized_total"]["float_hex"]))
    )
    c2_residual = abs(
        float.fromhex(str(row["c2_label_normalized_hex"]))
        - float.fromhex(str(c2["normalized_total"]["float_hex"]))
    )
    c1_ok = fraction(c1["decomposition_residual"]) == 0 and c1_residual <= 1e-12
    c2_ok = (
        fraction(c2["decomposition_residual"]) == 0
        and fraction(c2["label_bits"])
        == fraction(c2["forecast_surplus_bits"]) - fraction(c2["persistence_penalty_bits"])
        and c2_residual <= 1e-12
    )
    return c1_ok, c2_ok


def build_source_anchor(
    index: int,
    sample_rows: dict[str, list[dict[str, object]]],
) -> tuple[dict[tuple[int, int | None, int | None], dict[str, object]], dict[str, object]]:
    parent_path = source_path(index)
    parent_digest = verify_sidecar(parent_path)
    values = read_canonical_jsonl(parent_path)
    header, rows = values[0], values[1:]
    if (
        header.get("schema") != SOURCE_SCHEMA
        or int(header["global_anchor_index"]) != index
        or int(header["row_count"]) != len(rows)
        or int(header["q1_slots"]) != 16
        or int(header["q2_slots"]) != 22
    ):
        raise RuntimeError(f"source header drifted at global-{index:03d}")
    geometry, physics_digest = load_physics_geometry(index, len(rows))
    v3_rows = []
    control_rows = []
    lookup: dict[tuple[int, int | None, int | None], dict[str, object]] = {}
    legal_rows = 0
    null_rows = 0
    recompute_relative_max = 0.0
    gain_db_min = math.inf
