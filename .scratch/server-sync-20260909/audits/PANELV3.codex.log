def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("ascii")).hexdigest()


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def below_workspace(path: Path) -> bool:
    try:
        path.resolve().relative_to(WORKSPACE.resolve())
    except ValueError:
        return False
    return True


def verify_sidecar(path: Path, expected: str | None = None) -> str:
    actual = sha256(path)
    if expected is not None and actual != expected:
        raise RuntimeError(f"authenticated file changed: {path}")
    sidecar = path.with_name(path.name + ".sha256")
    if not sidecar.is_file() or sidecar.read_text(encoding="ascii").split()[0] != actual:
        raise RuntimeError(f"sidecar mismatch: {path}")
    return actual


def resolved_sources(receipt: Mapping[str, object]) -> list[dict[str, object]]:
    """Resolve deleted staging paths to receipt-identical retained files."""

    resolved = []
    for source in receipt["run_identity"]["sources"]:
        index = int(source["index"])
        original_physics = str(source["physics_path"])
        marker = "/physics/"
        if marker not in original_physics:
            raise RuntimeError(f"source physics path has no retained-relative seam at {index}")
        physics_relative = original_physics.split(marker, 1)[1]
        row = dict(source)
        row["physics_path"] = str(EXACT_FINAL_ROOT / "physics" / physics_relative)
        row["view_path"] = str(
            Q1_V1_STAGING / f"global-{index:03d}" / "views" / "world-1"
            / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
        )
        row["retained_copy_binding"] = "original receipt SHA-256, not mutable datepool manifest"
        resolved.append(row)
    if [row["index"] for row in resolved] != list(range(20)):
        raise RuntimeError("resolved exact-source prefix is not global 000--019")
    return resolved


def audit_physical_provenance() -> dict[str, object]:
    """Authenticate every provenance link used by the outcome-cache rebuild."""

    if sha256(ORIGINAL_PANEL) != EXPECTED_PANEL_SHA256:
        raise RuntimeError("sealed-input panel bytes drifted")
    receipt = json.loads(ORIGINAL_RECEIPT.read_text(encoding="ascii"))
    if receipt.get("panel_sha256") != EXPECTED_PANEL_SHA256:
        raise RuntimeError("PANELBUILD receipt does not bind the nominated panel")
    if receipt.get("anchor_count") != 20:
        raise RuntimeError("PANELBUILD receipt is not the declared first-20 panel")

    panel = json.loads(ORIGINAL_PANEL.read_text(encoding="ascii"))
    anchors = panel.get("anchors")
    if not isinstance(anchors, list) or len(anchors) != 20:
        raise RuntimeError("panel anchor inventory drifted")
    if panel.get("synthetic_smoke_not_evidence") is not True:
        raise RuntimeError("historical marker unexpectedly changed")
    if {str(row.get("date"))[:10] for row in anchors} != {"2026-01-07"}:
        raise RuntimeError("panel is not confined to the declared development date")

    sources = resolved_sources(receipt)
    if [row["index"] for row in sources] != list(range(20)):
        raise RuntimeError("exact-source prefix is not global 000--019")
    for source in sources:
        for name in ("physics", "view"):
            path = Path(source[f"{name}_path"])
            expected = str(source[f"{name}_sha256"])
            if sha256(path) != expected:
                raise RuntimeError(f"{name} authentication failed at anchor {source['index']}")
            verify_sidecar(path, expected)
        result_path = Path(source["result_path"])
        if result_path.is_file() and sha256(result_path) != source["result_sha256"]:
            raise RuntimeError(f"staging result authentication failed at anchor {source['index']}")

    cache = receipt["run_identity"]["outcome_cache"]
    files = cache["files"]
    if [row["name"] for row in files] != [f"anchor-{i:03d}.json" for i in range(20)]:
        raise RuntimeError("outcome-cache file inventory drifted")
    exact_outcome_boundary_evaluations = 0
    producer_reference_anchors = 0
    for index, row in enumerate(files):
        path = Path(cache["path"]) / row["name"]
        if sha256(path) != row["sha256"]:
            raise RuntimeError(f"outcome cache authentication failed at anchor {index}")
        cached = json.loads(path.read_text(encoding="ascii"))
        cached_anchor = cached["anchor"]
        audit = cached["audit"]
        current = anchors[index]
        if cached_anchor["anchor_id"] != current["anchor_id"]:
            raise RuntimeError(f"outcome cache anchor identity drifted at {index}")
        cached_profiles = cached_anchor["profiles"]
        current_profiles = current["profiles"]
        if [item["profile_id"] for item in cached_profiles] != [
            item["profile_id"] for item in current_profiles
        ]:
            raise RuntimeError(f"cached catalogue drifted at anchor {index}")
        if [item["outcome"] for item in cached_profiles] != [
            item["outcome"] for item in current_profiles
        ]:
            raise RuntimeError(f"cached exact outcomes drifted at anchor {index}")
        if audit.get("invalid_profiles") != 0:
            raise RuntimeError(f"cached physical profiles were rejected at anchor {index}")
        all_local_evaluations = 48 * len(cached_profiles)
        distinct_reference_ids = {
            cached_anchor["certified_fixed_point_profile_id"],
            cached_anchor["anytime_incumbent_profile_id"],
        }
        panelceil_reuse_evaluations = 48 * (
            len(cached_profiles) - len(distinct_reference_ids)
        )
        allowed_evaluations = (
            {all_local_evaluations, panelceil_reuse_evaluations}
            if index < 12 else {all_local_evaluations}
        )
        observed_evaluations = audit.get("outcome_physics_boundary_evaluations")
        if observed_evaluations not in allowed_evaluations:
            raise RuntimeError(f"outcomes lack full 48-boundary evaluation at anchor {index}")
        exact_outcome_boundary_evaluations += int(observed_evaluations)
        if index >= 12:
            if (
                audit.get("fixed_point_source") != "producer computation"
                or audit.get("fixed_point_certificate_complete") is not True
            ):
                raise RuntimeError(f"producer reference provenance failed at anchor {index}")
            producer_reference_anchors += 1
        del cached

    if sha256(PANELCEIL_RECEIPT) != EXPECTED_PANELCEIL_SHA256:
        raise RuntimeError("PANELCEIL receipt bytes drifted")
    panelceil = json.loads(PANELCEIL_RECEIPT.read_text(encoding="ascii"))
    claimed = panelceil.get("receipt_sha256")
    unsigned = dict(panelceil)
    unsigned.pop("receipt_sha256", None)
    if claimed != canonical_sha256(unsigned) or panelceil.get("status") != "COMPLETE":
        raise RuntimeError("PANELCEIL receipt is unauthenticated or incomplete")
    ceiling_rows = panelceil.get("anchors")
    if not isinstance(ceiling_rows, list) or [row["global_anchor_index"] for row in ceiling_rows] != list(range(12)):
        raise RuntimeError("PANELCEIL reuse is not exactly anchors 000--011")
    for index, ceiling in enumerate(ceiling_rows):
        if (
            ceiling.get("source_base_configuration_and_incumbent_mappings_verified") is not True
            or ceiling["first_improvement"]["termination_certificate"].get("complete") is not True
        ):
            raise RuntimeError(f"PANELCEIL exact reference failed at anchor {index}")
        current = anchors[index]
        by_id = {row["profile_id"]: row for row in current["profiles"]}
        for field, metric_name in (
            ("certified_fixed_point_profile_id", "U_FIRST"),
            ("anytime_incumbent_profile_id", "U_FIRST_AT_10"),
        ):
            outcome = by_id[current[field]]["outcome"]
            metric = ceiling["committed"][metric_name]
            expected = {
                "full_buffer_bits": float(metric["bits"]),
                "joules": float(metric["joules"]),
                "rate_target_attained": int(metric["rate_target_attained_count"]),
                "rate_target_opportunities": int(metric["user_count"]),
                "service_available": int(metric["served_count"]),
                "service_opportunities": int(metric["user_count"]),
            }
            if any(outcome[name] != value for name, value in expected.items()):
                raise RuntimeError(f"PANELCEIL endpoint metric drifted at anchor {index}")

    summary = {
        "verdict": "PASS_EXACT_PHYSICS_REAL_DEVELOPMENT_ANCHORS",
        "common_catalogue": "real development-anchor engine catalogue; authenticated profile-ID equality",
        "full_buffer_outcomes": "exact realised 48-boundary physics; authenticated cache equality",
        "certified_fixed_point": "12 authenticated PANELCEIL plus 8 complete producer computations",
        "same_budget_anytime_incumbent": "same traversal, last accepted iterate by 10.0 s",
        "anchor_indices": list(range(20)),
        "development_dates": ["2026-01-07"],
        "panelceil_anchors": 12,
        "producer_reference_anchors": producer_reference_anchors,
        "exact_outcome_boundary_evaluations": exact_outcome_boundary_evaluations,
        "fixture_physical_values_surviving": 0,
        "historical_flag_referred_to": "construction-nominated synthetic checkpoint",
        "rebuilt_flag_refers_to": "panel-carried physical content",
    }
    del panel, anchors, receipt, panelceil
    gc.collect()
    return summary


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--q1-schema", choices=("v1", "v2"), required=True)
    parser.add_argument("--checkpoint", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--resume-dir", type=Path, required=True)
    parser.add_argument("--outcome-cache-dir", type=Path, required=True)
    parser.add_argument("--limit", type=int, default=20)
    args = parser.parse_args()
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if not below_workspace(args.output) or not below_workspace(args.resume_dir):
        raise RuntimeError("all writes must remain below the PANELFIX workspace")
    if args.output.exists():
        raise RuntimeError(f"refusing to overwrite {args.output}")
    if any(os.environ.get(name) != "1" for name in THREAD_VARIABLES):
        raise RuntimeError("all BLAS thread variables must equal 1")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        os.nice(15 - os.getpriority(os.PRIO_PROCESS, 0))

    provenance = audit_physical_provenance()
    print("physical provenance PASS: no fixture value survives", flush=True)
    print(f"peak_rss_bytes={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024} after provenance", flush=True)

    builder = load_module("panelfix_upstream_builder", UPSTREAM_BUILDER)
    q1v2 = load_module("panelfix_q1_schema_v2", Q1_V2_MODULE) if args.q1_schema == "v2" else None
    original_atomic_json = builder.atomic_json
    original_load_module = builder.load_module
    original_feature_loader = builder.load_exact_feature_rows
    original_receipt_for_sources = json.loads(ORIGINAL_RECEIPT.read_text(encoding="ascii"))

    def fail_closed_c3_state(pilot, tape, step_index, base, config, rows_by_action,
                             width: int, member_width: int):
        changed = tuple(
            user for user in sorted(base.mapping)
            if base.mapping[user] != config.mapping[user]
        )
        if len(changed) <= 1:
            return len(changed), [0.0] * width
        context = pilot._coalition_context(
            tape=tape, step_index=step_index, anchor=base, selected=config,
            rows_by_user_action=rows_by_action,
        )
        full = context.invariant_vector(member_width=member_width).tolist()
        if len(full) != width:
            raise RuntimeError(
                f"checkpoint C3 width {width} differs from complete bound encoder width {len(full)}; truncation is forbidden"
            )
        return len(changed), full

    def v2_feature_loader(source: Mapping[str, object], widths: Mapping[str, int]):
        if args.q1_schema == "v1":
            return original_feature_loader(source, widths)
        if widths != {"C1": 15, "C2": 22, "C3": 236, "C3_MEMBER": 36}:
            raise RuntimeError(f"Q1-v2 checkpoint shape drifted: {dict(widths)!r}")
        index = int(source["index"])
        path = (
            Q1_V2_STAGING / f"global-{index:03d}" / "views" / "world-1"
            / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
        )
        verify_sidecar(path)
        raw_lines = path.read_bytes().splitlines()
        values = [json.loads(line.decode("ascii")) for line in raw_lines]
        header = values[0]
        if (
            header.get("schema") != "mcrl-v025-exact-source-view-shard-v1"
            or header.get("global_anchor_index") != index
            or header.get("q1_slots") != 15
            or header.get("q2_slots") != 22
        ):
            raise RuntimeError(f"Q1-v2 exact-view header drifted: {path}")
        result = {}
        for raw, payload in zip(raw_lines[1:], values[1:], strict=True):
            canonical = json.dumps(
                payload, sort_keys=True, separators=(",", ":"), allow_nan=False,
            ).encode("ascii")
            if raw != canonical or "exact_source_view" not in payload:
                raise RuntimeError("Q1-v2 exact-source row is unauthenticated")
            if (
                payload.get("q1_schema_sha256") != Q1_V2_SHA256
                or payload.get("q2_schema_sha256") != Q2_V1_SHA256
            ):
                raise RuntimeError("Q1-v2 row schema digest drifted")
            action = payload["action"]
            identity = None if action["norad_id"] is None else (
                int(action["norad_id"]), int(action["beam_chain_id"])
            )
            q1 = tuple(float.fromhex(value) for value in payload["q1_state"])
            q2 = tuple(float.fromhex(value) for value in payload["q2_state"])
            key = (int(payload["user_id"]), identity)
            if len(q1) != 15 or len(q2) != 22 or key in result:
                raise RuntimeError("Q1-v2 exact-source row shape or identity drifted")
            result[key] = builder.FeatureRow(q1, q2, bool(payload["outage"]))
        if len(result) != int(header["row_count"]):
            raise RuntimeError("Q1-v2 exact-source row count drifted")
        return result

    def adapted_module_loader(name: str, path: Path):
        module = original_load_module(name, path)
        if path != builder.PANELCEIL_PATH or args.q1_schema != "v2":
            return module
        original_pilot_loader = module.load_pilot

        def adapted_pilot_loader():
            pilot = original_pilot_loader()
            original_build_rows = pilot._build_anchor_rows
            resolver_cache = {}

            def build_rows_v2(**kwargs):
                built = original_build_rows(**kwargs)
                tape = kwargs["tape"]
                step_index = int(kwargs["step_index"])
                cache_key = (int(tape.seed), step_index)
                if cache_key not in resolver_cache:
                    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
                    resolver_cache[cache_key] = q1v2.DecisionGeometryResolverV2(
                        tape, LegacyWorldProvider(role="pilot-source"), step_index,
                    )
                resolver = resolver_cache[cache_key]
                converted = {}
                for key, row in built["rows_by_user_action"].items():
                    angle, elevation = resolver(row)
                    converted[key] = builder.FeatureRow(
                        q1v2.upgrade_q1_state_v2(
                            row.q1_state,
                            off_axis_angle_rad=angle,
                            focal_elevation_deg=elevation,
                            null_action=bool(row.null_action),
                        ),
                        tuple(row.q2_state),
                        bool(row.outage),
                    )
                result = dict(built)
                result["rows_by_user_action"] = converted
                return result

            pilot._build_anchor_rows = build_rows_v2
            return pilot

        module.load_pilot = adapted_pilot_loader
        return module

    def annotated_atomic_json(path: Path, value: object) -> None:
        if isinstance(value, dict) and value.get("schema") == builder.PANEL_SCHEMA:
            widths = {len(profile["C3"]["invariant_state"])
                      for anchor in value["anchors"] for profile in anchor["profiles"]}
            expected = 240 if args.q1_schema == "v1" else 236
            if widths != {expected}:
                raise RuntimeError(f"final panel C3 widths are not exactly {{{expected}}}: {widths}")
            value["synthetic_smoke_not_evidence"] = False
            value["panel_identity"]["information_class"] += "; " + FLAG_ASSERTION
        elif isinstance(value, dict) and value.get("schema") == "mcrl-v025-panelbuild-receipt-v1":
            expected = 240 if args.q1_schema == "v1" else 236
            value["synthetic_smoke_not_evidence"] = False
            value["c3_encoding"]["checkpoint_input_width"] = expected
            value["c3_encoding"]["production_full_width"] = expected
            value["c3_encoding"]["global_resource_feature_prefix_count"] = 6
            value["c3_encoding"]["fixture_limitation"] = None
            value["c3_encoding"]["width_policy"] = "exact equality; suffix truncation forbidden"
            value["encoder_binding"] = {
                "q1_schema": args.q1_schema,
                "q1_schema_sha256": Q1_V1_SHA256 if args.q1_schema == "v1" else Q1_V2_SHA256,
                "q1_width": 16 if args.q1_schema == "v1" else 15,
                "q2_schema_sha256": Q2_V1_SHA256,
                "q2_width": 22,
                "c3_member_width": 38 if args.q1_schema == "v1" else 36,
                "c3_full_width": expected,
            }
            value["physical_provenance_audit"] = provenance
            value["synthetic_flag_semantics"] = FLAG_ASSERTION
            value["material_class"] = "development; not claim-grade"
            value["global_evaluator_path_authority"] = "UNDETERMINED by EVALPATH-2026-09-10"
            value["adapter"] = {
                "path": str(Path(__file__).resolve()),
                "sha256": sha256(Path(__file__)),
                "upstream_builder": str(UPSTREAM_BUILDER),
                "upstream_builder_sha256": sha256(UPSTREAM_BUILDER),
                "q1_v2_module_sha256": None if q1v2 is None else sha256(Q1_V2_MODULE),
            }
        original_atomic_json(path, value)

    builder.c3_state = fail_closed_c3_state
    builder.load_exact_feature_rows = v2_feature_loader
    builder.load_module = adapted_module_loader
    builder.atomic_json = annotated_atomic_json
    builder.discover_panel = lambda limit: resolved_sources(original_receipt_for_sources)[:limit]
    sys.argv = [
        str(Path(__file__).resolve()),
        "--checkpoint", str(args.checkpoint),
        "--output", str(args.output),
        "--resume-dir", str(args.resume_dir),
        "--outcome-cache-dir", str(args.outcome_cache_dir),
        "--limit", str(args.limit),
    ]
    return int(builder.main())


if __name__ == "__main__":
    raise SystemExit(main())
#!/home/sat/mcrl-leo-handover/.venv/bin/python
"""Build PANELZ by extending PANELFIX2's fail-closed PANELBUILD adapter."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import resource
import sys
from typing import Mapping


WORKSPACE = Path("/home/sat/mcrl-v025-panelz-ws")
PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
PANELFIX = Path("/home/sat/mcrl-v025-panelfix-ws/scripts/build_stagec_scoring_panel.py")
UPSTREAM = Path("/home/sat/mcrl-v025-witness-ws/scripts/build_stagec_scoring_panel.py")
ORIGINAL_PANEL = Path("/home/sat/mcrl-v025-witness-ws/artifacts/stagec-scoring-panel-first20-v1.json")
ORIGINAL_RECEIPT = ORIGINAL_PANEL.with_name("stagec-scoring-panel-first20-v1.receipt.json")
PANELCEIL_RECEIPT = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/panelceil-receipt.json")
EXPECTED_PANEL_SHA256 = "92d5a80ff018c066ec95507da0f63bf4be5fa6802b3d15fafb8247b069dd53fb"
EXPECTED_PANELCEIL_SHA256 = "52400cf180cd55f4b004be785ba4ff8021e09e38eba20cec7321fbad9999cf7d"
Q1V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
ZSCORE_BUILDER_PATH = Path("/home/sat/mcrl-v025-design-ws/build_zscore_corpus.py")
ZSCORE_ROOT = Path(
    "/home/sat/mcrl-v025-design-ws/artifacts/"
    "v025-stagec-c3-coalition-q1v2z-20260910-BUILD_NOT_CLAIM/"
    "corpus/.staging-separated-v1"
)
Q1Z_SHA256 = "bd33e460c1d2f368f0962e6b4f3117784b81c5e8cab517ac5bf3c41053b23d04"
Q2Z_SHA256 = "c2dab920451aa386d0581bb7dd6d2435f352484301ca0d128438b25f2dcb054f"
EXPECTED_WIDTHS = {"C1": 30, "C2": 44, "C3": 296, "C3_MEMBER": 66}
