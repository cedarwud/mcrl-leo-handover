+++ b/scripts/derive_panel_q1v3_control.py
@@ -0,0 +1,177 @@
+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Derive the paired Q1-v3 control panel by an exact zero-coordinate transform."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import resource
+import sys
+
+
+ROOT = Path("/home/sat/mcrl-v025-panelv3-ws")
+PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+CONTROL_CORPUS = Path(
+    "/home/sat/mcrl-v025-q1v3-ws/artifacts/"
+    "q1-v3-control-exact-label-corpus-20260910"
+)
+CONTROL_SCHEMA_SHA256 = "ee6baea90d824d52bfa1e7c3a775fa191235e6f6db9d85c32674c608740cfc8f"
+CONTROL_CORPUS_SHA256 = "cc2ebaa9bed84c0bac38dcdd7d9acce355176b265ae40ba841f89f96f8adc000"
+C3_GAIN_COORDINATES = (16, 32, 54, 70)
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_sha256(value: object) -> str:
+    return hashlib.sha256(json.dumps(
+        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("ascii")).hexdigest()
+
+
+def write_json(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    encoder = json.JSONEncoder(indent=2, sort_keys=True, allow_nan=False, ensure_ascii=True)
+    with temporary.open("x", encoding="ascii") as handle:
+        for chunk in encoder.iterencode(value):
+            handle.write(chunk)
+        handle.write("\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+    temporary.replace(path)
+
+
+def verify_checkpoint(path: Path) -> None:
+    payload = json.loads(path.read_text(encoding="ascii"))
+    shapes = {
+        (
+            len(payload["arms"][arm]["C1"]["weights_hex"][0]),
+            len(payload["arms"][arm]["C2"]["weights_hex"][0]),
+            len(payload["arms"][arm]["C3"]["weights_hex"][0]),
+            payload["arms"][arm]["C3"]["member_width"],
+        )
+        for arm in payload["arms"]
+    }
+    if shapes != {(16, 22, 240, 38)}:
+        raise RuntimeError(f"control checkpoint shape drifted: {shapes}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--v3-panel", type=Path, required=True)
+    parser.add_argument("--v3-receipt", type=Path, required=True)
+    parser.add_argument("--control-checkpoint", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if Path(sys.executable).resolve() != PYTHON.resolve():
+        raise RuntimeError("wrong interpreter")
+    if any(os.environ.get(name) != "1" for name in THREAD_VARS):
+        raise RuntimeError("thread pins drifted")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 16:
+        os.nice(16 - os.getpriority(os.PRIO_PROCESS, 0))
+    if os.getpriority(os.PRIO_PROCESS, 0) != 16:
+        raise RuntimeError("niceness drifted")
+    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    cap = 4_900_000_000 if hard == resource.RLIM_INFINITY else min(hard, 4_900_000_000)
+    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
+    if not args.output.resolve().is_relative_to(ROOT.resolve()):
+        raise RuntimeError("output outside PANELV3 workspace")
+    if args.output.exists():
+        raise RuntimeError(f"refusing to overwrite {args.output}")
+    verify_checkpoint(args.control_checkpoint)
+
+    panel = json.loads(args.v3_panel.read_text(encoding="ascii"))
+    changed_c1 = changed_c3 = 0
+    for index, anchor in enumerate(panel["anchors"], 1):
+        for profile in anchor["profiles"]:
+            for pair in profile["C1"]:
+                for side in ("reference", "selected"):
+                    if len(pair[side]) != 16:
+                        raise RuntimeError("Q1-v3 C1 width drifted")
+                    if pair[side][15] != 0.0:
+                        changed_c1 += 1
+                    pair[side][15] = 0.0
+            state = profile["C3"]["invariant_state"]
+            if len(state) != 240:
+                raise RuntimeError("Q1-v3 C3 width drifted")
+            for coordinate in C3_GAIN_COORDINATES:
+                if state[coordinate] != 0.0:
+                    changed_c3 += 1
+                state[coordinate] = 0.0
+        print(f"anchor {index}/20 control-coordinate-transform", flush=True)
+    if changed_c1 == 0 or changed_c3 == 0:
+        raise RuntimeError("informative and control panels are not scorer-visibly distinct")
+    panel["panel_identity"]["name"] = (
+        "panel-q1v3-control development first-20 Stage-C scoring panel"
+    )
+    panel["panel_identity"]["information_class"] += (
+        "; paired control replaces only decision_boundary_log_nominal_gain_db "
+        "with normalized literal 0.0"
+    )
+    write_json(args.output, panel)
+    panel_digest = sha256(args.output)
+    args.output.with_name(args.output.name + ".sha256").write_text(
+        f"{panel_digest}  {args.output.name}\n", encoding="ascii",
+    )
+
+    receipt = json.loads(args.v3_receipt.read_text(encoding="ascii"))
+    sources = receipt["run_identity"]["sources"]
+    for index, source in enumerate(sources):
+        view = (
+            CONTROL_CORPUS / "views/world-1"
+            / f"BUILD_NOT_CLAIM-exact-source-anchor-{index:03d}.jsonl"
+        )
+        digest = sha256(view)
+        sidecar = view.with_name(view.name + ".sha256").read_text(encoding="ascii").split()[0]
+        if digest != sidecar:
+            raise RuntimeError(f"control corpus sidecar mismatch at {index}")
+        source["view_path"] = str(view)
+        source["view_sha256"] = digest
+        source["state_view_schema"] = "v3_control"
+        source["q1_schema_sha256"] = CONTROL_SCHEMA_SHA256
+        receipt["audits"][index]["source"] = dict(source)
+    receipt["run_identity"]["checkpoint_sha256"] = sha256(args.control_checkpoint)
+    receipt["run_identity"]["control_corpus_sha256"] = CONTROL_CORPUS_SHA256
+    receipt["run_digest"] = canonical_sha256(receipt["run_identity"])
+    receipt["panel"] = str(args.output.resolve())
+    receipt["panel_sha256"] = panel_digest
+    receipt["encoder_binding"]["view"] = "v3_control"
+    receipt["encoder_binding"]["q1_schema_sha256"] = CONTROL_SCHEMA_SHA256
+    receipt["state_provenance"] = {
+        "authenticated_rows": (
+            "paired control corpus authenticated; first 15 Q1 coordinates retained "
+            "and the declared last coordinate is exactly normalized 0.0"
+        ),
+        "control_derivation": (
+            "exact scorer-visible transform of audited v3 panel: C1 slot 15 and "
+            "C3 pooled member slots 16,32,54,70 set to 0.0; no physical core changed"
+        ),
+        "fixture_state_values_surviving": 0,
+    }
+    receipt["adapter_chain"]["control_deriver"] = str(Path(__file__).resolve())
+    receipt["control_transform_counts"] = {
+        "nonzero_c1_coordinates_replaced": changed_c1,
+        "nonzero_c3_coordinates_replaced": changed_c3,
+    }
+    receipt_path = args.output.with_name(args.output.stem + ".receipt.json")
+    write_json(receipt_path, receipt)
+    print(f"panel_sha256={panel_digest}", flush=True)
+    print(f"PEAK_RSS_BYTES={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
