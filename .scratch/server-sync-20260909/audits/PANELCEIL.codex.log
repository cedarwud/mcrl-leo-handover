        ROOT / "V025-STAGES-6-8-CONTRACT-v1.2-AMENDMENT-2026-09-09.md",
    ]
)
ALLOCATION_DIGEST = canonical_sha256(
    {
        "artifact_label": LABEL,
        "training_worlds": TRAIN_WORLDS,
        "evaluation_worlds": EVALUATION_WORLDS,
        "learner_seed_domains": LEARNER_DOMAINS,
        "anchors_per_world_per_carrier": 30,
    }
)


