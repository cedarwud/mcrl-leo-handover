            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=0.0 if primitive is None else primitive["remaining_d2"],
        return {
            "remaining_d2": float(arrays.remaining_d2_s[0, row]),
            "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
        }
    row = next(
        (
            value
            for value in step.boundaries[0].candidates
            if value.user_id == user and value.identity == identity
        ),
        None,
    )
    if row is None:
        return None
    return {
        "remaining_d2": row.remaining_d2_s,
        "remaining_visibility": row.remaining_visibility_s,
    }


def _archive_digest(tape) -> str:
    return canonical_sha256({"tle_files": list(tape.protocol.tle_files)})


def _pilot_calibration(tape, setting, run_setting) -> PilotCalibration:
    base = ENGINE._base_configuration(tape, 0, "nearest-eligible")
    evaluator = ENGINE.StepEvaluator(
        tape,
        setting,
        0,
        transition_from=base,
        field="realised",
        run_setting=run_setting,
    )
    profile = evaluator.evaluate(base)
    bits = Fraction(str(profile.bits))
    joules = Fraction(str(profile.joules))
    if bits <= 0 or joules <= 0:
        raise RuntimeError("pilot calibration proxy has a nonpositive endpoint")
    return PilotCalibration(
        eta_ref=bits / joules,
        lambda_bits_per_j=bits / joules,
        kappa_bits_per_user_step=bits / len(tape.user_layout),
        bits_ref=bits,
        joules_ref=joules,
        users=len(tape.user_layout),
    )


def _action_configs(tape, step_index: int, base, run_setting, *, full_legal: bool):
    if full_legal:
        options, census = ENGINE._legal_options(tape, step_index)
    else:
        options, census = ENGINE._selection_shortlist(
            tape, step_index, run_setting=run_setting
        )
    by_user: dict[int, tuple[tuple[int, int] | None, ...]] = {}
    configs: dict[tuple[int, tuple[int, int] | None], object] = {}
    for user in sorted(base.mapping):
        ordered = []
        for identity in (base.mapping[user], *options[user], None):
            if identity not in ordered:
                ordered.append(identity)
        by_user[user] = tuple(ordered)
        for identity in ordered:
            mapping = base.mapping
            mapping[user] = identity
            configs[(user, identity)] = ENGINE._configuration(
                base, mapping, kind="pilot-shortlisted-unilateral"
            )
    return by_user, configs, census


def _primitive_metrics(tape, step_index: int, user: int, identity, indices):
    if identity is None:
        return {
            "legal": False, "gain": 0.0, "remaining_d2": 0.0,
            "remaining_visibility": 0.0,
        }
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        candidate = next(
            (row for row in tape.steps[step_index].boundaries[0].candidates
             if row.user_id == user and row.identity == identity),
            None,
        )
        if candidate is None:
            return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
        return {
            "legal": candidate.legal,
            "gain": candidate.nominal_gain,
            "remaining_d2": candidate.remaining_d2_s,
            "remaining_visibility": candidate.remaining_visibility_s,
        }
    row = indices[step_index].get((user, identity))
    if row is None:
        return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
    return {
        "legal": bool(arrays.visible[0, row] and arrays.d2_eligible[0, row] and arrays.cell_reachable[0, row]),
        "gain": float(arrays.nominal_gain[0, row]),
        "remaining_d2": float(arrays.remaining_d2_s[0, row]),
        "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
    }


def _build_anchor_rows_primitive(
    *, tape, setting, run_setting, calibration, step_index, carrier,
    anchor_index, include_coalition, full_legal_actions,
):
    """Schema-complete provider-primitive fallback for bounded pilot compute."""

    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    # The generating-input digest already authenticates the provider inputs
    # and boundary-zero bytes. Computing ``tape.digest`` here hashes every
    # dense 33x48 array and dominates an entire anchor on this snapshot.
    tape_digest = tape.generating_input_digest or canonical_sha256({
        "domain": tape.domain,
        "seed": tape.seed,
        "provider": tape.protocol.provider_source_digest,
    })
    future_bases = {
        offset: ENGINE._base_configuration(tape, step_index + offset, carrier)
        for offset in (1, 2, 3)
    }
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape, setting, step_index, transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal", counter=counter, run_setting=run_setting,
        boundary_indices=(0,),
    )
    base_profile = current.evaluate(base)
    source_rows = []
    rows_by_user_action = {}
    for user in sorted(by_user):
        actions = []
        identities = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        base_metric = _primitive_metrics(
            tape, step_index, user, base.mapping[user], indices
        )
        base_gain = max(base_metric["gain"], 1e-300)
        for identity in by_user[user]:
            metric = _primitive_metrics(tape, step_index, user, identity, indices)
            ratio = max(metric["gain"], 1e-300) / base_gain
            gain_db = 10.0 * math.log10(max(ratio, 1e-30))
            if identity is None or not metric["legal"]:
                normalized_delta = -1.0
            else:
                normalized_delta = math.tanh(math.log(max(ratio, 1e-30)))
            candidate_margin = base_profile.min_decoding_margin_db + gain_db
#!/usr/bin/env python3
"""Perfect-knowledge set-interaction ceiling on corrected V0.25 physics.

This is a TRAIN-only diagnostic.  It has no learner and intentionally ignores
the ten-second deployment deadline.  Selection uses the exact binary64
decision-boundary outcomes; committed reporting uses all 48 realised
boundaries from the same detached world tape.
"""

from __future__ import annotations

import argparse
from collections import Counter
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import os
from pathlib import Path
import platform
import subprocess
import sys
import time
from typing import Mapping, Sequence


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
PROBE_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)
OUTPUT_PATH = HERE / "oracle-ceiling-result.json"
ETA_REF = Fraction("19720681.00172232")
ANCHORS_PER_WORLD = 5
WORLD_COUNT = 4
SELECTION_WORKERS = 1
OCCUPANT_SUBSET_MAX_SIZE = 4
OCCUPANT_SUBSET_TOTAL_CAP = 1_024
JOINT_CANDIDATE_CAP = 4_096
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"


def _load_probe():
    spec = importlib.util.spec_from_file_location("oracle_v025_probe", PROBE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load the pinned V0.25 probe")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


probe = _load_probe()


def exact_float(value: float) -> Fraction:
    """Treat the simulator's finite binary64 result as an exact coefficient."""

    if not math.isfinite(value):
        raise RuntimeError("non-finite physical coefficient")
    return Fraction.from_float(float(value))


def objective(profile) -> Fraction:
    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)


def served(profile) -> int:
    if isinstance(profile, SelectionMetric):
        return profile.served_count
    return sum(bool(value) for value in profile.score.served_phy.values())


def ratio(bits: float, joules: float) -> float:
    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
        raise RuntimeError("invalid EE components")
    return bits / joules


def relative_gain(numerator: float, denominator: float) -> float | None:
    """Return an anchor-local gain, or None when the reference EE is zero."""

    if denominator == 0.0:
        return None
    return numerator / denominator - 1.0


def frac_payload(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def _configuration(base, mapping: Mapping[int, tuple[int, int] | None], kind: str):
    return probe._configuration(base, dict(mapping), kind=kind)


@dataclass(frozen=True)
class CoordinateResult:
    selected: object
    iterations: int
    passes: int
    terminal_candidates: tuple[object, ...]
    best_alternatives: Mapping[int, tuple[int, int]]
    candidate_comparisons: int


@dataclass(frozen=True)
class SelectionMetric:
    config: object
    bits: float
    joules: float
    served_count: int


_WORKER_TAPE = None


def _selection_worker(task):
    step_index, base, configs = task
    evaluator = probe.StepEvaluator(
        _WORKER_TAPE,
        probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=probe.run_setting_for("a-r0"),
        boundary_indices=(0,),
        fading_quantile_alpha=0.10,
    )
    evaluator.evaluate_many(configs)
    rows = []
    for config in configs:
        profile = evaluator._evaluated.get(config.configuration_id)
        if profile is not None:
            rows.append(
                SelectionMetric(
                    config, profile.bits, profile.joules, served(profile)
                )
            )
    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations


class ParallelSelectionEvaluator:
    """Persistent fork workers over one detached tape; exact stable reduction."""

    def __init__(self, tape, step_index: int, base, pool) -> None:
        self.tape = tape
        self.step_index = step_index
        self.base = base
        self.pool = pool
        self._evaluated: dict[str, SelectionMetric] = {}
        self._invalid: set[str] = set()
        self.physical_evaluations = 0

    def evaluate_many(self, configs: Sequence[object]) -> None:
        missing_by_id = {
            row.configuration_id: row
            for row in configs
            if row.configuration_id not in self._evaluated
            and row.configuration_id not in self._invalid
        }
        missing = tuple(missing_by_id.values())
        if not missing:
            return
        if self.pool is None:
            results = [_selection_worker((self.step_index, self.base, missing))]
        else:
            shards = tuple(
                tuple(missing[index::SELECTION_WORKERS])
                for index in range(SELECTION_WORKERS)
            )
            results = self.pool.map(
                _selection_worker,
                tuple((self.step_index, self.base, shard) for shard in shards),
                chunksize=1,
            )
        unordered = {}
        for rows, invalid, evaluations in results:
            unordered.update((row.config.configuration_id, row) for row in rows)
            self._invalid.update(invalid)
            self.physical_evaluations += evaluations
        for config in missing:
            if config.configuration_id in unordered:
                self._evaluated[config.configuration_id] = unordered[
                    config.configuration_id
                ]

    def evaluate(self, config) -> SelectionMetric:
        self.evaluate_many((config,))
        try:
            return self._evaluated[config.configuration_id]
        except KeyError:
            raise RuntimeError(
                f"invalid selection configuration {config.configuration_id}"
            ) from None


def coordinate_optimum(*, tape, step_index: int, base, evaluator) -> CoordinateResult:
    """Deterministic cyclic best responses to a strict local optimum."""

    options, _ = probe._legal_options(tape, step_index)
    base_profile = evaluator.evaluate(base)
    guard = served(base_profile)
    current = base
    iterations = 0
    passes = 0
    comparisons = 0
    terminal: tuple[object, ...] = ()

    while True:
        passes += 1
        pass_moves = 0
        pass_candidates = []
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(current_profile)
            candidates = []
            current_map = current.mapping
            for identity in options[user]:
                if identity == current_map[user]:
                    continue
                mapping = dict(current_map)
                mapping[user] = identity
                candidates.append(
                    _configuration(base, mapping, "unilateral-coordinate")
                )
            evaluator.evaluate_many(candidates)
            comparisons += len(candidates)
            pass_candidates.extend(candidates)
            best = current
            best_value = current_value
            for candidate in candidates:
                profile = evaluator._evaluated.get(candidate.configuration_id)
                if profile is None or served(profile) < guard:
                    continue
                value = objective(profile)
                if value > best_value or (
                    value == best_value
                    and best is not current
                    and candidate.configuration_id < best.configuration_id
                ):
                    best = candidate
                    best_value = value
            if best.assignments != current.assignments:
                current = best
                iterations += 1
                pass_moves += 1
        if pass_moves == 0:
            terminal = tuple(pass_candidates)
            break
        print(
            json.dumps(
                {
                    "coordinate_step": step_index,
                    "completed_passes": passes,
                    "moves_in_pass": pass_moves,
                    "completed_improving_moves": iterations,
