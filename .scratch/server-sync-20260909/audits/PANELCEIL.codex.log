#!/usr/bin/env python3
"""Run the certified, deadline-free S_UNI_OFFLINE diagnostic.

This module is deliberately separate from ``run_v025_matrix_probe.py``.  It
imports the sealed operational evaluator and objective, but it does not alter
or call the operational S_UNI deadline/fallback path.

S_UNI_OFFLINE follows a deterministic sequential round-robin greedy path.  A
completed pass with no committed move evaluates the complete legal unilateral
neighbourhood of the final profile and supplies the local-optimum certificate.
The selected profile is path dependent and is not a ceiling on unilateral
reasoning.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import json
import multiprocessing as mp
from pathlib import Path
import sys
import time
from types import ModuleType
from typing import Iterable, Mapping, Sequence


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[2]
OPERATIONAL_RUNNER = HERE / "run_v025_matrix_probe.py"
SCHEMA = "multi-catfish-mcrl-v025-s-uni-offline-diagnostic-v1"
ARM = "S_UNI_OFFLINE"
CLAIM_STATUS = "DIAGNOSTIC_NOT_CLAIM"
TERMINATION_REASON = "CERTIFIED_LOCAL_OPTIMUM_COMPLETE_NEIGHBOURHOOD"
CERTIFICATE_STATEMENT = (
    "Every legal unilateral alternative was evaluated at the final iterate "
    "and none improves the guarded coordinator k=0 objective."
)
PATH_LIMITATION = (
    "This is an arbitrary path-dependent local optimum, not a ceiling on "
    "unilateral reasoning; FULL > S_UNI_OFFLINE licenses only 'not "
    "reproducible by this greedy path'."
)
_ANCHOR_CONTEXT: dict[str, object] | None = None


class OfflineSuniError(RuntimeError):
    """The offline diagnostic cannot produce an honest certificate."""


@dataclass(frozen=True)
class SearchResult:
    final: object
    move_count: int
    pass_count: int
    wall_seconds: float
    physical_boundary_evaluations: int
    candidate_evaluation_requests: int
    completed_neighbourhood: Mapping[str, object]


def _load_operational_runner() -> ModuleType:
    name = "mcrl_v025_operational_runner_for_offline_suni"
    loaded = sys.modules.get(name)
    if loaded is not None:
        return loaded
    spec = importlib.util.spec_from_file_location(name, OPERATIONAL_RUNNER)
    if spec is None or spec.loader is None:
        raise OfflineSuniError("cannot load the sealed V0.25 operational runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def _served_count(profile: object) -> int:
    return sum(bool(value) for value in profile.score.served_phy.values())


def _candidate(
    runner: ModuleType,
    *,
    anchor: object,
    current: object,
    user: int,
    identity: tuple[int, int],
) -> object:
    # Copy even though the production Configuration property already returns
    # a fresh dict; this keeps the search boundary robust to compatible test
    # or audit configuration objects that expose a stored mapping.
    mapping = dict(current.mapping)
    mapping[user] = identity
    return runner._configuration(anchor, mapping, kind="s-uni-offline-iterate")


def _coordinator_objective(
    runner: ModuleType,
    *,
    incumbent: object,
    config: object,
    profile: object,
    calibration: object,
    cell_rekeyed_users: Iterable[int],
) -> Fraction:
    return runner._objective(profile, calibration) + (
        calibration.kappa_bits_per_user_step
        * runner._phi_for(
            incumbent,
            config,
            cell_rekeyed_users=cell_rekeyed_users,
        )
    )


def _evaluate_neighbourhood(
    runner: ModuleType,
    *,
    anchor: object,
    incumbent: object,
    current: object,
    users: Sequence[int],
    options: Mapping[int, Sequence[tuple[int, int]]],
    evaluator: object,
    calibration: object,
    base_served: int,
    cell_rekeyed_users: Iterable[int],
) -> tuple[object, int, dict[str, int]]:
    """Evaluate one sequential pass and return the possibly changed profile."""

    requests = 0
    counts = {
        "legal_unilateral_alternatives_evaluated": 0,
        "physically_invalid_alternatives": 0,
        "service_guard_rejected_alternatives": 0,
        "strictly_improving_alternatives": 0,
    }
    moves = 0
    for user in users:
        current_profile = evaluator.evaluate(current)
        current_value = _coordinator_objective(
            runner,
            incumbent=incumbent,
            config=current,
            profile=current_profile,
            calibration=calibration,
            cell_rekeyed_users=cell_rekeyed_users,
        )
        candidates = tuple(
            _candidate(
                runner,
                anchor=anchor,
                current=current,
                user=user,
                identity=identity,
            )
            for identity in options[user]
            if identity != current.mapping[user]
        )
        evaluator.evaluate_many(candidates)
        requests += len(candidates)
        counts["legal_unilateral_alternatives_evaluated"] += len(candidates)
        improving: list[tuple[Fraction, str, object]] = []
        invalid = getattr(evaluator, "_invalid", set())
        for candidate in candidates:
            if candidate.configuration_id in invalid:
                counts["physically_invalid_alternatives"] += 1
                continue
            profile = evaluator.evaluate(candidate)
            if _served_count(profile) < base_served:
                counts["service_guard_rejected_alternatives"] += 1
                continue
            value = _coordinator_objective(
                runner,
                incumbent=incumbent,
                config=candidate,
                profile=profile,
                calibration=calibration,
                cell_rekeyed_users=cell_rekeyed_users,
            )
            if value > current_value:
                counts["strictly_improving_alternatives"] += 1
                improving.append((value, candidate.configuration_id, candidate))
        if improving:
            # Maximise the exact objective and retain the operational stable-ID
            # tie-break.  Equal-to-current alternatives are not improvements.
            current = min(improving, key=lambda row: (-row[0], row[1]))[2]
            moves += 1
    return current, moves, {**counts, "candidate_evaluation_requests": requests}


def sequential_round_robin(
    *,
    runner: ModuleType,
    anchor: object,
    incumbent: object,
    options: Mapping[int, Sequence[tuple[int, int]]],
    evaluator: object,
    calibration: object,
    cell_rekeyed_users: Iterable[int] = (),
) -> SearchResult:
    """Reach and certify one deterministic sequential best-response fixed point."""

    started = time.perf_counter()
    counter_start = int(getattr(getattr(evaluator, "counter", None), "boundary_evaluations", 0))
    users = tuple(sorted(options))
    rekeys = tuple(cell_rekeyed_users)
    current = anchor
    base_served = _served_count(evaluator.evaluate(anchor))
    moves = passes = requests = 0
    while True:
        passes += 1
        current, pass_moves, counts = _evaluate_neighbourhood(
            runner,
            anchor=anchor,
            incumbent=incumbent,
            current=current,
            users=users,
            options=options,
            evaluator=evaluator,
            calibration=calibration,
            base_served=base_served,
            cell_rekeyed_users=rekeys,
        )
        moves += pass_moves
        requests += counts.pop("candidate_evaluation_requests")
        if pass_moves == 0:
            if counts["strictly_improving_alternatives"] != 0:
                raise OfflineSuniError("zero-move pass contained an improving alternative")
            final_certificate = {
                "complete": True,
                "statement": CERTIFICATE_STATEMENT,
                **counts,
            }
            break
    counter_end = int(getattr(getattr(evaluator, "counter", None), "boundary_evaluations", 0))
    return SearchResult(
        final=current,
        move_count=moves,
        pass_count=passes,
        wall_seconds=time.perf_counter() - started,
        physical_boundary_evaluations=counter_end - counter_start,
        candidate_evaluation_requests=requests,
        completed_neighbourhood=final_certificate,
    )


def global_argmax(
    *,
    runner: ModuleType,
    anchor: object,
    incumbent: object,
    options: Mapping[int, Sequence[tuple[int, int]]],
    evaluator: object,
    calibration: object,
    cell_rekeyed_users: Iterable[int] = (),
) -> SearchResult:
    """Deadline-free transcription of the operational global-argmax path.

    This exists only for sampled fixed-point agreement checks.  It does not
    replace, wrap, or change the operational budgeted selector.
    """

    started = time.perf_counter()
    counter_start = int(getattr(getattr(evaluator, "counter", None), "boundary_evaluations", 0))
    rekeys = tuple(cell_rekeyed_users)
    current = anchor
    base_served = _served_count(evaluator.evaluate(anchor))
    moves = passes = requests = 0
    final_counts: dict[str, int] = {}
    while True:
        passes += 1
        current_profile = evaluator.evaluate(current)
        current_value = _coordinator_objective(
            runner,
            incumbent=incumbent,
            config=current,
            profile=current_profile,
            calibration=calibration,
            cell_rekeyed_users=rekeys,
        )
        candidates = tuple(
            _candidate(
                runner,
                anchor=anchor,
                current=current,
                user=user,
                identity=identity,
            )
            for user in sorted(options)
            for identity in options[user]
            if identity != current.mapping[user]
        )
        evaluator.evaluate_many(candidates)
        requests += len(candidates)
        counts = {
            "legal_unilateral_alternatives_evaluated": len(candidates),
            "physically_invalid_alternatives": 0,
            "service_guard_rejected_alternatives": 0,
            "strictly_improving_alternatives": 0,
        }
        best = current
        best_value = current_value
        invalid = getattr(evaluator, "_invalid", set())
        for candidate in candidates:
            if candidate.configuration_id in invalid:
                counts["physically_invalid_alternatives"] += 1
                continue
            profile = evaluator.evaluate(candidate)
            if _served_count(profile) < base_served:
                counts["service_guard_rejected_alternatives"] += 1
                continue
            value = _coordinator_objective(
                runner,
                incumbent=incumbent,
                config=candidate,
                profile=profile,
                calibration=calibration,
                cell_rekeyed_users=rekeys,
            )
            if value > current_value:
                counts["strictly_improving_alternatives"] += 1
            # Exact transcription of the operational global sweep: a stable
            # ID resolves equal objective values, including equality with the
            # current profile.  Equal moves strictly decrease that ID, so the
            # deadline-free comparison cannot tie-cycle.
            if value > best_value or (
                value == best_value
                and candidate.configuration_id < best.configuration_id
            ):
                best, best_value = candidate, value
        if best.assignments == current.assignments:
            final_counts = counts
            break
        current = best
        moves += 1
    counter_end = int(getattr(getattr(evaluator, "counter", None), "boundary_evaluations", 0))
    return SearchResult(
        final=current,
        move_count=moves,
        pass_count=passes,
        wall_seconds=time.perf_counter() - started,
        physical_boundary_evaluations=counter_end - counter_start,
        candidate_evaluation_requests=requests,
        completed_neighbourhood={
            "complete": True,
            "statement": CERTIFICATE_STATEMENT,
            **final_counts,
        },
    )


def result_receipt(
    *,
    result: SearchResult,
    anchor: object,
    world_domain: str,
    world_sha256: str,
    world_sha256: str,
    step_index: int,
    carrier: str,
    path: str,
) -> dict[str, object]:
    final = result.final
    return {
        "schema": f"{SCHEMA}-anchor-v1",
        "arm": ARM,
        "claim_status": CLAIM_STATUS,
        "world_domain": world_domain,
        "world_sha256": world_sha256,
        "step_index": step_index,
        "carrier": carrier,
        "anchor_configuration_id": anchor.configuration_id,
        "final_profile": {
            "configuration_id": final.configuration_id,
            "assignments": [
                [user, None if identity is None else list(identity)]
                for user, identity in final.assignments
            ],
        },
        "selection_differs_from_anchor": final.assignments != anchor.assignments,
        "iteration_count": result.move_count,
        "iteration_unit": "committed unilateral user moves",
        "pass_count": result.pass_count,
        "termination_reason": TERMINATION_REASON,
        "greedy_path": path,
        "completed_neighbourhood_certificate": dict(result.completed_neighbourhood),
        "cost": {
            "wall_seconds": result.wall_seconds,
            "physical_boundary_evaluations": result.physical_boundary_evaluations,
            "candidate_evaluation_requests": result.candidate_evaluation_requests,
        },
        "not_a_unilateral_ceiling": True,
        "interpretation_limit": PATH_LIMITATION,
    }


def summarize(anchor_receipts: Sequence[Mapping[str, object]]) -> dict[str, object]:
    if not anchor_receipts:
        raise OfflineSuniError("at least one completed anchor receipt is required")
    changed = sum(bool(row["selection_differs_from_anchor"]) for row in anchor_receipts)
    walls = [float(row["cost"]["wall_seconds"]) for row in anchor_receipts]  # type: ignore[index]
    evaluations = [
        int(row["cost"]["physical_boundary_evaluations"])  # type: ignore[index]
        for row in anchor_receipts
    ]
    return {
        "anchor_count": len(anchor_receipts),
        "selection_differs_from_anchor_count": changed,
        "non_degeneracy_fraction": changed / len(anchor_receipts),
        "informative": changed > 0,
        "per_anchor_cost": {
            "wall_seconds_mean": sum(walls) / len(walls),
            "wall_seconds_min": min(walls),
            "wall_seconds_max": max(walls),
            "physical_boundary_evaluations_mean": sum(evaluations) / len(evaluations),
            "physical_boundary_evaluations_min": min(evaluations),
            "physical_boundary_evaluations_max": max(evaluations),
        },
    }


def assert_t2_additive_placebo_nonvacuous(
    *,
    interaction: float,
    interaction_tolerance: float,
    anchor_configuration_id: str,
    deployed_configuration_id: str,
    unilateral_configuration_id: str,
) -> None:
    """Strengthened T2: near-zero interaction plus a non-anchor agreement."""

    if abs(interaction) > interaction_tolerance:
        raise OfflineSuniError("T2 additive placebo interaction is not near zero")
    if unilateral_configuration_id == anchor_configuration_id:
        raise OfflineSuniError(
            "T2 is vacuous: the unilateral arm must select a non-anchor profile"
        )
    if deployed_configuration_id != unilateral_configuration_id:
        raise OfflineSuniError(
            "T2 deployed selector does not match the non-anchor unilateral selection"
        )


def _new_evaluator(
    runner: ModuleType,
    *,
    tape: object,
    setting: object,
    step_index: int,
    carrier: str,
    incumbent: object,
    calibration: object,
    run_setting: object,
) -> tuple[object, object]:
    counter = runner.EvaluationCounter()
    evaluator = runner.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
        previously_served_users=runner._previously_served_users(
            tape, step_index, carrier
        ),
        field="margin",
        fading_quantile_alpha=0.10,
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    return evaluator, counter


def _run_anchor(anchor_index: int) -> tuple[dict[str, object], dict[str, object] | None]:
    if _ANCHOR_CONTEXT is None:
        raise OfflineSuniError("offline anchor context was not installed before execution")
    runner = _ANCHOR_CONTEXT["runner"]
    tape = _ANCHOR_CONTEXT["tape"]
    setting = _ANCHOR_CONTEXT["setting"]
    calibration = _ANCHOR_CONTEXT["calibration"]
    run_setting = _ANCHOR_CONTEXT["run_setting"]
    agreement_indices = _ANCHOR_CONTEXT["agreement_indices"]
    carrier_count = len(runner.REFERENCE_CARRIERS)
    step_index, carrier_offset = divmod(anchor_index, carrier_count)
    carrier = runner.REFERENCE_CARRIERS[carrier_offset]
    anchor = runner._base_configuration(tape, step_index, carrier)
    incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
    options, census = runner._legal_options(tape, step_index)
    evaluator, _counter = _new_evaluator(
        runner,
        tape=tape,
        setting=setting,
        step_index=step_index,
        carrier=carrier,
        incumbent=incumbent,
        calibration=calibration,
        run_setting=run_setting,
    )
    sequential = sequential_round_robin(
        runner=runner,
        anchor=anchor,
        incumbent=incumbent,
        options=options,
        evaluator=evaluator,
        calibration=calibration,
        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
    )
    row = result_receipt(
        result=sequential,
        anchor=anchor,
        world_domain=tape.domain,
        world_sha256=tape.digest,
        step_index=step_index,
        carrier=carrier,
        path="DETERMINISTIC_SEQUENTIAL_ROUND_ROBIN",
    )
    row["anchor_index"] = anchor_index
    row["legal_option_census"] = census
    agreement_row = None
    if anchor_index in agreement_indices:
        global_evaluator, _global_counter = _new_evaluator(
            runner,
            tape=tape,
            setting=setting,
            step_index=step_index,
            carrier=carrier,
            incumbent=incumbent,
            calibration=calibration,
            run_setting=run_setting,
        )
        global_result = global_argmax(
            runner=runner,
            anchor=anchor,
            incumbent=incumbent,
            options=options,
            evaluator=global_evaluator,
            calibration=calibration,
            cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
        )
        agreement_row = {
            "anchor_index": anchor_index,
            "step_index": step_index,
            "carrier": carrier,
            "same_fixed_point": (
                sequential.final.assignments == global_result.final.assignments
            ),
            "sequential_configuration_id": sequential.final.configuration_id,
            "global_argmax_configuration_id": global_result.final.configuration_id,
            "sequential_move_count": sequential.move_count,
            "global_argmax_move_count": global_result.move_count,
            "sequential_wall_seconds": sequential.wall_seconds,
            "global_argmax_wall_seconds": global_result.wall_seconds,
        }
    return row, agreement_row


def run_diagnostic(
    *,
    world_manifest: Path,
    calibration_manifest: Path,
    world_index: int,
    anchor_limit: int,
    agreement_anchor_indices: Iterable[int] = (),
    selected_anchor_indices: Iterable[int] | None = None,
    workers: int = 1,
) -> dict[str, object]:
    if workers not in {1, 2}:
        raise OfflineSuniError("offline diagnostic workers must be one or two")
    runner = _load_operational_runner()
    run_setting = runner.run_setting_for("a-r0")
    setting = runner._setting("a-r0")
    tape = runner.load_prepared_world_tape(world_manifest, world_index, run_setting)
    calibration = runner.load_calibration(calibration_manifest, setting, run_setting)
    agreement_indices = frozenset(agreement_anchor_indices)
    global _ANCHOR_CONTEXT
    _ANCHOR_CONTEXT = {
        "runner": runner,
        "tape": tape,
        "setting": setting,
        "calibration": calibration,
        "run_setting": run_setting,
        "agreement_indices": agreement_indices,
    }
    indices = (
        tuple(range(anchor_limit))
        if selected_anchor_indices is None
        else tuple(sorted(selected_anchor_indices))
    )
    if not indices or any(index < 0 or index >= 90 for index in indices):
        raise OfflineSuniError("selected anchor indices must be unique values in 0..89")
    if len(set(indices)) != len(indices):
        raise OfflineSuniError("selected anchor indices must be unique values in 0..89")
    if workers == 1:
        results = [_run_anchor(index) for index in indices]
    else:
        # Linux fork shares the immutable ~GB tape copy-on-write.  Parent plus
        # two workers is the task's maximum of three processes.
        with mp.get_context("fork").Pool(processes=workers) as pool:
            results = pool.map(_run_anchor, indices, chunksize=1)
    anchor_rows = [row for row, _agreement in results]
    agreement_rows = [row for _anchor, row in results if row is not None]
    payload = {
        "schema": SCHEMA,
        "status": "COMPLETE",
        "arm": ARM,
        "claim_status": CLAIM_STATUS,
        "deadline": None,
        "process_count": workers + 1 if workers > 1 else 1,
        "operational_arm_modified": False,
        "world_index": world_index,
        "world_domain": tape.domain,
        "world_sha256": tape.digest,
        "selected_anchor_indices": list(indices),
        "calibration_sha256": calibration.digest,
        "greedy_path": "DETERMINISTIC_SEQUENTIAL_ROUND_ROBIN",
        "interpretation_limit": PATH_LIMITATION,
        "summary": summarize(anchor_rows),
        "fixed_point_agreement_sample": agreement_rows,
        "anchors": anchor_rows,
    }
    payload["receipt_sha256"] = hashlib.sha256(
        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    return payload


def _parse_indices(value: str) -> tuple[int, ...]:
    if not value:
        return ()
    try:
        result = tuple(int(item) for item in value.split(","))
    except ValueError as error:
        raise argparse.ArgumentTypeError("agreement anchors must be comma-separated integers") from error
    if any(item < 0 for item in result) or len(set(result)) != len(result):
        raise argparse.ArgumentTypeError("agreement anchors must be unique and nonnegative")
    return result


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--world-manifest", type=Path, required=True)
    parser.add_argument("--calibration", type=Path, required=True)
    parser.add_argument("--world", type=int, default=1)
    parser.add_argument("--anchors", type=int, default=90)
    parser.add_argument("--agreement-anchors", type=_parse_indices, default=())
    parser.add_argument(
        "--only-anchors",
        type=_parse_indices,
        help="optional comma-separated 0-based anchor indices (audit/sample runs)",
    )
    parser.add_argument("--workers", type=int, choices=(1, 2), default=1)
    parser.add_argument("--output", type=Path)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if not 1 <= args.world <= 4 or not 1 <= args.anchors <= 90:
        raise SystemExit("--world must be in 1..4 and --anchors in 1..90")
    selected = (
        set(range(args.anchors))
        if args.only_anchors is None
        else set(args.only_anchors)
    )
    if not set(args.agreement_anchors) <= selected:
        raise SystemExit("every agreement anchor must be among the selected anchors")
    payload = run_diagnostic(
        world_manifest=args.world_manifest,
        calibration_manifest=args.calibration,
        world_index=args.world,
        anchor_limit=args.anchors,
        agreement_anchor_indices=args.agreement_anchors,
        selected_anchor_indices=args.only_anchors,
        workers=args.workers,
    )
    encoded = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    if args.output is None:
        print(encoded, end="")
    else:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(encoded, encoding="utf-8")
        print(json.dumps({"status": "COMPLETE", "path": str(args.output), **payload["summary"]}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

