    SOURCE_ROOT
    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
    / "PILOT_NOT_CLAIM-calibration.json"
)
SEALED_CORPUS = SOURCE_ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
OUTPUT = WORKSPACE / "artifacts/v025-exact-source-20260910-BUILD_NOT_CLAIM"
STAGING = OUTPUT / ".staging-separated-v1"
PHYSICS = OUTPUT / "physics"
VIEWS = OUTPUT / "views"
MANIFEST = OUTPUT / "BUILD_NOT_CLAIM-manifest.json"
VERIFICATION = OUTPUT / "BUILD_NOT_CLAIM-verification.json"
BUILD_STATE = OUTPUT / "BUILD_NOT_CLAIM-build-state.json"
CALIBRATION_RESULTS = WORKSPACE / ".scratch/exact-source-build/calibration-results.json"
PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
LABEL = "BUILD_NOT_CLAIM"
THREAD_VARS = (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
)
CARRIERS = ("nearest-eligible", "stay-if-possible", "random-masked")
WORLD_COUNT = 2
STEPS_PER_WORLD = 30
ANCHORS_PER_WORLD = STEPS_PER_WORLD * len(CARRIERS)
TOTAL_ANCHORS = WORLD_COUNT * ANCHORS_PER_WORLD
