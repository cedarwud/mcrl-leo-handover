   268	            if match is None:
   269	                continue
   270	            file_date = dt.datetime.strptime(match.group(1), "%Y%m%d").date()
   271	            self._paths[file_date] = path
   272	        if not self._paths:
   273	            raise MCRLContractError(f"no starlink_*.tle files under {self.root}")
   274	        self._cache: dict[dt.date, TleDailyFile] = {}
