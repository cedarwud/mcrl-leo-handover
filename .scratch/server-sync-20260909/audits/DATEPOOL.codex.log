   313	@dataclass(frozen=True)
   314	class ContiguousDateSplit:
   315	    """One chronological cut: train early, test late.  **Superseded.**
   316	
   317	    Retained only so the distribution shift that motivated
   318	    :class:`BlockAlternatingSplit` stays reproducible
   319	    (``tests/test_w02_ephemeris.py``).  Do not use it for a live run.
   320	    """
   321	
   322	    train_start: dt.date
   323	    train_end: dt.date
   324	    test_start: dt.date
   325	    test_end: dt.date
   326	
   327	    def __post_init__(self) -> None:
   328	        if self.train_start > self.train_end:
   329	            raise ValueError("train range is inverted")
   330	        if self.test_start > self.test_end:
   331	            raise ValueError("test range is inverted")
   332	        if not (self.train_end < self.test_start or self.test_end < self.train_start):
   333	            raise MCRLContractError(
   334	                "train and test date ranges overlap; SDD F3 forbids interleaving"
   335	            )
   336	
   337	    @classmethod
   338	    def chronological(
   339	        cls,
   340	        archive: TleArchive,
   341	        *,
   342	        test_fraction: float = 0.2,
   343	    ) -> ContiguousDateSplit:
   344	        dates = archive.dates
   345	        if len(dates) < 2:
   346	            raise MCRLContractError("need at least two dates to split")
   347	        if not 0.0 < test_fraction < 1.0:
   348	            raise ValueError("test_fraction must be in (0,1)")
   349	        cut = len(dates) - max(1, int(round(len(dates) * test_fraction)))
   350	        cut = min(max(cut, 1), len(dates) - 1)
   351	        return cls(
   352	            train_start=dates[0],
   353	            train_end=dates[cut - 1],
   354	            test_start=dates[cut],
   355	            test_end=dates[-1],
   356	        )
   357	
   358	    def dates_for(self, part: str) -> tuple[dt.date, dt.date]:
   359	        if part == TRAIN:
   360	            return self.train_start, self.train_end
   361	        if part == TEST:
   362	            return self.test_start, self.test_end
   363	        raise ValueError(f"unknown split part {part!r}")
   364	
   365	    def available_dates(
   366	        self, archive: TleArchive, part: str
   367	    ) -> tuple[dt.date, ...]:
   368	        first, last = self.dates_for(part)
   369	        return tuple(date for date in archive.dates if first <= date <= last)
   370	
   371	    def as_dict(self) -> dict[str, object]:
   372	        return {
   373	            "scheme": "contiguous-chronological-SUPERSEDED",
   374	            "train_start": self.train_start.isoformat(),
   375	            "train_end": self.train_end.isoformat(),
   376	            "test_start": self.test_start.isoformat(),
   377	            "test_end": self.test_end.isoformat(),
   378	        }
   379	
