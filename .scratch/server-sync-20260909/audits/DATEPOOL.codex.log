   381	@dataclass(frozen=True)
   382	class EpisodeStartSampler:
   383	    """Draws episode start times inside one part of a split.
   384	
   385	    **S**-level sampling distribution (F3 requires it to be frozen):
   386	    date uniform over the part's **available** file dates, time-of-day
   387	    uniform over the 86,400 s of that date, snapped down to a whole
   388	    ``time_step_s``.
   389	
   390	    "Available", not "calendar range": the corpus is 373 files across a
   391	    390-day span, so 17 dates have no file.  Drawing over the calendar
   392	    range would put ~4% of episodes on a date whose elements have to come
   393	    from a neighbouring file — a silent, undeclared change of the age
   394	    distribution.  Drawing over the file list keeps the sampling
   395	    distribution equal to the thing that was actually frozen.
   396	    """
   397	
   398	    part: str
   399	    available_dates: tuple[dt.date, ...]
   400	    time_step_s: float = DECISION_STEP_S
   401	
   402	    def __post_init__(self) -> None:
   403	        if self.part not in SPLIT_PARTS:
   404	            raise ValueError(f"unknown split part {self.part!r}")
   405	        if not self.available_dates:
   406	            raise MCRLContractError(f"no available dates for part {self.part!r}")
   407	        if list(self.available_dates) != sorted(set(self.available_dates)):
   408	            raise MCRLContractError("available_dates must be sorted and unique")
   409	
   410	    @classmethod
   411	    def for_archive(
   412	        cls,
   413	        archive: TleArchive,
   414	        split: Split,
   415	        part: str,
   416	        *,
   417	        time_step_s: float = DECISION_STEP_S,
   418	    ) -> EpisodeStartSampler:
   419	        return cls(part, split.available_dates(archive, part), time_step_s)
   420	
   421	    def draw(self, rng: np.random.Generator) -> dt.datetime:
   422	        day = self.available_dates[int(rng.integers(0, len(self.available_dates)))]
   423	        second_of_day = float(rng.integers(0, 86_400))
   424	        snapped = np.floor(second_of_day / self.time_step_s) * self.time_step_s
   425	        return dt.datetime.combine(
   426	            day, dt.time(0, 0), tzinfo=dt.timezone.utc
   427	        ) + dt.timedelta(seconds=float(snapped))
   428	
   429	    def as_dict(self) -> dict[str, object]:
   430	        first, last = self.available_dates[0], self.available_dates[-1]
   431	        return {
   432	            "part": self.part,
   433	            "date_first": first.isoformat(),
   434	            "date_last": last.isoformat(),
   435	            "date_count": len(self.available_dates),
   436	            "calendar_span_days": (last - first).days + 1,
   437	            "date_distribution": "uniform over available file dates",
   438	            "time_of_day_distribution": (
   439	                f"uniform over [0, 86400) s, floor-snapped to {self.time_step_s} s"
   440	            ),
   441	        }
