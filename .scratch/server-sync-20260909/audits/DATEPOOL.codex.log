    97	def select_elements(
    98	    archive: TleArchive,
    99	    when_utc: dt.datetime,
   100	    *,
   101	    max_age_h: float = MAX_TLE_AGE_H,
   102	    search_days: int = 1,
   103	) -> ElementSelection:
   104	    """SDD F3: per NORAD id take the nearest epoch, then drop age > max.
   105	
   106	    ``search_days`` widens the file window around ``when_utc``'s date.  It
   107	    is needed, not cosmetic: a single daily file spans ~21 days of epochs
   108	    and its 24 h coverage falls from 97% to 64% across the day it is named
   109	    after, so "nearest epoch" has to look at neighbouring files too.
   110	
   111	    Age is **absolute** ``|epoch − when|``, which permits a few hours of
   112	    backward extrapolation.  SGP4 is symmetric in Δt and the alternative
   113	    (past-only) would systematically double the mean age.  Declared as an
   114	    **S**-level choice.
   115	    """
   116	    if when_utc.tzinfo is None:
   117	        raise ValueError("when_utc must be timezone-aware")
   118	    if search_days < 0:
   119	        raise ValueError("search_days must be >= 0")
   120	    when_utc = when_utc.astimezone(dt.timezone.utc)
   121	
   122	    center = when_utc.date()
   123	    source_dates = [
   124	        center + dt.timedelta(days=offset)
   125	        for offset in range(-search_days, search_days + 1)
   126	        if archive.has(center + dt.timedelta(days=offset))
   127	    ]
   128	    if not source_dates:
   129	        raise EphemerisError(
   130	            f"no TLE file within ±{search_days} d of {center}"
   131	        )
   132	
   133	    best: dict[int, TleRecord] = {}
   134	    for file_date in source_dates:
