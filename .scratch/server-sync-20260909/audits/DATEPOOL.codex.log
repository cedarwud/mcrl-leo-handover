    74	class ActionSharedQNetwork(nn.Module):
    75	    """Apply one scalar MLP to every action's aligned local features."""
    76	
    77	    def __init__(self, config: EEAxisActionSharedConfig) -> None:
    78	        super().__init__()
    79	        activation = nn.Tanh if config.activation == "tanh" else nn.ReLU
    80	        widths = (
    81	            ACTION_ALIGNED_FEATURES + GLOBAL_FEATURES,
    82	            *config.hidden_layers,
    83	            1,
    84	        )
    85	        layers: list[nn.Module] = []
    86	        for left, right in zip(widths[:-2], widths[1:-1], strict=True):
    87	            layers.extend((nn.Linear(left, right), activation()))
    88	        layers.append(nn.Linear(widths[-2], widths[-1]))
    89	        self.scorer = nn.Sequential(*layers)
    90	        self.action_dim = config.action_dim
    91	
    92	    def forward(self, states: torch.Tensor) -> torch.Tensor:
    93	        if states.ndim != 2:
    94	            raise ValueError("action-shared Q input must be a state matrix")
    95	        batch = states.shape[0]
    96	        aligned_width = ACTION_ALIGNED_FEATURES * self.action_dim
    97	        expected = aligned_width + GLOBAL_FEATURES
    98	        if states.shape[1] != expected:
    99	            raise ValueError(
   100	                f"action-shared Q input width must be {expected}, got {states.shape[1]}"
   101	            )
   102	        local = states[:, :aligned_width].reshape(
   103	            batch, ACTION_ALIGNED_FEATURES, self.action_dim
   104	        ).transpose(1, 2)
   105	        global_features = states[:, aligned_width:].unsqueeze(1).expand(
   106	            -1, self.action_dim, -1
   107	        )
   108	        features = torch.cat((local, global_features), dim=2)
   109	        return self.scorer(features).squeeze(2)
