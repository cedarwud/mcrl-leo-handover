    48	        if type(self.source_seed) is not int or self.source_seed < 0:
    49	            raise E1SplitContractError("source_seed must be a nonnegative integer")
    50	        if (
    51	            not isinstance(self.anchor_sha256, str)
    52	            or len(self.anchor_sha256) != 64
    53	            or any(character not in "0123456789abcdef" for character in self.anchor_sha256)
    54	        ):
    55	            raise E1SplitContractError("anchor_sha256 must be lowercase SHA-256")
    56	        if (
    57	            not isinstance(self.inference_anchor_sha256, str)
    58	            or len(self.inference_anchor_sha256) != 64
    59	            or any(
    60	                character not in "0123456789abcdef"
    61	                for character in self.inference_anchor_sha256
    62	            )
    63	        ):
    64	            raise E1SplitContractError(
    65	                "inference_anchor_sha256 must be lowercase SHA-256"
    66	            )
    67	        if self.route in {"C1", "C3"} and self.inference_anchor_sha256 != self.anchor_sha256:
    68	            raise E1SplitContractError(
    69	                "C1/C3 inference anchor must equal the physical opening anchor"
    70	            )
    71	        if type(self.focal_user) is not int or self.focal_user < 0:
    72	            raise E1SplitContractError("focal_user must be a nonnegative integer")
    73	        if not self.action_mask or any(type(value) is not bool for value in self.action_mask):
    74	            raise E1SplitContractError("action_mask must be a nonempty boolean tuple")
    75	        for name, action in (
    76	            ("reference_action", self.reference_action),
    77	            ("candidate_action", self.candidate_action),
    78	        ):
    79	            if type(action) is not int or not 0 <= action < len(self.action_mask):
