   128	def _parse_start(value: dt.datetime | dt.date | str) -> dt.datetime:
   129	    if isinstance(value, str):
   130	        try:
   131	            parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
   132	        except ValueError as error:
   133	            raise ValueError("start_utc must be ISO-8601") from error
   134	    elif isinstance(value, dt.datetime):
   135	        parsed = value
   136	    elif isinstance(value, dt.date):
   137	        parsed = dt.datetime.combine(value, dt.time(), tzinfo=dt.timezone.utc)
   138	    else:
   139	        raise TypeError("start_utc must be a date, datetime, ISO string, or None")
   140	    if parsed.tzinfo is None:
   141	        raise ValueError("start_utc must be timezone-aware")
   142	    return parsed.astimezone(dt.timezone.utc)
