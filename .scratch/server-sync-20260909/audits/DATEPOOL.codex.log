   203	    test dates two days apart — vastly more than the 10 s episode and more
   204	    than the ground-track repeat of any Starlink shell, whereas the leak F3
   205	    was guarding against was episodes *minutes* apart.
   206	
   207	    ``block_days`` and ``embargo_days`` are **S**-level and must be frozen
   208	    in the W-13 PREREG.
   209	    """
   210	
   211	    first_date: dt.date
   212	    last_date: dt.date
   213	    block_days: int = 7
   214	    embargo_days: int = 1
   215	    first_block_part: str = TRAIN
   216	
   217	    def __post_init__(self) -> None:
   218	        if self.first_date > self.last_date:
   219	            raise ValueError("date range is inverted")
   220	        if self.block_days < 1:
   221	            raise ValueError("block_days must be >= 1")
   222	        if self.embargo_days < 1:
   223	            raise MCRLContractError(
   224	                "embargo_days must be >= 1; a zero embargo puts adjacent "
   225	                "train and test days next to each other"
   226	            )
   227	        if self.first_block_part not in SPLIT_PARTS:
   228	            raise ValueError(f"unknown part {self.first_block_part!r}")
   229	
   230	    @classmethod
   231	    def for_archive(
   232	        cls,
   233	        archive: TleArchive,
   234	        *,
   235	        block_days: int = 7,
   236	        embargo_days: int = 1,
   237	        first_block_part: str = TRAIN,
   238	    ) -> BlockAlternatingSplit:
   239	        first, last = archive.date_range
   240	        return cls(
   241	            first_date=first,
   242	            last_date=last,
   243	            block_days=block_days,
   244	            embargo_days=embargo_days,
   245	            first_block_part=first_block_part,
   246	        )
   247	
   248	    @property
   249	    def cycle_days(self) -> int:
   250	        return 2 * (self.block_days + self.embargo_days)
   251	
   252	    def _other_part(self) -> str:
   253	        return TEST if self.first_block_part == TRAIN else TRAIN
   254	
   255	    def part_for(self, date: dt.date) -> str:
   256	        """``"train"``, ``"test"``, or ``"embargo"`` for one calendar date."""
   257	        if not self.first_date <= date <= self.last_date:
   258	            raise MCRLContractError(f"{date} is outside the split range")
   259	        position = (date - self.first_date).days % self.cycle_days
   260	        if position < self.block_days:
   261	            return self.first_block_part
   262	        if position < self.block_days + self.embargo_days:
   263	            return EMBARGO
   264	        if position < 2 * self.block_days + self.embargo_days:
   265	            return self._other_part()
   266	        return EMBARGO
   267	
   268	    def available_dates(
   269	        self, archive: TleArchive, part: str
   270	    ) -> tuple[dt.date, ...]:
   271	        if part not in SPLIT_PARTS:
   272	            raise ValueError(f"unknown split part {part!r}")
   273	        return tuple(
   274	            date
   275	            for date in archive.dates
   276	            if self.first_date <= date <= self.last_date
   277	            and self.part_for(date) == part
   278	        )
   279	
   280	    def embargoed_dates(self, archive: TleArchive) -> tuple[dt.date, ...]:
   281	        return tuple(
   282	            date for date in archive.dates if self.part_for(date) == EMBARGO
   283	        )
   284	
   285	    def minimum_gap_days(self, archive: TleArchive) -> int:
   286	        """Smallest calendar distance between any train date and any test date."""
   287	        train = self.available_dates(archive, TRAIN)
   288	        test = self.available_dates(archive, TEST)
   289	        if not train or not test:
   290	            raise MCRLContractError("one side of the split is empty")
   291	        merged = sorted(
   292	            [(date, TRAIN) for date in train] + [(date, TEST) for date in test]
   293	        )
   294	        gap = min(
   295	            (later[0] - earlier[0]).days
   296	            for earlier, later in zip(merged, merged[1:])
   297	            if earlier[1] != later[1]
   298	        )
   299	        return int(gap)
   300	
   301	    def as_dict(self) -> dict[str, object]:
   302	        return {
   303	            "scheme": "block-alternating-with-embargo",
   304	            "first_date": self.first_date.isoformat(),
   305	            "last_date": self.last_date.isoformat(),
   306	            "block_days": self.block_days,
   307	            "embargo_days": self.embargo_days,
   308	            "first_block_part": self.first_block_part,
   309	            "cycle_days": self.cycle_days,
   310	        }
   311	
