   308	    def _select_capacity_constrained_actions(
   309	        self,
   310	        scalarized: np.ndarray,
   311	        masks: list[ActionMask],
   312	        eps: float,
   313	    ) -> np.ndarray:
   314	        """Centralized opt-in assignment constraint for anti-collapse pilots.
   315	
   316	        This is not part of the frozen MODQN baseline.  The candidate gate uses
   317	        it only when explicitly configured so that learned greedy evaluation
   318	        cannot place more than a declared number of users on one beam.
   319	        """
   320	        U = len(masks)
   321	        actions = np.zeros(U, dtype=np.int32)
   322	        max_users_per_beam = int(self.config.anti_collapse_max_users_per_beam)
   323	        assigned_counts = np.zeros(self.action_dim, dtype=np.int32)
   324	        ranked_choices: list[list[int]] = []
   325	
   326	        for uid in range(U):
   327	            valid = np.flatnonzero(masks[uid].mask)
   328	            if valid.size == 0:
   329	                ranked_choices.append([])
   330	                continue
   331	            if self._train_rng.random() < eps:
   332	                ranked_choices.append(
   333	                    [int(action) for action in self._train_rng.permutation(valid)]
   334	                )
   335	            else:
   336	                ranked_choices.append(
   337	                    self._rank_masked_actions(scalarized[uid], masks[uid].mask)
   338	                )
   339	
   340	        for uid, ranked in enumerate(ranked_choices):
   341	            if not ranked:
   342	                actions[uid] = 0
   343	                continue
   344	            selected = ranked[0]
   345	            for action in ranked:
   346	                if assigned_counts[action] < max_users_per_beam:
   347	                    selected = action
   348	                    break
   349	            actions[uid] = int(selected)
   350	            assigned_counts[int(selected)] += 1
   351	
   352	        return actions
