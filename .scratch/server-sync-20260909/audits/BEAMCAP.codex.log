#!/usr/bin/env python3
"""Reproduce the V0.25 beam-occupancy energy-efficiency diagnostic.

This is a deterministic analytic/numeric map.  It does not train or run a
policy.  The script prints the complete Markdown report to stdout.
"""

from __future__ import annotations

from dataclasses import dataclass
from functools import lru_cache
import math

import numpy as np

from mcrl.physics_v025.acm import ACMMode, ACM_MODES, rate_target_mode, rate_target_sinr
from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
    CIRCUIT_POWER_PER_CHAIN_W,
    ENGINE_VERSION,
    PA_SATURATION_POWER_W,
    RATE_TARGET_BPS,
    RX_GAIN_MAX_DBI,
    TX_FULL_HPBW_DEG,
)
from mcrl.physics_v025.energy import pa_supply_power_w
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.stagec_v025.mechanism_corpus import engine_table_q10


REFERENCE_ELEVATION_DEG = 30.0
REFERENCE_SLANT_KM = 750.0
REFERENCE_OFF_AXIS_DEG = 0.0
OFF_AXIS_GRID_DEG = (0.0, TX_FULL_HPBW_DEG / 4.0, TX_FULL_HPBW_DEG / 2.0)
SLANT_GRID_KM = (500.0, 750.0, 1000.0)
MAX_POPULATION = 24


@dataclass(frozen=True)
class BeamPoint:
    occupancy: int
    required_se: float
    mode: ACMMode
    controller_threshold_linear: float
    controller_threshold_db: float
    required_rf_w: float
    radiated_rf_w: float
    pa_supply_w: float
    total_one_beam_w: float

    @property
    def feasible(self) -> bool:
        return self.required_rf_w <= BEAM_RF_CAP_W

    @property
    def aggregate_delivered_bps(self) -> float:
        # n equal 1/n TDM shares sum back to one full-band mode rate.
        return BEAM_BANDWIDTH_HZ * self.mode.spectral_efficiency_bit_per_s_hz


@dataclass(frozen=True)
class Optimum:
    partition: tuple[int, ...]
    active_beams: int
    active_satellites: int
    delivered_bps: float
    power_w: float
    ee_bits_per_j: float


def nominal_direct_gain(theta_deg: float, slant_km: float, elevation_deg: float) -> float:
    """Use the provider's exact direct-nominal composition."""

    receive_peak = np.asarray(10.0 ** (RX_GAIN_MAX_DBI / 10.0), dtype=np.float64)
    path = LegacyWorldProvider._nominal_path_without_scintillation(
        np.asarray(slant_km, dtype=np.float64),
        np.asarray(elevation_deg, dtype=np.float64),
        receive_peak,
    )
    transmit = transmit_gain_linear(np.asarray(theta_deg, dtype=np.float64))
    return float(transmit * path)


def beam_curve(
    rule: str,
    theta_deg: float = REFERENCE_OFF_AXIS_DEG,
    slant_km: float = REFERENCE_SLANT_KM,
    elevation_deg: float = REFERENCE_ELEVATION_DEG,
) -> dict[int, BeamPoint]:
    if rule not in {"SEALED", "MARGIN"}:
        raise ValueError(rule)
    direct = nominal_direct_gain(theta_deg, slant_km, elevation_deg)
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    divisor = 1.0 if rule == "SEALED" else engine_table_q10(elevation_deg)
    result: dict[int, BeamPoint] = {}
    for occupancy in range(1, 13):
        mode = rate_target_mode(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
        target = rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
        assert mode is not None and target is not None
        required_rf = target * noise / direct / divisor
        radiated = min(required_rf, BEAM_RF_CAP_W)
        pa = pa_supply_power_w(radiated)
        result[occupancy] = BeamPoint(
            occupancy=occupancy,
            required_se=RATE_TARGET_BPS * occupancy / BEAM_BANDWIDTH_HZ,
            mode=mode,
            controller_threshold_linear=target,
            controller_threshold_db=10.0 * math.log10(target),
            required_rf_w=required_rf,
            radiated_rf_w=radiated,
            pa_supply_w=pa,
            total_one_beam_w=pa
            + CIRCUIT_POWER_PER_CHAIN_W
            + BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
        )
    return result


@lru_cache(maxsize=None)
def integer_partitions(total: int, minimum: int = 1) -> tuple[tuple[int, ...], ...]:
    if total == 0:
        return ((),)
    rows: list[tuple[int, ...]] = []
    for first in range(minimum, total + 1):
        for rest in integer_partitions(total - first, first):
            rows.append((first,) + rest)
    return tuple(rows)


def optimise(
    population: int,
    rule: str,
    theta_deg: float = REFERENCE_OFF_AXIS_DEG,
    slant_km: float = REFERENCE_SLANT_KM,
    elevation_deg: float = REFERENCE_ELEVATION_DEG,
    *,
    fixed_costs: bool = True,
    satellite_placement: str = "packed",
) -> Optimum:
    curve = beam_curve(rule, theta_deg, slant_km, elevation_deg)
    candidates: list[Optimum] = []
    for partition in integer_partitions(population):
        if any(size not in curve or not curve[size].feasible for size in partition):
            continue
        beams = len(partition)
        if satellite_placement == "packed":
            satellites = 1
        elif satellite_placement == "separate":
            satellites = beams
        else:
            raise ValueError(satellite_placement)
        delivered = math.fsum(curve[size].aggregate_delivered_bps for size in partition)
        pa = math.fsum(pa_supply_power_w(curve[size].required_rf_w) for size in partition)
        fixed = (
            beams * CIRCUIT_POWER_PER_CHAIN_W
            + satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
            if fixed_costs
            else 0.0
        )
        power = pa + fixed
        candidates.append(
            Optimum(partition, beams, satellites, delivered, power, delivered / power)
        )
    if not candidates:
        raise RuntimeError("no feasible partition")
    # Deterministic tie-break: fewer beams, then lexicographically larger loads.
    return max(candidates, key=lambda row: (row.ee_bits_per_j, -row.active_beams, row.partition))


def partition_text(partition: tuple[int, ...]) -> str:
    return "+".join(str(value) for value in partition)


def first_cap(curve: dict[int, BeamPoint]) -> int | None:
    return next((n for n, row in curve.items() if not row.feasible), None)


def d1_table(rule: str) -> list[str]:
    curve = beam_curve(rule)
    rows = [
        "| n | required SE (bit/s/Hz) | selected mode | target (dB) | RF needed (W) | RF radiated (W) | PA supply (W) | chain+baseband total (W) | RF x to n+1 | total x to n+1 |",
        "|---:|---:|:---|---:|---:|---:|---:|---:|---:|---:|",
    ]
    for n, point in curve.items():
        next_point = curve.get(n + 1)
        growth = "n/a" if next_point is None else f"{next_point.required_rf_w / point.required_rf_w:.4f}"
        total_growth = (
            "n/a"
            if next_point is None
            else f"{next_point.total_one_beam_w / point.total_one_beam_w:.4f}"
        )
        rf_needed = f"{point.required_rf_w:.6f}" + (" **CAP**" if not point.feasible else "")
        rows.append(
            f"| {n} | {point.required_se:.6f} | {point.mode.name} | "
            f"{point.controller_threshold_db:.6f} | {rf_needed} | "
            f"{point.radiated_rf_w:.6f} | {point.pa_supply_w:.6f} | "
            f"{point.total_one_beam_w:.6f} | {growth} | {total_growth} |"
        )
    return rows


def d2_table() -> list[str]:
    rows = [
        "| N | SEALED beams | SEALED occupancies | SEALED EE (Mbit/J) | MARGIN beams | MARGIN occupancies | MARGIN EE (Mbit/J) |",
        "|---:|---:|:---|---:|---:|:---|---:|",
    ]
    for population in range(1, MAX_POPULATION + 1):
        sealed = optimise(population, "SEALED")
        margin = optimise(population, "MARGIN")
        rows.append(
            f"| {population} | {sealed.active_beams} | {partition_text(sealed.partition)} | "
            f"{sealed.ee_bits_per_j / 1e6:.6f} | {margin.active_beams} | "
            f"{partition_text(margin.partition)} | {margin.ee_bits_per_j / 1e6:.6f} |"
        )
    return rows


def d3_table() -> list[str]:
    rows = [
        "| off-axis (deg) | slant (km) | SEALED feasible max n | SEALED N=24 optimum | MARGIN feasible max n | MARGIN N=24 optimum |",
        "|---:|---:|---:|:---|---:|:---|",
    ]
    for theta in OFF_AXIS_GRID_DEG:
        for slant in SLANT_GRID_KM:
            sealed_curve = beam_curve("SEALED", theta, slant)
            margin_curve = beam_curve("MARGIN", theta, slant)
            sealed_max = max(n for n, row in sealed_curve.items() if row.feasible)
            margin_max = max(n for n, row in margin_curve.items() if row.feasible)
            sealed = optimise(24, "SEALED", theta, slant)
            margin = optimise(24, "MARGIN", theta, slant)
            rows.append(
                f"| {theta:.2f} | {slant:.0f} | {sealed_max} | "
                f"{sealed.active_beams} beams: {partition_text(sealed.partition)} | "
                f"{margin_max} | {margin.active_beams} beams: {partition_text(margin.partition)} |"
            )
    return rows


def geometry_summary(rule: str) -> tuple[int, int, int, int, int]:
    changed = 0
    comparisons = 0
    min_beams = 10**9
    max_beams = 0
    occupancy_values: set[int] = set()
    reference = {n: optimise(n, rule).partition for n in range(1, MAX_POPULATION + 1)}
    for theta in OFF_AXIS_GRID_DEG:
        for slant in SLANT_GRID_KM:
            for population in range(1, MAX_POPULATION + 1):
                result = optimise(population, rule, theta, slant)
                comparisons += 1
                changed += result.partition != reference[population]
                min_beams = min(min_beams, result.active_beams)
                max_beams = max(max_beams, result.active_beams)
                occupancy_values.update(result.partition)
    return changed, comparisons, min_beams, max_beams, len(occupancy_values)


# External primary-source evidence for BEAMCAP

Completion criterion: this note identifies the strongest primary/official evidence found for Ka-band multibeam LEO per-beam occupancy/capacity mechanisms, gives exact source URLs, and states explicitly whether it yields a defensible commercial simultaneous-users-per-beam limit.

## Bottom line

No defensible public primary-source number was found for the maximum number of *simultaneously served user terminals per beam in an operational commercial Ka-band multibeam LEO network*. In particular, none of the sources below supports treating 10, 12.5, 20, or 25 users per beam as a universal commercial hard cap.

The official material nevertheless makes one narrower and useful conclusion possible: **about 12.5 users per active beam is not, by user count alone, an obviously nonphysical regime.** 3GPP's NTN study uses at least 10 UEs per beam for S/Ka system-level calibration, reports LEO-600 Ka throughput results with 10 UEs per cell under proportional-fair scheduling, and has a Ka-VSAT link-budget calibration with 10 UEs transmitting simultaneously in adjacent frequency resources. Elsewhere the same NTN study reports LEO simulations with 15 and 20 UEs per cell. These are study/calibration assumptions, not fielded-system limits or service guarantees.

## 1. 3GPP TR 38.821: direct Ka/LEO occupancy evidence

Primary source: 3GPP, *TR 38.821 V16.2.0 (2023-03), Solutions for NR to support non-terrestrial networks (NTN)*. [Official specification record](https://portal.3gpp.org/desktopmodules/Specifications/SpecificationDetails.aspx?specificationId=3525); [exact official archive package for the cited version](https://www.3gpp.org/ftp/Specs/archive/38_series/38.821/38821-g20.zip). A directly readable official-organizational-partner copy of V16.0.0, containing the same relevant tables, is [ATIS.3GPP.38.821.V1600](https://www.atis.org/wp-content/uploads/3gpp-documents/Rel16/ATIS.3GPP.38.821.V1600.pdf). The locally retained V16.2.0 PDF is `/home/sat/modqn-paper-exploration/paper-source/ref/official/38821-g20.pdf`; its page numbers and a locally derived Markdown conversion were checked directly.

- Table 6.1.1.1-5, pp. 37-39, governs both S-band and Ka-band system-level calibration. It sets Ka-band DL/UL maximum bandwidth per beam to 400 MHz (subject to frequency/polarization reuse) and says the UE-distribution baseline is “at least X=10 UEs per beam”; the Ka terminal configuration is VSAT. Local conversion: `/home/sat/modqn-paper-exploration/paper-source/official-markdown/38821-g20/part-000.md:1625-1677`.
- Section 6.1.1.3, Table 6.1.1.3-1, p. 48, says two companies supplied DL user-throughput results; one result set assumed 10 UEs per cell and proportional-fair scheduling. The table explicitly includes LEO-600 Ka-band study cases 6 and 7. At approximately 50% resource utilisation, its per-UE throughput percentiles are 6.91/10.03/13.7 Mbit/s for case 6 and 4.76/7.75/11.22 Mbit/s for case 7 (5th/50th/95th percentiles). Local conversion: `/home/sat/modqn-paper-exploration/paper-source/official-markdown/38821-g20/part-001.md:45-62`.
- Table 6.1.3.2-1, pp. 53-54, defines a Ka-band VSAT link-budget calibration at 20 GHz DL / 30 GHz UL with 400 MHz system bandwidth. For VSAT uplink, each terminal is allocated one tenth of the beam bandwidth; devices within a beam receive adjacent frequency resources; CIR is averaged over **10 simultaneously transmitting UEs** in the reference beam. Local conversion: `/home/sat/modqn-paper-exploration/paper-source/official-markdown/38821-g20/part-001.md:320-370`.
- Section 6.2.3 reports a LEO-1200 system-level study with 15 and 20 UEs per cell under proportional-fair scheduling and no frequency reuse, and specifically discusses results “with 15 UEs per beam.” This passage does not identify that particular study as Ka-band, so it is supporting NTN/LEO evidence rather than a Ka-specific count. Local conversion: `/home/sat/modqn-paper-exploration/paper-source/official-markdown/38821-g20/part-001.md:940-954`.
- Section 7.3.2.1.6 says many devices may be served within a single NTN cell and discusses a worst-case mobility stress calculation with 65,519 connected UEs, reflecting the then-current maximum C-RNTI value. This is a connected-UE control-plane stress assumption, **not** simultaneous data service and not a throughput-capacity claim. Local conversion: `/home/sat/modqn-paper-exploration/paper-source/official-markdown/38821-g20/part-002.md:267-315`.

Interpretation: 3GPP models occupancy through scheduled radio resources and resource utilisation. Ten simultaneously transmitting Ka VSATs in one beam is explicit. Ten UEs per cell in the LEO-600 Ka throughput study and 15/20 UEs in another LEO study bracket the project's 12.5-users/active-beam point in a broad standards-study sense. They do **not** prove that the project's bandwidth, antenna, ACM, interference, or rate results match a commercial system; those must be assessed separately.

Numerically, 12.5 is 25% above the explicit 10-UE Ka/LEO calibration occupancy. That modest ratio is useful only to reject “headcount alone makes it impossible”; it is not a 25% capacity-margin claim.

## 2. Telesat Lightspeed: official description of a real Ka-band LEO resource mechanism

Primary source: Telesat, *Telesat Lightspeed Service Resiliency* (official operator PDF), <https://www.telesat.com/wp-content/uploads/2022/05/Telesat-Lightspeed-Resiliency.pdf>.

- The document identifies Lightspeed as a Ka-band LEO system (p. 1).
- It describes resources adapting to user needs and the operating environment, and says terminal burst-time plans and satellite beam-hop plans can be changed in near real time so that lower-performing channels receive more slots (p. 2).

Interpretation: this first-party system description supports a dynamic scheduled-slot/beam-hopping model of finite capacity. It does not publish a maximum simultaneous terminal count per beam, so it cannot justify a numeric cap.

A second first-party document, [Telesat Lightspeed Communications Security Features](https://www.telesat.com/wp-content/uploads/2023/06/Communications-Security-Features-Whitepaper-Telesat-Lightspeed.pdf), says each satellite has 24 agile physical user beams that can hop among as many as 576 virtual beams, gives approximately 10 Tbit/s total network capacity, and says suitable terminals can receive more than 1 Gbit/s. It likewise states no users-per-beam cap. These are architectural/marketing design statements, useful for mechanism and scale but not a field measurement.

## 3. ETSI DVB-RCS2: official satellite return-link slot assignment

Primary source: ETSI, *EN 301 545-2 V1.4.1, Digital Video Broadcasting (DVB); Second Generation DVB Interactive Satellite System (DVB-RCS2); Part 2: Lower Layers for Satellite standard*, <https://www.etsi.org/deliver/etsi_en/301500_301599/30154502/01.04.01_60/en_30154502v010401p.pdf>.

- Section 7.2.2.1, p. 117, defines MF-TDMA as RCSTs sharing carriers divided into timeslots, with the network control centre assigning timeslots.
- Section 7.6.5.1, p. 166, states that every active RCST is provided dynamically parameterized timeslot/burst pairs.

Interpretation: this official satellite-access standard again makes the finite resource a schedule of carrier/time slots, not a universal terminals-per-beam integer. It is not specific to LEO or to the exact forward-link physics in V0.25 and therefore should be cited only for the general capacity mechanism.

## 4. 3GPP TS 38.214: NR allocates time/frequency resources per scheduled UE

Primary source: 3GPP, *TS 38.214 V19.3.0, NR; Physical layer procedures for data*. Exact official archive URL for the checked version: <https://www.3gpp.org/ftp/Specs/archive/38_series/38.214/38214-j30.zip>. Local official PDF: `/home/sat/modqn-paper-exploration/paper-source/ref/official/38214-j30.pdf`.

- Clause 5.1.2.2.1 says downlink resource-allocation type 0 carries a bitmap of resource-block groups allocated to the scheduled UE (PDF p. 38 in the extracted text region).
- Clause 5.1.2.2.2 says downlink type 1 indicates to a scheduled UE a contiguous set of virtual resource blocks within the active bandwidth part.
- Clause 6.1.2.2 similarly defines uplink frequency-domain resource-block assignment; clauses 6.1.2.2.1 and 6.1.2.2.2 allocate resource-block groups/blocks to a scheduled UE.

Interpretation: NR's data plane exposes time/frequency scheduling. The standard does not supply a universal hard maximum UEs per satellite beam. A system may of course have implementation-specific scheduler, control-channel, modem, gateway, power, or QoS limits.

## 5. Project Kuiper: applicant-authored Ka-LEO system filing

Primary source: Kuiper Systems LLC, *Technical Appendix to Application for Authority to Launch and Operate a Non-Geostationary Satellite Orbit System in Ka-band Frequencies*, filed with the FCC, <https://fcc.report/IBFS/SAT-LOA-20190704-00057/1773885.pdf?raw=1>. The FCC's authorization confirms the applicant/system and Ka customer bands: [FCC 20-102](https://docs.fcc.gov/public/attachments/FCC-20-102A1.pdf), paragraphs 9-10 (pp. 2-3).

- The applicant describes Ka-band LEO user beams giving multiple active customers connectivity within a virtual spot (Technical Appendix p. 8).
- It describes variable user-channel bandwidth and assignment in proportion to customer count and demand (p. 10).
- Each downlink user beam can be “gigabit-class” under stated link conditions; 100 MHz channels can be aggregated to 200-500 MHz. Return-link resources use 50 MHz channels aggregable to 200 MHz and can be shared among multiple terminals by FDMA/TDMA and potentially CDMA, adapting from small user populations to larger user bases (pp. 24-25). User-channel allocation is performed within each beam (p. 30).

Interpretation: this is first-party design evidence from an actual authorized Ka-band LEO system that beams serve multiple active customers and scale by flexible bandwidth/multiple-access scheduling. It publishes no terminals-per-beam maximum. At the project's nominal setpoint, 12.5 users x 50 Mbit/s = 625 Mbit/s aggregate, which is below the filing's conditional “gigabit-class” beam description; that is merely an order-of-magnitude aggregate sanity check, **not** validation of this project's geometry, link budget, ACM, power, overhead, or achieved rate.

## 6. Predecessor-project locations found incidentally

These locations are useful to the Part 1 investigator; no checkpoint was opened.

- The predecessor record explicitly says Cap25 was a project-created stress-test extension to address shared-Q geometric collapse, not a baseline-paper or 3GPP commercial deployment value: `/home/sat/modqn-paper-exploration/artifacts/literature_grounding.md:3-22` (especially lines 9, 11, 21-22).
- The operative selector is an opt-in centralized action-assignment constraint, not a PHY carrier count or reward term: `/home/sat/modqn-paper-exploration/src/modqn_paper_reproduction/algorithms/modqn.py:308-352`. It sets `max_users_per_beam` from config, ranks valid actions, and chooses the first whose assigned count is below that value. The dispatch is enabled only by `anti_collapse_action_constraint_enabled` plus mode `capacity-aware-greedy-assignment`: same file, lines 501-545.
- The matched protocol records a value of 25 and 100 total users: `/home/sat/modqn-paper-exploration/docs/research/angle-aware-ee-multicatfish/07-handover-aware-ee-hobs-sibling-sdd.md:1145-1172`.
- A distinct soft load-balance reward also existed. The environment documents `r3 = -(max_beam_thr - min_beam_thr) / U` and implements it separately from the cap: `/home/sat/modqn-paper-exploration/src/modqn_paper_reproduction/env/step.py:18-22` and `:829-870`.

Important code nuance: `_select_capacity_constrained_actions` initializes `selected` to the top-ranked action and, if no valid action has remaining count, retains that selection and increments its count. Thus the intended cap is hard whenever the valid-action/capacity set leaves an under-cap choice (as intended in the recorded protocol), but the function itself has no explicit infeasibility rejection when all valid candidates are saturated. It is an action-decoder admission/assignment guard, not a resource scheduler inside the physical environment.

## Conclusion usable in the main report

- **Verified from primary/official sources:** Ka-band multibeam NTN standards work explicitly evaluates 10 UEs per beam, including 10 simultaneously transmitting Ka VSATs on adjacent frequency resources; related LEO studies use 15 and 20 UEs per cell. Real Ka-band LEO design material describes dynamic slot/beam-plan allocation.
- **Inference, bounded:** the number 12.5 users per active beam does not by itself make the crowded endpoint physically impossible. Whether that endpoint is meaningful service depends on its per-user rate, resource share, ACM/power feasibility, and interference—not merely its user count.
- **Not found:** a defensible official public maximum simultaneous-users-per-beam figure for a deployed commercial Ka-band multibeam LEO network. Do not present 10, 15, 20, or the predecessor's 25 as such a maximum.

Criterion check: satisfied—primary/official evidence, exact URLs, and the explicit no-commercial-count finding are present.
