+#!/usr/bin/env python3
+"""Re-evaluate only the 12 crowded development endpoints and the reference link.
+
+DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM.  No learner or checkpoint is loaded.
+The sealed V0.25 source tree and interpreter are imported read-only; output is
+written only to this workspace.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+import gc
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+import numpy as np
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-beamcap-ws")
+SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2suff-ws")
+PILOT_PATH = SOURCE_ROOT / "scripts/run_v025_pilot_c3.py"
+CROWD_PATH = Path("/home/sat/mcrl-v025-crowd-ws/.scratch/crowding-cost/run_crowding_cost.py")
+OUTPUT = WORKSPACE / ".scratch/beamcap/beamcap-probe-receipt.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+CARRIERS = ("nearest-eligible", "stay-if-possible", "random-masked")
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def progress(message: str) -> None:
+    print(f"{message}; peak RSS {peak_rss_bytes()/2**30:.3f} GiB", flush=True)
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS is not below 5 GB")
+
+
+def assert_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 16:
+        raise RuntimeError("niceness is below 16")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    progress("runtime checks passed")
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main() -> int:
+    assert_runtime()
+    started = time.perf_counter()
+    sys.path.insert(0, str(SOURCE_ROOT / "src"))
+    pilot = load_module("beamcap_v025_pilot", PILOT_PATH)
+    crowd = load_module("beamcap_crowd_helpers", CROWD_PATH)
+    runner = pilot.ENGINE
+
+    from mcrl.physics_v025.acm import ACM_MODES, rate_target_mode, rate_target_sinr
+    from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
+    from mcrl.physics_v025.constants_v025 import (
+        BEAM_BANDWIDTH_HZ, BEAM_RF_CAP_W, DECISION_INTERVAL_S,
+        RATE_TARGET_BPS, RX_GAIN_MAX_DBI,
+    )
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    progress("imports complete")
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33,
+        start_time_s=0.0,
+    )
+    progress("development tape built")
+
+    # Production-derived isolated representative link: boresight, 750 km slant,
+    # 30-degree elevation, current receiver/noise/constants.
+    receive_peak = np.asarray(10.0 ** (RX_GAIN_MAX_DBI / 10.0), dtype=np.float64)
+    path = LegacyWorldProvider._nominal_path_without_scintillation(
+        np.asarray(750.0, dtype=np.float64),
+        np.asarray(30.0, dtype=np.float64),
+        receive_peak,
+    )
+    direct = float(transmit_gain_linear(np.asarray(0.0, dtype=np.float64)) * path)
+    noise = float(noise_power_w(BEAM_BANDWIDTH_HZ))
+    reference_rows = []
+    for occupancy in range(1, 14):
+        mode = rate_target_mode(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
+        gamma = rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
+        required_rf = None if gamma is None else float(gamma * noise / direct)
+        reference_rows.append({
+            "occupancy": occupancy,
+            "required_se_bit_s_hz": RATE_TARGET_BPS * occupancy / BEAM_BANDWIDTH_HZ,
+            "target_mode": None if mode is None else mode.name,
+            "target_sinr_linear": gamma,
+            "uncapped_required_rf_w": required_rf,
+            "cap_binds": required_rf is not None and required_rf > BEAM_RF_CAP_W,
+        })
+    progress("representative link curve complete")
+
+    options_by_step = {step: runner._legal_options(tape, step)[0] for step in range(4)}
+    minimum_by_step = {step: crowd.minimum_cover(options_by_step[step]) for step in range(4)}
+    mappings_by_step = {
+        step: crowd.assignment_for_beams(options_by_step[step], minimum_by_step[step])
+        for step in range(4)
+    }
+    progress("minimum legal-beam covers solved")
+
+    run_setting = runner.run_setting_for("a-r0")
+    anchors = []
+    mode_counts: Counter[str] = Counter()
+    occupancy_counts: Counter[int] = Counter()
+    total_bits = 0.0
+    total_joules = 0.0
+    attained = 0
+    served = 0
+    assigned = 0
+    cap_hits = 0
+    transmissions = 0
+    all_user_rates = []
+    for position, (step, carrier) in enumerate(
+        ((s, c) for s in range(4) for c in CARRIERS), 1
+    ):
+        base = runner._base_configuration(tape, step, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step - 1), carrier)
+        mapping = mappings_by_step[step]
+        config = runner._configuration(base, mapping, kind="beamcap-crowded-endpoint")
+        evaluator = runner.StepEvaluator(
+            tape, runner._setting("a-r0"), step,
+            transition_from=incumbent,
+            cell_rekeyed_users=runner._rekeyed_users(tape, step),
+            field="realised", run_setting=run_setting,
+            boundary_indices=tuple(range(48)),
+        )
+        # Match the crowded-family production measurement path exactly.  Calling
+        # evaluate() first would take the scalar KAT path; evaluate_many() fills
+        # the dense a-r0 cache used by the original panel run.
+        evaluator.evaluate_many([config])
+        profile = evaluator.evaluate(config)
+        if config.configuration_id in evaluator._invalid:
+            raise RuntimeError(f"invalid crowded endpoint at {step}/{carrier}")
+        counts = Counter(identity for identity in mapping.values() if identity is not None)
+        rates = [float(value) / DECISION_INTERVAL_S for value in profile.score.bits.values()]
+        row = {
+            "anchor": f"{tape.domain}|{step}|{carrier}",
+            "active_beams": len(counts),
+            "occupancies": sorted(counts.values(), reverse=True),
+            "bits": profile.bits,
+            "joules": profile.joules,
+            "served": sum(bool(value) for value in profile.score.served_phy.values()),
+            "rate_target_attained": sum(bool(value) for value in profile.score.rate_target_attained.values()),
+            "assigned": sum(value is not None for value in mapping.values()),
+            "mean_user_rate_bps": math.fsum(rates) / len(rates),
+            "min_user_rate_bps": min(rates),
+            "max_user_rate_bps": max(rates),
+            "acm_mode_counts": dict(profile.acm_mode_counts),
+            "rf_cap_hits": profile.rf_cap_hits,
+            "rf_transmission_observations": profile.rf_transmission_observations,
+        }
+        anchors.append(row)
+        mode_counts.update(profile.acm_mode_counts)
+        occupancy_counts.update(counts.values())
+        total_bits += profile.bits
+        total_joules += profile.joules
+        attained += int(row["rate_target_attained"])
+        served += int(row["served"])
+        assigned += int(row["assigned"])
+        cap_hits += profile.rf_cap_hits
+        transmissions += profile.rf_transmission_observations
+        all_user_rates.extend(rates)
+        del evaluator, profile
+        gc.collect()
+        progress(f"anchor {position}/12 complete")
+
+    result = {
+        "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
+        "runtime": {
+            "python": sys.executable,
+            "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "thread_vars": {name: os.environ.get(name) for name in THREAD_VARS},
+            "elapsed_s": time.perf_counter() - started,
+            "peak_rss_bytes": peak_rss_bytes(),
+        },
+        "sources": {
+            "pilot": {"path": str(PILOT_PATH), "sha256": sha256(PILOT_PATH)},
+            "crowd_helpers": {"path": str(CROWD_PATH), "sha256": sha256(CROWD_PATH)},
+        },
+        "reference_link": {
+            "geometry": {"off_axis_deg": 0.0, "slant_km": 750.0, "elevation_deg": 30.0},
+            "direct_gain_linear": direct,
+            "noise_w": noise,
+            "beam_bandwidth_hz": BEAM_BANDWIDTH_HZ,
+            "beam_rf_cap_w": BEAM_RF_CAP_W,
+            "rows": reference_rows,
+        },
+        "crowded_endpoint": {
+            "anchors": anchors,
+            "pooled": {
+                "bits": total_bits,
+                "joules": total_joules,
+                "ee_bits_per_j": total_bits / total_joules,
+                "assigned": assigned,
+                "served": served,
+                "rate_target_attained": attained,
+                "mean_user_rate_bps": total_bits / (assigned * DECISION_INTERVAL_S),
+                "min_user_rate_bps": min(all_user_rates),
+                "max_user_rate_bps": max(all_user_rates),
+                "mean_active_beams": sum(row["active_beams"] for row in anchors) / len(anchors),
+                "mean_occupancy": assigned / sum(row["active_beams"] for row in anchors),
+                "occupancy_histogram_beam_anchors": dict(sorted(occupancy_counts.items())),
+                "acm_mode_counts": dict(sorted(mode_counts.items())),
+                "rf_cap_hits": cap_hits,
+                "rf_transmission_observations": transmissions,
+            },
+        },
+        "acm_modes": [
+            {"name": mode.name, "se": mode.spectral_efficiency_bit_per_s_hz,
+             "threshold_db": mode.threshold_db}
+            for mode in ACM_MODES
+        ],
+    }
+    unsigned = json.dumps(result, sort_keys=True, separators=(",", ":"), allow_nan=False)
+    result["receipt_sha256"] = hashlib.sha256(unsigned.encode("utf-8")).hexdigest()
+    OUTPUT.write_text(json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + "\n", encoding="utf-8")
+    progress(f"receipt written to {OUTPUT}")
+    print(f"elapsed {result['runtime']['elapsed_s']:.3f} s", flush=True)
+    print(f"final peak RSS {peak_rss_bytes()} bytes ({peak_rss_bytes()/2**30:.3f} GiB)", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

