   501	    def select_actions(
   502	        self,
   503	        states_encoded: np.ndarray,
   504	        masks: list[ActionMask],
   505	        eps: float,
   506	        *,
   507	        objective_weights: tuple[float, float, float] | None = None,
   508	        raw_states: list[UserState] | None = None,
   509	    ) -> np.ndarray:
   510	        """Epsilon-greedy masked action selection with scalarized Q.
   511	
   512	        At each decision step:
   513	        1. Compute Q1, Q2, Q3 for each user
   514	        2. Scalarize: Q_scalar = w1*Q1 + w2*Q2 + w3*Q3
   515	        3. Mask invalid actions to -inf
   516	        4. epsilon-greedy over the masked scalarized Q
   517	
   518	        Returns actions array shape (num_users,).
   519	        """
   520	        w = objective_weights or self.config.objective_weights
   521	        q_values = self._predict_objective_q_values(states_encoded)
   522	        scalarized = self._scalarize_q_values(q_values, w)
   523	
   524	        if self.config.anti_collapse_action_constraint_enabled:
   525	            if (
   526	                self.config.anti_collapse_constraint_mode
   527	                == "capacity-aware-greedy-assignment"
   528	            ):
   529	                return self._select_capacity_constrained_actions(
   530	                    scalarized,
   531	                    masks,
   532	                    eps,
   533	                )
   534	            if (
   535	                self.config.anti_collapse_constraint_mode
   536	                == "qos-sticky-overflow-reassignment"
   537	            ):
   538	                return self._select_qos_sticky_overflow_reassignment_actions(
   539	                    scalarized,
   540	                    masks,
   541	                    eps,
   542	                    raw_states,
   543	                )
   544	
   545	        return self._select_unconstrained_actions(scalarized, masks, eps)
