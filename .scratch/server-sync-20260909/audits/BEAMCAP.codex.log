   147	@dataclass(frozen=True)
   148	class UncappedShannonDiagnosticRate:
   149	    """Treatment U: uncapped Shannon rate with the common margin removed.
   150	
   151	    This is a diagnostic upper bound, not an ACM profile and not eligible as
   152	    the primary model.  Its allocation boundary is the lowest ideal table
   153	    threshold after the symbol-rate/bandwidth conversion, with margin off.
   154	    """
   155	
   156	    name: str = "U_UNCAPPED_SHANNON_MARGIN_OFF"
   157	
   158	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float:
   159	        if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
   160	            raise MCRLContractError("SINR must be finite and nonnegative")
   161	        if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
   162	            raise MCRLContractError("bandwidth must be finite and positive")
   163	        if sinr_linear < SHANNON_MIN:
   164	            return 0.0
   165	        return bandwidth_hz * math.log2(1.0 + sinr_linear)
   166	
   167	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool:
   168	        if not math.isfinite(sinr_linear) or sinr_linear < 0.0:
   169	            raise MCRLContractError("SINR must be finite and nonnegative")
   170	        return bool(allocated and sinr_linear >= SHANNON_MIN)
   171	
