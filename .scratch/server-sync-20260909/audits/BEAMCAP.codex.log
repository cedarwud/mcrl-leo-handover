   129	@dataclass(frozen=True)
   130	class ACMRate:
   131	    """Capped, margin-bearing DVB-S2 ACM model."""
   132	
   133	    name: str = "ACM"
   134	
   135	    def rate_bps(self, sinr_linear: float, bandwidth_hz: float) -> float:
   136	        if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
   137	            raise MCRLContractError("bandwidth must be finite and positive")
   138	        if not served_phy(sinr_linear):
   139	            return 0.0
   140	        mode = select_mode(sinr_linear)
   141	        return 0.0 if mode is None else bandwidth_hz * mode.spectral_efficiency_bit_per_s_hz
   142	
   143	    def served(self, sinr_linear: float, *, allocated: bool = True) -> bool:
   144	        return served_phy(sinr_linear, allocated=allocated)
   145	
