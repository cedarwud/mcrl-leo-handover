+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Call the unchanged production corpus reader on a supplied corpus."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+from pathlib import Path
+import resource
+import sys
+
+
+RETRAIN = Path("/home/sat/mcrl-v025-retrain-ws")
+RUNNER = RETRAIN / "scripts/run_stagec_training.py"
+
+
+def main() -> int:
+    sys.path.insert(0, str(RETRAIN / "src"))
+    spec = importlib.util.spec_from_file_location("coalext_production_reader", RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load production runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    corpus = Path(sys.argv[1])
