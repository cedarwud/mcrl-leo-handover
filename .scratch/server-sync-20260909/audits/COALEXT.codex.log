+        f"coalition_rows={receipt['coalition_rows']} "
+        f"physics_digest={loaded['c3'].physics_digest}",
+        flush=True,
+    )
+    print(
+        f"PEAK_RSS_BYTES={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024} "
+        f"nice={os.getpriority(os.PRIO_PROCESS, 0)}",
