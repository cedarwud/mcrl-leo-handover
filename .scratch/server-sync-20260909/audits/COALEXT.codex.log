#!/home/sat/mcrl-leo-handover/.venv/bin/python
"""Verify the EXACTTRAIN input gates without reading evaluation-only material."""

from __future__ import annotations

from collections import defaultdict
from fractions import Fraction
import hashlib
import json
import math
import os
from pathlib import Path
import random
import resource
import sys
import time


PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python").resolve()
SOURCE_ROOT = Path(
    "/home/sat/mcrl-v025-datepool-ws/artifacts/"
    "v025-exact-source-20260910-BUILD_NOT_CLAIM"
)
COALITION_ROOT = Path(
    "/home/sat/mcrl-v025-coalgen-ws/artifacts/"
    "v025-stagec-c3-coalition-20260910-BUILD_NOT_CLAIM/"
    "corpus/.staging-separated-v1"
)
SEALED_ROOT = Path(
    "/home/sat/mcrl-v025-c1c2suff-ws/artifacts/"
    "v025-pilot-c3-20260909-PILOT_NOT_CLAIM/rows"
)
OUTPUT = Path("/home/sat/mcrl-v025-exacttrain-ws/.scratch/exacttrain/verification.json")
THREAD_VARS = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)
SOURCE_SCHEMA = "mcrl-v025-exact-source-view-shard-v1"
COALITION_SCHEMA = "mcrl-v025-stagec-c3-coalition-shard-v2"
SAMPLE_SEED = 20260910
SAMPLE_SIZE = 2000
MAX_AS_BYTES = 4_900_000_000


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def python_processes() -> tuple[int, ...]:
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            name = (entry / "comm").read_text(encoding="ascii").strip()
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if name.startswith("python"):
            pids.append(int(entry.name))
    return tuple(sorted(pids))


def enforce_runtime() -> None:
    if Path(sys.executable).resolve() != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    wrong = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if wrong:
        raise RuntimeError(f"thread pins drifted: {wrong}")
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
    processes = python_processes()
    if len(processes) > 3:
        raise RuntimeError(f"python-process cap exceeded: {processes}")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def verify_sidecar(path: Path) -> str:
    sidecar = path.with_suffix(path.suffix + ".sha256")
    fields = sidecar.read_text(encoding="ascii").strip().split()
    if len(fields) != 2 or fields[1] != path.name:
        raise RuntimeError(f"malformed sidecar: {sidecar}")
    actual = sha256(path)
    if fields[0] != actual:
        raise RuntimeError(f"sidecar mismatch: {path}")
    return actual


def fraction(payload: dict[str, object]) -> Fraction:
    numerator, denominator = payload["fraction"]
    value = Fraction(int(numerator), int(denominator))
    if payload["float_hex"] != float.hex(float(value)):
        raise RuntimeError("fraction/float-hex mismatch")
    return value


def action_key(action: dict[str, object]) -> tuple[int | None, int | None]:
    norad = action["norad_id"]
    beam = action["beam_chain_id"]
    return (
        None if norad is None else int(norad),
        None if beam is None else int(beam),
    )


def winner(rows: list[tuple[int, float]]) -> int:
    # Python max preserves the first occurrence; sorting makes the declared
    # lowest-action-index tie break explicit.
    return max(sorted(rows), key=lambda item: item[1])[0]


def source_inventory() -> dict[int, tuple[Path, dict[str, object]]]:
    inventory = {}
    for path in sorted((SOURCE_ROOT / "views").rglob("*.jsonl")):
        with path.open("r", encoding="ascii") as handle:
            header = json.loads(next(handle))
        if header.get("schema") != SOURCE_SCHEMA:
            raise RuntimeError(f"unexpected source schema: {path}")
        index = int(header["global_anchor_index"])
        if index in inventory:
            raise RuntimeError(f"duplicate source anchor: {index}")
        inventory[index] = (path, header)
    return inventory


def coalition_inventory() -> dict[int, tuple[Path, dict[str, object]]]:
    inventory = {}
    for path in sorted(COALITION_ROOT.rglob("*.jsonl")):
        with path.open("r", encoding="ascii") as handle:
            header = json.loads(next(handle))
        if header.get("schema") != COALITION_SCHEMA:
            continue
        part = next(part for part in path.parts if part.startswith("global-"))
        index = int(part.removeprefix("global-"))
        if index in inventory:
            raise RuntimeError(f"duplicate coalition anchor: {index}")
        inventory[index] = (path, header)
    return inventory


def sealed_source_rows(index: int, world_index: int, anchor_index: int) -> dict[tuple, dict]:
    path = (
        SEALED_ROOT / f"world-{world_index}"
        / f"PILOT_NOT_CLAIM-source-anchor-{anchor_index:03d}.jsonl"
    )
    verify_sidecar(path)
    rows = {}
    with path.open("r", encoding="ascii") as handle:
        next(handle)
        for line in handle:
            row = json.loads(line)
            key = (int(row["user_id"]), int(row["action_index"]), action_key(row["action"]))
            rows[key] = row
    if not rows:
        raise RuntimeError(f"sealed source anchor is empty: {index}")
    return rows


def sample_stats(rows: list[dict[str, object]], route: str) -> dict[str, object]:
    if len(rows) < SAMPLE_SIZE:
        raise RuntimeError(f"{route} has fewer than {SAMPLE_SIZE} eligible rows")
    rng = random.Random(f"EXACTTRAIN/{SAMPLE_SEED}/{route}")
    sample = rng.sample(rows, SAMPLE_SIZE)
    if route == "C1":
        matches = sum(row["exact_hex"] == row["surrogate_hex"] for row in sample)
        identities = sum(row["identity"] for row in sample)
    elif route == "C2":
        matches = sum(row["exact_hex"] == row["surrogate_hex"] for row in sample)
        identities = sum(row["identity"] for row in sample)
    else:
        matches = sum(row["exact_hex"] == row["surrogate_hex"] for row in sample)
        identities = sum(row["identity"] for row in sample)
    return {
        "sampling_frame_rows": len(rows),
        "sample_size": SAMPLE_SIZE,
        "rng_seed": f"EXACTTRAIN/{SAMPLE_SEED}/{route}",
        "declared_target_identity_matches": identities,
        "surrogate_exact_matches": matches,
        "surrogate_match_fraction": matches / SAMPLE_SIZE,
    }


def main() -> int:
    started = time.perf_counter()
    enforce_runtime()
    sources = source_inventory()
    coalitions = coalition_inventory()
    source_set = set(sources)
    coalition_set = set(coalitions)
    intersection = sorted(source_set & coalition_set)
    if len(intersection) < 12:
        raise RuntimeError(f"intersection gate failed: {len(intersection)}")
    print(
        f"progress inventory source={len(source_set)} coalition={len(coalition_set)} "
        f"intersection={len(intersection)} peak_rss={peak_rss_bytes()}", flush=True,
    )

    source_lookup: dict[int, dict[tuple[int, tuple[int | None, int | None]], dict[str, object]]] = {}
    source_groups = {"C1": defaultdict(list), "C2": defaultdict(list)}
    sample_rows = {"C1": [], "C2": [], "C3": []}
    q1_digests: set[str] = set()
    q2_digests: set[str] = set()
    q1_widths: set[int] = set()
    q2_widths: set[int] = set()
    physics_digests: set[str] = set()
    source_rows_total = 0
    sealed_source_rows_checked = 0
    source_exact_extension_residual_max = {"C1": 0.0, "C2": 0.0}

    for position, index in enumerate(intersection, start=1):
        path, header = sources[index]
        verify_sidecar(path)
        world_index = int(header["world_index"])
        anchor_index = int(header["anchor_index_within_world"])
        sealed = sealed_source_rows(index, world_index, anchor_index)
        lookup = {}
        count = 0
        with path.open("r", encoding="ascii") as handle:
            next(handle)
            for line in handle:
                row = json.loads(line)
                count += 1
                source_rows_total += 1
                q1_digests.add(str(row["q1_schema_sha256"]))
                q2_digests.add(str(row["q2_schema_sha256"]))
                q1_widths.add(len(row["q1_state"]))
                q2_widths.add(len(row["q2_state"]))
                physics_digests.add(str(row["physics_digest"]))
                user = int(row["user_id"])
                action_index = int(row["action_index"])
                action = action_key(row["action"])
                key = (user, action_index, action)
                fallback = sealed.get(key)
                if fallback is None:
                    raise RuntimeError(f"sealed fallback row missing at anchor {index}: {key}")
                extension = row["exact_source_view"]
                surrogate = extension["surrogate"]
                pairs = {
                    "c1_core_bits_hex": "c1_label_bits_hex",
                    "c1_phi_difference_hex": "c1_phi_difference_hex",
                    "c1_normalized_total_hex": "c1_label_normalized_hex",
                    "c2_label_bits_hex": "c2_label_bits_hex",
                    "c2_normalized_total_hex": "c2_label_normalized_hex",
                }
                if any(surrogate[left] != fallback[right] for left, right in pairs.items()):
                    raise RuntimeError(f"embedded surrogate is not sealed fallback: anchor {index}")
                sealed_source_rows_checked += 1

                c1 = extension["c1_difference_surplus"]
                c2 = extension["c2_persistence_forecast"]
                c1_target_hex = c1["normalized_total"]["float_hex"]
                c2_target_hex = c2["normalized_total"]["float_hex"]
                c1_exact = row["c1_label_normalized_hex"]
                c2_exact = row["c2_label_normalized_hex"]
                c1_target_residual = abs(float.fromhex(c1_exact) - float.fromhex(c1_target_hex))
                c2_target_residual = abs(float.fromhex(c2_exact) - float.fromhex(c2_target_hex))
                source_exact_extension_residual_max["C1"] = max(
                    source_exact_extension_residual_max["C1"], c1_target_residual
                )
                source_exact_extension_residual_max["C2"] = max(
                    source_exact_extension_residual_max["C2"], c2_target_residual
                )
                if c1_target_residual > 1e-12:
                    raise RuntimeError(f"C1 exact extension/base label mismatch: {c1_target_residual}")
                if c2_target_residual > 1e-12:
                    raise RuntimeError(f"C2 exact extension/base label mismatch: {c2_target_residual}")
                c1_identity = (
                    fraction(c1["decomposition_residual"]) == 0
                    and fraction(c1["normalized_total"])
                    == fraction(c1["core_bits"]) / Fraction.from_float(
                        float.fromhex(row["kappa_normalization_bits_hex"])
                    ) + fraction(c1["phi_difference"])
                )
                c2_identity = (
                    fraction(c2["decomposition_residual"]) == 0
                    and fraction(c2["label_bits"])
                    == fraction(c2["forecast_surplus_bits"])
                    - fraction(c2["persistence_penalty_bits"])
                    and fraction(c2["normalized_total"])
                    == fraction(c2["label_bits"]) / Fraction.from_float(
                        float.fromhex(row["kappa_normalization_bits_hex"])
                    )
                )
                # Exact rational normalization can differ from the binary64 kappa
                # reconstruction by rounding. The serialized decomposition residual
                # and extension/base equality are the authoritative exact checks.
                c1_identity = c1_identity or (
                    fraction(c1["decomposition_residual"]) == 0
                    and c1_target_residual <= 1e-12
                )
                c2_identity = c2_identity or (
                    fraction(c2["decomposition_residual"]) == 0
                    and fraction(c2["label_bits"])
                    == fraction(c2["forecast_surplus_bits"])
                    - fraction(c2["persistence_penalty_bits"])
                    and c2_target_residual <= 1e-12
                )
                lookup[(user, action)] = {
                    "exact_c1": float.fromhex(c1_exact),
                    "surrogate_c1": float.fromhex(surrogate["c1_normalized_total_hex"]),
                    "action_index": action_index,
                }
                group = (index, user)
                source_groups["C1"][group].append((action_index, float.fromhex(c1_exact), float.fromhex(surrogate["c1_normalized_total_hex"])))
                source_groups["C2"][group].append((action_index, float.fromhex(c2_exact), float.fromhex(surrogate["c2_normalized_total_hex"])))
                if not bool(row["reference_action"]):
                    sample_rows["C1"].append({
                        "exact_hex": c1_exact,
                        "surrogate_hex": surrogate["c1_normalized_total_hex"],
                        "identity": c1_identity,
                    })
                    sample_rows["C2"].append({
                        "exact_hex": c2_exact,
                        "surrogate_hex": surrogate["c2_normalized_total_hex"],
                        "identity": c2_identity,
                    })
        if count != int(header["row_count"]):
            raise RuntimeError(f"source row count mismatch: {path}")
        source_lookup[index] = lookup
        print(
            f"progress source {position}/{len(intersection)} global-{index:03d} "
            f"rows={count} peak_rss={peak_rss_bytes()}", flush=True,
        )

    disagreements = {}
    for route in ("C1", "C2"):
        disagree = 0
        for rows in source_groups[route].values():
            exact = winner([(index, exact) for index, exact, _surrogate in rows])
            surrogate = winner([(index, surrogate) for index, _exact, surrogate in rows])
            disagree += exact != surrogate
        groups = len(source_groups[route])
        disagreements[route] = {
            "groups": groups,
            "disagreements": disagree,
            "fraction": disagree / groups,
        }

    c3_groups: dict[int, list[tuple[int, float, float]]] = defaultdict(list)
    c3_rows_total = 0
    c3_exact_identity_count = 0
    c3_exact_c1_residual_max = 0.0
    c3_reconstruction_residual_max = 0.0
    c3_surrogate_match_all = 0
    c3_sealed_overlap_count = 0
    c3_sealed_overlap_psi_equal = 0

    for position, index in enumerate(intersection, start=1):
        path, header = coalitions[index]
        verify_sidecar(path)
        sealed_path = SEALED_ROOT / "world-1" / f"PILOT_NOT_CLAIM-coalition-anchor-{index:03d}.jsonl"
        verify_sidecar(sealed_path)
        with sealed_path.open("r", encoding="ascii") as handle:
            next(handle)
            sealed_coalition = json.loads(next(handle))
        sealed_members = tuple(sorted(
            (int(member["user_id"]), action_key(member["selected_action"]))
            for member in sealed_coalition["context"]["members"]
        ))
        row_count = 0
        with path.open("r", encoding="ascii") as handle:
            next(handle)
            for row_offset, line in enumerate(handle):
                row = json.loads(line)
                row_count += 1
                c3_rows_total += 1
                physics_digests.add(str(row["physics_digest"]))
                exact_c1 = float.fromhex(row["c1_normalized_hex"])
                exact_psi = float.fromhex(row["psi_normalized_hex"])
                objective = float.fromhex(row["objective_delta_normalized_hex"])
                physical_c1 = float.fromhex(row["physical_c1_normalized_hex"])
                physical_psi = float.fromhex(row["physical_psi_normalized_hex"])
                physical_delta = float.fromhex(row["physical_delta_normalized_hex"])
                reconstruction = max(
                    abs(exact_c1 + exact_psi - objective),
                    abs(physical_c1 + physical_psi - physical_delta),
                )
                c3_reconstruction_residual_max = max(c3_reconstruction_residual_max, reconstruction)
                if reconstruction > 1e-12:
                    raise RuntimeError(f"C3 exact reconstruction failed at anchor {index}")
                selected_members = tuple(sorted(
                    (int(member["user_id"]), action_key(member["selected_action"]))
                    for member in row["context"]["members"]
                ))
                exact_c1_from_source = math.fsum(
                    source_lookup[index][member]["exact_c1"] for member in selected_members
                )
                surrogate_c1 = math.fsum(
                    source_lookup[index][member]["surrogate_c1"] for member in selected_members
                )
                c1_residual = abs(exact_c1 - exact_c1_from_source)
                c3_exact_c1_residual_max = max(c3_exact_c1_residual_max, c1_residual)
                # Coalition C1 is accumulated from exact Fractions before one
                # binary64 conversion; source labels are converted per row and
                # then summed here. Permit only the tiny accumulation-order gap.
                if c1_residual > 1e-9:
                    raise RuntimeError(f"C3 exact C1/source identity failed at anchor {index}: {c1_residual}")
                surrogate_psi = objective - surrogate_c1
                surrogate_hex = float.hex(surrogate_psi)
                exact_hex = row["psi_normalized_hex"]
                c3_surrogate_match_all += exact_hex == surrogate_hex
                c3_exact_identity_count += 1
                sample_rows["C3"].append({
                    "exact_hex": exact_hex,
                    "surrogate_hex": surrogate_hex,
                    "identity": reconstruction <= 1e-12 and c1_residual <= 1e-9,
                })
                c3_groups[index].append((row_offset, exact_psi, surrogate_psi))
                if selected_members == sealed_members:
                    c3_sealed_overlap_count += 1
                    c3_sealed_overlap_psi_equal += (
                        exact_hex == sealed_coalition["psi_normalized_hex"]
                    )
        if row_count != int(header["row_count"]):
            raise RuntimeError(f"coalition row count mismatch: {path}")
        print(
            f"progress C3 {position}/{len(intersection)} global-{index:03d} "
            f"rows={row_count} peak_rss={peak_rss_bytes()}", flush=True,
        )

    c3_disagree = 0
    for rows in c3_groups.values():
        exact = winner([(offset, exact) for offset, exact, _surrogate in rows])
        surrogate = winner([(offset, surrogate) for offset, _exact, surrogate in rows])
        c3_disagree += exact != surrogate
    disagreements["C3"] = {
        "groups": len(c3_groups),
        "disagreements": c3_disagree,
        "fraction": c3_disagree / len(c3_groups),
        "group_definition": "one coalition-configuration argmax per anchor; canonical row order breaks exact ties",
    }

    if len(q1_digests) != 1 or len(q2_digests) != 1 or q1_widths != {16} or q2_widths != {22}:
        raise RuntimeError("source feature schema is not singular 16/22")
    q1_width = next(iter(q1_widths))
    member_width = 2 * q1_width + 6
    c3_width = 1 + 2 * member_width + 4 * 7 + (32 * 4 + 1) + 6
    if c3_width != 240:
        raise RuntimeError(f"derived C3 width drifted: {c3_width}")
    if len(physics_digests) != 1:
        raise RuntimeError(f"physics digests disagree: {physics_digests}")

    samples = {route: sample_stats(sample_rows[route], route) for route in ("C1", "C2", "C3")}
    # Fail closed if any route looks like the surrogate corpus. The threshold
    # is intentionally far from one; exact equality should be rare here.
    if any(samples[route]["surrogate_match_fraction"] >= 0.5 for route in samples):
        raise RuntimeError(f"surrogate-label gate failed: {samples}")

    anchors = [
        {
            "global_anchor_index": index,
            "name": (
                f"{sources[index][1]['world_id']}|step={sources[index][1]['step_index']}|"
                f"carrier={sources[index][1]['carrier']}"
            ),
        }
        for index in intersection
    ]
    result = {
        "schema": "mcrl-v025-exacttrain-corpus-verification-v1",
        "verified_by_running_code": {
            "source_anchor_count": len(source_set),
            "coalition_anchor_count": len(coalition_set),
            "intersection_count": len(intersection),
            "intersection": anchors,
            "source_rows": source_rows_total,
            "coalition_rows": c3_rows_total,
            "sealed_source_fallback_rows_checked": sealed_source_rows_checked,
            "source_training_label_vs_exact_extension_residual_max": source_exact_extension_residual_max,
            "physics_digest": next(iter(physics_digests)),
            "sample_checks": samples,
            "argmax_disagreement": disagreements,
            "c3_all_rows_surrogate_matches": c3_surrogate_match_all,
            "c3_all_rows_surrogate_match_fraction": c3_surrogate_match_all / c3_rows_total,
            "c3_exact_target_identity_count": c3_exact_identity_count,
            "c3_exact_c1_source_residual_max": c3_exact_c1_residual_max,
            "c3_reconstruction_residual_max": c3_reconstruction_residual_max,
            "c3_rows_overlapping_sealed_single_coalition": c3_sealed_overlap_count,
            "c3_overlap_exact_psi_equal_to_sealed": c3_sealed_overlap_psi_equal,
        },
        "derived_on_paper_checked_in_code": {
            "q1_schema_sha256": next(iter(q1_digests)),
            "q2_schema_sha256": next(iter(q2_digests)),
            "q1_width": q1_width,
            "q2_width": next(iter(q2_widths)),
            "member_width_formula": "2*Q1+6",
            "member_width": member_width,
            "c3_width_formula": "1 + 2*(2*Q1 + 6) + 4*7 + (32*4 + 1) + 6",
            "c3_width": c3_width,
        },
        "surrogate_c3_definition": (
            "objective_delta_normalized minus the sum of the same members' sealed "
            "provider-primitive C1 fallback labels; this is the mixed-label C3 residual "
            "that would result from substituting surrogate unilateral rows into the exact identity"
        ),
        "sample_frame": "non-reference source rows for C1/C2; all multi-user rows for C3",
        "resources": {
            "interpreter": str(Path(sys.executable).resolve()),
            "nice": os.getpriority(os.PRIO_PROCESS, 0),
            "blas_threads": {name: os.environ[name] for name in THREAD_VARS},
            "python_processes_observed": list(python_processes()),
            "rlimit_as_bytes": resource.getrlimit(resource.RLIMIT_AS)[0],
            "peak_rss_bytes": peak_rss_bytes(),
            "elapsed_s": time.perf_counter() - started,
        },
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    if OUTPUT.exists():
        raise RuntimeError(f"refusing to overwrite {OUTPUT}")
    temporary = OUTPUT.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii")
    temporary.replace(OUTPUT)
    print(json.dumps({
        "event": "verification-complete",
        "intersection": len(intersection),
        "samples": samples,
        "argmax_disagreement": disagreements,
        "peak_rss_bytes": peak_rss_bytes(),
    }, sort_keys=True), flush=True)
