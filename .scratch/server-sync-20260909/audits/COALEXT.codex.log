+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Run the sealed C3 coalition producer against promoted EXACTGEN2 inputs.
+
+This adapter changes only input discovery, anchor slicing, and owned output
+paths.  All catalogue reconstruction, joint evaluation, label construction,
+serialization, sidecars, and production-reader checks execute in the original
+producer module.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+
+PRODUCER = Path(
+    "/home/sat/mcrl-v025-coalgen-ws/.scratch/c3-coalition-build/build.py"
+)
+SOURCE_CORPUS = Path(
+    "/home/sat/mcrl-v025-datepool-ws/artifacts/"
+    "v025-exact-source-20260910-BUILD_NOT_CLAIM"
+)
+SOURCE_MANIFEST = SOURCE_CORPUS / "BUILD_NOT_CLAIM-manifest.json"
+OWNED_ROOT = Path("/home/sat/mcrl-v025-coalext-ws")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_producer():
+    spec = importlib.util.spec_from_file_location("coalext_original_producer", PRODUCER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import original producer: {PRODUCER}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def promoted_records(module) -> list[dict[str, object]]:
+    payload = json.loads(SOURCE_MANIFEST.read_text(encoding="ascii"))
+    records = list(payload["anchor_records"])
+    if int(payload["anchors_generated"]) != len(records) or len(records) != 93:
+        raise RuntimeError("promoted source manifest is not the admitted 93-anchor prefix")
+    if [int(row["global_anchor_index"]) for row in records] != list(range(93)):
+        raise RuntimeError("promoted source records are not global-000..global-092")
+    manifest_hash = sha256(SOURCE_MANIFEST)
+    for record in records:
+        physics = SOURCE_CORPUS / "physics" / str(record["physics_relative_path"])
+        view = SOURCE_CORPUS / "views" / str(record["view_relative_path"])
+        physics_hash = module.verify_sidecar(physics)
+        view_hash = module.verify_sidecar(view)
+        if physics_hash != record["physics_sha256"] or view_hash != record["view_sha256"]:
+            raise RuntimeError(
+                f"promoted source manifest/sidecar disagreement at anchor "
+                f"{record['global_anchor_index']}"
+            )
+        record.update(
+            {
+                "source_result_path": str(SOURCE_MANIFEST),
+                "source_physics_path": str(physics),
+                "source_view_path": str(view),
+                "source_result_sha256": manifest_hash,
+            }
+        )
+    start = int(os.environ.get("COALEXT_ANCHOR_START", "0"))
+    stop = int(os.environ.get("COALEXT_ANCHOR_STOP", "93"))
+    if not (0 <= start < stop <= 93):
+        raise RuntimeError(f"invalid admitted-anchor slice [{start}, {stop})")
+    selected = records[start:stop]
+    deadline = float(os.environ["COALEXT_DEADLINE_UNIX_S"])
+    if time.time() >= deadline:
+        raise RuntimeError("hard deadline already passed before producer launch")
+    print(
+        "ADAPTER "
+        + json.dumps(
+            {
+                "original_producer": str(PRODUCER),
+                "original_producer_sha256": sha256(PRODUCER),
+                "source_manifest": str(SOURCE_MANIFEST),
+                "source_manifest_sha256": manifest_hash,
+                "anchor_slice": [start, stop],
+                "hard_deadline_unix_s": deadline,
+            },
+            sort_keys=True,
+        ),
+        flush=True,
+    )
+    return selected
+
+
+def main() -> int:
+    module = load_producer()
+    output = Path(os.environ["COALEXT_OUTPUT"]).resolve()
+    try:
+        output.relative_to(OWNED_ROOT)
+    except ValueError as error:
+        raise RuntimeError(f"output is outside owned workspace: {output}") from error
+    module.WORKSPACE = OWNED_ROOT
+    module.SOURCE_CORPUS = SOURCE_CORPUS
+    module.OUTPUT = output
+    module.COMBINED_CORPUS = output / "corpus"
+    module.MANIFEST = output / "BUILD_NOT_CLAIM-coalition-verification.json"
+    module.snapshot_prefix = lambda: promoted_records(module)
+    return int(module.main())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
