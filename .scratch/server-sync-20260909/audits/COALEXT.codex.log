def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("ascii")


def write_new_json(path: Path, payload: object) -> None:
    if path.exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(canonical_bytes(payload) + b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def python_processes() -> tuple[tuple[int, str], ...]:
    rows = []
    for item in Path("/proc").iterdir():
        if not item.name.isdigit():
            continue
        try:
            name = (item / "comm").read_text().strip()
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if name.startswith("python"):
            rows.append((int(item.name), name))
    return tuple(sorted(rows))


def enforce_resources() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins are not all one: {bad}")
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    effective_cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
    resource.setrlimit(resource.RLIMIT_AS, (effective_cap, effective_cap))
    processes = python_processes()
    if len(processes) > 3:
        raise RuntimeError(f"python-process cap exceeded: {processes}")
    if peak_rss_bytes() >= 5_000_000_000:
        raise MemoryError("initial peak RSS is already at or above 5 GB")


def verify_sidecar(path: Path) -> str:
    sidecar = path.with_suffix(path.suffix + ".sha256")
    fields = sidecar.read_text(encoding="ascii").strip().split()
    if len(fields) != 2 or fields[1] != path.name:
        raise RuntimeError(f"malformed sidecar: {sidecar}")
    actual = sha256(path)
    if fields[0] != actual:
        raise RuntimeError(f"SHA-256 mismatch: {path}")
    return actual


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def snapshot_prefix() -> list[dict[str, object]]:
    records = []
    for index in range(SNAPSHOT_LIMIT):
        root = SOURCE_STAGING / f"global-{index:03d}"
        result_path = root / f"BUILD_NOT_CLAIM-anchor-{index:03d}.result.json"
        if not result_path.is_file():
            break
        record = json.loads(result_path.read_text())
        if int(record["global_anchor_index"]) != index:
            raise RuntimeError("source result index drifted")
        physics = SOURCE_CORPUS / str(record["physics_staging_path"])
        view = SOURCE_CORPUS / str(record["view_staging_path"])
        if not all(
            path.is_file()
            for path in (
                physics,
                physics.with_suffix(physics.suffix + ".sha256"),
                view,
                view.with_suffix(view.suffix + ".sha256"),
            )
        ):
            break
        physics_hash = verify_sidecar(physics)
        view_hash = verify_sidecar(view)
        if physics_hash != record["physics_sha256"] or view_hash != record["view_sha256"]:
            raise RuntimeError(f"result/sidecar disagreement for anchor {index}")
        records.append(
            {
                **record,
                "source_result_path": str(result_path),
                "source_physics_path": str(physics),
                "source_view_path": str(view),
                "source_result_sha256": sha256(result_path),
            }
        )
    if not records:
        raise RuntimeError("no complete authenticated source prefix exists")
    if [int(row["global_anchor_index"]) for row in records] != list(range(len(records))):
        raise RuntimeError("source snapshot is not a declared-order prefix")
    return records


def fraction(payload: dict[str, object]) -> Fraction:
    numerator, denominator = payload["fraction"]
    value = Fraction(int(numerator), int(denominator))
    if payload["float_hex"] != float.hex(float(value)):
        raise RuntimeError("fraction/float-hex disagreement")
    return value


def identity(value):
    return None if value is None else (int(value[0]), int(value[1]))


def mapping(payload: list[list[object]]) -> dict[int, tuple[int, int] | None]:
    return {int(user): identity(action) for user, action in payload}


def profile_payload(profile) -> dict[str, object]:
    return {
        "valid": True,
        "whole_network_bits_hex": float.hex(profile.bits),
        "whole_network_joules_hex": float.hex(profile.joules),
        "per_user": [
            {
                "user_id": int(user),
                "bits_hex": float.hex(float(profile.score.bits[user])),
                "served_phy": bool(profile.score.served_phy[user]),
                "decoding_time_s_hex": float.hex(float(profile.score.decoding_time_s[user])),
                "useful_time_s_hex": float.hex(float(profile.score.useful_time_s[user])),
                "rate_target_attained": (
                    None
                    if profile.score.rate_target_attained is None
                    else bool(profile.score.rate_target_attained[user])
                ),
                "rate_target_feasible": (
                    None
                    if profile.score.rate_target_feasible is None
                    else bool(profile.score.rate_target_feasible[user])
                ),
            }
            for user in sorted(profile.score.bits)
        ],
        "energy_components_j_hex": {
            str(name): float.hex(float(value))
            for name, value in sorted(profile.energy_components.items())
        },
        "required_power_w_max_hex": float.hex(profile.required_power_w_max),
        "minimum_decoding_margin_db_hex": float.hex(profile.min_decoding_margin_db),
        "mean_acm_spectral_efficiency_bit_s_hz_hex": float.hex(
            profile.mean_acm_se_bit_s_hz
        ),
        "acm_mode_counts": dict(sorted(profile.acm_mode_counts.items())),
        "certificate_status": profile.certificate_status,
        "certificate_iterations": int(profile.certificate_iterations),
        "rf_cap_hits": int(profile.rf_cap_hits),
        "rf_transmission_observations": int(profile.rf_transmission_observations),
    }


def outcome_from_stored(profile: dict[str, object], phi_payload: dict[str, object], NetworkOutcome):
    if profile["valid"] is not True:
        raise RuntimeError("stored singleton/default outcome is invalid")
    per_user = {
        int(row["user_id"]): float.fromhex(str(row["bits_hex"]))
        for row in profile["per_user"]
    }
    bits = sum((Fraction(str(value)) for value in per_user.values()), Fraction())
    decoding = math.fsum(
        float.fromhex(str(row["decoding_time_s_hex"])) for row in profile["per_user"]
    ) / (max(1, len(per_user)) * 30.08)
    useful = math.fsum(
        float.fromhex(str(row["useful_time_s_hex"])) for row in profile["per_user"]
    ) / (max(1, len(per_user)) * 30.08)
    return NetworkOutcome.build(
        bits=bits,
        joules=float.fromhex(str(profile["whole_network_joules_hex"])),
        phi=fraction(phi_payload),
        decoding_availability=min(1.0, max(0.0, decoding)),
        useful_availability=min(1.0, max(0.0, useful)),
        per_user_bits=per_user,
    )


def read_anchor_material(record, row_from_payload):
    physics_path = Path(str(record["source_physics_path"]))
    view_path = Path(str(record["source_view_path"]))
    with physics_path.open("r", encoding="ascii") as handle:
        header = json.loads(next(handle))
        if header["evaluation_path"] != {
            "boundaries": [0],
            "current_candidate_and_default": "evaluate_many",
            "forecast_candidate_and_default": "evaluate_many",
        }:
            raise RuntimeError("stored physics evaluation path drifted")
        context = None
        configurations = {}
        for line in handle:
            payload = json.loads(line)
            if payload["schema"] == "mcrl-v025-exact-source-anchor-context-v1":
                context = payload
            elif payload["schema"] == "mcrl-v025-exact-source-configuration-physics-v1":
                if len(payload["delta_from_default"]) <= 1:
                    configurations[payload["configuration_id"]] = {
                        "delta_from_default": payload["delta_from_default"],
                        "phi_current": payload["phi_current"],
                        "current": payload["current"],
                    }
    if context is None:
        raise RuntimeError("physics anchor context is missing")
    rows_by_user_action = {}
    authority = None
    with view_path.open("r", encoding="ascii") as handle:
        view_header = json.loads(next(handle))
        for line in handle:
            payload = json.loads(line)
            extension = payload.pop("exact_source_view")
            row = row_from_payload(payload)
            action = (
                None
                if row.action.norad_id is None
                else (row.action.norad_id, row.action.beam_chain_id)
            )
            rows_by_user_action[(row.user_id, action)] = row
            current_authority = {
                "world_seed": row.world_seed,
                "decision_time_utc": row.decision_time_utc,
                "decision_time_ns": row.decision_time_ns,
                "setting_id": row.setting_id,
                "code_digest": row.code_digest,
                "physics_digest": row.physics_digest,
                "catalogue_digest": row.catalogue_digest,
                "setting_digest": row.setting_digest,
                "calibration_digest": row.calibration_digest,
                "allocation_manifest_digest": row.allocation_manifest_digest,
                "provider_digest": row.provider_digest,
                "archive_digest": row.archive_digest,
            }
            if authority is None:
                authority = current_authority
            elif authority != current_authority:
                raise RuntimeError("source view authority varies within one anchor")
            if extension["physics_configuration_id"] not in configurations:
                raise RuntimeError("source view refers to absent singleton physics")
    if authority is None or len(rows_by_user_action) != int(view_header["row_count"]):
        raise RuntimeError("source view row inventory drifted")
    return header, context, configurations, rows_by_user_action, authority


def reconstruct_catalogue(ENGINE, tape, step_index, base, run_setting, configurations,
                          eta: Fraction, kappa: Fraction):
    users = tuple(sorted(user.user_id for user in tape.user_layout))
    all_options, raw_census = ENGINE._legal_options(tape, step_index)
    product_size = math.prod(len(all_options[user]) if all_options[user] else 1 for user in users)
    if product_size <= ENGINE.COMPLETE_CATALOGUE_LIMIT:
        options, census = all_options, raw_census
    else:
        options, census = ENGINE._selection_shortlist(
            tape, step_index, run_setting=run_setting
        )
    factors = tuple(options[user] if options[user] else (None,) for user in users)
    rows = [base]
    base_map = base.mapping
    ranked_users = []
    if product_size <= ENGINE.COMPLETE_CATALOGUE_LIMIT:
        for product in itertools.product(*factors):
            candidate_map = dict(zip(users, product, strict=True))
            if candidate_map != base_map:
                rows.append(ENGINE._configuration(base, candidate_map, kind="complete-cartesian"))
        mode = "complete-cartesian"
    else:
        unilaterals = {user: [] for user in users}
        for user in users:
            for action in options[user]:
                if action == base_map[user]:
                    continue
                candidate_map = dict(base_map)
                candidate_map[user] = action
                row = ENGINE._configuration(base, candidate_map, kind="unilateral")
                if row.configuration_id not in configurations:
                    raise RuntimeError(f"catalogue singleton absent from stored physics: {row.configuration_id}")
                rows.append(row)
                unilaterals[user].append(row)
        stored_defaults = [
            stored for stored in configurations.values() if not stored["delta_from_default"]
        ]
        if len(stored_defaults) != 1:
            raise RuntimeError("stored physics does not have exactly one zero-change configuration")
        base_stored = stored_defaults[0]["current"]
        base_bits = float.fromhex(base_stored["whole_network_bits_hex"])
        base_joules = float.fromhex(base_stored["whole_network_joules_hex"])
        best_surplus = {}
        for user in users:
            values = []
            for row in unilaterals[user]:
                stored = configurations[row.configuration_id]["current"]
                core = Fraction(
                    str(float.fromhex(stored["whole_network_bits_hex"]) - base_bits)
                ) - eta * Fraction(
                    str(float.fromhex(stored["whole_network_joules_hex"]) - base_joules)
                )
                core += kappa * ENGINE._phi_for(base, row)
                values.append(core)
            best_surplus[user] = max(values, default=Fraction(-10**30))
        ranked_users = sorted(users, key=lambda user: (-best_surplus[user], user))[
            : ENGINE.PAIRWISE_TOP_K_USERS
        ]
        for proposal_rank in range(ENGINE.TOP_PROPOSALS):
            candidate_map = dict(base_map)
            for user in users:
                if len(unilaterals[user]) > proposal_rank:
                    candidate_map[user] = unilaterals[user][proposal_rank].mapping[user]
            if candidate_map != base_map:
                rows.append(ENGINE._configuration(base, candidate_map, kind="s0-top-two"))
        for first, second in itertools.combinations(ranked_users, 2):
            for first_row in unilaterals[first][: ENGINE.TOP_PROPOSALS]:
                for second_row in unilaterals[second][: ENGINE.TOP_PROPOSALS]:
                    candidate_map = dict(base_map)
                    candidate_map[first] = first_row.mapping[first]
                    candidate_map[second] = second_row.mapping[second]
                    rows.append(
                        ENGINE._configuration(
                            base, candidate_map, kind="pairwise-top10-top2"
                        )
                    )
        for beam in sorted({value for value in base_map.values() if value is not None}):
            candidate_map = dict(base_map)
            affected = [user for user in users if base_map[user] == beam]
            for user in affected:
                candidate_map[user] = next(
                    (action for action in options[user] if action != beam), None
                )
            if candidate_map != base_map:
                rows.append(
                    ENGINE._configuration(base, candidate_map, kind="beam-evacuation")
                )
        mode = "bounded-union-v2"
    unique = {row.assignments: row for row in rows}
    ordered = (base,) + tuple(
        sorted(
            (row for assignments, row in unique.items() if assignments != base.assignments),
            key=lambda row: row.configuration_id,
        )
    )
    if mode != "complete-cartesian" and len(ordered) > ENGINE.CATALOGUE_CAP:
        raise RuntimeError("reconstructed bounded catalogue exceeded declared cap")
    return ordered, {
        **census,
        "complete_cartesian_size": product_size,
        "catalogue_mode": mode,
        "null_action_users": sum(not options[user] for user in users),
        "bounded_catalogue_count": len(ordered),
        "top10_users_by_exact_nominal_unilateral_surplus": ranked_users,
    }


def copy_source_view(record) -> Path:
    source = Path(str(record["source_view_path"]))
    world_index = int(record["world_index"])
    anchor = int(record["global_anchor_index"])
    destination = (
        COMBINED_CORPUS
        / ".staging-separated-v1"
        / f"global-{anchor:03d}"
        / "views"
        / f"world-{world_index}"
        / source.name
    )
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, destination)
    shutil.copyfile(
        source.with_suffix(source.suffix + ".sha256"),
        destination.with_suffix(destination.suffix + ".sha256"),
    )
    verify_sidecar(destination)
    return destination


def assert_snapshot_unchanged(records) -> None:
    for record in records:
        paths = {
            Path(str(record["source_result_path"])): record["source_result_sha256"],
            Path(str(record["source_physics_path"])): record["physics_sha256"],
            Path(str(record["source_view_path"])): record["view_sha256"],
        }
        for path, expected in paths.items():
            if sha256(path) != expected:
                raise RuntimeError(f"snapshotted EXACTGEN2-owned file changed: {path}")


def main() -> int:
    sys.dont_write_bytecode = True
    enforce_resources()
    if OUTPUT.exists():
        raise RuntimeError(f"output already exists: {OUTPUT}")
    records = snapshot_prefix()
    source_hashes_before = {
        str(path): sha256(path) for path in (LOCAL_PILOT, SOURCE_PILOT, TRAINING_RUNNER)
    }
    print(
        "SNAPSHOT "
        + json.dumps(
            {
                "anchors": len(records),
                "indices": [int(row["global_anchor_index"]) for row in records],
                "prefix_of_declared_180": True,
                "python_processes": python_processes(),
            },
            sort_keys=True,
        ),
        flush=True,
    )
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    pilot = load_module("c3_coalition_build_pilot", SOURCE_PILOT)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise RuntimeError("pilot fallback flag was not true after import")
    if tuple(pilot.ENGINE.SELECTION_BOUNDARY_INDICES) != (0,):
        raise RuntimeError("pilot selection boundary drifted")
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape
    from mcrl.physics_v025.targets import NetworkOutcome
    from mcrl.stagec_v025.canonical import canonical_sha256, float_hex
    from mcrl.stagec_v025.coalitions import (
        MAX_LABEL_COALITION_SIZE,
        CoalitionRow,
        capped_coalition_decomposition,
        write_coalition_shard,
    )
    from mcrl.stagec_v025.shards import _row_from_payload

    OUTPUT.mkdir(parents=True)
    overall_started = time.perf_counter()
    size_distribution = Counter()
    full_support_distribution = Counter()
    anchor_results = []
    singleton_zero_count = 0
    exact_residual_max = Fraction()
    float_residual_max = 0.0
    common_physics_digests = set()
    full_profile_equal_count = 0
    default_cross_batch_gaps = []
    by_world = {}
    for record in records:
        by_world.setdefault(int(record["world_index"]), []).append(record)
    progress = 0
    try:
        for world_index in sorted(by_world):
            world_records = by_world[world_index]
            world_id = str(world_records[0]["world_id"])
            print(f"PREPARE_WORLD world={world_id}", flush=True)
            provider = LegacyWorldProvider(role="pilot-source")
            tape_started = time.perf_counter()
            tape = build_world_tape(
                domain=world_id, provider=provider, steps=33, start_time_s=0.0
            )
            tape_wall = time.perf_counter() - tape_started
            setting = pilot.ENGINE._setting("a-r0")
            run_setting = pilot.ENGINE.run_setting_for("a-r0")
            for record in world_records:
                anchor_started = time.perf_counter()
                global_index = int(record["global_anchor_index"])
                step_index = int(record["step_index"])
                carrier = str(record["carrier"])
                if carrier != CARRIERS[int(record["carrier_index"])]:
                    raise RuntimeError("carrier order drifted")
                (
                    physics_header,
                    stored_context,
                    configurations,
                    rows_by_user_action,
                    authority,
                ) = read_anchor_material(record, _row_from_payload)
                eta = fraction(stored_context["calibration"]["eta_ref"])
                lambda_bits = fraction(stored_context["calibration"]["lambda_bits_per_j"])
                kappa = fraction(
                    stored_context["calibration"]["kappa_bits_per_user_step"]
                )
                if eta != lambda_bits:
                    raise RuntimeError("stored calibration violates lambda=eta")
                base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
                incumbent = pilot.ENGINE._base_configuration(
                    tape, max(0, step_index - 1), carrier
                )
                if base.configuration_id != stored_context["default_configuration_id"]:
                    raise RuntimeError("reconstructed default identity drifted")
                if base.mapping != mapping(stored_context["default_mapping"]):
                    raise RuntimeError("reconstructed default mapping drifted")
                if incumbent.mapping != mapping(stored_context["incumbent_mapping"]):
                    raise RuntimeError("reconstructed incumbent mapping drifted")
                if authority["provider_digest"] != tape.protocol.provider_source_digest:
                    raise RuntimeError("reconstructed provider digest differs from stored view")
                if authority["archive_digest"] != pilot._archive_digest(tape):
                    raise RuntimeError("reconstructed archive digest differs from stored view")
                rekeyed = pilot.ENGINE._rekeyed_users(tape, step_index)
                if tuple(stored_context["cell_rekeyed_users"]) != tuple(rekeyed):
                    raise RuntimeError("rekey inventory drifted")
                default_phi = pilot.ENGINE._phi_for(
                    incumbent, base, cell_rekeyed_users=rekeyed
                )
                if default_phi != fraction(stored_context["default_phi_current"]):
                    raise RuntimeError("default Phi drifted")
                catalogue, census = reconstruct_catalogue(
                    pilot.ENGINE,
                    tape,
                    step_index,
                    base,
                    run_setting,
                    configurations,
                    eta,
                    kappa,
                )
                singles = tuple(row for row in catalogue if row.changed_users == 1)
                joints = tuple(row for row in catalogue if row.changed_users >= 2)
                full_support_distribution.update(row.changed_users for row in catalogue)
                stored_defaults = [
                    stored
                    for stored in configurations.values()
                    if not stored["delta_from_default"]
                ]
                if len(stored_defaults) != 1:
                    raise RuntimeError(
                        "stored physics does not have exactly one zero-change configuration"
                    )
                stored_default = stored_defaults[0]
                stored_reference = outcome_from_stored(
                    stored_default["current"], stored_default["phi_current"], NetworkOutcome
                )
                for singleton in singles:
                    stored = configurations[singleton.configuration_id]
                    singleton_outcome = outcome_from_stored(
                        stored["current"], stored["phi_current"], NetworkOutcome
                    )
                    f0 = stored_reference.bits - eta * stored_reference.joules + kappa * stored_reference.phi
                    f1 = singleton_outcome.bits - eta * singleton_outcome.joules + kappa * singleton_outcome.phi
                    delta_singleton = f1 - f0
                    d_user = f1 - f0
                    residual = delta_singleton - d_user
                    if residual != 0:
                        raise RuntimeError("singleton Psi is not exactly zero")
                    singleton_zero_count += 1
                counter = pilot.ENGINE.EvaluationCounter()
                evaluator = pilot.ENGINE.StepEvaluator(
                    tape,
                    setting,
                    step_index,
                    transition_from=incumbent,
                    cell_rekeyed_users=rekeyed,
                    field="nominal",
                    counter=counter,
                    run_setting=run_setting,
                    boundary_indices=(0,),
                )
                joint_started = time.perf_counter()
                fresh_default_config = pilot.ENGINE._configuration(
                    base, base.mapping, kind="exact-source-attribution"
                )
                if fresh_default_config.configuration_id not in configurations:
                    raise RuntimeError("canonical fresh default ID is absent from stored physics")
                evaluator.evaluate_many((fresh_default_config, *joints))
                joint_wall = time.perf_counter() - joint_started
                if fresh_default_config.configuration_id not in evaluator._evaluated:
                    raise RuntimeError("fresh dense default evaluation is absent")
                fresh_base_profile = evaluator._evaluated[
                    fresh_default_config.configuration_id
                ]
                fresh_profile_payload = profile_payload(fresh_base_profile)
                if fresh_profile_payload == stored_default["current"]:
                    full_profile_equal_count += 1
                else:
                    differing_fields = sorted(
                        key
                        for key in fresh_profile_payload
                        if fresh_profile_payload[key] != stored_default["current"].get(key)
                    )
                    print(
                        "DEFAULT_PROFILE_METADATA_DIFFERENCE "
                        + json.dumps(
                            {
                                "global_anchor_index": global_index,
                                "fields": differing_fields,
                                "fresh_sha256": hashlib.sha256(
                                    canonical_bytes(fresh_profile_payload)
                                ).hexdigest(),
                                "stored_sha256": hashlib.sha256(
                                    canonical_bytes(stored_default["current"])
                                ).hexdigest(),
                            },
                            sort_keys=True,
                        ),
                        flush=True,
                    )
                fresh_reference = fresh_base_profile.outcome(phi=default_phi)
                default_cross_batch_gaps.append(
                    {
                        "global_anchor_index": global_index,
                        "bits_fraction": [
                            (fresh_reference.bits - stored_reference.bits).numerator,
                            (fresh_reference.bits - stored_reference.bits).denominator,
                        ],
                        "joules_fraction": [
                            (fresh_reference.joules - stored_reference.joules).numerator,
                            (fresh_reference.joules - stored_reference.joules).denominator,
                        ],
                        "physical_objective_fraction": [
                            (
                                (fresh_reference.bits - eta * fresh_reference.joules)
                                - (stored_reference.bits - eta * stored_reference.joules)
                            ).numerator,
                            (
                                (fresh_reference.bits - eta * fresh_reference.joules)
                                - (stored_reference.bits - eta * stored_reference.joules)
                            ).denominator,
                        ],
                    }
                )
                valid_joints = tuple(
                    row for row in joints if row.configuration_id in evaluator._evaluated
                )
                invalid_joints = tuple(
                    row for row in joints if row.configuration_id in evaluator._invalid
                )
                if len(valid_joints) + len(invalid_joints) != len(joints):
                    raise RuntimeError("joint evaluation inventory is incomplete")
                coalition_rows = []
                anchor_sizes = Counter()
                for selected in valid_joints:
                    context = pilot._coalition_context(
                        tape=tape,
                        step_index=step_index,
                        anchor=base,
                        selected=selected,
                        rows_by_user_action=rows_by_user_action,
                    )
                    unilateral = {}
                    for user in context.changed_users:
                        singleton_map = base.mapping
                        singleton_map[user] = selected.mapping[user]
                        singleton = pilot.ENGINE._configuration(
                            base, singleton_map, kind="coalition-singleton-from-stored"
                        )
                        stored = configurations.get(singleton.configuration_id)
                        if stored is None:
                            raise RuntimeError(
                                f"joint member singleton absent: {singleton.configuration_id}"
                            )
                        unilateral[user] = outcome_from_stored(
                            stored["current"], stored["phi_current"], NetworkOutcome
                        )
                    joint_phi = pilot.ENGINE._phi_for(
                        incumbent, selected, cell_rekeyed_users=rekeyed
                    )
                    coalition_outcome = evaluator._evaluated[selected.configuration_id].outcome(
                        phi=joint_phi
                    )
                    def physical(outcome):
                        return outcome.bits - eta * outcome.joules

                    def inclusive(outcome):
                        return physical(outcome) + kappa * outcome.phi

                    stored_f0 = inclusive(stored_reference)
                    fresh_f0 = inclusive(fresh_reference)
                    stored_p0 = physical(stored_reference)
                    fresh_p0 = physical(fresh_reference)
                    c1 = sum(
                        (inclusive(unilateral[user]) - stored_f0 for user in context.changed_users),
                        Fraction(),
                    )
                    physical_c1 = sum(
                        (physical(unilateral[user]) - stored_p0 for user in context.changed_users),
                        Fraction(),
                    )
                    objective_delta = inclusive(coalition_outcome) - fresh_f0
                    physical_delta = physical(coalition_outcome) - fresh_p0
                    psi = objective_delta - c1
                    physical_psi = physical_delta - physical_c1
                    residual = c1 + psi - objective_delta
                    physical_residual = physical_c1 + physical_psi - physical_delta
                    exact_residual_max = max(
                        exact_residual_max, abs(residual), abs(physical_residual)
                    )
                    original_users = context.changed_users
                    decomposition = dict(capped_coalition_decomposition(original_users))
                    row = CoalitionRow(
                        schema="mcrl-v025-stagec-c3-coalition-row-v2",
                        split="TRAIN",
                        world_id=str(physics_header["world_id"]),
                        world_seed=int(authority["world_seed"]),
                        learner_seed=None,
                        anchor_id=context.anchor_id,
                        anchor_index=int(physics_header["anchor_index_within_world"]),
                        decision_time_utc=str(authority["decision_time_utc"]),
                        decision_time_ns=int(authority["decision_time_ns"]),
                        setting_id=str(authority["setting_id"]),
                        context=context,
                        original_changed_user_count=len(original_users),
                        capped_decomposition=False,
                        original_changed_users=original_users,
                        decomposition_id=canonical_sha256(
                            {
                                "schema": "mcrl-v025-stagec-capped-coalition-decomposition-v1",
                                "original_changed_users": list(original_users),
                                "subsets": [
                                    list(users)
                                    for users, _weight in capped_coalition_decomposition(
                                        original_users
                                    )
                                ],
                            }
                        ),
                        decomposition_weight_hex=float_hex(decomposition[original_users]),
                        lambda_bits_per_j_hex=float_hex(float(lambda_bits)),
                        eta_ref_bits_per_j_hex=float_hex(float(eta)),
                        kappa_normalization_bits_hex=float_hex(float(kappa)),
                        c1_normalized_hex=float_hex(float(c1 / kappa)),
                        psi_normalized_hex=float_hex(float(psi / kappa)),
                        objective_delta_normalized_hex=float_hex(
                            float(objective_delta / kappa)
                        ),
                        physical_c1_normalized_hex=float_hex(float(physical_c1 / kappa)),
                        physical_psi_normalized_hex=float_hex(
                            float(physical_psi / kappa)
                        ),
                        physical_delta_normalized_hex=float_hex(
                            float(physical_delta / kappa)
                        ),
                        code_digest=str(authority["code_digest"]),
                        physics_digest=str(authority["physics_digest"]),
                        catalogue_digest=str(authority["catalogue_digest"]),
                        setting_digest=str(authority["setting_digest"]),
                        calibration_digest=str(authority["calibration_digest"]),
                        allocation_manifest_digest=str(
                            authority["allocation_manifest_digest"]
                        ),
                        credit_split=(
                            "EXACT_SHAPLEY_SMALL_SET"
                            if len(original_users) <= MAX_LABEL_COALITION_SIZE
                            else "NOT_COMPUTED_LARGE_SET"
                        ),
                    )
                    float_residual_max = max(
                        float_residual_max,
                        abs(
                            float.fromhex(row.c1_normalized_hex)
                            + float.fromhex(row.psi_normalized_hex)
                            - float.fromhex(row.objective_delta_normalized_hex)
                        ),
                        abs(
                            float.fromhex(row.physical_c1_normalized_hex)
                            + float.fromhex(row.physical_psi_normalized_hex)
                            - float.fromhex(row.physical_delta_normalized_hex)
                        ),
                    )
                    coalition_rows.append(row)
                    anchor_sizes[len(context.changed_users)] += 1
                    size_distribution[len(context.changed_users)] += 1
                    common_physics_digests.add(row.physics_digest)
                if not coalition_rows:
                    raise RuntimeError("anchor has no valid multi-user coalition rows")
                copied_view = copy_source_view(record)
                destination = (
                    copied_view.parent
                    / f"COALITION_BUILD-c3-anchor-{global_index:03d}.jsonl"
                )
                shard = write_coalition_shard(destination, coalition_rows)
                verify_sidecar(destination)
                assert_snapshot_unchanged((record,))
                if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
                    raise RuntimeError("pilot fallback flag changed in-process")
                progress += 1
                anchor_result = {
                    "global_anchor_index": global_index,
                    "world_id": world_id,
                    "anchor_index_within_world": int(record["anchor_index_within_world"]),
                    "step_index": step_index,
                    "carrier": carrier,
                    "catalogue_mode": census["catalogue_mode"],
                    "catalogue_count": len(catalogue),
                    "singleton_count": len(singles),
                    "joint_attempted_count": len(joints),
                    "joint_valid_emitted_count": len(valid_joints),
                    "joint_invalid_count": len(invalid_joints),
                    "coalition_size_distribution": dict(sorted(anchor_sizes.items())),
                    "joint_evaluation_wall_s": joint_wall,
                    "anchor_total_wall_s": time.perf_counter() - anchor_started,
                    "physics_boundary_evaluations": int(counter.boundary_evaluations),
                    "coalition_shard": destination.relative_to(OUTPUT).as_posix(),
                    "coalition_shard_sha256": shard.file_sha256,
                    "source_view_copy": copied_view.relative_to(OUTPUT).as_posix(),
                    "source_view_sha256": record["view_sha256"],
                    "peak_rss_bytes": peak_rss_bytes(),
                    "python_process_count": len(python_processes()),
                }
                anchor_results.append(anchor_result)
                print(
                    f"anchor {progress}/{len(records)} global-{global_index:03d} "
                    f"joint_s={joint_wall:.6f} emitted={len(valid_joints)}",
                    flush=True,
                )
                print(f"PEAK_RSS_BYTES={peak_rss_bytes()}", flush=True)
                if peak_rss_bytes() >= 5_000_000_000:
                    raise MemoryError("peak RSS reached 5 GB")
                if len(python_processes()) > 3:
                    raise RuntimeError("python-process cap exceeded during build")
                del evaluator, configurations, rows_by_user_action, coalition_rows
                gc.collect()
            del tape, provider
            gc.collect()
    finally:
        if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
            raise RuntimeError("pilot fallback flag was not restored")

    if len(common_physics_digests) != 1:
        raise RuntimeError(f"C3 rows do not share one physics digest: {common_physics_digests}")
    assert_snapshot_unchanged(records)
    gc.collect()
    training_runner = load_module("c3_coalition_training_reader", TRAINING_RUNNER)
    reader_started = time.perf_counter()
    loaded, corpus_receipt, feature = training_runner.load_corpus(COMBINED_CORPUS)
    reader_wall = time.perf_counter() - reader_started
    reader_verdict = "PASS"
    if loaded["pairs"]["C1"].physics_digest != loaded["c3"].physics_digest:
        raise RuntimeError("runner returned mismatched C1/C3 physics digests")
    source_hashes_after = {
        str(path): sha256(path) for path in (LOCAL_PILOT, SOURCE_PILOT, TRAINING_RUNNER)
    }
    if source_hashes_after != source_hashes_before:
        raise RuntimeError("pilot or training runner bytes changed")
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise RuntimeError("pilot fallback flag changed after reader dry-run")
    joint_seconds = [float(row["joint_evaluation_wall_s"]) for row in anchor_results]
    manifest = {
        "schema": "mcrl-v025-stagec-c3-coalition-build-verification-v1",
        "artifact_label": "BUILD_NOT_CLAIM",
        "not_a_claim": True,
        "anchors": len(records),
        "anchor_indices": [int(row["global_anchor_index"]) for row in records],
        "declared_order": {
            "worlds": ["V025_PROBE/world/1", "V025_PROBE/world/2"],
            "within_world": "step 0..29; at each step nearest-eligible, stay-if-possible, random-masked",
            "total_anchors": 180,
            "snapshot_is_prefix": True,
        },
        "source_snapshot": [
            {
                key: row[key]
                for key in (
                    "global_anchor_index",
                    "world_id",
                    "anchor_index_within_world",
                    "step_index",
                    "carrier",
                    "physics_sha256",
                    "view_sha256",
                    "source_result_sha256",
                )
            }
            for row in records
        ],
        "coalition_size_distribution": {
            str(key): value for key, value in sorted(size_distribution.items())
        },
        "full_catalogue_changed_user_distribution": {
            str(key): value for key, value in sorted(full_support_distribution.items())
        },
        "singleton_psi": {
            "checked": singleton_zero_count,
            "exact_nonzero": 0,
            "max_abs_fraction": [0, 1],
        },
        "decomposition_identity": {
            "exact_max_abs_fraction": [
                exact_residual_max.numerator,
                exact_residual_max.denominator,
            ],
            "binary64_encoded_max_abs": float_residual_max,
        },
        "joint_evaluation_seconds_per_anchor": {
            "values": joint_seconds,
            "minimum": min(joint_seconds),
            "mean": math.fsum(joint_seconds) / len(joint_seconds),
            "maximum": max(joint_seconds),
        },
        "runner_reader_dry_run": {
            "verdict": reader_verdict,
            "wall_s": reader_wall,
            "source_rows": corpus_receipt["source_rows"],
            "coalition_rows": corpus_receipt["coalition_rows"],
            "physics_digest": loaded["c3"].physics_digest,
            "corpus_receipt_digest": corpus_receipt["digest"],
            "feature": feature,
        },
        "evaluation_path": {
            "joint_candidate_and_fresh_default": "StepEvaluator.evaluate_many",
            "field": "nominal",
            "boundary_indices": [0],
            "stored_singleton_differences": "stored singleton minus stored default from authenticated original evaluate_many batch",
            "fresh_joint_differences": "fresh joint minus fresh default from one evaluate_many batch",
            "fresh_default_full_profile_equal_count": full_profile_equal_count,
            "singletons": "read from authenticated exact-source physics; not reevaluated",
        },
        "default_cross_batch_gaps": default_cross_batch_gaps,
        "resources": {
            "interpreter": sys.executable,
            "nice": os.getpriority(os.PRIO_PROCESS, 0),
            "blas_threads": {name: os.environ[name] for name in THREAD_VARS},
            "python_process_cap": 3,
            "observed_python_processes_at_end": python_processes(),
            "address_space_cap_bytes": MAX_AS_BYTES,
            "peak_rss_bytes": peak_rss_bytes(),
        },
        "byte_identity": {
            "before": source_hashes_before,
            "after": source_hashes_after,
            "identical": True,
            "pilot_fallback_value_after": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
        },
        "anchor_results": anchor_results,
        "overall_wall_s": time.perf_counter() - overall_started,
        "no_learner_trained": True,
        "no_ee_claim": True,
    }
    write_new_json(MANIFEST, manifest)
    print(f"READER_VERDICT={reader_verdict}", flush=True)
    print(f"PEAK_RSS_BYTES={peak_rss_bytes()}", flush=True)
    print(f"MANIFEST={MANIFEST}", flush=True)
    return 0


