@@ -0,0 +1,42 @@
+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Call the unchanged production corpus reader on a supplied corpus."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+from pathlib import Path
+import resource
+import sys
+
+
+RETRAIN = Path("/home/sat/mcrl-v025-retrain-ws")
+RUNNER = RETRAIN / "scripts/run_stagec_training.py"
+
+
+def main() -> int:
+    sys.path.insert(0, str(RETRAIN / "src"))
+    spec = importlib.util.spec_from_file_location("coalext_production_reader", RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load production runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    corpus = Path(sys.argv[1])
+    loaded, receipt, _feature = module.load_corpus(corpus)
+    print(
+        f"READER_VERDICT=PASS source_rows={receipt['source_rows']} "
+        f"coalition_rows={receipt['coalition_rows']} "
+        f"physics_digest={loaded['c3'].physics_digest}",
+        flush=True,
+    )
+    print(
+        f"PEAK_RSS_BYTES={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024} "
+        f"nice={os.getpriority(os.PRIO_PROCESS, 0)}",
+        flush=True,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
