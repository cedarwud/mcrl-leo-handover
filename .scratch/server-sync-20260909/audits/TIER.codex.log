    59	def canonical_bytes(value: object) -> bytes:
    60	    try:
    61	        return json.dumps(
    62	            value,
    63	            sort_keys=True,
    64	            separators=(",", ":"),
    65	            ensure_ascii=True,
    66	            allow_nan=False,
    67	        ).encode("ascii")
    68	    except (TypeError, ValueError, UnicodeError) as error:
    69	        raise MCRLContractError("tape payload is not canonical finite ASCII JSON") from error
    70	
    71	
    72	def digest_payload(value: object) -> str:
    73	    return hashlib.sha256(canonical_bytes(value)).hexdigest()
    74	
    75	
    76	def _step_array_digest(step: "PrimitiveStepArrays", *, boundary_zero_only: bool = False) -> str:
    77	    """Canonical digest for an array snapshot without multi-gigabyte JSON."""
    78	
    79	    digest = hashlib.sha256()
    80	    for name in step.__dataclass_fields__:
    81	        value = np.asarray(getattr(step, name))
    82	        if boundary_zero_only and value.ndim > 0 and value.shape[0] == 48:
    83	            value = value[:1]
    84	        contiguous = np.ascontiguousarray(value)
    85	        header = canonical_bytes(
    86	            {"name": name, "dtype": contiguous.dtype.str, "shape": list(contiguous.shape)}
    87	        )
    88	        digest.update(len(header).to_bytes(8, "big"))
    89	        digest.update(header)
    90	        payload = contiguous.tobytes(order="C")
    91	        digest.update(len(payload).to_bytes(8, "big"))
    92	        digest.update(payload)
    93	    return digest.hexdigest()
