#!/usr/bin/env python3
"""No-production-training C1/C2 collision and explainability diagnostic."""

from __future__ import annotations

import argparse
from dataclasses import dataclass, replace
from fractions import Fraction
import json
from pathlib import Path
import struct
import sys
from typing import Iterable

import numpy as np

from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.constants_v025 import BEAM_RF_CAP_W
from mcrl.physics_v025.tapes import (
    DEVELOPMENT_WORLD_DOMAINS,
    REFERENCE_CARRIERS,
    build_world_tape,
)
from mcrl.physics_v025.targets import (
    NetworkOutcome,
    OffsetProjection,
    c1_difference_surplus,
    c2_persistence_forecast,
)
from mcrl.stagec_v025.canonical import canonical_sha256
from mcrl.stagec_v025.shards import read_source_shard
from mcrl.stagec_v025.state import (
    ActionEvaluation,
    ForecastObservation,
    PhysicalAction,
    extract_source_rows,
    seal_action_evaluation,
)


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
import run_v025_pilot_c3 as pilot  # noqa: E402

ETA = Fraction(2)
KAPPA = Fraction(10)
ZERO_DIGEST = "0" * 64
EXISTING_ROWS = (
    ROOT
    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/rows/world-1"
)
CALIBRATION_PATH = (
    ROOT
    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
    / "PILOT_NOT_CLAIM-calibration.json"
)


def _network(bits: int, joules: int, *, phi: str = "0") -> NetworkOutcome:
    return NetworkOutcome.build(
        bits=bits,
        joules=joules,
        phi=phi,
        decoding_availability=1,
        useful_availability=1,
        per_user_bits={0: bits // 2, 1: bits - bits // 2},
    )


def _projection(
    index: int,
    outcome: NetworkOutcome,
    *,
    required_power_w: float,
) -> OffsetProjection:
    return OffsetProjection(
        offset_index=index,
        valid=True,
        survives=True,
        outcome=outcome,
        background_power_recomputed=True,
        required_power_w=required_power_w,
        power_cap_w=1.65,
        min_decoding_margin_db=4.0 - index,
        mean_acm_se_bit_s_hz=2.0,
    )


def _encoded_row(*, c1_bits: Fraction, c1_phi: Fraction, c2_bits: Fraction):
    forecasts = tuple(
        ForecastObservation(True, True, 4.0 - index, 2.0)
        for index in (1, 2, 3)
    )
    common = ActionEvaluation(
        action=PhysicalAction(1001, 7),
        nominal_sinr_margin_at_rate_target_db=4.0,
        nominal_required_power_over_cap=0.5,
        nominal_mode_spectral_efficiency=2.0,
        background_occupancy_excluding_focal=1,
        beam_active_before_focal=True,
        satellite_active_before_focal=True,
        off_axis_angle_rad=0.25,
        remaining_d2_time_s=60.0,
        remaining_visibility_time_s=90.0,
        refresh_phase=2,
        previous_served_association_for_action=False,
        previous_served_load_for_action=1,
        previous_beam_active_for_action=True,
        previous_satellite_active_for_action=True,
        previous_beam_max_rf_over_cap=0.4,
def _fraction(pair: list[int]) -> Fraction:
    return Fraction(pair[0], pair[1])


def _calibration() -> pilot.PilotCalibration:
    payload = json.loads(CALIBRATION_PATH.read_text())
    return pilot.PilotCalibration(
        eta_ref=_fraction(payload["eta_ref"]),
        lambda_bits_per_j=_fraction(payload["lambda_bits_per_j"]),
        kappa_bits_per_user_step=_fraction(payload["kappa_bits_per_user_step"]),
        bits_ref=_fraction(payload["bits_ref"]),
        joules_ref=_fraction(payload["joules_ref"]),
        users=int(payload["users"]),
    )


@dataclass(frozen=True)
class ExactRow:
    anchor: int
    user_id: int
    action: tuple[int, int] | None
    q1: tuple[float, ...]
    q2: tuple[float, ...]
    c1_structure: tuple[float, ...]
    c2_structure: tuple[float, ...]
    c1_admissible: tuple[float, ...]
    c2_admissible: tuple[float, ...]
    c1_target: float
    c2_target: float
    c1_target_exact: str
    c2_target_exact: str


def _f(value: Fraction) -> float:
    return float(value)


def _relabel_anchor(
    tape,
    calibration,
    anchor_index: int,
        "validity_affected_rows": validity_affected_rows,
        "validity_offset_mismatches": validity_offset_mismatches,
        "survival_offset_mismatches": survival_offset_mismatches,
        "stored_survival_vs_exact_absorbing_mask_offset_mismatches": absorbing_mask_mismatches,
        "by_anchor": {str(key): value for key, value in by_anchor.items()},
    }


def explainability(anchor_count: int) -> dict[str, object]:
    if anchor_count < 12 or anchor_count > 90 or anchor_count % len(REFERENCE_CARRIERS):
        raise ValueError("anchor_count must be an even integer in [12, 90]")
    anchor_indices = tuple(range(anchor_count))
    max_step = max(index // len(REFERENCE_CARRIERS) for index in anchor_indices)
    tape = build_world_tape(
        domain=DEVELOPMENT_WORLD_DOMAINS[0],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=max_step + 4,
        start_time_s=0.0,
    )
    calibration = _calibration()
    rows = []
    for anchor_index in anchor_indices:
        rows.extend(_relabel_anchor(tape, calibration, anchor_index))
        print(
            json.dumps(
                {"phase": "exact-relabel", "anchor": anchor_index, "rows": len(rows)}
            ),
            file=sys.stderr,
            flush=True,
        )
    # Both carrier views of one physical step can have byte-identical Q rows.
    # Split by step, not by source shard, so those aliases cannot leak between
    # fitting, model-selection, and held-out sets.
    rng = np.random.default_rng(20260909)
    step_count = anchor_count // len(REFERENCE_CARRIERS)
    shuffled_steps = list(range(step_count))
    rng.shuffle(shuffled_steps)
    test_step_count = max(1, step_count // 4)
    validation_step_count = max(1, step_count // 6)
    test_steps = set(shuffled_steps[:test_step_count])
    validation_steps = set(
        shuffled_steps[test_step_count : test_step_count + validation_step_count]
    )
    train_steps = set(shuffled_steps[test_step_count + validation_step_count :])

    def anchors_for(steps: set[int]) -> set[int]:
        return {
            step * len(REFERENCE_CARRIERS) + carrier
            for step in steps
            for carrier in range(len(REFERENCE_CARRIERS))
        }

    train = anchors_for(train_steps)

