+        nominal = engine.StepEvaluator(tape, setting, step_index, transition_from=incumbent, field="nominal", run_setting=run_setting)
+        proposal_config = config(proposals[arm])
+        begin = time.perf_counter()
+        nominal.evaluate_many((proposal_config,))
+        rec.setdefault("proposal_validation_s", {})[arm] = time.perf_counter() - begin
+        legal = proposal_config.configuration_id not in nominal._invalid
+        rec.setdefault("proposal_joint_physics_valid", {})[arm] = legal
+        if not legal:
+            # No invented repair support or changed feasibility rule.
+            rec["not_reached"] = "Invalid independent proposal; production repair catalogue assembly is not implemented."
+            break
