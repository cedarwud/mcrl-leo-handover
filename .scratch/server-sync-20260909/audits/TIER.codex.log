+        assert physical.physical_evaluations == before
+        rec["realised_cost_sample"] = {"profiles": len(sample), "valid": len(valid), "boundaries_per_profile": len(physical.boundary_indices), "cold_seconds": cold, "warm_seconds": warm, "cold_boundary_evaluations": before, "warm_additional_boundary_evaluations": physical.physical_evaluations - before}
