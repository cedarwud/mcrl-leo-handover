+        rec.setdefault("catalogues", {})[arm] = {"count": len(catalogue), "seconds": time.perf_counter() - begin, "boundary_evaluations": counter.boundary_evaluations, "mode": census["catalogue_mode"], "seed_assignment_sha256": digest(seed_config.assignments)}
