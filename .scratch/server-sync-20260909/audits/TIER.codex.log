+assert len({p["initialization_sha256"] for p in identities.values()}) == 1
+head_equalities = {arm: {route: payloads[arm][route] == payloads["FULL"][route] for route in ("C1", "C2", "C3")} for arm in models}
+print(json.dumps({"phase": "loaded_retained_checkpoints", "head_equalities_to_full": head_equalities}), flush=True)
+
+calp = json.loads((ART / "PILOT_NOT_CLAIM-calibration.json").read_text())
+calibration = SimpleNamespace(eta_ref=Fraction(*calp["eta_ref"]), kappa_bits_per_user_step=Fraction(*calp["kappa_bits_per_user_step"]))
