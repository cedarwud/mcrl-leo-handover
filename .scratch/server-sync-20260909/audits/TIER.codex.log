   473	def _selection_shortlist(
   474	    tape: ExogenousWorldTape,
   475	    step_index: int,
   476	    *,
   477	    run_setting: SealedRunSetting,
   478	) -> tuple[dict[int, tuple[tuple[int, int], ...]], dict[str, object]]:
   479	    """Top eight live actions by decision-instant nominal link margin."""
   480	
   481	    options, census = _legal_options(tape, step_index)
   482	    step = tape.steps[step_index]
   483	    ranked: dict[int, tuple[tuple[int, int], ...]] = {}
   484	    excluded_margins: list[float] = []
   485	    if step.arrays is not None:
   486	        arrays = step.arrays
   487	        row_of = arrays._row_index()
   488	        noise = noise_power_w(500_000_000.0)
   489	        for user, identities in options.items():
   490	            rows = []
   491	            for identity in identities:
   492	                row = row_of[(user, identity)]
   493	                sinr = BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) / noise
   494	                margin = 10.0 * math.log10(max(sinr, np.finfo(float).tiny)) - SINR_MIN_DB
   495	                rows.append((margin, identity))
   496	            ordered = sorted(rows, key=lambda item: (-item[0], item[1]))
   497	            ranked[user] = tuple(identity for _margin, identity in ordered[:SHORTLIST_OPTIONS_PER_USER])
   498	            excluded_margins.extend(margin for margin, _identity in ordered[SHORTLIST_OPTIONS_PER_USER:])
   499	    else:
   500	        first = step.boundaries[0]
   501	        by_key = {(row.user_id, row.identity): row for row in first.candidates}
   502	        noise = noise_power_w(500_000_000.0)
   503	        for user, identities in options.items():
   504	            rows = []
   505	            for identity in identities:
   506	                candidate = by_key[(user, identity)]
   507	                sinr = BEAM_RF_CAP_W * candidate.nominal_gain / noise
   508	                margin = 10.0 * math.log10(max(sinr, np.finfo(float).tiny)) - SINR_MIN_DB
   509	                rows.append((margin, identity))
   510	            ordered = sorted(rows, key=lambda item: (-item[0], item[1]))
   511	            ranked[user] = tuple(identity for _margin, identity in ordered[:SHORTLIST_OPTIONS_PER_USER])
   512	            excluded_margins.extend(margin for margin, _identity in ordered[SHORTLIST_OPTIONS_PER_USER:])
   513	    kept = sum(len(rows) for rows in ranked.values())
   514	    total = sum(len(rows) for rows in options.values())
   515	    return ranked, {
   516	        **census,
   517	        "selection_shortlist_per_user": SHORTLIST_OPTIONS_PER_USER,
   518	        "selection_shortlist_count": kept,
   519	        "legal_options_outside_selection_shortlist": total - kept,
   520	        "best_excluded_nominal_margin_db": (
   521	            None if not excluded_margins else max(excluded_margins)
   522	        ),
   523	        "shortlist_superset_miss_count": census["candidate_shortlist_miss_count"],
   524	    }
