  1026	def build_world_tape(
  1027	    *,
  1028	    domain: str,
  1029	    provider: PrimitiveWorldProvider,
  1030	    steps: int,
  1031	    start_time_s: float,
  1032	) -> ExogenousWorldTape:
  1033	    """Detach a provider into one immutable common-random-number TRAIN tape."""
  1034	
  1035	    if domain not in (
  1036	        PROBE_WORLD_DOMAINS
  1037	        + CALIBRATION_WORLD_DOMAINS
  1038	        + DEVELOPMENT_WORLD_DOMAINS
  1039	        + KAT_WORLD_DOMAINS
  1040	        + SYNTHETIC_WORLD_DOMAINS
  1041	        + SMOKE_WORLD_DOMAINS
  1042	    ):
  1043	        raise MCRLContractError("world domain is outside the declared V025 TRAIN inventories")
  1044	    if type(steps) is not int or steps < 1 or not math.isfinite(start_time_s):
  1045	        raise MCRLContractError("steps and start time are invalid")
  1046	    seed = seed_from_domain(domain)
  1047	    protocol = provider.protocol_outputs(world_seed=seed)
  1048	    # This call is deliberately first: hardware exists before candidates/actions.
  1049	    inventory = HardwareInventory.fixed(provider.inventory(world_seed=seed))
  1050	    tle_date, training_seed = provider.cluster_identity(world_seed=seed)
  1051	    layout = tuple(sorted(provider.user_layout(world_seed=seed), key=lambda row: row.user_id))
  1052	    if not layout or len({row.user_id for row in layout}) != len(layout):
  1053	        raise MCRLContractError("user layout must be nonempty with unique identities")
  1054	    step_rows = []
  1055	    array_builder = getattr(provider, "step_arrays", None)
  1056	    for step_index in range(steps):
  1057	        step_start = start_time_s + step_index * DECISION_INTERVAL_S
  1058	        if callable(array_builder):
  1059	            arrays = array_builder(
  1060	                world_seed=seed,
  1061	                step_index=step_index,
  1062	                start_time_s=start_time_s,
  1063	            )
  1064	            step_rows.append(
  1065	                StepTape(
  1066	                    step_index,
  1067	                    step_index % IDENTITY_REFRESH_DECISIONS,
  1068	                    arrays=arrays,
  1069	                )
  1070	            )
  1071	        else:
  1072	            boundaries = tuple(
  1073	                provider.boundary(
  1074	                    world_seed=seed,
  1075	                    step_index=step_index,
  1076	                    boundary_index=boundary_index,
  1077	                    absolute_time_s=step_start + boundary_index * D2_MEASUREMENT_STEP_S,
  1078	                )
  1079	                for boundary_index in range(D2_SUBINTERVALS + 1)
  1080	            )
  1081	            step_rows.append(
  1082	                StepTape(step_index, step_index % IDENTITY_REFRESH_DECISIONS, boundaries)
  1083	            )
  1084	    users = tuple(row.user_id for row in layout)
  1085	    carriers = fixed_carrier_actions(domain=domain, steps=step_rows, users=users)
  1086	    manifest_digest_builder = getattr(provider, "manifest_input_digest", None)
  1087	    generating_input_digest = (
  1088	        manifest_digest_builder(world_seed=seed)
  1089	        if callable(manifest_digest_builder)
