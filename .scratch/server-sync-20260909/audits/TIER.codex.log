+        arrays("adam_first_moment_biases_hex"), arrays("adam_second_moment_biases_hex"),
+        payload["activation"], opt["learning_rate"], *opt["betas"], opt["epsilon"],
+        opt["weight_decay"], payload["gauge_beta"], payload["loss_weight"], payload["adam_step"],
+    )
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
+
+
+started = time.perf_counter()
