   729	def world_plan_worker(plan: tuple[int, ...], deadline: float) -> list[dict[str, object]]:
   730	    assert_runtime()
   730	    assert_runtime()
   731	    if _SHARED_WORLD is None:
   732	        raise RuntimeError("shared world was not prepared before fork")
   733	    pilot, tape, setting, run_setting, calibration, world_index, tape_wall, off_axis = _SHARED_WORLD
   734	    if tuple(pilot.ENGINE.REFERENCE_CARRIERS) != CARRIERS:
   735	        raise AssertionError("carrier order drifted")
   736	    records = []
   737	    for global_index in plan:
   738	        if time.time() + 120.0 >= deadline:
   739	            break
   740	        within = global_index - world_index * ANCHORS_PER_WORLD
   741	        step_index, carrier_index = divmod(within, len(CARRIERS))
   742	        record = build_anchor(
   743	            pilot,
   744	            tape=tape,
   745	            setting=setting,
   746	            run_setting=run_setting,
   747	            calibration=calibration,
   748	            world_index=world_index,
   749	            step_index=step_index,
   750	            carrier_index=carrier_index,
   751	            global_index=global_index,
   752	            off_axis=off_axis,
   753	        )
   754	        record["worker_tape_build_wall_s"] = tape_wall
   755	        records.append(record)
   756	        print(
   757	            f"anchor {global_index + 1}/{TOTAL_ANCHORS}, peak RSS "
   758	            f"{int(record['peak_rss_bytes']) / 2**30:.3f} GiB "
   759	            + json.dumps(
   760	                {
   761	                    "phase": "exact-source-build",
   762	                    "completed_global_anchor": global_index,
   763	                    "world": world_index + 1,
   764	                    "step": step_index,
   765	                    "carrier": CARRIERS[carrier_index],
   766	                    "rows": record["row_count"],
   767	                    "wall_s": round(float(record["build_wall_s"]), 3),
   768	                }
   769	            ),
   770	            flush=True,
   771	        )
   772	        gc.collect()
   773	    return records
   774	
