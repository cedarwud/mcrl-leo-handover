  1801	    scored = []
  1802	    for config in catalog:
  1803	        bonus = Fraction()
  1804	        for user, identity in config.assignments:
  1805	            if identity == base_map[user]:
  1806	                continue
  1807	            bonus += sum((factors[name].get((user, identity), Fraction()) for name in include), Fraction())
