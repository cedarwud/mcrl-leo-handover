   106	def _restore_models(pilot):
   107	    models = {}
   108	    sources = {}
   109	    for arm in ARMS:
   110	        path = CHECKPOINT_ROOT / (
   111	            f"PILOT_NOT_CLAIM-seed-{SEED}-{arm}-epoch-{EPOCH:04d}.json"
   112	        )
   113	        checkpoint = json.loads(path.read_text(encoding="ascii"))
   114	        if (
   115	            checkpoint.get("learner_seed") != SEED
   116	            or checkpoint.get("arm") != arm
   117	            or checkpoint.get("completed_source_epochs") != EPOCH
   118	        ):
   119	            raise RuntimeError(f"checkpoint identity drifted: {path}")
   120	        payload = checkpoint["model"]
   121	        q1 = _restore_head(pilot, payload["C1"])
   122	        q2 = _restore_head(pilot, payload["C2"])
   123	        # The archived pilot checkpoint predates the deployed 240-wide
   124	        # coalition invariant (it is 117-wide).  Forward-pass latency depends
   125	        # on shape, not learned values, so use a deterministic synthetic head
   126	        # with the deployed input width and the same 64x64 hidden architecture.
   127	        archived_c3 = _restore_head(pilot, payload["C3"])
   128	        output_widths = [int(weights.shape[1]) for weights in archived_c3.weights]
   129	        widths = (DEPLOYED_C3_INPUT_DIM, *output_widths)
   130	        arm_seed = int.from_bytes(hashlib.sha256(arm.encode("ascii")).digest()[:8], "big")
   131	        rng = np.random.default_rng(SEED ^ arm_seed)
   132	        weights = [
   133	            rng.normal(0.0, np.sqrt(2.0 / max(1, left)), (left, right))
   134	            for left, right in zip(widths[:-1], widths[1:], strict=True)
   135	        ]
   136	        biases = [np.zeros(right, dtype=np.float64) for right in widths[1:]]
   137	        c3_network = AdamMLPHead(
   138	            weights=weights,
   139	            biases=biases,
   140	            first_moment_w=[np.zeros_like(value) for value in weights],
   141	            second_moment_w=[np.zeros_like(value) for value in weights],
   142	            first_moment_b=[np.zeros_like(value) for value in biases],
   143	            second_moment_b=[np.zeros_like(value) for value in biases],
   144	            activation=archived_c3.activation,
   145	            learning_rate=archived_c3.learning_rate,
   146	            beta1=archived_c3.beta1,
   147	            beta2=archived_c3.beta2,
   148	            epsilon=archived_c3.epsilon,
   149	            weight_decay=archived_c3.weight_decay,
   150	            gauge_beta=archived_c3.gauge_beta,
   151	            loss_weight=archived_c3.loss_weight,
   152	            adam_step=0,
   153	        )
   154	        psi = AdamSetInteractionHead(
   155	            c3_network, int(payload["C3"]["member_width"])
   156	        )
   157	        models[arm] = V1ThreeRouteModel(q1=q1, q2=q2, psi=psi)
   158	        sources[arm] = {
   159	            "path": str(path.relative_to(REPO)),
   160	            "sha256": _sha256(path),
   161	            "kind": {
   162	                route: payload[route]["kind"] for route in ("C1", "C2", "C3")
   163	            },
   164	            "weight_shapes": {
   165	                route: [list(array.shape) for array in model_head.weights]
   166	                for route, model_head in (
   167	                    ("C1", q1), ("C2", q2), ("C3", c3_network)
   168	                )
   169	            },
   170	            "route_sources": {
   171	                "C1": "epoch-2000 checkpoint",
   172	                "C2": "epoch-2000 checkpoint",
   173	                "C3": "deterministic untrained synthetic head of deployed shape",
   174	            },
   175	            "archived_c3_checkpoint_weight_shapes": [
   176	                list(array.shape) for array in archived_c3.weights
   177	            ],
   178	            "c3_synthetic_reason": (
   179	                "archived C3 checkpoint input width 117 does not match the current "
   180	                "deployed CoalitionContext invariant width 240"
   181	            ),
   182	            "c3_synthetic_rng_seed": SEED ^ arm_seed,
   183	        }
   184	    return models, sources
