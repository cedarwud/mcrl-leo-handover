   484	def main() -> int:
   485	    required = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
   486	    if any(os.environ.get(name) != "1" for name in required):
   487	        raise RuntimeError("all BLAS/OpenMP thread variables must equal 1")
   488	    nice_value = os.getpriority(os.PRIO_PROCESS, 0)
   489	    if nice_value < 15:
   490	        raise RuntimeError(f"niceness {nice_value} is below required 15")
   491	
   492	    load_start = list(os.getloadavg())
   493	    pilot = _load_pilot()
   494	    calibration = _calibration(pilot)
   495	    models, checkpoint_sources = _restore_models(pilot)
   496	    tapes, tape_rows = _load_or_build_tapes(pilot)
   497	    expected = _anytime_rows()
   498	    anchors = []
   499	    for world_index in range(1, 5):
   500	        tape = tapes[world_index]
   501	        for step_index in STEPS:
   502	            anchor_id = f"{tape.domain}:step/{step_index}"
   503	            anchors.append(
   504	                _benchmark_anchor(
   505	                    pilot,
   506	                    models,
   507	                    calibration,
   508	                    tape,
   509	                    world_index,
   510	                    step_index,
   511	                    expected[anchor_id],
   512	                )
   513	            )
   514	
   515	    stage_names = tuple(anchors[0]["stage_seconds"])
   516	    peak_rss_mib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0
   517	    payload = {
   518	        "schema": "mcrl-v025-selector-latency-diagnostic-v1",
   519	        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
   520	        "panel": "FULL20",
   850	            user_id=user,
   851	            reference_action=_physical_action(anchor.mapping[user]),
   852	            selected_action=_physical_action(selected.mapping[user]),
   853	            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
   854	            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
   855	            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
   856	        )
   857	        for user in changed
   858	    )
   859	    affected = sorted(
   860	        {
   861	            identity
   862	            for user in changed
   863	            for identity in (anchor.mapping[user], selected.mapping[user])
   864	            if identity is not None
   865	        }
   866	    )
   867	    before_counts: dict[tuple[int, int], int] = {}
   868	    after_counts: dict[tuple[int, int], int] = {}
   869	    for identity in anchor.mapping.values():
   870	        if identity is not None:
   871	            before_counts[identity] = before_counts.get(identity, 0) + 1
   872	    for identity in selected.mapping.values():
   873	        if identity is not None:
   874	            after_counts[identity] = after_counts.get(identity, 0) + 1
   875	    relations = _cross_gain_terms(tape, step_index, affected)
   876	    beams = tuple(
   877	        AffectedBeamContext(
   878	            beam_key=f"{identity[0]}:{identity[1]}",
   879	            occupancy_before=before_counts.get(identity, 0),
   880	            occupancy_after=after_counts.get(identity, 0),
   881	            active_before=before_counts.get(identity, 0) > 0,
   882	            active_after=after_counts.get(identity, 0) > 0,
   883	            shared_capacity=1.0,
   884	            interference_summary=math.fsum(
   885	                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
   886	            ),
   887	            capacity_margin=float(10 - after_counts.get(identity, 0)),
   888	        )
   889	        for identity in affected
   890	    )
   891	    return CoalitionContext(
   892	        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
   893	        reference_profile=tuple(
   894	            (user, _physical_action(identity)) for user, identity in anchor.assignments
   895	        ),
   896	        members=members,
   897	        affected_beams=beams,
   898	        global_resource_features=(
   899	            len(changed) / max(1, len(anchor.assignments)),
   900	            len(affected) / max(1, len(anchor.assignments)),
   901	            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
   902	            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
   903	            math.fsum(gain for _source, _target, gain in relations),
   904	            max((gain for _source, _target, gain in relations), default=0.0),
   905	        ),
   906	        pairwise_cross_gain_terms=relations,
   907	    )
