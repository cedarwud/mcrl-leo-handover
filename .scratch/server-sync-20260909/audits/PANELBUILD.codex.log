   605	        "all_knockout_pooled_ee_bits_per_j": knockout_pool["pooled_ee_bits_per_j"],
   606	        "pooled_ee_difference_bits_per_j": (
   607	            pools["ALL_NEUTRAL_CONTROL"]["pooled_ee_bits_per_j"] - knockout_pool["pooled_ee_bits_per_j"]
   608	        ),
   609	        "coincide_at_every_anchor": not differing,
   610	    }
   611	    axis_a_rows = []
   612	    neutral = pools["ALL_NEUTRAL_CONTROL"]
   613	    for arm in ARMS:
   614	        reference = {
   615	            "name": "ALL_NEUTRAL_CONTROL" if arm != "ALL_NEUTRAL_CONTROL" else "self",
   616	            "construction": (
