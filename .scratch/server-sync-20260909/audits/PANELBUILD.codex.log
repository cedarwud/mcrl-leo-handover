   854	def correlation(first: list[float], second: list[float]) -> float:
   855	    mean_first = statistics.fmean(first)
   856	    mean_second = statistics.fmean(second)
   857	    numerator = math.fsum(
   858	        (left - mean_first) * (right - mean_second)
   859	        for left, right in zip(first, second, strict=True)
   860	    )
   861	    denominator = math.sqrt(
   862	        math.fsum((value - mean_first) ** 2 for value in first)
   863	        * math.fsum((value - mean_second) ** 2 for value in second)
   864	    )
   865	    return numerator / denominator
