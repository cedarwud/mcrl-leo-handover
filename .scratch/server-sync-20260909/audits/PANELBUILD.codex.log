   490	def _profile_score(model: Mapping[str, Head], profile: Mapping[str, object], knockout_all: bool = False) -> float:
   491	    if knockout_all:
   492	        return 0.0
   493	    total = 0.0
   494	    for route in ("C1", "C2"):
   495	        for pair in profile[route]:
   496	            total += model[route].score(pair["selected"]) - model[route].score(pair["reference"])
   497	    c3 = profile["C3"]
   498	    if c3["coalition_size"] > 1:
   499	        total += model["C3"].score(c3["invariant_state"])
   500	    return total
   501	
   502	
   503	def _select(model: Mapping[str, Head], profiles: Sequence[Mapping[str, object]], *, knockout_all: bool = False) -> Mapping[str, object]:
   504	    best = profiles[0]
   505	    best_score = _profile_score(model, best, knockout_all=knockout_all)
   506	    for profile in profiles[1:]:
   507	        score = _profile_score(model, profile, knockout_all=knockout_all)
   508	        if score > best_score:
   509	            best, best_score = profile, score
   510	    return best
