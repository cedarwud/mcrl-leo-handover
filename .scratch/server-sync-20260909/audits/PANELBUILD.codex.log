   683	            "completed_source_epochs": checkpoint["completed_source_epochs"],
   684	            "learner_seed": checkpoint["learner_seed"],
   685	            "coordinator_budget_s": panel["budget_s"],
   686	            "arm_pooled_ee_bits_per_j": pools[arm]["pooled_ee_bits_per_j"],
   687	            "certified_fixed_point_pooled_ee_bits_per_j": fixed_ee,
