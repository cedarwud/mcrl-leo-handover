   287	def _validate_outcome(value: object, field: str) -> dict[str, float | int]:
   288	    outcome = _require_object(value, field)
   289	    if set(outcome) != set(OUTCOME_FIELDS):
   290	        raise ScorerContractError(f"{field} outcome field inventory drifted")
   291	    result: dict[str, float | int] = {
   292	        "full_buffer_bits": _finite_number(outcome["full_buffer_bits"], f"{field}.full_buffer_bits", nonnegative=True),
   293	        "joules": _finite_number(outcome["joules"], f"{field}.joules", nonnegative=True),
   294	    }
   295	    if result["joules"] <= 0.0:
   296	        raise ScorerContractError(f"{field}.joules must be positive")
   297	    for name in OUTCOME_FIELDS[2:]:
   298	        result[name] = _count(outcome[name], f"{field}.{name}")
   299	    for numerator, denominator in (
   300	        ("rate_target_attained", "rate_target_opportunities"),
   301	        ("service_available", "service_opportunities"),
   302	        ("handovers", "handover_opportunities"),
   303	        ("deadline_misses", "decisions"),
   304	    ):
   305	        if result[numerator] > result[denominator]:
   306	            raise ScorerContractError(f"{field}.{numerator} exceeds {denominator}")
   307	    return result
