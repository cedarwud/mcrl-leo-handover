    68	        np.asarray(
    69	            [[float.fromhex(value) for value in row] for row in array]
    70	            if array and isinstance(array[0], list)
    71	            else [float.fromhex(value) for value in array],
    72	            dtype=np.float64,
    73	        )
    74	        for array in rows
    75	    ]
