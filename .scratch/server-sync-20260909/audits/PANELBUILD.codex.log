    78	def _restore_head(pilot, payload: Mapping[str, object]):
    79	    weights = _decode_arrays(payload["weights_hex"])
    80	    biases = _decode_arrays(payload["biases_hex"])
    81	    first_w = _decode_arrays(payload["adam_first_moment_weights_hex"])
    82	    second_w = _decode_arrays(payload["adam_second_moment_weights_hex"])
    83	    first_b = _decode_arrays(payload["adam_first_moment_biases_hex"])
    84	    second_b = _decode_arrays(payload["adam_second_moment_biases_hex"])
    85	    optimizer = payload["optimizer"]
    86	    betas = optimizer["betas"]
    87	    return AdamMLPHead(
    88	        weights=weights,
    89	        biases=biases,
    90	        first_moment_w=first_w,
    91	        second_moment_w=second_w,
    92	        first_moment_b=first_b,
    93	        second_moment_b=second_b,
    94	        activation=str(payload["activation"]),
    95	        learning_rate=float(optimizer["learning_rate"]),
    96	        beta1=float(betas[0]),
    97	        beta2=float(betas[1]),
    98	        epsilon=float(optimizer["epsilon"]),
    99	        weight_decay=float(optimizer["weight_decay"]),
   100	        gauge_beta=float(payload["gauge_beta"]),
   101	        loss_weight=float(payload["loss_weight"]),
   102	        adam_step=int(payload["adam_step"]),
   103	    )
   104	
