   289	def _benchmark_anchor(pilot, models, calibration, tape, world_index, step_index, expected_base):
   290	    anchor_id = f"{tape.domain}:step/{step_index}"
   291	    setting = pilot.ENGINE._setting("a-r0")
   292	    run_setting = pilot.ENGINE.run_setting_for("a-r0")
   293	    all_started = time.perf_counter()
   294	
   295	    started = time.perf_counter()
   296	    built = pilot._build_anchor_rows(
   297	        tape=tape,
   298	        setting=setting,
   299	        run_setting=run_setting,
   300	        calibration=calibration,
   301	        step_index=step_index,
   302	        carrier="nearest-eligible",
   303	        anchor_index=(world_index - 1) * len(STEPS) + step_index,
   304	        include_coalition=False,
   305	        full_legal_actions=True,
   306	    )
   307	    feature_s = time.perf_counter() - started
   308	    base = built["base"]
   309	    incumbent = built["incumbent"]
   310	    action_rows = built["rows_by_user_action"]
   311	    if _canonical_assignments(base.assignments) != expected_base:
   312	        raise RuntimeError(f"{anchor_id}: base assignments differ from anytime panel")
   313	
   314	    started = time.perf_counter()
   315	    catalogue, census = pilot.ENGINE._catalogue_with_census(
   316	        tape,
   317	        step_index,
   318	        base,
   319	        setting=setting,
   320	        calibration=calibration,
   321	        run_setting=run_setting,
   322	    )
   323	    catalogue_s = time.perf_counter() - started
   324	
   325	    started = time.perf_counter()
   326	    legal_catalogue = list(catalogue)
   327	    context_eligible = tuple(row for row in legal_catalogue if row.changed_users >= 2)
   328	    eligibility_s = time.perf_counter() - started
   329	
   330	    started = time.perf_counter()
   331	    contexts = {
   332	        config.configuration_id: pilot._coalition_context(
   333	            tape=tape,
   334	            step_index=step_index,
   335	            anchor=base,
   336	            selected=config,
   337	            rows_by_user_action=action_rows,
   338	        )
   339	        for config in context_eligible
   340	    }
   341	    contexts_s = time.perf_counter() - started
   342	    if contexts:
   343	        observed_widths = {
   344	            len(context.invariant_vector(member_width=models["FULL"].psi.member_width))
   345	            for context in contexts.values()
   346	        }
   347	        if observed_widths != {DEPLOYED_C3_INPUT_DIM}:
   348	            raise RuntimeError(
   349	                f"{anchor_id}: deployed C3 invariant widths {sorted(observed_widths)} "
   350	                f"!= {DEPLOYED_C3_INPUT_DIM}"
   351	            )
   352	
   353	    started = time.perf_counter()
   354	    deltas_by_arm = {}
   355	    for arm in ARMS:
   356	        model = models[arm]
   357	        deltas = {}
   358	        for (user, action), row in action_rows.items():
   359	            reference = action_rows[(user, base.mapping[user])]
   360	            q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
   361	            deltas[(user, action)] = (
   362	                model.q1.score(row.q1_state)
   363	                - model.q1.score(reference.q1_state)
   364	                + q2_delta
   365	            )
   366	        deltas_by_arm[arm] = deltas
   367	    action_head_s = time.perf_counter() - started
   368	
   369	    started = time.perf_counter()
   370	    interactions = {arm: {} for arm in ARMS}
   371	    for config in legal_catalogue:
   372	        context = contexts.get(config.configuration_id)
   373	        if context is not None:
   374	            for arm in ARMS:
   375	                interactions[arm][config.configuration_id] = models[arm].interaction(context)
   376	    interaction_head_s = time.perf_counter() - started
   377	
   378	    started = time.perf_counter()
   379	    scores = {arm: [] for arm in ARMS}
   380	    for config in legal_catalogue:
   381	        for arm in ARMS:
   382	            score = math.fsum(
   383	                deltas_by_arm[arm][(user, config.mapping[user])]
   384	                for user in base.mapping
   385	            )
   386	            score += interactions[arm].get(config.configuration_id, 0.0)
   387	            scores[arm].append((score, config.configuration_id, config))
   388	    score_assembly_s = time.perf_counter() - started
   389	
   390	    started = time.perf_counter()
   391	    selections = {
   392	        arm: min(scores[arm], key=lambda row: (-row[0], row[1]))[2]
   393	        for arm in ARMS
   394	    }
   395	    argmax_s = time.perf_counter() - started
   396	
   397	    started = time.perf_counter()
   398	    realised = pilot.ENGINE.StepEvaluator(
   399	        tape,
   400	        setting,
   401	        step_index,
   402	        transition_from=incumbent,
   403	        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
   404	        field="realised",
   405	        run_setting=run_setting,
   406	    )
   407	    unique_selected = tuple(
   408	        {row.assignments: row for row in selections.values()}.values()
   409	    )
   410	    realised.evaluate_many(unique_selected)
   411	    committed_profiles = {
   412	        arm: realised.evaluate(config) for arm, config in selections.items()
   413	    }
   414	    committed_evaluation_s = time.perf_counter() - started
   415	
   416	    started = time.perf_counter()
   417	    commit_rows = {
   418	        arm: {
   419	            "configuration_id": selections[arm].configuration_id,
   420	            "changed_users": selections[arm].changed_users,
   421	            "bits": committed_profiles[arm].bits,
   422	            "joules": committed_profiles[arm].joules,
   423	        }
   424	        for arm in ARMS
   425	    }
   426	    commit_bookkeeping_s = time.perf_counter() - started
   427	
   428	    stage_seconds = {
   429	        "feature_and_action_row_construction": feature_s,
   430	        "catalogue_construction": catalogue_s,
   431	        "context_eligibility_filter": eligibility_s,
   432	        "coalition_context_construction": contexts_s,
   433	        "action_head_forward": action_head_s,
   434	        "interaction_head_forward": interaction_head_s,
   435	        "catalogue_score_assembly": score_assembly_s,
   436	        "stable_argmax": argmax_s,
   437	        "committed_physical_evaluation": committed_evaluation_s,
   438	        "commit_bookkeeping": commit_bookkeeping_s,
   439	    }
   440	    sum_stages = math.fsum(stage_seconds.values())
   441	    end_to_end_s = time.perf_counter() - all_started
   442	    unassigned_s = end_to_end_s - sum_stages
   443	    row = {
   444	        "anchor_id": anchor_id,
   445	        "world_index": world_index,
   446	        "step_index": step_index,
   447	        "catalogue_rows": len(legal_catalogue),
   448	        "catalogue_score_cells": len(legal_catalogue) * len(ARMS),
   449	        "action_rows": len(action_rows),
   450	        "action_head_scalar_forward_calls": len(action_rows) * len(ARMS) * 4,
   451	        "context_rows": len(contexts),
   452	        "context_missing_rows": len(legal_catalogue) - len(contexts),
   453	        "context_missing_fraction": (len(legal_catalogue) - len(contexts)) / len(legal_catalogue),
   454	        "interaction_head_forward_calls": len(contexts) * len(ARMS),
   455	        "unique_committed_configurations": len(unique_selected),
   456	        "committed_boundary_evaluations": realised.physical_evaluations,
   457	        "stage_seconds": stage_seconds,
   458	        "stage_sum_s": sum_stages,
   459	        "unassigned_wrapper_s": unassigned_s,
   460	        "end_to_end_s": end_to_end_s,
   461	        "over_10_s": end_to_end_s > 10.0,
   462	        "overrun_s": max(0.0, end_to_end_s - 10.0),
   463	        "commits": commit_rows,
   464	        "load_average": list(os.getloadavg()),
   465	    }
   466	    print(
   467	        json.dumps(
   468	            {
   469	                "event": "anchor_done",
   470	                "anchor": anchor_id,
   471	                "catalogue_rows": len(legal_catalogue),
   472	                "context_missing_fraction": row["context_missing_fraction"],
   473	                "stage_seconds": stage_seconds,
   474	                "end_to_end_s": end_to_end_s,
   475	                "load_average": row["load_average"],
   476	            },
   477	            sort_keys=True,
   478	        ),
   479	        flush=True,
   480	    )
   481	    return row
