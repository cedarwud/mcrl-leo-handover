   203	def _load_or_build_tapes(pilot):
   204	    TAPE_ROOT.mkdir(parents=True, exist_ok=True)
   205	    tapes = {}
   206	    rows = []
   207	    for world_index, domain in enumerate(WORLDS, start=1):
   208	        path = _tape_path(world_index)
   209	        started = time.perf_counter()
   210	        if path.is_file():
   211	            tape = pickle.loads(path.read_bytes())
   212	            source = "cache"
   213	        else:
   214	            tape = pilot.build_world_tape(
   215	                domain=domain,
   216	                provider=pilot.LegacyWorldProvider(role="selector-latency-diagnostic"),
   217	                steps=TAPE_STEPS,
   218	                start_time_s=0.0,
   219	            )
   220	            path.write_bytes(pickle.dumps(tape, protocol=pickle.HIGHEST_PROTOCOL))
   221	            source = "built"
   222	        elapsed = time.perf_counter() - started
   223	        if tape.domain != domain or len(tape.steps) != TAPE_STEPS:
   224	            raise RuntimeError(f"tape identity drifted for {domain}")
   225	        tapes[world_index] = tape
   226	        rows.append(
   227	            {
   228	                "world_index": world_index,
   229	                "domain": domain,
   230	                "source": source,
   231	                "load_or_build_wall_s": elapsed,
   232	                "pickle": str(path.relative_to(REPO)),
   233	                "pickle_sha256": _sha256(path),
   234	                "generating_input_digest": tape.generating_input_digest,
   235	            }
   236	        )
   237	        print(json.dumps({"event": "tape_ready", **rows[-1]}, sort_keys=True), flush=True)
   238	    return tapes, rows
