   540	        "information_class": identity["information_class"],
   541	        "estimand": estimand,
   542	        "numerator": identity["numerator"],
   543	        "energy_boundary": identity["energy_boundary"],
   544	        "panel_identity": {
   545	            "name": identity["name"], "anchors": identity["anchors"], "worlds": identity["worlds"],
