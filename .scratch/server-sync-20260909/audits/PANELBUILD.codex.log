  1790	def _set_select(
  1791	    *,
  1792	    catalog: Sequence[Configuration],
  1793	    evaluated: Mapping[str, EvaluatedProfile],
  1794	    factors: Mapping[str, Mapping[tuple[int, tuple[int, int] | None], Fraction]],
  1795	    include: Sequence[str],
  1796	    base: Configuration,
  1797	    calibration: CalibrationValues,
