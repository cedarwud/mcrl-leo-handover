   700	            "wall_clock_to_decision_mean_s": None if instrumentation_values is None else instrumentation_values["wall_clock_to_decision_mean_s"],
   701	            "wall_clock_to_decision_max_s": None if instrumentation_values is None else instrumentation_values["wall_clock_to_decision_max_s"],
