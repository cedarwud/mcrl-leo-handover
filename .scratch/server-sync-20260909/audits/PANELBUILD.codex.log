   256	def _thread_count() -> int | None:
   257	    try:
   258	        for line in Path("/proc/self/status").read_text(encoding="ascii").splitlines():
   259	            if line.startswith("Threads:"):
   260	                return int(line.split(":", 1)[1])
   261	    except OSError:
   262	        pass
   263	    return None
