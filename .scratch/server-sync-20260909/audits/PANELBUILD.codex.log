   259	    if any(len(values) != 1 for values in widths.values()):
   260	        raise ScorerContractError("model input widths differ across arms")
   261	    return {
   262	        "path": str(path.resolve()),
   263	        "sha256": _sha256(path),
   264	        "completed_source_epochs": completed,
   265	        "learner_seed": learner_seed,
   266	        "training_physics_digest": payload.get("training_physics_digest"),
