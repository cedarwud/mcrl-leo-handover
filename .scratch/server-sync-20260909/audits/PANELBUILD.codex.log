  1762	def _independent_proposal(
  1763	    *,
  1764	    base: Configuration,
  1765	    catalog: Sequence[Configuration],
  1766	    factors: Mapping[str, Mapping[tuple[int, tuple[int, int] | None], Fraction]],
  1767	    include: Sequence[str],
  1768	) -> Configuration:
  1769	    assignments = dict(base.assignments)
  1770	    for user in sorted(assignments):
  1771	        candidates = []
  1772	        for config in catalog:
  1773	            if config.changed_users != 1:
  1774	                continue
  1775	            identity = dict(config.assignments)[user]
  1776	            if identity == assignments[user]:
  1777	                continue
  1778	            score = sum((factors[name].get((user, identity), Fraction()) for name in include), Fraction())
  1779	            candidates.append((score, identity))
  1780	        if candidates:
  1781	            score, identity = min(candidates, key=lambda row: (-row[0], row[1]))
  1782	            if score > 0:
  1783	                assignments[user] = identity
  1784	    return next(
  1785	        (row for row in catalog if row.mapping == assignments),
  1786	        base,
  1787	    )
