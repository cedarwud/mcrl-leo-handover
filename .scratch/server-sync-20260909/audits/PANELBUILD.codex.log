   844	def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
   845	    changed = tuple(
   846	        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
   847	    )
   848	    members = tuple(
   849	        CoalitionMember(
   850	            user_id=user,
   851	            reference_action=_physical_action(anchor.mapping[user]),
   852	            selected_action=_physical_action(selected.mapping[user]),
   853	            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
   854	            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
   855	            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
   856	        )
   857	        for user in changed
   858	    )
   859	    affected = sorted(
   860	        {
   861	            identity
   862	            for user in changed
   863	            for identity in (anchor.mapping[user], selected.mapping[user])
   864	            if identity is not None
   865	        }
   866	    )
   867	    before_counts: dict[tuple[int, int], int] = {}
   868	    after_counts: dict[tuple[int, int], int] = {}
   869	    for identity in anchor.mapping.values():
   870	        if identity is not None:
   871	            before_counts[identity] = before_counts.get(identity, 0) + 1
   872	    for identity in selected.mapping.values():
   873	        if identity is not None:
   874	            after_counts[identity] = after_counts.get(identity, 0) + 1
   875	    relations = _cross_gain_terms(tape, step_index, affected)
   876	    beams = tuple(
   877	        AffectedBeamContext(
   878	            beam_key=f"{identity[0]}:{identity[1]}",
   879	            occupancy_before=before_counts.get(identity, 0),
   880	            occupancy_after=after_counts.get(identity, 0),
   881	            active_before=before_counts.get(identity, 0) > 0,
   882	            active_after=after_counts.get(identity, 0) > 0,
   883	            shared_capacity=1.0,
   884	            interference_summary=math.fsum(
   885	                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
   886	            ),
   887	            capacity_margin=float(10 - after_counts.get(identity, 0)),
   888	        )
   889	        for identity in affected
   890	    )
   891	    return CoalitionContext(
   892	        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
   893	        reference_profile=tuple(
   894	            (user, _physical_action(identity)) for user, identity in anchor.assignments
   895	        ),
   896	        members=members,
   897	        affected_beams=beams,
