   196	            "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
   197	            "pairwise_cross_gain_residual_sum_hex": float_hex(residual_sum),
   198	            "pairwise_cross_gain_terms": [
   199	                {
   200	                    "source_beam_key": source,
   201	                    "target_beam_key": target,
   202	                    "gain_hex": float_hex(gain),
   203	                }
   204	                for source, target, gain in self.pairwise_cross_gain_terms
   205	            ],
   206	        }
   207	
   208	    def _bounded_pairwise_cross_gain_terms(
   209	        self,
   210	    ) -> tuple[tuple[tuple[str, str, float], ...], float]:
   211	        """Top-K by magnitude, returned in canonical key order plus residual sum."""
   212	
   213	        ranked = sorted(
   214	            self.pairwise_cross_gain_terms,
   215	            key=lambda row: (-abs(row[2]), row[0], row[1]),
   216	        )
   217	        retained = tuple(
   218	            sorted(
   219	                ranked[:PAIRWISE_CROSS_GAIN_TOP_K],
   220	                key=lambda row: (row[0], row[1]),
   221	            )
   222	        )
   223	        residual_sum = math.fsum(row[2] for row in ranked[PAIRWISE_CROSS_GAIN_TOP_K:])
   224	        return retained, residual_sum
   225	
   226	    def pairwise_cross_gain_vector(self) -> np.ndarray:
   227	        """Fixed-width ordered pair block used by the interaction encoder."""
   228	
   229	        retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
   230	        block = np.zeros((PAIRWISE_CROSS_GAIN_TOP_K, 4), dtype=np.float64)
   231	        for index, (source, target, gain) in enumerate(retained):
   232	            block[index] = (
   233	                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
   234	                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
   235	                gain,
   236	                1.0,
   237	            )
   238	        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))
   239	
   240	    def invariant_vector(self, *, member_width: int) -> np.ndarray:
   241	        """DeepSets-style deterministic encoding; IDs/order are not features."""
   242	
   243	        if len(self.members) <= 1:
   244	            # Empty and singleton values are hard anchored by the head, but a
   245	            # stable vector remains useful for schema and KAT checks.
   246	            member_matrix = np.zeros((1, member_width), dtype=np.float64)
   247	        else:
   248	            member_matrix = np.asarray(
   249	                [member.invariant_features for member in self.members],
   250	                dtype=np.float64,
   251	            )
   252	            if member_matrix.shape[1] != member_width:
   253	                raise StageCContractError("coalition member feature width drifted")
   254	        beams = tuple(sorted(self.affected_beams, key=lambda beam: beam.beam_key))
   255	        beam_features = np.asarray([
   256	            [
   257	                beam.occupancy_before,
   258	                beam.occupancy_after,
   259	                float(beam.active_after) - float(beam.active_before),
   260	                beam.shared_capacity,
   261	                beam.interference_summary,
   262	                beam.capacity_margin,
   263	                1.0,
   264	            ]
   265	            for beam in beams
   266	        ], dtype=np.float64)
   267	        beam_pool = np.concatenate(
   268	            (
   269	                beam_features.sum(axis=0),
   270	                beam_features.max(axis=0),
   271	                beam_features.min(axis=0),
   272	                beam_features.mean(axis=0),
   273	            )
   274	        )
   275	        vector = np.concatenate(
   276	            (
   277	                np.asarray([float(len(self.members))], dtype=np.float64),
   278	                member_matrix.sum(axis=0),
   279	                member_matrix.max(axis=0),
   280	                beam_pool,
   281	                self.pairwise_cross_gain_vector(),
   282	                np.asarray(self.global_resource_features, dtype=np.float64),
   283	            )
   284	        )
   285	        if not np.isfinite(vector).all():
   286	            raise StageCContractError("coalition invariant encoding is non-finite")
   287	        return vector
   288	
   289	
   290	@dataclass(frozen=True, slots=True)
