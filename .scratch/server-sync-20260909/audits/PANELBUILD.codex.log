   109	def _write_bytes_once(path: Path, content: bytes) -> None:
   110	    if path.exists():
   111	        raise ScorerContractError(f"refusing to overwrite {path}")
   112	    path.parent.mkdir(parents=True, exist_ok=True)
   113	    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
   114	    with temporary.open("xb") as handle:
   115	        handle.write(content)
   116	        handle.flush()
   117	        os.fsync(handle.fileno())
   118	    temporary.replace(path)
