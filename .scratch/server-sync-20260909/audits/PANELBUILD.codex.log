   867	def _write_csv(path: Path, rows: Sequence[Mapping[str, object]]) -> None:
   868	    flat = _flatten(rows)
   869	    fields = []
   870	    for row in flat:
   871	        for key in row:
   872	            if key not in fields:
   873	                fields.append(key)
   874	    if path.exists():
   875	        raise ScorerContractError(f"refusing to overwrite {path}")
   876	    path.parent.mkdir(parents=True, exist_ok=True)
   877	    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
   878	    with temporary.open("x", encoding="utf-8", newline="") as handle:
   879	        writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="raise")
   880	        writer.writeheader()
   881	        writer.writerows(flat)
   882	        handle.flush()
   883	        os.fsync(handle.fileno())
   884	    temporary.replace(path)
