   805	def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
   806	    step = tape.steps[step_index]
   807	    if step.arrays is None:
   808	        return ()
   809	    arrays = step.arrays
   810	    cache_key = (tape.seed, step_index)
   811	    cached = _CROSS_GAIN_CACHE.get(cache_key)
   812	    if cached is None:
   813	        aggressors = {
   814	            tuple(int(value) for value in identity): index
   815	            for index, identity in enumerate(arrays.aggressor_identities)
   816	        }
   817	        victim_columns = {}
   818	        for row, identity in enumerate(arrays.identities.tolist()):
   819	            key = tuple(int(value) for value in identity)
   820	            victim_columns.setdefault(key, []).append(
   821	                int(arrays.row_user_column[row])
   822	            )
   823	        cached = (aggressors, victim_columns, {})
   824	        _CROSS_GAIN_CACHE[cache_key] = cached
   825	    aggressors, victim_columns, pair_cache = cached
   825	    aggressors, victim_columns, pair_cache = cached
   826	    result = []
   827	    for source, target in itertools.permutations(sorted(set(affected)), 2):
   828	        relation = (source, target)
   829	        gain = pair_cache.get(relation)
   830	        if gain is None:
   831	            column = aggressors.get(source)
   832	            gain = 0.0 if column is None else max(
   833	                (
   834	                    float(arrays.cross_base_nominal[0, user, column])
   835	                    for user in victim_columns.get(target, ())
   836	                ),
   837	                default=0.0,
   838	            )
   839	            pair_cache[relation] = gain
   840	        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
   841	    return tuple(result)
