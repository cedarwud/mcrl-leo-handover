   265	
   266	def _q(values: Sequence[float], fraction: float) -> float:
   267	    ordered = sorted(float(value) for value in values)
   268	    position = (len(ordered) - 1) * fraction
   269	    lower = math.floor(position)
   270	    upper = math.ceil(position)
   271	    if lower == upper:
   272	        return ordered[lower]
   273	    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)
   274	
   275	
   276	def _distribution(values: Sequence[float]) -> dict[str, float | int]:
   277	    rows = [float(value) for value in values]
   278	    return {
   279	        "count": len(rows),
   280	        "min": min(rows),
   281	        "q25": _q(rows, 0.25),
   282	        "median": statistics.median(rows),
   283	        "q75": _q(rows, 0.75),
   284	        "max": max(rows),
   285	        "mean": statistics.fmean(rows),
   286	    }
