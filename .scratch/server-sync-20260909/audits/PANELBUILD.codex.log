   838	def average_ranks(values: list[float]) -> list[float]:
   839	    order = sorted(range(len(values)), key=lambda index: (values[index], index))
   840	    ranks = [0.0] * len(values)
   841	    position = 0
   842	    while position < len(order):
   843	        end = position + 1
   844	        value = values[order[position]]
   845	        while end < len(order) and values[order[end]] == value:
   846	            end += 1
   847	        rank = (position + 1 + end) / 2.0
   848	        for index in order[position:end]:
   849	            ranks[index] = rank
   850	        position = end
   851	    return ranks
