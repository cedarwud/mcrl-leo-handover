    80	def tree_digest(root: Path) -> str:
    81	    digest = hashlib.sha256()
    82	    for path in sorted(row for row in root.rglob("*") if row.is_file()):
    83	        relative = path.relative_to(root).as_posix().encode("utf-8")
    84	        digest.update(len(relative).to_bytes(8, "big"))
    85	        digest.update(relative)
    86	        digest.update(bytes.fromhex(sha256(path)))
    87	    return digest.hexdigest()
