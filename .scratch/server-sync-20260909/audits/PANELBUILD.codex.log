  1015	    result = {
  1016	        "schema": RESULT_SCHEMA,
  1017	        "scorer": str(Path(__file__).resolve()),
  1018	        "scorer_sha256": _sha256(Path(__file__)),
  1019	        "panel": {key: panel[key] for key in (
  1020	            "path", "sha256", "identity", "references", "instrumentation",
  1021	            "instrumentation_recorded", "synthetic_smoke_not_evidence",
