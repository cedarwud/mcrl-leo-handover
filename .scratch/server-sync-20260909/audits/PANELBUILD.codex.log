   310	def _validate_state_pairs(value: object, field: str, width: int) -> tuple[dict[str, tuple[float, ...]], ...]:
   311	    if not isinstance(value, list):
   312	        raise ScorerContractError(f"{field} must be an array")
   313	    pairs = []
   314	    for index, raw in enumerate(value):
   315	        pair = _require_object(raw, f"{field}[{index}]")
   316	        if set(pair) != {"reference", "selected"}:
   317	            raise ScorerContractError(f"{field}[{index}] must contain reference and selected")
   318	        decoded = {}
   319	        for side in ("reference", "selected"):
   320	            states = pair[side]
   321	            if not isinstance(states, list) or len(states) != width:
   322	                raise ScorerContractError(f"{field}[{index}].{side} width drifted")
   323	            decoded[side] = tuple(_finite_number(item, f"{field}[{index}].{side}") for item in states)
   324	        pairs.append(decoded)
   325	    return tuple(pairs)
