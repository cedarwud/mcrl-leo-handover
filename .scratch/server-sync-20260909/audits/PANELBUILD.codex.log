   264	@dataclass(slots=True)
   265	class LinearHead:
   266	    weights: np.ndarray
   267	    bias: float
   268	
   269	    def clone(self) -> "LinearHead":
   270	        return LinearHead(self.weights.copy(), float(self.bias))
   271	
   272	    def score(self, state: Sequence[float]) -> float:
   273	        values = np.asarray(state, dtype=np.float64)
   274	        if values.shape != self.weights.shape:
   275	            raise StageCContractError("learner state shape drifted")
   276	        return float(values @ self.weights + self.bias)
   277	
   278	    def update(self, batch: PairwiseBatch, *, learning_rate: float, gauge_weight: float) -> float:
   279	        # Pairwise fixed-target regression with a reference-zero gauge. No
   280	        # reward, next state, target network, discount, or bootstrap exists.
   281	        reference_q = batch.reference_states @ self.weights + self.bias
   282	        candidate_q = batch.candidate_states @ self.weights + self.bias
   283	        residual = candidate_q - reference_q - batch.target_deltas
   284	        count = float(batch.target_deltas.size)
   285	        gradient_w = (2.0 / count) * ((batch.candidate_states - batch.reference_states).T @ residual)
   286	        gradient_w += (2.0 * gauge_weight / count) * (batch.reference_states.T @ reference_q)
   287	        gradient_b = float((2.0 * gauge_weight / count) * reference_q.sum())
   288	        self.weights -= learning_rate * gradient_w
   289	        self.bias -= learning_rate * gradient_b
   290	        loss = float(np.mean(residual * residual) + gauge_weight * np.mean(reference_q * reference_q))
   291	        if not np.isfinite(self.weights).all() or not np.isfinite(self.bias) or not np.isfinite(loss):
   292	            raise StageCContractError("non-finite learner update")
   293	        return loss
