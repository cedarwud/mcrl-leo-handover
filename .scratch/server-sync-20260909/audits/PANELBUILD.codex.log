   239	        raise ScorerContractError(f"unsupported checkpoint schema in {path}")
   240	    if payload.get("source_map") != EXPECTED_SOURCE_MAP:
   241	        raise ScorerContractError("checkpoint does not contain the sealed five-arm source map")
   242	    arms = _require_object(payload.get("arms"), "checkpoint.arms")
   243	    if set(arms) != set(ARMS):
   244	        raise ScorerContractError("checkpoint arm inventory must be exactly the five sealed arms")
   245	    completed = _count(payload.get("completed_source_epochs"), "completed_source_epochs")
   246	    if completed == 0 or completed % 100:
   247	        raise ScorerContractError("checkpoint is not on the sealed 100-epoch cadence")
   248	    learner_seed = _count(payload.get("learner_seed"), "learner_seed")
   249	    models = {}
   250	    for arm in ARMS:
   251	        arm_payload = _require_object(arms[arm], f"arms.{arm}")
   252	        if set(arm_payload) != set(ROUTES):
   253	            raise ScorerContractError(f"{arm} does not contain exactly C1/C2/C3")
   254	        models[arm] = {route: Head(arm_payload[route], f"arms.{arm}.{route}") for route in ROUTES}
   255	    widths = {
   256	        route: {models[arm][route].input_width for arm in ARMS}
   257	        for route in ROUTES
