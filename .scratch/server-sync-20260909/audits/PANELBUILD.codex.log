   326	class LineageOrchestrator:
   327	    """Five matched learned arms plus an external BASELINE policy."""
   328	
   329	    def __init__(
   330	        self,
   331	        *,
   332	        learner_seed: int,
   333	        batches: Mapping[Route, PairwiseBatch],
   334	        learning_rate: float = 0.02,
   335	        gauge_weight: float = 0.01,
   336	    ) -> None:
   337	        if set(batches) != set(ROUTES):
   338	            raise StageCContractError("orchestrator needs exactly C1/C2/C3 batches")
   339	        self.learner_seed = int(learner_seed)
   340	        self.batches = dict(batches)
   341	        self.learning_rate = float(learning_rate)
   342	        self.gauge_weight = float(gauge_weight)
   343	        dimensions = {route: batch.reference_states.shape[1] for route, batch in batches.items()}
   344	        template = _initial_model(self.learner_seed, dimensions)
   345	        self.initialization_payload = template.payload()
   346	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
   347	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
   348	        self.completed_source_epochs = 0
   349	        self.route_update_count = 0
   350	        self.loss_history: list[dict[str, object]] = []
   351	
   352	    @property
   353	    def batch_digests(self) -> dict[str, str]:
   354	        return {route: self.batches[route].digest for route in ROUTES}
   355	
   356	    @property
   357	    def source_authority_sha256(self) -> str:
   358	        authorities = {
   359	            batch.source_authority_sha256 for batch in self.batches.values()
   360	        }
   361	        if len(authorities) != 1:
   362	            raise StageCContractError("route batches disagree on source authority")
   363	        return next(iter(authorities))
   364	
   365	    def train_epoch(self) -> dict[str, dict[str, float]]:
   366	        """One deterministic pass over C1, C2, C3 fixed aggregate batches."""
   367	
   368	        epoch_losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
   369	        for route in ROUTES:
   370	            informed = self.batches[route]
   371	            neutral = informed.neutral()
   372	            for arm in LEARNED_ARMS:
   373	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
   374	                epoch_losses[arm][route] = self.models[arm].heads[route].update(
   375	                    batch,
   376	                    learning_rate=self.learning_rate,
   377	                    gauge_weight=self.gauge_weight,
   378	                )
   379	            self.route_update_count += 1
   380	        self.completed_source_epochs += 1
   381	        self.loss_history.append({"epoch": self.completed_source_epochs, "losses": epoch_losses})
   382	        return epoch_losses
   383	
   384	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
   385	        if isinstance(epochs, bool) or epochs < 0:
   386	            raise StageCContractError("epochs must be a nonnegative integer")
   387	        for _ in range(epochs):
   388	            self.train_epoch()
   389	            if (
   390	                checkpoint_directory is not None
   391	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
   392	            ):
   393	                path = Path(checkpoint_directory) / (
   394	                    f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
   395	                )
   396	                self.write_checkpoint(path)
