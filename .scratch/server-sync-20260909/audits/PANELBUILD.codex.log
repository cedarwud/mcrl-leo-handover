   628	            "learner_seed": checkpoint["learner_seed"],
   629	            "selected_profile_ids": selected_ids[arm],
   630	            **pools[arm],
   631	            "demand_cap_applied": False,
   632	        }
   633	        axis_a_rows.append(row)
