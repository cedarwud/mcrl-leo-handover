  1705	def _committed_set_decomposition(
  1706	    *,
  1707	    base: Configuration,
  1708	    selected: Configuration,
  1709	    incumbent: Configuration,
  1710	    evaluator: StepEvaluator,
  1711	    calibration: CalibrationValues,
  1712	    cell_rekeyed_users: Iterable[int] = (),
  1713	) -> tuple[object, tuple[EvaluatedProfile, ...]]:
  1714	    """Evaluate O(|A|) set terms and optional small-set Shapley reporting."""
  1715	
  1716	    base_map = base.mapping
  1717	    changed = tuple(
  1718	        user for user in sorted(base_map) if selected.mapping[user] != base_map[user]
  1719	    )
  1720	    required_subsets = {frozenset(), frozenset(changed)} | {
  1721	        frozenset((user,)) for user in changed
  1722	    }
  1723	    subsets = (
  1724	        {
  1725	            frozenset(subset)
  1726	            for size in range(len(changed) + 1)
  1727	            for subset in itertools.combinations(changed, size)
  1728	        }
  1729	        if 1 < len(changed) <= 4
  1730	        else required_subsets
  1731	    )
  1732	    configs: list[tuple[frozenset[int], Configuration]] = []
  1733	    for subset in sorted(subsets, key=lambda row: (len(row), tuple(sorted(row)))):
  1734	        mapping = dict(base_map)
  1735	        for user in subset:
  1736	            mapping[user] = selected.mapping[user]
  1737	        configs.append((subset, _configuration(base, mapping, kind="committed-sparse-set")))
  1738	    evaluator.evaluate_many([config for _subset, config in configs])
  1739	    outcomes = {
  1740	        subset: evaluator.evaluate(config).outcome()
  1741	        for subset, config in configs
  1742	    }
  1743	    decomposition = set_score_decomposition(
  1744	        coalition_users=changed,
  1745	        outcomes_by_subset=outcomes,
  1746	        lambda_bits_per_j=calibration.lambda_bits_per_j,
  1747	        eta_ref=calibration.eta_ref,
  1748	        kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1749	        phi_difference=(
  1750	            _phi_for(incumbent, selected, cell_rekeyed_users=cell_rekeyed_users)
  1751	            - _phi_for(incumbent, base, cell_rekeyed_users=cell_rekeyed_users)
  1752	        ),
  1753	    )
  1754	    singletons = tuple(
  1755	        evaluator.evaluate(config)
  1756	        for subset, config in configs
