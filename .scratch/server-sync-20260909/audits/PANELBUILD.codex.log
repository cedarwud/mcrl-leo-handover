    89	def _sha256(path: Path) -> str:
    90	    digest = hashlib.sha256()
    91	    with path.open("rb") as handle:
    92	        for block in iter(lambda: handle.read(1024 * 1024), b""):
    93	            digest.update(block)
    94	    return digest.hexdigest()
