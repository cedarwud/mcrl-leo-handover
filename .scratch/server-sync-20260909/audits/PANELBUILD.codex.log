   339	        opportunities = max(1, len(self.score.bits)) * DECISION_INTERVAL_S
   340	        decoding = math.fsum(self.score.decoding_time_s.values()) / opportunities
   341	        useful = math.fsum(self.score.useful_time_s.values()) / opportunities
