    71	def _enforce_resources() -> None:
    72	    if Path(sys.executable).resolve() != INTERPRETER.resolve():
    73	        raise RuntimeError(f"wrong interpreter: {sys.executable}; required {INTERPRETER}")
    74	    current_nice = os.getpriority(os.PRIO_PROCESS, 0)
    75	    if current_nice < REQUIRED_NICE:
    76	        os.nice(REQUIRED_NICE - current_nice)
    77	    if os.getpriority(os.PRIO_PROCESS, 0) < REQUIRED_NICE:
    78	        raise RuntimeError("could not enforce nice -n 15")
    79	    bad = {name: os.environ.get(name) for name in THREAD_VARIABLES if os.environ.get(name) != "1"}
    80	    if bad:
    81	        raise RuntimeError(f"BLAS thread pins drifted: {bad}")
    82	    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    83	    new_hard = MAX_RSS_BYTES if hard == resource.RLIM_INFINITY else min(hard, MAX_RSS_BYTES)
    84	    resource.setrlimit(resource.RLIMIT_AS, (min(MAX_RSS_BYTES, new_hard), new_hard))
    85	    if PROCESS_COUNT > 3:
    86	        raise RuntimeError("scorer process inventory exceeds hard cap")
