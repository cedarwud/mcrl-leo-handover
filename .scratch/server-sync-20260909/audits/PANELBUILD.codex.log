  1831	def _s_uni_select(
  1832	    *,
  1833	    base: Configuration,
  1834	    incumbent: Configuration,
  1835	    tape: ExogenousWorldTape,
  1836	    step_index: int,
  1837	    evaluator: StepEvaluator,
  1838	    calibration: CalibrationValues,
  1839	    compute_budget_s: float,
  1840	    run_setting: SealedRunSetting,
  1841	    cell_rekeyed_users: Iterable[int] = (),
  1842	) -> tuple[Configuration, int, float, bool, str]:
  1843	    """Information-matched exact single-user best response to convergence."""
  1844	
  1845	    started = time.perf_counter()
  1846	    # Evaluation calls are non-preemptible.  Reserve enough wall time for the
  1847	    # final in-flight candidate and receipt bookkeeping so the arm stays
  1848	    # inside its declared comparator budget.
  1849	    deadline_at = started + max(0.0, compute_budget_s - S_UNI_BUDGET_GUARD_S)
  1850	    options, _census = _legal_options(tape, step_index)
  1851	    current = base
  1852	    iterations = 0
  1853	    previous_batch_wall_s = 0.0
  1854	    base_profile = evaluator.evaluate(base)
  1855	    base_served = sum(base_profile.score.served_phy.values())
  1856	
  1857	    def coordinator_k0_objective(
  1858	        config: Configuration, profile: EvaluatedProfile
  1859	    ) -> Fraction:
  1860	        # C1+C3 at k=0 is (F(config)-F(base))/kappa plus the
  1861	        # incumbent-relative Phi difference.  The omitted base constants do
  1862	        # not affect ranking, so this is exactly the coordinator objective in
  1863	        # physical bit units.
  1864	        return _objective(profile, calibration) + (
  1865	            calibration.kappa_bits_per_user_step
  1866	            * _phi_for(
  1867	                incumbent,
  1868	                config,
  1869	                cell_rekeyed_users=cell_rekeyed_users,
  1870	            )
  1871	        )
  1872	
  1873	    while True:
  1874	        if time.perf_counter() >= deadline_at:
  1875	            return (
  1876	                base,
  1877	                iterations,
  1878	                time.perf_counter() - started,
  1879	                True,
  1880	                "DEADLINE_FALLBACK_BASE",
  1881	            )
  1882	        current_profile = evaluator.evaluate(current)
  1883	        best = current
  1884	        best_value = coordinator_k0_objective(current, current_profile)
  1885	        candidates = []
  1886	        for user in sorted(options):
  1887	            for identity in options[user]:
  1888	                if identity == current.mapping[user]:
  1889	                    continue
  1890	                mapping = current.mapping
  1891	                mapping[user] = identity
  1892	                candidates.append(
  1893	                    _configuration(base, mapping, kind="s-uni-iterate")
  1894	                )
  1895	        for offset in range(0, len(candidates), SELECTION_STAGE2_M):
  1896	            remaining_s = deadline_at - time.perf_counter()
  1897	            if remaining_s <= max(0.25, previous_batch_wall_s):
  1898	                return (
  1899	                    base,
  1900	                    iterations,
  1901	                    time.perf_counter() - started,
  1902	                    True,
  1903	                    "DEADLINE_FALLBACK_BASE",
  1904	                )
  1905	            batch_started = time.perf_counter()
  1906	            evaluator.evaluate_many(
  1907	                candidates[offset : offset + SELECTION_STAGE2_M]
  1908	            )
  1909	            previous_batch_wall_s = max(
  1910	                previous_batch_wall_s,
  1911	                time.perf_counter() - batch_started,
  1912	            )
  1913	            if time.perf_counter() >= deadline_at:
  1914	                return (
  1915	                    base,
  1916	                    iterations,
  1917	                    time.perf_counter() - started,
  1918	                    True,
  1919	                    "DEADLINE_FALLBACK_BASE",
  1920	                )
  1921	        for candidate in candidates:
  1922	            if candidate.configuration_id in getattr(evaluator, "_invalid", ()):
  1923	                continue
  1924	            profile = evaluator.evaluate(candidate)
  1925	            if sum(profile.score.served_phy.values()) < base_served:
  1926	                continue
  1927	            value = coordinator_k0_objective(candidate, profile)
  1928	            if value > best_value or (
  1929	                value == best_value and candidate.configuration_id < best.configuration_id
  1930	            ):
  1931	                best, best_value = candidate, value
  1932	        if best.assignments == current.assignments:
  1933	            return (
  1934	                current,
  1935	                iterations,
  1936	                time.perf_counter() - started,
  1937	                False,
  1938	                "NO_IMPROVING_LEGAL_UNILATERAL",
  1939	            )
  1940	        current = best
  1941	        iterations += 1
