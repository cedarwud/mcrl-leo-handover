   910	def _coalition_row(
   911	    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
   912	    rows_by_user_action, calibration, run_setting,
   913	):
   914	    context = _coalition_context(
   915	        tape=tape,
   916	        step_index=step_index,
   917	        anchor=anchor,
   918	        selected=selected,
   919	        rows_by_user_action=rows_by_user_action,
   920	    )
   921	    reference = evaluator.evaluate(anchor).outcome(
   922	        phi=ENGINE._phi_for(anchor, anchor)
   923	    )
   924	    unilateral = {}
   925	    for user in context.changed_users:
  1450	            rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-beam-evacuation"))
  1451	    unique = {row.assignments: row for row in rows}
  1452	    ordered = tuple(sorted(unique.values(), key=lambda row: row.configuration_id))
  1453	    if len(ordered) > ENGINE.CATALOGUE_CAP:
  1454	        ordered = ordered[: ENGINE.CATALOGUE_CAP]
