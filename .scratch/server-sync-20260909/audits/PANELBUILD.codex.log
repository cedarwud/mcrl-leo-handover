  1944	def _stage2_shortlist(
  1945	    *,
  1946	    catalog: Sequence[Configuration],
  1947	    factors: Mapping[str, Mapping[str, object]],
  1948	    mandatory_ids: set[str],
  1949	) -> tuple[tuple[Configuration, ...], dict[str, object]]:
  1950	    """Build the production top-M surface from k=0 scores only."""
  1951	
  1952	    stage1_ranked = sorted(
  1953	        catalog,
  1954	        key=lambda row: (
  1955	            -sum(
  1956	                (
  1957	                    Fraction(factors[row.configuration_id][name])
  1958	                    for name in ("C1", "C3")
  1959	                ),
  1960	                Fraction(),
  1961	            ),
  1962	            row.configuration_id,
  1963	        ),
  1964	    )
  1965	    stage2_ids = mandatory_ids | {
  1966	        row.configuration_id for row in stage1_ranked[:SELECTION_STAGE2_M]
  1967	    }
  1968	    rows = tuple(row for row in catalog if row.configuration_id in stage2_ids)
  1969	    return rows, {
  1970	        "stage1_top1_configuration": stage1_ranked[0].configuration_id,
  1971	        "stage2_candidate_count": len(rows),
  1972	    }
