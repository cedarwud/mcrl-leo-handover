   846	def _classification(results: Sequence[Mapping[str, object]]) -> tuple[str, bool]:
   847	    all_coincide = all(result["knockout_check"]["coincide_at_every_anchor"] for result in results)
   848	    label = (
   849	        "knockout_contrast_no_source_substitution_claim"
   850	        if all_coincide else "neutral_source_substitution_contrast_decision_separated_from_knockout"
   851	    )
   852	    for result in results:
   853	        for row in result["axis_a"]:
   854	            if row.get("contrast") == "FULL-minus-ALL_NEUTRAL_CONTROL":
   855	                row["primary_interpretation"] = label
   856	    return label, all_coincide
