   776	def build_world_shared(pilot, world_index: int, first: int, stop: int,
   777	                       deadline: float, existing: set[int]) -> list[dict[str, object]]:
   778	    global _SHARED_WORLD
   779	    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
   780	    from mcrl.physics_v025.tapes import build_world_tape
   781	
