   859	def _flatten(rows: Sequence[Mapping[str, object]]) -> list[dict[str, object]]:
   860	    def scalar(value: object) -> object:
   861	        if isinstance(value, (Mapping, list, tuple)):
   862	            return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
   863	        return value
   864	    return [{key: scalar(value) for key, value in row.items()} for row in rows]
