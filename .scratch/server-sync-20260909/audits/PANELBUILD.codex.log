   571	            chosen = _select(checkpoint["models"][arm], profiles)
   572	            selections[arm].append(chosen["outcome"])
   573	            selected_ids[arm].append(chosen["profile_id"])
   574	        knockout = _select(checkpoint["models"]["FULL"], profiles, knockout_all=True)
   575	        neutral_ids.append(selected_ids["ALL_NEUTRAL_CONTROL"][-1])
   576	        knockout_ids.append(knockout["profile_id"])
