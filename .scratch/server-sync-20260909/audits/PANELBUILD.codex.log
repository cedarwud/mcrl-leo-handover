   371	    original_forecast = pilot.ENGINE._batched_stage2_forecasts
   372	
   373	    def capture_forecast(**kwargs):
   374	        configs = tuple(kwargs["configs"])
   375	        if not configs:
   376	            raise AssertionError("forecast batch unexpectedly contained no configurations")
   377	        original_projection = pilot.ENGINE._projection_from_profile
