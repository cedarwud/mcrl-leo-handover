+++ b/.scratch/ceiling2/run_ceiling2.py
@@ -0,0 +1,950 @@
+#!/usr/bin/env python3
+"""Clean-path ceiling and coalition-support diagnostic.
+
+Selection rule: every objective comparison for one arm/anchor is made from one
+fresh dense boundary-0 StepEvaluator.  BASE is populated with evaluate_many in
+that evaluator before profiles are read.  Endpoints use one separate fresh
+realised full-48 evaluator and one evaluate_many call.  Scalar evaluate is
+replaced globally by a fail-closed raising stub.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import gc
+import hashlib
+import importlib.util
+import itertools
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import threading
+import time
+from typing import Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-ceiling2-ws")
+PANEL_RUNNER = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/run_panelceil.py")
+PANEL_RUNNER_SHA256 = "dda958d166c42d276704a696e20966ac4236b78e4f88ecf5120e8a73ef817f95"
+CLEAN_RECEIPT = Path("/home/sat/mcrl-v025-rank2-ws/.scratch/cleanpath/cleanpath-receipt.json")
+OUTPUT_DIR = WORKSPACE / ".scratch/ceiling2"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+WIDTHS = (1.66, 2.40)
+SUPPORT_LEVELS = (1, 2, 3, 4, 6)
+TOP_K_USERS = 10
+TOP_OPTIONS_PER_USER = 2
+CATALOGUE_ROW_CAP_PER_ANCHOR = 30_000
+UNILATERAL_BATCH_SIZE = 16
+JOINT_BATCH_SIZE = 32
+MAX_RSS_BYTES = 4_900_000_000
+EXPECTED_166 = {
+    "BASE": 11.027760,
+    "RSS_MAX": 41.621560,
+    "MYOPIC_GREEDY": 31.078504,
+    "U_FIRST": 31.028111,
+}
+SCALAR_EVALUATE_CALLS = 0
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def output_path(width: float) -> Path:
+    return OUTPUT_DIR / f"ceiling2-width-{width:.2f}.json"
+
+
+def atomic_write(path: Path, payload: dict) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    temporary.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(path)
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def resident_bytes() -> int:
+    for line in Path("/proc/self/status").read_text(encoding="ascii").splitlines():
+        if line.startswith("VmRSS:"):
+            return int(line.split()[1]) * 1024
+    raise RuntimeError("/proc/self/status omitted VmRSS")
+
+
+def start_rss_watchdog() -> None:
+    def monitor() -> None:
+        while True:
+            value = resident_bytes()
+            if value >= MAX_RSS_BYTES:
+                print(f"peak RSS hard-stop at {value} bytes", flush=True)
+                os._exit(86)
+            time.sleep(0.05)
+    threading.Thread(target=monitor, name="rss-watchdog", daemon=True).start()
+
+
+def check_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= 5_000_000_000:
+        raise MemoryError(f"peak RSS {peak_rss_bytes()} is not below 5 GB")
+
+
+def load_snapshot() -> dict[str, object]:
+    load1, load5, load15 = os.getloadavg()
+    return {
+        "unix_seconds": time.time(),
+        "load_average_1m": load1,
+        "load_average_5m": load5,
+        "load_average_15m": load15,
+        "logical_cpu_count": os.cpu_count(),
+    }
+
+
+def load_panel():
+    if sha256(PANEL_RUNNER) != PANEL_RUNNER_SHA256:
+        raise RuntimeError("hash-pinned PANELCEIL runner changed")
+    name = f"ceiling2_panelceil_{os.getpid()}"
+    spec = importlib.util.spec_from_file_location(name, PANEL_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot import PANELCEIL runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def forbid_scalar_evaluate(runner) -> None:
+    original = runner.StepEvaluator.evaluate
+
+    def forbidden(*args, **kwargs):
+        del args, kwargs
+        global SCALAR_EVALUATE_CALLS
+        SCALAR_EVALUATE_CALLS += 1
+        raise AssertionError("scalar StepEvaluator.evaluate is forbidden")
+
+    forbidden.__name__ = "scalar_evaluate_forbidden_on_clean_path"
+    forbidden.__wrapped__ = original
+    runner.StepEvaluator.evaluate = forbidden
+    assert runner.StepEvaluator.evaluate is forbidden
+
+
+def fresh_evaluator(runner, tape, step_index, incumbent, run_setting, field, boundaries):
+    return runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field=field, counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=boundaries,
+    )
+
+
+def configured(runner, base, mapping, kind: str):
+    return runner._configuration(base, mapping, kind=kind)
+
+
+def rss_max_configuration(runner, tape, step_index: int, base):
+    options, _ = runner._legal_options(tape, step_index)
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("exact panel omitted primitive arrays")
+    row_of = arrays._row_index()
+    mapping = {}
+    for user, identities in sorted(options.items()):
+        if not identities:
+            mapping[user] = None
+            continue
+        _, identity = min(enumerate(identities), key=lambda item: (
+            -float(arrays.nominal_gain[0, row_of[(user, item[1])]]), item[0]
+        ))
+        mapping[user] = identity
+    return configured(runner, base, mapping, "ceiling2-rss-max")
+
+
+@dataclass
+class SearchResult:
+    selected: object
+    at_10s: object
+    receipt: dict[str, object]
+    best_alternatives: dict[int, tuple[int, int]]
+
+
+def dense_search(panel, runner, calibration, tape, step_index, base, incumbent,
+                 run_setting, *, field: str, rule: str, converged: bool,
+                 kind: str) -> SearchResult:
+    """One arm, one fresh dense evaluator, no scalar reads."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field, (0,)
+    )
+    evaluator.evaluate_many((base,))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    if base_profile is None:
+        raise RuntimeError("dense BASE is invalid")
+    guard = panel.served(base_profile)
+    started = time.perf_counter()
+    options, census = runner._legal_options(tape, step_index)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    current = base
+    moves: list[tuple[float, object]] = [(0.0, base)]
+    passes = comparisons = submitted = 0
+    while True:
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = evaluator._evaluated.get(current.configuration_id)
+            if current_profile is None:
+                raise RuntimeError("current profile absent from dense cache")
+            current_value: Fraction = panel.objective(
+                runner, calibration, incumbent, current, current_profile, rekeys
+            )
+            candidates = tuple(
+                panel.candidate(runner, base, current, user, identity, kind)
+                for identity in options[user] if identity != current.mapping[user]
+            )
+            accepted = None
+            if rule == "first":
+                for offset in range(0, len(candidates), UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                    for row in batch:
+                        comparisons += 1
+                        profile = evaluator._evaluated.get(row.configuration_id)
+                        if profile is None or panel.served(profile) < guard:
+                            continue
+                        value = panel.objective(
+                            runner, calibration, incumbent, row, profile, rekeys
+                        )
+                        if value > current_value:
+                            accepted = row
+                            break
+                    if accepted is not None:
+                        break
+            elif rule == "best":
+                for offset in range(0, len(candidates), UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                eligible = [(current_value, current.configuration_id, current)]
+                for row in candidates:
+                    comparisons += 1
+                    profile = evaluator._evaluated.get(row.configuration_id)
+                    if profile is None or panel.served(profile) < guard:
+                        continue
+                    value = panel.objective(
+                        runner, calibration, incumbent, row, profile, rekeys
+                    )
+                    if not converged or value > current_value:
+                        eligible.append((value, row.configuration_id, row))
+                selected = min(eligible, key=lambda item: (-item[0], item[1]))[2]
+                if selected.mapping[user] != current.mapping[user]:
+                    accepted = selected
+            else:
+                raise ValueError(rule)
+            if accepted is not None:
+                current = accepted
+                moves_this_pass += 1
+                moves.append((time.perf_counter() - started, current))
+        passes += 1
+        if not converged or moves_this_pass == 0:
+            break
+        if passes > 100:
+            raise RuntimeError("search exceeded 100 passes")
+    at_10s = base
+    for accepted_seconds, config in moves:
+        if accepted_seconds > 10.0:
+            break
+        at_10s = config
+    best_alternatives = {}
+    if rule == "first" and converged:
+        for user in sorted(options):
+            rows = []
+            for identity in options[user]:
+                if identity == current.mapping[user]:
+                    continue
+                row = panel.candidate(
+                    runner, base, current, user, identity,
+                    "ceiling2-terminal-alternate",
+                )
+                profile = evaluator._evaluated.get(row.configuration_id)
+                if profile is not None:
+                    rows.append((
+                        panel.objective(
+                            runner, calibration, incumbent, row, profile, rekeys
+                        ),
+                        row.configuration_id,
+                        identity,
+                    ))
+            if rows:
+                best_alternatives[user] = min(
+                    rows, key=lambda item: (-item[0], item[1])
+                )[2]
+    receipt = {
+        "field": field,
+        "rule": rule,
+        "passes_mode": "converged" if converged else "one",
+        "moves": len(moves) - 1,
+        "passes_including_certificate": passes,
+        "guard": guard,
+        "comparisons": comparisons,
+        "submitted_candidate_slots": submitted,
+        "legal_option_census": census,
+        "selection_seconds": time.perf_counter() - started,
+        "last_move_seconds": moves[-1][0],
+        "moves_completed_by_10s": sum(seconds <= 10.0 for seconds, _ in moves[1:]),
+        "base_entered_via_evaluate_many_before_profile_read": True,
+        "one_fresh_dense_evaluator": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return SearchResult(current, at_10s, receipt, best_alternatives)
+
+
+def evaluate_batches(evaluator, rows: Sequence[object], size: int) -> None:
+    for offset in range(0, len(rows), size):
+        evaluator.evaluate_many(rows[offset:offset + size])
+
+
+def candidate_key(config) -> tuple:
+    return tuple(config.assignments)
+
+
+def changed_users(seed, config) -> tuple[int, ...]:
+    return tuple(
+        user for user in sorted(seed.mapping)
+        if seed.mapping[user] != config.mapping[user]
+    )
+
+
+def panel_bounded_joint_search(panel, runner, calibration, tape, step_index,
+                               base, incumbent, run_setting,
+                               first: SearchResult) -> tuple[object, dict]:
+    """Recompute PANELCEIL's quoted bounded joint selector on the clean path."""
+    started = time.perf_counter()
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    evaluator.evaluate_many((base, first.selected))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    seed_profile = evaluator._evaluated.get(first.selected.configuration_id)
+    if base_profile is None or seed_profile is None:
+        raise RuntimeError("BASE or U_FIRST is invalid for PANELCEIL joint selector")
+    guard = panel.served(base_profile)
+    candidates, aliases, families = panel.build_joint_candidates(
+        runner, tape, step_index, base, first.selected,
+        first.best_alternatives,
+    )
+    evaluate_batches(evaluator, candidates, JOINT_BATCH_SIZE)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    seed_value = panel.objective(
+        runner, calibration, incumbent, first.selected, seed_profile, rekeys
+    )
+    best = first.selected
+    best_profile = seed_profile
+    qualifying = 0
+    for row in candidates:
+        profile = evaluator._evaluated.get(row.configuration_id)
+        if profile is None or panel.served(profile) < guard:
+            continue
+        value = panel.objective(
+            runner, calibration, incumbent, row, profile, rekeys
+        )
+        if value > seed_value:
+            qualifying += 1
+        best_value = panel.objective(
+            runner, calibration, incumbent, best, best_profile, rekeys
+        )
+        if value > best_value or (
+            value == best_value and best is not first.selected
+            and row.configuration_id < best.configuration_id
+        ):
+            best, best_profile = row, profile
+    changed = changed_users(first.selected, best)
+    receipt = {
+        "catalogue_object": "PANELCEIL custom U_FIRST-local bounded catalogue",
+        "construction": (
+            "within-beam occupant subsets size 2..4 capped at 1024; victim plus "
+            "top-2/top-3 contributors; all common-destination complete-beam evacuations"
+        ),
+        "catalogue_unique": len(candidates),
+        "catalogue_aliases": sum(len(value) for value in aliases.values()),
+        "family_unique_counts": families,
+        "catalogue_exhausted": True,
+        "joint_candidate_cap": panel.JOINT_CANDIDATE_CAP,
+        "strict_improvement": best is not first.selected and panel.objective(
+            runner, calibration, incumbent, best, best_profile, rekeys
+        ) > seed_value,
+        "qualifying_rows": qualifying,
+        "winning_changed_set_size": len(changed),
+        "winning_changed_users": list(changed),
+        "wall_seconds": time.perf_counter() - started,
+        "one_fresh_dense_evaluator": True,
+        "base_and_seed_entered_via_evaluate_many_before_reads": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return best, receipt
+
+
+def support_catalogue_search(panel, runner, calibration, tape, step_index, base,
+                             incumbent, run_setting, seed) -> tuple[dict[int, object], dict]:
+    """Generalise the bounded top-10/top-2 catalogue from pairs through size 6.
+
+    Complete beam evacuations are included at every support level as the one
+    explicit exception to the cardinality cap requested by the experiment.
+    """
+    started = time.perf_counter()
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    evaluator.evaluate_many((base, seed))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    seed_profile = evaluator._evaluated.get(seed.configuration_id)
+    if base_profile is None or seed_profile is None:
+        raise RuntimeError("BASE or U_FIRST seed is invalid")
+    guard = panel.served(base_profile)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    seed_value = panel.objective(
+        runner, calibration, incumbent, seed, seed_profile, rekeys
+    )
+
+    shortlist, shortlist_census = runner._selection_shortlist(
+        tape, step_index, run_setting=run_setting
+    )
+    unilaterals: dict[int, list[object]] = {user: [] for user in sorted(shortlist)}
+    unique_ids = {seed.configuration_id}
+
+    def add(config) -> bool:
+        if config.configuration_id in unique_ids:
+            return False
+        unique_ids.add(config.configuration_id)
+        return True
+
+    for user in sorted(shortlist):
+        for identity in shortlist[user]:
+            if identity == seed.mapping[user]:
+                continue
+            mapping = dict(seed.mapping)
+            mapping[user] = identity
+            row = configured(runner, base, mapping, "ceiling2-unilateral")
+            if add(row):
+                unilaterals[user].append(row)
+    unilateral_rows = tuple(row for rows in unilaterals.values() for row in rows)
+    evaluate_batches(evaluator, unilateral_rows, JOINT_BATCH_SIZE)
+
+    best_surplus = {}
+    for user in sorted(unilaterals):
+        values = []
+        for row in unilaterals[user]:
+            profile = evaluator._evaluated.get(row.configuration_id)
+            if profile is None or panel.served(profile) < guard:
+                continue
+            values.append(panel.objective(
+                runner, calibration, incumbent, row, profile, rekeys
+            ) - seed_value)
+        best_surplus[user] = max(values, default=Fraction(-10**30))
+    ranked_users = tuple(sorted(
+        unilaterals, key=lambda user: (-best_surplus[user], user)
+    )[:TOP_K_USERS])
+
+    # Preserve the production bounded-catalogue proposal semantics: each of
+    # the selected top-K users contributes its first two declared shortlist
+    # alternatives, while this experiment generalises the pair combination.
+    proposals = {
+        user: tuple(unilaterals[user][:TOP_OPTIONS_PER_USER])
+        for user in ranked_users
+    }
+
+    evacuation_rows_list = []
+    for beam in sorted({identity for identity in seed.mapping.values() if identity is not None}):
+        mapping = dict(seed.mapping)
+        affected = [user for user in sorted(seed.mapping) if seed.mapping[user] == beam]
+        for user in affected:
+            mapping[user] = next(
+                (identity for identity in shortlist[user] if identity != beam), None
+            )
+        if mapping != seed.mapping:
+            row = configured(runner, base, mapping, "ceiling2-beam-evacuation")
+            if add(row):
+                evacuation_rows_list.append(row)
+    evacuation_rows = tuple(sorted(
+        evacuation_rows_list, key=lambda row: row.configuration_id
+    ))
+    evaluate_batches(evaluator, evacuation_rows, JOINT_BATCH_SIZE)
+
+    best = seed
+    best_profile = seed_profile
+    qualifying = 0
+    evaluated_ids: set[str] = set()
+
+    def consider(rows: Sequence[object]) -> None:
+        nonlocal best, best_profile, qualifying
+        for row in rows:
+            if row.configuration_id in evaluated_ids:
+                continue
+            evaluated_ids.add(row.configuration_id)
+            profile = evaluator._evaluated.get(row.configuration_id)
+            if profile is None or panel.served(profile) < guard:
+                continue
+            value = panel.objective(
+                runner, calibration, incumbent, row, profile, rekeys
+            )
+            if value > seed_value:
+                qualifying += 1
+            best_value = panel.objective(
+                runner, calibration, incumbent, best, best_profile, rekeys
+            )
+            if value > best_value or (
+                value == best_value and best is not seed
+                and row.configuration_id < best.configuration_id
+            ):
+                best, best_profile = row, profile
+
+    def drop_profiles(rows: Sequence[object]) -> None:
+        keep = {
+            base.configuration_id, seed.configuration_id,
+            best.configuration_id,
+        }
+        for row in rows:
+            if row.configuration_id not in keep:
+                evaluator._evaluated.pop(row.configuration_id, None)
+
+    consider(unilateral_rows)
+    consider(evacuation_rows)
+    drop_profiles(unilateral_rows)
+    drop_profiles(evacuation_rows)
+    selected: dict[int, object] = {}
+    levels = {}
+    cumulative_rows = 1 + len(evaluated_ids)
+    selected[1] = best
+    levels[1] = {
+        "catalogue_rows": cumulative_rows,
+        "row_cap": CATALOGUE_ROW_CAP_PER_ANCHOR,
+        "exhausted": cumulative_rows <= CATALOGUE_ROW_CAP_PER_ANCHOR,
+        "truncated": False,
+        "strict_improvement": best is not seed and panel.objective(
+            runner, calibration, incumbent, best, best_profile, rekeys
+        ) > seed_value,
+        "winning_changed_set_size": len(changed_users(seed, best)),
+        "winning_configuration_id": best.configuration_id,
+        "qualifying_rows": qualifying,
+        "cumulative_wall_seconds": time.perf_counter() - started,
+    }
+
+    for size in range(2, max(SUPPORT_LEVELS) + 1):
+        size_rows = []
+        for coalition in itertools.combinations(ranked_users, size):
+            if any(not proposals[user] for user in coalition):
+                continue
+            for choices in itertools.product(*(proposals[user] for user in coalition)):
+                mapping = dict(seed.mapping)
+                for user, proposal in zip(coalition, choices, strict=True):
+                    mapping[user] = proposal.mapping[user]
+                row = configured(runner, base, mapping, f"ceiling2-coalition-{size}")
+                if add(row):
+                    size_rows.append(row)
+        # The declared cap is applied to each cumulative support level.  A
+        # deterministic configuration-ID prefix would be used if it binds.
+        remaining = CATALOGUE_ROW_CAP_PER_ANCHOR - cumulative_rows
+        ordered = tuple(sorted(size_rows, key=lambda row: row.configuration_id))
+        truncated = len(ordered) > max(0, remaining)
+        admitted = ordered[:max(0, remaining)]
+        for offset in range(0, len(admitted), JOINT_BATCH_SIZE):
+            batch = admitted[offset:offset + JOINT_BATCH_SIZE]
+            evaluator.evaluate_many(batch)
+            consider(batch)
+            drop_profiles(batch)
+        cumulative_rows += len(admitted)
+        if size in SUPPORT_LEVELS:
+            selected[size] = best
+            levels[size] = {
+                "catalogue_rows": cumulative_rows,
+                "row_cap": CATALOGUE_ROW_CAP_PER_ANCHOR,
+                "exhausted": not truncated,
+                "truncated": truncated,
+                "strict_improvement": best is not seed and panel.objective(
+                    runner, calibration, incumbent, best, best_profile, rekeys
+                ) > seed_value,
+                "winning_changed_set_size": len(changed_users(seed, best)),
+                "winning_configuration_id": best.configuration_id,
+                "qualifying_rows": qualifying,
+                "new_rows_at_size": len(admitted),
+                "uncapped_new_rows_at_size": len(ordered),
+                "cumulative_wall_seconds": time.perf_counter() - started,
+            }
+        if truncated:
+            # Higher supports have no remaining rows under the cumulative cap.
+            for requested in SUPPORT_LEVELS:
+                if requested > size:
+                    selected[requested] = best
+                    levels[requested] = {
+                        **levels[size],
+                        "exhausted": False,
+                        "truncated": True,
+                        "support_requested": requested,
+                        "truncation_bound_at_size": size,
+                    }
+            break
+
+    receipt = {
+        "construction": (
+            "U_FIRST seed; every shortlisted unilateral; top-10 users ranked by "
+            "exact realised guarded unilateral surplus in the same evaluator; first "
+            "two declared shortlist alternatives per ranked user combined through "
+            "the requested support; complete beam evacuations at every level"
+        ),
+        "support_cap_exception": "complete beam evacuations are included at every level",
+        "top_k_users": list(ranked_users),
+        "top_k": TOP_K_USERS,
+        "top_options_per_user": TOP_OPTIONS_PER_USER,
+        "shortlist_census": shortlist_census,
+        "unilateral_rows": len(unilateral_rows),
+        "beam_evacuation_rows": len(evacuation_rows),
+        "levels": levels,
+        "guard": guard,
+        "one_fresh_dense_evaluator": True,
+        "base_and_seed_entered_via_evaluate_many_before_reads": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+        "wall_seconds": time.perf_counter() - started,
+    }
+    del evaluator
+    gc.collect()
+    return selected, receipt
+
+
+def endpoint_metrics(panel, runner, tape, step_index, incumbent, run_setting,
+                     configs: Mapping[str, object]) -> dict[str, dict[str, object]]:
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting,
+        "realised", tuple(range(48)),
+    )
+    evaluator.evaluate_many(tuple(configs.values()))
+    result = {}
+    for name, config in configs.items():
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is None:
+            raise RuntimeError(f"invalid endpoint config for {name}")
+        result[name] = panel.metric(profile)
+    del evaluator
+    gc.collect()
+    return result
+
+
+def pool(anchors: Sequence[Mapping[str, object]], name: str) -> dict[str, object]:
+    metrics = [row["committed"][name] for row in anchors]
+    bits = math.fsum(float(row["bits"]) for row in metrics)
+    joules = math.fsum(float(row["joules"]) for row in metrics)
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_mbit_per_j": bits / joules / 1e6,
+        "served_count": sum(int(row["served_count"]) for row in metrics),
+        "rate_target_attained_count": sum(
+            int(row["rate_target_attained_count"]) for row in metrics
+        ),
+        "user_count": sum(int(row["user_count"]) for row in metrics),
+    }
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    names = (
+        "BASE", "RSS_MAX", "MYOPIC_GREEDY", "U_FIRST", "U_BEST",
+        "U_FIRST_AT_10", "J_PANEL_BOUNDED",
+        *(f"JOINT_K{k}" for k in SUPPORT_LEVELS),
+    )
+    pooled = {name: pool(anchors, name) for name in names}
+    support = {}
+    for k in SUPPORT_LEVELS:
+        details = []
+        for row in anchors:
+            levels = row["support_catalogue"]["levels"]
+            details.append(levels[k] if k in levels else levels[str(k)])
+        joint_name = f"JOINT_K{k}"
+        support[str(k)] = {
+            "coordination_ceiling": (
+                pooled[joint_name]["ee_mbit_per_j"] / pooled["U_FIRST"]["ee_mbit_per_j"] - 1.0
+            ),
+            "catalogue_rows_total": sum(int(row["catalogue_rows"]) for row in details),
+            "catalogue_rows_mean_per_anchor": math.fsum(
+                float(row["catalogue_rows"]) for row in details
+            ) / len(details),
+            "catalogue_rows_range_per_anchor": [
+                min(int(row["catalogue_rows"]) for row in details),
+                max(int(row["catalogue_rows"]) for row in details),
+            ],
+            "strict_improvement_anchor_count": sum(bool(row["strict_improvement"]) for row in details),
+            "mean_winning_changed_set_size": math.fsum(
+                float(row["winning_changed_set_size"]) for row in details
+            ) / len(details),
+            "mean_winning_changed_set_size_given_improvement": (
+                math.fsum(
+                    float(row["winning_changed_set_size"])
+                    for row in details if row["strict_improvement"]
+                ) / max(1, sum(bool(row["strict_improvement"]) for row in details))
+            ),
+            "wall_seconds_total": math.fsum(float(row["cumulative_wall_seconds"]) for row in details),
+            "wall_seconds_mean_per_anchor": math.fsum(
+                float(row["cumulative_wall_seconds"]) for row in details
+            ) / len(details),
+            "all_catalogues_exhausted": all(bool(row["exhausted"]) for row in details),
+            "any_catalogue_truncated": any(bool(row["truncated"]) for row in details),
+            "row_cap_per_anchor": CATALOGUE_ROW_CAP_PER_ANCHOR,
+        }
+    return {
+        "pooled": pooled,
+        "coordination_ceiling_panel_bounded": (
+            pooled["J_PANEL_BOUNDED"]["ee_mbit_per_j"] / pooled["U_FIRST"]["ee_mbit_per_j"] - 1.0
+        ),
+        "traversal_order_gap_first_over_best": (
+            pooled["U_FIRST"]["ee_mbit_per_j"] / pooled["U_BEST"]["ee_mbit_per_j"] - 1.0
+        ),
+        "acceleration_headroom_first_over_10s": (
+            pooled["U_FIRST"]["ee_mbit_per_j"] / pooled["U_FIRST_AT_10"]["ee_mbit_per_j"] - 1.0
+        ),
+        "support": support,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--width", type=float, choices=WIDTHS, required=True)
+    args = parser.parse_args()
+    check_runtime()
+    resource.setrlimit(resource.RLIMIT_RSS, (MAX_RSS_BYTES, MAX_RSS_BYTES))
+    start_rss_watchdog()
+    overall_started = time.perf_counter()
+    panel = load_panel()
+    clean = json.loads(CLEAN_RECEIPT.read_text(encoding="utf-8"))
+    if clean.get("status") != "COMPLETE" or clean.get("receipt_sha256") != canonical_digest(clean):
+        raise RuntimeError("clean-path receipt is absent, incomplete, or digest-invalid")
+    frozen = clean.get("panel")
+    if not isinstance(frozen, list) or len(frozen) != 12:
+        raise RuntimeError("clean receipt omitted the 12 frozen development anchors")
+
+    pilot = panel.load_pilot()
+    runner = pilot.ENGINE
+    calibration = panel.load_calibration(pilot)
+    run_setting = runner.run_setting_for("a-r0")
+    forbid_scalar_evaluate(runner)
+    from mcrl.physics_v025 import channel
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+    channel.TX_FULL_HPBW_DEG = 2.0 * args.width
+
+    print(
+        f"DESIGN-PHASE EXPLORATION width={args.width:.2f} deg; "
+        f"peak RSS cap={MAX_RSS_BYTES} bytes",
+        flush=True,
+    )
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    tape_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33, start_time_s=0.0,
+    )
+    tape_seconds = time.perf_counter() - tape_started
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)
+
+    path = output_path(args.width)
+    payload = {
+        "schema": "mcrl-v025-ceiling2-clean-and-levers-v1",
+        "status": "RUNNING",
+        "claim_status": "DESIGN_PHASE_EXPLORATION_NOT_A_CLAIM",
+        "one_sided_half_power_deg": args.width,
+        "full_hpbw_deg_runtime_override": 2.0 * args.width,
+        "sealed_design_point_changed": False,
+        "panel": frozen,
+        "panel_count": len(frozen),
+        "development_anchors_only": True,
+        "evaluation_only_claim_dates_read": False,
+        "numerator": "full-buffer successfully decoded forward-downlink information bits; no demand cap",
+        "selection_path": {
+            "fresh_evaluator_per_arm_and_anchor": True,
+            "boundary_indices": [0],
+            "dense_evaluate_many_only": True,
+            "base_in_same_evaluator": True,
+            "foreign_cache_reads": False,
+            "scalar_evaluate_fail_closed": True,
+        },
+        "endpoint_path": {
+            "one_separate_fresh_realised_evaluator_per_anchor": True,
+            "boundary_indices": list(range(48)),
+            "one_evaluate_many_call_for_all_selected_configs": True,
+        },
+        "support_catalogue": {
+            "support_levels": list(SUPPORT_LEVELS),
+            "top_k_users": TOP_K_USERS,
+            "top_options_per_user": TOP_OPTIONS_PER_USER,
+            "row_cap_per_anchor": CATALOGUE_ROW_CAP_PER_ANCHOR,
+            "beam_evacuations_included_at_every_level": True,
+            "global_top_rank_proposals_excluded": True,
+            "reason": "the requested sweep isolates cardinality support plus the explicitly requested complete beam evacuations",
+            "catalogue_object_distinction": (
+                "This nested top-10/top-2 diagnostic follows the production C3 bounded-catalogue "
+                "semantics. The separately reported PANELCEIL coordination ceiling uses a "
+                "different U_FIRST-local catalogue with occupant/contributor families."
+            ),
+        },
+        "process_count": 1,
+        "python": sys.executable,
+        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+        "rss_watchdog_bytes": MAX_RSS_BYTES,
+        "load_start": load_snapshot(),
+        "world_tape": {
+            "domain": tape.domain, "seed": tape.seed, "digest": tape.digest,
+            "construction_seconds": tape_seconds,
+        },
+        "panel_runner": str(PANEL_RUNNER),
+        "panel_runner_sha256": sha256(PANEL_RUNNER),
+        "clean_receipt": str(CLEAN_RECEIPT),
+        "clean_receipt_sha256": clean["receipt_sha256"],
+        "anchors": [],
+    }
+
+    for position, panel_row in enumerate(frozen, 1):
+        index = int(panel_row["global_anchor_index"])
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        anchor_started = time.perf_counter()
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        rss = rss_max_configuration(runner, tape, step_index, base)
+        myopic = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, field="nominal", rule="best", converged=False,
+            kind="ceiling2-myopic-greedy",
+        )
+        first = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, field="realised", rule="first", converged=True,
+            kind="ceiling2-first-improvement",
+        )
+        best = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, field="realised", rule="best", converged=True,
+            kind="ceiling2-best-improvement",
+        )
+        panel_joint, panel_joint_receipt = panel_bounded_joint_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, first,
+        )
+        joint, joint_receipt = support_catalogue_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, first.selected,
+        )
+        configs = {
+            "BASE": base,
+            "RSS_MAX": rss,
+            "MYOPIC_GREEDY": myopic.selected,
+            "U_FIRST": first.selected,
+            "U_BEST": best.selected,
+            "U_FIRST_AT_10": first.at_10s,
+            "J_PANEL_BOUNDED": panel_joint,
+            **{f"JOINT_K{k}": joint[k] for k in SUPPORT_LEVELS},
+        }
+        committed = endpoint_metrics(
+            panel, runner, tape, step_index, incumbent, run_setting, configs
+        )
+        row = {
+            "global_anchor_index": index,
+            "anchor_id": f"{panel_row['world_id']}|{step_index}|{carrier}",
+            "step_index": step_index,
+            "carrier": carrier,
+            "search": {
+                "MYOPIC_GREEDY": myopic.receipt,
+                "U_FIRST": first.receipt,
+                "U_BEST": best.receipt,
+            },
+            "panel_bounded_joint": panel_joint_receipt,
+            "support_catalogue": joint_receipt,
+            "committed": committed,
+            "anchor_wall_seconds": time.perf_counter() - anchor_started,
+            "load_end": load_snapshot(),
+            "peak_rss_bytes": peak_rss_bytes(),
+        }
+        payload["anchors"].append(row)
+        payload["summary"] = summarize(payload["anchors"])
+        payload["peak_rss_bytes"] = peak_rss_bytes()
+        check_runtime()
+        atomic_write(path, payload)
+        print(
+            f"anchor {position}/{len(frozen)} completed peak RSS "
+            f"{peak_rss_bytes()/2**30:.3f} GiB "
+            + json.dumps({
+                "global": index,
+                "first_moves": first.receipt["moves"],
+                "best_moves": best.receipt["moves"],
+                "k2_rows": joint_receipt["levels"][2]["catalogue_rows"],
+                "k6_rows": joint_receipt["levels"][6]["catalogue_rows"],
+                "wall_s": round(row["anchor_wall_seconds"], 3),
+            }, sort_keys=True),
+            flush=True,
+        )
+
+    payload["summary"] = summarize(payload["anchors"])
+    payload["scalar_evaluate_calls"] = SCALAR_EVALUATE_CALLS
+    assert SCALAR_EVALUATE_CALLS == 0
+    payload["scalar_evaluate_assertion_passed"] = True
+    if args.width == 1.66:
+        parity = {}
+        for name, expected in EXPECTED_166.items():
+            measured = float(payload["summary"]["pooled"][name]["ee_mbit_per_j"])
+            passed = f"{measured:.6f}" == f"{expected:.6f}"
+            parity[name] = {"expected": expected, "measured": measured, "six_decimal_pass": passed}
+            if not passed:
+                raise AssertionError(f"mandatory parity failed for {name}: {measured} != {expected}")
+        payload["mandatory_clean_parity"] = parity
+        payload["mandatory_clean_parity_passed"] = True
+    payload["status"] = "COMPLETE"
+    payload["load_end"] = load_snapshot()
+    payload["wall_seconds"] = time.perf_counter() - overall_started
+    payload["peak_rss_bytes"] = peak_rss_bytes()
+    payload["runner_sha256"] = sha256(Path(__file__))
+    atomic_write(path, payload)
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(f"scalar_evaluate_calls={SCALAR_EVALUATE_CALLS}", flush=True)
+    print(json.dumps(payload["summary"], sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.scratch/ceiling2/spec.md b/.scratch/ceiling2/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..5601cb19b222a93cf1a8ab26ddbfc84d001d8190
--- /dev/null
+++ b/.scratch/ceiling2/spec.md
@@ -0,0 +1,8 @@
+# CEILING2 execution criterion
+
+The investigation is complete only if the requested report exists and its
+run-backed receipt (a) reproduces the four six-decimal clean-path parity values,
+(b) asserts zero scalar `StepEvaluator.evaluate` calls, (c) contains complete
+12-anchor results at 1.66° and 2.40° for all requested ceilings and support
+levels, and (d) records peak RSS below 5 GB, one Python process, pinned numerical
+threads, per-anchor progress, row caps/exhaustion, timing, and host load.

diff --git a/.scratch/ceiling2/run_ceiling2.py b/.scratch/ceiling2/run_ceiling2.py
new file mode 100644
index 0000000000000000000000000000000000000000..e7f46255bc27e2e54f71eb59fd60f045225eef0a
--- /dev/null
+++ b/.scratch/ceiling2/run_ceiling2.py
@@ -0,0 +1,950 @@
+#!/usr/bin/env python3
+"""Clean-path ceiling and coalition-support diagnostic.
+
+Selection rule: every objective comparison for one arm/anchor is made from one
+fresh dense boundary-0 StepEvaluator.  BASE is populated with evaluate_many in
+that evaluator before profiles are read.  Endpoints use one separate fresh
+realised full-48 evaluator and one evaluate_many call.  Scalar evaluate is
+replaced globally by a fail-closed raising stub.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+import gc
+import hashlib
+import importlib.util
+import itertools
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import threading
+import time
+from typing import Mapping, Sequence
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-ceiling2-ws")
+PANEL_RUNNER = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/run_panelceil.py")
+PANEL_RUNNER_SHA256 = "dda958d166c42d276704a696e20966ac4236b78e4f88ecf5120e8a73ef817f95"
+CLEAN_RECEIPT = Path("/home/sat/mcrl-v025-rank2-ws/.scratch/cleanpath/cleanpath-receipt.json")
+OUTPUT_DIR = WORKSPACE / ".scratch/ceiling2"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+WIDTHS = (1.66, 2.40)
+SUPPORT_LEVELS = (1, 2, 3, 4, 6)
+TOP_K_USERS = 10
+TOP_OPTIONS_PER_USER = 2
+CATALOGUE_ROW_CAP_PER_ANCHOR = 30_000
+UNILATERAL_BATCH_SIZE = 16
+JOINT_BATCH_SIZE = 32
+MAX_RSS_BYTES = 4_900_000_000
+EXPECTED_166 = {
+    "BASE": 11.027760,
+    "RSS_MAX": 41.621560,
+    "MYOPIC_GREEDY": 31.078504,
+    "U_FIRST": 31.028111,
+}
+SCALAR_EVALUATE_CALLS = 0
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def output_path(width: float) -> Path:
+    return OUTPUT_DIR / f"ceiling2-width-{width:.2f}.json"
+
+
+def atomic_write(path: Path, payload: dict) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    temporary.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(path)
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def resident_bytes() -> int:
+    for line in Path("/proc/self/status").read_text(encoding="ascii").splitlines():
+        if line.startswith("VmRSS:"):
+            return int(line.split()[1]) * 1024
+    raise RuntimeError("/proc/self/status omitted VmRSS")
+
+
+def start_rss_watchdog() -> None:
+    def monitor() -> None:
+        while True:
+            value = resident_bytes()
+            if value >= MAX_RSS_BYTES:
+                print(f"peak RSS hard-stop at {value} bytes", flush=True)
+                os._exit(86)
+            time.sleep(0.05)
+    threading.Thread(target=monitor, name="rss-watchdog", daemon=True).start()
+
+
+def check_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= 5_000_000_000:
+        raise MemoryError(f"peak RSS {peak_rss_bytes()} is not below 5 GB")
+
+
+def load_snapshot() -> dict[str, object]:
+    load1, load5, load15 = os.getloadavg()
+    return {
+        "unix_seconds": time.time(),
+        "load_average_1m": load1,
+        "load_average_5m": load5,
+        "load_average_15m": load15,
+        "logical_cpu_count": os.cpu_count(),
+    }
+
+
+def load_panel():
+    if sha256(PANEL_RUNNER) != PANEL_RUNNER_SHA256:
+        raise RuntimeError("hash-pinned PANELCEIL runner changed")
+    name = f"ceiling2_panelceil_{os.getpid()}"
+    spec = importlib.util.spec_from_file_location(name, PANEL_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot import PANELCEIL runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def forbid_scalar_evaluate(runner) -> None:
+    original = runner.StepEvaluator.evaluate
+
+    def forbidden(*args, **kwargs):
+        del args, kwargs
+        global SCALAR_EVALUATE_CALLS
+        SCALAR_EVALUATE_CALLS += 1
+        raise AssertionError("scalar StepEvaluator.evaluate is forbidden")
+
+    forbidden.__name__ = "scalar_evaluate_forbidden_on_clean_path"
+    forbidden.__wrapped__ = original
+    runner.StepEvaluator.evaluate = forbidden
+    assert runner.StepEvaluator.evaluate is forbidden
+
+
+def fresh_evaluator(runner, tape, step_index, incumbent, run_setting, field, boundaries):
+    return runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field=field, counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=boundaries,
+    )
+
+
+def configured(runner, base, mapping, kind: str):
+    return runner._configuration(base, mapping, kind=kind)
+
+
+def rss_max_configuration(runner, tape, step_index: int, base):
+    options, _ = runner._legal_options(tape, step_index)
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("exact panel omitted primitive arrays")
+    row_of = arrays._row_index()
+    mapping = {}
+    for user, identities in sorted(options.items()):
+        if not identities:
+            mapping[user] = None
+            continue
+        _, identity = min(enumerate(identities), key=lambda item: (
+            -float(arrays.nominal_gain[0, row_of[(user, item[1])]]), item[0]
+        ))
+        mapping[user] = identity
+    return configured(runner, base, mapping, "ceiling2-rss-max")
+
+
+@dataclass
+class SearchResult:
+    selected: object
+    at_10s: object
+    receipt: dict[str, object]
+    best_alternatives: dict[int, tuple[int, int]]
+
+
+def dense_search(panel, runner, calibration, tape, step_index, base, incumbent,
+                 run_setting, *, field: str, rule: str, converged: bool,
+                 kind: str) -> SearchResult:
+    """One arm, one fresh dense evaluator, no scalar reads."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field, (0,)
+    )
+    evaluator.evaluate_many((base,))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    if base_profile is None:
+        raise RuntimeError("dense BASE is invalid")
+    guard = panel.served(base_profile)
+    started = time.perf_counter()
+    options, census = runner._legal_options(tape, step_index)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    current = base
+    moves: list[tuple[float, object]] = [(0.0, base)]
+    passes = comparisons = submitted = 0
+    while True:
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = evaluator._evaluated.get(current.configuration_id)
+            if current_profile is None:
+                raise RuntimeError("current profile absent from dense cache")
+            current_value: Fraction = panel.objective(
+                runner, calibration, incumbent, current, current_profile, rekeys
+            )
+            candidates = tuple(
+                panel.candidate(runner, base, current, user, identity, kind)
+                for identity in options[user] if identity != current.mapping[user]
+            )
+            accepted = None
+            if rule == "first":
+                for offset in range(0, len(candidates), UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                    for row in batch:
+                        comparisons += 1
+                        profile = evaluator._evaluated.get(row.configuration_id)
+                        if profile is None or panel.served(profile) < guard:
+                            continue
+                        value = panel.objective(
+                            runner, calibration, incumbent, row, profile, rekeys
+                        )
+                        if value > current_value:
+                            accepted = row
+                            break
+                    if accepted is not None:
+                        break
+            elif rule == "best":
+                for offset in range(0, len(candidates), UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                eligible = [(current_value, current.configuration_id, current)]
+                for row in candidates:
+                    comparisons += 1
+                    profile = evaluator._evaluated.get(row.configuration_id)
+                    if profile is None or panel.served(profile) < guard:
+                        continue
+                    value = panel.objective(
+                        runner, calibration, incumbent, row, profile, rekeys
+                    )
+                    if not converged or value > current_value:
+                        eligible.append((value, row.configuration_id, row))
+                selected = min(eligible, key=lambda item: (-item[0], item[1]))[2]
+                if selected.mapping[user] != current.mapping[user]:
+                    accepted = selected
+            else:
+                raise ValueError(rule)
+            if accepted is not None:
+                current = accepted
+                moves_this_pass += 1
+                moves.append((time.perf_counter() - started, current))
+        passes += 1
+        if not converged or moves_this_pass == 0:
+            break
+        if passes > 100:
+            raise RuntimeError("search exceeded 100 passes")
+    at_10s = base
+    for accepted_seconds, config in moves:
+        if accepted_seconds > 10.0:
+            break
+        at_10s = config
+    best_alternatives = {}
+    if rule == "first" and converged:
+        for user in sorted(options):
+            rows = []
+            for identity in options[user]:
+                if identity == current.mapping[user]:
+                    continue
+                row = panel.candidate(
+                    runner, base, current, user, identity,
+                    "ceiling2-terminal-alternate",
+                )
+                profile = evaluator._evaluated.get(row.configuration_id)
+                if profile is not None:
+                    rows.append((
+                        panel.objective(
+                            runner, calibration, incumbent, row, profile, rekeys
+                        ),
+                        row.configuration_id,
+                        identity,
+                    ))
+            if rows:
+                best_alternatives[user] = min(
+                    rows, key=lambda item: (-item[0], item[1])
+                )[2]
+    receipt = {
+        "field": field,
+        "rule": rule,
+        "passes_mode": "converged" if converged else "one",
+        "moves": len(moves) - 1,
+        "passes_including_certificate": passes,
+        "guard": guard,
+        "comparisons": comparisons,
+        "submitted_candidate_slots": submitted,
+        "legal_option_census": census,
+        "selection_seconds": time.perf_counter() - started,
+        "last_move_seconds": moves[-1][0],
+        "moves_completed_by_10s": sum(seconds <= 10.0 for seconds, _ in moves[1:]),
+        "base_entered_via_evaluate_many_before_profile_read": True,
+        "one_fresh_dense_evaluator": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return SearchResult(current, at_10s, receipt, best_alternatives)
+
+
+def evaluate_batches(evaluator, rows: Sequence[object], size: int) -> None:
+    for offset in range(0, len(rows), size):
+        evaluator.evaluate_many(rows[offset:offset + size])
+
+
+def candidate_key(config) -> tuple:
+    return tuple(config.assignments)
+
+
+def changed_users(seed, config) -> tuple[int, ...]:
+    return tuple(
+        user for user in sorted(seed.mapping)
+        if seed.mapping[user] != config.mapping[user]
+    )
+
+
+def panel_bounded_joint_search(panel, runner, calibration, tape, step_index,
+                               base, incumbent, run_setting,
+                               first: SearchResult) -> tuple[object, dict]:
+    """Recompute PANELCEIL's quoted bounded joint selector on the clean path."""
+    started = time.perf_counter()
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    evaluator.evaluate_many((base, first.selected))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    seed_profile = evaluator._evaluated.get(first.selected.configuration_id)
+    if base_profile is None or seed_profile is None:
+        raise RuntimeError("BASE or U_FIRST is invalid for PANELCEIL joint selector")
+    guard = panel.served(base_profile)
+    candidates, aliases, families = panel.build_joint_candidates(
+        runner, tape, step_index, base, first.selected,
+        first.best_alternatives,
+    )
+    evaluate_batches(evaluator, candidates, JOINT_BATCH_SIZE)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    seed_value = panel.objective(
+        runner, calibration, incumbent, first.selected, seed_profile, rekeys
+    )
+    best = first.selected
+    best_profile = seed_profile
+    qualifying = 0
+    for row in candidates:
+        profile = evaluator._evaluated.get(row.configuration_id)
+        if profile is None or panel.served(profile) < guard:
+            continue
+        value = panel.objective(
+            runner, calibration, incumbent, row, profile, rekeys
+        )
+        if value > seed_value:
+            qualifying += 1
+        best_value = panel.objective(
+            runner, calibration, incumbent, best, best_profile, rekeys
+        )
+        if value > best_value or (
+            value == best_value and best is not first.selected
+            and row.configuration_id < best.configuration_id
+        ):
+            best, best_profile = row, profile
+    changed = changed_users(first.selected, best)
+    receipt = {
+        "catalogue_object": "PANELCEIL custom U_FIRST-local bounded catalogue",
+        "construction": (
+            "within-beam occupant subsets size 2..4 capped at 1024; victim plus "
+            "top-2/top-3 contributors; all common-destination complete-beam evacuations"
+        ),
+        "catalogue_unique": len(candidates),
+        "catalogue_aliases": sum(len(value) for value in aliases.values()),
+        "family_unique_counts": families,
+        "catalogue_exhausted": True,
+        "joint_candidate_cap": panel.JOINT_CANDIDATE_CAP,
+        "strict_improvement": best is not first.selected and panel.objective(
+            runner, calibration, incumbent, best, best_profile, rekeys
+        ) > seed_value,
+        "qualifying_rows": qualifying,
+        "winning_changed_set_size": len(changed),
+        "winning_changed_users": list(changed),
+        "wall_seconds": time.perf_counter() - started,
+        "one_fresh_dense_evaluator": True,
+        "base_and_seed_entered_via_evaluate_many_before_reads": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return best, receipt
+
+
+def support_catalogue_search(panel, runner, calibration, tape, step_index, base,
+                             incumbent, run_setting, seed) -> tuple[dict[int, object], dict]:
+    """Generalise the bounded top-10/top-2 catalogue from pairs through size 6.
+
+    Complete beam evacuations are included at every support level as the one
+    explicit exception to the cardinality cap requested by the experiment.
+    """
+    started = time.perf_counter()
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    evaluator.evaluate_many((base, seed))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    seed_profile = evaluator._evaluated.get(seed.configuration_id)
+    if base_profile is None or seed_profile is None:
+        raise RuntimeError("BASE or U_FIRST seed is invalid")
+    guard = panel.served(base_profile)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    seed_value = panel.objective(
+        runner, calibration, incumbent, seed, seed_profile, rekeys
+    )
+
+    shortlist, shortlist_census = runner._selection_shortlist(
+        tape, step_index, run_setting=run_setting
+    )
+    unilaterals: dict[int, list[object]] = {user: [] for user in sorted(shortlist)}
+    unique_ids = {seed.configuration_id}
+
+    def add(config) -> bool:
+        if config.configuration_id in unique_ids:
+            return False
+        unique_ids.add(config.configuration_id)
+        return True
+
+    for user in sorted(shortlist):
+        for identity in shortlist[user]:
+            if identity == seed.mapping[user]:
+                continue
+            mapping = dict(seed.mapping)
+            mapping[user] = identity
+            row = configured(runner, base, mapping, "ceiling2-unilateral")
+            if add(row):
+                unilaterals[user].append(row)
+    unilateral_rows = tuple(row for rows in unilaterals.values() for row in rows)
+    evaluate_batches(evaluator, unilateral_rows, JOINT_BATCH_SIZE)
+
+    best_surplus = {}
+    for user in sorted(unilaterals):
+        values = []
+        for row in unilaterals[user]:
+            profile = evaluator._evaluated.get(row.configuration_id)
+            if profile is None or panel.served(profile) < guard:
+                continue
+            values.append(panel.objective(
+                runner, calibration, incumbent, row, profile, rekeys
+            ) - seed_value)
+        best_surplus[user] = max(values, default=Fraction(-10**30))
+    ranked_users = tuple(sorted(
+        unilaterals, key=lambda user: (-best_surplus[user], user)
+    )[:TOP_K_USERS])
+
+    # Preserve the production bounded-catalogue proposal semantics: each of
+    # the selected top-K users contributes its first two declared shortlist
+    # alternatives, while this experiment generalises the pair combination.
+    proposals = {
+        user: tuple(unilaterals[user][:TOP_OPTIONS_PER_USER])
+        for user in ranked_users
+    }
+
+    evacuation_rows_list = []
+    for beam in sorted({identity for identity in seed.mapping.values() if identity is not None}):
+        mapping = dict(seed.mapping)
+        affected = [user for user in sorted(seed.mapping) if seed.mapping[user] == beam]
+        for user in affected:
+            mapping[user] = next(
+                (identity for identity in shortlist[user] if identity != beam), None
+            )
+        if mapping != seed.mapping:
+            row = configured(runner, base, mapping, "ceiling2-beam-evacuation")
+            if add(row):
+                evacuation_rows_list.append(row)
+    evacuation_rows = tuple(sorted(
+        evacuation_rows_list, key=lambda row: row.configuration_id
+    ))
+    evaluate_batches(evaluator, evacuation_rows, JOINT_BATCH_SIZE)
+
+    best = seed
+    best_profile = seed_profile
+    qualifying = 0
+    evaluated_ids: set[str] = set()
+
+    def consider(rows: Sequence[object]) -> None:
+        nonlocal best, best_profile, qualifying
+        for row in rows:
+            if row.configuration_id in evaluated_ids:
+                continue
+            evaluated_ids.add(row.configuration_id)
+            profile = evaluator._evaluated.get(row.configuration_id)
+            if profile is None or panel.served(profile) < guard:
+                continue
+            value = panel.objective(
+                runner, calibration, incumbent, row, profile, rekeys
+            )
+            if value > seed_value:
+                qualifying += 1
+            best_value = panel.objective(
+                runner, calibration, incumbent, best, best_profile, rekeys
+            )
+            if value > best_value or (
+                value == best_value and best is not seed
+                and row.configuration_id < best.configuration_id
+            ):
+                best, best_profile = row, profile
+
+    def drop_profiles(rows: Sequence[object]) -> None:
+        keep = {
+            base.configuration_id, seed.configuration_id,
+            best.configuration_id,
+        }
+        for row in rows:
+            if row.configuration_id not in keep:
+                evaluator._evaluated.pop(row.configuration_id, None)
+
+    consider(unilateral_rows)
+    consider(evacuation_rows)
+    drop_profiles(unilateral_rows)
+    drop_profiles(evacuation_rows)
+    selected: dict[int, object] = {}
+    levels = {}
+    cumulative_rows = 1 + len(evaluated_ids)
+    selected[1] = best
+    levels[1] = {
+        "catalogue_rows": cumulative_rows,
+        "row_cap": CATALOGUE_ROW_CAP_PER_ANCHOR,
+        "exhausted": cumulative_rows <= CATALOGUE_ROW_CAP_PER_ANCHOR,
+        "truncated": False,
+        "strict_improvement": best is not seed and panel.objective(
+            runner, calibration, incumbent, best, best_profile, rekeys
+        ) > seed_value,
+        "winning_changed_set_size": len(changed_users(seed, best)),
+        "winning_configuration_id": best.configuration_id,
+        "qualifying_rows": qualifying,
+        "cumulative_wall_seconds": time.perf_counter() - started,
+    }
+
+    for size in range(2, max(SUPPORT_LEVELS) + 1):
+        size_rows = []
+        for coalition in itertools.combinations(ranked_users, size):
+            if any(not proposals[user] for user in coalition):
+                continue
+            for choices in itertools.product(*(proposals[user] for user in coalition)):
+                mapping = dict(seed.mapping)
+                for user, proposal in zip(coalition, choices, strict=True):
+                    mapping[user] = proposal.mapping[user]
+                row = configured(runner, base, mapping, f"ceiling2-coalition-{size}")
+                if add(row):
+                    size_rows.append(row)
+        # The declared cap is applied to each cumulative support level.  A
+        # deterministic configuration-ID prefix would be used if it binds.
+        remaining = CATALOGUE_ROW_CAP_PER_ANCHOR - cumulative_rows
+        ordered = tuple(sorted(size_rows, key=lambda row: row.configuration_id))
+        truncated = len(ordered) > max(0, remaining)
+        admitted = ordered[:max(0, remaining)]
+        for offset in range(0, len(admitted), JOINT_BATCH_SIZE):
+            batch = admitted[offset:offset + JOINT_BATCH_SIZE]
+            evaluator.evaluate_many(batch)
+            consider(batch)
+            drop_profiles(batch)
+        cumulative_rows += len(admitted)
+        if size in SUPPORT_LEVELS:
+            selected[size] = best
+            levels[size] = {
+                "catalogue_rows": cumulative_rows,
+                "row_cap": CATALOGUE_ROW_CAP_PER_ANCHOR,
+                "exhausted": not truncated,
+                "truncated": truncated,
+                "strict_improvement": best is not seed and panel.objective(
+                    runner, calibration, incumbent, best, best_profile, rekeys
+                ) > seed_value,
+                "winning_changed_set_size": len(changed_users(seed, best)),
+                "winning_configuration_id": best.configuration_id,
+                "qualifying_rows": qualifying,
+                "new_rows_at_size": len(admitted),
+                "uncapped_new_rows_at_size": len(ordered),
+                "cumulative_wall_seconds": time.perf_counter() - started,
+            }
+        if truncated:
+            # Higher supports have no remaining rows under the cumulative cap.
+            for requested in SUPPORT_LEVELS:
+                if requested > size:
+                    selected[requested] = best
+                    levels[requested] = {
+                        **levels[size],
+                        "exhausted": False,
+                        "truncated": True,
+                        "support_requested": requested,
+                        "truncation_bound_at_size": size,
+                    }
+            break
+
+    receipt = {
+        "construction": (
+            "U_FIRST seed; every shortlisted unilateral; top-10 users ranked by "
+            "exact realised guarded unilateral surplus in the same evaluator; first "
+            "two declared shortlist alternatives per ranked user combined through "
+            "the requested support; complete beam evacuations at every level"
+        ),
+        "support_cap_exception": "complete beam evacuations are included at every level",
+        "top_k_users": list(ranked_users),
+        "top_k": TOP_K_USERS,
+        "top_options_per_user": TOP_OPTIONS_PER_USER,
+        "shortlist_census": shortlist_census,
+        "unilateral_rows": len(unilateral_rows),
+        "beam_evacuation_rows": len(evacuation_rows),
+        "levels": levels,
+        "guard": guard,
+        "one_fresh_dense_evaluator": True,
+        "base_and_seed_entered_via_evaluate_many_before_reads": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+        "wall_seconds": time.perf_counter() - started,
+    }
+    del evaluator
+    gc.collect()
+    return selected, receipt
+
+
+def endpoint_metrics(panel, runner, tape, step_index, incumbent, run_setting,
+                     configs: Mapping[str, object]) -> dict[str, dict[str, object]]:
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting,
+        "realised", tuple(range(48)),
+    )
+    evaluator.evaluate_many(tuple(configs.values()))
+    result = {}
+    for name, config in configs.items():
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is None:
+            raise RuntimeError(f"invalid endpoint config for {name}")
+        result[name] = panel.metric(profile)
+    del evaluator
+    gc.collect()
+    return result
+
+
+def pool(anchors: Sequence[Mapping[str, object]], name: str) -> dict[str, object]:
+    metrics = [row["committed"][name] for row in anchors]
+    bits = math.fsum(float(row["bits"]) for row in metrics)
+    joules = math.fsum(float(row["joules"]) for row in metrics)
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_mbit_per_j": bits / joules / 1e6,
+        "served_count": sum(int(row["served_count"]) for row in metrics),
+        "rate_target_attained_count": sum(
+            int(row["rate_target_attained_count"]) for row in metrics
+        ),
+        "user_count": sum(int(row["user_count"]) for row in metrics),
+    }
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    names = (
+        "BASE", "RSS_MAX", "MYOPIC_GREEDY", "U_FIRST", "U_BEST",
+        "U_FIRST_AT_10", "J_PANEL_BOUNDED",
+        *(f"JOINT_K{k}" for k in SUPPORT_LEVELS),
+    )
+    pooled = {name: pool(anchors, name) for name in names}
+    support = {}
+    for k in SUPPORT_LEVELS:
+        details = []
+        for row in anchors:
+            levels = row["support_catalogue"]["levels"]
+            details.append(levels[k] if k in levels else levels[str(k)])
+        joint_name = f"JOINT_K{k}"
+        support[str(k)] = {
+            "coordination_ceiling": (
+                pooled[joint_name]["ee_mbit_per_j"] / pooled["U_FIRST"]["ee_mbit_per_j"] - 1.0
+            ),
+            "catalogue_rows_total": sum(int(row["catalogue_rows"]) for row in details),
+            "catalogue_rows_mean_per_anchor": math.fsum(
+                float(row["catalogue_rows"]) for row in details
+            ) / len(details),
+            "catalogue_rows_range_per_anchor": [
+                min(int(row["catalogue_rows"]) for row in details),
+                max(int(row["catalogue_rows"]) for row in details),
+            ],
+            "strict_improvement_anchor_count": sum(bool(row["strict_improvement"]) for row in details),
+            "mean_winning_changed_set_size": math.fsum(
+                float(row["winning_changed_set_size"]) for row in details
+            ) / len(details),
+            "mean_winning_changed_set_size_given_improvement": (
+                math.fsum(
+                    float(row["winning_changed_set_size"])
+                    for row in details if row["strict_improvement"]
+                ) / max(1, sum(bool(row["strict_improvement"]) for row in details))
+            ),
+            "wall_seconds_total": math.fsum(float(row["cumulative_wall_seconds"]) for row in details),
+            "wall_seconds_mean_per_anchor": math.fsum(
+                float(row["cumulative_wall_seconds"]) for row in details
+            ) / len(details),
+            "all_catalogues_exhausted": all(bool(row["exhausted"]) for row in details),
+            "any_catalogue_truncated": any(bool(row["truncated"]) for row in details),
+            "row_cap_per_anchor": CATALOGUE_ROW_CAP_PER_ANCHOR,
+        }
+    return {
+        "pooled": pooled,
+        "coordination_ceiling_panel_bounded": (
+            pooled["J_PANEL_BOUNDED"]["ee_mbit_per_j"] / pooled["U_FIRST"]["ee_mbit_per_j"] - 1.0
+        ),
+        "traversal_order_gap_first_over_best": (
+            pooled["U_FIRST"]["ee_mbit_per_j"] / pooled["U_BEST"]["ee_mbit_per_j"] - 1.0
+        ),
+        "acceleration_headroom_first_over_10s": (
+            pooled["U_FIRST"]["ee_mbit_per_j"] / pooled["U_FIRST_AT_10"]["ee_mbit_per_j"] - 1.0
+        ),
+        "support": support,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--width", type=float, choices=WIDTHS, required=True)
+    args = parser.parse_args()
+    check_runtime()
+    resource.setrlimit(resource.RLIMIT_RSS, (MAX_RSS_BYTES, MAX_RSS_BYTES))
+    start_rss_watchdog()
+    overall_started = time.perf_counter()
+    panel = load_panel()
+    clean = json.loads(CLEAN_RECEIPT.read_text(encoding="utf-8"))
+    if clean.get("status") != "COMPLETE" or clean.get("receipt_sha256") != canonical_digest(clean):
+        raise RuntimeError("clean-path receipt is absent, incomplete, or digest-invalid")
+    frozen = clean.get("panel")
+    if not isinstance(frozen, list) or len(frozen) != 12:
+        raise RuntimeError("clean receipt omitted the 12 frozen development anchors")
+
+    pilot = panel.load_pilot()
+    runner = pilot.ENGINE
+    calibration = panel.load_calibration(pilot)
+    run_setting = runner.run_setting_for("a-r0")
+    forbid_scalar_evaluate(runner)
+    from mcrl.physics_v025 import channel
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+    channel.TX_FULL_HPBW_DEG = 2.0 * args.width
+
+    print(
+        f"DESIGN-PHASE EXPLORATION width={args.width:.2f} deg; "
+        f"peak RSS cap={MAX_RSS_BYTES} bytes",
+        flush=True,
+    )
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    tape_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33, start_time_s=0.0,
+    )
+    tape_seconds = time.perf_counter() - tape_started
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)
+
+    path = output_path(args.width)
+    payload = {
+        "schema": "mcrl-v025-ceiling2-clean-and-levers-v1",
+        "status": "RUNNING",
+        "claim_status": "DESIGN_PHASE_EXPLORATION_NOT_A_CLAIM",
+        "one_sided_half_power_deg": args.width,
+        "full_hpbw_deg_runtime_override": 2.0 * args.width,
+        "sealed_design_point_changed": False,
+        "panel": frozen,
+        "panel_count": len(frozen),
+        "development_anchors_only": True,
+        "evaluation_only_claim_dates_read": False,
+        "numerator": "full-buffer successfully decoded forward-downlink information bits; no demand cap",
+        "selection_path": {
+            "fresh_evaluator_per_arm_and_anchor": True,
+            "boundary_indices": [0],
+            "dense_evaluate_many_only": True,
+            "base_in_same_evaluator": True,
+            "foreign_cache_reads": False,
+            "scalar_evaluate_fail_closed": True,
+        },
+        "endpoint_path": {
+            "one_separate_fresh_realised_evaluator_per_anchor": True,
+            "boundary_indices": list(range(48)),
+            "one_evaluate_many_call_for_all_selected_configs": True,
+        },
+        "support_catalogue": {
+            "support_levels": list(SUPPORT_LEVELS),
+            "top_k_users": TOP_K_USERS,
+            "top_options_per_user": TOP_OPTIONS_PER_USER,
+            "row_cap_per_anchor": CATALOGUE_ROW_CAP_PER_ANCHOR,
+            "beam_evacuations_included_at_every_level": True,
+            "global_top_rank_proposals_excluded": True,
+            "reason": "the requested sweep isolates cardinality support plus the explicitly requested complete beam evacuations",
+            "catalogue_object_distinction": (
+                "This nested top-10/top-2 diagnostic follows the production C3 bounded-catalogue "
+                "semantics. The separately reported PANELCEIL coordination ceiling uses a "
+                "different U_FIRST-local catalogue with occupant/contributor families."
+            ),
+        },
+        "process_count": 1,
+        "python": sys.executable,
+        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+        "rss_watchdog_bytes": MAX_RSS_BYTES,
+        "load_start": load_snapshot(),
+        "world_tape": {
+            "domain": tape.domain, "seed": tape.seed, "digest": tape.digest,
+            "construction_seconds": tape_seconds,
+        },
+        "panel_runner": str(PANEL_RUNNER),
+        "panel_runner_sha256": sha256(PANEL_RUNNER),
+        "clean_receipt": str(CLEAN_RECEIPT),
+        "clean_receipt_sha256": clean["receipt_sha256"],
+        "anchors": [],
+    }
+
+    for position, panel_row in enumerate(frozen, 1):
+        index = int(panel_row["global_anchor_index"])
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        anchor_started = time.perf_counter()
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        rss = rss_max_configuration(runner, tape, step_index, base)
+        myopic = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, field="nominal", rule="best", converged=False,
+            kind="ceiling2-myopic-greedy",
+        )
+        first = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, field="realised", rule="first", converged=True,
+            kind="ceiling2-first-improvement",
+        )
+        best = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, field="realised", rule="best", converged=True,
+            kind="ceiling2-best-improvement",
+        )
+        panel_joint, panel_joint_receipt = panel_bounded_joint_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, first,
+        )
+        joint, joint_receipt = support_catalogue_search(
+            panel, runner, calibration, tape, step_index, base, incumbent,
+            run_setting, first.selected,
+        )
+        configs = {
+            "BASE": base,
+            "RSS_MAX": rss,
+            "MYOPIC_GREEDY": myopic.selected,
+            "U_FIRST": first.selected,
+            "U_BEST": best.selected,
+            "U_FIRST_AT_10": first.at_10s,
+            "J_PANEL_BOUNDED": panel_joint,
+            **{f"JOINT_K{k}": joint[k] for k in SUPPORT_LEVELS},
+        }
+        committed = endpoint_metrics(
+            panel, runner, tape, step_index, incumbent, run_setting, configs
+        )
+        row = {
+            "global_anchor_index": index,
+            "anchor_id": f"{panel_row['world_id']}|{step_index}|{carrier}",
+            "step_index": step_index,
+            "carrier": carrier,
+            "search": {
+                "MYOPIC_GREEDY": myopic.receipt,
+                "U_FIRST": first.receipt,
+                "U_BEST": best.receipt,
+            },
+            "panel_bounded_joint": panel_joint_receipt,
+            "support_catalogue": joint_receipt,
+            "committed": committed,
+            "anchor_wall_seconds": time.perf_counter() - anchor_started,
+            "load_end": load_snapshot(),
+            "peak_rss_bytes": peak_rss_bytes(),
+        }
+        payload["anchors"].append(row)
+        payload["summary"] = summarize(payload["anchors"])
+        payload["peak_rss_bytes"] = peak_rss_bytes()
+        check_runtime()
+        atomic_write(path, payload)
+        print(
+            f"anchor {position}/{len(frozen)} completed peak RSS "
+            f"{peak_rss_bytes()/2**30:.3f} GiB "
+            + json.dumps({
+                "global": index,
+                "first_moves": first.receipt["moves"],
+                "best_moves": best.receipt["moves"],
+                "k2_rows": joint_receipt["levels"][2]["catalogue_rows"],
+                "k6_rows": joint_receipt["levels"][6]["catalogue_rows"],
+                "wall_s": round(row["anchor_wall_seconds"], 3),
+            }, sort_keys=True),
+            flush=True,
+        )
+
+    payload["summary"] = summarize(payload["anchors"])
+    payload["scalar_evaluate_calls"] = SCALAR_EVALUATE_CALLS
+    assert SCALAR_EVALUATE_CALLS == 0
+    payload["scalar_evaluate_assertion_passed"] = True
+    if args.width == 1.66:
+        parity = {}
+        for name, expected in EXPECTED_166.items():
+            measured = float(payload["summary"]["pooled"][name]["ee_mbit_per_j"])
+            passed = f"{measured:.6f}" == f"{expected:.6f}"
+            parity[name] = {"expected": expected, "measured": measured, "six_decimal_pass": passed}
+            if not passed:
+                raise AssertionError(f"mandatory parity failed for {name}: {measured} != {expected}")
+        payload["mandatory_clean_parity"] = parity
+        payload["mandatory_clean_parity_passed"] = True
+    payload["status"] = "COMPLETE"
+    payload["load_end"] = load_snapshot()
+    payload["wall_seconds"] = time.perf_counter() - overall_started
+    payload["peak_rss_bytes"] = peak_rss_bytes()
+    payload["runner_sha256"] = sha256(Path(__file__))
+    atomic_write(path, payload)
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(f"scalar_evaluate_calls={SCALAR_EVALUATE_CALLS}", flush=True)
+    print(json.dumps(payload["summary"], sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
