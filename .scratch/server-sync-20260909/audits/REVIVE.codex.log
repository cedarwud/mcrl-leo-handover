   799	    actions: np.ndarray
   800	    base_actions: np.ndarray
   801	    profile_id: str
   802	    catalog_size: int
   803	    counts: Mapping[str, int]
   804	    nominal: Mapping[str, object] = field(default_factory=dict)
   805	    phase_wall_seconds: Mapping[str, float] = field(default_factory=dict)
   806	    unique_nominal_evaluations: int = 0
