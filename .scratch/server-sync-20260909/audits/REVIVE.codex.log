   588	
   589	def _copy_grid(grid: Any) -> Any:
   590	    copied = copy.deepcopy(grid)
   591	    for definition in fields(copied):
   592	        value = getattr(copied, definition.name)
   593	        if isinstance(value, np.ndarray):
   594	            value.setflags(write=False)
   595	    return copied
   596	
   597	
   598	def _freeze_nested_arrays(value: object) -> None:
   599	    """Make every copied ndarray in a capability-free snapshot read-only."""
   600	
   601	    seen: set[int] = set()
   602	
   603	    def visit(item: object) -> None:
   604	        if isinstance(item, np.ndarray):
   605	            item.setflags(write=False)
   606	            return
   607	        if item is None or isinstance(item, (bool, int, float, str, bytes, np.generic)):
   608	            return
   609	        identity = id(item)
   610	        if identity in seen:
   611	            return
   612	        seen.add(identity)
   613	        if isinstance(item, Mapping):
   614	            children = tuple(item.items())
   615	        elif isinstance(item, (tuple, list, set, frozenset)):
   616	            children = tuple(enumerate(item))
   617	        elif is_dataclass(item):
   618	            children = tuple(
   619	                (definition.name, getattr(item, definition.name))
   620	                for definition in fields(item)
   621	            )
   622	        elif hasattr(item, "__dict__"):
   623	            children = tuple(vars(item).items())
   624	        else:
   625	            children = ()
   626	        for _name, child in children:
   627	            visit(child)
   628	
   629	    visit(value)
