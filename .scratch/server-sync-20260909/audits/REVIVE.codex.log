   903	def _real_decision(
   904	    snapshot: DecisionSnapshot, evaluator: NominalSnapshotEvaluator,
   905	) -> DecisionResult:
   906	    phases: dict[str, float] = {"q_inference": snapshot.q_inference_seconds}
   907	    catalog_started = time.perf_counter()
   908	    catalog = build_s0_catalog(
   909	        snapshot=snapshot, evaluator=evaluator, timing_out=phases,
   910	    )
   911	    phases["catalog_total"] = time.perf_counter() - catalog_started
   912	    unique_nominal_evaluations = int(phases.pop("unique_nominal_evaluations"))
   913	    selection_started = time.perf_counter()
   914	    selected = select_candidate(catalog, eta_ref=snapshot.eta_ref)
   915	    phases["selection"] = time.perf_counter() - selection_started
   916	    counts = {
   917	        kind: sum(row["kind"] == kind for row in catalog)
   918	        for kind in ("base", "unilateral", "joint")
   919	    }
   920	    return DecisionResult(
   921	        actions=np.asarray(selected["actions"], dtype=np.int64),
   922	        base_actions=np.asarray(snapshot.base_actions, dtype=np.int64),
   923	        profile_id=str(selected["profile_id"]),
   924	        catalog_size=len(catalog),
   925	        counts=counts,
   926	        nominal=dict(selected["nominal"]),
   927	        phase_wall_seconds=phases,
   928	        unique_nominal_evaluations=unique_nominal_evaluations,
   929	    )
