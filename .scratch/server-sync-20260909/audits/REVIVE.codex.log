   545	@dataclass(frozen=True)
   546	class DecisionSnapshot:
   547	    """The complete and capability-free §2 coordinator input."""
   548	
   549	    native_state_matrix: np.ndarray
   550	    legal_masks: np.ndarray
   551	    slot_physical_keys: np.ndarray
   552	    q12_proposal: np.ndarray
   553	    base_actions: np.ndarray
   554	    candidates: FrozenCandidates
   555	    committed_association: tuple[Any, ...]
   556	    committed_segments: tuple[Any, ...]
   557	    committed_radiating: Any
   558	    tracking_state: tuple[Any, Any]
   559	    interval_s: float
   560	    catalog: Catalog
   561	    eta_ref: Fraction
   562	    q_inference_seconds: float
   563	
   564	    def verify(self) -> str:
   565	        arrays = (
   566	            self.native_state_matrix, self.legal_masks, self.slot_physical_keys,
   567	            self.q12_proposal, self.base_actions,
   568	        )
   569	        users = self.legal_masks.shape[0]
   570	        if (
   571	            self.native_state_matrix.ndim != 2
   572	            or self.legal_masks.dtype != np.bool_
   573	            or self.legal_masks.shape != (users, f1.NUM_ACTIONS)
   574	            or self.slot_physical_keys.shape != (users, f1.NUM_ACTIONS, 2)
   575	            or self.q12_proposal.dtype != np.float32
   576	            or self.q12_proposal.shape != self.legal_masks.shape
   577	            or self.base_actions.shape != (users,)
   578	            or any(array.flags.writeable for array in arrays)
   579	            or not np.all(np.isfinite(self.native_state_matrix))
   580	            or not np.all(np.isfinite(self.q12_proposal))
   581	            or not math.isfinite(self.interval_s) or self.interval_s <= 0
   582	            or not math.isfinite(self.q_inference_seconds) or self.q_inference_seconds < 0
   583	        ):
   584	            raise C3SPolicyError("pre-decision coordinator snapshot is malformed or mutable")
   585	        _assert_no_prohibited_capabilities(self)
   586	        return _structural_sha256(self)
