   879	            "profile_counts": dict(result.counts),
   880	            "selected_profile_id": result.profile_id,
   881	            "selected_nominal": {
   882	                "total_bits_hex": float(result.nominal["total_bits"]).hex(),
   883	                "total_energy_j_hex": float(result.nominal["total_energy_j"]).hex(),
   884	                "served": int(result.nominal["served"]),
   885	                "opportunities": int(result.nominal["opportunities"]),
   886	            } if result.nominal else None,
   887	            "action_changed": not np.array_equal(actions, base),
   888	            "nominal_convention": NOMINAL_CONVENTION,
   889	            "phase_wall_seconds_hex": {
