   229	
   230	def nominal_score(metric: Mapping[str, object], eta_ref: Fraction) -> Fraction:
   231	    parsed = _metric(metric, label="nominal")
   232	    return (
   233	        Fraction.from_float(float(parsed["total_bits"]))
   234	        - eta_ref * Fraction.from_float(float(parsed["total_energy_j"]))
   235	    )
   236	
   237	
   238	def _tie_key(row: Mapping[str, object]) -> tuple[int, ...]:
   239	    profile_id = str(row.get("profile_id", ""))
   240	    if profile_id == "BASE":
   241	        return (0,)
   242	    explicit = row.get("tie_key")
   243	    if isinstance(explicit, tuple) and explicit and all(type(value) is int for value in explicit):
   244	        return explicit
   245	    try:
   246	        if profile_id.startswith("U:"):
   247	            _prefix, user, action = profile_id.split(":")
   248	            return (1, int(user), int(action))
   249	        if profile_id.startswith("J:"):
   250	            origin, destination = profile_id[2:].split("->")
   251	            origin_satellite, origin_cell = origin.split(":")
   252	            destination_satellite, destination_cell = destination.split(":")
   253	            return (
   254	                2, int(origin_satellite), int(origin_cell),
   255	                int(destination_satellite), int(destination_cell),
   256	            )
   257	    except (TypeError, ValueError):
   258	        pass
   259	    raise C3SPolicyError(f"{profile_id} lacks the fixed S0 tuple tie key")
   260	
   261	
   262	def select_candidate(
   263	    candidates: Sequence[Mapping[str, object]], *, eta_ref: Fraction,
   264	) -> Mapping[str, object]:
   265	    """Apply S0 exactly: service guard, exact score, BASE-first lexical ties."""
   266	
   267	    if not candidates:
   268	        raise C3SPolicyError("candidate catalog is empty")
   269	    base_rows = [row for row in candidates if row.get("profile_id") == "BASE"]
   270	    if len(base_rows) != 1 or candidates[0].get("profile_id") != "BASE":
   271	        raise C3SPolicyError("catalog must contain BASE exactly once and first")
   272	    base_nominal = base_rows[0].get("nominal")
   273	    if not isinstance(base_nominal, Mapping):
   274	        raise C3SPolicyError("BASE nominal metric is absent")
   275	    base_metric = _metric(base_nominal, label="BASE nominal")
   276	    threshold = int(base_metric["served"])
   277	    seen: set[str] = set()
   278	    eligible: list[tuple[Fraction, tuple[int, ...], Mapping[str, object]]] = []
   279	    for row in candidates:
   280	        profile_id = row.get("profile_id")
   281	        nominal = row.get("nominal")
   282	        actions = np.asarray(row.get("actions"))
   283	        if not isinstance(profile_id, str) or not profile_id or profile_id in seen:
   284	            raise C3SPolicyError("catalog profile IDs are malformed or duplicated")
   285	        seen.add(profile_id)
   286	        if not isinstance(nominal, Mapping):
   287	            raise C3SPolicyError(f"{profile_id} nominal metric is absent")
   288	        parsed = _metric(nominal, label=f"{profile_id} nominal")
   289	        if parsed["opportunities"] != base_metric["opportunities"]:
   290	            raise C3SPolicyError("candidate opportunity count differs from BASE")
   291	        if actions.ndim != 1 or actions.dtype.kind not in "iu":
   292	            raise C3SPolicyError(f"{profile_id} action vector is malformed")
   293	        if int(parsed["served"]) >= threshold:
   294	            eligible.append((nominal_score(parsed, eta_ref), _tie_key(row), row))
   295	    if not eligible:
   296	        raise C3SPolicyError("nominal service guard has no feasible candidate")
   297	    best = max(row[0] for row in eligible)
   298	    return min((row for row in eligible if row[0] == best), key=lambda row: row[1])[2]
   299	
   300	
   301	def _metric_from_e1_payload(payload: object, *, label: str) -> dict[str, object]:
   302	    try:
   303	        return s0.metric_from_tape(payload, label=label)
   304	    except s0.ProbeError as error:
   305	        raise C3SPolicyError(str(error)) from error
