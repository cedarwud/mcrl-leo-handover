  1997	def _s0_select(
  1998	    tape: ExogenousWorldTape,
  1999	    setting: PhysicsSetting,
  2000	    step_index: int,
  2001	    base: Configuration,
  2002	    catalog: Sequence[Configuration],
  2003	    counter: EvaluationCounter,
  2004	    run_setting: SealedRunSetting | None = None,
  2005	) -> tuple[Configuration, tuple[str, ...], Configuration]:
  2006	    nominal_evaluator = StepEvaluator(
  2007	        tape,
  2008	        setting,
  2009	        step_index,
  2010	        transition_from=base,
  2011	        cell_rekeyed_users=_rekeyed_users(tape, step_index),
  2012	        field="nominal",
  2013	        counter=counter,
  2014	        run_setting=run_setting,
  2015	    )
  2016	    nominal_profiles = {
  2017	        row.configuration_id: nominal_evaluator.evaluate(row) for row in catalog
  2018	    }
  2019	    unilateral = [row for row in catalog if row.changed_users == 1]
  2020	    top_ids = []
  2021	    for user, _ in base.assignments:
  2022	        proposals = [row for row in unilateral if dict(row.assignments)[user] != dict(base.assignments)[user]]
  2023	        ranked = sorted(
  2024	            proposals,
  2025	            key=lambda row: (
  2026	                -_nominal_configuration(row, nominal_profiles[row.configuration_id]).nominal_bits,
  2027	                row.configuration_id,
  2028	            ),
  2029	        )[:TOP_PROPOSALS]
  2030	        top_ids.extend(row.configuration_id for row in ranked)
  2031	    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
  2032	    # Frozen evacuations: include multi-user configurations assembled solely
  2033	    # from the top-two per-user proposal identities.
  2034	    allowed.extend(
  2035	        row
  2036	        for row in catalog
  2037	        if row.changed_users > 1
  2038	        and all(
  2039	            any(dict(proposal.assignments)[user] == identity for proposal in unilateral if proposal.configuration_id in top_ids)
  2040	            for user, identity in row.assignments
  2041	            if identity != dict(base.assignments)[user]
  2042	        )
  2043	    )
  2044	    nominal = nominal_greedy_reference(
  2045	        _nominal_configuration(row, nominal_profiles[row.configuration_id]) for row in allowed
  2046	    )
  2047	    nominal_all = nominal_greedy_reference(
  2048	        _nominal_configuration(row, nominal_profiles[row.configuration_id]) for row in catalog
  2049	    )
  2050	    return (
  2051	        next(row for row in allowed if row.configuration_id == nominal.configuration_id),
  2052	        tuple(sorted(set(top_ids))),
  2053	        next(row for row in catalog if row.configuration_id == nominal_all.configuration_id),
  2054	    )
