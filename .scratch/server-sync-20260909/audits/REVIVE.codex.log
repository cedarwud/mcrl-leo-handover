   308	def _evacuation_skeletons(
   309	    observation: Any, reference: np.ndarray, base_profile: Any,
   310	) -> tuple[dict[str, object], ...]:
   311	    """Action-only projection of E1 ``build_joint_witness_catalog``."""
   312	
   313	    origins: dict[tuple[int, int], list[int]] = {}
   314	    for user in range(base_profile.users):
   315	        if bool(base_profile.served[user]):
   316	            origin = (
   317	                int(base_profile.serving_satellite[user]),
   318	                int(base_profile.serving_cell[user]),
   319	            )
   320	            origins.setdefault(origin, []).append(user)
   321	    rows: list[dict[str, object]] = []
   322	    for origin in sorted(origins):
   323	        users = tuple(origins[origin])
   324	        legal_maps = tuple(e1._legal_key_actions(observation, user) for user in users)
   325	        common = set(legal_maps[0])
   326	        for mapping in legal_maps[1:]:
   327	            common.intersection_update(mapping)
   328	        common.discard(origin)
   329	        for destination in sorted(common):
   330	            actions = np.asarray(reference, dtype=np.int64).copy()
   331	            for user, mapping in zip(users, legal_maps, strict=True):
   332	                actions[user] = mapping[destination]
   333	            rows.append({
   334	                "profile_id": (
   335	                    f"J:{origin[0]}:{origin[1]}"
   336	                    f"->{destination[0]}:{destination[1]}"
   337	                ),
   338	                "kind": "joint", "actions": actions,
   339	                "tie_key": (2, *origin, *destination),
   340	            })
   341	    return tuple(rows)
   342	
   343	
   344	def _lite_unilateral_skeletons(
   345	    observation: Any, reference: np.ndarray, q12: np.ndarray,
   346	) -> tuple[dict[str, object], ...]:
   347	    """Keep each user's first Q12-ranked physical alternative to BASE."""
   348	
   349	    values = np.asarray(q12)
   350	    tables = tuple(observation.candidates.slot_tables)
   351	    if (
   352	        values.dtype != np.dtype(np.float32)
   353	        or values.shape != (len(tables), f1.NUM_ACTIONS)
   354	        or not np.all(np.isfinite(values))
   355	    ):
   356	        raise C3SPolicyError("lite catalog requires one finite float32 Q1+Q2 surface")
   357	    try:
   358	        # Besides producing all physically distinct choices, this donor rejects
   359	        # ambiguous legal physical keys using the inherited E1/F1 rule.
   360	        full_rows = f1.enumerate_unilateral_candidates(observation, reference)
   361	    except Exception as error:
   362	        raise C3SPolicyError("lite unilateral legality validation failed") from error
   363	    by_user_action = {
   364	        (int(row["focal_user"]), int(row["candidate_action"])): row
   365	        for row in full_rows
   366	    }
   367	    rows: list[dict[str, object]] = []
   368	    for user, table in enumerate(tables):
   369	        mask = np.asarray(table.mask)
   370	        legal = [int(action) for action in np.flatnonzero(mask).tolist()]
   371	        base_action = int(reference[user])
   372	        if not legal:
   373	            if base_action != f1.NO_OP_ACTION:
   374	                raise C3SPolicyError("empty-mask lite user does not have BASE NOOP")
   375	            continue
   376	        ranked = sorted(legal, key=lambda action: (-float(values[user, action]), action))
   377	        if ranked[0] != base_action:
   378	            raise C3SPolicyError("lite Q1+Q2 ranking does not reproduce BASE")
   379	        # Starting after BASE naturally skips all BASE-equivalent slots because
   380	        # the inherited full rows contain only physically different choices.
   381	        for action in ranked[1:]:
   382	            skeleton = by_user_action.get((user, action))
   383	            if skeleton is None:
   384	                continue
   385	            rows.append(skeleton)
   521	class NominalSnapshotEvaluator:
   522	    """Pure nominal evaluator constructed only from a detached snapshot."""
   523	
   524	    snapshot: NominalPhysicsSnapshot
   525	
   526	    def verify(self) -> str:
   527	        return self.snapshot.verify()
   528	
   529	    def evaluate(self, actions: np.ndarray) -> Any:
   530	        from mcrl.env.action_contract import assert_selected_actions_valid
   531	        from mcrl.env.step import StepEnvironment
   532	
   533	        context = _DetachedNominalContext(self.snapshot)
   534	        selected = assert_selected_actions_valid(actions, self.snapshot.candidates.slot_tables)
   535	        physics = StepEnvironment._resolve_physics(
   536	            context, self.snapshot.candidates, selected, None
   537	        )
   538	        return SimpleNamespace(
   539	            resolution=physics["resolution"], radiating=physics["radiating"],
   540	            link_power_w=physics["link_power_w"], link_rate_bps=physics["rate"],
   541	            fixed_power_w=physics["fixed_power_w"], system_power_w=physics["system_power_w"],
   542	        )
