   715	
   716	def build_s0_catalog(
   717	    *, snapshot: DecisionSnapshot, evaluator: NominalSnapshotEvaluator,
   718	    timing_out: dict[str, float] | None = None,
   719	) -> tuple[dict[str, object], ...]:
   720	    """Build the declared full or Q12-pruned-lite catalog in fixed order."""
   721	
   722	    snapshot.verify()
   723	    _assert_no_prohibited_capabilities(evaluator)
   724	    reference = np.asarray(snapshot.base_actions)
   725	    if reference.dtype.kind not in "iu" or reference.ndim != 1:
   726	        raise C3SPolicyError("BASE action vector is malformed")
   727	    if snapshot.catalog not in ("full", "lite"):
   728	        raise C3SPolicyError("catalog must be 'full' or 'lite'")
   729	    try:
   730	        evaluation_started = time.perf_counter()
   731	        # Origin membership comes from BASE's nominal/native service result.
   732	        base_evaluation = evaluator.evaluate(reference)
   733	        base_profile, base_link_power = f1.profile_from_evaluation(
   734	            base_evaluation, interval_s=snapshot.interval_s
   735	        )
   736	        del base_link_power
   737	        base_nominal = _metric_from_e1_payload(
   738	            e1._profile_metrics(base_profile), label="BASE nominal evaluation"
   739	        )
   740	        base_evaluation_seconds = time.perf_counter() - evaluation_started
   741	        enumeration_started = time.perf_counter()
   742	        # F1 and E1 retain ownership of physical-key legality and ordering.
   743	        observation = SimpleNamespace(candidates=snapshot.candidates)
   744	        unilateral = (
   745	            f1.enumerate_unilateral_candidates(observation, reference)
   746	            if snapshot.catalog == "full"
   747	            else _lite_unilateral_skeletons(
   748	                observation, reference, snapshot.q12_proposal
   749	            )
   750	        )
   751	        rows: list[dict[str, object]] = [{
   752	            "profile_id": "BASE", "kind": "base", "tie_key": (0,),
   753	            "actions": reference.astype(np.int64, copy=True), "nominal": base_nominal,
   754	        }]
   755	        for skeleton in unilateral:
   756	            actions = np.asarray(skeleton["candidate_joint_actions"], dtype=np.int64)
   757	            rows.append({
   758	                "profile_id": f"U:{skeleton['focal_user']}:{skeleton['candidate_action']}",
   759	                "kind": "unilateral", "actions": actions.copy(),
   760	                "tie_key": (1, int(skeleton["focal_user"]), int(skeleton["candidate_action"])),
   761	            })
   762	        rows.extend(_evacuation_skeletons(observation, reference, base_profile))
   763	        enumeration_seconds = time.perf_counter() - enumeration_started
   764	
   765	        # One exhaustive S0 pass.  Physical aliases retain their catalog rows
   766	        # but share the first nominal result by complete action-vector key.
   767	        nominal_started = time.perf_counter()
   768	        cache = {tuple(int(value) for value in reference.tolist()): base_nominal}
   769	        for row in rows[1:]:
   770	            actions = np.asarray(row["actions"], dtype=np.int64)
   771	            key = tuple(int(value) for value in actions.tolist())
   772	            if key not in cache:
   773	                evaluation = evaluator.evaluate(actions)
   774	                profile, _link_power = f1.profile_from_evaluation(
   775	                    evaluation, interval_s=snapshot.interval_s
   776	                )
   777	                cache[key] = _metric_from_e1_payload(
   778	                    e1._profile_metrics(profile), label=f"{row['profile_id']} nominal evaluation"
   779	                )
   780	            row["nominal"] = cache[key]
   781	        nominal_seconds = time.perf_counter() - nominal_started
   782	        if timing_out is not None:
   783	            timing_out.update({
   784	                "base_nominal_evaluation": base_evaluation_seconds,
   785	                "enumeration": enumeration_seconds,
   786	                "remaining_nominal_evaluations": nominal_seconds,
   787	                "nominal_evaluation": base_evaluation_seconds + nominal_seconds,
   788	                "unique_nominal_evaluations": float(len(cache)),
   789	            })
   790	    except C3SPolicyError:
