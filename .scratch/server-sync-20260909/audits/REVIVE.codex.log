   869	        actions = np.asarray(result.actions)
   870	        base = np.asarray(result.base_actions)
   871	        if actions.dtype.kind not in "iu" or actions.ndim != 1 or actions.shape != base.shape:
   872	            raise C3SPolicyError("selected complete action vector is malformed")
