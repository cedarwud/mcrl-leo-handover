   127	def _assert_no_prohibited_capabilities(value: object) -> None:
   128	    """Reject any environment, RNG, or keyed-field object reachable by selection."""
   129	
   130	    seen: set[int] = set()
   131	
   132	    def visit(item: object) -> None:
   133	        if item is None or isinstance(item, (bool, int, float, str, bytes, np.generic, np.ndarray)):
   134	            return
   135	        identity = id(item)
   136	        if identity in seen:
   137	            return
   138	        seen.add(identity)
   139	        qualified = f"{type(item).__module__}.{type(item).__qualname__}"
   140	        if (
   141	            isinstance(item, np.random.Generator)
   142	            or qualified.endswith(".StepEnvironment")
   143	            or qualified.endswith(".TrainerEnvironment")
   144	            or qualified.endswith(".KeyedFadingField")
   145	        ):
   146	            raise C3SPolicyError(f"prohibited coordinator capability is reachable: {qualified}")
   147	        if isinstance(item, Mapping):
   148	            children = tuple(item.items())
   149	        elif isinstance(item, (tuple, list, set, frozenset)):
   150	            children = tuple(enumerate(item))
   151	        elif is_dataclass(item):
   152	            children = tuple((definition.name, getattr(item, definition.name)) for definition in fields(item))
   153	        elif hasattr(item, "__dict__"):
   154	            children = tuple(vars(item).items())
   155	        elif hasattr(type(item), "__slots__"):
   156	            slots = type(item).__slots__
   157	            names = (slots,) if isinstance(slots, str) else tuple(slots)
   158	            children = tuple((name, getattr(item, name)) for name in names if hasattr(item, name))
   159	        else:
   160	            children = ()
   161	        for _name, child in children:
   162	            visit(child)
   163	
   164	    visit(value)
