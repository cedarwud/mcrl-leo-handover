   632	def _snapshot_inputs(
   633	    adapter: "C3SPolicyAdapter", step_env: Any, observation: Any,
   634	) -> tuple[DecisionSnapshot, NominalSnapshotEvaluator]:
   635	    from mcrl.env.action_contract import SlotTable
   636	
   637	    q_started = time.perf_counter()
   638	    native, q12, base = e1._q12_surface_base_only(
   639	        adapter.physical, adapter.frozen, step_env, observation
   640	    )
   641	    q_seconds = time.perf_counter() - q_started
   642	    native.verify()
   643	    original = observation.candidates
   644	    tables = tuple(
   645	        SlotTable(
   646	            norad_ids=_readonly(table.norad_ids, dtype=np.int64),
   647	            cell_ids=_readonly(table.cell_ids, dtype=np.int64),
   648	            mask=_readonly(table.mask, dtype=np.bool_),
   649	        )
   650	        for table in tuple(original.slot_tables)
   651	    )
   652	    candidates = FrozenCandidates(
   653	        slot_tables=tables,
   654	        off_axis_deg=_readonly(original.off_axis_deg, dtype=np.float64),
   655	        elevation_deg=_readonly(original.elevation_deg, dtype=np.float64),
   656	        window_satellite_ecef_km=_readonly(
   657	            original.window_satellite_ecef_km, dtype=np.float64
   658	        ),
   659	        window_norad_ids=_readonly(original.window_norad_ids, dtype=np.int64),
   660	    )
   661	    keys = _readonly(
   662	        np.stack(
   663	            [np.stack((table.norad_ids, table.cell_ids), axis=1) for table in tables],
   664	            axis=0,
   665	        ),
   666	        dtype=np.int64,
   667	    )
   668	    pending = getattr(step_env, "_pending_segment_age", None)
   669	    history: list[tuple[int, tuple[tuple[int, np.ndarray], ...]]] = []
   670	    if int(getattr(step_env, "_step_index", -1)) == 0 and pending is not None:
   671	        for age in sorted(set(int(value) for value in np.asarray(pending).tolist())):
   672	            if age <= 0:
   673	                continue
   674	            positions = step_env.driver.satellite_ecef_at(-age)
   675	            history.append((
   676	                -age,
   677	                tuple(
   678	                    (int(norad), _readonly(position, dtype=np.float64))
   679	                    for norad, position in sorted(positions.items())
   680	                ),
   681	            ))
   682	    nominal_physics = NominalPhysicsSnapshot(
   683	        candidates=candidates,
   684	        grid=_copy_grid(step_env.driver.grid),
   685	        user_ecef_km=_readonly(step_env.driver.user_ecef_km(), dtype=np.float64),
   686	        historical_satellite_ecef=tuple(history),
   687	        physics=replace(step_env.physics, fading_enabled=False),
   688	        segments=tuple(copy.deepcopy(getattr(step_env, "_segments", ()))),
   689	        previous_association=tuple(copy.deepcopy(getattr(step_env, "_previous_association", ()))),
   690	        pending_segment_age=(None if pending is None else _readonly(pending, dtype=np.int64)),
   691	        step_index=int(getattr(step_env, "_step_index", -1)),
   692	    )
   693	    snapshot = DecisionSnapshot(
   694	        native_state_matrix=_readonly(native.state_matrix, dtype=np.float32),
   695	        legal_masks=_readonly(native.action_masks, dtype=np.bool_),
   696	        slot_physical_keys=keys,
   697	        q12_proposal=_readonly(q12, dtype=np.float32),
   698	        base_actions=_readonly(base, dtype=np.int64),
   699	        candidates=candidates,
   700	        committed_association=nominal_physics.previous_association,
   701	        committed_segments=nominal_physics.segments,
   702	        committed_radiating=copy.deepcopy(getattr(step_env, "_previous_radiating", None)),
   703	        tracking_state=(copy.deepcopy(original.d2), copy.deepcopy(original.dwell)),
   704	        interval_s=float(step_env.driver.config.ephemeris.time_step_s),
   705	        catalog=adapter.catalog,
   706	        eta_ref=adapter.eta_ref,
   707	        q_inference_seconds=q_seconds,
   708	    )
   709	    evaluator = NominalSnapshotEvaluator(nominal_physics)
   710	    _freeze_nested_arrays((snapshot, evaluator))
   711	    snapshot.verify()
   712	    evaluator.verify()
   713	    return snapshot, evaluator
