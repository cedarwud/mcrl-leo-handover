   812	class C3SPolicyAdapter:
   813	    """A state-neutral policy adapter around authenticated Q1/Q2 and S0."""
   814	
   815	    def __init__(
   816	        self, *, physical: Any, frozen: Any, eta_ref: Fraction | None = None,
   817	        eta_config: Path = CONFIG_PATH, catalog: Catalog = "full",
   818	        decision_function: DecisionFunction | None = None,
   819	    ) -> None:
   820	        self.physical = physical
   821	        self.frozen = frozen
   822	        self.eta_ref = load_eta_ref(eta_config) if eta_ref is None else Fraction(eta_ref)
   823	        if self.eta_ref <= 0:
   824	            raise C3SPolicyError("eta_ref must be positive")
   825	        if catalog not in ("full", "lite"):
   826	            raise C3SPolicyError("catalog must be 'full' or 'lite'")
   827	        self.catalog: Catalog = catalog
   828	        self._decision_function = decision_function or _real_decision
   829	        self.decision_records: list[dict[str, object]] = []
   830	
   831	    def select_actions(
   832	        self, step_env: Any, observation: Any, rng: np.random.Generator,
   833	    ) -> np.ndarray:
   834	        if not isinstance(rng, np.random.Generator):
   835	            raise C3SPolicyError("policy RNG must be numpy.random.Generator")
   836	        try:
   837	            before = _live_neutrality_fingerprint(step_env, rng)
   838	        except Exception as error:
   839	            raise C3SPolicyError("cannot snapshot the pre-decision environment") from error
   840	        started = time.perf_counter()
   841	        result: DecisionResult | None = None
   842	        decision_error: BaseException | None = None
   843	        try:
   844	            snapshot, evaluator = _snapshot_inputs(self, step_env, observation)
   845	            snapshot_digest = snapshot.verify()
   846	            evaluator_digest = evaluator.verify()
   847	            _assert_no_prohibited_capabilities((snapshot, evaluator))
   848	            result = self._decision_function(snapshot, evaluator)
   849	            if snapshot.verify() != snapshot_digest:
   850	                raise C3SPolicyError("coordinator mutated its frozen input snapshot")
   851	            if evaluator.verify() != evaluator_digest:
   852	                raise C3SPolicyError(
   853	                    "coordinator mutated its authenticated nominal geometry/physics"
   854	                )
   855	        except BaseException as error:
   856	            decision_error = error
   857	        elapsed = time.perf_counter() - started
   858	        try:
   859	            after = _live_neutrality_fingerprint(step_env, rng)
   860	        except Exception as error:
   861	            raise C3SPolicyError("cannot authenticate the post-decision environment") from error
   862	        if after != before:
