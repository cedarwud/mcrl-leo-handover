def write_report(path: Path, summary: Mapping[str, object], output: Path) -> None:
    histogram = summary["size_histogram"]
    r3 = summary["r3_normalized_distribution"]
    material = bool(r3["fraction_abs_gt_1e-3"] and r3["fraction_abs_gt_1e-3"] >= 0.05)
    lines = [
        "# Coalition corpus — 2026-09-09",
        "",
        f"**New trainable coalition-size histogram: {histogram}. Occupancy-activation is admitted by {summary['occupancy_activation_anchors_trainable']} of {summary['anchors']} anchors as a size-two-or-larger interaction coalition ({summary['occupancy_activation_anchors_including_singleton_observations']} anchors when exact occupancy-2→3 singleton mechanism observations are included).**",
        "",
        "`PILOT_NOT_CLAIM`",
        "",
        "## Outcome",
        "",
        f"Generated {summary['coalition_rows']} exact interaction rows across {summary['anchors']} anchors. Coalitions per anchor have distribution {summary['coalitions_per_anchor']}. Family counts over unique rows are {summary['family_histogram_unique_rows']}.",
        "",
        f"The authenticated corpus is `{output.relative_to(ROOT)}`. It contains {len(summary['shards'])} learner-readable v2 coalition shards, a family index, an occupancy singleton-observation ledger, a nested-mask scalar-observation ledger, and the manifest. The corpus remains `PILOT_NOT_CLAIM`.",
        "",
        "## Family coverage",
        "",
        f"- `pair-catalogue`: {summary['family_histogram_unique_rows'].get(PAIR_CATALOGUE, 0)} rows. All {summary['old_pair_rows_expected']} archived one-per-anchor selections were reconstructed; {summary['old_pair_exact_matches']} have bit-exact interaction and objective-delta labels. Mismatches: {len(summary['old_pair_mismatches'])}.",
        f"- `occupancy-activation`: {summary['family_histogram_unique_rows'].get(OCCUPANCY_ACTIVATION, 0)} trainable rows, plus {summary['occupancy_activation_singleton_observations']} exact singleton mechanism observations. The selector considers every anchor beam at occupancy 1 or 2 and moves the minimum available users needed to reach occupancy 3. Occupancy 1→3 is a pair interaction; occupancy 2→3 has one mover and therefore is recorded honestly as an exact scalar observation, not fabricated as a C3 interaction row.",
        f"- `aggressor-relief`: {summary['family_histogram_unique_rows'].get(AGGRESSOR_RELIEF, 0)} rows. Per admitting anchor, the victim with greatest top-three nominal cross-gain burden and its top two/top three contributors move to their own first different legal action in the sealed shortlist, yielding sizes 3 and 4.",
        f"- `beam-evacuation`: {summary['family_histogram_unique_rows'].get(BEAM_EVACUATION, 0)} rows. Every beam with 2 or 3 occupants is evacuated when every occupant has a different legal alternative. This selection uses occupancy and legal-action identity only; it consults no decode threshold.",
        f"- `nested-subsets`: {summary['family_histogram_unique_rows'].get(NESTED_SUBSETS, 0)} unique rows across {summary['nested_blocks']} six-user blocks. Each block has all 64 subset masks evaluated, giving 57 non-trivial residual-label occurrences. These are **64 scalar observations, not 57 independent measurements**.",
        "",
        "## Exact-label convention and cache",
        "",
        "Every size-`k` interaction row uses `k + 2` distinct sealed-objective configurations: the anchor baseline, each of the `k` singleton action changes evaluated exactly, and the joint coalition. The implemented convention is **exact singleton differences**; no learned singleton estimate enters any label. Consequently the target is the interaction itself, not interaction plus singleton-model error.",
        "",
        "The cache key is a canonical SHA-256 over four complete axes: (1) anchor identity and assignments (world, seed, step, carrier, anchor configuration), (2) context (objective convention, transition configuration, rekeyed users), (3) the complete proposed-action assignment, and (4) evaluator configuration (engine schema, setting/run-setting digest, nominal field, boundary set, physics digest, calibration digest). This explicitly includes the anchor, context, proposed actions, and evaluator configuration. Cache requests/hits were " + f"{summary['evaluation_cache_requests']}/{summary['evaluation_cache_hits']}; physical configuration evaluations were {summary['physical_evaluations']}.",
        "",
        "## Order audit",
        "",
        "For every valid coalition of size at least three, the audit computed exact pair interactions under the same proposed member actions and then `R3(A) = Psi(A) - Σ_{pairs⊂A} Psi(pair)`. In normalized units the distribution is " + f"{r3}. Using the predeclared descriptive materiality flag `|R3| > 1e-3` on at least 5% of audited rows, the result is **{'material' if material else 'not material'}**. " + ("A pairwise-only interaction model is therefore misspecified for this corpus." if material else "This audit does not establish material pairwise misspecification at that scale."),
        "",
        "## Integrity and invariants",
        "",
        f"The manifest digest is `{summary['manifest_sha256']}`; family index `{summary['family_index_sha256']}`; nested observations `{summary['nested_scalar_observations_sha256']}`. Invalid proposed configurations skipped after exact evaluation: {summary['invalid_proposals']}.",
        "",
        "No threshold, sign, seed, horizon, price, service guard, or acceptance rule was changed. The generator expands only which exact sealed-objective coalitions are labeled. No encoder feature is used to compute a label.",
    ]
    write_once_with_sha256(path, ("\n".join(lines) + "\n").encode("utf-8"))


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=DEFAULT_SOURCE)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
    parser.add_argument("--world-limit", type=int)
    parser.add_argument("--anchor-limit", type=int)
    args = parser.parse_args(argv)
    if args.output.exists() or args.report.exists():
        raise SystemExit("refusing to overwrite an existing corpus or report")
    summary = generate(
        source=args.source, output=args.output,
        world_limit=args.world_limit, anchor_limit=args.anchor_limit,
    )
    write_report(args.report, summary, args.output)
    print(json.dumps({"status": "COMPLETE", "summary": summary, "report": str(args.report)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

