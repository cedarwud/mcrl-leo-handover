+def _beam_activation_audits(tape, step_index: int, anchor) -> dict[object, dict[str, object]]:
+    """Bind activation to each occupied beam's decision-instant elevation."""
+
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        return {}
+    row_of = arrays._row_index()
+    elevations = defaultdict(list)
+    for user, beam in anchor.mapping.items():
+        if beam is None:
+            continue
+        row = row_of.get((user, beam))
+        if row is not None:
+            elevations[beam].append(float(arrays.elevations_deg[0, row]))
+    result = {}
+    for beam, values in elevations.items():
+        audit = occupancy_activation_audit(min(values))
+        audit["incumbent_elevations_deg"] = sorted(values)
+        audit["beam_elevation_rule"] = "minimum-incumbent-actual-elevation"
+        result[beam] = audit
+    return result
+
