+            elevations[beam].append(float(arrays.elevations_deg[0, row]))
+    result = {}
+    for beam, values in elevations.items():
+        audit = occupancy_activation_audit(min(values))
+        audit["incumbent_elevations_deg"] = sorted(values)
+        audit["beam_elevation_rule"] = "minimum-incumbent-actual-elevation"
+        result[beam] = audit
+    return result
+
