index 0000000000000000000000000000000000000000..1d0dbfa10ff7ca789ec4304225fc9f0a1b82ac58
--- /dev/null
+++ b/src/mcrl/stagec_v025/mechanism_corpus.py
@@ -0,0 +1,276 @@
+"""Mechanism-aware coalition selection and exact higher-order diagnostics.
+
+This module is deliberately independent of the pilot feature encoder.  It
+operates on immutable action assignments and scalar evaluations of the sealed
+objective; callers may attach whatever feature context their learner needs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from fractions import Fraction
+import itertools
+from typing import Callable, Hashable, Mapping, Sequence
+
+
+PAIR_CATALOGUE = "pair-catalogue"
+OCCUPANCY_ACTIVATION = "occupancy-activation"
+AGGRESSOR_RELIEF = "aggressor-relief"
+BEAM_EVACUATION = "beam-evacuation"
+NESTED_SUBSETS = "nested-subsets"
+FAMILIES = (
+    PAIR_CATALOGUE,
+    OCCUPANCY_ACTIVATION,
+    AGGRESSOR_RELIEF,
+    BEAM_EVACUATION,
+    NESTED_SUBSETS,
+)
+
+Action = Hashable
+Assignment = Mapping[int, Action]
+
+
+@dataclass(frozen=True, slots=True)
+class CoalitionProposal:
+    """A deterministic proposed action for a named mechanism family."""
+
+    family: str
+    selected_actions: tuple[tuple[int, Action], ...]
+    mechanism_key: str
+    metadata: Mapping[str, object] = field(default_factory=dict)
+
+    def __post_init__(self) -> None:
+        users = tuple(user for user, _action in self.selected_actions)
+        if self.family not in FAMILIES:
+            raise ValueError(f"unknown coalition family {self.family!r}")
+        if not users or users != tuple(sorted(users)) or len(set(users)) != len(users):
+            raise ValueError("proposal users must be nonempty, unique, and sorted")
+
+    @property
+    def users(self) -> tuple[int, ...]:
+        return tuple(user for user, _action in self.selected_actions)
+
+    def mapping(self, anchor: Assignment) -> dict[int, Action]:
+        result = dict(anchor)
+        for user, action in self.selected_actions:
+            if result[user] == action:
+                raise ValueError("coalition proposals must change every member action")
+            result[user] = action
+        return result
+
+
+@dataclass(frozen=True, slots=True)
+class ExactInteractionLabel:
+    """Exact additive residual and its complete evaluation receipt."""
+
+    users: tuple[int, ...]
+    baseline: Fraction
+    singleton_values: tuple[tuple[int, Fraction], ...]
+    coalition_value: Fraction
+    singleton_differences: tuple[tuple[int, Fraction], ...]
+    objective_delta: Fraction
+    psi: Fraction
+    distinct_evaluation_count: int
+
+
+def exact_interaction_label(
+    *,
+    anchor: Assignment,
+    selected: Assignment,
+    evaluate: Callable[[Mapping[int, Action]], Fraction],
+) -> ExactInteractionLabel:
+    """Evaluate baseline, every exact singleton, and the joint configuration.
+
+    A size-k label necessarily authenticates k+2 distinct configurations.
+    Learned singleton predictions are never accepted by this interface.
+    """
+
+    users = tuple(sorted(user for user in anchor if anchor[user] != selected[user]))
+    if len(users) < 2:
+        raise ValueError("interaction labels require at least two changed users")
+    baseline = evaluate(anchor)
+    singleton_values: list[tuple[int, Fraction]] = []
+    identities = {tuple(sorted(anchor.items()))}
+    for user in users:
+        mapping = dict(anchor)
+        mapping[user] = selected[user]
+        identity = tuple(sorted(mapping.items()))
+        if identity in identities:
+            raise ValueError("singleton evaluation is not distinct from baseline")
+        identities.add(identity)
+        singleton_values.append((user, evaluate(mapping)))
+    selected_identity = tuple(sorted(selected.items()))
+    if selected_identity in identities:
+        raise ValueError("coalition evaluation is not distinct from baseline/singletons")
+    identities.add(selected_identity)
+    coalition_value = evaluate(selected)
+    singleton_differences = tuple(
+        (user, value - baseline) for user, value in singleton_values
+    )
+    objective_delta = coalition_value - baseline
+    psi = objective_delta - sum(
+        (difference for _user, difference in singleton_differences), Fraction()
+    )
+    if len(identities) != len(users) + 2:
+        raise AssertionError("exact interaction receipt lost a required evaluation")
+    return ExactInteractionLabel(
+        users=users,
+        baseline=baseline,
+        singleton_values=tuple(singleton_values),
+        coalition_value=coalition_value,
+        singleton_differences=singleton_differences,
+        objective_delta=objective_delta,
+        psi=psi,
+        distinct_evaluation_count=len(identities),
+    )
+
+
+def exact_r3(
+    *,
+    anchor: Assignment,
+    selected: Assignment,
+    label: ExactInteractionLabel,
+    evaluate: Callable[[Mapping[int, Action]], Fraction],
+) -> tuple[Fraction, tuple[tuple[tuple[int, int], Fraction], ...]]:
+    """Return R3(A)=Psi(A)-sum_{pairs in A} Psi(pair), exactly."""
+
+    if len(label.users) < 3:
+        raise ValueError("R3 is defined here only for coalitions of size >=3")
+    singleton = dict(label.singleton_values)
+    pair_terms: list[tuple[tuple[int, int], Fraction]] = []
+    for first, second in itertools.combinations(label.users, 2):
+        mapping = dict(anchor)
+        mapping[first] = selected[first]
+        mapping[second] = selected[second]
+        pair_value = evaluate(mapping)
+        pair_psi = (
+            pair_value
+            - label.baseline
+            - (singleton[first] - label.baseline)
+            - (singleton[second] - label.baseline)
+        )
+        pair_terms.append(((first, second), pair_psi))
+    return (
+        label.psi - sum((value for _pair, value in pair_terms), Fraction()),
+        tuple(pair_terms),
+    )
+
+
+def best_alternatives(
+    anchor: Assignment,
+    legal_actions: Mapping[int, Sequence[Action]],
+) -> dict[int, Action]:
+    """First sealed-shortlist action different from the anchor, per user."""
+
+    return {
+        user: next(action for action in legal_actions[user] if action != anchor[user])
+        for user in sorted(anchor)
+        if any(action != anchor[user] for action in legal_actions[user])
+    }
+
+
+def occupancy_activation_proposals(
+    *,
+    anchor: Assignment,
+    legal_actions: Mapping[int, Sequence[Action]],
+) -> tuple[CoalitionProposal, ...]:
+    """Move the minimum available users into every beam at occupancy one/two.
+
+    Occupancy-two activations are returned as singleton mechanism observations;
+    callers exclude them from an interaction-training shard because an exact
+    singleton has no interaction residual.  Occupancy-one activations are
+    trainable pairs and cross the same occupancy-three threshold.
+    """
+
+    occupants: dict[Action, list[int]] = {}
+    for user, action in anchor.items():
+        if action is not None:
+            occupants.setdefault(action, []).append(user)
+    result: list[CoalitionProposal] = []
+    for beam, current_users in sorted(occupants.items(), key=lambda item: repr(item[0])):
+        occupancy = len(current_users)
+        if occupancy not in (1, 2):
+            continue
+        needed = 3 - occupancy
+        candidates = [
+            (tuple(legal_actions[user]).index(beam), user)
+            for user in sorted(anchor)
+            if anchor[user] != beam and beam in legal_actions[user]
+        ]
+        selected_users = tuple(user for _rank, user in sorted(candidates)[:needed])
+        if len(selected_users) != needed:
+            continue
+        result.append(
+            CoalitionProposal(
+                family=OCCUPANCY_ACTIVATION,
+                selected_actions=tuple((user, beam) for user in selected_users),
+                mechanism_key=f"beam:{beam!r}",
+                metadata={
+                    "beam": repr(beam),
+                    "occupancy_before": occupancy,
+                    "occupancy_after": 3,
+                    "incoming_users": list(selected_users),
+                },
+            )
+        )
+    return tuple(result)
+
+
+def beam_evacuation_proposals(
+    *,
+    anchor: Assignment,
+    legal_actions: Mapping[int, Sequence[Action]],
+) -> tuple[CoalitionProposal, ...]:
+    """Evacuate every beam with two or three occupants to best alternatives."""
+
+    alternatives = best_alternatives(anchor, legal_actions)
+    occupants: dict[Action, list[int]] = {}
+    for user, action in anchor.items():
+        if action is not None:
+            occupants.setdefault(action, []).append(user)
+    result = []
+    for beam, users in sorted(occupants.items(), key=lambda item: repr(item[0])):
+        if len(users) not in (2, 3) or any(user not in alternatives for user in users):
+            continue
+        result.append(
+            CoalitionProposal(
+                family=BEAM_EVACUATION,
+                selected_actions=tuple((user, alternatives[user]) for user in sorted(users)),
+                mechanism_key=f"beam:{beam!r}",
+                metadata={"beam": repr(beam), "occupancy_before": len(users), "occupancy_after": 0},
+            )
+        )
+    return tuple(result)
+
+
+def nested_subset_proposals(
+    *,
+    block: Sequence[int],
+    alternatives: Mapping[int, Action],
+) -> tuple[CoalitionProposal, ...]:
+    """Every non-trivial subset of one five/six-user alternative block."""
+
+    users = tuple(sorted(int(user) for user in block))
+    if len(users) not in (5, 6) or len(set(users)) != len(users):
+        raise ValueError("nested subset blocks must contain five or six unique users")
+    if not set(users) <= set(alternatives):
+        raise ValueError("every nested-block user requires a legal alternative")
+    result = []
+    for mask in range(1 << len(users)):
+        selected = tuple(
+            (user, alternatives[user])
+            for offset, user in enumerate(users)
+            if mask & (1 << offset)
+        )
+        if len(selected) < 2:
+            continue
+        result.append(
+            CoalitionProposal(
+                family=NESTED_SUBSETS,
+                selected_actions=selected,
+                mechanism_key=f"block:{','.join(map(str, users))}:mask:{mask:0{len(users)}b}",
+                metadata={"block": list(users), "mask": mask, "scalar_observation_count": 1 << len(users)},
+            )
+        )
+    return tuple(result)
+
diff --git a/tests/stagec_v025/test_mechanism_corpus.py b/tests/stagec_v025/test_mechanism_corpus.py
new file mode 100644
index 0000000000000000000000000000000000000000..929ce3aed42fcf50da10a890c54e8dcfc460eb34
--- /dev/null
+++ b/tests/stagec_v025/test_mechanism_corpus.py
@@ -0,0 +1,63 @@
+from fractions import Fraction
+
+import pytest
+
+from mcrl.stagec_v025.mechanism_corpus import (
+    BEAM_EVACUATION,
+    NESTED_SUBSETS,
+    OCCUPANCY_ACTIVATION,
+    beam_evacuation_proposals,
+    exact_interaction_label,
+    exact_r3,
+    nested_subset_proposals,
+    occupancy_activation_proposals,
+)
+
+
+def test_exact_label_uses_k_plus_two_distinct_scalar_evaluations() -> None:
+    anchor = {0: "a", 1: "a", 2: "a"}
+    selected = {0: "b", 1: "b", 2: "b"}
+    calls = []
+
+    def value(mapping):
+        changed = frozenset(user for user in anchor if mapping[user] != anchor[user])
+        calls.append(tuple(sorted(mapping.items())))
+        singleton = sum(Fraction(user + 1) for user in changed)
+        pairs = 10 * sum(1 for pair in ((0, 1), (0, 2), (1, 2)) if set(pair) <= changed)
+        triple = 7 if changed == frozenset((0, 1, 2)) else 0
+        return singleton + pairs + triple
+
+    label = exact_interaction_label(anchor=anchor, selected=selected, evaluate=value)
+    assert label.distinct_evaluation_count == 5
+    assert len(set(calls)) == 5
+    assert label.psi == 37
+    r3, pairs = exact_r3(anchor=anchor, selected=selected, label=label, evaluate=value)
+    assert [value for _pair, value in pairs] == [10, 10, 10]
+    assert r3 == 7
+
+
+def test_mechanism_selectors_cover_activation_evacuation_and_nested_sizes() -> None:
+    anchor = {0: "x", 1: "x", 2: "y", 3: "z", 4: "u", 5: "v"}
+    legal = {
+        0: ("x", "a"), 1: ("x", "b"), 2: ("y", "x", "c"),
+        3: ("z", "y", "d"), 4: ("u", "y", "e"), 5: ("v", "y", "f"),
+    }
+    activations = occupancy_activation_proposals(anchor=anchor, legal_actions=legal)
+    assert any(row.family == OCCUPANCY_ACTIVATION and len(row.users) == 2 for row in activations)
+    evacuations = beam_evacuation_proposals(anchor=anchor, legal_actions=legal)
+    assert len(evacuations) == 1
+    assert evacuations[0].family == BEAM_EVACUATION
+    alternatives = {user: actions[1] for user, actions in legal.items()}
+    nested = nested_subset_proposals(block=range(6), alternatives=alternatives)
+    assert len(nested) == 57
+    assert {len(row.users) for row in nested} == {2, 3, 4, 5, 6}
+    assert all(row.family == NESTED_SUBSETS for row in nested)
+
+
+def test_exact_label_rejects_a_noninteraction_singleton() -> None:
+    with pytest.raises(ValueError, match="at least two"):
+        exact_interaction_label(
+            anchor={0: "a", 1: "a"},
+            selected={0: "b", 1: "a"},
+            evaluate=lambda _mapping: Fraction(),
+        )

