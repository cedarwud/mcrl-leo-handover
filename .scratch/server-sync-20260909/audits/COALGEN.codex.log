+# The independently verified engine value quoted in the repair request.  The
+# elevation adjustment below comes only from the frozen engine scintillation
+# and shadow-sigma tables; it does not introduce a tunable threshold.
+Q10_AT_10_DEG = 0.42923539
+_NORMAL_P90 = 1.2815515655446004
+
+
+def engine_table_q10(elevation_deg: float) -> float:
+    """Return the frozen lower-channel quantile at the actual elevation.
+
+    The 10-degree value authenticates the engine's verified quantile.  Away
+    from 10 degrees, the multiplicative adjustment uses the engine's linearly
+    interpolated scintillation-loss and Ka-LOS shadow-sigma tables.  The fixed
+    Rician component cancels in the ratio because its K factor is independent
+    of elevation.
+    """
+
+    elevation = float(elevation_deg)
+    if not math.isfinite(elevation) or not -90.0 <= elevation <= 90.0:
+        raise ValueError("elevation must be finite and in [-90,90] degrees")
+    loss = float(scintillation_loss_db(elevation))
+    sigma = float(shadow_sigma_db(elevation))
+    reference_loss = float(scintillation_loss_db(10.0))
+    reference_sigma = float(shadow_sigma_db(10.0))
+    adjustment_db = (loss - reference_loss) + _NORMAL_P90 * (sigma - reference_sigma)
+    return Q10_AT_10_DEG * 10.0 ** (-adjustment_db / 10.0)
+
 
+def occupancy_activation_audit(elevation_deg: float) -> dict[str, object]:
+    """Compute the first occupancy whose q10-scaled target clears PHY."""
+
+    q10 = engine_table_q10(elevation_deg)
+    gamma = {
+        occupancy: rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
+        for occupancy in range(1, 7)
+    }
+    activating = next(
+        (
+            occupancy
+            for occupancy, target in gamma.items()
+            if target is not None and q10 * target >= SINR_MIN
+        ),
+        None,
+    )
+    return {
+        "elevation_deg": float(elevation_deg),
+        "q10": q10,
+        "lowest_threshold": SINR_MIN,
+        "gamma_by_occupancy": gamma,
+        "first_activating_occupancy": activating,
+    }
+
