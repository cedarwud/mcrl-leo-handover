        "",
        "No threshold, sign, seed, horizon, price, service guard, or acceptance rule was changed. The generator expands only which exact sealed-objective coalitions are labeled. No encoder feature is used to compute a label.",
    ]
    write_once_with_sha256(path, ("\n".join(lines) + "\n").encode("utf-8"))


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=DEFAULT_SOURCE)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
    parser.add_argument("--world-limit", type=int)
    parser.add_argument("--anchor-limit", type=int)
    args = parser.parse_args(argv)
    if args.output.exists() or args.report.exists():
        raise SystemExit("refusing to overwrite an existing corpus or report")
    summary = generate(
        source=args.source, output=args.output,
        world_limit=args.world_limit, anchor_limit=args.anchor_limit,
    )
    write_report(args.report, summary, args.output)
    print(json.dumps({"status": "COMPLETE", "summary": summary, "report": str(args.report)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

