+def occupancy_2_diminishing_proposals(
+    *,
+    anchor: Assignment,
+    legal_actions: Mapping[int, Sequence[Action]],
+    beam_audits: Mapping[Action, Mapping[str, object]],
+) -> tuple[CoalitionProposal, ...]:
+    """Move two arrivals into occupancy-two beams; keep them visibly separate.
+
+    The first arrival reaches the occupancy-three activation point.  The
+    second reaches occupancy four and is expected to expose the corrected
+    diminishing (often negative) interaction population.
+    """
+
+    occupants: dict[Action, list[int]] = {}
+    for user, action in anchor.items():
+        if action is not None:
+            occupants.setdefault(action, []).append(user)
+    result: list[CoalitionProposal] = []
+    for beam, current_users in sorted(occupants.items(), key=lambda item: repr(item[0])):
+        audit = beam_audits.get(beam)
+        if len(current_users) != 2 or audit is None or audit["first_activating_occupancy"] != 3:
+            continue
+        candidates = [
+            (tuple(legal_actions[user]).index(beam), user)
+            for user in sorted(anchor)
+            if anchor[user] != beam and beam in legal_actions[user]
+        ]
+        selected_users = tuple(sorted(user for _rank, user in sorted(candidates)[:2]))
+        if len(selected_users) != 2:
+            continue
+        result.append(
+            CoalitionProposal(
+                family=OCCUPANCY_2_DIMINISHING,
+                selected_actions=tuple((user, beam) for user in selected_users),
+                mechanism_key=f"beam:{beam!r}",
+                metadata={
+                    "beam": repr(beam),
+                    "occupancy_before": 2,
+                    "occupancy_after": 4,
+                    "incoming_users": list(selected_users),
+                    "first_arrival_occupancy": 3,
+                    "activation_audit": dict(audit),
                 },
             )
         )
