#!/usr/bin/env python3
"""Generate the PILOT_NOT_CLAIM mechanism-aware exact coalition corpus."""

from __future__ import annotations

import argparse
from collections import Counter, defaultdict
from fractions import Fraction
import hashlib
import itertools
import json
import math
from pathlib import Path
import sys
import time
from typing import Mapping, Sequence

import numpy as np

from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import build_world_tape
from mcrl.stagec_v025.canonical import (
    canonical_json_bytes,
    canonical_sha256,
    float_hex,
    write_once_with_sha256,
)
from mcrl.stagec_v025.coalitions import write_coalition_shard
from mcrl.stagec_v025.mechanism_corpus import (
    AGGRESSOR_RELIEF,
    BEAM_EVACUATION,
    NESTED_SUBSETS,
    OCCUPANCY_ACTIVATION,
    PAIR_CATALOGUE,
    CoalitionProposal,
    beam_evacuation_proposals,
    best_alternatives,
    exact_interaction_label,
    exact_r3,
    nested_subset_proposals,
    occupancy_activation_proposals,
)
from mcrl.stagec_v025.shards import read_source_shard


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))
import run_v025_pilot_c3 as pilot  # noqa: E402


LABEL = "PILOT_NOT_CLAIM"
SCHEMA = "mcrl-v025-mechanism-coalition-corpus-v1"
DEFAULT_SOURCE = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
DEFAULT_OUTPUT = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
DEFAULT_REPORT = ROOT / "COALITION-CORPUS-2026-09-09.md"
NESTED_ANCHORS_PER_WORLD = (0, 30, 60)


def _identity(action):
    if action.is_null:
        return None
    return (action.norad_id, action.beam_chain_id)


def _calibration(source: Path):
    payload = json.loads((source / f"{LABEL}-rows-manifest.json").read_text())["calibration"]
    fraction = lambda key: Fraction(*payload[key])
    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
        bits_ref=fraction("bits_ref"),
        joules_ref=fraction("joules_ref"),
        users=int(payload["users"]),
        source=str(payload["source"]),
    )


def _old_pair(source: Path, world_number: int, anchor_index: int, anchor) -> tuple[CoalitionProposal, dict]:
    path = source / "rows" / f"world-{world_number}" / f"{LABEL}-coalition-anchor-{anchor_index:03d}.jsonl"
    payload = json.loads(path.read_text(encoding="ascii").splitlines()[1])
    actions = []
    for member in payload["context"]["members"]:
        action = member["selected_action"]
        identity = None if action["norad_id"] is None else (int(action["norad_id"]), int(action["beam_chain_id"]))
        user = int(member["user_id"])
        if anchor.mapping[user] == identity:
            raise RuntimeError("archived pair member no longer changes the anchor")
        actions.append((user, identity))
    proposal = CoalitionProposal(
        family=PAIR_CATALOGUE,
        selected_actions=tuple(sorted(actions)),
        mechanism_key=f"archived:{path.name}",
        metadata={"archived_shard_sha256": hashlib.sha256(path.read_bytes()).hexdigest()},
    )
    return proposal, payload


def _aggressor_relief_proposals(tape, step_index: int, anchor, legal_actions) -> tuple[CoalitionProposal, ...]:
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        return ()
    alternatives = best_alternatives(anchor.mapping, legal_actions)
    row_of = arrays._row_index()
    candidates = []
    for victim in sorted(anchor.mapping):
        victim_beam = anchor.mapping[victim]
        victim_row = row_of.get((victim, victim_beam)) if victim_beam is not None else None
        if victim not in alternatives or victim_row is None:
            continue
        contributors = []
        for aggressor in sorted(anchor.mapping):
            source_beam = anchor.mapping[aggressor]
            if aggressor == victim or aggressor not in alternatives or source_beam is None:
                continue
            contribution = float(arrays._cross(0, victim_row, source_beam)[0])
            if contribution > 0.0:
                contributors.append((contribution, aggressor, source_beam))
        contributors.sort(key=lambda item: (-item[0], item[1]))
        if len(contributors) >= 3:
            candidates.append((math.fsum(row[0] for row in contributors[:3]), victim, contributors))
    if not candidates:
        return ()
    _harm, victim, contributors = min(candidates, key=lambda item: (-item[0], item[1]))
    result = []
    for top_n in (2, 3):
        selected_users = (victim, *(row[1] for row in contributors[:top_n]))
        contribution_rows = contributors[:top_n]
        result.append(
            CoalitionProposal(
                family=AGGRESSOR_RELIEF,
                selected_actions=tuple(sorted((user, alternatives[user]) for user in selected_users)),
                mechanism_key=f"victim:{victim}:top:{top_n}",
                metadata={
                    "victim": victim,
                    "top_contributor_count": top_n,
                    "contributors": [row[1] for row in contribution_rows],
                    "nominal_cross_gain": [float_hex(row[0]) for row in contribution_rows],
                    "alternative_rule": "first-different-action-in-sealed-shortlist",
                },
            )
        )
    return tuple(result)


class ExactObjectiveCache:
    """Anchor-local exact sealed-objective cache with authenticated full keys."""

    def __init__(self, *, tape, step_index, carrier, anchor, evaluator, calibration, setting, run_setting):
        self.tape = tape
        self.step_index = step_index
        self.carrier = carrier
        self.anchor = anchor
        self.evaluator = evaluator
        self.calibration = calibration
        self.evaluator_configuration = {
            "engine_schema": pilot.ENGINE.SCHEMA,
            "setting_id": setting.label,
            "setting_digest": run_setting.digest,
            "field": evaluator.field,
            "boundary_indices": list(evaluator.boundary_indices),
            "physics_digest": pilot.PHYSICS_DIGEST,
            "calibration_digest": calibration.digest,
        }
        self.anchor_context = {
            "world_id": tape.domain,
            "world_seed": tape.seed,
            "step_index": step_index,
            "carrier": carrier,
            "anchor_configuration_id": anchor.configuration_id,
            "anchor_assignments": list(anchor.assignments),
            "transition_configuration_id": evaluator.transition_from.configuration_id,
            "cell_rekeyed_users": list(evaluator.cell_rekeyed_users),
        }
        self._configs = {}
        self._values = {}
        self.requests = 0
        self.hits = 0

    def config(self, mapping: Mapping[int, object]):
        assignments = tuple(sorted(mapping.items()))
        config = self._configs.get(assignments)
        if config is None:
            config = pilot.ENGINE._configuration(self.anchor, dict(assignments), kind="mechanism-corpus-exact")
            self._configs[assignments] = config
        return config

    def key(self, mapping: Mapping[int, object]) -> str:
        config = self.config(mapping)
        return canonical_sha256({
            "schema": f"{SCHEMA}-evaluation-cache-key-v1",
            "anchor": self.anchor_context,
            "context": {
                "objective": "bits-lambda*joules+kappa*phi",
                "phi_reference": "anchor-to-proposed-actions",
            },
            "proposed_actions": list(config.assignments),
            "evaluator_configuration": self.evaluator_configuration,
        })

    def prepare(self, mappings: Sequence[Mapping[int, object]]) -> None:
        configs = {self.config(mapping).assignments: self.config(mapping) for mapping in mappings}
        ordered = list(configs.values())
        for start in range(0, len(ordered), 1024):
            self.evaluator.evaluate_many(tuple(ordered[start:start + 1024]))

    def value(self, mapping: Mapping[int, object]) -> Fraction:
        self.requests += 1
        key = self.key(mapping)
        if key in self._values:
            self.hits += 1
            return self._values[key]
        config = self.config(mapping)
        if config.configuration_id in self.evaluator._invalid:
            raise ValueError("invalid exact configuration")
        profile = self.evaluator.evaluate(config)
        value = (
            Fraction(str(profile.bits))
            - self.calibration.eta_ref * Fraction(str(profile.joules))
            + self.calibration.kappa_bits_per_user_step * pilot.ENGINE._phi_for(self.anchor, config)
        )
        self._values[key] = value
        return value


def _all_required_mappings(anchor, proposals):
    base = anchor.mapping
    mappings = [base]
    for proposal in proposals:
        selected = proposal.mapping(base)
        mappings.append(selected)
        for user in proposal.users:
            singleton = dict(base)
            singleton[user] = selected[user]
            mappings.append(singleton)
        if len(proposal.users) >= 3:
            for first, second in itertools.combinations(proposal.users, 2):
                pair = dict(base)
                pair[first] = selected[first]
                pair[second] = selected[second]
                mappings.append(pair)
    return mappings


def _quantiles(values):
    if not values:
        return {key: None for key in ("min", "p05", "p50", "p95", "max", "mean", "mean_abs")}
    array = np.asarray(values, dtype=np.float64)
    return {
        "min": float(array.min()), "p05": float(np.quantile(array, 0.05)),
        "p50": float(np.quantile(array, 0.50)), "p95": float(np.quantile(array, 0.95)),
        "max": float(array.max()), "mean": float(array.mean()),
        "mean_abs": float(np.abs(array).mean()),
    }


def _write_jsonl(path: Path, header: Mapping[str, object], rows: Sequence[Mapping[str, object]]) -> str:
    encoded = b"\n".join(canonical_json_bytes(value) for value in (header, *rows)) + b"\n"
    return write_once_with_sha256(path, encoded)

"""Mechanism-aware coalition selection and exact higher-order diagnostics.

This module is deliberately independent of the pilot feature encoder.  It
operates on immutable action assignments and scalar evaluations of the sealed
objective; callers may attach whatever feature context their learner needs.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from fractions import Fraction
import itertools
from typing import Callable, Hashable, Mapping, Sequence


PAIR_CATALOGUE = "pair-catalogue"
OCCUPANCY_ACTIVATION = "occupancy-activation"
AGGRESSOR_RELIEF = "aggressor-relief"
BEAM_EVACUATION = "beam-evacuation"
NESTED_SUBSETS = "nested-subsets"
FAMILIES = (
    PAIR_CATALOGUE,
    OCCUPANCY_ACTIVATION,
    AGGRESSOR_RELIEF,
    BEAM_EVACUATION,
    NESTED_SUBSETS,
)

Action = Hashable
Assignment = Mapping[int, Action]


@dataclass(frozen=True, slots=True)
class CoalitionProposal:
    """A deterministic proposed action for a named mechanism family."""

    family: str
    selected_actions: tuple[tuple[int, Action], ...]
    mechanism_key: str
    metadata: Mapping[str, object] = field(default_factory=dict)

    def __post_init__(self) -> None:
        users = tuple(user for user, _action in self.selected_actions)
        if self.family not in FAMILIES:
            raise ValueError(f"unknown coalition family {self.family!r}")
        if not users or users != tuple(sorted(users)) or len(set(users)) != len(users):
            raise ValueError("proposal users must be nonempty, unique, and sorted")

    @property
    def users(self) -> tuple[int, ...]:
        return tuple(user for user, _action in self.selected_actions)

    def mapping(self, anchor: Assignment) -> dict[int, Action]:
        result = dict(anchor)
        for user, action in self.selected_actions:
            if result[user] == action:
                raise ValueError("coalition proposals must change every member action")
            result[user] = action
        return result


@dataclass(frozen=True, slots=True)
class ExactInteractionLabel:
    """Exact additive residual and its complete evaluation receipt."""

    users: tuple[int, ...]
    baseline: Fraction
    singleton_values: tuple[tuple[int, Fraction], ...]
    coalition_value: Fraction
    singleton_differences: tuple[tuple[int, Fraction], ...]
    objective_delta: Fraction
    psi: Fraction
    distinct_evaluation_count: int


def exact_interaction_label(
    *,
    anchor: Assignment,
    selected: Assignment,
    evaluate: Callable[[Mapping[int, Action]], Fraction],
) -> ExactInteractionLabel:
    """Evaluate baseline, every exact singleton, and the joint configuration.

    A size-k label necessarily authenticates k+2 distinct configurations.
    Learned singleton predictions are never accepted by this interface.
    """

    users = tuple(sorted(user for user in anchor if anchor[user] != selected[user]))
    if len(users) < 2:
        raise ValueError("interaction labels require at least two changed users")
    baseline = evaluate(anchor)
    singleton_values: list[tuple[int, Fraction]] = []
    identities = {tuple(sorted(anchor.items()))}
    for user in users:
        mapping = dict(anchor)
        mapping[user] = selected[user]
        identity = tuple(sorted(mapping.items()))
        if identity in identities:
            raise ValueError("singleton evaluation is not distinct from baseline")
        identities.add(identity)
        singleton_values.append((user, evaluate(mapping)))
    selected_identity = tuple(sorted(selected.items()))
    if selected_identity in identities:
        raise ValueError("coalition evaluation is not distinct from baseline/singletons")
    identities.add(selected_identity)
    coalition_value = evaluate(selected)
    singleton_differences = tuple(
        (user, value - baseline) for user, value in singleton_values
    )
    objective_delta = coalition_value - baseline
    psi = objective_delta - sum(
        (difference for _user, difference in singleton_differences), Fraction()
    )
    if len(identities) != len(users) + 2:
        raise AssertionError("exact interaction receipt lost a required evaluation")
    return ExactInteractionLabel(
        users=users,
        baseline=baseline,
        singleton_values=tuple(singleton_values),
        coalition_value=coalition_value,
        singleton_differences=singleton_differences,
        objective_delta=objective_delta,
        psi=psi,
        distinct_evaluation_count=len(identities),
    )


def exact_r3(
    *,
    anchor: Assignment,
    selected: Assignment,
    label: ExactInteractionLabel,
    evaluate: Callable[[Mapping[int, Action]], Fraction],
) -> tuple[Fraction, tuple[tuple[tuple[int, int], Fraction], ...]]:
    """Return R3(A)=Psi(A)-sum_{pairs in A} Psi(pair), exactly."""

    if len(label.users) < 3:
        raise ValueError("R3 is defined here only for coalitions of size >=3")
    singleton = dict(label.singleton_values)
    pair_terms: list[tuple[tuple[int, int], Fraction]] = []
    for first, second in itertools.combinations(label.users, 2):
        mapping = dict(anchor)
        mapping[first] = selected[first]
        mapping[second] = selected[second]
        pair_value = evaluate(mapping)
        pair_psi = (
            pair_value
            - label.baseline
            - (singleton[first] - label.baseline)
            - (singleton[second] - label.baseline)
        )
        pair_terms.append(((first, second), pair_psi))
    return (
        label.psi - sum((value for _pair, value in pair_terms), Fraction()),
        tuple(pair_terms),
    )


def best_alternatives(
    anchor: Assignment,
    legal_actions: Mapping[int, Sequence[Action]],
) -> dict[int, Action]:
    """First sealed-shortlist action different from the anchor, per user."""

    return {
        user: next(action for action in legal_actions[user] if action != anchor[user])
        for user in sorted(anchor)
        if any(action != anchor[user] for action in legal_actions[user])
    }


def occupancy_activation_proposals(
    *,
    anchor: Assignment,
    legal_actions: Mapping[int, Sequence[Action]],
) -> tuple[CoalitionProposal, ...]:
    """Move the minimum available users into every beam at occupancy one/two.

    Occupancy-two activations are returned as singleton mechanism observations;
    callers exclude them from an interaction-training shard because an exact
    singleton has no interaction residual.  Occupancy-one activations are
    trainable pairs and cross the same occupancy-three threshold.
    """

    occupants: dict[Action, list[int]] = {}
    for user, action in anchor.items():
        if action is not None:
            occupants.setdefault(action, []).append(user)
    result: list[CoalitionProposal] = []
    for beam, current_users in sorted(occupants.items(), key=lambda item: repr(item[0])):
        occupancy = len(current_users)
        if occupancy not in (1, 2):
            continue
        needed = 3 - occupancy
        candidates = [
            (tuple(legal_actions[user]).index(beam), user)
            for user in sorted(anchor)
            if anchor[user] != beam and beam in legal_actions[user]
        ]
        ranked_users = tuple(user for _rank, user in sorted(candidates)[:needed])
        selected_users = tuple(sorted(ranked_users))
        if len(selected_users) != needed:
            continue
        result.append(
            CoalitionProposal(
                family=OCCUPANCY_ACTIVATION,
                selected_actions=tuple((user, beam) for user in selected_users),
                mechanism_key=f"beam:{beam!r}",
                metadata={
                    "beam": repr(beam),
                    "occupancy_before": occupancy,
                    "occupancy_after": 3,
                    "incoming_users": list(selected_users),
                },
            )
        )
    return tuple(result)


def beam_evacuation_proposals(
    *,
    anchor: Assignment,
    legal_actions: Mapping[int, Sequence[Action]],
) -> tuple[CoalitionProposal, ...]:
    """Evacuate every beam with two or three occupants to best alternatives."""

    alternatives = best_alternatives(anchor, legal_actions)
    occupants: dict[Action, list[int]] = {}
    for user, action in anchor.items():
        if action is not None:
            occupants.setdefault(action, []).append(user)
    result = []
    for beam, users in sorted(occupants.items(), key=lambda item: repr(item[0])):
        if len(users) not in (2, 3) or any(user not in alternatives for user in users):
            continue
        result.append(
            CoalitionProposal(
                family=BEAM_EVACUATION,
                selected_actions=tuple((user, alternatives[user]) for user in sorted(users)),
                mechanism_key=f"beam:{beam!r}",
                metadata={"beam": repr(beam), "occupancy_before": len(users), "occupancy_after": 0},
            )
        )
    return tuple(result)


def nested_subset_proposals(
    *,
    block: Sequence[int],
    alternatives: Mapping[int, Action],
) -> tuple[CoalitionProposal, ...]:
    """Every non-trivial subset of one five/six-user alternative block."""

    users = tuple(sorted(int(user) for user in block))
    if len(users) not in (5, 6) or len(set(users)) != len(users):
        raise ValueError("nested subset blocks must contain five or six unique users")
    if not set(users) <= set(alternatives):
        raise ValueError("every nested-block user requires a legal alternative")
    result = []
    for mask in range(1 << len(users)):
        selected = tuple(
            (user, alternatives[user])
            for offset, user in enumerate(users)
            if mask & (1 << offset)
        )
        if len(selected) < 2:
            continue
        result.append(
            CoalitionProposal(
                family=NESTED_SUBSETS,
                selected_actions=selected,
                mechanism_key=f"block:{','.join(map(str, users))}:mask:{mask:0{len(users)}b}",
                metadata={"block": list(users), "mask": mask, "scalar_observation_count": 1 << len(users)},
            )
        )
    return tuple(result)

