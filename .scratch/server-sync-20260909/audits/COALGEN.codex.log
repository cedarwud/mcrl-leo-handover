def _setting(label: str) -> PhysicsSetting:
    matches = [setting for setting in MATRIX_SETTINGS if setting.label == label]
    if len(matches) != 1:
        raise ProbeError(f"cell must be one of the {len(MATRIX_SETTINGS)} declared labels: {label!r}")
