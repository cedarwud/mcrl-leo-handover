def _identity(action):
    if action.is_null:
        return None
    return (action.norad_id, action.beam_chain_id)


def _calibration(source: Path):
    payload = json.loads((source / f"{LABEL}-rows-manifest.json").read_text())["calibration"]
    fraction = lambda key: Fraction(*payload[key])
    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
    path = source / "rows" / f"world-{world_number}" / f"{LABEL}-coalition-anchor-{anchor_index:03d}.jsonl"
    payload = json.loads(path.read_text(encoding="ascii").splitlines()[1])
    actions = []
    for member in payload["context"]["members"]:
        action = member["selected_action"]
        identity = None if action["norad_id"] is None else (int(action["norad_id"]), int(action["beam_chain_id"]))
        user = int(member["user_id"])
        if anchor.mapping[user] == identity:
            raise RuntimeError("archived pair member no longer changes the anchor")
        actions.append((user, identity))
    proposal = CoalitionProposal(
        family=PAIR_CATALOGUE,
        selected_actions=tuple(sorted(actions)),
        mechanism_key=f"archived:{path.name}",
        metadata={"archived_shard_sha256": hashlib.sha256(path.read_bytes()).hexdigest()},
    )
    return proposal, payload


def _aggressor_relief_proposals(tape, step_index: int, anchor, legal_actions) -> tuple[CoalitionProposal, ...]:
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        return ()
    alternatives = best_alternatives(anchor.mapping, legal_actions)
    row_of = arrays._row_index()
    candidates = []
    for victim in sorted(anchor.mapping):
        victim_beam = anchor.mapping[victim]
        victim_row = row_of.get((victim, victim_beam)) if victim_beam is not None else None
        if victim not in alternatives or victim_row is None:
            continue
        contributors = []
        for aggressor in sorted(anchor.mapping):
            source_beam = anchor.mapping[aggressor]
            if aggressor == victim or aggressor not in alternatives or source_beam is None:
                continue
            contribution = float(arrays._cross(0, victim_row, source_beam)[0])
            if contribution > 0.0:
                contributors.append((contribution, aggressor, source_beam))
        contributors.sort(key=lambda item: (-item[0], item[1]))
        if len(contributors) >= 3:
            candidates.append((math.fsum(row[0] for row in contributors[:3]), victim, contributors))
    if not candidates:
        return ()
    _harm, victim, contributors = min(candidates, key=lambda item: (-item[0], item[1]))
    result = []
    for top_n in (2, 3):
        selected_users = (victim, *(row[1] for row in contributors[:top_n]))
        contribution_rows = contributors[:top_n]
        result.append(
            CoalitionProposal(
                family=AGGRESSOR_RELIEF,
                selected_actions=tuple(sorted((user, alternatives[user]) for user in selected_users)),
                mechanism_key=f"victim:{victim}:top:{top_n}",
                metadata={
                    "victim": victim,
                    "top_contributor_count": top_n,
                    "contributors": [row[1] for row in contribution_rows],
                    "nominal_cross_gain": [float_hex(row[0]) for row in contribution_rows],
                    "alternative_rule": "first-different-action-in-sealed-shortlist",
                },
            )
        )
    return tuple(result)


class ExactObjectiveCache:
    """Anchor-local exact sealed-objective cache with authenticated full keys."""

    def __init__(self, *, tape, step_index, carrier, anchor, evaluator, calibration, setting, run_setting):
        self.tape = tape
        self.step_index = step_index
        self.carrier = carrier
        self.anchor = anchor
        self.evaluator = evaluator
        self.calibration = calibration
        self.evaluator_configuration = {
            "engine_schema": pilot.ENGINE.SCHEMA,
            "setting_id": setting.label,
            "setting_digest": run_setting.digest,
            "field": evaluator.field,
            "boundary_indices": list(evaluator.boundary_indices),
            "physics_digest": pilot.PHYSICS_DIGEST,
            "calibration_digest": calibration.digest,
        }
        self.anchor_context = {
            "world_id": tape.domain,
            "world_seed": tape.seed,
            "step_index": step_index,
            "carrier": carrier,
            "anchor_configuration_id": anchor.configuration_id,
            "anchor_assignments": list(anchor.assignments),
            "transition_configuration_id": evaluator.transition_from.configuration_id,
            "cell_rekeyed_users": list(evaluator.cell_rekeyed_users),
        }
        self._configs = {}
        self._values = {}
        self.requests = 0
        self.hits = 0

    def config(self, mapping: Mapping[int, object]):
        assignments = tuple(sorted(mapping.items()))
        config = self._configs.get(assignments)
        if config is None:
            config = pilot.ENGINE._configuration(self.anchor, dict(assignments), kind="mechanism-corpus-exact")
            self._configs[assignments] = config
        return config

    def key(self, mapping: Mapping[int, object]) -> str:
        config = self.config(mapping)
        return canonical_sha256({
            "schema": f"{SCHEMA}-evaluation-cache-key-v1",
            "anchor": self.anchor_context,
            "context": {
                "objective": "bits-lambda*joules+kappa*phi",
                "phi_reference": "anchor-to-proposed-actions",
            },
            "proposed_actions": list(config.assignments),
            "evaluator_configuration": self.evaluator_configuration,
        })

    def prepare(self, mappings: Sequence[Mapping[int, object]]) -> None:
        configs = {self.config(mapping).assignments: self.config(mapping) for mapping in mappings}
        ordered = list(configs.values())
        for start in range(0, len(ordered), 1024):
            self.evaluator.evaluate_many(tuple(ordered[start:start + 1024]))

    def value(self, mapping: Mapping[int, object]) -> Fraction:
        self.requests += 1
        key = self.key(mapping)
        if key in self._values:
            self.hits += 1
            return self._values[key]
        config = self.config(mapping)
        if config.configuration_id in self.evaluator._invalid:
            raise ValueError("invalid exact configuration")
        profile = self.evaluator.evaluate(config)
        value = (
            Fraction(str(profile.bits))
            - self.calibration.eta_ref * Fraction(str(profile.joules))
            + self.calibration.kappa_bits_per_user_step * pilot.ENGINE._phi_for(self.anchor, config)
        )
        self._values[key] = value
        return value


def _all_required_mappings(anchor, proposals):
    base = anchor.mapping
    mappings = [base]
    for proposal in proposals:
        selected = proposal.mapping(base)
        mappings.append(selected)
        for user in proposal.users:
            singleton = dict(base)
            singleton[user] = selected[user]
            mappings.append(singleton)
        if len(proposal.users) >= 3:
            for first, second in itertools.combinations(proposal.users, 2):
                pair = dict(base)
                pair[first] = selected[first]
                pair[second] = selected[second]
                mappings.append(pair)
    return mappings


