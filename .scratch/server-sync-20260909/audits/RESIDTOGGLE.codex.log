+def selected_rows(tape, candidates: Sequence[Candidate]) -> np.ndarray:
+    arrays = tape.steps[0].arrays  # shape only; caller replaces step below
+    if arrays is None:
+        raise RuntimeError("real anchor lacks primitive arrays")
+    raise AssertionError("step-specific overload required")
