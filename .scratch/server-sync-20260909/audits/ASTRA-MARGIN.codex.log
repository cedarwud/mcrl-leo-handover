   226	def keyed_fading_gain(
   227	    *,
   228	    world: int,
   229	    user: int,
   230	    norad: int,
   231	    absolute_time_ns: int,
   232	    elevation_deg: float,
   233	) -> float:
   234	    """Return the action-independent realised fading gain at the actual elevation.
   235	
   236	    Shadow and Rician components use separate stable keys.  Elevation is not
   237	    part of either key: two elevations therefore reuse the same standard-
   238	    normal variate while the elevation-dependent shadow sigma and
   239	    scintillation table genuinely alter the realised channel.  This is the
   240	    intended common-random-number comparison and prevents the legacy fixed
   241	    10-degree shadow fallback from returning.
   242	    """
