   244	    if not math.isfinite(elevation_deg) or not -90.0 <= elevation_deg <= 90.0:
   245	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
   246	    shadow_rng = np.random.default_rng(
   247	        keyed_component_seed(world, user, norad, absolute_time_ns, "shadow")
   248	    )
   249	    rician_rng = np.random.default_rng(
   250	        keyed_component_seed(world, user, norad, absolute_time_ns, "rician")
   251	    )
   252	    sigma_db = float(shadow_sigma_db(elevation_deg))
   253	    shadow_db = sigma_db * float(shadow_rng.standard_normal())
   254	    deterministic_loss_db = float(scintillation_loss_db(elevation_deg))
   255	    rician = float(rician_power_gain(rician_rng, (1,))[0])
   256	    return rician * 10.0 ** (-(shadow_db + deterministic_loss_db) / 10.0)
