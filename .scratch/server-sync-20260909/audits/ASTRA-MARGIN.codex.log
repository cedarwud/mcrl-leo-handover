   259	def fading_quantile_elevation_bin(elevation_deg: float) -> float:
   260	    """Return the sealed nearest 0.5-degree quantile-cache bin."""
   261	
   262	    if not math.isfinite(elevation_deg) or not -90.0 <= elevation_deg <= 90.0:
   263	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
   264	    # Avoid Python's ties-to-even rule so the binning convention is explicit.
   265	    return math.floor(elevation_deg / FADING_QUANTILE_ELEVATION_BIN_DEG + 0.5) * FADING_QUANTILE_ELEVATION_BIN_DEG
