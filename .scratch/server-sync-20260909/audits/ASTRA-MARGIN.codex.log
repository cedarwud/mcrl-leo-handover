   204	    """Mean of ``10**(-X/10)`` for ``X ~ Normal(0, sigma_db**2)``."""
   205	
   206	    if not math.isfinite(sigma_db) or sigma_db < 0.0:
   207	        raise ValueError("sigma_db must be finite and nonnegative")
   208	    return math.exp(0.5 * (sigma_db * math.log(10.0) / 10.0) ** 2)
