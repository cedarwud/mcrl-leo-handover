   183	def rician_power_gain(
   184	    rng: np.random.Generator,
   185	    size: tuple[int, ...],
   186	    *,
   187	    k_factor_db: float = RICIAN_K_FACTOR_DB,
   188	) -> np.ndarray:
   189	    """Unit-mean Rician power gain."""
   190	
   191	    if not isinstance(rng, np.random.Generator):
   192	        raise TypeError("rng must be an explicit numpy Generator")
   193	    if not math.isfinite(k_factor_db):
   194	        raise ValueError("k_factor_db must be finite")
   195	    k_linear = 10.0 ** (k_factor_db / 10.0)
   196	    los = math.sqrt(k_linear / (k_linear + 1.0))
   197	    sigma = math.sqrt(1.0 / (2.0 * (k_linear + 1.0)))
   198	    real = los + sigma * rng.standard_normal(size)
   199	    imaginary = sigma * rng.standard_normal(size)
   200	    return real**2 + imaginary**2
