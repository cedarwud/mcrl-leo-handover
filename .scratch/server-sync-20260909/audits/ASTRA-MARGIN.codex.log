   379	    )
   380	    forced = (
   381	        np.zeros(len(active_user_ids), dtype=np.bool_)
   382	        if force_cap is None
   383	        else np.asarray(force_cap, dtype=np.bool_)
   384	    )
   385	    if targets.shape != caps.shape or forced.shape != caps.shape:
   386	        raise MCRLContractError("power target, forced-cap mask, and caps must share shape")
   387	    power = np.zeros(len(active_user_ids), dtype=np.float64)
   388	    residual = math.inf
   389	    recent_changes: list[float] = []
   390	    status: Literal["CONVERGED", "CONVERGED_SLOW"] = "CONVERGED"
   391	    for iteration in range(1, config.solver_iteration_cap + 1):
   392	        updated = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   393	        updated[forced] = caps[forced]
   394	        if not np.all(np.isfinite(updated)) or np.any(
