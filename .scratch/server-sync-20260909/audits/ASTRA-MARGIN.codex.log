   268	def fading_quantile_derivation_seed(elevation_bin_deg: float, alpha: float) -> int:
   269	    """Domain-separated seed for the sealed Monte-Carlo quantile procedure."""
   270	
   271	    payload = (
   272	        f"{FADING_QUANTILE_DERIVATION_DOMAIN}|"
   273	        f"{elevation_bin_deg:.1f}|{alpha:.17g}"
   274	    ).encode("ascii")
   275	    return int.from_bytes(hashlib.sha256(payload).digest()[:8], "big")
