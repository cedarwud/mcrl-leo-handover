   339	def _masked_coupling(
   340	    geometry: Geometry,
   341	    active: tuple[int, ...],
   342	    field: FieldKind,
   343	    overlap: np.ndarray | None = None,
   344	) -> np.ndarray:
   345	    count = len(active)
   346	    coupling = np.zeros((count, count), dtype=np.float64)
   347	    cross = geometry.cross(field)
   348	    for row, victim in enumerate(active):
   349	        victim_link = geometry.links[victim]
   350	        for column, aggressor in enumerate(active):
   351	            aggressor_link = geometry.links[aggressor]
   352	            if victim == aggressor or victim_link.beam == aggressor_link.beam:
   353	                continue
   354	            if victim_link.color != aggressor_link.color:
   355	                continue
   356	            factor = 1.0 if overlap is None else float(overlap[row, column])
   357	            coupling[row, column] = cross[victim, aggressor] * factor
   358	    return coupling
