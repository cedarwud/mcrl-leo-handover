   278	@lru_cache(maxsize=None)
   279	def _cached_fading_product_quantile(elevation_bin_deg: float, alpha: float) -> float:
   280	    """200 000-draw quantile of Rician x shadow x scintillation fading."""
   281	
   282	    if not math.isfinite(alpha) or not 0.0 < alpha < 1.0:
   283	        raise MCRLContractError("fading quantile alpha must lie strictly in (0,1)")
   284	    if fading_quantile_elevation_bin(elevation_bin_deg) != elevation_bin_deg:
   285	        raise MCRLContractError("quantile cache key is not a sealed 0.5-degree bin")
   286	    rng = np.random.default_rng(
   287	        fading_quantile_derivation_seed(elevation_bin_deg, alpha)
   288	    )
   289	    shadow_db = float(shadow_sigma_db(elevation_bin_deg)) * rng.standard_normal(
   290	        FADING_QUANTILE_DRAWS
   291	    )
   292	    rician = rician_power_gain(rng, (FADING_QUANTILE_DRAWS,))
   293	    product = rician * 10.0 ** (
   294	        -(
   295	            shadow_db
   296	            + float(scintillation_loss_db(elevation_bin_deg))
   297	        )
   298	        / 10.0
   299	    )
   300	    return float(np.quantile(product, alpha, method="linear"))
