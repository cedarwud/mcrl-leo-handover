+#!/usr/bin/env python3
+"""Validate the C2 declared-target diagnostic artifact."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("result", type=Path)
+    args = parser.parse_args()
+    data = json.loads(args.result.read_text(encoding="utf-8"))
+    assert data["schema"] == "c2-declared-target-learnability-diagnostic-v1"
+    assert data["status"] == "DIAGNOSTIC_NOT_CLAIM"
+    generation = data["generation"]
+    assert generation["anchors"] >= 4
+    assert generation["worlds"] == ["V025_PROBE/world/1", "V025_PROBE/world/2"]
+    assert generation["max_abs_decomposition_residual"] < 1e-10
+    assert generation["max_abs_target_helper_residual"] < 1e-10
+    root = args.result.resolve().parents[2]
+    assert generation["pilot_source_sha256_before_and_after"] == sha256(root / "scripts/run_v025_pilot_c3.py")
+
+    contract = data["learner_contract"]
+    assert contract["hidden_layers"] == [100, 50, 50]
+    assert contract["activation"] == "tanh"
+    assert contract["learning_rate"] == 1e-3
+    assert contract["gauge_beta"] == 0.1
+    assert contract["adam_betas"] == [0.9, 0.999]
+    assert contract["epochs"] == 2000
+    assert contract["deterministic_pair_cap"] == 4096
+
+    audit = data["slot_audit"]
+    assert audit["nominal_dimension"] == 22
+    assert 0 < audit["matrix_rank_centered"] <= audit["matrix_rank_uncentered"] <= 22
+    assert 0 < audit["effective_dimension_semantic"] <= 22
+    assert len(audit["q1_reappearing_slots"]) == 7
+
+    for model in ("sealed", "linear", "constant_mean", "absorbing_floor_from_q2"):
+        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+            row = data["models"][model][regime]
+            for metric in ("r2", "pairwise_ordering", "top1_accuracy"):
+                assert isinstance(row[metric], (int, float))
+    assert set(data["capacity"]["widths"]) == {"100x50x50", "150x75x75", "200x100x100"}
+    for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+        high = data["capacity"]["high_capacity"][regime]
+        for metric in ("r2", "pairwise_ordering", "top1_accuracy"):
+            assert isinstance(high[metric], (int, float))
+    for model in ("sealed", "linear", "constant_mean", "absorbing_floor_from_q2", "high_capacity"):
+        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+            bootstrap = data["anchor_bootstraps"][model][regime]
+            assert bootstrap["replicates"] == 2000
+            assert bootstrap["clusters"] == generation["anchors"]
+            assert set(bootstrap["intervals"]) == {"r2", "pairwise_ordering", "top1_accuracy"}
+
+    structure = data["target_structure"]
+    assert set(structure["discrete_floors"]) == {"0", "-1", "-2", "-3"}
+    assert structure["ties"]["all_within_group_pairs"] >= structure["ties"]["nontied_pairs"] > 0
+    assert data["resource_usage"]["python_process_cap"] == 3
+    assert data["resource_usage"]["blas_threads"] == 1
+    assert data["resource_usage"]["nice"] == 15
+    assert data["resource_usage"]["maximum_process_peak_rss_mib"] < 5120.0
+    assert any("no production" in item.lower() for item in data["limitations"])
+    print(json.dumps({
+        "validated": str(args.result), "anchors": generation["anchors"],
+        "rows": generation["rows"], "effective_dimension": audit["effective_dimension_semantic"],
+        "peak_rss_mib": data["resource_usage"]["maximum_process_peak_rss_mib"],
+    }, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

