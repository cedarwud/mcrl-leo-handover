index 0000000000000000000000000000000000000000..3db4d54772a711766e6a0d1ab614c4dab451217a
--- /dev/null
+++ b/.scratch/c2-declared/analyze.py
@@ -0,0 +1,629 @@
+#!/usr/bin/env python3
+"""Held-out learnability analysis for exact-path declared C2 rows."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+import multiprocessing as mp
+from pathlib import Path
+import resource
+import time
+from types import SimpleNamespace
+
+import numpy as np
+
+from mcrl.physics_v025.tapes import seed_from_domain
+from mcrl.stagec_v025.learner import AdamMLPHead, LEGACY_EPOCH_BUDGET, LEGACY_TRAINER_LITERALS
+from mcrl.stagec_v025.state import Q2_FEATURES
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRATCH = ROOT / ".scratch/c2-declared"
+PAIR_LIMIT = 4_096
+BOOTSTRAP_REPLICATES = 2_000
+PILOT_LEARNER_DOMAINS = tuple(f"V025_LEARNER/seed/{i}" for i in range(1, 5))
+PILOT_LEARNER_SEEDS = tuple(seed_from_domain(value) for value in PILOT_LEARNER_DOMAINS)
+ARCHITECTURES = (
+    (100, 50, 50),
+    (150, 75, 75),
+    (200, 100, 100),
+)
+_WORKER_DATA = None
+
+
+@dataclass(frozen=True)
+class Dataset:
+    x: np.ndarray
+    y: np.ndarray
+    lost: np.ndarray
+    surplus: np.ndarray
+    reference: np.ndarray
+    anchor: np.ndarray
+    world: np.ndarray
+    group: np.ndarray
+    action_index: np.ndarray
+    anchor_records: tuple[dict[str, object], ...]
+    metadata: tuple[dict[str, object], ...]
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_dataset(paths: list[Path]) -> Dataset:
+    metadata = []
+    anchors = []
+    row_blocks = []
+    for path in paths:
+        with path.open(encoding="utf-8") as handle:
+            for line in handle:
+                record = json.loads(line)
+                if record["kind"] == "metadata":
+                    metadata.append(record)
+                else:
+                    anchors.append({key: value for key, value in record.items() if key != "rows"})
+                    # Only this decoded anchor record exists at a time; convert it
+                    # immediately to compact numeric tuples before reading the next.
+                    for row in record["rows"]:
+                        row_blocks.append((
+                            row["q2"], row["declared"], row["lost_offsets"],
+                            row["forecast_surplus_normalized"], row["reference"],
+                            record["anchor_id"], record["world_id"], row["user_id"],
+                            row["action_index"],
+                        ))
+                del record
+    anchor_names = sorted({row[5] for row in row_blocks})
+    world_names = sorted({row[6] for row in row_blocks})
+    group_names = sorted({f"{row[5]}|user/{row[7]}" for row in row_blocks})
+    anchor_code = {value: index for index, value in enumerate(anchor_names)}
+    world_code = {value: index for index, value in enumerate(world_names)}
+    group_code = {value: index for index, value in enumerate(group_names)}
+    result = Dataset(
+        x=np.asarray([row[0] for row in row_blocks], dtype=np.float64),
+        y=np.asarray([row[1] for row in row_blocks], dtype=np.float64),
+        lost=np.asarray([row[2] for row in row_blocks], dtype=np.int8),
+        surplus=np.asarray([row[3] for row in row_blocks], dtype=np.float64),
+        reference=np.asarray([row[4] for row in row_blocks], dtype=bool),
+        anchor=np.asarray([anchor_code[row[5]] for row in row_blocks], dtype=np.int16),
+        world=np.asarray([world_code[row[6]] for row in row_blocks], dtype=np.int8),
+        group=np.asarray([group_code[f"{row[5]}|user/{row[7]}"] for row in row_blocks], dtype=np.int32),
+        action_index=np.asarray([row[8] for row in row_blocks], dtype=np.int16),
+        anchor_records=tuple(anchors), metadata=tuple(metadata),
+    )
+    del row_blocks
+    return result
+
+
+def splits(data: Dataset, regime: str):
+    key = data.anchor if regime == "leave_one_anchor_out" else data.world
+    for value in np.unique(key):
+        test = key == value
+        yield ~test, test, str(int(value))
+
+
+def build_pair_batch(data: Dataset, train: np.ndarray) -> SimpleNamespace:
+    ref_by_group = {int(data.group[i]): int(i) for i in np.flatnonzero(train & data.reference)}
+    candidates = np.flatnonzero(train & ~data.reference)
+    references = np.asarray([ref_by_group[int(data.group[i])] for i in candidates], dtype=np.int64)
+    if candidates.size > PAIR_LIMIT:
+        chosen = np.linspace(0, candidates.size - 1, PAIR_LIMIT, dtype=np.int64)
+        candidates, references = candidates[chosen], references[chosen]
+    return SimpleNamespace(
+        reference_states=data.x[references], candidate_states=data.x[candidates],
+        target_deltas=data.y[candidates] - data.y[references],
+    )
+
+
+def ordering_counts(prediction, truth, groups, lost):
+    credit = 0.0
+    pairs = 0
+    score_ties = 0
+    true_ties = 0
+    all_pairs = 0
+    cross_credit = 0.0
+    cross_pairs = 0
+    same_credit = 0.0
+    same_pairs = 0
+    top1_hits = 0
+    top1_true_tied = 0
+    group_count = 0
+    for group_id in np.unique(groups):
+        idx = np.flatnonzero(groups == group_id)
+        if idx.size < 2:
+            continue
+        target, score, lost_group = truth[idx], prediction[idx], lost[idx]
+        left, right = np.triu_indices(idx.size, 1)
+        td, sd = target[left] - target[right], score[left] - score[right]
+        all_pairs += int(td.size)
+        tied = np.abs(td) <= 1e-12
+        true_ties += int(tied.sum())
+        keep = ~tied
+        td, sd = td[keep], sd[keep]
+        cross = lost_group[left][keep] != lost_group[right][keep]
+        pair_credit = (np.sign(td) == np.sign(sd)).astype(np.float64)
+        predicted_tie = np.abs(sd) <= 1e-15
+        pair_credit[predicted_tie] = 0.5
+        credit += float(pair_credit.sum())
+        pairs += int(td.size)
+        score_ties += int(predicted_tie.sum())
+        cross_credit += float(pair_credit[cross].sum())
+        cross_pairs += int(cross.sum())
+        same_credit += float(pair_credit[~cross].sum())
+        same_pairs += int((~cross).sum())
+        selected = int(np.argmax(score))
+        top1_hits += int(target[selected] >= target.max() - 1e-12)
+        top1_true_tied += int(np.sum(target >= target.max() - 1e-12) > 1)
+        group_count += 1
+    return {
+        "order_credit": credit, "pairs": pairs, "score_ties_on_nontied": score_ties,
+        "true_ties": true_ties, "all_pairs": all_pairs,
+        "cross_lost_credit": cross_credit, "cross_lost_pairs": cross_pairs,
+        "same_lost_credit": same_credit, "same_lost_pairs": same_pairs,
+        "top1_hits": top1_hits, "top1_true_tied_groups": top1_true_tied,
+        "groups": group_count,
+    }
+
+
+def metric(prediction, truth, groups, lost):
+    rss = float(np.square(truth - prediction).sum())
+    tss = float(np.square(truth - truth.mean()).sum())
+    counts = ordering_counts(prediction, truth, groups, lost)
+    safe = lambda numerator, denominator: float(numerator / denominator) if denominator else None
+    return {
+        "r2": float(1.0 - rss / tss) if tss else None,
+        "pairwise_ordering": safe(counts["order_credit"], counts["pairs"]),
+        "top1_accuracy": safe(counts["top1_hits"], counts["groups"]),
+        "rows": int(truth.size), "pairs": counts["pairs"], "groups": counts["groups"],
+        "ordering_strata": {
+            "cross_lost_fraction_of_nontied": safe(counts["cross_lost_pairs"], counts["pairs"]),
+            "cross_lost_ordering": safe(counts["cross_lost_credit"], counts["cross_lost_pairs"]),
+            "same_lost_ordering": safe(counts["same_lost_credit"], counts["same_lost_pairs"]),
+            "prediction_tie_fraction_on_nontied": safe(counts["score_ties_on_nontied"], counts["pairs"]),
+        },
+    }
+
+
+def architecture_key(architecture):
+    return "x".join(str(value) for value in architecture)
+
+
+def adam_task(task):
+    architecture, regime, seed = task
+    data = _WORKER_DATA
+    literal = dict(LEGACY_TRAINER_LITERALS["C2"])
+    literal["hidden_layers"] = architecture
+    prediction = np.empty_like(data.y)
+    folds = []
+    started = time.perf_counter()
+    for train, test, fold in splits(data, regime):
+        batch = build_pair_batch(data, train)
+        head = AdamMLPHead.create(data.x.shape[1], literal, np.random.default_rng(seed))
+        for _ in range(LEGACY_EPOCH_BUDGET):
+            head.update(batch)
+        prediction[test] = head._forward(data.x[test])[0]
+        folds.append({"fold": fold, "train_pairs": int(batch.target_deltas.size), "test_rows": int(test.sum())})
+    peak_mib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0
+    if peak_mib >= 5120.0:
+        raise RuntimeError(f"worker peak RSS cap exceeded: {peak_mib:.3f} MiB")
+    return {
+        **metric(prediction, data.y, data.group, data.lost),
+        "architecture": list(architecture), "regime": regime, "seed": int(seed),
+        "epochs": LEGACY_EPOCH_BUDGET, "pair_limit": PAIR_LIMIT, "folds": folds,
+        "wall_s": time.perf_counter() - started, "peak_rss_mib": peak_mib,
+        "prediction": prediction,
+    }
+
+
+def aggregate_seed_results(items):
+    result = {"seeds": len(items), "per_seed": []}
+    for field in ("r2", "pairwise_ordering", "top1_accuracy"):
+        values = np.asarray([row[field] for row in items], dtype=np.float64)
+        result[field] = float(values.mean())
+        result[field + "_median"] = float(np.median(values))
+        result[field + "_min"] = float(values.min())
+        result[field + "_max"] = float(values.max())
+    result["per_seed"] = [{k: v for k, v in row.items() if k != "prediction"} for row in items]
+    return result
+
+
+def linear_cv(data, regime):
+    prediction = np.empty_like(data.y)
+    for train, test, _ in splits(data, regime):
+        batch = build_pair_batch(data, train)
+        difference = batch.candidate_states - batch.reference_states
+        pair_design = np.column_stack((difference, np.zeros(difference.shape[0])))
+        gauge_design = np.column_stack((batch.reference_states, np.ones(batch.reference_states.shape[0])))
+        design = np.vstack((pair_design, math.sqrt(0.1) * gauge_design))
+        target = np.concatenate((batch.target_deltas, np.zeros(gauge_design.shape[0])))
+        coefficient = np.linalg.lstsq(design, target, rcond=None)[0]
+        prediction[test] = np.column_stack((data.x[test], np.ones(test.sum()))) @ coefficient
+    return metric(prediction, data.y, data.group, data.lost), prediction
+
+
+def constant_cv(data, regime, *, modal=False):
+    prediction = np.empty_like(data.y)
+    for train, test, _ in splits(data, regime):
+        if modal:
+            counts = Counter(float(v) for v in data.y[train])
+            value = min(counts, key=lambda item: (-counts[item], item))
+        else:
+            value = float(data.y[train].mean())
+        prediction[test] = value
+    return metric(prediction, data.y, data.group, data.lost), prediction
+
+
+def lost_from_q2(x):
+    result = np.zeros(x.shape[0], dtype=np.int8)
+    alive = np.ones(x.shape[0], dtype=bool)
+    for offset, (valid_slot, survival_slot) in enumerate(((10, 11), (14, 15), (18, 19)), start=1):
+        failed = alive & ((x[:, valid_slot] < 0.5) | (x[:, survival_slot] < 0.5))
+        result[failed] = 4 - offset
+        alive &= ~failed
+    return result
+
+
+def floor_cv(data, regime):
+    derived_lost = lost_from_q2(data.x)
+    if not np.array_equal(derived_lost, data.lost):
+        raise RuntimeError("q2 survival slots do not exactly recover absorbing lost offsets")
+    prediction = -derived_lost.astype(np.float64)
+    return metric(prediction, data.y, data.group, data.lost), prediction
+
+
+def random_feature_map(x, mean, scale, seed):
+    normalized = (x - mean) / scale
+    rng = np.random.default_rng(seed)
+    w1 = rng.normal(0.0, math.sqrt(2.0 / x.shape[1]), (x.shape[1], 256))
+    b1 = rng.normal(0.0, 0.1, 256)
+    h1 = np.maximum(normalized @ w1 + b1, 0.0)
+    w2 = rng.normal(0.0, math.sqrt(2.0 / 256), (256, 256))
+    b2 = rng.normal(0.0, 0.1, 256)
+    h2 = np.maximum(h1 @ w2 + b2, 0.0)
+    return np.column_stack((normalized, h1, h2, np.ones(x.shape[0])))
+
+
+def high_capacity_cv(data, regime):
+    prediction = np.empty_like(data.y)
+    seed = PILOT_LEARNER_SEEDS[0]
+    ridge_grid = (0.01, 0.1, 1.0, 10.0, 100.0, 1000.0)
+    choices = []
+    started = time.perf_counter()
+    for train, test, fold in splits(data, regime):
+        training_anchors = np.unique(data.anchor[train])
+        validation_anchors = training_anchors[-max(2, len(training_anchors) // 5):]
+        validation = train & np.isin(data.anchor, validation_anchors)
+        subtrain = train & ~validation
+        sub_mean, sub_scale = data.x[subtrain].mean(0), data.x[subtrain].std(0)
+        sub_scale[sub_scale == 0.0] = 1.0
+        z_sub = random_feature_map(data.x[subtrain], sub_mean, sub_scale, seed)
+        z_val = random_feature_map(data.x[validation], sub_mean, sub_scale, seed)
+        gram, rhs = z_sub.T @ z_sub, z_sub.T @ data.surplus[subtrain]
+        eigenvalues, eigenvectors = np.linalg.eigh(gram)
+        projected_rhs = eigenvectors.T @ rhs
+        validation_scores = []
+        for ridge in ridge_grid:
+            coef = eigenvectors @ (projected_rhs / (eigenvalues + ridge))
+            candidate = z_val @ coef - data.lost[validation]
+            validation_scores.append((metric(candidate, data.y[validation], data.group[validation], data.lost[validation])["r2"], ridge))
+        ridge = float(max(validation_scores, key=lambda row: (row[0], -row[1]))[1])
+        mean, scale = data.x[train].mean(0), data.x[train].std(0)
+        scale[scale == 0.0] = 1.0
+        z_train = random_feature_map(data.x[train], mean, scale, seed)
+        z_test = random_feature_map(data.x[test], mean, scale, seed)
+        gram = z_train.T @ z_train
+        coefficient = np.linalg.solve(gram + ridge * np.eye(gram.shape[0]), z_train.T @ data.surplus[train])
+        prediction[test] = z_test @ coefficient - lost_from_q2(data.x[test])
+        choices.append({"fold": fold, "ridge": ridge})
+    result = metric(prediction, data.y, data.group, data.lost)
+    result.update({
+        "architecture": "exact absorbing penalty from q2 survival slots plus fixed-seed 22-256-256 ReLU random features and ridge residual output",
+        "trainable_output_parameters": 535, "random_seed": seed,
+        "ridge": "training-only nested choice from [0.01,0.1,1,10,100,1000]",
+        "ridge_choices": choices, "wall_s": time.perf_counter() - started,
+    })
+    return result, prediction
+
+
+def anchor_bootstrap(predictions, data, seed_domain):
+    by_anchor = []
+    for anchor_id in np.unique(data.anchor):
+        mask = data.anchor == anchor_id
+        truth, groups, lost = data.y[mask], data.group[mask], data.lost[mask]
+        item = {"n": int(mask.sum()), "sum": float(truth.sum()), "sum2": float(np.square(truth).sum()), "predictions": []}
+        for prediction in predictions:
+            counts = ordering_counts(prediction[mask], truth, groups, lost)
+            item["predictions"].append({
+                "rss": float(np.square(truth - prediction[mask]).sum()),
+                "order_credit": counts["order_credit"], "pairs": counts["pairs"],
+                "top1_hits": counts["top1_hits"], "groups": counts["groups"],
+            })
+        by_anchor.append(item)
+    rng = np.random.default_rng(seed_from_domain(seed_domain))
+    draws = {"r2": [], "pairwise_ordering": [], "top1_accuracy": []}
+    for _ in range(BOOTSTRAP_REPLICATES):
+        selected = [by_anchor[int(i)] for i in rng.integers(0, len(by_anchor), len(by_anchor))]
+        n = sum(row["n"] for row in selected)
+        tss = sum(row["sum2"] for row in selected) - sum(row["sum"] for row in selected) ** 2 / n
+        seeded = []
+        for pred_index in range(len(predictions)):
+            seeded.append({
+                "r2": 1.0 - sum(row["predictions"][pred_index]["rss"] for row in selected) / tss,
+                "pairwise_ordering": sum(row["predictions"][pred_index]["order_credit"] for row in selected) / sum(row["predictions"][pred_index]["pairs"] for row in selected),
+                "top1_accuracy": sum(row["predictions"][pred_index]["top1_hits"] for row in selected) / sum(row["predictions"][pred_index]["groups"] for row in selected),
+            })
+        for field in draws:
+            draws[field].append(float(np.mean([row[field] for row in seeded])))
+    return {
+        "unit": "anchor", "clusters": len(by_anchor), "replicates": BOOTSTRAP_REPLICATES,
+        "seed": seed_from_domain(seed_domain),
+        "intervals": {field: {
+            "lower_2_5pct": float(np.quantile(values, 0.025)),
+            "upper_97_5pct": float(np.quantile(values, 0.975)),
+            "bootstrap_se": float(np.std(values, ddof=1)),
+        } for field, values in draws.items()},
+    }
+
+
+def slot_audit(data):
+    x = data.x
+    constants = []
+    for slot in range(x.shape[1]):
+        if np.all(x[:, slot] == x[0, slot]):
+            constants.append({"slot": slot, "name": Q2_FEATURES[slot].name, "value": float(x[0, slot])})
+    equal_pairs = []
+    for right in range(x.shape[1]):
+        for left in range(right):
+            if np.array_equal(x[:, left], x[:, right]):
+                equal_pairs.append({"redundant_slot": right, "source_slot": left, "relation": "equal"})
+    indicator_relations = []
+    for target in range(x.shape[1]):
+        if target in {row["slot"] for row in constants}:
+            continue
+        for source in range(x.shape[1]):
+            if source != target and np.array_equal(x[:, target], (x[:, source] > 0.0).astype(float)):
+                indicator_relations.append({"redundant_slot": target, "source_slot": source, "relation": "indicator(source>0)"})
+                break
+    # Greedy semantic count: constants, then exact duplicate targets, then indicator targets.
+    redundant_targets = {row["redundant_slot"] for row in equal_pairs}
+    redundant_targets.update(row["redundant_slot"] for row in indicator_relations)
+    redundant_targets.difference_update(row["slot"] for row in constants)
+    return {
+        "nominal_dimension": 22,
+        "matrix_rank_uncentered": int(np.linalg.matrix_rank(x)),
+        "matrix_rank_centered": int(np.linalg.matrix_rank(x - x.mean(axis=0))),
+        "effective_dimension_semantic": 22 - len(constants) - len(redundant_targets),
+        "constant_slots": constants,
+        "exact_equal_pairs": equal_pairs,
+        "exact_indicator_relations": indicator_relations,
+        "redundant_target_slots": sorted(redundant_targets),
+        "q1_reappearing_slots": [
+            {"q1_slot": 7, "q2_slot": 2, "name": "remaining_d2_time"},
+            {"q1_slot": 8, "q2_slot": 3, "name": "remaining_visibility_time"},
+            {"q1_slot": 9, "q2_slot": 4, "name": "refresh_phase"},
+            {"q1_slot": 3, "q2_slot": 5, "name": "background_occupancy_excluding_focal"},
+            {"q1_slot": 4, "q2_slot": 6, "name": "beam_active_before_focal"},
+            {"q1_slot": 5, "q2_slot": 7, "name": "satellite_active_before_focal"},
+            {"q1_slot": 15, "q2_slot": 9, "name": "missing_incumbent"},
+        ],
+    }
+
+
+def target_structure(data):
+    if not np.allclose(data.y, data.surplus - data.lost, rtol=0.0, atol=3e-15):
+        raise RuntimeError("stored target does not equal surplus/kappa minus lost offsets")
+    counts = Counter(float(value) for value in data.y)
+    mode_value, mode_count = min(counts.items(), key=lambda row: (-row[1], row[0]))
+    zero_surplus = data.surplus == 0.0
+    true_ties = 0
+    all_pairs = 0
+    cross_lost_nontied = 0
+    nontied = 0
+    top_tied_groups = 0
+    for group_id in np.unique(data.group):
+        idx = np.flatnonzero(data.group == group_id)
+        left, right = np.triu_indices(idx.size, 1)
+        td = data.y[idx][left] - data.y[idx][right]
+        tied = np.abs(td) <= 1e-12
+        all_pairs += int(td.size)
+        true_ties += int(tied.sum())
+        nontied += int((~tied).sum())
+        cross_lost_nontied += int(np.sum((data.lost[idx][left] != data.lost[idx][right]) & ~tied))
+        top_tied_groups += int(np.sum(data.y[idx] >= data.y[idx].max() - 1e-12) > 1)
+    quantiles = np.quantile(data.y, [0, .01, .05, .25, .5, .75, .95, .99, 1])
+    reference_values = data.y[data.reference]
+    reference_counts = Counter(float(value) for value in reference_values)
+    return {
+        "rows": int(data.y.size), "minimum": float(data.y.min()), "maximum": float(data.y.max()),
+        "mean": float(data.y.mean()), "std": float(data.y.std()), "unique_exact_float_values": len(counts),
+        "quantiles": {key: float(value) for key, value in zip(("0",".01",".05",".25",".5",".75",".95",".99","1"), quantiles)},
+        "mode": {"value": mode_value, "count": mode_count, "fraction": mode_count / data.y.size},
+        "reference_action_targets": {
+            "rows": int(reference_values.size),
+            "zero_count": int(np.sum(reference_values == 0.0)),
+            "zero_fraction": float(np.mean(reference_values == 0.0)),
+            "minimum": float(reference_values.min()), "maximum": float(reference_values.max()),
+            "exact_value_counts": {str(key): value for key, value in sorted(reference_counts.items())},
+            "note": "C2 has no universal zero reference gauge: when the BASE projection fails, its own absorbing persistence penalty remains.",
+        },
+        "lost_offset_distribution": {str(k): {"count": int(np.sum(data.lost == k)), "fraction": float(np.mean(data.lost == k))} for k in range(4)},
+        "discrete_floors": {str(-k): {
+            "count": int(np.sum(zero_surplus & (data.lost == k))),
+            "fraction_all_rows": float(np.mean(zero_surplus & (data.lost == k))),
+            "fraction_within_lost_class": float(np.mean(zero_surplus[data.lost == k])) if np.any(data.lost == k) else None,
+        } for k in range(4)},
+        "ties": {
+            "all_within_group_pairs": all_pairs, "true_tied_pairs": true_ties,
+            "true_tied_pair_fraction": true_ties / all_pairs,
+            "nontied_pairs": nontied,
+            "cross_lost_fraction_of_nontied": cross_lost_nontied / nontied,
+            "groups_with_tied_true_top": top_tied_groups,
+            "groups_with_tied_true_top_fraction": top_tied_groups / len(np.unique(data.group)),
+        },
+    }
+
+
+def main():
+    global _WORKER_DATA
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--inputs", type=Path, nargs="+", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    data = load_dataset(args.inputs)
+    _WORKER_DATA = data
+    if len(np.unique(data.anchor)) < 4 or len(np.unique(data.world)) != 2:
+        raise RuntimeError("need at least four anchors and exactly two worlds")
+
+    audit = slot_audit(data)
+    structure = target_structure(data)
+    print(json.dumps({"slot_audit_before_fit": audit, "target_structure_before_fit": structure}), flush=True)
+
+    tasks = []
+    for architecture in ARCHITECTURES:
+        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+            seeds = PILOT_LEARNER_SEEDS[:1] if regime == "leave_one_anchor_out" else PILOT_LEARNER_SEEDS
+            tasks.extend((architecture, regime, seed) for seed in seeds)
+    adam_results = []
+    with ProcessPoolExecutor(max_workers=2, mp_context=mp.get_context("fork")) as executor:
+        future_map = {executor.submit(adam_task, task): task for task in tasks}
+        for future in as_completed(future_map):
+            row = future.result()
+            adam_results.append(row)
+            print(json.dumps({
+                "finished": [list(future_map[future][0]), *future_map[future][1:]],
+                "r2": row["r2"], "ordering": row["pairwise_ordering"],
+                "top1": row["top1_accuracy"], "wall_s": row["wall_s"],
+                "peak_rss_mib": row["peak_rss_mib"],
+            }), flush=True)
+
+    capacity = {}
+    prediction_sets = {}
+    for architecture in ARCHITECTURES:
+        key = architecture_key(architecture)
+        capacity[key] = {}
+        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+            selected = sorted(
+                [row for row in adam_results if tuple(row["architecture"]) == architecture and row["regime"] == regime],
+                key=lambda row: row["seed"],
+            )
+            capacity[key][regime] = aggregate_seed_results(selected)
+            prediction_sets[(key, regime)] = [row["prediction"] for row in selected]
+
+    references = {"linear": {}, "constant_mean": {}, "constant_modal_floor": {}, "absorbing_floor_from_q2": {}}
+    reference_predictions = {}
+    for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+        for name, runner in (
+            ("linear", lambda: linear_cv(data, regime)),
+            ("constant_mean", lambda: constant_cv(data, regime)),
+            ("constant_modal_floor", lambda: constant_cv(data, regime, modal=True)),
+            ("absorbing_floor_from_q2", lambda: floor_cv(data, regime)),
+        ):
+            values, prediction = runner()
+            references[name][regime] = values
+            reference_predictions[(name, regime)] = [prediction]
+
+    high_capacity = {}
+    high_predictions = {}
+    for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+        values, prediction = high_capacity_cv(data, regime)
+        high_capacity[regime] = values
+        high_predictions[regime] = [prediction]
+        print(json.dumps({"high_capacity": regime, **values}), flush=True)
+
+    bootstraps = {}
+    models_for_bootstrap = {
+        "sealed": {regime: prediction_sets[(architecture_key(ARCHITECTURES[0]), regime)] for regime in ("leave_one_anchor_out", "leave_one_world_out")},
+        "linear": {regime: reference_predictions[("linear", regime)] for regime in ("leave_one_anchor_out", "leave_one_world_out")},
+        "constant_mean": {regime: reference_predictions[("constant_mean", regime)] for regime in ("leave_one_anchor_out", "leave_one_world_out")},
+        "absorbing_floor_from_q2": {regime: reference_predictions[("absorbing_floor_from_q2", regime)] for regime in ("leave_one_anchor_out", "leave_one_world_out")},
+        "high_capacity": high_predictions,
+    }
+    for name, regimes in models_for_bootstrap.items():
+        bootstraps[name] = {}
+        for regime, predictions in regimes.items():
+            bootstraps[name][regime] = anchor_bootstrap(predictions, data, f"C2REAL/{name}/{regime}/anchor-bootstrap/2026-09-10")
+
+    source_hashes = {row["pilot_source_sha256_before"] for row in data.metadata}
+    current_pilot_hash = file_sha256(ROOT / "scripts/run_v025_pilot_c3.py")
+    if source_hashes != {current_pilot_hash}:
+        raise RuntimeError("pilot source byte identity failed before/after generation")
+    exact_times = [float(row["exact_wall_s"]) for row in data.anchor_records]
+    process_peaks = [float(row["peak_rss_mib"]) for row in adam_results]
+    main_peak = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0
+    if max([main_peak, *process_peaks]) >= 5120.0:
+        raise RuntimeError("analysis exceeded 5 GiB per-process RSS cap")
+    generation = {
+        "worlds": sorted({row["world_id"] for row in data.metadata}),
+        "anchors": int(len(np.unique(data.anchor))), "rows": int(data.y.size),
+        "anchor_user_groups": int(len(np.unique(data.group))),
+        "provider_wall_s": [float(row["provider_wall_s"]) for row in data.metadata],
+        "exact_anchor_wall_s": exact_times,
+        "exact_anchor_seconds": {
+            "mean": float(np.mean(exact_times)), "median": float(np.median(exact_times)),
+            "q25": float(np.quantile(exact_times, .25)), "q75": float(np.quantile(exact_times, .75)),
+            "minimum": min(exact_times), "maximum": max(exact_times),
+        },
+        "max_abs_decomposition_residual": max(float(row["decomposition_max_abs"]) for row in data.anchor_records),
+        "max_abs_target_helper_residual": max(float(row["target_helper_max_abs"]) for row in data.anchor_records),
+        "pilot_source_sha256_before_and_after": current_pilot_hash,
+        "input_sha256": {str(path.relative_to(ROOT)): file_sha256(path) for path in args.inputs},
+        "in_process_flag_override": True,
+        "flag_override_detail": "set imported scripts.run_v025_pilot_c3.PILOT_PRIMITIVE_SOURCE_FALLBACK=False before each _build_anchor_rows call; source bytes unchanged",
+        "power": {
+            "analyzed_anchor_clusters": int(len(np.unique(data.anchor))),
+            "world_clusters": int(len(np.unique(data.world))),
+            "user_option_groups": int(len(np.unique(data.group))),
+            "note": "Anchor bootstrap quantifies within-panel sampling only; two LOWO folds have no powered population-of-worlds interpretation.",
+        },
+    }
+    result = {
+        "schema": "c2-declared-target-learnability-diagnostic-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM", "generated_utc_date": "2026-09-10",
+        "generation": generation,
+        "learner_contract": {
+            **{key: value for key, value in LEGACY_TRAINER_LITERALS["C2"].items()},
+            "hidden_layers": list(LEGACY_TRAINER_LITERALS["C2"]["hidden_layers"]),
+            "adam_betas": list(LEGACY_TRAINER_LITERALS["C2"]["adam_betas"]),
+            "epochs": LEGACY_EPOCH_BUDGET,
+            "batch": "one deterministic full-batch update per source epoch",
+            "deterministic_pair_cap": PAIR_LIMIT,
+            "learner_seed_domains": list(PILOT_LEARNER_DOMAINS), "learner_seeds": list(PILOT_LEARNER_SEEDS),
+        },
+        "metric_definitions": {
+            "r2": "pooled held-out raw levels; no test-time re-gauging",
+            "pairwise_ordering": "all non-tied true pairs within held-out (anchor,user); prediction ties earn 0.5",
+            "top1_accuracy": "stable predicted argmax is correct if truth is within 1e-12 of group maximum",
+            "seed_summary": "LOAO first sealed seed; LOWO arithmetic mean of four sealed-seed metrics",
+        },
+        "slot_audit": audit, "target_structure": structure,
+        "models": {"sealed": capacity[architecture_key(ARCHITECTURES[0])], **references},
+        "capacity": {"widths": capacity, "high_capacity": high_capacity},
+        "anchor_bootstraps": bootstraps,
+        "resource_usage": {
+            "main_peak_rss_mib": main_peak, "worker_peak_rss_mib": process_peaks,
+            "maximum_process_peak_rss_mib": max([main_peak, *process_peaks]),
+            "python_process_cap": 3, "blas_threads": 1, "nice": 15,
+        },
+        "limitations": [
+            "Predictive-quality evidence only: no production training, policy, acceptance, corpus, panel, or EE endpoint ran.",
+            "High-capacity result is the best observed tested same-input family, not a proof of the Bayes ceiling.",
+            "Only two worlds exist, so LOWO is descriptive rather than powered world-level inference.",
+        ],
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(f"PEAK_RSS_MIB={main_peak:.3f} MAX_PROCESS_PEAK_RSS_MIB={result['resource_usage']['maximum_process_peak_rss_mib']:.3f}", flush=True)
+    print(json.dumps({"written": str(args.output), "anchors": generation["anchors"], "rows": generation["rows"]}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
