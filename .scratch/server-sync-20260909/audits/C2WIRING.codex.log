@@ -0,0 +1,443 @@
+#!/usr/bin/env python3
+"""Bounded C2 wiring diagnostic against the exact FACTORIAL selector."""
+
+from __future__ import annotations
+
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import sys
+from typing import Iterable, Mapping
+
+
+FACTORIAL_RUNNER = Path(
+    "/home/sat/mcrl-v025-arch-ws/scripts/run_oracle_factorial.py"
+)
+FACTORIAL_ROOT = FACTORIAL_RUNNER.parents[1]
+FACTORIAL_RESULTS = FACTORIAL_ROOT / ".scratch/oracle-factorial/results.json"
+OUTPUT = Path(__file__).with_name("results.json")
+THREAD_VARIABLES = (
+    "OMP_NUM_THREADS",
+    "OPENBLAS_NUM_THREADS",
+    "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS",
+)
+
+
+def load_factorial_module():
+    spec = importlib.util.spec_from_file_location("oracle_factorial", FACTORIAL_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {FACTORIAL_RUNNER}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def pair(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def unpair(value) -> Fraction:
+    return Fraction(int(value[0]), int(value[1]))
+
+
+def require_guardrails() -> None:
+    drift = {name: os.environ.get(name) for name in THREAD_VARIABLES if os.environ.get(name) != "1"}
+    if drift:
+        raise RuntimeError(f"BLAS/thread environment must be exactly one: {drift}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("diagnostic must run at nice level 15 or greater")
+
+
+def synthetic_fixture(module) -> dict:
+    """A source-shaped catalogue where a live C2 term changes the winner."""
+
+    def profile(index: int, candidate_id: str, numerator: int) -> dict:
+        return {
+            "index": index,
+            "candidate_id": candidate_id,
+            "size": 0 if index == 0 else 1,
+            "valid": True,
+            "served_count": 1,
+            "rate_target_attained_count": 1,
+            "capacity": pair(Fraction(numerator)),
+            "demand_capped": pair(Fraction(numerator)),
+            "energy": pair(Fraction(1)),
+            "additive_capacity": pair(Fraction(numerator)),
+            "additive_demand_capped": pair(Fraction(numerator)),
+            "additive_energy": pair(Fraction(1)),
+        }
+
+    source_anchor = {
+        "anchor_id": "SYNTHETIC_C2_WIRING",
+        "world_index": 0,
+        "step_index": 0,
+        "world_sha256": "synthetic",
+        "base_assignments": [[1, [100, 1]]],
+        "base_guard_served_count": 1,
+        "profiles": [
+            profile(0, "base", 10),
+            profile(1, "assoc", 11),
+            profile(2, "control", 12),
+        ],
+        "candidate_definitions": [
+            {"candidate_id": "base", "assignments": [[1, [100, 1]]], "mode_offsets_by_user": []},
+            {"candidate_id": "assoc", "assignments": [[1, [101, 1]]], "mode_offsets_by_user": []},
+            {"candidate_id": "control", "assignments": [[1, [100, 1]]], "mode_offsets_by_user": [[1, 1]]},
+        ],
+    }
+    shard = module.compact_anchor(source_anchor, 1)
+    eta = Fraction(1)
+    drop = module.choose_for_anchor(shard, "demand_capped", "DROP_C2", eta)
+    full = module.choose_for_anchor(shard, "demand_capped", "FULL", eta)
+    drop_index = int(drop["row"]["index"])
+    full_index = int(full["row"]["index"])
+    passed = drop_index != full_index
+    if not passed:
+        raise AssertionError(
+            "FAIL: FULL and DROP_C2 agreed on the synthetic C2-only witness"
+        )
+    return {
+        "kind": "synthetic_three_row_source_shaped_exact_fraction",
+        "construction": (
+            "base row B=10,E=1; association row B=11,E=1; "
+            "mode-offset row B=12,E=1; all residuals zero; eta=1"
+        ),
+        "uses_factorial_compact_anchor": True,
+        "uses_factorial_choose_for_anchor": True,
+        "c1_present": True,
+        "eta": [eta.numerator, eta.denominator],
+        "drop_c2_selected_index": drop_index,
+        "full_selected_index": full_index,
+        "verdict": "PASS",
+    }
+
+
+def tie_key(row: Mapping[str, object]) -> tuple[int, int]:
+    index = int(row["index"])
+    return (0 if index == 0 else 1, index)
+
+
+def select_scaled(rows: list[dict], multiplier: Fraction) -> dict:
+    return min(
+        rows,
+        key=lambda row: (
+            -(row["without_c2_score"] + multiplier * row["c2_score"]),
+            tie_key(row),
+        ),
+    )
+
+
+def empirical_quantile(values: list[Fraction], numerator: int, denominator: int) -> Fraction:
+    """Nearest-rank empirical quantile, with q=0 returning the minimum."""
+
+    ordered = sorted(values)
+    if numerator == 0:
+        return ordered[0]
+    rank = (numerator * len(ordered) + denominator - 1) // denominator
+    return ordered[rank - 1]
+
+
+def distribution(values: list[Fraction]) -> dict:
+    if not values:
+        raise RuntimeError("cannot summarize an empty distribution")
+    exact_zero = sum(value == 0 for value in values)
+    minimum = min(values)
+    maximum = max(values)
+    mean = sum(values, Fraction()) / len(values)
+    floats = [float(value) / 1e6 for value in values]
+    return {
+        "count": len(values),
+        "exact_zero_count": exact_zero,
+        "exact_zero_fraction": pair(Fraction(exact_zero, len(values))),
+        "exact_zero_percentage": 100.0 * exact_zero / len(values),
+        "minimum": pair(minimum),
+        "p25_nearest_rank": pair(empirical_quantile(values, 1, 4)),
+        "median_nearest_rank": pair(empirical_quantile(values, 1, 2)),
+        "p75_nearest_rank": pair(empirical_quantile(values, 3, 4)),
+        "maximum": pair(maximum),
+        "mean": pair(mean),
+        "spread": pair(maximum - minimum),
+        "minimum_mbit": float(minimum) / 1e6,
+        "p25_mbit": float(empirical_quantile(values, 1, 4)) / 1e6,
+        "median_mbit": float(empirical_quantile(values, 1, 2)) / 1e6,
+        "p75_mbit": float(empirical_quantile(values, 3, 4)) / 1e6,
+        "maximum_mbit": float(maximum) / 1e6,
+        "mean_mbit": float(mean) / 1e6,
+        "population_stddev_mbit": statistics.pstdev(floats),
+        "spread_mbit": float(maximum - minimum) / 1e6,
+    }
+
+
+def first_flip(rows: list[dict]) -> dict:
+    current = select_scaled(rows, Fraction(1))
+    current_a = current["without_c2_score"]
+    current_b = current["c2_score"]
+    thresholds = []
+    for row in rows:
+        slope_gain = row["c2_score"] - current_b
+        if slope_gain <= 0:
+            continue
+        threshold = (current_a - row["without_c2_score"]) / slope_gain
+        if threshold >= 1:
+            thresholds.append(threshold)
+    if not thresholds:
+        return {"exists_for_k_ge_1": False}
+    boundary = min(thresholds)
+    at_boundary = select_scaled(rows, boundary)
+    scores_at_boundary = [
+        row["without_c2_score"] + boundary * row["c2_score"] for row in rows
+    ]
+    maximum = max(scores_at_boundary)
+    tied = [row for row, score in zip(rows, scores_at_boundary, strict=True) if score == maximum]
+    right_limit = min(tied, key=lambda row: (-row["c2_score"], tie_key(row)))
+    inclusive = int(at_boundary["index"]) != int(current["index"])
+    if int(right_limit["index"]) == int(current["index"]):
+        raise RuntimeError("computed boundary does not change the right-limit argmax")
+    return {
+        "exists_for_k_ge_1": True,
+        "boundary": pair(boundary),
+        "boundary_decimal": float(boundary),
+        "boundary_inclusive": inclusive,
+        "condition": "k >= boundary" if inclusive else "k > boundary",
+        "current_index": int(current["index"]),
+        "at_boundary_index": int(at_boundary["index"]),
+        "right_limit_index": int(right_limit["index"]),
+        "current_c2_term": pair(current_b),
+        "right_limit_c2_term": pair(right_limit["c2_score"]),
+    }
+
+
+def analyze_real_catalogue(module) -> dict:
+    source = json.loads(FACTORIAL_RESULTS.read_text(encoding="ascii"))
+    demand = source["numerators"]["demand_capped"]["selectors"]
+    eta_full = unpair(demand["FULL"]["optimization_ratio"])
+    eta_drop = unpair(demand["DROP_C2"]["optimization_ratio"])
+    if eta_full != eta_drop:
+        raise RuntimeError("FULL and DROP_C2 do not have a common exact final price")
+
+    manifests = source["anchor_shards"]
+    per_anchor = []
+    per_row_c2 = []
+    aggregate = {"C1": [], "C2": [], "FULL": []}
+    flips = 0
+    for manifest in manifests:
+        shard_path = FACTORIAL_ROOT / manifest["path"]
+        if sha256(shard_path) != manifest["sha256"]:
+            raise RuntimeError(f"anchor shard custody mismatch: {shard_path}")
+        shard = json.loads(shard_path.read_text(encoding="ascii"))
+        rows = []
+        for row in shard["rows"]:
+            terms = {}
+            for route in ("C1", "C2", "C3"):
+                delta_n = unpair(row["deltas"][route]["demand_capped"])
+                delta_e = unpair(row["deltas"][route]["energy"])
+                terms[route] = delta_n - eta_full * delta_e
+            base_score = (
+                unpair(shard["base"]["demand_capped"])
+                - eta_full * unpair(shard["base"]["energy"])
+            )
+            without = base_score + terms["C1"] + terms["C3"]
+            full = without + terms["C2"]
+            enriched = {
+                **row,
+                "base_score": base_score,
+                "c1_score": terms["C1"],
+                "c2_score": terms["C2"],
+                "c3_score": terms["C3"],
+                "without_c2_score": without,
+                "full_score": full,
+            }
+            rows.append(enriched)
+            aggregate["C1"].append(terms["C1"])
+            aggregate["C2"].append(terms["C2"])
+            aggregate["FULL"].append(full)
+            per_row_c2.append({
+                "anchor_id": shard["anchor_id"],
+                "candidate_index": int(row["index"]),
+                "route_kind": row["route_kind"],
+                "c2_score_term": pair(terms["C2"]),
+                "c2_score_term_mbit": float(terms["C2"]) / 1e6,
+            })
+
+        # Exercise the actual two declared arm paths at their common exact eta.
+        without_actual = module.choose_for_anchor(shard, "demand_capped", "DROP_C2", eta_full)
+        with_actual = module.choose_for_anchor(shard, "demand_capped", "FULL", eta_full)
+        without_index = int(without_actual["row"]["index"])
+        with_index = int(with_actual["row"]["index"])
+        if without_index != int(select_scaled(rows, Fraction(0))["index"]):
+            raise RuntimeError("manual k=0 score disagrees with DROP_C2 arm")
+        if with_index != int(select_scaled(rows, Fraction(1))["index"]):
+            raise RuntimeError("manual k=1 score disagrees with FULL arm")
+        differs = without_index != with_index
+        flips += int(differs)
+
+        ranked_without = sorted(rows, key=lambda row: (-row["without_c2_score"], tie_key(row)))
+        top = ranked_without[0]["without_c2_score"]
+        second = ranked_without[1]["without_c2_score"]
+        next_distinct = next(
+            (row["without_c2_score"] for row in ranked_without if row["without_c2_score"] < top),
+            None,
+        )
+        tie_count = sum(row["without_c2_score"] == top for row in ranked_without)
+        c1_values = [row["c1_score"] for row in rows]
+        c2_values = [row["c2_score"] for row in rows]
+        full_values = [row["full_score"] for row in rows]
+        d1 = distribution(c1_values)
+        d2 = distribution(c2_values)
+        dt = distribution(full_values)
+        c2_spread = unpair(d2["spread"])
+        c1_spread = unpair(d1["spread"])
+        total_spread = unpair(dt["spread"])
+        immediate_gap = top - second
+        distinct_gap = None if next_distinct is None else top - next_distinct
+        per_anchor.append({
+            "anchor_id": shard["anchor_id"],
+            "eligible_rows": len(rows),
+            "route_kind_counts": dict(sorted(Counter(row["route_kind"] for row in rows).items())),
+            "without_c2_selected_index": without_index,
+            "with_c2_selected_index": with_index,
+            "choice_differs": differs,
+            "selected_route_kind": with_actual["row"]["route_kind"],
+            "C1_distribution": d1,
+            "C2_distribution": d2,
+            "FULL_score_distribution": dt,
+            "spread_comparison": {
+                "c2_over_c1": float(c2_spread / c1_spread) if c1_spread else None,
+                "c2_over_full_total": float(c2_spread / total_spread) if total_spread else None,
+            },
+            "top_without_c2": {
+                "top_tie_count": tie_count,
+                "immediate_runner_up_gap": pair(immediate_gap),
+                "immediate_runner_up_gap_mbit": float(immediate_gap) / 1e6,
+                "next_distinct_gap": None if distinct_gap is None else pair(distinct_gap),
+                "next_distinct_gap_mbit": None if distinct_gap is None else float(distinct_gap) / 1e6,
+                "c2_spread_over_immediate_gap": (
+                    None if immediate_gap == 0 else float(c2_spread / immediate_gap)
+                ),
+                "c2_spread_over_next_distinct_gap": (
+                    None if distinct_gap in (None, 0) else float(c2_spread / distinct_gap)
+                ),
+            },
+            "first_flip": first_flip(rows),
+        })
+
+    candidates = [
+        (unpair(anchor["first_flip"]["boundary"]), anchor)
+        for anchor in per_anchor
+        if anchor["first_flip"]["exists_for_k_ge_1"]
+    ]
+    if not candidates:
+        global_flip = {"exists_for_k_ge_1": False}
+    else:
+        boundary, anchor = min(candidates, key=lambda item: item[0])
+        global_flip = {
+            "exists_for_k_ge_1": True,
+            "anchor_id": anchor["anchor_id"],
+            **anchor["first_flip"],
+        }
+
+    aggregate_distributions = {
+        "C1": distribution(aggregate["C1"]),
+        "C2": distribution(aggregate["C2"]),
+        "FULL_score": distribution(aggregate["FULL"]),
+    }
+    return {
+        "numerator": "demand_capped",
+        "common_exact_eta_bit_per_j": pair(eta_full),
+        "common_eta_mbit_per_j": float(eta_full) / 1e6,
+        "anchor_count": len(per_anchor),
+        "catalogue_row_count": len(per_row_c2),
+        "argmax_choice_difference_count": flips,
+        "aggregate_distributions": aggregate_distributions,
+        "aggregate_spread_comparison": {
+            "c2_over_c1": float(
+                unpair(aggregate_distributions["C2"]["spread"])
+                / unpair(aggregate_distributions["C1"]["spread"])
+            ),
+            "c2_over_full_total": float(
+                unpair(aggregate_distributions["C2"]["spread"])
+                / unpair(aggregate_distributions["FULL_score"]["spread"])
+            ),
+        },
+        "first_flip": global_flip,
+        "per_anchor": per_anchor,
+        "per_catalogue_row_c2": per_row_c2,
+    }
+
+
+def main() -> int:
+    require_guardrails()
+    module = load_factorial_module()
+    fixture = synthetic_fixture(module)
+    real = analyze_real_catalogue(module)
+    result = {
+        "schema": "mcrl-v025-c2-wiring-diagnostic-v1",
+        "claim": "DIAGNOSTIC_NOT_CLAIM",
+        "classification": "C2_REACHES_SCORE",
+        "fixture": fixture,
+        "real_catalogue": real,
+        "evidence": {
+            "verified_by_running_code": [
+                "synthetic fixture through FACTORIAL choose_for_anchor",
+                "eight cached anchors replayed through FACTORIAL FULL and DROP_C2 arm paths",
+                "exact per-row terms and first-flip boundaries computed with Fraction",
+            ],
+            "derived_on_paper": [
+                "spread ratios and displayed decimal conversions from exact replay values"
+            ],
+            "inferred": [
+                "causal interpretation of real-catalogue inertness from support, spread, gaps, and first-flip scale"
+            ],
+        },
+        "learner_used": False,
+        "sealed_settings_changed": False,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "nice_level": os.getpriority(os.PRIO_PROCESS, 0),
+        "thread_environment": {name: os.environ.get(name) for name in THREAD_VARIABLES},
+        "provenance": {
+            "factorial_runner": str(FACTORIAL_RUNNER),
+            "factorial_runner_sha256": sha256(FACTORIAL_RUNNER),
+            "factorial_results": str(FACTORIAL_RESULTS),
+            "factorial_results_sha256": sha256(FACTORIAL_RESULTS),
+            "diagnostic_runner": str(Path(__file__).resolve()),
+            "diagnostic_runner_sha256": sha256(Path(__file__)),
+        },
+    }
+    OUTPUT.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(
+        "C2_WIRING_FIXTURE "
+        f"{fixture['verdict']}: DROP_C2={fixture['drop_c2_selected_index']} "
+        f"FULL={fixture['full_selected_index']}"
+    )
+    flip = real["first_flip"]
+    print(
+        f"REAL_CATALOGUE flips={real['argmax_choice_difference_count']}/"
+        f"{real['anchor_count']} first_boundary={flip.get('boundary_decimal')} "
+        f"condition={flip.get('condition')} anchor={flip.get('anchor_id')}"
+    )
+    print(f"WROTE {OUTPUT}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
