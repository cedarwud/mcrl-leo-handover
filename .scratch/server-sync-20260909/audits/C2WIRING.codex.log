def pseudo_values(shard: Mapping[str, object], row: Mapping[str, object], numerator: str, arm: str) -> tuple[Fraction, Fraction]:
    n = unpair(shard["base"][numerator])  # type: ignore[index]
    e = unpair(shard["base"]["energy"])  # type: ignore[index]
    for route in INCLUDES[arm]:
        n += unpair(row["deltas"][route][numerator])  # type: ignore[index]
        e += unpair(row["deltas"][route]["energy"])  # type: ignore[index]
    return n, e


def choose_for_anchor(shard: Mapping[str, object], numerator: str, arm: str, eta: Fraction) -> dict:
    best = None
    best_score = None
    for row in shard["rows"]:  # type: ignore[assignment]
        n, e = pseudo_values(shard, row, numerator, arm)
        score = n - eta * e
        # Candidate zero wins an exact tie; otherwise source index order is the
        # original lexicographic candidate-id order.
        tie_key = (0 if int(row["index"]) == 0 else 1, int(row["index"]))
        if best is None or score > best_score or (
            score == best_score and tie_key < best["tie_key"]
        ):
            best = {"row": row, "pseudo_n": n, "pseudo_e": e, "tie_key": tie_key}
            best_score = score
    if best is None:
        raise RuntimeError("anchor shard has no eligible candidate")
    return best


def optimize(manifests: Sequence[Mapping[str, object]], numerator: str, arm: str) -> dict:
    base_n = Fraction()
    base_e = Fraction()
    for manifest in manifests:
        shard = load_shard(manifest)
        base_n += unpair(shard["base"][numerator])
        base_e += unpair(shard["base"]["energy"])
        del shard
    eta = base_n / base_e
    trace = []
    previous = None
    selected = []
    for iteration in range(1, MAX_DINKELBACH + 1):
        selected = []
        for manifest in manifests:
            shard = load_shard(manifest)
            chosen = choose_for_anchor(shard, numerator, arm, eta)
            row = chosen["row"]
            selected.append({
                "anchor_id": shard["anchor_id"],
                "index": int(row["index"]),
                "candidate_id_sha256": row["candidate_id_sha256"],
                "candidate_size": int(row["size"]),
                "route_kind": row["route_kind"],
                "pseudo_n": chosen["pseudo_n"],
                "pseudo_e": chosen["pseudo_e"],
                "actual_n": unpair(row["actual"][numerator]),
                "actual_e": unpair(row["actual"]["energy"]),
                "served_count": int(row["served_count"]),
                "rate_target_attained_count": int(row["rate_target_attained_count"]),
            })
            del shard
        pseudo_n = sum((row["pseudo_n"] for row in selected), Fraction())
        pseudo_e = sum((row["pseudo_e"] for row in selected), Fraction())
        if pseudo_e <= 0:
            raise RuntimeError(f"{numerator}:{arm} Dinkelbach pseudo-energy is not positive")
        new_eta = pseudo_n / pseudo_e
        indices = tuple(int(row["index"]) for row in selected)
        residual = pseudo_n - eta * pseudo_e
        trace.append({
            "iteration": iteration,
            "eta": pair(eta),
            "selected_indices": list(indices),
            "surplus_residual": pair(residual),
        })
        if new_eta == eta:
            break
        if indices == previous:
            raise RuntimeError(f"{numerator}:{arm} selection fixed without exact price equality")
        previous = indices
        eta = new_eta
    else:
        raise RuntimeError(f"{numerator}:{arm} Dinkelbach iteration cap reached")

    actual_n = sum((row["actual_n"] for row in selected), Fraction())
    actual_e = sum((row["actual_e"] for row in selected), Fraction())
    per_anchor = [{
        "anchor_id": row["anchor_id"],
        "candidate_index": row["index"],
        "candidate_id_sha256": row["candidate_id_sha256"],
        "candidate_size": row["candidate_size"],
        "route_kind": row["route_kind"],
        "numerator": pair(row["actual_n"]),
        "energy": pair(row["actual_e"]),
        "ee_bit_per_j": float(row["actual_n"] / row["actual_e"]),
        "served_count": row["served_count"],
        "rate_target_attained_count": row["rate_target_attained_count"],
    } for row in selected]
    return {
        "arm": arm,
        "included_exact_terms": list(INCLUDES[arm]),
        "dinkelbach_iterations": len(trace),
        "optimization_ratio": pair(eta),
        "selected_indices": [row["index"] for row in selected],
        "selected_candidate_id_sha256": [row["candidate_id_sha256"] for row in selected],
        "pseudo_numerator": pair(pseudo_n),
        "pseudo_energy": pair(pseudo_e),
        "actual_numerator": pair(actual_n),
        "actual_energy": pair(actual_e),
        "pooled_ee_bit_per_j": float(actual_n / actual_e),
        "served_count": sum(int(row["served_count"]) for row in selected),
        "rate_target_attained_count": sum(int(row["rate_target_attained_count"]) for row in selected),
        "candidate_size_distribution": dict(sorted(Counter(
            str(row["candidate_size"]) for row in selected
        ).items())),
        "per_anchor": per_anchor,
        "trace": trace,
    }


def contrast(left: Mapping[str, object], right: Mapping[str, object]) -> dict:
    left_n = unpair(left["actual_numerator"])  # type: ignore[arg-type]
    left_e = unpair(left["actual_energy"])  # type: ignore[arg-type]
    right_n = unpair(right["actual_numerator"])  # type: ignore[arg-type]
    right_e = unpair(right["actual_energy"])  # type: ignore[arg-type]
    left_ee, right_ee = left_n / left_e, right_n / right_e
    absolute = right_ee - left_ee
    relative = right_ee / left_ee - 1
    return {
        "left": str(left["arm"]),
        "right": str(right["arm"]),
        "ee_difference_bit_per_j": pair(absolute),
        "gain_relative": pair(relative),
        "gain_percentage": 100.0 * float(relative),
        "positive": relative > 0,
        "zero": relative == 0,
        "numerator_delta": pair(right_n - left_n),
        "energy_delta": pair(right_e - left_e),
        "served_delta": int(right["served_count"]) - int(left["served_count"]),
        "rate_target_attained_delta": (
            int(right["rate_target_attained_count"])
            - int(left["rate_target_attained_count"])
        ),
    }


def build_contrasts(selectors: Mapping[str, Mapping[str, object]]) -> tuple[dict, dict]:
    requested = {}
    for arm in ("C1_ONLY", "C2_ONLY", "C3_ONLY"):
        requested[f"{arm}-BASELINE"] = contrast(selectors["BASELINE"], selectors[arm])
    for arm in ("DROP_C1", "DROP_C2", "DROP_C3"):
        requested[f"FULL-{arm}"] = contrast(selectors[arm], selectors["FULL"])
        requested[f"{arm}-BASELINE"] = contrast(selectors["BASELINE"], selectors[arm])

    interactions = {}
    for route in ("C1", "C2", "C3"):
        conditional = requested[f"FULL-DROP_{route}"]
        alone = requested[f"{route}_ONLY-BASELINE"]
        conditional_abs = unpair(conditional["ee_difference_bit_per_j"])
        alone_abs = unpair(alone["ee_difference_bit_per_j"])
        difference_abs = conditional_abs - alone_abs
        difference_pp = float(conditional["gain_percentage"]) - float(alone["gain_percentage"])
        interactions[route] = {
            "conditional_contrast": f"FULL-DROP_{route}",
            "alone_contrast": f"{route}_ONLY-BASELINE",
            "conditional_gain_percentage": conditional["gain_percentage"],
            "alone_gain_percentage": alone["gain_percentage"],
            "difference_percentage_points": difference_pp,
            "conditional_minus_alone_ee_bit_per_j": pair(difference_abs),
            "conditional_marginal_larger": difference_abs > 0,
            "equal": difference_abs == 0,
        }
    return requested, interactions


def verify_fullspan_reproduction(blocks: Mapping[str, object]) -> dict:
    fullspan = json.loads(FULLSPAN_RESULTS.read_text(encoding="ascii"))
    checks = []
    mapping = {
        "BASELINE": "BASELINE",
        "DROP_C3": "ADDITIVE_ONLY",
        "FULL": "WITH_RESIDUAL",
    }
    for numerator in NUMERATORS:
        for arm, source_selector in mapping.items():
            ours = blocks[numerator]["selectors"][arm]  # type: ignore[index]
            source = fullspan["numerators"][numerator]["selectors"][source_selector]
            match = (
                ours["selected_indices"] == source["selected_indices"]
                and unpair(ours["actual_numerator"]) == unpair(source["numerator"])
                and unpair(ours["actual_energy"]) == unpair(source["energy"])
            )
            if not match:
                raise RuntimeError(f"FULLSPAN reproduction failed for {numerator}:{arm}")
            checks.append({
                "numerator": numerator,
                "arm": arm,
                "source_selector": source_selector,
                "selected_indices_and_exact_totals_match": True,
            })
    return {"all_match": True, "checks": checks}


def status_word(value: Mapping[str, object]) -> str:
    if bool(value["positive"]):
        return "POSITIVE"
    if bool(value["zero"]):
        return "ZERO"
    return "NOT POSITIVE"


def pct(value: Mapping[str, object]) -> str:
    return f"{float(value['gain_percentage']):+.2f}%"


def render_report(results: Mapping[str, object], output_sha: str) -> str:
    demand = results["numerators"]["demand_capped"]  # type: ignore[index]
    singles = demand["contrasts"]
    all_positive = all(bool(singles[f"{route}_ONLY-BASELINE"]["positive"]) for route in ("C1", "C2", "C3"))
    first = (
        f"**Demand-capped single-route marginals over `BASELINE` are C1 "
        f"{pct(singles['C1_ONLY-BASELINE'])}, C2 {pct(singles['C2_ONLY-BASELINE'])}, and "
        f"C3 {pct(singles['C3_ONLY-BASELINE'])}; "
        f"{'all three are positive' if all_positive else 'not all three are positive'}.**"
    )
    lines = [
        first, "", "# Oracle factorial — 2026-09-10", "", f"`{CLAIM}`", "",
        "Every number is a **ceiling: exact terms, not learned predictions**.", "",
        "`BASELINE` is the committed nearest-eligible incumbent with no catalogue selection. It is **not** `ALL_NEUTRAL_CONTROL`.", "",
        "## Demand-capped reported result", "",
        "Demand cap: `min(per-user integrated delivery, 50 Mbit/s × 30.08 s)`. Pooled EE is the ratio of pooled capped bits to pooled realised energy.", "",
        "| arm | exact score terms | pooled EE (Mbit/J) | capped bits (Gbit) | energy (J) | served | rate-target attained | sizes |",
        "| --- | --- | ---: | ---: | ---: | ---: | ---: | --- |",
    ]
    for arm in ARMS:
        row = demand["selectors"][arm]
        formula = "+".join(row["included_exact_terms"]) or "incumbent/no selection"
        lines.append(
            f"| `{arm}` | {formula} | {row['pooled_ee_bit_per_j']/1e6:.6f} | "
            f"{float(unpair(row['actual_numerator']))/1e9:.6f} | "
            f"{float(unpair(row['actual_energy'])):.6f} | {row['served_count']} | "
            f"{row['rate_target_attained_count']} | `{row['candidate_size_distribution']}` |"
        )

    lines += ["", "## Required contrasts", "", "| contrast | EE difference (Mbit/J) | relative gain | sign | capped-bits delta (Gbit) | energy delta (J) |", "| --- | ---: | ---: | --- | ---: | ---: |"]
    contrast_order = (
        "C1_ONLY-BASELINE", "C2_ONLY-BASELINE", "C3_ONLY-BASELINE",
        "FULL-DROP_C1", "FULL-DROP_C2", "FULL-DROP_C3",
        "DROP_C1-BASELINE", "DROP_C2-BASELINE", "DROP_C3-BASELINE",
    )
    for key in contrast_order:
        row = demand["contrasts"][key]
        label = f"{row['right']} - {row['left']}"
        lines.append(
            f"| `{label}` | {float(unpair(row['ee_difference_bit_per_j']))/1e6:+.6f} | "
            f"{pct(row)} | **{status_word(row)}** | "
            f"{float(unpair(row['numerator_delta']))/1e9:+.6f} | "
            f"{float(unpair(row['energy_delta'])):+.6f} |"
        )

    lines += [
        "",
        "Positive contrasts are `C1_ONLY − BASELINE`, `C2_ONLY − BASELINE`, "
        "`FULL − DROP_C1`, `FULL − DROP_C3`, `DROP_C2 − BASELINE`, and "
        "`DROP_C3 − BASELINE`. Not positive are `C3_ONLY − BASELINE` and "
        "`DROP_C1 − BASELINE` (both negative), plus `FULL − DROP_C2` "
        "(exactly zero, not merely rounded to zero). No negative or zero "
        "marginal is treated as support for the claim.",
        "", "## Route interaction", "",
        "The percentage-point comparison uses each marginal's own reference EE. The final column is the classical difference of absolute EE marginals, `(FULL − DROP_Ci) − (Ci_ONLY − BASELINE)`.",
        "", "| route | FULL vs pair | route alone vs BASELINE | conditional − alone (pp) | absolute interaction (Mbit/J) | interpretation |", "| --- | ---: | ---: | ---: | ---: | --- |",
    ]
    for route in ("C1", "C2", "C3"):
        row = demand["interactions"][route]
        if row["equal"]:
            interpretation = "equal"
        elif row["conditional_marginal_larger"]:
            interpretation = "conditional marginal is larger"
        else:
            interpretation = "conditional marginal is smaller"
        lines.append(
            f"| {route} | {row['conditional_gain_percentage']:+.2f}% | "
            f"{row['alone_gain_percentage']:+.2f}% | {row['difference_percentage_points']:+.2f} pp | "
            f"{float(unpair(row['conditional_minus_alone_ee_bit_per_j']))/1e6:+.6f} | {interpretation} |"
        )

    lines += ["", "## Per-anchor demand-capped EE", "", "| anchor | " + " | ".join(ARMS) + " |", "| --- | " + " | ".join("---:" for _ in ARMS) + " |"]
    anchor_ids = results["anchor_ids"]
    for index, anchor_id in enumerate(anchor_ids):
        cells = [f"{demand['selectors'][arm]['per_anchor'][index]['ee_bit_per_j']/1e6:.6f}" for arm in ARMS]
        lines.append(f"| {anchor_id} | " + " | ".join(cells) + " |")

    lines += ["", "## Per-anchor demand-capped endpoints", "", "| arm | anchor | capped bits (Gbit) | energy (J) | served | target | selected size | candidate index |", "| --- | --- | ---: | ---: | ---: | ---: | ---: | ---: |"]
    for arm in ARMS:
        for row in demand["selectors"][arm]["per_anchor"]:
            lines.append(
                f"| `{arm}` | {row['anchor_id']} | {float(unpair(row['numerator']))/1e9:.6f} | "
                f"{float(unpair(row['energy'])):.6f} | {row['served_count']} | "
                f"{row['rate_target_attained_count']} | {row['candidate_size']} | {row['candidate_index']} |"
            )

    capacity = results["numerators"]["capacity"]  # type: ignore[index]
    lines += ["", "## Capacity numerator (secondary)", "", "These capacity-numerator figures are secondary; the demand-capped figures above are the reported result.", "", "| arm | pooled EE (Mbit/J) | capacity (Gbit) | energy (J) | served | target |", "| --- | ---: | ---: | ---: | ---: | ---: |"]
    for arm in ARMS:
        row = capacity["selectors"][arm]
        lines.append(
            f"| `{arm}` | {row['pooled_ee_bit_per_j']/1e6:.6f} | "
            f"{float(unpair(row['actual_numerator']))/1e9:.6f} | "
            f"{float(unpair(row['actual_energy'])):.6f} | {row['served_count']} | "
            f"{row['rate_target_attained_count']} |"
        )

    memory = results["memory"]
    lines += [
        "", "## Exact construction and memory discipline", "",
        "For candidate `x`, C1 is the sum of exact atomic association-change numerator/energy deltas, C2 is the sum of exact atomic adjacent-mode/control deltas, and C3 is the residual `joint − incumbent − C1 − C2`. At common Dinkelbach price `η`, an arm scores `incumbent + Σ included routes`, equivalently `B0 − ηE0 + Σ(ΔBi − ηΔEi)`. The selected candidate is then reported with its actual realised 48-boundary capped bits and energy, not with pseudo totals.", "",
        "The source candidate order was asserted to be incumbent first and then lexicographic. Every eligible row was asserted to be either association-only or control-only; mixed association/control rows were physically invalid and excluded by the inherited eligibility guard, so no cached mixed term was approximated.", "",
        f"The first anchor peak RSS was **{memory['first_anchor_peak_rss_gib']:.3f} GiB**, below the 6 GiB stop threshold. All eight anchors were streamed serially; each compact anchor shard was written before the decoded source anchor was freed. The run used exactly one Python process and all BLAS thread counts were one.", "",
        "## Evidence classification", "", "### Verified by running code", "",
        "The pinned source receipt, source selected-record file, residual-toggle runner, FULLSPAN result, and FULLSPAN runner matched their SHA-256 digests. The code streamed all eight cached anchors, asserted the inherited eligibility and exact singleton-residual identities, reran every factorial selector with exact `Fraction` prices, and exactly reproduced `BASELINE`, `DROP_C3`/`ADDITIVE_ONLY`, and `FULL`/`WITH_RESIDUAL` selections and totals for both numerators.", "",
        "### Derived on paper", "",
        "Pooled ratios, requested contrasts, and interaction differences are exact rational arithmetic over the cached binary64 physical outputs. Displayed decimals are formatting only.", "",
        "### Inferred", "",
        "These oracle selectors expose ceiling opportunity within this fixed catalogue. They do not establish learnability, deployable policy efficacy, or achievable learned values.", "",
        "No learner was run. Loss values are never evidence about EE. Nothing was tuned to produce an ordering, and no sealed constant, threshold, sign, seed, horizon, price, guard, acceptance rule, control law, search grid, manifest, or optimizer setting was changed.", "",
        "## Custody and reproduction", "",
        f"Machine result: `.scratch/oracle-factorial/results.json` (SHA-256 `{output_sha}`). Compact per-anchor cache shards and their hashes are listed in that result. Runner SHA-256: `{results['provenance']['runner_sha256']}`.", "",
        "From `/home/sat/mcrl-v025-arch-ws`:", "", "```bash",
        "env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \\",
        "  NUMEXPR_NUM_THREADS=1 PYTHONPATH=src nice -n 15 \\",
        "  /home/sat/mcrl-leo-handover/.venv/bin/python \\",
        "  scripts/run_oracle_factorial.py", "```", "",
    ]
    return "\n".join(lines)


def main() -> int:
    require_execution_guardrails()
    started = time.perf_counter()
    actual_hashes = {
        "source_receipt": sha256(SOURCE_RECEIPT),
        "source_selected_records": sha256(SOURCE_SELECTED),
        "source_runner": sha256(SOURCE_RUNNER),
        "fullspan_results": sha256(FULLSPAN_RESULTS),
        "fullspan_runner": sha256(FULLSPAN_RUNNER),
    }
    if actual_hashes != EXPECTED_HASHES:
        raise RuntimeError(f"source custody mismatch: {actual_hashes}")

    manifests, memory = prepare_anchor_shards()
    numerator_blocks = {}
    for numerator in NUMERATORS:
        selectors = {}
        for arm in ARMS:
            selectors[arm] = optimize(manifests, numerator, arm)
            print(
                f"optimized {numerator}:{arm}, iterations "
                f"{selectors[arm]['dinkelbach_iterations']}, peak RSS {peak_rss_gib():.3f} GiB",
                flush=True,
            )
        contrasts, interactions = build_contrasts(selectors)
        numerator_blocks[numerator] = {
            "selectors": selectors,
            "contrasts": contrasts,
            "interactions": interactions,
        }
    reproduction = verify_fullspan_reproduction(numerator_blocks)

    results = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM,
        "ceiling_statement": "Every number is a ceiling: exact terms, not learned predictions.",
        "baseline_definition": "committed nearest-eligible incumbent; no catalogue selection",
        "baseline_is_all_neutral_control": False,
        "route_definitions": {
            "C1": "exact atomic association-change numerator and energy deltas",
            "C2": "exact atomic adjacent-mode/control numerator and energy deltas",
            "C3": "exact joint residual after incumbent, C1, and C2",
        },
        "arm_formulas": {arm: list(INCLUDES[arm]) for arm in ARMS},
        "anchor_ids": [str(row["anchor_id"]) for row in manifests],
        "numerators": numerator_blocks,
        "fullspan_reproduction": reproduction,
        "anchor_shards": manifests,
        "memory": {**memory, "final_process_peak_rss_gib": peak_rss_gib()},
        "reuse": {
            "catalogue_rebuilt": False,
            "physical_candidate_profiles_rerun": False,
            "cached_exact_candidate_profiles_reused": True,
            "factorial_dinkelbach_selectors_rerun": True,
        },
        "sealed_settings_changed": False,
        "learner_used": False,
        "loss_values_used_as_ee_evidence": False,
        "python": sys.executable,
        "python_version": platform.python_version(),
        "nice_level": os.getpriority(os.PRIO_PROCESS, 0),
        "thread_environment": {name: os.environ.get(name) for name in (
            "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS",
        )},
        "wall_seconds": time.perf_counter() - started,
        "provenance": {
# C2 is **BOTH an encoder-adapter bug and a sufficiency gap**; an admissible one-scalar C1 repair exists, but it adds zero held-out predictive power.

**ADMISSIBILITY:** a feature is admissible only if it is computable from the pre-decision network state and the focal candidate action alone, without evaluating the candidate configuration's coupled power fixed point or its whole-network outcome, and without any label, oracle, or future information.

`DIAGNOSTIC_NOT_CLAIM`

No learner training or production run was performed. No threshold, sign, seed, horizon, price, service guard, acceptance rule, or `PILOT_PRIMITIVE_SOURCE_FALLBACK` was changed. The sealed clone and its virtual environment were not modified; its Python executable was used read-only with `PYTHONPATH=src` and `nice -n 15`.

## A. The C2 survival defect

### Finding

`state.py` does not compute survival, and the serializer is not overwriting or defaulting the flag. `extract_source_rows` appends `float(forecast.valid)` and `float(forecast.survival)` verbatim (`src/mcrl/stagec_v025/state.py:426-433`). The defect is upstream in the legacy pilot's primitive encoder adapter:

- `_build_anchor_rows_primitive` defines survival as `future_metric["legal"] and identity is not None`, then writes that same value to both `valid` and `survival` (`scripts/run_v025_pilot_c3.py:416-430`). `_primitive_metrics` defines `legal` only from future visibility, D2 eligibility, and cell reachability (`scripts/run_v025_pilot_c3.py:323-352`). It never asks whether the coupled evaluator serves the user.
- The exact projection uses a different predicate. `_batched_stage2_forecasts` evaluates the whole configuration, forms `changed = {u: candidate_mapping[u] != future_transition[u]}`, and requires **every changed user** to be in `profile.score.served_phy` (`.scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py:1612-1638`).
- The non-fallback source builder would pass those exact `row.valid` and `row.survives` values into `ForecastObservation` correctly (`scripts/run_v025_pilot_c3.py:665-672`). Therefore this is specifically an adapter-path semantic misencoding, not a mutation in `state.py`.

For the real witness, both anchors have the same physical step-0 tape, current base mapping, incumbent mapping, and focal candidate `(user=6, action=(65028,44))`. Nevertheless, the future carrier transition makes the target predicate range over 93 changed users at each offset for anchor 0, but only the focal user for anchor 1. Thus the target uses the same predicate on different `changed` inputs across anchors, while the primitive encoder uses an entirely different predicate.

| Anchor | Stored Q2 `survival[1:3]` | Exact projection `survives[1:3]` | Exact C2 |
|---:|---:|---:|---:|
| 0, `nearest-eligible` | `(1,1,1)` | `(0,0,0)` | `60102789335062397912351470235270 / 11110569965387252983357173269901` = `5.4095145003632172...` |
| 1, `stay-if-possible` | `(1,1,1)` | `(1,1,1)` | `2149528301326970807719944431070731 / 111105699653872529833571732699010` = `19.346696956352321...` |

The absorbing rule is applied to the target but not to the encoded row. `c2_persistence_forecast` maintains `alive`; a first invalid/non-surviving projection makes every later offset a loss (`src/mcrl/physics_v025/targets.py:289-310`). Q2 stores three independent supplied booleans and has no cumulative `alive` transform. In this witness the distinction begins at offset 1, so anchor 0 incurs all three losses.

Classification: **BOTH**.

1. **ENCODER_BUG:** the primitive adapter labels geometric legality as both validity and coupled survival, although Q2 advertises distinct `valid` and `survival` fields. This is the immediate reason the stored row misreports all three flags.
2. **SUFFICIENCY_GAP:** the exact target flag is genuinely unavailable under the governing admissibility rule. It depends on a future carrier transition and a candidate whole-configuration coupled served set. The two witness inputs are identical at decision time, so no admissible deterministic feature can distinguish their target values. This also exposes a target-context defect: unrelated changed users can decide a focal action's “survival.”

Across the two cheap anchors, 822 of 1,784 valid nonreference rows have at least one stored-vs-exact **survival** mismatch (792/892 at anchor 0 and 30/892 at anchor 1), totalling 2,406 offset flags. Additionally, 200 rows have validity mismatches (600 offset flags). Counting a row affected by either boolean gives 1,022/1,784 rows. These anchors contain the previously established 62 exact C2 collision groups.

### Minimal real-tape reproduction

```text
nice -n 15 env PYTHONPATH=src \
  /home/sat/mcrl-leo-handover/.venv/bin/python \
  scripts/diagnose_v025_c1c2_sufficiency.py --survival-repro
```

The focused command completes in about 31 seconds and asserts byte-identical Q1/Q2, identical current base mappings, stored survival `[(true,true,true),(true,true,true)]`, and exact survival `[(false,false,false),(true,true,true)]`. It prints the exact fractions above and changed-user counts `[(93,93,93),(1,1,1)]`.

## B. Smallest admissible feature sets

Feature choice was declared before measurement. No second variant was tried.

| Route | Proposed feature | Exact definition and production supplier | Inputs | Admissibility, individually | Witnesses broken; encoded values |
|---|---|---|---|---|---|
| C1 | `predecision_network_max_rf_over_cap` | `p_max(base) / BEAM_RF_CAP_W`, where `p_max(base)` is `EvaluatedProfile.required_power_w_max`. `_base_configuration(tape, step_index, carrier)` supplies the committed configuration; `StepEvaluator.evaluate(base)` supplies the already-present network maximum (`.scratch/.../run_v025_matrix_probe.py:312-328,380-404`; `scripts/run_v025_pilot_c3.py:550-569`). | Decision-time tape, committed/base association, current setting; constant cap `1.65 W`. The focal candidate is not evaluated. | **Admissible.** It summarizes the current coupled state only. A controller may read/cache the already-committed power state before considering candidates. It contains no candidate outcome, label, oracle, or future value. | Breaks constructed C1 only: A `0.8/1.65 = 16/33 = 0.484848...`; B `1.5/1.65 = 10/11 = 0.909090...`. The repaired Q1 rows differ in their 17th scalar. It does not break the real C2 pair. |
| C2 | **No feature exists under the constraint** | Any deterministic function of decision-time state plus `(user 6,(65028,44))` receives identical inputs in both anchors. | Identical current tape/mapping/incumbent and candidate action. | Adding carrier identity, the future transition's changed-user set, or `_batched_stage2_forecasts(...).survives` is **inadmissible**: the first is source-policy context rather than network state, and the latter two use future/candidate coupled information. | Breaks neither; the admissible set remains empty. The tempting exact flag would give `(0,0,0)` vs `(1,1,1)`, but it is explicitly rejected as non-deployable. |

Cardinality one is minimal for C1 because zero added features preserves the published collision. C2 has no admissible separating set because the admissible inputs themselves are equal.

## C. Held-out predictive power

The rerun used `scripts/diagnose_v025_c1c2_sufficiency.py --anchors 30`, seed `20260909`, and the same physical-step split: train `1,2,4,6,7,8,9`; validation `5`; test `0,3`. It retained 26,345 exact-relabelled nonreference rows; the test set has 5,280 rows. Each deployable row used standardized inverse-distance k-NN with `k` selected from `{1,3,7,15,31}` on validation; `k=31` was selected throughout.

| Route | Feature row | Held-out EV | RMSE | Change in EV |
|---|---|---:|---:|---:|
| C1 | current Q1 only | `-0.3355476799` | `3.4683937281` | — |
| C1 | Q1 + one admissible feature | `-0.3355476799` | `3.4683937281` | `0.0000000000` |
| C2 | current Q2 only | `0.2106516781` | `3.3856461561` | — |
| C2 | admissible repair (empty; Q2 unchanged) | `0.2106516781` | `3.3856461561` | `0.0000000000` |
| C1 | `LEAKY_REFERENCE_NOT_DEPLOYABLE` | `1.0000000000` | `2.6554e-13` | not comparable |
| C2 | `LEAKY_REFERENCE_NOT_DEPLOYABLE` | `1.0000000000` | `1.0200e-14` | not comparable |

The admissible C1 repair buys **no measured predictive power**. Its value is exactly `1.0` at all 30 corpus anchors because every current base configuration reaches the RF cap, so standardization removes it. This negative result is not evidence that the feature is wrongly chosen for identifiability; it shows that breaking one contract witness does not supply variation useful on this corpus. C2 is unchanged because no admissible separator exists.

The leaky rows are only algebra checks. C1 OLS receives candidate/default whole-network bits, energy, and Phi; C2 OLS receives per-offset candidate/default outcome terms plus expanded absorbing state. Their `EV=1` merely recovers the target definitions and says nothing about deployable prediction.

## D. Consequences

### Expected pooled-energy-efficiency effect (under 200 words)

C1 cannot presently be expected to raise pooled energy efficiency. Its Q-only held-out EV is worse than the mean predictor, and the smallest admissible collision-breaking feature is constant on this sample and changes nothing. The exact C1 label is structurally sensitive to coupled whole-network effects that the action-local row still does not represent. A training run would not repair missing information and is not authorized by this diagnostic.

C2 also cannot presently be expected to raise pooled energy efficiency. Although Q2's held-out EV is positive (`0.2107`), its stored survival semantics are wrong on 822/1,784 two-anchor rows, and the exact target varies with future carrier-transition context absent from admissible deployment inputs. Correcting offline flags by copying coupled forecast outcomes would be leakage, not a deployable encoder repair. Before any efficacy claim, the focal-survival target must be made a function of admissible decision-time information (or the per-user C2 head design reconsidered), then evaluated on a fresh untouched split. No pooled-EE conclusion follows here.

### Minimum pipeline change and sealed-lineage stop (under 200 words)

For C1 only, `src/mcrl/stagec_v025/state.py` would need a v2 Q1 `FeatureSpec`, an `ActionEvaluation` field, and extraction of the 17th scalar. `scripts/run_v025_pilot_c3.py` would populate it from the cached decision-time `base_profile.required_power_w_max / BEAM_RF_CAP_W` in both source-builder paths. `tests/stagec_v025/test_stagec_pipeline.py` and relevant state/shard tests would need the new ordered width/schema assertions; synthetic rows already derive width from `Q1_FEATURES` but fixtures must be checked. `scripts/diagnose_v025_c1c2_sufficiency.py` contains the diagnostic-only measurement implemented here.

This changes `Q1_SCHEMA_SHA256`. Existing sealed JSONL shard headers, merged manifests, trained checkpoints, and frozen artifact digests would no longer match and must **not** be edited in place; adoption requires a newly versioned, newly generated artifact/manifest/checkpoint lineage. C2 additionally requires a target-contract decision, not an encoder-width change. Per the stop rule, no production schema, sealed artifact, frozen manifest, or training pipeline was modified.
