            "valid": False,
            "whole_network_bits_hex": float.hex(0.0),
            "whole_network_joules_hex": float.hex(0.0),
            "per_user": [],
            "required_power_w_max_hex": None,
            "minimum_decoding_margin_db_hex": float.hex(-100.0),
            "mean_acm_spectral_efficiency_bit_s_hz_hex": float.hex(0.0),
        }
    return {
        "valid": True,
        "whole_network_bits_hex": float.hex(profile.bits),
        "whole_network_joules_hex": float.hex(profile.joules),
        "per_user": [
            {
                "user_id": int(user),
                "bits_hex": float.hex(float(profile.score.bits[user])),
                "served_phy": bool(profile.score.served_phy[user]),
                "decoding_time_s_hex": float.hex(float(profile.score.decoding_time_s[user])),
                "useful_time_s_hex": float.hex(float(profile.score.useful_time_s[user])),
                "rate_target_attained": (
                    None
                    if profile.score.rate_target_attained is None
                    else bool(profile.score.rate_target_attained[user])
                ),
                "rate_target_feasible": (
            if payload is not header:
                row_count += 1
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    file_hash = digest.hexdigest()
    sidecar = path.with_suffix(path.suffix + ".sha256")
    sidecar_tmp = sidecar.with_name(f".{sidecar.name}.{os.getpid()}.tmp")
    sidecar_tmp.write_text(f"{file_hash}  {path.name}\n")
    sidecar_tmp.replace(sidecar)
    return file_hash, row_count, path.stat().st_size


def build_anchor(pilot, *, tape, setting, run_setting, calibration, world_index: int,
                 step_index: int, carrier_index: int, global_index: int,
                 off_axis) -> dict[str, object]:
    runner_before = sha256(RUNNER)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("source fallback value was not true before in-process override")
    captured_forecasts = {}
    captured_forecast_profiles = {}
    original_forecast = pilot.ENGINE._batched_stage2_forecasts

    def capture_forecast(**kwargs):
        configs = tuple(kwargs["configs"])
        if not configs:
            raise AssertionError("forecast batch unexpectedly contained no configurations")
        original_projection = pilot.ENGINE._projection_from_profile
        call_index = 0

        def capture_projection(**projection_kwargs):
            nonlocal call_index
            config = configs[call_index % len(configs)]
            expected_offset = call_index // len(configs) + 1
            if int(projection_kwargs["offset"]) != expected_offset:
                raise AssertionError("forecast projection order changed")
            captured_forecast_profiles.setdefault(config.configuration_id, {})[
                expected_offset
            ] = projection_kwargs["profile"]
            call_index += 1
            return original_projection(**projection_kwargs)

        pilot.ENGINE._projection_from_profile = capture_projection
        try:
            result = original_forecast(**kwargs)
        finally:
            pilot.ENGINE._projection_from_profile = original_projection
        if call_index != len(configs) * 3:
            raise AssertionError("forecast profile capture count changed")
        captured_forecasts.update(result[0])
        return result

    carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_index]
    pilot.ENGINE._batched_stage2_forecasts = capture_forecast
    pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
    started = time.perf_counter()
    try:
        built = pilot._build_anchor_rows(
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step_index=step_index,
            carrier=carrier,
            anchor_index=step_index * len(CARRIERS) + carrier_index,
            include_coalition=False,
            full_legal_actions=False,
        )
    finally:
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = True
        pilot.ENGINE._batched_stage2_forecasts = original_forecast
    build_wall = time.perf_counter() - started
    if not captured_forecasts or not captured_forecast_profiles:
        raise AssertionError("exact branch did not call the batched forecast path")

    base = built["base"]
    incumbent = built["incumbent"]
    current = built["current_evaluator"]
    base_profile = current._evaluated[base.configuration_id]
    base_projections = captured_forecasts[base.configuration_id]
    rekeyed = pilot.ENGINE._rekeyed_users(tape, step_index)
    row_indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    from mcrl.physics_v025.targets import c1_difference_surplus, c2_persistence_forecast

    view_payloads = []
    physics_rows = []
    configurations = {}
    gauge_max = Fraction()
    decomposition_max = Fraction()
    c2_decomposition_max = Fraction()
    attribution_max = 0.0
    default_phi = pilot.ENGINE._phi_for(
        incumbent, base, cell_rekeyed_users=rekeyed
    )
    for row in built["rows"]:
        identity = pilot._identity(row.action)
        mapping = base.mapping
        mapping[row.user_id] = identity
        config = pilot.ENGINE._configuration(base, mapping, kind="exact-source-attribution")
        profile = current._evaluated[config.configuration_id]
        candidate_phi = pilot.ENGINE._phi_for(
            incumbent, config, cell_rekeyed_users=rekeyed
        )
        c1 = c1_difference_surplus(
            profile.outcome(phi=candidate_phi),
            base_profile.outcome(phi=default_phi),
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        c2 = c2_persistence_forecast(
            captured_forecasts[config.configuration_id],
            base_projections,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        c1_residual = c1.normalized_total - (
            c1.difference_surplus_bits / calibration.kappa_bits_per_user_step
            + c1.phi_difference
        )
        c2_residual = c2.normalized_total - (
            (c2.forecast_surplus_bits - c2.persistence_penalty_bits)
            / calibration.kappa_bits_per_user_step
        )
        decomposition_max = max(decomposition_max, abs(c1_residual))
        c2_decomposition_max = max(c2_decomposition_max, abs(c2_residual))
        if row.reference_action:
            gauge_max = max(gauge_max, abs(c1.normalized_total))
        attribution_max = max(
            attribution_max,
            abs(math.fsum(profile.score.bits.values()) - profile.bits),
            abs(math.fsum(base_profile.score.bits.values()) - base_profile.bits),
        )
        surrogate = surrogate_labels(
            pilot,
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            user=row.user_id,
            identity=identity,
            base=base,
            incumbent=incumbent,
            config=config,
            calibration=calibration,
            row_indices=row_indices,
        )
        row_key = f"u{row.user_id:03d}-a{row.action_index:03d}"
        view = row.payload()
        view["exact_source_view"] = {
            "schema": "mcrl-v025-exact-source-view-extension-v1",
            "row_key": row_key,
            "physics_configuration_id": config.configuration_id,
            "c1_difference_surplus": {
                "core_bits": fraction_payload(c1.difference_surplus_bits),
                "phi_difference": fraction_payload(c1.phi_difference),
                "normalized_total": fraction_payload(c1.normalized_total),
                "decomposition_residual": fraction_payload(c1_residual),
            },
            "c2_persistence_forecast": {
                "forecast_surplus_bits": fraction_payload(c2.forecast_surplus_bits),
                "lost_offsets": c2.lost_offsets,
                "persistence_penalty_bits": fraction_payload(c2.persistence_penalty_bits),
                "label_bits": fraction_payload(
                    c2.forecast_surplus_bits - c2.persistence_penalty_bits
                ),
                "normalized_total": fraction_payload(c2.normalized_total),
                "decomposition_residual": fraction_payload(c2_residual),
            },
            "surrogate": surrogate,
            "evaluation_path": {
                "exact_candidate_current": "evaluate_many then cache access",
                "exact_default_current": "evaluate_many then cache access",
                "exact_candidate_forecasts": "evaluate_many",
                "exact_default_forecasts": "evaluate_many",
                "c1_target": "c1_difference_surplus",
                "c2_target": "c2_persistence_forecast",
                "surrogate": "provider-primitive-array-lookup",
                "boundary_indices": [0],
            },
        }
        view_payloads.append(view)

        candidate_geometry = []
        default_geometry = []
        for offset in range(4):
            projected_step = step_index + offset
            candidate_geometry.append(
                geometry_payload(
                    tape,
                    off_axis,
                    step_index=projected_step,
                    user=row.user_id,
                    identity=identity,
                )
            )
            default_identity = pilot.ENGINE._base_configuration(
                tape, projected_step, carrier
            ).mapping[row.user_id]
            default_geometry.append(
                geometry_payload(
                    tape,
                    off_axis,
                    step_index=projected_step,
                    user=row.user_id,
                    identity=default_identity,
                )
            )
        physics_rows.append(
            {
                "schema": "mcrl-v025-exact-source-row-physics-v1",
                "row_key": row_key,
                "user_id": row.user_id,
                "action_index": row.action_index,
                "identity": None if identity is None else list(identity),
                "reference_action": row.reference_action,
                "configuration_id": config.configuration_id,
                "candidate_geometry_offsets_0_1_2_3": candidate_geometry,
                "default_geometry_offsets_0_1_2_3": default_geometry,
            }
        )

        if config.configuration_id not in configurations:
            forecast_rows = captured_forecasts[config.configuration_id]
            forecast_profiles = captured_forecast_profiles[config.configuration_id]
            delta = [
                [int(user), None if assigned is None else list(assigned)]
                for user, assigned in sorted(config.mapping.items())
                if assigned != base.mapping[user]
            ]
            configurations[config.configuration_id] = {
                "schema": "mcrl-v025-exact-source-configuration-physics-v1",
                "configuration_id": config.configuration_id,
                "delta_from_default": delta,
                "phi_current": fraction_payload(candidate_phi),
                "current": profile_payload(profile),
                "projections": [
                    {
                        "offset_index": projection.offset_index,
                        "valid": projection.valid,
                        "survives": projection.survives,
                        "background_power_recomputed": projection.background_power_recomputed,
                        "required_power_w_hex": (
                            None
                            if projection.required_power_w is None
                            else float.hex(projection.required_power_w)
                        ),
                        "power_cap_w_hex": (
                            None
                            if projection.power_cap_w is None
                            else float.hex(projection.power_cap_w)
                        ),
                        "required_power_cap_margin_w_hex": (
                            None
                            if projection.required_power_cap_margin_w is None
                            else float.hex(projection.required_power_cap_margin_w)
                        ),
                        "profile": profile_payload(
                            forecast_profiles[projection.offset_index]
                        ),
                    }
                    for projection in forecast_rows
                ],
            }

    anchor_within_world = step_index * len(CARRIERS) + carrier_index
    filename = f"{LABEL}-exact-source-anchor-{anchor_within_world:03d}.jsonl"
    physics_relative = Path(f"world-{world_index + 1}") / filename
    view_relative = Path(f"world-{world_index + 1}") / filename
    staging_root = STAGING / f"global-{global_index:03d}"
    physics_staging = staging_root / "physics" / physics_relative
    view_staging = staging_root / "views" / view_relative
    common_header = {
        "artifact_label": LABEL,
        "world_index": world_index + 1,
        "world_id": tape.domain,
        "global_anchor_index": global_index,
        "anchor_index_within_world": anchor_within_world,
        "step_index": step_index,
        "carrier_index": carrier_index,
        "carrier": carrier,
        "row_count": len(view_payloads),
        "evaluation_path": {
            "current_candidate_and_default": "evaluate_many",
            "forecast_candidate_and_default": "evaluate_many",
            "boundaries": [0],
        },
    }
    physics_header = {
        **common_header,
        "schema": "mcrl-v025-exact-source-physics-shard-v1",
        "record_kinds": ["anchor_context", "configuration_physics", "row_geometry"],
    }
    physics_context = {
        "schema": "mcrl-v025-exact-source-anchor-context-v1",
        "default_configuration_id": base.configuration_id,
        "default_mapping": [
            [int(user), None if identity is None else list(identity)]
            for user, identity in sorted(base.mapping.items())
        ],
        "incumbent_mapping": [
            [int(user), None if identity is None else list(identity)]
            for user, identity in sorted(incumbent.mapping.items())
        ],
        "cell_rekeyed_users": list(rekeyed),
        "refresh_phase": tape.steps[step_index].refresh_phase,
        "default_phi_current": fraction_payload(default_phi),
        "calibration": {
            "lambda_bits_per_j": fraction_payload(calibration.lambda_bits_per_j),
            "eta_ref": fraction_payload(calibration.eta_ref),
            "kappa_bits_per_user_step": fraction_payload(
                calibration.kappa_bits_per_user_step
            ),
        },
    }
    physics_payloads = [
        physics_context,
        *[configurations[key] for key in sorted(configurations)],
        *physics_rows,
    ]
    physics_hash, physics_count, physics_bytes = write_anchor_shard(
        physics_staging, physics_header, physics_payloads
    )
    view_header = {
        **common_header,
        "schema": "mcrl-v025-exact-source-view-shard-v1",
        "existing_row_schema": view_payloads[0]["schema"],
        "extension_schema": "mcrl-v025-exact-source-view-extension-v1",
        "q1_slots": 16,
        "q2_slots": 22,
    }
    view_hash, row_count, view_bytes = write_anchor_shard(
        view_staging, view_header, view_payloads
    )
    peak = assert_rss()
    record = {
        "global_anchor_index": global_index,
        "world_index": world_index + 1,
        "world_id": tape.domain,
        "anchor_index_within_world": anchor_within_world,
        "step_index": step_index,
        "carrier_index": carrier_index,
        "carrier": carrier,
        "physics_relative_path": physics_relative.as_posix(),
        "view_relative_path": view_relative.as_posix(),
        "physics_staging_path": physics_staging.relative_to(OUTPUT).as_posix(),
        "view_staging_path": view_staging.relative_to(OUTPUT).as_posix(),
        "physics_sha256": physics_hash,
        "view_sha256": view_hash,
        "row_count": row_count,
        "physics_record_count": physics_count,
        "configuration_count": len(configurations),
        "physics_byte_count": physics_bytes,
        "view_byte_count": view_bytes,
        "build_wall_s": build_wall,
        "physics_boundary_evaluations": int(built["physics_calls"]),
        "skipped_invalid": int(built["skipped_invalid"]),
        "gauge_max_abs": fraction_payload(gauge_max),
        "c1_decomposition_max_abs": fraction_payload(decomposition_max),
        "c2_decomposition_max_abs": fraction_payload(c2_decomposition_max),
        "per_user_attribution_sum_max_abs_bits": attribution_max,
        "runner_sha256_before": runner_before,
        "runner_sha256_after": sha256(RUNNER),
        "fallback_source_value_restored": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True,
        "peak_rss_bytes": peak,
    }
    if record["runner_sha256_after"] != runner_before:
        raise AssertionError("runner bytes changed during anchor build")
    if gauge_max or decomposition_max or c2_decomposition_max or attribution_max:
        raise AssertionError(f"exact identities failed: {record}")
    result_path = staging_root / f"{LABEL}-anchor-{global_index:03d}.result.json"
    atomic_json(result_path, record)
    return record


def world_plan_worker(plan: tuple[int, ...], deadline: float) -> list[dict[str, object]]:
    assert_runtime()
        position = end
    return ranks


def correlation(first: list[float], second: list[float]) -> float:
    mean_first = statistics.fmean(first)
    mean_second = statistics.fmean(second)
    numerator = math.fsum(
        (left - mean_first) * (right - mean_second)
        for left, right in zip(first, second, strict=True)
    )
    denominator = math.sqrt(
        math.fsum((value - mean_first) ** 2 for value in first)
        * math.fsum((value - mean_second) ** 2 for value in second)
    )
    return numerator / denominator


def verify(records: list[dict[str, object]]) -> dict[str, object]:
    exact_c1: list[float] = []
    surrogate_c1: list[float] = []
    exact_c2: list[float] = []
    surrogate_c2: list[float] = []
    exact_combined: list[float] = []
    surrogate_combined: list[float] = []
    groups: dict[tuple[int, int], list[tuple[int, float, float, float, float, float, float]]] = {}
    gauge_max = 0.0
    c1_residual_max = 0.0
    c2_residual_max = 0.0
    attribution_max = 0.0
    rows_seen = 0
    physics_configurations_seen = 0
    geometry_rows_seen = 0
    true_off_axis_rows_seen = 0
    for record in records:
        physics_path = PHYSICS / str(record["physics_relative_path"])
        view_path = VIEWS / str(record["view_relative_path"])
        if sha256(physics_path) != record["physics_sha256"]:
            raise AssertionError(f"physics shard hash mismatch: {physics_path}")
        if sha256(view_path) != record["view_sha256"]:
            raise AssertionError(f"view shard hash mismatch: {view_path}")
        configuration_ids = set()
        physics_row_keys = set()
        with physics_path.open() as handle:
            physics_header = json.loads(next(handle))
            physics_count = 0
            for line in handle:
                payload = json.loads(line)
                physics_count += 1
                schema = payload["schema"]
                if schema == "mcrl-v025-exact-source-configuration-physics-v1":
                    physics_configurations_seen += 1
                    configuration_ids.add(payload["configuration_id"])
                    profiles = [payload["current"]] + [
                        projection["profile"] for projection in payload["projections"]
                    ]
                    if len(payload["projections"]) != 3:
                        raise AssertionError("physics configuration lost a sealed offset")
                    for profile in profiles:
                        if not profile["valid"]:
                            continue
                        values = [
                            float.fromhex(per_user["bits_hex"])
                            for per_user in profile["per_user"]
                        ]
                        expected = float.fromhex(profile["whole_network_bits_hex"])
                        attribution_max = max(
                            attribution_max, abs(math.fsum(values) - expected)
                        )
                elif schema == "mcrl-v025-exact-source-row-physics-v1":
                    geometry_rows_seen += 1
                    physics_row_keys.add(payload["row_key"])
                    if len(payload["candidate_geometry_offsets_0_1_2_3"]) != 4:
                        raise AssertionError("candidate geometry lost a sealed offset")
                    if len(payload["default_geometry_offsets_0_1_2_3"]) != 4:
                        raise AssertionError("default geometry lost a sealed offset")
                    for geometry in (
                        payload["candidate_geometry_offsets_0_1_2_3"]
                        + payload["default_geometry_offsets_0_1_2_3"]
                    ):
                        if geometry["present_in_tape"]:
                            float.fromhex(geometry["elevation_deg_hex"])
                            float.fromhex(geometry["true_off_axis_angle_rad_hex"])
                            true_off_axis_rows_seen += 1
                elif schema != "mcrl-v025-exact-source-anchor-context-v1":
                    raise AssertionError(f"unknown physics record schema: {schema}")
            if physics_count != record["physics_record_count"]:
                raise AssertionError(f"physics record-count mismatch: {physics_path}")
            if physics_header["row_count"] != record["row_count"]:
                raise AssertionError(f"physics header row-count mismatch: {physics_path}")
        view_row_keys = set()
        with view_path.open() as handle:
            header = json.loads(next(handle))
            count = 0
            for line in handle:
                payload = json.loads(line)
                count += 1
                rows_seen += 1
                if len(payload["q1_state"]) != 16 or len(payload["q2_state"]) != 22:
                    raise AssertionError("sealed feature view has the wrong slot count")
                extension = payload["exact_source_view"]
                view_row_keys.add(extension["row_key"])
                if extension["physics_configuration_id"] not in configuration_ids:
                    raise AssertionError("view references absent physics configuration")
                c1 = float.fromhex(extension["c1_difference_surplus"]["normalized_total"]["float_hex"])
                s1 = float.fromhex(extension["surrogate"]["c1_normalized_total_hex"])
                c2 = float.fromhex(extension["c2_persistence_forecast"]["normalized_total"]["float_hex"])
                s2 = float.fromhex(extension["surrogate"]["c2_normalized_total_hex"])
                exact_c1.append(c1)
                surrogate_c1.append(s1)
                exact_c2.append(c2)
                surrogate_c2.append(s2)
                exact_combined.append(c1 + c2)
                surrogate_combined.append(s1 + s2)
                key = (int(record["global_anchor_index"]), int(payload["user_id"]))
                groups.setdefault(key, []).append(
                    (int(payload["action_index"]), c1, s1, c2, s2, c1 + c2, s1 + s2)
                )
                if payload["reference_action"]:
                    gauge_max = max(gauge_max, abs(c1))
                c1_residual_max = max(
                    c1_residual_max,
                    abs(float.fromhex(extension["c1_difference_surplus"]["decomposition_residual"]["float_hex"])),
                )
                c2_residual_max = max(
                    c2_residual_max,
                    abs(float.fromhex(extension["c2_persistence_forecast"]["decomposition_residual"]["float_hex"])),
                )
            if count != header["row_count"] or count != record["row_count"]:
                raise AssertionError(f"row-count mismatch: {view_path}")
        if view_row_keys != physics_row_keys:
            raise AssertionError("physics/view row-key sets differ")

    def disagreement(column_exact: int, column_surrogate: int) -> dict[str, object]:
        differing = 0
        for rows in groups.values():
            exact_winner = min(rows, key=lambda row: (-row[column_exact], row[0]))[0]
            surrogate_winner = min(rows, key=lambda row: (-row[column_surrogate], row[0]))[0]
            differing += int(exact_winner != surrogate_winner)
        return {
            "groups": len(groups),
            "different": differing,
            "fraction": differing / len(groups),
            "tie_break": "lowest action_index among exact-equal maxima",
        }

    result = {
        "schema": "mcrl-v025-exact-source-verification-v1",
        "artifact_label": LABEL,
        "anchors": len(records),
        "rows": rows_seen,
        "groups": len(groups),
        "c1_gauge_max_abs": gauge_max,
        "c1_decomposition_identity_max_abs": c1_residual_max,
        "c2_decomposition_identity_max_abs": c2_residual_max,
        "per_user_bits_sum_identity_max_abs_bits": attribution_max,
        "physics_configurations_seen": physics_configurations_seen,
        "geometry_rows_seen": geometry_rows_seen,
        "geometry_records_with_true_off_axis": true_off_axis_rows_seen,
        "c1_exact_vs_surrogate": {
            "pearson_correlation": correlation(exact_c1, surrogate_c1),
            "spearman_rank_correlation": correlation(
                average_ranks(exact_c1), average_ranks(surrogate_c1)
            ),
            "argmax_disagreement": disagreement(1, 2),
        },
        "c2_exact_vs_surrogate": {
            "pearson_correlation": correlation(exact_c2, surrogate_c2),
            "spearman_rank_correlation": correlation(
                average_ranks(exact_c2), average_ranks(surrogate_c2)
            ),
            "argmax_disagreement": disagreement(3, 4),
        },
        "c1_plus_c2_exact_vs_surrogate": {
            "pearson_correlation": correlation(exact_combined, surrogate_combined),
            "spearman_rank_correlation": correlation(
                average_ranks(exact_combined), average_ranks(surrogate_combined)
            ),
            "argmax_disagreement": disagreement(5, 6),
        },
        "evaluation_path": {
                    "prefix_rule": "only the longest completed prefix is promoted",
                },
            },
            sort_keys=True,
        ),
        flush=True,
    )
    OUTPUT.mkdir(parents=True, exist_ok=True)
    STAGING.mkdir(exist_ok=True)
    if BUILD_STATE.exists():
        state = json.loads(BUILD_STATE.read_text())
        build_started_wall = float(state["part2_started_unix_s"])
    else:
        build_started_wall = time.time()
        atomic_json(
            BUILD_STATE,
            {
                "schema": "mcrl-v025-exact-source-build-state-v1",
                "part2_started_unix_s": build_started_wall,
                "budget_s": BUILD_BUDGET_S,
                "planned_anchors": planned,
                "declared_total_anchors": TOTAL_ANCHORS,
            },
        )
    build_started_mono = time.monotonic()
    deadline = build_started_wall + BUILD_BUDGET_S
    runner_before = sha256(RUNNER)
    sealed_corpus_before = tree_digest(SEALED_CORPUS)
    pilot = load_pilot()
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("source fallback constant was not true on imported module")
    all_records = [
        json.loads(path.read_text())
        for path in sorted(STAGING.rglob("*.result.json"))
    ]
    existing = {int(row["global_anchor_index"]) for row in all_records}
    for world_index in range(WORLD_COUNT):
        first = world_index * ANCHORS_PER_WORLD
        stop = min((world_index + 1) * ANCHORS_PER_WORLD, planned)
        if first >= stop or time.time() >= deadline:
            break
        new_records = build_world_shared(
            pilot, world_index, first, stop, deadline, existing
        )
        all_records.extend(new_records)
        existing.update(int(row["global_anchor_index"]) for row in new_records)
        completed = {int(row["global_anchor_index"]) for row in all_records}
        if any(index not in completed for index in range(first, stop)):
            break
    runner_after = sha256(RUNNER)
    sealed_corpus_after = tree_digest(SEALED_CORPUS)
    if runner_after != runner_before:
        raise AssertionError("pilot runner bytes changed during build")
    if sealed_corpus_after != sealed_corpus_before:
        raise AssertionError("sealed corpus bytes changed during build")
    prefix = promote_prefix(all_records)
    discarded_nonprefix = len(all_records) - len(prefix)
    # Staging contains only this build's recoverable temporary checkpoints.
    # Once the clean prefix is promoted, discard non-prefix and result scratch.
    shutil.rmtree(STAGING)
    verification = verify(prefix)
    atomic_json(VERIFICATION, verification)
    manifest_records = []
    for record in prefix:
        clean = dict(record)
        clean.pop("physics_staging_path", None)
        clean.pop("view_staging_path", None)
        manifest_records.append(clean)
    manifest = {
        "schema": "mcrl-v025-exact-source-build-manifest-v1",
        "artifact_label": LABEL,
        "status": "complete" if len(prefix) == TOTAL_ANCHORS else "truncated-prefix",
        "not_a_claim": True,
        "declared_order": {
            "worlds": ["V025_PROBE/world/1", "V025_PROBE/world/2"],
            "within_world": "step_index 0..29, then carrier order at each step",
            "carriers": list(CARRIERS),
            "total_anchors": TOTAL_ANCHORS,
        },
        "budget": {
            "wall_s": BUILD_BUDGET_S,
            "reconciled_s_per_anchor": reconciled_rate,
            "projected_180_anchors_at_3_processes_s": projected,
            "planned_anchors": planned,
        },
        "execution": {
            "interpreter": sys.executable,
            "max_python_processes": MAX_PYTHON_PROCESSES,
            "generation_python_processes": GENERATION_PYTHON_PROCESSES,
            "prior_legacy_builder_python_processes_inferred": 2,
            "prior_legacy_builder_last_observed_checkpoint_utc": "2026-09-10T12:27:34Z",
            "nice": os.getpriority(os.PRIO_PROCESS, 0),
            "blas_threads": {name: os.environ[name] for name in THREAD_VARS},
            "include_coalition": False,
            "full_legal_actions": False,
            "selection_and_forecast_boundary_indices": [0],
            "fallback_override": "PILOT_PRIMITIVE_SOURCE_FALLBACK=False on imported module objects only",
            "runner_path": str(RUNNER),
            "runner_sha256_before": runner_before,
            "runner_sha256_after": runner_after,
            "sealed_corpus_path": str(SEALED_CORPUS),
            "sealed_corpus_tree_sha256_before": sealed_corpus_before,
            "sealed_corpus_tree_sha256_after": sealed_corpus_after,
            "build_started_unix_s": build_started_wall,
            "final_resume_wall_s": time.monotonic() - build_started_mono,
            "total_part2_wall_s": time.time() - build_started_wall,
        },
        "anchors_generated": len(prefix),
        "completed_but_discarded_nonprefix_anchors": discarded_nonprefix,
        "rows_generated": sum(int(row["row_count"]) for row in prefix),
        "physics_bytes_generated": sum(int(row["physics_byte_count"]) for row in prefix),
        "view_bytes_generated": sum(int(row["view_byte_count"]) for row in prefix),
        "anchor_records": manifest_records,
        "verification": verification,
    }
    atomic_json(MANIFEST, manifest)
    print(json.dumps({"PART_2_RESULT": {
        "anchors": manifest["anchors_generated"],
        "rows": manifest["rows_generated"],
        "status": manifest["status"],
        "c1_argmax_disagreement": verification["c1_exact_vs_surrogate"]["argmax_disagreement"]["fraction"],
        "manifest": str(MANIFEST),
    }}, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

