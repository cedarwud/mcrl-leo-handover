                                (fresh_reference.bits - eta * fresh_reference.joules)
                                - (stored_reference.bits - eta * stored_reference.joules)
                            ).numerator,
                            (
                                (fresh_reference.bits - eta * fresh_reference.joules)
                                - (stored_reference.bits - eta * stored_reference.joules)
                            ).denominator,
                        ],
                    }
                )
                valid_joints = tuple(
                    row for row in joints if row.configuration_id in evaluator._evaluated
                )
                invalid_joints = tuple(
                    row for row in joints if row.configuration_id in evaluator._invalid
                )
                if len(valid_joints) + len(invalid_joints) != len(joints):
                    raise RuntimeError("joint evaluation inventory is incomplete")
                coalition_rows = []
    if len(physics_digests) != 1:
        raise RuntimeError("C3 verification found multiple physics digests")
    build.assert_snapshot_unchanged(records)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise RuntimeError("pilot fallback flag changed")

    # Reload the production runner against its own package tree in a clean module namespace.
    for name in tuple(sys.modules):
        if name == "mcrl" or name.startswith("mcrl."):
            del sys.modules[name]
    sys.path = [entry for entry in sys.path if entry != str(build.SOURCE_ROOT / "src")]
    training_runner = load_module("c3_coalition_production_reader", build.TRAINING_RUNNER)
    reader_started = time.perf_counter()
