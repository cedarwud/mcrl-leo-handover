    variant = variant_for_digests(first_row.q1_schema_sha256, first_row.q2_schema_sha256)
    corpus_receipt = {
        "mode": "exact-view-corpus",
        "root": str(corpus.resolve()),
        "digest": canonical_sha256(inventory),
        "files": inventory,
        "anchor_list": sorted(anchors, key=lambda row: row["global_anchor_index"]),
        "source_rows": sum(len(shard.rows) for shard in source_shards),
        "coalition_rows": sum(len(shard.rows) for shard in coalition_shards),
    }
    feature = {
        "name": variant.name,
        "digest": canonical_sha256(variant.schema_manifest()),
        "q1_schema_sha256": variant.q1_schema_sha256,
        "q2_schema_sha256": variant.q2_schema_sha256,
        "q1_width": variant.q1_width,
        "q2_width": variant.q2_width,
        "view_schema": SOURCE_VIEW_SCHEMA,
        "view_extension_schema": SOURCE_EXTENSION_SCHEMA,
        "coalition_schema": COALITION_SHARD_SCHEMA,
    }
    return {"pairs": pairs, "c3": c3}, corpus_receipt, feature


def build_synthetic_corpus(
    output: Path, *, directory_name: str = "synthetic-input"
) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
    material = output / directory_name
"""Named encoder-variant seam for the Stage-C per-action feature vectors.

Everything about *which* scalars enter ``q1_state``/``q2_state``, in what
order and at what frozen scale lives behind a named :class:`EncoderVariant`.
Row building, serialization, read-back, training and evaluation discover the
feature width and the schema digests from the variant, so no downstream module
hardcodes 16 or 22.

Registration invariants that make a row impossible to misattribute:

* every variant's ``(q1_schema_sha256, q2_schema_sha256)`` pair is unique --
  registration fails loudly on collision, so the digests a row already carries
  resolve back to exactly one variant name via :func:`variant_for_digests`;
* the *default* variant's schema payload is byte-frozen (it omits the
  ``encoder_variant`` key) because its digests are already published in sealed
  shards, checkpoints and terminal reports.  Every other variant carries its
  name inside the hashed payload, which is what makes the pair unique by
  construction.

The extractor callables take one engine-neutral action evaluation and are only
ever read attribute-wise, so this module deliberately imports nothing from
``state`` -- that is what keeps the import graph acyclic.
"""

from __future__ import annotations

from dataclasses import dataclass, field
import importlib
import math
import os
from typing import Callable, Mapping, Sequence

from .canonical import StageCContractError, canonical_sha256, float_hex


Q1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
Q2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"

#: The production encoder as shipped in contract v1.  Selecting it must yield
#: rows byte-identical to the pre-seam code.
DEFAULT_ENCODER_VARIANT = "V025_CONTRACT_V1"

#: Process-wide selection levers used by the comparison runner.  ``_MODULES_ENV``
#: names importable modules whose import side effect is variant registration,
#: so a new variant never requires editing training or evaluation code.
_VARIANT_ENV = "MCRL_STAGEC_ENCODER_VARIANT"
_MODULES_ENV = "MCRL_STAGEC_ENCODER_MODULES"
_DEFAULT_PLUGIN_MODULES = ("mcrl.stagec_v025.encoder_variants",)


@dataclass(frozen=True, slots=True)
class FeatureSpec:
    name: str
    unit: str
    scale: float


def _schema_payload(
    version: str, features: Sequence[FeatureSpec], *, variant: str
) -> dict[str, object]:
    payload: dict[str, object] = {
        "schema": version,
        "normalization": "raw_value / positive_frozen_scale; signed values retained",
        "shape": [len(features)],
        "features": [
            {"name": item.name, "unit": item.unit, "scale_hex": float_hex(item.scale)}
            for item in features
        ],
        "removed": ["recurrence_power", "entry_gain_ratio", "segment_age"],
    }
    if variant != DEFAULT_ENCODER_VARIANT:
        # Deliberate asymmetry: the default payload is frozen byte-for-byte
        # because its digest is already sealed into published artefacts.  Any
        # other variant binds its name into the hashed payload, which makes the
        # digest pair unique by construction rather than by luck.
        payload["encoder_variant"] = variant
    return payload


def _normalize(
    raw: Sequence[float], specs: Sequence[FeatureSpec]
) -> tuple[float, ...]:
    if len(raw) != len(specs):
        raise StageCContractError("state field count disagrees with schema")
    result = tuple(float(value) / spec.scale for value, spec in zip(raw, specs, strict=True))
    if not all(math.isfinite(value) for value in result):
        raise StageCContractError("state values must be finite")
    return result


@dataclass(frozen=True, slots=True)
class EncoderVariant:
    """One named way of turning an action evaluation into the two vectors."""

    name: str
    q1_features: tuple[FeatureSpec, ...]
    q2_features: tuple[FeatureSpec, ...]
    q1_raw: Callable[[object], Sequence[float]]
    q2_raw: Callable[[object], Sequence[float]]
    q1_schema: Mapping[str, object] = field(repr=False)
    q2_schema: Mapping[str, object] = field(repr=False)
    q1_schema_sha256: str = ""
    q2_schema_sha256: str = ""

    @property
    def q1_width(self) -> int:
        return len(self.q1_features)

    @property
    def q2_width(self) -> int:
        return len(self.q2_features)

    def encode_q1(self, action: object) -> tuple[float, ...]:
        return _normalize(self.q1_raw(action), self.q1_features)

    def encode_q2(self, action: object) -> tuple[float, ...]:
        return _normalize(self.q2_raw(action), self.q2_features)

    def schema_manifest(self) -> dict[str, object]:
        return {
            "q1": {**self.q1_schema, "sha256": self.q1_schema_sha256},
            "q2": {**self.q2_schema, "sha256": self.q2_schema_sha256},
        }


_REGISTRY: dict[str, EncoderVariant] = {}
_DIGEST_INDEX: dict[tuple[str, str], str] = {}


def register_encoder_variant(
    name: str,
    *,
    q1_features: Sequence[FeatureSpec],
    q2_features: Sequence[FeatureSpec],
    q1_raw: Callable[[object], Sequence[float]],
    q2_raw: Callable[[object], Sequence[float]],
) -> EncoderVariant:
    """Register one named encoder.  Collisions are contract errors, not warnings."""

    if not name or not name.isascii() or name != name.strip() or " " in name:
        raise StageCContractError("encoder variant name must be a bare ASCII token")
    if name in _REGISTRY:
        raise StageCContractError(f"encoder variant {name!r} is already registered")
    q1 = tuple(q1_features)
    q2 = tuple(q2_features)
    if not q1 or not q2:
        raise StageCContractError("encoder variant must define both feature vectors")
    for spec in (*q1, *q2):
        if not math.isfinite(spec.scale) or spec.scale <= 0.0:
            raise StageCContractError("feature scales must be positive and finite")
    q1_schema = _schema_payload(Q1_SCHEMA_VERSION, q1, variant=name)
    q2_schema = _schema_payload(Q2_SCHEMA_VERSION, q2, variant=name)
    variant = EncoderVariant(
        name=name,
        q1_features=q1,
        q2_features=q2,
        q1_raw=q1_raw,
        q2_raw=q2_raw,
        q1_schema=q1_schema,
        q2_schema=q2_schema,
        q1_schema_sha256=canonical_sha256(q1_schema),
        q2_schema_sha256=canonical_sha256(q2_schema),
    )
    key = (variant.q1_schema_sha256, variant.q2_schema_sha256)
    if key in _DIGEST_INDEX:
        raise StageCContractError(
            f"encoder variant {name!r} shares its q1/q2 schema digests with "
            f"{_DIGEST_INDEX[key]!r}; rows could not be attributed to one encoder"
        )
    _REGISTRY[name] = variant
    _DIGEST_INDEX[key] = name
    return variant


def _load_plugin_modules() -> None:
    raw = os.environ.get(_MODULES_ENV)
    names = (
        tuple(part.strip() for part in raw.split(",") if part.strip())
        if raw
        else _DEFAULT_PLUGIN_MODULES
    )
    for module in names:
        try:
            importlib.import_module(module)
        except ImportError as error:
            raise StageCContractError(
                f"encoder variant module {module!r} is not importable"
            ) from error


def encoder_variant(name: str | None = None) -> EncoderVariant:
    """Resolve a variant by name, importing registration modules if needed."""

    wanted = DEFAULT_ENCODER_VARIANT if name is None else str(name)
    if wanted not in _REGISTRY:
        _load_plugin_modules()
    if wanted not in _REGISTRY:
        raise StageCContractError(
            f"unknown encoder variant {wanted!r}; registered: "
            f"{', '.join(sorted(_REGISTRY)) or '<none>'}"
        )
    return _REGISTRY[wanted]


def active_encoder_variant() -> EncoderVariant:
    """The variant selected for this process, defaulting to production."""

    return encoder_variant(os.environ.get(_VARIANT_ENV) or DEFAULT_ENCODER_VARIANT)


def variant_for_digests(q1_schema_sha256: str, q2_schema_sha256: str) -> EncoderVariant:
    """Resolve the encoder a persisted row was built with.  Never guesses."""

    key = (str(q1_schema_sha256), str(q2_schema_sha256))
    if key not in _DIGEST_INDEX:
        _load_plugin_modules()
    if key not in _DIGEST_INDEX:
        raise StageCContractError(
            "state schema digests do not match any registered encoder variant"
        )
    return _REGISTRY[_DIGEST_INDEX[key]]


def registered_encoder_variants() -> tuple[str, ...]:
    return tuple(sorted(_REGISTRY))


__all__ = [
    "DEFAULT_ENCODER_VARIANT",
    "EncoderVariant",
    "FeatureSpec",
    "Q1_SCHEMA_VERSION",
    "Q2_SCHEMA_VERSION",
    "active_encoder_variant",
    "encoder_variant",
    "register_encoder_variant",
    "registered_encoder_variants",
    "variant_for_digests",
]
"""Versioned Q1 feature-schema successor; the sealed v1 code stays untouched.

The module is intentionally a projection layer.  Both sealed pilot builders
may produce their authenticated v1 rows first; this layer replaces the dead
geometry coordinate with decision-time geometry, adds focal elevation, removes
two exact indicator duplicates, and emits a row/shard identity that cannot be
mistaken for v1.
"""

from __future__ import annotations

from dataclasses import dataclass
from hashlib import sha256
import json
import math
from typing import Any, Callable, Iterable, Mapping, Sequence


Q1_V1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
Q1_V1_SCHEMA_SHA256 = "c002ea883a4ab727f9e00cc15866f5b9d37abca645963fd3db2f2db7c6cc887a"
Q1_V2_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v2"
ROW_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-row-v2"
SHARD_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-shard-v2"


class Q1SchemaV2Error(RuntimeError):
    """A v2 schema/projection invariant failed closed."""


def canonical_json_bytes(value: Any) -> bytes:
    try:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
            allow_nan=False,
        ).encode("ascii")
    except (TypeError, ValueError, UnicodeEncodeError) as error:
        raise Q1SchemaV2Error("value is not canonical finite JSON") from error


def canonical_sha256(value: Any) -> str:
    return sha256(canonical_json_bytes(value)).hexdigest()


def float_hex(value: float | int) -> str:
    number = float(value)
    if not math.isfinite(number):
        raise Q1SchemaV2Error("schema floats must be finite")
    return number.hex()


def parse_float_hex(value: object, *, field: str) -> float:
    if not isinstance(value, str):
        raise Q1SchemaV2Error(f"{field} must be a hexadecimal float string")
    try:
        number = float.fromhex(value)
    except ValueError as error:
        raise Q1SchemaV2Error(f"{field} is not a hexadecimal float") from error
    if not math.isfinite(number) or number.hex() != value:
        raise Q1SchemaV2Error(f"{field} is not a canonical finite float")
    return number


@dataclass(frozen=True, slots=True)
class FeatureSpec:
    name: str
    unit: str
    scale: float


# The two exact indicators from v1 are deliberately absent:
#   beam_active_before_focal == 1[background occupancy > 0]
#   previous_beam_active_for_action == 1[previous served load > 0]
Q1_V2_FEATURES = (
    FeatureSpec("nominal_sinr_margin_at_rate_target", "dB", 20.0),
    FeatureSpec("nominal_required_power_over_cap", "ratio", 1.0),
    FeatureSpec("nominal_mode_spectral_efficiency", "bit/s/Hz", 4.0),
    FeatureSpec("background_occupancy_excluding_focal", "user", 10.0),
    FeatureSpec("satellite_active_before_focal", "boolean", 1.0),
    FeatureSpec("off_axis_angle", "rad", 1.0),
    FeatureSpec("focal_link_elevation", "deg", 90.0),
    FeatureSpec("remaining_d2_time", "s", 120.0),
    FeatureSpec("remaining_visibility_time", "s", 120.0),
    FeatureSpec("refresh_phase", "decision", 3.0),
    FeatureSpec("previous_served_association_for_action", "boolean", 1.0),
    FeatureSpec("previous_served_load_for_action", "user", 10.0),
    FeatureSpec("previous_satellite_active_for_action", "boolean", 1.0),
    FeatureSpec("previous_beam_max_rf_over_cap", "ratio", 1.0),
    FeatureSpec("missing_incumbent", "boolean", 1.0),
)
Q1_V2_FEATURE_NAMES = tuple(feature.name for feature in Q1_V2_FEATURES)


Q1_V2_SCHEMA = {
    "schema": Q1_V2_SCHEMA_VERSION,
    "successor_of": {
        "schema": Q1_V1_SCHEMA_VERSION,
        "sha256": Q1_V1_SCHEMA_SHA256,
    },
    "normalization": "raw_value / positive_frozen_scale; signed values retained",
    "shape": [len(Q1_V2_FEATURES)],
    "features": [
        {
            "name": feature.name,
            "unit": feature.unit,
            "scale_hex": float_hex(feature.scale),
        }
        for feature in Q1_V2_FEATURES
    ],
    "changes": {
        "repaired": [
            "off_axis_angle: true satellite-to-(beam centre,user) angle at decision boundary 0, converted from physics degrees to schema radians"
        ],
        "added": [
            "focal_link_elevation: provider boundary-0 elevation in the physics degree convention"
        ],
        "removed_exact_redundancies": [
            "beam_active_before_focal",
            "previous_beam_active_for_action",
        ],
        "retained_structural_coordinate": [
            "missing_incumbent: meaningful for tapes with an unserved prior mapping; structurally zero on the measured pilot tapes"
        ],
        "null_action_geometry": (
            "off_axis_angle and focal_link_elevation are 0 only when the row-level "
            "null_action flag says that no focal link exists"
        ),
    },
    "removed_legacy": ["recurrence_power", "entry_gain_ratio", "segment_age"],
}
Q1_V2_SCHEMA_SHA256 = canonical_sha256(Q1_V2_SCHEMA)


def upgrade_q1_state_v2(
    q1_state_v1: Sequence[float],
    *,
    off_axis_angle_rad: float,
    focal_elevation_deg: float,
    null_action: bool,
) -> tuple[float, ...]:
    """Project one learner-normalized v1 vector to learner-normalized v2."""

    if len(q1_state_v1) != 16:
        raise Q1SchemaV2Error("v1 Q1 state must have exactly 16 slots")
    old = tuple(float(value) for value in q1_state_v1)
    if not all(math.isfinite(value) for value in old):
        raise Q1SchemaV2Error("v1 Q1 state contains a non-finite value")
    angle = float(off_axis_angle_rad)
    elevation = float(focal_elevation_deg)
    if not math.isfinite(angle) or not math.isfinite(elevation):
        raise Q1SchemaV2Error("decision geometry must be finite")
    if null_action:
        if angle != 0.0 or elevation != 0.0:
            raise Q1SchemaV2Error("null action geometry must use the explicit absent-link zeros")
    elif not (0.0 <= angle <= math.pi and -90.0 <= elevation <= 90.0):
        raise Q1SchemaV2Error("non-null decision geometry is outside physical bounds")

    # Old slots 4 and 12 are excluded. Old slot 6 is replaced, not reused.
    projected = (
        *old[0:4],
        old[5],
        angle,
        elevation / 90.0,
        *old[7:12],
        *old[13:16],
    )
    if len(projected) != len(Q1_V2_FEATURES):
        raise AssertionError("internal v2 projection length drifted")
    return projected


def project_row_payload_v2(
    parent_payload: Mapping[str, object],
    *,
    off_axis_angle_rad: float,
    focal_elevation_deg: float,
    geometry_source: str,
) -> dict[str, object]:
    """Create an authenticated v2 row payload from a readable sealed v1 row."""

    if parent_payload.get("q1_schema_sha256") != Q1_V1_SCHEMA_SHA256:
        raise Q1SchemaV2Error("parent row is not the sealed Q1 v1 schema")
    raw_state = parent_payload.get("q1_state")
    if not isinstance(raw_state, list) or len(raw_state) != 16:
        raise Q1SchemaV2Error("parent q1_state is malformed")
    old = tuple(parse_float_hex(value, field="q1_state") for value in raw_state)
    null_action = parent_payload.get("null_action")
    if type(null_action) is not bool:
        raise Q1SchemaV2Error("parent null_action is not boolean")
    state = upgrade_q1_state_v2(
        old,
        off_axis_angle_rad=off_axis_angle_rad,
        focal_elevation_deg=focal_elevation_deg,
        null_action=null_action,
    )
    if not geometry_source:
        raise Q1SchemaV2Error("geometry source must be named")

    result = dict(parent_payload)
    result["schema"] = ROW_V2_SCHEMA_VERSION
    result["q1_state"] = [float_hex(value) for value in state]
    result["q1_schema_sha256"] = Q1_V2_SCHEMA_SHA256
    result["q1_v1_parent_row_sha256"] = canonical_sha256(parent_payload)
    result["q1_geometry_source"] = geometry_source
    result["q1_visible_primitives_sha256"] = canonical_sha256(
        {
            "parent_visible_primitives_sha256": parent_payload.get(
                "visible_primitives_sha256"
            ),
            "off_axis_angle_rad_hex": float_hex(off_axis_angle_rad),
            "focal_elevation_deg_hex": float_hex(focal_elevation_deg),
            "geometry_source": geometry_source,
        }
    )
    validate_v2_row_payload(result)
    return result


def validate_v2_row_payload(payload: Mapping[str, object]) -> None:
    if payload.get("schema") != ROW_V2_SCHEMA_VERSION:
        raise Q1SchemaV2Error("row schema is not Q1 v2")
    if payload.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256:
        raise Q1SchemaV2Error("row Q1 digest is not Q1 v2")
    state = payload.get("q1_state")
    if not isinstance(state, list) or len(state) != len(Q1_V2_FEATURES):
        raise Q1SchemaV2Error("v2 row state dimension drifted")
    for value in state:
        parse_float_hex(value, field="q1_state")
    for field in ("q1_v1_parent_row_sha256", "q1_visible_primitives_sha256"):
        digest = payload.get(field)
        if (
            not isinstance(digest, str)
            or len(digest) != 64
            or any(character not in "0123456789abcdef" for character in digest)
        ):
            raise Q1SchemaV2Error(f"{field} is not a lowercase SHA-256")


def encode_v2_shard(rows: Iterable[Mapping[str, object]]) -> bytes:
    """Serialize a canonical v2 shard with its own digest in every row/header."""

    material = [dict(row) for row in rows]
    if not material:
        raise Q1SchemaV2Error("cannot encode an empty v2 shard")
    for row in material:
        validate_v2_row_payload(row)
    q2_digests = {row.get("q2_schema_sha256") for row in material}
    if len(q2_digests) != 1:
        raise Q1SchemaV2Error("v2 shard rows disagree on Q2 schema")
    header = {
        "schema": SHARD_V2_SCHEMA_VERSION,
        "row_count": len(material),
        "rows_sha256": canonical_sha256(material),
        "q1_schema_sha256": Q1_V2_SCHEMA_SHA256,
        "q2_schema_sha256": next(iter(q2_digests)),
    }
    return b"\n".join(canonical_json_bytes(value) for value in (header, *material)) + b"\n"


def decode_v2_shard(encoded: bytes) -> tuple[dict[str, object], ...]:
    """Read and re-check a canonical v2 shard; v1 remains owned by its reader."""

    try:
        values = [json.loads(line.decode("ascii")) for line in encoded.splitlines()]
    except (UnicodeError, json.JSONDecodeError) as error:
        raise Q1SchemaV2Error("cannot parse v2 shard") from error
    if not values or not isinstance(values[0], dict):
        raise Q1SchemaV2Error("v2 shard header is missing")
    if encoded != b"\n".join(canonical_json_bytes(value) for value in values) + b"\n":
        raise Q1SchemaV2Error("v2 shard is not canonical JSONL")
    header, rows = values[0], values[1:]
    if (
        header.get("schema") != SHARD_V2_SCHEMA_VERSION
        or header.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256
        or header.get("row_count") != len(rows)
        or header.get("rows_sha256") != canonical_sha256(rows)
    ):
        raise Q1SchemaV2Error("v2 shard header/digest check failed")
    for row in rows:
        if not isinstance(row, dict):
            raise Q1SchemaV2Error("v2 shard row is not an object")
        validate_v2_row_payload(row)
    return tuple(rows)


GeometryLookup = Callable[[object], tuple[float, float]]


def decision_geometry_from_ecef(
    *,
    satellite_ecef_km: Sequence[float],
    beam_centre_ecef_km: Sequence[float],
    user_ecef_km: Sequence[float],
) -> tuple[float, float]:
    """Return (off-axis radians, elevation degrees) from decision-time ECEF.

    Off-axis is the angle at the satellite between the satellite-to-cell
    boresight and satellite-to-user link. Elevation uses the spherical-Earth
    local-up convention used by the provider/channel path.
    """

    satellite = tuple(float(value) for value in satellite_ecef_km)
    centre = tuple(float(value) for value in beam_centre_ecef_km)
    user = tuple(float(value) for value in user_ecef_km)
    if any(len(vector) != 3 for vector in (satellite, centre, user)):
        raise Q1SchemaV2Error("ECEF geometry vectors must have length three")
    if not all(math.isfinite(value) for vector in (satellite, centre, user) for value in vector):
        raise Q1SchemaV2Error("ECEF geometry must be finite")

    boresight = tuple(c - s for c, s in zip(centre, satellite, strict=True))
    link_from_satellite = tuple(u - s for u, s in zip(user, satellite, strict=True))
    link_from_user = tuple(s - u for s, u in zip(satellite, user, strict=True))

    def norm(vector: Sequence[float]) -> float:
        return math.sqrt(sum(value * value for value in vector))

    boresight_norm = norm(boresight)
    satellite_link_norm = norm(link_from_satellite)
    satellite_link_norm = norm(link_from_satellite)
    user_norm = norm(user)
    if min(boresight_norm, satellite_link_norm, user_norm) <= 0.0:
        raise Q1SchemaV2Error("ECEF geometry contains a zero-length direction")
    cosine = sum(
        left * right for left, right in zip(boresight, link_from_satellite, strict=True)
    ) / (boresight_norm * satellite_link_norm)
    off_axis_rad = math.acos(max(-1.0, min(1.0, cosine)))
    sine_elevation = sum(
        delta * up for delta, up in zip(link_from_user, user, strict=True)
    ) / (satellite_link_norm * user_norm)
    elevation_deg = math.degrees(math.asin(max(-1.0, min(1.0, sine_elevation))))
    return off_axis_rad, elevation_deg


class DecisionGeometryResolverV2:
    """Resolve true focal geometry for one tape step through public seams."""

    def __init__(self, tape: object, provider: object, step_index: int) -> None:
        # Imports stay local so the schema/digest itself has no dependency on
        # the sealed implementation. The caller chooses which readable v1
        # provider supplies the successor's geometry.
        import numpy as np
        from mcrl.env.cells import build_cell_grid
        from mcrl.env.geometry import geodetic_to_ecef
        from mcrl.env.scenario import NOMINAL_GRID_ALTITUDE_KM

        step = tape.steps[step_index]
        arrays = step.arrays
        if arrays is None:
            raise Q1SchemaV2Error(
                "v2 off-axis requires the provider array/ECEF seam; object-only tape is insufficient"
            )
        layouts = (
            tape.step_user_layouts[step_index]
            if tape.step_user_layouts
            else tape.user_layout
        )
        ordered = sorted(layouts, key=lambda item: item.user_id)
        user_ids = np.asarray([item.user_id for item in ordered], dtype=np.int64)
        user_ecef = geodetic_to_ecef(
            np.asarray([item.latitude_deg for item in ordered], dtype=np.float64),
            np.asarray([item.longitude_deg for item in ordered], dtype=np.float64),
        )
        user_by_id = {
            int(user_id): tuple(float(value) for value in user_ecef[index])
            for index, user_id in enumerate(user_ids.tolist())
        }
        satellites = dict(
            provider.satellite_ecef_km(
                world_seed=tape.seed,
                step_index=step_index,
                boundary_index=0,
            )
        )
        grid = build_cell_grid(altitude_km=NOMINAL_GRID_ALTITUDE_KM)
        row_index = arrays._row_index()
        resolved: dict[tuple[int, tuple[int, int]], tuple[float, float]] = {}
        maximum_elevation_error = 0.0
        for (user_id, identity), array_row in row_index.items():
            norad, cell_id = identity
            geometry = decision_geometry_from_ecef(
                satellite_ecef_km=satellites[norad],
                beam_centre_ecef_km=grid.centers_ecef_km[cell_id],
                user_ecef_km=user_by_id[user_id],
            )
            array_elevation = float(arrays.elevations_deg[0, array_row])
            maximum_elevation_error = max(
                maximum_elevation_error, abs(geometry[1] - array_elevation)
            )
            resolved[(user_id, identity)] = (geometry[0], array_elevation)
        if maximum_elevation_error > 1.0e-9:
            raise Q1SchemaV2Error(
                "public ECEF elevation disagrees with provider boundary-0 elevation"
            )
        self._resolved = resolved
        self.maximum_elevation_crosscheck_error_deg = maximum_elevation_error

    def __call__(self, row: object) -> tuple[float, float]:
        if bool(row.null_action):
            return 0.0, 0.0
        action = row.action
        if action.norad_id is None or action.beam_chain_id is None:
            raise Q1SchemaV2Error("non-null row has no physical identity")
        key = (
            int(row.user_id),
            (int(action.norad_id), int(action.beam_chain_id)),
        )
        try:
            return self._resolved[key]
        except KeyError as error:
            raise Q1SchemaV2Error(
                "non-null row has no decision-time provider geometry"
            ) from error


def _upgrade_builder_output_v2(
    result: Mapping[str, object], geometry_lookup: GeometryLookup
) -> dict[str, object]:
    """Upgrade the row portion of either sealed builder result."""

    parent_rows = result.get("rows")
    if not isinstance(parent_rows, tuple):
        raise Q1SchemaV2Error("builder result has no tuple of source rows")
    upgraded = []
    for row in parent_rows:
        angle, elevation = geometry_lookup(row)
        upgraded.append(
            project_row_payload_v2(
                row.payload(),
                off_axis_angle_rad=angle,
                focal_elevation_deg=elevation,
                geometry_source=(
                    "provider boundary-0 ECEF satellite/cell/user geometry; "
                    "elevation cross-checked against PrimitiveStepArrays"
                ),
            )
        )
    output = dict(result)
    output["rows_v1"] = parent_rows
    output["rows"] = tuple(upgraded)
    output["rows_by_user_action"] = {
        (int(row["user_id"]), (
            None
            if bool(row["null_action"])
            else (int(row["action"]["norad_id"]), int(row["action"]["beam_chain_id"]))
        )): row
        for row in upgraded
    }
    return output


def build_primitive_rows_v2(
    pilot_module: object,
    *,
    geometry_lookup: GeometryLookup,
    **builder_arguments: object,
) -> dict[str, object]:
    """Run the sealed fallback builder, then emit only versioned v2 rows."""

    result = pilot_module._build_anchor_rows_primitive(**builder_arguments)
    return _upgrade_builder_output_v2(result, geometry_lookup)


def build_exact_rows_v2(
    pilot_module: object,
    *,
    geometry_lookup: GeometryLookup,
    **builder_arguments: object,
) -> dict[str, object]:
    """Run the sealed exact builder branch, then emit only versioned v2 rows."""

    original = pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK
    pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
    try:
        result = pilot_module._build_anchor_rows(**builder_arguments)
    finally:
        pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK = original
    return _upgrade_builder_output_v2(result, geometry_lookup)



