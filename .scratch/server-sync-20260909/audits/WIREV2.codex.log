def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("ascii")


def write_new_json(path: Path, payload: object) -> None:
    if path.exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(canonical_bytes(payload) + b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def python_processes() -> tuple[tuple[int, str], ...]:
    rows = []
    for item in Path("/proc").iterdir():
        if not item.name.isdigit():
            continue
        try:
            name = (item / "comm").read_text().strip()
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if name.startswith("python"):
            rows.append((int(item.name), name))
    return tuple(sorted(rows))


def enforce_resources() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins are not all one: {bad}")
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    effective_cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
    resource.setrlimit(resource.RLIMIT_AS, (effective_cap, effective_cap))
    processes = python_processes()
    if len(processes) > 3:
        raise RuntimeError(f"python-process cap exceeded: {processes}")
    if peak_rss_bytes() >= 5_000_000_000:
        raise MemoryError("initial peak RSS is already at or above 5 GB")


def verify_sidecar(path: Path) -> str:
    sidecar = path.with_suffix(path.suffix + ".sha256")
    fields = sidecar.read_text(encoding="ascii").strip().split()
    if len(fields) != 2 or fields[1] != path.name:
        raise RuntimeError(f"malformed sidecar: {sidecar}")
    actual = sha256(path)
    if fields[0] != actual:
        raise RuntimeError(f"SHA-256 mismatch: {path}")
    return actual


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def snapshot_prefix() -> list[dict[str, object]]:
    records = []
    for index in range(SNAPSHOT_LIMIT):
        root = SOURCE_STAGING / f"global-{index:03d}"
        result_path = root / f"BUILD_NOT_CLAIM-anchor-{index:03d}.result.json"
        if not result_path.is_file():
            break
        record = json.loads(result_path.read_text())
        if int(record["global_anchor_index"]) != index:
            raise RuntimeError("source result index drifted")
        physics = SOURCE_CORPUS / str(record["physics_staging_path"])
        view = SOURCE_CORPUS / str(record["view_staging_path"])
        if not all(
            path.is_file()
            for path in (
                physics,
                physics.with_suffix(physics.suffix + ".sha256"),
                view,
                view.with_suffix(view.suffix + ".sha256"),
            )
        ):
            break
        physics_hash = verify_sidecar(physics)
        view_hash = verify_sidecar(view)
        if physics_hash != record["physics_sha256"] or view_hash != record["view_sha256"]:
            raise RuntimeError(f"result/sidecar disagreement for anchor {index}")
        records.append(
            {
                **record,
                "source_result_path": str(result_path),
                "source_physics_path": str(physics),
                "source_view_path": str(view),
                "source_result_sha256": sha256(result_path),
            }
        )
    if not records:
        raise RuntimeError("no complete authenticated source prefix exists")
    if [int(row["global_anchor_index"]) for row in records] != list(range(len(records))):
        raise RuntimeError("source snapshot is not a declared-order prefix")
    return records


def fraction(payload: dict[str, object]) -> Fraction:
    numerator, denominator = payload["fraction"]
    value = Fraction(int(numerator), int(denominator))
    if payload["float_hex"] != float.hex(float(value)):
        raise RuntimeError("fraction/float-hex disagreement")
    return value


def identity(value):
    return None if value is None else (int(value[0]), int(value[1]))


def mapping(payload: list[list[object]]) -> dict[int, tuple[int, int] | None]:
    return {int(user): identity(action) for user, action in payload}


def profile_payload(profile) -> dict[str, object]:
    return {
        "valid": True,
        "whole_network_bits_hex": float.hex(profile.bits),
        "whole_network_joules_hex": float.hex(profile.joules),
        "per_user": [
            {
                "user_id": int(user),
                "bits_hex": float.hex(float(profile.score.bits[user])),
                "served_phy": bool(profile.score.served_phy[user]),
                "decoding_time_s_hex": float.hex(float(profile.score.decoding_time_s[user])),
                "useful_time_s_hex": float.hex(float(profile.score.useful_time_s[user])),
                "rate_target_attained": (
                    None
                    if profile.score.rate_target_attained is None
                    else bool(profile.score.rate_target_attained[user])
                ),
                "rate_target_feasible": (
                    None
                    if profile.score.rate_target_feasible is None
                    else bool(profile.score.rate_target_feasible[user])
                ),
            }
            for user in sorted(profile.score.bits)
        ],
        "energy_components_j_hex": {
            str(name): float.hex(float(value))
            for name, value in sorted(profile.energy_components.items())
        },
        "required_power_w_max_hex": float.hex(profile.required_power_w_max),
        "minimum_decoding_margin_db_hex": float.hex(profile.min_decoding_margin_db),
        "mean_acm_spectral_efficiency_bit_s_hz_hex": float.hex(
            profile.mean_acm_se_bit_s_hz
        ),
        "acm_mode_counts": dict(sorted(profile.acm_mode_counts.items())),
        "certificate_status": profile.certificate_status,
        "certificate_iterations": int(profile.certificate_iterations),
        "rf_cap_hits": int(profile.rf_cap_hits),
        "rf_transmission_observations": int(profile.rf_transmission_observations),
    }


def outcome_from_stored(profile: dict[str, object], phi_payload: dict[str, object], NetworkOutcome):
    if profile["valid"] is not True:
        raise RuntimeError("stored singleton/default outcome is invalid")
    per_user = {
    per_user = {
        int(row["user_id"]): float.fromhex(str(row["bits_hex"]))
        for row in profile["per_user"]
    }
    bits = sum((Fraction(str(value)) for value in per_user.values()), Fraction())
    decoding = math.fsum(
        float.fromhex(str(row["decoding_time_s_hex"])) for row in profile["per_user"]
    ) / (max(1, len(per_user)) * 30.08)
    useful = math.fsum(
        float.fromhex(str(row["useful_time_s_hex"])) for row in profile["per_user"]
    ) / (max(1, len(per_user)) * 30.08)
    return NetworkOutcome.build(
        bits=bits,
        joules=float.fromhex(str(profile["whole_network_joules_hex"])),
        phi=fraction(phi_payload),
        decoding_availability=min(1.0, max(0.0, decoding)),
        useful_availability=min(1.0, max(0.0, useful)),
        per_user_bits=per_user,
    )


def read_anchor_material(record, row_from_payload):
    physics_path = Path(str(record["source_physics_path"]))
    view_path = Path(str(record["source_view_path"]))
    with physics_path.open("r", encoding="ascii") as handle:
        header = json.loads(next(handle))
        if header["evaluation_path"] != {
            "boundaries": [0],
            "current_candidate_and_default": "evaluate_many",
            "forecast_candidate_and_default": "evaluate_many",
        }:
            raise RuntimeError("stored physics evaluation path drifted")
        context = None
        configurations = {}
        for line in handle:
            payload = json.loads(line)
            if payload["schema"] == "mcrl-v025-exact-source-anchor-context-v1":
                context = payload
            elif payload["schema"] == "mcrl-v025-exact-source-configuration-physics-v1":
                if len(payload["delta_from_default"]) <= 1:
                    configurations[payload["configuration_id"]] = {
                        "delta_from_default": payload["delta_from_default"],
                        "phi_current": payload["phi_current"],
                        "current": payload["current"],
                    }
    if context is None:
        raise RuntimeError("physics anchor context is missing")
    rows_by_user_action = {}
    authority = None
    with view_path.open("r", encoding="ascii") as handle:
        view_header = json.loads(next(handle))
        for line in handle:
            payload = json.loads(line)
            extension = payload.pop("exact_source_view")
            row = row_from_payload(payload)
            action = (
                None
                if row.action.norad_id is None
                else (row.action.norad_id, row.action.beam_chain_id)
            )
            rows_by_user_action[(row.user_id, action)] = row
            current_authority = {
                "world_seed": row.world_seed,
                "decision_time_utc": row.decision_time_utc,
                "decision_time_ns": row.decision_time_ns,
                "setting_id": row.setting_id,
                "code_digest": row.code_digest,
                "physics_digest": row.physics_digest,
                "catalogue_digest": row.catalogue_digest,
                "setting_digest": row.setting_digest,
                "calibration_digest": row.calibration_digest,
                "allocation_manifest_digest": row.allocation_manifest_digest,
                "provider_digest": row.provider_digest,
                "archive_digest": row.archive_digest,
            }
            if authority is None:
                authority = current_authority
            elif authority != current_authority:
                raise RuntimeError("source view authority varies within one anchor")
            if extension["physics_configuration_id"] not in configurations:
                raise RuntimeError("source view refers to absent singleton physics")
    if authority is None or len(rows_by_user_action) != int(view_header["row_count"]):
        raise RuntimeError("source view row inventory drifted")
    return header, context, configurations, rows_by_user_action, authority


def reconstruct_catalogue(ENGINE, tape, step_index, base, run_setting, configurations,
                          eta: Fraction, kappa: Fraction):
    users = tuple(sorted(user.user_id for user in tape.user_layout))
    all_options, raw_census = ENGINE._legal_options(tape, step_index)
    product_size = math.prod(len(all_options[user]) if all_options[user] else 1 for user in users)
    if product_size <= ENGINE.COMPLETE_CATALOGUE_LIMIT:
        options, census = all_options, raw_census
    else:
        options, census = ENGINE._selection_shortlist(
            tape, step_index, run_setting=run_setting
        )
    factors = tuple(options[user] if options[user] else (None,) for user in users)
    rows = [base]
    base_map = base.mapping
    ranked_users = []
    if product_size <= ENGINE.COMPLETE_CATALOGUE_LIMIT:
        for product in itertools.product(*factors):
            candidate_map = dict(zip(users, product, strict=True))
            if candidate_map != base_map:
                rows.append(ENGINE._configuration(base, candidate_map, kind="complete-cartesian"))
        mode = "complete-cartesian"
    else:
        unilaterals = {user: [] for user in users}
        for user in users:
            for action in options[user]:
                if action == base_map[user]:
                    continue
                candidate_map = dict(base_map)
                candidate_map[user] = action
                row = ENGINE._configuration(base, candidate_map, kind="unilateral")
                if row.configuration_id not in configurations:
                    raise RuntimeError(f"catalogue singleton absent from stored physics: {row.configuration_id}")
                rows.append(row)
                unilaterals[user].append(row)
        stored_defaults = [
            stored for stored in configurations.values() if not stored["delta_from_default"]
        ]
        if len(stored_defaults) != 1:
            raise RuntimeError("stored physics does not have exactly one zero-change configuration")
        base_stored = stored_defaults[0]["current"]
        base_bits = float.fromhex(base_stored["whole_network_bits_hex"])
        base_joules = float.fromhex(base_stored["whole_network_joules_hex"])
        best_surplus = {}
        for user in users:
            values = []
            for row in unilaterals[user]:
                stored = configurations[row.configuration_id]["current"]
                core = Fraction(
                    str(float.fromhex(stored["whole_network_bits_hex"]) - base_bits)
                ) - eta * Fraction(
                    str(float.fromhex(stored["whole_network_joules_hex"]) - base_joules)
                )
                core += kappa * ENGINE._phi_for(base, row)
                values.append(core)
            best_surplus[user] = max(values, default=Fraction(-10**30))
        ranked_users = sorted(users, key=lambda user: (-best_surplus[user], user))[
            : ENGINE.PAIRWISE_TOP_K_USERS
        ]
        for proposal_rank in range(ENGINE.TOP_PROPOSALS):
            candidate_map = dict(base_map)
            for user in users:
                if len(unilaterals[user]) > proposal_rank:
                    candidate_map[user] = unilaterals[user][proposal_rank].mapping[user]
            if candidate_map != base_map:
                rows.append(ENGINE._configuration(base, candidate_map, kind="s0-top-two"))
        for first, second in itertools.combinations(ranked_users, 2):
            for first_row in unilaterals[first][: ENGINE.TOP_PROPOSALS]:
                for second_row in unilaterals[second][: ENGINE.TOP_PROPOSALS]:
                    candidate_map = dict(base_map)
                    candidate_map[first] = first_row.mapping[first]
                    candidate_map[second] = second_row.mapping[second]
                    rows.append(
                        ENGINE._configuration(
                            base, candidate_map, kind="pairwise-top10-top2"
                        )
                    )
        for beam in sorted({value for value in base_map.values() if value is not None}):
            candidate_map = dict(base_map)
            affected = [user for user in users if base_map[user] == beam]
            for user in affected:
                candidate_map[user] = next(
                    (action for action in options[user] if action != beam), None
                )
            if candidate_map != base_map:
                rows.append(
                    ENGINE._configuration(base, candidate_map, kind="beam-evacuation")
                )
        mode = "bounded-union-v2"
    unique = {row.assignments: row for row in rows}
    ordered = (base,) + tuple(
        sorted(
            (row for assignments, row in unique.items() if assignments != base.assignments),
            key=lambda row: row.configuration_id,
        )
    )
    if mode != "complete-cartesian" and len(ordered) > ENGINE.CATALOGUE_CAP:
        raise RuntimeError("reconstructed bounded catalogue exceeded declared cap")
    return ordered, {
        **census,
        "complete_cartesian_size": product_size,
        "catalogue_mode": mode,
        "null_action_users": sum(not options[user] for user in users),
        "bounded_catalogue_count": len(ordered),
        "top10_users_by_exact_nominal_unilateral_surplus": ranked_users,
    }


def copy_source_view(record) -> Path:
    source = Path(str(record["source_view_path"]))
    world_index = int(record["world_index"])
    anchor = int(record["global_anchor_index"])
    destination = (
        COMBINED_CORPUS
        / ".staging-separated-v1"
        / f"global-{anchor:03d}"
        / "views"
        / f"world-{world_index}"
        / source.name
    )
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, destination)
    shutil.copyfile(
        source.with_suffix(source.suffix + ".sha256"),
        destination.with_suffix(destination.suffix + ".sha256"),
    )
    verify_sidecar(destination)
    return destination


def assert_snapshot_unchanged(records) -> None:
    for record in records:
        paths = {
            Path(str(record["source_result_path"])): record["source_result_sha256"],
            Path(str(record["source_physics_path"])): record["physics_sha256"],
            Path(str(record["source_view_path"])): record["view_sha256"],
        }
        for path, expected in paths.items():
            if sha256(path) != expected:
                raise RuntimeError(f"snapshotted EXACTGEN2-owned file changed: {path}")


