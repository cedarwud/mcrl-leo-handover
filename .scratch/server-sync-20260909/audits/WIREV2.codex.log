def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(row for row in root.rglob("*") if row.is_file()):
        relative = path.relative_to(root).as_posix().encode("utf-8")
        digest.update(len(relative).to_bytes(8, "big"))
        digest.update(relative)
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def atomic_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(json.dumps(payload, sort_keys=True, indent=2, allow_nan=False).encode())
        handle.write(b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def assert_runtime() -> None:
    if sys.executable != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins are not all one: {bad}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below 15")


def load_pilot():
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    name = f"exact_source_build_pilot_{os.getpid()}"
    spec = importlib.util.spec_from_file_location(name, RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load pilot runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def load_calibration(pilot):
    payload = json.loads(CALIBRATION.read_text())

    def fraction(name: str) -> Fraction:
        numerator, denominator = payload[name]
        return Fraction(numerator, denominator)

    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
        bits_ref=fraction("bits_ref"),
        joules_ref=fraction("joules_ref"),
        users=int(payload["users"]),
    )


def fraction_payload(value: Fraction) -> dict[str, object]:
    return {
        "fraction": [value.numerator, value.denominator],
        "float_hex": float.hex(float(value)),
    }


