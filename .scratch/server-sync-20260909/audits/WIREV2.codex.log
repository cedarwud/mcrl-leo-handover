   135	
   136	def upgrade_q1_state_v2(
   137	    q1_state_v1: Sequence[float],
   138	    *,
   139	    off_axis_angle_rad: float,
   140	    focal_elevation_deg: float,
   141	    null_action: bool,
   142	) -> tuple[float, ...]:
   143	    """Project one learner-normalized v1 vector to learner-normalized v2."""
   144	
   145	    if len(q1_state_v1) != 16:
   146	        raise Q1SchemaV2Error("v1 Q1 state must have exactly 16 slots")
   147	    old = tuple(float(value) for value in q1_state_v1)
   148	    if not all(math.isfinite(value) for value in old):
   149	        raise Q1SchemaV2Error("v1 Q1 state contains a non-finite value")
   150	    angle = float(off_axis_angle_rad)
   151	    elevation = float(focal_elevation_deg)
   152	    if not math.isfinite(angle) or not math.isfinite(elevation):
   153	        raise Q1SchemaV2Error("decision geometry must be finite")
   154	    if null_action:
   155	        if angle != 0.0 or elevation != 0.0:
   156	            raise Q1SchemaV2Error("null action geometry must use the explicit absent-link zeros")
   157	    elif not (0.0 <= angle <= math.pi and -90.0 <= elevation <= 90.0):
   158	        raise Q1SchemaV2Error("non-null decision geometry is outside physical bounds")
   159	
   160	    # Old slots 4 and 12 are excluded. Old slot 6 is replaced, not reused.
   161	    projected = (
   162	        *old[0:4],
   163	        old[5],
   164	        angle,
   165	        elevation / 90.0,
   166	        *old[7:12],
   167	        *old[13:16],
   168	    )
   169	    if len(projected) != len(Q1_V2_FEATURES):
   170	        raise AssertionError("internal v2 projection length drifted")
   171	    return projected
   172	
   173	
   174	def project_row_payload_v2(
   175	    parent_payload: Mapping[str, object],
   176	    *,
   177	    off_axis_angle_rad: float,
   178	    focal_elevation_deg: float,
   179	    geometry_source: str,
   180	) -> dict[str, object]:
   181	    """Create an authenticated v2 row payload from a readable sealed v1 row."""
   182	
   183	    if parent_payload.get("q1_schema_sha256") != Q1_V1_SCHEMA_SHA256:
   184	        raise Q1SchemaV2Error("parent row is not the sealed Q1 v1 schema")
   185	    raw_state = parent_payload.get("q1_state")
   186	    if not isinstance(raw_state, list) or len(raw_state) != 16:
   187	        raise Q1SchemaV2Error("parent q1_state is malformed")
   188	    old = tuple(parse_float_hex(value, field="q1_state") for value in raw_state)
   189	    null_action = parent_payload.get("null_action")
   190	    if type(null_action) is not bool:
   191	        raise Q1SchemaV2Error("parent null_action is not boolean")
   192	    state = upgrade_q1_state_v2(
   193	        old,
   194	        off_axis_angle_rad=off_axis_angle_rad,
   195	        focal_elevation_deg=focal_elevation_deg,
   196	        null_action=null_action,
   197	    )
   198	    if not geometry_source:
   199	        raise Q1SchemaV2Error("geometry source must be named")
   200	
   201	    result = dict(parent_payload)
   202	    result["schema"] = ROW_V2_SCHEMA_VERSION
   203	    result["q1_state"] = [float_hex(value) for value in state]
   204	    result["q1_schema_sha256"] = Q1_V2_SCHEMA_SHA256
   205	    result["q1_v1_parent_row_sha256"] = canonical_sha256(parent_payload)
   206	    result["q1_geometry_source"] = geometry_source
   207	    result["q1_visible_primitives_sha256"] = canonical_sha256(
   208	        {
   209	            "parent_visible_primitives_sha256": parent_payload.get(
   210	                "visible_primitives_sha256"
   211	            ),
   212	            "off_axis_angle_rad_hex": float_hex(off_axis_angle_rad),
   213	            "focal_elevation_deg_hex": float_hex(focal_elevation_deg),
   214	            "geometry_source": geometry_source,
   215	        }
   216	    )
   217	    validate_v2_row_payload(result)
   218	    return result
   219	
   220	
   221	def validate_v2_row_payload(payload: Mapping[str, object]) -> None:
   222	    if payload.get("schema") != ROW_V2_SCHEMA_VERSION:
   223	        raise Q1SchemaV2Error("row schema is not Q1 v2")
   224	    if payload.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256:
   225	        raise Q1SchemaV2Error("row Q1 digest is not Q1 v2")
   226	    state = payload.get("q1_state")
   227	    if not isinstance(state, list) or len(state) != len(Q1_V2_FEATURES):
   228	        raise Q1SchemaV2Error("v2 row state dimension drifted")
   229	    for value in state:
   230	        parse_float_hex(value, field="q1_state")
   231	    for field in ("q1_v1_parent_row_sha256", "q1_visible_primitives_sha256"):
   232	        digest = payload.get(field)
   233	        if (
   234	            not isinstance(digest, str)
   235	            or len(digest) != 64
   410	        except KeyError as error:
   411	            raise Q1SchemaV2Error(
   412	                "non-null row has no decision-time provider geometry"
   413	            ) from error
