)


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def main() -> int:
    sys.dont_write_bytecode = True
    build = load_module("c3_coalition_build_helpers", BUILD_SCRIPT)
    build.enforce_resources()
    if not build.OUTPUT.is_dir() or build.MANIFEST.exists():
        raise RuntimeError("completed shard directory missing or manifest already exists")
    records = build.snapshot_prefix()
    if len(records) != len(TIMINGS):
        raise RuntimeError("frozen prefix/timing inventory disagreement")
    source_hashes_before = {
        str(path): build.sha256(path)
        for path in (build.LOCAL_PILOT, build.SOURCE_PILOT, build.TRAINING_RUNNER)
    }
    sys.path.insert(0, str(build.SOURCE_ROOT / "src"))
    pilot = load_module("c3_coalition_verify_pilot", build.SOURCE_PILOT)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise RuntimeError("pilot fallback flag drifted")
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape
    from mcrl.physics_v025.targets import NetworkOutcome
    from mcrl.stagec_v025.coalitions import read_coalition_shard
    from mcrl.stagec_v025.shards import _row_from_payload

    emitted_sizes = Counter()
    full_sizes = Counter()
    singleton_checks = 0
    float_residual_max = 0.0
    coalition_rows = 0
    physics_digests = set()
    catalogue_counts = []
    anchor_summaries = []
    by_world = {}
    for record in records:
        by_world.setdefault(int(record["world_index"]), []).append(record)
    progress = 0
    for world_index in sorted(by_world):
        world_records = by_world[world_index]
        world_id = str(world_records[0]["world_id"])
        provider = LegacyWorldProvider(role="pilot-source")
        tape = build_world_tape(
            domain=world_id, provider=provider, steps=33, start_time_s=0.0
        )
        run_setting = pilot.ENGINE.run_setting_for("a-r0")
        for record in world_records:
            global_index = int(record["global_anchor_index"])
            step_index = int(record["step_index"])
            carrier = str(record["carrier"])
            (
                _physics_header,
                stored_context,
                configurations,
                _rows_by_user_action,
                authority,
            ) = build.read_anchor_material(record, _row_from_payload)
            if authority["provider_digest"] != tape.protocol.provider_source_digest:
                raise RuntimeError("provider digest drifted during verification")
            if authority["archive_digest"] != pilot._archive_digest(tape):
                raise RuntimeError("archive digest drifted during verification")
            eta = build.fraction(stored_context["calibration"]["eta_ref"])
            kappa = build.fraction(
                stored_context["calibration"]["kappa_bits_per_user_step"]
            )
            base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
            catalogue, census = build.reconstruct_catalogue(
                pilot.ENGINE,
                tape,
                step_index,
                base,
                run_setting,
                configurations,
                eta,
                kappa,
            )
            singles = tuple(row for row in catalogue if row.changed_users == 1)
            joints = tuple(row for row in catalogue if row.changed_users >= 2)
            full_sizes.update(row.changed_users for row in catalogue)
            stored_defaults = [
                stored for stored in configurations.values() if not stored["delta_from_default"]
            ]
            if len(stored_defaults) != 1:
                raise RuntimeError("zero-change physics inventory drifted")
            reference = build.outcome_from_stored(
                stored_defaults[0]["current"],
                stored_defaults[0]["phi_current"],
                NetworkOutcome,
            )
            f0 = reference.bits - eta * reference.joules + kappa * reference.phi
            for singleton in singles:
                stored = configurations[singleton.configuration_id]
                outcome = build.outcome_from_stored(
                    stored["current"], stored["phi_current"], NetworkOutcome
                )
                f1 = outcome.bits - eta * outcome.joules + kappa * outcome.phi
                delta = f1 - f0
                d_user = f1 - f0
                if delta - d_user != 0:
                    raise RuntimeError("singleton Psi is not exactly zero")
                singleton_checks += 1
            c3_path = (
                build.COMBINED_CORPUS
                / ".staging-separated-v1"
                / f"global-{global_index:03d}"
                / "views"
                / f"world-{world_index}"
                / f"COALITION_BUILD-c3-anchor-{global_index:03d}.jsonl"
            )
            shard = read_coalition_shard(c3_path)
            emitted_assignments = set()
            for row in shard.rows:
                selected = {
                    user: (
                        None
                        if action.norad_id is None
                        else (action.norad_id, action.beam_chain_id)
                    )
                    for user, action in row.context.reference_profile
                }
                for member in row.context.members:
                    selected[member.user_id] = (
                        None
                        if member.selected_action.norad_id is None
                        else (
                            member.selected_action.norad_id,
                            member.selected_action.beam_chain_id,
                        )
                    )
                emitted_assignments.add(tuple(sorted(selected.items())))
                emitted_sizes[len(row.context.changed_users)] += 1
                coalition_rows += 1
                physics_digests.add(row.physics_digest)
                float_residual_max = max(
                    float_residual_max,
                    abs(
                        float.fromhex(row.c1_normalized_hex)
                        + float.fromhex(row.psi_normalized_hex)
                        - float.fromhex(row.objective_delta_normalized_hex)
                    ),
                    abs(
                        float.fromhex(row.physical_c1_normalized_hex)
                        + float.fromhex(row.physical_psi_normalized_hex)
                        - float.fromhex(row.physical_delta_normalized_hex)
                    ),
                )
            expected_assignments = {row.assignments for row in joints}
            if emitted_assignments != expected_assignments:
                raise RuntimeError(
                    f"emitted C3 support differs from bounded catalogue at anchor {global_index}"
                )
            if any(row.physics_digest != authority["physics_digest"] for row in shard.rows):
                raise RuntimeError("C3/source physics digest disagreement")
            catalogue_counts.append(len(catalogue))
            anchor_summaries.append(
                {
                    "global_anchor_index": global_index,
                    "world_id": world_id,
                    "anchor_index_within_world": int(record["anchor_index_within_world"]),
                    "step_index": step_index,
                    "carrier": carrier,
                    "catalogue_mode": census["catalogue_mode"],
                    "catalogue_count": len(catalogue),
                    "singleton_count": len(singles),
                    "coalition_count": len(shard.rows),
                    "coalition_size_distribution": dict(
                        sorted(Counter(len(row.context.changed_users) for row in shard.rows).items())
                    ),
                    "joint_evaluation_wall_s": TIMINGS[global_index],
                    "c3_shard": c3_path.relative_to(build.OUTPUT).as_posix(),
                    "c3_sha256": shard.file_sha256,
                }
            )
            progress += 1
            print(f"anchor {progress}/{len(records)} verify global-{global_index:03d}", flush=True)
            print(f"PEAK_RSS_BYTES={build.peak_rss_bytes()}", flush=True)
            if build.peak_rss_bytes() >= 5_000_000_000:
                raise MemoryError("verification peak RSS reached 5 GB")
            if len(build.python_processes()) > 3:
                raise RuntimeError("python-process cap exceeded")
            del configurations, shard
            gc.collect()
        del tape, provider
        gc.collect()

    if len(physics_digests) != 1:
        raise RuntimeError("C3 verification found multiple physics digests")
    build.assert_snapshot_unchanged(records)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise RuntimeError("pilot fallback flag changed")

    # Reload the production runner against its own package tree in a clean module namespace.
    for name in tuple(sys.modules):
        if name == "mcrl" or name.startswith("mcrl."):
            del sys.modules[name]
    sys.path = [entry for entry in sys.path if entry != str(build.SOURCE_ROOT / "src")]
    training_runner = load_module("c3_coalition_production_reader", build.TRAINING_RUNNER)
    reader_started = time.perf_counter()
    loaded, corpus_receipt, feature = training_runner.load_corpus(build.COMBINED_CORPUS)
    reader_wall = time.perf_counter() - reader_started
    if loaded["pairs"]["C1"].physics_digest != loaded["c3"].physics_digest:
        raise RuntimeError("production reader returned mismatched physics digests")
    source_hashes_after = {
        str(path): build.sha256(path)
        for path in (build.LOCAL_PILOT, build.SOURCE_PILOT, build.TRAINING_RUNNER)
    }
