   416	def _upgrade_builder_output_v2(
   417	    result: Mapping[str, object], geometry_lookup: GeometryLookup
   418	) -> dict[str, object]:
   419	    """Upgrade the row portion of either sealed builder result."""
   420	
   421	    parent_rows = result.get("rows")
   422	    if not isinstance(parent_rows, tuple):
   423	        raise Q1SchemaV2Error("builder result has no tuple of source rows")
   424	    upgraded = []
   425	    for row in parent_rows:
   426	        angle, elevation = geometry_lookup(row)
   427	        upgraded.append(
   428	            project_row_payload_v2(
   429	                row.payload(),
   430	                off_axis_angle_rad=angle,
   431	                focal_elevation_deg=elevation,
   432	                geometry_source=(
   433	                    "provider boundary-0 ECEF satellite/cell/user geometry; "
   434	                    "elevation cross-checked against PrimitiveStepArrays"
   435	                ),
   436	            )
   437	        )
   438	    output = dict(result)
   439	    output["rows_v1"] = parent_rows
   440	    output["rows"] = tuple(upgraded)
   441	    output["rows_by_user_action"] = {
   442	        (int(row["user_id"]), (
   443	            None
   444	            if bool(row["null_action"])
   445	            else (int(row["action"]["norad_id"]), int(row["action"]["beam_chain_id"]))
   446	        )): row
   447	        for row in upgraded
   448	    }
   449	    return output
