+"""Fast red-capable parity and defect-path check for the MARGIN_Q copy."""
+
+from dataclasses import fields
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+
+def load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+fixture = load("ceiling30_margin_fixture", REPO / "tests/physics_v025/test_stage4d_gate.py")
+margin = load("ceiling30_margin_batch", HERE / "margin_batch.py")
+from mcrl.physics_v025.batch import evaluate_ar_tdm_catalogue as original
+
+rows = np.asarray(((0, 1, 2), (0, 1, -1), (0, -1, -1)), dtype=np.int64)
+divisor_one = margin.build_evaluator("divisor-one")
+cases = []
+for rho, base_power in ((0.0, 0.01), (0.1, 0.05), (0.8, 0.0001), (0.1, 2.0)):
+    arrays, _ = fixture._three_user_arrays(rho, base_power)
+    for field in ("nominal", "realised"):
+        for boundaries in ((0,), tuple(range(48))):
+            kwargs = {
+                "field": field,
+                "boundary_indices": boundaries,
+                "fading_quantile_alpha": 0.1,
+            }
+            expected = original(arrays, rows, **kwargs)
+            actual = divisor_one(arrays, rows, **kwargs)
+            for descriptor in fields(expected):
+                name = descriptor.name
+                np.testing.assert_array_equal(
+                    getattr(actual, name), getattr(expected, name), err_msg=name
+                )
+            cases.append(
+                {
+                    "rho": rho,
+                    "isolated_target_power_w": base_power,
+                    "field": field,
+                    "boundaries": len(boundaries),
+                    "equal_fields": len(fields(expected)),
+                }
+            )
+
+arrays, _ = fixture._three_user_arrays(0.0, 0.01)
+kwargs = {"field": "realised", "boundary_indices": (0,), "fading_quantile_alpha": 0.1}
+before = original(arrays, rows[:1], **kwargs)
+after = margin.evaluate_ar_tdm_catalogue(arrays, rows[:1], **kwargs)
+assert int(before.transmitted_mode_counts[0, 0]) == 3
+assert int(after.transmitted_mode_counts[0, 0]) == 0
+assert np.all(after.bits > 0.0)
+assert after.max_rf_power_w[0] > before.max_rf_power_w[0]
+
+result = {
+    "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+    "status": "PASS",
+    "divisor_one_bitwise_parity": cases,
+    "uncapped_occupancy_one": {
+        "original_no_mode": int(before.transmitted_mode_counts[0, 0]),
+        "margin_q_no_mode": int(after.transmitted_mode_counts[0, 0]),
+        "original_max_power_w": float(before.max_rf_power_w[0]),
+        "margin_q_max_power_w": float(after.max_rf_power_w[0]),
+        "margin_q_bits": float(after.bits.sum()),
+    },
+}
+output = HERE / "variant-audit.json"
+if output.exists() or output.is_symlink():
+    raise RuntimeError(f"refusing to overwrite completed audit: {output}")
+output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii")
+print(json.dumps({"status": "PASS", "parity_cases": len(cases), "fields_per_case": len(fields(before))}))
