"""Validate the 30-date ceiling receipts and write the diagnostic report."""

from __future__ import annotations

import hashlib
import json
import math
import statistics
from collections import Counter
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
RESULTS = ROOT / ".scratch/oracle-ceiling30/results"
AGGREGATE = ROOT / ".scratch/oracle-ceiling30/ceiling30-aggregate.json"
REPORT = ROOT / "CEILING-30-DATES-2026-09-10.md"

FULL_SPAN = [
    "2025-07-31", "2025-08-18", "2025-09-03", "2025-09-30", "2025-10-17",
    "2025-11-04", "2025-11-20", "2025-12-07", "2025-12-24", "2026-02-20",
    "2026-03-09", "2026-03-27", "2026-04-13", "2026-04-30", "2026-05-16",
    "2026-06-02", "2026-06-29", "2026-07-17", "2026-08-02", "2026-08-20",
]
SINGLE_MONTH = [
    "2026-01-03", "2026-01-04", "2026-01-06", "2026-01-07", "2026-01-09",
    "2026-01-19", "2026-01-21", "2026-01-22", "2026-01-24", "2026-01-25",
]
EXPECTED = set(FULL_SPAN + SINGLE_MONTH)
T_CRIT_975 = {9: 2.2621571627409915, 19: 2.093024054408263, 29: 2.045229642132703}


def canonical_hash(receipt: dict) -> str:
    unsigned = dict(receipt)
    claimed = unsigned.pop("receipt_sha256")
    payload = json.dumps(
        unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")
    actual = hashlib.sha256(payload).hexdigest()
    assert actual == claimed, (receipt.get("tle_date"), claimed, actual)
    return actual


def pct(x: float) -> str:
    return f"{100.0 * x:+.3f}%"


def spread_pct(x: float) -> str:
    return f"{100.0 * x:.3f}%"


def stats(rows: list[dict]) -> dict:
    values = [r["gain"] for r in rows]
    n = len(values)
    mean = statistics.fmean(values)
    sd = statistics.stdev(values)
    se = sd / math.sqrt(n)
    half = T_CRIT_975[n - 1] * se
    lo_i = min(range(n), key=values.__getitem__)
    hi_i = max(range(n), key=values.__getitem__)
    return {
        "n_dates": n,
        "mean": mean,
        "sample_sd": sd,
        "ci95_t": [mean - half, mean + half],
        "min": values[lo_i],
        "min_date": rows[lo_i]["date"],
        "max": values[hi_i],
        "max_date": rows[hi_i]["date"],
    }


def pearson(xs: list[float], ys: list[float]) -> float:
    mx, my = statistics.fmean(xs), statistics.fmean(ys)
    num = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
    den = math.sqrt(sum((x - mx) ** 2 for x in xs) * sum((y - my) ** 2 for y in ys))
    return num / den


def arm_pool(receipts: list[dict], arm: str) -> dict:
    bits = sum(r["summary"]["pooled"][arm]["bits"] for r in receipts)
    joules = sum(r["summary"]["pooled"][arm]["joules"] for r in receipts)
    served = sum(r["summary"]["pooled"][arm]["served_count_sum"] for r in receipts)
    return {"bits": bits, "joules": joules, "ee_bit_per_j": bits / joules, "served_count_sum": served}


def main() -> None:
    files = sorted(RESULTS.glob("date-*.json"))
    receipts = [json.loads(path.read_text(encoding="ascii")) for path in files]
    by_date = {r["tle_date"]: r for r in receipts}
    assert len(receipts) == len(by_date) == 30, (len(receipts), len(by_date))
    assert set(by_date) == EXPECTED, (sorted(EXPECTED - set(by_date)), sorted(set(by_date) - EXPECTED))

    receipt_hashes = {}
    family_aliases: Counter[str] = Counter()
    family_selected: Counter[str] = Counter()
    anchor_total = 0
    qualifying_total = 0
    terminal_total = 0
    oracle_less_served = 0
    oracle_equal_served = 0
    negative_endpoint = 0
    anchor_wall = 0.0
    for receipt in receipts:
        date = receipt["tle_date"]
        receipt_hashes[date] = canonical_hash(receipt)
        assert receipt["claim_ceiling"] == "DIAGNOSTIC_NOT_CLAIM"
        assert receipt["test_split_opened"] is False
        assert receipt["learner_used"] is False
        assert receipt["process_limit"] == 4 and receipt["processes_used"] <= 4
        assert receipt["tape_storage"]["never_used_tmp"] is True
        assert receipt["tape_storage"]["one_date_resident_at_a_time"] is True
        assert receipt["tape_storage"]["released_after_evaluation"] is True
        assert receipt["tape_deleted_after_evaluation"] is True
        expected_panel = "FULL_SPAN" if date in FULL_SPAN else "SINGLE_MONTH_2026_01"
        assert receipt["panel"] == expected_panel
        anchors = receipt["anchors"]
        assert receipt["summary"]["anchor_count"] == len(anchors)
        anchor_total += len(anchors)
        anchor_wall += sum(a["wall_seconds"] for a in anchors)
        for anchor in anchors:
            terminal_total += int(anchor["selection"]["unilateral_terminal_certified"])
            qualifying_total += int(anchor["selection"]["qualifying_coalition_existed"])
            os = anchor["committed"]["ORACLE_SET"]["served_count"]
            us = anchor["committed"]["UNILATERAL"]["served_count"]
            oracle_less_served += int(os < us)
            oracle_equal_served += int(os == us)
            negative_endpoint += int(anchor["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] < 0)
            aliases = anchor["selection"]["selected_candidate_aliases"]
            if aliases:
                family_selected[aliases[0]["family"]] += 1
            for alias in aliases:
                family_aliases[alias["family"]] += 1
    assert terminal_total == anchor_total

    rows = []
    for date in sorted(by_date):
        r = by_date[date]
        s = r["summary"]
        rows.append({
            "date": date,
            "panel": r["panel"],
            "satellites": r["satellite_count_daily_file"],
            "quarantined": r["quarantined_records_daily_file"],
            "anchors": s["anchor_count"],
            "gain": s["oracle_set_over_unilateral_relative"],
            "baseline_served": s["pooled"]["BASELINE"]["served_count_sum"],
            "unilateral_served": s["pooled"]["UNILATERAL"]["served_count_sum"],
            "oracle_served": s["pooled"]["ORACLE_SET"]["served_count_sum"],
            "qualifying": s["qualifying_coalition_anchor_count"],
            "wall_seconds": r["timing"]["total_wall_seconds"],
            "core_hours": r["timing"]["core_hours"],
        })

    full_rows = [r for r in rows if r["date"] in FULL_SPAN]
    month_rows = [r for r in rows if r["date"] in SINGLE_MONTH]
    all_stats, full_stats, month_stats = stats(rows), stats(full_rows), stats(month_rows)
    arms = {arm: arm_pool(receipts, arm) for arm in ("BASELINE", "UNILATERAL", "ORACLE_SET")}
    grand_gain = arms["ORACLE_SET"]["ee_bit_per_j"] / arms["UNILATERAL"]["ee_bit_per_j"] - 1.0
    total_wall = sum(r["timing"]["total_wall_seconds"] for r in receipts)
    total_core = sum(r["timing"]["core_hours"] for r in receipts)
    construction_wall = sum(r["timing"]["construction_wall_seconds"] for r in receipts)
    gain_sat_corr_all = pearson([r["satellites"] for r in rows], [r["gain"] for r in rows])
    gain_sat_corr_full = pearson([r["satellites"] for r in full_rows], [r["gain"] for r in full_rows])

    aggregate = {
        "schema": "mcrl-v025-ceiling30-aggregate-v1",
        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
        "date_level_statistics": {"all_30": all_stats, "full_span_20": full_stats, "single_month_10": month_stats},
        "grand_pooled": {"arms": arms, "oracle_set_over_unilateral_relative": grand_gain},
        "rows": rows,
        "integrity": {
            "receipt_hashes": receipt_hashes,
            "all_unilateral_terminal_certified": terminal_total == anchor_total,
            "anchor_total": anchor_total,
            "qualifying_anchor_total": qualifying_total,
            "negative_committed_gain_anchor_total": negative_endpoint,
            "oracle_less_served_anchor_total": oracle_less_served,
            "oracle_equal_served_anchor_total": oracle_equal_served,
        },
        "timing": {
            "total_wall_seconds": total_wall,
            "total_core_hours": total_core,
            "construction_wall_seconds": construction_wall,
            "anchor_wall_seconds": anchor_wall,
        },
        "descriptive_gain_satellite_pearson_r": {"all_30": gain_sat_corr_all, "full_span_20": gain_sat_corr_full},
        "selected_primary_family_counts": dict(family_selected),
        "selected_alias_family_counts": dict(family_aliases),
    }
    unsigned = json.dumps(aggregate, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False).encode("ascii")
    aggregate["aggregate_sha256"] = hashlib.sha256(unsigned).hexdigest()
    AGGREGATE.write_text(json.dumps(aggregate, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")

    def stat_line(label: str, value: dict) -> str:
        return (
            f"| {label} | {value['n_dates']} | {pct(value['mean'])} | {spread_pct(value['sample_sd'])} | "
            f"[{pct(value['ci95_t'][0])}, {pct(value['ci95_t'][1])}] | "
            f"{pct(value['min'])} ({value['min_date']}) | {pct(value['max'])} ({value['max_date']}) |"
        )

    mean_wall = total_wall / 30.0
    mean_core = total_core / 30.0
    observed_anchor_wall = anchor_wall / anchor_total
    projected_ten_wall = mean_wall * 10.0
    projected_ten_core = mean_core * 10.0
    projected_20_wall = construction_wall + 30.0 * 20.0 * observed_anchor_wall
    projected_20_core = total_core * (projected_20_wall / total_wall)
    early = min(rows, key=lambda r: r["date"])
    late = max(rows, key=lambda r: r["date"])

    lines = [
        f"# Coordination headroom diagnostic across 30 TRAIN dates: mean {pct(all_stats['mean'])}, 95% CI [{pct(all_stats['ci95_t'][0])}, {pct(all_stats['ci95_t'][1])}]",
        "",
        "`DIAGNOSTIC_NOT_CLAIM`",
        "",
        f"Across 30 dates, the arithmetic mean of the per-date pooled ORACLE_SET-over-UNILATERAL gains is **{pct(all_stats['mean'])}** (date-level sample SD **{spread_pct(all_stats['sample_sd'])}**, two-sided 95% Student-t CI **[{pct(all_stats['ci95_t'][0])}, {pct(all_stats['ci95_t'][1])}]**). The date is the independent unit: each date first pools bits and joules across its anchors, computes each arm's pooled bit/J, and then forms the ORACLE_SET/UNILATERAL relative gain. This interval is descriptive over the selected dates, not a population-randomization interval.",
        "",
        "## Result",
        "",
        "| Panel | Dates | Mean gain | Date SD | 95% t CI over dates | Minimum | Maximum |",
        "|---|---:|---:|---:|---:|---:|---:|",
        stat_line("All dates", all_stats),
        stat_line("Full archive span", full_stats),
        stat_line("Single month (January 2026)", month_stats),
        "",
        f"As a separate weighting—not the headline—the ratio after pooling all {anchor_total} anchors across all dates is **{pct(grand_gain)}**. It weights dates by their bits/joules and by the deliberately unequal anchor counts, so it is not used for the date-level CI.",
        "",
        f"The full-span panel runs from {FULL_SPAN[0]} to {FULL_SPAN[-1]}. Satellite count grows from **{early['satellites']:,}** on {early['date']} to **{late['satellites']:,}** on {late['date']}; every selected daily file has zero quarantined records. The descriptive Pearson correlation between date gain and satellite count is **r={gain_sat_corr_all:+.3f}** over all 30 dates and **r={gain_sat_corr_full:+.3f}** within the 20-date full-span panel. These correlations do not separate constellation growth from time-varying geometry and are not causal adjustments; the separate January panel is the cleaner check with much less growth mixing.",
        "",
        "## Every date",
        "",
        "Served counts are sums over that date's anchors and are shown for all three arms. `Q` is the number/share of anchors with at least one qualifying catalogue coalition at the selection boundary.",
        "",
        "| Date | Panel | Satellites | Anchors | Gain | Served B / U / O | Q | Wall min | Core h |",
        "|---|---|---:|---:|---:|---:|---:|---:|---:|",
    ]
    for row in rows:
        panel = "span" if row["panel"] == "FULL_SPAN" else "Jan"
        lines.append(
            f"| {row['date']} | {panel} | {row['satellites']:,} | {row['anchors']} | {pct(row['gain'])} | "
            f"{row['baseline_served']} / {row['unilateral_served']} / {row['oracle_served']} | "
            f"{row['qualifying']}/{row['anchors']} ({100.0*row['qualifying']/row['anchors']:.1f}%) | "
            f"{row['wall_seconds']/60.0:.2f} | {row['core_hours']:.3f} |"
        )

    lines.extend([
        "",
        "No date or anchor was removed for a negative endpoint gain, low service count, slow convergence, or failed catalogue improvement. The table therefore keeps the unfavorable committed endpoints visible inside their date pools.",
        "",
        "## Interpretation boundaries",
        "",
        "UNILATERAL is a deterministic ascending-user cyclic exact single-user best-response run from the carrier anchor. It stops only after a complete pass has no strict improving legal move; there is no deadline. All anchors passed that terminal check. Its endpoint is an **arbitrary path-dependent coordinate-wise local optimum**, not a ceiling and not an upper bound. A qualifying ORACLE_SET result demonstrates only that the selected coordination move was **not reachable by exhaustive single-user best response from the carrier anchor** along this deterministic path.",
        "",
        "ORACLE_SET searches the same bounded, hand-built mechanism catalogue used previously: within-beam occupant subsets of sizes 2–4 (1,024-family cap), a victim plus its top-2 or top-3 positive physical-interference contributors, and complete beam evacuations to a common legal destination, under a 4,096-candidate cap. It is perfect-knowledge only within this catalogue. Therefore the observed ORACLE_SET gain is a **lower bound from this catalogue on coordination headroom**, not a general coordination optimum or upper bound.",
        "",
        f"A qualifying coalition existed on **{qualifying_total}/{anchor_total} anchors ({100.0*qualifying_total/anchor_total:.1f}%)**. At the committed 48-boundary endpoint, ORACLE_SET served fewer users than UNILATERAL on **{oracle_less_served}/{anchor_total}** anchors, the same number on **{oracle_equal_served}/{anchor_total}**, and more on **{anchor_total-oracle_less_served-oracle_equal_served}/{anchor_total}**. There were **{negative_endpoint}/{anchor_total}** negative committed ORACLE_SET-over-UNILATERAL gains; they remain in the pools. The selection-time guard is served count >= BASELINE, not >= UNILATERAL, so the served-count columns and this audit are essential when interpreting gains.",
        "",
        "This diagnostic is learner-free: no training, learned head, checkpoint, or TEST-partition tape was opened. Consequently the contested train/evaluation date-boundary question does not apply to this measurement. All 30 dates are nevertheless from the TRAIN partition, are distinct, and avoid the archive's 17 missing calendar dates.",
        "",
        "## Exact evaluation and provenance",
        "",
        "All three arms use the exact evaluator and corrected causal ACM physics from engine source tree `1728f6b0462f86d85618a4c73f4d1dd2d2c07376`, the tree of engine commit `75c5c78c`. The workspace wrapper commit recorded by the receipts is `36ee19b9c918d9ae1881226b14b37fa54279a499`. Selection uses exact binary64 `F = B - eta_ref E` at realised boundary 0 with `eta_ref = 19,720,681.00172232` bit/J and a 30.08 s held snapshot; committed reporting uses the corrected causal realised endpoint at boundary 48.",
        "",
        f"All **30/30** receipt hashes verified, all **{anchor_total}/{anchor_total}** unilateral endpoints were terminal-certified, every receipt records at most four processes (one coordinator plus three selection workers), and BLAS/OpenMP thread variables were fixed to one. The aggregate JSON is [`.scratch/oracle-ceiling30/ceiling30-aggregate.json`](.scratch/oracle-ceiling30/ceiling30-aggregate.json) with embedded payload SHA-256 `{aggregate['aggregate_sha256']}`; individual signed receipts are in [`.scratch/oracle-ceiling30/results/`](.scratch/oracle-ceiling30/results/). The runner is [`.scratch/oracle-ceiling30/run_oracle_ceiling30.py`](.scratch/oracle-ceiling30/run_oracle_ceiling30.py).",
        "",
        "## Compute cost and deviations",
        "",
        f"The completed 30-date measurement consumed **{total_wall/3600.0:.3f} sequential wall hours** and **{total_core:.3f} core-hours** as summed from the date receipts, including **{construction_wall/60.0:.2f} minutes** of tape construction. Mean cost was **{mean_wall/60.0:.2f} wall minutes/date** and **{mean_core:.3f} core-hours/date**. At this observed mix, ten additional dates project to about **{projected_ten_wall/3600.0:.2f} wall hours** and **{projected_ten_core:.2f} core-hours**. A fresh 30-date run at 20 anchors/date projects mechanically to about **{projected_20_wall/3600.0:.2f} wall hours** and **{projected_20_core:.2f} core-hours**; this is a linear planning extrapolation, not a benchmark guarantee.",
        "",
        f"The 30-date plan and panel membership were fixed before outcome inspection and never changed. The requested date coverage was achieved, but the observed exact-search tails made roughly 20 anchors/date incompatible with the four-hour envelope. The final design has **{anchor_total} anchors**: 10 on 2025-07-31, eight on the next six completed dates, and six on each remaining 23 dates. This lower and unequal within-date density is the main precision limitation; no completed anchor was discarded and the headline gives equal weight to each date.",
        "",
        "The sandbox returned `EROFS` for `/home/sat/bigtmp`, so tape files could not be serialized there. No tape was written to `/tmp`. Instead, each detached tape was built and held in RAM, shared unchanged across the three arms for one date, released before the next date, and recorded as `NOT_SERIALIZED_SANDBOX_EROFS` in every receipt. This changes persistence/audit convenience, not the evaluated tape or arm comparison. Receipt timing excludes aborted sizing/preflight attempts made before the final anchor allocation was frozen.",
        "",
        "## Bottom line",
        "",
        f"The original +6.359% point estimate is now accompanied by a 30-date distribution: **mean {pct(all_stats['mean'])}, 95% CI [{pct(all_stats['ci95_t'][0])}, {pct(all_stats['ci95_t'][1])}]**, with the full-span and single-month panels reported separately above. The result supports catalogue-specific coordination headroom beyond one exact unilateral path; it does not establish a global coordination ceiling.",
        "",
    ])
    REPORT.write_text("\n".join(lines), encoding="utf-8")
    print(REPORT)
    print(json.dumps(aggregate["date_level_statistics"], indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
# Coordination headroom diagnostic across 30 TRAIN dates: mean +5.888%, 95% CI [+5.235%, +6.540%]

`DIAGNOSTIC_NOT_CLAIM`

Across 30 dates, the arithmetic mean of the per-date pooled ORACLE_SET-over-UNILATERAL gains is **+5.888%** (date-level sample SD **1.747%**, two-sided 95% Student-t CI **[+5.235%, +6.540%]**). The date is the independent unit: each date first pools bits and joules across its anchors, computes each arm's pooled bit/J, and then forms the ORACLE_SET/UNILATERAL relative gain. This interval is descriptive over the selected dates, not a population-randomization interval.

