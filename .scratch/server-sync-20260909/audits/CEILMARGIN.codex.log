   714	def _panel_for(date_text: str) -> str:
   715	    if date_text in FULL_SPAN_DATES:
   716	        return "FULL_SPAN"
   717	    if date_text in SINGLE_MONTH_DATES:
   718	        return "SINGLE_MONTH_2026_01"
   719	    raise RuntimeError(f"date is outside the frozen 30-date plan: {date_text}")
