   721	
   722	def run_date(*, date_text: str, anchors_per_date: int, tape_root: Path) -> dict[str, object]:
   723	    from mcrl.env.ephemeris import BlockAlternatingSplit, TRAIN
   724	    from mcrl.env.tle import TleArchive
   725	    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
   726	    import mcrl.physics_v025.tapes as tape_module
   727	
   728	    if date_text not in DATE_PLAN:
   729	        raise RuntimeError(f"date is outside the frozen 30-date plan: {date_text}")
   730	    if not 1 <= anchors_per_date <= 30:
   731	        raise RuntimeError("anchors per date must be in 1..30")
   732	    tle_root = Path("~/demo/tle_data/starlink/tle").expanduser()
   733	    archive = TleArchive(tle_root)
   734	    date = dt.date.fromisoformat(date_text)
   735	    split = BlockAlternatingSplit.for_archive(archive)
   736	    if not archive.has(date) or split.part_for(date) != TRAIN:
   737	        raise RuntimeError(f"planned date is not an available TRAIN date: {date_text}")
   738	
   739	    domain = f"V025_CEILING30/date/{date_text}"
   740	    # The authority's tape builder fails closed to declared domain names.  Add
   741	    # only this diagnostic identity in memory; no source or physics is changed.
   742	    tape_module.PROBE_WORLD_DOMAINS = tuple(tape_module.PROBE_WORLD_DOMAINS) + (domain,)
   743	    start_utc = _date_start(date_text, domain, anchors_per_date)
   744	    provider = LegacyWorldProvider(start_utc=start_utc, steps=anchors_per_date)
   745	    started = time.perf_counter()
   746	    cpu_started = _cpu_seconds()
   747	    build_started = time.perf_counter()
   748	    tape = probe.build_world_tape(
   749	        domain=domain,
   750	        provider=provider,
   751	        steps=anchors_per_date,
   752	        start_time_s=0.0,
   753	    )
   754	    build_wall = time.perf_counter() - build_started
   755	
   756	    tape_path = tape_root / f"mcrl-v025-ceiling30-{date_text}.pickle"
   757	    # This managed workspace exposes /home/sat/bigtmp read-only (EROFS).  Keep
   758	    # the detached tape only in RAM, one date at a time, and never serialize it
   759	    # to the RAM-backed /tmp fallback.  The finally block releases the tape
   760	    # before the next date process starts.
   761	    tape_bytes = 0
   762	    persist_wall = 0.0
   763	
   764	    anchors = []
   765	    global _WORKER_TAPE
   766	    _WORKER_TAPE = tape
   767	    pool_context = None
   768	    try:
   769	        if "fork" not in mp.get_all_start_methods():
   770	            raise RuntimeError("exact parallel selector requires POSIX fork")
   771	        pool_context = mp.get_context("fork").Pool(SELECTION_WORKERS)
   772	        for step_index in range(anchors_per_date):
   773	            row = evaluate_anchor(
   774	                tape=tape,
   775	                date_index=DATE_PLAN.index(date_text) + 1,
   776	                step_index=step_index,
   777	                pool=pool_context,
   778	            )
   779	            anchors.append(row)
   780	            print(
   781	                json.dumps(
   782	                    {
   783	                        "anchor": row["anchor_id"],
   784	                        "unilateral_iterations": row["selection"]["unilateral_iterations"],
   785	                        "joint_candidates": row["selection"]["joint_catalogue_unique"],
   786	                        "qualifying": row["selection"]["qualifying_coalition_existed"],
   787	                        "oracle_ee_gain_pct": (
   788	                            None
   789	                            if row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] is None
   790	                            else 100.0 * row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"]
   791	                        ),
   792	                        "wall_seconds": row["wall_seconds"],
   793	                    },
   794	                    sort_keys=True,
   795	                ),
   796	                flush=True,
   797	            )
   798	    finally:
   799	        if pool_context is not None:
   800	            pool_context.close()
   801	            pool_context.join()
   802	        _WORKER_TAPE = None
   803	        del tape
   804	        gc.collect()
   805	        if tape_path.exists() or tape_path.is_symlink():
   806	            tape_path.unlink()
   807	
   808	    result = {
   809	        "schema": "mcrl-v025-perfect-knowledge-oracle-ceiling-date-v2",
   810	        "claim_ceiling": CLAIM_CEILING,
   811	        "source_commit": _git("rev-parse", "HEAD"),
   812	        "source_tree": _git("rev-parse", "HEAD^{tree}"),
   813	        "probe_source_sha256": hashlib.sha256(PROBE_PATH.read_bytes()).hexdigest(),
   814	        "runner_source_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
   815	        "python": sys.executable,
   816	        "python_version": platform.python_version(),
   817	        "date_index": DATE_PLAN.index(date_text) + 1,
   818	        "panel": _panel_for(date_text),
   819	        "domain": domain,
   820	        "tle_date": date_text,
     1	"""Dense catalogue evaluation for the V0.25 rate-target TDM architecture.
