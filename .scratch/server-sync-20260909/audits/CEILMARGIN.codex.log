    76	
    77	def _evaluate_ar_tdm_catalogue_core(
    78	    arrays: PrimitiveStepArrays,
    79	    selected_rows: np.ndarray,
    80	    *,
    81	    field: str = "realised",
    82	    chunk_size: int = 256,
    83	    rate_target_bps: float = RATE_TARGET_BPS,
    84	    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
    85	    boundary_indices: tuple[int, ...] = tuple(range(48)),
    86	    fading_quantile_alpha: float | None = None,
    87	) -> BatchARResult:
    88	    """Evaluate ``C x U`` selected candidate-row indices without row objects.
    89	
    90	    A row index of ``-1`` is the explicit null action.  The common rational
    91	    TDM partition is an exact refinement of every configuration's scalar slot
    92	    partition, so splitting a constant slot cannot alter rates or energy.
    93	    """
    94	
    95	    rows_all = np.asarray(selected_rows, dtype=np.int64)
    96	    if rows_all.ndim != 2 or rows_all.shape[1] != arrays.users.size:
    97	        raise MCRLContractError("selected_rows must have shape (configurations, users)")
    98	    if field not in {"nominal", "margin", "realised"}:
    99	        raise MCRLContractError("batch field must be nominal, margin, or realised")
   100	    if fading_quantile_alpha is not None and (
   101	        not math.isfinite(fading_quantile_alpha)
   102	        or not 0.0 < fading_quantile_alpha < 1.0
   103	    ):
   104	        raise MCRLContractError("fading quantile alpha must lie strictly in (0,1)")
   105	    if field == "margin" and fading_quantile_alpha is None:
   106	        raise MCRLContractError("margin field requires a fading quantile alpha")
   107	    if (
   108	        not boundary_indices
   109	        or tuple(sorted(set(boundary_indices))) != boundary_indices
   110	        or boundary_indices[0] < 0
   111	        or boundary_indices[-1] >= 48
   112	    ):
   113	        raise MCRLContractError("boundary indices must be unique, ordered, and in 0..47")
   114	    configurations, users = rows_all.shape
   115	    modes = ACM_MODES
   116	    thresholds = np.asarray([row.threshold_linear for row in modes])
   117	    efficiencies = np.asarray([row.spectral_efficiency_bit_per_s_hz for row in modes])
   118	    gamma = np.asarray(
   119	        [0.0]
   120	        + [
   121	            np.nan if rate_target_sinr(rate_target_bps, BEAM_BANDWIDTH_HZ, n) is None
   122	            else float(rate_target_sinr(rate_target_bps, BEAM_BANDWIDTH_HZ, n))
   123	            for n in range(1, users + 1)
   124	        ],
   125	        dtype=np.float64,
   126	    )
   127	    target_mode_index = np.asarray(
   128	        [0]
   129	        + [
   130	            0
   131	            if rate_target_mode(rate_target_bps, BEAM_BANDWIDTH_HZ, n) is None
   132	            else ACM_MODES.index(
   133	                rate_target_mode(rate_target_bps, BEAM_BANDWIDTH_HZ, n)
   134	            )
   135	            + 1
   136	            for n in range(1, users + 1)
   137	        ],
   138	        dtype=np.int64,
   139	    )
   140	    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
   141	    bits = np.zeros((configurations, users), dtype=np.float64)
   142	    decoding = np.zeros_like(bits)
   143	    feasible_all = np.ones((configurations, users), dtype=np.bool_)
   144	    residual_max = np.zeros(configurations, dtype=np.float64)
   145	    components = np.zeros((configurations, 3), dtype=np.float64)
   146	    mode_counts = np.zeros((configurations, len(modes) + 1), dtype=np.int64)
