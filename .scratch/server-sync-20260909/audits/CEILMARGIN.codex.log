@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Compare deterministic receipt payloads for three divisor-one dates."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+SEALED = HERE.parent / "oracle-ceiling30" / "results"
+CONTROL = HERE / "compat-divisor-one"
+OUTPUT = HERE / "divisor-one-receipt-compatibility.json"
+DATES = ("2025-11-04", "2026-01-19", "2026-07-17")
+
+
+def deterministic_projection(reference, candidate, path=()):
+    if path == ():
+        excluded = {"receipt_sha256", "timing"}
+    elif len(path) == 2 and path[0] == "anchors" and isinstance(path[1], int):
+        excluded = {"wall_seconds"}
+    else:
+        excluded = set()
+    if isinstance(reference, dict):
+        return {
+            key: deterministic_projection(value, candidate[key], path + (key,))
+            for key, value in reference.items()
+            if key not in excluded
+        }
+    if isinstance(reference, list):
+        return [
+            deterministic_projection(value, candidate[index], path + (index,))
+            for index, value in enumerate(reference)
+        ]
+    return candidate
+
+
+def canonical_bytes(value) -> bytes:
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+
+
+rows = []
+for date in DATES:
+    reference_path = SEALED / f"date-{date}.json"
+    control_path = CONTROL / f"date-{date}.json"
+    reference = json.loads(reference_path.read_text(encoding="ascii"))
+    control = json.loads(control_path.read_text(encoding="ascii"))
+    reference_projection = deterministic_projection(reference, reference)
+    control_projection = deterministic_projection(reference, control)
+    reference_bytes = canonical_bytes(reference_projection)
+    control_bytes = canonical_bytes(control_projection)
+    rows.append(
+        {
+            "date": date,
+            "anchor_count": reference["summary"]["anchor_count"],
+            "sealed_receipt_sha256": reference["receipt_sha256"],
+            "deterministic_payload_sha256": hashlib.sha256(reference_bytes).hexdigest(),
+            "divisor_one_payload_sha256": hashlib.sha256(control_bytes).hexdigest(),
+            "bit_identical": reference_bytes == control_bytes,
+        }
+    )
+
+result = {
+    "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+    "status": "PASS" if all(row["bit_identical"] for row in rows) else "FAIL",
+    "assertion": "All deterministic receipt fields are canonical-JSON bit-identical under divisor one.",
+    "excluded_non_reproducible_fields": [
+        "receipt_sha256 (covers elapsed-time fields)",
+        "timing",
+        "anchors[*].wall_seconds",
+    ],
+    "dates": rows,
+}
+if OUTPUT.exists() or OUTPUT.is_symlink():
+    raise RuntimeError(f"refusing to overwrite completed compatibility receipt: {OUTPUT}")
+OUTPUT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii")
+print(json.dumps(result, indent=2, sort_keys=True))
+raise SystemExit(0 if result["status"] == "PASS" else 1)

