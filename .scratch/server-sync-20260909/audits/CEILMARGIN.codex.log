   478	def evaluate_anchor(*, tape, date_index: int, step_index: int, pool=None) -> dict[str, object]:
   479	    setting = probe._setting("a-r0")
   480	    run_setting = probe.run_setting_for("a-r0")
   481	    base = probe._base_configuration(tape, step_index, "nearest-eligible")
   482	    selection = ParallelSelectionEvaluator(tape, step_index, base, pool)
   483	    started = time.perf_counter()
   484	    coordinate = coordinate_optimum(
   485	        tape=tape,
   486	        step_index=step_index,
   487	        base=base,
   488	        evaluator=selection,
   489	    )
   490	    unilateral = coordinate.selected
   491	    before_joint_evaluations = selection.physical_evaluations
   492	    candidates, aliases, family_counts = build_joint_candidates(
   493	        tape=tape,
   494	        step_index=step_index,
   495	        base=base,
   496	        unilateral=unilateral,
   497	        best_alternatives=coordinate.best_alternatives,
   498	    )
   499	    selection.evaluate_many(candidates)
   500	    base_profile = selection.evaluate(base)
   501	    unilateral_profile = selection.evaluate(unilateral)
   502	    guard = served(base_profile)
   503	    best = unilateral
   504	    best_profile = unilateral_profile
   505	    for candidate in candidates:
   506	        profile = selection._evaluated.get(candidate.configuration_id)
   507	        if profile is None or served(profile) < guard:
   508	            continue
   509	        value = objective(profile)
   510	        best_value = objective(best_profile)
   511	        if value > best_value or (
   512	            value == best_value
   513	            and best is not unilateral
   514	            and candidate.configuration_id < best.configuration_id
   515	        ):
   516	            best, best_profile = candidate, profile
   517	
   518	    coalition_users = tuple(
   519	        user
   520	        for user in sorted(unilateral.mapping)
   521	        if unilateral.mapping[user] != best.mapping[user]
   522	    )
   523	    psi = Fraction()
   524	    singleton_sum = Fraction()
   525	    if coalition_users:
   526	        for user in coalition_users:
   527	            mapping = unilateral.mapping
   528	            mapping[user] = best.mapping[user]
   529	            singleton = _configuration(base, mapping, "oracle-singleton-component")
   530	            singleton_profile = selection.evaluate(singleton)
   531	            singleton_sum += objective(singleton_profile) - objective(unilateral_profile)
   532	        psi = (
   533	            objective(best_profile)
   534	            - objective(unilateral_profile)
   535	            - singleton_sum
   536	        )
   537	
   538	    committed_counter = probe.EvaluationCounter()
   539	    committed = probe.StepEvaluator(
   540	        tape,
   541	        setting,
   542	        step_index,
   543	        transition_from=base,
   544	        field="realised",
   545	        counter=committed_counter,
   546	        run_setting=run_setting,
   547	        boundary_indices=tuple(range(48)),
   548	        fading_quantile_alpha=0.10,
   549	    )
   550	    unique = {
   551	        row.configuration_id: row for row in (base, unilateral, best)
   552	    }
   553	    committed.evaluate_many(tuple(unique.values()))
   554	
   555	    profiles = {
   556	        "BASELINE": committed.evaluate(base),
   557	        "UNILATERAL": committed.evaluate(unilateral),
   558	        "ORACLE_SET": committed.evaluate(best),
   559	    }
   560	    chosen_aliases = aliases.get(best.assignments, ())
   561	    qualifying = bool(coalition_users) and objective(best_profile) > objective(
   562	        unilateral_profile
   563	    )
   564	    row = {
   565	        "anchor_id": f"V025_CEILING30/date/{tape.tle_date}:step/{step_index}",
   566	        "date_index": date_index,
   567	        "world_domain": tape.domain,
   568	        "world_sha256": tape.digest,
   569	        "tle_date": tape.tle_date,
   570	        "training_seed": tape.training_seed,
   571	        "step_index": step_index,
   572	        "selection": {
   573	            "field": "realised",
   574	            "boundary_indices": [0],
   575	            "held_snapshot_seconds": 30.08,
   576	            "eta_ref": frac_payload(ETA_REF),
   577	            "baseline_served_guard": guard,
   578	            "unilateral_iterations": coordinate.iterations,
   579	            "unilateral_passes": coordinate.passes,
   580	            "unilateral_terminal_certified": True,
   581	            "unilateral_candidate_comparisons": coordinate.candidate_comparisons,
   582	            "joint_catalogue_unique": len(candidates),
   583	            "joint_catalogue_aliases": sum(len(value) for value in aliases.values()),
   584	            "joint_family_unique_counts": family_counts,
   585	            "qualifying_coalition_existed": qualifying,
   586	            "selected_coalition_size": len(coalition_users) if qualifying else 0,
   587	            "selected_coalition_users": list(coalition_users) if qualifying else [],
   588	            "selected_candidate_aliases": list(chosen_aliases) if qualifying else [],
   589	            "selected_joint_served": served(best_profile),
   590	            "selected_joint_F_gain_bits": float(
   591	                objective(best_profile) - objective(unilateral_profile)
   592	            ),
   593	            "selected_singleton_sum_bits": float(singleton_sum),
   594	            "selected_Psi_A_bits": float(psi),
   595	            "selected_Psi_A_exact": frac_payload(psi),
   596	            "unique_selection_configuration_evaluations": selection.physical_evaluations,
   597	            "unilateral_unique_evaluations_before_joint": before_joint_evaluations,
   598	            "new_joint_unique_evaluations": (
   599	                selection.physical_evaluations - before_joint_evaluations
   600	            ),
   601	            "selection_physical_boundary_evaluations": selection.physical_evaluations,
   602	        },
   603	        "committed": {
   604	            name: {
   605	                "configuration_id": profile.config.configuration_id,
   606	                "bits": profile.bits,
   607	                "joules": profile.joules,
   608	                "ee_bit_per_j": ratio(profile.bits, profile.joules),
   609	                "served_count": served(profile),
   610	            }
   611	            for name, profile in profiles.items()
   612	        },
   613	        "committed_unique_configuration_evaluations": len(unique),
   614	        "committed_physical_boundary_evaluations": committed_counter.boundary_evaluations,
   615	        "wall_seconds": time.perf_counter() - started,
   616	    }
   617	    row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] = relative_gain(
   618	        row["committed"]["ORACLE_SET"]["ee_bit_per_j"],
   619	        row["committed"]["UNILATERAL"]["ee_bit_per_j"],
   620	    )
   621	    row["committed"]["UNILATERAL"]["relative_ee_gain_over_BASELINE"] = relative_gain(
   622	        row["committed"]["UNILATERAL"]["ee_bit_per_j"],
   623	        row["committed"]["BASELINE"]["ee_bit_per_j"],
   624	    )
   625	    if served(best_profile) < guard:
   626	        raise RuntimeError("ORACLE_SET violated the literal selection-time service guard")
   627	    if objective(best_profile) < objective(unilateral_profile):
   628	        raise RuntimeError("ORACLE_SET is worse than its included UNILATERAL reference")
   629	    return row
