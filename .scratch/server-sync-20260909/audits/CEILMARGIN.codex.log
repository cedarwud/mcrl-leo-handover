    "anchors": reports,
}
(HERE / "original-reproduction-audit.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
print(json.dumps({key: value for key, value in result.items() if key != "anchors"}))
for row in reports:
    if row["differences"]:
        print(json.dumps(row))
