    68	
    69	def _slot_grid(maximum_occupancy: int) -> tuple[np.ndarray, np.ndarray]:
    70	    boundaries = {0.0, 1.0}
    71	    for occupancy in range(1, maximum_occupancy + 1):
    72	        boundaries.update(index / occupancy for index in range(1, occupancy))
    73	    ordered = np.asarray(sorted(boundaries), dtype=np.float64)
    74	    return (ordered[1:] - ordered[:-1], (ordered[1:] + ordered[:-1]) / 2.0)
