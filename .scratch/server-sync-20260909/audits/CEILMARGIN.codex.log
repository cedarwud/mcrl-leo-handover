   201	def coordinate_optimum(*, tape, step_index: int, base, evaluator) -> CoordinateResult:
   202	    """Deterministic cyclic best responses to a strict local optimum."""
   203	
   204	    options, _ = probe._legal_options(tape, step_index)
   205	    base_profile = evaluator.evaluate(base)
