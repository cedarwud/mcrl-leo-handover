@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Run requested frozen dates sequentially without overwriting receipts."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+HERE = Path(__file__).resolve().parent
+RUNNER = HERE / "run_margin_ceiling30.py"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--formulation", choices=("margin-q", "divisor-one"), required=True)
+    parser.add_argument("--dates", nargs="*")
+    args = parser.parse_args()
+    output = HERE / ("results" if args.formulation == "margin-q" else "compat-divisor-one")
+    env = dict(os.environ)
+    env.update(
+        {
+            "PYTHONPATH": "src",
+            "OMP_NUM_THREADS": "1",
+            "OPENBLAS_NUM_THREADS": "1",
+            "MKL_NUM_THREADS": "1",
+            "NUMEXPR_NUM_THREADS": "1",
+        }
+    )
+    dates = args.dates or [
+        path.stem.removeprefix("date-")
+        for path in sorted((HERE.parent / "oracle-ceiling30" / "results").glob("date-*.json"))
+    ]
+    for date in dates:
+        path = output / f"date-{date}.json"
+        if path.exists():
+            print(json.dumps({"date": date, "status": "SKIP_COMPLETED", "path": str(path)}), flush=True)
+            continue
+        command = [sys.executable, str(RUNNER), "--formulation", args.formulation, "--date", date]
+        print(json.dumps({"date": date, "status": "START", "command": command}), flush=True)
+        subprocess.run(command, cwd=HERE.parents[1], env=env, check=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
