    60	def exact_float(value: float) -> Fraction:
    61	    """Treat the simulator's finite binary64 result as an exact coefficient."""
    62	
    63	    if not math.isfinite(value):
    64	        raise RuntimeError("non-finite physical coefficient")
    65	    return Fraction.from_float(float(value))
    66	
    67	
    68	def objective(profile) -> Fraction:
    69	    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
