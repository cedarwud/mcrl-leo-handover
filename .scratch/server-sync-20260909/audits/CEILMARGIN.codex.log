    84	def relative_gain(numerator: float, denominator: float) -> float | None:
    85	    """Return an anchor-local gain, or None when the reference EE is zero."""
    86	
    87	    if denominator == 0.0:
    88	        return None
    89	    return numerator / denominator - 1.0
