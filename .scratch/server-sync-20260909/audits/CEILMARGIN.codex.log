   638	def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
   639	    selectors = ("BASELINE", "UNILATERAL", "ORACLE_SET")
   640	    pooled = {}
   641	    for name in selectors:
   642	        bits = math.fsum(float(row["committed"][name]["bits"]) for row in anchors)  # type: ignore[index]
   643	        joules = math.fsum(float(row["committed"][name]["joules"]) for row in anchors)  # type: ignore[index]
   644	        pooled[name] = {
   645	            "bits": bits,
   646	            "joules": joules,
   647	            "ee_bit_per_j": ratio(bits, joules),
   648	            "served_count_sum": sum(
   649	                int(row["committed"][name]["served_count"]) for row in anchors  # type: ignore[index]
   650	            ),
   651	        }
   652	    return {
   653	        "anchor_count": len(anchors),
   654	        "world_count": len({str(row["world_domain"]) for row in anchors}),
   655	        "qualifying_coalition_anchor_count": sum(
   656	            bool(row["selection"]["qualifying_coalition_existed"]) for row in anchors  # type: ignore[index]
   657	        ),
   658	        "pooled": pooled,
   659	        "oracle_set_over_unilateral_relative": relative_gain(
   660	            pooled["ORACLE_SET"]["ee_bit_per_j"],
   661	            pooled["UNILATERAL"]["ee_bit_per_j"],
   662	        ),
   663	        "unilateral_over_baseline_relative": relative_gain(
   664	            pooled["UNILATERAL"]["ee_bit_per_j"],
   665	            pooled["BASELINE"]["ee_bit_per_j"],
   666	        ),
   667	        "exact_evaluation_count": {
   668	            "unique_selection_configurations": sum(
   669	                int(row["selection"]["unique_selection_configuration_evaluations"])  # type: ignore[index]
   670	                for row in anchors
   671	            ),
   672	            "selection_boundary_evaluations": sum(
   673	                int(row["selection"]["selection_physical_boundary_evaluations"])  # type: ignore[index]
   674	                for row in anchors
   675	            ),
   676	            "committed_unique_configurations": sum(
   677	                int(row["committed_unique_configuration_evaluations"])
   678	                for row in anchors
   679	            ),
   680	            "committed_boundary_evaluations": sum(
   681	                int(row["committed_physical_boundary_evaluations"])
   682	                for row in anchors
   683	            ),
   684	            "unilateral_candidate_comparisons": sum(
   685	                int(row["selection"]["unilateral_candidate_comparisons"])  # type: ignore[index]
   686	                for row in anchors
   687	            ),
   688	            "joint_unique_candidates": sum(
   689	                int(row["selection"]["joint_catalogue_unique"])  # type: ignore[index]
   690	                for row in anchors
   691	            ),
   692	        },
   693	    }
