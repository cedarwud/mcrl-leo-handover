   146	class ParallelSelectionEvaluator:
   147	    """Persistent fork workers over one detached tape; exact stable reduction."""
   148	
   149	    def __init__(self, tape, step_index: int, base, pool) -> None:
   150	        self.tape = tape
   151	        self.step_index = step_index
   152	        self.base = base
   153	        self.pool = pool
   154	        self._evaluated: dict[str, SelectionMetric] = {}
   155	        self._invalid: set[str] = set()
   156	        self.physical_evaluations = 0
   157	
   158	    def evaluate_many(self, configs: Sequence[object]) -> None:
   159	        missing_by_id = {
   160	            row.configuration_id: row
   161	            for row in configs
   162	            if row.configuration_id not in self._evaluated
   163	            and row.configuration_id not in self._invalid
   164	        }
   165	        missing = tuple(missing_by_id.values())
   166	        if not missing:
   167	            return
   168	        if self.pool is None:
   169	            results = [_selection_worker((self.step_index, self.base, missing))]
   170	        else:
   171	            shards = tuple(
   172	                tuple(missing[index::SELECTION_WORKERS])
   173	                for index in range(SELECTION_WORKERS)
   174	            )
   175	            results = self.pool.map(
   176	                _selection_worker,
   177	                tuple((self.step_index, self.base, shard) for shard in shards),
   178	                chunksize=1,
   179	            )
   180	        unordered = {}
   181	        for rows, invalid, evaluations in results:
   182	            unordered.update((row.config.configuration_id, row) for row in rows)
   183	            self._invalid.update(invalid)
   184	            self.physical_evaluations += evaluations
   185	        for config in missing:
   186	            if config.configuration_id in unordered:
   187	                self._evaluated[config.configuration_id] = unordered[
   188	                    config.configuration_id
   189	                ]
   190	
   191	    def evaluate(self, config) -> SelectionMetric:
   192	        self.evaluate_many((config,))
   193	        try:
   194	            return self._evaluated[config.configuration_id]
   195	        except KeyError:
   196	            raise RuntimeError(
   197	                f"invalid selection configuration {config.configuration_id}"
   198	            ) from None
