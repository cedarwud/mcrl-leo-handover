   318	def _interference_contributors(
   319	    *, tape, step_index: int, current, victim: int
   320	) -> tuple[int, ...]:
   321	    """Rank users by physical nominal interference, never by reward marginal."""
   322	
   323	    mapping = current.mapping
   324	    victim_beam = mapping[victim]
   325	    if victim_beam is None:
   326	        return ()
   327	    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
   328	    step = tape.steps[step_index]
   329	    scores = []
   330	    if step.arrays is not None:
   331	        arrays = step.arrays
   332	        victim_row = arrays._row_index().get((victim, victim_beam))
   333	        aggressor_of = arrays._aggressor_index()
   334	        if victim_row is None:
   335	            return ()
   336	        for user, beam in sorted(mapping.items()):
   337	            if user == victim or beam is None or beam == victim_beam:
   338	                continue
   339	            aggressor_index = aggressor_of.get(beam)
   340	            if aggressor_index is None:
   341	                continue
   342	            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
   343	            score = gain / occupancy[beam]
   344	            if score > 0.0:
   345	                scores.append((score, user))
   346	    else:
   347	        boundary = step.boundary_at(0)
   348	        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
   349	        victim_row = by_key.get((victim, victim_beam))
   350	        if victim_row is None:
   351	            return ()
   352	        cross = dict(victim_row.nominal_cross_gain_by_identity)
   353	        for user, beam in sorted(mapping.items()):
   354	            if user == victim or beam is None or beam == victim_beam:
   355	                continue
   356	            score = cross.get(beam, 0.0) / occupancy[beam]
   357	            if score > 0.0:
   358	                scores.append((score, user))
   359	    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))
