   696	def _cpu_seconds() -> float:
   697	    own = resource.getrusage(resource.RUSAGE_SELF)
   698	    children = resource.getrusage(resource.RUSAGE_CHILDREN)
   699	    return own.ru_utime + own.ru_stime + children.ru_utime + children.ru_stime
