index 0000000000000000000000000000000000000000..3e5d6ac1ad57b798cf104e7e5b9704be980627e2
--- /dev/null
+++ b/.scratch/oracle-ceiling30-margin/report_margin_ceiling30.py
@@ -0,0 +1,349 @@
+#!/usr/bin/env python3
+"""Validate paired CEILING30 receipts and write the MARGIN_Q report."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from pathlib import Path
+import statistics
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+SEALED_RESULTS = HERE.parent / "oracle-ceiling30" / "results"
+MARGIN_RESULTS = HERE / "results"
+COMPATIBILITY = HERE / "divisor-one-receipt-compatibility.json"
+AGGREGATE = HERE / "ceiling30-margin-aggregate.json"
+REPORT = ROOT / "CEILING30-MARGIN-2026-09-10.md"
+T_CRIT_29 = 2.045229642132703
+ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
+
+
+def validate_receipt(receipt: dict) -> str:
+    unsigned = dict(receipt)
+    claimed = unsigned.pop("receipt_sha256")
+    payload = json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+    actual = hashlib.sha256(payload).hexdigest()
+    if actual != claimed:
+        raise RuntimeError(f"receipt hash mismatch on {receipt.get('tle_date')}")
+    return actual
+
+
+def pct(value: float, digits: int = 3) -> str:
+    return f"{100.0 * value:+.{digits}f}%"
+
+
+def share(value: float, digits: int = 2) -> str:
+    return f"{100.0 * value:.{digits}f}%"
+
+
+def date_stats(values: list[float], dates: list[str]) -> dict[str, object]:
+    mean = statistics.fmean(values)
+    sd = statistics.stdev(values)
+    half = T_CRIT_29 * sd / math.sqrt(len(values))
+    lo = min(range(len(values)), key=values.__getitem__)
+    hi = max(range(len(values)), key=values.__getitem__)
+    return {
+        "n_dates": len(values),
+        "mean": mean,
+        "sample_sd": sd,
+        "ci95_t": [mean - half, mean + half],
+        "negative_dates": sum(value < 0.0 for value in values),
+        "zero_dates": sum(value == 0.0 for value in values),
+        "minimum": values[lo],
+        "minimum_date": dates[lo],
+        "maximum": values[hi],
+        "maximum_date": dates[hi],
+    }
+
+
+def ranks(values: list[float]) -> list[float]:
+    order = sorted(range(len(values)), key=values.__getitem__)
+    result = [0.0] * len(values)
+    start = 0
+    while start < len(order):
+        end = start + 1
+        while end < len(order) and values[order[end]] == values[order[start]]:
+            end += 1
+        average_rank = (start + 1 + end) / 2.0
+        for index in order[start:end]:
+            result[index] = average_rank
+        start = end
+    return result
+
+
+def pearson(xs: list[float], ys: list[float]) -> float:
+    xmean = statistics.fmean(xs)
+    ymean = statistics.fmean(ys)
+    numerator = sum((x - xmean) * (y - ymean) for x, y in zip(xs, ys, strict=True))
+    denominator = math.sqrt(
+        sum((x - xmean) ** 2 for x in xs) * sum((y - ymean) ** 2 for y in ys)
+    )
+    return numerator / denominator
+
+
+def triple(values: dict[str, int]) -> str:
+    return " / ".join(f"{int(values[arm]):,}" for arm in ARMS)
+
+
+def diagnostic_triple(diagnostics: dict, key: str, formatter) -> str:
+    return " / ".join(formatter(diagnostics[arm][key]) for arm in ARMS)
+
+
+sealed_paths = sorted(SEALED_RESULTS.glob("date-*.json"))
+margin_paths = sorted(MARGIN_RESULTS.glob("date-*.json"))
+sealed = {row["tle_date"]: row for row in (json.loads(path.read_text()) for path in sealed_paths)}
+margin = {row["tle_date"]: row for row in (json.loads(path.read_text()) for path in margin_paths)}
+if len(sealed) != 30 or set(margin) != set(sealed):
+    raise RuntimeError(f"paired panel incomplete: sealed={len(sealed)}, margin={len(margin)}")
+compatibility = json.loads(COMPATIBILITY.read_text(encoding="ascii"))
+if compatibility["status"] != "PASS" or len(compatibility["dates"]) < 3:
+    raise RuntimeError("divisor-one compatibility gate did not pass on three dates")
+
+rows = []
+sealed_hashes = {}
+margin_hashes = {}
+terminal_count = 0
+anchor_total = 0
+for date in sorted(sealed):
+    old = sealed[date]
+    new = margin[date]
+    sealed_hashes[date] = validate_receipt(old)
+    margin_hashes[date] = validate_receipt(new)
+    if new["variant"] != "MARGIN_Q" or new["claim_ceiling"] != "DIAGNOSTIC_NOT_CLAIM":
+        raise RuntimeError(f"wrong variant or claim label on {date}")
+    for key in ("world_sha256", "training_seed", "start_utc", "tle_date"):
+        if new[key] != old[key]:
+            raise RuntimeError(f"pairing mismatch {date} {key}")
+    if new["summary"]["anchor_count"] != old["summary"]["anchor_count"]:
+        raise RuntimeError(f"anchor count changed on {date}")
+    for anchor in new["anchors"]:
+        terminal_count += int(anchor["selection"]["unilateral_terminal_certified"])
+    anchor_total += int(new["summary"]["anchor_count"])
+    old_gain = float(old["summary"]["oracle_set_over_unilateral_relative"])
+    new_gain = float(new["summary"]["oracle_set_over_unilateral_relative"])
+    old_served = {
+        arm: int(old["summary"]["pooled"][arm]["served_count_sum"]) for arm in ARMS
+    }
+    new_diag = new["summary"]["corrected_diagnostics"]
+    old_diag = new["summary"]["sealed_diagnostics"]
+    if any(old_served[arm] != int(old_diag[arm]["served_count_sum"]) for arm in ARMS):
+        raise RuntimeError(f"sealed diagnostic service mismatch on {date}")
+    if any(
+        int(new["summary"]["pooled"][arm]["served_count_sum"])
+        != int(new_diag[arm]["served_count_sum"])
+        for arm in ARMS
+    ):
+        raise RuntimeError(f"corrected diagnostic service mismatch on {date}")
+    rows.append(
+        {
+            "date": date,
+            "anchors": int(new["summary"]["anchor_count"]),
+            "sealed_gain": old_gain,
+            "margin_q_gain": new_gain,
+            "paired_difference": new_gain - old_gain,
+            "sealed_served": old_served,
+            "margin_q_served": {arm: int(new_diag[arm]["served_count_sum"]) for arm in ARMS},
+            "sealed_rate_target_attained": {
+                arm: int(old_diag[arm]["rate_target_attained_count_sum"]) for arm in ARMS
+            },
+            "margin_q_rate_target_attained": {
+                arm: int(new_diag[arm]["rate_target_attained_count_sum"]) for arm in ARMS
+            },
+            "sealed_diagnostics": old_diag,
+            "margin_q_diagnostics": new_diag,
+        }
+    )
+
+if terminal_count != anchor_total or anchor_total != 196:
+    raise RuntimeError(f"terminal/anchor count mismatch: {terminal_count}/{anchor_total}")
+dates = [row["date"] for row in rows]
+sealed_values = [row["sealed_gain"] for row in rows]
+margin_values = [row["margin_q_gain"] for row in rows]
+differences = [row["paired_difference"] for row in rows]
+sealed_stats = date_stats(sealed_values, dates)
+margin_stats = date_stats(margin_values, dates)
+paired_stats = date_stats(differences, dates)
+spearman = pearson(ranks(sealed_values), ranks(margin_values))
+
+pooled_diagnostics = {}
+for formulation, key in (("SEALED", "sealed_diagnostics"), ("MARGIN_Q", "margin_q_diagnostics")):
+    pooled_diagnostics[formulation] = {}
+    for arm in ARMS:
+        records = [row[key][arm] for row in rows]
+        attempts = sum(int(record["transmission_boundary_attempts"]) for record in records)
+        cap_hits = sum(int(record["rf_cap_binding_attempts"]) for record in records)
+        no_mode = sum(int(record["no_eligible_mode_attempts"]) for record in records)
+        pooled_diagnostics[formulation][arm] = {
+            "served_count": sum(int(record["served_count_sum"]) for record in records),
+            "rate_target_attained_count": sum(
+                int(record["rate_target_attained_count_sum"]) for record in records
+            ),
+            "user_anchor_opportunities": anchor_total * 100,
+            "transmission_boundary_attempts": attempts,
+            "rf_cap_binding_attempts": cap_hits,
+            "rf_cap_binding_attempt_share": cap_hits / attempts,
+            "no_eligible_mode_attempts": no_mode,
+            "no_eligible_mode_attempt_share": no_mode / attempts,
+        }
+
+aggregate = {
+    "schema": "mcrl-v025-ceiling30-margin-q-paired-aggregate-v1",
+    "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+    "anchor_total": anchor_total,
+    "date_as_independent_unit": True,
+    "sealed_statistics": sealed_stats,
+    "margin_q_statistics": margin_stats,
+    "paired_difference_margin_q_minus_sealed_statistics": paired_stats,
+    "spearman_rank_correlation": spearman,
+    "pooled_diagnostics": pooled_diagnostics,
+    "rows": rows,
+    "integrity": {
+        "sealed_receipt_hashes": sealed_hashes,
+        "margin_q_receipt_hashes": margin_hashes,
+        "terminal_certificates": terminal_count,
+        "compatibility_receipt": compatibility,
+    },
+}
+unsigned = json.dumps(
+    aggregate, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+).encode("ascii")
+aggregate["aggregate_sha256"] = hashlib.sha256(unsigned).hexdigest()
+AGGREGATE.write_text(
+    json.dumps(aggregate, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii"
+)
+
+negative_rows = [row for row in rows if row["margin_q_gain"] < 0.0]
+flipped = [row for row in rows if row["sealed_gain"] > 0.0 and row["margin_q_gain"] <= 0.0]
+headline_material = margin_stats["ci95_t"][0] <= 0.005 <= margin_stats["ci95_t"][1]
+lead = (
+    f"Corrected mean gain **{pct(margin_stats['mean'])}**, 95% CI "
+    f"**[{pct(margin_stats['ci95_t'][0])}, {pct(margin_stats['ci95_t'][1])}]**, "
+    f"with **{margin_stats['negative_dates']} negative dates**."
+)
+if headline_material:
+    lead += " The corrected gap is small and its interval includes the project's +0.5% materiality scale."
+
+lines = [
+    lead,
+    "",
+    "`DIAGNOSTIC_NOT_CLAIM`",
+    "",
+    "This is a separate diagnostic evaluation on copied code. No sealed constant, source artefact, frozen manifest, sign, seed, horizon, price, service guard, cap, catalogue rule, or acceptance rule was changed. There was no training run, learner, or policy run.",
+    "",
+    "## Direct answers",
+    "",
+    f"1. **No.** The corrected coordination gap is positive on **{30-len(negative_rows)}/30** dates and negative on **{len(negative_rows)}/30**. "
+    + ("The negative dates are " + ", ".join(f"{row['date']} ({pct(row['margin_q_gain'])})" for row in negative_rows) + "." if negative_rows else "No date is negative."),
+    "",
+    f"2. The date-level mean corrected gain is **{pct(margin_stats['mean'])}** with sample SD **{pct(margin_stats['sample_sd']).replace('+','')}** and a two-sided 95% Student-t interval **[{pct(margin_stats['ci95_t'][0])}, {pct(margin_stats['ci95_t'][1])}]**. The minimum is **{pct(margin_stats['minimum'])}** on {margin_stats['minimum_date']}; the maximum is **{pct(margin_stats['maximum'])}** on {margin_stats['maximum_date']}.",
+    "",
+    f"3. **Yes: {len(flipped)} dates change from favourable under the sealed rule to non-positive under `MARGIN_Q`.** Spearman rank correlation between the two sets of 30 per-date gains is **ρ={spearman:+.3f}**. This reports ordering, not agreement in magnitude.",
+    "",
+    "## Compatibility gate before the panel",
+    "",
+    "Before any corrected date was run, the copied evaluator was compiled with its provisioning divisor set to one and three complete six-anchor dates were rerun. Every deterministic receipt field was canonical-JSON bit-identical to its existing sealed counterpart:",
+    "",
+    "| Date | Anchors | Sealed/control deterministic SHA-256 | Bit-identical |",
+    "|---|---:|---|:---:|",
+]
+for row in compatibility["dates"]:
+    lines.append(
+        f"| {row['date']} | {row['anchor_count']} | `{row['deterministic_payload_sha256']}` | yes |"
+    )
+lines.extend(
+    [
+        "",
+        "The compared payload includes world identity, seed, epoch, search paths and counts, terminal certificates, configuration IDs, committed bits/joules/served counts, and summaries. Only elapsed wall/CPU timing, per-anchor wall time, and the outer receipt hash covering those nondeterministic timing fields were excluded. The compatibility receipt is `.scratch/oracle-ceiling30-margin/divisor-one-receipt-compatibility.json`.",
+        "",
+        "## Date-level paired result",
+        "",
+        "Each date first pools bits and joules over its unchanged anchor set, computes each arm's pooled bit/J, and then forms `ORACLE_SET / UNILATERAL - 1`. Dates—not anchors, users, boundaries, or transmission attempts—are the 30 independent units for the mean and interval.",
+        "",
+        "| Rule | Dates | Mean | Sample SD | Two-sided 95% t interval | Negative | Minimum | Maximum |",
+        "|---|---:|---:|---:|---:|---:|---:|---:|",
+        f"| Sealed | 30 | {pct(sealed_stats['mean'])} | {pct(sealed_stats['sample_sd']).replace('+','')} | [{pct(sealed_stats['ci95_t'][0])}, {pct(sealed_stats['ci95_t'][1])}] | {sealed_stats['negative_dates']} | {pct(sealed_stats['minimum'])} ({sealed_stats['minimum_date']}) | {pct(sealed_stats['maximum'])} ({sealed_stats['maximum_date']}) |",
+        f"| `MARGIN_Q` | 30 | {pct(margin_stats['mean'])} | {pct(margin_stats['sample_sd']).replace('+','')} | [{pct(margin_stats['ci95_t'][0])}, {pct(margin_stats['ci95_t'][1])}] | {margin_stats['negative_dates']} | {pct(margin_stats['minimum'])} ({margin_stats['minimum_date']}) | {pct(margin_stats['maximum'])} ({margin_stats['maximum_date']}) |",
+        f"| Paired difference (`MARGIN_Q` − sealed) | 30 | {pct(paired_stats['mean'])} | {pct(paired_stats['sample_sd']).replace('+','')} | [{pct(paired_stats['ci95_t'][0])}, {pct(paired_stats['ci95_t'][1])}] | {paired_stats['negative_dates']} | {pct(paired_stats['minimum'])} ({paired_stats['minimum_date']}) | {pct(paired_stats['maximum'])} ({paired_stats['maximum_date']}) |",
+        "",
+        "| Date | Anchors | Sealed gain | `MARGIN_Q` gain | Paired difference | Sealed served B/U/O | `MARGIN_Q` served B/U/O | Sealed target-attained B/U/O | `MARGIN_Q` target-attained B/U/O |",
+        "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+    ]
+)
+for row in rows:
+    lines.append(
+        f"| {row['date']} | {row['anchors']} | {pct(row['sealed_gain'])} | {pct(row['margin_q_gain'])} | {pct(row['paired_difference'])} | "
+        f"{triple(row['sealed_served'])} | {triple(row['margin_q_served'])} | "
+        f"{triple(row['sealed_rate_target_attained'])} | {triple(row['margin_q_rate_target_attained'])} |"
+    )
+lines.extend(
+    [
+        "",
+        "`B/U/O` means BASELINE / UNILATERAL / ORACLE_SET. Served means at least some successful decoding in the endpoint; rate-target-attained means the user's integrated bits meet the unchanged per-user target. They are distinct and are not merged.",
+        "",
+        "## Service and boundary-attempt diagnostics",
+        "",
+        "The unit below is one active transmission in one native TDM slot at one evaluated boundary. Because a boundary can contain multiple slots and users, these are transmission-boundary-attempt shares, not a claim that the events are independent. `NO_MODE` means no eligible transmitted ACM mode; cap binding means RF power is within 1e-9 W of the unchanged per-beam cap.",
+        "",
+        "| Rule | Arm | Served / 19,600 | Rate target attained / 19,600 | Cap binds / attempts (share) | `NO_MODE` / attempts (share) |",
+        "|---|---|---:|---:|---:|---:|",
+    ]
+)
+for formulation in ("SEALED", "MARGIN_Q"):
+    for arm in ARMS:
+        item = pooled_diagnostics[formulation][arm]
+        lines.append(
+            f"| {formulation} | {arm} | {item['served_count']:,} / {item['user_anchor_opportunities']:,} | "
+            f"{item['rate_target_attained_count']:,} / {item['user_anchor_opportunities']:,} | "
+            f"{item['rf_cap_binding_attempts']:,} / {item['transmission_boundary_attempts']:,} ({share(item['rf_cap_binding_attempt_share'])}) | "
