   702	def _date_start(date_text: str, domain: str, anchors: int) -> dt.datetime:
   703	    """Choose a deterministic 30.08-s-aligned epoch inside the named UTC day."""
   704	
   705	    date = dt.date.fromisoformat(date_text)
   706	    episode_s = (anchors + 3) * 30.08
   707	    slot_count = int((86_400.0 - episode_s) // 30.08) + 1
   708	    slot = probe.seed_from_domain(domain + "/epoch-slot") % slot_count
   709	    return dt.datetime.combine(date, dt.time(), tzinfo=dt.timezone.utc) + dt.timedelta(
   710	        seconds=slot * 30.08
   711	    )
