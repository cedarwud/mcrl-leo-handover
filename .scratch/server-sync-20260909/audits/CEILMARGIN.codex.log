            if value != new["committed"][name][key]:
                item = {"path": f"committed.{name}.{key}", "reference": value, "current": new["committed"][name][key]}
                differences.append(item)
                committed_mismatches.append({"anchor_id": old["anchor_id"], **item})
    for key, value in old["selection"].items():
        if value != new["selection"][key]:
            item = {"path": f"selection.{key}", "reference": value, "current": new["selection"][key]}
            differences.append(item)
            if key in internal_float_keys:
                max_internal_difference = max(max_internal_difference, abs(value - new["selection"][key]))
            elif key != "selected_Psi_A_exact":
                discrete_mismatches.append({"anchor_id": old["anchor_id"], **item})
    reports.append({"anchor_id": old["anchor_id"], "differences": differences})
result = {
    "status": "PASS" if all(not row["differences"] for row in reports) else "DIFFERENCES",
