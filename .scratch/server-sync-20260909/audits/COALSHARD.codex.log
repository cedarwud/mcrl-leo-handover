   391	def build_coalition_row(
   392	    *,
   393	    context: CoalitionContext,
   394	    reference_outcome: NetworkOutcome,
   395	    unilateral_outcomes: Mapping[int, NetworkOutcome],
   396	    coalition_outcome: NetworkOutcome,
   397	    original_changed_user_count: int | None = None,
   398	    original_changed_users: Sequence[int] | None = None,
   399	    world_id: str,
   400	    world_seed: int,
   401	    anchor_index: int,
   402	    decision_time_utc: str,
   403	    decision_time_ns: int,
   404	    setting_id: str,
   405	    lambda_bits_per_j: float,
   406	    eta_ref_bits_per_j: float,
   407	    kappa_normalization_bits: float,
   408	    code_digest: str,
   409	    physics_digest: str,
   410	    catalogue_digest: str,
   411	    setting_digest: str,
   412	    calibration_digest: str,
   413	    allocation_manifest_digest: str,
   414	) -> CoalitionRow:
   415	    """Production B4/B5 builder from nominal counterfactual outcomes."""
   416	
   417	    identity = coalition_identity(
   418	        coalition_users=context.changed_users,
   419	        reference=reference_outcome,
   420	        unilateral_by_user=unilateral_outcomes,
   421	        coalition=coalition_outcome,
   422	        lambda_bits_per_j=lambda_bits_per_j,
   423	        eta_ref=eta_ref_bits_per_j,
   424	        kappa_bits_per_user_s=kappa_normalization_bits,
   425	    )
   426	    kappa = Fraction(str(kappa_normalization_bits))
   427	    original_users = (
   428	        context.changed_users
   429	        if original_changed_users is None
   430	        else tuple(sorted(int(user) for user in original_changed_users))
   431	    )
   432	    original_count = len(original_users) if original_changed_user_count is None else original_changed_user_count
   433	    if original_count != len(original_users):
   434	        raise StageCContractError("original changed-user count requires the complete user inventory")
   435	    decomposition = dict(capped_coalition_decomposition(original_users))
   436	    if context.changed_users not in decomposition:
   437	        raise StageCContractError("coalition context is absent from the sealed capped decomposition")
   438	    return CoalitionRow(
   439	        schema=COALITION_ROW_SCHEMA,
   440	        split="TRAIN",
