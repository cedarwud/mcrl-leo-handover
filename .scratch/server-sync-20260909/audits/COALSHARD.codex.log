   508	def exact_shapley_reporting_credit(
   509	    *,
   510	    coalition_users: Sequence[int],
   511	    subset_values: Mapping[frozenset[int], float],
   512	    roster: Sequence[int],
   513	) -> dict[int, float]:
   514	    """Exact reporting-only Shapley allocation for a coalition of at most four."""
   515	
   516	    users = tuple(sorted(coalition_users))
   517	    complete_roster = tuple(roster)
   518	    if not 2 <= len(users) <= MAX_LABEL_COALITION_SIZE or len(set(users)) != len(users):
   519	        raise StageCContractError("exact Shapley reporting requires 2..4 unique users")
   520	    if not set(users) <= set(complete_roster):
   521	        raise StageCContractError("Shapley coalition users must be in the roster")
   522	    expected = {
   523	        frozenset(user for index, user in enumerate(users) if mask & (1 << index))
   524	        for mask in range(1 << len(users))
   525	    }
   526	    if set(subset_values) != expected:
   527	        raise StageCContractError("exact Shapley reporting requires every subset value")
   528	    factorial = math.factorial
   529	    count = len(users)
   530	    credit = {user: 0.0 for user in complete_roster}
   531	    for user in users:
   532	        others = tuple(candidate for candidate in users if candidate != user)
   533	        for mask in range(1 << len(others)):
   534	            subset = frozenset(
   535	                candidate for index, candidate in enumerate(others) if mask & (1 << index)
   536	            )
   537	            weight = (
   538	                factorial(len(subset))
   539	                * factorial(count - len(subset) - 1)
   540	                / factorial(count)
