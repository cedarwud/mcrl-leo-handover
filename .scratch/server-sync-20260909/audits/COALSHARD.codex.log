   493	def pair_reporting_credit(
   494	    *, psi_normalized: float, coalition_users: Sequence[int], roster: Sequence[int]
   495	) -> dict[int, float]:
   496	    """B5 reporting-only equal pair credit, with explicit dummy-user zeros."""
   497	
   498	    users = tuple(coalition_users)
   499	    complete_roster = tuple(roster)
   500	    if len(users) != 2 or len(set(users)) != 2 or not set(users) <= set(complete_roster):
   501	        raise StageCContractError("pair reporting credit requires two roster members")
   502	    return {
   503	        user: float(psi_normalized) / 2.0 if user in users else 0.0
   504	        for user in complete_roster
   505	    }
