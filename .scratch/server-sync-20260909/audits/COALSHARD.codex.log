   442	        world_seed=world_seed,
   443	        learner_seed=None,
   444	        anchor_id=context.anchor_id,
   445	        anchor_index=anchor_index,
   446	        decision_time_utc=decision_time_utc,
   447	        decision_time_ns=decision_time_ns,
