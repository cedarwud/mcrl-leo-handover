   482	def capped_coalition_decomposition(
   483	    changed_users: Sequence[int],
   484	) -> tuple[tuple[tuple[int, ...], float], ...]:
   485	    """v1.2 rule: one uncapped row for the actual selected coalition."""
   486	
   487	    users = tuple(sorted(int(user) for user in changed_users))
   488	    if len(set(users)) != len(users) or len(users) < 2:
   489	        raise StageCContractError("capped decomposition requires unique changed users")
   490	    return ((users, 1.0),)
