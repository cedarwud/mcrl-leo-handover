   285	@dataclass(frozen=True, slots=True)
   286	class CoalitionRow:
   287	    schema: str
   288	    split: str
   289	    world_id: str
   290	    world_seed: int
   291	    learner_seed: int | None
   292	    anchor_id: str
   293	    anchor_index: int
   294	    decision_time_utc: str
   295	    decision_time_ns: int
   296	    setting_id: str
   297	    context: CoalitionContext
   298	    original_changed_user_count: int
   299	    capped_decomposition: bool
   300	    original_changed_users: tuple[int, ...]
   301	    decomposition_id: str
   302	    decomposition_weight_hex: str
   303	    lambda_bits_per_j_hex: str
   304	    eta_ref_bits_per_j_hex: str
   305	    kappa_normalization_bits_hex: str
   306	    c1_normalized_hex: str
   307	    psi_normalized_hex: str
   308	    objective_delta_normalized_hex: str
   309	    physical_c1_normalized_hex: str
   310	    physical_psi_normalized_hex: str
   311	    physical_delta_normalized_hex: str
   312	    code_digest: str
   313	    physics_digest: str
   314	    catalogue_digest: str
   315	    setting_digest: str
   316	    calibration_digest: str
   317	    allocation_manifest_digest: str
   318	    credit_split: str
   319	
   320	    def __post_init__(self) -> None:
   321	        if self.schema != COALITION_ROW_SCHEMA or self.split != "TRAIN":
   322	            raise StageCContractError("C3 coalition rows are versioned TRAIN rows")
   323	        size = len(self.context.members)
   324	        if size < 2:
   325	            raise StageCContractError("trainable C3 rows require coalition size >=2")
   326	        if self.original_changed_user_count != size or self.capped_decomposition:
   327	            raise StageCContractError("v1.2 selected-coalition interaction labels are uncapped")
   328	        if self.original_changed_user_count != len(self.original_changed_users):
   329	            raise StageCContractError("larger-set original user inventory is incomplete")
   330	        if self.context.changed_users != self.original_changed_users:
   331	            raise StageCContractError("uncapped row must carry the actual selected user set")
   332	        weight = parse_float_hex(self.decomposition_weight_hex, field="decomposition_weight")
   333	        if not self.decomposition_id or weight <= 0.0 or weight > 1.0:
   334	            raise StageCContractError("capped decomposition identity/weight is invalid")
   335	        expected = capped_coalition_decomposition(self.original_changed_users)
   336	        expected_weights = {users: value for users, value in expected}
   337	        if expected_weights.get(self.context.changed_users) != weight:
   338	            raise StageCContractError("capped decomposition subset or row weight drifted")
   339	        expected_id = canonical_sha256({
   340	            "schema": "mcrl-v025-stagec-capped-coalition-decomposition-v1",
   341	            "original_changed_users": list(self.original_changed_users),
   342	            "subsets": [list(users) for users, _ in expected],
   343	        })
   344	        if self.decomposition_id != expected_id:
   345	            raise StageCContractError("capped decomposition digest drifted")
   346	        expected_credit = (
   347	            "EXACT_SHAPLEY_SMALL_SET"
   348	            if size <= MAX_LABEL_COALITION_SIZE
   349	            else "NOT_COMPUTED_LARGE_SET"
   350	        )
   351	        if self.credit_split != expected_credit:
   352	            raise StageCContractError("credit split disagrees with reporting-only Shapley cap")
   353	        for field in (
   354	            "code_digest",
   355	            "physics_digest",
   356	            "catalogue_digest",
   357	            "setting_digest",
   358	            "calibration_digest",
   359	            "allocation_manifest_digest",
   360	        ):
   361	            digest = getattr(self, field)
   362	            if len(digest) != 64 or any(character not in "0123456789abcdef" for character in digest):
   363	                raise StageCContractError(f"C3 {field} must be a lowercase SHA-256")
   364	        kappa = parse_float_hex(self.kappa_normalization_bits_hex, field="kappa")
   365	        lambda_bits = parse_float_hex(self.lambda_bits_per_j_hex, field="lambda")
   366	        eta_ref = parse_float_hex(self.eta_ref_bits_per_j_hex, field="eta_ref")
   367	        if kappa <= 0.0 or lambda_bits <= 0.0 or lambda_bits != eta_ref:
   368	            raise StageCContractError("C3 row prices must be positive and lambda=eta_ref")
   369	        c1 = parse_float_hex(self.c1_normalized_hex, field="c1")
   370	        psi = parse_float_hex(self.psi_normalized_hex, field="psi")
   371	        delta = parse_float_hex(self.objective_delta_normalized_hex, field="objective_delta")
   372	        pc1 = parse_float_hex(self.physical_c1_normalized_hex, field="physical_c1")
   373	        ppsi = parse_float_hex(self.physical_psi_normalized_hex, field="physical_psi")
   374	        pdelta = parse_float_hex(self.physical_delta_normalized_hex, field="physical_delta")
   375	        if not math.isclose(c1 + psi, delta, rel_tol=0.0, abs_tol=1e-12) or not math.isclose(
   376	            pc1 + ppsi, pdelta, rel_tol=0.0, abs_tol=1e-12
   377	        ):
   378	            raise StageCContractError("C3 row reconstruction identity drifted")
   379	
   380	    def payload(self) -> dict[str, object]:
   381	        value = asdict(self)
   382	        value["context"] = self.context.payload()
   383	        return value
