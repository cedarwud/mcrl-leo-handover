   543	@dataclass(frozen=True, slots=True)
   544	class CoalitionBatch:
   545	    """Typed C3 scalar batch over complete set-conditioned contexts."""
   546	
   547	    contexts: tuple[CoalitionContext, ...]
   548	    invariant_states: np.ndarray
   549	    target_psi: np.ndarray
   550	    row_identities: tuple[str, ...]
   551	    source_authority_sha256: str
   552	    source_identity: str
   553	    physics_digest: str
   554	    member_width: int
   555	    digest: str
   556	
   557	    @classmethod
   558	    def create(
   559	        cls,
   560	        shards: Sequence[CoalitionShard],
   561	        *,
   562	        source_identity: str = "informed",
   563	        target_override: Sequence[float] | None = None,
   564	    ) -> "CoalitionBatch":
   565	        rows = tuple(row for shard in shards for row in shard.rows)
   566	        if not rows:
   567	            raise StageCContractError("C3 coalition batch cannot be empty")
   568	        physics = {row.physics_digest for row in rows}
   569	        if len(physics) != 1:
   570	            raise StageCContractError("C3 coalition shards mix physics digests")
   571	        physics_digest = next(iter(physics))
   572	        widths = {len(member.invariant_features) for row in rows for member in row.context.members}
   573	        if len(widths) != 1:
   574	            raise StageCContractError("C3 coalition member width drifted")
   575	        member_width = next(iter(widths))
   576	        contexts = tuple(row.context for row in rows)
   577	        states = np.stack(
   578	            [context.invariant_vector(member_width=member_width) for context in contexts]
   579	        )
   580	        targets = np.asarray(
   581	            [
   582	                parse_float_hex(row.psi_normalized_hex, field="psi_normalized")
   583	                for row in rows
   584	            ]
   585	            if target_override is None
   586	            else target_override,
   587	            dtype=np.float64,
   588	        )
   589	        if targets.shape != (len(rows),) or not np.isfinite(targets).all():
   590	            raise StageCContractError("C3 scalar target shape drifted")
   591	        identities = tuple(
   592	            f"{row.world_id}|{row.anchor_id}|{','.join(map(str, row.context.changed_users))}"
   593	            for row in rows
   594	        )
   595	        authority = canonical_sha256(
   596	            {
   597	                "schema": "mcrl-v025-stagec-c3-source-authority-v1",
   598	                "shards": [shard.file_sha256 for shard in shards],
   599	                "row_schemas": sorted({row.schema for row in rows}),
   600	                "catalogues": sorted({row.catalogue_digest for row in rows}),
   601	                "physics": sorted({row.physics_digest for row in rows}),
   602	            }
   603	        )
   604	        payload = {
   605	            "schema": "mcrl-v025-stagec-c3-coalition-batch-v2",
   606	            "source_identity": source_identity,
   607	            "shape": list(states.shape),
   608	            "states": [[float_hex(value) for value in row] for row in states],
   609	            "targets": [float_hex(value) for value in targets],
   610	            "row_identities": list(identities),
   611	            "source_authority_sha256": authority,
   612	            "anchored_zero_empty_and_singleton": True,
   613	            "physics_digest": physics_digest,
   614	            "permutation_invariant": True,
   615	            "context_schemas": sorted({
   616	                context.payload()["context_schema"] for context in contexts
   617	            }),
   618	            "pairwise_cross_gain_top_k": contexts[0].payload()[
   619	                "pairwise_cross_gain_top_k"
   620	            ],
   280	        if not np.isfinite(vector).all():
   281	            raise StageCContractError("coalition invariant encoding is non-finite")
   282	        return vector
