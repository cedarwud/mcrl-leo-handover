for r in rows: by_anchor[(r['world_id'],r['anchor_id'])].append(r)
assert len(by_anchor)==180 and all(len(v)==1 for v in by_anchor.values())
print('PASS: 180 TRAIN rows; histogram {2: 180}; 108 positive; one coalition and one size at each of 180 anchors')
