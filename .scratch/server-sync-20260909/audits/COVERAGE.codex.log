   386	def build_coalition_row(
   387	    *,
   388	    context: CoalitionContext,
   389	    reference_outcome: NetworkOutcome,
   390	    unilateral_outcomes: Mapping[int, NetworkOutcome],
   391	    coalition_outcome: NetworkOutcome,
   392	    original_changed_user_count: int | None = None,
   393	    original_changed_users: Sequence[int] | None = None,
   394	    world_id: str,
   395	    world_seed: int,
   396	    anchor_index: int,
   397	    decision_time_utc: str,
   398	    decision_time_ns: int,
   399	    setting_id: str,
   400	    lambda_bits_per_j: float,
   401	    eta_ref_bits_per_j: float,
   402	    kappa_normalization_bits: float,
   403	    code_digest: str,
   404	    physics_digest: str,
   405	    catalogue_digest: str,
   406	    setting_digest: str,
   407	    calibration_digest: str,
   408	    allocation_manifest_digest: str,
   409	) -> CoalitionRow:
   410	    """Production B4/B5 builder from nominal counterfactual outcomes."""
   411	
   412	    identity = coalition_identity(
   413	        coalition_users=context.changed_users,
   414	        reference=reference_outcome,
   415	        unilateral_by_user=unilateral_outcomes,
   416	        coalition=coalition_outcome,
   417	        lambda_bits_per_j=lambda_bits_per_j,
   418	        eta_ref=eta_ref_bits_per_j,
   419	        kappa_bits_per_user_s=kappa_normalization_bits,
   420	    )
   421	    kappa = Fraction(str(kappa_normalization_bits))
   422	    original_users = (
   423	        context.changed_users
   424	        if original_changed_users is None
   425	        else tuple(sorted(int(user) for user in original_changed_users))
   426	    )
   427	    original_count = len(original_users) if original_changed_user_count is None else original_changed_user_count
   428	    if original_count != len(original_users):
   429	        raise StageCContractError("original changed-user count requires the complete user inventory")
   430	    decomposition = dict(capped_coalition_decomposition(original_users))
   431	    if context.changed_users not in decomposition:
   432	        raise StageCContractError("coalition context is absent from the sealed capped decomposition")
   433	    return CoalitionRow(
   434	        schema=COALITION_ROW_SCHEMA,
   435	        split="TRAIN",
   436	        world_id=world_id,
   437	        world_seed=world_seed,
   438	        learner_seed=None,
   439	        anchor_id=context.anchor_id,
   440	        anchor_index=anchor_index,
   441	        decision_time_utc=decision_time_utc,
   442	        decision_time_ns=decision_time_ns,
   443	        setting_id=setting_id,
   444	        context=context,
   445	        original_changed_user_count=original_count,
   446	        capped_decomposition=False,
   447	        original_changed_users=original_users,
   448	        decomposition_id=canonical_sha256({
   449	            "schema": "mcrl-v025-stagec-capped-coalition-decomposition-v1",
   450	            "original_changed_users": list(original_users),
   451	            "subsets": [list(users) for users, _ in capped_coalition_decomposition(original_users)],
   452	        }),
   453	        decomposition_weight_hex=float_hex(decomposition[context.changed_users]),
   454	        lambda_bits_per_j_hex=float_hex(lambda_bits_per_j),
   455	        eta_ref_bits_per_j_hex=float_hex(eta_ref_bits_per_j),
   456	        kappa_normalization_bits_hex=float_hex(kappa_normalization_bits),
   457	        c1_normalized_hex=float_hex(float(identity.c1 / kappa)),
   458	        psi_normalized_hex=float_hex(float(identity.c3 / kappa)),
   459	        objective_delta_normalized_hex=float_hex(float(identity.objective_delta / kappa)),
   460	        physical_c1_normalized_hex=float_hex(float(identity.physical_c1 / kappa)),
   461	        physical_psi_normalized_hex=float_hex(float(identity.physical_c3 / kappa)),
   462	        physical_delta_normalized_hex=float_hex(float(identity.physical_delta / kappa)),
   463	        code_digest=code_digest,
   464	        physics_digest=physics_digest,
   465	        catalogue_digest=catalogue_digest,
   466	        setting_digest=setting_digest,
   467	        calibration_digest=calibration_digest,
   468	        allocation_manifest_digest=allocation_manifest_digest,
   469	        credit_split=(
   470	            "EXACT_SHAPLEY_SMALL_SET"
   471	            if len(context.members) <= MAX_LABEL_COALITION_SIZE
   472	            else "NOT_COMPUTED_LARGE_SET"
   473	        ),
   474	    )
