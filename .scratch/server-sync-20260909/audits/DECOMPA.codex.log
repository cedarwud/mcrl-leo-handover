   752	        if deadline_s <= 0.0:
   753	            raise StageCContractError("selector deadline must be positive")
   754	        context = multiprocessing.get_context("fork")
   755	        parent, child = context.Pipe(duplex=False)
   756	
   757	        def work() -> None:
   758	            try:
   759	                child.send(("ok", self.select(**kwargs)))
   760	            except BaseException as error:
   761	                child.send(("error", type(error).__name__))
