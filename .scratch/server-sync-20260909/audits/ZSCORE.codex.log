index 0000000000000000000000000000000000000000..af67a8e0dda5ebe38d4d362b8a745892eaff7213
--- /dev/null
+++ b/zscore_view.py
@@ -0,0 +1,111 @@
+"""Versioned raw-plus-cross-user-z view schemas for the repaired Stage-C corpus.
+
+This is a representation-only successor.  For one decision anchor and one
+candidate action identity, each learner-normalized feature is standardized over
+the users for whom that action is present.  The original vector remains the
+first block and the population z-score is appended as the second block.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Sequence
+
+
+Q1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v2z"
+Q2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1z"
+Q1_PARENT_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v2"
+Q2_PARENT_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"
+ENCODER_NAME = "MCRL_V025_STAGEC_Q1_V2_Q2_V1_RAW_PLUS_LIVE_USER_Z"
+POPULATION_RULE = (
+    "within each decision anchor and candidate action identity, over the users "
+    "for whom that action is present; population standard deviation (ddof=0)"
+)
+ZERO_SIGMA_RULE = (
+    "emit exact +0.0: every centered numerator in an exactly constant "
+    "population is zero, so zero is the finite limit and carries no false "
+    "within-population contrast"
+)
+
+
+def canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+
+
+def canonical_sha256(value: object) -> str:
+    return hashlib.sha256(canonical_bytes(value)).hexdigest()
+
+
+def _feature_payload(features: Sequence[object]) -> list[dict[str, object]]:
+    raw = [
+        {
+            "name": f"raw__{feature.name}",
+            "source_name": feature.name,
+            "unit": feature.unit,
+            "scale_hex": float(feature.scale).hex(),
+            "block": "raw",
+        }
+        for feature in features
+    ]
+    z = [
+        {
+            "name": f"z__{feature.name}",
+            "source_name": feature.name,
+            "unit": "population standard deviation",
+            "scale_hex": float(1.0).hex(),
+            "block": "cross_user_z",
+        }
+        for feature in features
+    ]
+    return raw + z
+
+
+def schema(
+    *,
+    version: str,
+    parent_version: str,
+    parent_sha256: str,
+    features: Sequence[object],
+) -> dict[str, object]:
+    return {
+        "schema": version,
+        "successor_of": {"schema": parent_version, "sha256": parent_sha256},
+        "encoder_variant": ENCODER_NAME,
+        "shape": [2 * len(features)],
+        "layout": "concatenate([raw_learner_normalized, live_cross_user_z])",
+        "features": _feature_payload(features),
+        "cross_user_population": POPULATION_RULE,
+        "sigma": "population standard deviation in float64 (ddof=0)",
+        "sigma_zero": ZERO_SIGMA_RULE,
+        "decision_time_only": True,
+        "decision_owner": "the unchanged learned heads and their masked argmax",
+        "physics_reexecuted": False,
+        "provenance_note": (
+            "view-only successor projected from authenticated Q1-v2/Q2-v1 "
+            "rows; raw values are preserved byte-for-value before the appended z block"
+        ),
+    }
+
+
+def schemas(q1_features: Sequence[object], q1_sha256: str, q2_variant: object):
+    q1 = schema(
+        version=Q1_SCHEMA_VERSION,
+        parent_version=Q1_PARENT_SCHEMA_VERSION,
+        parent_sha256=q1_sha256,
+        features=q1_features,
+    )
+    q2 = schema(
+        version=Q2_SCHEMA_VERSION,
+        parent_version=Q2_PARENT_SCHEMA_VERSION,
+        parent_sha256=q2_variant.q2_schema_sha256,
+        features=q2_variant.q2_features,
+    )
+    return q1, q2, canonical_sha256(q1), canonical_sha256(q2)
+

