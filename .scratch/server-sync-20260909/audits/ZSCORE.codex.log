"""Per-user input standardization for the shared-Q isolation test (pure numpy, no RNG, no torch).

`zscore_over_users` is THE single transformation of this experiment: given the augmented per-user input
`aug` (U, 224) it standardizes EACH of the 224 features ACROSS the user axis (axis 0), so every feature has
mean 0 / unit spread over the 100 users AT THAT STEP. This removes the few large-magnitude shared/global
features that dominate the raw user-row correlation (~0.96) and exposes the (present but scale-dominated)
per-user signal (corr -> ~0), which is the whole hypothesis.

The transform is applied at the SAME place in train, replay, TD-target and eval (via the trainer's
`_encode_aug` hook + the eval value_fn), so there is no train/eval skew. For the injection pool (arm B,
IS-cat) the same per-step transform is applied to the pool's (N, U, 224) bundles at load time
(`standardize_pool_arrays`) because the pool retains the per-step (U, ...) snapshot structure -> the
per-step z-score over users is the byte-identical operation.
"""

from __future__ import annotations

from typing import Any

import numpy as np

DEFAULT_EPS = 1e-6


def zscore_over_users(aug: np.ndarray, eps: float = DEFAULT_EPS) -> np.ndarray:
    """Per-feature standardization ACROSS the user axis (axis 0): (aug - mean_u) / (std_u + eps).

    aug: (U, F) per-user input for ONE step (F = 224 for the augmented encoding). The 100 users are the
    replicates; each of the F features is centred and scaled over them.

    Returns float32, shape-preserving (U, F). eps regularizes NEAR-CONSTANT features: a feature that is
    (nearly) identical across all users has std ~= 0, so (aug - mean) ~= 0 and the eps in the denominator
    keeps the ratio finite and small (a truly-constant feature maps to exactly 0). mean/std accumulate in
    float64 to avoid float32 catastrophic cancellation on the large-magnitude shared features (the exact
    features that dominate here); the result is cast back to float32 to preserve `aug_dim`/dtype.
    """
    a = np.asarray(aug, dtype=np.float64)
    if a.ndim != 2:
        raise ValueError(f"zscore_over_users expects a 2-D (U, F) array, got shape {a.shape}")
    mean = a.mean(axis=0)                       # (F,) — over the U users
    std = a.std(axis=0)                         # (F,) — population std (ddof=0)
    z = (a - mean) / (std + float(eps))
    return z.astype(np.float32)


def zscore_pool_over_users(arr: np.ndarray, eps: float = DEFAULT_EPS) -> np.ndarray:
    """Vectorized per-STEP z-score for a stacked pool array (N, U, F): standardize each of the N steps'
    (U, F) snapshot over its U users. Byte-equivalent to applying `zscore_over_users` to every arr[i]
    (asserted in the smoke). Returns float32, shape-preserving (N, U, F)."""
    a = np.asarray(arr, dtype=np.float64)
    if a.ndim != 3:
        raise ValueError(f"zscore_pool_over_users expects a 3-D (N, U, F) array, got shape {a.shape}")
    mean = a.mean(axis=1, keepdims=True)        # (N, 1, F) — over the U users of each step
    std = a.std(axis=1, keepdims=True)          # (N, 1, F)
    z = (a - mean) / (std + float(eps))
    return z.astype(np.float32)


def standardize_pool_arrays(pool: Any, eps: float = DEFAULT_EPS) -> dict[str, Any]:
    """IN-PLACE per-step z-score of an `injection_rung1.pool.InjectionPool`'s state arrays (arm B, IS-cat).

    The pool stores per-STEP bundles `states_aug` / `next_states_aug` of shape (N, U, 224) — each step is a
    full U-user snapshot, IDENTICAL in structure to the trainer's own rollout encode. So we standardize
    those two arrays PER STEP over the user axis, exactly as the trainer's `_encode_aug` standardizes its
    own rollout encode. All downstream sampling (`InjectionPool.sample`) then draws already-standardized
    (step, user) items -> no main/injected input-scale skew. Actions, masks, rewards, slot_cell, done are
    untouched (the teacher's action label + the geometry are scale-free). Returns an audit stamp.

    This is the ONE `augmented_encode` bypass in the trainer's flow (the pool is pre-encoded at BUILD time
    and loaded from disk) -> it is handled here rather than via `_encode_aug`. Idempotency-guarded.
    """
    if getattr(pool, "_shared_q_isolation_standardized", False):
        return dict(pool._shared_q_isolation_stamp)  # type: ignore[attr-defined]
    arrays = pool._a  # the InjectionPool's internal array dict (composition surface for this experiment)
    stamp: dict[str, Any] = {"eps": float(eps), "keys_standardized": [], "raw_max_abs": {}, "std_max_abs": {}}
    for key in ("states_aug", "next_states_aug"):
        raw = np.asarray(arrays[key])
        if raw.ndim != 3:
            raise ValueError(f"pool array {key!r} must be (N, U, F) to z-score per step, got {raw.shape}")
        stamp["raw_max_abs"][key] = float(np.max(np.abs(raw))) if raw.size else 0.0
        zs = zscore_pool_over_users(raw, eps=eps)
        arrays[key] = zs
        stamp["std_max_abs"][key] = float(np.max(np.abs(zs))) if zs.size else 0.0
        stamp["keys_standardized"].append(key)
    pool._shared_q_isolation_standardized = True
    pool._shared_q_isolation_stamp = dict(stamp)
    return stamp


def center_over_users(aug: np.ndarray, eps: float = DEFAULT_EPS) -> np.ndarray:
    """Per-feature CENTERING across the user axis (axis 0): (aug - mean_u) — the mean-removal-ONLY variant
    (NO σ-division). Tier-0 found the cross-user de-correlation is ~100% mean-removal, so this isolates the
    centering component of `zscore_over_users`. `eps` accepted for a signature parallel to zscore (unused).
    Returns float32, shape-preserving. mean accumulates in float64 (large-magnitude shared features)."""
    a = np.asarray(aug, dtype=np.float64)
    if a.ndim != 2:
        raise ValueError(f"center_over_users expects a 2-D (U, F) array, got shape {a.shape}")
    return (a - a.mean(axis=0)).astype(np.float32)


def center_pool_over_users(arr: np.ndarray, eps: float = DEFAULT_EPS) -> np.ndarray:
    """Vectorized per-STEP centering for a stacked pool array (N, U, F): subtract each step's per-feature
    cross-user mean. Byte-equivalent to `center_over_users` on every arr[i]. Returns float32 (N, U, F)."""
    a = np.asarray(arr, dtype=np.float64)
    if a.ndim != 3:
        raise ValueError(f"center_pool_over_users expects a 3-D (N, U, F) array, got shape {a.shape}")
    return (a - a.mean(axis=1, keepdims=True)).astype(np.float32)


def mean_offdiag_row_pearson(mat: np.ndarray) -> float:
    """Mean off-diagonal Pearson correlation between the ROWS of `mat` (U, F).

    Used as the homogenization readout: rows = the 100 users, columns = features (input) or actions
    (unmasked scalarized Q). ~1.0 => users' rows are collinear (homogenized / collapse); ~0 => decorrelated.
    Rows must be finite (for the Q readout, pass the UNMASKED scalarized Q, not the -inf-masked decode
    surface). Constant rows (zero variance) are dropped from the average (their correlation is undefined).
    """
    m = np.asarray(mat, dtype=np.float64)
    if m.ndim != 2 or m.shape[0] < 2:
        return float("nan")
    if not np.all(np.isfinite(m)):
        raise ValueError("mean_offdiag_row_pearson requires finite rows (use the UNMASKED scalarized Q)")
    keep = m.std(axis=1) > 0.0                  # drop constant rows (undefined correlation)
    m = m[keep]
    if m.shape[0] < 2:
        return float("nan")
    c = np.corrcoef(m)                          # (U', U') row-correlation
    iu = np.triu_indices(c.shape[0], k=1)
    off = c[iu]
    off = off[np.isfinite(off)]
    return float(np.mean(off)) if off.size else float("nan")
"""ConcatInjectionRung1Trainer — v3 concat(raw‖z) (or raw‖raw width-control) trainer, composition-only.

Like `trainer_std.StandardizedInjectionRung1Trainer` this SUBCLASSES the frozen
`injection_rung1.trainer.InjectionRung1Trainer` and overrides only the encode surfaces + REBUILDS the Q-nets
at the doubled input dim (448) — everything else (decode, replay, TD target, ε/target schedules, injection
mechanics incl. margin, the L5-1 / fence / r1=EE guards) is inherited byte-for-byte.

Two forms, opt-in via `shared_q_isolation.form` in the arm yaml (fail-closed):
  - **concat** : net input = [ raw_aug_224 ‖ zscore_over_users(raw_aug_224) ] = 448 (Rider-4 form; E-4b GREEN).
  - **width**  : net input = [ raw_aug_224 ‖ raw_aug_224 ] = 448 — the width-matched negative control (no z).

Net rebuild (vs trainer_std which kept 224): after the parent __init__ builds 224-dim nets, we rebuild
q_nets/target_nets/optimizers at `concat_state_dim` and re-seed `torch.manual_seed(train_seed)` EXACTLY as the
parent does (`route_b_factorial/trainer.py:103-111`) so the 448 nets are deterministic from the train seed.

Pool bypass: injection pools are stored RAW-224 on disk; we load them under the raw expected_dim then
concat-expand to 448 at load (`concat_pool_arrays`) so injected + own-rollout inputs share the 448 surface.

READINESS-ONLY. No effectiveness claim. Frozen modqn/env/state_encoding/shaped_q untouched.
"""

from __future__ import annotations

import copy
from typing import Any

import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim

from ..injection_rung1.pool import InjectionPool
from ..injection_rung1.trainer import InjectionRung1Trainer
from ..route_b_factorial.shaped_q import augmented_state_dim, build_augmented_q_nets
from .concat_encode import concat_pool_arrays, concat_state_dim
from .standardize import DEFAULT_EPS, center_over_users, zscore_over_users

CONFIG_BLOCK = "shared_q_isolation"


class ConcatInjectionRung1Trainer(InjectionRung1Trainer):
    def __init__(self, *args: Any, **kwargs: Any) -> None:
        super().__init__(*args, **kwargs)
        block = dict(self.route_cfg.raw.get(CONFIG_BLOCK, {}) or {})
        self._form = str(block.get("form", "")).lower()
