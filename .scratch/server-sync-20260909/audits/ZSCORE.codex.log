#!/usr/bin/env python3
"""Rebuild the 22-anchor Stage-C view corpus with Q1 schema v2.

The exact-source and coalition inputs are immutable parents.  This process
reads their authenticated view/physics shards, projects only Q1 view fields,
and writes a new corpus under the design workspace.  It does not import or
invoke a physics evaluator.
"""

from __future__ import annotations

from collections import Counter
import hashlib
import importlib.util
import json
import math
import os
from pathlib import Path
import resource
import sys
import time
from typing import Mapping


THREAD_VARS = (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
)
for _thread_var in THREAD_VARS:
    os.environ[_thread_var] = "1"

import numpy as np  # noqa: E402

import q1_schema_v2 as q1v2  # noqa: E402


ROOT = Path("/home/sat/mcrl-v025-design-ws")
EXACT_ROOT = Path(
    "/home/sat/mcrl-v025-datepool-ws/artifacts/"
    "v025-exact-source-20260910-BUILD_NOT_CLAIM"
)
EXACT_STAGING = EXACT_ROOT / ".staging-separated-v1"
COALITION_ROOT = Path(
    "/home/sat/mcrl-v025-coalgen-ws/artifacts/"
    "v025-stagec-c3-coalition-20260910-BUILD_NOT_CLAIM"
)
COALITION_STAGING = COALITION_ROOT / "corpus/.staging-separated-v1"
SEALED_BUILDER = Path(
    "/home/sat/mcrl-v025-datepool-ws/.scratch/exact-source-build/build.py"
)
SEALED_PILOT = Path(
    "/home/sat/mcrl-v025-c1c2suff-ws/scripts/run_v025_pilot_c3.py"
)
TRAINING_RUNNER = Path(
    "/home/sat/mcrl-v025-retrain-ws/scripts/run_stagec_training.py"
)
OUTPUT = ROOT / (
    "artifacts/v025-stagec-c3-coalition-q1v2-20260910-BUILD_NOT_CLAIM"
)
CORPUS = OUTPUT / "corpus"
RECEIPT = OUTPUT / "BUILD_NOT_CLAIM-corpus-v2-verification.json"
PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
ANCHORS = 22
MAX_AS_BYTES = 4_900_000_000
GEOMETRY_SOURCE = (
    "stored mcrl-v025-exact-source-row-physics-v1 candidate geometry at "
    "offset 0: true_off_axis_angle_rad_hex and elevation_deg_hex"
)
SOURCE_VIEW_SCHEMA = "mcrl-v025-exact-source-view-shard-v1"
COALITION_SHARD_SCHEMA = "mcrl-v025-stagec-c3-coalition-shard-v2"


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode("ascii")


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def visible_python_processes() -> tuple[tuple[int, str], ...]:
    rows = []
    for child in Path("/proc").iterdir():
        if not child.name.isdigit():
            continue
        try:
            name = (child / "comm").read_text(encoding="ascii").strip()
        except (FileNotFoundError, PermissionError, ProcessLookupError, UnicodeError):
            continue
        if name.startswith("python"):
            rows.append((int(child.name), name))
    return tuple(sorted(rows))


def enforce_resources() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS threads are not pinned to one: {bad}")
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
    processes = visible_python_processes()
    if len(processes) > 3:
        raise RuntimeError(f"python-process cap exceeded: {processes}")
    if peak_rss_bytes() >= 5_000_000_000:
        raise MemoryError("initial peak RSS is already at or above 5 GB")


def verify_sidecar(path: Path) -> str:
    sidecar = path.with_suffix(path.suffix + ".sha256")
    fields = sidecar.read_text(encoding="ascii").strip().split()
    actual = file_sha256(path)
    if len(fields) != 2 or fields[0] != actual or fields[1] != path.name:
        raise RuntimeError(f"SHA-256 sidecar disagreement: {path}")
    return actual


def write_jsonl(path: Path, values: list[dict[str, object]]) -> str:
    if path.exists() or path.with_suffix(path.suffix + ".sha256").exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    digest = hashlib.sha256()
    with temporary.open("wb") as handle:
        for value in values:
            encoded = canonical_bytes(value) + b"\n"
            handle.write(encoded)
            digest.update(encoded)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    hexdigest = digest.hexdigest()
    sidecar = path.with_suffix(path.suffix + ".sha256")
    sidecar.write_text(f"{hexdigest}  {path.name}\n", encoding="ascii")
    if verify_sidecar(path) != hexdigest:
        raise AssertionError("new JSONL sidecar did not round trip")
    return hexdigest


def write_json(path: Path, value: object) -> None:
    if path.exists():
        raise RuntimeError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(json.dumps(value, indent=2, sort_keys=True, allow_nan=False).encode("ascii"))
        handle.write(b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def read_result(index: int) -> dict[str, object]:
    path = (
        EXACT_STAGING
        / f"global-{index:03d}"
        / f"BUILD_NOT_CLAIM-anchor-{index:03d}.result.json"
    )
    result = json.loads(path.read_text(encoding="ascii"))
    if int(result["global_anchor_index"]) != index:
        raise RuntimeError(f"source result index drifted at {index}")
    return result


def paths_for_anchor(index: int) -> tuple[dict[str, object], Path, Path, Path]:
    result = read_result(index)
    physics = EXACT_ROOT / str(result["physics_staging_path"])
    source = EXACT_ROOT / str(result["view_staging_path"])
    world_index = int(result["world_index"])
    coalition = (
        COALITION_STAGING
        / f"global-{index:03d}"
        / "views"
        / f"world-{world_index}"
        / f"COALITION_BUILD-c3-anchor-{index:03d}.jsonl"
    )
    return result, physics, source, coalition


def load_geometry(physics_path: Path, expected_count: int) -> dict[str, dict[str, object]]:
    geometry: dict[str, dict[str, object]] = {}
    with physics_path.open("r", encoding="ascii") as handle:
        header = json.loads(next(handle))
        if header.get("schema") != "mcrl-v025-exact-source-physics-shard-v1":
            raise RuntimeError("stored physics shard schema drifted")
        for line in handle:
            if '"schema":"mcrl-v025-exact-source-row-physics-v1"' not in line:
                continue
            row = json.loads(line)
            candidate = row["candidate_geometry_offsets_0_1_2_3"][0]
            if int(candidate["step_index"]) != int(header["step_index"]):
                raise RuntimeError("stored candidate geometry is not offset 0")
            if row["row_key"] in geometry:
                raise RuntimeError("duplicate physics row_key")
            geometry[str(row["row_key"])] = candidate
    if len(geometry) != expected_count:
        raise RuntimeError("physics/view row inventory differs")
    return geometry


def action_key(user_id: int, action: Mapping[str, object]) -> tuple[int, int | None, int | None]:
    return (
        int(user_id),
        None if action["norad_id"] is None else int(action["norad_id"]),
        None if action["beam_chain_id"] is None else int(action["beam_chain_id"]),
    )


def rebuild_source_view(
    source_path: Path,
    geometry: dict[str, dict[str, object]],
    destination: Path,
    census_rows: list[tuple[float, ...]],
) -> tuple[str, dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]], str]:
    verify_sidecar(source_path)
    raw_lines = source_path.read_bytes().splitlines()
    values = [json.loads(line.decode("ascii")) for line in raw_lines]
    if any(line != canonical_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise RuntimeError("parent source view is not canonical JSONL")
    header = values[0]
    if (
        header.get("schema") != SOURCE_VIEW_SCHEMA
        or header.get("q1_slots") != 16
        or header.get("q2_slots") != 22
    ):
        raise RuntimeError("parent exact-source header drifted")
    if len(values) - 1 != int(header["row_count"]):
        raise RuntimeError("parent exact-source row count drifted")

    upgraded_values: list[dict[str, object]] = [
        {**header, "q1_slots": len(q1v2.Q1_V2_FEATURES)}
    ]
    by_action: dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]] = {}
    lineage = hashlib.sha256()
    for payload in values[1:]:
        extension = payload.get("exact_source_view")
        if not isinstance(extension, Mapping):
            raise RuntimeError("exact-source extension is absent")
        row_key = str(extension["row_key"])
        candidate = geometry.get(row_key)
        if candidate is None:
            raise RuntimeError(f"stored physics has no geometry for {row_key}")
        parent = {key: value for key, value in payload.items() if key != "exact_source_view"}
        null_action = parent.get("null_action")
        if type(null_action) is not bool:
            raise RuntimeError("parent null_action drifted")
        if null_action:
            if candidate != {
                "identity": None,
                "present_in_tape": False,
                "step_index": int(header["step_index"]),
            }:
                raise RuntimeError("null row has unexpected stored geometry")
            angle = 0.0
            elevation = 0.0
        else:
            if candidate.get("present_in_tape") is not True:
                raise RuntimeError("non-null row lacks stored candidate geometry")
            angle = float.fromhex(str(candidate["true_off_axis_angle_rad_hex"]))
            elevation = float.fromhex(str(candidate["elevation_deg_hex"]))
            expected_identity = [parent["action"]["norad_id"], parent["action"]["beam_chain_id"]]
            if candidate.get("identity") != expected_identity:
                raise RuntimeError("stored geometry identity differs from source action")
        upgraded = q1v2.project_row_payload_v2(
            parent,
            off_axis_angle_rad=angle,
            focal_elevation_deg=elevation,
            geometry_source=GEOMETRY_SOURCE,
        )

        # The production exact-view reader owns a stable whole-row envelope.
        # Keep that envelope and replace only its versioned Q1 fields.  The
        # full v2 row lineage is bound into the build receipt below.
        compatible = dict(parent)
        compatible["q1_state"] = list(upgraded["q1_state"])
        compatible["q1_schema_sha256"] = str(upgraded["q1_schema_sha256"])
        compatible["visible_primitives_sha256"] = str(
            upgraded["q1_visible_primitives_sha256"]
        )
        output = {**compatible, "exact_source_view": dict(extension)}
        upgraded_values.append(output)
        old_state = list(parent["q1_state"])
        new_state = list(compatible["q1_state"])
        key = action_key(int(parent["user_id"]), parent["action"])
        if key in by_action:
            raise RuntimeError("duplicate user/action in source view")
        by_action[key] = (old_state, new_state)
        numeric = tuple(float.fromhex(str(value)) for value in new_state)
        census_rows.append(numeric)
        lineage.update(
            canonical_bytes(
                {
                    "row_key": row_key,
                    "q1_v1_parent_row_sha256": upgraded["q1_v1_parent_row_sha256"],
                    "q1_visible_primitives_sha256": upgraded[
                        "q1_visible_primitives_sha256"
                    ],
                }
            )
        )
    if len(by_action) != int(header["row_count"]):
        raise RuntimeError("upgraded source inventory drifted")
    digest = write_jsonl(destination, upgraded_values)
    return digest, by_action, lineage.hexdigest()


def rebuild_coalition_view(
    source_path: Path,
    destination: Path,
    by_action: dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]],
) -> tuple[str, int, int]:
    verify_sidecar(source_path)
    raw_lines = source_path.read_bytes().splitlines()
    values = [json.loads(line.decode("ascii")) for line in raw_lines]
    if any(line != canonical_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise RuntimeError("parent coalition shard is not canonical JSONL")
    header, rows = values[0], values[1:]
    if header.get("schema") != COALITION_SHARD_SCHEMA:
        raise RuntimeError("parent coalition schema drifted")
    if len(rows) != int(header["row_count"]):
        raise RuntimeError("parent coalition row count drifted")
    replacements = 0
    for row in rows:
        members = row["context"]["members"]
        for member in members:
            user_id = int(member["user_id"])
            selected = action_key(user_id, member["selected_action"])
            reference = action_key(user_id, member["reference_action"])
            try:
                old_selected, new_selected = by_action[selected]
                old_reference, new_reference = by_action[reference]
            except KeyError as error:
                raise RuntimeError("coalition member action absent from source view") from error
            if member["selected_q1_row_hex"] != old_selected:
                raise RuntimeError("coalition selected Q1 row differs from source parent")
            if member["incumbent_q1_row_hex"] != old_reference:
                raise RuntimeError("coalition incumbent Q1 row differs from source parent")
            member["selected_q1_row_hex"] = new_selected
            member["incumbent_q1_row_hex"] = new_reference
            replacements += 2
    header = {
        **header,
        "context_payloads_sha256": canonical_sha256(
            [row["context"] for row in rows]
        ),
        "rows_sha256": canonical_sha256(rows),
    }
    digest = write_jsonl(destination, [header, *rows])
    return digest, len(rows), replacements


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def install_reader_adapter(runner: object) -> dict[str, object]:
    import mcrl.stagec_v025.encoders as encoders

    default = encoders.encoder_variant()
    name = "CORPUS_Q1_V2_READER_ADAPTER"
    key = (q1v2.Q1_V2_SCHEMA_SHA256, default.q2_schema_sha256)
    if name in encoders._REGISTRY or key in encoders._DIGEST_INDEX:
        raise RuntimeError("reader adapter registration unexpectedly pre-exists")
    q1_features = tuple(
        encoders.FeatureSpec(item.name, item.unit, item.scale)
        for item in q1v2.Q1_V2_FEATURES
    )
    variant = encoders.EncoderVariant(
        name=name,
        q1_features=q1_features,
        q2_features=default.q2_features,
        q1_raw=lambda _item: (),
        q2_raw=default.q2_raw,
        q1_schema=q1v2.Q1_V2_SCHEMA,
        q2_schema=default.q2_schema,
        q1_schema_sha256=q1v2.Q1_V2_SCHEMA_SHA256,
        q2_schema_sha256=default.q2_schema_sha256,
    )
    encoders._REGISTRY[name] = variant
    encoders._DIGEST_INDEX[key] = name
    resolved = runner.variant_for_digests(*key)
    if resolved is not variant:
        raise RuntimeError("production reader did not resolve the v2 adapter")
    return {
        "name": name,
        "method": "in-process registration in the production runner's encoder registry",
        "persistent_source_edits": False,
        "q1_schema_sha256": variant.q1_schema_sha256,
        "q2_schema_sha256": variant.q2_schema_sha256,
        "q1_width": variant.q1_width,
        "q2_width": variant.q2_width,
    }


def census(rows: list[tuple[float, ...]]) -> dict[str, object]:
    matrix = np.asarray(rows, dtype=np.float64)
    if matrix.shape[1] != len(q1v2.Q1_V2_FEATURES) or not np.isfinite(matrix).all():
        raise RuntimeError("regenerated Q1 census matrix drifted")
    scales = np.asarray([item.scale for item in q1v2.Q1_V2_FEATURES], dtype=np.float64)
    physical = matrix * scales
    slots = []
    constant_names = []
    for index, feature in enumerate(q1v2.Q1_V2_FEATURES):
        values = physical[:, index]
        exactly_constant = bool(np.all(values == values[0]))
        if exactly_constant:
            constant_names.append(feature.name)
        counts = Counter(values.tolist())
        structural_reason = None
        scope_classification = None
        if feature.name == "missing_incumbent":
            structural_reason = (
                "all covered pilot tapes keep every user served in the prior "
                "fixed-carrier mapping"
            )
            scope_classification = "schema-domain structural on these pilot tapes"
        elif feature.name == "nominal_required_power_over_cap" and exactly_constant:
            structural_reason = (
                "the exact-path ActionEvaluation uses the whole-network profile's "
                "required_power_w_max divided by the beam cap; every covered exact "
                "candidate profile reaches that cap, so the ratio is 1.0"
            )
            scope_classification = (
                "exact-path corpus-conditioned saturation; pre-existing in Q1 v1, "
                "not a schema-wide structural constant"
            )
        slots.append(
            {
                "index": index,
                "name": feature.name,
                "unit": feature.unit,
                "scale_hex": float.hex(feature.scale),
                "minimum_hex": float.hex(float(values.min())),
                "maximum_hex": float.hex(float(values.max())),
                "mean_hex": float.hex(float(values.mean())),
                "distinct": len(counts),
                "modal_fraction": max(counts.values()) / len(values),
                "exactly_constant": exactly_constant,
                "structural_constant_reason": structural_reason,
                "constant_scope_classification": scope_classification,
            }
        )
    rank = int(np.linalg.matrix_rank(physical))
    varying = physical[:, [index for index in range(physical.shape[1]) if index not in {
        slot["index"] for slot in slots if slot["exactly_constant"]
    }]]
    varying_rank = int(np.linalg.matrix_rank(varying))
    if constant_names != ["nominal_required_power_over_cap", "missing_incumbent"]:
        raise RuntimeError(f"unexpected exactly-constant Q1 slots: {constant_names}")
    centered_rank = int(np.linalg.matrix_rank(physical - physical.mean(axis=0)))
    if rank != 14 or centered_rank != 13 or varying.shape[1] != 13 or varying_rank != 13:
        raise RuntimeError(
            f"unexpected Q1 rank/effective dimension: rank={rank}, "
            f"varying={varying.shape[1]}, varying_rank={varying_rank}"
        )
    return {
        "rows": int(matrix.shape[0]),
        "serialized_dimension": int(matrix.shape[1]),
        "matrix_rank": rank,
        "mean_centered_matrix_rank": centered_rank,
        "exactly_constant_slots": constant_names,
        "varying_matrix_rank": varying_rank,
        "observed_effective_dimension": int(varying.shape[1]),
        "schema_defined_effective_dimension": 14,
        "slots": slots,
    }


def main() -> int:
    sys.dont_write_bytecode = True
    enforce_resources()
    if OUTPUT.exists():
        raise RuntimeError(f"output already exists: {OUTPUT}")
    watched = (SEALED_BUILDER, SEALED_PILOT, TRAINING_RUNNER)
    watched_before = {str(path): file_sha256(path) for path in watched}
    OUTPUT.mkdir(parents=True)
    all_census_rows: list[tuple[float, ...]] = []
    anchor_receipts = []
    physics_digests: set[str] = set()
    view_seconds = []
    total_source_rows = 0
    total_coalition_rows = 0
    overall_started = time.perf_counter()

    for index in range(ANCHORS):
        anchor_started = time.perf_counter()
        result, physics, source, coalition = paths_for_anchor(index)
        physics_hash = verify_sidecar(physics)
#!/usr/bin/env python3
"""Thin launcher: register the Q1-v2 reader adapter, then run the production trainer.

Mechanical wrapper only. It changes no sealed file, no head literal, no target and no
scoring rule. Its whole job is to make the production runner able to *read* a corpus whose
Q1 encoder variant is the repaired v2 schema, which the runner otherwise refuses with
StageCContractError at encoders.py:211 -- a fail-closed the runner is right to have.
"""
import importlib.util
import sys
from pathlib import Path

RUNNER = Path("/home/sat/mcrl-v025-retrain-ws/scripts/run_stagec_training.py")
BUILDER = Path("/home/sat/mcrl-v025-design-ws/build_corpus_v2.py")


def _load(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def main(argv):
    sys.path.insert(0, "/home/sat/mcrl-v025-retrain-ws/src")
    sys.path.insert(0, str(RUNNER.parent))
    runner = _load(RUNNER, "_v2_runner")
    builder = _load(BUILDER, "_v2_builder")
    info = builder.install_reader_adapter(runner)
    print(f"ADAPTER_INSTALLED {info}", flush=True)
    return runner.main(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
