@@ -0,0 +1,360 @@
+#!/usr/bin/env python3
+"""Evaluate learned FULL-arm a0 on the frozen PANELCEIL development panel.
+
+One invocation handles one completed 16-seed run.  Selection is exactly the
+per-user masked argmax of Q1+Q2.  No learned C3 score or profile repair is used.
+The committed endpoint is PANELCEIL's 48-boundary full-buffer numerator.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+import gc
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+from typing import Mapping
+
+
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+for _name in THREAD_VARS:
+    os.environ[_name] = "1"
+
+PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+RUNNER_PATH = Path("/home/sat/mcrl-v025-retrain-ws/scripts/run_stagec_training.py")
+PANELCEIL_PATH = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/run_panelceil.py")
+Q1V2_BUILDER = Path("/home/sat/mcrl-v025-design-ws/build_corpus_v2.py")
+ZSCORE_BUILDER = Path("/home/sat/mcrl-v025-design-ws/build_zscore_corpus.py")
+MAX_AS_BYTES = 4_900_000_000
+PANEL_ANCHORS = 12
+SEEDS = 16
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def enforce_resources() -> None:
+    if Path(sys.executable).resolve() != PYTHON.resolve():
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins drifted: {bad}")
+    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    cap = MAX_AS_BYTES if hard == resource.RLIM_INFINITY else min(MAX_AS_BYTES, hard)
+    resource.setrlimit(resource.RLIMIT_AS, (cap, cap))
+
+
+def verified_json(path: Path) -> dict:
+    sidecar = path.with_suffix(path.suffix + ".sha256")
+    fields = sidecar.read_text(encoding="ascii").split()
+    actual = file_sha256(path)
+    if len(fields) != 2 or fields[0] != actual or fields[1] != path.name:
+        raise RuntimeError(f"checkpoint sidecar disagreement: {path}")
+    return json.loads(path.read_text(encoding="ascii"))
+
+
+def source_tables(runner, corpus: Path):
+    anchors = {}
+    for path in runner._candidate_view_files(corpus):
+        first = json.loads(path.read_bytes().splitlines()[0])
+        if first.get("schema") != runner.SOURCE_VIEW_SCHEMA:
+            continue
+        shard, header = runner._read_exact_source_view(path)
+        index = int(header["global_anchor_index"])
+        if index >= PANEL_ANCHORS:
+            continue
+        grouped = defaultdict(list)
+        for row in shard.rows:
+            grouped[row.user_id].append(row)
+        tables = []
+        for user, rows in sorted(grouped.items()):
+            ordered = tuple(sorted(rows, key=lambda row: row.action_index))
+            if tuple(row.action_index for row in ordered) != tuple(range(len(ordered))):
+                raise RuntimeError("action indices are not contiguous")
+            tables.append(runner.UserActionTable(
+                user_id=user,
+                actions=tuple(row.action for row in ordered),
+                action_mask=ordered[0].action_mask,
+                q1_states=tuple(row.q1_state for row in ordered),
+                q2_states=tuple(row.q2_state for row in ordered),
+            ))
+        anchors[index] = {"header": header, "tables": tuple(tables)}
+    if set(anchors) != set(range(PANEL_ANCHORS)):
+        raise RuntimeError(f"training-panel source views incomplete: {sorted(anchors)}")
+    return anchors
+
+
+def identity(action):
+    return None if action.is_null else (int(action.norad_id), int(action.beam_chain_id))
+
+
+def masked_argmax(values, mask) -> int:
+    legal = [index for index, enabled in enumerate(mask) if enabled]
+    if not legal or len(values) != len(mask):
+        raise RuntimeError("masked argmax shape or legal-set failure")
+    return max(legal, key=lambda index: (float(values[index]), -index))
+
+
+def concentration(indices, tables) -> dict[str, object]:
+    selected = [table.actions[index] for table, index in zip(tables, indices, strict=True)]
+    beams = [int(action.beam_chain_id) for action in selected if not action.is_null]
+    satellites = [int(action.norad_id) for action in selected if not action.is_null]
+    beam_counts = Counter(beams)
+    users = len(selected)
+    return {
+        "modal_frac": (max(beam_counts.values()) / users) if beam_counts else 0.0,
+        "active_beams": len(set(beams)),
+        "active_satellites": len(set(satellites)),
+        "argmax_distinct": len(set(indices)),
+        "null_fraction": sum(action.is_null for action in selected) / users,
+    }
+
+
+def stat(values) -> dict[str, object]:
+    material = [float(value) for value in values]
+    return {
+        "mean": math.fsum(material) / len(material),
+        "minimum": min(material),
+        "maximum": max(material),
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--label", required=True)
+    parser.add_argument("--corpus", type=Path, required=True)
+    parser.add_argument("--run", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    enforce_resources()
+    if args.output.exists():
+        raise RuntimeError(f"refusing to overwrite {args.output}")
+    if not (args.run / "training-result.json").is_file():
+        raise RuntimeError(f"training run is not complete: {args.run}")
+    sys.path.insert(0, "/home/sat/mcrl-v025-retrain-ws/src")
+    runner = load_module("a0_panel_training_runner", RUNNER_PATH)
+    # Register both non-default successors; registration has no persistent edit.
+    q1v2_builder = load_module("a0_q1v2_builder", Q1V2_BUILDER)
+    q1v2_builder.install_reader_adapter(runner)
+    z_builder = load_module("a0_zscore_builder", ZSCORE_BUILDER)
+    z_builder.install_reader_adapter(runner)
+    panelceil = load_module("a0_panelceil", PANELCEIL_PATH)
+    frozen = panelceil.frozen_panel()
+    pilot = panelceil.load_pilot()
+    engine = pilot.ENGINE
+    run_setting = engine.run_setting_for("a-r0")
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    started = time.perf_counter()
+    batches, corpus_receipt, feature = runner.load_corpus(args.corpus.resolve())
+    anchors = source_tables(runner, args.corpus.resolve())
+    checkpoints = sorted((args.run / "checkpoints").glob("learner-*-epoch-000500.json"))
+    if len(checkpoints) != SEEDS:
+        raise RuntimeError(f"expected {SEEDS} terminal checkpoints, found {len(checkpoints)}")
+    selections = []
+    checkpoint_receipts = []
+    for position, checkpoint in enumerate(checkpoints, 1):
+        payload = verified_json(checkpoint)
+        seed = int(payload["learner_seed"])
+        trainer = runner.V1LineageOrchestrator(
+            learner_seed=seed,
+            q1_batch=batches["pairs"]["C1"],
+            q2_batch=batches["pairs"]["C2"],
+            c3_batch=batches["c3"],
+            neutral_sources=runner.default_synthetic_neutral_sources(),
+        )
+        trainer.load_checkpoint(checkpoint)
+        if trainer.completed_source_epochs != 500:
+            raise RuntimeError("terminal checkpoint is not epoch 500")
+        model = trainer.models["FULL"]
+        for index in range(PANEL_ANCHORS):
+            tables = anchors[index]["tables"]
+            indices = tuple(
+                masked_argmax(
+                    tuple(
+                        model.score("C1", q1) + model.score("C2", q2)
+                        for q1, q2 in zip(table.q1_states, table.q2_states, strict=True)
+                    ),
+                    table.action_mask,
+                )
+                for table in tables
+            )
+            selections.append({
+                "seed": seed,
+                "global_anchor_index": index,
+                "indices": indices,
+                "mapping": {table.user_id: identity(table.actions[action_index])
+                            for table, action_index in zip(tables, indices, strict=True)},
+                "concentration": concentration(indices, tables),
+            })
+        checkpoint_receipts.append({
+            "seed": seed, "path": str(checkpoint), "sha256": file_sha256(checkpoint),
+            "sealed_loader_readback": "PASS",
+        })
+        del trainer, model
+        gc.collect()
+        print(f"selection seed {position}/{SEEDS} peak RSS {peak_rss_bytes()} bytes", flush=True)
+
+    # Drop the training matrices before the exact committed evaluator builds its
+    # world tape.  Selection records contain only indices and physical mappings.
+    del batches, anchors
+    gc.collect()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33, start_time_s=0.0,
+    )
+    if peak_rss_bytes() >= 5_000_000_000:
+        raise MemoryError("peak RSS crossed 5 GB after development tape build")
+    results = []
+    for index, panel_row in enumerate(frozen):
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        base = engine._base_configuration(tape, step_index, carrier)
+        incumbent = engine._base_configuration(tape, max(0, step_index - 1), carrier)
+        rows = [row for row in selections if row["global_anchor_index"] == index]
+        unique = {}
+        for row in rows:
+            assignments = tuple(sorted(row["mapping"].items()))
+            if assignments not in unique:
+                unique[assignments] = engine._configuration(
+                    base, row["mapping"], kind=f"learned-a0-{args.label}"
+                )
+        evaluator = engine.StepEvaluator(
+            tape, engine._setting("a-r0"), step_index,
