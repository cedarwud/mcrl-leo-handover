def _policy_actions_on_states(q_nets, bundles: list[dict], env_cfg, weights, k_c: int) -> dict[str, np.ndarray]:
    """Re-evaluate a policy on a FIXED set of stored states. Returns decoded actions + per-user argmax.

    Uses the bundle's OWN `states_aug` / `cur_mask` / `slot_cell`, so every policy sees byte-identical inputs.
    """
    from ..env.family_b_step import FamilyBStepEnvironment
    from ..route_b_factorial.corrected_decode import decode_hybrid_corrected
    from ..route_b_factorial.shaped_q import scalarized_q_from_arrays

    C = int(FamilyBStepEnvironment(env_cfg).grid.count)
    acts, args_, distinct = [], [], []
    for b in bundles:
        states_aug = np.asarray(b["states_aug"])
        cur_mask = np.asarray(b["cur_mask"], dtype=bool)
        slot_cell = np.asarray(b["slot_cell"], dtype=np.int64)
        V = scalarized_q_from_arrays(q_nets, states_aug, cur_mask, weights, "cpu")   # (U,A), -inf off-mask
        a = decode_hybrid_corrected(V, slot_cell, env_cfg.l_w, env_cfg.k_cap, C, int(k_c), shift_to_nonneg=True)
        am = np.full(V.shape[0], -1, dtype=np.int64)
        for u in range(V.shape[0]):
            valid = np.flatnonzero(cur_mask[u])
            if valid.size:
                am[u] = int(valid[int(np.argmax(V[u, valid]))])
        acts.append(np.asarray(a, dtype=np.int64))
        args_.append(am)
        distinct.append(len(set(am[am >= 0].tolist())))
    return {
        "actions": np.stack(acts, 0),                       # (N,U) decoded (== what a pool would store)
        "argmax": np.stack(args_, 0),                       # (N,U) pre-decode per-user preference
        "argmax_distinct": np.asarray(distinct, dtype=np.int64),   # (N,) collapse phenotype
    }


def _agreement(a: np.ndarray, b: np.ndarray, admit: np.ndarray | None = None) -> dict[str, float]:
    """Fraction of (step,user) items on which two policies pick the same action (optionally on the admitted
    = top-20% demo subset only, which is what actually lands in the pool)."""
    eq = (np.asarray(a) == np.asarray(b))
    out = {"all_steps": float(eq.mean())}
    if admit is not None and admit.any():
        out["admitted_steps"] = float(eq[admit].mean())
    return out


