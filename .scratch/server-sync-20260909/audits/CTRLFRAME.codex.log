87: def interval_energy(
88:     inventory: HardwareInventory,
89:     interval: EnergyInterval,
90:     *,
91:     idle_power_w: float = PRIMARY_IDLE_POWER_W,
92:     bus_power_w: float = P_BUS_W,
93:     circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
94: ) -> EnergyReceipt:
95:     """Evaluate the declared physical-inventory formula for one interval."""
96: 
97:     if not math.isfinite(interval.duration_s) or interval.duration_s < 0.0:
98:         raise MCRLContractError("interval duration must be finite and nonnegative")
99:     if not math.isfinite(idle_power_w) or idle_power_w < 0.0:
100:         raise MCRLContractError("idle power must be finite and nonnegative")
101:     if not math.isfinite(circuit_power_per_active_chain_w) or circuit_power_per_active_chain_w < 0.0:
102:         raise MCRLContractError("active-chain circuit power must be finite and nonnegative")
103:     if bus_power_w != 0.0:
104:         raise MCRLContractError("V0.25 stage-1 endpoint declares P_bus=0 exclusion")
105:     inventory_set = set(inventory.chains)
106:     supplied = set(interval.beam_rf_w)
107:     if not supplied <= inventory_set:
108:         raise MCRLContractError("radiation names a chain outside the fixed inventory")
109:     if any(not math.isfinite(value) or value < 0.0 for value in interval.beam_rf_w.values()):
110:         raise MCRLContractError("beam RF values must be finite and nonnegative")
111:     duration = interval.duration_s
112:     pa_j = circuit_j = standby_j = 0.0
113:     active_satellites: set[int] = set()
114:     active_by_satellite: dict[int, int] = {}
115:     for identity, raw_rf in interval.beam_rf_w.items():
116:         rf = float(raw_rf)
117:         if rf > 0.0:
118:             active_satellites.add(identity[0])
119:             active_by_satellite[identity[0]] = active_by_satellite.get(identity[0], 0) + 1
120:             pa_j += max(idle_power_w, pa_supply_power_w(rf)) * duration
121:             circuit_j += circuit_power_per_active_chain_w * duration
122:     if idle_power_w > 0.0:
123:         # Sensitivity-only physical census: every represented satellite owns
124:         # 12 RF chains, independent of the number of realisable earth cells.
125:         represented_satellites = {identity[0] for identity in inventory.chains}
126:         if any(active_by_satellite.get(satellite, 0) > 12 for satellite in represented_satellites):
127:             raise MCRLContractError("active beams exceed the declared 12-chain satellite census")
128:         idle_chains = sum(
129:             12 - active_by_satellite.get(satellite, 0)
130:             for satellite in represented_satellites
131:         )
132:         standby_j = idle_chains * idle_power_w * duration
133:     baseband_j = len(active_satellites) * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W * duration
134:     receipt = EnergyReceipt(
135:         math.fsum((pa_j, circuit_j, standby_j, baseband_j)),
136:         pa_j,
137:         circuit_j,
138:         standby_j,
139:         baseband_j,
140:         0.0,
141:     )
142:     receipt.verify()
143:     return receipt
