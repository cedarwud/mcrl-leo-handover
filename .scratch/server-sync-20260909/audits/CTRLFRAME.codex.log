132: def receive_gain_dbi(separation_deg: np.ndarray | float) -> np.ndarray:
133:     """S.465-6 envelope with the declared near-axis approximation.
134: 
135:     For this terminal ``D/lambda < 50`` and the applicable lower boundary is
136:     2.043298703 degrees.  S.465-6 supplies ``32 - 25 log10(theta)`` from that
137:     boundary to 48 degrees and the -10 dBi continuation thereafter.  Below
138:     the boundary V0.25 deliberately extends the same analytic envelope up to
139:     the independently sourced 35 dBi terminal peak.  That last branch is an
140:     engineering approximation, not a prescription of S.465-6.
141:     """
142: 
143:     separation = np.asarray(separation_deg, dtype=np.float64)
144:     if not np.all(np.isfinite(separation)) or np.any(separation < 0.0):
145:         raise MCRLContractError("receive separations must be finite and nonnegative")
146:     with np.errstate(divide="ignore"):
147:         near_axis_approximation = RX_ENVELOPE_A_DBI - RX_ENVELOPE_B * np.log10(
148:             np.maximum(separation, 1.0e-12)
149:         )
150:         s465_envelope = RX_ENVELOPE_A_DBI - RX_ENVELOPE_B * np.log10(
151:             np.maximum(separation, RX_S465_THETA_MIN_DEG)
152:         )
153:     result = np.where(
154:         separation < RX_S465_THETA_MIN_DEG,
155:         near_axis_approximation,
156:         s465_envelope,
157:     )
158:     return np.clip(result, RX_GAIN_FLOOR_DBI, RX_GAIN_MAX_DBI)
159: 
160: 
161: def receive_gain_linear(separation_deg: np.ndarray | float) -> np.ndarray:
162:     return 10.0 ** (receive_gain_dbi(separation_deg) / 10.0)
163: 
164: 
165: def interference_receive_gain_linear(
166:     separation_deg: np.ndarray | float,
167:     *,
168:     same_satellite: np.ndarray | bool,
169: ) -> np.ndarray:
170:     """Receive gain used in the interference sum, including boresight override."""
171: 
172:     separation = np.asarray(separation_deg, dtype=np.float64)
173:     same = np.asarray(same_satellite, dtype=np.bool_)
174:     try:
175:         separation, same = np.broadcast_arrays(separation, same)
176:     except ValueError as error:
177:         raise MCRLContractError("separation and satellite-identity masks do not broadcast") from error
178:     envelope = receive_gain_linear(separation)
179:     peak = 10.0 ** (RX_GAIN_MAX_DBI / 10.0)
180:     return np.where(same, peak, envelope)
181: 
182: 
183: def rician_power_gain(
184:     rng: np.random.Generator,
185:     size: tuple[int, ...],
186:     *,
187:     k_factor_db: float = RICIAN_K_FACTOR_DB,
188: ) -> np.ndarray:
189:     """Unit-mean Rician power gain."""
190: 
191:     if not isinstance(rng, np.random.Generator):
192:         raise TypeError("rng must be an explicit numpy Generator")
193:     if not math.isfinite(k_factor_db):
194:         raise ValueError("k_factor_db must be finite")
195:     k_linear = 10.0 ** (k_factor_db / 10.0)
196:     los = math.sqrt(k_linear / (k_linear + 1.0))
197:     sigma = math.sqrt(1.0 / (2.0 * (k_linear + 1.0)))
198:     real = los + sigma * rng.standard_normal(size)
199:     imaginary = sigma * rng.standard_normal(size)
200:     return real**2 + imaginary**2

