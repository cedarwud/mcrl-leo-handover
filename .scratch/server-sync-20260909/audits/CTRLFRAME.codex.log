61: def _load_module(name: str, path: Path):
62:     spec = importlib.util.spec_from_file_location(name, path)
63:     if spec is None or spec.loader is None:
64:         raise RuntimeError(f"cannot load {path}")
65:     module = importlib.util.module_from_spec(spec)
66:     sys.modules[name] = module
67:     spec.loader.exec_module(module)
68:     return module
