79: @dataclass(frozen=True)
80: class EndpointTotals:
81:     bits: Fraction
82:     joules: Fraction
83:     pooled_ee: Fraction | None
84:     decoding_availability: Fraction
85:     useful_availability: Fraction
86:     complete_service_user_steps: int
87:     user_steps: int
88: 
89: 
90: def pool(steps: Iterable[StepEndpoint]) -> EndpointTotals:
91:     """Ratio of sums; all-dark is explicitly undefined rather than dropped."""
92: 
93:     rows = tuple(steps)
94:     for row in rows:
95:         row.verify()
96:     bits = sum((row.bits for row in rows), Fraction())
97:     joules = sum((row.joules for row in rows), Fraction())
98:     opportunity = sum((row.opportunity_user_seconds for row in rows), Fraction())
99:     decoding = sum((row.decoding_user_seconds for row in rows), Fraction())
100:     useful = sum((row.useful_user_seconds for row in rows), Fraction())
101:     return EndpointTotals(
102:         bits,
103:         joules,
104:         None if joules == 0 else bits / joules,
105:         Fraction() if opportunity == 0 else decoding / opportunity,
106:         Fraction() if opportunity == 0 else useful / opportunity,
107:         sum(row.complete_service_user_steps for row in rows),
108:         sum(row.user_steps for row in rows),
109:     )
110: 
111: 
112: def reward_core(
113:     endpoint: StepEndpoint | EndpointTotals,
114:     *,
115:     eta_ref: Number,
116: ) -> Fraction:
117:     """Return ``B - eta_ref*E`` for either one step or its pooled endpoint."""
118: 
119:     if isinstance(endpoint, StepEndpoint):
120:         endpoint.verify()
121:     b, e, eta = endpoint.bits, endpoint.joules, exact(eta_ref)
122:     if b < 0 or e < 0 or eta <= 0:
123:         raise MCRLContractError("reward inputs require B,E>=0 and eta_ref>0")
124:     return b - eta * e
