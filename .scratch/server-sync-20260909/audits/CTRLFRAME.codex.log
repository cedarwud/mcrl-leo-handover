23: def pa_efficiency(rf_power_w: float) -> float:
24:     """Square-root PA efficiency; zero RF has zero efficiency."""
25: 
26:     if not math.isfinite(rf_power_w) or rf_power_w < 0.0:
27:         raise MCRLContractError("RF power must be finite and nonnegative")
28:     if rf_power_w == 0.0:
