99: def transmit_gain_linear(theta_deg: np.ndarray | float) -> np.ndarray:
100:     """HOBS ideal aperture pattern, with full-HPBW converted once."""
101: 
102:     theta = np.asarray(theta_deg, dtype=np.float64)
103:     if not np.all(np.isfinite(theta)):
104:         raise MCRLContractError("off-axis angles must be finite")
105:     half_power = math.radians(TX_FULL_HPBW_DEG / 2.0)
106:     mu = _BESSEL_MU_COEFFICIENT * np.sin(np.radians(theta)) / math.sin(half_power)
107:     flat = np.atleast_1d(mu).ravel()
108:     on_axis = np.abs(flat) < _MU_ZERO
109:     safe = np.where(on_axis, 1.0, flat)
110:     # The historical ascending series is already measurably inaccurate at
111:     # mu=34.  Route the new engine to stable Miller recursion from mu>=20;
112:     # keep the vectorised series only in its well-conditioned main-lobe range.
113:     stable = np.abs(safe) >= 20.0
114:     j1 = np.empty_like(safe)
115:     j3 = np.empty_like(safe)
116:     if np.any(~stable):
117:         series_rows = bessel_j_array((1, 3), safe[~stable])
118:         j1[~stable] = series_rows[0]
119:         j3[~stable] = series_rows[1]
120:     if np.any(stable):
121:         stable_values = safe[stable]
122:         stable_rows = _miller_array((1, 3), np.abs(stable_values))
123:         signs = np.where(stable_values < 0.0, -1.0, 1.0)
124:         j1[stable] = stable_rows[0] * signs
125:         j3[stable] = stable_rows[1] * signs
126:     bracket = j1 / (2.0 * safe) + 36.0 * j3 / safe**3
127:     result = TX_G0_LINEAR * bracket**2
128:     result[on_axis] = TX_G0_LINEAR
129:     return result.reshape(theta.shape)
