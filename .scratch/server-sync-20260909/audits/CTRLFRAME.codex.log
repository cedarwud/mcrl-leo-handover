42:     @classmethod
43:     def build(
44:         cls,
45:         *,
46:         bits: Number,
47:         joules: Number,
48:         decoding_user_seconds: Number,
49:         useful_user_seconds: Number,
50:         opportunity_user_seconds: Number,
51:         complete_service_user_steps: int,
52:         user_steps: int,
53:     ) -> "StepEndpoint":
54:         result = cls(
55:             exact(bits),
56:             exact(joules),
57:             exact(decoding_user_seconds),
58:             exact(useful_user_seconds),
59:             exact(opportunity_user_seconds),
