74: def exact_float(value: float) -> Fraction:
75:     if not math.isfinite(value):
76:         raise RuntimeError("non-finite physical coefficient")
77:     return Fraction.from_float(float(value))
78: 
79: 
80: def objective(profile) -> Fraction:
81:     return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
82: 
