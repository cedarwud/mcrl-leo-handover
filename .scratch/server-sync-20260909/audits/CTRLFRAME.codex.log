23: def pa_efficiency(rf_power_w: float) -> float:
24:     """Square-root PA efficiency; zero RF has zero efficiency."""
25: 
26:     if not math.isfinite(rf_power_w) or rf_power_w < 0.0:
27:         raise MCRLContractError("RF power must be finite and nonnegative")
28:     if rf_power_w == 0.0:
29:         return 0.0
30:     return min(PA_MAX_EFFICIENCY, PA_MAX_EFFICIENCY * math.sqrt(rf_power_w / PA_SATURATION_POWER_W))
31: 
32: 
33: def pa_supply_power_w(rf_power_w: float) -> float:
34:     """``sqrt(p*p_sat)/eta_max`` for positive RF, exactly zero at zero."""
35: 
36:     if not math.isfinite(rf_power_w) or rf_power_w < 0.0:
37:         raise MCRLContractError("RF power must be finite and nonnegative")
38:     return 0.0 if rf_power_w == 0.0 else math.sqrt(rf_power_w * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY
39: 
40: 
41: PRIMARY_IDLE_POWER_W = 0.0
42: SENSITIVITY_IDLE_POWER_W = STANDBY_FRACTION * pa_supply_power_w(BEAM_RF_CAP_W)
