65: 
66:     def verify(self) -> None:
67:         if self.bits < 0 or self.joules < 0:
68:             raise MCRLContractError("bits and joules must be nonnegative")
69:         if self.joules == 0 and self.bits > 0:
70:             raise MCRLContractError("positive bits at zero energy is invalid")
71:         if not 0 <= self.decoding_user_seconds <= self.opportunity_user_seconds:
72:             raise MCRLContractError("decoding availability is outside its opportunity time")
73:         if not 0 <= self.useful_user_seconds <= self.decoding_user_seconds:
74:             raise MCRLContractError("useful time is outside decoding time")
75:         if not 0 <= self.complete_service_user_steps <= self.user_steps:
76:             raise MCRLContractError("complete-service count is outside user steps")
