33: def pa_supply_power_w(rf_power_w: float) -> float:
34:     """``sqrt(p*p_sat)/eta_max`` for positive RF, exactly zero at zero."""
35: 
36:     if not math.isfinite(rf_power_w) or rf_power_w < 0.0:
37:         raise MCRLContractError("RF power must be finite and nonnegative")
38:     return 0.0 if rf_power_w == 0.0 else math.sqrt(rf_power_w * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY
39: 
