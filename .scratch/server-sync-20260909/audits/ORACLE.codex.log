def apply_deadline_fallback(
    selections: Mapping[str, Configuration],
    *,
    base: Configuration,
    missed: bool,
) -> dict[str, Configuration]:
    """Commit BASE for every deployable set arm after one whole-path miss."""

    result = dict(selections)
    if missed:
        for arm in SET_LEVEL_ARMS:
            result[arm] = base
    return result


