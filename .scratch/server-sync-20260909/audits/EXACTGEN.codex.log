"""Part B worker: build the SAME anchor both ways (fallback row path and the
normal engine row path) and diff every SourceRow field mechanically.

Read-only diagnostic. The on-disk pilot tree is never modified; the fallback
flag is toggled only inside this diagnostic process to obtain the comparison
row, which is the only way to build the normal row for the same input."""
from __future__ import annotations

import importlib.util, json, math, sys, time
from dataclasses import asdict, fields
from pathlib import Path

WS = Path("/home/sat/mcrl-v025-coverage-ws")
SRC = WS / "src-copy"
OUT = WS / ".scratch" / "preflight-data"


def load():
    sys.path.insert(0, str(SRC / "src"))
    spec = importlib.util.spec_from_file_location(
        "pilot_c3", SRC / "scripts" / "run_v025_pilot_c3.py")
    mod = importlib.util.module_from_spec(spec)
    sys.modules["pilot_c3"] = mod
    spec.loader.exec_module(mod)
    return mod


def _sortkey(k):
    return (k[0], -1 if k[1] is None else k[1],
            -1 if k[2] is None else k[2])


def key_of(row):
    return (row.user_id, row.action.norad_id, row.action.beam_chain_id)


def main(steps: list[int], carrier_index: int) -> int:
    MOD = load()
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape
    from mcrl.stagec_v025.state import Q1_FEATURES, SourceRow

    carrier = MOD.ENGINE.REFERENCE_CARRIERS[carrier_index]
    setting = MOD.ENGINE._setting("a-r0")
    run_setting = MOD.ENGINE.run_setting_for("a-r0")
    tape = build_world_tape(domain=MOD.TRAIN_WORLDS[0],
                           provider=LegacyWorldProvider(role="pilot-source"),
                           steps=33, start_time_s=0.0)
    cal = MOD._pilot_calibration(tape, setting, run_setting)
    names = [f.name for f in fields(SourceRow)]
    q1names = [f.name for f in Q1_FEATURES]
    results = []

    for step_index in steps:
        anchor_index = step_index * len(MOD.ENGINE.REFERENCE_CARRIERS) + carrier_index
        t0 = time.perf_counter()
        fb = MOD._build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting, calibration=cal,
            step_index=step_index, carrier=carrier, anchor_index=anchor_index,
            include_coalition=True, full_legal_actions=False)
        t_fb = time.perf_counter() - t0
        print(f"step {step_index} fallback rows={len(fb['rows'])} t={t_fb:.1f}s", flush=True)

        MOD.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
        t0 = time.perf_counter()
        nm = MOD._build_anchor_rows(
            tape=tape, setting=setting, run_setting=run_setting, calibration=cal,
            step_index=step_index, carrier=carrier, anchor_index=anchor_index,
            include_coalition=True, full_legal_actions=False)
        t_nm = time.perf_counter() - t0
        MOD.PILOT_PRIMITIVE_SOURCE_FALLBACK = True
        print(f"step {step_index} normal   rows={len(nm['rows'])} t={t_nm:.1f}s", flush=True)

        fmap = {key_of(r): r for r in fb["rows"]}
        nmap = {key_of(r): r for r in nm["rows"]}
        shared = sorted(set(fmap) & set(nmap), key=_sortkey)
        field_diff = {n: 0 for n in names}
        field_examples: dict[str, list] = {}
        q1_diff = {n: 0 for n in q1names}
        q1_absmax = {n: 0.0 for n in q1names}
        label_pairs = {"c1_label_bits": [], "c2_label_bits": [],
                       "c1_phi_difference": [], "outage": []}
        for k in shared:
            a, b = fmap[k], nmap[k]
            for n in names:
                va, vb = getattr(a, n), getattr(b, n)
                if n in {"q1_state", "q2_state"}:
                    if tuple(va) != tuple(vb):
                        field_diff[n] += 1
                    continue
                if va != vb:
                    field_diff[n] += 1
                    if n not in field_examples:
                        field_examples[n] = [str(va)[:120], str(vb)[:120]]
            for i, n in enumerate(q1names):
                d = abs(a.q1_state[i] - b.q1_state[i])
                if d > 0.0:
                    q1_diff[n] += 1
                q1_absmax[n] = max(q1_absmax[n], d)
            label_pairs["c1_label_bits"].append(
                [float.fromhex(a.c1_label_bits_hex), float.fromhex(b.c1_label_bits_hex)])
            label_pairs["c2_label_bits"].append(
                [float.fromhex(a.c2_label_bits_hex), float.fromhex(b.c2_label_bits_hex)])
            label_pairs["c1_phi_difference"].append(
                [float.fromhex(a.c1_phi_difference_hex), float.fromhex(b.c1_phi_difference_hex)])
            label_pairs["outage"].append([int(a.outage), int(b.outage)])

        fb_coal = fb["coalition_row"]
        nm_coal = nm["coalition_row"]
        def coal_payload(row):
            if row is None:
                return None
            try:
                p = row.payload() if hasattr(row, "payload") else asdict(row)
                return {
                    "anchor_id": p.get("context", {}).get("anchor_id"),
                    "original_changed_users": p.get("original_changed_users"),
                    "original_changed_user_count": p.get("original_changed_user_count"),
                    "member_user_ids": [m.get("user_id") for m in
                                        p.get("context", {}).get("members", [])],
                    "member_selected_actions": [m.get("selected_action") for m in
                                                p.get("context", {}).get("members", [])],
                    "member_reference_actions": [m.get("reference_action") for m in
                                                 p.get("context", {}).get("members", [])],
                    "psi_normalized_hex": p.get("psi_normalized_hex"),
                    "c1_normalized_hex": p.get("c1_normalized_hex"),
                    "objective_delta_normalized_hex": p.get("objective_delta_normalized_hex"),
                    "decomposition_id": p.get("decomposition_id"),
                }
