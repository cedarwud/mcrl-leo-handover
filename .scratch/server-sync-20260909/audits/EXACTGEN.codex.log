#!/usr/bin/env python3
"""Quarantined end-to-end V0.25 learned-C3 pilot (PILOT_NOT_CLAIM).

This adapter joins the independently delivered stage-4d/4f real-physics
engine, fixed legacy provider, and Stage-C build-3 learner.  It deliberately
uses only V025_PROBE/world/{1..4}; no claim-panel namespace is accepted.
"""

from __future__ import annotations

import argparse
from concurrent.futures import ProcessPoolExecutor, as_completed
from dataclasses import dataclass
import datetime as dt
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import multiprocessing as mp
import os
from pathlib import Path
import resource
import sys
import time
from types import ModuleType
from typing import Iterable, Mapping, Sequence

import numpy as np

from mcrl.physics_v025.calibration import assert_calibration_prices
from mcrl.physics_v025.constants_v025 import BEAM_RF_CAP_W, DECISION_INTERVAL_S
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape, digest_payload, seed_from_domain
from mcrl.physics_v025.targets import c2_persistence_forecast, matched_anchor_decomposition
from mcrl.stagec_v025.canonical import canonical_sha256, write_once_json
from mcrl.stagec_v025.coalitions import (
    AffectedBeamContext,
    CoalitionContext,
    CoalitionMember,
    build_coalition_row,
    read_coalition_shard,
    write_coalition_shard,
)
from mcrl.stagec_v025.learner import (
    CoalitionBatch,
    LEGACY_EPOCH_BUDGET,
    LEARNED_ARMS,
    PairwiseBatch,
    ROUTES,
    SOURCE_MAP,
    V1LineageOrchestrator,
    build_pairwise_batches,
    default_synthetic_neutral_sources,
)
from mcrl.stagec_v025.shards import read_source_shard, write_source_shard
from mcrl.stagec_v025.state import (
    ActionEvaluation,
    ForecastObservation,
    PhysicalAction,
    extract_source_rows,
    seal_action_evaluation,
)


LABEL = "PILOT_NOT_CLAIM"
PILOT_SCHEMA = "mcrl-v025-learned-c3-real-physics-pilot-v1"
ROOT = Path(__file__).resolve().parents[1]
ENGINE_PATH = ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
DEFAULT_OUTPUT = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
REPORT_PATH = ROOT / "V025-PILOT-C3-REPORT-2026-09-09.md"
TRAIN_WORLDS = DEVELOPMENT_WORLD_DOMAINS[:2]
EVALUATION_WORLDS = DEVELOPMENT_WORLD_DOMAINS[2:4]
LEARNER_DOMAINS = tuple(f"V025_LEARNER/seed/{index}" for index in range(1, 5))
LEARNER_SEEDS = tuple(seed_from_domain(domain) for domain in LEARNER_DOMAINS)
REPORTED_ARMS = (*LEARNED_ARMS, "BASELINE", "S0", "S_UNI")
# --- minimal-pilot scale knobs (engineering only; overridden from main()) ---
# Defaults reproduce the original full-scale pilot exactly.
PILOT_ARMS = tuple(LEARNED_ARMS)
EVAL_ANCHOR_STEPS = 30
EVAL_CARRIER_LIMIT = None
EVAL_EPOCH = LEGACY_EPOCH_BUDGET
ROW_WORLD_GLOB = "world-*"
ROW_ANCHOR_LIMIT = None
EVAL_TAPE_STEPS = 33
PILOT_FORECAST_BOUNDARIES = (0,)
PILOT_AGGREGATE_PAIR_LIMIT = 4_096
PILOT_PRIMITIVE_SOURCE_FALLBACK = True


def _engine() -> ModuleType:
    name = "mcrl_v025_pilot_matrix_engine"
    if name in sys.modules:
        return sys.modules[name]
    spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load engine at {ENGINE_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


ENGINE = _engine()
# Pilot-only compute fallback. The sealed engine remains byte-for-byte intact;
# its forecast helper reads this module constant at call time.
ENGINE.SELECTION_BOUNDARY_INDICES = PILOT_FORECAST_BOUNDARIES


def _sha_files(paths: Iterable[Path]) -> str:
    digest = hashlib.sha256()
    for path in sorted(paths):
        digest.update(path.relative_to(ROOT).as_posix().encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


CODE_DIGEST = _sha_files(
    [Path(__file__), *sorted((ROOT / "src/mcrl/stagec_v025").glob("*.py"))]
)
PHYSICS_DIGEST = _sha_files(sorted((ROOT / "src/mcrl/physics_v025").glob("*.py")))
LAUNCH_DIGEST = _sha_files(
    [
        ROOT / "V025-PILOT-TRACK-DECLARATION-2026-09-09.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1-2026-09-08.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1.1-AMENDMENT-2026-09-09.md",
        ROOT / "V025-STAGES-6-8-CONTRACT-v1.2-AMENDMENT-2026-09-09.md",
    ]
)
ALLOCATION_DIGEST = canonical_sha256(
    {
        "artifact_label": LABEL,
        "training_worlds": TRAIN_WORLDS,
        "evaluation_worlds": EVALUATION_WORLDS,
        "learner_seed_domains": LEARNER_DOMAINS,
        "anchors_per_world_per_carrier": 30,
    }
)


@dataclass(frozen=True)
class PilotCalibration:
    eta_ref: Fraction
    lambda_bits_per_j: Fraction
    kappa_bits_per_user_step: Fraction
    bits_ref: Fraction
    joules_ref: Fraction
    users: int
    source: str = "one-development-anchor-proxy"

    def __post_init__(self) -> None:
        assert_calibration_prices(
            lambda_bits_per_j=self.lambda_bits_per_j,
            eta_ref=self.eta_ref,
            kappa_bits_per_user_step=self.kappa_bits_per_user_step,
        )

    @property
    def digest(self) -> str:
        return canonical_sha256(self.payload())

    def payload(self) -> dict[str, object]:
        def ratio(value: Fraction) -> list[int]:
            return [value.numerator, value.denominator]

        return {
            "schema": f"{PILOT_SCHEMA}-calibration-proxy-v1",
            "artifact_label": LABEL,
            "source": self.source,
            "eta_ref": ratio(self.eta_ref),
            "lambda_bits_per_j": ratio(self.lambda_bits_per_j),
            "kappa_bits_per_user_step": ratio(self.kappa_bits_per_user_step),
            "bits_ref": ratio(self.bits_ref),
            "joules_ref": ratio(self.joules_ref),
            "users": self.users,
        }

    if full_legal:
        options, census = ENGINE._legal_options(tape, step_index)
    else:
        options, census = ENGINE._selection_shortlist(
            tape, step_index, run_setting=run_setting
        )
    by_user: dict[int, tuple[tuple[int, int] | None, ...]] = {}
    configs: dict[tuple[int, tuple[int, int] | None], object] = {}
    for user in sorted(base.mapping):
        ordered = []
        for identity in (base.mapping[user], *options[user], None):
            if identity not in ordered:
                ordered.append(identity)
        by_user[user] = tuple(ordered)
        for identity in ordered:
            mapping = base.mapping
            mapping[user] = identity
            configs[(user, identity)] = ENGINE._configuration(
                base, mapping, kind="pilot-shortlisted-unilateral"
            )
    return by_user, configs, census


def _primitive_metrics(tape, step_index: int, user: int, identity, indices):
    if identity is None:
        return {
            "legal": False, "gain": 0.0, "remaining_d2": 0.0,
            "remaining_visibility": 0.0,
        }
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        candidate = next(
            (row for row in tape.steps[step_index].boundaries[0].candidates
             if row.user_id == user and row.identity == identity),
            None,
        )
        if candidate is None:
            return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
        return {
            "legal": candidate.legal,
            "gain": candidate.nominal_gain,
            "remaining_d2": candidate.remaining_d2_s,
            "remaining_visibility": candidate.remaining_visibility_s,
        }
    row = indices[step_index].get((user, identity))
    if row is None:
        return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
    return {
        "legal": bool(arrays.visible[0, row] and arrays.d2_eligible[0, row] and arrays.cell_reachable[0, row]),
        "gain": float(arrays.nominal_gain[0, row]),
        "remaining_d2": float(arrays.remaining_d2_s[0, row]),
        "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
    }


def _build_anchor_rows_primitive(
    *, tape, setting, run_setting, calibration, step_index, carrier,
    anchor_index, include_coalition, full_legal_actions,
):
    """Schema-complete provider-primitive fallback for bounded pilot compute."""

    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    # The generating-input digest already authenticates the provider inputs
    # and boundary-zero bytes. Computing ``tape.digest`` here hashes every
    # dense 33x48 array and dominates an entire anchor on this snapshot.
    tape_digest = tape.generating_input_digest or canonical_sha256({
        "domain": tape.domain,
        "seed": tape.seed,
        "provider": tape.protocol.provider_source_digest,
    })
    future_bases = {
        offset: ENGINE._base_configuration(tape, step_index + offset, carrier)
        for offset in (1, 2, 3)
    }
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape, setting, step_index, transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal", counter=counter, run_setting=run_setting,
        boundary_indices=(0,),
    )
    base_profile = current.evaluate(base)
    source_rows = []
    rows_by_user_action = {}
    for user in sorted(by_user):
        actions = []
        identities = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        base_metric = _primitive_metrics(
            tape, step_index, user, base.mapping[user], indices
        )
        base_gain = max(base_metric["gain"], 1e-300)
        for identity in by_user[user]:
            metric = _primitive_metrics(tape, step_index, user, identity, indices)
            ratio = max(metric["gain"], 1e-300) / base_gain
            gain_db = 10.0 * math.log10(max(ratio, 1e-30))
            if identity is None or not metric["legal"]:
                normalized_delta = -1.0
            else:
                normalized_delta = math.tanh(math.log(max(ratio, 1e-30)))
            candidate_margin = base_profile.min_decoding_margin_db + gain_db
            required_ratio = min(1e6, max(0.0, base_profile.required_power_w_max / BEAM_RF_CAP_W / max(ratio, 1e-12)))
            se = max(0.0, base_profile.mean_acm_se_bit_s_hz * min(4.0, max(0.0, ratio)))
            forecast_rows = []
            c2_normalized = 0.0
            alive = True
            for offset in (1, 2, 3):
                projected = step_index + offset
                future_metric = _primitive_metrics(tape, projected, user, identity, indices)
                future_base = future_bases[offset].mapping[user]
                future_base_metric = _primitive_metrics(tape, projected, user, future_base, indices)
                future_ratio = max(future_metric["gain"], 1e-300) / max(future_base_metric["gain"], 1e-300)
                survives = bool(future_metric["legal"] and identity is not None)
                if alive:
                    c2_normalized += math.tanh(math.log(max(future_ratio, 1e-30))) if survives else -1.0
                    alive = survives
                else:
                    c2_normalized -= 1.0
                forecast_rows.append(ForecastObservation(
                    valid=survives,
                    survival=survives,
                    minimum_decoding_margin_db=base_profile.min_decoding_margin_db + 10.0 * math.log10(max(future_ratio, 1e-30)),
                    mean_acm_spectral_efficiency=max(0.0, se * min(4.0, max(0.0, future_ratio))),
                ))
            phi = ENGINE._phi_for(incumbent, configs[(user, identity)]) - ENGINE._phi_for(incumbent, base)
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = 0 if identity is None else previous_beam.get(identity, 0)
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=candidate_margin,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=se,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=metric["remaining_d2"],
                remaining_visibility_time_s=metric["remaining_visibility"],
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent.mapping[user],
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=identity is not None and identity in previous_beam,
                previous_satellite_active_for_action=identity is not None and identity[0] in previous_satellite,
                previous_beam_max_rf_over_cap=0.0 if identity is None else min(1.0, required_ratio),
                missing_incumbent=incumbent.mapping[user] is None,
                candidate_current_nominal_decoding_margin_db=candidate_margin,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(forecast_rows[0].mean_acm_spectral_efficiency - se) / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W * (1.0 - required_ratio),
                forecasts=tuple(forecast_rows),
                c1_label_bits=float(calibration.kappa_bits_per_user_step) * normalized_delta,
                c1_phi_difference=float(phi),
                c2_label_bits=float(calibration.kappa_bits_per_user_step) * c2_normalized,
                legal=True,
                terminal=step_index == 29,
                outage=not bool(metric["legal"]),
            )
            actions.append(seal_action_evaluation(
                observation,
                source_provenance_sha256=canonical_sha256({
                    "artifact_label": LABEL, "method": "provider-primitive-fallback",
                    "world": tape_digest, "step": step_index, "carrier": carrier,
                    "user": user, "identity": identity,
                }),
                forecast_method_sha256=canonical_sha256({
                    "method": "provider-primitive-boundary-0", "offsets": [1, 2, 3]
                }),
            ))
            identities.append(identity)
        envelope = AnchorEnvelope(
            world_id=tape.domain, split="TRAIN", world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}", anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user, setting_id="a-r0", code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST, launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest, calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape), allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]), actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row
    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)
    return {
        "base": base, "incumbent": incumbent, "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action, "current_evaluator": current,
        "coalition_row": coalition_row, "census": census, "skipped_invalid": 0,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=0.0 if primitive is None else primitive["remaining_d2"],
                remaining_visibility_time_s=(
                    0.0 if primitive is None else primitive["remaining_visibility"]
                ),
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent_identity,
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=(
                    identity is not None and identity in previous_beam
                ),
                previous_satellite_active_for_action=(
                    identity is not None and identity[0] in previous_satellite
                ),
                previous_beam_max_rf_over_cap=(
                    0.0 if identity is None else min(1.0, required_ratio)
                ),
                missing_incumbent=missing_incumbent,
                candidate_current_nominal_decoding_margin_db=profile.min_decoding_margin_db,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(
                    projections[0].mean_acm_se_bit_s_hz
                    - profile.mean_acm_se_bit_s_hz
                )
                / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W - profile.required_power_w_max,
                forecasts=tuple(
                    ForecastObservation(
                        valid=row.valid,
                        survival=row.survives,
                        minimum_decoding_margin_db=row.min_decoding_margin_db,
                        mean_acm_spectral_efficiency=row.mean_acm_se_bit_s_hz,
                    )
                    for row in projections
                ),
                c1_label_bits=float(core),
                c1_phi_difference=float(phi),
                c2_label_bits=float(c2.forecast_surplus_bits - c2.persistence_penalty_bits),
                legal=True,
                terminal=step_index == 29,
                outage=not bool(profile.score.served_phy.get(user, False)),
            )
            provenance = canonical_sha256(
                {
                    "artifact_label": LABEL,
                    "world": tape.digest,
                    "step": step_index,
                    "carrier": carrier,
                    "user": user,
                    "configuration": config.configuration_id,
                }
            )
            actions.append(
                seal_action_evaluation(
                    observation,
                    source_provenance_sha256=provenance,
                    forecast_method_sha256=canonical_sha256(
                        {
                            "engine": ENGINE.SCHEMA,
                            "offsets": [1, 2, 3],
                            "boundaries": list(ENGINE.SELECTION_BOUNDARY_INDICES),
                        }
                    ),
                )
            )
            identities.append(identity)
        if base.mapping[user] not in identities or None not in identities:
            raise RuntimeError("source action set lost BASE or the explicit null action")
        envelope = AnchorEnvelope(
            world_id=tape.domain,
            split="TRAIN",
            world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}",
            anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user,
            setting_id="a-r0",
            code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST,
            launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest,
            calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape),
            allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]),
            actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row

    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _catalogue_census = ENGINE._catalogue_with_census(
            tape,
            step_index,
            base,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        current.evaluate_many(catalogue)
        catalogue_count = len(catalogue)
        factors = ENGINE._selection_factor_scores(
            base=base,
            incumbent=incumbent,
            catalog=tuple(
                row for row in catalogue if row.configuration_id not in current._invalid
            ),
            evaluated=current._evaluated,
            calibration=calibration,
            cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        )
        pairwise = [
            row
            for row in catalogue
            if row.changed_users == 2
            and row.configuration_id in factors
        ]
        if not pairwise:
            raise RuntimeError("sealed catalogue produced no trainable joint coalition")
        selected = min(
            pairwise,
            key=lambda row: (
                -float(factors[row.configuration_id]["C1"] + factors[row.configuration_id]["C3"]),
                row.configuration_id,
            ),
        )
        coalition_row = _coalition_row(
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            run_setting=run_setting,
        )
    return {
        "base": base,
        "incumbent": incumbent,
        "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action,
        "current_evaluator": current,
        "coalition_row": coalition_row,
        "census": census,
        "skipped_invalid": skipped_invalid,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
        world_id=tape.domain,
        world_seed=tape.seed,
        anchor_index=anchor_index,
        decision_time_utc=_utc_at(tape, step_index),
        decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
        setting_id="a-r0",
        lambda_bits_per_j=float(calibration.lambda_bits_per_j),
        eta_ref_bits_per_j=float(calibration.eta_ref),
        kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
        code_digest=CODE_DIGEST,
        physics_digest=PHYSICS_DIGEST,
        catalogue_digest=ENGINE.catalogue_definition()["sha256"],
        setting_digest=run_setting.digest,
        calibration_digest=calibration.digest,
        allocation_manifest_digest=ALLOCATION_DIGEST,
    )


def _write_phase_manifest(path: Path, payload: Mapping[str, object]) -> str:
    return write_once_json(path, {"artifact_label": LABEL, **payload})


def generate_rows(output: Path):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    source_shards = []
    coalition_shards = []
    calibration = None
    world_records = []
    for world_index, domain in enumerate(TRAIN_WORLDS, start=1):
        provider_started = time.perf_counter()
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(role="pilot-source"),
            steps=33,
            start_time_s=0.0,
        )
        provider_wall = time.perf_counter() - provider_started
        if calibration is None:
            calibration = _pilot_calibration(tape, setting, run_setting)
            _write_phase_manifest(output / f"{LABEL}-calibration.json", calibration.payload())
        skipped = physics_calls = catalogue_rows = 0
        source_row_count = coalition_row_count = source_bytes = coalition_bytes = 0
        source_hashes = []
        coalition_hashes = []
        anchor_started = time.perf_counter()
        anchor_index = 0
        for step_index in range(30):
            for carrier in ENGINE.REFERENCE_CARRIERS:
                built = _build_anchor_rows(
                    tape=tape,
                    setting=setting,
                    run_setting=run_setting,
                    calibration=calibration,
                    step_index=step_index,
                    carrier=carrier,
                    anchor_index=anchor_index,
                    include_coalition=True,
                )
                source_path = (
                    output / "rows" / f"world-{world_index}"
                    / f"{LABEL}-source-anchor-{anchor_index:03d}.jsonl"
                )
                coalition_path = (
                    output / "rows" / f"world-{world_index}"
                    / f"{LABEL}-coalition-anchor-{anchor_index:03d}.jsonl"
                )
                source_shard = write_source_shard(source_path, built["rows"])
                coalition_shard = write_coalition_shard(
                    coalition_path, (built["coalition_row"],)
                )
                source_shards.append(source_shard)
                coalition_shards.append(coalition_shard)
                source_row_count += len(built["rows"])
                coalition_row_count += 1
                source_bytes += source_path.stat().st_size
                coalition_bytes += coalition_path.stat().st_size
                source_hashes.append(source_shard.file_sha256)
                coalition_hashes.append(coalition_shard.file_sha256)
                skipped += built["skipped_invalid"]
                physics_calls += built["physics_calls"]
                catalogue_rows += built["catalogue_count"]
                anchor_index += 1
                print(
                    json.dumps(
                        {
                            "artifact_label": LABEL,
                            "phase": "rows",
                            "world": world_index,
                            "anchor": anchor_index,
                            "anchors_total": 90,
                        }
                    ),
                    flush=True,
                )
        world_records.append(
            {
                "world_id": domain,
                "world_seed": tape.seed,
                "anchors": anchor_index,
                "source_rows": source_row_count,
                "coalition_rows": coalition_row_count,
                "source_bytes": source_bytes,
                "coalition_bytes": coalition_bytes,
                "provider_wall_s": provider_wall,
                "anchor_wall_s": time.perf_counter() - anchor_started,
                "skipped_power_invalid_actions": skipped,
                "physics_boundary_evaluations": physics_calls,
                "catalogue_rows_considered": catalogue_rows,
                "source_shards_sha256": canonical_sha256(source_hashes),
                "coalition_shards_sha256": canonical_sha256(coalition_hashes),
            }
        )
    assert calibration is not None
    manifest = {
        "schema": f"{PILOT_SCHEMA}-rows-manifest-v1",
        "phase_wall_s": time.perf_counter() - phase_started,
        "phase_core_s": time.process_time() - cpu_started,
        "worlds": world_records,
        "total_source_rows": sum(row["source_rows"] for row in world_records),
        "total_coalition_rows": sum(row["coalition_rows"] for row in world_records),
        "total_bytes": sum(
            row["source_bytes"] + row["coalition_bytes"] for row in world_records
        ),
        "calibration": calibration.payload(),
    }
    _write_phase_manifest(output / f"{LABEL}-rows-manifest.json", manifest)
    return source_shards, coalition_shards, calibration, manifest


_TRAIN_Q1 = None
_TRAIN_Q2 = None
_TRAIN_C3 = None
_TRAIN_NEUTRAL = None
_TRAIN_OUTPUT = None


def _train_one(task):
    learner_seed, arm = task
    wall_started = time.perf_counter()
    cpu_started = time.process_time()
    assert _TRAIN_Q1 is not None and _TRAIN_Q2 is not None and _TRAIN_C3 is not None
    orchestrator = V1LineageOrchestrator(
        learner_seed=learner_seed,
        q1_batch=_TRAIN_Q1,
        q2_batch=_TRAIN_Q2,
        c3_batch=_TRAIN_C3,
        neutral_sources=_TRAIN_NEUTRAL,
    )
    model = orchestrator.models[arm]
    batches = {
        "C1": _TRAIN_Q1 if SOURCE_MAP[arm]["C1"] == "informed" else orchestrator._neutral_q1,
        "C2": _TRAIN_Q2 if SOURCE_MAP[arm]["C2"] == "informed" else orchestrator._neutral_q2,
        "C3": _TRAIN_C3 if SOURCE_MAP[arm]["C3"] == "informed" else orchestrator._neutral_c3,
    }
    final_losses = {}
    checkpoint_digests = []
    for epoch in range(1, LEGACY_EPOCH_BUDGET + 1):
        final_losses = {

    unilateral = [row for row in catalogue if row.changed_users == 1]
    top_ids = []
    for user in sorted(base.mapping):
        proposals = [
            row for row in unilateral
            if row.mapping[user] != base.mapping[user]
        ]
        ranked = sorted(
            proposals,
            key=lambda row: (
                -(
                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
                ),
                row.configuration_id,
            ),
        )[: ENGINE.TOP_PROPOSALS]
        top_ids.extend(row.configuration_id for row in ranked)
    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
    allowed.extend(
        row for row in catalogue
        if row.changed_users > 1
        and all(
            any(
                proposal.mapping[user] == identity
                for proposal in unilateral
                if proposal.configuration_id in top_ids
            )
            for user, identity in row.assignments
            if identity != base.mapping[user]
        )
    )
    evaluator.evaluate_many(tuple(allowed))
    allowed = [
        row for row in allowed if row.configuration_id not in evaluator._invalid
    ]
    return min(
        allowed,
        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
    )


def _select_for_anchor(
    anchor_name, anchor, catalogue, exact, models, rows_by_user_action,
    tape, step_index, exact_s0,
):
    selections = {}
    diagnostics = {}
    legal_catalogue = [row for row in catalogue if row.configuration_id in exact]
    contexts = {}
    for config in legal_catalogue:
        if len(exact[config.configuration_id]["changed"]) >= 2:
            contexts[config.configuration_id] = _coalition_context(
                tape=tape, step_index=step_index, anchor=anchor,
                selected=config, rows_by_user_action=rows_by_user_action,
            )
    for seed in LEARNER_SEEDS:
        exact_scores = []
        additive_scores = []
        learned_scores_by_arm = {arm: [] for arm in PILOT_ARMS}
        deltas_by_arm = {}
        c2_tie_pairs = 0
        c2_eligible_pairs = 0
        for arm in PILOT_ARMS:
            model = models[(seed, arm)]
            deltas = {}
            for (user, action), row in rows_by_user_action.items():
                reference = rows_by_user_action[(user, anchor.mapping[user])]
                q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
                deltas[(user, action)] = (
                    model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
                    + q2_delta
                )
                if arm == "FULL" and action != anchor.mapping[user]:
                    c2_eligible_pairs += 1
                    c2_tie_pairs += int(q2_delta == 0.0)
            deltas_by_arm[arm] = deltas
        c2_tie_fraction = (
            c2_tie_pairs / c2_eligible_pairs if c2_eligible_pairs else None
        )
        for config in legal_catalogue:
            context = contexts.get(config.configuration_id)
            full_additive = math.fsum(
                deltas_by_arm["FULL"][(user, config.mapping[user])]
                for user in anchor.mapping
            )
            exact_scores.append((full_additive + exact[config.configuration_id]["psi"], config.configuration_id, config))
            additive_scores.append((full_additive, config.configuration_id, config))
            for arm in PILOT_ARMS:
                model = models[(seed, arm)]
                score = math.fsum(
                    deltas_by_arm[arm][(user, config.mapping[user])]
                    for user in anchor.mapping
                )
                if context is not None:
                    score += model.interaction(context)
                learned_scores_by_arm[arm].append((score, config.configuration_id, config))
        exact_choice = min(exact_scores, key=lambda row: (-row[0], row[1]))[2]
        additive_choice = min(additive_scores, key=lambda row: (-row[0], row[1]))[2]
        selections[(seed, "S0")] = exact_s0
        for arm in PILOT_ARMS:
            selections[(seed, arm)] = min(
                learned_scores_by_arm[arm], key=lambda row: (-row[0], row[1])
            )[2]
        diagnostics[seed] = {
            "top_choice_agreement": selections[(seed, "FULL")].assignments == exact_choice.assignments,
            "additive_choice": additive_choice,
            "exact_choice": exact_choice,
            "anchor": anchor_name,
            # Minimal-pilot C2 tie statistic: over the FULL arm, the fraction of
            # non-incumbent (user, action) candidates whose C2 head score is
            # exactly equal to the incumbent's, i.e. C2 cannot discriminate the
            # move at all and the ranking falls through to C1 + the tie-break.
            "c2_tie": c2_tie_fraction,
            "c2_tie_pairs": c2_tie_pairs,
            "c2_eligible_pairs": c2_eligible_pairs,
        }
    return selections, diagnostics


