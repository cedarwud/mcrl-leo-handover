   250	
   251	def c2_persistence_forecast(
   252	    candidate: Sequence[OffsetProjection],
   253	    default: Sequence[OffsetProjection],
   254	    *,
   255	    lambda_bits_per_j: int | float | str | Fraction,
   256	    eta_ref: int | float | str | Fraction,
   257	    kappa_bits_per_user_step: int | float | str | Fraction | None = None,
   258	    kappa_bits_per_user_s: int | float | str | Fraction | None = None,
   259	    horizon_offsets: int = FORECAST_OFFSETS,
   260	) -> C2Label:
   261	    """OPS-3-style absorbing persistence with one -kappa per lost offset.
   262	
   263	    The failed offset's attempted transmission is already present in its
   264	    ``NetworkOutcome``.  Only later offsets are made absorbing losses; live
   265	    recovery outside this forecast remains possible.
   266	    """
   267	
   268	    if (kappa_bits_per_user_step is None) == (kappa_bits_per_user_s is None):
   269	        raise MCRLContractError("supply exactly one kappa normalization keyword")
   270	    kappa_value = (
   271	        kappa_bits_per_user_step
   272	        if kappa_bits_per_user_step is not None
   273	        else kappa_bits_per_user_s
   274	    )
   275	    eta, kappa = assert_calibration_prices(
   276	        lambda_bits_per_j=lambda_bits_per_j,
   277	        eta_ref=eta_ref,
   278	        kappa_bits_per_user_step=kappa_value,
   279	    )
   280	    candidate_rows, default_rows = tuple(candidate), tuple(default)
   281	    if horizon_offsets not in {1, 2, FORECAST_OFFSETS}:
   282	        raise MCRLContractError("C2 horizon sensitivity must use the first 1, 2, or 3 offsets")
   283	    if len(candidate_rows) != FORECAST_OFFSETS or len(default_rows) != FORECAST_OFFSETS:
   284	        raise MCRLContractError("C2 requires exactly three candidate and default projections")
   285	    if tuple(row.offset_index for row in candidate_rows) != (1, 2, 3):
   286	        raise MCRLContractError("candidate forecast offsets are not ordered 1,2,3")
   287	    if tuple(row.offset_index for row in default_rows) != (1, 2, 3):
   288	        raise MCRLContractError("default forecast offsets are not ordered 1,2,3")
   289	    alive = True
   290	    core = Fraction()
   291	    lost = 0
   292	    retained: list[OffsetProjection] = []
   293	    for selected, baseline in zip(
   294	        candidate_rows[:horizon_offsets], default_rows[:horizon_offsets], strict=True
   295	    ):
   296	        if not selected.background_power_recomputed or not baseline.background_power_recomputed:
   297	            raise MCRLContractError("C2 projection did not recompute background powers")
   298	        if alive:
   299	            core += (selected.outcome.bits - baseline.outcome.bits) - eta * (
   300	                selected.outcome.joules - baseline.outcome.joules
   301	            )
   302	            retained.append(selected)
   303	            if not selected.valid or not selected.survives:
   304	                alive = False
   305	                lost += 1
   306	        else:
   307	            lost += 1
   308	            retained.append(selected)
   309	    penalty = kappa * lost
   310	    return C2Label(core, lost, penalty, (core - penalty) / kappa, tuple(retained))
