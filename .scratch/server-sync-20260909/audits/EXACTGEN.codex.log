   200	def write_source_shard(path: str | Path, rows: Iterable[SourceRow]) -> SourceShard:
   201	    destination = Path(path)
   202	    material = tuple(rows)
   203	    if not material:
   204	        raise StageCContractError("cannot write an empty source shard")
   205	    payloads = [row.payload() for row in material]
   206	    for payload in payloads:
   207	        _row_from_payload(payload)
   208	    rows_digest = canonical_sha256(payloads)
   209	    header = {
   210	        "schema": SHARD_SCHEMA_VERSION,
   211	        "split": "TRAIN",
   212	        "row_count": len(payloads),
   213	        "rows_sha256": rows_digest,
   214	        "q1_schema_sha256": Q1_SCHEMA_SHA256,
   215	        "q2_schema_sha256": Q2_SCHEMA_SHA256,
   216	        "settings": sorted({row.setting_digest for row in material}),
   217	        "calibrations": sorted({row.calibration_digest for row in material}),
   218	        "source_authority_sha256": canonical_sha256(
   219	            [
   220	                {
   221	                    "code_digest": row.code_digest,
   222	                    "physics_digest": row.physics_digest,
   223	                    "launch_digest": row.launch_digest,
   224	                    "catalogue_digest": row.catalogue_digest,
   225	                    "provider_digest": row.provider_digest,
   226	                    "archive_digest": row.archive_digest,
   227	                    "setting_digest": row.setting_digest,
   228	                    "calibration_digest": row.calibration_digest,
   229	                    "allocation_manifest_digest": row.allocation_manifest_digest,
   230	                }
   231	                for row in material
   232	            ]
   233	        ),
   234	    }
   235	    encoded = b"\n".join(canonical_json_bytes(value) for value in (header, *payloads)) + b"\n"
   236	    file_digest = write_once_with_sha256(destination, encoded)
   237	    return SourceShard(destination, file_digest, rows_digest, material)
