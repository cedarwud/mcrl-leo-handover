def run_zero(anchors) -> dict[str, object]:
    expected = expected_epoch200()
    models = {seed: PayloadModel.load(checkpoint_path(seed, 200, minimal=True)) for seed in SEEDS}
    rows_out = []
    for anchor in anchors:
        base = anchor["built"]["base"]
        rows = anchor["built"]["rows_by_user_action"]
        catalogue = anchor["catalogue"]
        for seed, model in models.items():
            scored = [
                (additive_score(model, rows, base, config), config.configuration_id, config)
                for config in catalogue
            ]
            score, configuration_id, choice = stable_argmax(scored)
            row = {
                "anchor": anchor["anchor_index"],
                "learner_seed": seed,
                "zero_c3_choice_size": choice.changed_users,
                "zero_c3_choice": configuration_id,
                "zero_c3_score": score,
                "observed_full_choice": expected[(anchor["anchor_index"], seed)],
                "same_as_observed_full": configuration_id == expected[(anchor["anchor_index"], seed)],
            }
            rows_out.append(row)
            print(json.dumps({
                "event": "zero-result",
                "anchor": row["anchor"],
                "learner_seed": row["learner_seed"],
                "zero_c3_choice_size": row["zero_c3_choice_size"],
                "same_as_observed_full": row["same_as_observed_full"],
            }), flush=True)
    result = {
        "schema": "mcrl-v025-selector-zero-c3-diagnostic-v1",
        "artifact_label": "DIAGNOSTIC_NOT_CLAIM",
        "rows": rows_out,
        "all_zero_c3_choose_100": all(row["zero_c3_choice_size"] == 100 for row in rows_out),
    }
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / "zero-c3.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii")
    return result


def run_full(pilot, anchors) -> dict[str, object]:
    expected = expected_epoch200()
    models = {
        (seed, epoch): PayloadModel.load(
            checkpoint_path(seed, epoch, minimal=(epoch == 200))
        )
        for seed in SEEDS
        for epoch in EPOCHS
    }
    panel_rows = []
    exact_comparison = []
    reproduction = []
    noop_rows = []
    r3_rows = []
    accounting_rows = []

    for anchor in anchors:
        anchor_index = anchor["anchor_index"]
        base = anchor["built"]["base"]
        evaluator = anchor["built"]["current_evaluator"]
        rows = anchor["built"]["rows_by_user_action"]
        catalogue = anchor["catalogue"]
        grand_by_seed = {
            seed: configuration_from_id(
                pilot, base, expected[(anchor_index, seed)], kind="observed-epoch200-full"
            )
            for seed in SEEDS
        }
        small = tuple(row for row in catalogue if 2 <= row.changed_users <= 6)
        exact = exact_components(pilot, anchor, (*small, *grand_by_seed.values(), base))
        valid_small = [row for row in small if row.configuration_id in exact]
        feasible_small = [row for row in valid_small if bool(exact[row.configuration_id]["service_guard"])]
        best_by_size = {}
        feasible_best_by_size = {}
        for size in range(2, 7):
            candidates = [row for row in valid_small if row.changed_users == size]
            if candidates:
                best_by_size[size] = min(
                    candidates,
                    key=lambda row: (-float(exact[row.configuration_id]["exact_final"]), row.configuration_id),
                )
            feasible_candidates = [row for row in feasible_small if row.changed_users == size]
            if feasible_candidates:
                feasible_best_by_size[size] = min(
                    feasible_candidates,
                    key=lambda row: (-float(exact[row.configuration_id]["exact_final"]), row.configuration_id),
                )

        # Full-path reproduction validates the legacy checkpoint encoder before
        # its predictions are used in the panel diagnostic.
        for seed in SEEDS:
            model = models[(seed, 200)]
            scored = []
            for config in catalogue:
                components = model_components(pilot, model, anchor, config)
                scored.append((components["model_final"], config.configuration_id, config))
            score, chosen_id, chosen = stable_argmax(scored)
            reproduction.append({
                "anchor": anchor_index,
                "learner_seed": seed,
                "replayed_choice": chosen_id,
                "observed_choice": expected[(anchor_index, seed)],
                "match": chosen_id == expected[(anchor_index, seed)],
                "size": chosen.changed_users,
                "score": score,
            })

        panel_configs = {base.assignments: base}
        panel_configs.update({row.assignments: row for row in best_by_size.values()})
        panel_configs.update({row.assignments: row for row in grand_by_seed.values()})
        panel = tuple(sorted(panel_configs.values(), key=lambda row: (row.changed_users, row.configuration_id)))
        panel_exact = exact_components(pilot, anchor, panel)

        for seed in SEEDS:
            exact_scored = [
                (float(panel_exact[row.configuration_id]["exact_final"]), row.configuration_id, row)
                for row in panel
                if row.configuration_id in panel_exact and bool(panel_exact[row.configuration_id]["service_guard"])
            ]
            exact_score, exact_id, exact_choice = stable_argmax(exact_scored)
            learned_scored = []
            for config in panel:
                if config.configuration_id not in panel_exact:
                    continue
                components = model_components(pilot, models[(seed, 200)], anchor, config)
                learned_scored.append((components["model_final"], config.configuration_id, config))
            learned_score, learned_id, learned_choice = stable_argmax(learned_scored)
            grand = grand_by_seed[seed]
            grand_exact = panel_exact.get(grand.configuration_id)
            best_small = min(
                feasible_best_by_size.values(),
                key=lambda row: (-float(panel_exact[row.configuration_id]["exact_final"]), row.configuration_id),
            ) if feasible_best_by_size else None
            best_small_unconstrained = min(
                best_by_size.values(),
                key=lambda row: (-float(panel_exact[row.configuration_id]["exact_final"]), row.configuration_id),
            ) if best_by_size else None
            exact_comparison.append({
                "anchor": anchor_index,
                "learner_seed": seed,
                "panel_size": len(panel),
                "selector_exact_choice_size": exact_choice.changed_users,
                "selector_exact_choice": exact_id,
                "selector_exact_score": exact_score,
                "selector_model_choice_size": learned_choice.changed_users,
                "selector_model_choice": learned_id,
                "selector_model_score": learned_score,
                "grand_valid": grand_exact is not None,
                "grand_service_guard": None if grand_exact is None else grand_exact["service_guard"],
                "grand_exact_score": None if grand_exact is None else grand_exact["exact_final"],
                "best_small_size": None if best_small is None else best_small.changed_users,
                "best_small_exact_score": None if best_small is None else panel_exact[best_small.configuration_id]["exact_final"],
                "best_small_unconstrained_size": None if best_small_unconstrained is None else best_small_unconstrained.changed_users,
                "best_small_unconstrained_exact_score": None if best_small_unconstrained is None else panel_exact[best_small_unconstrained.configuration_id]["exact_final"],
                "best_small_unconstrained_service_guard": None if best_small_unconstrained is None else panel_exact[best_small_unconstrained.configuration_id]["service_guard"],
                "small_strictly_beats_grand": bool(
                    best_small is not None and grand_exact is not None
                    and float(panel_exact[best_small.configuration_id]["exact_final"])
                    > float(grand_exact["exact_final"])
                ),
            })

        for epoch in EPOCHS:
            for seed in SEEDS:
                model = models[(seed, epoch)]
                for config in panel:
                    exact_row = panel_exact.get(config.configuration_id)
                    if exact_row is None:
                        continue
                    panel_rows.append({
                        "anchor": anchor_index,
                        "learner_seed": seed,
                        "epoch": epoch,
                        "configuration_id": config.configuration_id,
                        **exact_row,
                        **model_components(pilot, model, anchor, config),
                    })

        # No-op invariant: exact algebra with a no-op unilateral must be
        # identical; catalogue changed counts must also equal actual changes.
        bookkeeping_mismatches = sum(
            row.changed_users != sum(
                row.mapping[user] != base.mapping[user] for user in sorted(base.mapping)
            )
            for row in catalogue
        )
        probe = best_by_size.get(3) or best_by_size.get(2)
        if probe is not None:
            changed = tuple(user for user in sorted(base.mapping) if probe.mapping[user] != base.mapping[user])
            noop_user = next(user for user in sorted(base.mapping) if user not in changed)
            base_outcome = evaluator.evaluate(base).outcome(phi=pilot.ENGINE._phi_for(base, base))
            probe_outcome = evaluator.evaluate(probe).outcome(phi=pilot.ENGINE._phi_for(base, probe))
            unilateral = {}
            for user in changed:
                mapping = base.mapping
                mapping[user] = probe.mapping[user]
                singleton = pilot.ENGINE._configuration(base, mapping, kind="noop-invariant-singleton")
                evaluator.evaluate_many((singleton,))
                unilateral[user] = evaluator.evaluate(singleton).outcome(
                    phi=pilot.ENGINE._phi_for(base, singleton)
                )
            original_identity = coalition_identity(
                coalition_users=changed,
                reference=base_outcome,
                unilateral_by_user=unilateral,
                coalition=probe_outcome,
                lambda_bits_per_j=float(anchor["calibration"].lambda_bits_per_j),
                eta_ref=float(anchor["calibration"].eta_ref),
                kappa_bits_per_user_s=float(anchor["calibration"].kappa_bits_per_user_step),
            )
            augmented = dict(unilateral)
            augmented[noop_user] = base_outcome
            noop_identity = coalition_identity(
                coalition_users=(*changed, noop_user),
                reference=base_outcome,
                unilateral_by_user=augmented,
                coalition=probe_outcome,
                lambda_bits_per_j=float(anchor["calibration"].lambda_bits_per_j),
                eta_ref=float(anchor["calibration"].eta_ref),
                kappa_bits_per_user_s=float(anchor["calibration"].kappa_bits_per_user_step),
            )
            context = pilot._coalition_context(
                tape=anchor["tape"], step_index=anchor_index, anchor=base,
                selected=probe, rows_by_user_action=rows,
            )
            ref_row = rows[(noop_user, base.mapping[noop_user])]
            noop_member = pilot.CoalitionMember(
                user_id=noop_user,
                reference_action=pilot._physical_action(base.mapping[noop_user]),
                selected_action=pilot._physical_action(base.mapping[noop_user]),
                selected_q1_row=ref_row.q1_state,
                incumbent_q1_row=ref_row.q1_state,
                missing_incumbent=ref_row.outage,
            )
            augmented_context = replace(context, members=(*context.members, noop_member))
            learned_before = models[(SEEDS[0], 200)].interaction(context)
            learned_after = models[(SEEDS[0], 200)].interaction(augmented_context)
            noop_rows.append({
                "anchor": anchor_index,
                "probe_size": len(changed),
                "noop_user": noop_user,
                "physical_psi_before": float(original_identity.c3),
                "physical_psi_after": float(noop_identity.c3),
                "physical_exact_equal": original_identity.c3 == noop_identity.c3,
                "learned_psi_before": learned_before,
                "learned_psi_after_illegal_augmented_context": learned_after,
                "learned_exact_equal": learned_before == learned_after,
                "catalogue_changed_count_mismatches": bookkeeping_mismatches,
            })

            # The production builder issues reference + k singletons + joint.
            class CountingEvaluator:
                def __init__(self, delegate):
                    self.delegate = delegate
                    self.ids = []

                def evaluate(self, config):
                    self.ids.append(config.configuration_id)
                    return self.delegate.evaluate(config)

            counting = CountingEvaluator(evaluator)
            before_physical = evaluator.physical_evaluations
            pilot._coalition_row(
                tape=anchor["tape"], step_index=anchor_index,
                carrier=pilot.ENGINE.REFERENCE_CARRIERS[0], anchor_index=anchor_index,
                anchor=base, selected=probe, evaluator=counting,
                rows_by_user_action=rows, calibration=anchor["calibration"],
                run_setting=anchor["run_setting"],
            )
            accounting_rows.append({
                "anchor": anchor_index,
                "k": len(changed),
                "evaluate_calls": len(counting.ids),
                "distinct_evaluations": len(set(counting.ids)),
                "expected_k_plus_2": len(changed) + 2,
                "new_physical_boundary_evaluations": evaluator.physical_evaluations - before_physical,
            })

        # R3 on the exact-best feasible size 3..6 panels and their pair subsets.
        for size, config in sorted(best_by_size.items()):
            if size < 3:
                continue
            changed = tuple(user for user in sorted(base.mapping) if config.mapping[user] != base.mapping[user])
            pair_configs = []
            for left_index, left in enumerate(changed):
                for right in changed[left_index + 1:]:
                    mapping = base.mapping
                    mapping[left] = config.mapping[left]
                    mapping[right] = config.mapping[right]
                    pair_configs.append(pilot.ENGINE._configuration(base, mapping, kind="selector-diag-r3-pair"))
            pair_exact = exact_components(pilot, anchor, pair_configs)
            pair_sum = math.fsum(float(row["exact_psi"]) for row in pair_exact.values())
            full_psi = float(panel_exact[config.configuration_id]["exact_psi"])
            residual = full_psi - pair_sum
            r3_rows.append({
                "anchor": anchor_index,
                "size": size,
                "psi": full_psi,
                "pair_psi_sum": pair_sum,
                "r3": residual,
                "abs_r3_over_abs_psi": None if full_psi == 0.0 else abs(residual) / abs(full_psi),
                "pair_count": len(pair_configs),
            })

        print(json.dumps({
            "event": "full-anchor-done",
            "anchor": anchor_index,
            "valid_small": len(valid_small),
            "feasible_small": len(feasible_small),
            "best_sizes": sorted(best_by_size),
            "feasible_best_sizes": sorted(feasible_best_by_size),
        }), flush=True)

    # Signed error per pair is meaningful only as a diagnostic normalization;
    # this head predicts one set scalar and is not itself pairwise-additive.
    epoch200 = [row for row in panel_rows if row["epoch"] == 200 and row["size"] >= 2]
    per_pair_errors = [
        (float(row["model_psi"]) - float(row["exact_psi"]))
        / (int(row["size"]) * (int(row["size"]) - 1) / 2)
        for row in epoch200
    ]
    mean_bias = math.fsum(per_pair_errors) / len(per_pair_errors)
    bias = {
        "epoch": 200,
        "observations": len(per_pair_errors),
        "mean_signed_error_per_pair": mean_bias,
        "implied_error_k2": mean_bias,
        "implied_error_k100": mean_bias * 4950,
        "bias_alone_favours": "k=100" if mean_bias > 0 else "empty/singleton" if mean_bias < 0 else "none",
    }
    result = {
        "schema": "mcrl-v025-selector-full-diagnostic-v1",
        "artifact_label": "DIAGNOSTIC_NOT_CLAIM",
        "model_reproduction": reproduction,
        "panel_comparisons": exact_comparison,
        "score_components": panel_rows,
        "bias_accumulation": bias,
        "noop_invariant": noop_rows,
        "label_accounting": accounting_rows,
        "r3": r3_rows,
        "small_strictly_beats_grand_any": any(row["small_strictly_beats_grand"] for row in exact_comparison),
        "small_strictly_beats_grand_count": sum(row["small_strictly_beats_grand"] for row in exact_comparison),
        "reproduction_matches": sum(row["match"] for row in reproduction),
    }
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / "full.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii")
    return result


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--phase", choices=("zero", "full", "all"), default="all")
    args = parser.parse_args(argv)
    pilot = _load_pilot()
    anchors = build_anchors(pilot)
    if args.phase in {"zero", "all"}:
        result = run_zero(anchors)
        print(json.dumps({"event": "complete", "phase": "zero", "all_choose_100": result["all_zero_c3_choose_100"]}), flush=True)
    if args.phase in {"full", "all"}:
        result = run_full(pilot, anchors)
        print(json.dumps({
            "event": "complete", "phase": "full",
            "small_beats_grand_count": result["small_strictly_beats_grand_count"],
            "reproduction_matches": result["reproduction_matches"],
        }), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
