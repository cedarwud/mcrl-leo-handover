+            ("interaction RMSE", fmt(ab["full_interaction_rmse"]), fmt(ab["member_only_interaction_rmse"]), fmt(ab["interaction_rmse_difference"])),
+            ("ADDITIVE mean selection regret", fmt(ab["full_additive_mean_regret"]), fmt(ab["member_only_additive_mean_regret"]), fmt(ab["selection_regret_difference"])),
+        ],
