        domain=domain,
        provider=pilot.LegacyWorldProvider(role="c1-target-probe"),
        steps=max(args.steps, args.anchors + 4),
        start_time_s=0.0,
    )
    calibration = pilot._pilot_calibration(tape, setting, run_setting)
    print(json.dumps({"event": "tape", "wall_s": time.perf_counter() - started}), flush=True)

    kappa = calibration.kappa_bits_per_user_step
    eta = calibration.eta_ref
    records: list[dict[str, object]] = []
    carrier = pilot.ENGINE.REFERENCE_CARRIERS[0]

    for step_index in range(args.anchors):
        anchor_started = time.perf_counter()
        built = pilot._build_anchor_rows(
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step_index=step_index,
            carrier=carrier,
            anchor_index=step_index * len(pilot.ENGINE.REFERENCE_CARRIERS),
            include_coalition=False,
        )
        base = built["base"]
        incumbent = built["incumbent"]
        by_user, configs, _census = pilot._action_configs(
            tape, step_index, base, run_setting, full_legal=False
        )
        # A fresh evaluator so the reference and every candidate go through the
        # SAME dense ``evaluate_many`` path.  ``built["current_evaluator"]`` has
        # already cached the reference through the per-config ``evaluate`` path
        # (run_v025_pilot_c3.py:396), and the two paths do not agree bit-for-bit;
        # mixing them puts a constant offset into every unilateral label.
        evaluator = pilot.ENGINE.StepEvaluator(
            tape, setting, step_index, transition_from=incumbent,
            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
            field="nominal", counter=pilot.ENGINE.EvaluationCounter(),
            run_setting=run_setting, boundary_indices=(0,),
        )
        material = tuple({c.assignments: c for c in configs.values()}.values())
        evaluator.evaluate_many((base, *material))
        base_profile = evaluator.evaluate(base)
        single_path_base_bits = float(built["current_evaluator"].evaluate(base).bits)
        path_gap = (float(base_profile.bits) - single_path_base_bits) / float(kappa)
        base_bits = dict(base_profile.score.bits)
        base_total = Fraction(str(base_profile.bits))
        base_joules = Fraction(str(base_profile.joules))
        phi_base = pilot.ENGINE._phi_for(incumbent, base)

        for user in sorted(by_user):
            for identity in by_user[user]:
                config = configs[(user, identity)]
                if config.configuration_id in evaluator._invalid:
                    continue
                profile = evaluator.evaluate(config)
                bits = dict(profile.score.bits)
                own = (Fraction(str(bits.get(user, 0.0))) - Fraction(str(base_bits.get(user, 0.0)))) / kappa
                total = (Fraction(str(profile.bits)) - base_total) / kappa
                ext = total - own
                energy = -eta * (Fraction(str(profile.joules)) - base_joules) / kappa
                phi = pilot.ENGINE._phi_for(incumbent, config) - phi_base
                row = built["rows_by_user_action"].get((user, identity))
                records.append({
                    "anchor": step_index,
                    "user": int(user),
                    "identity": None if identity is None else list(identity),
                    "is_base_action": identity == base.mapping[user],
                    "own": float(own),
                    "ext": float(ext),
                    "bits_total": float(total),
                    "energy": float(energy),
                    "phi": float(phi),
                    "y": float(total + energy + phi),
                    "surrogate_y": None if row is None else float.fromhex(row.c1_label_normalized_hex),
                    "q1_state": None if row is None else list(row.q1_state),
                    "q2_state": None if row is None else list(row.q2_state),
                    "surrogate_c2": None if row is None else float.fromhex(row.c2_label_normalized_hex),
                })
        print(json.dumps({
            "event": "anchor",
            "anchor": step_index,
            "records": len(records),
            "evaluate_vs_evaluate_many_gap_over_kappa": path_gap,
            "wall_s": time.perf_counter() - anchor_started,
        }), flush=True)

    payload = {
        "schema": "c1c2-target-design-production-probe-v1",
        "note": "DIAGNOSTIC_NOT_CLAIM; exact c1_difference_surplus identity per unilateral action",
        "world": domain,
        "carrier": carrier,
        "kappa": float(kappa),
        "eta": float(eta),
        "records": records,
    }
    path = OUT / "production-c1.json"
    path.write_text(json.dumps(payload))
    print(json.dumps({"event": "written", "path": str(path), "records": len(records)}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
