+            (name, values["anchors"], values["rows"], f"`{values['size_histogram']}`")
+            for name, values in result["corpus"]["partitions"].items()
+        ],
+    )
+    lines.extend(
+        [
+            "",
+            "## Estimator and feature control",
+            "",
+            f"Estimator: `{result['estimator']['family']}`. Grid: `{result['estimator']['grid']}`. Each component chose hyperparameters only by validation RMSE; final refits used train+validation.",
+            "",
+        ]
+    )
+    table(
+        lines,
+        ("component", "width", "ridge", "validation RMSE"),
+        [
+            (name, choice["width"], choice["ridge"], fmt(choice["validation_rmse"]))
+            for name, choice in result["estimator"]["chosen"].items()
+        ],
+    )
+    lines.extend(
+        [
+            "",
+            f"Feature information is matched at the arm level. DIRECT and ADDITIVE's interaction head both receive the same {FULL_SET_WIDTH}-D vector: the existing {BASE_CONTEXT_WIDTH}-D invariant set context plus the same {Q1_WIDTH + PER_USER_BANK_WIDTH}-D summed per-user deviation bank used by the additive head. The per-user head itself does not see {FULL_SET_WIDTH - MEMBER_ONLY_SET_WIDTH} resource-context coordinates (affected-beam pooling, pairwise cross-gains, and globals); ADDITIVE's interaction head does. That is the sealed decomposition's architecture, not an information advantage over DIRECT.",
+            "",
+            "The predeclared member-only ablation quantifies those resource coordinates:",
+            "",
+        ]
+    )
+    ab = result["context_ablation"]
+    table(
+        lines,
+        ("quantity", "full context", "member-only", "full minus member-only"),
+        [
+            ("interaction RMSE", fmt(ab["full_interaction_rmse"]), fmt(ab["member_only_interaction_rmse"]), fmt(ab["interaction_rmse_difference"])),
+            ("ADDITIVE mean selection regret", fmt(ab["full_additive_mean_regret"]), fmt(ab["member_only_additive_mean_regret"]), fmt(ab["selection_regret_difference"])),
+        ],
+    )
+    lines.extend(["", "## Held-out selection regret", ""])
+    order = (
+        "CONSTANT",
+        "ADDITIVE",
+        "DIRECT",
+        "EXACT_ADDITIVE_LEARNED_INTERACTION",
+        "LEARNED_ADDITIVE_EXACT_INTERACTION",
+        "ORACLE",
+    )
+    table(
+        lines,
+        ("predictor", "mean", "median", "p95", "choice differs", "selection sizes"),
+        [
+            (
+                name,
+                fmt(result["predictors"][name]["selection"]["mean"]),
+                fmt(result["predictors"][name]["selection"]["median"]),
+                fmt(result["predictors"][name]["selection"]["p95"]),
+                f"{result['predictors'][name]['selection']['differs_fraction']:.2%}",
+                f"`{result['predictors'][name]['selection']['selection_size_histogram']}`",
+            )
+            for name in order
+        ],
+    )
+    lines.extend(
+        [
+            "",
+            f"Exact-winner size distribution: `{direct['selection']['exact_winner_size_histogram']}`.",
+            "",
+            "### Selection regret by selected coalition size",
+            "",
+        ]
+    )
+    selected_sizes = sorted(
+        {
+            int(size)
+            for name in order
+            for size in result["predictors"][name]["selection"]["by_selected_size"]
+        }
+    )
+    size_rows = []
+    for name in order:
+        for size in selected_sizes:
+            value = result["predictors"][name]["selection"]["by_selected_size"].get(str(size))
+            if value is not None:
+                size_rows.append(
+                    (name, size, value["n"], fmt(value["mean"]), fmt(value["median"]), fmt(value["p95"]), f"{value['differs_fraction']:.2%}")
+                )
+    table(lines, ("predictor", "selected k", "n", "mean", "median", "p95", "differs"), size_rows)
+    lines.extend(["", "## Held-out value error", ""])
+    table(
+        lines,
+        ("predictor", "explained variance", "RMSE"),
+        [
+            (name, fmt(result["predictors"][name]["value"]["explained_variance"]), fmt(result["predictors"][name]["value"]["rmse"]))
+            for name in order
+        ],
+    )
+    lines.extend(["", "### Value error by coalition size", ""])
+    value_rows = []
+    for name in order:
+        for size, value in result["predictors"][name]["value_by_size"].items():
+            value_rows.append((name, size, value["n"], fmt(value["explained_variance"]), fmt(value["rmse"])))
+    table(lines, ("predictor", "k", "n", "explained variance", "RMSE"), value_rows)
+    amp = result["additive_amplification"]
+    lines.extend(
+        [
+            "",
+            "## ADDITIVE realised amplification",
+            "",
+            f"On held-out rows, additive-part error RMSE is {amp['additive_error_rmse']:.6f}; interaction-part error RMSE is {amp['interaction_error_rmse']:.6f}; their Pearson correlation is {amp['error_correlation']:.6f}. Opposite error signs occur in {amp['opposite_sign_fraction']:.2%} of rows. The combined-error RMSE is {amp['joint_error_rmse']:.6f}, or {amp['cancellation_factor']:.6f} times the root-sum-square component error. A value below one means realised error cancellation.",
+            "",
+            f"RMS-relative error is {amp['additive_relative_error']:.6f} for the additive part, {amp['interaction_relative_error']:.6f} for the interaction part, and {amp['joint_relative_error']:.6f} for their sum. Thus the realised relative error of the sum is {amp['relative_amplification_vs_additive']:.6f} times the additive part's relative error. Median rowwise absolute relative errors (excluding exact magnitudes <=1e-8) are {amp['additive_rowwise_relative_median']:.6f}, {amp['interaction_rowwise_relative_median']:.6f}, and {amp['joint_rowwise_relative_median']:.6f}, respectively.",
+            "",
+        ]
+    )
+    if amp["cancellation_factor"] < 0.8:
+        lines.append("The component errors cancel materially; the review's conditioning objection is weaker on these realised fits than an independence assumption would imply.")
+    elif amp["cancellation_factor"] < 1.0:
+        lines.append("The component errors cancel somewhat, but not enough to remove the observed amplification at the joint decision.")
+    else:
+        lines.append("The component errors do not cancel in aggregate; they reinforce or behave worse than an uncorrelated root-sum-square benchmark.")
+    lines.extend(["", "## Out-of-support behaviour", ""])
+    lines.append(f"Final training size support was `{result['out_of_support']['training_size_support']}`.")
+    lines.append("")
+    table(
+        lines,
+        ("arm", "OOS selections", "fraction", "selected-value RMSE there", "mean regret there", "OOS test-row RMSE"),
+        [
+            (
+                name,
+                result["predictors"][name]["selection"]["outside_training_support"]["count"],
+                f"{result['predictors'][name]['selection']['outside_training_support']['fraction']:.2%}",
+                fmt(result["predictors"][name]["selection"]["outside_training_support"]["selected_value_error_rmse"]),
+                fmt(result["predictors"][name]["selection"]["outside_training_support"]["selection_regret_mean"]),
+                fmt(result["predictors"][name]["out_of_support_test_rows"]["rmse"]),
+            )
