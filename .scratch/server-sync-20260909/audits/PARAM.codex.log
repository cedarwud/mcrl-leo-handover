ROOT = Path(__file__).resolve().parents[1]
PILOT = ROOT / "scripts/run_v025_pilot_c3.py"
OUT = ROOT / ".scratch/c1c2-target-design"


def load_pilot():
    spec = importlib.util.spec_from_file_location("c1_target_probe_pilot", PILOT)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {PILOT}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def identity_of(action) -> tuple[int, int] | None:
    if action.norad_id is None:
        return None
    return (int(action.norad_id), int(action.beam_chain_id))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--anchors", type=int, default=6)
    parser.add_argument("--steps", type=int, default=12)
    args = parser.parse_args(argv)

