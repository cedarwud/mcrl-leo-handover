                            for pair_users, value in pair_terms
                        ],
                    }
                receipt = {
                    "schema": f"{SCHEMA}-family-index-row-v1",
                    "artifact_label": LABEL,
                    "world_id": domain,
                    "anchor_index": anchor_index,
                    "anchor_id": coalition_row.anchor_id,
                    "configuration_id": config.configuration_id,
                    "coalition_row_sha256": canonical_sha256(coalition_row.payload()),
                    "coalition_size": len(label.users),
                    "families": families,
                    "mechanisms": mechanisms,
                    "label_convention": "EXACT_SINGLETON_DIFFERENCES",
                    "required_distinct_label_evaluations": len(label.users) + 2,
                    "observed_distinct_label_evaluations": label.distinct_evaluation_count,
                    "exact_objective_receipt": {
                        "encoding": "fraction-numerator-denominator",
                        "baseline": _fraction_receipt(label.baseline),
                        "singletons": [
                            {
                                "user": user,
                                "value": _fraction_receipt(value),
                                "difference": _fraction_receipt(
                                    dict(label.singleton_differences)[user]
                                ),
                            }
                            for user, value in label.singleton_values
                        ],
                        "coalition": _fraction_receipt(label.coalition_value),
                        "objective_delta": _fraction_receipt(label.objective_delta),
                        "psi": _fraction_receipt(label.psi),
                    },
                    "evaluation_cache_keys": {
                        "baseline": receipt_cache.key(anchor.mapping),
                        "singletons": [
                            {"user": user, "key": receipt_cache.key({**anchor.mapping, user: selected[user]})}
                            for user in label.users
                        ],
                        "coalition": receipt_cache.key(selected),
                    },
                    "r3": r3_payload,
                }
                anchor_rows.append(coalition_row)
                anchor_family_records.append(receipt)
                size_histogram[len(label.users)] += 1
                for family in families:
                    family_histogram[family] += 1
                    family_size_histogram[family][len(label.users)] += 1
                    family_psi_values[family].append(normalized_psi)
                if PAIR_CATALOGUE in families:
                    same = (
                        old_payload["psi_normalized_hex"] == coalition_row.psi_normalized_hex
                        and old_payload["objective_delta_normalized_hex"] == coalition_row.objective_delta_normalized_hex
                    )
                    if same:
                        old_pair_exact_matches += 1
                    else:
                        old_pair_mismatches.append({
                            "world": world_number, "anchor": anchor_index,
                            "old_psi": old_payload["psi_normalized_hex"], "new_psi": coalition_row.psi_normalized_hex,
                            "old_delta": old_payload["objective_delta_normalized_hex"],
                            "new_delta": coalition_row.objective_delta_normalized_hex,
                        })

            baseline_value = cache.value(anchor.mapping)
            if nested_block is not None:
                alternatives = best_alternatives(anchor.mapping, legal_actions)
                block_values = {}
                block_mappings = {}
                for mask in range(1 << len(nested_block)):
                    mapping = dict(anchor.mapping)
                    for offset, user in enumerate(nested_block):
                        if mask & (1 << offset):
                            mapping[user] = alternatives[user]
                    value = cache.value(mapping)
                    block_values[mask] = value
                    block_mappings[mask] = mapping
                for mask, value in block_values.items():
                    mobius = sum(
                        (-1 if (mask.bit_count() - subset.bit_count()) % 2 else 1)
                        * block_values[subset]
                        for subset in range(mask + 1)
                        if subset & mask == subset
                    )
                    nested_observations.append({
                        "schema": f"{SCHEMA}-nested-scalar-observation-v1",
                        "artifact_label": LABEL, "world_id": domain, "anchor_index": anchor_index,
                        "block": list(nested_block), "mask": mask, "mask_width": len(nested_block),
                        "objective_value_normalized_hex": float_hex(float(value / normalization_kappa)),
                        "objective_delta_normalized_hex": float_hex(float((value - baseline_value) / normalization_kappa)),
                        "mobius_coefficient_normalized_hex": float_hex(float(mobius / normalization_kappa)),
                        "evaluation_cache_key": cache.key(block_mappings[mask]),
                    })
            if not anchor_rows:
                raise RuntimeError("anchor produced no valid coalition rows")
            shard_path = output / "rows" / f"world-{world_number}" / f"{LABEL}-mechanism-anchor-{anchor_index:03d}.jsonl"
            shard = write_coalition_shard(shard_path, anchor_rows)
            shard_paths.append({"path": str(shard_path.relative_to(output)), "sha256": shard.file_sha256, "rows": len(anchor_rows)})
            family_rows.extend(anchor_family_records)
            coalitions_per_anchor.append(len(anchor_rows))
            total_cache_requests += cache.requests
            total_cache_hits += cache.hits
            total_physical += evaluator.physical_evaluations
            global_anchor += 1
            print(json.dumps({"event": "anchor-complete", "world": world_number, "anchor": anchor_index, "coalitions": len(anchor_rows)}), flush=True)
        if anchor_limit is not None and global_anchor >= anchor_limit:
            break

    family_digest = _write_jsonl(
        output / f"{LABEL}-family-index.jsonl",
        {"schema": f"{SCHEMA}-family-index-v1", "artifact_label": LABEL, "row_count": len(family_rows)},
        family_rows,
    )
    nested_digest = _write_jsonl(
        output / f"{LABEL}-nested-scalar-observations.jsonl",
        {"schema": f"{SCHEMA}-nested-scalar-observations-v1", "artifact_label": LABEL, "row_count": len(nested_observations)},
        nested_observations,
    )
    r3_summary = _quantiles(r3_values)
    r3_summary.update({
        "count": len(r3_values),
        "fraction_abs_gt_1e-6": float(np.mean(np.abs(r3_values) > 1e-6)) if r3_values else None,
        "fraction_abs_gt_1e-3": float(np.mean(np.abs(r3_values) > 1e-3)) if r3_values else None,
    })
    summary = {
        "schema": f"{SCHEMA}-manifest-v1", "artifact_label": LABEL,
        "claim_status": "PILOT_NOT_CLAIM", "anchors": global_anchor,
        "coalition_rows": sum(size_histogram.values()),
        "size_histogram": {str(key): size_histogram[key] for key in sorted(size_histogram)},
        "family_histogram_unique_rows": {key: family_histogram[key] for key in sorted(family_histogram)},
        "family_size_histogram": {
            family: {str(size): counts[size] for size in sorted(counts)}
            for family, counts in sorted(family_size_histogram.items())
        },
        "coalitions_per_anchor": _quantiles(coalitions_per_anchor),
        "occupancy_activation_anchors_trainable": len(occupancy_trainable_anchors),
        "occupancy_2_diminishing_anchors": len(occupancy_2_anchors),
        "family_psi_normalized_distributions": {
            family: {
                **_quantiles(values),
                "count": len(values),
                "negative_count": sum(value < 0.0 for value in values),
                "zero_count": sum(value == 0.0 for value in values),
                "positive_count": sum(value > 0.0 for value in values),
            }
            for family, values in sorted(family_psi_values.items())
        },
        "nested_blocks": len(nested_observations) // 64,
        "nested_scalar_observations": len(nested_observations),
        "nested_mobius_coefficients": len(nested_observations),
        "nested_nontrivial_residual_label_occurrences": (len(nested_observations) // 64) * 57,
        "nested_independence_statement": "64 scalar observations per six-user block; the 57 non-trivial residual labels are not 57 independent measurements",
        "label_convention": "EXACT_SINGLETON_DIFFERENCES",
        "label_evaluation_rule": "size k uses k+2 distinct configurations: baseline, k exact singletons, coalition",
        "evaluation_cache_key_axes": ["anchor", "context", "proposed_actions", "evaluator_configuration"],
        "evaluation_cache_requests": total_cache_requests, "evaluation_cache_hits": total_cache_hits,
        "physical_evaluations": total_physical, "invalid_proposals": invalid_proposals,
        "old_pair_rows_expected": global_anchor, "old_pair_exact_matches": old_pair_exact_matches,
        "old_pair_mismatches": old_pair_mismatches, "r3_normalized_distribution": r3_summary,
        "shards": shard_paths,
        "family_index_sha256": family_digest,
        "nested_scalar_observations_sha256": nested_digest,
        "code_digest": pilot.CODE_DIGEST, "physics_digest": pilot.PHYSICS_DIGEST,
        "calibration_digest": calibration.digest, "elapsed_wall_s": time.perf_counter() - started,
    }
    if world_limit is None and anchor_limit is None:
        if summary["coalition_rows"] < 3_000:
            raise RuntimeError("full corpus did not reach the several-thousand-row target")
        if set(summary["size_histogram"]) != {"2", "3", "4", "5", "6"}:
            raise RuntimeError("full corpus did not cover every coalition size 2 through 6")
        if min(coalitions_per_anchor) < 2:
            raise RuntimeError("full corpus lost within-anchor coalition variation")
    manifest_digest = write_once_with_sha256(
        output / f"{LABEL}-manifest.json", canonical_json_bytes(summary) + b"\n"
    )
    summary["manifest_sha256"] = manifest_digest
    return summary


def write_report(path: Path, summary: Mapping[str, object], output: Path) -> None:
    histogram = summary["size_histogram"]
    r3 = summary["r3_normalized_distribution"]
    material = bool(r3["fraction_abs_gt_1e-3"] and r3["fraction_abs_gt_1e-3"] >= 0.05)
    try:
        output_display = output.resolve().relative_to(ROOT)
    except ValueError:
        output_display = output.resolve()
    lines = [
        "# Coalition corpus — 2026-09-09",
        "",
        f"**New trainable coalition-size histogram: {histogram}. Occupancy-activation is admitted by {summary['occupancy_activation_anchors_trainable']} of {summary['anchors']} anchors.**",
        "",
        "`PILOT_NOT_CLAIM`",
        "",
        "## Outcome",
        "",
        f"Generated {summary['coalition_rows']} exact interaction rows across {summary['anchors']} anchors, versus the audited 180-row baseline: {summary['coalition_rows'] / 180.0:.2f}x as many coalition rows. Against 176,223 per-user rows, the interaction ratio improved from about 1:979 to 1:{176223 / summary['coalition_rows']:.1f}. Coalitions per anchor have distribution {summary['coalitions_per_anchor']}. Family counts over unique rows are {summary['family_histogram_unique_rows']}.",
        "",
        f"The authenticated corpus is `{output_display}`. It contains {len(summary['shards'])} learner-readable v2 coalition shards, a family index, a nested-mask scalar-observation ledger, and the manifest. The corpus remains `PILOT_NOT_CLAIM`.",
        "",
        "## Family coverage",
        "",
        f"- `pair-catalogue`: {summary['family_histogram_unique_rows'].get(PAIR_CATALOGUE, 0)} rows. All {summary['old_pair_rows_expected']} archived one-per-anchor action selections were reconstructed unchanged, so the old design points remain a configuration subset. Under the single canonical exact evaluator/cache used for every family, {summary['old_pair_exact_matches']} labels match both archived interaction and objective delta bit-for-bit and {len(summary['old_pair_mismatches'])} differ. The mismatches are retained in the manifest: the legacy artifacts used a call-order-dependent primitive evaluator path, so their action selections are comparable but their old labels are not reused as exact targets.",
        f"- `occupancy-activation`: {summary['family_histogram_unique_rows'].get(OCCUPANCY_ACTIVATION, 0)} trainable rows across {summary['occupancy_activation_anchors_trainable']} anchors, by changed-user size {summary['family_size_histogram'].get(OCCUPANCY_ACTIVATION, {})}. Every seed beam starts at occupancy exactly 1 and two legal arrivals take it to occupancy 3. The exact activation core is retained as a pair; where a legal outside action exists, a three-change context probe adds a third changed user so the learner directly sees third-order variation around the same activation. The first activating occupancy is recomputed from `q10(elevation) * Gamma(n)` using the full Rician×shadow distribution and the engine tables at the weakest actual link elevation among incumbents and selected arrivals. The numerical rule is deterministic: 192-point Gauss–Hermite integration of the Rician×shadow CDF followed by a 60-step bisection root solve, authenticated at the 10-degree value `q10 = 0.42923539`; the lowest threshold remains `0.7174947935658479`. Its exact-Psi sign/distribution ledger is {summary['family_psi_normalized_distributions'].get(OCCUPANCY_ACTIVATION, {})}.",
        f"- `occupancy-2-diminishing`: {summary['family_histogram_unique_rows'].get(OCCUPANCY_2_DIMINISHING, 0)} rows across {summary['occupancy_2_diminishing_anchors']} anchors, kept separate from occupancy activation. These start at occupancy 2 and add two users, so the first arrival crosses occupancy 3 and the second exposes the corrected diminishing population. Its exact-Psi sign/distribution ledger is {summary['family_psi_normalized_distributions'].get(OCCUPANCY_2_DIMINISHING, {})}.",
        f"- `aggressor-relief`: {summary['family_histogram_unique_rows'].get(AGGRESSOR_RELIEF, 0)} rows. Per admitting anchor, the victim with greatest top-three nominal cross-gain burden and its top two/top three contributors move to their own first different legal action in the sealed shortlist, yielding sizes 3 and 4.",
        f"- `beam-evacuation`: {summary['family_histogram_unique_rows'].get(BEAM_EVACUATION, 0)} rows. Every beam with 2 or 3 occupants is evacuated when every occupant has a different legal alternative. This selection uses occupancy and legal-action identity only; it consults no decode threshold.",
        f"- `nested-subsets`: {summary['family_histogram_unique_rows'].get(NESTED_SUBSETS, 0)} unique rows across {summary['nested_blocks']} six-user blocks. Each block has all 64 subset masks evaluated and all 64 Möbius coefficients emitted, giving 57 non-trivial residual-label occurrences. These are **64 scalar observations, not 57 independent measurements**.",
        "",
        "## Exact-label convention and cache",
        "",
        "Every size-`k` interaction row uses `k + 2` distinct sealed-objective configurations: the anchor baseline, each of the `k` singleton action changes evaluated exactly, and the joint coalition. Each family-index row carries the exact numerator/denominator receipt for all of those values and the residual. The implemented convention is **exact singleton differences**; no learned singleton estimate enters any label. Consequently the target is the interaction itself, not interaction plus singleton-model error.",
        "",
        "The cache key is a canonical SHA-256 over four complete axes: (1) anchor identity and assignments (world, seed, step, carrier, anchor configuration), (2) context (objective convention, transition configuration, rekeyed users), (3) the complete proposed-action assignment, and (4) evaluator configuration (engine schema, setting/run-setting digest, nominal field, boundary set, physics digest, calibration digest). This explicitly includes the anchor, context, proposed actions, and evaluator configuration. Once an anchor baseline and its exact singleton action values are cached, an additional coalition label costs one new joint evaluation; the R3 audit separately requires its pair configurations. Cache requests/hits were " + f"{summary['evaluation_cache_requests']}/{summary['evaluation_cache_hits']}; physical configuration evaluations including the order audit were {summary['physical_evaluations']}.",
        "",
        "## Order audit",
        "",
        "For every valid coalition of size at least three, the audit computed exact pair interactions under the same proposed member actions and then `R3(A) = Psi(A) - Σ_{pairs⊂A} Psi(pair)`. In normalized units the distribution is " + f"{r3}. As a descriptive scale check (not an acceptance rule), `|R3| > 1e-3` occurs in " + f"{100.0 * r3['fraction_abs_gt_1e-3']:.2f}% of rows; this is **{'material' if material else 'not material'}** for model specification. " + ("A pairwise-only interaction model is therefore misspecified for this corpus." if material else "This audit does not establish material pairwise misspecification at that scale."),
        "",
        "## Integrity and invariants",
        "",
        f"The manifest digest is `{summary['manifest_sha256']}`; family index `{summary['family_index_sha256']}`; nested observations `{summary['nested_scalar_observations_sha256']}`. Invalid proposed configurations skipped after exact evaluation: {summary['invalid_proposals']}.",
        "",
        "No threshold, sign, seed, horizon, price, service guard, or acceptance rule was changed. The generator expands only which exact sealed-objective coalitions are labeled. No encoder feature is used to compute a label.",
    ]
    write_once_with_sha256(path, ("\n".join(lines) + "\n").encode("utf-8"))


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=DEFAULT_SOURCE)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
    parser.add_argument("--world-limit", type=int)
    parser.add_argument("--anchor-limit", type=int)
    args = parser.parse_args(argv)
    if args.output.exists() or args.report.exists():
        raise SystemExit("refusing to overwrite an existing corpus or report")
    summary = generate(
        source=args.source, output=args.output,
        world_limit=args.world_limit, anchor_limit=args.anchor_limit,
    )
    write_report(args.report, summary, args.output)
    print(json.dumps({"status": "COMPLETE", "summary": summary, "report": str(args.report)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

