+def main() -> int:
+    enforce_resources()
+    started = time.perf_counter()
+    pilot = load_module("interaction_scale_pilot", PILOT_PATH)
+    q1v2 = load_module("interaction_scale_q1v2", Q1V2_PATH)
+    cal = calibration(pilot)
+    checkpoints = discover_latest_checkpoints()
+    if not checkpoints:
+        raise RuntimeError("no checkpoints found")
+    observations = []
+    anchor_receipts = []
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    for world_index, domain in enumerate(WORLDS, 1):
+        tape_path = TAPE_ROOT / f"world-{world_index}-steps-8.pickle"
+        tape = pickle.loads(tape_path.read_bytes())
+        if tape.domain != domain or len(tape.steps) != 8:
+            raise RuntimeError(f"cached development tape identity drifted: {tape_path}")
+        for step_index in STEPS:
+            anchor_started = time.perf_counter()
+            anchor_id = f"{domain}:step/{step_index}"
+            built = pilot._build_anchor_rows(
+                tape=tape, setting=setting, run_setting=run_setting, calibration=cal,
+                step_index=step_index, carrier="nearest-eligible",
+                anchor_index=(world_index - 1) * len(STEPS) + step_index,
+                include_coalition=False, full_legal_actions=True,
+            )
+            base, incumbent = built["base"], built["incumbent"]
+            rows_v1 = built["rows_by_user_action"]
+            rows_v2, elevation_error = v2_rows(q1v2, pilot, tape, step_index, rows_v1)
+            catalogue, _census = pilot.ENGINE._catalogue_with_census(
+                tape, step_index, base, setting=setting, calibration=cal,
+                run_setting=run_setting,
+            )
+            context_configs = tuple(config for config in catalogue if config.changed_users >= 2)
+            contexts_v1 = {
+                config.configuration_id: pilot._coalition_context(
+                    tape=tape, step_index=step_index, anchor=base, selected=config,
+                    rows_by_user_action=rows_v1,
+                ) for config in context_configs
+            }
+            contexts_v2 = {
+                config.configuration_id: pilot._coalition_context(
+                    tape=tape, step_index=step_index, anchor=base, selected=config,
+                    rows_by_user_action=rows_v2,
+                ) for config in context_configs
+            }
+            if {len(value.invariant_vector(member_width=38)) for value in contexts_v1.values()} != {240}:
+                raise RuntimeError(f"{anchor_id}: V1 coalition width drifted")
+            if {len(value.invariant_vector(member_width=36)) for value in contexts_v2.values()} != {236}:
+                raise RuntimeError(f"{anchor_id}: V2 coalition width drifted")
+            exact_context = pilot._exact_interactions(
+                base, incumbent, context_configs, built["current_evaluator"], cal
+            )
+            catalogue = tuple(
+                config for config in catalogue
+                if config.configuration_id not in built["current_evaluator"]._invalid
+            )
+            exact_psi = {config.configuration_id: 0.0 for config in catalogue}
+            exact_psi.update({cid: row["psi"] for cid, row in exact_context.items() if cid in exact_psi})
+            exact_stat = interaction_stats(exact_psi)
+            before = len(observations)
+            for checkpoint in checkpoints:
+                observations.append(checkpoint_anchor_scores(
+                    checkpoint, pilot, base, catalogue, rows_v1, rows_v2,
+                    contexts_v1, contexts_v2, exact_psi, anchor_id,
+                ))
+            anchor_receipts.append({
+                "anchor_id": anchor_id, "world_index": world_index, "step_index": step_index,
+                "carrier": "nearest-eligible", "catalogue_rows": len(catalogue),
+                "context_rows": len(context_configs), "exact_psi": exact_stat,
+                "q1_v2_max_elevation_crosscheck_error_deg": elevation_error,
+                "tape_path": str(tape_path), "tape_sha256": sha256(tape_path),
+                "wall_s": time.perf_counter() - anchor_started,
+            })
+            print(
+                f"PROGRESS anchor {len(anchor_receipts)}/{len(WORLDS)*len(STEPS)} "
+                f"id={anchor_id} rows={len(catalogue)} contexts={len(context_configs)} "
+                f"observations={len(observations)-before} peak_rss_mib={peak_rss_bytes()/2**20:.1f}",
+                flush=True,
+            )
+        del tape
+        gc.collect()
+    peak_mib = peak_rss_bytes() / 2**20
+    if peak_rss_bytes() >= RSS_CAP_BYTES:
+        raise MemoryError("peak RSS reached the 4 GB cap")
+    payload = {
+        "schema": "mcrl-v025-interaction-scale-development-diagnostic-v1",
+        "claim_ceiling": "DESIGN_PHASE_DIAGNOSTIC_NOT_CLAIM",
+        "computes_ee": False,
+        "checkpoints": [
+            {"run": item.run, "seed": item.seed, "epoch": item.epoch,
+             "path": str(item.path), "sha256": item.sha256}
+            for item in checkpoints
+        ],
+        "anchors": anchor_receipts,
+        "observations": observations,
+        "method": {
+            "diagnostic_source": str(Path(__file__).resolve()),
+            "diagnostic_source_sha256": sha256(Path(__file__).resolve()),
+            "pilot_source": str(PILOT_PATH), "pilot_source_sha256": sha256(PILOT_PATH),
+            "q1_v2_source": str(Q1V2_PATH), "q1_v2_source_sha256": sha256(Q1V2_PATH),
+            "calibration": str(CALIBRATION_PATH), "calibration_sha256": sha256(CALIBRATION_PATH),
+            "checkpoint_rule": "latest complete cadence checkpoint per seed present at process start",
+            "exact_psi": "pilot._exact_interactions on every changed_users>=2 catalogue row; structural zero on unchanged/singleton rows",
+            "selection": "stable max score with lexicographically minimum configuration_id tie-break",
+        },
+        "environment": {
+            "python": sys.executable, "python_version": platform.python_version(),
+            "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+            "processes_used": 1, "thread_environment": {name: os.environ[name] for name in THREAD_VARS},
+            "peak_rss_mib": peak_mib, "wall_s": time.perf_counter() - started,
+            "load_average_end": list(os.getloadavg()),
+        },
+    }
+    unsigned = json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("ascii")
+    payload["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
+    RECEIPT_PATH.write_text(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
+    REPORT_PATH.write_text(summarize(payload), encoding="utf-8")
+    print(f"PEAK_RSS_MIB={peak_mib:.3f}", flush=True)
+    print(json.dumps({"event": "complete", "report": str(REPORT_PATH), "receipt": str(RECEIPT_PATH),
+                      "receipt_sha256": payload["receipt_sha256"], "wall_s": payload["environment"]["wall_s"]}, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/interaction_scale_diagnostic.py b/interaction_scale_diagnostic.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb80eb3c4fb1d080bd90933cd584e7da153a332d
--- /dev/null
+++ b/interaction_scale_diagnostic.py
@@ -0,0 +1,616 @@
+#!/usr/bin/env python3
+"""Development-only score-scale/argmax diagnostic for the V0.25 selector.
+
+Reads sealed implementation/checkpoints and cached development tapes.  Writes
+only a diagnostic receipt and report in this workspace.  It computes no EE.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+from fractions import Fraction
+import gc
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import pickle
+import platform
+import resource
+import statistics
+import sys
+import time
+from typing import Mapping, Sequence
+
+import numpy as np
+
+
+WORKSPACE = Path(__file__).resolve().parent
+PYTHON = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+RETRAIN = Path("/home/sat/mcrl-v025-retrain-ws")
+DESIGN = Path("/home/sat/mcrl-v025-design-ws")
+HARNESS = Path("/home/sat/mcrl-v025-harness-ws")
+PILOT_PATH = HARNESS / "scripts/run_v025_pilot_c3.py"
+Q1V2_PATH = DESIGN / "q1_schema_v2.py"
+CALIBRATION_PATH = (
+    HARNESS
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+    / "PILOT_NOT_CLAIM-calibration.json"
+)
+TAPE_ROOT = HARNESS / ".tmp/selector-latency-tapes"
+RUNS = {
+    "V1_CONTRACT": RETRAIN / "artifacts/firstrun-500ep-20260910T1355Z",
+    "Q1_V2": DESIGN / "artifacts/firstrun-v2-500ep-20260910T1425Z",
+}
+ARMS = ("FULL", "DROP_C1", "DROP_C2", "DROP_C3", "ALL_NEUTRAL_CONTROL")
+WORLDS = tuple(f"V025_PROBE_R2/world/{index}" for index in range(1, 5))
+STEPS = tuple(range(5))
+RSS_CAP_BYTES = 4_000_000_000
+ADDRESS_SPACE_GUARD_BYTES = 8_000_000_000
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "BLIS_NUM_THREADS", "VECLIB_MAXIMUM_THREADS",
+)
+RECEIPT_PATH = WORKSPACE / "interaction-scale-receipt.json"
+REPORT_PATH = WORKSPACE / "INTERACTION-SCALE-2026-09-10.md"
+
+
+@dataclass(frozen=True)
+class Head:
+    weights: tuple[np.ndarray, ...]
+    biases: tuple[np.ndarray, ...]
+    activation: str
+
+    def score(self, values: Sequence[float]) -> float:
+        state = np.asarray(values, dtype=np.float64)
+        for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
+            state = state @ weights + bias
+            if index + 1 < len(self.weights):
+                if self.activation == "relu":
+                    state = np.maximum(state, 0.0)
+                elif self.activation == "tanh":
+                    state = np.tanh(state)
+                else:
+                    raise RuntimeError(f"unsupported activation {self.activation!r}")
+        return float(np.asarray(state).reshape(-1)[0])
+
+
+@dataclass(frozen=True)
+class ArmModel:
+    q1: Head
+    q2: Head
+    c3: Head
+    member_width: int
+
+
+@dataclass(frozen=True)
+class Checkpoint:
+    run: str
+    path: Path
+    sha256: str
+    seed: int
+    epoch: int
+    models: Mapping[str, ArmModel]
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def enforce_resources() -> None:
+    if Path(sys.executable).resolve() != PYTHON.resolve():
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 17:
+        raise RuntimeError("niceness must be at least 17")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"BLAS/OpenMP pins drifted: {bad}")
+    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    # NumPy/provider mappings reserve substantially more virtual address space
+    # than resident memory.  The contract is on peak RSS, checked and reported
+    # separately; this guard catches runaway address growth without conflating
+    # it with RSS.
+    limit = ADDRESS_SPACE_GUARD_BYTES if hard == resource.RLIM_INFINITY else min(ADDRESS_SPACE_GUARD_BYTES, hard)
+    resource.setrlimit(resource.RLIMIT_AS, (limit, limit))
+
+
+def peak_rss_bytes() -> int:
+    # Linux reports ru_maxrss in KiB.
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def decode_arrays(values: object) -> tuple[np.ndarray, ...]:
+    if not isinstance(values, list):
+        raise RuntimeError("checkpoint tensor list is malformed")
+    arrays = []
+    for encoded in values:
+        array = np.asarray(encoded, dtype=object)
+        flat = [float.fromhex(value) for value in array.reshape(-1)]
+        arrays.append(np.asarray(flat, dtype=np.float64).reshape(array.shape))
+    return tuple(arrays)
+
+
+def restore_head(payload: Mapping[str, object]) -> Head:
+    return Head(
+        weights=decode_arrays(payload["weights_hex"]),
+        biases=decode_arrays(payload["biases_hex"]),
+        activation=str(payload["activation"]),
+    )
+
+
+def discover_latest_checkpoints() -> tuple[Checkpoint, ...]:
+    frozen_paths: list[tuple[str, Path]] = []
+    for run, root in RUNS.items():
+        latest: dict[int, tuple[int, Path]] = {}
+        for path in sorted((root / "checkpoints").glob("learner-*-epoch-*.json")):
+            parts = path.stem.split("-")
+            seed, epoch = int(parts[1]), int(parts[3])
+            if seed not in latest or epoch > latest[seed][0]:
+                latest[seed] = (epoch, path)
+        frozen_paths.extend((run, item[1]) for item in sorted(latest.values()))
+    checkpoints = []
+    for position, (run, path) in enumerate(frozen_paths, 1):
+        actual = sha256(path)
+        fields = path.with_suffix(path.suffix + ".sha256").read_text(encoding="ascii").split()
+        if len(fields) != 2 or fields[0] != actual or fields[1] != path.name:
+            raise RuntimeError(f"checkpoint sidecar mismatch: {path}")
+        payload = json.loads(path.read_text(encoding="ascii"))
+        seed = int(payload["learner_seed"])
+        epoch = int(payload["completed_source_epochs"])
+        if set(payload["arms"]) != set(ARMS):
+            raise RuntimeError(f"arm inventory drifted: {path}")
+        models = {}
+        for arm in ARMS:
+            row = payload["arms"][arm]
+            models[arm] = ArmModel(
+                q1=restore_head(row["C1"]),
+                q2=restore_head(row["C2"]),
+                c3=restore_head(row["C3"]),
+                member_width=int(row["C3"]["member_width"]),
+            )
+        checkpoints.append(Checkpoint(run, path, actual, seed, epoch, models))
+        del payload
+        gc.collect()
+        print(
+            f"PROGRESS checkpoint {position}/{len(frozen_paths)} loaded "
+            f"run={run} seed={seed} epoch={epoch} peak_rss_mib={peak_rss_bytes()/2**20:.1f}",
+            flush=True,
+        )
+    return tuple(checkpoints)
+
+
+def calibration(pilot):
+    row = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
+    return pilot.PilotCalibration(
+        eta_ref=Fraction(*row["eta_ref"]),
+        lambda_bits_per_j=Fraction(*row["lambda_bits_per_j"]),
+        kappa_bits_per_user_step=Fraction(*row["kappa_bits_per_user_step"]),
+        bits_ref=Fraction(*row["bits_ref"]),
+        joules_ref=Fraction(*row["joules_ref"]),
+        users=int(row["users"]),
+    )
+
+
+def distribution(values: Sequence[float]) -> dict[str, float | int]:
+    rows = [float(value) for value in values]
+    return {
+        "count": len(rows), "min": min(rows), "median": statistics.median(rows),
+        "max": max(rows), "mean": statistics.fmean(rows),
+        "population_std": statistics.pstdev(rows),
+    }
+
+
+def stable_order(scores: Mapping[str, float]) -> list[tuple[str, float]]:
+    return sorted(scores.items(), key=lambda item: (-item[1], item[0]))
+
+
+def score_stats(scores: Mapping[str, float]) -> dict[str, object]:
+    ordered = stable_order(scores)
+    top = ordered[0][1]
+    return {
+        "population_std": statistics.pstdev(scores.values()),
+        "top_configuration_id": ordered[0][0],
+        "top_gaps": [top - ordered[index][1] for index in range(1, 5)],
+    }
+
+
+def interaction_stats(values: Mapping[str, float]) -> dict[str, float]:
+    rows = list(values.values())
+    minimum, maximum = min(rows), max(rows)
+    return {
+        "absolute_max": max(abs(minimum), abs(maximum)),
+        "population_std": statistics.pstdev(rows),
+        "minimum": minimum,
+        "maximum": maximum,
+        "range": maximum - minimum,
+    }
+
+
+def v2_rows(q1v2, pilot, tape, step_index: int, rows):
+    resolver = q1v2.DecisionGeometryResolverV2(
+        tape, pilot.LegacyWorldProvider(role="interaction-scale-development-diagnostic"), step_index
+    )
+    converted = {}
+    for key, row in rows.items():
+        angle, elevation = resolver(row)
+        state = q1v2.upgrade_q1_state_v2(
+            row.q1_state,
+            off_axis_angle_rad=angle,
+            focal_elevation_deg=elevation,
+            null_action=bool(row.null_action),
+        )
+        converted[key] = replace(row, q1_state=state)
+    return converted, resolver.maximum_elevation_crosscheck_error_deg
+
+
+def checkpoint_anchor_scores(
+    checkpoint: Checkpoint, pilot, base, catalogue, rows_v1, rows_v2, contexts_v1, contexts_v2,
+    exact_psi, anchor_id: str,
+) -> dict[str, object]:
+    rows = rows_v1 if checkpoint.run == "V1_CONTRACT" else rows_v2
+    contexts = contexts_v1 if checkpoint.run == "V1_CONTRACT" else contexts_v2
+    additive_by_arm: dict[str, dict[str, float]] = {}
+    interaction_by_arm: dict[str, dict[str, float]] = {}
+    combined_by_arm: dict[str, dict[str, float]] = {}
+    choices = {}
+    for arm in ARMS:
+        model = checkpoint.models[arm]
+        deltas = {}
+        for (user, action), row in rows.items():
+            reference = rows[(user, base.mapping[user])]
+            deltas[(user, action)] = (
+                model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
+                + model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
+            )
+        additive = {}
+        interactions = {}
+        combined = {}
+        for config in catalogue:
+            cid = config.configuration_id
+            score = math.fsum(
+                deltas[(user, config.mapping[user])] for user in base.mapping
+            )
+            interaction = (
+                model.c3.score(contexts[cid].invariant_vector(member_width=model.member_width))
+                if cid in contexts else 0.0
+            )
+            additive[cid] = score
+            interactions[cid] = interaction
+            combined[cid] = score + interaction
+        additive_by_arm[arm] = additive
+        interaction_by_arm[arm] = interactions
+        combined_by_arm[arm] = combined
+        choices[arm] = stable_order(combined)[0][0]
+    full_additive = additive_by_arm["FULL"]
+    additive_stat = score_stats(full_additive)
+    learned_interaction_stat = interaction_stats(interaction_by_arm["FULL"])
+    gap = float(additive_stat["top_gaps"][0])
+    ratio = math.inf if gap == 0.0 and learned_interaction_stat["range"] > 0.0 else (
+        0.0 if gap == 0.0 else learned_interaction_stat["range"] / gap
+    )
+    additive_choice = str(additive_stat["top_configuration_id"])
+    full_choice = choices["FULL"]
+    exact_scores = {cid: score + exact_psi[cid] for cid, score in full_additive.items()}
+    exact_choice = stable_order(exact_scores)[0][0]
+    return {
+        "checkpoint": {
+            "run": checkpoint.run, "seed": checkpoint.seed, "epoch": checkpoint.epoch,
+            "path": str(checkpoint.path), "sha256": checkpoint.sha256,
+        },
+        "anchor_id": anchor_id,
+        "catalogue_rows": len(catalogue),
+        "additive": additive_stat,
+        "learned_interaction": learned_interaction_stat,
+        "interaction_range_to_top12_additive_gap": ratio,
+        "additive_choice": additive_choice,
+        "full_choice": full_choice,
+        "learned_interaction_changes_argmax": full_choice != additive_choice,
+        "exact_choice": exact_choice,
+        "exact_psi_changes_argmax": exact_choice != additive_choice,
+        "arm_choices": choices,
+        "arm_differs_from_full": {arm: choices[arm] != full_choice for arm in ARMS},
+    }
+
+
+def fmt(value: float) -> str:
+    if math.isinf(value):
+        return "inf"
+    if value == 0.0:
+        return "0"
+    return f"{value:.6g}"
+
+
+def markdown_table(headers: Sequence[str], rows: Sequence[Sequence[object]]) -> str:
+    lines = ["| " + " | ".join(headers) + " |", "|" + "|".join("---" for _ in headers) + "|"]
+    lines.extend("| " + " | ".join(str(value) for value in row) + " |" for row in rows)
+    return "\n".join(lines)
+
+
+def summarize(payload: dict[str, object]) -> str:
+    observations = payload["observations"]
+    anchors = payload["anchors"]
+    checkpoint_rows = payload["checkpoints"]
+    ratios = [row["interaction_range_to_top12_additive_gap"] for row in observations]
+    learned_changed = [row for row in observations if row["learned_interaction_changes_argmax"]]
+    exact_changed = [row for row in observations if row["exact_psi_changes_argmax"]]
+    learned_anchor_ids = sorted({row["anchor_id"] for row in learned_changed})
+    exact_anchor_ids = sorted({row["anchor_id"] for row in exact_changed})
+    exact_can = "can" if exact_changed else "cannot"
+    first = (
+        f"**Across {len(observations)} frozen checkpoint-anchor decisions, the median learned-interaction-range / "
+        f"FULL top-1/top-2 additive-gap ratio is {fmt(statistics.median(ratios))}; including learned interaction "
+        f"changes the argmax on {len(learned_anchor_ids)}/{len(anchors)} distinct anchors "
+        f"({len(learned_changed)}/{len(observations)} decisions), and exact `psi` {exact_can} move it "
+        f"({len(exact_anchor_ids)}/{len(anchors)} anchors; {len(exact_changed)}/{len(observations)} decisions).**"
+    )
+
+    lines = [first, "", "# Interaction scale and selector argmax — development diagnostic", "",
+             "`DESIGN_PHASE_DIAGNOSTIC_NOT_CLAIM`. This run computes score scales and configuration identities only; it computes no EE and uses no loss value as evidence.", "",
+             "## Verdict", ""]
+    if learned_changed:
+        lines.append(
+            f"The proposed dead-by-scale hypothesis is **refuted on this panel**: learned interaction changed {len(learned_changed)} of {len(observations)} checkpoint-anchor argmax decisions, spanning {len(learned_anchor_ids)} of {len(anchors)} anchors."
+        )
+    else:
+        lines.append(
+            "The learned interaction never changed the argmax in the frozen observations. This supports dead-by-scale on this panel, subject to the stated checkpoint and development-panel scope."
+        )
+    if exact_changed:
+        lines.append(
+            f"Exact `psi` also changed {len(exact_changed)} decisions on {len(exact_anchor_ids)} anchors, so there is no structural impossibility in the scalar decision rule on this panel."
+        )
+    else:
+        lines.append(
+            "Exact `psi` never changed the argmax. Within this catalogue, additive surfaces, calibration, and development panel, that is a structural scale result for the scalar rule—not a statement about C3 information or training loss."
+        )
+
+    lines += ["", "## Verified by running code", "", "### Scope and provenance", "",
