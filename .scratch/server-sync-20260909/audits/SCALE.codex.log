    anchors = source_tables(runner, args.corpus.resolve())
    checkpoints = sorted((args.run / "checkpoints").glob("learner-*-epoch-000500.json"))
    if len(checkpoints) != SEEDS:
        raise RuntimeError(f"expected {SEEDS} terminal checkpoints, found {len(checkpoints)}")
    selections = []
    checkpoint_receipts = []
    for position, checkpoint in enumerate(checkpoints, 1):
        payload = verified_json(checkpoint)
