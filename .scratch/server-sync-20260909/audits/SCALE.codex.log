            selections.append({
                "seed": seed,
                "global_anchor_index": index,
                "indices": indices,
                "mapping": {table.user_id: identity(table.actions[action_index])
                            for table, action_index in zip(tables, indices, strict=True)},
                "concentration": concentration(indices, tables),
            })
        checkpoint_receipts.append({
            "seed": seed, "path": str(checkpoint), "sha256": file_sha256(checkpoint),
            "sealed_loader_readback": "PASS",
        })
        del trainer, model
        gc.collect()
        print(f"selection seed {position}/{SEEDS} peak RSS {peak_rss_bytes()} bytes", flush=True)

    # Drop the training matrices before the exact committed evaluator builds its
    # world tape.  Selection records contain only indices and physical mappings.
