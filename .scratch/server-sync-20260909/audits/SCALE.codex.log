def _action_configs(tape, step_index: int, base, run_setting, *, full_legal: bool):
    if full_legal:
        options, census = ENGINE._legal_options(tape, step_index)
    else:
        options, census = ENGINE._selection_shortlist(
            tape, step_index, run_setting=run_setting
        )
    by_user: dict[int, tuple[tuple[int, int] | None, ...]] = {}
    configs: dict[tuple[int, tuple[int, int] | None], object] = {}
    for user in sorted(base.mapping):
        ordered = []
        for identity in (base.mapping[user], *options[user], None):
            if identity not in ordered:
                ordered.append(identity)
        by_user[user] = tuple(ordered)
        for identity in ordered:
            mapping = base.mapping
            mapping[user] = identity
            configs[(user, identity)] = ENGINE._configuration(
                base, mapping, kind="pilot-shortlisted-unilateral"
            )
    return by_user, configs, census


def _primitive_metrics(tape, step_index: int, user: int, identity, indices):
    if identity is None:
        return {
            "legal": False, "gain": 0.0, "remaining_d2": 0.0,
            "remaining_visibility": 0.0,
        }
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        candidate = next(
            (row for row in tape.steps[step_index].boundaries[0].candidates
             if row.user_id == user and row.identity == identity),
            None,
        )
        if candidate is None:
            return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
        return {
            "legal": candidate.legal,
            "gain": candidate.nominal_gain,
            "remaining_d2": candidate.remaining_d2_s,
            "remaining_visibility": candidate.remaining_visibility_s,
        }
    row = indices[step_index].get((user, identity))
    if row is None:
        return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
    return {
        "legal": bool(arrays.visible[0, row] and arrays.d2_eligible[0, row] and arrays.cell_reachable[0, row]),
        "gain": float(arrays.nominal_gain[0, row]),
        "remaining_d2": float(arrays.remaining_d2_s[0, row]),
        "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
    }


def _build_anchor_rows_primitive(
    *, tape, setting, run_setting, calibration, step_index, carrier,
    anchor_index, include_coalition, full_legal_actions,
):
    """Schema-complete provider-primitive fallback for bounded pilot compute."""

    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    # The generating-input digest already authenticates the provider inputs
    # and boundary-zero bytes. Computing ``tape.digest`` here hashes every
    # dense 33x48 array and dominates an entire anchor on this snapshot.
    tape_digest = tape.generating_input_digest or canonical_sha256({
        "domain": tape.domain,
        "seed": tape.seed,
        "provider": tape.protocol.provider_source_digest,
    })
    future_bases = {
        offset: ENGINE._base_configuration(tape, step_index + offset, carrier)
        for offset in (1, 2, 3)
    }
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape, setting, step_index, transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal", counter=counter, run_setting=run_setting,
        boundary_indices=(0,),
    )
    base_profile = current.evaluate(base)
    source_rows = []
    rows_by_user_action = {}
    for user in sorted(by_user):
        actions = []
        identities = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        base_metric = _primitive_metrics(
            tape, step_index, user, base.mapping[user], indices
        )
        base_gain = max(base_metric["gain"], 1e-300)
        for identity in by_user[user]:
            metric = _primitive_metrics(tape, step_index, user, identity, indices)
            ratio = max(metric["gain"], 1e-300) / base_gain
            gain_db = 10.0 * math.log10(max(ratio, 1e-30))
            if identity is None or not metric["legal"]:
                normalized_delta = -1.0
            else:
                normalized_delta = math.tanh(math.log(max(ratio, 1e-30)))
            candidate_margin = base_profile.min_decoding_margin_db + gain_db
            required_ratio = min(1e6, max(0.0, base_profile.required_power_w_max / BEAM_RF_CAP_W / max(ratio, 1e-12)))
            se = max(0.0, base_profile.mean_acm_se_bit_s_hz * min(4.0, max(0.0, ratio)))
            forecast_rows = []
            c2_normalized = 0.0
            alive = True
            for offset in (1, 2, 3):
                projected = step_index + offset
                future_metric = _primitive_metrics(tape, projected, user, identity, indices)
                future_base = future_bases[offset].mapping[user]
                future_base_metric = _primitive_metrics(tape, projected, user, future_base, indices)
                future_ratio = max(future_metric["gain"], 1e-300) / max(future_base_metric["gain"], 1e-300)
                survives = bool(future_metric["legal"] and identity is not None)
                if alive:
                    c2_normalized += math.tanh(math.log(max(future_ratio, 1e-30))) if survives else -1.0
                    alive = survives
                else:
                    c2_normalized -= 1.0
                forecast_rows.append(ForecastObservation(
                    valid=survives,
                    survival=survives,
                    minimum_decoding_margin_db=base_profile.min_decoding_margin_db + 10.0 * math.log10(max(future_ratio, 1e-30)),
                    mean_acm_spectral_efficiency=max(0.0, se * min(4.0, max(0.0, future_ratio))),
                ))
            phi = ENGINE._phi_for(incumbent, configs[(user, identity)]) - ENGINE._phi_for(incumbent, base)
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = 0 if identity is None else previous_beam.get(identity, 0)
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=candidate_margin,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=se,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=metric["remaining_d2"],
                remaining_visibility_time_s=metric["remaining_visibility"],
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent.mapping[user],
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=identity is not None and identity in previous_beam,
                previous_satellite_active_for_action=identity is not None and identity[0] in previous_satellite,
                previous_beam_max_rf_over_cap=0.0 if identity is None else min(1.0, required_ratio),
                missing_incumbent=incumbent.mapping[user] is None,
                candidate_current_nominal_decoding_margin_db=candidate_margin,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(forecast_rows[0].mean_acm_spectral_efficiency - se) / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W * (1.0 - required_ratio),
                forecasts=tuple(forecast_rows),
                c1_label_bits=float(calibration.kappa_bits_per_user_step) * normalized_delta,
                c1_phi_difference=float(phi),
                c2_label_bits=float(calibration.kappa_bits_per_user_step) * c2_normalized,
                legal=True,
                terminal=step_index == 29,
                outage=not bool(metric["legal"]),
            )
            actions.append(seal_action_evaluation(
                observation,
                source_provenance_sha256=canonical_sha256({
                    "artifact_label": LABEL, "method": "provider-primitive-fallback",
                    "world": tape_digest, "step": step_index, "carrier": carrier,
                    "user": user, "identity": identity,
                }),
                forecast_method_sha256=canonical_sha256({
                    "method": "provider-primitive-boundary-0", "offsets": [1, 2, 3]
                }),
            ))
            identities.append(identity)
        envelope = AnchorEnvelope(
            world_id=tape.domain, split="TRAIN", world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}", anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user, setting_id="a-r0", code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST, launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest, calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape), allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]), actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row
    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)
    return {
        "base": base, "incumbent": incumbent, "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action, "current_evaluator": current,
        "coalition_row": coalition_row, "census": census, "skipped_invalid": 0,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
            column = aggressors.get(source)
            gain = 0.0 if column is None else max(
                (
                    float(arrays.cross_base_nominal[0, user, column])
                    for user in victim_columns.get(target, ())
                ),
                default=0.0,
            )
            pair_cache[relation] = gain
        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
    return tuple(result)


def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
    changed = tuple(
        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
    )
    members = tuple(
        CoalitionMember(
            user_id=user,
            reference_action=_physical_action(anchor.mapping[user]),
            selected_action=_physical_action(selected.mapping[user]),
            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
        )
        for user in changed
    )
    affected = sorted(
        {
            identity
            for user in changed
            for identity in (anchor.mapping[user], selected.mapping[user])
            if identity is not None
        }
    )
    before_counts: dict[tuple[int, int], int] = {}
    after_counts: dict[tuple[int, int], int] = {}
    for identity in anchor.mapping.values():
        if identity is not None:
            before_counts[identity] = before_counts.get(identity, 0) + 1
    for identity in selected.mapping.values():
        if identity is not None:
            after_counts[identity] = after_counts.get(identity, 0) + 1
    relations = _cross_gain_terms(tape, step_index, affected)
    beams = tuple(
        AffectedBeamContext(
            beam_key=f"{identity[0]}:{identity[1]}",
            occupancy_before=before_counts.get(identity, 0),
            occupancy_after=after_counts.get(identity, 0),
            active_before=before_counts.get(identity, 0) > 0,
            active_after=after_counts.get(identity, 0) > 0,
            shared_capacity=1.0,
            interference_summary=math.fsum(
                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
            ),
            capacity_margin=float(10 - after_counts.get(identity, 0)),
        )
        for identity in affected
    )
    return CoalitionContext(
        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
        reference_profile=tuple(
            (user, _physical_action(identity)) for user, identity in anchor.assignments
        ),
        members=members,
        affected_beams=beams,
        global_resource_features=(
            len(changed) / max(1, len(anchor.assignments)),
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )

        (output / f"{LABEL}-training-manifest.json").read_text(encoding="ascii")
    )
    calibration_payload = json.loads(
        (output / f"{LABEL}-calibration.json").read_text(encoding="ascii")
    )
    ratio = lambda name: Fraction(*calibration_payload[name])
    calibration = PilotCalibration(
        eta_ref=ratio("eta_ref"),
        lambda_bits_per_j=ratio("lambda_bits_per_j"),
        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
        bits_ref=ratio("bits_ref"), joules_ref=ratio("joules_ref"),
        users=int(calibration_payload["users"]),
    )
    source_shards = [
        read_source_shard(path)
        for path in sorted((output / "rows").glob(f"{ROW_WORLD_GLOB}/*source-anchor-*.jsonl"))[:ROW_ANCHOR_LIMIT]
    ]
    coalition_shards = [
        read_coalition_shard(path)
        for path in sorted((output / "rows").glob(f"{ROW_WORLD_GLOB}/*coalition-anchor-*.jsonl"))[:ROW_ANCHOR_LIMIT]
    ]
    q_batches = {
        route: _aggregate_pair_batch(batch)
        for route, batch in build_pairwise_batches(source_shards).items()
    }
    batches = (
        q_batches["C1"], q_batches["C2"],
        CoalitionBatch.create(coalition_shards), default_synthetic_neutral_sources(),
    )
    model_payloads = {}
    for seed in LEARNER_SEEDS:
        for arm in PILOT_ARMS:
            checkpoint = output / "checkpoints" / (
                f"{LABEL}-seed-{seed}-{arm}-epoch-{EVAL_EPOCH:04d}.json"
            )
            payload = json.loads(checkpoint.read_text(encoding="ascii"))
            model_payloads[(seed, arm)] = payload["model"]
    return row_manifest, training_manifest, calibration, model_payloads, batches


def _restore_models(payloads, batches):
    q1, q2, c3, neutral = batches
    restored = {}
    for (seed, arm), payload in payloads.items():
        orchestrator = V1LineageOrchestrator(
            learner_seed=seed,
            q1_batch=q1,
            q2_batch=q2,
            c3_batch=c3,
            neutral_sources=neutral,
        )
        model = orchestrator.models[arm]
        V1LineageOrchestrator._restore_adam_head(model.q1, payload["C1"])
        V1LineageOrchestrator._restore_adam_head(model.q2, payload["C2"])
        V1LineageOrchestrator._restore_adam_head(model.psi.network, payload["C3"])
        restored[(seed, arm)] = model
    return restored


def _repair_profile(base, proposed, evaluator):
    if proposed.configuration_id not in evaluator._invalid:
        evaluator.evaluate_many((proposed,))
    if proposed.configuration_id not in evaluator._invalid:
        return proposed, 0
    mapping = proposed.mapping
    repairs = 0
    for user in sorted(mapping):
        if mapping[user] == base.mapping[user]:
            continue
        mapping[user] = base.mapping[user]
        repairs += 1
        candidate = ENGINE._configuration(base, mapping, kind="pilot-deterministic-repair")
        evaluator.evaluate_many((candidate,))
        if candidate.configuration_id not in evaluator._invalid:
            return candidate, repairs
    return base, repairs


def _additive_scores(model, rows_by_user_action, base, config):
    total = 0.0
    for user in sorted(base.mapping):
        reference = rows_by_user_action[(user, base.mapping[user])]
        selected = rows_by_user_action[(user, config.mapping[user])]
        total += (
            model.q1.score(selected.q1_state) - model.q1.score(reference.q1_state)
            + model.q2.score(selected.q2_state) - model.q2.score(reference.q2_state)
        )
    return total


def _exact_interactions(anchor, incumbent, catalogue, evaluator, calibration):
    evaluator.evaluate_many(catalogue)
    base_profile = evaluator.evaluate(anchor)
    base_core = (
        Fraction(str(base_profile.bits))
        - calibration.eta_ref * Fraction(str(base_profile.joules))
        + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, anchor)
    )
    singleton_by_key = {}
    for config in catalogue:
        for user in anchor.mapping:
            if config.mapping[user] == anchor.mapping[user]:
                continue
            mapping = anchor.mapping
            mapping[user] = config.mapping[user]
            singleton_by_key[(config.configuration_id, user)] = ENGINE._configuration(
                anchor, mapping, kind="pilot-exact-singleton"
            )
    evaluator.evaluate_many(tuple({
        row.assignments: row for row in singleton_by_key.values()
    }.values()))
    values = {}
    for config in catalogue:
        if config.configuration_id in evaluator._invalid:
            continue
        changed = tuple(user for user in anchor.mapping if config.mapping[user] != anchor.mapping[user])
        additive = Fraction()
        for user in changed:
            singleton = singleton_by_key[(config.configuration_id, user)]
            if singleton.configuration_id in evaluator._invalid:
                additive = Fraction(-10**30)
                break
            profile = evaluator.evaluate(singleton)
            additive += (
                Fraction(str(profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules))
                + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, singleton)
                - base_core
            )
        profile = evaluator.evaluate(config)
        joint = (
            Fraction(str(profile.bits))
            - calibration.eta_ref * Fraction(str(profile.joules))
            + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, config)
            - base_core
        )
        values[config.configuration_id] = {
            "changed": changed,
            "joint": float(joint / calibration.kappa_bits_per_user_step),
            "additive": float(additive / calibration.kappa_bits_per_user_step),
            "psi": float((joint - additive) / calibration.kappa_bits_per_user_step),
        }
    return values


def _structural_interactions(anchor, catalogue):
    return {
        config.configuration_id: {
            "changed": tuple(
                user for user in anchor.mapping
                if config.mapping[user] != anchor.mapping[user]
            ),
            "joint": 0.0, "additive": 0.0, "psi": 0.0,
        }
        for config in catalogue
    }


