GeometryLookup = Callable[[object], tuple[float, float]]


def decision_geometry_from_ecef(
    *,
    satellite_ecef_km: Sequence[float],
    beam_centre_ecef_km: Sequence[float],
    user_ecef_km: Sequence[float],
) -> tuple[float, float]:
    """Return (off-axis radians, elevation degrees) from decision-time ECEF.

    Off-axis is the angle at the satellite between the satellite-to-cell
    boresight and satellite-to-user link. Elevation uses the spherical-Earth
    local-up convention used by the provider/channel path.
    """

    satellite = tuple(float(value) for value in satellite_ecef_km)
    centre = tuple(float(value) for value in beam_centre_ecef_km)
    user = tuple(float(value) for value in user_ecef_km)
    if any(len(vector) != 3 for vector in (satellite, centre, user)):
        raise Q1SchemaV2Error("ECEF geometry vectors must have length three")
    if not all(math.isfinite(value) for vector in (satellite, centre, user) for value in vector):
        raise Q1SchemaV2Error("ECEF geometry must be finite")

    boresight = tuple(c - s for c, s in zip(centre, satellite, strict=True))
    link_from_satellite = tuple(u - s for u, s in zip(user, satellite, strict=True))
    link_from_user = tuple(s - u for s, u in zip(satellite, user, strict=True))

    def norm(vector: Sequence[float]) -> float:
        return math.sqrt(sum(value * value for value in vector))

    boresight_norm = norm(boresight)
    satellite_link_norm = norm(link_from_satellite)
    user_norm = norm(user)
    if min(boresight_norm, satellite_link_norm, user_norm) <= 0.0:
        raise Q1SchemaV2Error("ECEF geometry contains a zero-length direction")
    cosine = sum(
        left * right for left, right in zip(boresight, link_from_satellite, strict=True)
    ) / (boresight_norm * satellite_link_norm)
    off_axis_rad = math.acos(max(-1.0, min(1.0, cosine)))
    sine_elevation = sum(
        delta * up for delta, up in zip(link_from_user, user, strict=True)
    ) / (satellite_link_norm * user_norm)
    elevation_deg = math.degrees(math.asin(max(-1.0, min(1.0, sine_elevation))))
    return off_axis_rad, elevation_deg


class DecisionGeometryResolverV2:
    """Resolve true focal geometry for one tape step through public seams."""

    def __init__(self, tape: object, provider: object, step_index: int) -> None:
        # Imports stay local so the schema/digest itself has no dependency on
        # the sealed implementation. The caller chooses which readable v1
        # provider supplies the successor's geometry.
        import numpy as np
        from mcrl.env.cells import build_cell_grid
        from mcrl.env.geometry import geodetic_to_ecef
        from mcrl.env.scenario import NOMINAL_GRID_ALTITUDE_KM

        step = tape.steps[step_index]
        arrays = step.arrays
        if arrays is None:
            raise Q1SchemaV2Error(
                "v2 off-axis requires the provider array/ECEF seam; object-only tape is insufficient"
            )
        layouts = (
            tape.step_user_layouts[step_index]
            if tape.step_user_layouts
            else tape.user_layout
        )
        ordered = sorted(layouts, key=lambda item: item.user_id)
        user_ids = np.asarray([item.user_id for item in ordered], dtype=np.int64)
        user_ecef = geodetic_to_ecef(
            np.asarray([item.latitude_deg for item in ordered], dtype=np.float64),
            np.asarray([item.longitude_deg for item in ordered], dtype=np.float64),
        )
        user_by_id = {
            int(user_id): tuple(float(value) for value in user_ecef[index])
            for index, user_id in enumerate(user_ids.tolist())
        }
        satellites = dict(
            provider.satellite_ecef_km(
                world_seed=tape.seed,
                step_index=step_index,
                boundary_index=0,
            )
        )
        grid = build_cell_grid(altitude_km=NOMINAL_GRID_ALTITUDE_KM)
        row_index = arrays._row_index()
        resolved: dict[tuple[int, tuple[int, int]], tuple[float, float]] = {}
        maximum_elevation_error = 0.0
        for (user_id, identity), array_row in row_index.items():
            norad, cell_id = identity
            geometry = decision_geometry_from_ecef(
                satellite_ecef_km=satellites[norad],
                beam_centre_ecef_km=grid.centers_ecef_km[cell_id],
                user_ecef_km=user_by_id[user_id],
            )
            array_elevation = float(arrays.elevations_deg[0, array_row])
            maximum_elevation_error = max(
                maximum_elevation_error, abs(geometry[1] - array_elevation)
            )
            resolved[(user_id, identity)] = (geometry[0], array_elevation)
        if maximum_elevation_error > 1.0e-9:
            raise Q1SchemaV2Error(
                "public ECEF elevation disagrees with provider boundary-0 elevation"
            )
        self._resolved = resolved
        self.maximum_elevation_crosscheck_error_deg = maximum_elevation_error

    def __call__(self, row: object) -> tuple[float, float]:
        if bool(row.null_action):
            return 0.0, 0.0
        action = row.action
        if action.norad_id is None or action.beam_chain_id is None:
            raise Q1SchemaV2Error("non-null row has no physical identity")
        key = (
            int(row.user_id),
            (int(action.norad_id), int(action.beam_chain_id)),
        )
        try:
            return self._resolved[key]
        except KeyError as error:
            raise Q1SchemaV2Error(
                "non-null row has no decision-time provider geometry"
            ) from error


def _upgrade_builder_output_v2(
    result: Mapping[str, object], geometry_lookup: GeometryLookup
) -> dict[str, object]:
    """Upgrade the row portion of either sealed builder result."""

    parent_rows = result.get("rows")
    if not isinstance(parent_rows, tuple):
        raise Q1SchemaV2Error("builder result has no tuple of source rows")
    upgraded = []
    for row in parent_rows:
        angle, elevation = geometry_lookup(row)
        upgraded.append(
            project_row_payload_v2(
                row.payload(),
                off_axis_angle_rad=angle,
                focal_elevation_deg=elevation,
                geometry_source=(
                    "provider boundary-0 ECEF satellite/cell/user geometry; "
                    "elevation cross-checked against PrimitiveStepArrays"
                ),
            )
        )
    output = dict(result)
    output["rows_v1"] = parent_rows
    output["rows"] = tuple(upgraded)
    output["rows_by_user_action"] = {
        (int(row["user_id"]), (
            None
            if bool(row["null_action"])
            else (int(row["action"]["norad_id"]), int(row["action"]["beam_chain_id"]))
        )): row
        for row in upgraded
    }
    return output


def build_primitive_rows_v2(
    pilot_module: object,
    *,
    geometry_lookup: GeometryLookup,
    **builder_arguments: object,
) -> dict[str, object]:
    """Run the sealed fallback builder, then emit only versioned v2 rows."""

    result = pilot_module._build_anchor_rows_primitive(**builder_arguments)
    return _upgrade_builder_output_v2(result, geometry_lookup)


def build_exact_rows_v2(
    pilot_module: object,
    *,
    geometry_lookup: GeometryLookup,
    **builder_arguments: object,
) -> dict[str, object]:
    """Run the sealed exact builder branch, then emit only versioned v2 rows."""

    original = pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK
    pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
    try:
        result = pilot_module._build_anchor_rows(**builder_arguments)
    finally:
        pilot_module.PILOT_PRIMITIVE_SOURCE_FALLBACK = original
    return _upgrade_builder_output_v2(result, geometry_lookup)


