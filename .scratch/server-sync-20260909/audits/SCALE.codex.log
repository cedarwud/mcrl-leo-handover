            neutral_sources=runner.default_synthetic_neutral_sources(),
        )
        trainer.load_checkpoint(checkpoint)
        if trainer.completed_source_epochs != 500:
            raise RuntimeError("terminal checkpoint is not epoch 500")
        model = trainer.models["FULL"]
        for index in range(PANEL_ANCHORS):
            tables = anchors[index]["tables"]
            indices = tuple(
                masked_argmax(
                    tuple(
                        model.score("C1", q1) + model.score("C2", q2)
                        for q1, q2 in zip(table.q1_states, table.q2_states, strict=True)
                    ),
                    table.action_mask,
                )
                for table in tables
