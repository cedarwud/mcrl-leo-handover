"""Measure the deployed learned-selector path on the fixed FULL20 anchors.

This is diagnostic instrumentation only.  It imports the production pilot
adapter and invokes its catalogue, feature, coalition-context, learned-head,
argmax, and realised committed-evaluation computations without changing them.
No training is performed.
"""

from __future__ import annotations

from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import json
import math
import os
from pathlib import Path
import pickle
import platform
import resource
import statistics
import sys
import time
from typing import Mapping, Sequence

import numpy as np

from mcrl.stagec_v025.learner import (
    AdamMLPHead,
    AdamSetInteractionHead,
    V1ThreeRouteModel,
)


REPO = Path(__file__).resolve().parents[1]
PILOT_PATH = REPO / "scripts/run_v025_pilot_c3.py"
CHECKPOINT_ROOT = REPO / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/checkpoints"
CALIBRATION_PATH = REPO / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/PILOT_NOT_CLAIM-calibration.json"
ANYTIME_PATH = REPO / "receipts/anytime-sealed-full20.json"
TAPE_ROOT = REPO / ".tmp/selector-latency-tapes"
OUTPUT_PATH = REPO / "receipts/selector-latency-full20.json"
SEED = 5166716249291843642
EPOCH = 2000
ARMS = ("FULL", "DROP_C1", "DROP_C2", "DROP_C3", "ALL_NEUTRAL_CONTROL")
WORLDS = tuple(f"V025_PROBE_R2/world/{index}" for index in range(1, 5))
STEPS = tuple(range(5))
TAPE_STEPS = 8
DEPLOYED_C3_INPUT_DIM = 240


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _load_pilot():
    spec = importlib.util.spec_from_file_location("selector_latency_pilot", PILOT_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {PILOT_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def _decode_arrays(rows) -> list[np.ndarray]:
    return [
        np.asarray(
            [[float.fromhex(value) for value in row] for row in array]
            if array and isinstance(array[0], list)
            else [float.fromhex(value) for value in array],
            dtype=np.float64,
        )
        for array in rows
    ]


def _restore_head(pilot, payload: Mapping[str, object]):
    weights = _decode_arrays(payload["weights_hex"])
    biases = _decode_arrays(payload["biases_hex"])
    first_w = _decode_arrays(payload["adam_first_moment_weights_hex"])
    second_w = _decode_arrays(payload["adam_second_moment_weights_hex"])
    first_b = _decode_arrays(payload["adam_first_moment_biases_hex"])
    second_b = _decode_arrays(payload["adam_second_moment_biases_hex"])
    optimizer = payload["optimizer"]
    betas = optimizer["betas"]
    return AdamMLPHead(
        weights=weights,
        biases=biases,
        first_moment_w=first_w,
        second_moment_w=second_w,
        first_moment_b=first_b,
        second_moment_b=second_b,
        activation=str(payload["activation"]),
        learning_rate=float(optimizer["learning_rate"]),
        beta1=float(betas[0]),
        beta2=float(betas[1]),
        epsilon=float(optimizer["epsilon"]),
        weight_decay=float(optimizer["weight_decay"]),
        gauge_beta=float(payload["gauge_beta"]),
        loss_weight=float(payload["loss_weight"]),
        adam_step=int(payload["adam_step"]),
    )


def _restore_models(pilot):
    models = {}
    sources = {}
    for arm in ARMS:
        path = CHECKPOINT_ROOT / (
            f"PILOT_NOT_CLAIM-seed-{SEED}-{arm}-epoch-{EPOCH:04d}.json"
        )
        checkpoint = json.loads(path.read_text(encoding="ascii"))
        if (
            checkpoint.get("learner_seed") != SEED
            or checkpoint.get("arm") != arm
            or checkpoint.get("completed_source_epochs") != EPOCH
        ):
            raise RuntimeError(f"checkpoint identity drifted: {path}")
        payload = checkpoint["model"]
        q1 = _restore_head(pilot, payload["C1"])
        q2 = _restore_head(pilot, payload["C2"])
        # The archived pilot checkpoint predates the deployed 240-wide
        # coalition invariant (it is 117-wide).  Forward-pass latency depends
        # on shape, not learned values, so use a deterministic synthetic head
        # with the deployed input width and the same 64x64 hidden architecture.
        archived_c3 = _restore_head(pilot, payload["C3"])
        output_widths = [int(weights.shape[1]) for weights in archived_c3.weights]
        widths = (DEPLOYED_C3_INPUT_DIM, *output_widths)
        arm_seed = int.from_bytes(hashlib.sha256(arm.encode("ascii")).digest()[:8], "big")
        rng = np.random.default_rng(SEED ^ arm_seed)
        weights = [
            rng.normal(0.0, np.sqrt(2.0 / max(1, left)), (left, right))
            for left, right in zip(widths[:-1], widths[1:], strict=True)
        ]
        biases = [np.zeros(right, dtype=np.float64) for right in widths[1:]]
        c3_network = AdamMLPHead(
            weights=weights,
            biases=biases,
            first_moment_w=[np.zeros_like(value) for value in weights],
            second_moment_w=[np.zeros_like(value) for value in weights],
            first_moment_b=[np.zeros_like(value) for value in biases],
            second_moment_b=[np.zeros_like(value) for value in biases],
            activation=archived_c3.activation,
            learning_rate=archived_c3.learning_rate,
            beta1=archived_c3.beta1,
            beta2=archived_c3.beta2,
            epsilon=archived_c3.epsilon,
            weight_decay=archived_c3.weight_decay,
            gauge_beta=archived_c3.gauge_beta,
            loss_weight=archived_c3.loss_weight,
            adam_step=0,
        )
        psi = AdamSetInteractionHead(
            c3_network, int(payload["C3"]["member_width"])
        )
        models[arm] = V1ThreeRouteModel(q1=q1, q2=q2, psi=psi)
        sources[arm] = {
            "path": str(path.relative_to(REPO)),
            "sha256": _sha256(path),
            "kind": {
                route: payload[route]["kind"] for route in ("C1", "C2", "C3")
            },
            "weight_shapes": {
                route: [list(array.shape) for array in model_head.weights]
                for route, model_head in (
                    ("C1", q1), ("C2", q2), ("C3", c3_network)
                )
            },
            "route_sources": {
                "C1": "epoch-2000 checkpoint",
                "C2": "epoch-2000 checkpoint",
                "C3": "deterministic untrained synthetic head of deployed shape",
            },
            "archived_c3_checkpoint_weight_shapes": [
                list(array.shape) for array in archived_c3.weights
            ],
            "c3_synthetic_reason": (
                "archived C3 checkpoint input width 117 does not match the current "
                "deployed CoalitionContext invariant width 240"
            ),
            "c3_synthetic_rng_seed": SEED ^ arm_seed,
        }
    return models, sources


def _calibration(pilot):
    row = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
    return pilot.PilotCalibration(
        eta_ref=Fraction(*row["eta_ref"]),
        lambda_bits_per_j=Fraction(*row["lambda_bits_per_j"]),
        kappa_bits_per_user_step=Fraction(*row["kappa_bits_per_user_step"]),
        bits_ref=Fraction(*row["bits_ref"]),
        joules_ref=Fraction(*row["joules_ref"]),
        users=int(row["users"]),
    )


def _tape_path(world_index: int) -> Path:
    return TAPE_ROOT / f"world-{world_index}-steps-{TAPE_STEPS}.pickle"


def _load_or_build_tapes(pilot):
    TAPE_ROOT.mkdir(parents=True, exist_ok=True)
    tapes = {}
    rows = []
    for world_index, domain in enumerate(WORLDS, start=1):
        path = _tape_path(world_index)
        started = time.perf_counter()
        if path.is_file():
            tape = pickle.loads(path.read_bytes())
            source = "cache"
        else:
            tape = pilot.build_world_tape(
                domain=domain,
                provider=pilot.LegacyWorldProvider(role="selector-latency-diagnostic"),
                steps=TAPE_STEPS,
                start_time_s=0.0,
            )
            path.write_bytes(pickle.dumps(tape, protocol=pickle.HIGHEST_PROTOCOL))
            source = "built"
        elapsed = time.perf_counter() - started
        if tape.domain != domain or len(tape.steps) != TAPE_STEPS:
            raise RuntimeError(f"tape identity drifted for {domain}")
        tapes[world_index] = tape
        rows.append(
            {
                "world_index": world_index,
                "domain": domain,
                "source": source,
                "load_or_build_wall_s": elapsed,
                "pickle": str(path.relative_to(REPO)),
                "pickle_sha256": _sha256(path),
                "generating_input_digest": tape.generating_input_digest,
            }
        )
        print(json.dumps({"event": "tape_ready", **rows[-1]}, sort_keys=True), flush=True)
    return tapes, rows


def _canonical_assignments(rows) -> tuple:
    return tuple(
        (int(user), None if identity is None else tuple(int(value) for value in identity))
        for user, identity in rows
    )


def _anytime_rows():
    receipt = json.loads(ANYTIME_PATH.read_text(encoding="ascii"))
    return {
        row["anchor_id"]: _canonical_assignments(row["baseline"]["assignments"])
        for row in receipt["anchors"]
    }


def _thread_count() -> int | None:
    try:
        for line in Path("/proc/self/status").read_text(encoding="ascii").splitlines():
            if line.startswith("Threads:"):
                return int(line.split(":", 1)[1])
    except OSError:
        pass
    return None


def _q(values: Sequence[float], fraction: float) -> float:
    ordered = sorted(float(value) for value in values)
    position = (len(ordered) - 1) * fraction
    lower = math.floor(position)
    upper = math.ceil(position)
    if lower == upper:
        return ordered[lower]
    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)


def _distribution(values: Sequence[float]) -> dict[str, float | int]:
    rows = [float(value) for value in values]
    return {
        "count": len(rows),
        "min": min(rows),
        "min": min(rows),
        "q25": _q(rows, 0.25),
        "median": statistics.median(rows),
        "q75": _q(rows, 0.75),
        "max": max(rows),
        "mean": statistics.fmean(rows),
    }


def _benchmark_anchor(pilot, models, calibration, tape, world_index, step_index, expected_base):
    anchor_id = f"{tape.domain}:step/{step_index}"
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    all_started = time.perf_counter()

    started = time.perf_counter()
    built = pilot._build_anchor_rows(
        tape=tape,
        setting=setting,
        run_setting=run_setting,
        calibration=calibration,
        step_index=step_index,
        carrier="nearest-eligible",
        anchor_index=(world_index - 1) * len(STEPS) + step_index,
        include_coalition=False,
        full_legal_actions=True,
    )
    feature_s = time.perf_counter() - started
    base = built["base"]
    incumbent = built["incumbent"]
    action_rows = built["rows_by_user_action"]
    if _canonical_assignments(base.assignments) != expected_base:
        raise RuntimeError(f"{anchor_id}: base assignments differ from anytime panel")

    started = time.perf_counter()
    catalogue, census = pilot.ENGINE._catalogue_with_census(
        tape,
        step_index,
        base,
        setting=setting,
        calibration=calibration,
        run_setting=run_setting,
    )
    catalogue_s = time.perf_counter() - started

    started = time.perf_counter()
    legal_catalogue = list(catalogue)
    context_eligible = tuple(row for row in legal_catalogue if row.changed_users >= 2)
    eligibility_s = time.perf_counter() - started

    started = time.perf_counter()
    contexts = {
        config.configuration_id: pilot._coalition_context(
            tape=tape,
            step_index=step_index,
            anchor=base,
            selected=config,
            rows_by_user_action=action_rows,
        )
        for config in context_eligible
    }
    contexts_s = time.perf_counter() - started
    if contexts:
        observed_widths = {
            len(context.invariant_vector(member_width=models["FULL"].psi.member_width))
            for context in contexts.values()
        }
        if observed_widths != {DEPLOYED_C3_INPUT_DIM}:
            raise RuntimeError(
                f"{anchor_id}: deployed C3 invariant widths {sorted(observed_widths)} "
                f"!= {DEPLOYED_C3_INPUT_DIM}"
            )

    started = time.perf_counter()
    deltas_by_arm = {}
    for arm in ARMS:
        model = models[arm]
        deltas = {}
        for (user, action), row in action_rows.items():
            reference = action_rows[(user, base.mapping[user])]
            q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
            deltas[(user, action)] = (
                model.q1.score(row.q1_state)
                - model.q1.score(reference.q1_state)
                + q2_delta
            )
        deltas_by_arm[arm] = deltas
    action_head_s = time.perf_counter() - started

    started = time.perf_counter()
    interactions = {arm: {} for arm in ARMS}
    for config in legal_catalogue:
        context = contexts.get(config.configuration_id)
        if context is not None:
            for arm in ARMS:
                interactions[arm][config.configuration_id] = models[arm].interaction(context)
    interaction_head_s = time.perf_counter() - started

    started = time.perf_counter()
    scores = {arm: [] for arm in ARMS}
    for config in legal_catalogue:
        for arm in ARMS:
            score = math.fsum(
                deltas_by_arm[arm][(user, config.mapping[user])]
                for user in base.mapping
            )
            score += interactions[arm].get(config.configuration_id, 0.0)
            scores[arm].append((score, config.configuration_id, config))
    score_assembly_s = time.perf_counter() - started

    started = time.perf_counter()
    selections = {
        arm: min(scores[arm], key=lambda row: (-row[0], row[1]))[2]
        for arm in ARMS
    }
    argmax_s = time.perf_counter() - started

    started = time.perf_counter()
    realised = pilot.ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
        field="realised",
        run_setting=run_setting,
    )
    unique_selected = tuple(
        {row.assignments: row for row in selections.values()}.values()
    )
    realised.evaluate_many(unique_selected)
    committed_profiles = {
        arm: realised.evaluate(config) for arm, config in selections.items()
    }
    committed_evaluation_s = time.perf_counter() - started

    started = time.perf_counter()
    commit_rows = {
        arm: {
            "configuration_id": selections[arm].configuration_id,
            "changed_users": selections[arm].changed_users,
            "bits": committed_profiles[arm].bits,
            "joules": committed_profiles[arm].joules,
        }
        for arm in ARMS
    }
    commit_bookkeeping_s = time.perf_counter() - started

    stage_seconds = {
        "feature_and_action_row_construction": feature_s,
        "catalogue_construction": catalogue_s,
        "context_eligibility_filter": eligibility_s,
        "coalition_context_construction": contexts_s,
        "action_head_forward": action_head_s,
        "interaction_head_forward": interaction_head_s,
        "catalogue_score_assembly": score_assembly_s,
        "stable_argmax": argmax_s,
        "committed_physical_evaluation": committed_evaluation_s,
        "commit_bookkeeping": commit_bookkeeping_s,
    }
    sum_stages = math.fsum(stage_seconds.values())
    end_to_end_s = time.perf_counter() - all_started
    unassigned_s = end_to_end_s - sum_stages
    row = {
        "anchor_id": anchor_id,
        "world_index": world_index,
        "step_index": step_index,
        "catalogue_rows": len(legal_catalogue),
        "catalogue_score_cells": len(legal_catalogue) * len(ARMS),
        "action_rows": len(action_rows),
        "action_head_scalar_forward_calls": len(action_rows) * len(ARMS) * 4,
        "context_rows": len(contexts),
        "context_missing_rows": len(legal_catalogue) - len(contexts),
        "context_missing_fraction": (len(legal_catalogue) - len(contexts)) / len(legal_catalogue),
        "interaction_head_forward_calls": len(contexts) * len(ARMS),
        "unique_committed_configurations": len(unique_selected),
        "committed_boundary_evaluations": realised.physical_evaluations,
        "stage_seconds": stage_seconds,
        "stage_sum_s": sum_stages,
        "unassigned_wrapper_s": unassigned_s,
        "end_to_end_s": end_to_end_s,
        "over_10_s": end_to_end_s > 10.0,
        "overrun_s": max(0.0, end_to_end_s - 10.0),
        "commits": commit_rows,
        "load_average": list(os.getloadavg()),
    }
    print(
        json.dumps(
            {
                "event": "anchor_done",
                "anchor": anchor_id,
                "catalogue_rows": len(legal_catalogue),
                "context_missing_fraction": row["context_missing_fraction"],
                "stage_seconds": stage_seconds,
                "end_to_end_s": end_to_end_s,
                "load_average": row["load_average"],
            },
            sort_keys=True,
        ),
        flush=True,
    )
    return row


def main() -> int:
    required = ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
    if any(os.environ.get(name) != "1" for name in required):
        raise RuntimeError("all BLAS/OpenMP thread variables must equal 1")
    nice_value = os.getpriority(os.PRIO_PROCESS, 0)
    if nice_value < 15:
        raise RuntimeError(f"niceness {nice_value} is below required 15")

    load_start = list(os.getloadavg())
    pilot = _load_pilot()
    calibration = _calibration(pilot)
    models, checkpoint_sources = _restore_models(pilot)
    tapes, tape_rows = _load_or_build_tapes(pilot)
    expected = _anytime_rows()
    anchors = []
    for world_index in range(1, 5):
        tape = tapes[world_index]
        for step_index in STEPS:
            anchor_id = f"{tape.domain}:step/{step_index}"
            anchors.append(
                _benchmark_anchor(
                    pilot,
                    models,
                    calibration,
                    tape,
                    world_index,
                    step_index,
                    expected[anchor_id],
                )
            )

    stage_names = tuple(anchors[0]["stage_seconds"])
    peak_rss_mib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0
    payload = {
        "schema": "mcrl-v025-selector-latency-diagnostic-v1",
        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
        "panel": "FULL20",
        "anchors": anchors,
        "summary": {
            "end_to_end_s": _distribution([row["end_to_end_s"] for row in anchors]),
            "stage_seconds": {
                name: _distribution([row["stage_seconds"][name] for row in anchors])
                for name in stage_names
            },
            "catalogue_rows": _distribution([row["catalogue_rows"] for row in anchors]),
            "catalogue_score_cells": sum(row["catalogue_score_cells"] for row in anchors),
            "action_rows": _distribution([row["action_rows"] for row in anchors]),
            "context_rows": _distribution([row["context_rows"] for row in anchors]),
            "context_missing_fraction": _distribution(
                [row["context_missing_fraction"] for row in anchors]
            ),
            "pooled_context_missing_fraction": sum(row["context_missing_rows"] for row in anchors)
            / sum(row["catalogue_rows"] for row in anchors),
            "deadline_s": 10.0,
            "miss_count": sum(row["over_10_s"] for row in anchors),
            "miss_fraction": sum(row["over_10_s"] for row in anchors) / len(anchors),
            "margin_s": _distribution([10.0 - row["end_to_end_s"] for row in anchors]),
        },
        "method": {
            "pilot_source": str(PILOT_PATH.relative_to(REPO)),
            "pilot_source_sha256": _sha256(PILOT_PATH),
            "engine_source": str(pilot.ENGINE_PATH.relative_to(REPO)),
            "engine_source_sha256": _sha256(pilot.ENGINE_PATH),
            "benchmark_source": str(Path(__file__).resolve().relative_to(REPO)),
            "benchmark_source_sha256": _sha256(Path(__file__).resolve()),
            "calibration": str(CALIBRATION_PATH.relative_to(REPO)),
            "calibration_sha256": _sha256(CALIBRATION_PATH),
            "checkpoint_seed": SEED,
            "checkpoint_epoch": EPOCH,
            "checkpoints": checkpoint_sources,
            "arms": list(ARMS),
            "training_performed": False,
            "same_anchor_check": "20/20 nearest-eligible base assignments equal anytime receipt",
            "base_timing_note": (
                "The production _build_anchor_rows function rederives and boundary-0 evaluates "
                "the base inside feature construction.  That work cannot be isolated without "
                "changing the deployed function, so it remains charged to the measured total."
            ),
            "timer_note": (
                "Instrumentation lets over-budget stages finish to measure latency; production "
                "contract F2 would cancel at 10 s and execute the prevalidated base."
            ),
        },
        "environment": {
            "python": sys.executable,
            "python_version": platform.python_version(),
            "platform": platform.platform(),
            "cpu": platform.processor(),
            "cpu_count": os.cpu_count(),
            "cpu_affinity": sorted(os.sched_getaffinity(0)),
            "niceness": nice_value,
            "processes_used": 1,
            "thread_environment": {name: os.environ.get(name) for name in required},
            "native_threads_at_end": _thread_count(),
            "load_average_start": load_start,
            "load_average_end": list(os.getloadavg()),
            "peak_rss_mib": peak_rss_mib,
        },
        "world_tapes": tape_rows,
        "anytime_source": {
            "path": str(ANYTIME_PATH.relative_to(REPO)),
            "sha256": _sha256(ANYTIME_PATH),
        },
    }
    unsigned = json.dumps(
        payload, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")
    payload["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT_PATH.write_text(
        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    print(f"PEAK_RSS_MIB={peak_rss_mib:.3f}", flush=True)
    print(
        json.dumps(
            {
                "event": "complete",
                "output": str(OUTPUT_PATH.relative_to(REPO)),
                "summary": payload["summary"],
                "receipt_sha256": payload["receipt_sha256"],
            },
            sort_keys=True,
        ),
        flush=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
