"""Versioned Q1 feature-schema successor; the sealed v1 code stays untouched.

The module is intentionally a projection layer.  Both sealed pilot builders
may produce their authenticated v1 rows first; this layer replaces the dead
geometry coordinate with decision-time geometry, adds focal elevation, removes
two exact indicator duplicates, and emits a row/shard identity that cannot be
mistaken for v1.
"""

from __future__ import annotations

from dataclasses import dataclass
from hashlib import sha256
import json
import math
from typing import Any, Callable, Iterable, Mapping, Sequence


Q1_V1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
Q1_V1_SCHEMA_SHA256 = "c002ea883a4ab727f9e00cc15866f5b9d37abca645963fd3db2f2db7c6cc887a"
Q1_V2_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v2"
ROW_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-row-v2"
SHARD_V2_SCHEMA_VERSION = "mcrl-v025-stagec-source-shard-v2"


class Q1SchemaV2Error(RuntimeError):
    """A v2 schema/projection invariant failed closed."""


def canonical_json_bytes(value: Any) -> bytes:
    try:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
            allow_nan=False,
        ).encode("ascii")
    except (TypeError, ValueError, UnicodeEncodeError) as error:
        raise Q1SchemaV2Error("value is not canonical finite JSON") from error


def canonical_sha256(value: Any) -> str:
    return sha256(canonical_json_bytes(value)).hexdigest()


def float_hex(value: float | int) -> str:
    number = float(value)
    if not math.isfinite(number):
        raise Q1SchemaV2Error("schema floats must be finite")
    return number.hex()


def parse_float_hex(value: object, *, field: str) -> float:
    if not isinstance(value, str):
        raise Q1SchemaV2Error(f"{field} must be a hexadecimal float string")
    try:
        number = float.fromhex(value)
    except ValueError as error:
        raise Q1SchemaV2Error(f"{field} is not a hexadecimal float") from error
    if not math.isfinite(number) or number.hex() != value:
        raise Q1SchemaV2Error(f"{field} is not a canonical finite float")
    return number


@dataclass(frozen=True, slots=True)
class FeatureSpec:
    name: str
    unit: str
    scale: float


# The two exact indicators from v1 are deliberately absent:
#   beam_active_before_focal == 1[background occupancy > 0]
#   previous_beam_active_for_action == 1[previous served load > 0]
Q1_V2_FEATURES = (
    FeatureSpec("nominal_sinr_margin_at_rate_target", "dB", 20.0),
    FeatureSpec("nominal_required_power_over_cap", "ratio", 1.0),
    FeatureSpec("nominal_mode_spectral_efficiency", "bit/s/Hz", 4.0),
    FeatureSpec("background_occupancy_excluding_focal", "user", 10.0),
    FeatureSpec("satellite_active_before_focal", "boolean", 1.0),
    FeatureSpec("off_axis_angle", "rad", 1.0),
    FeatureSpec("focal_link_elevation", "deg", 90.0),
    FeatureSpec("remaining_d2_time", "s", 120.0),
    FeatureSpec("remaining_visibility_time", "s", 120.0),
    FeatureSpec("refresh_phase", "decision", 3.0),
    FeatureSpec("previous_served_association_for_action", "boolean", 1.0),
    FeatureSpec("previous_served_load_for_action", "user", 10.0),
    FeatureSpec("previous_satellite_active_for_action", "boolean", 1.0),
    FeatureSpec("previous_beam_max_rf_over_cap", "ratio", 1.0),
    FeatureSpec("missing_incumbent", "boolean", 1.0),
)
Q1_V2_FEATURE_NAMES = tuple(feature.name for feature in Q1_V2_FEATURES)


Q1_V2_SCHEMA = {
    "schema": Q1_V2_SCHEMA_VERSION,
    "successor_of": {
        "schema": Q1_V1_SCHEMA_VERSION,
        "sha256": Q1_V1_SCHEMA_SHA256,
    },
    "normalization": "raw_value / positive_frozen_scale; signed values retained",
    "shape": [len(Q1_V2_FEATURES)],
    "features": [
        {
            "name": feature.name,
            "unit": feature.unit,
            "scale_hex": float_hex(feature.scale),
        }
        for feature in Q1_V2_FEATURES
    ],
    "changes": {
        "repaired": [
            "off_axis_angle: true satellite-to-(beam centre,user) angle at decision boundary 0, converted from physics degrees to schema radians"
        ],
        "added": [
            "focal_link_elevation: provider boundary-0 elevation in the physics degree convention"
        ],
        "removed_exact_redundancies": [
            "beam_active_before_focal",
            "previous_beam_active_for_action",
        ],
        "retained_structural_coordinate": [
            "missing_incumbent: meaningful for tapes with an unserved prior mapping; structurally zero on the measured pilot tapes"
        ],
        "null_action_geometry": (
            "off_axis_angle and focal_link_elevation are 0 only when the row-level "
            "null_action flag says that no focal link exists"
        ),
    },
    "removed_legacy": ["recurrence_power", "entry_gain_ratio", "segment_age"],
}
Q1_V2_SCHEMA_SHA256 = canonical_sha256(Q1_V2_SCHEMA)


def upgrade_q1_state_v2(
    q1_state_v1: Sequence[float],
    *,
    off_axis_angle_rad: float,
    focal_elevation_deg: float,
    null_action: bool,
) -> tuple[float, ...]:
    """Project one learner-normalized v1 vector to learner-normalized v2."""

    if len(q1_state_v1) != 16:
        raise Q1SchemaV2Error("v1 Q1 state must have exactly 16 slots")
    old = tuple(float(value) for value in q1_state_v1)
    if not all(math.isfinite(value) for value in old):
        raise Q1SchemaV2Error("v1 Q1 state contains a non-finite value")
    angle = float(off_axis_angle_rad)
    elevation = float(focal_elevation_deg)
    if not math.isfinite(angle) or not math.isfinite(elevation):
        raise Q1SchemaV2Error("decision geometry must be finite")
    if null_action:
        if angle != 0.0 or elevation != 0.0:
            raise Q1SchemaV2Error("null action geometry must use the explicit absent-link zeros")
    elif not (0.0 <= angle <= math.pi and -90.0 <= elevation <= 90.0):
        raise Q1SchemaV2Error("non-null decision geometry is outside physical bounds")

    # Old slots 4 and 12 are excluded. Old slot 6 is replaced, not reused.
    projected = (
        *old[0:4],
        old[5],
        angle,
        elevation / 90.0,
        *old[7:12],
        *old[13:16],
    )
    if len(projected) != len(Q1_V2_FEATURES):
        raise AssertionError("internal v2 projection length drifted")
    return projected


def project_row_payload_v2(
    parent_payload: Mapping[str, object],
    *,
    off_axis_angle_rad: float,
    focal_elevation_deg: float,
    geometry_source: str,
) -> dict[str, object]:
    """Create an authenticated v2 row payload from a readable sealed v1 row."""

    if parent_payload.get("q1_schema_sha256") != Q1_V1_SCHEMA_SHA256:
        raise Q1SchemaV2Error("parent row is not the sealed Q1 v1 schema")
    raw_state = parent_payload.get("q1_state")
    if not isinstance(raw_state, list) or len(raw_state) != 16:
        raise Q1SchemaV2Error("parent q1_state is malformed")
    old = tuple(parse_float_hex(value, field="q1_state") for value in raw_state)
    null_action = parent_payload.get("null_action")
    if type(null_action) is not bool:
        raise Q1SchemaV2Error("parent null_action is not boolean")
    state = upgrade_q1_state_v2(
        old,
        off_axis_angle_rad=off_axis_angle_rad,
        focal_elevation_deg=focal_elevation_deg,
        null_action=null_action,
    )
    if not geometry_source:
        raise Q1SchemaV2Error("geometry source must be named")

    result = dict(parent_payload)
    result["schema"] = ROW_V2_SCHEMA_VERSION
    result["q1_state"] = [float_hex(value) for value in state]
    result["q1_schema_sha256"] = Q1_V2_SCHEMA_SHA256
    result["q1_v1_parent_row_sha256"] = canonical_sha256(parent_payload)
    result["q1_geometry_source"] = geometry_source
    result["q1_visible_primitives_sha256"] = canonical_sha256(
        {
            "parent_visible_primitives_sha256": parent_payload.get(
                "visible_primitives_sha256"
            ),
            "off_axis_angle_rad_hex": float_hex(off_axis_angle_rad),
            "focal_elevation_deg_hex": float_hex(focal_elevation_deg),
            "geometry_source": geometry_source,
        }
    )
    validate_v2_row_payload(result)
    return result


def validate_v2_row_payload(payload: Mapping[str, object]) -> None:
    if payload.get("schema") != ROW_V2_SCHEMA_VERSION:
        raise Q1SchemaV2Error("row schema is not Q1 v2")
    if payload.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256:
        raise Q1SchemaV2Error("row Q1 digest is not Q1 v2")
    state = payload.get("q1_state")
    if not isinstance(state, list) or len(state) != len(Q1_V2_FEATURES):
        raise Q1SchemaV2Error("v2 row state dimension drifted")
    for value in state:
        parse_float_hex(value, field="q1_state")
    for field in ("q1_v1_parent_row_sha256", "q1_visible_primitives_sha256"):
        digest = payload.get(field)
        if (
            not isinstance(digest, str)
            or len(digest) != 64
            or any(character not in "0123456789abcdef" for character in digest)
        ):
            raise Q1SchemaV2Error(f"{field} is not a lowercase SHA-256")


def encode_v2_shard(rows: Iterable[Mapping[str, object]]) -> bytes:
    """Serialize a canonical v2 shard with its own digest in every row/header."""

    material = [dict(row) for row in rows]
    if not material:
        raise Q1SchemaV2Error("cannot encode an empty v2 shard")
    for row in material:
        validate_v2_row_payload(row)
    q2_digests = {row.get("q2_schema_sha256") for row in material}
    if len(q2_digests) != 1:
        raise Q1SchemaV2Error("v2 shard rows disagree on Q2 schema")
    header = {
        "schema": SHARD_V2_SCHEMA_VERSION,
        "row_count": len(material),
        "rows_sha256": canonical_sha256(material),
        "q1_schema_sha256": Q1_V2_SCHEMA_SHA256,
        "q2_schema_sha256": next(iter(q2_digests)),
    }
    return b"\n".join(canonical_json_bytes(value) for value in (header, *material)) + b"\n"


