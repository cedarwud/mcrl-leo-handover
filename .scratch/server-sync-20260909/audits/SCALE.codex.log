+            "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+            "processes_used": 1, "thread_environment": {name: os.environ[name] for name in THREAD_VARS},
+            "peak_rss_mib": peak_mib, "wall_s": time.perf_counter() - started,
+            "load_average_end": list(os.getloadavg()),
