   221	                "attained_match": attained == int(cached["rate_target_attained_count"]),
   222	                "candidate_id_match": str(candidate.candidate_id) == str(cached["candidate_id"]),
   223	                "fresh_candidate_id": str(candidate.candidate_id),
   224	                "cached_candidate_id": str(cached["candidate_id"]),
