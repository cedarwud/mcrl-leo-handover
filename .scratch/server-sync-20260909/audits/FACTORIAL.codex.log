   205	        attained = int(np.count_nonzero(result.bits[0] >= float(target)))
   206	        exact_match = (
   207	            capacity == unpair(cached["capacity"])
   208	            and demand_capped == unpair(cached["demand_capped"])
   209	            and energy == unpair(cached["energy"])
   210	            and served == int(cached["served_count"])
   211	            and attained == int(cached["rate_target_attained_count"])
   212	            and str(candidate.candidate_id) == str(cached["candidate_id"])
