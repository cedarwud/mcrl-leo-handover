   511	def optimize(anchors: Sequence[Mapping[str, object]], numerator: str, selector: str) -> dict:
   512	    if numerator not in NUMERATORS or selector not in SELECTORS:
   513	        raise RuntimeError("unknown optimization arm")
   514	    eta = sum((unpair(a["profiles"][0][numerator]) for a in anchors), Fraction()) / sum(  # type: ignore[index]
   515	        (unpair(a["profiles"][0]["energy"]) for a in anchors), Fraction()  # type: ignore[index]
   516	    )
   517	    trace = []
   518	    previous = None
   519	    for iteration in range(1, MAX_DINKELBACH + 1):
   520	        selected = []
   521	        for anchor in anchors:
   522	            eligible = [row for row in anchor["profiles"] if  # type: ignore[index]
   523	                        bool(row["valid"]) and int(row["served_count"]) >= int(anchor["base_guard_served_count"])]
   524	            nkey = numerator if selector == "WITH_RESIDUAL" else f"additive_{numerator}"
   525	            ekey = "energy" if selector == "WITH_RESIDUAL" else "additive_energy"
   526	            scored = [(unpair(row[nkey]) - eta * unpair(row[ekey]), row) for row in eligible]
   527	            best_score = max(score for score, _row in scored)
   528	            tied = [row for score, row in scored if score == best_score]
   529	            incumbent = next((row for row in tied if int(row["index"]) == 0), None)
   530	            selected.append(incumbent if incumbent is not None else min(tied, key=lambda row: str(row["candidate_id"])))
   531	        nkey = numerator if selector == "WITH_RESIDUAL" else f"additive_{numerator}"
   532	        ekey = "energy" if selector == "WITH_RESIDUAL" else "additive_energy"
   533	        pseudo_n = sum((unpair(row[nkey]) for row in selected), Fraction())
   534	        pseudo_e = sum((unpair(row[ekey]) for row in selected), Fraction())
   535	        if pseudo_e <= 0:
   536	            raise RuntimeError("Dinkelbach pseudo-energy is not positive")
   537	        new_eta = pseudo_n / pseudo_e
   538	        ids = tuple(str(row["candidate_id"]) for row in selected)
   539	        residual = pseudo_n - eta * pseudo_e
   540	        trace.append({
   541	            "iteration": iteration,
   542	            "eta": _fraction_pair(eta),
   543	            "selected_candidate_ids": list(ids),
   544	            "surplus_residual": _fraction_pair(residual),
   545	        })
   546	        if new_eta == eta:
   547	            break
   548	        if ids == previous:
   549	            raise RuntimeError("selection fixed without exact Dinkelbach price equality")
   550	        previous = ids
   551	        eta = new_eta
   552	    else:
   553	        raise RuntimeError("Dinkelbach iteration cap reached")
   554	    actual_n = sum((unpair(row[numerator]) for row in selected), Fraction())
   555	    actual_e = sum((unpair(row["energy"]) for row in selected), Fraction())
   556	    return {
   557	        "selector": selector,
   558	        "numerator": numerator,
   559	        "iterations": len(trace),
   560	        "optimization_ratio": _fraction_pair(eta),
   561	        "selected_indices": [int(row["index"]) for row in selected],
   562	        "selected_candidate_ids": [str(row["candidate_id"]) for row in selected],
   563	        "actual_numerator": _fraction_pair(actual_n),
   564	        "actual_energy": _fraction_pair(actual_e),
   565	        "actual_ee_bit_per_j": float(actual_n / actual_e),
   566	        "trace": trace,
   567	    }
