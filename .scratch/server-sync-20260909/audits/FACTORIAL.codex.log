  1563	def _projection_from_profile(
  1564	    *,
  1565	    offset: int,
  1566	    profile: EvaluatedProfile | None,
  1567	    survives: bool,
  1568	) -> OffsetProjection:
  1569	    return OffsetProjection(
  1570	        offset,
  1630	                for user in config.mapping
  1631	                if config.mapping[user] != transition.mapping.get(user)
  1632	            )
  1633	            survives = profile is not None and all(
  1634	                profile.score.served_phy.get(user, False) for user in changed
  1635	            )
  1636	            projection = _projection_from_profile(
  1637	                offset=offset, profile=profile, survives=survives
  1638	            )
  1639	            by_config[config.configuration_id].append(projection)
  1640	            receipts.append(
  1641	                {
  1642	                    "schema": f"{SCHEMA}-forecast-margin-row-v1",
  1643	                    "configuration_id": config.configuration_id,
  1644	                    "offset": offset,
  1645	                    "valid": projection.valid,
  1646	                    "survives": projection.survives,
  1647	                    "required_power_w": projection.required_power_w,
  1648	                    "power_cap_w": projection.power_cap_w,
  1649	                    "required_power_cap_margin_w": projection.required_power_cap_margin_w,
  1650	                    "min_decoding_margin_db": projection.min_decoding_margin_db,
  1651	                    "mean_acm_se_bit_s_hz": projection.mean_acm_se_bit_s_hz,
  1652	                }
  1653	            )
  1654	    validated: dict[str, tuple[OffsetProjection, ...]] = {}
  1655	    for config in configs:
  1656	        rows = tuple(by_config[config.configuration_id])
  1657	        if all(row.valid for row in rows):
  1658	            def replay_projection(
  1659	                index: int,
  1660	                _time_s: float,
  1661	                assignments: Mapping[int, tuple[int, int] | None],
  1662	                recompute_background: bool,
  1663	                *,
  1664	                expected_assignments: Mapping[int, tuple[int, int] | None] = config.mapping,
  1665	                projections: tuple[OffsetProjection, ...] = rows,
  1666	            ) -> OffsetProjection:
  1667	                if assignments != expected_assignments or not recompute_background:
  1668	                    raise ProbeError("forecast projection replay contract drifted")
  1669	                return projections[index - 1]
  1670	
  1671	            rows = project_three_offsets(
  1672	                assignments=config.mapping,
  1673	                evaluator=replay_projection,
  1674	                architecture=setting.architecture,
  1675	                lambda_bits_per_j=calibration.lambda_bits_per_j,
  1676	                eta_ref=calibration.eta_ref,
  1677	                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1678	            )
  1679	        validated[config.configuration_id] = rows
  1680	    return validated, tuple(receipts)
