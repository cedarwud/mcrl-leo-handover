SOURCE_RUNNER = ROOT / "scripts/run_oracle_residual_toggle.py"
SOURCE_RECEIPT = ROOT / ".scratch/oracle-residual-toggle-20260910/result.json"
SOURCE_SELECTED = ROOT / ".scratch/oracle-residual-toggle-20260910/selected-records.json"
OUTPUT = ROOT / ".scratch/oracle-full-span/results.json"
REPORT = ROOT / "ORACLE-FULL-SPAN-2026-09-10.md"
SCHEMA = "mcrl-v025-oracle-full-span-v1"
CLAIM = "DIAGNOSTIC_NOT_CLAIM"
SELECTORS = ("BASELINE", "ADDITIVE_ONLY", "WITH_RESIDUAL")
NUMERATORS = ("capacity", "demand_capped")
EXPECTED_SOURCE_HASHES = {
    "runner": "e204ddf332ffdbc98679a2b9b4cb63261f137a9fb42b08edfad58506587a10a3",
    "receipt": "0149f167208565f85dec9fcd349dcc90ac1703b2357b22b79e24131018414f71",
    "selected_records": "5b729294785de203a24bb541de8a12e817625f1f3d5a18169b53ba5b2e9fad57",
}


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("ascii")).hexdigest()


def load_source_runner():
    spec = importlib.util.spec_from_file_location("oracle_full_span_source", SOURCE_RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {SOURCE_RUNNER}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def unpair(pair: Sequence[int]) -> Fraction:
    return Fraction(int(pair[0]), int(pair[1]))


def pair(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def exact(value: float) -> Fraction:
    value = float(value)
    if not math.isfinite(value):
        raise RuntimeError("non-finite physical value")
    return Fraction.from_float(value)


def selected_indices(receipt: Mapping[str, object], numerator: str, selector: str) -> list[int]:
    if selector == "BASELINE":
        return [0] * len(receipt["anchors"])  # type: ignore[arg-type]
    return [int(value) for value in receipt["optimizations"][f"{numerator}:{selector}"]["selected_indices"]]  # type: ignore[index]


def detail(anchor: Mapping[str, object], index: int, numerator: str) -> dict:
    profile = anchor["profiles"][index]  # type: ignore[index]
    definition = anchor["candidate_definitions"][index]  # type: ignore[index]
    n = unpair(profile[numerator])
    e = unpair(profile["energy"])
    return {
        "candidate_index": index,
        "candidate_id": str(profile["candidate_id"]),
        "configuration_id": str(definition["configuration_id"]),
        "candidate_size": int(profile["size"]),
        "numerator": pair(n),
        "energy": pair(e),
        "ee_bit_per_j": float(n / e),
        "served_count": int(profile["served_count"]),
        "rate_target_attained_count": int(profile["rate_target_attained_count"]),
    }


def pooled(receipt: Mapping[str, object], numerator: str, selector: str) -> dict:
    indices = selected_indices(receipt, numerator, selector)
    rows = [detail(anchor, index, numerator)
            for anchor, index in zip(receipt["anchors"], indices, strict=True)]  # type: ignore[arg-type]
    n = sum((unpair(row["numerator"]) for row in rows), Fraction())
    e = sum((unpair(row["energy"]) for row in rows), Fraction())
    return {
        "selected_indices": indices,
        "selected_candidate_ids": [row["candidate_id"] for row in rows],
        "numerator": pair(n),
        "energy": pair(e),
        "pooled_ee_bit_per_j": float(n / e),
        "served_count": sum(row["served_count"] for row in rows),
        "rate_target_attained_count": sum(row["rate_target_attained_count"] for row in rows),
        "candidate_size_distribution": dict(sorted(Counter(
            str(row["candidate_size"]) for row in rows
        ).items())),
        "per_anchor": rows,
    }


def contrast(left: Mapping[str, object], right: Mapping[str, object]) -> dict:
    left_n, left_e = unpair(left["numerator"]), unpair(left["energy"])  # type: ignore[arg-type]
    right_n, right_e = unpair(right["numerator"]), unpair(right["energy"])  # type: ignore[arg-type]
    left_ee, right_ee = left_n / left_e, right_n / right_e
    return {
        "gain_relative": pair(right_ee / left_ee - 1),
        "gain_percentage": 100.0 * float(right_ee / left_ee - 1),
        "numerator_delta": pair(right_n - left_n),
        "energy_delta": pair(right_e - left_e),
        "served_delta": int(right["served_count"]) - int(left["served_count"]),
        "rate_target_attained_delta": (
            int(right["rate_target_attained_count"])
            - int(left["rate_target_attained_count"])
        ),
    }


def decompose_span(baseline: Mapping[str, object], residual: Mapping[str, object]) -> dict:
    """Exact path decomposition: bits first at E0, then energy at N1."""

    n0, e0 = unpair(baseline["numerator"]), unpair(baseline["energy"])  # type: ignore[arg-type]
    n1, e1 = unpair(residual["numerator"]), unpair(residual["energy"])  # type: ignore[arg-type]
    ee0, ee1 = n0 / e0, n1 / e1
    bits_absolute = (n1 - n0) / e0
    energy_absolute = n1 / e1 - n1 / e0
    total_absolute = ee1 - ee0
    if bits_absolute + energy_absolute != total_absolute:
        raise RuntimeError("EE decomposition failed exact closure")
    bits_relative = bits_absolute / ee0
    energy_relative = energy_absolute / ee0
    total_relative = total_absolute / ee0
    return {
        "method": "credit numerator delta at baseline energy, then credit energy delta at final numerator",
        "numerator_delta": pair(n1 - n0),
        "energy_reduction": pair(e0 - e1),
        "ee_gain_bit_per_j": pair(total_absolute),
        "bits_component_bit_per_j": pair(bits_absolute),
        "energy_component_bit_per_j": pair(energy_absolute),
        "total_relative": pair(total_relative),
        "bits_component_relative": pair(bits_relative),
        "energy_component_relative": pair(energy_relative),
        "bits_share_of_ee_gain": pair(bits_absolute / total_absolute),
        "energy_share_of_ee_gain": pair(energy_absolute / total_absolute),
        "exact_closure": True,
    }


def evaluate_baseline_per_user(source, receipt: Mapping[str, object]) -> dict:
    from mcrl.physics_v025.provider_legacy import factory

    deliveries: dict[str, list[float]] = {}
    checks = []
    for anchor in receipt["anchors"]:  # type: ignore[assignment]
        step_index = int(anchor["step_index"])
        tape = source.probe.build_world_tape(
            domain=str(anchor["world_domain"]), provider=factory(),
            steps=source.ANCHORS_PER_WORLD, start_time_s=0.0,
        )
        base = source.probe._base_configuration(tape, step_index, "nearest-eligible")
        users = tuple(int(value) for value in anchor["users"])
        catalogue_base = source.probe._configuration(
            base, dict(base.mapping), kind="residual-toggle-incumbent",
        )
        candidate = source.Candidate(
            catalogue_base, (0,) * len(users),
            source.candidate_id(catalogue_base, (0,) * len(users)),
            ("incumbent",),
        )
        eval_users, result, _trace = source.evaluate_candidates(
            tape, step_index, (candidate,), capture=False,
        )
        if tuple(eval_users) != users:
            raise RuntimeError("baseline user order drifted")
        cached = anchor["profiles"][0]
        capacity = sum((exact(value) for value in result.bits[0]), Fraction())
        target = exact(source.CONTRACT_RATE_BPS * source.INTERVAL_S)
        demand_capped = sum((min(exact(value), target) for value in result.bits[0]), Fraction())
        energy = exact(result.joules[0])
        served = int(np.count_nonzero(result.decoding_time_s[0] > 0.0))
        attained = int(np.count_nonzero(result.bits[0] >= float(target)))
        exact_match = (
            capacity == unpair(cached["capacity"])
            and demand_capped == unpair(cached["demand_capped"])
            and energy == unpair(cached["energy"])
            and served == int(cached["served_count"])
            and attained == int(cached["rate_target_attained_count"])
            and str(candidate.candidate_id) == str(cached["candidate_id"])
        )
        if not exact_match:
            raise RuntimeError(json.dumps({
                "cached_baseline_mismatch": str(anchor["anchor_id"]),
                "capacity_match": capacity == unpair(cached["capacity"]),
                "demand_capped_match": demand_capped == unpair(cached["demand_capped"]),
                "energy_match": energy == unpair(cached["energy"]),
                "served_match": served == int(cached["served_count"]),
                "served_match": served == int(cached["served_count"]),
                "attained_match": attained == int(cached["rate_target_attained_count"]),
                "candidate_id_match": str(candidate.candidate_id) == str(cached["candidate_id"]),
                "fresh_candidate_id": str(candidate.candidate_id),
                "cached_candidate_id": str(cached["candidate_id"]),
            }, sort_keys=True))
        deliveries[str(anchor["anchor_id"])] = [float(value) for value in result.bits[0]]
        checks.append({
            "anchor_id": str(anchor["anchor_id"]),
            "candidate_zero_exact_match": True,
            "capacity": pair(capacity),
            "demand_capped": pair(demand_capped),
            "energy": pair(energy),
            "served_count": served,
            "rate_target_attained_count": attained,
        })
        print(json.dumps({
            "baseline_exact_match": str(anchor["anchor_id"]),
            "users": len(users),
        }, sort_keys=True), flush=True)
    return {"deliveries": deliveries, "checks": checks}


def monotonicity_audit(
    receipt: Mapping[str, object], selected_records: Mapping[str, object],
    baseline_delivery: Mapping[str, Sequence[float]], numerator: str,
) -> dict:
    indices = selected_indices(receipt, numerator, "WITH_RESIDUAL")
    records = {
        (str(row["anchor_id"]), int(row["candidate_index"])): row
        for row in selected_records["records"]  # type: ignore[assignment]
    }
    per_anchor = []
    all_deltas: list[float] = []
    violations = []
    for anchor, index in zip(receipt["anchors"], indices, strict=True):  # type: ignore[arg-type]
        anchor_id = str(anchor["anchor_id"])
        record = records[(anchor_id, index)]
        base = baseline_delivery[anchor_id]
        selected = record["per_user_delivery"]
        if len(base) != len(selected):
            raise RuntimeError("per-user delivery width mismatch")
        anchor_deltas = []
        for column, (b, row) in enumerate(zip(base, selected, strict=True)):
            if int(row["user"]) != int(anchor["users"][column]):
                raise RuntimeError("selected-record user order mismatch")
            delta = float(row["delivered_bits"]) - float(b)
            anchor_deltas.append(delta)
            all_deltas.append(delta)
            if delta < 0.0:
                violations.append({
                    "anchor_id": anchor_id,
                    "user": int(row["user"]),
                    "delta_bits": delta,
                })
        per_anchor.append({
            "anchor_id": anchor_id,
            "nondecreasing_users": sum(delta >= 0.0 for delta in anchor_deltas),
            "decreasing_users": sum(delta < 0.0 for delta in anchor_deltas),
            "minimum_delta_bits": min(anchor_deltas),
            "maximum_delta_bits": max(anchor_deltas),
        })
    return {
        "checked_user_anchor_pairs": len(all_deltas),
        "nondecreasing": not violations,
        "nondecreasing_pairs": sum(delta >= 0.0 for delta in all_deltas),
        "decreasing_pairs": len(violations),
        "minimum_delta_bits": min(all_deltas),
        "maximum_delta_bits": max(all_deltas),
        "violations": violations,
        "per_anchor": per_anchor,
    }


def pct(pair_value: Sequence[int]) -> str:
    return f"{100.0 * float(unpair(pair_value)):+.2f}%"


def selector_table(block: Mapping[str, object]) -> list[str]:
    lines = [
        "| selector | pooled EE (Mbit/J) | numerator (Gbit) | energy (J) | served | rate-target attained | selected-size counts |",
        "| --- | ---: | ---: | ---: | ---: | ---: | --- |",
    ]
    for selector in SELECTORS:
        row = block["selectors"][selector]  # type: ignore[index]
        lines.append(
            f"| `{selector}` | {row['pooled_ee_bit_per_j']/1e6:.6f} | "
            f"{float(unpair(row['numerator']))/1e9:.6f} | "
            f"{float(unpair(row['energy'])):.6f} | {row['served_count']} | "
            f"{row['rate_target_attained_count']} | `{row['candidate_size_distribution']}` |"
        )
    return lines


def render_report(results: Mapping[str, object], results_file_sha256: str) -> str:
    cap = results["numerators"]["capacity"]  # type: ignore[index]
    dem = results["numerators"]["demand_capped"]  # type: ignore[index]
    first = (
        f"**`WITH_RESIDUAL - BASELINE` is {pct(cap['contrasts']['WITH_RESIDUAL-BASELINE']['gain_relative'])} "
        f"on `CAPACITY` (stagewise split: {pct(cap['contrasts']['ADDITIVE_ONLY-BASELINE']['gain_relative'])} additive, then "
        f"{pct(cap['contrasts']['WITH_RESIDUAL-ADDITIVE_ONLY']['gain_relative'])} residual) and "
        f"{pct(dem['contrasts']['WITH_RESIDUAL-BASELINE']['gain_relative'])} on `DEMAND_CAPPED` "
        f"(stagewise split: {pct(dem['contrasts']['ADDITIVE_ONLY-BASELINE']['gain_relative'])} additive, then "
        f"{pct(dem['contrasts']['WITH_RESIDUAL-ADDITIVE_ONLY']['gain_relative'])} residual).**"
    )
    lines = [
        first, "", "# Oracle full span — 2026-09-10", "", "`DIAGNOSTIC_NOT_CLAIM`", "",
        "## Decisive result", "",
        "`BASELINE` is the committed nearest-eligible incumbent itself, evaluated with no catalogue selection. It is not `ALL_NEUTRAL_CONTROL`.", "",
    ]
    for key, label in (("capacity", "CAPACITY"), ("demand_capped", "DEMAND_CAPPED")):
        block = results["numerators"][key]  # type: ignore[index]
        lines += [f"### {label}", ""]
        lines += selector_table(block)
        lines += ["", "| contrast | pooled EE gain | what it isolates |", "| --- | ---: | --- |"]
        for contrast_key, isolation in (
            ("ADDITIVE_ONLY-BASELINE", "per-user additive routes over the committed reference"),
            ("WITH_RESIDUAL-ADDITIVE_ONLY", "exact set-residual marginal"),
            ("WITH_RESIDUAL-BASELINE", "whole-system span"),
        ):
            lines.append(f"| `{contrast_key.replace('-', ' - ')}` | **{pct(block['contrasts'][contrast_key]['gain_relative'])}** | {isolation} |")
        lines += [
            "", "Per-anchor whole-system span:", "",
            "| anchor | baseline EE | with-residual EE | span | sizes B/R | served B/R | target B/R |",
            "| --- | ---: | ---: | ---: | ---: | ---: | ---: |",
        ]
        baseline_rows = block["selectors"]["BASELINE"]["per_anchor"]
        residual_rows = block["selectors"]["WITH_RESIDUAL"]["per_anchor"]
        for anchor, b, r in zip(results["anchor_ids"], baseline_rows, residual_rows, strict=True):
            gain = r["ee_bit_per_j"] / b["ee_bit_per_j"] - 1.0
            lines.append(
                f"| {anchor} | {b['ee_bit_per_j']/1e6:.6f} | {r['ee_bit_per_j']/1e6:.6f} | "
                f"{100.0*gain:+.2f}% | {b['candidate_size']}/{r['candidate_size']} | "
                f"{b['served_count']}/{r['served_count']} | "
                f"{b['rate_target_attained_count']}/{r['rate_target_attained_count']} |"
            )
        lines.append("")

    lines += ["## Span decomposition", ""]
    for key, label in (("capacity", "CAPACITY"), ("demand_capped", "DEMAND_CAPPED")):
        block = results["numerators"][key]  # type: ignore[index]
        d = block["decomposition"]
        audit = block["per_user_nondecrease_audit"]
        lines += [
            f"### {label}", "",
            f"The span adds **{float(unpair(d['numerator_delta']))/1e9:.6f} Gbit** and "
            f"reduces energy by **{float(unpair(d['energy_reduction'])):.6f} J**. "
            "Using the exact path decomposition that first credits the numerator change at baseline energy and then credits the energy change at the final numerator:", "",
            "| component | EE contribution (Mbit/J) | relative to baseline EE | share of total EE gain |",
            "| --- | ---: | ---: | ---: |",
            f"| extra credited bits | {float(unpair(d['bits_component_bit_per_j']))/1e6:.6f} | {pct(d['bits_component_relative'])} | {100.0*float(unpair(d['bits_share_of_ee_gain'])):.2f}% |",
            f"| reduced energy | {float(unpair(d['energy_component_bit_per_j']))/1e6:.6f} | {pct(d['energy_component_relative'])} | {100.0*float(unpair(d['energy_share_of_ee_gain'])):.2f}% |",
            f"| total | {float(unpair(d['ee_gain_bit_per_j']))/1e6:.6f} | {pct(d['total_relative'])} | 100.00% |",
            "",
            f"Per-user delivery is **{'nondecreasing' if audit['nondecreasing'] else 'not nondecreasing'}** over all "
            f"{audit['checked_user_anchor_pairs']} user-anchor comparisons for this selector: "
            f"{audit['decreasing_pairs']} decreases; minimum delta {audit['minimum_delta_bits']/1e6:.6f} Mbit. "
            + (
                "Therefore the positive reduced-energy component survives every per-user nondecreasing numerator: the numerator cannot fall while the denominator falls."
                if audit["nondecreasing"] else
                "Therefore the reduced-energy component is positive for the reported numerator, but the stronger any-numerator guarantee does not follow."
            ), "",
        ]

    lines += [
        "## Evidence classification", "",
        "### Verified by running code", "",
        "The prior receipt, selected-record file, and source runner matched their declared SHA-256 hashes. The cached exact-Fraction candidate-zero totals were checked against eight fresh, single-configuration evaluations through the same corrected realised 48-boundary path; all eight matched exactly. The prior Dinkelbach selections were not rerun. The per-user nondecrease audits compare those freshly recovered incumbent deliveries with the already-cached `WITH_RESIDUAL` custody records.", "",
        "### Derived on paper", "",
        "All three pooled ratios, the three contrasts, and the decomposition are exact rational arithmetic over cached binary64 values. The decomposition is the identity `N1/E1 - N0/E0 = (N1-N0)/E0 + N1(1/E1-1/E0)`; it closes exactly. The displayed decimals are formatting only.", "",
        "### Inferred", "",
        "These are exact oracle terms, so every number here is a ceiling on what learned heads could deliver, not an achievable value. No learnability or learned-policy claim follows. Loss values are never evidence about EE.", "",
        "## Fixed scope and custody", "",
        "Nothing was tuned. The fixed catalogue construction, eligibility guard, incumbent-first/lexicographic tie-break, corrected `Gamma/q_0.10(elevation)` provisioning, exact coupled-power solve, eight anchors, exact-Fraction common-price Dinkelbach selections, and realised 48-boundary pooled-ratio reporting are inherited unchanged from the residual-toggle receipt.", "",
        f"Machine result: `.scratch/oracle-full-span/results.json` (SHA-256 `{results_file_sha256}`). Source receipt SHA-256: `{results['provenance']['source_receipt_sha256']}`; source selected-record SHA-256: `{results['provenance']['source_selected_records_sha256']}`; full-span runner SHA-256: `{results['provenance']['runner_sha256']}`.", "",
        "Reproduction from `/home/sat/mcrl-v025-arch-ws`:", "", "```bash",
        "env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \\",
        "  NUMEXPR_NUM_THREADS=1 PYTHONPATH=src nice -n 15 \\",
        "  /home/sat/mcrl-leo-handover/.venv/bin/python \\",
        "  scripts/run_oracle_full_span.py", "```", "",
        "Exactly one Python process is used. It does not write to the reference checkout or virtual environment, and it does not open a learner, training run, policy run, test split, search grid, manifest, or optimizer configuration.", "",
    ]
    return "\n".join(lines)


def main() -> int:
    actual_hashes = {
        "runner": sha256(SOURCE_RUNNER),
        "receipt": sha256(SOURCE_RECEIPT),
        "selected_records": sha256(SOURCE_SELECTED),
    }
    if actual_hashes != EXPECTED_SOURCE_HASHES:
        raise RuntimeError(f"source custody mismatch: {actual_hashes}")
    source = load_source_runner()
    receipt = json.loads(SOURCE_RECEIPT.read_text(encoding="ascii"))
    selected_records = json.loads(SOURCE_SELECTED.read_text(encoding="ascii"))
    if receipt["schema"] != "mcrl-v025-oracle-residual-toggle-v1":
        raise RuntimeError("unexpected source schema")
    if receipt["claim_ceiling"] != CLAIM:
        raise RuntimeError("source claim label drifted")
    if receipt["selected_records"]["records_sha256"] != selected_records["records_sha256"]:
        raise RuntimeError("selected-record canonical digest mismatch")

    baseline_eval = evaluate_baseline_per_user(source, receipt)
    numerator_blocks = {}
    for numerator in NUMERATORS:
        selectors = {selector: pooled(receipt, numerator, selector) for selector in SELECTORS}
        for selector in ("ADDITIVE_ONLY", "WITH_RESIDUAL"):
            source_opt = receipt["optimizations"][f"{numerator}:{selector}"]
            if (
                unpair(selectors[selector]["numerator"]) != unpair(source_opt["actual_numerator"])
                or unpair(selectors[selector]["energy"]) != unpair(source_opt["actual_energy"])
            ):
                raise RuntimeError(f"exact optimizer totals did not reproduce for {numerator}:{selector}")
        contrasts = {
            "ADDITIVE_ONLY-BASELINE": contrast(selectors["BASELINE"], selectors["ADDITIVE_ONLY"]),
            "WITH_RESIDUAL-ADDITIVE_ONLY": contrast(selectors["ADDITIVE_ONLY"], selectors["WITH_RESIDUAL"]),
            "WITH_RESIDUAL-BASELINE": contrast(selectors["BASELINE"], selectors["WITH_RESIDUAL"]),
        }
        source_gain = float(receipt["summary"][numerator]["pooled_gain_relative"])
        derived_gain = float(unpair(contrasts["WITH_RESIDUAL-ADDITIVE_ONLY"]["gain_relative"]))
        if not math.isclose(source_gain, derived_gain, rel_tol=0.0, abs_tol=2e-15):
            raise RuntimeError("residual marginal did not reproduce")
        audit = monotonicity_audit(
            receipt, selected_records, baseline_eval["deliveries"], numerator,
        )
        decomposition = decompose_span(selectors["BASELINE"], selectors["WITH_RESIDUAL"])
        decomposition["energy_component_positive"] = (
            unpair(decomposition["energy_component_bit_per_j"]) > 0
        )
        decomposition["any_per_user_nondecreasing_numerator_guarantee"] = bool(
            decomposition["energy_component_positive"] and audit["nondecreasing"]
        )
        numerator_blocks[numerator] = {
            "selectors": selectors,
            "contrasts": contrasts,
            "decomposition": decomposition,
            "per_user_nondecrease_audit": audit,
        }

    results = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM,
        "baseline_definition": "committed nearest-eligible incumbent; no catalogue selection",
        "baseline_is_all_neutral_control": False,
        "anchor_ids": [str(anchor["anchor_id"]) for anchor in receipt["anchors"]],
        "numerators": numerator_blocks,
        "baseline_re_evaluation_checks": baseline_eval["checks"],
        "reuse": {
            "catalogue_rebuilt": False,
            "candidate_profiles_rerun": False,
            "dinkelbach_rerun": False,
            "baseline_single_configuration_evaluations": 8,
        },
        "sealed_settings_changed": False,
        "learner_used": False,
        "training_run_used": False,
        "policy_run_used": False,
        "test_split_opened": False,
        "python": sys.executable,
        "python_version": platform.python_version(),
        "thread_environment": {name: os.environ.get(name) for name in (
            "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS",
        )},
        "python_processes": 1,
        "provenance": {
            "source_runner": str(SOURCE_RUNNER.relative_to(ROOT)),
            "source_runner_sha256": actual_hashes["runner"],
            "source_receipt": str(SOURCE_RECEIPT.relative_to(ROOT)),
            "source_receipt_sha256": actual_hashes["receipt"],
            "source_selected_records": str(SOURCE_SELECTED.relative_to(ROOT)),
            "source_selected_records_sha256": actual_hashes["selected_records"],
            "source_receipt_canonical_sha256": receipt["receipt_sha256"],
            "source_selected_records_canonical_sha256": selected_records["records_sha256"],
            "workspace_commit": subprocess.check_output(
                ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True,
            ).strip(),
            "reference_commit": receipt["reference_commit"],
            "runner_sha256": sha256(Path(__file__).resolve()),
        },
        "evidence_classification": {
            "verified_by_running_code": [
                "source custody hashes",
                "eight cached candidate-zero profiles against fresh single-configuration evaluations",
                "per-user baseline-to-with-residual delivery monotonicity",
            ],
            "derived_on_paper": [
                "pooled selector ratios and three contrasts from exact cached fractions",
                "exact path decomposition of EE gain into numerator and energy components",
            ],
            "inferred": [
                "oracle values are ceilings on learned heads, not achievable values",
                "scope of the any-numerator energy-component guarantee",
            ],
        },
    }
    results["canonical_payload_sha256"] = canonical_sha256(results)
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(json.dumps(results, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
    output_sha = sha256(OUTPUT)
    REPORT.write_text(render_report(results, output_sha), encoding="utf-8")
    print(json.dumps({
        "output": str(OUTPUT),
        "output_sha256": output_sha,
