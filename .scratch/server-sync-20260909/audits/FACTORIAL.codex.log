  2548	        "selected_acm_mode_counts": dict(sorted(selected.acm_mode_counts.items())),
  2549	        "se_plateau_user_steps": selected.se_plateau_user_steps,
  2550	        "user_step_observations": selected.user_step_observations,
  2551	        "rf_cap_hits": selected.rf_cap_hits,
  2552	        "rf_transmission_observations": selected.rf_transmission_observations,
  2553	        "se_plateau_user_step_share": (
  2554	            0.0
  2555	            if selected.user_step_observations == 0
  2556	            else selected.se_plateau_user_steps / selected.user_step_observations
  2557	        ),
  2558	        "rf_cap_transmission_share": (
  2559	            0.0
  2560	            if selected.rf_transmission_observations == 0
  2561	            else selected.rf_cap_hits / selected.rf_transmission_observations
  2562	        ),
  2563	        "best_feasible_reassignment_dc_energy_change_j_by_beam": by_beam,
  2564	        "thresholds_applied": False,
