  1478	def _set_score_select(
  1479	    *,
  1480	    catalog: Sequence[Configuration],
  1481	    factors: Mapping[str, Mapping[str, object]],
  1482	    include: Sequence[str],
  1483	) -> Configuration:
  1484	    """Select one atomic configuration from the exact declared factor sum."""
  1485	
  1486	    scored = [
  1487	        (
  1488	            sum((Fraction(factors[row.configuration_id][name]) for name in include), Fraction()),
  1489	            row.configuration_id,
  1490	            row,
  1491	        )
  1492	        for row in catalog
  1493	    ]
  1494	    return min(scored, key=lambda row: (-row[0], row[1]))[2]
  1495	
  1496	
  1497	def _selection_factor_scores(
  1498	    *,
  1499	    base: Configuration,
  1500	    incumbent: Configuration,
  1501	    catalog: Sequence[Configuration],
  1502	    evaluated: Mapping[str, EvaluatedProfile],
  1503	    calibration: CalibrationValues,
  1504	    cell_rekeyed_users: Iterable[int] = (),
  1505	) -> dict[str, dict[str, object]]:
  1506	    """Configuration-local C1/C3 on the sealed coarse selection grid.
  1507	
  1508	    C3 is never reduced to a per-(user, action) maximum.  Each row owns its
  1509	    own joint residual, so evacuation and proposal rows are scored as atomic
  1510	    coalitions.  Shapley credits are attached when the complete coalition
  1511	    game is evaluated for the committed row.
  1512	    """
  1513	
  1514	    base_profile = evaluated[base.configuration_id]
  1515	    base_map = base.mapping
  1516	    base_core = Fraction(str(base_profile.bits)) - calibration.eta_ref * Fraction(
  1517	        str(base_profile.joules)
  1518	    )
  1519	    result: dict[str, dict[str, object]] = {}
  1520	    for config in catalog:
  1521	        changed = tuple(
  1522	            user
  1523	            for user in sorted(base_map)
  1524	            if config.mapping[user] != base_map[user]
  1525	        )
  1526	        d_rows = []
  1527	        for user in changed:
  1528	            mapping = dict(base_map)
  1529	            mapping[user] = config.mapping[user]
  1530	            singleton = _configuration(base, mapping, kind="selection-singleton")
  1531	            profile = evaluated[singleton.configuration_id]
  1532	            value = Fraction(str(profile.bits)) - calibration.eta_ref * Fraction(
  1533	                str(profile.joules)
  1534	            )
  1535	            d_rows.append((user, value - base_core))
  1536	        profile = evaluated[config.configuration_id]
  1537	        joint = (
  1538	            Fraction(str(profile.bits))
  1539	            - calibration.eta_ref * Fraction(str(profile.joules))
  1540	            - base_core
  1541	        )
  1542	        additive = sum((value for _user, value in d_rows), Fraction())
  1543	        psi = joint - additive
  1544	        phi = _phi_for(
  1545	            incumbent, config, cell_rekeyed_users=cell_rekeyed_users
  1546	        ) - _phi_for(
  1547	            incumbent, base, cell_rekeyed_users=cell_rekeyed_users
  1548	        )
  1549	        result[config.configuration_id] = {
  1550	            "C1": additive / calibration.kappa_bits_per_user_step + phi,
  1551	            "C2": Fraction(),
  1552	            "C3": psi / calibration.kappa_bits_per_user_step,
  1553	            "d_by_user": tuple(d_rows),
  1554	            "psi_A": psi,
  1555	            "shapley_interaction_by_user": (),
  1556	            "joint_change_bits": joint,
  1557	            "c1_physical_core": additive / calibration.kappa_bits_per_user_step,
  1558	            "phi_difference": phi,
  1559	        }
  1560	    return result
  1561	
