   150	    energy_absolute = n1 / e1 - n1 / e0
   151	    total_absolute = ee1 - ee0
   152	    if bits_absolute + energy_absolute != total_absolute:
   153	        raise RuntimeError("EE decomposition failed exact closure")
   154	    bits_relative = bits_absolute / ee0
   155	    energy_relative = energy_absolute / ee0
   156	    total_relative = total_absolute / ee0
   157	    return {
   158	        "method": "credit numerator delta at baseline energy, then credit energy delta at final numerator",
   159	        "numerator_delta": pair(n1 - n0),
   160	        "energy_reduction": pair(e0 - e1),
   161	        "ee_gain_bit_per_j": pair(total_absolute),
   162	        "bits_component_bit_per_j": pair(bits_absolute),
   163	        "energy_component_bit_per_j": pair(energy_absolute),
   164	        "total_relative": pair(total_relative),
   165	        "bits_component_relative": pair(bits_relative),
   166	        "energy_component_relative": pair(energy_relative),
   167	        "bits_share_of_ee_gain": pair(bits_absolute / total_absolute),
   168	        "energy_share_of_ee_gain": pair(energy_absolute / total_absolute),
   169	        "exact_closure": True,
   170	    }
