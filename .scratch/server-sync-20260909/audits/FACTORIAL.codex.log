  1356	def _configuration_factor_scores(
  1357	    *,
  1358	    tape: ExogenousWorldTape,
  1359	    setting: PhysicsSetting,
  1360	    step_index: int,
  1361	    carrier: str,
  1362	    base: Configuration,
  1363	    incumbent: Configuration,
  1364	    catalog: Sequence[Configuration],
  1365	    evaluator: StepEvaluator,
  1366	    calibration: CalibrationValues,
  1367	    counter: EvaluationCounter,
  1368	    c2_horizon_offsets: int = 3,
  1369	    run_setting: SealedRunSetting | None = None,
  1370	) -> tuple[dict[str, dict[str, object]], Fraction, int]:
  1371	    """Score every complete configuration by the sealed v1.5 decomposition."""
  1372	
  1373	    base_profile = evaluator.evaluate(base)
  1374	    base_map = base.mapping
  1375	    singleton_c2: dict[tuple[int, tuple[int, int] | None], Fraction] = {}
  1376	    default_forecasts: dict[int, tuple[OffsetProjection, ...]] = {}
  1377	    result: dict[str, dict[str, object]] = {}
  1378	    interaction_sum = Fraction()
  1379	    interaction_count = 0
  1380	    for config in catalog:
  1381	        selected_map = config.mapping
  1382	        changed = tuple(
  1383	            user for user in sorted(base_map) if selected_map[user] != base_map[user]
  1384	        )
  1385	        required_subsets = {frozenset(), frozenset(changed)} | {
  1386	            frozenset((user,)) for user in changed
  1387	        }
  1388	        reporting_subsets = (
  1389	            {
  1390	                frozenset(subset)
  1391	                for size in range(len(changed) + 1)
  1392	                for subset in itertools.combinations(changed, size)
  1393	            }
  1394	            if 1 < len(changed) <= 4
  1395	            else required_subsets
  1396	        )
  1397	        outcomes: dict[frozenset[int], NetworkOutcome] = {}
  1398	        for subset in reporting_subsets:
  1399	            mapping = dict(base_map)
  1400	            for user in subset:
  1401	                mapping[user] = selected_map[user]
  1402	            subset_config = _configuration(base, mapping, kind="v15-sparse-set")
  1403	            outcomes[subset] = evaluator.evaluate(subset_config).outcome()
  1404	        candidate_phi = _phi_for(
  1405	            incumbent,
  1406	            config,
  1407	            cell_rekeyed_users=_rekeyed_users(tape, step_index),
  1408	        )
  1409	        base_phi = _phi_for(
  1410	            incumbent,
  1411	            base,
  1412	            cell_rekeyed_users=_rekeyed_users(tape, step_index),
  1413	        )
  1414	        decomposition = set_score_decomposition(
  1415	            coalition_users=changed,
  1416	            outcomes_by_subset=outcomes,
  1417	            lambda_bits_per_j=calibration.lambda_bits_per_j,
  1418	            eta_ref=calibration.eta_ref,
  1419	            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1420	            phi_difference=candidate_phi - base_phi,
  1421	        )
  1422	        c2 = Fraction()
  1423	        for user in changed:
  1424	            key = (user, selected_map[user])
  1425	            if key not in singleton_c2:
  1426	                singleton_map = dict(base_map)
  1427	                singleton_map[user] = selected_map[user]
  1428	                singleton_config = _configuration(base, singleton_map, kind="v15-singleton")
  1429	                if user not in default_forecasts:
  1430	                    default_forecasts[user] = _forecast_rows(
  1431	                        tape=tape,
  1432	                        setting=setting,
  1433	                        anchor_step=step_index,
  1434	                        config=base,
  1435	                        carrier=carrier,
  1436	                        counter=counter,
  1437	                        focal_user=user,
  1438	                        run_setting=run_setting,
  1439	                    )
  1440	                projection = c2_persistence_forecast(
  1441	                    _forecast_rows(
  1442	                        tape=tape,
  1443	                        setting=setting,
  1444	                        anchor_step=step_index,
  1445	                        config=singleton_config,
  1446	                        carrier=carrier,
  1447	                        counter=counter,
  1448	                        focal_user=user,
  1449	                        run_setting=run_setting,
  1450	                    ),
  1451	                    default_forecasts[user],
  1452	                    lambda_bits_per_j=calibration.lambda_bits_per_j,
  1453	                    eta_ref=calibration.eta_ref,
  1454	                    kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1455	                    horizon_offsets=c2_horizon_offsets,
  1456	                )
  1457	                singleton_c2[key] = projection.normalized_total
  1458	            c2 += singleton_c2[key]
  1459	        result[config.configuration_id] = {
  1460	            "C1": decomposition.factor_c1,
  1461	            "C2": c2,
  1462	            "C3": decomposition.c3,
  1463	            "d_by_user": decomposition.d_by_user,
  1464	            "psi_A": decomposition.interaction_bits,
  1465	            "shapley_interaction_by_user": decomposition.shapley_interaction_by_user,
  1466	            "credit_split": decomposition.credit_split,
  1467	            "joint_change_bits": decomposition.joint_change_bits,
  1468	            "c1_physical_core": decomposition.c1,
  1469	            "phi_difference": decomposition.phi_difference,
  1470	        }
  1471	        if changed:
  1472	            interaction_sum += decomposition.interaction_bits
  1473	        if len(changed) > 1:
  1474	            interaction_count += 1
  1475	    return result, interaction_sum, interaction_count
  1476	
