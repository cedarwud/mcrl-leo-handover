  2568	def execute_step(
  2569	    *,
  2570	    tape: ExogenousWorldTape,
  2571	    setting: PhysicsSetting,
  2572	    step_index: int,
  2573	    carrier: str,
  2574	    calibration: CalibrationValues,
  2575	    counter: EvaluationCounter,
  2576	    incumbent: Configuration | None = None,
  2577	    c2_horizon_offsets: int = 3,
  2578	    run_setting: SealedRunSetting | None = None,
  2579	) -> dict[str, object]:
  2580	    anchor_started = time.perf_counter()
  2581	    decision_started = anchor_started
  2582	    deadline_at = decision_started + DECISION_DEADLINE_S
  2583	    phase: dict[str, float] = {}
  2584	    counter_start = counter.boundary_evaluations
  2585	    active_run = run_setting_for(setting.label) if run_setting is None else run_setting
  2586	    base = _base_configuration(tape, step_index, carrier)
  2587	    incumbent = base if incumbent is None else incumbent
  2588	    cell_rekeys = _rekeyed_users(tape, step_index)
  2589	
  2590	    started = time.perf_counter()
  2591	    catalog, catalogue_census = _catalogue_with_census(
  2592	        tape,
  2593	        step_index,
  2594	        base,
  2595	        setting=setting,
  2596	        calibration=calibration,
  2597	        counter=counter,
  2598	        run_setting=active_run,
  2599	    )
  2600	    if catalogue_census["catalogue_mode"] != "complete-cartesian" and len(catalog) > CATALOGUE_CAP:
  2601	        raise ProbeError(
  2602	            f"selection shortlist row-count gate failed: {len(catalog)} > {CATALOGUE_CAP}"
  2603	        )
  2604	    phase["catalogue"] = time.perf_counter() - started
  2605	    phase["catalogue_row_count"] = len(catalog)
  2606	
  2607	    started = time.perf_counter()
  2608	    selection_evaluator = StepEvaluator(
  2609	        tape,
  2610	        setting,
  2611	        step_index,
  2612	        transition_from=incumbent,
  2613	        cell_rekeyed_users=cell_rekeys,
  2614	        field="nominal",
  2615	        counter=counter,
  2616	        run_setting=active_run,
  2617	        boundary_indices=(0,),
