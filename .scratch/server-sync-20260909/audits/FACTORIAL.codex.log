  1249	def _factor_scores(
  1250	    *,
  1251	    tape: ExogenousWorldTape,
  1252	    setting: PhysicsSetting,
  1253	    step_index: int,
  1254	    carrier: str,
  1255	    base: Configuration,
  1256	    incumbent: Configuration,
  1257	    catalog: Sequence[Configuration],
  1258	    evaluated: Mapping[str, EvaluatedProfile],
  1259	    calibration: CalibrationValues,
  1260	    counter: EvaluationCounter,
  1261	) -> tuple[
  1262	    dict[str, dict[tuple[int, tuple[int, int] | None], Fraction]],
  1263	    Fraction,
  1264	    int,
  1265	]:
  1266	    base_profile = evaluated[base.configuration_id]
  1267	    result = {name: {} for name in ("C1", "C2", "C3")}
  1268	    for config in catalog:
  1269	        if config.changed_users != 1:
  1270	            continue
  1271	        user = next(
  1272	            user for user, identity in config.assignments if dict(base.assignments)[user] != identity
  1273	        )
  1274	        identity = dict(config.assignments)[user]
  1275	        c1 = c1_difference_surplus(
  1276	            evaluated[config.configuration_id].outcome(
  1277	                phi=_phi_for(
  1278	                    incumbent,
  1279	                    config,
  1280	                    cell_rekeyed_users=_rekeyed_users(tape, step_index),
  1281	                )
  1282	            ),
  1283	            base_profile.outcome(
  1284	                phi=_phi_for(
  1285	                    incumbent,
  1286	                    base,
  1287	                    cell_rekeyed_users=_rekeyed_users(tape, step_index),
  1288	                )
  1289	            ),
  1290	            lambda_bits_per_j=calibration.lambda_bits_per_j,
  1291	            eta_ref=calibration.eta_ref,
  1292	            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1293	        )
  1294	        result["C1"][(user, identity)] = c1.normalized_total
  1295	        candidate_forecast = _forecast_rows(
  1296	            tape=tape,
  1297	            setting=setting,
  1298	            anchor_step=step_index,
  1299	            config=config,
  1300	            carrier=carrier,
  1301	            counter=counter,
  1302	            focal_user=user,
  1303	        )
  1304	        default_forecast = _forecast_rows(
  1305	            tape=tape,
  1306	            setting=setting,
  1307	            anchor_step=step_index,
  1308	            config=base,
  1309	            carrier=carrier,
  1310	            counter=counter,
  1311	            focal_user=user,
  1312	        )
  1313	        c2 = c2_persistence_forecast(
  1314	            candidate_forecast,
  1315	            default_forecast,
  1316	            lambda_bits_per_j=calibration.lambda_bits_per_j,
  1317	            eta_ref=calibration.eta_ref,
  1318	            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1319	        )
  1320	        result["C2"][(user, identity)] = c2.normalized_total
  1321	    users = tuple(user for user, _ in base.assignments)
  1322	    interaction_sum = Fraction()
  1323	    interaction_count = 0
  1324	    for user0, user1 in itertools.combinations(users, 2):
  1325	        uni0 = [row for row in catalog if row.changed_users == 1 and dict(row.assignments)[user0] != dict(base.assignments)[user0]]
  1326	        uni1 = [row for row in catalog if row.changed_users == 1 and dict(row.assignments)[user1] != dict(base.assignments)[user1]]
  1327	        for first in uni0:
  1328	            for second in uni1:
  1329	                merged_map = dict(base.assignments)
  1330	                merged_map[user0] = dict(first.assignments)[user0]
  1331	                merged_map[user1] = dict(second.assignments)[user1]
  1332	                joint = next((row for row in catalog if row.mapping == merged_map), None)
  1333	                if joint is None:
  1334	                    continue
  1335	                interaction = c3_lcsrs_interaction(
  1336	                    coalition_users=(user0, user1),
  1337	                    f00=base_profile.outcome(),
  1338	                    f10=evaluated[first.configuration_id].outcome(),
  1339	                    f01=evaluated[second.configuration_id].outcome(),
  1340	                    f11=evaluated[joint.configuration_id].outcome(),
  1341	                    lambda_bits_per_j=calibration.lambda_bits_per_j,
  1342	                    eta_ref=calibration.eta_ref,
  1343	                    kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1344	                )
  1345	                interaction_sum += interaction.psi
  1346	                interaction_count += 1
  1347	                for user, z3 in interaction.z3_by_user:
  1348	                    identity = merged_map[user]
  1349	                    old = result["C3"].get((user, identity))
  1350	                    normalized = z3 / calibration.kappa_bits_per_user_step
  1351	                    if old is None or normalized > old:
  1352	                        result["C3"][(user, identity)] = normalized
  1353	    return result, interaction_sum, interaction_count
  1354	
