  1683	def _attach_stage2_c2(
  1684	    *,
  1685	    factors: dict[str, dict[str, object]],
  1686	    forecasts: Mapping[str, tuple[OffsetProjection, ...]],
  1687	    base: Configuration,
  1688	    calibration: CalibrationValues,
  1689	    horizon_offsets: int,
  1690	) -> None:
  1691	    baseline = forecasts[base.configuration_id]
  1692	    for configuration_id, rows in forecasts.items():
  1693	        label = c2_persistence_forecast(
  1694	            rows,
  1695	            baseline,
  1696	            lambda_bits_per_j=calibration.lambda_bits_per_j,
  1697	            eta_ref=calibration.eta_ref,
  1698	            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
  1699	            horizon_offsets=horizon_offsets,
  1700	        )
  1701	        factors[configuration_id]["C2"] = label.normalized_total
  1702	        factors[configuration_id]["c2_lost_offsets"] = label.lost_offsets
  1703	
