  1239	                True,
  1240	                required if setting.architecture in {"a-r", "a′-r"} else None,
  1241	                cap if setting.architecture in {"a-r", "a′-r"} else None,
  1242	                min(margins, default=-math.inf) if margins else -100.0,
  1243	                math.fsum(ses) / len(ses) if ses else 0.0,
  1244	            )
  1245	        )
  1246	    return tuple(rows)
