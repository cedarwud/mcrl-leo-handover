+
+INTERPRETER = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
+FIXTURE = REPO / "tests/fixtures/stagec-training-arm-difference-v1.json"
+SOURCE_VIEW_SCHEMA = "mcrl-v025-exact-source-view-shard-v1"
+SOURCE_EXTENSION_SCHEMA = "mcrl-v025-exact-source-view-extension-v1"
+MAX_RSS_BYTES = 5_000_000_000
+MAX_PYTHON_PROCESSES = 3
+RUNNER_PYTHON_PROCESSES = 1
+REQUIRED_NICE = 15
+AMENDED_SEED_COUNT = 16
+V2_EPOCH_BUDGET = 4000
+STEP_DECAY_BOUNDARIES = (2000, 3000)
+STEP_DECAY_FACTOR = 0.1
+
+SOURCE_HEADER_FIELDS = {
+    "schema", "artifact_label", "world_index", "world_id",
+    "global_anchor_index", "anchor_index_within_world", "step_index",
+    "carrier_index", "carrier", "row_count", "evaluation_path",
+    "existing_row_schema", "extension_schema", "q1_slots", "q2_slots",
+}
+EXTENSION_FIELDS = {
+    "schema", "row_key", "physics_configuration_id",
+    "c1_difference_surplus", "c2_persistence_forecast", "surrogate",
+    "evaluation_path",
+}
