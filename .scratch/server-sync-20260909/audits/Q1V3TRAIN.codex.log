            coalition_shards.append(read_coalition_shard(path))
        else:
            raise StageCContractError(f"unsupported view schema {schema!r}: {path}")
        inventory.append({"path": path.relative_to(corpus).as_posix(), "sha256": _sha256(path)})
    if not source_shards:
