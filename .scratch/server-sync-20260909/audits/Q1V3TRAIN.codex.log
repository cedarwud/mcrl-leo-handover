+#!/home/sat/mcrl-leo-handover/.venv/bin/python
+"""Digest-keyed Q1-v3 adapter around the unchanged Stage-C runner v2 copy."""
+
+from __future__ import annotations
+
+import argparse
+import gc
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import resource
+import sys
+
+
+THREAD_VARIABLES = (
+    "OMP_NUM_THREADS",
+    "OPENBLAS_NUM_THREADS",
+    "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS",
+    "VECLIB_MAXIMUM_THREADS",
+    "BLIS_NUM_THREADS",
+)
+for _name in THREAD_VARIABLES:
+    os.environ[_name] = "1"
+
+ROOT = Path(__file__).resolve().parents[1]
+RUNNER_PATH = ROOT / "scripts/run_stagec_training_v2.py"
+RUNNER_SHA256 = "47313ed05ff5e3a7c85d4b89e307dba534b5cef882a30d267970bbf35e900e1f"
+Q2_SHA256 = "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c"
+Q1_PARENT_SHA256 = "c002ea883a4ab727f9e00cc15866f5b9d37abca645963fd3db2f2db7c6cc887a"
+EXPECTED_C3_WIDTH = 240
+VIEWS = {
+    "v3": {
+        "corpus": ROOT / "artifacts/q1-v3-exact-label-corpus-20260910",
+        "corpus_sha256": "a3e139737306df759b3febe4089eecbc3f0105da5314b578bdebbb18d0b6f59c",
+        "q1_sha256": "3850d23fa9cd5a5c2744e60c57e103766ecc73cf46cdf8755382e61e3aaafc01",
+        "manifest_sha256": "dc4d1038d86846f3c665e68434e6b61ece539665c5c55bc12ec22d4a14033860",
+    },
+    "v3_control": {
+        "corpus": ROOT / "artifacts/q1-v3-control-exact-label-corpus-20260910",
+        "corpus_sha256": "cc2ebaa9bed84c0bac38dcdd7d9acce355176b265ae40ba841f89f96f8adc000",
+        "q1_sha256": "ee6baea90d824d52bfa1e7c3a775fa191235e6f6db9d85c32674c608740cfc8f",
+        "manifest_sha256": "7582ff1fed21f1a622466d7301c68093a50c35a7ae6b8f6b0a4a23b93e686bbf",
+    },
+}
+
+sys.path.insert(0, str(ROOT))
+
+import q1_schema_v3 as q1v3  # noqa: E402
+import mcrl.stagec_v025.encoders as encoders  # noqa: E402
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_runner():
+    if sha256(RUNNER_PATH) != RUNNER_SHA256:
+        raise RuntimeError("unchanged runner-v2 copy digest drifted")
+    spec = importlib.util.spec_from_file_location("q1v3_unchanged_runner_v2", RUNNER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load unchanged runner-v2 copy")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def register_adapter(runner, view: str):
+    declaration = VIEWS[view]
+    expected_schema = (
+        q1v3.Q1_V3_SCHEMA if view == "v3" else q1v3.Q1_V3_CONTROL_SCHEMA
+    )
+    expected_digest = (
+        q1v3.Q1_V3_SCHEMA_SHA256
+        if view == "v3"
+        else q1v3.Q1_V3_CONTROL_SCHEMA_SHA256
+    )
+    if expected_digest != declaration["q1_sha256"]:
+        raise RuntimeError("declared Q1-v3 schema digest drifted")
+    parent = encoders.variant_for_digests(Q1_PARENT_SHA256, Q2_SHA256)
+    name = "CORPUS_Q1_V3_READER_ADAPTER" if view == "v3" else "CORPUS_Q1_V3_CONTROL_READER_ADAPTER"
+    key = (expected_digest, Q2_SHA256)
+    if name in encoders._REGISTRY or key in encoders._DIGEST_INDEX:
+        raise RuntimeError("Q1-v3 adapter unexpectedly pre-exists")
+    variant = encoders.EncoderVariant(
+        name=name,
+        q1_features=tuple(
+            encoders.FeatureSpec(item.name, item.unit, item.scale)
+            for item in q1v3.Q1_V3_FEATURES
+        ),
+        q2_features=parent.q2_features,
+        q1_raw=lambda _item: (),
+        q2_raw=parent.q2_raw,
+        q1_schema=expected_schema,
+        q2_schema=parent.q2_schema,
+        q1_schema_sha256=expected_digest,
+        q2_schema_sha256=Q2_SHA256,
+    )
+    encoders._REGISTRY[name] = variant
+    encoders._DIGEST_INDEX[key] = name
+    if runner.variant_for_digests(*key) is not variant:
+        raise RuntimeError("unchanged production reader did not resolve Q1-v3 adapter")
+    if variant.q1_width != 16 or variant.q2_width != 22:
+        raise RuntimeError("Q1/Q2 adapter width drifted")
+    if runner.canonical_sha256(variant.schema_manifest()) != declaration["manifest_sha256"]:
+        raise RuntimeError("Q1-v3 feature-manifest digest drifted")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--view", choices=tuple(VIEWS), required=True)
+    known, passthrough = parser.parse_known_args()
+    declaration = VIEWS[known.view]
+    runner = load_runner()
+    register_adapter(runner, known.view)
+    expected_corpus = declaration["corpus"].resolve()
+    supplied = runner.parse_args(passthrough)
+    if supplied.corpus == "synthetic-fixture" or Path(supplied.corpus).resolve() != expected_corpus:
+        raise RuntimeError(f"{known.view} must use corpus {expected_corpus}")
+    batches, corpus_receipt, feature = runner.load_corpus(expected_corpus)
+    c3_width = int(batches["c3"].invariant_states.shape[1])
+    if (
+        c3_width != EXPECTED_C3_WIDTH
+        or int(batches["c3"].member_width) != 38
+        or corpus_receipt["digest"] != declaration["corpus_sha256"]
+        or feature["q1_schema_sha256"] != declaration["q1_sha256"]
+        or feature["q2_schema_sha256"] != Q2_SHA256
+        or feature["digest"] != declaration["manifest_sha256"]
+    ):
+        raise RuntimeError("Q1-v3 corpus schema/digest or fail-closed C3 width check failed")
+    print(json.dumps({
+        "event": "q1v3-preflight-pass",
+        "view": known.view,
+        "q1_schema_sha256": feature["q1_schema_sha256"],
+        "corpus_sha256": corpus_receipt["digest"],
+        "c3_width": c3_width,
+        "peak_rss_bytes": int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024,
+    }, sort_keys=True), flush=True)
+    del batches, corpus_receipt, feature
+    gc.collect()
+    return runner.main(passthrough)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
