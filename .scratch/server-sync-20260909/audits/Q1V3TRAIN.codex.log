--- /dev/null
+++ b/tests/fixtures/stagec-training-arm-difference-v1.json
@@ -0,0 +1,35 @@
+{
+  "candidate_count": 256,
+  "fixture_outcomes": {
+    "base_bits": 1000.0,
+    "base_joules": 10.0,
+    "bits_per_action_index": 7.0,
+    "joules_per_action_index": 0.003
+  },
+  "pool_rng_seed": 20260910,
+  "required_pairs": [
+    [
+      "FULL",
+      "DROP_C1",
+      "C1"
+    ],
+    [
+      "FULL",
