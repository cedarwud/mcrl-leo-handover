        rows.append(row)
    if not rows or len(rows) != int(header["row_count"]):
        raise StageCContractError("exact source view row count drifted")
    variant = variant_for_digests(rows[0].q1_schema_sha256, rows[0].q2_schema_sha256)
    if (
        any((row.q1_schema_sha256, row.q2_schema_sha256) !=
            (variant.q1_schema_sha256, variant.q2_schema_sha256) for row in rows)
        or header["q1_slots"] != variant.q1_width
        or header["q2_slots"] != variant.q2_width
    ):
        raise StageCContractError("exact source feature schema drifted")
    shard = SourceShard(path, file_digest, canonical_sha256([row.payload() for row in rows]), tuple(rows))
    return shard, dict(header)


def _candidate_view_files(corpus: Path) -> list[Path]:
    promoted = corpus / "views"
    staging = corpus / ".staging-separated-v1"
    if promoted.is_dir():
        root = promoted
    elif staging.is_dir():
        root = staging
    else:
        raise StageCContractError("corpus has neither views/ nor .staging-separated-v1/*/views/")
    files = sorted(path for path in root.rglob("*.jsonl") if path.is_file() and "views" in path.parts)
    if not files:
        raise StageCContractError("view layer contains no JSONL shards")
    if any("physics" in path.parts for path in files):
        raise StageCContractError("physics path was admitted into view inventory")
    return files


