def schedule_digest(schedule: object) -> str:
    encoded = json.dumps(schedule, sort_keys=True, separators=(",", ":"),
                         allow_nan=False).encode("ascii")
    return hashlib.sha256(encoded).hexdigest()


def optimize_pooled(
    rule: str,
    source_anchors: Sequence[Mapping[str, object]],
    worlds: Mapping[int, tuple[object, object]],
    local_anchors: Sequence[Mapping[str, object]],
    *,
    resume_checkpoints: bool,
) -> tuple[list[dict], dict, list[dict[str, float]]]:
    """Run one shared-price Dinkelbach search across all eight anchors."""

    local_pool = pool(rule, local_anchors)
    eta = float(local_pool["c1"]["ee_bit_per_j"])  # type: ignore[index]
    prior: dict[str, object] = {}
    best_anchors: list[dict] | None = None
    best_pool: dict | None = None
    trace = []
    for iteration in range(MAX_DINKELBACH):
        candidates = []
        for source_anchor in source_anchors:
            anchor_id = str(source_anchor["anchor_id"])
            start = prior.get(anchor_id)
            start_sha = schedule_digest(start)
            checkpoint = (
                REPO / ".scratch/control-law-ceiling/checkpoints"
                / f"{rule.lower()}-pooled-{iteration + 1}-world-"
                  f"{source_anchor['world_index']}-step-{source_anchor['step_index']}.json"
            )
            anchor = None
            tape, provider = worlds[int(source_anchor["world_index"])]
            if resume_checkpoints and checkpoint.exists():
                saved = json.loads(checkpoint.read_text(encoding="ascii"))
                if (
                    saved.get("schema") == "mcrl-v025-control-law-pooled-checkpoint-v1"
                    and saved.get("pooled_search_revision") == POOLED_SEARCH_REVISION
                    and saved.get("rule") == rule
                    and saved.get("source_receipt_sha256") == EXPECTED_SOURCE_SHA256[rule]
                    and saved.get("world_sha256") == tape.digest
                    and saved.get("eta_hex") == eta.hex()
                    and saved.get("starting_schedule_sha256") == start_sha
                    and saved.get("anchor", {}).get("anchor_id") == anchor_id
                ):
                    anchor = saved["anchor"]
            if anchor is None:
                anchor = evaluate_anchor(
                    rule, source_anchor, tape, provider,
                    fixed_eta=eta,
                    initial_mode_schedule=start,  # type: ignore[arg-type]
                )
                checkpoint.parent.mkdir(parents=True, exist_ok=True)
                checkpoint.write_text(json.dumps({
                    "schema": "mcrl-v025-control-law-pooled-checkpoint-v1",
                    "pooled_search_revision": POOLED_SEARCH_REVISION,
                    "rule": rule,
                    "source_receipt_sha256": EXPECTED_SOURCE_SHA256[rule],
                    "world_sha256": tape.digest,
                    "eta_hex": eta.hex(),
                    "starting_schedule_sha256": start_sha,
                    "anchor": anchor,
                }, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
            candidates.append(anchor)
            print(json.dumps({
                "completed": anchor_id,
                "rule": rule,
                "pooled_iteration": iteration + 1,
                "shared_eta_mbit_per_j": eta / 1e6,
                "candidate_anchor_ee_mbit_per_j": anchor["c2_best_known"]["ee_bit_per_j"] / 1e6,
            }, sort_keys=True), flush=True)
        candidate_pool = pool(rule, candidates)
        new_eta = float(candidate_pool["c2_best_known"]["ee_bit_per_j"])  # type: ignore[index]
        residual = (
            float(candidate_pool["c2_best_known"]["bits"])
            - eta * float(candidate_pool["c2_best_known"]["joules"])
        )  # type: ignore[index]
        trace.append({
            "iteration": float(iteration + 1),
            "eta_bit_per_j": eta,
            "candidate_eta_bit_per_j": new_eta,
            "residual_bits": residual,
        })
        if best_pool is None or new_eta > float(best_pool["c2_best_known"]["ee_bit_per_j"]):  # type: ignore[index]
            best_anchors, best_pool = candidates, candidate_pool
        prior = {
            str(anchor["anchor_id"]): anchor["search"]["mode_schedule"]
            for anchor in candidates
        }
        if abs(new_eta - eta) <= 1e-10 * max(1.0, abs(eta)):
            break
        eta = new_eta
    if best_anchors is None or best_pool is None:
        raise RuntimeError("pooled search produced no feasible panel")
    return best_anchors, best_pool, trace


def self_test() -> None:
    if not FRONTIER or any(
        ACM_MODES[b].spectral_efficiency_bit_per_s_hz <=
        ACM_MODES[a].spectral_efficiency_bit_per_s_hz
        for a, b in zip(FRONTIER, FRONTIER[1:])
    ):
        raise RuntimeError("ACM frontier construction failed")
    direct = np.asarray([2.0, 1.5])
    coupling = np.asarray([[0.0, 0.1], [0.2, 0.0]])
    gamma = np.asarray([0.5, 0.7])
    noise = np.asarray([0.01, 0.02])
    matrix = np.eye(2) - gamma[:, None] * coupling / direct[:, None]
    rhs = gamma * noise / direct
    power = np.linalg.solve(matrix, rhs)
    achieved = power * direct / (noise + coupling @ power)
    if not np.allclose(achieved, gamma, rtol=2e-14, atol=2e-14):
        raise RuntimeError("inner coupled power identity failed")
    print(json.dumps({"self_test": "PASS", "frontier_modes": len(FRONTIER)}))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--receipt", type=Path,
                        default=REPO / ".scratch/control-law-ceiling/control-law-ceiling.json")
    parser.add_argument("--report", type=Path,
                        default=REPO / "CONTROL-LAW-CEILING-2026-09-10.md")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument(
        "--resume-checkpoints", action="store_true",
        help="reuse validated per-anchor checkpoints from an interrupted identical run",
    )
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return 0
    for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
        if os.environ.get(name) != "1":
            raise RuntimeError(f"{name}=1 is required by the shared-machine process contract")
    sources = {}
    for rule, path in SOURCE_RECEIPTS.items():
        actual = sha256(path)
        if actual != EXPECTED_SOURCE_SHA256[rule]:
            raise RuntimeError(f"source receipt hash mismatch for {rule}: {actual}")
        sources[rule] = json.loads(path.read_text(encoding="ascii"))
    executable_sources = verify_executable_sources()
    for rule, source in sources.items():
        if not math.isclose(float(source["one_sided_half_power_deg"]),
                            ONE_SIDED_HP_DEG, rel_tol=0.0, abs_tol=0.0):
            raise RuntimeError(f"{rule} receipt beamwidth differs from sealed source value")
    if not math.isclose(DECISION_INTERVAL_S, D2_SUBINTERVALS * STEP_S,
                        rel_tol=0.0, abs_tol=0.0):
        raise RuntimeError("sealed boundary clock identity changed")
    started = time.time()
    result = {
        "schema": "mcrl-v025-control-law-fixed-assignment-best-known-v1",
        "claim_ceiling": CLAIM,
        "optimality_status": "best-known; not a certified ceiling",
        "max_workers": 1,
        "python": sys.executable,
        "python_version": platform.python_version(),
        "numpy_version": np.__version__,
        "executable_sources": executable_sources,
        "source_receipts": {
            rule: {"path": str(path), "sha256": sha256(path)}
            for rule, path in SOURCE_RECEIPTS.items()
        },
        "constants_replayed_unchanged": {
            "beam_rf_cap_w": BEAM_RF_CAP_W,
            "rate_target_bps": RATE_TARGET_BPS,
            "beam_bandwidth_hz": BEAM_BANDWIDTH_HZ,
            "pa_saturation_power_w": PA_SATURATION_POWER_W,
            "pa_max_efficiency": PA_MAX_EFFICIENCY,
            "circuit_power_per_active_chain_w": CIRCUIT_POWER_PER_CHAIN_W,
            "baseband_power_per_active_satellite_w": BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
        },
        "search_contract": {
            "assignment": "fixed per rule/anchor at recorded J_from_first commit",
            "outer": "Dinkelbach iterations; deterministic two-order coordinate ascent",
            "inner": "direct binary64 solve of exact realised coupled minimum-power equations",
            "service_constraint": "each C1-decoded link retains or improves its mode",
            "mode_candidates": [ACM_MODES[i].name for i in FRONTIER],
            "certified": False,
        },
        "rules": {},
    }
    # Build each world once and retain its provider for off-axis reconstruction.
    worlds = {}
    reference_anchors = {a["anchor_id"]: a for a in sources["STRICT"]["anchors"]}
    for world_index in (1, 2):
        domain = runner.probe.PROBE_WORLD_DOMAINS[world_index - 1]
        provider = factory()
        tape = runner.probe.build_world_tape(
            domain=domain, provider=provider, steps=4, start_time_s=0.0
        )
        expected = next(a for a in reference_anchors.values()
                        if int(a["world_index"]) == world_index)
        if tape.digest != expected["world_sha256"]:
            raise RuntimeError("world tape digest mismatch")
        worlds[world_index] = (tape, provider)
    for rule in ("SEALED", "STRICT"):
        anchors = []
        for source_anchor in sources[rule]["anchors"]:
            tape, provider = worlds[int(source_anchor["world_index"])]
            checkpoint = (
                REPO / ".scratch/control-law-ceiling/checkpoints"
                / f"{rule.lower()}-world-{source_anchor['world_index']}-step-{source_anchor['step_index']}.json"
            )
            anchor = None
            if args.resume_checkpoints and checkpoint.exists():
                saved = json.loads(checkpoint.read_text(encoding="ascii"))
                if (
                    saved.get("schema") == "mcrl-v025-control-law-anchor-checkpoint-v1"
                    and saved.get("rule") == rule
                    and saved.get("search_revision") == SEARCH_REVISION
                    and saved.get("source_receipt_sha256") == EXPECTED_SOURCE_SHA256[rule]
                    and saved.get("world_sha256") == tape.digest
                    and saved.get("anchor", {}).get("anchor_id") == source_anchor["anchor_id"]
                ):
                    anchor = saved["anchor"]
            if anchor is None:
                anchor = evaluate_anchor(rule, source_anchor, tape, provider)
                checkpoint.parent.mkdir(parents=True, exist_ok=True)
                checkpoint.write_text(json.dumps({
                    "schema": "mcrl-v025-control-law-anchor-checkpoint-v1",
                    "rule": rule,
                    "search_revision": SEARCH_REVISION,
                    "source_receipt_sha256": EXPECTED_SOURCE_SHA256[rule],
                    "world_sha256": tape.digest,
                    "anchor": anchor,
                }, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
            anchors.append(anchor)
            print(json.dumps({
                "completed": anchor["anchor_id"], "rule": rule,
                "c1_mbit_per_j": anchor["c1"]["ee_bit_per_j"] / 1e6,
                "c2_mbit_per_j": anchor["c2_best_known"]["ee_bit_per_j"] / 1e6,
                "gap_pct": anchor["gap"]["relative_pct"],
            }, sort_keys=True), flush=True)
        pooled_anchors, pooled, pooled_trace = optimize_pooled(
            rule, sources[rule]["anchors"], worlds, anchors,
            resume_checkpoints=args.resume_checkpoints,
        )
        public_local_anchors = []
        for anchor in anchors:
            public = dict(anchor)
            # C4/C5 are properties of the separately pooled-search settings.
            public.pop("decomposition", None)
            public.pop("implementability", None)
            public_local_anchors.append(public)
        result["rules"][rule] = {
            "anchors": public_local_anchors,
            "pooled_search_anchors": pooled_anchors,
            "pooled": pooled,
            "pooled_search": {
                "objective": "sum(bits) / sum(joules) across all eight anchors",
                "shared_dinkelbach_trace": pooled_trace,
                "iterations": len(pooled_trace),
                "optimality_status": "best-known; discrete outer search not certified",
            },
            "pooled_decomposition": aggregate_decomposition(pooled_anchors, pooled),
            "implementability": {
                "changed_boundary_slot_links": sum(a["implementability"]["changed_boundary_slot_links"] for a in pooled_anchors),
                "changed_requiring_cross_beam_information": sum(a["implementability"]["changed_requiring_cross_beam_information"] for a in pooled_anchors),
                "maximum_interference_component_size": max(a["implementability"]["maximum_interference_component_size"] for a in pooled_anchors),
            },
        }
        impl = result["rules"][rule]["implementability"]
        impl["changed_requiring_cross_beam_information_pct"] = (
            0.0 if impl["changed_boundary_slot_links"] == 0 else
            100.0 * impl["changed_requiring_cross_beam_information"] / impl["changed_boundary_slot_links"]
        )
    result["summary"] = {rule: result["rules"][rule]["pooled"]
                         for rule in ("SEALED", "STRICT")}
    result["wall_seconds"] = time.time() - started
    result["receipt_sha256"] = canonical_digest(result)
    args.receipt.parent.mkdir(parents=True, exist_ok=True)
    args.receipt.write_text(json.dumps(result, indent=2, sort_keys=True,
                                        allow_nan=False) + "\n", encoding="ascii")
    render_report(result, args.report, args.receipt)
    print(json.dumps({"receipt": str(args.receipt), "report": str(args.report),
                      "receipt_sha256": result["receipt_sha256"]}, sort_keys=True))
    return 0


