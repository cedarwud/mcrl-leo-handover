+#!/usr/bin/env python3
+"""Read-only demand-capped replay of the fixed-assignment control-law receipt.
+
+DIAGNOSTIC_NOT_CLAIM. This replays recorded C1 assignments and the unchanged,
+deterministic C2 search. It does not modify a sealed input or search setting.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from concurrent.futures import ProcessPoolExecutor, as_completed
+import hashlib
+import importlib.util
+import json
+import math
+import multiprocessing
+import os
+from pathlib import Path
+import struct
+import sys
+from typing import Mapping, Sequence
+
+
+WORKSPACE = Path(__file__).resolve().parents[2]
+ARCH = Path("/home/sat/mcrl-v025-arch-ws")
+SOURCE_REPORT = ARCH / "CONTROL-LAW-CEILING-2026-09-10.md"
+SOURCE_RECEIPT = ARCH / ".scratch/control-law-ceiling/control-law-ceiling.json"
+SOURCE_SCRIPT = ARCH / "scripts/run_control_law_ceiling.py"
+CHECKPOINTS = ARCH / ".scratch/control-law-ceiling/checkpoints"
+PARTS = WORKSPACE / ".scratch/control-law-capped/parts"
+OUTPUT = WORKSPACE / ".scratch/control-law-capped/rescored.json"
+REPORT = WORKSPACE / "CONTROL-LAW-DEMAND-CAPPED-2026-09-10.md"
+
+EXPECTED_REPORT_SHA256 = "f5bbbef109186b56447ae97874ecd4c6843146a021f57b8ae2f328d5abddab6b"
+EXPECTED_RECEIPT_SHA256 = "2c308dd4fb7a325b394418f9820ae1375d78efc52dfd2fac74094964f4ed334a"
+CITED_SOURCE_SCRIPT_SHA256 = "6840a68842068cec4a9946c5fdca68470b73242d29fccc8df3185da10a11e59d"
+ULP_LIMIT = 2
+RULES = ("SEALED", "STRICT")
+NUMERATORS = ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY")
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    encoded = json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def load_control_module():
+    spec = importlib.util.spec_from_file_location("ctrlcap_source", SOURCE_SCRIPT)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot import control-law replay source")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def positive_float_ulp_distance(left: float, right: float) -> int:
+    if not (math.isfinite(left) and math.isfinite(right)):
+        raise RuntimeError("ULP comparison received a non-finite value")
+    if left < 0.0 or right < 0.0:
+        raise RuntimeError("ULP comparison is restricted to nonnegative receipt values")
+    left_bits = struct.unpack(">Q", struct.pack(">d", left))[0]
+    right_bits = struct.unpack(">Q", struct.pack(">d", right))[0]
+    return abs(left_bits - right_bits)
+
+
+class UlpCensus:
+    def __init__(self, limit: int) -> None:
+        self.limit = limit
+        self.distances: list[int] = []
+        self.nonexact: list[dict[str, object]] = []
+
+    def compare(self, field: str, actual: float, expected: float) -> None:
+        distance = positive_float_ulp_distance(actual, expected)
+        self.distances.append(distance)
+        if distance:
+            self.nonexact.append({
+                "field": field,
+                "actual": actual,
+                "expected": expected,
+                "ulp_distance": distance,
+            })
+
+    def result(self) -> dict[str, object]:
+        bins = Counter(self.distances)
+        return {
+            "comparison_count": len(self.distances),
+            "binary64_exact": bins[0],
+            "exactly_1_ulp": bins[1],
+            "exactly_2_ulp": bins[2],
+            "above_2_ulp": sum(count for distance, count in bins.items() if distance > 2),
+            "maximum_ulp": max(self.distances, default=0),
+            "nonexact_fields": self.nonexact,
+            "threshold_ulp": self.limit,
+        }
+
+    def enforce(self, label: str) -> None:
+        result = self.result()
+        if int(result["maximum_ulp"]) > self.limit:
+            raise RuntimeError(f"{label} parity gate failed: {result}")
+
+
+def load_checkpoint(rule: str, world_index: int, step_index: int) -> tuple[dict, Path]:
+    path = CHECKPOINTS / f"{rule.lower()}-world-{world_index}-step-{step_index}.json"
+    checkpoint = json.loads(path.read_text(encoding="ascii"))
+    if checkpoint.get("schema") != "mcrl-v025-control-law-anchor-checkpoint-v1":
+        raise RuntimeError(f"unexpected checkpoint schema: {path}")
+    if checkpoint.get("rule") != rule:
+        raise RuntimeError(f"checkpoint rule mismatch: {path}")
+    return checkpoint, path
+
+
+def replay_anchor(control, rule: str, source_anchor: Mapping[str, object], tape,
+                  mode_schedule: Sequence[Sequence[Sequence[int]]]) -> dict:
+    world_index = int(source_anchor["world_index"])
+    step_index = int(source_anchor["step_index"])
+    anchor_id = str(source_anchor["anchor_id"])
+    checkpoint, checkpoint_path = load_checkpoint(rule, world_index, step_index)
+    checkpoint_anchor = checkpoint["anchor"]
+    if checkpoint_anchor["anchor_id"] != anchor_id:
+        raise RuntimeError(f"checkpoint anchor mismatch: {checkpoint_path}")
+
+    base = control.runner.probe._base_configuration(tape, step_index, "nearest-eligible")
+    committed = source_anchor["committed"]["J_from_first"]
+    config = control.configuration_from_record(base, committed)
+    if config.configuration_id != checkpoint_anchor["fixed_configuration_id"]:
+        raise RuntimeError(f"fixed configuration mismatch at {anchor_id}")
+    geometries = tape.geometry_for(step_index=step_index, assignments=config.mapping)
+    architecture, context = control.c1_architecture(rule)
+    roster = tuple(sorted(config.mapping))
+    c1_user_boundary: list[dict[int, float]] = []
+    c2_user_boundary: list[dict[int, float]] = []
+    c1_boundary_rates: list[float] = []
+    c2_boundary_rates: list[float] = []
+    c1_boundary_power: list[float] = []
+    c2_boundary_power: list[float] = []
+    if len(mode_schedule) != control.BOUNDARIES:
+        raise RuntimeError(f"mode schedule boundary count mismatch at {anchor_id}")
+
+    if context is not None:
+        context.__enter__()
+    try:
+        for boundary, (_time, geometry) in enumerate(geometries):
+            radiation = architecture.radiate(
+                control.runner.RadiationConfig(
+                    rate_target_bps=control.RATE_TARGET_BPS,
+                    fading_quantile_alpha=0.10,
+                ),
+                geometry,
+                "realised",
+            )
+            if not radiation.valid:
+                raise RuntimeError(f"C1 radiation invalid at {anchor_id} boundary {boundary}")
+            if len(radiation.slots) != len(mode_schedule[boundary]):
+                raise RuntimeError(f"mode schedule slot count mismatch at {anchor_id}")
+            c1_rates = {user: 0.0 for user in roster}
+            c2_rates = {user: 0.0 for user in roster}
+            c1_power = 0.0
+            c2_power = 0.0
+            for slot_index, (slot, scheduled_modes) in enumerate(
+                zip(radiation.slots, mode_schedule[boundary], strict=True)
+            ):
+                positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
+                c1_power += slot.fraction * (
+                    math.fsum(
+                        control.pa_supply_power_w(tx.rf_power_w)
+                        + control.CIRCUIT_POWER_PER_CHAIN_W
+                        for tx in positive
+                    )
+                    + len({tx.beam[0] for tx in positive})
+                    * control.BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
+                )
+                for tx in slot.transmissions:
+                    if tx.realised_outcome.decoded:
+                        c1_rates[tx.user_id] += (
+                            slot.fraction
+                            * control.BEAM_BANDWIDTH_HZ
+                            * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
+                        )
+
+                offsets = {int(tx.user_id): 0.0 for tx in slot.transmissions}
+                problem = control.SlotProblem(
+                    geometry, slot, boundary=boundary, off_axis=offsets
+                )
+                value = problem.evaluate(tuple(int(mode) for mode in scheduled_modes))
+                if not value.feasible:
+                    raise RuntimeError(
+                        f"recorded C2 schedule infeasible at {anchor_id} "
+                        f"boundary {boundary} slot {slot_index}"
+                    )
+                c2_power += slot.fraction * value.power_w
+                for local_index, user in enumerate(problem.users):
+                    c2_rates[user] += slot.fraction * value.rates_bps[local_index]
+
+            c1_user_boundary.append(c1_rates)
+            c2_user_boundary.append(c2_rates)
+            c1_boundary_rates.append(math.fsum(c1_rates.values()))
+            c2_boundary_rates.append(math.fsum(c2_rates.values()))
+            c1_boundary_power.append(c1_power)
+            c2_boundary_power.append(c2_power)
+    finally:
+        if context is not None:
+            context.__exit__(None, None, None)
+
+    c1_user_bits = {
+        user: control.trapezoid([row[user] for row in c1_user_boundary])
+        for user in roster
+    }
+    c2_user_bits = {
+        user: control.trapezoid([row[user] for row in c2_user_boundary])
+        for user in roster
+    }
+    target = float(control.RATE_TARGET_BPS * 47 * control.STEP_S)
+
+    def aggregate(user_bits: Mapping[int, float], boundary_rates: Sequence[float],
+                  boundary_power: Sequence[float]) -> dict[str, object]:
+        bits = control.trapezoid(boundary_rates)
+        joules = control.trapezoid(boundary_power)
+        return {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": bits / joules,
+            "served_count": sum(value > 0.0 for value in user_bits.values()),
+            "rate_target_attained_count": sum(value >= target for value in user_bits.values()),
+        }
+
+    c1_aggregate = aggregate(c1_user_bits, c1_boundary_rates, c1_boundary_power)
+    c2_aggregate = aggregate(c2_user_bits, c2_boundary_rates, c2_boundary_power)
+    users = [
+        {
+            "user_id": user,
+            "c1_delivered_bits": c1_user_bits[user],
+            "c2_delivered_bits": c2_user_bits[user],
+            "delta_bits": c2_user_bits[user] - c1_user_bits[user],
+            "c1_attained": c1_user_bits[user] >= target,
+            "c2_attained": c2_user_bits[user] >= target,
+        }
+        for user in roster
+    ]
+    return {
+        "anchor_id": anchor_id,
+        "world_index": world_index,
+        "step_index": step_index,
+        "fixed_configuration_id": config.configuration_id,
+        "checkpoint_path": str(checkpoint_path),
+        "checkpoint_sha256": sha256(checkpoint_path),
+        "mode_schedule": mode_schedule,
+        "c1_aggregate_replay": c1_aggregate,
+        "c2_aggregate_replay": c2_aggregate,
+        "users": users,
+    }
+
