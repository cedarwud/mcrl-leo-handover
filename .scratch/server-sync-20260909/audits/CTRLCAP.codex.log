+    return "\n".join(lines) + "\n"
+
+
+def main() -> int:
+    for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
+        if os.environ.get(name) != "1":
+            raise RuntimeError(f"{name}=1 is required")
+    if sys.executable != "/home/sat/mcrl-leo-handover/.venv/bin/python":
+        raise RuntimeError(f"unexpected interpreter: {sys.executable}")
+    if sha256(SOURCE_REPORT) != EXPECTED_REPORT_SHA256:
+        raise RuntimeError("source report file hash mismatch")
+    if sha256(SOURCE_RECEIPT) != EXPECTED_RECEIPT_SHA256:
+        raise RuntimeError("source receipt file hash mismatch")
+
+    source = json.loads(SOURCE_RECEIPT.read_text(encoding="ascii"))
+    if canonical_digest(source) != source["receipt_sha256"]:
+        raise RuntimeError("source receipt canonical digest mismatch")
+    control = load_control_module()
+    executable_sources = control.verify_executable_sources()
+    for rule in RULES:
+        if sha256(control.SOURCE_RECEIPTS[rule]) != control.EXPECTED_SOURCE_SHA256[rule]:
+            raise RuntimeError(f"{rule} fixed-assignment source receipt hash mismatch")
+
+    sources = {
+        rule: json.loads(control.SOURCE_RECEIPTS[rule].read_text(encoding="ascii"))
+        for rule in RULES
+    }
+    jobs = [
+        (rule, source_anchor)
+        for rule in RULES
+        for source_anchor in sources[rule]["anchors"]
+    ]
+    completed: dict[tuple[str, str], dict] = {}
+    pending = []
+    for rule, source_anchor in jobs:
+        destination = part_path(rule, source_anchor)
+        expected_contract = part_contract(rule, source_anchor)
+        if destination.exists():
+            saved = json.loads(destination.read_text(encoding="ascii"))
+            if saved.get("part_contract") == expected_contract:
+                completed[(rule, str(source_anchor["anchor_id"]))] = saved
+                print(json.dumps({"reused": source_anchor["anchor_id"], "rule": rule}), flush=True)
+                continue
+        pending.append((rule, source_anchor))
+    if pending:
+        context = multiprocessing.get_context("spawn")
+        with ProcessPoolExecutor(max_workers=1, mp_context=context) as executor:
+            futures = {
+                executor.submit(replay_job, rule, source_anchor): (rule, source_anchor)
+                for rule, source_anchor in pending
+            }
+            for future in as_completed(futures):
+                rule, source_anchor = futures[future]
+                row = future.result()
+                completed[(rule, str(source_anchor["anchor_id"]))] = row
+                print(json.dumps({"completed": source_anchor["anchor_id"], "rule": rule}), flush=True)
+
+    c1_census = UlpCensus(ULP_LIMIT)
+    c2_census = UlpCensus(ULP_LIMIT)
+    c1_count_mismatches: list[dict[str, object]] = []
+    c2_count_mismatches: list[dict[str, object]] = []
+    replayed: dict[str, list[dict]] = {}
+    rules_result: dict[str, dict[str, object]] = {}
+    all_violations: list[dict[str, object]] = []
+    minimum_delta = math.inf
+    demand_bits = float(control.RATE_TARGET_BPS * 47 * control.STEP_S)
+
+    for rule in RULES:
+        source_by_id = {str(row["anchor_id"]): row for row in sources[rule]["anchors"]}
+        receipt_by_id = {str(row["anchor_id"]): row for row in source["rules"][rule]["anchors"]}
+        anchors = []
+        for anchor_id, receipt_anchor in receipt_by_id.items():
+            source_anchor = source_by_id[anchor_id]
+            row = completed[(rule, anchor_id)]
+            compare_aggregate(
+                c1_census, c1_count_mismatches, f"{rule}.{anchor_id}.c1",
+                row["c1_aggregate_replay"], receipt_anchor["c1"],
+            )
+            compare_aggregate(
+                c2_census, c2_count_mismatches, f"{rule}.{anchor_id}.c2",
+                row["c2_aggregate_replay"], receipt_anchor["c2_best_known"],
+            )
+            for user in row["users"]:
+                minimum_delta = min(minimum_delta, float(user["delta_bits"]))
+                if float(user["delta_bits"]) < 0.0:
+                    all_violations.append({
+                        "rule": rule,
+                        "anchor_id": anchor_id,
+                        **user,
+                    })
+            anchors.append(row)
+
+        def pooled_aggregate(policy: str) -> dict[str, object]:
+            bits = math.fsum(float(row[f"{policy}_aggregate_replay"]["bits"]) for row in anchors)
+            joules = math.fsum(float(row[f"{policy}_aggregate_replay"]["joules"]) for row in anchors)
+            return {
+                "bits": bits,
+                "joules": joules,
+                "ee_bit_per_j": bits / joules,
+                "served_count": sum(int(row[f"{policy}_aggregate_replay"]["served_count"]) for row in anchors),
+                "rate_target_attained_count": sum(int(row[f"{policy}_aggregate_replay"]["rate_target_attained_count"]) for row in anchors),
+            }
+
+        c1_pool = pooled_aggregate("c1")
+        c2_pool = pooled_aggregate("c2")
+        compare_aggregate(
+            c1_census, c1_count_mismatches, f"{rule}.pooled.c1",
+            c1_pool, source["rules"][rule]["pooled"]["c1"],
+        )
+        compare_aggregate(
+            c2_census, c2_count_mismatches, f"{rule}.pooled.c2",
+            c2_pool, source["rules"][rule]["pooled"]["c2_best_known"],
+        )
+
+        c1_user_values = [float(user["c1_delivered_bits"]) for row in anchors for user in row["users"]]
+        c2_user_values = [float(user["c2_delivered_bits"]) for row in anchors for user in row["users"]]
+        c1_accounting = accounting(c1_user_values, float(c1_pool["joules"]), demand_bits)
+        c2_accounting = accounting(c2_user_values, float(c2_pool["joules"]), demand_bits)
+        numerators = {}
+        for name in NUMERATORS:
+            c1_ee = c1_accounting[name]["ee_bit_per_j"]
+            c2_ee = c2_accounting[name]["ee_bit_per_j"]
+            gain = relative_gain(c2_ee, c1_ee)
+            item: dict[str, object] = {
+                "c1_credited_bits": c1_accounting[name]["credited_bits"],
+                "c2_credited_bits": c2_accounting[name]["credited_bits"],
+                "c1_ee_bit_per_j": c1_ee,
+                "c2_ee_bit_per_j": c2_ee,
+                "relative_gain": gain,
+            }
+            if name == "DEMAND_CAPPED":
+                energy_component = float(c1_pool["joules"]) / float(c2_pool["joules"]) - 1.0
+                if gain is None:
+                    raise RuntimeError("demand-capped baseline EE is zero")
+                bits_component = gain - energy_component
+                item.update({
+                    "energy_only_component": energy_component,
+                    "extra_credited_bits_component": bits_component,
+                    "energy_share_of_total_gain_pct": 100.0 * energy_component / gain,
+                    "bits_share_of_total_gain_pct": 100.0 * bits_component / gain,
+                })
+            numerators[name] = item
+
+        cohort = {
+            "already_attained": {"user_anchor_count": 0, "capacity_increment_bits": 0.0, "demand_capped_increment_bits": 0.0},
+            "not_attained": {"user_anchor_count": 0, "capacity_increment_bits": 0.0, "demand_capped_increment_bits": 0.0},
+        }
+        for row in anchors:
+            for user in row["users"]:
+                key = "already_attained" if user["c1_attained"] else "not_attained"
+                c1_bits = float(user["c1_delivered_bits"])
+                c2_bits = float(user["c2_delivered_bits"])
+                cohort[key]["user_anchor_count"] += 1
+                cohort[key]["capacity_increment_bits"] += c2_bits - c1_bits
+                cohort[key]["demand_capped_increment_bits"] += min(c2_bits, demand_bits) - min(c1_bits, demand_bits)
+        raw_total = math.fsum(float(row["capacity_increment_bits"]) for row in cohort.values())
+        capped_total = math.fsum(float(row["demand_capped_increment_bits"]) for row in cohort.values())
+        expected_raw = float(numerators["CAPACITY"]["c2_credited_bits"]) - float(numerators["CAPACITY"]["c1_credited_bits"])
+        expected_capped = float(numerators["DEMAND_CAPPED"]["c2_credited_bits"]) - float(numerators["DEMAND_CAPPED"]["c1_credited_bits"])
+        if not math.isclose(raw_total, expected_raw, rel_tol=2e-15, abs_tol=2e-4):
+            raise RuntimeError(f"{rule} raw cohort split does not reconcile")
+        if not math.isclose(capped_total, expected_capped, rel_tol=2e-15, abs_tol=2e-4):
+            raise RuntimeError(f"{rule} capped cohort split does not reconcile")
+        for value in cohort.values():
+            value["capacity_share_pct"] = 100.0 * float(value["capacity_increment_bits"]) / raw_total
+            value["demand_capped_share_pct"] = 100.0 * float(value["demand_capped_increment_bits"]) / capped_total
+        cohort["total"] = {
+            "user_anchor_count": sum(int(value["user_anchor_count"]) for value in cohort.values()),
+            "capacity_increment_bits": raw_total,
+            "demand_capped_increment_bits": capped_total,
+            "capacity_share_pct": 100.0,
+            "demand_capped_share_pct": 100.0,
+        }
+
+        replayed[rule] = anchors
+        rules_result[rule] = {
+            "pooled": {
+                "c1_joules": c1_pool["joules"],
+                "c2_joules": c2_pool["joules"],
+                "c1_served_count": c1_pool["served_count"],
+                "c2_served_count": c2_pool["served_count"],
+                "c1_rate_target_attained_count": c1_pool["rate_target_attained_count"],
+                "c2_rate_target_attained_count": c2_pool["rate_target_attained_count"],
+                "numerators": numerators,
+            },
+            "cohort_split": cohort,
+            "anchors": anchors,
+        }
+
+    c1_census.enforce("C1")
+    c2_census.enforce("C2")
+    if c1_count_mismatches:
+        raise RuntimeError(f"C1 count parity failed: {c1_count_mismatches}")
+    if c2_count_mismatches:
+        raise RuntimeError(f"C2 count parity failed: {c2_count_mismatches}")
+
+    result: dict[str, object] = {
+        "schema": "mcrl-v025-control-law-demand-capped-rescore-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "accounting_definitions": {
+            "endpoint_duration_s": float(47 * control.STEP_S),
+            "per_user_demand_bits": demand_bits,
+            "CAPACITY": "sum integrated delivery over user-anchors",
+            "DEMAND_CAPPED": "sum min(integrated user-anchor delivery, per-user demand)",
+            "ATTAINMENT_ONLY": "sum uncapped integrated delivery only for user-anchors attaining per-user demand",
+        },
+        "provenance": {
+            "source_report_path": str(SOURCE_REPORT),
+            "source_report_sha256": sha256(SOURCE_REPORT),
+            "source_report_expected_sha256": EXPECTED_REPORT_SHA256,
+            "source_receipt_path": str(SOURCE_RECEIPT),
+            "source_receipt_sha256": sha256(SOURCE_RECEIPT),
+            "source_receipt_canonical_digest_verified": True,
+            "source_script_path": str(SOURCE_SCRIPT),
+            "source_script_current_sha256": sha256(SOURCE_SCRIPT),
+            "source_script_cited_sha256": CITED_SOURCE_SCRIPT_SHA256,
+            "source_script_matches_cited_digest": sha256(SOURCE_SCRIPT) == CITED_SOURCE_SCRIPT_SHA256,
+            "pinned_executable_sources": executable_sources,
+            "python": sys.executable,
+            "search_rerun": True,
+            "search_scope": "original per-anchor deterministic local search only; no pooled-search extension",
+            "maximum_concurrent_python_processes": 2,
+            "worker_processes": 1,
+            "blas_threads": 1,
+        },
+        "parity_gate": {
+            "threshold_ulp": ULP_LIMIT,
+            "c1": c1_census.result(),
+            "c1_integer_comparison_count": 36,
+            "c1_integer_mismatches": c1_count_mismatches,
+            "c2": c2_census.result(),
+            "c2_integer_comparison_count": 36,
+            "c2_integer_mismatches": c2_count_mismatches,
+        },
+        "invariant": {
+            "definition": "per user-anchor integrated C2 delivery >= integrated C1 delivery",
+            "user_anchor_count": sum(len(row["users"]) for rows in replayed.values() for row in rows),
+            "violation_count": len(all_violations),
+            "violations": all_violations,
+            "minimum_delta_bits": minimum_delta,
+        },
+        "paper_lower_bound_verified": len(all_violations) == 0,
+        "rules": rules_result,
+    }
+    result["receipt_sha256"] = canonical_digest(result)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    OUTPUT.write_text(
+        json.dumps(result, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    REPORT.write_text(render_report(result), encoding="utf-8")
+    print(json.dumps({
+        "status": "PASS",
+        "output": str(OUTPUT),
+        "report": str(REPORT),
+        "receipt_sha256": result["receipt_sha256"],
+        "c1_ulp_census": result["parity_gate"]["c1"],
+        "c2_ulp_census": result["parity_gate"]["c2"],
+        "invariant_violations": len(all_violations),
+        "demand_capped_gains": {
+            rule: rules_result[rule]["pooled"]["numerators"]["DEMAND_CAPPED"]["relative_gain"]
+            for rule in RULES
+        },
+    }, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.scratch/control-law-capped/spec.md b/.scratch/control-law-capped/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..8a977f1054928821ac2f9d6354bd3525408897ac
--- /dev/null
+++ b/.scratch/control-law-capped/spec.md
@@ -0,0 +1,12 @@
+# CTRLCAP replay criterion
+
+Status: `DIAGNOSTIC_NOT_CLAIM`.
+
+The diagnostic is complete only when one deterministic command using one parent and one anchor worker (two Python processes, below the hard cap of four):
+
+1. reconstructs both rules' fixed `J_from_first` assignments on all eight anchors and all 48 realised boundaries;
+2. replays C1 and fails closed if any reported C1 floating value differs by more than 2 ULP or any reported count differs;
+3. replays each recorded C2 local-search mode schedule and requires its aggregate values and counts to match the sealed control-law receipt within the same 2-ULP tolerance;
+4. integrates delivery per user-anchor before computing `CAPACITY`, `DEMAND_CAPPED`, and `ATTAINMENT_ONLY`;
+5. enumerates every integrated-delivery non-regression violation, reconciles the attainment-defined cohort split, and exactly decomposes the capped relative gain into energy-only and extra-credited-bits components; and
+6. writes `.scratch/control-law-capped/rescored.json` and `CONTROL-LAW-DEMAND-CAPPED-2026-09-10.md` without changing any source receipt, sealed setting, search setting, or sibling workspace.

diff --git a/.scratch/control-law-capped/rescore_control_law.py b/.scratch/control-law-capped/rescore_control_law.py
new file mode 100644
index 0000000000000000000000000000000000000000..f4a05a83ef9e01eab2cc0c46ab72b78db573a519
--- /dev/null
+++ b/.scratch/control-law-capped/rescore_control_law.py
@@ -0,0 +1,793 @@
+#!/usr/bin/env python3
+"""Read-only demand-capped replay of the fixed-assignment control-law receipt.
+
+DIAGNOSTIC_NOT_CLAIM. This replays recorded C1 assignments and the unchanged,
+deterministic C2 search. It does not modify a sealed input or search setting.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from concurrent.futures import ProcessPoolExecutor, as_completed
+import hashlib
+import importlib.util
+import json
+import math
+import multiprocessing
+import os
+from pathlib import Path
+import struct
+import sys
+from typing import Mapping, Sequence
+
+
+WORKSPACE = Path(__file__).resolve().parents[2]
+ARCH = Path("/home/sat/mcrl-v025-arch-ws")
+SOURCE_REPORT = ARCH / "CONTROL-LAW-CEILING-2026-09-10.md"
+SOURCE_RECEIPT = ARCH / ".scratch/control-law-ceiling/control-law-ceiling.json"
+SOURCE_SCRIPT = ARCH / "scripts/run_control_law_ceiling.py"
+CHECKPOINTS = ARCH / ".scratch/control-law-ceiling/checkpoints"
+PARTS = WORKSPACE / ".scratch/control-law-capped/parts"
+OUTPUT = WORKSPACE / ".scratch/control-law-capped/rescored.json"
+REPORT = WORKSPACE / "CONTROL-LAW-DEMAND-CAPPED-2026-09-10.md"
+
+EXPECTED_REPORT_SHA256 = "f5bbbef109186b56447ae97874ecd4c6843146a021f57b8ae2f328d5abddab6b"
+EXPECTED_RECEIPT_SHA256 = "2c308dd4fb7a325b394418f9820ae1375d78efc52dfd2fac74094964f4ed334a"
+CITED_SOURCE_SCRIPT_SHA256 = "6840a68842068cec4a9946c5fdca68470b73242d29fccc8df3185da10a11e59d"
+ULP_LIMIT = 2
+RULES = ("SEALED", "STRICT")
+NUMERATORS = ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY")
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    encoded = json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def load_control_module():
+    spec = importlib.util.spec_from_file_location("ctrlcap_source", SOURCE_SCRIPT)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot import control-law replay source")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def positive_float_ulp_distance(left: float, right: float) -> int:
+    if not (math.isfinite(left) and math.isfinite(right)):
+        raise RuntimeError("ULP comparison received a non-finite value")
+    if left < 0.0 or right < 0.0:
+        raise RuntimeError("ULP comparison is restricted to nonnegative receipt values")
+    left_bits = struct.unpack(">Q", struct.pack(">d", left))[0]
+    right_bits = struct.unpack(">Q", struct.pack(">d", right))[0]
+    return abs(left_bits - right_bits)
+
+
+class UlpCensus:
+    def __init__(self, limit: int) -> None:
+        self.limit = limit
+        self.distances: list[int] = []
+        self.nonexact: list[dict[str, object]] = []
+
+    def compare(self, field: str, actual: float, expected: float) -> None:
+        distance = positive_float_ulp_distance(actual, expected)
+        self.distances.append(distance)
+        if distance:
+            self.nonexact.append({
+                "field": field,
+                "actual": actual,
+                "expected": expected,
+                "ulp_distance": distance,
+            })
+
+    def result(self) -> dict[str, object]:
+        bins = Counter(self.distances)
+        return {
+            "comparison_count": len(self.distances),
+            "binary64_exact": bins[0],
+            "exactly_1_ulp": bins[1],
+            "exactly_2_ulp": bins[2],
+            "above_2_ulp": sum(count for distance, count in bins.items() if distance > 2),
+            "maximum_ulp": max(self.distances, default=0),
+            "nonexact_fields": self.nonexact,
+            "threshold_ulp": self.limit,
+        }
+
+    def enforce(self, label: str) -> None:
+        result = self.result()
+        if int(result["maximum_ulp"]) > self.limit:
+            raise RuntimeError(f"{label} parity gate failed: {result}")
+
+
+def load_checkpoint(rule: str, world_index: int, step_index: int) -> tuple[dict, Path]:
+    path = CHECKPOINTS / f"{rule.lower()}-world-{world_index}-step-{step_index}.json"
+    checkpoint = json.loads(path.read_text(encoding="ascii"))
+    if checkpoint.get("schema") != "mcrl-v025-control-law-anchor-checkpoint-v1":
+        raise RuntimeError(f"unexpected checkpoint schema: {path}")
+    if checkpoint.get("rule") != rule:
+        raise RuntimeError(f"checkpoint rule mismatch: {path}")
+    return checkpoint, path
+
+
+def replay_anchor(control, rule: str, source_anchor: Mapping[str, object], tape,
+                  mode_schedule: Sequence[Sequence[Sequence[int]]]) -> dict:
+    world_index = int(source_anchor["world_index"])
+    step_index = int(source_anchor["step_index"])
+    anchor_id = str(source_anchor["anchor_id"])
+    checkpoint, checkpoint_path = load_checkpoint(rule, world_index, step_index)
+    checkpoint_anchor = checkpoint["anchor"]
+    if checkpoint_anchor["anchor_id"] != anchor_id:
+        raise RuntimeError(f"checkpoint anchor mismatch: {checkpoint_path}")
+
+    base = control.runner.probe._base_configuration(tape, step_index, "nearest-eligible")
+    committed = source_anchor["committed"]["J_from_first"]
+    config = control.configuration_from_record(base, committed)
+    if config.configuration_id != checkpoint_anchor["fixed_configuration_id"]:
+        raise RuntimeError(f"fixed configuration mismatch at {anchor_id}")
+    geometries = tape.geometry_for(step_index=step_index, assignments=config.mapping)
+    architecture, context = control.c1_architecture(rule)
+    roster = tuple(sorted(config.mapping))
+    c1_user_boundary: list[dict[int, float]] = []
+    c2_user_boundary: list[dict[int, float]] = []
+    c1_boundary_rates: list[float] = []
+    c2_boundary_rates: list[float] = []
+    c1_boundary_power: list[float] = []
+    c2_boundary_power: list[float] = []
+    if len(mode_schedule) != control.BOUNDARIES:
+        raise RuntimeError(f"mode schedule boundary count mismatch at {anchor_id}")
+
+    if context is not None:
+        context.__enter__()
+    try:
+        for boundary, (_time, geometry) in enumerate(geometries):
+            radiation = architecture.radiate(
+                control.runner.RadiationConfig(
+                    rate_target_bps=control.RATE_TARGET_BPS,
+                    fading_quantile_alpha=0.10,
+                ),
+                geometry,
+                "realised",
+            )
+            if not radiation.valid:
+                raise RuntimeError(f"C1 radiation invalid at {anchor_id} boundary {boundary}")
+            if len(radiation.slots) != len(mode_schedule[boundary]):
+                raise RuntimeError(f"mode schedule slot count mismatch at {anchor_id}")
+            c1_rates = {user: 0.0 for user in roster}
+            c2_rates = {user: 0.0 for user in roster}
+            c1_power = 0.0
+            c2_power = 0.0
+            for slot_index, (slot, scheduled_modes) in enumerate(
+                zip(radiation.slots, mode_schedule[boundary], strict=True)
+            ):
+                positive = [tx for tx in slot.transmissions if tx.rf_power_w > 0.0]
+                c1_power += slot.fraction * (
+                    math.fsum(
+                        control.pa_supply_power_w(tx.rf_power_w)
+                        + control.CIRCUIT_POWER_PER_CHAIN_W
+                        for tx in positive
+                    )
+                    + len({tx.beam[0] for tx in positive})
+                    * control.BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
+                )
+                for tx in slot.transmissions:
+                    if tx.realised_outcome.decoded:
+                        c1_rates[tx.user_id] += (
+                            slot.fraction
+                            * control.BEAM_BANDWIDTH_HZ
+                            * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
+                        )
+
+                offsets = {int(tx.user_id): 0.0 for tx in slot.transmissions}
+                problem = control.SlotProblem(
+                    geometry, slot, boundary=boundary, off_axis=offsets
+                )
+                value = problem.evaluate(tuple(int(mode) for mode in scheduled_modes))
+                if not value.feasible:
+                    raise RuntimeError(
+                        f"recorded C2 schedule infeasible at {anchor_id} "
+                        f"boundary {boundary} slot {slot_index}"
+                    )
+                c2_power += slot.fraction * value.power_w
+                for local_index, user in enumerate(problem.users):
+                    c2_rates[user] += slot.fraction * value.rates_bps[local_index]
+
+            c1_user_boundary.append(c1_rates)
+            c2_user_boundary.append(c2_rates)
+            c1_boundary_rates.append(math.fsum(c1_rates.values()))
+            c2_boundary_rates.append(math.fsum(c2_rates.values()))
+            c1_boundary_power.append(c1_power)
+            c2_boundary_power.append(c2_power)
+    finally:
+        if context is not None:
+            context.__exit__(None, None, None)
+
+    c1_user_bits = {
+        user: control.trapezoid([row[user] for row in c1_user_boundary])
+        for user in roster
+    }
+    c2_user_bits = {
+        user: control.trapezoid([row[user] for row in c2_user_boundary])
+        for user in roster
+    }
+    target = float(control.RATE_TARGET_BPS * 47 * control.STEP_S)
+
+    def aggregate(user_bits: Mapping[int, float], boundary_rates: Sequence[float],
+                  boundary_power: Sequence[float]) -> dict[str, object]:
+        bits = control.trapezoid(boundary_rates)
+        joules = control.trapezoid(boundary_power)
+        return {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": bits / joules,
+            "served_count": sum(value > 0.0 for value in user_bits.values()),
+            "rate_target_attained_count": sum(value >= target for value in user_bits.values()),
+        }
+
+    c1_aggregate = aggregate(c1_user_bits, c1_boundary_rates, c1_boundary_power)
+    c2_aggregate = aggregate(c2_user_bits, c2_boundary_rates, c2_boundary_power)
+    users = [
+        {
+            "user_id": user,
+            "c1_delivered_bits": c1_user_bits[user],
+            "c2_delivered_bits": c2_user_bits[user],
+            "delta_bits": c2_user_bits[user] - c1_user_bits[user],
+            "c1_attained": c1_user_bits[user] >= target,
+            "c2_attained": c2_user_bits[user] >= target,
+        }
+        for user in roster
+    ]
+    return {
+        "anchor_id": anchor_id,
+        "world_index": world_index,
+        "step_index": step_index,
+        "fixed_configuration_id": config.configuration_id,
+        "checkpoint_path": str(checkpoint_path),
+        "checkpoint_sha256": sha256(checkpoint_path),
+        "mode_schedule": mode_schedule,
+        "c1_aggregate_replay": c1_aggregate,
+        "c2_aggregate_replay": c2_aggregate,
+        "users": users,
+    }
+
+
+def part_path(rule: str, source_anchor: Mapping[str, object]) -> Path:
+    return PARTS / (
+        f"{rule.lower()}-world-{int(source_anchor['world_index'])}-"
+        f"step-{int(source_anchor['step_index'])}.json"
+    )
+
+
+def part_contract(rule: str, source_anchor: Mapping[str, object]) -> dict[str, object]:
+    checkpoint, checkpoint_path = load_checkpoint(
+        rule, int(source_anchor["world_index"]), int(source_anchor["step_index"])
+    )
+    return {
+        "schema": "mcrl-v025-control-law-capped-anchor-part-v1",
+        "rule": rule,
+        "anchor_id": str(source_anchor["anchor_id"]),
+        "source_script_sha256": sha256(SOURCE_SCRIPT),
+        "source_receipt_sha256": sha256(SOURCE_RECEIPT),
+        "fixed_assignment_receipt_sha256": sha256(
+            Path("/home/sat/mcrl-v025-beam-ws/.scratch/beamwidth")
+            / ("final-sealed-one-sided-1.66.json" if rule == "SEALED" else "final-strict-one-sided-1.66.json")
+        ),
+        "checkpoint_sha256": sha256(checkpoint_path),
+        "checkpoint_schema": checkpoint["schema"],
+    }
+
+
+def replay_job(rule: str, source_anchor: Mapping[str, object]) -> dict:
+    """Run one independent unchanged local search and per-user schedule replay."""
+    control = load_control_module()
+    world_index = int(source_anchor["world_index"])
+    domain = control.runner.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+    provider = control.factory()
+    tape = control.runner.probe.build_world_tape(
+        domain=domain, provider=provider, steps=4, start_time_s=0.0
+    )
+    if tape.digest != source_anchor["world_sha256"]:
+        raise RuntimeError(f"world digest mismatch for {source_anchor['anchor_id']}")
+    searched = control.evaluate_anchor(rule, source_anchor, tape, provider)
+    row = replay_anchor(
+        control, rule, source_anchor, tape, searched["search"]["mode_schedule"]
+    )
+    row["part_contract"] = part_contract(rule, source_anchor)
+    destination = part_path(rule, source_anchor)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text(
+        json.dumps(row, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    return row
+
+
+def compare_aggregate(census: UlpCensus, count_mismatches: list[dict[str, object]],
+                      prefix: str, actual: Mapping[str, object],
+                      expected: Mapping[str, object]) -> None:
+    for field in ("bits", "joules", "ee_bit_per_j"):
+        census.compare(f"{prefix}.{field}", float(actual[field]), float(expected[field]))
+    for field in ("served_count", "rate_target_attained_count"):
+        if int(actual[field]) != int(expected[field]):
+            count_mismatches.append({
+                "field": f"{prefix}.{field}",
+                "actual": int(actual[field]),
+                "expected": int(expected[field]),
+            })
+
+
+def accounting(bits: Sequence[float], joules: float, demand_bits: float) -> dict[str, dict[str, float]]:
+    credited = {
+        "CAPACITY": math.fsum(bits),
+        "DEMAND_CAPPED": math.fsum(min(value, demand_bits) for value in bits),
+        "ATTAINMENT_ONLY": math.fsum(value for value in bits if value >= demand_bits),
+    }
+    return {
+        name: {
+            "credited_bits": value,
+            "ee_bit_per_j": value / joules,
+        }
+        for name, value in credited.items()
+    }
+
+
+def relative_gain(c2: float, c1: float) -> float | None:
+    return None if c1 == 0.0 else c2 / c1 - 1.0
+
+
+def pct(value: float | None, digits: int = 4) -> str:
+    return "undefined" if value is None else f"{100.0 * value:+.{digits}f}%"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    rules = result["rules"]
+    sealed = rules["SEALED"]
+    strict = rules["STRICT"]
+    sealed_capped = sealed["pooled"]["numerators"]["DEMAND_CAPPED"]
+    strict_capped = strict["pooled"]["numerators"]["DEMAND_CAPPED"]
+    first = (
+        "**The demand-capped counterparts are "
+        f"{pct(sealed_capped['relative_gain'], 4)} (`SEALED`) and "
+        f"{pct(strict_capped['relative_gain'], 4)} (`STRICT`); energy reduction accounts for "
+        f"{sealed_capped['energy_share_of_total_gain_pct']:.2f}% and "
+        f"{strict_capped['energy_share_of_total_gain_pct']:.2f}% of those gains, respectively.**"
+    )
+    lines = [
+        first,
+        "",
