+        lines += [
+            f"#### `{rule}`",
+            "",
+            "| C1 cohort | User-anchors | Raw increment (Gbit) | Raw share | Capped increment (Gbit) | Capped share |",
+            "|---|---:|---:|---:|---:|---:|",
+        ]
+        for key, label in (("already_attained", "Already attained"), ("not_attained", "Did not attain"), ("total", "Total")):
+            item = split[key]
+            lines.append(
+                f"| {label} | {item['user_anchor_count']} | "
