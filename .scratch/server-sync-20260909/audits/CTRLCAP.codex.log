+EXPECTED_REPORT_SHA256 = "f5bbbef109186b56447ae97874ecd4c6843146a021f57b8ae2f328d5abddab6b"
+EXPECTED_RECEIPT_SHA256 = "2c308dd4fb7a325b394418f9820ae1375d78efc52dfd2fac74094964f4ed334a"
+CITED_SOURCE_SCRIPT_SHA256 = "6840a68842068cec4a9946c5fdca68470b73242d29fccc8df3185da10a11e59d"
+ULP_LIMIT = 2
+RULES = ("SEALED", "STRICT")
+NUMERATORS = ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY")
