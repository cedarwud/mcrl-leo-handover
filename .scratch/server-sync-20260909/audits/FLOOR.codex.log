+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        matches = actual[field] == expected[field]
+        if field in {"bits", "joules"}:
+            matches = math.isclose(
+                float(actual[field]),
+                float(expected[field]),
+                rel_tol=1e-13,
+                abs_tol=1e-9,
+            )
+        if not matches:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
