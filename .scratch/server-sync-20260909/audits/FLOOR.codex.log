+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
