index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

