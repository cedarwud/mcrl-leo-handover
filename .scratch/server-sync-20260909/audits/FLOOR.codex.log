+#!/usr/bin/env python3
+"""Measure the one-pass occupancy-three floor on the oracle-ceiling panel."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+PROBE_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+REFERENCE_PATH = Path(
+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+
+from mcrl.physics_v025.occupancy_floor import (  # noqa: E402
+    MIN_OCCUPANCY,
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancies,
+    occupancy_histogram,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+    ).strip()
+
+
+def _canonical_sha256(payload: object) -> str:
+    raw = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_reference(path: Path) -> dict[str, object]:
+    if _sha256(path) != REFERENCE_SHA256:
+        raise RuntimeError("oracle-ceiling reference file digest drifted")
+    payload = json.loads(path.read_text(encoding="ascii"))
+    declared = payload.pop("receipt_sha256", None)
+    if declared != REFERENCE_RECEIPT_SHA256 or _canonical_sha256(payload) != declared:
+        raise RuntimeError("oracle-ceiling embedded receipt digest is invalid")
+    payload["receipt_sha256"] = declared
+    if payload.get("schema") != "mcrl-v025-perfect-knowledge-oracle-ceiling-v1":
+        raise RuntimeError("wrong oracle-ceiling schema")
+    if payload.get("claim_ceiling") != CLAIM_CEILING:
+        raise RuntimeError("oracle-ceiling claim ceiling drifted")
+    if payload.get("source_tree") != ENGINE_TREE:
+        raise RuntimeError("oracle-ceiling engine tree drifted")
+    if len(payload.get("anchors", ())) != WORLD_COUNT * ANCHORS_PER_WORLD:
+        raise RuntimeError("oracle-ceiling anchor panel drifted")
+    return payload
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative_gain(numerator: float, denominator: float) -> float:
+    if denominator == 0.0:
+        raise RuntimeError("zero reference EE")
+    return numerator / denominator - 1.0
+
+
+def parse_configuration(base, encoded: str, *, kind: str):
+    if not encoded.startswith("CFG:"):
+        raise RuntimeError(f"cannot parse non-derived configuration {encoded!r}")
+    mapping = {}
+    for item in encoded[4:].split(";"):
+        fields = item.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            mapping[user] = None
+        else:
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    config = probe._configuration(base, mapping, kind=kind)
+    if config.configuration_id != encoded:
+        raise RuntimeError("configuration reconstruction changed its identity")
+    return config
+
+
+def slant_lookup(tape, step_index: int) -> dict[tuple[int, tuple[int, int]], float]:
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        boundary = step.boundary_at(0)
+        return {
+            (row.user_id, row.identity): float(row.slant_km)
+            for row in boundary.candidates
+            if row.legal
+        }
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        if actual[field] != expected[field]:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    base_selection = selection.evaluate(base)
+    service_guard = served(base_selection)
+    scoring_seconds = 0.0
+    decision_started = time.perf_counter()
+    legal_options, _ = probe._legal_options(tape, step_index)
+    slants = slant_lookup(tape, step_index)
+
+    def exact_score(plan):
+        nonlocal scoring_seconds
+        config = probe._configuration(base, plan.mapping, kind=f"floor-{plan.action}")
+        started = time.perf_counter()
+        profile = selection.evaluate(config)
+        scoring_seconds += time.perf_counter() - started
+        if config.configuration_id in selection._invalid:
+            return None
+        return ScoredRepair(
+            plan=plan,
+            objective=objective(profile),
+            served_count=served(profile),
+            configuration_id=config.configuration_id,
+        )
+
+    floor_result = apply_occupancy_floor(
+        base.mapping,
+        legal_options=legal_options,
+        slant_km=slants,
+        exact_score=exact_score,
+        minimum_served=service_guard,
+    )
+    decision_seconds = time.perf_counter() - decision_started
+    floor = probe._configuration(base, floor_result.mapping, kind="occupancy-floor")
+    expected_committed = reference["committed"]
+    unilateral = parse_configuration(
+        base,
+        str(expected_committed["UNILATERAL"]["configuration_id"]),
+        kind="unilateral-reference",
+    )
+    oracle_set = parse_configuration(
+        base,
+        str(expected_committed["ORACLE_SET"]["configuration_id"]),
+        kind="oracle-set-reference",
+    )
+    committed = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    configs = (base, unilateral, floor, oracle_set)
+    committed.evaluate_many(configs)
+    profiles = {
+        "BASELINE": committed.evaluate(base),
+        "UNILATERAL": committed.evaluate(unilateral),
+        "FLOOR": committed.evaluate(floor),
+        "ORACLE_SET": committed.evaluate(oracle_set),
+    }
+    payloads = {name: _profile_payload(profile) for name, profile in profiles.items()}
+    for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        _verify_reference_profile(payloads[name], expected_committed[name], arm=name)
+
+    before_counts = occupancies(base.mapping)
+    after_counts = occupancies(floor.mapping)
+    initial_underfull = floor_result.initially_underfull
+    consolidated = sum(after_counts.get(beam, 0) >= MIN_OCCUPANCY for beam in initial_underfull)
+    emptied = sum(after_counts.get(beam, 0) == 0 for beam in initial_underfull)
+    if consolidated + emptied != len(initial_underfull):
+        raise RuntimeError("initial underfull beam was neither consolidated nor emptied")
+    return {
+        "anchor_id": reference["anchor_id"],
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "policy": {
+            "minimum_occupancy": MIN_OCCUPANCY,
+            "starting_assignment": "BASELINE",
+            "service_guard": service_guard,
+            "initial_underfull_beams": len(initial_underfull),
+            "consolidated_beams": consolidated,
+            "emptied_beams": emptied,
+            "changed_users": floor.changed_users,
+            "before_active_beams": len(before_counts),
+            "after_active_beams": len(after_counts),
+            "before_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(base.mapping).items()
+            },
+            "after_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(floor.mapping).items()
+            },
+            "selected_repairs": [
+                {
+                    "beam": list(row.plan.beam),
+                    "action": row.plan.action,
+                    "moved_users": list(row.plan.moved_users),
+                    "decision_served_count": row.served_count,
+                    "objective_bits": float(row.objective),
+                    "configuration_id": row.configuration_id,
+                }
+                for row in floor_result.decisions
+            ],
+            "exact_branch_configurations_evaluated": selection.physical_evaluations - 1,
+            "decision_wall_seconds": decision_seconds,
+            "exact_scoring_wall_seconds": scoring_seconds,
+            "rule_overhead_wall_seconds": max(0.0, decision_seconds - scoring_seconds),
+        },
+        "committed": payloads,
+    }
+
+
+def _percentile(values: Sequence[float], q: float) -> float:
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * q
+    low = math.floor(index)
+    high = math.ceil(index)
+    if low == high:
+        return ordered[low]
+    return ordered[low] * (high - index) + ordered[high] * (index - low)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    arms = ("BASELINE", "UNILATERAL", "FLOOR", "ORACLE_SET")
+    pooled = {}
+    for arm in arms:
+        bits = math.fsum(float(row["committed"][arm]["bits"]) for row in anchors)
+        joules = math.fsum(float(row["committed"][arm]["joules"]) for row in anchors)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ratio(bits, joules),
+            "served_count_sum": sum(
+                int(row["committed"][arm]["served_count"]) for row in anchors
+            ),
+        }
+    numerator = pooled["FLOOR"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    denominator = pooled["ORACLE_SET"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    if denominator <= 0.0:
+        raise RuntimeError("oracle reference has no positive headroom")
+    timing = [float(row["policy"]["decision_wall_seconds"]) for row in anchors]
+    overhead = [float(row["policy"]["rule_overhead_wall_seconds"]) for row in anchors]
+    before_hist = Counter()
+    after_hist = Counter()
+    for row in anchors:
+        before_hist.update({int(k): int(v) for k, v in row["policy"]["before_occupancy_histogram"].items()})
+        after_hist.update({int(k): int(v) for k, v in row["policy"]["after_occupancy_histogram"].items()})
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({row["world_domain"] for row in anchors}),
+        "pooled": pooled,
+        "captured_fraction_of_oracle_gain_over_unilateral": numerator / denominator,
+        "floor_over_unilateral_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_over_baseline_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        ),
+        "oracle_set_over_unilateral_relative": relative_gain(
+            pooled["ORACLE_SET"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_decision_wall_seconds": {
+            "mean": statistics.fmean(timing),
+            "p50": _percentile(timing, 0.50),
+            "p95": _percentile(timing, 0.95),
+            "max": max(timing),
+            "sum": math.fsum(timing),
+        },
+        "floor_rule_overhead_wall_seconds": {
+            "mean": statistics.fmean(overhead),
+            "p50": _percentile(overhead, 0.50),
+            "p95": _percentile(overhead, 0.95),
+            "max": max(overhead),
+        },
+        "initial_underfull_beams": sum(
+            int(row["policy"]["initial_underfull_beams"]) for row in anchors
+        ),
+        "consolidated_beams": sum(int(row["policy"]["consolidated_beams"]) for row in anchors),
+        "emptied_beams": sum(int(row["policy"]["emptied_beams"]) for row in anchors),
+        "changed_users": sum(int(row["policy"]["changed_users"]) for row in anchors),
+        "before_occupancy_histogram": {str(k): v for k, v in sorted(before_hist.items())},
+        "after_occupancy_histogram": {str(k): v for k, v in sorted(after_hist.items())},
+        "floor_worse_than_unilateral_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        ],
+        "floor_worse_than_baseline_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["BASELINE"]["ee_bit_per_j"]
+        ],
+    }
+
+
+def run(*, worlds: int, anchors_per_world: int, reference_path: Path) -> dict[str, object]:
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested run exceeds the fixed 4-world x 5-anchor panel")
+    reference = load_reference(reference_path)
+    by_anchor = {row["anchor_id"]: row for row in reference["anchors"]}
+    started = time.perf_counter()
+    anchors = []
+    world_rows = []
+    for world_index in range(1, worlds + 1):
+        domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=ANCHORS_PER_WORLD,
+            start_time_s=0.0,
+        )
+        world_rows.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "tle_date": tape.tle_date,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        for step_index in range(anchors_per_world):
+            anchor_id = f"{domain}:step/{step_index}"
+            row = evaluate_anchor(tape=tape, reference=by_anchor[anchor_id])
+            anchors.append(row)
+            print(
+                json.dumps(
+                    {
+                        "anchor": anchor_id,
+                        "floor_ee": row["committed"]["FLOOR"]["ee_bit_per_j"],
+                        "served": row["committed"]["FLOOR"]["served_count"],
+                        "underfull": row["policy"]["initial_underfull_beams"],
+                        "consolidated": row["policy"]["consolidated_beams"],
+                        "emptied": row["policy"]["emptied_beams"],
+                        "decision_ms": 1000.0 * row["policy"]["decision_wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    result = {
+        "schema": "mcrl-v025-occupancy-floor-diagnostic-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "engine_commit": "75c5c78c",
+        "engine_tree": ENGINE_TREE,
+        "workspace_commit_before_diagnostic": _git("rev-parse", "HEAD"),
+        "probe_source_sha256": _sha256(PROBE_PATH),
+        "oracle_reference_path": str(reference_path),
+        "oracle_reference_file_sha256": REFERENCE_SHA256,
+        "oracle_reference_receipt_sha256": REFERENCE_RECEIPT_SHA256,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "process_limit": 3,
+        "processes_used": 1,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "thresholds_tried": [MIN_OCCUPANCY],
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "eta_ref": [ETA_REF.numerator, ETA_REF.denominator],
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "every intermediate branch selected from served count >= BASELINE at boundary 0",
+        "policy_rule": (
+            "Starting from BASELINE, visit the initially active occupancy-1/2 beams once in ascending identity order. "
+            "Prescribe consolidation by importing the nearest-slant legal occupants of other currently underfull beams until occupancy 3, and evacuation by moving every occupant to its nearest-slant legal currently occupancy>=3 beam (NULL only if none). "
+            "Choose the service-safe branch with greater exact F; ties use served count, consolidate before empty, then configuration id. Commit each repair immediately."
+        ),
+        "worlds": world_rows,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    result["receipt_sha256"] = _canonical_sha256(result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--reference", type=Path, default=REFERENCE_PATH)
+    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
+    args = parser.parse_args()
+    result = run(
+        worlds=args.worlds,
+        anchors_per_world=args.anchors_per_world,
+        reference_path=args.reference,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/occupancy_floor.py b/src/mcrl/physics_v025/occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
diff --git a/tests/physics_v025/test_occupancy_floor.py b/tests/physics_v025/test_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

diff --git a/.scratch/occupancy-floor/run_occupancy_floor.py b/.scratch/occupancy-floor/run_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f1834ff29715024ab9fe74ea6299433671b9b42
--- /dev/null
+++ b/.scratch/occupancy-floor/run_occupancy_floor.py
@@ -0,0 +1,511 @@
+#!/usr/bin/env python3
+"""Measure the one-pass occupancy-three floor on the oracle-ceiling panel."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+PROBE_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+REFERENCE_PATH = Path(
+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+
+from mcrl.physics_v025.occupancy_floor import (  # noqa: E402
+    MIN_OCCUPANCY,
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancies,
+    occupancy_histogram,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+    ).strip()
+
+
+def _canonical_sha256(payload: object) -> str:
+    raw = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_reference(path: Path) -> dict[str, object]:
+    if _sha256(path) != REFERENCE_SHA256:
+        raise RuntimeError("oracle-ceiling reference file digest drifted")
+    payload = json.loads(path.read_text(encoding="ascii"))
+    declared = payload.pop("receipt_sha256", None)
+    if declared != REFERENCE_RECEIPT_SHA256 or _canonical_sha256(payload) != declared:
+        raise RuntimeError("oracle-ceiling embedded receipt digest is invalid")
+    payload["receipt_sha256"] = declared
+    if payload.get("schema") != "mcrl-v025-perfect-knowledge-oracle-ceiling-v1":
+        raise RuntimeError("wrong oracle-ceiling schema")
+    if payload.get("claim_ceiling") != CLAIM_CEILING:
+        raise RuntimeError("oracle-ceiling claim ceiling drifted")
+    if payload.get("source_tree") != ENGINE_TREE:
+        raise RuntimeError("oracle-ceiling engine tree drifted")
+    if len(payload.get("anchors", ())) != WORLD_COUNT * ANCHORS_PER_WORLD:
+        raise RuntimeError("oracle-ceiling anchor panel drifted")
+    return payload
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative_gain(numerator: float, denominator: float) -> float:
+    if denominator == 0.0:
+        raise RuntimeError("zero reference EE")
+    return numerator / denominator - 1.0
+
+
+def parse_configuration(base, encoded: str, *, kind: str):
+    if not encoded.startswith("CFG:"):
+        raise RuntimeError(f"cannot parse non-derived configuration {encoded!r}")
+    mapping = {}
+    for item in encoded[4:].split(";"):
+        fields = item.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            mapping[user] = None
+        else:
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    config = probe._configuration(base, mapping, kind=kind)
+    if config.configuration_id != encoded:
+        raise RuntimeError("configuration reconstruction changed its identity")
+    return config
+
+
+def slant_lookup(tape, step_index: int) -> dict[tuple[int, tuple[int, int]], float]:
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        boundary = step.boundary_at(0)
+        return {
+            (row.user_id, row.identity): float(row.slant_km)
+            for row in boundary.candidates
+            if row.legal
+        }
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        if actual[field] != expected[field]:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    base_selection = selection.evaluate(base)
+    service_guard = served(base_selection)
+    scoring_seconds = 0.0
+    decision_started = time.perf_counter()
+    legal_options, _ = probe._legal_options(tape, step_index)
+    slants = slant_lookup(tape, step_index)
+
+    def exact_score(plan):
+        nonlocal scoring_seconds
+        config = probe._configuration(base, plan.mapping, kind=f"floor-{plan.action}")
+        started = time.perf_counter()
+        profile = selection.evaluate(config)
+        scoring_seconds += time.perf_counter() - started
+        if config.configuration_id in selection._invalid:
+            return None
+        return ScoredRepair(
+            plan=plan,
+            objective=objective(profile),
+            served_count=served(profile),
+            configuration_id=config.configuration_id,
+        )
+
+    floor_result = apply_occupancy_floor(
+        base.mapping,
+        legal_options=legal_options,
+        slant_km=slants,
+        exact_score=exact_score,
+        minimum_served=service_guard,
+    )
+    decision_seconds = time.perf_counter() - decision_started
+    floor = probe._configuration(base, floor_result.mapping, kind="occupancy-floor")
+    expected_committed = reference["committed"]
+    unilateral = parse_configuration(
+        base,
+        str(expected_committed["UNILATERAL"]["configuration_id"]),
+        kind="unilateral-reference",
+    )
+    oracle_set = parse_configuration(
+        base,
+        str(expected_committed["ORACLE_SET"]["configuration_id"]),
+        kind="oracle-set-reference",
+    )
+    committed = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    configs = (base, unilateral, floor, oracle_set)
+    committed.evaluate_many(configs)
+    profiles = {
+        "BASELINE": committed.evaluate(base),
+        "UNILATERAL": committed.evaluate(unilateral),
+        "FLOOR": committed.evaluate(floor),
+        "ORACLE_SET": committed.evaluate(oracle_set),
+    }
+    payloads = {name: _profile_payload(profile) for name, profile in profiles.items()}
+    for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        _verify_reference_profile(payloads[name], expected_committed[name], arm=name)
+
+    before_counts = occupancies(base.mapping)
+    after_counts = occupancies(floor.mapping)
+    initial_underfull = floor_result.initially_underfull
+    consolidated = sum(after_counts.get(beam, 0) >= MIN_OCCUPANCY for beam in initial_underfull)
+    emptied = sum(after_counts.get(beam, 0) == 0 for beam in initial_underfull)
+    if consolidated + emptied != len(initial_underfull):
+        raise RuntimeError("initial underfull beam was neither consolidated nor emptied")
+    return {
+        "anchor_id": reference["anchor_id"],
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "policy": {
+            "minimum_occupancy": MIN_OCCUPANCY,
+            "starting_assignment": "BASELINE",
+            "service_guard": service_guard,
+            "initial_underfull_beams": len(initial_underfull),
+            "consolidated_beams": consolidated,
+            "emptied_beams": emptied,
+            "changed_users": floor.changed_users,
+            "before_active_beams": len(before_counts),
+            "after_active_beams": len(after_counts),
+            "before_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(base.mapping).items()
+            },
+            "after_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(floor.mapping).items()
+            },
+            "selected_repairs": [
+                {
+                    "beam": list(row.plan.beam),
+                    "action": row.plan.action,
+                    "moved_users": list(row.plan.moved_users),
+                    "decision_served_count": row.served_count,
+                    "objective_bits": float(row.objective),
+                    "configuration_id": row.configuration_id,
+                }
+                for row in floor_result.decisions
+            ],
+            "exact_branch_configurations_evaluated": selection.physical_evaluations - 1,
+            "decision_wall_seconds": decision_seconds,
+            "exact_scoring_wall_seconds": scoring_seconds,
+            "rule_overhead_wall_seconds": max(0.0, decision_seconds - scoring_seconds),
+        },
+        "committed": payloads,
+    }
+
+
+def _percentile(values: Sequence[float], q: float) -> float:
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * q
+    low = math.floor(index)
+    high = math.ceil(index)
+    if low == high:
+        return ordered[low]
+    return ordered[low] * (high - index) + ordered[high] * (index - low)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    arms = ("BASELINE", "UNILATERAL", "FLOOR", "ORACLE_SET")
+    pooled = {}
+    for arm in arms:
+        bits = math.fsum(float(row["committed"][arm]["bits"]) for row in anchors)
+        joules = math.fsum(float(row["committed"][arm]["joules"]) for row in anchors)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ratio(bits, joules),
+            "served_count_sum": sum(
+                int(row["committed"][arm]["served_count"]) for row in anchors
+            ),
+        }
+    numerator = pooled["FLOOR"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    denominator = pooled["ORACLE_SET"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    if denominator <= 0.0:
+        raise RuntimeError("oracle reference has no positive headroom")
+    timing = [float(row["policy"]["decision_wall_seconds"]) for row in anchors]
+    overhead = [float(row["policy"]["rule_overhead_wall_seconds"]) for row in anchors]
+    before_hist = Counter()
+    after_hist = Counter()
+    for row in anchors:
+        before_hist.update({int(k): int(v) for k, v in row["policy"]["before_occupancy_histogram"].items()})
+        after_hist.update({int(k): int(v) for k, v in row["policy"]["after_occupancy_histogram"].items()})
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({row["world_domain"] for row in anchors}),
+        "pooled": pooled,
+        "captured_fraction_of_oracle_gain_over_unilateral": numerator / denominator,
+        "floor_over_unilateral_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_over_baseline_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        ),
+        "oracle_set_over_unilateral_relative": relative_gain(
+            pooled["ORACLE_SET"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_decision_wall_seconds": {
+            "mean": statistics.fmean(timing),
+            "p50": _percentile(timing, 0.50),
+            "p95": _percentile(timing, 0.95),
+            "max": max(timing),
+            "sum": math.fsum(timing),
+        },
+        "floor_rule_overhead_wall_seconds": {
+            "mean": statistics.fmean(overhead),
+            "p50": _percentile(overhead, 0.50),
+            "p95": _percentile(overhead, 0.95),
+            "max": max(overhead),
+        },
+        "initial_underfull_beams": sum(
+            int(row["policy"]["initial_underfull_beams"]) for row in anchors
+        ),
+        "consolidated_beams": sum(int(row["policy"]["consolidated_beams"]) for row in anchors),
+        "emptied_beams": sum(int(row["policy"]["emptied_beams"]) for row in anchors),
+        "changed_users": sum(int(row["policy"]["changed_users"]) for row in anchors),
+        "before_occupancy_histogram": {str(k): v for k, v in sorted(before_hist.items())},
+        "after_occupancy_histogram": {str(k): v for k, v in sorted(after_hist.items())},
+        "floor_worse_than_unilateral_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        ],
+        "floor_worse_than_baseline_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["BASELINE"]["ee_bit_per_j"]
+        ],
+    }
+
+
+def run(*, worlds: int, anchors_per_world: int, reference_path: Path) -> dict[str, object]:
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested run exceeds the fixed 4-world x 5-anchor panel")
+    reference = load_reference(reference_path)
+    by_anchor = {row["anchor_id"]: row for row in reference["anchors"]}
+    started = time.perf_counter()
+    anchors = []
+    world_rows = []
+    for world_index in range(1, worlds + 1):
+        domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=ANCHORS_PER_WORLD,
+            start_time_s=0.0,
+        )
+        world_rows.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "tle_date": tape.tle_date,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        for step_index in range(anchors_per_world):
+            anchor_id = f"{domain}:step/{step_index}"
+            row = evaluate_anchor(tape=tape, reference=by_anchor[anchor_id])
+            anchors.append(row)
+            print(
+                json.dumps(
+                    {
+                        "anchor": anchor_id,
+                        "floor_ee": row["committed"]["FLOOR"]["ee_bit_per_j"],
+                        "served": row["committed"]["FLOOR"]["served_count"],
+                        "underfull": row["policy"]["initial_underfull_beams"],
+                        "consolidated": row["policy"]["consolidated_beams"],
+                        "emptied": row["policy"]["emptied_beams"],
+                        "decision_ms": 1000.0 * row["policy"]["decision_wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    result = {
+        "schema": "mcrl-v025-occupancy-floor-diagnostic-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "engine_commit": "75c5c78c",
+        "engine_tree": ENGINE_TREE,
+        "workspace_commit_before_diagnostic": _git("rev-parse", "HEAD"),
+        "probe_source_sha256": _sha256(PROBE_PATH),
+        "oracle_reference_path": str(reference_path),
+        "oracle_reference_file_sha256": REFERENCE_SHA256,
+        "oracle_reference_receipt_sha256": REFERENCE_RECEIPT_SHA256,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "process_limit": 3,
+        "processes_used": 1,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "thresholds_tried": [MIN_OCCUPANCY],
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "eta_ref": [ETA_REF.numerator, ETA_REF.denominator],
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "every intermediate branch selected from served count >= BASELINE at boundary 0",
+        "policy_rule": (
+            "Starting from BASELINE, visit the initially active occupancy-1/2 beams once in ascending identity order. "
+            "Prescribe consolidation by importing the nearest-slant legal occupants of other currently underfull beams until occupancy 3, and evacuation by moving every occupant to its nearest-slant legal currently occupancy>=3 beam (NULL only if none). "
+            "Choose the service-safe branch with greater exact F; ties use served count, consolidate before empty, then configuration id. Commit each repair immediately."
+        ),
+        "worlds": world_rows,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    result["receipt_sha256"] = _canonical_sha256(result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--reference", type=Path, default=REFERENCE_PATH)
+    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
+    args = parser.parse_args()
+    result = run(
+        worlds=args.worlds,
+        anchors_per_world=args.anchors_per_world,
+        reference_path=args.reference,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/occupancy_floor.py b/src/mcrl/physics_v025/occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
diff --git a/tests/physics_v025/test_occupancy_floor.py b/tests/physics_v025/test_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

diff --git a/.scratch/occupancy-floor/run_occupancy_floor.py b/.scratch/occupancy-floor/run_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f1834ff29715024ab9fe74ea6299433671b9b42
--- /dev/null
+++ b/.scratch/occupancy-floor/run_occupancy_floor.py
@@ -0,0 +1,511 @@
+#!/usr/bin/env python3
+"""Measure the one-pass occupancy-three floor on the oracle-ceiling panel."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+PROBE_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+REFERENCE_PATH = Path(
+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+
+from mcrl.physics_v025.occupancy_floor import (  # noqa: E402
+    MIN_OCCUPANCY,
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancies,
+    occupancy_histogram,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+    ).strip()
+
+
+def _canonical_sha256(payload: object) -> str:
+    raw = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_reference(path: Path) -> dict[str, object]:
+    if _sha256(path) != REFERENCE_SHA256:
+        raise RuntimeError("oracle-ceiling reference file digest drifted")
+    payload = json.loads(path.read_text(encoding="ascii"))
+    declared = payload.pop("receipt_sha256", None)
+    if declared != REFERENCE_RECEIPT_SHA256 or _canonical_sha256(payload) != declared:
+        raise RuntimeError("oracle-ceiling embedded receipt digest is invalid")
+    payload["receipt_sha256"] = declared
+    if payload.get("schema") != "mcrl-v025-perfect-knowledge-oracle-ceiling-v1":
+        raise RuntimeError("wrong oracle-ceiling schema")
+    if payload.get("claim_ceiling") != CLAIM_CEILING:
+        raise RuntimeError("oracle-ceiling claim ceiling drifted")
+    if payload.get("source_tree") != ENGINE_TREE:
+        raise RuntimeError("oracle-ceiling engine tree drifted")
+    if len(payload.get("anchors", ())) != WORLD_COUNT * ANCHORS_PER_WORLD:
+        raise RuntimeError("oracle-ceiling anchor panel drifted")
+    return payload
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative_gain(numerator: float, denominator: float) -> float:
+    if denominator == 0.0:
+        raise RuntimeError("zero reference EE")
+    return numerator / denominator - 1.0
+
+
+def parse_configuration(base, encoded: str, *, kind: str):
+    if not encoded.startswith("CFG:"):
+        raise RuntimeError(f"cannot parse non-derived configuration {encoded!r}")
+    mapping = {}
+    for item in encoded[4:].split(";"):
+        fields = item.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            mapping[user] = None
+        else:
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    config = probe._configuration(base, mapping, kind=kind)
+    if config.configuration_id != encoded:
+        raise RuntimeError("configuration reconstruction changed its identity")
+    return config
+
+
+def slant_lookup(tape, step_index: int) -> dict[tuple[int, tuple[int, int]], float]:
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        boundary = step.boundary_at(0)
+        return {
+            (row.user_id, row.identity): float(row.slant_km)
+            for row in boundary.candidates
+            if row.legal
+        }
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        if actual[field] != expected[field]:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    base_selection = selection.evaluate(base)
+    service_guard = served(base_selection)
+    scoring_seconds = 0.0
+    decision_started = time.perf_counter()
+    legal_options, _ = probe._legal_options(tape, step_index)
+    slants = slant_lookup(tape, step_index)
+
+    def exact_score(plan):
+        nonlocal scoring_seconds
+        config = probe._configuration(base, plan.mapping, kind=f"floor-{plan.action}")
+        started = time.perf_counter()
+        profile = selection.evaluate(config)
+        scoring_seconds += time.perf_counter() - started
+        if config.configuration_id in selection._invalid:
+            return None
+        return ScoredRepair(
+            plan=plan,
+            objective=objective(profile),
+            served_count=served(profile),
+            configuration_id=config.configuration_id,
+        )
+
+    floor_result = apply_occupancy_floor(
+        base.mapping,
+        legal_options=legal_options,
+        slant_km=slants,
+        exact_score=exact_score,
+        minimum_served=service_guard,
+    )
+    decision_seconds = time.perf_counter() - decision_started
+    floor = probe._configuration(base, floor_result.mapping, kind="occupancy-floor")
+    expected_committed = reference["committed"]
+    unilateral = parse_configuration(
+        base,
+        str(expected_committed["UNILATERAL"]["configuration_id"]),
+        kind="unilateral-reference",
+    )
+    oracle_set = parse_configuration(
+        base,
+        str(expected_committed["ORACLE_SET"]["configuration_id"]),
+        kind="oracle-set-reference",
+    )
+    committed = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    configs = (base, unilateral, floor, oracle_set)
+    committed.evaluate_many(configs)
+    profiles = {
+        "BASELINE": committed.evaluate(base),
+        "UNILATERAL": committed.evaluate(unilateral),
+        "FLOOR": committed.evaluate(floor),
+        "ORACLE_SET": committed.evaluate(oracle_set),
+    }
+    payloads = {name: _profile_payload(profile) for name, profile in profiles.items()}
+    for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        _verify_reference_profile(payloads[name], expected_committed[name], arm=name)
+
+    before_counts = occupancies(base.mapping)
+    after_counts = occupancies(floor.mapping)
+    initial_underfull = floor_result.initially_underfull
+    consolidated = sum(after_counts.get(beam, 0) >= MIN_OCCUPANCY for beam in initial_underfull)
+    emptied = sum(after_counts.get(beam, 0) == 0 for beam in initial_underfull)
+    if consolidated + emptied != len(initial_underfull):
+        raise RuntimeError("initial underfull beam was neither consolidated nor emptied")
+    return {
+        "anchor_id": reference["anchor_id"],
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "policy": {
+            "minimum_occupancy": MIN_OCCUPANCY,
+            "starting_assignment": "BASELINE",
+            "service_guard": service_guard,
+            "initial_underfull_beams": len(initial_underfull),
+            "consolidated_beams": consolidated,
+            "emptied_beams": emptied,
+            "changed_users": floor.changed_users,
+            "before_active_beams": len(before_counts),
+            "after_active_beams": len(after_counts),
+            "before_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(base.mapping).items()
+            },
+            "after_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(floor.mapping).items()
+            },
+            "selected_repairs": [
+                {
+                    "beam": list(row.plan.beam),
+                    "action": row.plan.action,
+                    "moved_users": list(row.plan.moved_users),
+                    "decision_served_count": row.served_count,
+                    "objective_bits": float(row.objective),
+                    "configuration_id": row.configuration_id,
+                }
+                for row in floor_result.decisions
+            ],
+            "exact_branch_configurations_evaluated": selection.physical_evaluations - 1,
+            "decision_wall_seconds": decision_seconds,
+            "exact_scoring_wall_seconds": scoring_seconds,
+            "rule_overhead_wall_seconds": max(0.0, decision_seconds - scoring_seconds),
+        },
+        "committed": payloads,
+    }
+
+
+def _percentile(values: Sequence[float], q: float) -> float:
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * q
+    low = math.floor(index)
+    high = math.ceil(index)
+    if low == high:
+        return ordered[low]
+    return ordered[low] * (high - index) + ordered[high] * (index - low)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    arms = ("BASELINE", "UNILATERAL", "FLOOR", "ORACLE_SET")
+    pooled = {}
+    for arm in arms:
+        bits = math.fsum(float(row["committed"][arm]["bits"]) for row in anchors)
+        joules = math.fsum(float(row["committed"][arm]["joules"]) for row in anchors)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ratio(bits, joules),
+            "served_count_sum": sum(
+                int(row["committed"][arm]["served_count"]) for row in anchors
+            ),
+        }
+    numerator = pooled["FLOOR"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    denominator = pooled["ORACLE_SET"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    if denominator <= 0.0:
+        raise RuntimeError("oracle reference has no positive headroom")
+    timing = [float(row["policy"]["decision_wall_seconds"]) for row in anchors]
+    overhead = [float(row["policy"]["rule_overhead_wall_seconds"]) for row in anchors]
+    before_hist = Counter()
+    after_hist = Counter()
+    for row in anchors:
+        before_hist.update({int(k): int(v) for k, v in row["policy"]["before_occupancy_histogram"].items()})
+        after_hist.update({int(k): int(v) for k, v in row["policy"]["after_occupancy_histogram"].items()})
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({row["world_domain"] for row in anchors}),
+        "pooled": pooled,
+        "captured_fraction_of_oracle_gain_over_unilateral": numerator / denominator,
+        "floor_over_unilateral_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_over_baseline_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        ),
+        "oracle_set_over_unilateral_relative": relative_gain(
+            pooled["ORACLE_SET"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_decision_wall_seconds": {
+            "mean": statistics.fmean(timing),
+            "p50": _percentile(timing, 0.50),
+            "p95": _percentile(timing, 0.95),
+            "max": max(timing),
+            "sum": math.fsum(timing),
+        },
+        "floor_rule_overhead_wall_seconds": {
+            "mean": statistics.fmean(overhead),
+            "p50": _percentile(overhead, 0.50),
+            "p95": _percentile(overhead, 0.95),
+            "max": max(overhead),
+        },
+        "initial_underfull_beams": sum(
+            int(row["policy"]["initial_underfull_beams"]) for row in anchors
+        ),
+        "consolidated_beams": sum(int(row["policy"]["consolidated_beams"]) for row in anchors),
+        "emptied_beams": sum(int(row["policy"]["emptied_beams"]) for row in anchors),
+        "changed_users": sum(int(row["policy"]["changed_users"]) for row in anchors),
+        "before_occupancy_histogram": {str(k): v for k, v in sorted(before_hist.items())},
+        "after_occupancy_histogram": {str(k): v for k, v in sorted(after_hist.items())},
+        "floor_worse_than_unilateral_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        ],
+        "floor_worse_than_baseline_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["BASELINE"]["ee_bit_per_j"]
+        ],
+    }
+
+
+def run(*, worlds: int, anchors_per_world: int, reference_path: Path) -> dict[str, object]:
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested run exceeds the fixed 4-world x 5-anchor panel")
+    reference = load_reference(reference_path)
+    by_anchor = {row["anchor_id"]: row for row in reference["anchors"]}
+    started = time.perf_counter()
+    anchors = []
+    world_rows = []
+    for world_index in range(1, worlds + 1):
+        domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=ANCHORS_PER_WORLD,
+            start_time_s=0.0,
+        )
+        world_rows.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "tle_date": tape.tle_date,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        for step_index in range(anchors_per_world):
+            anchor_id = f"{domain}:step/{step_index}"
+            row = evaluate_anchor(tape=tape, reference=by_anchor[anchor_id])
+            anchors.append(row)
+            print(
+                json.dumps(
+                    {
+                        "anchor": anchor_id,
+                        "floor_ee": row["committed"]["FLOOR"]["ee_bit_per_j"],
+                        "served": row["committed"]["FLOOR"]["served_count"],
+                        "underfull": row["policy"]["initial_underfull_beams"],
+                        "consolidated": row["policy"]["consolidated_beams"],
+                        "emptied": row["policy"]["emptied_beams"],
+                        "decision_ms": 1000.0 * row["policy"]["decision_wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    result = {
+        "schema": "mcrl-v025-occupancy-floor-diagnostic-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "engine_commit": "75c5c78c",
+        "engine_tree": ENGINE_TREE,
+        "workspace_commit_before_diagnostic": _git("rev-parse", "HEAD"),
+        "probe_source_sha256": _sha256(PROBE_PATH),
+        "oracle_reference_path": str(reference_path),
+        "oracle_reference_file_sha256": REFERENCE_SHA256,
+        "oracle_reference_receipt_sha256": REFERENCE_RECEIPT_SHA256,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "process_limit": 3,
+        "processes_used": 1,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "thresholds_tried": [MIN_OCCUPANCY],
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "eta_ref": [ETA_REF.numerator, ETA_REF.denominator],
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "every intermediate branch selected from served count >= BASELINE at boundary 0",
+        "policy_rule": (
+            "Starting from BASELINE, visit the initially active occupancy-1/2 beams once in ascending identity order. "
+            "Prescribe consolidation by importing the nearest-slant legal occupants of other currently underfull beams until occupancy 3, and evacuation by moving every occupant to its nearest-slant legal currently occupancy>=3 beam (NULL only if none). "
+            "Choose the service-safe branch with greater exact F; ties use served count, consolidate before empty, then configuration id. Commit each repair immediately."
+        ),
+        "worlds": world_rows,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    result["receipt_sha256"] = _canonical_sha256(result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--reference", type=Path, default=REFERENCE_PATH)
+    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
+    args = parser.parse_args()
+    result = run(
+        worlds=args.worlds,
+        anchors_per_world=args.anchors_per_world,
+        reference_path=args.reference,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/occupancy_floor.py b/src/mcrl/physics_v025/occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
diff --git a/tests/physics_v025/test_occupancy_floor.py b/tests/physics_v025/test_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

diff --git a/.scratch/occupancy-floor/run_occupancy_floor.py b/.scratch/occupancy-floor/run_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f1834ff29715024ab9fe74ea6299433671b9b42
--- /dev/null
+++ b/.scratch/occupancy-floor/run_occupancy_floor.py
@@ -0,0 +1,511 @@
+#!/usr/bin/env python3
+"""Measure the one-pass occupancy-three floor on the oracle-ceiling panel."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+PROBE_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+REFERENCE_PATH = Path(
+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+
+from mcrl.physics_v025.occupancy_floor import (  # noqa: E402
+    MIN_OCCUPANCY,
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancies,
+    occupancy_histogram,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+    ).strip()
+
+
+def _canonical_sha256(payload: object) -> str:
+    raw = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_reference(path: Path) -> dict[str, object]:
+    if _sha256(path) != REFERENCE_SHA256:
+        raise RuntimeError("oracle-ceiling reference file digest drifted")
+    payload = json.loads(path.read_text(encoding="ascii"))
+    declared = payload.pop("receipt_sha256", None)
+    if declared != REFERENCE_RECEIPT_SHA256 or _canonical_sha256(payload) != declared:
+        raise RuntimeError("oracle-ceiling embedded receipt digest is invalid")
+    payload["receipt_sha256"] = declared
+    if payload.get("schema") != "mcrl-v025-perfect-knowledge-oracle-ceiling-v1":
+        raise RuntimeError("wrong oracle-ceiling schema")
+    if payload.get("claim_ceiling") != CLAIM_CEILING:
+        raise RuntimeError("oracle-ceiling claim ceiling drifted")
+    if payload.get("source_tree") != ENGINE_TREE:
+        raise RuntimeError("oracle-ceiling engine tree drifted")
+    if len(payload.get("anchors", ())) != WORLD_COUNT * ANCHORS_PER_WORLD:
+        raise RuntimeError("oracle-ceiling anchor panel drifted")
+    return payload
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative_gain(numerator: float, denominator: float) -> float:
+    if denominator == 0.0:
+        raise RuntimeError("zero reference EE")
+    return numerator / denominator - 1.0
+
+
+def parse_configuration(base, encoded: str, *, kind: str):
+    if not encoded.startswith("CFG:"):
+        raise RuntimeError(f"cannot parse non-derived configuration {encoded!r}")
+    mapping = {}
+    for item in encoded[4:].split(";"):
+        fields = item.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            mapping[user] = None
+        else:
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    config = probe._configuration(base, mapping, kind=kind)
+    if config.configuration_id != encoded:
+        raise RuntimeError("configuration reconstruction changed its identity")
+    return config
+
+
+def slant_lookup(tape, step_index: int) -> dict[tuple[int, tuple[int, int]], float]:
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        boundary = step.boundary_at(0)
+        return {
+            (row.user_id, row.identity): float(row.slant_km)
+            for row in boundary.candidates
+            if row.legal
+        }
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        if actual[field] != expected[field]:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    base_selection = selection.evaluate(base)
+    service_guard = served(base_selection)
+    scoring_seconds = 0.0
+    decision_started = time.perf_counter()
+    legal_options, _ = probe._legal_options(tape, step_index)
+    slants = slant_lookup(tape, step_index)
+
+    def exact_score(plan):
+        nonlocal scoring_seconds
+        config = probe._configuration(base, plan.mapping, kind=f"floor-{plan.action}")
+        started = time.perf_counter()
+        profile = selection.evaluate(config)
+        scoring_seconds += time.perf_counter() - started
+        if config.configuration_id in selection._invalid:
+            return None
+        return ScoredRepair(
+            plan=plan,
+            objective=objective(profile),
+            served_count=served(profile),
+            configuration_id=config.configuration_id,
+        )
+
+    floor_result = apply_occupancy_floor(
+        base.mapping,
+        legal_options=legal_options,
+        slant_km=slants,
+        exact_score=exact_score,
+        minimum_served=service_guard,
+    )
+    decision_seconds = time.perf_counter() - decision_started
+    floor = probe._configuration(base, floor_result.mapping, kind="occupancy-floor")
+    expected_committed = reference["committed"]
+    unilateral = parse_configuration(
+        base,
+        str(expected_committed["UNILATERAL"]["configuration_id"]),
+        kind="unilateral-reference",
+    )
+    oracle_set = parse_configuration(
+        base,
+        str(expected_committed["ORACLE_SET"]["configuration_id"]),
+        kind="oracle-set-reference",
+    )
+    committed = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    configs = (base, unilateral, floor, oracle_set)
+    committed.evaluate_many(configs)
+    profiles = {
+        "BASELINE": committed.evaluate(base),
+        "UNILATERAL": committed.evaluate(unilateral),
+        "FLOOR": committed.evaluate(floor),
+        "ORACLE_SET": committed.evaluate(oracle_set),
+    }
+    payloads = {name: _profile_payload(profile) for name, profile in profiles.items()}
+    for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        _verify_reference_profile(payloads[name], expected_committed[name], arm=name)
+
+    before_counts = occupancies(base.mapping)
+    after_counts = occupancies(floor.mapping)
+    initial_underfull = floor_result.initially_underfull
+    consolidated = sum(after_counts.get(beam, 0) >= MIN_OCCUPANCY for beam in initial_underfull)
+    emptied = sum(after_counts.get(beam, 0) == 0 for beam in initial_underfull)
+    if consolidated + emptied != len(initial_underfull):
+        raise RuntimeError("initial underfull beam was neither consolidated nor emptied")
+    return {
+        "anchor_id": reference["anchor_id"],
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "policy": {
+            "minimum_occupancy": MIN_OCCUPANCY,
+            "starting_assignment": "BASELINE",
+            "service_guard": service_guard,
+            "initial_underfull_beams": len(initial_underfull),
+            "consolidated_beams": consolidated,
+            "emptied_beams": emptied,
+            "changed_users": floor.changed_users,
+            "before_active_beams": len(before_counts),
+            "after_active_beams": len(after_counts),
+            "before_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(base.mapping).items()
+            },
+            "after_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(floor.mapping).items()
+            },
+            "selected_repairs": [
+                {
+                    "beam": list(row.plan.beam),
+                    "action": row.plan.action,
+                    "moved_users": list(row.plan.moved_users),
+                    "decision_served_count": row.served_count,
+                    "objective_bits": float(row.objective),
+                    "configuration_id": row.configuration_id,
+                }
+                for row in floor_result.decisions
+            ],
+            "exact_branch_configurations_evaluated": selection.physical_evaluations - 1,
+            "decision_wall_seconds": decision_seconds,
+            "exact_scoring_wall_seconds": scoring_seconds,
+            "rule_overhead_wall_seconds": max(0.0, decision_seconds - scoring_seconds),
+        },
+        "committed": payloads,
+    }
+
+
+def _percentile(values: Sequence[float], q: float) -> float:
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * q
+    low = math.floor(index)
+    high = math.ceil(index)
+    if low == high:
+        return ordered[low]
+    return ordered[low] * (high - index) + ordered[high] * (index - low)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    arms = ("BASELINE", "UNILATERAL", "FLOOR", "ORACLE_SET")
+    pooled = {}
+    for arm in arms:
+        bits = math.fsum(float(row["committed"][arm]["bits"]) for row in anchors)
+        joules = math.fsum(float(row["committed"][arm]["joules"]) for row in anchors)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ratio(bits, joules),
+            "served_count_sum": sum(
+                int(row["committed"][arm]["served_count"]) for row in anchors
+            ),
+        }
+    numerator = pooled["FLOOR"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    denominator = pooled["ORACLE_SET"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    if denominator <= 0.0:
+        raise RuntimeError("oracle reference has no positive headroom")
+    timing = [float(row["policy"]["decision_wall_seconds"]) for row in anchors]
+    overhead = [float(row["policy"]["rule_overhead_wall_seconds"]) for row in anchors]
+    before_hist = Counter()
+    after_hist = Counter()
+    for row in anchors:
+        before_hist.update({int(k): int(v) for k, v in row["policy"]["before_occupancy_histogram"].items()})
+        after_hist.update({int(k): int(v) for k, v in row["policy"]["after_occupancy_histogram"].items()})
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({row["world_domain"] for row in anchors}),
+        "pooled": pooled,
+        "captured_fraction_of_oracle_gain_over_unilateral": numerator / denominator,
+        "floor_over_unilateral_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_over_baseline_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        ),
+        "oracle_set_over_unilateral_relative": relative_gain(
+            pooled["ORACLE_SET"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_decision_wall_seconds": {
+            "mean": statistics.fmean(timing),
+            "p50": _percentile(timing, 0.50),
+            "p95": _percentile(timing, 0.95),
+            "max": max(timing),
+            "sum": math.fsum(timing),
+        },
+        "floor_rule_overhead_wall_seconds": {
+            "mean": statistics.fmean(overhead),
+            "p50": _percentile(overhead, 0.50),
+            "p95": _percentile(overhead, 0.95),
+            "max": max(overhead),
+        },
+        "initial_underfull_beams": sum(
+            int(row["policy"]["initial_underfull_beams"]) for row in anchors
+        ),
+        "consolidated_beams": sum(int(row["policy"]["consolidated_beams"]) for row in anchors),
+        "emptied_beams": sum(int(row["policy"]["emptied_beams"]) for row in anchors),
+        "changed_users": sum(int(row["policy"]["changed_users"]) for row in anchors),
+        "before_occupancy_histogram": {str(k): v for k, v in sorted(before_hist.items())},
+        "after_occupancy_histogram": {str(k): v for k, v in sorted(after_hist.items())},
+        "floor_worse_than_unilateral_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        ],
+        "floor_worse_than_baseline_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["BASELINE"]["ee_bit_per_j"]
+        ],
+    }
+
+
+def run(*, worlds: int, anchors_per_world: int, reference_path: Path) -> dict[str, object]:
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested run exceeds the fixed 4-world x 5-anchor panel")
+    reference = load_reference(reference_path)
+    by_anchor = {row["anchor_id"]: row for row in reference["anchors"]}
+    started = time.perf_counter()
+    anchors = []
+    world_rows = []
+    for world_index in range(1, worlds + 1):
+        domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=ANCHORS_PER_WORLD,
+            start_time_s=0.0,
+        )
+        world_rows.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "tle_date": tape.tle_date,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        for step_index in range(anchors_per_world):
+            anchor_id = f"{domain}:step/{step_index}"
+            row = evaluate_anchor(tape=tape, reference=by_anchor[anchor_id])
+            anchors.append(row)
+            print(
+                json.dumps(
+                    {
+                        "anchor": anchor_id,
+                        "floor_ee": row["committed"]["FLOOR"]["ee_bit_per_j"],
+                        "served": row["committed"]["FLOOR"]["served_count"],
+                        "underfull": row["policy"]["initial_underfull_beams"],
+                        "consolidated": row["policy"]["consolidated_beams"],
+                        "emptied": row["policy"]["emptied_beams"],
+                        "decision_ms": 1000.0 * row["policy"]["decision_wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    result = {
+        "schema": "mcrl-v025-occupancy-floor-diagnostic-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "engine_commit": "75c5c78c",
+        "engine_tree": ENGINE_TREE,
+        "workspace_commit_before_diagnostic": _git("rev-parse", "HEAD"),
+        "probe_source_sha256": _sha256(PROBE_PATH),
+        "oracle_reference_path": str(reference_path),
+        "oracle_reference_file_sha256": REFERENCE_SHA256,
+        "oracle_reference_receipt_sha256": REFERENCE_RECEIPT_SHA256,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "process_limit": 3,
+        "processes_used": 1,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "thresholds_tried": [MIN_OCCUPANCY],
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "eta_ref": [ETA_REF.numerator, ETA_REF.denominator],
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "every intermediate branch selected from served count >= BASELINE at boundary 0",
+        "policy_rule": (
+            "Starting from BASELINE, visit the initially active occupancy-1/2 beams once in ascending identity order. "
+            "Prescribe consolidation by importing the nearest-slant legal occupants of other currently underfull beams until occupancy 3, and evacuation by moving every occupant to its nearest-slant legal currently occupancy>=3 beam (NULL only if none). "
+            "Choose the service-safe branch with greater exact F; ties use served count, consolidate before empty, then configuration id. Commit each repair immediately."
+        ),
+        "worlds": world_rows,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    result["receipt_sha256"] = _canonical_sha256(result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--reference", type=Path, default=REFERENCE_PATH)
+    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
+    args = parser.parse_args()
+    result = run(
+        worlds=args.worlds,
+        anchors_per_world=args.anchors_per_world,
+        reference_path=args.reference,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/occupancy_floor.py b/src/mcrl/physics_v025/occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
diff --git a/tests/physics_v025/test_occupancy_floor.py b/tests/physics_v025/test_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

diff --git a/.scratch/occupancy-floor/run_occupancy_floor.py b/.scratch/occupancy-floor/run_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f1834ff29715024ab9fe74ea6299433671b9b42
--- /dev/null
+++ b/.scratch/occupancy-floor/run_occupancy_floor.py
@@ -0,0 +1,511 @@
+#!/usr/bin/env python3
+"""Measure the one-pass occupancy-three floor on the oracle-ceiling panel."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+PROBE_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+REFERENCE_PATH = Path(
+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+
+from mcrl.physics_v025.occupancy_floor import (  # noqa: E402
+    MIN_OCCUPANCY,
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancies,
+    occupancy_histogram,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+    ).strip()
+
+
+def _canonical_sha256(payload: object) -> str:
+    raw = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_reference(path: Path) -> dict[str, object]:
+    if _sha256(path) != REFERENCE_SHA256:
+        raise RuntimeError("oracle-ceiling reference file digest drifted")
+    payload = json.loads(path.read_text(encoding="ascii"))
+    declared = payload.pop("receipt_sha256", None)
+    if declared != REFERENCE_RECEIPT_SHA256 or _canonical_sha256(payload) != declared:
+        raise RuntimeError("oracle-ceiling embedded receipt digest is invalid")
+    payload["receipt_sha256"] = declared
+    if payload.get("schema") != "mcrl-v025-perfect-knowledge-oracle-ceiling-v1":
+        raise RuntimeError("wrong oracle-ceiling schema")
+    if payload.get("claim_ceiling") != CLAIM_CEILING:
+        raise RuntimeError("oracle-ceiling claim ceiling drifted")
+    if payload.get("source_tree") != ENGINE_TREE:
+        raise RuntimeError("oracle-ceiling engine tree drifted")
+    if len(payload.get("anchors", ())) != WORLD_COUNT * ANCHORS_PER_WORLD:
+        raise RuntimeError("oracle-ceiling anchor panel drifted")
+    return payload
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative_gain(numerator: float, denominator: float) -> float:
+    if denominator == 0.0:
+        raise RuntimeError("zero reference EE")
+    return numerator / denominator - 1.0
+
+
+def parse_configuration(base, encoded: str, *, kind: str):
+    if not encoded.startswith("CFG:"):
+        raise RuntimeError(f"cannot parse non-derived configuration {encoded!r}")
+    mapping = {}
+    for item in encoded[4:].split(";"):
+        fields = item.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            mapping[user] = None
+        else:
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    config = probe._configuration(base, mapping, kind=kind)
+    if config.configuration_id != encoded:
+        raise RuntimeError("configuration reconstruction changed its identity")
+    return config
+
+
+def slant_lookup(tape, step_index: int) -> dict[tuple[int, tuple[int, int]], float]:
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        boundary = step.boundary_at(0)
+        return {
+            (row.user_id, row.identity): float(row.slant_km)
+            for row in boundary.candidates
+            if row.legal
+        }
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        if actual[field] != expected[field]:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    base_selection = selection.evaluate(base)
+    service_guard = served(base_selection)
+    scoring_seconds = 0.0
+    decision_started = time.perf_counter()
+    legal_options, _ = probe._legal_options(tape, step_index)
+    slants = slant_lookup(tape, step_index)
+
+    def exact_score(plan):
+        nonlocal scoring_seconds
+        config = probe._configuration(base, plan.mapping, kind=f"floor-{plan.action}")
+        started = time.perf_counter()
+        profile = selection.evaluate(config)
+        scoring_seconds += time.perf_counter() - started
+        if config.configuration_id in selection._invalid:
+            return None
+        return ScoredRepair(
+            plan=plan,
+            objective=objective(profile),
+            served_count=served(profile),
+            configuration_id=config.configuration_id,
+        )
+
+    floor_result = apply_occupancy_floor(
+        base.mapping,
+        legal_options=legal_options,
+        slant_km=slants,
+        exact_score=exact_score,
+        minimum_served=service_guard,
+    )
+    decision_seconds = time.perf_counter() - decision_started
+    floor = probe._configuration(base, floor_result.mapping, kind="occupancy-floor")
+    expected_committed = reference["committed"]
+    unilateral = parse_configuration(
+        base,
+        str(expected_committed["UNILATERAL"]["configuration_id"]),
+        kind="unilateral-reference",
+    )
+    oracle_set = parse_configuration(
+        base,
+        str(expected_committed["ORACLE_SET"]["configuration_id"]),
+        kind="oracle-set-reference",
+    )
+    committed = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    configs = (base, unilateral, floor, oracle_set)
+    committed.evaluate_many(configs)
+    profiles = {
+        "BASELINE": committed.evaluate(base),
+        "UNILATERAL": committed.evaluate(unilateral),
+        "FLOOR": committed.evaluate(floor),
+        "ORACLE_SET": committed.evaluate(oracle_set),
+    }
+    payloads = {name: _profile_payload(profile) for name, profile in profiles.items()}
+    for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        _verify_reference_profile(payloads[name], expected_committed[name], arm=name)
+
+    before_counts = occupancies(base.mapping)
+    after_counts = occupancies(floor.mapping)
+    initial_underfull = floor_result.initially_underfull
+    consolidated = sum(after_counts.get(beam, 0) >= MIN_OCCUPANCY for beam in initial_underfull)
+    emptied = sum(after_counts.get(beam, 0) == 0 for beam in initial_underfull)
+    if consolidated + emptied != len(initial_underfull):
+        raise RuntimeError("initial underfull beam was neither consolidated nor emptied")
+    return {
+        "anchor_id": reference["anchor_id"],
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "policy": {
+            "minimum_occupancy": MIN_OCCUPANCY,
+            "starting_assignment": "BASELINE",
+            "service_guard": service_guard,
+            "initial_underfull_beams": len(initial_underfull),
+            "consolidated_beams": consolidated,
+            "emptied_beams": emptied,
+            "changed_users": floor.changed_users,
+            "before_active_beams": len(before_counts),
+            "after_active_beams": len(after_counts),
+            "before_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(base.mapping).items()
+            },
+            "after_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(floor.mapping).items()
+            },
+            "selected_repairs": [
+                {
+                    "beam": list(row.plan.beam),
+                    "action": row.plan.action,
+                    "moved_users": list(row.plan.moved_users),
+                    "decision_served_count": row.served_count,
+                    "objective_bits": float(row.objective),
+                    "configuration_id": row.configuration_id,
+                }
+                for row in floor_result.decisions
+            ],
+            "exact_branch_configurations_evaluated": selection.physical_evaluations - 1,
+            "decision_wall_seconds": decision_seconds,
+            "exact_scoring_wall_seconds": scoring_seconds,
+            "rule_overhead_wall_seconds": max(0.0, decision_seconds - scoring_seconds),
+        },
+        "committed": payloads,
+    }
+
+
+def _percentile(values: Sequence[float], q: float) -> float:
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * q
+    low = math.floor(index)
+    high = math.ceil(index)
+    if low == high:
+        return ordered[low]
+    return ordered[low] * (high - index) + ordered[high] * (index - low)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    arms = ("BASELINE", "UNILATERAL", "FLOOR", "ORACLE_SET")
+    pooled = {}
+    for arm in arms:
+        bits = math.fsum(float(row["committed"][arm]["bits"]) for row in anchors)
+        joules = math.fsum(float(row["committed"][arm]["joules"]) for row in anchors)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ratio(bits, joules),
+            "served_count_sum": sum(
+                int(row["committed"][arm]["served_count"]) for row in anchors
+            ),
+        }
+    numerator = pooled["FLOOR"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    denominator = pooled["ORACLE_SET"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    if denominator <= 0.0:
+        raise RuntimeError("oracle reference has no positive headroom")
+    timing = [float(row["policy"]["decision_wall_seconds"]) for row in anchors]
+    overhead = [float(row["policy"]["rule_overhead_wall_seconds"]) for row in anchors]
+    before_hist = Counter()
+    after_hist = Counter()
+    for row in anchors:
+        before_hist.update({int(k): int(v) for k, v in row["policy"]["before_occupancy_histogram"].items()})
+        after_hist.update({int(k): int(v) for k, v in row["policy"]["after_occupancy_histogram"].items()})
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({row["world_domain"] for row in anchors}),
+        "pooled": pooled,
+        "captured_fraction_of_oracle_gain_over_unilateral": numerator / denominator,
+        "floor_over_unilateral_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_over_baseline_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        ),
+        "oracle_set_over_unilateral_relative": relative_gain(
+            pooled["ORACLE_SET"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_decision_wall_seconds": {
+            "mean": statistics.fmean(timing),
+            "p50": _percentile(timing, 0.50),
+            "p95": _percentile(timing, 0.95),
+            "max": max(timing),
+            "sum": math.fsum(timing),
+        },
+        "floor_rule_overhead_wall_seconds": {
+            "mean": statistics.fmean(overhead),
+            "p50": _percentile(overhead, 0.50),
+            "p95": _percentile(overhead, 0.95),
+            "max": max(overhead),
+        },
+        "initial_underfull_beams": sum(
+            int(row["policy"]["initial_underfull_beams"]) for row in anchors
+        ),
+        "consolidated_beams": sum(int(row["policy"]["consolidated_beams"]) for row in anchors),
+        "emptied_beams": sum(int(row["policy"]["emptied_beams"]) for row in anchors),
+        "changed_users": sum(int(row["policy"]["changed_users"]) for row in anchors),
+        "before_occupancy_histogram": {str(k): v for k, v in sorted(before_hist.items())},
+        "after_occupancy_histogram": {str(k): v for k, v in sorted(after_hist.items())},
+        "floor_worse_than_unilateral_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        ],
+        "floor_worse_than_baseline_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["BASELINE"]["ee_bit_per_j"]
+        ],
+    }
+
+
+def run(*, worlds: int, anchors_per_world: int, reference_path: Path) -> dict[str, object]:
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested run exceeds the fixed 4-world x 5-anchor panel")
+    reference = load_reference(reference_path)
+    by_anchor = {row["anchor_id"]: row for row in reference["anchors"]}
+    started = time.perf_counter()
+    anchors = []
+    world_rows = []
+    for world_index in range(1, worlds + 1):
+        domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=ANCHORS_PER_WORLD,
+            start_time_s=0.0,
+        )
+        world_rows.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "tle_date": tape.tle_date,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        for step_index in range(anchors_per_world):
+            anchor_id = f"{domain}:step/{step_index}"
+            row = evaluate_anchor(tape=tape, reference=by_anchor[anchor_id])
+            anchors.append(row)
+            print(
+                json.dumps(
+                    {
+                        "anchor": anchor_id,
+                        "floor_ee": row["committed"]["FLOOR"]["ee_bit_per_j"],
+                        "served": row["committed"]["FLOOR"]["served_count"],
+                        "underfull": row["policy"]["initial_underfull_beams"],
+                        "consolidated": row["policy"]["consolidated_beams"],
+                        "emptied": row["policy"]["emptied_beams"],
+                        "decision_ms": 1000.0 * row["policy"]["decision_wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    result = {
+        "schema": "mcrl-v025-occupancy-floor-diagnostic-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "engine_commit": "75c5c78c",
+        "engine_tree": ENGINE_TREE,
+        "workspace_commit_before_diagnostic": _git("rev-parse", "HEAD"),
+        "probe_source_sha256": _sha256(PROBE_PATH),
+        "oracle_reference_path": str(reference_path),
+        "oracle_reference_file_sha256": REFERENCE_SHA256,
+        "oracle_reference_receipt_sha256": REFERENCE_RECEIPT_SHA256,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "process_limit": 3,
+        "processes_used": 1,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "thresholds_tried": [MIN_OCCUPANCY],
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "eta_ref": [ETA_REF.numerator, ETA_REF.denominator],
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "every intermediate branch selected from served count >= BASELINE at boundary 0",
+        "policy_rule": (
+            "Starting from BASELINE, visit the initially active occupancy-1/2 beams once in ascending identity order. "
+            "Prescribe consolidation by importing the nearest-slant legal occupants of other currently underfull beams until occupancy 3, and evacuation by moving every occupant to its nearest-slant legal currently occupancy>=3 beam (NULL only if none). "
+            "Choose the service-safe branch with greater exact F; ties use served count, consolidate before empty, then configuration id. Commit each repair immediately."
+        ),
+        "worlds": world_rows,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    result["receipt_sha256"] = _canonical_sha256(result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--reference", type=Path, default=REFERENCE_PATH)
+    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
+    args = parser.parse_args()
+    result = run(
+        worlds=args.worlds,
+        anchors_per_world=args.anchors_per_world,
+        reference_path=args.reference,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/occupancy_floor.py b/src/mcrl/physics_v025/occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
diff --git a/tests/physics_v025/test_occupancy_floor.py b/tests/physics_v025/test_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

diff --git a/.scratch/occupancy-floor/run_occupancy_floor.py b/.scratch/occupancy-floor/run_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f1834ff29715024ab9fe74ea6299433671b9b42
--- /dev/null
+++ b/.scratch/occupancy-floor/run_occupancy_floor.py
@@ -0,0 +1,511 @@
+#!/usr/bin/env python3
+"""Measure the one-pass occupancy-three floor on the oracle-ceiling panel."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+PROBE_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+REFERENCE_PATH = Path(
+    "/home/sat/mcrl-v025-oracle-ws/.scratch/oracle-ceiling/"
+    "oracle-ceiling-result.json"
+)
+OUTPUT_PATH = HERE / "occupancy-floor-result.json"
+REFERENCE_SHA256 = "af5a0ae34fd511b1598ab79d004be311fb1f1ea2478ca276ecbe3e8c96c79a83"
+REFERENCE_RECEIPT_SHA256 = "07c120297370f2b1a4826fce723950bccaf9e1a4e81007cda4ae30fae975fc29"
+ENGINE_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ETA_REF = Fraction("19720681.00172232")
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+ANCHORS_PER_WORLD = 5
+WORLD_COUNT = 4
+
+
+def _load_probe():
+    spec = importlib.util.spec_from_file_location("floor_v025_probe", PROBE_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load the pinned V0.25 probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+
+from mcrl.physics_v025.occupancy_floor import (  # noqa: E402
+    MIN_OCCUPANCY,
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancies,
+    occupancy_histogram,
+)
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+    ).strip()
+
+
+def _canonical_sha256(payload: object) -> str:
+    raw = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def load_reference(path: Path) -> dict[str, object]:
+    if _sha256(path) != REFERENCE_SHA256:
+        raise RuntimeError("oracle-ceiling reference file digest drifted")
+    payload = json.loads(path.read_text(encoding="ascii"))
+    declared = payload.pop("receipt_sha256", None)
+    if declared != REFERENCE_RECEIPT_SHA256 or _canonical_sha256(payload) != declared:
+        raise RuntimeError("oracle-ceiling embedded receipt digest is invalid")
+    payload["receipt_sha256"] = declared
+    if payload.get("schema") != "mcrl-v025-perfect-knowledge-oracle-ceiling-v1":
+        raise RuntimeError("wrong oracle-ceiling schema")
+    if payload.get("claim_ceiling") != CLAIM_CEILING:
+        raise RuntimeError("oracle-ceiling claim ceiling drifted")
+    if payload.get("source_tree") != ENGINE_TREE:
+        raise RuntimeError("oracle-ceiling engine tree drifted")
+    if len(payload.get("anchors", ())) != WORLD_COUNT * ANCHORS_PER_WORLD:
+        raise RuntimeError("oracle-ceiling anchor panel drifted")
+    return payload
+
+
+def exact_float(value: float) -> Fraction:
+    if not math.isfinite(value):
+        raise RuntimeError("non-finite physical coefficient")
+    return Fraction.from_float(float(value))
+
+
+def objective(profile) -> Fraction:
+    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)
+
+
+def served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def ratio(bits: float, joules: float) -> float:
+    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
+        raise RuntimeError("invalid EE components")
+    return bits / joules
+
+
+def relative_gain(numerator: float, denominator: float) -> float:
+    if denominator == 0.0:
+        raise RuntimeError("zero reference EE")
+    return numerator / denominator - 1.0
+
+
+def parse_configuration(base, encoded: str, *, kind: str):
+    if not encoded.startswith("CFG:"):
+        raise RuntimeError(f"cannot parse non-derived configuration {encoded!r}")
+    mapping = {}
+    for item in encoded[4:].split(";"):
+        fields = item.split(":")
+        user = int(fields[0])
+        if fields[1] == "NULL":
+            mapping[user] = None
+        else:
+            mapping[user] = (int(fields[1]), int(fields[2]))
+    config = probe._configuration(base, mapping, kind=kind)
+    if config.configuration_id != encoded:
+        raise RuntimeError("configuration reconstruction changed its identity")
+    return config
+
+
+def slant_lookup(tape, step_index: int) -> dict[tuple[int, tuple[int, int]], float]:
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        boundary = step.boundary_at(0)
+        return {
+            (row.user_id, row.identity): float(row.slant_km)
+            for row in boundary.candidates
+            if row.legal
+        }
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    result = {}
+    for row in probe.np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        identity = tuple(int(value) for value in arrays.identities[row])
+        result[(user, identity)] = float(arrays.slants_km[0, row])
+    return result
+
+
+def _profile_payload(profile) -> dict[str, object]:
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bit_per_j": ratio(profile.bits, profile.joules),
+        "served_count": served(profile),
+    }
+
+
+def _verify_reference_profile(
+    actual: Mapping[str, object], expected: Mapping[str, object], *, arm: str
+) -> None:
+    for field in ("configuration_id", "bits", "joules", "served_count"):
+        if actual[field] != expected[field]:
+            raise RuntimeError(
+                f"{arm} committed reference mismatch in {field}: "
+                f"actual={actual[field]!r} expected={expected[field]!r}"
+            )
+
+
+def evaluate_anchor(*, tape, reference: Mapping[str, object]) -> dict[str, object]:
+    step_index = int(reference["step_index"])
+    expected_id = f"{tape.domain}:step/{step_index}"
+    if reference["anchor_id"] != expected_id or reference["world_sha256"] != tape.digest:
+        raise RuntimeError("reconstructed anchor does not match the ceiling reference")
+    base = probe._base_configuration(tape, step_index, "nearest-eligible")
+    selection = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    base_selection = selection.evaluate(base)
+    service_guard = served(base_selection)
+    scoring_seconds = 0.0
+    decision_started = time.perf_counter()
+    legal_options, _ = probe._legal_options(tape, step_index)
+    slants = slant_lookup(tape, step_index)
+
+    def exact_score(plan):
+        nonlocal scoring_seconds
+        config = probe._configuration(base, plan.mapping, kind=f"floor-{plan.action}")
+        started = time.perf_counter()
+        profile = selection.evaluate(config)
+        scoring_seconds += time.perf_counter() - started
+        if config.configuration_id in selection._invalid:
+            return None
+        return ScoredRepair(
+            plan=plan,
+            objective=objective(profile),
+            served_count=served(profile),
+            configuration_id=config.configuration_id,
+        )
+
+    floor_result = apply_occupancy_floor(
+        base.mapping,
+        legal_options=legal_options,
+        slant_km=slants,
+        exact_score=exact_score,
+        minimum_served=service_guard,
+    )
+    decision_seconds = time.perf_counter() - decision_started
+    floor = probe._configuration(base, floor_result.mapping, kind="occupancy-floor")
+    expected_committed = reference["committed"]
+    unilateral = parse_configuration(
+        base,
+        str(expected_committed["UNILATERAL"]["configuration_id"]),
+        kind="unilateral-reference",
+    )
+    oracle_set = parse_configuration(
+        base,
+        str(expected_committed["ORACLE_SET"]["configuration_id"]),
+        kind="oracle-set-reference",
+    )
+    committed = probe.StepEvaluator(
+        tape,
+        probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    configs = (base, unilateral, floor, oracle_set)
+    committed.evaluate_many(configs)
+    profiles = {
+        "BASELINE": committed.evaluate(base),
+        "UNILATERAL": committed.evaluate(unilateral),
+        "FLOOR": committed.evaluate(floor),
+        "ORACLE_SET": committed.evaluate(oracle_set),
+    }
+    payloads = {name: _profile_payload(profile) for name, profile in profiles.items()}
+    for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+        _verify_reference_profile(payloads[name], expected_committed[name], arm=name)
+
+    before_counts = occupancies(base.mapping)
+    after_counts = occupancies(floor.mapping)
+    initial_underfull = floor_result.initially_underfull
+    consolidated = sum(after_counts.get(beam, 0) >= MIN_OCCUPANCY for beam in initial_underfull)
+    emptied = sum(after_counts.get(beam, 0) == 0 for beam in initial_underfull)
+    if consolidated + emptied != len(initial_underfull):
+        raise RuntimeError("initial underfull beam was neither consolidated nor emptied")
+    return {
+        "anchor_id": reference["anchor_id"],
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "step_index": step_index,
+        "policy": {
+            "minimum_occupancy": MIN_OCCUPANCY,
+            "starting_assignment": "BASELINE",
+            "service_guard": service_guard,
+            "initial_underfull_beams": len(initial_underfull),
+            "consolidated_beams": consolidated,
+            "emptied_beams": emptied,
+            "changed_users": floor.changed_users,
+            "before_active_beams": len(before_counts),
+            "after_active_beams": len(after_counts),
+            "before_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(base.mapping).items()
+            },
+            "after_occupancy_histogram": {
+                str(key): value for key, value in occupancy_histogram(floor.mapping).items()
+            },
+            "selected_repairs": [
+                {
+                    "beam": list(row.plan.beam),
+                    "action": row.plan.action,
+                    "moved_users": list(row.plan.moved_users),
+                    "decision_served_count": row.served_count,
+                    "objective_bits": float(row.objective),
+                    "configuration_id": row.configuration_id,
+                }
+                for row in floor_result.decisions
+            ],
+            "exact_branch_configurations_evaluated": selection.physical_evaluations - 1,
+            "decision_wall_seconds": decision_seconds,
+            "exact_scoring_wall_seconds": scoring_seconds,
+            "rule_overhead_wall_seconds": max(0.0, decision_seconds - scoring_seconds),
+        },
+        "committed": payloads,
+    }
+
+
+def _percentile(values: Sequence[float], q: float) -> float:
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * q
+    low = math.floor(index)
+    high = math.ceil(index)
+    if low == high:
+        return ordered[low]
+    return ordered[low] * (high - index) + ordered[high] * (index - low)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    arms = ("BASELINE", "UNILATERAL", "FLOOR", "ORACLE_SET")
+    pooled = {}
+    for arm in arms:
+        bits = math.fsum(float(row["committed"][arm]["bits"]) for row in anchors)
+        joules = math.fsum(float(row["committed"][arm]["joules"]) for row in anchors)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": ratio(bits, joules),
+            "served_count_sum": sum(
+                int(row["committed"][arm]["served_count"]) for row in anchors
+            ),
+        }
+    numerator = pooled["FLOOR"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    denominator = pooled["ORACLE_SET"]["ee_bit_per_j"] - pooled["UNILATERAL"]["ee_bit_per_j"]
+    if denominator <= 0.0:
+        raise RuntimeError("oracle reference has no positive headroom")
+    timing = [float(row["policy"]["decision_wall_seconds"]) for row in anchors]
+    overhead = [float(row["policy"]["rule_overhead_wall_seconds"]) for row in anchors]
+    before_hist = Counter()
+    after_hist = Counter()
+    for row in anchors:
+        before_hist.update({int(k): int(v) for k, v in row["policy"]["before_occupancy_histogram"].items()})
+        after_hist.update({int(k): int(v) for k, v in row["policy"]["after_occupancy_histogram"].items()})
+    return {
+        "anchor_count": len(anchors),
+        "world_count": len({row["world_domain"] for row in anchors}),
+        "pooled": pooled,
+        "captured_fraction_of_oracle_gain_over_unilateral": numerator / denominator,
+        "floor_over_unilateral_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_over_baseline_relative": relative_gain(
+            pooled["FLOOR"]["ee_bit_per_j"], pooled["BASELINE"]["ee_bit_per_j"]
+        ),
+        "oracle_set_over_unilateral_relative": relative_gain(
+            pooled["ORACLE_SET"]["ee_bit_per_j"], pooled["UNILATERAL"]["ee_bit_per_j"]
+        ),
+        "floor_decision_wall_seconds": {
+            "mean": statistics.fmean(timing),
+            "p50": _percentile(timing, 0.50),
+            "p95": _percentile(timing, 0.95),
+            "max": max(timing),
+            "sum": math.fsum(timing),
+        },
+        "floor_rule_overhead_wall_seconds": {
+            "mean": statistics.fmean(overhead),
+            "p50": _percentile(overhead, 0.50),
+            "p95": _percentile(overhead, 0.95),
+            "max": max(overhead),
+        },
+        "initial_underfull_beams": sum(
+            int(row["policy"]["initial_underfull_beams"]) for row in anchors
+        ),
+        "consolidated_beams": sum(int(row["policy"]["consolidated_beams"]) for row in anchors),
+        "emptied_beams": sum(int(row["policy"]["emptied_beams"]) for row in anchors),
+        "changed_users": sum(int(row["policy"]["changed_users"]) for row in anchors),
+        "before_occupancy_histogram": {str(k): v for k, v in sorted(before_hist.items())},
+        "after_occupancy_histogram": {str(k): v for k, v in sorted(after_hist.items())},
+        "floor_worse_than_unilateral_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        ],
+        "floor_worse_than_baseline_anchors": [
+            row["anchor_id"]
+            for row in anchors
+            if row["committed"]["FLOOR"]["ee_bit_per_j"]
+            < row["committed"]["BASELINE"]["ee_bit_per_j"]
+        ],
+    }
+
+
+def run(*, worlds: int, anchors_per_world: int, reference_path: Path) -> dict[str, object]:
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
+        raise RuntimeError("requested run exceeds the fixed 4-world x 5-anchor panel")
+    reference = load_reference(reference_path)
+    by_anchor = {row["anchor_id"]: row for row in reference["anchors"]}
+    started = time.perf_counter()
+    anchors = []
+    world_rows = []
+    for world_index in range(1, worlds + 1):
+        domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        world_started = time.perf_counter()
+        tape = probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=ANCHORS_PER_WORLD,
+            start_time_s=0.0,
+        )
+        world_rows.append(
+            {
+                "world_index": world_index,
+                "domain": domain,
+                "world_sha256": tape.digest,
+                "tle_date": tape.tle_date,
+                "training_seed": tape.training_seed,
+                "construction_wall_seconds": time.perf_counter() - world_started,
+            }
+        )
+        for step_index in range(anchors_per_world):
+            anchor_id = f"{domain}:step/{step_index}"
+            row = evaluate_anchor(tape=tape, reference=by_anchor[anchor_id])
+            anchors.append(row)
+            print(
+                json.dumps(
+                    {
+                        "anchor": anchor_id,
+                        "floor_ee": row["committed"]["FLOOR"]["ee_bit_per_j"],
+                        "served": row["committed"]["FLOOR"]["served_count"],
+                        "underfull": row["policy"]["initial_underfull_beams"],
+                        "consolidated": row["policy"]["consolidated_beams"],
+                        "emptied": row["policy"]["emptied_beams"],
+                        "decision_ms": 1000.0 * row["policy"]["decision_wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    result = {
+        "schema": "mcrl-v025-occupancy-floor-diagnostic-v1",
+        "claim_ceiling": CLAIM_CEILING,
+        "engine_commit": "75c5c78c",
+        "engine_tree": ENGINE_TREE,
+        "workspace_commit_before_diagnostic": _git("rev-parse", "HEAD"),
+        "probe_source_sha256": _sha256(PROBE_PATH),
+        "oracle_reference_path": str(reference_path),
+        "oracle_reference_file_sha256": REFERENCE_SHA256,
+        "oracle_reference_receipt_sha256": REFERENCE_RECEIPT_SHA256,
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "process_limit": 3,
+        "processes_used": 1,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "thresholds_tried": [MIN_OCCUPANCY],
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
+        "eta_ref": [ETA_REF.numerator, ETA_REF.denominator],
+        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
+        "service_guard": "every intermediate branch selected from served count >= BASELINE at boundary 0",
+        "policy_rule": (
+            "Starting from BASELINE, visit the initially active occupancy-1/2 beams once in ascending identity order. "
+            "Prescribe consolidation by importing the nearest-slant legal occupants of other currently underfull beams until occupancy 3, and evacuation by moving every occupant to its nearest-slant legal currently occupancy>=3 beam (NULL only if none). "
+            "Choose the service-safe branch with greater exact F; ties use served count, consolidate before empty, then configuration id. Commit each repair immediately."
+        ),
+        "worlds": world_rows,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    result["receipt_sha256"] = _canonical_sha256(result)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
+    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
+    parser.add_argument("--reference", type=Path, default=REFERENCE_PATH)
+    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
+    args = parser.parse_args()
+    result = run(
+        worlds=args.worlds,
+        anchors_per_world=args.anchors_per_world,
+        reference_path=args.reference,
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/occupancy_floor.py b/src/mcrl/physics_v025/occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
diff --git a/tests/physics_v025/test_occupancy_floor.py b/tests/physics_v025/test_occupancy_floor.py
new file mode 100644
index 0000000000000000000000000000000000000000..00775eb0e422b09d589a8382c98d10f2c0d1e6a3
--- /dev/null
+++ b/tests/physics_v025/test_occupancy_floor.py
@@ -0,0 +1,100 @@
+from fractions import Fraction
+
+from mcrl.physics_v025.occupancy_floor import (
+    ScoredRepair,
+    apply_occupancy_floor,
+    occupancy_histogram,
+    repair_plans,
+)
+
+
+def _options(*beams):
+    return tuple(beams)
+
+
+def test_policy_consolidates_or_empties_every_underfull_beam() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+
+    def score(plan):
+        bonus = 10 if plan.action == "consolidate" else 0
+        return ScoredRepair(plan, Fraction(bonus), 6, f"cfg-{plan.action}")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert occupancy_histogram(result.mapping) == {3: 2}
+    assert result.decisions[0].plan.action == "consolidate"
+    assert result.mapping[2] == a
+
+
+def test_empty_branch_uses_only_stable_destinations_and_null_as_last_resort() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: b, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(b, c),
+        2: _options(b),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {
+        (user, beam): float(rank + 1)
+        for user, beams in legal.items()
+        for rank, beam in enumerate(beams)
+    }
+    plans = repair_plans(
+        assignments,
+        beam=b,
+        legal_options=legal,
+        slant_km=slants,
+    )
+    empty = next(row for row in plans if row.action == "empty")
+    assert empty.mapping[1] == c
+    assert empty.mapping[2] is None
+
+
+def test_service_guard_rejects_higher_objective_branch() -> None:
+    a, b, c = (1, 1), (1, 2), (1, 3)
+    assignments = {0: a, 1: a, 2: b, 3: c, 4: c, 5: c}
+    legal = {
+        0: _options(a, c),
+        1: _options(a, c),
+        2: _options(b, a, c),
+        3: _options(c),
+        4: _options(c),
+        5: _options(c),
+    }
+    slants = {(user, beam): 1.0 for user, beams in legal.items() for beam in beams}
+
+    def score(plan):
+        if plan.action == "empty":
+            return ScoredRepair(plan, Fraction(100), 5, "bad-service")
+        return ScoredRepair(plan, Fraction(1), 6, "good-service")
+
+    result = apply_occupancy_floor(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        exact_score=score,
+        minimum_served=6,
+    )
+    assert result.decisions[0].configuration_id == "good-service"

