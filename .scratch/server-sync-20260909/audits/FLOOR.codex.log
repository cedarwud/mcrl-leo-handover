index 0000000000000000000000000000000000000000..e6fbcd609824c820fcc4544102b92360ea71e5b4
--- /dev/null
+++ b/src/mcrl/physics_v025/occupancy_floor.py
@@ -0,0 +1,243 @@
+"""Deterministic one-pass occupancy-three floor policy.
+
+The policy repairs the incumbent assignment directly.  It is not a candidate
+catalogue: each underfull beam has at most two prescribed repairs, and a
+caller-provided exact scorer chooses between those repairs.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass
+from fractions import Fraction
+from typing import Callable, Mapping, Sequence
+
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+MIN_OCCUPANCY = 3
+
+
+@dataclass(frozen=True)
+class RepairPlan:
+    """One prescribed repair for the beam currently being visited."""
+
+    action: str
+    beam: BeamIdentity
+    assignments: tuple[tuple[int, Assignment], ...]
+    moved_users: tuple[int, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+@dataclass(frozen=True)
+class ScoredRepair:
+    """The exact decision-boundary score used by the branch rule."""
+
+    plan: RepairPlan
+    objective: Fraction
+    served_count: int
+    configuration_id: str
+
+
+@dataclass(frozen=True)
+class FloorResult:
+    """Committed output and audit trail of the single policy pass."""
+
+    assignments: tuple[tuple[int, Assignment], ...]
+    decisions: tuple[ScoredRepair, ...]
+    initially_underfull: tuple[BeamIdentity, ...]
+
+    @property
+    def mapping(self) -> dict[int, Assignment]:
+        return dict(self.assignments)
+
+
+def occupancies(assignments: Mapping[int, Assignment]) -> Counter[BeamIdentity]:
+    """Return active-beam occupancies; empty and NULL beams are absent."""
+
+    return Counter(beam for beam in assignments.values() if beam is not None)
+
+
+def occupancy_histogram(assignments: Mapping[int, Assignment]) -> dict[int, int]:
+    """Map occupancy to the number of active beams at that occupancy."""
+
+    return dict(sorted(Counter(occupancies(assignments).values()).items()))
+
+
+def _empty_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan:
+    """Evacuate every occupant to its nearest already-stable legal beam."""
+
+    counts = occupancies(current)
+    occupants = tuple(sorted(user for user, value in current.items() if value == beam))
+    mapping = dict(current)
+    for user in occupants:
+        destinations = tuple(
+            candidate
+            for candidate in legal_options.get(user, ())
+            if candidate != beam and counts.get(candidate, 0) >= MIN_OCCUPANCY
+        )
+        mapping[user] = min(
+            destinations,
+            key=lambda candidate: (slant_km[(user, candidate)], candidate),
+            default=None,
+        )
+    return RepairPlan(
+        action="empty",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=occupants,
+    )
+
+
+def _consolidate_plan(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> RepairPlan | None:
+    """Fill a beam from other underfull beams using nearest-link order."""
+
+    counts = occupancies(current)
+    needed = MIN_OCCUPANCY - counts.get(beam, 0)
+    if needed <= 0:
+        return None
+    arrivals = sorted(
+        (
+            slant_km[(user, beam)],
+            user,
+            origin,
+        )
+        for user, origin in current.items()
+        if origin is not None
+        and origin != beam
+        and counts.get(origin, 0) < MIN_OCCUPANCY
+        and beam in legal_options.get(user, ())
+        and (user, beam) in slant_km
+    )
+    if len(arrivals) < needed:
+        return None
+    moved = tuple(user for _slant, user, _origin in arrivals[:needed])
+    mapping = dict(current)
+    for user in moved:
+        mapping[user] = beam
+    return RepairPlan(
+        action="consolidate",
+        beam=beam,
+        assignments=tuple(sorted(mapping.items())),
+        moved_users=moved,
+    )
+
+
+def repair_plans(
+    current: Mapping[int, Assignment],
+    *,
+    beam: BeamIdentity,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+) -> tuple[RepairPlan, ...]:
+    """Return the two fixed branches, or only evacuation when filling is impossible."""
+
+    consolidate = _consolidate_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    empty = _empty_plan(
+        current,
+        beam=beam,
+        legal_options=legal_options,
+        slant_km=slant_km,
+    )
+    return (empty,) if consolidate is None else (consolidate, empty)
+
+
+def apply_occupancy_floor(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    exact_score: Callable[[RepairPlan], ScoredRepair | None],
+    minimum_served: int,
+) -> FloorResult:
+    """Apply one sorted pass and commit the best service-safe exact repair.
+
+    Branch order is objective descending, served count descending, action
+    (``consolidate`` before ``empty``), then configuration id.  A branch that
+    is physically invalid or below the unchanged service guard is ineligible.
+    """
+
+    current = dict(assignments)
+    initial_counts = occupancies(current)
+    initially_underfull = tuple(
+        beam
+        for beam, count in sorted(initial_counts.items())
+        if 0 < count < MIN_OCCUPANCY
+    )
+    decisions: list[ScoredRepair] = []
+    action_rank = {"consolidate": 0, "empty": 1}
+    for beam in initially_underfull:
+        count = occupancies(current).get(beam, 0)
+        if count == 0 or count >= MIN_OCCUPANCY:
+            continue
+        scored = tuple(
+            row
+            for plan in repair_plans(
+                current,
+                beam=beam,
+                legal_options=legal_options,
+                slant_km=slant_km,
+            )
+            if (row := exact_score(plan)) is not None
+            and row.served_count >= minimum_served
+        )
+        if not scored:
+            raise RuntimeError(f"no service-safe occupancy-floor repair for beam {beam}")
+        selected = min(
+            scored,
+            key=lambda row: (
+                -row.objective,
+                -row.served_count,
+                action_rank[row.plan.action],
+                row.configuration_id,
+            ),
+        )
+        current = selected.plan.mapping
+        decisions.append(selected)
+
+    residual = {
+        beam: count
+        for beam, count in occupancies(current).items()
+        if count < MIN_OCCUPANCY
+    }
+    if residual:
+        raise RuntimeError(f"occupancy-floor invariant was not established: {residual}")
+    return FloorResult(
+        assignments=tuple(sorted(current.items())),
+        decisions=tuple(decisions),
+        initially_underfull=initially_underfull,
+    )
+
+
+__all__ = [
+    "Assignment",
+    "BeamIdentity",
+    "FloorResult",
+    "MIN_OCCUPANCY",
+    "RepairPlan",
+    "ScoredRepair",
+    "apply_occupancy_floor",
+    "occupancies",
+    "occupancy_histogram",
+    "repair_plans",
+]
