    @staticmethod
    def _profile_payload(profile: Profile, tables: Sequence[UserActionTable]) -> list[dict[str, object]]:
        if len(profile) != len(tables):
            raise StageCContractError("profile is incomplete")
        return [
            {"user_id": table.user_id, "action": table.actions[index].payload()}
            for table, index in zip(tables, profile, strict=True)
        ]

    @classmethod
    def _authenticate_inputs(
        cls,
        *,
        catalogue, _catalogue_census = ENGINE._catalogue_with_census(
            tape,
            step_index,
            base,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        current.evaluate_many(catalogue)
        catalogue_count = len(catalogue)
        factors = ENGINE._selection_factor_scores(
            base=base,
            incumbent=incumbent,
            catalog=tuple(
                row for row in catalogue if row.configuration_id not in current._invalid
            ),
            evaluated=current._evaluated,
            calibration=calibration,
            cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        )
        pairwise = [
            row
            for row in catalogue
            if row.changed_users == 2
            and row.configuration_id in factors
        ]
        if not pairwise:
            raise RuntimeError("sealed catalogue produced no trainable joint coalition")
        selected = min(
            pairwise,
            key=lambda row: (
                -float(factors[row.configuration_id]["C1"] + factors[row.configuration_id]["C3"]),
                row.configuration_id,
            ),
        )
        coalition_row = _coalition_row(
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]), actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row
    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)

