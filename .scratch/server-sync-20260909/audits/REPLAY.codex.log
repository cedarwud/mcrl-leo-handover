+    return {
+        "count": int(data.size),
+        "min": float(data.min()),
+        "p05": float(np.percentile(data, 5)),
+        "p25": float(np.percentile(data, 25)),
+        "p50": float(np.percentile(data, 50)),
+        "p75": float(np.percentile(data, 75)),
+        "p95": float(np.percentile(data, 95)),
