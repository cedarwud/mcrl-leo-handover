+    import hashlib
+
+    encoded = json.dumps(row, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()
+
+
+def load_rows_by_sha(root: Path) -> dict[str, dict[str, Any]]:
+    rows: dict[str, dict[str, Any]] = {}
+    for path in sorted(root.glob(ROW_GLOB)):
+        with path.open(encoding="utf-8") as handle:
+            header = json.loads(next(handle))
+            observed = 0
+            for line in handle:
+                row = json.loads(line)
+                digest = canonical_sha(row)
+                if digest in rows:
+                    raise RuntimeError(f"duplicate coalition-row SHA in {path}")
+                rows[digest] = row
+                observed += 1
+            if observed != int(header["row_count"]):
+                raise RuntimeError(f"row-count mismatch in {path}: {observed}")
+    return rows
+
+
+def load_candidates(root: Path) -> tuple[dict[tuple[str, int], list[dict[str, Any]]], dict[str, Any]]:
+    rows_by_sha = load_rows_by_sha(root)
+    grouped: dict[tuple[str, int], list[dict[str, Any]]] = defaultdict(list)
+    direct_identity_max_abs = 0.0
+    with (root / "PILOT_NOT_CLAIM-family-index.jsonl").open(encoding="utf-8") as handle:
+        header = json.loads(next(handle))
+        observed = 0
+        for line in handle:
+            item = json.loads(line)
+            row = rows_by_sha.get(str(item["coalition_row_sha256"]))
+            if row is None:
+                raise RuntimeError(
+                    f"missing coalition row {item['coalition_row_sha256']}"
+                )
+            receipt = item["exact_objective_receipt"]
+            exact_value = fraction(receipt["coalition"])
+            baseline_value = fraction(receipt["baseline"])
+            f_delta = float.fromhex(row["objective_delta_normalized_hex"])
+            c1 = float.fromhex(row["c1_normalized_hex"])
+            psi = float.fromhex(row["psi_normalized_hex"])
+            if int(item["coalition_size"]) == 2:
+                residual = 0.0
+                q2_delta = math.fsum((c1, psi))
+            else:
+                r3 = item.get("r3")
+                if not isinstance(r3, dict):
+                    raise RuntimeError("retained pair values absent for size >= 3")
+                residual = float.fromhex(r3["r3_normalized_hex"])
+                pair_terms = tuple(
+                    float.fromhex(pair["psi"])
+                    for pair in r3["pair_psi_normalized_hex"]
+                )
+                q2_delta = math.fsum((c1, *pair_terms))
+                direct_identity_max_abs = max(
+                    direct_identity_max_abs,
+                    abs(math.fsum((q2_delta, residual, -f_delta))),
+                )
+            grouped[(str(item["world_id"]), int(item["anchor_index"]))].append(
+                {
+                    "configuration_id": str(item["configuration_id"]),
+                    "anchor_id": str(item["anchor_id"]),
+                    "coalition_size": int(item["coalition_size"]),
+                    "families": tuple(item["families"]),
+                    "exact_value": exact_value,
+                    "baseline_value": baseline_value,
+                    "f_delta_normalized": f_delta,
+                    "q2_delta_normalized": q2_delta,
+                    "residual_normalized": residual,
+                }
+            )
+            observed += 1
+    if observed != int(header["row_count"]):
+        raise RuntimeError(f"family-index row-count mismatch: {observed}")
+    if len(rows_by_sha) != observed:
+        raise RuntimeError(
+            f"coalition row/index mismatch: {len(rows_by_sha)} versus {observed}"
+        )
+    return grouped, {
+        "family_index_rows": observed,
+        "mechanism_rows": len(rows_by_sha),
+        "direct_q2_plus_residual_identity_max_abs": direct_identity_max_abs,
+    }
+
+
+def tie_sorted(candidates: list[dict[str, Any]], score: str) -> list[dict[str, Any]]:
+    return sorted(candidates, key=lambda row: (-float(row[score]), row["configuration_id"]))
+
+
+def exact_sorted(candidates: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    return sorted(candidates, key=lambda row: (-row["exact_value"], row["configuration_id"]))
+
+
+def replay(root: Path) -> dict[str, Any]:
+    grouped, integrity = load_candidates(root)
+    anchors: list[dict[str, Any]] = []
+    bound_slack_min = float("inf")
+    for (world, anchor), labelled in sorted(grouped.items()):
+        baseline_values = {row["baseline_value"] for row in labelled}
+        if len(baseline_values) != 1:
+            raise RuntimeError(f"baseline receipt mismatch for {world} anchor {anchor}")
+        baseline_value = baseline_values.pop()
+        anchor_ids = {row["anchor_id"] for row in labelled}
+        if len(anchor_ids) != 1:
+            raise RuntimeError(f"anchor-ID mismatch for {world} anchor {anchor}")
+        baseline_configuration_id = anchor_ids.pop().split("|")[-1]
+        # BASE sorts before CFG and thus receives the production stable-ID tie preference.
+        pool = [
+            {
+                "configuration_id": baseline_configuration_id,
+                "anchor_id": baseline_configuration_id,
+                "coalition_size": 0,
+                "families": ("no-move-baseline",),
+                "exact_value": baseline_value,
+                "baseline_value": baseline_value,
+                "f_delta_normalized": 0.0,
+                "q2_delta_normalized": 0.0,
+                "residual_normalized": 0.0,
+            },
+            *labelled,
+        ]
+        by_exact = exact_sorted(pool)
+        by_q2 = tie_sorted(pool, "q2_delta_normalized")
+        a_star, a2 = by_exact[0], by_q2[0]
+        exact_top_ties = [row for row in pool if row["exact_value"] == a_star["exact_value"]]
+        q2_top_ties = [
+            row
+            for row in pool
+            if row["q2_delta_normalized"] == a2["q2_delta_normalized"]
+        ]
+        exact_top_three_cutoff = by_exact[2]["exact_value"]
+        exact_top_three_cutoff_tied = [
+            row for row in pool if row["exact_value"] == exact_top_three_cutoff
+        ]
+        exact_top_three_ids = {row["configuration_id"] for row in by_exact[:3]}
+        exact_top_three_cutoff_straddles = any(
+            row["configuration_id"] not in exact_top_three_ids
+            for row in exact_top_three_cutoff_tied
+        )
+        regret_exact = a_star["exact_value"] - a2["exact_value"]
+        relative_regret = float(regret_exact / abs(a_star["exact_value"]))
+        comparator_relative_regret = (
+            float(a_star["exact_value"] / a2["exact_value"] - 1)
+            if a2["exact_value"] > 0
+            else None
+        )
+        regret_normalized = (
+            a_star["f_delta_normalized"] - a2["f_delta_normalized"]
+        )
+        changed = a_star["configuration_id"] != a2["configuration_id"]
+        residuals = [row["residual_normalized"] for row in pool]
+        residual_range = max(residuals) - min(residuals)
+        bound_slack = residual_range - regret_normalized
+        bound_slack_min = min(bound_slack_min, bound_slack)
+        shortlists: dict[str, Any] = {}
+        for k in (3, 5, 10):
+            reranked = exact_sorted(by_q2[:k])[0]
+            gap = a_star["exact_value"] - reranked["exact_value"]
+            cutoff_score = by_q2[k - 1]["q2_delta_normalized"]
+            cutoff_tied = [
+                row for row in pool if row["q2_delta_normalized"] == cutoff_score
+            ]
+            included_ids = {row["configuration_id"] for row in by_q2[:k]}
+            cutoff_straddles = any(
+                row["configuration_id"] in included_ids for row in cutoff_tied
+            ) and any(row["configuration_id"] not in included_ids for row in cutoff_tied)
+            cutoff_consequential = cutoff_straddles and (
+                max(
+                    row["exact_value"]
+                    for row in cutoff_tied
+                    if row["configuration_id"] not in included_ids
+                )
+                > min(
+                    row["exact_value"]
+                    for row in cutoff_tied
+                    if row["configuration_id"] in included_ids
+                )
+            )
+            shortlists[str(k)] = {
+                "selected_configuration_id": reranked["configuration_id"],
+                "gap_normalized": a_star["f_delta_normalized"]
+                - reranked["f_delta_normalized"],
+                "gap_relative": float(gap / abs(a_star["exact_value"])),
+                "exact_recovered": gap == 0,
+                "q2_cutoff_tie_straddles": cutoff_straddles,
+                "q2_cutoff_tie_consequential": cutoff_consequential,
+            }
+        anchors.append(
+            {
+                "world_id": world,
+                "anchor_index": anchor,
+                "pool_size_including_baseline": len(pool),
+                "a_star_configuration_id": a_star["configuration_id"],
+                "a2_configuration_id": a2["configuration_id"],
+                "selection_changed": changed,
+                "a2_exact_rank": next(
+                    index + 1
+                    for index, row in enumerate(by_exact)
+                    if row["configuration_id"] == a2["configuration_id"]
+                ),
+                "regret_normalized": regret_normalized,
+                "regret_relative": relative_regret,
+                "regret_relative_full_over_selected": comparator_relative_regret,
+                "a_star_exact_value": float(a_star["exact_value"]),
+                "a2_exact_value": float(a2["exact_value"]),
+                "exceeds_relative_margin": relative_regret > MARGIN,
+                "r_ge_3_min_normalized": min(residuals),
+                "r_ge_3_max_normalized": max(residuals),
+                "r_ge_3_range_normalized": residual_range,
+                "bound_slack_normalized": bound_slack,
+                "exact_top_tie_count": len(exact_top_ties),
+                "q2_top_tie_count": len(q2_top_ties),
+                "exact_top_three_cutoff_tie_straddles": exact_top_three_cutoff_straddles,
+                "q2_top_tie_exact_values_differ": len(
+                    {row["exact_value"] for row in q2_top_ties}
+                )
+                > 1,
+                "q2_tie_rule_realized_lower_exact_value": (
+                    a2["exact_value"]
+                    < max(row["exact_value"] for row in q2_top_ties)
+                ),
+                "shortlists": shortlists,
+            }
+        )
+
+    changed = [row for row in anchors if row["selection_changed"]]
+    total = len(anchors)
+    if total != 180:
+        raise RuntimeError(f"expected 180 anchors, got {total}")
+    if bound_slack_min < -1e-10:
+        raise RuntimeError(f"truncation bound failed: min slack {bound_slack_min}")
+
+    summary: dict[str, Any] = {
+        "claim_status": "DIAGNOSTIC_NOT_CLAIM",
+        "relative_margin": MARGIN,
+        "anchor_count": total,
+        "changed_selection_count": len(changed),
+        "unchanged_selection_count": total - len(changed),
+        "fraction_all_anchors_regret_exceeds_margin": sum(
+            row["exceeds_relative_margin"] for row in anchors
+        )
+        / total,
+        "count_all_anchors_regret_exceeds_margin": sum(
+            row["exceeds_relative_margin"] for row in anchors
+        ),
+        "fraction_changed_anchors_regret_exceeds_margin": (
+            sum(row["exceeds_relative_margin"] for row in changed) / len(changed)
+            if changed
+            else 0.0
+        ),
+        "regret_normalized_all_anchors": quantiles(
+            row["regret_normalized"] for row in anchors
+        ),
+        "regret_relative_all_anchors": quantiles(
+            row["regret_relative"] for row in anchors
+        ),
+        "regret_normalized_changed_anchors": quantiles(
+            row["regret_normalized"] for row in changed
+        ),
+        "regret_relative_changed_anchors": quantiles(
+            row["regret_relative"] for row in changed
+        ),
+        "a_star_nonpositive_count": sum(row["a_star_exact_value"] <= 0 for row in anchors),
+        "a2_nonpositive_count": sum(row["a2_exact_value"] <= 0 for row in anchors),
+        "regret_relative_full_over_selected_positive_denominator": quantiles(
+            row["regret_relative_full_over_selected"]
+            for row in anchors
+            if row["regret_relative_full_over_selected"] is not None
+        ),
+        "a2_equals_a_star": total - len(changed),
+        "a2_in_exact_top_three": sum(row["a2_exact_rank"] <= 3 for row in anchors),
+        "a2_in_exact_top_three_changed_anchors": sum(
+            row["a2_exact_rank"] <= 3 for row in changed
+        ),
+        "ties": {
+            "exact_top_tie_anchors": sum(row["exact_top_tie_count"] > 1 for row in anchors),
+            "q2_top_tie_anchors": sum(row["q2_top_tie_count"] > 1 for row in anchors),
+            "exact_top_three_cutoff_tie_anchors": sum(
+                row["exact_top_three_cutoff_tie_straddles"] for row in anchors
+            ),
+            "q2_top_ties_with_different_exact_values": sum(
+                row["q2_top_tie_exact_values_differ"] for row in anchors
+            ),
+            "q2_tie_rule_realized_lower_exact_value": sum(
+                row["q2_tie_rule_realized_lower_exact_value"] for row in anchors
+            ),
+            "details": [
+                row
+                for row in anchors
+                if row["exact_top_tie_count"] > 1 or row["q2_top_tie_count"] > 1
+            ],
+        },
+        "shortlists": {},
+        "changed_anchor_r_ge_3_range": quantiles(
+            row["r_ge_3_range_normalized"] for row in changed
+        ),
+        "all_anchor_r_ge_3_range": quantiles(
+            row["r_ge_3_range_normalized"] for row in anchors
+        ),
+        "largest_changed_anchor_r_ge_3_range_normalized": max(
+            (row["r_ge_3_range_normalized"] for row in changed), default=0.0
+        ),
+        "bound_min_slack_normalized": bound_slack_min,
+        "integrity": integrity,
+    }
+    for k in (3, 5, 10):
+        all_gaps = [row["shortlists"][str(k)] for row in anchors]
+        changed_gaps = [row["shortlists"][str(k)] for row in changed]
+        summary["shortlists"][str(k)] = {
+            "exact_recovered_all_anchors": sum(row["exact_recovered"] for row in all_gaps),
+            "exact_recovered_changed_anchors": sum(
+                row["exact_recovered"] for row in changed_gaps
+            ),
+            "gap_normalized_all_anchors": quantiles(row["gap_normalized"] for row in all_gaps),
+            "gap_relative_all_anchors": quantiles(row["gap_relative"] for row in all_gaps),
+            "gap_normalized_changed_anchors": quantiles(
+                row["gap_normalized"] for row in changed_gaps
+            ),
+            "gap_relative_changed_anchors": quantiles(
+                row["gap_relative"] for row in changed_gaps
+            ),
+            "count_all_anchors_gap_exceeds_margin": sum(
+                row["gap_relative"] > MARGIN for row in all_gaps
+            ),
+            "q2_cutoff_tie_anchors": sum(
+                row["q2_cutoff_tie_straddles"] for row in all_gaps
+            ),
+            "q2_cutoff_consequential_tie_anchors": sum(
+                row["q2_cutoff_tie_consequential"] for row in all_gaps
+            ),
+        }
+
+    largest = summary["largest_changed_anchor_r_ge_3_range_normalized"]
+    summary["largest_range_changed_anchors"] = [
+        row for row in changed if row["r_ge_3_range_normalized"] == largest
+    ]
+    summary["changed_anchor_details"] = changed
+    largest_all = max(row["r_ge_3_range_normalized"] for row in anchors)
+    summary["largest_all_anchor_r_ge_3_range_normalized"] = largest_all
+    summary["largest_range_all_anchors"] = [
+        row for row in anchors if row["r_ge_3_range_normalized"] == largest_all
+    ]
+    return summary
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--corpus", type=Path, default=CORPUS)
+    parser.add_argument("--compact", action="store_true")
+    args = parser.parse_args()
+    result = replay(args.corpus)
+    if args.compact:
+        result.pop("changed_anchor_details", None)
+        result.pop("largest_range_changed_anchors", None)
+        result.pop("largest_range_all_anchors", None)
+        result["ties"].pop("details", None)
+    print(json.dumps(result, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

