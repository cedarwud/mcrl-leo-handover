+        "thread_pins": {key: os.environ[key] for key in THREAD_VARS},
+        "process_count": 1,
+        "panel_count": len(frozen),
+        "anchors": anchors,
+        "pooled": pooled,
+        "parity": parity,
+        "peak_rss_bytes": peak_rss_bytes(),
+        "wall_seconds": time.perf_counter() - overall_started,
+    }
