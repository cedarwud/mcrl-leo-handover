#!/usr/bin/env python3
"""Measure the non-learned static family on PANELCEIL's frozen training panel.

This runner deliberately imports PANELCEIL's sealed construction helpers from
the sibling read-only workspace.  It does not read evaluation-only dates and
writes only the local receipt below.
"""

from __future__ import annotations

from collections import Counter
from fractions import Fraction
import hashlib
import importlib.util
import json
import math
import os
from pathlib import Path
import random
import resource
import sys
import time


WORKSPACE = Path("/home/sat/mcrl-v025-rank-ws")
PANELCEIL_WORKSPACE = Path("/home/sat/mcrl-v025-ceiling30-ws")
PANELCEIL_RUNNER = PANELCEIL_WORKSPACE / ".scratch/panelceil/run_panelceil.py"
PANELCEIL_RECEIPT = PANELCEIL_WORKSPACE / ".scratch/panelceil/panelceil-receipt.json"
OUTPUT = WORKSPACE / ".scratch/statics/statics-receipt.json"
PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
THREAD_VARS = (
    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
)
MAX_RSS_BYTES = 5_000_000_000
RANDOM_SEED = 20260910
ARM_NAMES = (
    "RANDOM", "ROUND_ROBIN", "RSS_MAX", "NEAREST_ELIGIBLE",
    "MYOPIC_GREEDY", "FIRST_IMPROVEMENT_FP",
)
EXPECTED_EE_MBIT_J = {
    "NEAREST_ELIGIBLE": 11.027760,
    "FIRST_IMPROVEMENT_FP": 13.430253,
}


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_digest(payload: dict) -> str:
    unsigned = dict(payload)
    unsigned.pop("receipt_sha256", None)
    return hashlib.sha256(json.dumps(
        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("utf-8")).hexdigest()


def atomic_write(payload: dict) -> None:
    payload["receipt_sha256"] = canonical_digest(payload)
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
        encoding="utf-8",
    )
    temporary.replace(OUTPUT)


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def assert_runtime() -> None:
    if sys.executable != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"thread pins are not all one: {bad}")
    if peak_rss_bytes() >= MAX_RSS_BYTES:
        raise MemoryError("peak RSS is not below 5 GB")


def load_panelceil():
    name = "statics_panelceil_reference"
    spec = importlib.util.spec_from_file_location(name, PANELCEIL_RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot import PANELCEIL runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def legal_options(panelceil, tape, step_index: int):
    return panelceil.load_pilot().ENGINE._legal_options(tape, step_index)[0]


def configured(runner, base, mapping, kind: str):
    return runner._configuration(base, mapping, kind=kind)


def random_configuration(runner, tape, step_index: int, base, anchor_index: int):
    options, _ = runner._legal_options(tape, step_index)
    rng = random.Random(RANDOM_SEED + anchor_index)
    mapping = {
        user: (None if not identities else identities[rng.randrange(len(identities))])
        for user, identities in sorted(options.items())
    }
    return configured(runner, base, mapping, "statics-random")


def round_robin_configuration(runner, tape, step_index: int, base):
    options, _ = runner._legal_options(tape, step_index)
    loads: Counter[tuple[int, int]] = Counter()
    mapping = {}
    for user, identities in sorted(options.items()):
        if not identities:
            mapping[user] = None
            continue
        ordinal, identity = min(
            enumerate(identities), key=lambda item: (loads[item[1]], item[0])
        )
        del ordinal
        mapping[user] = identity
        loads[identity] += 1
    return configured(runner, base, mapping, "statics-round-robin")


def rss_max_configuration(runner, tape, step_index: int, base):
    options, _ = runner._legal_options(tape, step_index)
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        raise RuntimeError("frozen exact panel must expose primitive arrays")
    row_of = arrays._row_index()
    mapping = {}
    for user, identities in sorted(options.items()):
        if not identities:
            mapping[user] = None
            continue
        ordinal, identity = min(
            enumerate(identities),
            key=lambda item: (
                -float(arrays.nominal_gain[0, row_of[(user, item[1])]]), item[0]
            ),
        )
        del ordinal
        mapping[user] = identity
    return configured(runner, base, mapping, "statics-rss-max")


def myopic_greedy(panelceil, runner, calibration, tape, step_index: int, base, incumbent, run_setting):
    """One ascending-user exact best-response sweep on nominal boundary zero."""

    evaluator = panelceil.new_selection_evaluator(
        runner, tape, step_index, incumbent, run_setting, field="nominal"
    )
    base_profile = evaluator.evaluate(base)
    guard = panelceil.served(base_profile)
    options, census = runner._legal_options(tape, step_index)
    rekeys = runner._rekeyed_users(tape, step_index)
    current = base
    candidate_evaluations = 0
    changed_users = 0
    for user in sorted(options):
        rows = [current]
        rows.extend(
            panelceil.candidate(
                runner, base, current, user, identity, "statics-myopic-greedy"
            )
            for identity in options[user]
            if identity != current.mapping[user]
        )
        for offset in range(0, len(rows), panelceil.UNILATERAL_BATCH_SIZE):
            evaluator.evaluate_many(rows[offset:offset + panelceil.UNILATERAL_BATCH_SIZE])
        candidate_evaluations += len(rows)
        eligible = []
        for row in rows:
            profile = evaluator._evaluated.get(row.configuration_id)
            if profile is None or panelceil.served(profile) < guard:
                continue
            value: Fraction = panelceil.objective(
                runner, calibration, incumbent, row, profile, rekeys
            )
            eligible.append((value, row.configuration_id, row))
        if not eligible:
            raise RuntimeError("myopic step lost its guarded incumbent")
        selected = min(eligible, key=lambda item: (-item[0], item[1]))[2]
        changed_users += selected.mapping[user] != current.mapping[user]
        current = selected
    return current, {
        "algorithm": "one ascending-user exact greedy sweep",
        "physics": "nominal boundary 0",
        "objective": "F = decoded bits - eta_ref * joules",
        "guard": f"served PHY >= base served PHY ({guard})",
        "tie_break": "lexicographically smallest stable configuration ID",
        "candidate_batch_size": panelceil.UNILATERAL_BATCH_SIZE,
        "candidate_evaluations_including_incumbents": candidate_evaluations,
        "users_changing_choice": changed_users,
        "legal_option_census": census,
    }


def diversity(config, options) -> dict[str, object]:
    mapping = config.mapping
    chosen = [identity for identity in mapping.values() if identity is not None]
    counts = Counter(chosen)
    user_count = len(mapping)
    ordinals = []
    for user, identity in sorted(mapping.items()):
        if identity is None:
            continue
        try:
            ordinals.append(options[user].index(identity))
        except ValueError as error:
            raise RuntimeError(f"user {user} selected a non-legal identity") from error
    return {
        "modal_frac": 0.0 if not counts else max(counts.values()) / user_count,
        "active_beams": len(counts),
        "active_satellites": len({identity[0] for identity in counts}),
        "argmax_distinct": len(set(ordinals)),
        "assigned_users": len(chosen),
        "user_count": user_count,
    }


def committed_one(panelceil, runner, tape, step_index, incumbent, run_setting, name, config):
    return panelceil.committed_metrics(
        runner, tape, step_index, incumbent, run_setting, {name: config}
    )[name]


def pool(anchors, arm: str) -> dict[str, object]:
    rows = [anchor["arms"][arm]["committed"] for anchor in anchors]
    bits = math.fsum(float(row["bits"]) for row in rows)
    joules = math.fsum(float(row["joules"]) for row in rows)
    diversities = [anchor["arms"][arm]["diversity"] for anchor in anchors]
    timings = [anchor["arms"][arm]["timing"] for anchor in anchors]
    result: dict[str, object] = {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count": sum(int(row["served_count"]) for row in rows),
        "rate_target_attained_count": sum(
            int(row["rate_target_attained_count"]) for row in rows
        ),
        "user_count": sum(int(row["user_count"]) for row in rows),
    }
    for field in ("modal_frac", "active_beams", "active_satellites", "argmax_distinct"):
        values = [float(row[field]) for row in diversities]
        result[field] = {
            "mean": math.fsum(values) / len(values),
            "min": min(values),
            "max": max(values),
        }
    for field in ("selection_seconds", "committed_seconds", "wall_seconds"):
        values = [float(row[field]) for row in timings]
        result[field] = {
            "mean": math.fsum(values) / len(values),
            "min": min(values),
            "max": max(values),
            "total": math.fsum(values),
        }
    return result


def main() -> int:
    assert_runtime()
    panelceil = load_panelceil()
    panel = panelceil.frozen_panel()
    source_receipt = json.loads(PANELCEIL_RECEIPT.read_text(encoding="utf-8"))
    if (
        source_receipt.get("status") != "COMPLETE"
        or source_receipt.get("receipt_sha256") != panelceil.canonical_digest(source_receipt)
    ):
        raise RuntimeError("PANELCEIL reference receipt is not sealed and complete")
    pilot = panelceil.load_pilot()
    runner = pilot.ENGINE
    calibration = panelceil.load_calibration(pilot)
    run_setting = runner.run_setting_for("a-r0")
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape

    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
    tape_started = time.perf_counter()
    tape = build_world_tape(
        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
        steps=33, start_time_s=0.0,
    )
    tape_seconds = time.perf_counter() - tape_started
    if peak_rss_bytes() >= MAX_RSS_BYTES:
        raise MemoryError("peak RSS is not below 5 GB after tape")
    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)

    payload = {
        "schema": "mcrl-v025-static-baseline-family-v1",
        "status": "RUNNING",
        "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
        "panel": panel,
        "panel_count": len(panel),
        "panelceil_runner_sha256": sha256(PANELCEIL_RUNNER),
        "panelceil_receipt_sha256": source_receipt["receipt_sha256"],
        "world_tape": {
            "domain": tape.domain, "seed": tape.seed, "digest": tape.digest,
            "construction_seconds": tape_seconds,
        },
        "python": sys.executable,
        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
        "process_count": 1,
        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
        "random_seed": RANDOM_SEED,
        "anchors": [],
    }
    if OUTPUT.exists():
        previous = json.loads(OUTPUT.read_text(encoding="utf-8"))
        if previous.get("panel") != panel or previous.get("random_seed") != RANDOM_SEED:
            raise RuntimeError("existing receipt does not match this frozen construction")
        payload["anchors"] = previous.get("anchors", [])
    completed = {int(row["global_anchor_index"]) for row in payload["anchors"]}

    for position, panel_row in enumerate(panel, 1):
        index = int(panel_row["global_anchor_index"])
        if index in completed:
            print(
                f"anchor {position}/{len(panel)} resume-complete peak RSS "
                f"{peak_rss_bytes()/2**30:.3f} GiB", flush=True,
            )
            continue
        step_index = int(panel_row["step_index"])
        carrier = str(panel_row["carrier"])
        base = runner._base_configuration(tape, step_index, carrier)
        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
        options, _ = runner._legal_options(tape, step_index)

        configs = {}
        selection_seconds = {}
        detail = {}

        started = time.perf_counter()
        configs["NEAREST_ELIGIBLE"] = runner._base_configuration(tape, step_index, carrier)
        selection_seconds["NEAREST_ELIGIBLE"] = time.perf_counter() - started

        started = time.perf_counter()
        configs["RANDOM"] = random_configuration(runner, tape, step_index, base, index)
        selection_seconds["RANDOM"] = time.perf_counter() - started

        started = time.perf_counter()
        configs["ROUND_ROBIN"] = round_robin_configuration(runner, tape, step_index, base)
        selection_seconds["ROUND_ROBIN"] = time.perf_counter() - started

        started = time.perf_counter()
        configs["RSS_MAX"] = rss_max_configuration(runner, tape, step_index, base)
        selection_seconds["RSS_MAX"] = time.perf_counter() - started

        started = time.perf_counter()
        configs["MYOPIC_GREEDY"], detail["MYOPIC_GREEDY"] = myopic_greedy(
            panelceil, runner, calibration, tape, step_index, base, incumbent, run_setting
        )
        selection_seconds["MYOPIC_GREEDY"] = time.perf_counter() - started

        first = panelceil.first_improvement(
            runner, calibration, tape, step_index, base, incumbent, run_setting
        )
        configs["FIRST_IMPROVEMENT_FP"] = first.selected
        selection_seconds["FIRST_IMPROVEMENT_FP"] = float(
            first.receipt["total_including_certificate_seconds"]
        )
        detail["FIRST_IMPROVEMENT_FP"] = first.receipt

        reference_anchor = source_receipt["anchors"][index]
        if (
            configs["NEAREST_ELIGIBLE"].configuration_id
            != reference_anchor["committed"]["BASE"]["configuration_id"]
            or configs["FIRST_IMPROVEMENT_FP"].configuration_id
            != reference_anchor["committed"]["U_FIRST"]["configuration_id"]
        ):
            raise RuntimeError(f"parity configuration mismatch at anchor {index}")

        arms = {}
        for name in ARM_NAMES:
            commit_started = time.perf_counter()
            committed = committed_one(
                panelceil, runner, tape, step_index, incumbent, run_setting,
                name, configs[name],
            )
            committed_seconds = time.perf_counter() - commit_started
            arms[name] = {
                "configuration_id": configs[name].configuration_id,
                "assignments": [
                    [user, None if identity is None else list(identity)]
                    for user, identity in configs[name].assignments
                ],
                "committed": committed,
                "diversity": diversity(configs[name], options),
                "timing": {
                    "selection_seconds": selection_seconds[name],
                    "committed_seconds": committed_seconds,
                    "wall_seconds": selection_seconds[name] + committed_seconds,
                },
                "detail": detail.get(name),
            }

        row = {
            "global_anchor_index": index,
            "anchor_id": f"{panel_row['world_id']}|{step_index}|{carrier}",
            "step_index": step_index,
            "carrier": carrier,
            "arms": arms,
            "peak_rss_bytes": peak_rss_bytes(),
        }
        if row["peak_rss_bytes"] >= MAX_RSS_BYTES:
            raise MemoryError("peak RSS is not below 5 GB")
        payload["anchors"].append(row)
        payload["anchors"].sort(key=lambda item: item["global_anchor_index"])
        payload["pooled"] = {
            arm: pool(payload["anchors"], arm) for arm in ARM_NAMES
        }
        payload["peak_rss_bytes"] = peak_rss_bytes()
        atomic_write(payload)
        print(
            f"anchor {position}/{len(panel)} completed peak RSS "
            f"{peak_rss_bytes()/2**30:.3f} GiB "
            + json.dumps({
                "global": index,
                "myopic_s": round(selection_seconds["MYOPIC_GREEDY"], 3),
                "first_fp_s": round(selection_seconds["FIRST_IMPROVEMENT_FP"], 3),
            }, sort_keys=True),
            flush=True,
        )

    payload["pooled"] = {arm: pool(payload["anchors"], arm) for arm in ARM_NAMES}
    parity = {}
    for arm, expected in EXPECTED_EE_MBIT_J.items():
        observed = float(payload["pooled"][arm]["ee_bit_per_j"]) / 1e6
        parity[arm] = {
            "expected_rounded_6_mbit_per_j": expected,
            "observed_mbit_per_j": observed,
            "rounded_6_match": round(observed, 6) == expected,
            "all_anchor_configuration_ids_match_panelceil": True,
        }
    payload["parity"] = parity
    payload["both_parity_checks_reproduced"] = all(
        bool(row["rounded_6_match"]) for row in parity.values()
    )
    payload["status"] = "COMPLETE" if payload["both_parity_checks_reproduced"] else "PARITY_FAILED"
    payload["peak_rss_bytes"] = peak_rss_bytes()
    payload["completed_wall_seconds"] = time.perf_counter() - tape_started
    atomic_write(payload)
    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
    print(json.dumps({
        arm: payload["pooled"][arm]["ee_bit_per_j"] / 1e6 for arm in ARM_NAMES
    }, sort_keys=True), flush=True)
    print(f"both_parity_checks_reproduced={payload['both_parity_checks_reproduced']}", flush=True)
    return 0 if payload["both_parity_checks_reproduced"] else 2


if __name__ == "__main__":
    raise SystemExit(main())

