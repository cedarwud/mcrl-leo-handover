+#!/usr/bin/env python3
+"""Parity gate for the selection-surface diagnostic.
+
+All selection profiles, including BASE, enter through fresh dense batches.
+The committed endpoints enter through one separate dense full-48 batch.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from fractions import Fraction
+import gc
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-surface-ws")
+PANEL_RUNNER = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/run_panelceil.py")
+OUTPUT = WORKSPACE / ".scratch/surface/parity.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 4_000_000_000
+EXPECTED = {
+    "nominal|best|one": 28.668530,
+    "realised|first|converged": 13.430253,
+}
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def check_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness below 15")
+    bad = {key: os.environ.get(key) for key in THREAD_VARS if os.environ.get(key) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins not one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS is not below 4 GB")
+
+
+def load_panel():
+    name = "surface_panelceil_reference"
+    spec = importlib.util.spec_from_file_location(name, PANEL_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load PANELCEIL runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def fresh_evaluator(panel, runner, tape, step_index, incumbent, run_setting, field, boundaries):
+    return runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field=field, counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=boundaries,
+    )
+
+
+def search(panel, runner, calibration, tape, step_index, base, incumbent, run_setting,
+           *, field: str, rule: str, converged: bool):
+    evaluator = fresh_evaluator(
+        panel, runner, tape, step_index, incumbent, run_setting, field, (0,)
+    )
+    # Dense-populate BASE before it is read.  No scalar cache entry can exist.
+    evaluator.evaluate_many((base,))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    if base_profile is None:
+        raise RuntimeError("dense BASE is invalid")
+    guard = panel.served(base_profile)
+    options, census = runner._legal_options(tape, step_index)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    current = base
+    passes = moves = comparisons = submitted = 0
+    started = time.perf_counter()
+    while True:
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = evaluator._evaluated.get(current.configuration_id)
+            if current_profile is None:
+                raise RuntimeError("current profile absent from dense cache")
+            current_value: Fraction = panel.objective(
+                runner, calibration, incumbent, current, current_profile, rekeys
+            )
+            candidates = tuple(
+                panel.candidate(runner, base, current, user, identity, "surface-parity")
+                for identity in options[user]
+                if identity != current.mapping[user]
+            )
+            accepted = None
+            if rule == "first":
+                for offset in range(0, len(candidates), panel.UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + panel.UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                    for row in batch:
+                        comparisons += 1
+                        profile = evaluator._evaluated.get(row.configuration_id)
+                        if profile is None or panel.served(profile) < guard:
+                            continue
+                        value = panel.objective(
+                            runner, calibration, incumbent, row, profile, rekeys
+                        )
+                        if value > current_value:
+                            accepted = row
+                            break
+                    if accepted is not None:
+                        break
+            elif rule == "best":
+                # Incumbent participates in the same dense comparison and tie rule
+                # as the published one-sweep arm.
+                for offset in range(0, len(candidates), panel.UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + panel.UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                eligible = [(current_value, current.configuration_id, current)]
+                for row in candidates:
+                    comparisons += 1
+                    profile = evaluator._evaluated.get(row.configuration_id)
+                    if profile is None or panel.served(profile) < guard:
+                        continue
+                    value = panel.objective(
+                        runner, calibration, incumbent, row, profile, rekeys
+                    )
+                    eligible.append((value, row.configuration_id, row))
+                selected = min(eligible, key=lambda item: (-item[0], item[1]))[2]
+                if selected.mapping[user] != current.mapping[user]:
+                    accepted = selected
+            else:
+                raise ValueError(rule)
+            if accepted is not None:
+                current = accepted
+                moves += 1
+                moves_this_pass += 1
+        passes += 1
+        if not converged or moves_this_pass == 0:
+            break
+        if passes > 100:
+            raise RuntimeError("search exceeded 100 passes")
+    detail = {
+        "field": field, "rule": rule,
+        "passes_mode": "converged" if converged else "one",
+        "passes": passes, "moves": moves, "guard": guard,
+        "comparisons": comparisons, "submitted": submitted,
+        "legal_option_census": census,
+        "selection_seconds": time.perf_counter() - started,
+        "base_was_dense_populated": True,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return current, detail
+
+
+def diversity(config) -> dict[str, float | int]:
+    counts = Counter(identity for identity in config.mapping.values() if identity is not None)
+    users = len(config.mapping)
+    return {
+        "modal_frac": 0.0 if not counts else max(counts.values()) / users,
+        "active_beams": len(counts),
+        "active_satellites": len({identity[0] for identity in counts}),
+    }
+
+
+def main() -> int:
+    check_runtime()
+    panel = load_panel()
+    frozen = panel.frozen_panel()
+    pilot = panel.load_pilot()
+    runner = pilot.ENGINE
+    calibration = panel.load_calibration(pilot)
+    run_setting = runner.run_setting_for("a-r0")
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    overall_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33, start_time_s=0.0,
+    )
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)
+    anchors = []
+    for position, panel_row in enumerate(frozen, 1):
+        index = int(panel_row["global_anchor_index"])
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        configs = {}
+        details = {}
+        cell = "nominal|best|one"
+        configs[cell], details[cell] = search(
+            panel, runner, calibration, tape, step_index, base, incumbent, run_setting,
+            field="nominal", rule="best", converged=False,
+        )
+        cell = "realised|first|converged"
+        configs[cell], details[cell] = search(
+            panel, runner, calibration, tape, step_index, base, incumbent, run_setting,
+            field="realised", rule="first", converged=True,
+        )
+        endpoint = fresh_evaluator(
+            panel, runner, tape, step_index, incumbent, run_setting,
+            "realised", tuple(range(48)),
+        )
+        endpoint.evaluate_many(tuple(configs.values()))
+        metrics = {
+            name: panel.metric(endpoint._evaluated[config.configuration_id])
+            for name, config in configs.items()
+        }
+        anchors.append({
+            "global_anchor_index": index, "step_index": step_index, "carrier": carrier,
+            "cells": {
+                name: {
+                    "configuration_id": configs[name].configuration_id,
+                    "selection": details[name], "committed": metrics[name],
+                    "diversity": diversity(configs[name]),
+                }
+                for name in configs
+            },
+        })
+        del endpoint
+        gc.collect()
+        check_runtime()
+        print(
+            f"anchor {position}/{len(frozen)} completed peak RSS "
+            f"{peak_rss_bytes()/2**30:.3f} GiB", flush=True,
+        )
+
+    pooled = {}
+    for name in EXPECTED:
+        rows = [row["cells"][name] for row in anchors]
+        bits = math.fsum(float(row["committed"]["bits"]) for row in rows)
+        joules = math.fsum(float(row["committed"]["joules"]) for row in rows)
+        pooled[name] = {
+            "bits": bits, "joules": joules, "ee_mbit_per_j": bits / joules / 1e6,
+            "served_count": sum(int(row["committed"]["served_count"]) for row in rows),
+            "rate_target_attained_count": sum(
+                int(row["committed"]["rate_target_attained_count"]) for row in rows
+            ),
+            "modal_frac_mean": math.fsum(float(row["diversity"]["modal_frac"]) for row in rows) / len(rows),
+            "active_beams_mean": math.fsum(float(row["diversity"]["active_beams"]) for row in rows) / len(rows),
+            "active_satellites_mean": math.fsum(float(row["diversity"]["active_satellites"]) for row in rows) / len(rows),
+            "selection_seconds": math.fsum(float(row["selection"]["selection_seconds"]) for row in rows),
+        }
+    parity = {
+        name: {
+            "expected_rounded_6": expected,
+            "observed": pooled[name]["ee_mbit_per_j"],
+            "rounded_6_match": round(float(pooled[name]["ee_mbit_per_j"]), 6) == expected,
+        }
+        for name, expected in EXPECTED.items()
+    }
+    passed = all(row["rounded_6_match"] for row in parity.values())
+    payload = {
+        "schema": "mcrl-v025-selection-surface-parity-v1",
+        "status": "PASS" if passed else "PARITY_FAILED",
+        "claim_status": "DESIGN_PHASE_DIAGNOSTIC_NOT_A_CLAIM",
+        "dense_base_only": True,
+        "python": sys.executable,
+        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+        "thread_pins": {key: os.environ[key] for key in THREAD_VARS},
+        "process_count": 1,
+        "panel_count": len(frozen),
+        "anchors": anchors,
+        "pooled": pooled,
+        "parity": parity,
+        "peak_rss_bytes": peak_rss_bytes(),
+        "wall_seconds": time.perf_counter() - overall_started,
+    }
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    OUTPUT.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(json.dumps({"parity": parity, "pooled": pooled}, sort_keys=True), flush=True)
+    return 0 if passed else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

