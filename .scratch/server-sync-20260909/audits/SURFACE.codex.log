def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_digest(payload: Mapping[str, object]) -> str:
    unsigned = dict(payload)
    unsigned.pop("receipt_sha256", None)
    return hashlib.sha256(json.dumps(
        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("utf-8")).hexdigest()


def atomic_write(payload: dict) -> None:
    payload["receipt_sha256"] = canonical_digest(payload)
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
        encoding="utf-8",
    )
    temporary.replace(OUTPUT)


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def assert_rss() -> int:
    value = peak_rss_bytes()
    if value >= MAX_RSS_BYTES:
        raise MemoryError(f"peak RSS {value} is not below 5 GB")
    return value


def assert_runtime() -> None:
    if sys.executable != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("niceness is below 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"thread pins are not all one: {bad}")


def load_pilot():
    if sha256(PILOT_PATH) != PILOT_SHA256:
        raise RuntimeError("source pilot changed after panel freeze")
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    name = "panelceil_exactgen2_pilot"
    spec = importlib.util.spec_from_file_location(name, PILOT_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot import source pilot")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def load_calibration(pilot):
    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
    def ratio(name: str) -> Fraction:
        numerator, denominator = payload[name]
        return Fraction(numerator, denominator)
    return pilot.PilotCalibration(
        eta_ref=ratio("eta_ref"),
        lambda_bits_per_j=ratio("lambda_bits_per_j"),
        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
        bits_ref=ratio("bits_ref"),
        joules_ref=ratio("joules_ref"),
        users=int(payload["users"]),
    )


def frozen_panel() -> list[dict[str, object]]:
    rows = []
    for index, expected_hash in enumerate(RESULT_SHA256):
        root = STAGING / f"global-{index:03d}"
        result_path = root / f"BUILD_NOT_CLAIM-anchor-{index:03d}.result.json"
        if not result_path.is_file() or sha256(result_path) != expected_hash:
            raise RuntimeError(f"frozen result absent or changed: {result_path}")
        row = json.loads(result_path.read_text(encoding="utf-8"))
        step, carrier_index = divmod(index, len(CARRIERS))
        if (
            row["global_anchor_index"] != index
            or row["world_index"] != 1
            or row["step_index"] != step
            or row["carrier_index"] != carrier_index
            or row["carrier"] != CARRIERS[carrier_index]
        ):
            raise RuntimeError(f"declared-order mismatch at anchor {index}")
        physics_path = root / "physics" / str(row["physics_relative_path"])
        if not physics_path.is_file() or sha256(physics_path) != row["physics_sha256"]:
            raise RuntimeError(f"physics shard absent or changed at anchor {index}")
        rows.append({
            "global_anchor_index": index,
            "world_index": 1,
            "world_id": row["world_id"],
            "step_index": step,
            "carrier_index": carrier_index,
            "carrier": row["carrier"],
            "result_path": str(result_path),
            "result_sha256": expected_hash,
            "physics_path": str(physics_path),
            "physics_sha256": row["physics_sha256"],
            "rows": row["row_count"],
            "configurations": row["configuration_count"],
        })
    return rows


def source_base_metric(panel_row: Mapping[str, object]) -> tuple[dict, dict]:
    context = None
    base = None
    with Path(str(panel_row["physics_path"])).open(encoding="utf-8") as handle:
        header = json.loads(next(handle))
        for line in handle:
            row = json.loads(line)
            if row["schema"] == "mcrl-v025-exact-source-anchor-context-v1":
                context = row
            elif (
                row["schema"] == "mcrl-v025-exact-source-configuration-physics-v1"
                and row["delta_from_default"] == []
            ):
                base = row["current"]
            if context is not None and base is not None:
                break
    if context is None or base is None:
        raise RuntimeError("physics shard omitted anchor context or default profile")
    if header["global_anchor_index"] != panel_row["global_anchor_index"]:
        raise RuntimeError("physics header anchor mismatch")
    return context, base


def exact_float(value: float) -> Fraction:
    if not math.isfinite(value):
        raise RuntimeError("non-finite exact coefficient")
    return Fraction.from_float(float(value))


def served(profile) -> int:
    return sum(bool(value) for value in profile.score.served_phy.values())


def objective(runner, calibration, incumbent, config, profile, rekeys) -> Fraction:
    # Match the standing anytime and coordination oracle: exact system
    # objective F = B - eta_ref E.  Phi belongs to the source-label
    # decomposition, not to either quoted ceiling's fixed-point construction.
    return runner._objective(profile, calibration)


def candidate(runner, base, current, user: int, identity, kind: str):
    mapping = dict(current.mapping)
    mapping[user] = identity
    return runner._configuration(base, mapping, kind=kind)


def new_selection_evaluator(
    runner, tape, step_index, incumbent, run_setting, *, field="realised"
):
    return runner.StepEvaluator(
        tape,
        runner._setting("a-r0"),
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
        field=field,
        counter=runner.EvaluationCounter(),
        run_setting=run_setting,
        boundary_indices=(0,),
    )


@dataclass
class SearchRun:
    selected: object
    moves: list[tuple[float, object]]
    receipt: dict[str, object]
    best_alternatives: dict[int, tuple[int, int]]


def first_improvement(runner, calibration, tape, step_index, base, incumbent, run_setting) -> SearchRun:
    evaluator = new_selection_evaluator(runner, tape, step_index, incumbent, run_setting)
    base_profile = evaluator.evaluate(base)  # F2: validated a0 exists before coordinator time.
    guard = served(base_profile)
    started = time.perf_counter()
    options, census = runner._legal_options(tape, step_index)
    options, census = runner._legal_options(tape, step_index)
    rekeys = runner._rekeyed_users(tape, step_index)
    current = base
    moves: list[tuple[float, object]] = [(0.0, base)]
    passes_with_moves = comparisons = submissions = 0
    while True:
        pass_started = time.perf_counter() - started
        moves_this_pass = 0
        terminal_counts = {
            "legal_unilateral_alternatives_evaluated": 0,
            "physically_invalid_alternatives": 0,
            "service_guard_rejected_alternatives": 0,
            "strictly_improving_alternatives": 0,
        }
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(
                runner, calibration, incumbent, current, current_profile, rekeys
            )
            identities = [row for row in options[user] if row != current.mapping[user]]
            accepted = None
            for offset in range(0, len(identities), UNILATERAL_BATCH_SIZE):
                batch = tuple(candidate(
                    runner, base, current, user, identity,
                    "panelceil-first-improvement",
                ) for identity in identities[offset:offset + UNILATERAL_BATCH_SIZE])
                evaluator.evaluate_many(batch)
                submissions += len(batch)
                terminal_counts["legal_unilateral_alternatives_evaluated"] += len(batch)
                for row in batch:
                    comparisons += 1
                    profile = evaluator._evaluated.get(row.configuration_id)
                    if profile is None:
                        terminal_counts["physically_invalid_alternatives"] += 1
                        continue
                    if served(profile) < guard:
                        terminal_counts["service_guard_rejected_alternatives"] += 1
                        continue
                    value = objective(runner, calibration, incumbent, row, profile, rekeys)
                    if value > current_value:
                        terminal_counts["strictly_improving_alternatives"] += 1
                        accepted = row
                        break
                if accepted is not None:
                    current = accepted
                    moves_this_pass += 1
                    moves.append((time.perf_counter() - started, current))
                    break
        pass_finished = time.perf_counter() - started
        if moves_this_pass == 0:
            if terminal_counts["strictly_improving_alternatives"] != 0:
                raise RuntimeError("zero-move certificate contains an improvement")
            break
        passes_with_moves += 1

    best_alternatives = {}
    for user in sorted(options):
        rows = []
        for identity in options[user]:
            if identity == current.mapping[user]:
                continue
            row = candidate(runner, base, current, user, identity, "panelceil-terminal-alternate")
            profile = evaluator._evaluated.get(row.configuration_id)
            if profile is not None:
                rows.append((
                    objective(runner, calibration, incumbent, row, profile, rekeys),
                    row.configuration_id,
                    identity,
                ))
        if rows:
            best_alternatives[user] = min(rows, key=lambda item: (-item[0], item[1]))[2]
    return SearchRun(current, moves, {
        "algorithm": "deterministic cyclic first-improvement",
        "candidate_order": "ascending user ID; each user's declared legal-option order",
        "microbatch_size": UNILATERAL_BATCH_SIZE,
        "baseline_served_guard": guard,
        "legal_option_census": census,
        "accepted_moves": len(moves) - 1,
        "passes_with_moves": passes_with_moves,
        "total_passes_including_certificate": passes_with_moves + 1,
        "candidate_comparisons_through_certificate": comparisons,
        "physically_submitted_candidates_through_certificate": submissions,
        "last_improvement_seconds": moves[-1][0],
        "finding_seconds": pass_started,
        "terminal_certificate_seconds": pass_finished - pass_started,
        "total_including_certificate_seconds": pass_finished,
        "termination_certificate": {
            "complete": True,
            "statement": "Every legal unilateral alternative was evaluated at the final iterate and none strictly improves guarded F.",
            **terminal_counts,
        },
    }, best_alternatives)


def best_improvement(runner, calibration, tape, step_index, base, incumbent, run_setting) -> SearchRun:
    evaluator = new_selection_evaluator(runner, tape, step_index, incumbent, run_setting)
    base_profile = evaluator.evaluate(base)
    guard = served(base_profile)
    started = time.perf_counter()
    options, census = runner._legal_options(tape, step_index)
    rekeys = runner._rekeyed_users(tape, step_index)
    current = base
    moves: list[tuple[float, object]] = [(0.0, base)]
    passes_with_moves = comparisons = 0
    while True:
        pass_started = time.perf_counter() - started
        moves_this_pass = 0
        terminal_counts = {
            "legal_unilateral_alternatives_evaluated": 0,
            "physically_invalid_alternatives": 0,
            "service_guard_rejected_alternatives": 0,
            "strictly_improving_alternatives": 0,
        }
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(
                runner, calibration, incumbent, current, current_profile, rekeys
            )
            candidates = tuple(candidate(
                runner, base, current, user, identity,
                "panelceil-best-improvement",
            ) for identity in options[user] if identity != current.mapping[user])
            for offset in range(0, len(candidates), UNILATERAL_BATCH_SIZE):
                evaluator.evaluate_many(
                    candidates[offset:offset + UNILATERAL_BATCH_SIZE]
                )
            terminal_counts["legal_unilateral_alternatives_evaluated"] += len(candidates)
            improving = []
            for row in candidates:
                comparisons += 1
                profile = evaluator._evaluated.get(row.configuration_id)
                if profile is None:
                    terminal_counts["physically_invalid_alternatives"] += 1
                    continue
                if served(profile) < guard:
                    terminal_counts["service_guard_rejected_alternatives"] += 1
                    continue
                value = objective(runner, calibration, incumbent, row, profile, rekeys)
                if value > current_value:
                    terminal_counts["strictly_improving_alternatives"] += 1
                    improving.append((value, row.configuration_id, row))
            if improving:
                current = min(improving, key=lambda item: (-item[0], item[1]))[2]
                moves_this_pass += 1
                moves.append((time.perf_counter() - started, current))
        pass_finished = time.perf_counter() - started
        if moves_this_pass == 0:
            if terminal_counts["strictly_improving_alternatives"] != 0:
                raise RuntimeError("zero-move best-improvement certificate contains an improvement")
            break
        passes_with_moves += 1
    return SearchRun(current, moves, {
        "algorithm": "deterministic cyclic best-improvement",
        "candidate_order": "ascending user ID; declared legal options in ordered microbatches of 16; exact best response per user; stable configuration-ID tie-break",
        "microbatch_size": UNILATERAL_BATCH_SIZE,
        "baseline_served_guard": guard,
        "legal_option_census": census,
        "accepted_moves": len(moves) - 1,
        "passes_with_moves": passes_with_moves,
        "total_passes_including_certificate": passes_with_moves + 1,
        "candidate_comparisons_through_certificate": comparisons,
        "last_improvement_seconds": moves[-1][0],
        "finding_seconds": pass_started,
        "terminal_certificate_seconds": pass_finished - pass_started,
        "total_including_certificate_seconds": pass_finished,
        "termination_certificate": {
            "complete": True,
            "statement": "Every legal unilateral alternative was evaluated at the final iterate and none strictly improves guarded F.",
            **terminal_counts,
        },
    }, {})


def interference_contributors(tape, step_index: int, current, victim: int) -> tuple[int, ...]:
    mapping = current.mapping
    victim_beam = mapping[victim]
    if victim_beam is None:
        return ()
    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        raise RuntimeError("exact panel requires primitive arrays")
    victim_row = arrays._row_index().get((victim, victim_beam))
    aggressor_of = arrays._aggressor_index()
    if victim_row is None:
        return ()
    scores = []
    for user, beam in sorted(mapping.items()):
        if user == victim or beam is None or beam == victim_beam:
            continue
        column = aggressor_of.get(beam)
        if column is None:
            continue
        score = arrays._cross_at_index(0, victim_row, column)[0] / occupancy[beam]
        if score > 0.0:
            scores.append((score, user))
    return tuple(user for _, user in sorted(scores, key=lambda item: (-item[0], item[1])))


def build_joint_candidates(runner, tape, step_index: int, base, unilateral, best_alternatives):
    options, _ = runner._legal_options(tape, step_index)
    current = unilateral.mapping
    by_beam = {
        beam: tuple(user for user, identity in sorted(current.items()) if identity == beam)
        for beam in sorted({identity for identity in current.values() if identity is not None})
    }
    aliases: dict[tuple, list[dict[str, object]]] = {}
    configs = {}
    families = Counter()
    def add(mapping, family: str, coalition: Sequence[int], detail: str) -> None:
        changed = tuple(user for user in sorted(current) if mapping[user] != current[user])
        if len(changed) < 2:
            return
        assignments = tuple(sorted(mapping.items()))
        aliases.setdefault(assignments, []).append({
            "family": family, "coalition_users": list(sorted(coalition)),
            "changed_users": list(changed), "detail": detail,
        })
        if assignments not in configs:
            configs[assignments] = runner._configuration(base, mapping, kind=family)
            families[family] += 1
    occupant_rows = 0
    for beam, occupants in by_beam.items():
        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
            for coalition in itertools.combinations(occupants, size):
                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                    break
                if any(user not in best_alternatives for user in coalition):
                    continue
                mapping = dict(current)
                for user in coalition:
                    mapping[user] = best_alternatives[user]
                add(mapping, "beam-occupant-subset", coalition,
                    f"origin={beam[0]}:{beam[1]};size={size}")
                occupant_rows += 1
            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                break
        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
            break
    for victim in sorted(current):
        if victim not in best_alternatives:
            continue
        contributors = interference_contributors(tape, step_index, unilateral, victim)
        for count in (2, 3):
            if len(contributors) < count:
                continue
            coalition = (victim, *contributors[:count])
            if any(user not in best_alternatives for user in coalition):
                continue
            mapping = dict(current)
            for user in coalition:
                mapping[user] = best_alternatives[user]
            add(mapping, f"victim-plus-top-{count}-contributors", coalition,
                f"victim={victim};contributors={','.join(map(str, contributors[:count]))}")
    for beam, occupants in by_beam.items():
        if len(occupants) < 2:
            continue
        common = set(options[occupants[0]])
        for user in occupants[1:]:
            common.intersection_update(options[user])
        common.discard(beam)
        for destination in sorted(common):
            mapping = dict(current)
            for user in occupants:
                mapping[user] = destination
            add(mapping, "complete-beam-evacuation", occupants,
                f"origin={beam[0]}:{beam[1]};destination={destination[0]}:{destination[1]}")
    ordered = tuple(configs[key] for key in sorted(configs))
    if len(ordered) > JOINT_CANDIDATE_CAP:
        raise RuntimeError(f"joint catalogue {len(ordered)} exceeds {JOINT_CANDIDATE_CAP}")
    return ordered, aliases, dict(sorted(families.items()))


def joint_optimum(runner, calibration, tape, step_index, base, incumbent, run_setting, first):
    evaluator = new_selection_evaluator(runner, tape, step_index, incumbent, run_setting)
    base_profile = evaluator.evaluate(base)
    seed_profile = evaluator.evaluate(first.selected)
    guard = served(base_profile)
    candidates, aliases, families = build_joint_candidates(
        runner, tape, step_index, base, first.selected, first.best_alternatives
    )
    before = evaluator.counter.boundary_evaluations
    for offset in range(0, len(candidates), JOINT_BATCH_SIZE):
        evaluator.evaluate_many(candidates[offset:offset + JOINT_BATCH_SIZE])
    best = first.selected
    best_profile = seed_profile
    rekeys = runner._rekeyed_users(tape, step_index)
    qualifying = 0
    for row in candidates:
        profile = evaluator._evaluated.get(row.configuration_id)
        if profile is None or served(profile) < guard:
            continue
        value = objective(runner, calibration, incumbent, row, profile, rekeys)
        best_value = objective(runner, calibration, incumbent, best, best_profile, rekeys)
        if value > objective(runner, calibration, incumbent, first.selected, seed_profile, rekeys):
            qualifying += 1
        if value > best_value or (
            value == best_value and best is not first.selected
            and row.configuration_id < best.configuration_id
        ):
            best, best_profile = row, profile
    changed = [user for user in sorted(first.selected.mapping)
               if first.selected.mapping[user] != best.mapping[user]]
    return best, {
        "catalogue_unique": len(candidates),
        "catalogue_aliases": sum(len(value) for value in aliases.values()),
        "family_unique_counts": families,
        "joint_boundary_evaluations": evaluator.counter.boundary_evaluations - before,
        "qualifying_strict_objective_improvements": qualifying,
        "strict_selection_objective_improvement": best.assignments != first.selected.assignments,
        "selected_coalition_size": len(changed),
        "selected_coalition_users": changed,
    }


def config_at(run: SearchRun, seconds: float):
    selected = run.moves[0][1]
    for accepted, config in run.moves[1:]:
        if accepted > seconds:
            break
        selected = config
    return selected


def metric(profile) -> dict[str, object]:
    attained = profile.score.rate_target_attained
    if attained is None:
        raise RuntimeError("committed profile omitted rate-target attainment")
    return {
        "configuration_id": profile.config.configuration_id,
        "assignments": [[user, None if identity is None else list(identity)]
                        for user, identity in profile.config.assignments],
        "bits": float(profile.bits),
        "joules": float(profile.joules),
        "ee_bit_per_j": float(profile.bits) / float(profile.joules),
        "served_count": served(profile),
        "rate_target_attained_count": sum(bool(value) for value in attained.values()),
        "user_count": len(attained),
    }


def committed_metrics(runner, tape, step_index, incumbent, run_setting, configs):
    evaluator = runner.StepEvaluator(
        tape, runner._setting("a-r0"), step_index,
        transition_from=incumbent,
        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
        field="realised", counter=runner.EvaluationCounter(),
        run_setting=run_setting, boundary_indices=tuple(range(48)),
    )
    result = {}
    for name, config in configs.items():
        evaluator.evaluate_many((config,))
        profile = evaluator._evaluated.get(config.configuration_id)
        if profile is None:
            raise RuntimeError(f"invalid committed config for {name}")
        result[name] = metric(profile)
    return result


def context_mapping(rows) -> dict[int, tuple[int, int] | None]:
    return {
    return {
        int(user): (None if identity is None else (int(identity[0]), int(identity[1])))
        for user, identity in rows
    }


def verify_source_base(runner, profile, incumbent, context: Mapping[str, object], source: Mapping[str, object]) -> dict[str, object]:
    if profile.config.configuration_id != context["default_configuration_id"]:
        raise RuntimeError("reconstructed base configuration differs from exact corpus")
    if dict(profile.config.mapping) != context_mapping(context["default_mapping"]):
        raise RuntimeError("reconstructed base mapping differs from exact corpus")
    if dict(incumbent.mapping) != context_mapping(context["incumbent_mapping"]):
        raise RuntimeError("reconstructed incumbent mapping differs from exact corpus")
    source_bits = float.fromhex(str(source["whole_network_bits_hex"]))
    source_joules = float.fromhex(str(source["whole_network_joules_hex"]))
    source_served = sum(bool(row["served_phy"]) for row in source["per_user"])
    return {
        "configuration_id_exact_match": True,
        "default_mapping_exact_match": True,
        "incumbent_mapping_exact_match": True,
        "served_count_exact_match": served(profile) == source_served,
        "singleton_served_count": served(profile),
        "corpus_dense_batch_served_count": source_served,
        "bits_close_rel_1e_10": math.isclose(
            float(profile.bits), source_bits, rel_tol=1e-10, abs_tol=1e-5
        ),
        "joules_close_rel_1e_10": math.isclose(
            float(profile.joules), source_joules, rel_tol=1e-10, abs_tol=1e-10
        ),
        "bits": float(profile.bits) - source_bits,
        "joules": float(profile.joules) - source_joules,
        "ee_bit_per_j": (
            float(profile.bits) / float(profile.joules) - source_bits / source_joules
        ),
        "explanation": (
            "The corpus recorded this configuration inside its complete dense action batch; "
            "the oracle harness evaluates it as a singleton. Configuration ID plus the "
            "complete default and incumbent mappings are required to match; metric and PHY "
            "service-threshold differences are retained rather than silently treated as "
            "provenance failure."
        ),
    }


def pool(rows: Sequence[Mapping[str, object]], name: str) -> dict[str, object]:
    metrics = [row["committed"][name] for row in rows]
    bits = math.fsum(float(row["bits"]) for row in metrics)
    joules = math.fsum(float(row["joules"]) for row in metrics)
    return {
        "bits": bits, "joules": joules, "ee_bit_per_j": bits / joules,
        "served_count": sum(int(row["served_count"]) for row in metrics),
        "rate_target_attained_count": sum(int(row["rate_target_attained_count"]) for row in metrics),
        "user_count": sum(int(row["user_count"]) for row in metrics),
    }


def summarize(rows: Sequence[Mapping[str, object]]) -> dict[str, object]:
    names = ("BASE", "U_FIRST", "U_BEST", "J_FROM_FIRST", *(
        f"U_FIRST_AT_{seconds:g}" for seconds in CHECKPOINTS
    ))
    pooled = {name: pool(rows, name) for name in names}
    coordination = []
    for row in rows:
        u = row["committed"]["U_FIRST"]["ee_bit_per_j"]
        j = row["committed"]["J_FROM_FIRST"]["ee_bit_per_j"]
        coordination.append({
            "global_anchor_index": row["global_anchor_index"],
            "relative_ee_gain": j / u - 1.0,
        })
    return {
        "pooled": pooled,
        "coordination_ceiling_relative_to_first": (
            pooled["J_FROM_FIRST"]["ee_bit_per_j"] / pooled["U_FIRST"]["ee_bit_per_j"] - 1.0
        ),
        "coordination_per_anchor": coordination,
        "coordination_non_positive_anchor_count": sum(row["relative_ee_gain"] <= 0 for row in coordination),
        "traversal_order_gap_first_over_best": (
            pooled["U_FIRST"]["ee_bit_per_j"] / pooled["U_BEST"]["ee_bit_per_j"] - 1.0
        ),
        "acceleration_headroom_convergence_over_10s": (
            pooled["U_FIRST"]["ee_bit_per_j"] / pooled["U_FIRST_AT_10"]["ee_bit_per_j"] - 1.0
        ),
    }


def main() -> int:
    assert_runtime()
    panel = frozen_panel()
    pilot = load_pilot()
    runner = pilot.ENGINE
    calibration = load_calibration(pilot)
    run_setting = runner.run_setting_for("a-r0")
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape
    print("panel " + json.dumps([
        f"{row['world_id']}|step={row['step_index']}|carrier={row['carrier']}"
        for row in panel
    ]), flush=True)
    print(f"peak RSS {peak_rss_bytes() / 2**30:.3f} GiB before tape", flush=True)
    tape_started = time.perf_counter()
    tape = build_world_tape(
        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
        steps=33, start_time_s=0.0,
    )
    tape_wall = time.perf_counter() - tape_started
    print(f"peak RSS {assert_rss() / 2**30:.3f} GiB after tape", flush=True)
    payload = {
        "schema": "mcrl-v025-training-panel-ceilings-v1",
        "status": "RUNNING",
        "claim_status": "EXACT_ORACLE_DIAGNOSTIC_NOT_LEARNED_ACHIEVEMENT",
        "panel_frozen_at_start": panel,
        "panel_count": len(panel),
        "panel_prefix_rule": "completed global indices 0..11 present at task start in declared order",
        "world_tape": {
            "domain": tape.domain, "seed": tape.seed,
            "digest": tape.digest, "construction_seconds": tape_wall,
        },
        "calibration": calibration.payload(),
        "selection_information_class": "exact realised boundary-0 joint physics; no future-boundary information; system F = B - eta_ref*E",
        "selection_estimand": "strict guarded improvement in exact F at realised boundary 0",
        "committed_estimand": "pooled sum(full-buffer decoded bits)/sum(modelled partial-payload DC joules) over 48 realised boundaries",
        "numerator": "declared saturated full-buffer successfully decoded forward-downlink information bits; no demand cap",
        "fixed_point_orders": {
            "first": "ascending users; declared legal options; first strict improvement in ordered microbatches of 16",
            "best": "ascending users; declared legal-option order in microbatches of 16; exact best strict response per user; stable configuration-ID tie-break",
        },
        "timing_contract": "a0 constructed and validated before timer; timer includes legal-option construction and exact search; one process; only moves whose evaluation completed by checkpoint are credited",
        "joint_catalogue": {
            "construction": "reseeded from U_FIRST: within-beam occupant subsets size 2..4, victim plus top-2/top-3 physical nominal interferers, complete-beam evacuations",
            "occupant_subset_total_cap": OCCUPANT_SUBSET_TOTAL_CAP,
            "joint_candidate_cap": JOINT_CANDIDATE_CAP,
            "exhausted": True,
        },
        "process_count": 1,
        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
        "python": sys.executable,
        "pilot_sha256": sha256(PILOT_PATH),
        "engine_sha256": sha256(SOURCE_ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"),
        "anchors": [],
    }
    if OUTPUT.exists():
        previous = json.loads(OUTPUT.read_text(encoding="utf-8"))
        if previous.get("panel_frozen_at_start") != panel:
            raise RuntimeError("resume panel differs from frozen panel")
        payload["anchors"] = previous.get("anchors", [])
    completed = {int(row["global_anchor_index"]) for row in payload["anchors"]}
    for position, panel_row in enumerate(panel, 1):
        index = int(panel_row["global_anchor_index"])
        if index in completed:
            print(f"anchor {position}/{len(panel)} resume-complete peak RSS {assert_rss()/2**30:.3f} GiB", flush=True)
            continue
        step_index = int(panel_row["step_index"])
        carrier = str(panel_row["carrier"])
        base = runner._base_configuration(tape, step_index, carrier)
        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
        context, corpus_base = source_base_metric(panel_row)
        check_evaluator = new_selection_evaluator(
            runner, tape, step_index, incumbent, run_setting, field="nominal"
        )
        source_base_delta = verify_source_base(
            runner, check_evaluator.evaluate(base), incumbent, context, corpus_base
        )
        anchor_started = time.perf_counter()
        first = first_improvement(
            runner, calibration, tape, step_index, base, incumbent, run_setting
        )
        best = best_improvement(
            runner, calibration, tape, step_index, base, incumbent, run_setting
        )
        joint, joint_receipt = joint_optimum(
            runner, calibration, tape, step_index, base, incumbent, run_setting, first
        )
        configs = {
            "BASE": base,
            "U_FIRST": first.selected,
            "U_BEST": best.selected,
            "J_FROM_FIRST": joint,
        }
        configs.update({
            f"U_FIRST_AT_{seconds:g}": config_at(first, seconds)
            for seconds in CHECKPOINTS
        })
        committed = committed_metrics(
            runner, tape, step_index, incumbent, run_setting, configs
        )
        row = {
            "global_anchor_index": index,
            "anchor_id": f"{panel_row['world_id']}|{step_index}|{carrier}",
            "world_id": panel_row["world_id"],
            "step_index": step_index,
            "carrier": carrier,
            "source_base_configuration_and_incumbent_mappings_verified": True,
            "source_base_singleton_minus_corpus_dense_batch": source_base_delta,
            "first_improvement": first.receipt,
            "best_improvement": best.receipt,
            "joint_selection": joint_receipt,
            "committed": committed,
            "anchor_wall_seconds": time.perf_counter() - anchor_started,
            "peak_rss_bytes": assert_rss(),
        }
        payload["anchors"].append(row)
        payload["anchors"].sort(key=lambda item: item["global_anchor_index"])
        payload["summary"] = summarize(payload["anchors"])
        payload["peak_rss_bytes"] = assert_rss()
        atomic_write(payload)
        print(
            f"anchor {position}/{len(panel)} completed peak RSS {payload['peak_rss_bytes']/2**30:.3f} GiB "
            + json.dumps({
                "global": index, "step": step_index, "carrier": carrier,
                "first_s": round(first.receipt["total_including_certificate_seconds"], 3),
                "best_s": round(best.receipt["total_including_certificate_seconds"], 3),
                "joint_n": joint_receipt["catalogue_unique"],
                "wall_s": round(row["anchor_wall_seconds"], 3),
            }, sort_keys=True),
            flush=True,
        )
    payload["status"] = "COMPLETE"
    payload["summary"] = summarize(payload["anchors"])
    payload["peak_rss_bytes"] = assert_rss()
    payload["completed_wall_seconds"] = time.perf_counter() - tape_started
    atomic_write(payload)
    print(f"peak RSS {payload['peak_rss_bytes']/2**30:.3f} GiB final ({payload['peak_rss_bytes']} bytes)", flush=True)
    print(json.dumps(payload["summary"], sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

codex
The existing static runner exposes the exact failure mode warned about in the task: it calls scalar `evaluate(BASE)` before dense candidate batches. I will not reuse that behavior. The parity harness will batch-populate BASE and candidates in each fresh selection evaluator; this is the decisive red-capable check because it will show whether the published parity survives removal of the cache-path contamination.
