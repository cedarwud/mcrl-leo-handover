run_width() {
  hp="$1"
  nice -n 15 env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/beamwidth/run_beamwidth_network.py --worlds 2 --anchors-per-world 4 --one-sided-hp-deg "$hp" --provisioning-rule margin-strict --output ".scratch/beamwidth/strict-margin-sweep-one-sided-${hp}.json"
}
