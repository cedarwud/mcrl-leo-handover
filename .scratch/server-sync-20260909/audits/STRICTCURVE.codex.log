#!/usr/bin/env python3
"""Read-only diagnosis of uncapped NO_MODE in the margin-provisioned copy.

Only rebuilds anchor profiles flagged by the completed native-slot census.
No source, variant target, cap, solver, or mode selection behavior is changed.
"""

from __future__ import annotations

from collections import Counter
import json
import math
from pathlib import Path
import time

import numpy as np

import oracle_runner
from scalar_diagnostics import scalar_formulation
from mcrl.physics_v025 import architectures
from mcrl.physics_v025.acm import ACM_MODES
from mcrl.physics_v025.channel import fading_product_quantile
from mcrl.physics_v025.provider_legacy import factory as real_factory


HERE = Path(__file__).resolve().parent


def _stats(values):
    rows = np.asarray(values, dtype=np.float64)
    return {
        "count": len(values), "min": float(np.min(rows)),
        "p50": float(np.quantile(rows, 0.5)), "p95": float(np.quantile(rows, 0.95)),
        "max": float(np.max(rows)), "mean": float(np.mean(rows)),
    }


def run():
    started = time.perf_counter()
    census = json.loads((HERE / "scalar-census-summary.json").read_text())
    result = json.loads((HERE / "margin-result.json").read_text())
    anchors = {row["anchor_id"]: row for row in result["anchors"]}
    affected = sorted(
        (row for row in census["anchors"] if row["formulation"] == "margin" and row["counts"]["no_mode_uncapped"]),
        key=lambda row: (row["anchor_id"], row["selector"]),
    )
    print(json.dumps({"affected_profiles": len(affected), "expected_attempts": sum(row["counts"]["no_mode_uncapped"] for row in affected)}), flush=True)
    loaded_domain = None
    tape = None
    config = architectures.RadiationConfig(fading_quantile_alpha=0.10)
    engine = architectures.AngleRateTPC_TDM()
    floor = min(ACM_MODES, key=lambda mode: mode.threshold_linear)
    examples = []
    profile_rows = []
    for profile in affected:
        anchor = anchors[profile["anchor_id"]]
        domain = anchor["world_domain"]
        if loaded_domain != domain:
            tape = oracle_runner.probe.build_world_tape(
                domain=domain, provider=real_factory(), steps=5, start_time_s=0.0,
            )
            if tape.digest != anchor["world_sha256"]:
                raise RuntimeError("reconstructed tape digest differs from stored margin result")
            loaded_domain = domain
            print(json.dumps({"rebuilt_world": domain, "elapsed_s": time.perf_counter() - started}), flush=True)
        step = int(anchor["step_index"])
        selected = anchor["committed"][profile["selector"]]
        mapping = {int(user): None if identity is None else tuple(identity) for user, identity in selected["assignments"]}
        samples = tape.geometry_for(step_index=step, assignments=mapping)
        local = []
        with scalar_formulation("margin"):
            for boundary, (time_s, geometry) in enumerate(samples):
                radiation = engine.radiate(config, geometry, "realised")
                by_user = {link.user_id: (index, link) for index, link in enumerate(geometry.links)}
                occupancy = Counter(link.beam for link in geometry.links)
                for slot_index, slot in enumerate(radiation.slots):
                    failures = [tx for tx in slot.transmissions if tx.m_tx is None and tx.rf_power_w < config.beam_cap_w - 1.0e-9]
                    if not failures:
                        continue
                    active = tuple(by_user[tx.user_id][0] for tx in slot.transmissions)
                    coupling = architectures._masked_coupling(geometry, active, "nominal")
                    powers = np.asarray([tx.rf_power_w for tx in slot.transmissions])
                    nominal_interference = coupling @ powers
                    slot_rows = {tx.user_id: index for index, tx in enumerate(slot.transmissions)}
                    for tx in failures:
                        position = slot_rows[tx.user_id]
                        link = by_user[tx.user_id][1]
                        q = fading_product_quantile(link.elevation_deg, 0.10)
                        predicted = q * tx.nominal_sinr
                        required_power_current_interference = tx.rate_target_sinr * (tx.noise_w + nominal_interference[position]) / link.nominal_gain
                        row = {
                            "anchor_id": profile["anchor_id"], "selector": profile["selector"],
                            "boundary": boundary, "slot": slot_index, "slot_fraction": slot.fraction,
                            "user_id": tx.user_id, "beam": list(tx.beam), "occupancy": occupancy[tx.beam],
                            "elevation_deg": link.elevation_deg, "q": q,
                            "nominal_sinr": tx.nominal_sinr, "predicted_sinr": predicted,
                            "floor_threshold_linear": floor.threshold_linear,
                            "floor_threshold_deficit_relative": 1.0 - predicted / floor.threshold_linear,
                            "floor_threshold_deficit_db": 10.0 * math.log10(floor.threshold_linear / predicted),
                            "power_w": tx.rf_power_w, "cap_w": config.beam_cap_w,
                            "cap_headroom_w": config.beam_cap_w - tx.rf_power_w,
                            "target_mode": None if tx.m_target is None else tx.m_target.name,
                            "provisioned_target_sinr": tx.rate_target_sinr,
                            "nominal_interference_w": float(nominal_interference[position]),
                            "noise_w": tx.noise_w,
                            "nominal_interference_to_noise": float(nominal_interference[position] / tx.noise_w),
                            "required_power_at_current_interference_w": float(required_power_current_interference),
                            "current_fixed_point_power_deficit_w": float(required_power_current_interference - tx.rf_power_w),
                            "current_fixed_point_power_deficit_relative": float(required_power_current_interference / tx.rf_power_w - 1.0),
                            "certificate_status": slot.certificate.status,
                            "certificate_residual_w": slot.certificate.residual_w,
                            "certificate_tolerance_w": slot.certificate.tolerance_w,
                            "certificate_iterations": slot.certificate.iterations,
                        }
                        local.append(row)
                        examples.append(row)
        if len(local) != profile["counts"]["no_mode_uncapped"]:
            raise RuntimeError(f"uncapped census trace mismatch at {profile['anchor_id']} {profile['selector']}: {len(local)} versus {profile['counts']['no_mode_uncapped']}")
        report = {
            "anchor_id": profile["anchor_id"], "selector": profile["selector"], "count": len(local),
            "max_deficit_db": max(row["floor_threshold_deficit_db"] for row in local),
            "max_deficit_relative": max(row["floor_threshold_deficit_relative"] for row in local),
            "max_power_deficit_w": max(row["current_fixed_point_power_deficit_w"] for row in local),
        }
        profile_rows.append(report)
        print(json.dumps({**report, "elapsed_s": time.perf_counter() - started}), flush=True)
    numerical = (
        "floor_threshold_deficit_relative", "floor_threshold_deficit_db", "power_w", "cap_headroom_w",
        "current_fixed_point_power_deficit_w", "current_fixed_point_power_deficit_relative",
        "nominal_interference_to_noise", "certificate_residual_w", "certificate_iterations", "q",
    )
    output = {
        "schema": "ladder-floor-uncapped-margin-failure-trace-v1",
        "profile_count": len(affected), "attempt_count": len(examples),
        "by_selector": dict(Counter(row["selector"] for row in examples)),
        "by_occupancy": dict(Counter(row["occupancy"] for row in examples)),
        "certificate_status": dict(Counter(row["certificate_status"] for row in examples)),
        "statistics": {name: _stats([row[name] for row in examples]) for name in numerical},
        "profiles": profile_rows,
        "worst_examples": sorted(examples, key=lambda row: row["floor_threshold_deficit_db"], reverse=True)[:20],
        "smallest_examples": sorted(examples, key=lambda row: row["floor_threshold_deficit_db"])[:5],
        "wall_seconds": time.perf_counter() - started,
    }
    (HERE / "uncapped-margin-failure-trace.json").write_text(json.dumps(output, indent=2, allow_nan=False) + "\n")
    return output


if __name__ == "__main__":
    run()

