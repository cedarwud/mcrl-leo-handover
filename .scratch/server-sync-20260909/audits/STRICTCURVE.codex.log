#!/usr/bin/env python3
"""Assert the private provisioning seam is bit-identical at divisor one."""

from __future__ import annotations

import argparse
import dataclasses
import importlib.util
import json
import math
from pathlib import Path
import sys

import numpy as np


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
PROBE_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)


def _load_probe():
    spec = importlib.util.spec_from_file_location("identity_v025_probe", PROBE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load pinned probe")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


probe = _load_probe()

import margin_batch
from mcrl.physics_v025 import batch as sealed_batch
from mcrl.physics_v025 import channel as channel_module
from mcrl.physics_v025.provider_legacy import factory


def _configuration_from_id(base, configuration_id: str):
    if configuration_id.startswith("BASE:"):
        return base
    if not configuration_id.startswith("CFG:"):
        raise RuntimeError(f"unexpected configuration id: {configuration_id}")
    mapping = {}
    for assignment in configuration_id[4:].split(";"):
        user, norad, chain = assignment.split(":")
        mapping[int(user)] = (int(norad), int(chain))
    config = probe._configuration(base, mapping, kind="divisor-one-replay")
    if config.configuration_id != configuration_id:
        raise RuntimeError("configuration-id reconstruction failed")
    return config


def _selected_rows(arrays, configs):
    row_of = arrays._row_index()
    users = tuple(int(value) for value in arrays.users)
    selected = np.full((len(configs), len(users)), -1, dtype=np.int64)
    for config_index, config in enumerate(configs):
        for user_column, user in enumerate(users):
            identity = config.mapping[user]
            if identity is not None:
                selected[config_index, user_column] = row_of[(user, identity)]
    return selected


def _assert_batch_equal(left, right, *, label):
    for field in dataclasses.fields(left):
        a = np.asarray(getattr(left, field.name))
        b = np.asarray(getattr(right, field.name))
        if a.dtype != b.dtype or a.shape != b.shape or a.tobytes() != b.tobytes():
            raise AssertionError(f"{label}: batch field differs: {field.name}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("receipts", nargs="+", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    checked = []
    for receipt_path in args.receipts:
        receipt = json.loads(receipt_path.read_text(encoding="ascii"))
        width = float(receipt["beamwidth_diagnostic"]["off_axis_half_power_deg"])
        channel_module.TX_FULL_HPBW_DEG = 2.0 * width
        tapes = {}
        for world_index in (1, 2):
            tape = probe.build_world_tape(
                domain=probe.PROBE_WORLD_DOMAINS[world_index - 1],
                provider=factory(),
                steps=4,
                start_time_s=0.0,
            )
            expected_world = next(
                row for row in receipt["worlds"] if row["world_index"] == world_index
            )
            if tape.digest != expected_world["world_sha256"]:
                raise AssertionError(f"{receipt_path}: world digest differs")
            tapes[world_index] = tape
        configurations = 0
        catalogue_calls = 0
        for anchor in receipt["anchors"]:
            tape = tapes[int(anchor["world_index"])]
            step_index = int(anchor["step_index"])
            arrays = tape.steps[step_index].arrays
            if arrays is None:
                raise AssertionError("real anchor unexpectedly lacks dense arrays")
            base = probe._base_configuration(tape, step_index, "nearest-eligible")
            names = ("BASELINE", "UNILATERAL", "ORACLE_SET")
            configs = [
                _configuration_from_id(
                    base, anchor["committed"][name]["configuration_id"]
                )
                for name in names
            ]
            selected = _selected_rows(arrays, configs)
            for boundaries in ((0,), tuple(range(48))):
                kwargs = {
                    "field": "realised",
                    "rate_target_bps": probe.run_setting_for("a-r0").rate_target_bps,
                    "circuit_power_per_active_chain_w": probe.run_setting_for(
                        "a-r0"
                    ).circuit_power_per_active_chain_w,
                    "boundary_indices": boundaries,
                    "fading_quantile_alpha": 0.10,
                }
                sealed = sealed_batch._evaluate_ar_tdm_catalogue_core(
                    arrays, selected, **kwargs
                )
                divisor_one = margin_batch.evaluate_ar_tdm_catalogue_divisor_one(
                    arrays, selected, **kwargs
                )
                _assert_batch_equal(
                    sealed,
                    divisor_one,
                    label=f"{receipt_path.name}:{anchor['anchor_id']}:{boundaries}",
                )
                catalogue_calls += 1
            for index, name in enumerate(names):
                recorded = anchor["committed"][name]
                bits = math.fsum(float(value) for value in sealed.bits[index])
                joules = float(sealed.joules[index])
                served = int(np.sum(sealed.decoding_time_s[index] > 0.0))
                if (
                    bits.hex() != float(recorded["bits"]).hex()
                    or joules.hex() != float(recorded["joules"]).hex()
                    or served != int(recorded["served_count"])
                ):
                    raise AssertionError(
                        f"{receipt_path.name}:{anchor['anchor_id']}:{name}: receipt mismatch"
                    )
            configurations += len(configs)
        checked.append(
            {
                "receipt": str(receipt_path),
                "receipt_sha256": receipt["receipt_sha256"],
                "width_deg": width,
                "anchors": len(receipt["anchors"]),
                "committed_configurations": configurations,
                "catalogue_calls": catalogue_calls,
                "status": "BIT_IDENTICAL",
            }
        )
    result = {
        "assertion": "BIT_IDENTICAL",
        "comparison": (
            "every ndarray field from the sealed and divisor-one private dense "
            "evaluators, at boundary 0 and all 48 boundaries"
        ),
        "receipt_record_check": "bits, joules, and served counts match exactly",
        "receipts": checked,
        "total_receipts": len(checked),
        "total_anchors": sum(row["anchors"] for row in checked),
        "total_committed_configurations": sum(
            row["committed_configurations"] for row in checked
        ),
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii"
    )
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Replay recorded sealed selections to add non-selection diagnostics."""

from __future__ import annotations

import argparse
import importlib.util
import json
from pathlib import Path
import sys


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
sys.path.insert(0, str(HERE))


def _load_runner():
    path = HERE / "run_beamwidth_network.py"
    spec = importlib.util.spec_from_file_location("sealed_replay_runner", path)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load beam-width runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


runner = _load_runner()

from mcrl.physics_v025 import batch as sealed_batch
from mcrl.physics_v025.provider_legacy import factory


def _configuration_from_id(base, configuration_id: str):
    if configuration_id.startswith("BASE:"):
        return base
    mapping = {}
    for assignment in configuration_id[4:].split(";"):
        user, norad, chain = assignment.split(":")
        mapping[int(user)] = (int(norad), int(chain))
    config = runner.probe._configuration(base, mapping, kind="sealed-diagnostic-replay")
    if config.configuration_id != configuration_id:
        raise RuntimeError("configuration reconstruction failed")
    return config


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("receipts", nargs="+", type=Path)
    parser.add_argument("--output-dir", type=Path, required=True)
    args = parser.parse_args()
    outputs = []
    runner.PROVISIONING_RULE = "sealed"
    runner.probe.evaluate_ar_tdm_catalogue = sealed_batch.evaluate_ar_tdm_catalogue
    for receipt_path in args.receipts:
        source = json.loads(receipt_path.read_text(encoding="ascii"))
        width = float(source["beamwidth_diagnostic"]["off_axis_half_power_deg"])
        runner.channel_module.TX_FULL_HPBW_DEG = 2.0 * width
        tapes = {}
        for world_index in (1, 2):
            tape = runner.probe.build_world_tape(
                domain=runner.probe.PROBE_WORLD_DOMAINS[world_index - 1],
                provider=factory(),
                steps=4,
                start_time_s=0.0,
            )
            expected = next(
                row for row in source["worlds"] if row["world_index"] == world_index
            )
            if tape.digest != expected["world_sha256"]:
                raise RuntimeError("world digest mismatch")
            tapes[world_index] = tape
        anchors = []
        for recorded in source["anchors"]:
            tape = tapes[int(recorded["world_index"])]
            step_index = int(recorded["step_index"])
            base = runner.probe._base_configuration(tape, step_index, "nearest-eligible")
            configs = {
                name: _configuration_from_id(
                    base, recorded["committed"][name]["configuration_id"]
                )
                for name in ("BASELINE", "UNILATERAL", "ORACLE_SET")
            }
            evaluator = runner.probe.StepEvaluator(
                tape,
                runner.probe._setting("a-r0"),
                step_index,
                transition_from=base,
                field="realised",
                run_setting=runner.probe.run_setting_for("a-r0"),
                boundary_indices=tuple(range(48)),
                fading_quantile_alpha=0.10,
            )
            evaluator.evaluate_many(tuple(configs.values()))
            committed = {}
            for name, config in configs.items():
                profile = evaluator.evaluate(config)
                old = recorded["committed"][name]
                if (
                    profile.bits.hex() != float(old["bits"]).hex()
                    or profile.joules.hex() != float(old["joules"]).hex()
                    or runner.served(profile) != int(old["served_count"])
                ):
                    raise RuntimeError("sealed committed replay differs from receipt")
                committed[name] = {
                    "configuration_id": config.configuration_id,
                    "bits": profile.bits,
                    "joules": profile.joules,
                    "ee_bit_per_j": runner.ratio(profile.bits, profile.joules),
                    "served_count": runner.served(profile),
                    "rate_target_attained_count": sum(
                        bool(value)
                        for value in (profile.score.rate_target_attained or {}).values()
                    ),
                    "rf_cap_hits": profile.rf_cap_hits,
                    "rf_transmission_observations": profile.rf_transmission_observations,
                    "m_tx_counts": dict(profile.m_tx_counts),
                    "interference_structure": runner.interference_structure(
                        tape=tape, step_index=step_index, selected=config
                    ),
                }
            committed["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] = (
                runner.relative_gain(
                    committed["ORACLE_SET"]["ee_bit_per_j"],
                    committed["UNILATERAL"]["ee_bit_per_j"],
                )
            )
            committed["UNILATERAL"]["relative_ee_gain_over_BASELINE"] = (
                runner.relative_gain(
                    committed["UNILATERAL"]["ee_bit_per_j"],
                    committed["BASELINE"]["ee_bit_per_j"],
                )
            )
            anchors.append(
                {
                    "anchor_id": recorded["anchor_id"],
                    "world_index": recorded["world_index"],
                    "world_domain": recorded["world_domain"],
                    "step_index": step_index,
                    "selection": recorded["selection"],
                    "committed": committed,
                    "committed_unique_configuration_evaluations": len(
                        {config.configuration_id for config in configs.values()}
                    ),
                    "committed_physical_boundary_evaluations": 48
                    * len({config.configuration_id for config in configs.values()}),
                }
            )
        result = {
            "schema": "mcrl-v025-beamwidth-sealed-diagnostic-replay-v1",
            "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
            "source_receipt": str(receipt_path),
            "source_receipt_sha256": source["receipt_sha256"],
            "beamwidth_diagnostic": source["beamwidth_diagnostic"],
            "provisioning_rule": "sealed",
            "anchors": anchors,
            "summary": runner.summarize(anchors),
        }
        output = args.output_dir / f"sealed-diagnostics-one-sided-{width:.2f}.json"
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(
            json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="ascii",
        )
        outputs.append(str(output))
        print(json.dumps({"completed": str(output), "anchors": len(anchors)}), flush=True)
    print(json.dumps({"outputs": outputs}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

codex
The evidence now supports three ranked, testable explanations:

1. The finite solver stops on its inherited residual criterion before the quantile-adjusted discrete ACM floor is crossed; an uncapped attempt can therefore be microscopically below the target mode.
2. Dense-only correction could change catalogue selection while leaving scalar diagnostics on the defective path.
3. A runner adaptation could alter results through unrelated source/tree differences.

The checks will distinguish them by (1) asserting the actual two clearance inequalities, (2) matching scalar and dense fixtures including modes/power/iterations, and (3) pinning identical engine trees plus exact strict-module hashes and comparing the existing 20-anchor ladder receipt.
