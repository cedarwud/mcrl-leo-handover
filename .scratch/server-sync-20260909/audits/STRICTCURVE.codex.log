@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Focused actual-clearance and scalar/dense agreement audit."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+
+import numpy as np
+
+import margin_batch
+import strict_clearance_adapter as strict
+from mcrl.physics_v025 import architectures
+from mcrl.physics_v025.acm import rate_target_sinr
+from mcrl.physics_v025.channel import fading_product_quantile
+from mcrl.physics_v025.constants_v025 import (
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    POWER_SOLVER_ITERATION_CAP,
+)
+from mcrl.physics_v025.energy import HardwareInventory, schedule_energy
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+spec = importlib.util.spec_from_file_location(
+    "beamwidth_strict_fixture", REPO / "tests/physics_v025/test_stage4d_gate.py"
+)
+fixture = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = fixture
+spec.loader.exec_module(fixture)
+
+
+def main() -> int:
+    q = fading_product_quantile(45.0, 0.10)
+    gamma = rate_target_sinr(50e6, BEAM_BANDWIDTH_HZ, 1)
+    if gamma is None:
+        raise AssertionError("occupancy-one target unexpectedly unavailable")
+    selected = np.asarray([[0, 1, 2]])
+    duration = 30.08
+    original_target = architectures._rate_targets
+    original_solve = architectures._solve_power
+    rows = []
+    for rho, isolated_power in (
+        (0.0, 0.01),
+        (0.1, 0.01),
+        (0.1, 0.001),
+        (0.1, 0.0001),
+        (0.1, 0.00001),
+        (0.1, 2.0),
+        (0.8, 0.01),
+    ):
+        arrays, geometry = fixture._three_user_arrays(rho, isolated_power)
+        geometry = replace(
+            geometry,
+            links=tuple(replace(link, elevation_deg=45.0) for link in geometry.links),
+        )
+        kwargs = dict(
+            field="realised",
+            boundary_indices=(0,),
+            fading_quantile_alpha=0.10,
+        )
+        simple = margin_batch.evaluate_ar_tdm_catalogue(arrays, selected, **kwargs)
+        dense = strict.evaluate_ar_tdm_catalogue(arrays, selected, **kwargs)
+        config = architectures.RadiationConfig(fading_quantile_alpha=0.10)
+        with strict.scalar_formulation("margin-cleared"):
+            scalar = architectures.AngleRateTPC_TDM().radiate(
+                config, geometry, "realised"
+            )
+        assert architectures._rate_targets is original_target
+        assert architectures._solve_power is original_solve
+        scalar_power = max(
+            tx.rf_power_w for slot in scalar.slots for tx in slot.transmissions
+        )
+        scalar_bits = math.fsum(
+            slot.fraction
+            * tx.bandwidth_hz
+            * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
+            * duration
+            for slot in scalar.slots
+            for tx in slot.transmissions
+        )
+        inventory = HardwareInventory.fixed(link.beam for link in geometry.links)
+        scalar_joules = schedule_energy(
+            inventory,
+            ((slot.fraction, dict(slot.beam_rf_w)) for slot in scalar.slots),
+            duration_s=duration,
+        ).joules
+        scalar_no_mode = sum(
+            tx.m_tx is None for slot in scalar.slots for tx in slot.transmissions
+        )
+        dense_no_mode = int(dense.transmitted_mode_counts[0, 0])
+        np.testing.assert_allclose(
+            scalar_power, dense.max_rf_power_w[0], rtol=2e-14, atol=0
+        )
+        np.testing.assert_allclose(
+            scalar_bits, dense.bits.sum(), rtol=2e-14, atol=0
+        )
+        np.testing.assert_allclose(
+            scalar_joules, dense.joules[0], rtol=2e-14, atol=0
+        )
+        assert scalar_no_mode == dense_no_mode
+        assert scalar.certificate.iterations == int(dense.certificate_iterations[0])
+        assert scalar.valid and bool(dense.valid[0])
+
+        power = float(dense.max_rf_power_w[0])
+        direct = float(arrays.nominal_gain[0, 0])
+        cross = float(arrays.cross_base_nominal[0, 0, 1])
+        noise = float(scalar.slots[0].transmissions[0].noise_w)
+        nominal = power * direct / (noise + 2.0 * cross * power)
+        uncapped = power < BEAM_RF_CAP_W
+        nominal_clear = nominal >= gamma / q
+        mode_clear = (
+            q * nominal
+            >= scalar.slots[0].transmissions[0].m_target.threshold_linear
+        )
+        if uncapped:
+            assert nominal_clear and mode_clear and dense_no_mode == 0
+        assert int(dense.certificate_iterations[0]) <= POWER_SOLVER_ITERATION_CAP
+        rows.append(
+            {
+                "rho": rho,
+                "isolated_target_power_w": isolated_power,
+                "uncapped": uncapped,
+                "simple_no_mode": int(simple.transmitted_mode_counts[0, 0]),
+                "strict_no_mode": dense_no_mode,
+                "strict_power_w": power,
+                "nominal_at_least_gamma_over_q": nominal_clear,
+                "q_nominal_at_least_target_mode_threshold": mode_clear,
+                "scalar_dense_power_hex_equal": scalar_power.hex() == power.hex(),
+                "scalar_dense_mode_count_equal": scalar_no_mode == dense_no_mode,
+                "iterations": int(dense.certificate_iterations[0]),
+            }
+        )
+    result = {
+        "status": "PASS",
+        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+        "fixture_count": len(rows),
+        "checks": (
+            "Every uncapped fixture clears both nominal Gamma/q and "
+            "q-adjusted target-mode threshold; scalar and dense paths agree."
+        ),
+        "iteration_budget": POWER_SOLVER_ITERATION_CAP,
+        "source_sha256": strict.SOURCE_SHA256,
+        "cases": rows,
+        "dense_clearance_counters": strict.CLEARANCE_DIAGNOSTICS,
+        "scalar_clearance_counters": dict(strict.SCALAR_CLEARANCE_DIAGNOSTICS),
+        "original_scalar_functions_restored": (
+            architectures._rate_targets is original_target
+            and architectures._solve_power is original_solve
+        ),
+    }
+    output = HERE / "strict-clearance-verification.json"
+    output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

