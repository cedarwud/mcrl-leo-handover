+Together with the existing sealed and simple-division receipts, it must report
+pooled energy efficiency, separate served and target-attainment counts,
+oracle-over-unilateral coordination headroom and negative-anchor counts,
+occupancy-one uncapped no-mode attempts and their within-1e-8-dB subset, and
+simple/strict committed-assignment agreement. It must pass the divisor-one
+bit-identity assertion, actual target-clearance checks, scalar/dense parity,
+and a behaviour-preservation audit against the twenty-anchor ladder panel.
+All 48 realised boundaries must be retained and no declared width omitted.
diff --git a/.scratch/beamwidth/strict_clearance_adapter.py b/.scratch/beamwidth/strict_clearance_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..56e6e3a235b76fa834a0377bdec8e2dad3c7673c
--- /dev/null
+++ b/.scratch/beamwidth/strict_clearance_adapter.py
@@ -0,0 +1,176 @@
+"""Read-only adapter to the adjudicated strict-clearance implementation.
+
+The implementation itself remains byte-for-byte in the ladder workspace.  This
+module only verifies its source and the common sealed engine sources, loads it
+under private module names, and exposes its dense evaluator and scalar context.
+No numerical code is copied or changed here.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import inspect
+from pathlib import Path
+import sys
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+LADDER_REPO = Path("/home/sat/mcrl-v025-ladder-ws")
+STRICT_DIR = LADDER_REPO / ".scratch/ladder-floor-20260910"
+
+EXPECTED_SHA256 = {
+    "cleared_margin_batch.py": "bf9f3cfecba54125c6a7736f550032e6bd7292f03f8fc6281f1d02979c14a85f",
+    "scalar_diagnostics.py": "808b3bd98d2048ef8b13f582a9560e55152aeca5240da6bc3574361eb8441de6",
+    "batch.py": "f43ee35da08f123d21eda9f6b1ab64b0792ed0149a5dcc489a7f6a68cbf72e34",
+    "architectures.py": "2836f5a76e437782c9edbbbadb9368b9c40acd3f46f0311aeafd6de6c6804ae1",
+}
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+SOURCE_PATHS = {
+    "cleared_margin_batch.py": STRICT_DIR / "cleared_margin_batch.py",
+    "scalar_diagnostics.py": STRICT_DIR / "scalar_diagnostics.py",
+    "batch.py": REPO / "src/mcrl/physics_v025/batch.py",
+    "architectures.py": REPO / "src/mcrl/physics_v025/architectures.py",
+}
+SOURCE_SHA256 = {name: _sha256(path) for name, path in SOURCE_PATHS.items()}
+if SOURCE_SHA256 != EXPECTED_SHA256:
+    raise RuntimeError(
+        f"strict-clearance or common engine source hash differs: {SOURCE_SHA256}"
+    )
+
+
+def _load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load strict-clearance module: {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_dense = _load("beamwidth_strict_dense", SOURCE_PATHS["cleared_margin_batch.py"])
+_scalar = _load("beamwidth_strict_scalar", SOURCE_PATHS["scalar_diagnostics.py"])
+
+evaluate_ar_tdm_catalogue = _dense.evaluate_ar_tdm_catalogue
+scalar_formulation = _scalar.scalar_formulation
+CLEARANCE_DIAGNOSTICS = _dense.CLEARANCE_DIAGNOSTICS
+SCALAR_CLEARANCE_DIAGNOSTICS = _scalar.SCALAR_CLEARANCE_DIAGNOSTICS
+
+
+def _divisor_one_core():
+    """Compile the same strict function with its diagnostic divisor set to one.
+
+    The actual quantile arm uses the byte-identical function exposed above.
+    This check-only specialization changes the provisioning divisor and the
+    corresponding target-mode clearance factor together; no run uses it.
+    """
+
+    source = inspect.getsource(_dense._evaluate_ar_tdm_catalogue_core)
+    old_target = "targets = gamma[np.minimum(occupancy, users)] / quantile"
+    new_target = (
+        "strict_clearance_enabled = False\n"
+        "                provisioning_divisor = np.ones_like(quantile)\n"
+        "                targets = gamma[np.minimum(occupancy, users)] / provisioning_divisor"
+    )
+    old_clearance = "clearance_sinr * quantile < target_threshold"
+    new_clearance = "clearance_sinr * provisioning_divisor < target_threshold"
+    old_deficient = "deficient = ("
+    new_deficient = "deficient = strict_clearance_enabled & ("
+    if (
+        source.count(old_target) != 1
+        or source.count(old_clearance) != 1
+        or source.count(old_deficient) != 1
+    ):
+        raise RuntimeError("strict-clearance source no longer has the audited seams")
+    namespace = dict(vars(_dense))
+    exec(
+        compile(
+            source.replace(old_target, new_target)
+            .replace(old_clearance, new_clearance)
+            .replace(old_deficient, new_deficient),
+            __file__,
+            "exec",
+        ),
+        namespace,
+    )
+    return namespace["_evaluate_ar_tdm_catalogue_core"]
+
+
+evaluate_ar_tdm_catalogue_divisor_one = _divisor_one_core()
+
+
+__all__ = [
+    "CLEARANCE_DIAGNOSTICS",
+    "EXPECTED_SHA256",
+    "SCALAR_CLEARANCE_DIAGNOSTICS",
+    "SOURCE_SHA256",
+    "evaluate_ar_tdm_catalogue",
+    "evaluate_ar_tdm_catalogue_divisor_one",
+    "scalar_formulation",
+]
+
+
+def _verify_sources() -> dict[str, str]:
+    paths = {
+        "cleared_margin_batch.py": STRICT_DIR / "cleared_margin_batch.py",
+        "scalar_diagnostics.py": STRICT_DIR / "scalar_diagnostics.py",
+        "batch.py": REPO / "src/mcrl/physics_v025/batch.py",
+        "architectures.py": REPO / "src/mcrl/physics_v025/architectures.py",
+    }
+    observed = {name: _sha256(path) for name, path in paths.items()}
+    if observed != EXPECTED_SHA256:
+        raise RuntimeError(
+            f"strict-clearance source provenance differs: {observed!r}"
+        )
+    sibling_engine = {
+        "batch.py": _sha256(LADDER_REPO / "src/mcrl/physics_v025/batch.py"),
+        "architectures.py": _sha256(
+            LADDER_REPO / "src/mcrl/physics_v025/architectures.py"
+        ),
+    }
+    for name, digest in sibling_engine.items():
+        if digest != observed[name]:
+            raise RuntimeError(f"beam and ladder engine source differs: {name}")
+    return observed
+
+
+def _load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load strict-clearance source: {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+SOURCE_SHA256 = _verify_sources()
+_dense = _load(
+    "beamwidth_adjudicated_cleared_margin_batch",
+    STRICT_DIR / "cleared_margin_batch.py",
+)
+_scalar = _load(
+    "beamwidth_adjudicated_scalar_diagnostics",
+    STRICT_DIR / "scalar_diagnostics.py",
+)
+
+evaluate_ar_tdm_catalogue = _dense.evaluate_ar_tdm_catalogue
+scalar_formulation = _scalar.scalar_formulation
+CLEARANCE_DIAGNOSTICS = _dense.CLEARANCE_DIAGNOSTICS
+SCALAR_CLEARANCE_DIAGNOSTICS = _scalar.SCALAR_CLEARANCE_DIAGNOSTICS
+
+
+__all__ = [
+    "CLEARANCE_DIAGNOSTICS",
+    "SCALAR_CLEARANCE_DIAGNOSTICS",
+    "SOURCE_SHA256",
+    "evaluate_ar_tdm_catalogue",
+    "scalar_formulation",
+]
diff --git a/.scratch/beamwidth/verify_ladder_adapter.py b/.scratch/beamwidth/verify_ladder_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..0972c46159b26fb068fcd880ceeaa4313b33e1dc
--- /dev/null
+++ b/.scratch/beamwidth/verify_ladder_adapter.py
@@ -0,0 +1,126 @@
+#!/usr/bin/env python3
+"""Replay the 20-anchor strict ladder commitments through the beam adapter."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+
+import numpy as np
+
+import strict_clearance_adapter as strict
+
+
+HERE = Path(__file__).resolve().parent
+LADDER = Path("/home/sat/mcrl-v025-ladder-ws")
+STRICT_DIR = LADDER / ".scratch/ladder-floor-20260910"
+
+
+def _load_probe():
+    path = LADDER / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+    spec = importlib.util.spec_from_file_location("ladder_adapter_probe", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load ladder probe")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+probe = _load_probe()
+from mcrl.physics_v025.provider_legacy import factory
+
+
+def _configuration(base, configuration_id):
+    if configuration_id.startswith("BASE:"):
+        return base
+    mapping = {}
+    for assignment in configuration_id[4:].split(";"):
+        user, norad, chain = assignment.split(":")
+        mapping[int(user)] = (int(norad), int(chain))
+    result = probe._configuration(base, mapping, kind="ladder-adapter-replay")
+    assert result.configuration_id == configuration_id
+    return result
+
+
+def main() -> int:
+    reference_path = STRICT_DIR / "margin-cleared-result.json"
+    reference = json.loads(reference_path.read_text())
+    audit = json.loads((STRICT_DIR / "strict-result-audit.json").read_text())
+    assert audit["strict_batch_sha256"] == strict.SOURCE_SHA256["cleared_margin_batch.py"]
+    probe.evaluate_ar_tdm_catalogue = strict.evaluate_ar_tdm_catalogue
+    tapes = {}
+    for world in reference["worlds"]:
+        world_index = int(world["world_index"])
+        tape = probe.build_world_tape(
+            domain=probe.PROBE_WORLD_DOMAINS[world_index - 1],
+            provider=factory(),
+            steps=5,
+            start_time_s=0.0,
+        )
+        assert tape.digest == world["world_sha256"]
+        tapes[world_index] = tape
+    comparisons = 0
+    maximum_relative_error = 0.0
+    for anchor in reference["anchors"]:
+        tape = tapes[int(anchor["world_index"])]
+        step_index = int(anchor["step_index"])
+        base = probe._base_configuration(tape, step_index, "nearest-eligible")
+        configs = {
+            name: _configuration(base, anchor["committed"][name]["configuration_id"])
+            for name in ("BASELINE", "UNILATERAL", "ORACLE_SET")
+        }
+        evaluator = probe.StepEvaluator(
+            tape,
+            probe._setting("a-r0"),
+            step_index,
+            transition_from=base,
+            field="realised",
+            run_setting=probe.run_setting_for("a-r0"),
+            boundary_indices=tuple(range(48)),
+            fading_quantile_alpha=0.10,
+        )
+        evaluator.evaluate_many(tuple(configs.values()))
+        for name, config in configs.items():
+            profile = evaluator.evaluate(config)
+            expected = anchor["committed"][name]
+            assert profile.bits.hex() == float(expected["bits"]).hex()
+            assert profile.joules.hex() == float(expected["joules"]).hex()
+            served = int(np.sum(np.fromiter(profile.score.served_phy.values(), bool)))
+            assert served == int(expected["served_count"])
+            comparisons += 1
+            maximum_relative_error = max(
+                maximum_relative_error,
+                abs(profile.bits / float(expected["bits"]) - 1.0)
+                if float(expected["bits"]) else 0.0,
+                abs(profile.joules / float(expected["joules"]) - 1.0),
+            )
+    strict_summary = audit["formulations"]["margin-cleared"]
+    payload = {
+        "status": "BIT_IDENTICAL",
+        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+        "reference_receipt": str(reference_path),
+        "anchor_count": len(reference["anchors"]),
+        "committed_profile_comparisons": comparisons,
+        "maximum_relative_error": maximum_relative_error,
+        "strict_batch_sha256": strict.SOURCE_SHA256["cleared_margin_batch.py"],
+        "ladder_joint_over_unilateral_pct": strict_summary[
+            "oracle_over_unilateral_pct"
+        ],
+        "ladder_pooled": strict_summary["pooled"],
+        "interpretation": (
+            "The adapter calls the same hash-pinned strict function object; all "
+            "60 stored committed ladder profiles replay bit-identically."
+        ),
+    }
+    output = HERE / "strict-ladder-adapter-verification.json"
+    output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.scratch/beamwidth/verify_strict_clearance.py b/.scratch/beamwidth/verify_strict_clearance.py
new file mode 100644
index 0000000000000000000000000000000000000000..767fb230b082679a62e227ae4b53553eb50b649a
--- /dev/null
+++ b/.scratch/beamwidth/verify_strict_clearance.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Focused actual-clearance and scalar/dense agreement audit."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+
+import numpy as np
+
+import margin_batch
+import strict_clearance_adapter as strict
+from mcrl.physics_v025 import architectures
+from mcrl.physics_v025.acm import rate_target_sinr
+from mcrl.physics_v025.channel import fading_product_quantile
+from mcrl.physics_v025.constants_v025 import (
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    POWER_SOLVER_ITERATION_CAP,
+)
+from mcrl.physics_v025.energy import HardwareInventory, schedule_energy
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+spec = importlib.util.spec_from_file_location(
+    "beamwidth_strict_fixture", REPO / "tests/physics_v025/test_stage4d_gate.py"
+)
+fixture = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = fixture
+spec.loader.exec_module(fixture)
+
+
+def main() -> int:
+    q = fading_product_quantile(45.0, 0.10)
+    gamma = rate_target_sinr(50e6, BEAM_BANDWIDTH_HZ, 1)
+    if gamma is None:
+        raise AssertionError("occupancy-one target unexpectedly unavailable")
+    selected = np.asarray([[0, 1, 2]])
+    duration = 30.08
+    original_target = architectures._rate_targets
+    original_solve = architectures._solve_power
+    rows = []
+    for rho, isolated_power in (
+        (0.0, 0.01),
+        (0.1, 0.01),
+        (0.1, 0.001),
+        (0.1, 0.0001),
+        (0.1, 0.00001),
+        (0.1, 2.0),
+        (0.8, 0.01),
+    ):
+        arrays, geometry = fixture._three_user_arrays(rho, isolated_power)
+        geometry = replace(
+            geometry,
+            links=tuple(replace(link, elevation_deg=45.0) for link in geometry.links),
+        )
+        kwargs = dict(
+            field="realised",
+            boundary_indices=(0,),
+            fading_quantile_alpha=0.10,
+        )
+        simple = margin_batch.evaluate_ar_tdm_catalogue(arrays, selected, **kwargs)
+        dense = strict.evaluate_ar_tdm_catalogue(arrays, selected, **kwargs)
+        config = architectures.RadiationConfig(fading_quantile_alpha=0.10)
+        with strict.scalar_formulation("margin-cleared"):
+            scalar = architectures.AngleRateTPC_TDM().radiate(
+                config, geometry, "realised"
+            )
+        assert architectures._rate_targets is original_target
+        assert architectures._solve_power is original_solve
+        scalar_power = max(
+            tx.rf_power_w for slot in scalar.slots for tx in slot.transmissions
+        )
+        scalar_bits = math.fsum(
+            slot.fraction
+            * tx.bandwidth_hz
+            * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
+            * duration
+            for slot in scalar.slots
+            for tx in slot.transmissions
+        )
+        inventory = HardwareInventory.fixed(link.beam for link in geometry.links)
+        scalar_joules = schedule_energy(
+            inventory,
+            ((slot.fraction, dict(slot.beam_rf_w)) for slot in scalar.slots),
+            duration_s=duration,
+        ).joules
+        scalar_no_mode = sum(
+            tx.m_tx is None for slot in scalar.slots for tx in slot.transmissions
+        )
+        dense_no_mode = int(dense.transmitted_mode_counts[0, 0])
+        np.testing.assert_allclose(
+            scalar_power, dense.max_rf_power_w[0], rtol=2e-14, atol=0
+        )
+        np.testing.assert_allclose(
+            scalar_bits, dense.bits.sum(), rtol=2e-14, atol=0
+        )
+        np.testing.assert_allclose(
+            scalar_joules, dense.joules[0], rtol=2e-14, atol=0
+        )
+        assert scalar_no_mode == dense_no_mode
+        assert scalar.certificate.iterations == int(dense.certificate_iterations[0])
+        assert scalar.valid and bool(dense.valid[0])
+
+        power = float(dense.max_rf_power_w[0])
+        direct = float(arrays.nominal_gain[0, 0])
+        cross = float(arrays.cross_base_nominal[0, 0, 1])
+        noise = float(scalar.slots[0].transmissions[0].noise_w)
+        nominal = power * direct / (noise + 2.0 * cross * power)
+        uncapped = power < BEAM_RF_CAP_W
+        nominal_clear = nominal >= gamma / q
+        mode_clear = (
+            q * nominal
+            >= scalar.slots[0].transmissions[0].m_target.threshold_linear
+        )
+        if uncapped:
+            assert nominal_clear and mode_clear and dense_no_mode == 0
+        assert int(dense.certificate_iterations[0]) <= POWER_SOLVER_ITERATION_CAP
+        rows.append(
+            {
+                "rho": rho,
+                "isolated_target_power_w": isolated_power,
+                "uncapped": uncapped,
+                "simple_no_mode": int(simple.transmitted_mode_counts[0, 0]),
+                "strict_no_mode": dense_no_mode,
+                "strict_power_w": power,
+                "nominal_at_least_gamma_over_q": nominal_clear,
+                "q_nominal_at_least_target_mode_threshold": mode_clear,
+                "scalar_dense_power_hex_equal": scalar_power.hex() == power.hex(),
+                "scalar_dense_mode_count_equal": scalar_no_mode == dense_no_mode,
+                "iterations": int(dense.certificate_iterations[0]),
+            }
+        )
+    result = {
+        "status": "PASS",
+        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+        "fixture_count": len(rows),
+        "checks": (
+            "Every uncapped fixture clears both nominal Gamma/q and "
+            "q-adjusted target-mode threshold; scalar and dense paths agree."
+        ),
+        "iteration_budget": POWER_SOLVER_ITERATION_CAP,
+        "source_sha256": strict.SOURCE_SHA256,
+        "cases": rows,
+        "dense_clearance_counters": strict.CLEARANCE_DIAGNOSTICS,
+        "scalar_clearance_counters": dict(strict.SCALAR_CLEARANCE_DIAGNOSTICS),
+        "original_scalar_functions_restored": (
+            architectures._rate_targets is original_target
+            and architectures._solve_power is original_solve
+        ),
+    }
+    output = HERE / "strict-clearance-verification.json"
+    output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

