diff --git a/.scratch/beamwidth/replay_committed_no_mode.py b/.scratch/beamwidth/replay_committed_no_mode.py
new file mode 100644
index 0000000000000000000000000000000000000000..08edf84efeb24f185f4085c1ad8234fa2eb68904
--- /dev/null
+++ b/.scratch/beamwidth/replay_committed_no_mode.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Replay stored assignments for the requested uncapped occupancy-one census."""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+sys.path.insert(0, str(HERE))
+
+
+def _load_runner():
+    path = HERE / "run_beamwidth_network.py"
+    spec = importlib.util.spec_from_file_location("no_mode_replay_runner", path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load beam-width runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+runner = _load_runner()
+from mcrl.physics_v025.provider_legacy import factory
+
+
+def _configuration_from_id(base, configuration_id: str):
+    if configuration_id.startswith("BASE:"):
+        return base
+    if not configuration_id.startswith("CFG:"):
+        raise RuntimeError(f"unexpected configuration id: {configuration_id}")
+    mapping = {}
+    for assignment in configuration_id[4:].split(";"):
+        user, norad, chain = assignment.split(":")
+        mapping[int(user)] = (int(norad), int(chain))
+    config = runner.probe._configuration(base, mapping, kind="no-mode-replay")
+    if config.configuration_id != configuration_id:
+        raise RuntimeError("configuration reconstruction failed")
+    return config
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("receipts", nargs="+", type=Path)
+    parser.add_argument("--provisioning-rule", choices=("sealed", "margin"), required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    runner.PROVISIONING_RULE = args.provisioning_rule
+    results = []
+    totals = defaultdict(lambda: defaultdict(int))
+    for receipt_path in args.receipts:
+        source = json.loads(receipt_path.read_text(encoding="ascii"))
+        width = float(source["beamwidth_diagnostic"]["off_axis_half_power_deg"])
+        runner.channel_module.TX_FULL_HPBW_DEG = 2.0 * width
+        tapes = {}
+        for world_index in (1, 2):
+            tape = runner.probe.build_world_tape(
+                domain=runner.probe.PROBE_WORLD_DOMAINS[world_index - 1],
+                provider=factory(),
+                steps=4,
+                start_time_s=0.0,
+            )
+            expected = next(
+                row for row in source["worlds"] if row["world_index"] == world_index
+            )
+            if tape.digest != expected["world_sha256"]:
+                raise RuntimeError("world digest mismatch")
+            tapes[world_index] = tape
+        anchors = []
+        for recorded in source["anchors"]:
+            tape = tapes[int(recorded["world_index"])]
+            step_index = int(recorded["step_index"])
+            base = runner.probe._base_configuration(tape, step_index, "nearest-eligible")
+            row = {"anchor_id": recorded["anchor_id"], "selectors": {}}
+            for name in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
+                config = _configuration_from_id(
+                    base, recorded["committed"][name]["configuration_id"]
+                )
+                census = runner.interference_structure(
+                    tape=tape, step_index=step_index, selected=config
+                )
+                attempts = int(census["occupancy_one_uncapped_no_mode_attempts"])
+                near = int(census["occupancy_one_uncapped_no_mode_within_1e8_db"])
+                row["selectors"][name] = {
+                    "attempts": attempts,
+                    "within_1e8_db": near,
+                    "deficit_db_min": census[
+                        "occupancy_one_uncapped_no_mode_deficit_db_min"
+                    ],
+                    "deficit_db_max": census[
+                        "occupancy_one_uncapped_no_mode_deficit_db_max"
+                    ],
+                }
+                totals[str(width)][name + ":attempts"] += attempts
+                totals[str(width)][name + ":within_1e8_db"] += near
+            anchors.append(row)
+        results.append(
+            {
+                "receipt": str(receipt_path),
+                "width_deg": width,
+                "anchors": anchors,
+            }
+        )
+        print(json.dumps({"completed": str(receipt_path), "width_deg": width}), flush=True)
+    payload = {
+        "status": "PASS",
+        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+        "provisioning_rule": args.provisioning_rule,
+        "definition": (
+            "Unweighted native TDM transmission attempts at all 48 boundaries "
+            "with realised beam occupancy one, m_tx=None, and RF power at least "
+            "1e-9 W below the 1.65-W cap; near means floor-threshold deficit in "
+            "[0,1e-8] dB."
+        ),
+        "receipts": results,
+        "totals_by_width": {key: dict(value) for key, value in totals.items()},
+    }
+    args.output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(payload["totals_by_width"], indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
