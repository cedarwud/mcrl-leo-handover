        threshold_steps = int(round(D2_TTT_S / D2_MEASUREMENT_STEP_S))
        if not math.isclose(
            threshold_steps * D2_MEASUREMENT_STEP_S,
            D2_TTT_S,
            rel_tol=0.0,
            abs_tol=1.0e-12,
        ):
