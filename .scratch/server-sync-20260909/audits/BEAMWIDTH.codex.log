   119	@dataclass(frozen=True)
   120	class SelectionMetric:
   121	    config: object
   122	    bits: float
   123	    joules: float
   124	    served_count: int
   125	
   126	
   127	_WORKER_TAPE = None
   128	
   129	
   130	def _selection_worker(task):
   131	    step_index, base, configs = task
   132	    evaluator = probe.StepEvaluator(
   133	        _WORKER_TAPE,
   134	        probe._setting("a-r0"),
   135	        step_index,
   136	        transition_from=base,
   137	        field="realised",
   138	        run_setting=probe.run_setting_for("a-r0"),
   139	        boundary_indices=(0,),
   140	        fading_quantile_alpha=0.10,
   141	    )
   142	    evaluator.evaluate_many(configs)
   143	    rows = []
   144	    for config in configs:
   145	        profile = evaluator._evaluated.get(config.configuration_id)
   146	        if profile is not None:
   147	            rows.append(
   148	                SelectionMetric(
   149	                    config, profile.bits, profile.joules, served(profile)
   150	                )
   151	            )
   152	    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations
