| 2 | 10 | 19.770 | -4.396 | -8.819 | 15.374 | 2.120 | 2.519 | 4.639 |
| 3 | 10 | 16.687 | -5.583 | -4.142 | 11.104 | 3.398 | 6.238 | 9.636 |
