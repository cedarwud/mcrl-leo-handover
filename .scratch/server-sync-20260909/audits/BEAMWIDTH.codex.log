   154	
   155	class ParallelSelectionEvaluator:
   156	    """Persistent fork workers over one detached tape; exact stable reduction."""
   157	
   158	    def __init__(self, tape, step_index: int, base, pool) -> None:
   159	        self.tape = tape
   160	        self.step_index = step_index
   161	        self.base = base
   162	        self.pool = pool
   163	        self._evaluated: dict[str, SelectionMetric] = {}
   164	        self._invalid: set[str] = set()
   165	        self.physical_evaluations = 0
   166	
   167	    def evaluate_many(self, configs: Sequence[object]) -> None:
   168	        missing_by_id = {
   169	            row.configuration_id: row
   170	            for row in configs
   171	            if row.configuration_id not in self._evaluated
   172	            and row.configuration_id not in self._invalid
   173	        }
   174	        missing = tuple(missing_by_id.values())
   175	        if not missing:
   176	            return
   177	        if self.pool is None:
   178	            results = [_selection_worker((self.step_index, self.base, missing))]
   179	        else:
   180	            shards = tuple(
   181	                tuple(missing[index::SELECTION_WORKERS])
   182	                for index in range(SELECTION_WORKERS)
   183	            )
   184	            results = self.pool.map(
   185	                _selection_worker,
   186	                tuple((self.step_index, self.base, shard) for shard in shards),
   187	                chunksize=1,
   188	            )
   189	        unordered = {}
   190	        for rows, invalid, evaluations in results:
   191	            unordered.update((row.config.configuration_id, row) for row in rows)
   192	            self._invalid.update(invalid)
   193	            self.physical_evaluations += evaluations
   194	        for config in missing:
   195	            if config.configuration_id in unordered:
   196	                self._evaluated[config.configuration_id] = unordered[
   197	                    config.configuration_id
   198	                ]
   199	
   200	    def evaluate(self, config) -> SelectionMetric:
   201	        self.evaluate_many((config,))
   202	        try:
   203	            return self._evaluated[config.configuration_id]
   204	        except KeyError:
   205	            raise RuntimeError(
   206	                f"invalid selection configuration {config.configuration_id}"
   207	            ) from None
   208	
   209	
   210	def coordinate_optimum(*, tape, step_index: int, base, evaluator) -> CoordinateResult:
   211	    """Deterministic cyclic best responses to a strict local optimum."""
   212	
   213	    options, _ = probe._legal_options(tape, step_index)
   214	    base_profile = evaluator.evaluate(base)
   215	    guard = served(base_profile)
   216	    current = base
   217	    iterations = 0
   218	    passes = 0
   219	    comparisons = 0
   220	    terminal: tuple[object, ...] = ()
   221	
   222	    while True:
   223	        passes += 1
   224	        pass_moves = 0
   225	        pass_candidates = []
   226	        for user in sorted(options):
   227	            current_profile = evaluator.evaluate(current)
   228	            current_value = objective(current_profile)
   229	            candidates = []
   230	            current_map = current.mapping
   231	            for identity in options[user]:
   232	                if identity == current_map[user]:
   233	                    continue
   234	                mapping = dict(current_map)
   235	                mapping[user] = identity
   236	                candidates.append(
   237	                    _configuration(base, mapping, "unilateral-coordinate")
   238	                )
   239	            evaluator.evaluate_many(candidates)
   240	            comparisons += len(candidates)
   241	            pass_candidates.extend(candidates)
   242	            best = current
   243	            best_value = current_value
   244	            for candidate in candidates:
   245	                profile = evaluator._evaluated.get(candidate.configuration_id)
   246	                if profile is None or served(profile) < guard:
   247	                    continue
   248	                value = objective(profile)
   249	                if value > best_value or (
   250	                    value == best_value
   251	                    and best is not current
   252	                    and candidate.configuration_id < best.configuration_id
   253	                ):
   254	                    best = candidate
   255	                    best_value = value
   256	            if best.assignments != current.assignments:
   257	                current = best
   258	                iterations += 1
   259	                pass_moves += 1
   260	        if pass_moves == 0:
   261	            terminal = tuple(pass_candidates)
   262	            break
   263	        print(
   264	            json.dumps(
   265	                {
   266	                    "coordinate_step": step_index,
   267	                    "completed_passes": passes,
   268	                    "moves_in_pass": pass_moves,
   269	                    "completed_improving_moves": iterations,
   270	                    "unique_selection_evaluations": evaluator.physical_evaluations,
   271	                },
   272	                sort_keys=True,
   273	            ),
   274	            flush=True,
   275	        )
   276	
   277	    # Every action here was physically evaluated in the terminal certificate.
   278	    # The alternate is chosen per user only to instantiate physically-defined
   279	    # coalition memberships; users are never ranked by this value.
   280	    best_alternatives: dict[int, tuple[int, int]] = {}
   281	    current_map = current.mapping
   282	    for user in sorted(options):
   283	        rows = []
   284	        for identity in options[user]:
   285	            if identity == current_map[user]:
   286	                continue
   287	            mapping = dict(current_map)
   288	            mapping[user] = identity
   289	            candidate = _configuration(base, mapping, "terminal-alternate")
   290	            profile = evaluator._evaluated.get(candidate.configuration_id)
   291	            if profile is not None:
   292	                rows.append((objective(profile), candidate.configuration_id, identity))
   293	        if rows:
   294	            best_alternatives[user] = min(
   295	                rows, key=lambda row: (-row[0], row[1])
   296	            )[2]
   297	
   298	    return CoordinateResult(
   299	        current,
   300	        iterations,
   301	        passes,
   302	        terminal,
   303	        best_alternatives,
   304	        comparisons,
   305	    )
   306	
   307	
   308	def _interference_contributors(
   309	    *, tape, step_index: int, current, victim: int
   310	) -> tuple[int, ...]:
   311	    """Rank users by physical nominal interference, never by reward marginal."""
   312	
   313	    mapping = current.mapping
   314	    victim_beam = mapping[victim]
   315	    if victim_beam is None:
   316	        return ()
   317	    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
   318	    step = tape.steps[step_index]
   319	    scores = []
   320	    if step.arrays is not None:
   321	        arrays = step.arrays
   322	        victim_row = arrays._row_index().get((victim, victim_beam))
   323	        aggressor_of = arrays._aggressor_index()
   324	        if victim_row is None:
   325	            return ()
   326	        for user, beam in sorted(mapping.items()):
   327	            if user == victim or beam is None or beam == victim_beam:
   328	                continue
   329	            aggressor_index = aggressor_of.get(beam)
   330	            if aggressor_index is None:
   331	                continue
   332	            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
   333	            score = gain / occupancy[beam]
   334	            if score > 0.0:
   335	                scores.append((score, user))
   336	    else:
   337	        boundary = step.boundary_at(0)
   338	        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
   339	        victim_row = by_key.get((victim, victim_beam))
   340	        if victim_row is None:
   341	            return ()
   342	        cross = dict(victim_row.nominal_cross_gain_by_identity)
   343	        for user, beam in sorted(mapping.items()):
   344	            if user == victim or beam is None or beam == victim_beam:
   345	                continue
   346	            score = cross.get(beam, 0.0) / occupancy[beam]
   347	            if score > 0.0:
   348	                scores.append((score, user))
   349	    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))
   350	
   351	
   352	def build_joint_candidates(
   353	    *, tape, step_index: int, base, unilateral, best_alternatives
   354	) -> tuple[tuple[object, ...], Mapping[tuple, tuple[dict[str, object], ...]], dict[str, int]]:
   355	    """Build a bounded catalogue from occupancy and interference mechanisms."""
   356	
   357	    options, _ = probe._legal_options(tape, step_index)
   358	    current_map = unilateral.mapping
   359	    by_beam: dict[tuple[int, int], tuple[int, ...]] = {}
   360	    for beam in sorted({row for row in current_map.values() if row is not None}):
   361	        by_beam[beam] = tuple(
   362	            user for user, identity in sorted(current_map.items()) if identity == beam
   363	        )
   364	
   365	    aliases: dict[tuple, list[dict[str, object]]] = {}
   366	    configs: dict[tuple, object] = {}
   367	    family_rows = Counter()
   368	
   369	    def add(mapping, *, family: str, coalition: Sequence[int], detail: str) -> None:
   370	        changed = tuple(
   371	            user
   372	            for user in sorted(current_map)
   373	            if mapping[user] != current_map[user]
   374	        )
   375	        if len(changed) < 2:
   376	            return
   377	        assignments = tuple(sorted(mapping.items()))
   378	        aliases.setdefault(assignments, []).append(
   379	            {
   380	                "family": family,
   381	                "coalition_users": list(sorted(coalition)),
   382	                "changed_users": list(changed),
   383	                "detail": detail,
   384	            }
   385	        )
   386	        if assignments not in configs:
   387	            configs[assignments] = _configuration(base, mapping, family)
   388	            family_rows[family] += 1
   389	
   390	    occupant_rows = 0
   391	    for beam, occupants in by_beam.items():
   392	        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
   393	            for coalition in itertools.combinations(occupants, size):
   394	                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
   395	                    break
   396	                if any(user not in best_alternatives for user in coalition):
   397	                    continue
   398	                mapping = dict(current_map)
   399	                for user in coalition:
   400	                    mapping[user] = best_alternatives[user]
   401	                add(
   402	                    mapping,
   403	                    family="beam-occupant-subset",
   404	                    coalition=coalition,
   405	                    detail=f"origin={beam[0]}:{beam[1]};size={size}",
   406	                )
   407	                occupant_rows += 1
   408	            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
   409	                break
   410	        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
   411	            break
   412	
   413	    for victim in sorted(current_map):
   414	        if victim not in best_alternatives:
   415	            continue
   416	        contributors = _interference_contributors(
   417	            tape=tape, step_index=step_index, current=unilateral, victim=victim
   418	        )
   419	        for count in (2, 3):
   420	            if len(contributors) < count:
   421	                continue
   422	            coalition = (victim, *contributors[:count])
   423	            if any(user not in best_alternatives for user in coalition):
   424	                continue
   425	            mapping = dict(current_map)
   426	            for user in coalition:
   427	                mapping[user] = best_alternatives[user]
   428	            add(
   429	                mapping,
   430	                family=f"victim-plus-top-{count}-contributors",
   431	                coalition=coalition,
   432	                detail=f"victim={victim};contributors={','.join(map(str, contributors[:count]))}",
   433	            )
   434	
   435	    for beam, occupants in by_beam.items():
   436	        if len(occupants) < 2:
   437	            continue
   438	        common = set(options[occupants[0]])
   439	        for user in occupants[1:]:
   440	            common.intersection_update(options[user])
   441	        common.discard(beam)
   442	        for destination in sorted(common):
   443	            mapping = dict(current_map)
   444	            for user in occupants:
   445	                mapping[user] = destination
   446	            add(
   447	                mapping,
   448	                family="complete-beam-evacuation",
   449	                coalition=occupants,
   450	                detail=(
   451	                    f"origin={beam[0]}:{beam[1]};"
   452	                    f"destination={destination[0]}:{destination[1]}"
   453	                ),
   454	            )
   455	
   456	    ordered = tuple(configs[key] for key in sorted(configs))
   457	    if len(ordered) > JOINT_CANDIDATE_CAP:
   458	        raise RuntimeError(
   459	            f"mechanism catalogue exceeds fixed bound: {len(ordered)} > {JOINT_CANDIDATE_CAP}"
   460	        )
   461	    return (
   462	        ordered,
   463	        {key: tuple(value) for key, value in aliases.items()},
   464	        dict(sorted(family_rows.items())),
   465	    )
   466	
   467	
   468	def interference_structure(*, tape, step_index: int, selected) -> dict[str, object]:
   469	    """Classify infeasible user-steps by an exact zero-cross-interference rerun.
   470	
   471	    The assignment, beam occupancy, direct links, rate target, RF cap, and all
   472	    other constants are held fixed.  A user-step is interference-limited only
   473	    when it is infeasible with the physical cross-gain matrix and feasible at
   474	    every boundary when that matrix alone is zeroed.  Top-1 share is computed
   475	    over the failing transmissions of those interference-limited user-steps,
   476	    with TDM-slot and trapezoidal boundary weights.
   477	    """
   478	
   479	    assignments = selected.mapping
   480	    users = tuple(sorted(assignments))
   481	    actual_all = {user: True for user in users}
   482	    zero_all = {user: True for user in users}
   483	    contributions: dict[int, list[tuple[float, float]]] = {
   484	        user: [] for user in users
   485	    }
   486	    geometries = tape.geometry_for(step_index=step_index, assignments=assignments)
   487	    architecture = AngleRateTPC_TDM()
   488	    config = RadiationConfig(fading_quantile_alpha=0.10)
   489	
   490	    for boundary_index, (_absolute_time, geometry) in enumerate(geometries):
   491	        endpoint_weight = 0.5 if boundary_index in (0, len(geometries) - 1) else 1.0
   492	        actual = architecture.radiate(config, geometry, "nominal")
   493	        zeros = np.zeros_like(geometry.nominal_cross_gain)
   494	        zero_geometry = Geometry(geometry.links, zeros, zeros)
   495	        without_cross = architecture.radiate(config, zero_geometry, "nominal")
   496	        actual_rows = actual.per_user_rate_target_feasible or {}
   497	        zero_rows = without_cross.per_user_rate_target_feasible or {}
   498	        live_users = {link.user_id for link in geometry.links}
   499	        for user in users:
   500	            actual_all[user] &= user in live_users and bool(actual_rows.get(user, False))
   501	            zero_all[user] &= user in live_users and bool(zero_rows.get(user, False))
   502	
   503	        index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
   504	        for slot in actual.slots:
   505	            tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
   506	            for tx in slot.transmissions:
   507	                if tx.rate_target_feasible is None or bool(tx.rate_target_feasible):
   508	                    continue
   509	                victim_index = index_by_user[tx.user_id]
   510	                victim_link = geometry.links[victim_index]
   511	                terms = []
   512	                for aggressor in slot.transmissions:
   513	                    if aggressor.user_id == tx.user_id:
   514	                        continue
   515	                    aggressor_index = index_by_user[aggressor.user_id]
   516	                    aggressor_link = geometry.links[aggressor_index]
   517	                    if aggressor_link.beam == victim_link.beam:
   518	                        continue
   519	                    if aggressor_link.color != victim_link.color:
   520	                        continue
   521	                    term = (
   522	                        float(geometry.nominal_cross_gain[victim_index, aggressor_index])
   523	                        * aggressor.rf_power_w
   524	                    )
   525	                    if term > 0.0:
   526	                        terms.append(term)
   527	                total = math.fsum(terms)
   528	                if total > 0.0:
   529	                    weight = endpoint_weight * slot.fraction
   530	                    contributions[tx.user_id].append((weight * max(terms), weight * total))
   531	
   532	    infeasible = tuple(user for user in users if not actual_all[user])
   533	    interference_limited = tuple(
   534	        user for user in infeasible if zero_all[user]
   535	    )
   536	    weighted_top1 = math.fsum(
   537	        top1
   538	        for user in interference_limited
   539	        for top1, _total in contributions[user]
   540	    )
   541	    weighted_total = math.fsum(
   542	        total
   543	        for user in interference_limited
   544	        for _top1, total in contributions[user]
   545	    )
   546	    return {
   547	        "user_steps": len(users),
   548	        "infeasible_user_steps": len(infeasible),
   549	        "interference_limited_user_steps": len(interference_limited),
   550	        "weighted_top1_interference_w": weighted_top1,
   551	        "weighted_total_interference_w": weighted_total,
   552	        "definition": (
   553	            "infeasible under physical cross-gain and feasible at every boundary "
   554	            "when cross-gain alone is zeroed"
   555	        ),
   556	    }
   557	
   558	
   559	def evaluate_anchor(*, tape, world_index: int, step_index: int, pool=None) -> dict[str, object]:
   560	    setting = probe._setting("a-r0")
   561	    run_setting = probe.run_setting_for("a-r0")
   562	    base = probe._base_configuration(tape, step_index, "nearest-eligible")
   563	    selection = ParallelSelectionEvaluator(tape, step_index, base, pool)
   564	    started = time.perf_counter()
   565	    coordinate = coordinate_optimum(
   566	        tape=tape,
   567	        step_index=step_index,
   568	        base=base,
   569	        evaluator=selection,
   570	    )
   571	    unilateral = coordinate.selected
   572	    before_joint_evaluations = selection.physical_evaluations
   573	    candidates, aliases, family_counts = build_joint_candidates(
   574	        tape=tape,
   575	        step_index=step_index,
   576	        base=base,
   577	        unilateral=unilateral,
   578	        best_alternatives=coordinate.best_alternatives,
   579	    )
   580	    selection.evaluate_many(candidates)
   581	    base_profile = selection.evaluate(base)
   582	    unilateral_profile = selection.evaluate(unilateral)
   583	    guard = served(base_profile)
   584	    best = unilateral
   585	    best_profile = unilateral_profile
   586	    for candidate in candidates:
   587	        profile = selection._evaluated.get(candidate.configuration_id)
   588	        if profile is None or served(profile) < guard:
   589	            continue
   590	        value = objective(profile)
   591	        best_value = objective(best_profile)
   592	        if value > best_value or (
   593	            value == best_value
   594	            and best is not unilateral
   595	            and candidate.configuration_id < best.configuration_id
   596	        ):
   597	            best, best_profile = candidate, profile
   598	
   599	    coalition_users = tuple(
   600	        user
   601	        for user in sorted(unilateral.mapping)
   602	        if unilateral.mapping[user] != best.mapping[user]
   603	    )
   604	    psi = Fraction()
   605	    singleton_sum = Fraction()
   606	    if coalition_users:
   607	        for user in coalition_users:
   608	            mapping = unilateral.mapping
   609	            mapping[user] = best.mapping[user]
   610	            singleton = _configuration(base, mapping, "oracle-singleton-component")
   611	            singleton_profile = selection.evaluate(singleton)
   612	            singleton_sum += objective(singleton_profile) - objective(unilateral_profile)
   613	        psi = (
   614	            objective(best_profile)
   615	            - objective(unilateral_profile)
   616	            - singleton_sum
   617	        )
   618	
   619	    committed_counter = probe.EvaluationCounter()
   620	    committed = probe.StepEvaluator(
   621	        tape,
   622	        setting,
   623	        step_index,
   624	        transition_from=base,
   625	        field="realised",
   626	        counter=committed_counter,
   627	        run_setting=run_setting,
   628	        boundary_indices=tuple(range(48)),
   629	        fading_quantile_alpha=0.10,
   630	    )
   631	    unique = {
   632	        row.configuration_id: row for row in (base, unilateral, best)
   633	    }
   634	    committed.evaluate_many(tuple(unique.values()))
   635	
   636	    profiles = {
   637	        "BASELINE": committed.evaluate(base),
   638	        "UNILATERAL": committed.evaluate(unilateral),
   639	        "ORACLE_SET": committed.evaluate(best),
   640	    }
   641	    structure = {
   642	        "BASELINE": interference_structure(
   643	            tape=tape, step_index=step_index, selected=base
   644	        ),
   645	        "UNILATERAL": interference_structure(
   646	            tape=tape, step_index=step_index, selected=unilateral
   647	        ),
   648	        "ORACLE_SET": interference_structure(
   649	            tape=tape, step_index=step_index, selected=best
   650	        ),
   651	    }
   652	    chosen_aliases = aliases.get(best.assignments, ())
   653	    qualifying = bool(coalition_users) and objective(best_profile) > objective(
   654	        unilateral_profile
   655	    )
   656	    row = {
   657	        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
   658	        "world_index": world_index,
   659	        "world_domain": tape.domain,
   660	        "world_sha256": tape.digest,
   661	        "tle_date": tape.tle_date,
   662	        "training_seed": tape.training_seed,
   663	        "step_index": step_index,
   664	        "selection": {
   665	            "field": "realised",
   666	            "boundary_indices": [0],
   667	            "held_snapshot_seconds": 30.08,
   668	            "eta_ref": frac_payload(ETA_REF),
   669	            "baseline_served_guard": guard,
   670	            "unilateral_iterations": coordinate.iterations,
   671	            "unilateral_passes": coordinate.passes,
   672	            "unilateral_terminal_certified": True,
   673	            "unilateral_candidate_comparisons": coordinate.candidate_comparisons,
   674	            "joint_catalogue_unique": len(candidates),
   675	            "joint_catalogue_aliases": sum(len(value) for value in aliases.values()),
   676	            "joint_family_unique_counts": family_counts,
   677	            "qualifying_coalition_existed": qualifying,
   678	            "selected_coalition_size": len(coalition_users) if qualifying else 0,
   679	            "selected_coalition_users": list(coalition_users) if qualifying else [],
