   147	def upgrade_q2_state_v2(
   148	    q2_state_v1: Sequence[float],
   149	    *,
   150	    offset_elevations_deg: Sequence[float],
   151	    null_action: bool,
   152	) -> tuple[float, ...]:
   153	    """Project one learner-normalized v1 vector to learner-normalized Q2-v2."""
   154	
   155	    if len(q2_state_v1) != 22:
   156	        raise Q2SchemaV2Error("v1 Q2 state must have exactly 22 slots")
   157	    old = tuple(float(value) for value in q2_state_v1)
   158	    if not all(math.isfinite(value) for value in old):
   159	        raise Q2SchemaV2Error("v1 Q2 state contains a non-finite value")
   160	    elevations = tuple(float(value) for value in offset_elevations_deg)
   161	    if len(elevations) != 3 or not all(math.isfinite(value) for value in elevations):
   162	        raise Q2SchemaV2Error("exactly three finite offset elevations are required")
   163	    if null_action:
   164	        if elevations != (0.0, 0.0, 0.0):
   165	            raise Q2SchemaV2Error("null action geometry must use explicit absent-link zeros")
   166	    elif not all(-90.0 <= elevation <= 90.0 for elevation in elevations):
   167	        raise Q2SchemaV2Error("non-null offset elevation is outside physical bounds")
   168	
   169	    # Old slots 6, 10, 14, and 18 are excluded. Elevation is appended to each
   170	    # corresponding three-offset block. Every retained old value is unchanged.
   171	    projected: list[float] = [*old[0:6], *old[7:10]]
   172	    for offset, start in enumerate((10, 14, 18)):
   173	        projected.extend((old[start + 1], old[start + 2], old[start + 3], elevations[offset] / 90.0))
   174	    result = tuple(projected)
   175	    if len(result) != len(Q2_V2_FEATURES):
   176	        raise AssertionError("internal Q2-v2 projection length drifted")
   177	    return result
   178	
   179	
   180	def project_row_payload_v2(
   181	    parent_payload: Mapping[str, object],
   182	    *,
   183	    offset_elevations_deg: Sequence[float],
   184	    geometry_source: str,
   185	) -> dict[str, object]:
   186	    """Create an authenticated Q2-v2 row payload from a sealed v1 row."""
   187	
   188	    if parent_payload.get("q2_schema_sha256") != Q2_V1_SCHEMA_SHA256:
   189	        raise Q2SchemaV2Error("parent row is not the sealed Q2-v1 schema")
   190	    raw_state = parent_payload.get("q2_state")
   191	    if not isinstance(raw_state, list) or len(raw_state) != 22:
   192	        raise Q2SchemaV2Error("parent q2_state is malformed")
   193	    old = tuple(parse_float_hex(value, field="q2_state") for value in raw_state)
   194	    null_action = parent_payload.get("null_action")
   195	    if type(null_action) is not bool:
   196	        raise Q2SchemaV2Error("parent null_action is not boolean")
   197	    elevations = tuple(float(value) for value in offset_elevations_deg)
   198	    state = upgrade_q2_state_v2(old, offset_elevations_deg=elevations, null_action=null_action)
   199	    if not geometry_source:
   200	        raise Q2SchemaV2Error("geometry source must be named")
   201	
   202	    result = dict(parent_payload)
   203	    result["schema"] = ROW_Q2_V2_SCHEMA_VERSION
   204	    result["q2_state"] = [float_hex(value) for value in state]
   205	    result["q2_schema_sha256"] = Q2_V2_SCHEMA_SHA256
   206	    result["q2_v1_parent_row_sha256"] = canonical_sha256(parent_payload)
   207	    result["q2_geometry_source"] = geometry_source
   208	    result["q2_visible_primitives_sha256"] = canonical_sha256({
   209	        "parent_visible_primitives_sha256": parent_payload.get("visible_primitives_sha256"),
   210	        "offset_elevations_deg_hex": [float_hex(value) for value in elevations],
   211	        "geometry_source": geometry_source,
   212	    })
   213	    validate_v2_row_payload(result)
   214	    return result
