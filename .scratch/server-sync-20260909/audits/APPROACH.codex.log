   217	def validate_v2_row_payload(payload: Mapping[str, object]) -> None:
   218	    if payload.get("schema") != ROW_Q2_V2_SCHEMA_VERSION:
   219	        raise Q2SchemaV2Error("row schema is not Q2-v2")
   220	    if payload.get("q2_schema_sha256") != Q2_V2_SCHEMA_SHA256:
   221	        raise Q2SchemaV2Error("row Q2 digest is not Q2-v2")
   222	    state = payload.get("q2_state")
   223	    if not isinstance(state, list) or len(state) != len(Q2_V2_FEATURES):
   224	        raise Q2SchemaV2Error("Q2-v2 row state dimension drifted")
   225	    for value in state:
   226	        parse_float_hex(value, field="q2_state")
   227	    for field in ("q2_v1_parent_row_sha256", "q2_visible_primitives_sha256"):
   228	        digest = payload.get(field)
   229	        if not isinstance(digest, str) or len(digest) != 64 or any(
   230	            character not in "0123456789abcdef" for character in digest
   231	        ):
   232	            raise Q2SchemaV2Error(f"{field} is not a lowercase SHA-256")
   233	
   234	
   235	def encode_v2_shard(rows: Iterable[Mapping[str, object]]) -> bytes:
   236	    material = [dict(row) for row in rows]
   237	    if not material:
   238	        raise Q2SchemaV2Error("cannot encode an empty Q2-v2 shard")
   239	    for row in material:
   240	        validate_v2_row_payload(row)
   241	    q1_digests = {row.get("q1_schema_sha256") for row in material}
   242	    if len(q1_digests) != 1:
   243	        raise Q2SchemaV2Error("Q2-v2 shard rows disagree on Q1 schema")
   244	    header = {
   245	        "schema": SHARD_Q2_V2_SCHEMA_VERSION,
   246	        "row_count": len(material),
   247	        "rows_sha256": canonical_sha256(material),
   248	        "q1_schema_sha256": next(iter(q1_digests)),
   249	        "q2_schema_sha256": Q2_V2_SCHEMA_SHA256,
   250	    }
   251	    return b"\n".join(canonical_json_bytes(value) for value in (header, *material)) + b"\n"
   252	
   253	
   254	def decode_v2_shard(encoded: bytes) -> tuple[dict[str, object], ...]:
   255	    try:
   256	        values = [json.loads(line.decode("ascii")) for line in encoded.splitlines()]
   257	    except (UnicodeError, json.JSONDecodeError) as error:
   258	        raise Q2SchemaV2Error("cannot parse Q2-v2 shard") from error
   259	    if not values or not isinstance(values[0], dict):
   260	        raise Q2SchemaV2Error("Q2-v2 shard header is missing")
   261	    if encoded != b"\n".join(canonical_json_bytes(value) for value in values) + b"\n":
   262	        raise Q2SchemaV2Error("Q2-v2 shard is not canonical JSONL")
   263	    header, rows = values[0], values[1:]
   264	    if (
   265	        header.get("schema") != SHARD_Q2_V2_SCHEMA_VERSION
   266	        or header.get("q2_schema_sha256") != Q2_V2_SCHEMA_SHA256
   267	        or header.get("row_count") != len(rows)
   268	        or header.get("rows_sha256") != canonical_sha256(rows)
   269	    ):
   270	        raise Q2SchemaV2Error("Q2-v2 shard header/digest check failed")
   271	    for row in rows:
   272	        if not isinstance(row, dict):
   273	            raise Q2SchemaV2Error("Q2-v2 shard row is not an object")
   274	        validate_v2_row_payload(row)
   275	    return tuple(rows)
