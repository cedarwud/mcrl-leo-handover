   380	        "allocation_manifest_digest",
     1	"""Named encoder-variant seam for the Stage-C per-action feature vectors.
     2	
     3	Everything about *which* scalars enter ``q1_state``/``q2_state``, in what
     4	order and at what frozen scale lives behind a named :class:`EncoderVariant`.
     5	Row building, serialization, read-back, training and evaluation discover the
     6	feature width and the schema digests from the variant, so no downstream module
     7	hardcodes 16 or 22.
     8	
     9	Registration invariants that make a row impossible to misattribute:
    10	
    11	* every variant's ``(q1_schema_sha256, q2_schema_sha256)`` pair is unique --
    12	  registration fails loudly on collision, so the digests a row already carries
    13	  resolve back to exactly one variant name via :func:`variant_for_digests`;
    14	* the *default* variant's schema payload is byte-frozen (it omits the
    15	  ``encoder_variant`` key) because its digests are already published in sealed
    16	  shards, checkpoints and terminal reports.  Every other variant carries its
    17	  name inside the hashed payload, which is what makes the pair unique by
    18	  construction.
    19	
    20	The extractor callables take one engine-neutral action evaluation and are only
    21	ever read attribute-wise, so this module deliberately imports nothing from
    22	``state`` -- that is what keeps the import graph acyclic.
    23	"""
    24	
    25	from __future__ import annotations
    26	
    27	from dataclasses import dataclass, field
    28	import importlib
    29	import math
    30	import os
    31	from typing import Callable, Mapping, Sequence
    32	
    33	from .canonical import StageCContractError, canonical_sha256, float_hex
    34	
    35	
    36	Q1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
    37	Q2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"
    38	
    39	#: The production encoder as shipped in contract v1.  Selecting it must yield
    40	#: rows byte-identical to the pre-seam code.
    41	DEFAULT_ENCODER_VARIANT = "V025_CONTRACT_V1"
    42	
    43	#: Process-wide selection levers used by the comparison runner.  ``_MODULES_ENV``
    44	#: names importable modules whose import side effect is variant registration,
    45	#: so a new variant never requires editing training or evaluation code.
    46	_VARIANT_ENV = "MCRL_STAGEC_ENCODER_VARIANT"
    47	_MODULES_ENV = "MCRL_STAGEC_ENCODER_MODULES"
    48	_DEFAULT_PLUGIN_MODULES = ("mcrl.stagec_v025.encoder_variants",)
    49	
    50	
    51	@dataclass(frozen=True, slots=True)
    52	class FeatureSpec:
    53	    name: str
    54	    unit: str
    55	    scale: float
    56	
    57	
    58	def _schema_payload(
    59	    version: str, features: Sequence[FeatureSpec], *, variant: str
    60	) -> dict[str, object]:
    61	    payload: dict[str, object] = {
    62	        "schema": version,
    63	        "normalization": "raw_value / positive_frozen_scale; signed values retained",
    64	        "shape": [len(features)],
    65	        "features": [
    66	            {"name": item.name, "unit": item.unit, "scale_hex": float_hex(item.scale)}
    67	            for item in features
    68	        ],
    69	        "removed": ["recurrence_power", "entry_gain_ratio", "segment_age"],
    70	    }
    71	    if variant != DEFAULT_ENCODER_VARIANT:
    72	        # Deliberate asymmetry: the default payload is frozen byte-for-byte
    73	        # because its digest is already sealed into published artefacts.  Any
    74	        # other variant binds its name into the hashed payload, which makes the
    75	        # digest pair unique by construction rather than by luck.
    76	        payload["encoder_variant"] = variant
    77	    return payload
    78	
    79	
    80	def _normalize(
    81	    raw: Sequence[float], specs: Sequence[FeatureSpec]
    82	) -> tuple[float, ...]:
    83	    if len(raw) != len(specs):
    84	        raise StageCContractError("state field count disagrees with schema")
    85	    result = tuple(float(value) / spec.scale for value, spec in zip(raw, specs, strict=True))
    86	    if not all(math.isfinite(value) for value in result):
    87	        raise StageCContractError("state values must be finite")
    88	    return result
    89	
    90	
    91	@dataclass(frozen=True, slots=True)
    92	class EncoderVariant:
    93	    """One named way of turning an action evaluation into the two vectors."""
    94	
    95	    name: str
    96	    q1_features: tuple[FeatureSpec, ...]
    97	    q2_features: tuple[FeatureSpec, ...]
    98	    q1_raw: Callable[[object], Sequence[float]]
    99	    q2_raw: Callable[[object], Sequence[float]]
   100	    q1_schema: Mapping[str, object] = field(repr=False)
   101	    q2_schema: Mapping[str, object] = field(repr=False)
   102	    q1_schema_sha256: str = ""
   103	    q2_schema_sha256: str = ""
   104	
   105	    @property
   106	    def q1_width(self) -> int:
   107	        return len(self.q1_features)
   108	
   109	    @property
   110	    def q2_width(self) -> int:
   111	        return len(self.q2_features)
   112	
   113	    def encode_q1(self, action: object) -> tuple[float, ...]:
   114	        return _normalize(self.q1_raw(action), self.q1_features)
   115	
   116	    def encode_q2(self, action: object) -> tuple[float, ...]:
   117	        return _normalize(self.q2_raw(action), self.q2_features)
   118	
   119	    def schema_manifest(self) -> dict[str, object]:
   120	        return {
   121	            "q1": {**self.q1_schema, "sha256": self.q1_schema_sha256},
   122	            "q2": {**self.q2_schema, "sha256": self.q2_schema_sha256},
   123	        }
   124	
   125	
   126	_REGISTRY: dict[str, EncoderVariant] = {}
   127	_DIGEST_INDEX: dict[tuple[str, str], str] = {}
   128	
   129	
   130	def register_encoder_variant(
   131	    name: str,
   132	    *,
   133	    q1_features: Sequence[FeatureSpec],
   134	    q2_features: Sequence[FeatureSpec],
   135	    q1_raw: Callable[[object], Sequence[float]],
   136	    q2_raw: Callable[[object], Sequence[float]],
   137	) -> EncoderVariant:
   138	    """Register one named encoder.  Collisions are contract errors, not warnings."""
   139	
   140	    if not name or not name.isascii() or name != name.strip() or " " in name:
   141	        raise StageCContractError("encoder variant name must be a bare ASCII token")
   142	    if name in _REGISTRY:
   143	        raise StageCContractError(f"encoder variant {name!r} is already registered")
   144	    q1 = tuple(q1_features)
   145	    q2 = tuple(q2_features)
   146	    if not q1 or not q2:
   147	        raise StageCContractError("encoder variant must define both feature vectors")
   148	    for spec in (*q1, *q2):
   149	        if not math.isfinite(spec.scale) or spec.scale <= 0.0:
   150	            raise StageCContractError("feature scales must be positive and finite")
   151	    q1_schema = _schema_payload(Q1_SCHEMA_VERSION, q1, variant=name)
   152	    q2_schema = _schema_payload(Q2_SCHEMA_VERSION, q2, variant=name)
   153	    variant = EncoderVariant(
   154	        name=name,
   155	        q1_features=q1,
   156	        q2_features=q2,
   157	        q1_raw=q1_raw,
   158	        q2_raw=q2_raw,
   159	        q1_schema=q1_schema,
   160	        q2_schema=q2_schema,
   161	        q1_schema_sha256=canonical_sha256(q1_schema),
   162	        q2_schema_sha256=canonical_sha256(q2_schema),
   163	    )
   164	    key = (variant.q1_schema_sha256, variant.q2_schema_sha256)
   165	    if key in _DIGEST_INDEX:
   166	        raise StageCContractError(
   167	            f"encoder variant {name!r} shares its q1/q2 schema digests with "
   168	            f"{_DIGEST_INDEX[key]!r}; rows could not be attributed to one encoder"
   169	        )
   170	    _REGISTRY[name] = variant
   171	    _DIGEST_INDEX[key] = name
   172	    return variant
   173	
   174	
   175	def _load_plugin_modules() -> None:
   176	    raw = os.environ.get(_MODULES_ENV)
   177	    names = (
   178	        tuple(part.strip() for part in raw.split(",") if part.strip())
   179	        if raw
   180	        else _DEFAULT_PLUGIN_MODULES
   181	    )
   182	    for module in names:
   183	        try:
   184	            importlib.import_module(module)
   185	        except ImportError as error:
   186	            raise StageCContractError(
   187	                f"encoder variant module {module!r} is not importable"
   188	            ) from error
   189	
   190	
   191	def encoder_variant(name: str | None = None) -> EncoderVariant:
   192	    """Resolve a variant by name, importing registration modules if needed."""
   193	
   194	    wanted = DEFAULT_ENCODER_VARIANT if name is None else str(name)
   195	    if wanted not in _REGISTRY:
   196	        _load_plugin_modules()
   197	    if wanted not in _REGISTRY:
   198	        raise StageCContractError(
   199	            f"unknown encoder variant {wanted!r}; registered: "
   200	            f"{', '.join(sorted(_REGISTRY)) or '<none>'}"
   201	        )
   202	    return _REGISTRY[wanted]
   203	
   204	
   205	def active_encoder_variant() -> EncoderVariant:
   206	    """The variant selected for this process, defaulting to production."""
   207	
   208	    return encoder_variant(os.environ.get(_VARIANT_ENV) or DEFAULT_ENCODER_VARIANT)
   209	
   210	
   211	def variant_for_digests(q1_schema_sha256: str, q2_schema_sha256: str) -> EncoderVariant:
   212	    """Resolve the encoder a persisted row was built with.  Never guesses."""
   213	
   214	    key = (str(q1_schema_sha256), str(q2_schema_sha256))
   215	    if key not in _DIGEST_INDEX:
   216	        _load_plugin_modules()
   217	    if key not in _DIGEST_INDEX:
   218	        raise StageCContractError(
   219	            "state schema digests do not match any registered encoder variant"
   220	        )
   221	    return _REGISTRY[_DIGEST_INDEX[key]]
   222	
   223	
   224	def registered_encoder_variants() -> tuple[str, ...]:
   225	    return tuple(sorted(_REGISTRY))
   226	
   227	
   228	__all__ = [
   229	    "DEFAULT_ENCODER_VARIANT",
   230	    "EncoderVariant",
   231	    "FeatureSpec",
   232	    "Q1_SCHEMA_VERSION",
   233	    "Q2_SCHEMA_VERSION",
   234	    "active_encoder_variant",
   235	    "encoder_variant",
   236	    "register_encoder_variant",
   237	    "registered_encoder_variants",
   238	    "variant_for_digests",
   239	]

