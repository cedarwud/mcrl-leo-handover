   313	    link_from_satellite = tuple(u - s for u, s in zip(user, satellite, strict=True))
   314	    link_from_user = tuple(s - u for s, u in zip(satellite, user, strict=True))
   315	
   316	    def norm(vector: Sequence[float]) -> float:
   317	        return math.sqrt(sum(value * value for value in vector))
   318	
   319	    boresight_norm = norm(boresight)
   320	    satellite_link_norm = norm(link_from_satellite)
