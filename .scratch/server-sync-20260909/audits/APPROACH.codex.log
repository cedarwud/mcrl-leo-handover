   308	        raise Q1SchemaV2Error("ECEF geometry vectors must have length three")
   309	    if not all(math.isfinite(value) for vector in (satellite, centre, user) for value in vector):
   310	        raise Q1SchemaV2Error("ECEF geometry must be finite")
   311	
