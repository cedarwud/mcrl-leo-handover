   344	def _validate_anchor(anchor: PerAnchorEvaluation) -> None:
   345	    if anchor.split != "TRAIN":
   346	        raise StageCContractError("Stage C source construction is TRAIN-only")
   347	    if not anchor.actions:
   348	        raise StageCContractError("anchor must carry at least the explicit null action")
   349	    if not 0 <= anchor.base_action_index < len(anchor.actions):
   350	        raise StageCContractError("base_action_index is outside the action table")
   351	    if not anchor.actions[anchor.base_action_index].legal:
   352	        raise StageCContractError("BASE action must be legal")
   353	    if not any(item.legal and item.action.is_null for item in anchor.actions):
   354	        raise StageCContractError("anchor must include an explicit legal null action")
   355	    if (
   356	        not math.isfinite(anchor.kappa_normalization_bits)
   357	        or anchor.kappa_normalization_bits <= 0.0
   358	    ):
   359	        raise StageCContractError("normalization kappa must be a positive bit scale")
   360	    if (
   361	        not math.isfinite(anchor.lambda_bits_per_j)
   362	        or anchor.lambda_bits_per_j <= 0.0
   363	        or anchor.lambda_bits_per_j != anchor.eta_ref_bits_per_j
   364	    ):
   365	        raise StageCContractError("lambda and eta_ref must be identical")
   366	    if anchor.anchor_index < 0 or anchor.decision_time_ns < 0:
   367	        raise StageCContractError("anchor indices/times must be nonnegative")
   368	    identities = [item.action for item in anchor.actions]
   369	    if len(set(identities)) != len(identities):
   370	        raise StageCContractError("anchor has duplicate physical actions")
