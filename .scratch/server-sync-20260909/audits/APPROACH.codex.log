   281	class ForecastElevationResolverV2:
   282	    """Resolve focal elevation at C2 offsets 1, 2, and 3 via public seams."""
   283	
   284	    def __init__(self, tape: object, provider: object, step_index: int) -> None:
   285	        import numpy as np
   286	        from mcrl.env.geometry import geodetic_to_ecef
   287	
   288	        geometry: list[tuple[dict[int, tuple[float, float, float]], dict[int, Sequence[float]]]] = []
   289	        maximum_error = 0.0
   290	        for offset in (1, 2, 3):
   291	            projected_step = step_index + offset
   292	            layouts = (
   293	                tape.step_user_layouts[projected_step]
   294	                if tape.step_user_layouts
   295	                else tape.user_layout
   296	            )
   297	            ordered = sorted(layouts, key=lambda item: item.user_id)
   298	            user_ids = np.asarray([item.user_id for item in ordered], dtype=np.int64)
   299	            user_ecef = geodetic_to_ecef(
   300	                np.asarray([item.latitude_deg for item in ordered], dtype=np.float64),
   301	                np.asarray([item.longitude_deg for item in ordered], dtype=np.float64),
   302	            )
   303	            user_by_id = {
   304	                int(user_id): tuple(float(value) for value in user_ecef[index])
   305	                for index, user_id in enumerate(user_ids.tolist())
   306	            }
   307	            satellites = dict(provider.satellite_ecef_km(
   308	                world_seed=tape.seed,
   309	                step_index=projected_step,
   310	                boundary_index=0,
   311	            ))
   312	            arrays = tape.steps[projected_step].arrays
   313	            if arrays is not None:
   314	                for (user_id, (norad, _cell_id)), array_row in arrays._row_index().items():
   315	                    expected = float(arrays.elevations_deg[0, array_row])
   316	                    calculated = _elevation_from_ecef(
   317	                        satellite_ecef_km=satellites[norad],
   318	                        user_ecef_km=user_by_id[user_id],
   319	                    )
   320	                    maximum_error = max(maximum_error, abs(calculated - expected))
   321	            geometry.append((user_by_id, satellites))
   322	        if maximum_error > 1.0e-9:
   323	            raise Q2SchemaV2Error("public ECEF elevation disagrees with forecast provider arrays")
   324	        self._geometry = tuple(geometry)
   325	        self.maximum_elevation_crosscheck_error_deg = maximum_error
   326	
   327	    def __call__(self, row: object) -> tuple[float, float, float]:
   328	        if bool(row.null_action):
   329	            return 0.0, 0.0, 0.0
   330	        action = row.action
   331	        if action.norad_id is None or action.beam_chain_id is None:
   332	            raise Q2SchemaV2Error("non-null row has no physical identity")
   333	        user_id = int(row.user_id)
   334	        norad = int(action.norad_id)
   335	        try:
   336	            return tuple(
   337	                _elevation_from_ecef(
   338	                    satellite_ecef_km=satellites[norad],
   339	                    user_ecef_km=users[user_id],
   340	                )
   341	                for users, satellites in self._geometry
   342	            )  # type: ignore[return-value]
   343	        except KeyError as error:
   344	            raise Q2SchemaV2Error("non-null row has no decision-time forecast geometry") from error
   345	
   346	
   347	def _elevation_from_ecef(
   348	    *, satellite_ecef_km: Sequence[float], user_ecef_km: Sequence[float]
   349	) -> float:
   350	    satellite = tuple(float(value) for value in satellite_ecef_km)
   351	    user = tuple(float(value) for value in user_ecef_km)
   352	    if len(satellite) != 3 or len(user) != 3 or not all(
   353	        math.isfinite(value) for vector in (satellite, user) for value in vector
   354	    ):
   355	        raise Q2SchemaV2Error("ECEF geometry must contain finite length-three vectors")
   356	    link = tuple(s - u for s, u in zip(satellite, user, strict=True))
   357	    link_norm = math.sqrt(sum(value * value for value in link))
   358	    user_norm = math.sqrt(sum(value * value for value in user))
   359	    if min(link_norm, user_norm) <= 0.0:
   360	        raise Q2SchemaV2Error("ECEF geometry contains a zero-length direction")

