        actual_rows = [
            row for row in occupancy_rows if row["transmitted_mode"] != "NO_MODE"
        ]
        actual_mode_by_occupancy[str(occupancy)] = (
            None if not actual_rows else stats(actual_rows)
        )
    actual_mode_rows = [
        row for row in observations if row["transmitted_mode"] != "NO_MODE"

