    all_powered = payload["aggregate"]["gap_statistics"]
    overall = payload["aggregate"]["actual_transmitted_mode_gap_statistics"]
    delivered = payload["aggregate"]["delivered_capacity"]
    capped = payload["aggregate"]["demand_capped"]
    lines = [
        (
            f"**Median gap: {overall['median_rung_gap']:.1f} rungs and "
            f"{overall['median_db_gap']:.3f} dB among slots with a declared transmitted mode; "
            f"mode selection alone offers {delivered['extra_bits_per_j']:,.0f} extra delivered bit/J "
            f"({capped['extra_bits_per_j']:,.0f} bit/J demand-capped), at identical transmit power.**"
        ),
        "",
        "# Mode-selection gap diagnostic — 2026-09-10",
        "",
        "`DIAGNOSTIC_NOT_CLAIM` · `FAST_DIAGNOSIS` · pure evaluation of the existing law.",
        "",
    ]
    if float(overall["fraction_zero_rungs"]) >= 0.5:
        lines.extend(
            [
                "**The transmitted mode was usually already the highest mode supported by realised SINR; "
                "the proposed explanation is refuted on this slice.**",
                "",
            ]
        )
    else:
        lines.extend(
            [
                "**When the law selected a transmitted mode, it was usually below the highest mode "
                "supported by realised SINR; the unharvested-headroom explanation is supported on this slice.**",
                "",
            ]
        )
    lines.extend(
        [
            "## Slot-level result",
            "",
            f"The law selected `NO_MODE` in **{pct(all_powered['fraction_no_transmitted_mode'])}** of "
            "powered transmission records. Those records have no transmitted threshold, so their requested "
            "rung and dB gaps are undefined. The main distribution below uses records with an actual "
            "transmitted mode; every `NO_MODE` row remains in the raw ledger and supplemental census.",
            "",
            "Rung gaps are signed: `highest realised-supported rung - transmitted rung`. Rungs are the "
            "sealed modes ordered by increasing spectral efficiency, matching the law's greatest-efficiency selector.",
            "",
            "| occupancy | slots with transmitted mode | mean rung gap | median rung gap | zero rungs | >=3 rungs | mean dB gap | median dB gap |",
            "|---:|---:|---:|---:|---:|---:|---:|---:|",
        ]
