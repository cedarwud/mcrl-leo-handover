            strict=True,
        )
    }
    row_satellite = np.asarray(
        [satellite_of.get(int(identity[0]), 0) for identity in arrays.identities],
        dtype=np.int64,
    )
    user_axis = np.arange(users, dtype=np.int64)
    lower_user = user_axis[None, None, :] < user_axis[None, :, None]
