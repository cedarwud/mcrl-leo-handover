+DECLARED_ALPHA = 0.10
+ALPHA_SWEEP = (0.10, 0.25, 0.50, 0.75, 0.90)
+# Declared before outcome computation.  Zero dB is R2; R3 contains only the
+# positive fixed safety margins below and is not adaptively enlarged.
+BACKOFF_DB_SWEEP = (1.0, 2.0, 3.0, 4.0, 6.0, 8.0)
+FIELD = "realised"
