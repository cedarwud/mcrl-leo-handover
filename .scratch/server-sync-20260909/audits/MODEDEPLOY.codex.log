    table_rows = [("all", overall)] + list(
        payload["aggregate"]["actual_transmitted_mode_gap_statistics_by_occupancy"].items()
    )
    for occupancy, row in table_rows:
        if row is None:
            lines.append("| " + str(occupancy) + " | 0 | n/a | n/a | n/a | n/a | n/a | n/a |")
            continue
        lines.append(
            f"| {occupancy} | {row['slots']} | {row['mean_rung_gap']:.3f} | "
            f"{row['median_rung_gap']:.3f} | {pct(row['fraction_zero_rungs'])} | "
