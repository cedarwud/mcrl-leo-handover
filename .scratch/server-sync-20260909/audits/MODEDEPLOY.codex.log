--- /dev/null
+++ b/diagnose_mode_causal_reachability.py
@@ -0,0 +1,780 @@
+#!/usr/bin/env python3
+"""Measure same-power causal reachability of the V0.25 mode-selection gap.
+
+This is a diagnostic evaluator, not a proposal or selector change.  It runs
+the declared alpha=.10 law once, preserves every resulting RF power, and
+re-credits the immutable radiation records under declared sensitivity and
+causal-feedback rules.  R4 alone may use the current realised SINR.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import subprocess
+import sys
+from typing import Mapping, Sequence
+
+from mcrl.physics_v025.acm import select_mode, select_transmitted_mode
+from mcrl.physics_v025.adapter import _rescore_boundary
+from mcrl.physics_v025.channel import fading_product_quantile
+from mcrl.physics_v025.constants_v025 import (
+    ACM_TABLE_SHA256,
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    CIRCUIT_POWER_PER_CHAIN_W,
+    DECISION_INTERVAL_S,
+    RATE_TARGET_BPS,
+)
+from mcrl.physics_v025.integration import BoundarySample, integrate_47_subintervals
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.tapes import PROBE_WORLD_DOMAINS, build_world_tape
+
+
+ROOT = Path(__file__).resolve().parent
+RUNNER_PATH = (
+    ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+PRIOR_REPORT = ROOT / "MODE-SELECTION-GAP-2026-09-10.md"
+PRIOR_JSON = ROOT / ".scratch/mode-selection-gap/mode-selection-gap.json"
+DEFAULT_JSON = ROOT / ".scratch/mode-causal/results.json"
+DEFAULT_REPORT = ROOT / "MODE-CAUSAL-REACHABILITY-2026-09-10.md"
+
+DECLARED_ALPHA = 0.10
+ALPHA_SWEEP = (0.10, 0.25, 0.50, 0.75, 0.90)
+# Declared before outcome computation.  Zero dB is R2; R3 contains only the
+# positive fixed safety margins below and is not adaptively enlarged.
+BACKOFF_DB_SWEEP = (1.0, 2.0, 3.0, 4.0, 6.0, 8.0)
+FIELD = "realised"
+CARRIER = "nearest-eligible"
+SETTING_LABEL = "a-r0"
+EXPECTED_WORLD = {
+    "domain": "V025_PROBE_R2/world/1",
+    "seed": 3525272352645343090,
+    "tape_digest": "a7d222eab02789c26de423f7cd87d7e2f677c574f64fb181bd98ec799fdec704",
+}
+EXPECTED_POWER_SHA256 = {
+    0: "daf04c86f3c907994173c1dbcc1747f7a7b52a1abb49dd76cfb19462a7c28a7b",
+    1: "65a8166daf1ced75e81708b0f346e7836940b378a1849f04fc5403eef6c758f2",
+    2: "0dd207b5c91c23906ed6679c353677b5d853251ac5b631ac91a437a629482f1b",
+    3: "c50532b210139adad8412f5f19254c04ade796264570e63370586c0ae60066df",
+}
+EXPECTED_PRIOR = {
+    "joules": 27559.293300987632,
+    "r0_bits": 107263069546.77252,
+    "r0_capped_bits": 107263069546.77252,
+    "r4_bits": 378963277911.42865,
+    "r4_capped_bits": 374200269047.09,
+}
+
+
+def load_runner():
+    spec = importlib.util.spec_from_file_location("v025_mode_causal_runner", RUNNER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load V0.25 matrix runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+RUNNER = load_runner()
+SETTING = RUNNER._setting(SETTING_LABEL)
+RUN_SETTING = RUNNER.run_setting_for(SETTING_LABEL)
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def git_value(*args: str) -> str:
+    return subprocess.run(
+        ("git", *args), cwd=ROOT, check=True, text=True, capture_output=True
+    ).stdout.strip()
+
+
+def mode_name(mode) -> str:
+    return "NO_MODE" if mode is None else mode.name
+
+
+def same_mode(left, right) -> bool:
+    return mode_name(left) == mode_name(right)
+
+
+def demand_capped_bits(per_user_bits: Mapping[int, float]) -> float:
+    cap = RATE_TARGET_BPS * DECISION_INTERVAL_S
+    return math.fsum(min(bits, cap) for bits in per_user_bits.values())
+
+
+def rule_specs() -> tuple[dict[str, object], ...]:
+    rows: list[dict[str, object]] = [
+        {
+            "id": "R0",
+            "rung": "R0",
+            "parameter": "alpha=0.10 (declared)",
+            "kind": "declared",
+        }
+    ]
+    rows.extend(
+        {
+            "id": f"R1_alpha_{alpha:.2f}",
+            "rung": "R1",
+            "parameter": f"alpha={alpha:.2f}",
+            "kind": "quantile",
+            "alpha": alpha,
+        }
+        for alpha in ALPHA_SWEEP
+    )
+    rows.append(
+        {
+            "id": "R2",
+            "rung": "R2",
+            "parameter": "stale, 0 dB",
+            "kind": "stale",
+            "backoff_db": 0.0,
+        }
+    )
+    rows.extend(
+        {
+            "id": f"R3_backoff_{backoff:g}dB",
+            "rung": "R3",
+            "parameter": f"stale, -{backoff:g} dB",
+            "kind": "stale",
+            "backoff_db": backoff,
+        }
+        for backoff in BACKOFF_DB_SWEEP
+    )
+    rows.append(
+        {
+            "id": "R4",
+            "rung": "R4",
+            "parameter": "current realised SINR (oracle)",
+            "kind": "oracle",
+        }
+    )
+    return tuple(rows)
+
+
+RULE_SPECS = rule_specs()
+
+
+def elevation_maps(tape, anchor: int, config, shared) -> tuple[dict[tuple[int, tuple[int, int]], float], ...]:
+    geometry_samples = tape.geometry_for(
+        step_index=anchor, assignments=config.mapping
+    )
+    if len(geometry_samples) != len(shared.integrated):
+        raise RuntimeError(f"anchor {anchor}: geometry/boundary length drift")
+    result = []
+    for (time_s, geometry), boundary in zip(
+        geometry_samples, shared.integrated, strict=True
+    ):
+        if time_s != boundary.time_s:
+            raise RuntimeError(f"anchor {anchor}: geometry time drift")
+        mapping = {
+            (int(link.user_id), tuple(int(value) for value in link.beam)): float(
+                link.elevation_deg
+            )
+            for link in geometry.links
+        }
+        if len(mapping) != len(geometry.links):
+            raise RuntimeError(f"anchor {anchor}: duplicate geometry user/beam key")
+        result.append(mapping)
+    return tuple(result)
+
+
+def select_all_modes(shared, elevations):
+    selected: dict[str, list[list[object]]] = {
+        str(spec["id"]): [] for spec in RULE_SPECS
+    }
+    counts: dict[str, dict[str, int]] = {
+        str(spec["id"]): {
+            "records": 0,
+            "no_mode": 0,
+            "decode_failure": 0,
+            "decode_success": 0,
+            "fallback": 0,
+            "first_boundary_fallback": 0,
+            "missing_predecessor_fallback": 0,
+        }
+        for spec in RULE_SPECS
+    }
+    previous: dict[tuple[int, tuple[int, int]], float] = {}
+    for boundary_index, boundary in enumerate(shared.integrated):
+        current: dict[tuple[int, tuple[int, int]], float] = {}
+        boundary_modes: dict[str, list[object]] = {
+            str(spec["id"]): [] for spec in RULE_SPECS
+        }
+        seen: set[tuple[int, tuple[int, int]]] = set()
+        for slot in boundary.radiation.slots:
+            for tx in slot.transmissions:
+                key = (int(tx.user_id), tuple(int(value) for value in tx.beam))
+                if key in seen:
+                    raise RuntimeError(
+                        "same user/beam appears more than once in a boundary"
+                    )
+                seen.add(key)
+                if key not in elevations[boundary_index]:
+                    raise RuntimeError("transmission lacks a matching elevation")
+                elevation = elevations[boundary_index][key]
+                current[key] = float(tx.sinr)
+                for spec in RULE_SPECS:
+                    rule_id = str(spec["id"])
+                    kind = str(spec["kind"])
+                    fallback = False
+                    first_fallback = False
+                    missing_fallback = False
+                    if kind == "declared":
+                        mode = tx.m_tx
+                    elif kind == "quantile":
+                        if tx.nominal_sinr is None:
+                            raise RuntimeError("nominal SINR absent from transmission")
+                        quantile = fading_product_quantile(
+                            elevation, float(spec["alpha"])
+                        )
+                        mode = select_transmitted_mode(float(tx.nominal_sinr), quantile)
+                    elif kind == "stale":
+                        if key not in previous:
+                            mode = tx.m_tx
+                            fallback = True
+                            first_fallback = boundary_index == 0
+                            missing_fallback = boundary_index != 0
+                        else:
+                            backed_off = previous[key] / (
+                                10.0 ** (float(spec["backoff_db"]) / 10.0)
+                            )
+                            mode = select_mode(backed_off)
+                    elif kind == "oracle":
+                        mode = select_mode(tx.sinr)
+                    else:
+                        raise RuntimeError(f"unknown rule kind {kind}")
+                    if rule_id == "R1_alpha_0.10" and not same_mode(mode, tx.m_tx):
+                        raise RuntimeError("R1 alpha=.10 failed to reconstruct R0 mode")
+                    boundary_modes[rule_id].append(mode)
+                    counter = counts[rule_id]
+                    counter["records"] += 1
+                    counter["fallback"] += int(fallback)
+                    counter["first_boundary_fallback"] += int(first_fallback)
+                    counter["missing_predecessor_fallback"] += int(missing_fallback)
+                    if mode is None:
+                        counter["no_mode"] += 1
+                    elif tx.sinr < mode.threshold_linear:
+                        counter["decode_failure"] += 1
+                    else:
+                        counter["decode_success"] += 1
+        for spec in RULE_SPECS:
+            selected[str(spec["id"])].append(boundary_modes[str(spec["id"])])
+        previous = current
+    return selected, counts
+
+
+def score_selected_modes(shared, events, modes_by_boundary):
+    points = []
+    for boundary_index, boundary in enumerate(shared.integrated):
+        original = _rescore_boundary(
+            boundary,
+            shared.inventory,
+            SETTING,
+            shared.users,
+            shared.circuit_power_per_active_chain_w,
+        )
+        rates = {user: 0.0 for user in original.rate_bps}
+        decoded = {user: True for user in original.rate_bps}
+        seen = {user: False for user in original.rate_bps}
+        mode_index = 0
+        modes = modes_by_boundary[boundary_index]
+        for slot in boundary.radiation.slots:
+            for tx in slot.transmissions:
+                if mode_index >= len(modes):
+                    raise RuntimeError("selected-mode ledger is too short")
+                mode = modes[mode_index]
+                mode_index += 1
+                user = int(tx.user_id)
+                seen[user] = True
+                passed = mode is not None and tx.sinr >= mode.threshold_linear
+                decoded[user] &= passed
+                if passed:
+                    rates[user] += (
+                        slot.fraction
+                        * tx.bandwidth_hz
+                        * mode.spectral_efficiency_bit_per_s_hz
+                    )
+        if mode_index != len(modes):
+            raise RuntimeError("selected-mode ledger is too long")
+        decoded = {user: decoded[user] and seen[user] for user in decoded}
+        points.append(BoundarySample(boundary.time_s, rates, original.power_w, decoded))
+    return integrate_47_subintervals(
+        points,
+        interruptions=events,
+        interruption_enabled=SETTING.interruption == "on",
+    )
+
+
+def power_vector(shared, anchor: int) -> tuple[str, int]:
+    payload = []
+    observations = 0
+    for boundary_index, boundary in enumerate(shared.integrated):
+        for slot_index, slot in enumerate(boundary.radiation.slots):
+            for tx in slot.transmissions:
+                observations += 1
+                payload.append(
+                    (
+                        anchor,
+                        boundary_index,
+                        slot_index,
+                        int(tx.user_id),
+                        tx.rf_power_w.hex(),
+                    )
+                )
+    digest = hashlib.sha256(
+        json.dumps(payload, separators=(",", ":")).encode("ascii")
+    ).hexdigest()
+    return digest, observations
+
+
+def evaluate_anchor(tape, anchor: int, incumbent, previously_served: set[int]):
+    config = RUNNER._base_configuration(tape, anchor, CARRIER)
+    rekeyed = RUNNER._rekeyed_users(tape, anchor)
+    evaluator = RUNNER.StepEvaluator(
+        tape,
+        SETTING,
+        anchor,
+        transition_from=incumbent,
+        cell_rekeyed_users=rekeyed,
+        previously_served_users=tuple(sorted(previously_served)),
+        field=FIELD,
+        run_setting=RUN_SETTING,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=DECLARED_ALPHA,
+    )
+    profile = evaluator.evaluate(config)
+    shared = evaluator._shared[config.configuration_id]
+    if len(shared.integrated) != 48:
+        raise RuntimeError(f"anchor {anchor}: expected 48 boundaries")
+    events = RUNNER._interruption_events(
+        incumbent,
+        config,
+        shared.integrated[0].time_s,
+        cell_rekeyed_users=rekeyed,
+        previously_served_users=tuple(sorted(previously_served)),
+    )
+    elevations = elevation_maps(tape, anchor, config, shared)
+    selected, counts = select_all_modes(shared, elevations)
+    receipts = {
+        str(spec["id"]): score_selected_modes(
+            shared, events, selected[str(spec["id"])]
+        )
+        for spec in RULE_SPECS
+    }
+    baseline = receipts["R0"]
+    if baseline.joules != profile.joules:
+        raise RuntimeError(f"anchor {anchor}: baseline energy is not exactly preserved")
+    for rule_id, receipt in receipts.items():
+        if receipt.joules != baseline.joules:
+            raise RuntimeError(
+                f"anchor {anchor}: energy changed while re-crediting {rule_id}"
+            )
+    for user in profile.score.bits:
+        if not math.isclose(
+            baseline.bits[user], profile.score.bits[user], rel_tol=1e-12, abs_tol=2e-6
+        ):
+            raise RuntimeError(f"anchor {anchor}: R0 bit reconstruction drift")
+    power_sha, observations = power_vector(shared, anchor)
+    if power_sha != EXPECTED_POWER_SHA256[anchor]:
+        raise RuntimeError(f"anchor {anchor}: prior power-vector hash changed")
+    rules = {}
+    for spec in RULE_SPECS:
+        rule_id = str(spec["id"])
+        receipt = receipts[rule_id]
+        rule_counts = counts[rule_id]
+        attempted = rule_counts["records"] - rule_counts["no_mode"]
+        rules[rule_id] = {
+            "bits": math.fsum(receipt.bits.values()),
+            "demand_capped_bits": demand_capped_bits(receipt.bits),
+            "joules": receipt.joules,
+            **rule_counts,
+            "decode_failure_fraction_all_powered_records": (
+                rule_counts["decode_failure"] / rule_counts["records"]
+            ),
+            "decode_failure_fraction_selected_modes": (
+                rule_counts["decode_failure"] / attempted if attempted else None
+            ),
+            "no_mode_fraction": rule_counts["no_mode"] / rule_counts["records"],
+        }
+    newly_served = {
+        user for user, seconds in profile.score.decoding_time_s.items() if seconds > 0.0
+    }
+    return (
+        {
+            "anchor": anchor,
+            "configuration_id": config.configuration_id,
+            "assignment_sha256": RUNNER.digest_payload(config.assignments),
+            "boundaries": len(shared.integrated),
+            "transmission_observations": observations,
+            "joules": baseline.joules,
+            "joules_hex": baseline.joules.hex(),
+            "power_vector_sha256": power_sha,
+            "rules": rules,
+        },
+        config,
+        newly_served,
+    )
+
+
+def aggregate(anchor_rows: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    baseline_joules = math.fsum(float(row["joules"]) for row in anchor_rows)
+    for spec in RULE_SPECS:
+        rule_id = str(spec["id"])
+        rows = [row["rules"][rule_id] for row in anchor_rows]
+        joules = math.fsum(float(row["joules"]) for row in rows)
+        if joules != baseline_joules:
+            raise RuntimeError(f"pooled energy changed for {rule_id}")
+        bits = math.fsum(float(row["bits"]) for row in rows)
+        capped = math.fsum(float(row["demand_capped_bits"]) for row in rows)
+        counts = {
+            key: sum(int(row[key]) for row in rows)
+            for key in (
+                "records",
+                "no_mode",
+                "decode_failure",
+                "decode_success",
+                "fallback",
+                "first_boundary_fallback",
+                "missing_predecessor_fallback",
+            )
+        }
+        attempted = counts["records"] - counts["no_mode"]
+        result[rule_id] = {
+            **spec,
+            "bits": bits,
+            "demand_capped_bits": capped,
+            "joules": joules,
+            "joules_hex": joules.hex(),
+            "capacity_ee_bits_per_j": bits / joules,
+            "demand_capped_ee_bits_per_j": capped / joules,
+            **counts,
+            "decode_failure_fraction_all_powered_records": (
+                counts["decode_failure"] / counts["records"]
+            ),
+            "decode_failure_fraction_selected_modes": (
+                counts["decode_failure"] / attempted if attempted else None
+            ),
+            "no_mode_fraction": counts["no_mode"] / counts["records"],
+        }
+    r0 = result["R0"]
+    r4 = result["R4"]
+    for row in result.values():
+        row["capacity_relative_gain_over_r0"] = (
+            row["capacity_ee_bits_per_j"] / r0["capacity_ee_bits_per_j"] - 1.0
+        )
+        row["demand_capped_relative_gain_over_r0"] = (
+            row["demand_capped_ee_bits_per_j"]
+            / r0["demand_capped_ee_bits_per_j"]
+            - 1.0
+        )
+        row["capacity_oracle_gap_recovered"] = (
+            (row["capacity_ee_bits_per_j"] - r0["capacity_ee_bits_per_j"])
+            / (r4["capacity_ee_bits_per_j"] - r0["capacity_ee_bits_per_j"])
+        )
+        row["demand_capped_oracle_gap_recovered"] = (
+            (
+                row["demand_capped_ee_bits_per_j"]
+                - r0["demand_capped_ee_bits_per_j"]
+            )
+            /
+            (
+                r4["demand_capped_ee_bits_per_j"]
+                - r0["demand_capped_ee_bits_per_j"]
+            )
+        )
+    return result
+
+
+def close(actual: float, expected: float, *, absolute: float = 2e-5) -> bool:
+    return math.isclose(actual, expected, rel_tol=1e-13, abs_tol=absolute)
+
+
+def validate(payload: Mapping[str, object]) -> None:
+    aggregate_rows = payload["aggregate"]
+    r0 = aggregate_rows["R0"]
+    r1_declared = aggregate_rows["R1_alpha_0.10"]
+    r4 = aggregate_rows["R4"]
+    checks = (
+        (r0["joules"], EXPECTED_PRIOR["joules"], 1e-10, "pooled joules"),
+        (r0["bits"], EXPECTED_PRIOR["r0_bits"], 2e-5, "R0 bits"),
+        (
+            r0["demand_capped_bits"],
+            EXPECTED_PRIOR["r0_capped_bits"],
+            2e-5,
+            "R0 capped bits",
+        ),
+        (r4["bits"], EXPECTED_PRIOR["r4_bits"], 2e-5, "R4 bits"),
+        (
+            r4["demand_capped_bits"],
+            EXPECTED_PRIOR["r4_capped_bits"],
+            2e-5,
+            "R4 capped bits",
+        ),
+    )
+    for actual, expected, tolerance, label in checks:
+        if not close(float(actual), float(expected), absolute=tolerance):
+            raise RuntimeError(f"prior comparison failed for {label}")
+    for key in ("bits", "demand_capped_bits", "joules"):
+        if r1_declared[key] != r0[key]:
+            raise RuntimeError(f"R1 alpha=.10 is not bit-identical to R0 for {key}")
+    if r4["decode_failure"] != 0:
+        raise RuntimeError("oracle selected an unsupported mode")
+    if payload["coverage"]["transmission_observations"] != 126720:
+        raise RuntimeError("transmission coverage changed from the prior report")
+
+
+def pct(value: float) -> str:
+    return f"{100.0 * value:.2f}%"
+
+
+def render(payload: Mapping[str, object], json_path: Path) -> str:
+    rows = payload["aggregate"]
+    r0 = rows["R0"]
+    r2 = rows["R2"]
+    r4 = rows["R4"]
+    r3_rows = [row for row in rows.values() if row["rung"] == "R3"]
+    best_feedback = max(
+        [r2, *r3_rows], key=lambda row: row["demand_capped_ee_bits_per_j"]
+    )
+    best_all_causal = max(
+        [row for row in rows.values() if row["rung"] != "R4"],
+        key=lambda row: row["demand_capped_ee_bits_per_j"],
+    )
+    gain = (
+        best_feedback["demand_capped_ee_bits_per_j"]
+        - r0["demand_capped_ee_bits_per_j"]
+    )
+    first = (
+        f"**Best tested causal feedback rule ({best_feedback['parameter']}) gains "
+        f"{gain/1e6:.3f} Mbit/J demand-capped over R0 "
+        f"({pct(best_feedback['demand_capped_relative_gain_over_r0'])}) and recovers "
+        f"{pct(best_feedback['demand_capped_oracle_gap_recovered'])} of the R4-R0 oracle gap.**"
+    )
+    lines = [
+        first,
+        "",
+        "# Mode causal reachability diagnostic — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM` · same-power mode re-crediting only.",
+        "",
+        "This measures magnitudes on the prior report's one-world, four-anchor slice. It does not change or challenge the sealed tenth-percentile scoring convention. R1 is a sensitivity curve only, and R4 is a non-causal ceiling.",
+        "",
+        "## Verified by running code",
+        "",
+        f"All rows reuse exactly **{r0['joules']:.12f} J**. The pooled denominator has the same binary64 value (`{r0['joules_hex']}`) for every rule, and every re-crediting path asserts exact equality before output.",
+        "",
+        "Decode failure below means a non-`NO_MODE` selection whose threshold exceeds current realised SINR, divided by all powered transmission records. Together, decode success, decode failure, and `NO_MODE` partition the records. The JSON also reports failure conditional on selecting a mode.",
+        "",
+        "| rung | parameter | capacity EE (Mbit/J) | gain vs R0 | demand-capped EE (Mbit/J) | gain vs R0 | decode failure | `NO_MODE` | R4-R0 demand gap recovered |",
+        "|---|---|---:|---:|---:|---:|---:|---:|---:|",
+    ]
+    for row in rows.values():
+        lines.append(
+            f"| {row['rung']} | {row['parameter']} | "
+            f"{row['capacity_ee_bits_per_j']/1e6:.6f} | "
+            f"{pct(row['capacity_relative_gain_over_r0'])} | "
+            f"{row['demand_capped_ee_bits_per_j']/1e6:.6f} | "
+            f"{pct(row['demand_capped_relative_gain_over_r0'])} | "
+            f"{pct(row['decode_failure_fraction_all_powered_records'])} | "
+            f"{pct(row['no_mode_fraction'])} | "
+            f"{pct(row['demand_capped_oracle_gap_recovered'])} |"
+        )
+    lines.extend(
+        [
+            "",
+            "R1 at alpha=0.10 is deliberately shown twice: its exact equality with R0 validates that the sweep reconstructs the implemented declared selector. The other R1 rows are sensitivity measurements on the sealed convention, not candidate replacements.",
+            "",
+            f"R2 recovers **{pct(r2['capacity_oracle_gap_recovered'])}** of the capacity gap and **{pct(r2['demand_capped_oracle_gap_recovered'])}** of the demand-capped gap. The best R3 point ({best_feedback['parameter']}) recovers **{pct(best_feedback['capacity_oracle_gap_recovered'])}** and **{pct(best_feedback['demand_capped_oracle_gap_recovered'])}**, respectively.",
+            "",
+            f"Across every evaluated causal row including the R1 sensitivity, the largest demand-capped value is `{best_all_causal['rung']} {best_all_causal['parameter']}` at **{best_all_causal['demand_capped_ee_bits_per_j']/1e6:.6f} Mbit/J**. This is descriptive selection after the sweep, not a newly chosen operating rule.",
+            "",
+            "### R2/R3 boundary handling",
+            "",
+            f"The stale key is exactly `(user, beam)` at boundary `b-1`. History resets at each anchor. At each anchor's first boundary, all {r2['first_boundary_fallback']} pooled records without feedback use that same record's R0 mode. There were {r2['missing_predecessor_fallback']} additional non-first-boundary fallbacks because the same key was absent at the immediately preceding boundary. No older observation is carried forward. The same fallback is used for every R3 margin; back-off applies only when an immediate predecessor exists.",
+            "",
+            "## Reverified comparison identity",
+            "",
+            f"The regenerated tape is `{payload['world']['domain']}` with seed `{payload['world']['seed']}` and digest `{payload['world']['tape_digest']}`. Coverage is anchors `{payload['coverage']['anchors']}`, 48 boundaries per anchor, and {payload['coverage']['transmission_observations']} powered records—identical to the [prior mode-gap report](/home/sat/mcrl-v025-prevalence-ws/MODE-SELECTION-GAP-2026-09-10.md).",
+            "",
+            "The prior report's per-anchor power-vector SHA-256 values were recomputed from `(anchor, boundary, slot, user, rf_power_w.hex())` and matched exactly:",
+            "",
+        ]
+    )
+    for row in payload["anchors"]:
+        lines.append(
+            f"- anchor {row['anchor']}: `{row['power_vector_sha256']}`; "
+            f"{row['transmission_observations']} records; {row['joules']:.12f} J"
+        )
+    lines.extend(
+        [
+            "",
+            f"R0 and R4 also reproduce the prior pooled bit totals: R0 `{r0['bits']:.6f}` bits and R4 `{r4['bits']:.6f}` bits for delivered capacity; R0 `{r0['demand_capped_bits']:.6f}` and R4 `{r4['demand_capped_bits']:.6f}` demand-capped bits.",
+            "",
+            "## Derived on paper",
+            "",
+            "For each row, `EE = pooled delivered bits / unchanged pooled joules`; relative gain is `EE_rule / EE_R0 - 1`; and recovered gap is `(EE_rule - EE_R0) / (EE_R4 - EE_R0)`. Demand capping is applied separately per user and anchor as `min(integrated bits, 50 Mbit/s × 30.08 s)` before pooling. These arithmetic transforms are serialized alongside their run-verified inputs.",
+            "",
+            "## Inferred",
+            "",
+            "The stale-feedback rows quantify what this specific one-boundary CQI delay can causally reach on this tape. They do not establish performance on other worlds, delays, estimators, or feedback-error models. The best sweep point is an observed sensitivity maximum, not a pre-registered deployment choice or an efficacy claim.",
+            "",
+            "## Sealed-convention boundary",
+            "",
+            "The [v1.7 erratum §1](/home/sat/mcrl-records/decisions/V025-PHYSICS-SUCCESSOR-PRIORITY-DECLARATION-v1.7-ERRATUM-2026-09-09.md:5) names alpha=0.10 as the pre-specified channel-gain scoring rule. The [v1.9 amendment §1](/home/sat/mcrl-records/decisions/V025-PHYSICS-SUCCESSOR-PRIORITY-DECLARATION-v1.9-AMENDMENT-2026-09-09.md:5) requires nominal transmit powers to remain unchanged and forbids re-solving the margin into power. This diagnostic obeys both: it performs one alpha=0.10 declared radiation evaluation per anchor, never invokes a second power solve, and varies credited mode only.",
+            "",
+            "## Reproduction and provenance",
+            "",
+            "From the workspace root:",
+            "",
+            "```bash",
+            "env OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 BLIS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python diagnose_mode_causal_reachability.py --world 1 --anchors 0 1 2 3",
+            "sha256sum diagnose_mode_causal_reachability.py MODE-CAUSAL-REACHABILITY-2026-09-10.md .scratch/mode-causal/results.json",
+            "```",
+            "",
+            f"- source commit: `{payload['provenance']['source_commit']}`; tracked tree: `{payload['provenance']['tracked_tree']}`",
+            f"- evaluator script SHA-256 before report rendering: `{payload['provenance']['script_sha256']}`",
+            f"- imported matrix runner SHA-256: `{payload['provenance']['runner_sha256']}`",
+            f"- sealed ACM table SHA-256: `{payload['provenance']['acm_table_sha256']}`",
+            f"- prior report SHA-256: `{payload['provenance']['prior_report_sha256']}`",
+            f"- prior raw ledger SHA-256: `{payload['provenance']['prior_json_sha256']}`",
+            f"- machine-readable result: `{json_path.relative_to(ROOT)}`",
+            "",
+            "No sealed constant, threshold, sign, seed, horizon, price, guard, acceptance rule, control law, manifest, or optimizer setting was changed.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--world", type=int, default=1)
+    parser.add_argument("--anchors", type=int, nargs="+", default=[0, 1, 2, 3])
+    parser.add_argument("--json", type=Path, default=DEFAULT_JSON)
+    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    if args.world != 1 or sorted(set(args.anchors)) != [0, 1, 2, 3]:
+        raise SystemExit("this comparison is fixed to prior world 1 and anchors 0 1 2 3")
+    if not PRIOR_REPORT.is_file() or not PRIOR_JSON.is_file():
+        raise SystemExit("prior report and raw ledger are required for comparison provenance")
+    domain = PROBE_WORLD_DOMAINS[args.world - 1]
+    tape = build_world_tape(
+        domain=domain,
+        provider=LegacyWorldProvider(user_count=100),
