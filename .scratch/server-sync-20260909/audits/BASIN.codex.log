@@ -0,0 +1,14 @@
+# BASIN barrier diagnostic completion criterion
+
+One unattended, one-process run under the mandated interpreter, niceness, and
+single-thread controls must:
+
+- reproduce the sealed 12-anchor `NEAREST_ELIGIBLE` and
+  `FIRST_IMPROVEMENT_FP` pooled EE values to six decimals before computing new
+  findings;
+- emit every requested BASE-to-RSS_MAX path, exact rational `F` values,
+  unilateral checks, restart endpoints, six-arm rankings, bounded-catalogue
+  diagnostics, and reference-profile interaction signs;
+- print `anchor k/N` progress and peak RSS, with peak RSS below 5 GB; and
+- read development anchors only and no learner checkpoint.
+

codex
Still inside the prior measured construction envelope. Once it clears, parity and then each anchor’s new results will be checkpointed locally, so later failures will not blur which findings were actually completed.
diff --git a/.scratch/basin/run_basin.py b/.scratch/basin/run_basin.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b64ef2ae5ec518c6235f933d932ce2e50573a32
--- /dev/null
+++ b/.scratch/basin/run_basin.py
@@ -0,0 +1,850 @@
+#!/usr/bin/env python3
+"""Learner-free BASIN barrier diagnostic on PANELCEIL's 12 development anchors."""
+
+from __future__ import annotations
+
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-basin-ws")
+RANK_WORKSPACE = Path("/home/sat/mcrl-v025-rank-ws")
+PANELCEIL_WORKSPACE = Path("/home/sat/mcrl-v025-ceiling30-ws")
+PANELCEIL_RUNNER = PANELCEIL_WORKSPACE / ".scratch/panelceil/run_panelceil.py"
+PANELCEIL_RECEIPT = PANELCEIL_WORKSPACE / ".scratch/panelceil/panelceil-receipt.json"
+STATICS_RUNNER = RANK_WORKSPACE / ".scratch/statics/run_statics.py"
+STATICS_RECEIPT = RANK_WORKSPACE / ".scratch/statics/statics-receipt.json"
+OUTPUT = WORKSPACE / ".scratch/basin/basin-receipt.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+ARM_NAMES = (
+    "RANDOM", "ROUND_ROBIN", "RSS_MAX", "NEAREST_ELIGIBLE",
+    "MYOPIC_GREEDY", "FIRST_IMPROVEMENT_FP",
+)
+EXPECTED_PARITY = {
+    "NEAREST_ELIGIBLE": 11.027760,
+    "FIRST_IMPROVEMENT_FP": 13.430253,
+}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: dict) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def atomic_write(payload: dict) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
+    temporary.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(OUTPUT)
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def assert_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS is not below 5 GB")
+
+
+def assert_rss() -> int:
+    value = peak_rss_bytes()
+    if value >= MAX_RSS_BYTES:
+        raise MemoryError(f"peak RSS {value} is not below 5 GB")
+    return value
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def fraction_payload(value: Fraction) -> dict[str, object]:
+    return {
+        "numerator": value.numerator,
+        "denominator": value.denominator,
+        "float_bits": float(value),
+    }
+
+
+def sign(value: Fraction) -> str:
+    return "positive" if value > 0 else "negative" if value < 0 else "zero"
+
+
+def mapping_from_assignments(rows) -> dict[int, tuple[int, int] | None]:
+    return {
+        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
+        for user, identity in rows
+    }
+
+
+def reconstruct(runner, base, arm_row, kind: str):
+    mapping = mapping_from_assignments(arm_row["assignments"])
+    if mapping == base.mapping:
+        result = base
+    else:
+        result = runner._configuration(base, mapping, kind=kind)
+    if result.configuration_id != arm_row["configuration_id"]:
+        raise RuntimeError(f"configuration reconstruction mismatch for {kind}")
+    return result
+
+
+def evaluate_batches(evaluator, rows, batch_size: int) -> None:
+    for offset in range(0, len(rows), batch_size):
+        evaluator.evaluate_many(tuple(rows[offset:offset + batch_size]))
+
+
+def committed_profile(panelceil, runner, tape, step_index, incumbent, run_setting, config):
+    evaluator = runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field="realised", counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=tuple(range(48)),
+    )
+    evaluator.evaluate_many((config,))
+    profile = evaluator._evaluated.get(config.configuration_id)
+    if profile is None:
+        raise RuntimeError("committed configuration is invalid")
+    return panelceil.metric(profile)
+
+
+def pool_metrics(rows, key: str) -> dict[str, object]:
+    metrics = [row[key] for row in rows]
+    bits = math.fsum(float(row["bits"]) for row in metrics)
+    joules = math.fsum(float(row["joules"]) for row in metrics)
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bit_per_j": bits / joules,
+        "served_count": sum(int(row["served_count"]) for row in metrics),
+        "rate_target_attained_count": sum(
+            int(row["rate_target_attained_count"]) for row in metrics
+        ),
+        "user_count": sum(int(row["user_count"]) for row in metrics),
+    }
+
+
+def first_improvement_from(
+    panelceil, runner, calibration, tape, step_index, base, start, incumbent, run_setting,
+):
+    evaluator = panelceil.new_selection_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field="realised"
+    )
+    base_profile = evaluator.evaluate(base)
+    guard = panelceil.served(base_profile)
+    options, census = runner._legal_options(tape, step_index)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    current = start
+    accepted_moves = comparisons = submissions = passes_with_moves = 0
+    while True:
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = evaluator.evaluate(current)
+            current_value = panelceil.objective(
+                runner, calibration, incumbent, current, current_profile, rekeys
+            )
+            identities = [identity for identity in options[user] if identity != current.mapping[user]]
+            accepted = None
+            for offset in range(0, len(identities), panelceil.UNILATERAL_BATCH_SIZE):
+                batch = tuple(
+                    panelceil.candidate(
+                        runner, base, current, user, identity,
+                        "basin-first-improvement-restart",
+                    )
+                    for identity in identities[offset:offset + panelceil.UNILATERAL_BATCH_SIZE]
+                )
+                evaluator.evaluate_many(batch)
+                submissions += len(batch)
+                for row in batch:
+                    comparisons += 1
+                    profile = evaluator._evaluated.get(row.configuration_id)
+                    if profile is None or panelceil.served(profile) < guard:
+                        continue
+                    value = panelceil.objective(
+                        runner, calibration, incumbent, row, profile, rekeys
+                    )
+                    if value > current_value:
+                        accepted = row
+                        break
+                if accepted is not None:
+                    current = accepted
+                    accepted_moves += 1
+                    moves_this_pass += 1
+                    break
+        if moves_this_pass == 0:
+            break
+        passes_with_moves += 1
+    # Explicit terminal certificate on a fresh cache, matching the same move class.
+    certificate = panelceil.new_selection_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field="realised"
+    )
+    current_profile = certificate.evaluate(current)
+    current_value = panelceil.objective(
+        runner, calibration, incumbent, current, current_profile, rekeys
+    )
+    improving = 0
+    guarded = 0
+    invalid = 0
+    all_rows = []
+    for user in sorted(options):
+        user_rows = []
+        for identity in options[user]:
+            if identity != current.mapping[user]:
+                user_rows.append(panelceil.candidate(
+                    runner, base, current, user, identity, "basin-terminal-certificate"
+                ))
+        # Preserve PANELCEIL's per-user microbatch boundaries.  The dense
+        # backend is numerically stable within that declared estimator, but a
+        # differently packed cross-user batch can move a boundary equality by
+        # an ULP and is not the same certificate.
+        evaluate_batches(certificate, user_rows, panelceil.UNILATERAL_BATCH_SIZE)
+        all_rows.extend(user_rows)
+    for row in all_rows:
+        profile = certificate._evaluated.get(row.configuration_id)
+        if profile is None:
+            invalid += 1
+            continue
+        if panelceil.served(profile) < guard:
+            continue
+        guarded += 1
+        if panelceil.objective(
+            runner, calibration, incumbent, row, profile, rekeys
+        ) > current_value:
+            improving += 1
+    if improving:
+        raise RuntimeError("restart terminal certificate found a strict guarded improvement")
+    return current, {
+        "algorithm": "deterministic cyclic first-improvement",
+        "start_configuration_id": start.configuration_id,
+        "guard": guard,
+        "candidate_order": "ascending user ID; declared legal-option order",
+        "microbatch_size": panelceil.UNILATERAL_BATCH_SIZE,
+        "accepted_moves": accepted_moves,
+        "passes_with_moves": passes_with_moves,
+        "total_passes_including_certificate": passes_with_moves + 1,
+        "comparisons_before_separate_certificate": comparisons,
+        "submissions_before_separate_certificate": submissions,
+        "terminal_certificate": {
+            "complete": True,
+            "alternatives": len(all_rows),
+            "physically_invalid": invalid,
+            "guarded": guarded,
+            "strictly_improving": improving,
+        },
+        "legal_option_census": census,
+    }
+
+
+def hamming_counts(catalogue, center) -> Counter:
+    return Counter(
+        sum(config.mapping[user] != center.mapping[user] for user in center.mapping)
+        for config in catalogue
+    )
+
+
+def exact_interactions(
+    runner, panelceil, calibration, incumbent, center, catalogue, evaluator,
+):
+    """Pure-F and Stage-C F+kappa*Phi set residual beyond singleton effects."""
+
+    rekeys = runner._rekeyed_users(evaluator.tape, evaluator.step_index)
+    evaluate_batches(evaluator, list(catalogue), panelceil.JOINT_BATCH_SIZE)
+    center_profile = evaluator.evaluate(center)
+    center_f = panelceil.objective(
+        runner, calibration, incumbent, center, center_profile, rekeys
+    )
+
+    singleton_by_assignments = {}
+    changed_by_config = {}
+    for config in catalogue:
+        changed = tuple(
+            user for user in sorted(center.mapping)
+            if config.mapping[user] != center.mapping[user]
+        )
+        changed_by_config[config.configuration_id] = changed
+        if len(changed) < 2:
+            continue
+        for user in changed:
+            mapping = center.mapping
+            mapping[user] = config.mapping[user]
+            singleton = runner._configuration(center, mapping, kind="basin-exact-singleton")
+            singleton_by_assignments[singleton.assignments] = singleton
+    evaluate_batches(
+        evaluator, list(singleton_by_assignments.values()), panelceil.JOINT_BATCH_SIZE
+    )
+
+    def f_of(config):
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is None:
+            return None
+        return panelceil.objective(
+            runner, calibration, incumbent, config, profile, rekeys
+        )
+
+    center_phi = calibration.kappa_bits_per_user_step * runner._phi_for(incumbent, center)
+    values = {}
+    for config in catalogue:
+        changed = changed_by_config[config.configuration_id]
+        if len(changed) < 2:
+            continue
+        joint_f = f_of(config)
+        if joint_f is None:
+            continue
+        singleton_delta = Fraction()
+        singleton_phi_delta = Fraction()
+        valid = True
+        for user in changed:
+            mapping = center.mapping
+            mapping[user] = config.mapping[user]
+            singleton = singleton_by_assignments[tuple(sorted(mapping.items()))]
+            singleton_f = f_of(singleton)
+            if singleton_f is None:
+                valid = False
+                break
+            singleton_delta += singleton_f - center_f
+            singleton_phi_delta += (
+                calibration.kappa_bits_per_user_step * runner._phi_for(incumbent, singleton)
+                - center_phi
+            )
+        if not valid:
+            continue
+        joint_delta = joint_f - center_f
+        joint_phi_delta = (
+            calibration.kappa_bits_per_user_step * runner._phi_for(incumbent, config)
+            - center_phi
+        )
+        psi_f = joint_delta - singleton_delta
+        psi_stagec = (joint_delta + joint_phi_delta) - (
+            singleton_delta + singleton_phi_delta
+        )
+        values[config.configuration_id] = {
+            "changed_users": list(changed),
+            "coalition_size": len(changed),
+            "joint_delta_f": fraction_payload(joint_delta),
+            "additive_singleton_delta_f": fraction_payload(singleton_delta),
+            "psi_f": fraction_payload(psi_f),
+            "psi_f_sign": sign(psi_f),
+            "psi_stagec_f_plus_kappa_phi": fraction_payload(psi_stagec),
+            "psi_stagec_sign": sign(psi_stagec),
+        }
+    return values
+
+
+def main() -> int:
+    assert_runtime()
+    started = time.perf_counter()
+    panelceil = load_module("basin_panelceil_reference", PANELCEIL_RUNNER)
+    statics = load_module("basin_statics_reference", STATICS_RUNNER)
+    panel = panelceil.frozen_panel()
+    if len(panel) != 12 or [row["global_anchor_index"] for row in panel] != list(range(12)):
+        raise RuntimeError("development panel is not the frozen 12-anchor prefix")
+    statics_receipt = json.loads(STATICS_RECEIPT.read_text(encoding="utf-8"))
+    panelceil_receipt = json.loads(PANELCEIL_RECEIPT.read_text(encoding="utf-8"))
+    if (
+        statics_receipt.get("status") != "COMPLETE"
+        or statics_receipt.get("receipt_sha256") != statics.canonical_digest(statics_receipt)
+        or panelceil_receipt.get("status") != "COMPLETE"
+        or panelceil_receipt.get("receipt_sha256") != panelceil.canonical_digest(panelceil_receipt)
+    ):
+        raise RuntimeError("source receipts are not sealed and complete")
+
+    pilot = panelceil.load_pilot()
+    runner = pilot.ENGINE
+    calibration = panelceil.load_calibration(pilot)
+    run_setting = runner.run_setting_for("a-r0")
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    tape_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33, start_time_s=0.0,
+    )
+    tape_seconds = time.perf_counter() - tape_started
+    print(f"peak RSS {assert_rss()/2**30:.3f} GiB after tape", flush=True)
+
+    # Mandatory stop gate: independently replay both parity arms before any new result.
+    parity_rows = []
+    for position, panel_row in enumerate(panel, 1):
+        index = int(panel_row["global_anchor_index"])
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        source_anchor = statics_receipt["anchors"][index]
+        fp = reconstruct(
+            runner, base, source_anchor["arms"]["FIRST_IMPROVEMENT_FP"],
+            "basin-parity-first-improvement",
+        )
+        committed = panelceil.committed_metrics(
+            runner, tape, step_index, incumbent, run_setting,
+            {"NEAREST_ELIGIBLE": base, "FIRST_IMPROVEMENT_FP": fp},
+        )
+        for arm in EXPECTED_PARITY:
+            source = source_anchor["arms"][arm]["committed"]
+            replay = committed[arm]
+            if (
+                replay["configuration_id"] != source["configuration_id"]
+                or replay["bits"] != source["bits"]
+                or replay["joules"] != source["joules"]
+                or replay["served_count"] != source["served_count"]
+                or replay["rate_target_attained_count"] != source["rate_target_attained_count"]
+            ):
+                raise RuntimeError(f"parity row differs at anchor {index} arm {arm}")
+        parity_rows.append(committed)
+        print(
+            f"anchor {position}/{len(panel)} parity peak RSS {assert_rss()/2**30:.3f} GiB",
+            flush=True,
+        )
+    parity = {}
+    for arm, expected in EXPECTED_PARITY.items():
+        bits = math.fsum(float(row[arm]["bits"]) for row in parity_rows)
+        joules = math.fsum(float(row[arm]["joules"]) for row in parity_rows)
+        observed = bits / joules / 1e6
+        parity[arm] = {
+            "expected_rounded_6_mbit_per_j": expected,
+            "observed_mbit_per_j": observed,
+            "rounded_6_match": round(observed, 6) == expected,
+            "all_rows_exact_match_statics_receipt": True,
+        }
+    if not all(row["rounded_6_match"] for row in parity.values()):
+        raise RuntimeError(f"mandatory parity gate failed: {parity}")
+    print("PARITY PASS " + json.dumps(parity, sort_keys=True), flush=True)
+
+    payload = {
+        "schema": "mcrl-v025-basin-barrier-diagnostic-v1",
+        "status": "RUNNING",
+        "claim_status": "DESIGN_PHASE_DIAGNOSTIC_NOT_A_CLAIM",
+        "learner_free": True,
+        "learner_checkpoints_read": False,
+        "evaluation_only_claim_dates_read": False,
+        "panel": panel,
+        "panel_count": len(panel),
+        "parity": parity,
+        "python": sys.executable,
+        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+        "process_count": 1,
+        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+        "world_tape": {
+            "domain": tape.domain, "seed": tape.seed, "digest": tape.digest,
+            "construction_seconds": tape_seconds,
+        },
+        "calibration": calibration.payload(),
+        "eta_ref_bits_per_j": fraction_payload(calibration.eta_ref),
+        "sources": {
+            "panelceil_runner": {"path": str(PANELCEIL_RUNNER), "sha256": sha256(PANELCEIL_RUNNER)},
+            "panelceil_receipt": {"path": str(PANELCEIL_RECEIPT), "sha256": sha256(PANELCEIL_RECEIPT)},
+            "statics_runner": {"path": str(STATICS_RUNNER), "sha256": sha256(STATICS_RUNNER)},
+            "statics_receipt": {"path": str(STATICS_RECEIPT), "sha256": sha256(STATICS_RECEIPT)},
+        },
+        "objective": "pure F = decoded full-buffer bits - eta_ref * joules",
+        "selection_surface": "exact realised boundary 0 with declared prior-step incumbent",
+        "anchors": [],
+    }
+
+    for position, panel_row in enumerate(panel, 1):
+        anchor_started = time.perf_counter()
+        index = int(panel_row["global_anchor_index"])
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        source_anchor = statics_receipt["anchors"][index]
+        configs = {
+            arm: (
+                base if arm == "NEAREST_ELIGIBLE" else reconstruct(
+                    runner, base, source_anchor["arms"][arm], f"basin-{arm.lower()}"
+                )
+            )
+            for arm in ARM_NAMES
+        }
+        rss = configs["RSS_MAX"]
+        myopic = configs["MYOPIC_GREEDY"]
+        differing_users = [
+            user for user in sorted(base.mapping)
+            if base.mapping[user] != rss.mapping[user]
+        ]
+
+        evaluator = panelceil.new_selection_evaluator(
+            runner, tape, step_index, incumbent, run_setting, field="realised"
+        )
+        evaluate_batches(evaluator, list(configs.values()), panelceil.UNILATERAL_BATCH_SIZE)
+        rekeys = runner._rekeyed_users(tape, step_index)
+        arm_f = {}
+        for arm, config in configs.items():
+            profile = evaluator._evaluated.get(config.configuration_id)
+            if profile is None:
+                raise RuntimeError(f"static arm {arm} invalid at anchor {index}")
+            value = panelceil.objective(
+                runner, calibration, incumbent, config, profile, rekeys
+            )
+            arm_f[arm] = fraction_payload(value)
+
+        # Ascending-user cumulative path BASE -> RSS_MAX.
+        path = [base]
+        mapping = base.mapping
+        for user in differing_users:
+            mapping[user] = rss.mapping[user]
+            path.append(runner._configuration(base, mapping, kind="basin-rss-prefix-path"))
+        if path[-1].configuration_id != rss.configuration_id:
+            raise RuntimeError("RSS path endpoint mismatch")
+        evaluate_batches(evaluator, path, panelceil.UNILATERAL_BATCH_SIZE)
+        base_value = panelceil.objective(
+            runner, calibration, incumbent, base, evaluator.evaluate(base), rekeys
+        )
+        path_rows = []
+        first_improving_k = None
+        for path_index, config in enumerate(path):
+            profile = evaluator._evaluated.get(config.configuration_id)
+            if profile is None:
+                raise RuntimeError(f"invalid path prefix {path_index} at anchor {index}")
+            value = panelceil.objective(
+                runner, calibration, incumbent, config, profile, rekeys
+            )
+            if path_index > 0 and first_improving_k is None and value > base_value:
+                first_improving_k = path_index
+            path_rows.append({
+                "k": path_index,
+                "changed_user": None if path_index == 0 else differing_users[path_index - 1],
+                "configuration_id": config.configuration_id,
+                "f": fraction_payload(value),
+                "delta_f_vs_base": fraction_payload(value - base_value),
+                "served_count": panelceil.served(profile),
+            })
+
+        # Every isolated BASE -> RSS user replacement, not only the first prefix.
+        singleton_rows = []
+        singleton_configs = []
+        for user in differing_users:
+            mapping = base.mapping
+            mapping[user] = rss.mapping[user]
+            singleton_configs.append((user, runner._configuration(
+                base, mapping, kind="basin-rss-direction-singleton"
+            )))
+        evaluate_batches(
+            evaluator, [config for _, config in singleton_configs],
+            panelceil.UNILATERAL_BATCH_SIZE,
+        )
+        guard = panelceil.served(evaluator.evaluate(base))
+        for user, config in singleton_configs:
+            profile = evaluator._evaluated.get(config.configuration_id)
+            if profile is None:
+                singleton_rows.append({"user": user, "valid": False})
+                continue
+            value = panelceil.objective(
+                runner, calibration, incumbent, config, profile, rekeys
+            )
+            singleton_rows.append({
+                "user": user,
+                "valid": True,
+                "served_count": panelceil.served(profile),
+                "passes_guard": panelceil.served(profile) >= guard,
+                "delta_f_vs_base": fraction_payload(value - base_value),
+                "sign": sign(value - base_value),
+            })
+
+        rss_restart, rss_restart_detail = first_improvement_from(
+            panelceil, runner, calibration, tape, step_index, base, rss, incumbent, run_setting
+        )
+        myopic_restart, myopic_restart_detail = first_improvement_from(
+            panelceil, runner, calibration, tape, step_index, base, myopic, incumbent, run_setting
+        )
+        rss_restart_committed = committed_profile(
+            panelceil, runner, tape, step_index, incumbent, run_setting, rss_restart
+        )
+        myopic_restart_committed = committed_profile(
+            panelceil, runner, tape, step_index, incumbent, run_setting, myopic_restart
+        )
+
+        setting = runner._setting("a-r0")
+        base_catalogue, base_census = runner._catalogue_with_census(
+            tape, step_index, base, setting=setting, calibration=calibration,
+            run_setting=run_setting,
+        )
+        rss_catalogue, rss_census = runner._catalogue_with_census(
+            tape, step_index, rss, setting=setting, calibration=calibration,
+            run_setting=run_setting,
+        )
+        catalogue_evaluator = panelceil.new_selection_evaluator(
+            runner, tape, step_index, incumbent, run_setting, field="realised"
+        )
+        evaluate_batches(
+            catalogue_evaluator, list(rss_catalogue), panelceil.JOINT_BATCH_SIZE
+        )
+        rss_profile = catalogue_evaluator.evaluate(rss)
+        rss_value = panelceil.objective(
+            runner, calibration, incumbent, rss, rss_profile, rekeys
+        )
+        eligible = []
+        for config in rss_catalogue:
+            profile = catalogue_evaluator._evaluated.get(config.configuration_id)
+            if profile is None or panelceil.served(profile) < guard:
+                continue
+            value = panelceil.objective(
+                runner, calibration, incumbent, config, profile, rekeys
+            )
+            eligible.append((value, config.configuration_id, config))
+        if not eligible:
+            raise RuntimeError("RSS catalogue lost its guarded center")
+        catalogue_best_value, _, catalogue_best = min(
+            eligible, key=lambda row: (-row[0], row[1])
+        )
+        catalogue_best_committed = committed_profile(
+            panelceil, runner, tape, step_index, incumbent, run_setting, catalogue_best
+        )
+
+        joint_catalogue = tuple(
+            config for config in rss_catalogue
+            if sum(
+                config.mapping[user] != rss.mapping[user] for user in rss.mapping
+            ) >= 2
+        )
+        interaction_values = exact_interactions(
+            runner, panelceil, calibration, incumbent, rss, joint_catalogue,
+            catalogue_evaluator,
+        )
+        eligible_joint = [
+            row for row in eligible
+            if row[2].configuration_id in interaction_values
+        ]
+        best_joint = None
+        if eligible_joint:
+            best_joint_value, _, best_joint_config = min(
+                eligible_joint, key=lambda row: (-row[0], row[1])
+            )
+            best_joint = {
+                "configuration_id": best_joint_config.configuration_id,
+                "delta_f_vs_rss": fraction_payload(best_joint_value - rss_value),
+                **interaction_values[best_joint_config.configuration_id],
+            }
+        psi_f_counts = Counter(row["psi_f_sign"] for row in interaction_values.values())
+        psi_stagec_counts = Counter(row["psi_stagec_sign"] for row in interaction_values.values())
+        max_psi_config = None
+        if interaction_values:
+            max_id, max_row = max(
+                interaction_values.items(),
+                key=lambda item: (
+                    Fraction(
+                        int(item[1]["psi_f"]["numerator"]),
+                        int(item[1]["psi_f"]["denominator"]),
+                    ),
+                    -len(item[1]["changed_users"]),
+                    item[0],
+                ),
+            )
+            max_psi_config = {"configuration_id": max_id, **max_row}
+
+        base_hamming = hamming_counts(base_catalogue, base)
+        rss_hamming = hamming_counts(rss_catalogue, rss)
+        anchor_result = {
+            "global_anchor_index": index,
+            "anchor_id": f"{panel_row['world_id']}|{step_index}|{carrier}",
+            "step_index": step_index,
+            "carrier": carrier,
+            "hamming_base_to_rss": len(differing_users),
+            "differing_users_ascending": differing_users,
+            "arm_f": arm_f,
+            "path": path_rows,
+            "first_strictly_f_improving_prefix_k": first_improving_k,
+            "rss_direction_singletons": singleton_rows,
+            "all_valid_rss_direction_singletons_strictly_downhill": all(
+                row.get("sign") == "negative" for row in singleton_rows
+            ),
+            "rss_restart": {
+                "configuration_id": rss_restart.configuration_id,
+                "already_fixed_point": rss_restart.configuration_id == rss.configuration_id,
+                "detail": rss_restart_detail,
+                "committed": rss_restart_committed,
+            },
+            "myopic_restart": {
+                "configuration_id": myopic_restart.configuration_id,
+                "already_fixed_point": myopic_restart.configuration_id == myopic.configuration_id,
+                "detail": myopic_restart_detail,
+                "committed": myopic_restart_committed,
+            },
+            "catalogues": {
+                "a0": {
+                    "census": base_census,
+                    "count": len(base_catalogue),
+                    "hamming_counts": dict(sorted(base_hamming.items())),
+                    "max_hamming": max(base_hamming),
+                },
+                "rss": {
+                    "census": rss_census,
+                    "count": len(rss_catalogue),
+                    "hamming_counts": dict(sorted(rss_hamming.items())),
+                    "max_hamming": max(rss_hamming),
+                    "guard": guard,
+                    "eligible_count": len(eligible),
+                    "strict_f_improver_count": sum(value > rss_value for value, _, _ in eligible),
+                    "best_configuration_id": catalogue_best.configuration_id,
+                    "best_delta_f_vs_rss": fraction_payload(catalogue_best_value - rss_value),
+                    "best_committed": catalogue_best_committed,
+                },
+            },
+            "c3_reference_rss": {
+                "definition_pure_f": "psi_F = [F(S)-F(empty)] - sum_i[F({i})-F(empty)]",
+                "stagec_variant": "same residual after adding kappa*Phi to each configuration value",
+                "joint_candidate_count": len(joint_catalogue),
+                "exact_valid_interaction_count": len(interaction_values),
+                "psi_f_sign_counts": dict(psi_f_counts),
+                "psi_stagec_sign_counts": dict(psi_stagec_counts),
+                "best_guarded_joint_by_f": best_joint,
+                "maximum_psi_f": max_psi_config,
+            },
+            "anchor_wall_seconds": time.perf_counter() - anchor_started,
+            "peak_rss_bytes": assert_rss(),
+        }
+        payload["anchors"].append(anchor_result)
+        payload["peak_rss_bytes"] = assert_rss()
+        atomic_write(payload)
+        print(
+            f"anchor {position}/{len(panel)} completed peak RSS "
+            f"{payload['peak_rss_bytes']/2**30:.3f} GiB "
+            + json.dumps({
+                "global": index,
+                "hamming": len(differing_users),
+                "k": first_improving_k,
+                "rss_restart_moves": rss_restart_detail["accepted_moves"],
+                "myopic_restart_moves": myopic_restart_detail["accepted_moves"],
+                "rss_catalogue": len(rss_catalogue),
+                "c3_sign": None if best_joint is None else best_joint["psi_f_sign"],
+                "wall_s": round(anchor_result["anchor_wall_seconds"], 3),
+            }, sort_keys=True),
+            flush=True,
+        )
+
+    # Aggregate only after every anchor is complete.
+    aggregate_f = {}
+    for arm in ARM_NAMES:
+        total = sum((
+            Fraction(
+                int(row["arm_f"][arm]["numerator"]),
+                int(row["arm_f"][arm]["denominator"]),
+            )
+            for row in payload["anchors"]
+        ), Fraction())
+        aggregate_f[arm] = fraction_payload(total)
+    f_order = sorted(
+        ARM_NAMES,
+        key=lambda arm: (
+            -Fraction(
+                int(aggregate_f[arm]["numerator"]),
+                int(aggregate_f[arm]["denominator"]),
+            ),
+            arm,
+        ),
+    )
+    ee_order = sorted(
+        ARM_NAMES,
+        key=lambda arm: (-float(statics_receipt["pooled"][arm]["ee_bit_per_j"]), arm),
+    )
+    rss_restart_pool = pool_metrics(payload["anchors"], "_unused") if False else None
+    # Avoid a second schema for pooling nested endpoints.
+    def nested_pool(parent: str, child: str) -> dict[str, object]:
+        rows = [anchor[parent][child] for anchor in payload["anchors"]]
+        bits = math.fsum(float(row["bits"]) for row in rows)
+        joules = math.fsum(float(row["joules"]) for row in rows)
+        return {
+            "bits": bits, "joules": joules, "ee_bit_per_j": bits / joules,
+            "served_count": sum(int(row["served_count"]) for row in rows),
+            "rate_target_attained_count": sum(int(row["rate_target_attained_count"]) for row in rows),
+            "user_count": sum(int(row["user_count"]) for row in rows),
+        }
+    payload["summary"] = {
+        "aggregate_f": aggregate_f,
+        "f_order_best_to_worst": f_order,
+        "pooled_ee_order_best_to_worst": ee_order,
+        "orders_agree": f_order == ee_order,
+        "rss_f_above_base": Fraction(
+            int(aggregate_f["RSS_MAX"]["numerator"]),
+            int(aggregate_f["RSS_MAX"]["denominator"]),
+        ) > Fraction(
+            int(aggregate_f["NEAREST_ELIGIBLE"]["numerator"]),
+            int(aggregate_f["NEAREST_ELIGIBLE"]["denominator"]),
+        ),
+        "minimum_positive_prefix_k_across_anchors": min(
+            row["first_strictly_f_improving_prefix_k"]
+            for row in payload["anchors"]
+            if row["first_strictly_f_improving_prefix_k"] is not None
+        ),
+        "maximum_first_positive_prefix_k_across_anchors": max(
+            row["first_strictly_f_improving_prefix_k"]
+            for row in payload["anchors"]
+            if row["first_strictly_f_improving_prefix_k"] is not None
+        ),
+        "anchors_with_no_positive_prefix": [
+            row["global_anchor_index"] for row in payload["anchors"]
+            if row["first_strictly_f_improving_prefix_k"] is None
+        ],
+        "rss_restart_pooled": nested_pool("rss_restart", "committed"),
+        "myopic_restart_pooled": nested_pool("myopic_restart", "committed"),
+        "rss_catalogue_best_f_pooled": nested_pool("catalogues", "rss") if False else None,
+    }
+    catalogue_committed = [
+        anchor["catalogues"]["rss"]["best_committed"] for anchor in payload["anchors"]
+    ]
+    bits = math.fsum(float(row["bits"]) for row in catalogue_committed)
+    joules = math.fsum(float(row["joules"]) for row in catalogue_committed)
+    payload["summary"]["rss_catalogue_best_f_pooled"] = {
+        "bits": bits, "joules": joules, "ee_bit_per_j": bits / joules,
+        "served_count": sum(int(row["served_count"]) for row in catalogue_committed),
+        "rate_target_attained_count": sum(
+            int(row["rate_target_attained_count"]) for row in catalogue_committed
+        ),
+        "user_count": sum(int(row["user_count"]) for row in catalogue_committed),
+    }
+    payload["status"] = "COMPLETE"
+    payload["peak_rss_bytes"] = assert_rss()
+    payload["completed_wall_seconds"] = time.perf_counter() - started
+    atomic_write(payload)
+    print(f"peak RSS {payload['peak_rss_bytes']/2**30:.3f} GiB final ({payload['peak_rss_bytes']} bytes)", flush=True)
+    print(json.dumps(payload["summary"], sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
