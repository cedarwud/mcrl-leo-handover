+#!/usr/bin/env python3
+"""Learner-free BASIN barrier diagnostic on PANELCEIL's 12 development anchors."""
+
+from __future__ import annotations
+
+from collections import Counter
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-basin-ws")
+RANK_WORKSPACE = Path("/home/sat/mcrl-v025-rank-ws")
+PANELCEIL_WORKSPACE = Path("/home/sat/mcrl-v025-ceiling30-ws")
+PANELCEIL_RUNNER = PANELCEIL_WORKSPACE / ".scratch/panelceil/run_panelceil.py"
+PANELCEIL_RECEIPT = PANELCEIL_WORKSPACE / ".scratch/panelceil/panelceil-receipt.json"
+STATICS_RUNNER = RANK_WORKSPACE / ".scratch/statics/run_statics.py"
+STATICS_RECEIPT = RANK_WORKSPACE / ".scratch/statics/statics-receipt.json"
+OUTPUT = WORKSPACE / ".scratch/basin/basin-receipt.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+ARM_NAMES = (
+    "RANDOM", "ROUND_ROBIN", "RSS_MAX", "NEAREST_ELIGIBLE",
+    "MYOPIC_GREEDY", "FIRST_IMPROVEMENT_FP",
+)
+EXPECTED_PARITY = {
+    "NEAREST_ELIGIBLE": 11.027760,
+    "FIRST_IMPROVEMENT_FP": 13.430253,
+}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: dict) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def atomic_write(payload: dict) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
+    temporary.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(OUTPUT)
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def assert_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError("peak RSS is not below 5 GB")
+
+
+def assert_rss() -> int:
+    value = peak_rss_bytes()
+    if value >= MAX_RSS_BYTES:
+        raise MemoryError(f"peak RSS {value} is not below 5 GB")
+    return value
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def fraction_payload(value: Fraction) -> dict[str, object]:
+    return {
+        "numerator": value.numerator,
+        "denominator": value.denominator,
+        "float_bits": float(value),
+    }
+
+
+def sign(value: Fraction) -> str:
+    return "positive" if value > 0 else "negative" if value < 0 else "zero"
+
+
+def mapping_from_assignments(rows) -> dict[int, tuple[int, int] | None]:
+    return {
+        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
+        for user, identity in rows
+    }
+
+
+def reconstruct(runner, base, arm_row, kind: str):
+    mapping = mapping_from_assignments(arm_row["assignments"])
+    if mapping == base.mapping:
+        result = base
+    else:
+        result = runner._configuration(base, mapping, kind=kind)
+    if result.configuration_id != arm_row["configuration_id"]:
+        raise RuntimeError(f"configuration reconstruction mismatch for {kind}")
+    return result
+
+
+def evaluate_batches(evaluator, rows, batch_size: int) -> None:
+    for offset in range(0, len(rows), batch_size):
+        evaluator.evaluate_many(tuple(rows[offset:offset + batch_size]))
+
+
+def committed_profile(panelceil, runner, tape, step_index, incumbent, run_setting, config):
+    evaluator = runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field="realised", counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=tuple(range(48)),
+    )
+    evaluator.evaluate_many((config,))
+    profile = evaluator._evaluated.get(config.configuration_id)
+    if profile is None:
+        raise RuntimeError("committed configuration is invalid")
+    return panelceil.metric(profile)
+
+
+def pool_metrics(rows, key: str) -> dict[str, object]:
+    metrics = [row[key] for row in rows]
+    bits = math.fsum(float(row["bits"]) for row in metrics)
+    joules = math.fsum(float(row["joules"]) for row in metrics)
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bit_per_j": bits / joules,
+        "served_count": sum(int(row["served_count"]) for row in metrics),
+        "rate_target_attained_count": sum(
+            int(row["rate_target_attained_count"]) for row in metrics
+        ),
+        "user_count": sum(int(row["user_count"]) for row in metrics),
+    }
+
+
+def first_improvement_from(
+    panelceil, runner, calibration, tape, step_index, base, start, incumbent, run_setting,
+):
+    evaluator = panelceil.new_selection_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field="realised"
+    )
+    base_profile = evaluator.evaluate(base)
+    guard = panelceil.served(base_profile)
+    options, census = runner._legal_options(tape, step_index)
+    rekeys = runner._rekeyed_users(tape, step_index)
+    current = start
+    accepted_moves = comparisons = submissions = passes_with_moves = 0
+    while True:
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = evaluator.evaluate(current)
+            current_value = panelceil.objective(
+                runner, calibration, incumbent, current, current_profile, rekeys
+            )
+            identities = [identity for identity in options[user] if identity != current.mapping[user]]
+            accepted = None
+            for offset in range(0, len(identities), panelceil.UNILATERAL_BATCH_SIZE):
+                batch = tuple(
+                    panelceil.candidate(
+                        runner, base, current, user, identity,
+                        "basin-first-improvement-restart",
+                    )
+                    for identity in identities[offset:offset + panelceil.UNILATERAL_BATCH_SIZE]
+                )
+                evaluator.evaluate_many(batch)
+                submissions += len(batch)
+                for row in batch:
+                    comparisons += 1
+                    profile = evaluator._evaluated.get(row.configuration_id)
+                    if profile is None or panelceil.served(profile) < guard:
+                        continue
+                    value = panelceil.objective(
+                        runner, calibration, incumbent, row, profile, rekeys
+                    )
+                    if value > current_value:
+                        accepted = row
+                        break
+                if accepted is not None:
+                    current = accepted
+                    accepted_moves += 1
+                    moves_this_pass += 1
+                    break
+        if moves_this_pass == 0:
+            break
+        passes_with_moves += 1
+    # Explicit terminal certificate on a fresh cache, matching the same move class.
+    certificate = panelceil.new_selection_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field="realised"
+    )
+    current_profile = certificate.evaluate(current)
+    current_value = panelceil.objective(
+        runner, calibration, incumbent, current, current_profile, rekeys
+    )
+    improving = 0
+    guarded = 0
+    invalid = 0
+    all_rows = []
+    for user in sorted(options):
+        for identity in options[user]:
+            if identity != current.mapping[user]:
+                all_rows.append(panelceil.candidate(
+                    runner, base, current, user, identity, "basin-terminal-certificate"
+                ))
+    evaluate_batches(certificate, all_rows, panelceil.UNILATERAL_BATCH_SIZE)
+    for row in all_rows:
+        profile = certificate._evaluated.get(row.configuration_id)
+        if profile is None:
+            invalid += 1
+            continue
+        if panelceil.served(profile) < guard:
+            continue
+        guarded += 1
+        if panelceil.objective(
+            runner, calibration, incumbent, row, profile, rekeys
+        ) > current_value:
+            improving += 1
+    if improving:
+        raise RuntimeError("restart terminal certificate found a strict guarded improvement")
+    return current, {
+        "algorithm": "deterministic cyclic first-improvement",
+        "start_configuration_id": start.configuration_id,
+        "guard": guard,
+        "candidate_order": "ascending user ID; declared legal-option order",
+        "microbatch_size": panelceil.UNILATERAL_BATCH_SIZE,
+        "accepted_moves": accepted_moves,
+        "passes_with_moves": passes_with_moves,
+        "total_passes_including_certificate": passes_with_moves + 1,
+        "comparisons_before_separate_certificate": comparisons,
+        "submissions_before_separate_certificate": submissions,
+        "terminal_certificate": {
+            "complete": True,
+            "alternatives": len(all_rows),
+            "physically_invalid": invalid,
+            "guarded": guarded,
+            "strictly_improving": improving,
+        },
+        "legal_option_census": census,
+    }
+
+
+def hamming_counts(catalogue, center) -> Counter:
+    return Counter(
+        sum(config.mapping[user] != center.mapping[user] for user in center.mapping)
+        for config in catalogue
+    )
+
+
+def exact_interactions(
+    runner, panelceil, calibration, incumbent, center, catalogue, evaluator,
+):
+    """Pure-F and Stage-C F+kappa*Phi set residual beyond singleton effects."""
+
+    rekeys = runner._rekeyed_users(evaluator.tape, evaluator.step_index)
+    evaluate_batches(evaluator, list(catalogue), panelceil.JOINT_BATCH_SIZE)
+    center_profile = evaluator.evaluate(center)
+    center_f = panelceil.objective(
+        runner, calibration, incumbent, center, center_profile, rekeys
+    )
+
+    singleton_by_assignments = {}
+    changed_by_config = {}
+    for config in catalogue:
+        changed = tuple(
+            user for user in sorted(center.mapping)
+            if config.mapping[user] != center.mapping[user]
+        )
+        changed_by_config[config.configuration_id] = changed
+        if len(changed) < 2:
+            continue
+        for user in changed:
+            mapping = center.mapping
+            mapping[user] = config.mapping[user]
+            singleton = runner._configuration(center, mapping, kind="basin-exact-singleton")
+            singleton_by_assignments[singleton.assignments] = singleton
+    evaluate_batches(
+        evaluator, list(singleton_by_assignments.values()), panelceil.JOINT_BATCH_SIZE
+    )
+
+    def f_of(config):
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is None:
+            return None
+        return panelceil.objective(
+            runner, calibration, incumbent, config, profile, rekeys
+        )
+
+    center_phi = calibration.kappa_bits_per_user_step * runner._phi_for(incumbent, center)
+    values = {}
+    for config in catalogue:
+        changed = changed_by_config[config.configuration_id]
+        if len(changed) < 2:
+            continue
+        joint_f = f_of(config)
+        if joint_f is None:
+            continue
+        singleton_delta = Fraction()
+        singleton_phi_delta = Fraction()
+        valid = True
+        for user in changed:
+            mapping = center.mapping
+            mapping[user] = config.mapping[user]
+            singleton = singleton_by_assignments[tuple(sorted(mapping.items()))]
+            singleton_f = f_of(singleton)
+            if singleton_f is None:
+                valid = False
+                break
+            singleton_delta += singleton_f - center_f
+            singleton_phi_delta += (
+                calibration.kappa_bits_per_user_step * runner._phi_for(incumbent, singleton)
+                - center_phi
+            )
+        if not valid:
+            continue
+        joint_delta = joint_f - center_f
+        joint_phi_delta = (
+            calibration.kappa_bits_per_user_step * runner._phi_for(incumbent, config)
+            - center_phi
+        )
+        psi_f = joint_delta - singleton_delta
+        psi_stagec = (joint_delta + joint_phi_delta) - (
+            singleton_delta + singleton_phi_delta
