+# Set it on the imported module object for this rerun, then restore it.
+original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
+pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
+
+inputs = [
+    ROOT / ".scratch/c2-declared/world-1.jsonl",
+    ROOT / ".scratch/c2-declared/world-2.jsonl",
+]
+data = analysis.load_dataset(inputs)
+q2_digest_before = array_sha256(data.x)
+q2_copy = data.x.copy()
+
+# A Q1-v2 row projection is a dict copy followed by writes to Q1/provenance
+# keys.  Its q2_state field is not consumed or replaced.  Exercise that public
+# projection on a real shipped v1 source row and prove exact Q2 preservation.
+sample_path = (
+    ROOT
+    / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM/rows/world-1"
+    / "PILOT_NOT_CLAIM-source-anchor-000.jsonl"
+)
+with sample_path.open(encoding="ascii") as stream:
+    next(stream)
+    sample_parent = json.loads(next(stream))
+sample_projected = q1_v2.project_row_payload_v2(
+    sample_parent,
+    off_axis_angle_rad=0.0,
+    focal_elevation_deg=0.0,
+    geometry_source="schema-boundary regression: geometry values immaterial to q2 copy",
+)
+if sample_projected["q2_state"] != sample_parent["q2_state"]:
+    raise RuntimeError("Q1 v2 projection changed q2_state")
+
+analysis.SCRATCH = SCRATCH
+try:
+    analysis.main()
+finally:
+    pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = original_flag
+
+output_index = sys.argv.index("--output") + 1
+output_path = Path(sys.argv[output_index])
+payload = json.loads(output_path.read_text(encoding="utf-8"))
+v1 = json.loads(V1_RESULTS.read_text(encoding="utf-8"))
+
+q2_digest_after = array_sha256(q2_copy)
+if q2_digest_after != q2_digest_before:
+    raise RuntimeError("in-memory Q2 matrix changed")
+
+payload["schema"] = "c2-declared-target-learnability-diagnostic-v2"
+payload["q1_schema_repair"] = {
+    "name": q1_v2.Q1_V2_SCHEMA_VERSION,
+    "sha256": q1_v2.Q1_V2_SCHEMA_SHA256,
+    "shape": [len(q1_v2.Q1_V2_FEATURES)],
+    "file": str(V2_PATH),
+    "file_sha256": before[str(V2_PATH)],
+}
+payload["q2_schema_boundary"] = {
+    "q2_schema_name": "mcrl-v025-stagec-q2-action-v1",
+    "q2_schema_sha256": "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c",
+    "shape": [22],
+    "changed_zero_based_slots": [],
+    "unchanged_zero_based_slots": list(range(22)),
+    "matrix_sha256_before": q2_digest_before,
+    "matrix_sha256_after": q2_digest_after,
+    "representative_public_adapter_q2_exactly_equal": True,
+    "reason": (
+        "q1_schema_v2 project_row_payload_v2 copies the parent payload and "
+        "replaces only q1_state plus Q1 provenance; it defines no Q2-v2 schema"
+    ),
+}
+payload["repaired_coordinate_permutation_importance"] = {
+    name: {
+        "present_in_c2_q2_state": False,
+        "prediction_change_after_permutation": 0.0,
+        "drop_r2": 0.0,
+        "drop_pairwise_ordering": 0.0,
+        "drop_top1_accuracy": 0.0,
+        "kind": "exact structural zero, not an estimated importance",
+    }
+    for name in ("off_axis_angle", "focal_link_elevation")
+}
+payload["v1_comparator"] = {
+    "result": str(V1_RESULTS.resolve().relative_to(ROOT)),
+    "sha256": before[str(V1_RESULTS)],
+}
+payload["fresh_rerun"] = {
+    "fresh_cache": str((SCRATCH / "adam-task-cache").resolve().relative_to(ROOT)),
+    "loaded_cached_adam_tasks": sum(
+        int(row.get("loaded_cache", False))
+        for architecture in payload["capacity"]["widths"].values()
+        for regime in architecture.values()
+        for row in regime["per_seed"]
+    ),
+    "same_input_file_hashes_as_v1": payload["generation"]["input_sha256"]
+    == v1["generation"]["input_sha256"],
+    "same_anchors_rows_groups_as_v1": all(
+        payload["generation"][field] == v1["generation"][field]
+        for field in ("anchors", "rows", "anchor_user_groups")
+    ),
+    "exact_path_module_flag_during_rerun": False,
+    "exact_path_module_flag_restored": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
+}
+
+after = {str(path): sha256(path) for path in sealed}
+changed = [path for path in before if before[path] != after[path]]
+if changed:
+    raise RuntimeError(f"sealed inputs changed during v2 analysis: {changed}")
+
+peak_self = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+peak_children = int(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)
+payload["resource_usage_v2_wrapper"] = {
+    "python_process_cap": 3,
+    "analysis_python_processes": "one parent plus at most two fork workers",
+    "nice": __import__("os").nice(0),
+    "blas_threads": 1,
+    "rlimit_as_bytes_per_process": RSS_LIMIT_BYTES,
+    "peak_rss_kb_parent": peak_self,
+    "peak_rss_kb_children_max": peak_children,
+}
+payload["sealed_file_sha256_before"] = before
+payload["sealed_file_sha256_after"] = after
+payload["changed_files"] = changed
+output_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+print(f"PEAK_RSS_KB_PARENT={peak_self}", flush=True)
+print(f"PEAK_RSS_KB_CHILDREN_MAX={peak_children}", flush=True)
+print(
+    json.dumps(
+        {
+            "written": str(output_path),
+            "q2_changed_slots": [],
+            "fresh_cached_tasks_loaded": payload["fresh_rerun"]["loaded_cached_adam_tasks"],
+        },
+        sort_keys=True,
+    ),
+    flush=True,
+)
