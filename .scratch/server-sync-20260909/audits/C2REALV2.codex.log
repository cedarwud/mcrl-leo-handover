+        "prediction_change_after_permutation": 0.0,
+        "drop_r2": 0.0,
+        "drop_pairwise_ordering": 0.0,
+        "drop_top1_accuracy": 0.0,
+        "kind": "exact structural zero, not an estimated importance",
+    }
+    for name in ("off_axis_angle", "focal_link_elevation")
