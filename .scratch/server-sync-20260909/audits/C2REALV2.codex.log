+#!/usr/bin/env python3
+"""Spot-audit the direct Q1-v2 exact adapter against fitted C2 rows."""
+
+from __future__ import annotations
+
+import argparse
+from fractions import Fraction
+import hashlib
+import json
+from pathlib import Path
+import resource
+import time
