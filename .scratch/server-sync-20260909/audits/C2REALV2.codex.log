+++ b/.scratch/c2-declared-v2/verify_exact_adapter_v2.py
@@ -0,0 +1,207 @@
+#!/usr/bin/env python3
+"""Spot-audit the direct Q1-v2 exact adapter against fitted C2 rows."""
+
+from __future__ import annotations
+
+import argparse
+from fractions import Fraction
+import hashlib
+import json
+from pathlib import Path
+import resource
+import time
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+
+ROOT = Path(__file__).resolve().parents[2]
+V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+    / "PILOT_NOT_CLAIM-calibration.json"
+)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def ratio(payload: dict[str, object], key: str) -> Fraction:
+    values = payload[key]
+    return Fraction(int(values[0]), int(values[1]))
+
+
+def load_calibration(path: Path, pilot):
+    payload = json.loads(path.read_text(encoding="ascii"))
+    return pilot.PilotCalibration(
+        eta_ref=ratio(payload, "eta_ref"),
+        lambda_bits_per_j=ratio(payload, "lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio(payload, "kappa_bits_per_user_step"),
+        bits_ref=ratio(payload, "bits_ref"),
+        joules_ref=ratio(payload, "joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def cached_key(row: dict[str, object]) -> tuple[int, int, tuple[int, int] | None]:
+    identity = row["identity"]
+    physical = None if identity is None else (int(identity[0]), int(identity[1]))
+    return int(row["user_id"]), int(row["action_index"]), physical
+
+
+def payload_key(payload: dict[str, object]) -> tuple[int, int, tuple[int, int] | None]:
+    action = payload["action"]
+    physical = (
+        None
+        if bool(payload["null_action"])
+        else (int(action["norad_id"]), int(action["beam_chain_id"]))
+    )
+    return int(payload["user_id"]), int(payload["action_index"]), physical
+
+
+def load_cached_anchor(path: Path, step_index: int) -> dict[tuple, dict[str, object]]:
+    with path.open(encoding="utf-8") as stream:
+        for line in stream:
+            record = json.loads(line)
+            if record["kind"] == "anchor" and int(record["step_index"]) == step_index:
+                return {cached_key(row): row for row in record["rows"]}
+    raise RuntimeError("requested cached anchor is absent")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--world-index", type=int, choices=(1, 2), required=True)
+    parser.add_argument("--step-index", type=int, default=0)
+    parser.add_argument("--fitted-input", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    watched = (PILOT_PATH, V2_PATH, CALIBRATION_PATH, args.fitted_input)
+    before = {str(path): sha256(path) for path in watched}
+
+    import q1_schema_v2 as v2
+    import scripts.run_v025_pilot_c3 as pilot
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+    from mcrl.stagec_v025.canonical import parse_float_hex
+
+    domain = DEVELOPMENT_WORLD_DOMAINS[args.world_index - 1]
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    calibration = load_calibration(CALIBRATION_PATH, pilot)
+    expected = load_cached_anchor(args.fitted_input, args.step_index)
+
+    original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
+    provider_started = time.perf_counter()
+    provider = LegacyWorldProvider(role="pilot-source")
+    tape = build_world_tape(
+        domain=domain,
+        provider=provider,
+        steps=33,
+        start_time_s=0.0,
+    )
+    provider_wall_s = time.perf_counter() - provider_started
+
+    geometry = v2.DecisionGeometryResolverV2(tape, provider, args.step_index)
+    started = time.perf_counter()
+    exact = v2.build_exact_rows_v2(
+        pilot,
+        geometry_lookup=geometry,
+        tape=tape,
+        setting=setting,
+        run_setting=run_setting,
+        calibration=calibration,
+        step_index=args.step_index,
+        carrier="nearest-eligible",
+        anchor_index=args.step_index,
+        include_coalition=False,
+        full_legal_actions=False,
+    )
+    exact_wall_s = time.perf_counter() - started
+    max_q2_abs = 0.0
+    max_target_abs = 0.0
+    for payload in exact["rows"]:
+        cached = expected.pop(payload_key(payload))
+        q2 = tuple(parse_float_hex(value, field="q2") for value in payload["q2_state"])
+        max_q2_abs = max(
+            max_q2_abs,
+            max(abs(left - right) for left, right in zip(q2, cached["q2"], strict=True)),
+        )
+        target = parse_float_hex(payload["c2_label_normalized_hex"], field="c2")
+        max_target_abs = max(max_target_abs, abs(target - float(cached["declared"])))
+    if expected:
+        raise RuntimeError("direct adapter did not reproduce every fitted row")
+    if max(max_q2_abs, max_target_abs) != 0.0:
+        raise RuntimeError("direct exact adapter disagrees with cached fitted C2 panel")
+    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not original_flag:
+        raise RuntimeError("exact adapter did not restore the module flag")
+
+    after = {str(path): sha256(path) for path in watched}
+    changed = [path for path in before if before[path] != after[path]]
+    if changed:
+        raise RuntimeError(f"watched input changed: {changed}")
+    peak_rss_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    result = {
+        "artifact": "C2_DECLARED_TARGET_LEARNABILITY_V2_EXACT_ADAPTER_SPOT_AUDIT",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "interpreter": __import__("sys").executable,
+        "world_id": domain,
+        "world_index": args.world_index,
+        "step_index": args.step_index,
+        "setting": "a-r0",
+        "carrier": "nearest-eligible",
+        "rows": len(exact["rows"]),
+        "provider_wall_s": provider_wall_s,
+        "exact_wall_s": exact_wall_s,
+        "physics_calls": int(exact["physics_calls"]),
+        "skipped_invalid": int(exact["skipped_invalid"]),
+        "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
+        "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
+        "direct_adapter": "q1_schema_v2.build_exact_rows_v2",
+        "pilot_flag_original_and_after": original_flag,
+        "maximum_absolute_difference": {
+            "q2_state": max_q2_abs,
+            "declared_c2_target": max_target_abs,
+        },
+        "maximum_elevation_crosscheck_error_deg": float(
+            geometry.maximum_elevation_crosscheck_error_deg
+        ),
+        "resource_policy": {
+            "python_processes_for_this_worker": 1,
+            "nice": __import__("os").nice(0),
+            "blas_threads": 1,
+            "rlimit_as_bytes": RSS_LIMIT_BYTES,
+            "peak_rss_kb": peak_rss_kb,
+        },
+        "watched_sha256_before": before,
+        "watched_sha256_after": after,
+        "changed_files": changed,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(
+        json.dumps(
+            {
+                "world": args.world_index,
+                "step": args.step_index,
+                "rows": len(exact["rows"]),
+                "exact_wall_s": exact_wall_s,
+                "physics_calls": int(exact["physics_calls"]),
+            },
+            sort_keys=True,
+        ),
+        flush=True,
+    )
+    print(f"PEAK_RSS_KB={peak_rss_kb}", flush=True)
+    print(json.dumps({"written": str(args.output)}, sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
