+#!/usr/bin/env python3
+"""Fresh schema-only rerun of the declared-C2 learnability diagnostic.
+
+Q1 v2 deliberately changes only ``q1_state``.  The C2 learner consumes
+``q2_state``; the successor adapter copies that field verbatim.  This wrapper
+runs the retained v1 analysis against a fresh cache, proves the Q2 inputs are
+the same, and records the schema-boundary result explicitly.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import resource
+import sys
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRATCH = ROOT / ".scratch/c2-declared-v2"
+V1_ANALYZE = ROOT / ".scratch/c2-declared/analyze.py"
+V1_RESULTS = ROOT / ".scratch/c2-declared/results.json"
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+EXPECTED_Q1_V2_SHA256 = (
+    "66ed4a3f9222ac7f20f4334ffab92f6164d2dad203cbac7f7d4e1728ae4ad654"
+)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def array_sha256(array) -> str:
+    digest = hashlib.sha256()
+    digest.update(str(array.dtype).encode("ascii"))
+    digest.update(json.dumps(list(array.shape), separators=(",", ":")).encode("ascii"))
+    digest.update(array.tobytes(order="C"))
+    return digest.hexdigest()
+
+
+sealed = (
+    PILOT_PATH,
+    V2_PATH,
+    ROOT / "src/mcrl/stagec_v025/learner.py",
+    ROOT / "src/mcrl/stagec_v025/state.py",
+    ROOT / "src/mcrl/physics_v025/targets.py",
+    ROOT / ".scratch/c2-declared/world-1.jsonl",
+    ROOT / ".scratch/c2-declared/world-2.jsonl",
+    V1_RESULTS,
+)
+before = {str(path): sha256(path) for path in sealed}
+
+spec = importlib.util.spec_from_file_location("c2_declared_v1_analysis", V1_ANALYZE)
+if spec is None or spec.loader is None:
+    raise RuntimeError("could not load v1 analysis")
+analysis = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = analysis
+spec.loader.exec_module(analysis)
+
+import numpy as np
+import q1_schema_v2 as q1_v2
+import scripts.run_v025_pilot_c3 as pilot
+
+
+if Path(q1_v2.__file__).resolve() != V2_PATH:
+    raise RuntimeError(f"wrong q1_schema_v2 import: {q1_v2.__file__}")
+if q1_v2.Q1_V2_SCHEMA_SHA256 != EXPECTED_Q1_V2_SHA256:
+    raise RuntimeError("Q1 v2 schema digest mismatch")
+
+# The retained checkpoints were generated by this exact-path module state.
+# Set it on the imported module object for this rerun, then restore it.
+original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
+pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
+
+inputs = [
+    ROOT / ".scratch/c2-declared/world-1.jsonl",
+    ROOT / ".scratch/c2-declared/world-2.jsonl",
+]
+data = analysis.load_dataset(inputs)
+q2_digest_before = array_sha256(data.x)
+q2_copy = data.x.copy()
+
+# A Q1-v2 row projection is a dict copy followed by writes to Q1/provenance
+# keys.  Its q2_state field is not consumed or replaced.  Exercise that public
+# projection on a real shipped v1 source row and prove exact Q2 preservation.
+sample_path = (
+    ROOT
+    / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM/rows/world-1"
+    / "PILOT_NOT_CLAIM-source-anchor-000.jsonl"
+)
+with sample_path.open(encoding="ascii") as stream:
+    next(stream)
+    sample_parent = json.loads(next(stream))
+sample_projected = q1_v2.project_row_payload_v2(
+    sample_parent,
+    off_axis_angle_rad=0.0,
+    focal_elevation_deg=0.0,
+    geometry_source="schema-boundary regression: geometry values immaterial to q2 copy",
+)
+if sample_projected["q2_state"] != sample_parent["q2_state"]:
+    raise RuntimeError("Q1 v2 projection changed q2_state")
+
+analysis.SCRATCH = SCRATCH
+try:
+    analysis.main()
+finally:
+    pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = original_flag
+
+output_index = sys.argv.index("--output") + 1
+output_path = Path(sys.argv[output_index])
+payload = json.loads(output_path.read_text(encoding="utf-8"))
+v1 = json.loads(V1_RESULTS.read_text(encoding="utf-8"))
+
+q2_digest_after = array_sha256(q2_copy)
+if q2_digest_after != q2_digest_before:
+    raise RuntimeError("in-memory Q2 matrix changed")
+
+payload["schema"] = "c2-declared-target-learnability-diagnostic-v2"
+payload["q1_schema_repair"] = {
+    "name": q1_v2.Q1_V2_SCHEMA_VERSION,
+    "sha256": q1_v2.Q1_V2_SCHEMA_SHA256,
+    "shape": [len(q1_v2.Q1_V2_FEATURES)],
+    "file": str(V2_PATH),
+    "file_sha256": before[str(V2_PATH)],
+}
+payload["q2_schema_boundary"] = {
+    "q2_schema_name": "mcrl-v025-stagec-q2-action-v1",
+    "q2_schema_sha256": "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c",
+    "shape": [22],
+    "changed_zero_based_slots": [],
+    "unchanged_zero_based_slots": list(range(22)),
+    "matrix_sha256_before": q2_digest_before,
+    "matrix_sha256_after": q2_digest_after,
+    "representative_public_adapter_q2_exactly_equal": True,
+    "reason": (
+        "q1_schema_v2 project_row_payload_v2 copies the parent payload and "
+        "replaces only q1_state plus Q1 provenance; it defines no Q2-v2 schema"
+    ),
+}
+payload["repaired_coordinate_permutation_importance"] = {
+    name: {
+        "present_in_c2_q2_state": False,
+        "prediction_change_after_permutation": 0.0,
+        "drop_r2": 0.0,
+        "drop_pairwise_ordering": 0.0,
+        "drop_top1_accuracy": 0.0,
+        "kind": "exact structural zero, not an estimated importance",
+    }
+    for name in ("off_axis_angle", "focal_link_elevation")
+}
+payload["v1_comparator"] = {
+    "result": str(V1_RESULTS.resolve().relative_to(ROOT)),
+    "sha256": before[str(V1_RESULTS)],
+}
+payload["fresh_rerun"] = {
+    "fresh_cache": str((SCRATCH / "adam-task-cache").resolve().relative_to(ROOT)),
+    "loaded_cached_adam_tasks": sum(
+        int(row.get("loaded_cache", False))
+        for architecture in payload["capacity"]["widths"].values()
+        for regime in architecture.values()
+        for row in regime["per_seed"]
+    ),
+    "same_input_file_hashes_as_v1": payload["generation"]["input_sha256"]
+    == v1["generation"]["input_sha256"],
+    "same_anchors_rows_groups_as_v1": all(
+        payload["generation"][field] == v1["generation"][field]
+        for field in ("anchors", "rows", "anchor_user_groups")
+    ),
+    "exact_path_module_flag_during_rerun": False,
+    "exact_path_module_flag_restored": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
+}
+
+after = {str(path): sha256(path) for path in sealed}
+changed = [path for path in before if before[path] != after[path]]
+if changed:
+    raise RuntimeError(f"sealed inputs changed during v2 analysis: {changed}")
+
+peak_self = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+peak_children = int(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)
+payload["resource_usage_v2_wrapper"] = {
+    "python_process_cap": 3,
+    "analysis_python_processes": "one parent plus at most two fork workers",
+    "nice": __import__("os").nice(0),
+    "blas_threads": 1,
+    "rlimit_as_bytes_per_process": RSS_LIMIT_BYTES,
+    "peak_rss_kb_parent": peak_self,
+    "peak_rss_kb_children_max": peak_children,
+}
+payload["sealed_file_sha256_before"] = before
+payload["sealed_file_sha256_after"] = after
+payload["changed_files"] = changed
+output_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+print(f"PEAK_RSS_KB_PARENT={peak_self}", flush=True)
+print(f"PEAK_RSS_KB_CHILDREN_MAX={peak_children}", flush=True)
+print(
+    json.dumps(
+        {
+            "written": str(output_path),
+            "q2_changed_slots": [],
+            "fresh_cached_tasks_loaded": payload["fresh_rerun"]["loaded_cached_adam_tasks"],
+        },
+        sort_keys=True,
+    ),
+    flush=True,
+)
diff --git a/.scratch/c2-declared-v2/verify_exact_adapter_v2.py b/.scratch/c2-declared-v2/verify_exact_adapter_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..84ede9becdf7f4135b954a4fc48e3c360241873e
--- /dev/null
+++ b/.scratch/c2-declared-v2/verify_exact_adapter_v2.py
@@ -0,0 +1,207 @@
+#!/usr/bin/env python3
+"""Spot-audit the direct Q1-v2 exact adapter against fitted C2 rows."""
+
+from __future__ import annotations
+
+import argparse
+from fractions import Fraction
+import hashlib
+import json
+from pathlib import Path
+import resource
+import time
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+
+ROOT = Path(__file__).resolve().parents[2]
+V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+    / "PILOT_NOT_CLAIM-calibration.json"
+)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def ratio(payload: dict[str, object], key: str) -> Fraction:
+    values = payload[key]
+    return Fraction(int(values[0]), int(values[1]))
+
+
+def load_calibration(path: Path, pilot):
+    payload = json.loads(path.read_text(encoding="ascii"))
+    return pilot.PilotCalibration(
+        eta_ref=ratio(payload, "eta_ref"),
+        lambda_bits_per_j=ratio(payload, "lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio(payload, "kappa_bits_per_user_step"),
+        bits_ref=ratio(payload, "bits_ref"),
+        joules_ref=ratio(payload, "joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def cached_key(row: dict[str, object]) -> tuple[int, int, tuple[int, int] | None]:
+    identity = row["identity"]
+    physical = None if identity is None else (int(identity[0]), int(identity[1]))
+    return int(row["user_id"]), int(row["action_index"]), physical
+
+
+def payload_key(payload: dict[str, object]) -> tuple[int, int, tuple[int, int] | None]:
+    action = payload["action"]
+    physical = (
+        None
+        if bool(payload["null_action"])
+        else (int(action["norad_id"]), int(action["beam_chain_id"]))
+    )
+    return int(payload["user_id"]), int(payload["action_index"]), physical
+
+
+def load_cached_anchor(path: Path, step_index: int) -> dict[tuple, dict[str, object]]:
+    with path.open(encoding="utf-8") as stream:
+        for line in stream:
+            record = json.loads(line)
+            if record["kind"] == "anchor" and int(record["step_index"]) == step_index:
+                return {cached_key(row): row for row in record["rows"]}
+    raise RuntimeError("requested cached anchor is absent")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--world-index", type=int, choices=(1, 2), required=True)
+    parser.add_argument("--step-index", type=int, default=0)
+    parser.add_argument("--fitted-input", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    watched = (PILOT_PATH, V2_PATH, CALIBRATION_PATH, args.fitted_input)
+    before = {str(path): sha256(path) for path in watched}
+
+    import q1_schema_v2 as v2
+    import scripts.run_v025_pilot_c3 as pilot
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+    from mcrl.stagec_v025.canonical import parse_float_hex
+
+    domain = DEVELOPMENT_WORLD_DOMAINS[args.world_index - 1]
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    calibration = load_calibration(CALIBRATION_PATH, pilot)
+    expected = load_cached_anchor(args.fitted_input, args.step_index)
+
+    original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
+    provider_started = time.perf_counter()
+    provider = LegacyWorldProvider(role="pilot-source")
+    tape = build_world_tape(
+        domain=domain,
+        provider=provider,
+        steps=33,
+        start_time_s=0.0,
+    )
+    provider_wall_s = time.perf_counter() - provider_started
+
+    geometry = v2.DecisionGeometryResolverV2(tape, provider, args.step_index)
+    started = time.perf_counter()
+    exact = v2.build_exact_rows_v2(
+        pilot,
+        geometry_lookup=geometry,
+        tape=tape,
+        setting=setting,
+        run_setting=run_setting,
+        calibration=calibration,
+        step_index=args.step_index,
+        carrier="nearest-eligible",
+        anchor_index=args.step_index,
+        include_coalition=False,
+        full_legal_actions=False,
+    )
+    exact_wall_s = time.perf_counter() - started
+    max_q2_abs = 0.0
+    max_target_abs = 0.0
+    for payload in exact["rows"]:
+        cached = expected.pop(payload_key(payload))
+        q2 = tuple(parse_float_hex(value, field="q2") for value in payload["q2_state"])
+        max_q2_abs = max(
+            max_q2_abs,
+            max(abs(left - right) for left, right in zip(q2, cached["q2"], strict=True)),
+        )
+        target = parse_float_hex(payload["c2_label_normalized_hex"], field="c2")
+        max_target_abs = max(max_target_abs, abs(target - float(cached["declared"])))
+    if expected:
+        raise RuntimeError("direct adapter did not reproduce every fitted row")
+    if max(max_q2_abs, max_target_abs) != 0.0:
+        raise RuntimeError("direct exact adapter disagrees with cached fitted C2 panel")
+    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not original_flag:
+        raise RuntimeError("exact adapter did not restore the module flag")
+
+    after = {str(path): sha256(path) for path in watched}
+    changed = [path for path in before if before[path] != after[path]]
+    if changed:
+        raise RuntimeError(f"watched input changed: {changed}")
+    peak_rss_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    result = {
+        "artifact": "C2_DECLARED_TARGET_LEARNABILITY_V2_EXACT_ADAPTER_SPOT_AUDIT",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "interpreter": __import__("sys").executable,
+        "world_id": domain,
+        "world_index": args.world_index,
+        "step_index": args.step_index,
+        "setting": "a-r0",
+        "carrier": "nearest-eligible",
+        "rows": len(exact["rows"]),
+        "provider_wall_s": provider_wall_s,
+        "exact_wall_s": exact_wall_s,
+        "physics_calls": int(exact["physics_calls"]),
+        "skipped_invalid": int(exact["skipped_invalid"]),
+        "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
+        "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
+        "direct_adapter": "q1_schema_v2.build_exact_rows_v2",
+        "pilot_flag_original_and_after": original_flag,
+        "maximum_absolute_difference": {
+            "q2_state": max_q2_abs,
+            "declared_c2_target": max_target_abs,
+        },
+        "maximum_elevation_crosscheck_error_deg": float(
+            geometry.maximum_elevation_crosscheck_error_deg
+        ),
+        "resource_policy": {
+            "python_processes_for_this_worker": 1,
+            "nice": __import__("os").nice(0),
+            "blas_threads": 1,
+            "rlimit_as_bytes": RSS_LIMIT_BYTES,
+            "peak_rss_kb": peak_rss_kb,
+        },
+        "watched_sha256_before": before,
+        "watched_sha256_after": after,
+        "changed_files": changed,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(
+        json.dumps(
+            {
+                "world": args.world_index,
+                "step": args.step_index,
+                "rows": len(exact["rows"]),
+                "exact_wall_s": exact_wall_s,
+                "physics_calls": int(exact["physics_calls"]),
+            },
+            sort_keys=True,
+        ),
+        flush=True,
+    )
+    print(f"PEAK_RSS_KB={peak_rss_kb}", flush=True)
+    print(json.dumps({"written": str(args.output)}, sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    main()

diff --git a/.scratch/c2-declared-v2/analyze_v2.py b/.scratch/c2-declared-v2/analyze_v2.py
