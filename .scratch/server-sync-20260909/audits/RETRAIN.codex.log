_TRAIN_Q1 = None
_TRAIN_Q2 = None
_TRAIN_C3 = None
_TRAIN_NEUTRAL = None
_TRAIN_OUTPUT = None


def _train_one(task):
    learner_seed, arm = task
    wall_started = time.perf_counter()
    cpu_started = time.process_time()
    assert _TRAIN_Q1 is not None and _TRAIN_Q2 is not None and _TRAIN_C3 is not None
    orchestrator = V1LineageOrchestrator(
        learner_seed=learner_seed,
        q1_batch=_TRAIN_Q1,
        q2_batch=_TRAIN_Q2,
        c3_batch=_TRAIN_C3,
        neutral_sources=_TRAIN_NEUTRAL,
    )
    model = orchestrator.models[arm]
    batches = {
        "C1": _TRAIN_Q1 if SOURCE_MAP[arm]["C1"] == "informed" else orchestrator._neutral_q1,
        "C2": _TRAIN_Q2 if SOURCE_MAP[arm]["C2"] == "informed" else orchestrator._neutral_q2,
        "C3": _TRAIN_C3 if SOURCE_MAP[arm]["C3"] == "informed" else orchestrator._neutral_c3,
    }
    final_losses = {}
    checkpoint_digests = []
    for epoch in range(1, LEGACY_EPOCH_BUDGET + 1):
        final_losses = {
            "C1": model.q1.update(batches["C1"]),
            "C2": model.q2.update(batches["C2"]),
            "C3": model.psi.update(batches["C3"]),
        }
        if epoch % 100 == 0:
            payload = {
                "schema": f"{PILOT_SCHEMA}-arm-lineage-checkpoint-v1",
                "artifact_label": LABEL,
                "arm": arm,
                "learner_seed": learner_seed,
                "completed_source_epochs": epoch,
                "checkpoint_every_source_epochs": 100,
                "epoch_budget": LEGACY_EPOCH_BUDGET,
                "batch_digests": {
                    "C1": _TRAIN_Q1.digest,
                    "C2": _TRAIN_Q2.digest,
                    "C3": _TRAIN_C3.digest,
                },
                "neutral_source_digests": {
                    route: _TRAIN_NEUTRAL[route].digest for route in ROUTES
                },
                "initialization_sha256": orchestrator.initialization_sha256,
                "source_map": dict(SOURCE_MAP[arm]),
                "model": model.payload(),
                "final_losses": final_losses,
                "neutral_batches_hoisted": True,
            }
            path = (
                Path(_TRAIN_OUTPUT)
                / "checkpoints"
                / f"{LABEL}-seed-{learner_seed}-{arm}-epoch-{epoch:04d}.json"
            )
            checkpoint_digests.append(write_once_json(path, payload))
    return {
        "artifact_label": LABEL,
        "arm": arm,
        "learner_seed": learner_seed,
        "completed_source_epochs": LEGACY_EPOCH_BUDGET,
        "wall_s": time.perf_counter() - wall_started,
        "core_s": time.process_time() - cpu_started,
        "final_losses": final_losses,
        "checkpoint_count": len(checkpoint_digests),
        "final_checkpoint_sha256": checkpoint_digests[-1],
        "model_payload": model.payload(),
        "initialization_sha256": orchestrator.initialization_sha256,
    }


def _aggregate_pair_batch(batch: PairwiseBatch) -> PairwiseBatch:
    if batch.target_deltas.size <= PILOT_AGGREGATE_PAIR_LIMIT:
        return batch
    indices = np.linspace(
        0, batch.target_deltas.size - 1, PILOT_AGGREGATE_PAIR_LIMIT,
        dtype=np.int64,
    )
    return PairwiseBatch.create(
        batch.route, batch.reference_states[indices],
        batch.candidate_states[indices], batch.target_deltas[indices],
        tuple(batch.row_identities[index] for index in indices),
        batch.source_authority_sha256,
        source_identity="informed:pilot-deterministic-4096-pair-aggregate",
        physics_digest=batch.physics_digest,
    )


def train(output: Path, source_shards, coalition_shards):
    global _TRAIN_Q1, _TRAIN_Q2, _TRAIN_C3, _TRAIN_NEUTRAL, _TRAIN_OUTPUT
    phase_started = time.perf_counter()
    q_batches = {
        route: _aggregate_pair_batch(batch)
        for route, batch in build_pairwise_batches(source_shards).items()
    }
    _TRAIN_Q1, _TRAIN_Q2 = q_batches["C1"], q_batches["C2"]
    _TRAIN_C3 = CoalitionBatch.create(coalition_shards)
    _TRAIN_NEUTRAL = default_synthetic_neutral_sources()
    _TRAIN_OUTPUT = str(output)
    tasks = [(seed, arm) for seed in LEARNER_SEEDS for arm in LEARNED_ARMS]
    results = []
    context = mp.get_context("fork")
    with ProcessPoolExecutor(max_workers=16, mp_context=context) as executor:
        future_to_task = {executor.submit(_train_one, task): task for task in tasks}
        for future in as_completed(future_to_task):
            result = future.result()
            results.append(result)
            print(
                json.dumps(
                    {
                        "artifact_label": LABEL,
                        "phase": "train",
                        "arm": result["arm"],
                        "learner_seed": result["learner_seed"],
                        "completed": len(results),
                        "total": len(tasks),
                    }
                ),
                flush=True,
            )
    baseline = [
        {
            "artifact_label": LABEL,
            "arm": "BASELINE",
            "learner_seed": seed,
            "completed_source_epochs": 0,
            "external_policy": "fixed carrier proposal",
            "wall_s": 0.0,
            "core_s": 0.0,
            "checkpoint_count": 0,
        }
        for seed in LEARNER_SEEDS
    ]
    serializable = [{key: value for key, value in row.items() if key != "model_payload"} for row in results]
    manifest = {
        "schema": f"{PILOT_SCHEMA}-training-manifest-v1",
        "artifact_label": LABEL,
        "concurrency": 16,
        "neutral_batches_hoisted": True,
        "pilot_aggregate_pair_limit": PILOT_AGGREGATE_PAIR_LIMIT,
        "aggregate_batch_rows": {
            "C1": int(_TRAIN_Q1.target_deltas.size),
            "C2": int(_TRAIN_Q2.target_deltas.size),
            "C3": int(_TRAIN_C3.target_psi.size),
        },
        "phase_wall_s": time.perf_counter() - phase_started,
        "phase_core_s": sum(float(row["core_s"]) for row in results),
        "learner_seed_domains": list(LEARNER_DOMAINS),
        "lineages": sorted(serializable + baseline, key=lambda row: (row["learner_seed"], row["arm"])),
    }
    _write_phase_manifest(output / f"{LABEL}-training-manifest.json", manifest)
    models = {(row["learner_seed"], row["arm"]): row["model_payload"] for row in results}
    return models, manifest, (_TRAIN_Q1, _TRAIN_Q2, _TRAIN_C3, _TRAIN_NEUTRAL)


def _load_completed_training(output: Path):
    row_manifest = json.loads(
        (output / f"{LABEL}-rows-manifest.json").read_text(encoding="ascii")
    )
    training_manifest = json.loads(
        (output / f"{LABEL}-training-manifest.json").read_text(encoding="ascii")
    )
    calibration_payload = json.loads(
        (output / f"{LABEL}-calibration.json").read_text(encoding="ascii")
    )
    ratio = lambda name: Fraction(*calibration_payload[name])
    calibration = PilotCalibration(
        eta_ref=ratio("eta_ref"),
        lambda_bits_per_j=ratio("lambda_bits_per_j"),
        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
        bits_ref=ratio("bits_ref"), joules_ref=ratio("joules_ref"),
        users=int(calibration_payload["users"]),
    )
    source_shards = [
        read_source_shard(path)
        for path in sorted((output / "rows").glob(f"{ROW_WORLD_GLOB}/*source-anchor-*.jsonl"))[:ROW_ANCHOR_LIMIT]
    ]
    coalition_shards = [
        read_coalition_shard(path)
        for path in sorted((output / "rows").glob(f"{ROW_WORLD_GLOB}/*coalition-anchor-*.jsonl"))[:ROW_ANCHOR_LIMIT]
    ]
    q_batches = {
        route: _aggregate_pair_batch(batch)
        for route, batch in build_pairwise_batches(source_shards).items()
    }
    batches = (
        q_batches["C1"], q_batches["C2"],
        CoalitionBatch.create(coalition_shards), default_synthetic_neutral_sources(),
    )
    model_payloads = {}
    for seed in LEARNER_SEEDS:
        for arm in PILOT_ARMS:
            checkpoint = output / "checkpoints" / (
                f"{LABEL}-seed-{seed}-{arm}-epoch-{EVAL_EPOCH:04d}.json"
            )
            payload = json.loads(checkpoint.read_text(encoding="ascii"))
            model_payloads[(seed, arm)] = payload["model"]
    return row_manifest, training_manifest, calibration, model_payloads, batches


def _restore_models(payloads, batches):
    q1, q2, c3, neutral = batches
    restored = {}
    for (seed, arm), payload in payloads.items():
        orchestrator = V1LineageOrchestrator(
            learner_seed=seed,
            q1_batch=q1,
            q2_batch=q2,
            c3_batch=c3,
            neutral_sources=neutral,
        )
        model = orchestrator.models[arm]
        V1LineageOrchestrator._restore_adam_head(model.q1, payload["C1"])
        V1LineageOrchestrator._restore_adam_head(model.q2, payload["C2"])
        V1LineageOrchestrator._restore_adam_head(model.psi.network, payload["C3"])
        restored[(seed, arm)] = model
    return restored


def _repair_profile(base, proposed, evaluator):
    if proposed.configuration_id not in evaluator._invalid:
        evaluator.evaluate_many((proposed,))
    if proposed.configuration_id not in evaluator._invalid:
        return proposed, 0
    mapping = proposed.mapping
    repairs = 0
    for user in sorted(mapping):
        if mapping[user] == base.mapping[user]:
            continue
        mapping[user] = base.mapping[user]
        repairs += 1
        candidate = ENGINE._configuration(base, mapping, kind="pilot-deterministic-repair")
        evaluator.evaluate_many((candidate,))
        if candidate.configuration_id not in evaluator._invalid:
            return candidate, repairs
    return base, repairs


def _additive_scores(model, rows_by_user_action, base, config):
    total = 0.0
    for user in sorted(base.mapping):
        reference = rows_by_user_action[(user, base.mapping[user])]
        selected = rows_by_user_action[(user, config.mapping[user])]
        total += (
            model.q1.score(selected.q1_state) - model.q1.score(reference.q1_state)
            + model.q2.score(selected.q2_state) - model.q2.score(reference.q2_state)
        )
    return total


def _exact_interactions(anchor, incumbent, catalogue, evaluator, calibration):
    evaluator.evaluate_many(catalogue)
    base_profile = evaluator.evaluate(anchor)
    base_core = (
        Fraction(str(base_profile.bits))
        - calibration.eta_ref * Fraction(str(base_profile.joules))
        + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, anchor)
    )
    singleton_by_key = {}
    for config in catalogue:
        for user in anchor.mapping:
            if config.mapping[user] == anchor.mapping[user]:
                continue
            mapping = anchor.mapping
            mapping[user] = config.mapping[user]
            singleton_by_key[(config.configuration_id, user)] = ENGINE._configuration(
                anchor, mapping, kind="pilot-exact-singleton"
            )
    evaluator.evaluate_many(tuple({
        row.assignments: row for row in singleton_by_key.values()
    }.values()))
    values = {}
    for config in catalogue:
        if config.configuration_id in evaluator._invalid:
            continue
        changed = tuple(user for user in anchor.mapping if config.mapping[user] != anchor.mapping[user])
        additive = Fraction()
        for user in changed:
            singleton = singleton_by_key[(config.configuration_id, user)]
            if singleton.configuration_id in evaluator._invalid:
                additive = Fraction(-10**30)
                break
            profile = evaluator.evaluate(singleton)
            additive += (
                Fraction(str(profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules))
                + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, singleton)
                - base_core
            )
        profile = evaluator.evaluate(config)
        joint = (
            Fraction(str(profile.bits))
            - calibration.eta_ref * Fraction(str(profile.joules))
            + calibration.kappa_bits_per_user_step * ENGINE._phi_for(incumbent, config)
            - base_core
        )
        values[config.configuration_id] = {
            "changed": changed,
            "joint": float(joint / calibration.kappa_bits_per_user_step),
            "additive": float(additive / calibration.kappa_bits_per_user_step),
            "psi": float((joint - additive) / calibration.kappa_bits_per_user_step),
        }
    return values


def _structural_interactions(anchor, catalogue):
    return {
        config.configuration_id: {
            "changed": tuple(
                user for user in anchor.mapping
                if config.mapping[user] != anchor.mapping[user]
            ),
            "joint": 0.0, "additive": 0.0, "psi": 0.0,
        }
        for config in catalogue
    }


def _build_u_catalogue(
    tape, step_index, a0, u, standard_catalogue, evaluator, calibration,
    rows_by_user_action,
):
    started = time.perf_counter()
    options, _ = ENGINE._legal_options(tape, step_index)
    evaluator.evaluate(u)
    candidates_by_user = {}
    for user in sorted(options):
        candidates = []
        for identity in options[user]:
            if identity == u.mapping[user]:
                continue
            mapping = u.mapping
            mapping[user] = identity
            config = ENGINE._configuration(a0, mapping, kind="pilot-u-unilateral")
            reference = rows_by_user_action[(user, u.mapping[user])]
            selected = rows_by_user_action[(user, identity)]
            score = (
                float.fromhex(selected.c1_label_normalized_hex)
                + float.fromhex(selected.c2_label_normalized_hex)
                - float.fromhex(reference.c1_label_normalized_hex)
                - float.fromhex(reference.c2_label_normalized_hex)
            )
            candidates.append((Fraction(str(score)), config))
        candidates_by_user[user] = candidates
    moves = {}
    for user in sorted(options):
        moves[user] = sorted(
            candidates_by_user[user],
            key=lambda row: (-row[0], row[1].configuration_id),
        )
    ranked = sorted(
        (user for user in moves if moves[user]),
        key=lambda user: (-abs(float(moves[user][0][0])), user),
    )[:10]
    rows = [a0, u]
    rows.extend(row for row in standard_catalogue if row.changed_users == 1)
    rows.extend(
        row for row in standard_catalogue if row.kind in {"s0-top-two", "beam-evacuation"}
    )
    for first, second in itertools.combinations(ranked, 2):
        mapping = u.mapping
        mapping[first] = moves[first][0][1].mapping[first]
        mapping[second] = moves[second][0][1].mapping[second]
        rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-pairwise-top10"))
    for beam in sorted({identity for identity in u.mapping.values() if identity is not None}):
        mapping = u.mapping
        changed = False
        for user in sorted(mapping):
            if mapping[user] == beam and moves.get(user):
                mapping[user] = moves[user][0][1].mapping[user]
                changed = True
        if changed:
            rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-beam-evacuation"))
    unique = {row.assignments: row for row in rows}
    ordered = tuple(sorted(unique.values(), key=lambda row: row.configuration_id))
    if len(ordered) > ENGINE.CATALOGUE_CAP:
        ordered = ordered[: ENGINE.CATALOGUE_CAP]
    return ordered, ranked, time.perf_counter() - started


def _exact_s0_boundary0(base, catalogue, evaluator, rows_by_user_action):
    """Primitive proposal ranking plus exact nominal bounded-set S0."""

    unilateral = [row for row in catalogue if row.changed_users == 1]
    top_ids = []
    for user in sorted(base.mapping):
        proposals = [
            row for row in unilateral
            if row.mapping[user] != base.mapping[user]
        ]
        ranked = sorted(
            proposals,
            key=lambda row: (
                -(
                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
                ),
                row.configuration_id,
            ),
        )[: ENGINE.TOP_PROPOSALS]
        top_ids.extend(row.configuration_id for row in ranked)
    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
    allowed.extend(
        row for row in catalogue
        if row.changed_users > 1
        and all(
            any(
                proposal.mapping[user] == identity
                for proposal in unilateral
                if proposal.configuration_id in top_ids
            )
            for user, identity in row.assignments
            if identity != base.mapping[user]
        )
    )
    evaluator.evaluate_many(tuple(allowed))
    allowed = [
        row for row in allowed if row.configuration_id not in evaluator._invalid
    ]
    return min(
        allowed,
        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
    )


def _select_for_anchor(
    anchor_name, anchor, catalogue, exact, models, rows_by_user_action,
    tape, step_index, exact_s0,
):
    selections = {}
    diagnostics = {}
    legal_catalogue = [row for row in catalogue if row.configuration_id in exact]
    contexts = {}
    for config in legal_catalogue:
        if len(exact[config.configuration_id]["changed"]) >= 2:
            contexts[config.configuration_id] = _coalition_context(
                tape=tape, step_index=step_index, anchor=anchor,
                selected=config, rows_by_user_action=rows_by_user_action,
            )
    for seed in LEARNER_SEEDS:
        exact_scores = []
        additive_scores = []
        learned_scores_by_arm = {arm: [] for arm in PILOT_ARMS}
        deltas_by_arm = {}
        c2_tie_pairs = 0
        c2_eligible_pairs = 0
        for arm in PILOT_ARMS:
            model = models[(seed, arm)]
            deltas = {}
            for (user, action), row in rows_by_user_action.items():
                reference = rows_by_user_action[(user, anchor.mapping[user])]
                q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
                deltas[(user, action)] = (
                    model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
                    + q2_delta
                )
                if arm == "FULL" and action != anchor.mapping[user]:
                    c2_eligible_pairs += 1
                    c2_tie_pairs += int(q2_delta == 0.0)
            deltas_by_arm[arm] = deltas
        c2_tie_fraction = (
            c2_tie_pairs / c2_eligible_pairs if c2_eligible_pairs else None
        )
        for config in legal_catalogue:
            context = contexts.get(config.configuration_id)
            full_additive = math.fsum(
                deltas_by_arm["FULL"][(user, config.mapping[user])]
                for user in anchor.mapping
            )
            exact_scores.append((full_additive + exact[config.configuration_id]["psi"], config.configuration_id, config))
            additive_scores.append((full_additive, config.configuration_id, config))
            for arm in PILOT_ARMS:
                model = models[(seed, arm)]
                score = math.fsum(
                    deltas_by_arm[arm][(user, config.mapping[user])]
                    for user in anchor.mapping
                )
                if context is not None:
                    score += model.interaction(context)
                learned_scores_by_arm[arm].append((score, config.configuration_id, config))
        exact_choice = min(exact_scores, key=lambda row: (-row[0], row[1]))[2]
        additive_choice = min(additive_scores, key=lambda row: (-row[0], row[1]))[2]
        selections[(seed, "S0")] = exact_s0
        for arm in PILOT_ARMS:
            selections[(seed, arm)] = min(
                learned_scores_by_arm[arm], key=lambda row: (-row[0], row[1])
            )[2]
        diagnostics[seed] = {
            "top_choice_agreement": selections[(seed, "FULL")].assignments == exact_choice.assignments,
            "additive_choice": additive_choice,
            "exact_choice": exact_choice,
            "anchor": anchor_name,
            # Minimal-pilot C2 tie statistic: over the FULL arm, the fraction of
            # non-incumbent (user, action) candidates whose C2 head score is
            # exactly equal to the incumbent's, i.e. C2 cannot discriminate the
            # move at all and the ranking falls through to C1 + the tie-break.
            "c2_tie": c2_tie_fraction,
            "c2_tie_pairs": c2_tie_pairs,
            "c2_eligible_pairs": c2_eligible_pairs,
        }
    return selections, diagnostics


