+#!/usr/bin/env python3
+"""Run the repaired-feature C3 retraining measurement (PILOT_NOT_CLAIM).
+
+The script deliberately keeps the frozen pilot policy constants unchanged.  It
+varies only two audited axes: exact versus inherited proxy C1/C2 source rows,
+and the 180-row pair-only versus rebuilt mechanism C3 corpus.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import multiprocessing as mp
+from pathlib import Path
+import sys
+import time
+from typing import Mapping
+
+import numpy as np
+
+from mcrl.stagec_v025.canonical import canonical_sha256
+from mcrl.stagec_v025.coalitions import (
+    CoalitionShard,
+    read_coalition_shard,
+    write_coalition_shard,
+)
+from mcrl.stagec_v025.learner import (
+    CoalitionBatch,
+    SOURCE_MAP,
+    V1LineageOrchestrator,
+    build_pairwise_batches,
+    default_synthetic_neutral_sources,
+)
+from mcrl.stagec_v025.shards import read_source_shard, write_source_shard
+
+
+LABEL = "PILOT_NOT_CLAIM"
+ROOT = Path(__file__).resolve().parents[2]
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+REBUILT = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
+    / f"{LABEL}-calibration.json"
+)
+DEFAULT_OUTPUT = ROOT / "artifacts/v025-retrain-measurement-20260909-PILOT_NOT_CLAIM"
+REPORT_PATH = ROOT / "RETRAIN-RESULT-2026-09-09.md"
+
+TARGET_MODES = ("exact", "proxy")
+CORPORA = ("rebuilt", "old-180")
+EPOCHS = (200, 1000, 2000)
+ARMS = ("FULL", "DROP_C3")
+REPORTED_ARMS = (*ARMS, "BASELINE", "S0", "S_UNI")
+TRAIN_ANCHORS = 5
+EVAL_ANCHORS = 5
+TAPE_STEPS = 8
+MAX_WORKERS = 4
+
+
+def load_pilot():
+    spec = importlib.util.spec_from_file_location("v025_retrain_pilot", PILOT_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PILOT_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    module.EVALUATION_WORLDS = module.DEVELOPMENT_WORLD_DOMAINS[2:3]
+    module.LEARNER_DOMAINS = module.LEARNER_DOMAINS[:2]
+    module.LEARNER_SEEDS = module.LEARNER_SEEDS[:2]
+    module.PILOT_ARMS = ARMS
+    module.REPORTED_ARMS = REPORTED_ARMS
+    module.EVAL_ANCHOR_STEPS = EVAL_ANCHORS
+    module.EVAL_CARRIER_LIMIT = 1
+    module.EVAL_TAPE_STEPS = TAPE_STEPS
+    return module
+
+
+def load_calibration(pilot):
+    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
+    ratio = lambda name: Fraction(*payload[name])
+    return pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def write_json(path: Path, payload: object) -> str:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    encoded = (json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n").encode("ascii")
+    with path.open("xb") as stream:
+        stream.write(encoded)
+    digest = hashlib.sha256(encoded).hexdigest()
+    path.with_name(path.name + ".sha256").write_text(
+        f"{digest}  {path.name}\n", encoding="ascii"
+    )
+    return digest
+
+
+def write_jsonl(path: Path, rows: list[dict]) -> str:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", encoding="ascii") as stream:
+        for row in rows:
+            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n")
+    digest = sha256(path)
+    path.with_name(path.name + ".sha256").write_text(
+        f"{digest}  {path.name}\n", encoding="ascii"
+    )
+    return digest
+
+
+def verify_rebuilt_input() -> dict:
+    verified = {}
+    for path in sorted(REBUILT.glob("*.sha256")):
+        target_name = path.read_text(encoding="ascii").split()[1]
+        target = path.parent / target_name
+        expected = path.read_text(encoding="ascii").split()[0]
+        actual = sha256(target)
+        if actual != expected:
+            raise RuntimeError(f"rebuilt input digest mismatch: {target}")
+        verified[str(target.relative_to(ROOT))] = actual
+    for path in sorted((REBUILT / "rows").glob("world-*/*.jsonl")):
+        sidecar = path.with_name(path.name + ".sha256")
+        expected = sidecar.read_text(encoding="ascii").split()[0]
+        actual = sha256(path)
+        if actual != expected:
+            raise RuntimeError(f"rebuilt shard digest mismatch: {path}")
+    return verified
+
+
+def load_corpora(output: Path):
+    paths = sorted((REBUILT / "rows").glob("world-*/*.jsonl"))
+    rebuilt_shards = [read_coalition_shard(path) for path in paths]
+    wanted = set()
+    index_path = REBUILT / f"{LABEL}-family-index.jsonl"
+    with index_path.open(encoding="ascii") as stream:
+        next(stream)
+        for line in stream:
+            payload = json.loads(line)
+            if "pair-catalogue" in payload["families"]:
+                wanted.add(payload["coalition_row_sha256"])
+    old_rows = []
+    for shard in rebuilt_shards:
+        for row in shard.rows:
+            digest = canonical_sha256(row.payload())
+            if digest in wanted:
+                old_rows.append(row)
+    if len(wanted) != 180 or len(old_rows) != 180:
+        raise RuntimeError(
+            f"old corpus extraction drifted: wanted={len(wanted)}, found={len(old_rows)}"
+        )
+    if Counter(len(row.context.members) for row in old_rows) != {2: 180}:
+        raise RuntimeError("old comparator corpus is not exactly 180 size-two rows")
+    old_path = output / "training-inputs" / f"{LABEL}-old-180-repaired-v2.jsonl"
+    old_shard = write_coalition_shard(old_path, tuple(old_rows))
+    return {
+        "rebuilt": CoalitionBatch.create(rebuilt_shards),
+        "old-180": CoalitionBatch.create((old_shard,)),
+    }, {
+        "rebuilt_shards": len(rebuilt_shards),
+        "rebuilt_rows": sum(len(shard.rows) for shard in rebuilt_shards),
+        "old_rows": len(old_rows),
+        "old_size_histogram": dict(sorted(Counter(len(row.context.members) for row in old_rows).items())),
+        "old_subset_sha256": old_shard.file_sha256,
+    }
+
+
+def generate_action_sources(pilot, output: Path, calibration):
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    tape_started = time.perf_counter()
+    tape = pilot.build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=pilot.LegacyWorldProvider(role="retrain-source-exact-and-proxy"),
+        steps=TAPE_STEPS,
+        start_time_s=0.0,
+    )
+    tape_wall = time.perf_counter() - tape_started
+    shards = {mode: [] for mode in TARGET_MODES}
+    timings = {mode: [] for mode in TARGET_MODES}
+    for anchor_index in range(TRAIN_ANCHORS):
+        for mode in TARGET_MODES:
+            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = mode == "proxy"
+            started = time.perf_counter()
+            built = pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=calibration,
+                step_index=anchor_index,
+                carrier="nearest-eligible",
+                anchor_index=anchor_index,
+                include_coalition=False,
+                full_legal_actions=False,
+            )
+            wall = time.perf_counter() - started
+            path = (
+                output
+                / "training-inputs"
+                / mode
+                / f"{LABEL}-source-anchor-{anchor_index:03d}.jsonl"
+            )
+            shard = write_source_shard(path, built["rows"])
+            shards[mode].append(shard)
+            nonreference = sum(not row.reference_action for row in built["rows"])
+            timings[mode].append(
+                {
+                    "anchor_index": anchor_index,
+                    "wall_s": wall,
+                    "rows": len(built["rows"]),
+                    "nonreference_action_targets": nonreference,
+                    "scalar_c1_c2_labels": 2 * nonreference,
+                    "physics_boundary_evaluations": built["physics_calls"],
+                    "shard_sha256": shard.file_sha256,
+                }
+            )
+            print(json.dumps({
+                "event": "training_source_anchor_done",
+                "mode": mode,
+                "anchor": anchor_index + 1,
+                "anchors_total": TRAIN_ANCHORS,
+                "wall_s": wall,
+            }), flush=True)
+    batches = {}
+    for mode in TARGET_MODES:
+        built = build_pairwise_batches(shards[mode])
+        batches[mode] = {
+            route: pilot._aggregate_pair_batch(batch)
+            for route, batch in built.items()
+            if route in {"C1", "C2"}
+        }
+    exact_wall = math.fsum(row["wall_s"] for row in timings["exact"])
+    exact_pairs = sum(row["nonreference_action_targets"] for row in timings["exact"])
+    exact_scalars = 2 * exact_pairs
+    metrics = {
+        "training_tape_wall_s": tape_wall,
+        "training_anchors": TRAIN_ANCHORS,
+        "tape_steps": TAPE_STEPS,
+        "timings": timings,
+        "exact_total_wall_s": exact_wall,
+        "exact_action_target_pairs": exact_pairs,
+        "exact_scalar_c1_c2_labels": exact_scalars,
+        "exact_wall_s_per_paired_c1_c2_action_target": exact_wall / exact_pairs,
+        "exact_wall_s_per_scalar_c1_or_c2_label": exact_wall / exact_scalars,
+        "aggregate_batch_rows": {
+            mode: {
+                route: int(batch.target_deltas.size)
+                for route, batch in batches[mode].items()
+            }
+            for mode in TARGET_MODES
+        },
+    }
+    return batches, metrics
+
+
+_TRAIN_ACTION_BATCHES = None
+_TRAIN_C3_BATCHES = None
+_TRAIN_OUTPUT = None
+_TRAIN_SEEDS = None
+
+
+def _train_condition(task):
+    target_mode, corpus, seed = task
+    q = _TRAIN_ACTION_BATCHES[target_mode]
+    c3 = _TRAIN_C3_BATCHES[corpus]
+    neutral = default_synthetic_neutral_sources()
+    orchestrator = V1LineageOrchestrator(
+        learner_seed=seed,
+        q1_batch=q["C1"],
+        q2_batch=q["C2"],
+        c3_batch=c3,
+        neutral_sources=neutral,
+    )
+    started = time.perf_counter()
+    checkpoints = {}
+    losses = {}
+    for epoch in range(1, max(EPOCHS) + 1):
+        for arm in ARMS:
+            model = orchestrator.models[arm]
+            losses[arm] = {
+                "C1": model.q1.update(q["C1"]),
+                "C2": model.q2.update(q["C2"]),
+                "C3": model.psi.update(
+                    c3 if SOURCE_MAP[arm]["C3"] == "informed" else orchestrator._neutral_c3
+                ),
+            }
+        if epoch in EPOCHS:
+            payload = {
+                "artifact_label": LABEL,
+                "schema": "mcrl-v025-retrain-condition-checkpoint-v1",
+                "target_mode": target_mode,
+                "corpus": corpus,
+                "learner_seed": seed,
+                "epoch": epoch,
+                "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in ARMS},
+                "batch_digests": {"C1": q["C1"].digest, "C2": q["C2"].digest, "C3": c3.digest},
+                "initialization_sha256": orchestrator.initialization_sha256,
+                "models": {arm: orchestrator.models[arm].payload() for arm in ARMS},
+                "losses": losses,
+            }
+            path = Path(_TRAIN_OUTPUT) / "checkpoints" / (
+                f"{LABEL}-{target_mode}-{corpus}-seed-{seed}-epoch-{epoch:04d}.json"
+            )
+            checkpoints[str(epoch)] = {"path": str(path), "sha256": write_json(path, payload)}
+    return {
+        "target_mode": target_mode,
+        "corpus": corpus,
+        "learner_seed": seed,
+        "wall_s": time.perf_counter() - started,
+        "checkpoints": checkpoints,
+        "final_losses": losses,
+    }
+
+
+def train_conditions(pilot, output: Path, action_batches, c3_batches):
+    global _TRAIN_ACTION_BATCHES, _TRAIN_C3_BATCHES, _TRAIN_OUTPUT, _TRAIN_SEEDS
+    _TRAIN_ACTION_BATCHES = action_batches
+    _TRAIN_C3_BATCHES = c3_batches
+    _TRAIN_OUTPUT = str(output)
+    _TRAIN_SEEDS = tuple(pilot.LEARNER_SEEDS)
+    tasks = [
+        (target_mode, corpus, seed)
+        for target_mode in TARGET_MODES
+        for corpus in CORPORA
+        for seed in pilot.LEARNER_SEEDS
+    ]
+    started = time.perf_counter()
+    results = []
+    with ProcessPoolExecutor(max_workers=MAX_WORKERS, mp_context=mp.get_context("fork")) as executor:
+        futures = {executor.submit(_train_condition, task): task for task in tasks}
+        for future in as_completed(futures):
+            result = future.result()
+            results.append(result)
+            print(json.dumps({
+                "event": "training_condition_done",
+                "target_mode": result["target_mode"],
+                "corpus": result["corpus"],
+                "learner_seed": result["learner_seed"],
+                "wall_s": result["wall_s"],
+                "completed": len(results),
+                "total": len(tasks),
+            }), flush=True)
+    return {
+        "max_processes": MAX_WORKERS,
+        "wall_s": time.perf_counter() - started,
+        "conditions": sorted(results, key=lambda row: (row["target_mode"], row["corpus"], row["learner_seed"])),
+    }
+
+
+def restore_models(pilot, output: Path, action_batches, c3_batches):
+    restored = {}
+    checkpoint_digests = {}
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            q = action_batches[target_mode]
+            c3 = c3_batches[corpus]
+            batches = (q["C1"], q["C2"], c3, default_synthetic_neutral_sources())
+            for epoch in EPOCHS:
+                payloads = {}
+                for seed in pilot.LEARNER_SEEDS:
+                    path = output / "checkpoints" / (
+                        f"{LABEL}-{target_mode}-{corpus}-seed-{seed}-epoch-{epoch:04d}.json"
+                    )
+                    sidecar = path.with_name(path.name + ".sha256")
+                    expected = sidecar.read_text(encoding="ascii").split()[0]
+                    actual = sha256(path)
+                    if expected != actual:
+                        raise RuntimeError(f"checkpoint digest mismatch: {path}")
+                    checkpoint_digests[str(path.relative_to(ROOT))] = actual
+                    payload = json.loads(path.read_text(encoding="ascii"))
+                    for arm in ARMS:
+                        payloads[(seed, arm)] = payload["models"][arm]
+                restored[(target_mode, corpus, epoch)] = pilot._restore_models(payloads, batches)
+    return restored, checkpoint_digests
+
+
+def _selected_exact_psi(pilot, anchor, incumbent, selected, evaluator, calibration):
+    unique = {config.assignments: config for config in selected}
+    joint = tuple(config for config in unique.values() if config.changed_users >= 2)
+    values = pilot._structural_interactions(anchor, tuple(unique.values()))
+    if joint:
+        values.update(pilot._exact_interactions(anchor, incumbent, joint, evaluator, calibration))
+    return values
+
+
+def evaluate(pilot, output: Path, calibration, models_by_condition):
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    domain = pilot.EVALUATION_WORLDS[0]
+    tape_started = time.perf_counter()
+    tape = pilot.build_world_tape(
+        domain=domain,
+        provider=pilot.LegacyWorldProvider(role="retrain-evaluation"),
+        steps=TAPE_STEPS,
+        start_time_s=0.0,
+    )
+    tape_wall = time.perf_counter() - tape_started
+    records = []
+    latencies = []
+    for anchor_index in range(EVAL_ANCHORS):
+        anchor_started = time.perf_counter()
+        built_by_mode = {}
+        for target_mode in TARGET_MODES:
+            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = target_mode == "proxy"
+            feature_started = time.perf_counter()
+            built_by_mode[target_mode] = pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=calibration,
+                step_index=anchor_index,
+                carrier="nearest-eligible",
+                anchor_index=anchor_index,
+                include_coalition=False,
+                full_legal_actions=True,
+            )
+            built_by_mode[target_mode]["feature_wall_s"] = time.perf_counter() - feature_started
+        exact_built = built_by_mode["exact"]
+        base = exact_built["base"]
+        incumbent = exact_built["incumbent"]
+        current = exact_built["current_evaluator"]
+        catalogue, _ = pilot.ENGINE._catalogue_with_census(
+            tape,
+            anchor_index,
+            base,
+            setting=setting,
+            calibration=calibration,
+            run_setting=run_setting,
+        )
+        structural = pilot._structural_interactions(base, catalogue)
+        s_uni, u_iterations, u_wall, u_missed, u_certificate = pilot.ENGINE._s_uni_select(
+            base=base,
+            incumbent=incumbent,
+            tape=tape,
+            step_index=anchor_index,
+            evaluator=current,
+            calibration=calibration,
+            compute_budget_s=5.0,
+            run_setting=run_setting,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, anchor_index),
+        )
+        selections = {}
+        diagnostics = {}
+        for target_mode in TARGET_MODES:
+            rows = built_by_mode[target_mode]["rows_by_user_action"]
+            mode_current = built_by_mode[target_mode]["current_evaluator"]
+            s0 = pilot._exact_s0_boundary0(base, catalogue, mode_current, rows)
+            for corpus in CORPORA:
+                for epoch in EPOCHS:
+                    key = (target_mode, corpus, epoch)
+                    chosen, diag = pilot._select_for_anchor(
+                        "P-a0",
+                        base,
+                        catalogue,
+                        structural,
+                        models_by_condition[key],
+                        rows,
+                        tape,
+                        anchor_index,
+                        s0,
+                    )
+                    for seed in pilot.LEARNER_SEEDS:
+                        chosen[(seed, "BASELINE")] = base
+                        chosen[(seed, "S0")] = s0
+                        chosen[(seed, "S_UNI")] = s_uni
+                    selections[key] = chosen
+                    diagnostics[key] = diag
+        learned_selected = [
+            chosen[(seed, arm)]
+            for chosen in selections.values()
+            for seed in pilot.LEARNER_SEEDS
+            for arm in ARMS
+        ]
+        exact_psi = _selected_exact_psi(
+            pilot, base, incumbent, learned_selected, current, calibration
+        )
+        realised = pilot.ENGINE.StepEvaluator(
+            tape,
+            setting,
+            anchor_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, anchor_index),
+            field="realised",
+            run_setting=run_setting,
+        )
+        all_selected = {
+            config.assignments: config
+            for chosen in selections.values()
+            for config in chosen.values()
+        }
+        realised.evaluate_many(tuple(all_selected.values()))
+        for key, chosen in selections.items():
+            target_mode, corpus, epoch = key
+            rows = built_by_mode[target_mode]["rows_by_user_action"]
+            models = models_by_condition[key]
+            for seed in pilot.LEARNER_SEEDS:
+                for arm in REPORTED_ARMS:
+                    config = chosen[(seed, arm)]
+                    profile = realised.evaluate(config)
+                    outcome = profile.outcome()
+                    row = {
+                        "artifact_label": LABEL,
+                        "target_mode": target_mode,
+                        "corpus": corpus,
+                        "epoch": epoch,
+                        "world_id": domain,
+                        "world_seed": tape.seed,
+                        "anchor_index": anchor_index,
+                        "step_index": anchor_index,
+                        "carrier": "nearest-eligible",
+                        "learner_seed": seed,
+                        "arm": arm,
+                        "configuration_id": config.configuration_id,
+                        "changed_users": config.changed_users,
+                        "bits": profile.bits,
+                        "joules": profile.joules,
+                        "availability": float(outcome.useful_availability),
+                    }
+                    if arm in ARMS:
+                        context = None
+                        if config.changed_users >= 2:
+                            context = pilot._coalition_context(
+                                tape=tape,
+                                step_index=anchor_index,
+                                anchor=base,
+                                selected=config,
+                                rows_by_user_action=rows,
+                            )
+                        row["predicted_psi_normalized"] = (
+                            0.0 if context is None else models[(seed, arm)].interaction(context)
+                        )
+                        row["exact_psi_normalized"] = exact_psi[config.configuration_id]["psi"]
+                        row["exact_joint_delta_normalized"] = exact_psi[config.configuration_id]["joint"]
+                        row["top_choice_agreement"] = diagnostics[key][seed]["top_choice_agreement"]
+                    records.append(row)
+        latencies.append({
+            "anchor_index": anchor_index,
+            "wall_s": time.perf_counter() - anchor_started,
+            "exact_feature_wall_s": exact_built["feature_wall_s"],
+            "proxy_feature_wall_s": built_by_mode["proxy"]["feature_wall_s"],
+            "exact_source_physics_evaluations": exact_built["physics_calls"],
+            "proxy_source_physics_evaluations": built_by_mode["proxy"]["physics_calls"],
+            "nominal_physics_evaluations": current.physical_evaluations,
+            "realised_physics_evaluations": realised.physical_evaluations,
+            "s_uni_iterations": u_iterations,
+            "s_uni_wall_s": u_wall,
+            "s_uni_deadline_missed": u_missed,
+            "s_uni_termination_certificate": u_certificate,
+        })
+        print(json.dumps({
+            "event": "evaluation_anchor_done",
+            "anchor": anchor_index + 1,
+            "anchors_total": EVAL_ANCHORS,
+            "wall_s": latencies[-1]["wall_s"],
+        }), flush=True)
+    receipt_path = output / "evaluation" / f"{LABEL}-raw-receipts.jsonl"
+    receipt_digest = write_jsonl(receipt_path, records)
+    return records, {
+        "evaluation_tape_wall_s": tape_wall,
+        "latencies": latencies,
+        "receipt_rows": len(records),
+        "receipt_sha256": receipt_digest,
+        "receipt_path": str(receipt_path.relative_to(ROOT)),
+    }
+
+
+def summarize(records: list[dict]) -> dict:
+    result = {"conditions": {}}
+    for target_mode in TARGET_MODES:
+        result["conditions"][target_mode] = {}
+        for corpus in CORPORA:
+            result["conditions"][target_mode][corpus] = {}
+            for epoch in EPOCHS:
+                subset = [
+                    row for row in records
+                    if row["target_mode"] == target_mode
+                    and row["corpus"] == corpus
+                    and row["epoch"] == epoch
+                ]
+                arms = {}
+                for arm in REPORTED_ARMS:
+                    rows = [row for row in subset if row["arm"] == arm]
+                    bits = math.fsum(row["bits"] for row in rows)
+                    joules = math.fsum(row["joules"] for row in rows)
+                    arms[arm] = {
+                        "count": len(rows),
+                        "bits": bits,
+                        "joules": joules,
+                        "pooled_ee_bits_per_j": bits / joules,
+                        "availability": math.fsum(row["availability"] for row in rows) / len(rows),
+                    }
+                full = arms["FULL"]
+                drop = arms["DROP_C3"]
+                full_rows = [row for row in subset if row["arm"] == "FULL"]
+                psi_error = [
+                    row["predicted_psi_normalized"] - row["exact_psi_normalized"]
+                    for row in full_rows
+                ]
+                result["conditions"][target_mode][corpus][str(epoch)] = {
+                    "arms": arms,
+                    "full_minus_drop_c3_relative": full["pooled_ee_bits_per_j"] / drop["pooled_ee_bits_per_j"] - 1.0,
+                    "availability_gap_full_minus_drop_c3": full["availability"] - drop["availability"],
+                    "availability_held": full["availability"] >= drop["availability"],
+                    "full_selected_coalition_size_histogram": dict(sorted(Counter(row["changed_users"] for row in full_rows).items())),
+                    "full_predicted_vs_exact_psi": {
+                        "count": len(full_rows),
+                        "predicted_mean": math.fsum(row["predicted_psi_normalized"] for row in full_rows) / len(full_rows),
+                        "exact_mean": math.fsum(row["exact_psi_normalized"] for row in full_rows) / len(full_rows),
+                        "mae": math.fsum(abs(value) for value in psi_error) / len(psi_error),
+                        "rmse": math.sqrt(math.fsum(value * value for value in psi_error) / len(psi_error)),
+                        "sign_agreement": sum(
+                            np.sign(row["predicted_psi_normalized"]) == np.sign(row["exact_psi_normalized"])
+                            for row in full_rows
+                        ) / len(full_rows),
+                        "predicted_min": min(row["predicted_psi_normalized"] for row in full_rows),
+                        "predicted_max": max(row["predicted_psi_normalized"] for row in full_rows),
+                        "exact_min": min(row["exact_psi_normalized"] for row in full_rows),
+                        "exact_max": max(row["exact_psi_normalized"] for row in full_rows),
+                    },
+                }
+    return result
+
+
+def pct(value: float) -> str:
+    return f"{100.0 * value:+.3f}%"
+
+
+def write_report(summary: dict, source_metrics: dict, corpus_metrics: dict, run_manifest: dict):
+    primary = summary["conditions"]["exact"]["rebuilt"]["2000"]
+    full = primary["arms"]["FULL"]
+    drop = primary["arms"]["DROP_C3"]
+    availability_word = "HELD" if primary["availability_held"] else "DID NOT HOLD"
+    lines = [
+        f"**Epoch 2000, exact targets + rebuilt corpus: FULL minus DROP_C3 = {pct(primary['full_minus_drop_c3_relative'])}; availability {availability_word} (FULL {full['availability']:.6%}, DROP_C3 {drop['availability']:.6%}).**",
+        "",
+        "# First repaired-feature C3 retraining measurement",
+        "",
+        f"**{LABEL}.** This is a minimal engineering pilot: one evaluation world, five anchors, nearest-eligible carrier, and two fixed learner seeds. It is not claim evidence.",
+        "",
+    ]
+    if primary["full_minus_drop_c3_relative"] <= 0:
+        lines.append("The contracted exact-target result is negative or flat: the rebuilt C3 head does not improve pooled energy efficiency over DROP_C3 at epoch 2000.")
+    elif not primary["availability_held"]:
+        lines.append("The contracted exact-target result is not reported as a gain because FULL serves fewer users than DROP_C3 at epoch 2000.")
+    else:
+        lines.append("The contracted exact-target result is positive in this minimal pilot and availability did not fall relative to DROP_C3; the scale is still too small for a general claim.")
+    lines.extend([
+        "",
+        "## Energy efficiency and availability",
+        "",
+        "Pooled EE is total realised bits divided by total realised joules across the 10 anchor-seed decisions. The relative contrast is `FULL / DROP_C3 - 1`.",
+        "",
+        "| Targets | C3 corpus | Epoch | Arm | Pooled EE (bit/J) | Availability | FULL−DROP_C3 | Availability held? |",
+        "|---|---|---:|---|---:|---:|---:|---|",
+    ])
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            for epoch in EPOCHS:
+                row = summary["conditions"][target_mode][corpus][str(epoch)]
+                for arm in REPORTED_ARMS:
+                    arm_row = row["arms"][arm]
+                    contrast = pct(row["full_minus_drop_c3_relative"]) if arm == "FULL" else "—"
+                    held = ("yes" if row["availability_held"] else "no") if arm == "FULL" else "—"
+                    lines.append(
+                        f"| {target_mode} | {corpus} | {epoch} | {arm} | {arm_row['pooled_ee_bits_per_j']:.9g} | {arm_row['availability']:.6%} | {contrast} | {held} |"
+                    )
+    lines.extend([
+        "",
+        "## Direct old-corpus versus rebuilt-corpus contrast",
+        "",
+        "The old comparator is exactly the 180 `pair-catalogue` action selections, all size two, reconstructed as v2 rows and evaluated with the same repaired encoder and canonical exact C3 labels. This isolates corpus coverage; it does not reuse the legacy call-order-dependent labels.",
+        "",
+        "| Targets | Epoch | Old-180 FULL−DROP_C3 | Rebuilt FULL−DROP_C3 | Old availability gap | Rebuilt availability gap |",
+        "|---|---:|---:|---:|---:|---:|",
+    ])
+    for target_mode in TARGET_MODES:
+        for epoch in EPOCHS:
+            old = summary["conditions"][target_mode]["old-180"][str(epoch)]
+            new = summary["conditions"][target_mode]["rebuilt"][str(epoch)]
+            lines.append(
+                f"| {target_mode} | {epoch} | {pct(old['full_minus_drop_c3_relative'])} | {pct(new['full_minus_drop_c3_relative'])} | {pct(old['availability_gap_full_minus_drop_c3'])} | {pct(new['availability_gap_full_minus_drop_c3'])} |"
+            )
+    lines.extend([
+        "",
+        "## FULL selected coalition sizes",
+        "",
+        "Counts are across five anchors × two learner seeds.",
+        "",
+        "| Targets | C3 corpus | Epoch | Size distribution |",
+        "|---|---|---:|---|",
+    ])
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            for epoch in EPOCHS:
+                hist = summary["conditions"][target_mode][corpus][str(epoch)]["full_selected_coalition_size_histogram"]
+                rendered = "; ".join(f"size {size}: {count}" for size, count in hist.items())
+                lines.append(f"| {target_mode} | {corpus} | {epoch} | {rendered} |")
+    lines.extend([
+        "",
+        "## FULL interaction prediction versus exact Psi",
+        "",
+        "All values are normalized by kappa and are computed at the coalitions actually selected by FULL. Exact Psi is recomputed from the anchor, exact singleton changes, and selected joint configuration; it is not copied from the training corpus.",
+        "",
+        "| Targets | C3 corpus | Epoch | Predicted mean | Exact mean | MAE | RMSE | Sign agreement | Predicted range | Exact range |",
+        "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+    ])
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            for epoch in EPOCHS:
+                psi = summary["conditions"][target_mode][corpus][str(epoch)]["full_predicted_vs_exact_psi"]
+                lines.append(
+                    f"| {target_mode} | {corpus} | {epoch} | {psi['predicted_mean']:.6g} | {psi['exact_mean']:.6g} | {psi['mae']:.6g} | {psi['rmse']:.6g} | {psi['sign_agreement']:.1%} | [{psi['predicted_min']:.6g}, {psi['predicted_max']:.6g}] | [{psi['exact_min']:.6g}, {psi['exact_max']:.6g}] |"
+                )
+    exact = source_metrics
+    lines.extend([
+        "",
+        "## Exact-target cost and scope",
+        "",
+        f"The full 180-anchor C1/C2 source rebuild was reduced to {exact['training_anchors']} matched training anchors for both exact and proxy modes. The exact path produced {exact['exact_action_target_pairs']} paired action targets ({exact['exact_scalar_c1_c2_labels']} scalar C1-or-C2 labels) in {exact['exact_total_wall_s']:.3f} wall seconds: {exact['exact_wall_s_per_paired_c1_c2_action_target']:.6f} s per paired C1/C2 action target, or {exact['exact_wall_s_per_scalar_c1_or_c2_label']:.6f} s per scalar label. This timing includes exact feature/outcome construction and the three frozen forecast offsets.",
+        "",
+        f"The rebuilt C3 corpus contained {corpus_metrics['rebuilt_rows']} rows in {corpus_metrics['rebuilt_shards']} shards. The repaired old comparator contained {corpus_metrics['old_rows']} rows with histogram {corpus_metrics['old_size_histogram']}.",
+        "",
+        "Evaluation retained the requested world 3, five anchors, nearest-eligible carrier, two learner seeds, FULL, DROP_C3, BASELINE, S0, and the iterated unilateral optimum. It used the same 8-step tape prefix (five anchors plus three forecast steps). Exact and proxy modes were both run; no threshold, sign, seed, horizon, price, service guard, acceptance rule, or optimizer literal was changed.",
+        "",
+        "Training used at most four worker processes and every launched Python process was run under `nice -n 10` with BLAS thread counts fixed to one.",
+        "",
+        "## Artifacts and limitations",
+        "",
+        f"Raw receipts: `{run_manifest['evaluation']['receipt_path']}` ({run_manifest['evaluation']['receipt_rows']} rows; SHA-256 `{run_manifest['evaluation']['receipt_sha256']}`).",
+        f"Run manifest: `artifacts/v025-retrain-measurement-20260909-PILOT_NOT_CLAIM/{LABEL}-manifest.json`.",
+        "",
+        "This is a 10-decision-per-condition pilot, so it has no useful claim-level power or uncertainty estimate. The exact/proxy comparison also changes the feature values produced by the inherited fallback, not only its scalar labels, because that flag bypasses the evaluator path that supplies both contracted outcomes and their derived state fields.",
+        "",
+        f"**{LABEL}.**",
+        "",
+    ])
+    REPORT_PATH.write_text("\n".join(lines), encoding="utf-8")
+    digest = sha256(REPORT_PATH)
+    REPORT_PATH.with_name(REPORT_PATH.name + ".sha256").write_text(
+        f"{digest}  {REPORT_PATH.name}\n", encoding="ascii"
+    )
+    return digest
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    args = parser.parse_args()
+    if args.output.exists():
+        raise SystemExit(f"refusing to overwrite {args.output}")
+    if REPORT_PATH.exists():
+        raise SystemExit(f"refusing to overwrite {REPORT_PATH}")
+    args.output.mkdir(parents=True)
+    total_started = time.perf_counter()
+    pilot = load_pilot()
+    calibration = load_calibration(pilot)
+    verified_inputs = verify_rebuilt_input()
+    c3_batches, corpus_metrics = load_corpora(args.output)
+    action_batches, source_metrics = generate_action_sources(
+        pilot, args.output, calibration
+    )
+    training = train_conditions(
+        pilot, args.output, action_batches, c3_batches
+    )
+    models, checkpoint_digests = restore_models(
+        pilot, args.output, action_batches, c3_batches
+    )
+    records, evaluation = evaluate(
+        pilot, args.output, calibration, models
+    )
+    summary = summarize(records)
+    manifest = {
+        "artifact_label": LABEL,
+        "schema": "mcrl-v025-retrain-measurement-v1",
+        "scope": {
+            "target_modes": TARGET_MODES,
+            "corpora": CORPORA,
+            "epochs": EPOCHS,
+            "training_anchors": TRAIN_ANCHORS,
+            "evaluation_worlds": pilot.EVALUATION_WORLDS,
+            "evaluation_anchors": EVAL_ANCHORS,
+            "tape_steps": TAPE_STEPS,
+            "carrier": "nearest-eligible",
+            "learner_seed_domains": pilot.LEARNER_DOMAINS,
+            "learner_seeds": pilot.LEARNER_SEEDS,
+            "arms": REPORTED_ARMS,
+            "max_processes": MAX_WORKERS,
+        },
+        "repaired_coalition_context_schema": "mcrl-v025-stagec-c3-coalition-context-v2",
+        "proxy_flag_inherited_value": True,
+        "exact_flag_value": False,
+        "verified_rebuilt_top_level_inputs": verified_inputs,
+        "corpus_metrics": corpus_metrics,
+        "source_metrics": source_metrics,
+        "training": training,
+        "checkpoint_sha256": checkpoint_digests,
+        "evaluation": evaluation,
+        "summary": summary,
+        "total_wall_s_before_manifest": time.perf_counter() - total_started,
+    }
+    manifest_path = args.output / f"{LABEL}-manifest.json"
+    manifest_digest = write_json(manifest_path, manifest)
+    manifest["manifest_sha256"] = manifest_digest
+    report_digest = write_report(
+        summary, source_metrics, corpus_metrics, manifest
+    )
+    print(json.dumps({
+        "event": "complete",
+        "manifest": str(manifest_path),
+        "manifest_sha256": manifest_digest,
+        "report": str(REPORT_PATH),
+        "report_sha256": report_digest,
+        "total_wall_s": time.perf_counter() - total_started,
+    }), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/.scratch/retrain/run_retrain_measurement.py b/.scratch/retrain/run_retrain_measurement.py
new file mode 100644
index 0000000000000000000000000000000000000000..50ac9f4d19c0db321e33bceb961117b2562f5b7f
--- /dev/null
+++ b/.scratch/retrain/run_retrain_measurement.py
@@ -0,0 +1,833 @@
+#!/usr/bin/env python3
+"""Run the repaired-feature C3 retraining measurement (PILOT_NOT_CLAIM).
+
+The script deliberately keeps the frozen pilot policy constants unchanged.  It
+varies only two audited axes: exact versus inherited proxy C1/C2 source rows,
+and the 180-row pair-only versus rebuilt mechanism C3 corpus.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+import multiprocessing as mp
+from pathlib import Path
+import sys
+import time
+from typing import Mapping
+
+import numpy as np
+
+from mcrl.stagec_v025.canonical import canonical_sha256
+from mcrl.stagec_v025.coalitions import (
+    CoalitionShard,
+    read_coalition_shard,
+    write_coalition_shard,
+)
+from mcrl.stagec_v025.learner import (
+    CoalitionBatch,
+    SOURCE_MAP,
+    V1LineageOrchestrator,
+    build_pairwise_batches,
+    default_synthetic_neutral_sources,
+)
+from mcrl.stagec_v025.shards import read_source_shard, write_source_shard
+
+
+LABEL = "PILOT_NOT_CLAIM"
+ROOT = Path(__file__).resolve().parents[2]
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+REBUILT = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
+    / f"{LABEL}-calibration.json"
+)
+DEFAULT_OUTPUT = ROOT / "artifacts/v025-retrain-measurement-20260909-PILOT_NOT_CLAIM"
+REPORT_PATH = ROOT / "RETRAIN-RESULT-2026-09-09.md"
+
+TARGET_MODES = ("exact", "proxy")
+CORPORA = ("rebuilt", "old-180")
+EPOCHS = (200, 1000, 2000)
+ARMS = ("FULL", "DROP_C3")
+REPORTED_ARMS = (*ARMS, "BASELINE", "S0", "S_UNI")
+TRAIN_ANCHORS = 5
+EVAL_ANCHORS = 5
+TAPE_STEPS = 8
+MAX_WORKERS = 4
+
+
+def load_pilot():
+    spec = importlib.util.spec_from_file_location("v025_retrain_pilot", PILOT_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {PILOT_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    module.EVALUATION_WORLDS = module.DEVELOPMENT_WORLD_DOMAINS[2:3]
+    module.LEARNER_DOMAINS = module.LEARNER_DOMAINS[:2]
+    module.LEARNER_SEEDS = module.LEARNER_SEEDS[:2]
+    module.PILOT_ARMS = ARMS
+    module.REPORTED_ARMS = REPORTED_ARMS
+    module.EVAL_ANCHOR_STEPS = EVAL_ANCHORS
+    module.EVAL_CARRIER_LIMIT = 1
+    module.EVAL_TAPE_STEPS = TAPE_STEPS
+    return module
+
+
+def load_calibration(pilot):
+    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
+    ratio = lambda name: Fraction(*payload[name])
+    return pilot.PilotCalibration(
+        eta_ref=ratio("eta_ref"),
+        lambda_bits_per_j=ratio("lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
+        bits_ref=ratio("bits_ref"),
+        joules_ref=ratio("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def write_json(path: Path, payload: object) -> str:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    encoded = (json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n").encode("ascii")
+    with path.open("xb") as stream:
+        stream.write(encoded)
+    digest = hashlib.sha256(encoded).hexdigest()
+    path.with_name(path.name + ".sha256").write_text(
+        f"{digest}  {path.name}\n", encoding="ascii"
+    )
+    return digest
+
+
+def write_jsonl(path: Path, rows: list[dict]) -> str:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("x", encoding="ascii") as stream:
+        for row in rows:
+            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n")
+    digest = sha256(path)
+    path.with_name(path.name + ".sha256").write_text(
+        f"{digest}  {path.name}\n", encoding="ascii"
+    )
+    return digest
+
+
+def verify_rebuilt_input() -> dict:
+    verified = {}
+    for path in sorted(REBUILT.glob("*.sha256")):
+        target_name = path.read_text(encoding="ascii").split()[1]
+        target = path.parent / target_name
+        expected = path.read_text(encoding="ascii").split()[0]
+        actual = sha256(target)
+        if actual != expected:
+            raise RuntimeError(f"rebuilt input digest mismatch: {target}")
+        verified[str(target.relative_to(ROOT))] = actual
+    for path in sorted((REBUILT / "rows").glob("world-*/*.jsonl")):
+        sidecar = path.with_name(path.name + ".sha256")
+        expected = sidecar.read_text(encoding="ascii").split()[0]
+        actual = sha256(path)
+        if actual != expected:
+            raise RuntimeError(f"rebuilt shard digest mismatch: {path}")
+    return verified
+
+
+def load_corpora(output: Path):
+    paths = sorted((REBUILT / "rows").glob("world-*/*.jsonl"))
+    rebuilt_shards = [read_coalition_shard(path) for path in paths]
+    wanted = set()
+    index_path = REBUILT / f"{LABEL}-family-index.jsonl"
+    with index_path.open(encoding="ascii") as stream:
+        next(stream)
+        for line in stream:
+            payload = json.loads(line)
+            if "pair-catalogue" in payload["families"]:
+                wanted.add(payload["coalition_row_sha256"])
+    old_rows = []
+    for shard in rebuilt_shards:
+        for row in shard.rows:
+            digest = canonical_sha256(row.payload())
+            if digest in wanted:
+                old_rows.append(row)
+    if len(wanted) != 180 or len(old_rows) != 180:
+        raise RuntimeError(
+            f"old corpus extraction drifted: wanted={len(wanted)}, found={len(old_rows)}"
+        )
+    if Counter(len(row.context.members) for row in old_rows) != {2: 180}:
+        raise RuntimeError("old comparator corpus is not exactly 180 size-two rows")
+    old_path = output / "training-inputs" / f"{LABEL}-old-180-repaired-v2.jsonl"
+    old_shard = write_coalition_shard(old_path, tuple(old_rows))
+    return {
+        "rebuilt": CoalitionBatch.create(rebuilt_shards),
+        "old-180": CoalitionBatch.create((old_shard,)),
+    }, {
+        "rebuilt_shards": len(rebuilt_shards),
+        "rebuilt_rows": sum(len(shard.rows) for shard in rebuilt_shards),
+        "old_rows": len(old_rows),
+        "old_size_histogram": dict(sorted(Counter(len(row.context.members) for row in old_rows).items())),
+        "old_subset_sha256": old_shard.file_sha256,
+    }
+
+
+def generate_action_sources(pilot, output: Path, calibration):
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    tape_started = time.perf_counter()
+    tape = pilot.build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=pilot.LegacyWorldProvider(role="retrain-source-exact-and-proxy"),
+        steps=TAPE_STEPS,
+        start_time_s=0.0,
+    )
+    tape_wall = time.perf_counter() - tape_started
+    shards = {mode: [] for mode in TARGET_MODES}
+    timings = {mode: [] for mode in TARGET_MODES}
+    for anchor_index in range(TRAIN_ANCHORS):
+        for mode in TARGET_MODES:
+            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = mode == "proxy"
+            started = time.perf_counter()
+            built = pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=calibration,
+                step_index=anchor_index,
+                carrier="nearest-eligible",
+                anchor_index=anchor_index,
+                include_coalition=False,
+                full_legal_actions=False,
+            )
+            wall = time.perf_counter() - started
+            path = (
+                output
+                / "training-inputs"
+                / mode
+                / f"{LABEL}-source-anchor-{anchor_index:03d}.jsonl"
+            )
+            shard = write_source_shard(path, built["rows"])
+            shards[mode].append(shard)
+            nonreference = sum(not row.reference_action for row in built["rows"])
+            timings[mode].append(
+                {
+                    "anchor_index": anchor_index,
+                    "wall_s": wall,
+                    "rows": len(built["rows"]),
+                    "nonreference_action_targets": nonreference,
+                    "scalar_c1_c2_labels": 2 * nonreference,
+                    "physics_boundary_evaluations": built["physics_calls"],
+                    "shard_sha256": shard.file_sha256,
+                }
+            )
+            print(json.dumps({
+                "event": "training_source_anchor_done",
+                "mode": mode,
+                "anchor": anchor_index + 1,
+                "anchors_total": TRAIN_ANCHORS,
+                "wall_s": wall,
+            }), flush=True)
+    batches = {}
+    for mode in TARGET_MODES:
+        built = build_pairwise_batches(shards[mode])
+        batches[mode] = {
+            route: pilot._aggregate_pair_batch(batch)
+            for route, batch in built.items()
+            if route in {"C1", "C2"}
+        }
+    exact_wall = math.fsum(row["wall_s"] for row in timings["exact"])
+    exact_pairs = sum(row["nonreference_action_targets"] for row in timings["exact"])
+    exact_scalars = 2 * exact_pairs
+    metrics = {
+        "training_tape_wall_s": tape_wall,
+        "training_anchors": TRAIN_ANCHORS,
+        "tape_steps": TAPE_STEPS,
+        "timings": timings,
+        "exact_total_wall_s": exact_wall,
+        "exact_action_target_pairs": exact_pairs,
+        "exact_scalar_c1_c2_labels": exact_scalars,
+        "exact_wall_s_per_paired_c1_c2_action_target": exact_wall / exact_pairs,
+        "exact_wall_s_per_scalar_c1_or_c2_label": exact_wall / exact_scalars,
+        "aggregate_batch_rows": {
+            mode: {
+                route: int(batch.target_deltas.size)
+                for route, batch in batches[mode].items()
+            }
+            for mode in TARGET_MODES
+        },
+    }
+    return batches, metrics
+
+
+_TRAIN_ACTION_BATCHES = None
+_TRAIN_C3_BATCHES = None
+_TRAIN_OUTPUT = None
+_TRAIN_SEEDS = None
+
+
+def _train_condition(task):
+    target_mode, corpus, seed = task
+    q = _TRAIN_ACTION_BATCHES[target_mode]
+    c3 = _TRAIN_C3_BATCHES[corpus]
+    neutral = default_synthetic_neutral_sources()
+    orchestrator = V1LineageOrchestrator(
+        learner_seed=seed,
+        q1_batch=q["C1"],
+        q2_batch=q["C2"],
+        c3_batch=c3,
+        neutral_sources=neutral,
+    )
+    started = time.perf_counter()
+    checkpoints = {}
+    losses = {}
+    for epoch in range(1, max(EPOCHS) + 1):
+        for arm in ARMS:
+            model = orchestrator.models[arm]
+            losses[arm] = {
+                "C1": model.q1.update(q["C1"]),
+                "C2": model.q2.update(q["C2"]),
+                "C3": model.psi.update(
+                    c3 if SOURCE_MAP[arm]["C3"] == "informed" else orchestrator._neutral_c3
+                ),
+            }
+        if epoch in EPOCHS:
+            payload = {
+                "artifact_label": LABEL,
+                "schema": "mcrl-v025-retrain-condition-checkpoint-v1",
+                "target_mode": target_mode,
+                "corpus": corpus,
+                "learner_seed": seed,
+                "epoch": epoch,
+                "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in ARMS},
+                "batch_digests": {"C1": q["C1"].digest, "C2": q["C2"].digest, "C3": c3.digest},
+                "initialization_sha256": orchestrator.initialization_sha256,
+                "models": {arm: orchestrator.models[arm].payload() for arm in ARMS},
+                "losses": losses,
+            }
+            path = Path(_TRAIN_OUTPUT) / "checkpoints" / (
+                f"{LABEL}-{target_mode}-{corpus}-seed-{seed}-epoch-{epoch:04d}.json"
+            )
+            checkpoints[str(epoch)] = {"path": str(path), "sha256": write_json(path, payload)}
+    return {
+        "target_mode": target_mode,
+        "corpus": corpus,
+        "learner_seed": seed,
+        "wall_s": time.perf_counter() - started,
+        "checkpoints": checkpoints,
+        "final_losses": losses,
+    }
+
+
+def train_conditions(pilot, output: Path, action_batches, c3_batches):
+    global _TRAIN_ACTION_BATCHES, _TRAIN_C3_BATCHES, _TRAIN_OUTPUT, _TRAIN_SEEDS
+    _TRAIN_ACTION_BATCHES = action_batches
+    _TRAIN_C3_BATCHES = c3_batches
+    _TRAIN_OUTPUT = str(output)
+    _TRAIN_SEEDS = tuple(pilot.LEARNER_SEEDS)
+    tasks = [
+        (target_mode, corpus, seed)
+        for target_mode in TARGET_MODES
+        for corpus in CORPORA
+        for seed in pilot.LEARNER_SEEDS
+    ]
+    started = time.perf_counter()
+    results = []
+    with ProcessPoolExecutor(max_workers=MAX_WORKERS, mp_context=mp.get_context("fork")) as executor:
+        futures = {executor.submit(_train_condition, task): task for task in tasks}
+        for future in as_completed(futures):
+            result = future.result()
+            results.append(result)
+            print(json.dumps({
+                "event": "training_condition_done",
+                "target_mode": result["target_mode"],
+                "corpus": result["corpus"],
+                "learner_seed": result["learner_seed"],
+                "wall_s": result["wall_s"],
+                "completed": len(results),
+                "total": len(tasks),
+            }), flush=True)
+    return {
+        "max_processes": MAX_WORKERS,
+        "wall_s": time.perf_counter() - started,
+        "conditions": sorted(results, key=lambda row: (row["target_mode"], row["corpus"], row["learner_seed"])),
+    }
+
+
+def restore_models(pilot, output: Path, action_batches, c3_batches):
+    restored = {}
+    checkpoint_digests = {}
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            q = action_batches[target_mode]
+            c3 = c3_batches[corpus]
+            batches = (q["C1"], q["C2"], c3, default_synthetic_neutral_sources())
+            for epoch in EPOCHS:
+                payloads = {}
+                for seed in pilot.LEARNER_SEEDS:
+                    path = output / "checkpoints" / (
+                        f"{LABEL}-{target_mode}-{corpus}-seed-{seed}-epoch-{epoch:04d}.json"
+                    )
+                    sidecar = path.with_name(path.name + ".sha256")
+                    expected = sidecar.read_text(encoding="ascii").split()[0]
+                    actual = sha256(path)
+                    if expected != actual:
+                        raise RuntimeError(f"checkpoint digest mismatch: {path}")
+                    checkpoint_digests[str(path.relative_to(ROOT))] = actual
+                    payload = json.loads(path.read_text(encoding="ascii"))
+                    for arm in ARMS:
+                        payloads[(seed, arm)] = payload["models"][arm]
+                restored[(target_mode, corpus, epoch)] = pilot._restore_models(payloads, batches)
+    return restored, checkpoint_digests
+
+
+def _selected_exact_psi(pilot, anchor, incumbent, selected, evaluator, calibration):
+    unique = {config.assignments: config for config in selected}
+    joint = tuple(config for config in unique.values() if config.changed_users >= 2)
+    values = pilot._structural_interactions(anchor, tuple(unique.values()))
+    if joint:
+        values.update(pilot._exact_interactions(anchor, incumbent, joint, evaluator, calibration))
+    return values
+
+
+def evaluate(pilot, output: Path, calibration, models_by_condition):
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    domain = pilot.EVALUATION_WORLDS[0]
+    tape_started = time.perf_counter()
+    tape = pilot.build_world_tape(
+        domain=domain,
+        provider=pilot.LegacyWorldProvider(role="retrain-evaluation"),
+        steps=TAPE_STEPS,
+        start_time_s=0.0,
+    )
+    tape_wall = time.perf_counter() - tape_started
+    records = []
+    latencies = []
+    for anchor_index in range(EVAL_ANCHORS):
+        anchor_started = time.perf_counter()
+        built_by_mode = {}
+        for target_mode in TARGET_MODES:
+            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = target_mode == "proxy"
+            feature_started = time.perf_counter()
+            built_by_mode[target_mode] = pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=calibration,
+                step_index=anchor_index,
+                carrier="nearest-eligible",
+                anchor_index=anchor_index,
+                include_coalition=False,
+                full_legal_actions=True,
+            )
+            built_by_mode[target_mode]["feature_wall_s"] = time.perf_counter() - feature_started
+        exact_built = built_by_mode["exact"]
+        base = exact_built["base"]
+        incumbent = exact_built["incumbent"]
+        current = exact_built["current_evaluator"]
+        catalogue, _ = pilot.ENGINE._catalogue_with_census(
+            tape,
+            anchor_index,
+            base,
+            setting=setting,
+            calibration=calibration,
+            run_setting=run_setting,
+        )
+        structural = pilot._structural_interactions(base, catalogue)
+        s_uni, u_iterations, u_wall, u_missed, u_certificate = pilot.ENGINE._s_uni_select(
+            base=base,
+            incumbent=incumbent,
+            tape=tape,
+            step_index=anchor_index,
+            evaluator=current,
+            calibration=calibration,
+            compute_budget_s=5.0,
+            run_setting=run_setting,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, anchor_index),
+        )
+        selections = {}
+        diagnostics = {}
+        for target_mode in TARGET_MODES:
+            rows = built_by_mode[target_mode]["rows_by_user_action"]
+            mode_current = built_by_mode[target_mode]["current_evaluator"]
+            s0 = pilot._exact_s0_boundary0(base, catalogue, mode_current, rows)
+            for corpus in CORPORA:
+                for epoch in EPOCHS:
+                    key = (target_mode, corpus, epoch)
+                    chosen, diag = pilot._select_for_anchor(
+                        "P-a0",
+                        base,
+                        catalogue,
+                        structural,
+                        models_by_condition[key],
+                        rows,
+                        tape,
+                        anchor_index,
+                        s0,
+                    )
+                    for seed in pilot.LEARNER_SEEDS:
+                        chosen[(seed, "BASELINE")] = base
+                        chosen[(seed, "S0")] = s0
+                        chosen[(seed, "S_UNI")] = s_uni
+                    selections[key] = chosen
+                    diagnostics[key] = diag
+        learned_selected = [
+            chosen[(seed, arm)]
+            for chosen in selections.values()
+            for seed in pilot.LEARNER_SEEDS
+            for arm in ARMS
+        ]
+        exact_psi = _selected_exact_psi(
+            pilot, base, incumbent, learned_selected, current, calibration
+        )
+        realised = pilot.ENGINE.StepEvaluator(
+            tape,
+            setting,
+            anchor_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, anchor_index),
+            field="realised",
+            run_setting=run_setting,
+        )
+        all_selected = {
+            config.assignments: config
+            for chosen in selections.values()
+            for config in chosen.values()
+        }
+        realised.evaluate_many(tuple(all_selected.values()))
+        for key, chosen in selections.items():
+            target_mode, corpus, epoch = key
+            rows = built_by_mode[target_mode]["rows_by_user_action"]
+            models = models_by_condition[key]
+            for seed in pilot.LEARNER_SEEDS:
+                for arm in REPORTED_ARMS:
+                    config = chosen[(seed, arm)]
+                    profile = realised.evaluate(config)
+                    outcome = profile.outcome()
+                    row = {
+                        "artifact_label": LABEL,
+                        "target_mode": target_mode,
+                        "corpus": corpus,
+                        "epoch": epoch,
+                        "world_id": domain,
+                        "world_seed": tape.seed,
+                        "anchor_index": anchor_index,
+                        "step_index": anchor_index,
+                        "carrier": "nearest-eligible",
+                        "learner_seed": seed,
+                        "arm": arm,
+                        "configuration_id": config.configuration_id,
+                        "changed_users": config.changed_users,
+                        "bits": profile.bits,
+                        "joules": profile.joules,
+                        "availability": float(outcome.useful_availability),
+                    }
+                    if arm in ARMS:
+                        context = None
+                        if config.changed_users >= 2:
+                            context = pilot._coalition_context(
+                                tape=tape,
+                                step_index=anchor_index,
+                                anchor=base,
+                                selected=config,
+                                rows_by_user_action=rows,
+                            )
+                        row["predicted_psi_normalized"] = (
+                            0.0 if context is None else models[(seed, arm)].interaction(context)
+                        )
+                        row["exact_psi_normalized"] = exact_psi[config.configuration_id]["psi"]
+                        row["exact_joint_delta_normalized"] = exact_psi[config.configuration_id]["joint"]
+                        row["top_choice_agreement"] = diagnostics[key][seed]["top_choice_agreement"]
+                    records.append(row)
+        latencies.append({
+            "anchor_index": anchor_index,
+            "wall_s": time.perf_counter() - anchor_started,
+            "exact_feature_wall_s": exact_built["feature_wall_s"],
+            "proxy_feature_wall_s": built_by_mode["proxy"]["feature_wall_s"],
+            "exact_source_physics_evaluations": exact_built["physics_calls"],
+            "proxy_source_physics_evaluations": built_by_mode["proxy"]["physics_calls"],
+            "nominal_physics_evaluations": current.physical_evaluations,
+            "realised_physics_evaluations": realised.physical_evaluations,
+            "s_uni_iterations": u_iterations,
+            "s_uni_wall_s": u_wall,
+            "s_uni_deadline_missed": u_missed,
+            "s_uni_termination_certificate": u_certificate,
+        })
+        print(json.dumps({
+            "event": "evaluation_anchor_done",
+            "anchor": anchor_index + 1,
+            "anchors_total": EVAL_ANCHORS,
+            "wall_s": latencies[-1]["wall_s"],
+        }), flush=True)
+    receipt_path = output / "evaluation" / f"{LABEL}-raw-receipts.jsonl"
+    receipt_digest = write_jsonl(receipt_path, records)
+    return records, {
+        "evaluation_tape_wall_s": tape_wall,
+        "latencies": latencies,
+        "receipt_rows": len(records),
+        "receipt_sha256": receipt_digest,
+        "receipt_path": str(receipt_path.relative_to(ROOT)),
+    }
+
+
+def summarize(records: list[dict]) -> dict:
+    result = {"conditions": {}}
+    for target_mode in TARGET_MODES:
+        result["conditions"][target_mode] = {}
+        for corpus in CORPORA:
+            result["conditions"][target_mode][corpus] = {}
+            for epoch in EPOCHS:
+                subset = [
+                    row for row in records
+                    if row["target_mode"] == target_mode
+                    and row["corpus"] == corpus
+                    and row["epoch"] == epoch
+                ]
+                arms = {}
+                for arm in REPORTED_ARMS:
+                    rows = [row for row in subset if row["arm"] == arm]
+                    bits = math.fsum(row["bits"] for row in rows)
+                    joules = math.fsum(row["joules"] for row in rows)
+                    arms[arm] = {
+                        "count": len(rows),
+                        "bits": bits,
+                        "joules": joules,
+                        "pooled_ee_bits_per_j": bits / joules,
+                        "availability": math.fsum(row["availability"] for row in rows) / len(rows),
+                    }
+                full = arms["FULL"]
+                drop = arms["DROP_C3"]
+                full_rows = [row for row in subset if row["arm"] == "FULL"]
+                psi_error = [
+                    row["predicted_psi_normalized"] - row["exact_psi_normalized"]
+                    for row in full_rows
+                ]
+                result["conditions"][target_mode][corpus][str(epoch)] = {
+                    "arms": arms,
+                    "full_minus_drop_c3_relative": full["pooled_ee_bits_per_j"] / drop["pooled_ee_bits_per_j"] - 1.0,
+                    "availability_gap_full_minus_drop_c3": full["availability"] - drop["availability"],
+                    "availability_held": full["availability"] >= drop["availability"],
+                    "full_selected_coalition_size_histogram": dict(sorted(Counter(row["changed_users"] for row in full_rows).items())),
+                    "full_predicted_vs_exact_psi": {
+                        "count": len(full_rows),
+                        "predicted_mean": math.fsum(row["predicted_psi_normalized"] for row in full_rows) / len(full_rows),
+                        "exact_mean": math.fsum(row["exact_psi_normalized"] for row in full_rows) / len(full_rows),
+                        "mae": math.fsum(abs(value) for value in psi_error) / len(psi_error),
+                        "rmse": math.sqrt(math.fsum(value * value for value in psi_error) / len(psi_error)),
+                        "sign_agreement": sum(
+                            np.sign(row["predicted_psi_normalized"]) == np.sign(row["exact_psi_normalized"])
+                            for row in full_rows
+                        ) / len(full_rows),
+                        "predicted_min": min(row["predicted_psi_normalized"] for row in full_rows),
+                        "predicted_max": max(row["predicted_psi_normalized"] for row in full_rows),
+                        "exact_min": min(row["exact_psi_normalized"] for row in full_rows),
+                        "exact_max": max(row["exact_psi_normalized"] for row in full_rows),
+                    },
+                }
+    return result
+
+
+def pct(value: float) -> str:
+    return f"{100.0 * value:+.3f}%"
+
+
+def write_report(summary: dict, source_metrics: dict, corpus_metrics: dict, run_manifest: dict):
+    primary = summary["conditions"]["exact"]["rebuilt"]["2000"]
+    full = primary["arms"]["FULL"]
+    drop = primary["arms"]["DROP_C3"]
+    availability_word = "HELD" if primary["availability_held"] else "DID NOT HOLD"
+    lines = [
+        f"**Epoch 2000, exact targets + rebuilt corpus: FULL minus DROP_C3 = {pct(primary['full_minus_drop_c3_relative'])}; availability {availability_word} (FULL {full['availability']:.6%}, DROP_C3 {drop['availability']:.6%}).**",
+        "",
+        "# First repaired-feature C3 retraining measurement",
+        "",
+        f"**{LABEL}.** This is a minimal engineering pilot: one evaluation world, five anchors, nearest-eligible carrier, and two fixed learner seeds. It is not claim evidence.",
+        "",
+    ]
+    if primary["full_minus_drop_c3_relative"] <= 0:
+        lines.append("The contracted exact-target result is negative or flat: the rebuilt C3 head does not improve pooled energy efficiency over DROP_C3 at epoch 2000.")
+    elif not primary["availability_held"]:
+        lines.append("The contracted exact-target result is not reported as a gain because FULL serves fewer users than DROP_C3 at epoch 2000.")
+    else:
+        lines.append("The contracted exact-target result is positive in this minimal pilot and availability did not fall relative to DROP_C3; the scale is still too small for a general claim.")
+    lines.extend([
+        "",
+        "## Energy efficiency and availability",
+        "",
+        "Pooled EE is total realised bits divided by total realised joules across the 10 anchor-seed decisions. The relative contrast is `FULL / DROP_C3 - 1`.",
+        "",
+        "| Targets | C3 corpus | Epoch | Arm | Pooled EE (bit/J) | Availability | FULL−DROP_C3 | Availability held? |",
+        "|---|---|---:|---|---:|---:|---:|---|",
+    ])
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            for epoch in EPOCHS:
+                row = summary["conditions"][target_mode][corpus][str(epoch)]
+                for arm in REPORTED_ARMS:
+                    arm_row = row["arms"][arm]
+                    contrast = pct(row["full_minus_drop_c3_relative"]) if arm == "FULL" else "—"
+                    held = ("yes" if row["availability_held"] else "no") if arm == "FULL" else "—"
+                    lines.append(
+                        f"| {target_mode} | {corpus} | {epoch} | {arm} | {arm_row['pooled_ee_bits_per_j']:.9g} | {arm_row['availability']:.6%} | {contrast} | {held} |"
+                    )
+    lines.extend([
+        "",
+        "## Direct old-corpus versus rebuilt-corpus contrast",
+        "",
+        "The old comparator is exactly the 180 `pair-catalogue` action selections, all size two, reconstructed as v2 rows and evaluated with the same repaired encoder and canonical exact C3 labels. This isolates corpus coverage; it does not reuse the legacy call-order-dependent labels.",
+        "",
+        "| Targets | Epoch | Old-180 FULL−DROP_C3 | Rebuilt FULL−DROP_C3 | Old availability gap | Rebuilt availability gap |",
+        "|---|---:|---:|---:|---:|---:|",
+    ])
+    for target_mode in TARGET_MODES:
+        for epoch in EPOCHS:
+            old = summary["conditions"][target_mode]["old-180"][str(epoch)]
+            new = summary["conditions"][target_mode]["rebuilt"][str(epoch)]
+            lines.append(
+                f"| {target_mode} | {epoch} | {pct(old['full_minus_drop_c3_relative'])} | {pct(new['full_minus_drop_c3_relative'])} | {pct(old['availability_gap_full_minus_drop_c3'])} | {pct(new['availability_gap_full_minus_drop_c3'])} |"
+            )
+    lines.extend([
+        "",
+        "## FULL selected coalition sizes",
+        "",
+        "Counts are across five anchors × two learner seeds.",
+        "",
+        "| Targets | C3 corpus | Epoch | Size distribution |",
+        "|---|---|---:|---|",
+    ])
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            for epoch in EPOCHS:
+                hist = summary["conditions"][target_mode][corpus][str(epoch)]["full_selected_coalition_size_histogram"]
+                rendered = "; ".join(f"size {size}: {count}" for size, count in hist.items())
+                lines.append(f"| {target_mode} | {corpus} | {epoch} | {rendered} |")
+    lines.extend([
+        "",
+        "## FULL interaction prediction versus exact Psi",
+        "",
+        "All values are normalized by kappa and are computed at the coalitions actually selected by FULL. Exact Psi is recomputed from the anchor, exact singleton changes, and selected joint configuration; it is not copied from the training corpus.",
+        "",
+        "| Targets | C3 corpus | Epoch | Predicted mean | Exact mean | MAE | RMSE | Sign agreement | Predicted range | Exact range |",
+        "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+    ])
+    for target_mode in TARGET_MODES:
+        for corpus in CORPORA:
+            for epoch in EPOCHS:
+                psi = summary["conditions"][target_mode][corpus][str(epoch)]["full_predicted_vs_exact_psi"]
+                lines.append(
+                    f"| {target_mode} | {corpus} | {epoch} | {psi['predicted_mean']:.6g} | {psi['exact_mean']:.6g} | {psi['mae']:.6g} | {psi['rmse']:.6g} | {psi['sign_agreement']:.1%} | [{psi['predicted_min']:.6g}, {psi['predicted_max']:.6g}] | [{psi['exact_min']:.6g}, {psi['exact_max']:.6g}] |"
+                )
+    exact = source_metrics
+    lines.extend([
+        "",
+        "## Exact-target cost and scope",
+        "",
+        f"The full 180-anchor C1/C2 source rebuild was reduced to {exact['training_anchors']} matched training anchors for both exact and proxy modes. The exact path produced {exact['exact_action_target_pairs']} paired action targets ({exact['exact_scalar_c1_c2_labels']} scalar C1-or-C2 labels) in {exact['exact_total_wall_s']:.3f} wall seconds: {exact['exact_wall_s_per_paired_c1_c2_action_target']:.6f} s per paired C1/C2 action target, or {exact['exact_wall_s_per_scalar_c1_or_c2_label']:.6f} s per scalar label. This timing includes exact feature/outcome construction and the three frozen forecast offsets.",
+        "",
+        f"The rebuilt C3 corpus contained {corpus_metrics['rebuilt_rows']} rows in {corpus_metrics['rebuilt_shards']} shards. The repaired old comparator contained {corpus_metrics['old_rows']} rows with histogram {corpus_metrics['old_size_histogram']}.",
+        "",
+        "Evaluation retained the requested world 3, five anchors, nearest-eligible carrier, two learner seeds, FULL, DROP_C3, BASELINE, S0, and the iterated unilateral optimum. It used the same 8-step tape prefix (five anchors plus three forecast steps). Exact and proxy modes were both run; no threshold, sign, seed, horizon, price, service guard, acceptance rule, or optimizer literal was changed.",
+        "",
+        "Training used at most four worker processes and every launched Python process was run under `nice -n 10` with BLAS thread counts fixed to one.",
+        "",
+        "## Artifacts and limitations",
+        "",
+        f"Raw receipts: `{run_manifest['evaluation']['receipt_path']}` ({run_manifest['evaluation']['receipt_rows']} rows; SHA-256 `{run_manifest['evaluation']['receipt_sha256']}`).",
+        f"Run manifest: `artifacts/v025-retrain-measurement-20260909-PILOT_NOT_CLAIM/{LABEL}-manifest.json`.",
+        "",
+        "This is a 10-decision-per-condition pilot, so it has no useful claim-level power or uncertainty estimate. The exact/proxy comparison also changes the feature values produced by the inherited fallback, not only its scalar labels, because that flag bypasses the evaluator path that supplies both contracted outcomes and their derived state fields.",
+        "",
+        f"**{LABEL}.**",
+        "",
+    ])
+    REPORT_PATH.write_text("\n".join(lines), encoding="utf-8")
+    digest = sha256(REPORT_PATH)
+    REPORT_PATH.with_name(REPORT_PATH.name + ".sha256").write_text(
+        f"{digest}  {REPORT_PATH.name}\n", encoding="ascii"
+    )
+    return digest
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    args = parser.parse_args()
+    if args.output.exists():
+        raise SystemExit(f"refusing to overwrite {args.output}")
+    if REPORT_PATH.exists():
+        raise SystemExit(f"refusing to overwrite {REPORT_PATH}")
+    args.output.mkdir(parents=True)
+    total_started = time.perf_counter()
+    pilot = load_pilot()
+    calibration = load_calibration(pilot)
+    verified_inputs = verify_rebuilt_input()
+    c3_batches, corpus_metrics = load_corpora(args.output)
+    action_batches, source_metrics = generate_action_sources(
+        pilot, args.output, calibration
+    )
+    training = train_conditions(
+        pilot, args.output, action_batches, c3_batches
+    )
+    models, checkpoint_digests = restore_models(
+        pilot, args.output, action_batches, c3_batches
+    )
+    records, evaluation = evaluate(
+        pilot, args.output, calibration, models
+    )
+    summary = summarize(records)
+    manifest = {
+        "artifact_label": LABEL,
+        "schema": "mcrl-v025-retrain-measurement-v1",
+        "scope": {
+            "target_modes": TARGET_MODES,
+            "corpora": CORPORA,
+            "epochs": EPOCHS,
+            "training_anchors": TRAIN_ANCHORS,
+            "evaluation_worlds": pilot.EVALUATION_WORLDS,
+            "evaluation_anchors": EVAL_ANCHORS,
+            "tape_steps": TAPE_STEPS,
+            "carrier": "nearest-eligible",
+            "learner_seed_domains": pilot.LEARNER_DOMAINS,
+            "learner_seeds": pilot.LEARNER_SEEDS,
+            "arms": REPORTED_ARMS,
+            "max_processes": MAX_WORKERS,
+        },
+        "repaired_coalition_context_schema": "mcrl-v025-stagec-c3-coalition-context-v2",
+        "proxy_flag_inherited_value": True,
+        "exact_flag_value": False,
+        "verified_rebuilt_top_level_inputs": verified_inputs,
+        "corpus_metrics": corpus_metrics,
+        "source_metrics": source_metrics,
+        "training": training,
+        "checkpoint_sha256": checkpoint_digests,
+        "evaluation": evaluation,
+        "summary": summary,
+        "total_wall_s_before_manifest": time.perf_counter() - total_started,
+    }
+    manifest_path = args.output / f"{LABEL}-manifest.json"
+    manifest_digest = write_json(manifest_path, manifest)
+    manifest["manifest_sha256"] = manifest_digest
+    report_digest = write_report(
+        summary, source_metrics, corpus_metrics, manifest
+    )
+    print(json.dumps({
+        "event": "complete",
+        "manifest": str(manifest_path),
+        "manifest_sha256": manifest_digest,
+        "report": str(REPORT_PATH),
+        "report_sha256": report_digest,
+        "total_wall_s": time.perf_counter() - total_started,
+    }), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

