                    exact.update(
                        _exact_interactions(
                            catalogue_anchor, incumbent, selected_full_catalogue,
                            current, calibration,
                        )
                    )
                    for seed in LEARNER_SEEDS:
                        selections[(seed, "BASELINE")] = carrier_base
                        selections[(seed, "S_UNI")] = u
                    additive_configs = {
                        row["additive_choice"].assignments: row["additive_choice"]
                        for row in diagnostics.values()
                    }
                    realised.evaluate_many(
                        tuple({
                            **{row.assignments: row for row in selections.values()},
                            **additive_configs,
