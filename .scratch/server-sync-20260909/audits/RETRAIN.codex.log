"""Quarantined end-to-end V0.25 learned-C3 pilot (PILOT_NOT_CLAIM).

This adapter joins the independently delivered stage-4d/4f real-physics
engine, fixed legacy provider, and Stage-C build-3 learner.  It deliberately
uses only V025_PROBE/world/{1..4}; no claim-panel namespace is accepted.
"""

from __future__ import annotations

import argparse
