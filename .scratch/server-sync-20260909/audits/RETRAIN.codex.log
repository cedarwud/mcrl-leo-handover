+LABEL = "PILOT_NOT_CLAIM"
+ROOT = Path(__file__).resolve().parents[2]
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+REBUILT = ROOT / "artifacts/v025-mechanism-coalition-corpus-20260909-PILOT_NOT_CLAIM"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-min-20260909-PILOT_NOT_CLAIM"
+    / f"{LABEL}-calibration.json"
+)
+DEFAULT_OUTPUT = ROOT / "artifacts/v025-retrain-measurement-20260909-PILOT_NOT_CLAIM"
+REPORT_PATH = ROOT / "RETRAIN-RESULT-2026-09-09.md"
+
+TARGET_MODES = ("exact", "proxy")
+CORPORA = ("rebuilt", "old-180")
+EPOCHS = (200, 1000, 2000)
+ARMS = ("FULL", "DROP_C3")
+REPORTED_ARMS = (*ARMS, "BASELINE", "S0", "S_UNI")
+TRAIN_ANCHORS = 5
+EVAL_ANCHORS = 5
+TAPE_STEPS = 8
+MAX_WORKERS = 4
