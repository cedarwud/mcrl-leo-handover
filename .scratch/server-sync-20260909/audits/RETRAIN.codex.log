        "- Power-invalid shortlisted actions have no engine outcome object. They are counted and omitted from rows; BASE and explicit NULL are required to remain.",
        "- The old T1 acceptance assertion expected the superseded four-user label cap. T1/T2 logic otherwise ran; the full T3 Monte Carlo gate was stopped after ten wall minutes to protect the pilot compute budget.",
        "- Build 3 has no explicit C2 tie-break implementation. Stable total score then configuration ID is used. The C2 tie statistic reported here was implemented by this pilot as the smallest schema-satisfying measurement (exact C2-score equality against the incumbent); it measures head indiscriminability, not a build-3 tie-break code path.",
        "- V_CA and coalition-size anti-pattern strata were not first-class build-3 receipt fields. The pilot records V_CA as the realised FULL-minus-additive-selector F difference, with bits, -eta*energy and Phi components unclipped, and emits explicit size strata.",
        "- To remain inside the six-core-hour ceiling after timing the real provider, Q2 forecasts use boundary 0 at each of the three sealed offsets rather than all five coarse boundaries, and training uses a deterministic 4096-pair aggregate while preserving all raw rows. This is a schema-complete pilot fallback, not sealed evidence.",
        "- Exact full-network C1/C2 evaluation for every shortlisted source action exceeded the compute ceiling. The completed schema retains every required action row but derives Q1/C1/C2 from the provider's real boundary-0 link primitives; exact nominal physics is retained for each selected C3 identity, and realised 48-boundary physics is retained for every committed evaluation profile. These approximate source labels are PILOT_NOT_CLAIM.",
        "- Exact S0 over 48 boundaries for every catalogue profile was unbounded in the joined engine. The pilot ranks S0's top-two proposals with provider-primitive C1+C2, applies the same bounded evacuation rule, evaluates that set with exact nominal boundary-0 physics, then evaluates the committed S0 profile over all 48 realised boundaries.",
        "- Exhaustive exact interaction decomposition over every catalogue row was also unbounded. Exact Psi is computed for every P-u joint escape candidate and every selected FULL coalition; other rows retain learned scoring only. P-u top-10 users are primitive-ranked by |d_i^u|. The pilot S_UNI wall budget was reduced to 5 seconds, with the engine's fallback and termination certificate retained verbatim.",
        "",
        f"Raw evaluation rows: {evaluation_manifest['receipt_rows']}; bytes: {evaluation_manifest['receipt_bytes']}; SHA-256: `{evaluation_manifest['receipt_sha256']}`.",
        "",
    ])
    REPORT_PATH.write_text("\n".join(lines), encoding="utf-8")
    digest = hashlib.sha256(REPORT_PATH.read_bytes()).hexdigest()
    REPORT_PATH.with_name(REPORT_PATH.name + ".sha256").write_text(
        f"{digest}  {REPORT_PATH.name}\n", encoding="ascii"
    )
    return digest


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument(
        "--resume-evaluation", action="store_true",
        help="resume from immutable completed row/training artifacts",
    )
    parser.add_argument("--min-pilot", action="store_true",
                        help="minimal PILOT_NOT_CLAIM scale: world 3, 5 anchors, "
                             "nearest carrier, 2 seeds, FULL/DROP_C3/BASELINE, epoch 200")
    args = parser.parse_args(argv)
    if args.min_pilot:
        global EVALUATION_WORLDS, LEARNER_DOMAINS, LEARNER_SEEDS, REPORTED_ARMS
        global PILOT_ARMS, EVAL_ANCHOR_STEPS, EVAL_CARRIER_LIMIT, EVAL_EPOCH
        global ROW_WORLD_GLOB, ROW_ANCHOR_LIMIT, REPORT_PATH
        EVALUATION_WORLDS = DEVELOPMENT_WORLD_DOMAINS[2:3]
        LEARNER_DOMAINS = LEARNER_DOMAINS[:2]
        LEARNER_SEEDS = LEARNER_SEEDS[:2]
        PILOT_ARMS = ("FULL", "DROP_C3")
        REPORTED_ARMS = (*PILOT_ARMS, "BASELINE", "S0", "S_UNI")
        EVAL_ANCHOR_STEPS = 5
        EVAL_CARRIER_LIMIT = 1
        EVAL_EPOCH = 200
        ROW_WORLD_GLOB = "world-1"
        ROW_ANCHOR_LIMIT = 5
        global EVAL_TAPE_STEPS
        EVAL_TAPE_STEPS = EVAL_ANCHOR_STEPS + 3
        REPORT_PATH = ROOT / "V025-PILOT-MIN-REPORT-2026-09-09.md"
    if args.output.exists() and not args.resume_evaluation:
        raise SystemExit(f"refusing to overwrite pilot output: {args.output}")
    if args.resume_evaluation and not args.output.exists():
        raise SystemExit(f"resume output does not exist: {args.output}")
    args.output.mkdir(parents=True, exist_ok=args.resume_evaluation)
    total_started = time.perf_counter()
    if args.resume_evaluation:
        row_manifest, training_manifest, calibration, models, batches = (
            _load_completed_training(args.output)
        )
    else:
        rows, coalitions, calibration, row_manifest = generate_rows(args.output)
        models, training_manifest, batches = train(args.output, rows, coalitions)
    records, evaluation_manifest = evaluate(
        args.output, calibration, models, batches
    )
    summary = summarize(records, row_manifest, training_manifest, evaluation_manifest)
    _write_phase_manifest(
        args.output / f"{LABEL}-summary.json",
        {
            "schema": f"{PILOT_SCHEMA}-summary-v1",
            "total_wall_s": time.perf_counter() - total_started,
            "summary": summary,
        },
    )
    report_digest = write_report(
        summary, row_manifest, training_manifest, evaluation_manifest
    )
    print(
        json.dumps(
            {
                "artifact_label": LABEL,
                "status": "COMPLETE",
                "output": str(args.output),
                "report": str(REPORT_PATH),
                "report_sha256": report_digest,
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

