def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=0.0 if primitive is None else primitive["remaining_d2"],
                remaining_visibility_time_s=(
                    0.0 if primitive is None else primitive["remaining_visibility"]
                ),
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent_identity,
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=(
                    identity is not None and identity in previous_beam
                ),
                previous_satellite_active_for_action=(
                    identity is not None and identity[0] in previous_satellite
                ),
                previous_beam_max_rf_over_cap=(
                    0.0 if identity is None else min(1.0, required_ratio)
                ),
                missing_incumbent=missing_incumbent,
                candidate_current_nominal_decoding_margin_db=profile.min_decoding_margin_db,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(
                    projections[0].mean_acm_se_bit_s_hz
                    - profile.mean_acm_se_bit_s_hz
                )
                / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W - profile.required_power_w_max,
                forecasts=tuple(
                    ForecastObservation(
                        valid=row.valid,
                        survival=row.survives,
                        minimum_decoding_margin_db=row.min_decoding_margin_db,
                        mean_acm_spectral_efficiency=row.mean_acm_se_bit_s_hz,
                    )
                    for row in projections
                ),
                c1_label_bits=float(core),
                c1_phi_difference=float(phi),
                c2_label_bits=float(c2.forecast_surplus_bits - c2.persistence_penalty_bits),
                legal=True,
                terminal=step_index == 29,
                outage=not bool(profile.score.served_phy.get(user, False)),
            )
            provenance = canonical_sha256(
                {
                    "artifact_label": LABEL,
                    "world": tape.digest,
                    "step": step_index,
                    "carrier": carrier,
                    "user": user,
                    "configuration": config.configuration_id,
                }
            )
            actions.append(
                seal_action_evaluation(
                    observation,
                    source_provenance_sha256=provenance,
                    forecast_method_sha256=canonical_sha256(
                        {
                            "engine": ENGINE.SCHEMA,
                            "offsets": [1, 2, 3],
                            "boundaries": list(ENGINE.SELECTION_BOUNDARY_INDICES),
                        }
                    ),
                )
            )
            identities.append(identity)
        if base.mapping[user] not in identities or None not in identities:
            raise RuntimeError("source action set lost BASE or the explicit null action")
        envelope = AnchorEnvelope(
            world_id=tape.domain,
            split="TRAIN",
            world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}",
            anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user,
            setting_id="a-r0",
            code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST,
            launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest,
            calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape),
            allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]),
            actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row

    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _catalogue_census = ENGINE._catalogue_with_census(
            tape,
            step_index,
            base,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        current.evaluate_many(catalogue)
        catalogue_count = len(catalogue)
        factors = ENGINE._selection_factor_scores(
            base=base,
            incumbent=incumbent,
            catalog=tuple(
                row for row in catalogue if row.configuration_id not in current._invalid
            ),
            evaluated=current._evaluated,
            calibration=calibration,
            cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        )
        pairwise = [
            row
            for row in catalogue
            if row.changed_users == 2
            and row.configuration_id in factors
        ]
        if not pairwise:
            raise RuntimeError("sealed catalogue produced no trainable joint coalition")
        selected = min(
            pairwise,
            key=lambda row: (
                -float(factors[row.configuration_id]["C1"] + factors[row.configuration_id]["C3"]),
                row.configuration_id,
            ),
        )
        coalition_row = _coalition_row(
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            run_setting=run_setting,
        )
    return {
        "base": base,
        "incumbent": incumbent,
        "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action,
        "current_evaluator": current,
        "coalition_row": coalition_row,
        "census": census,
        "skipped_invalid": skipped_invalid,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
            column = aggressors.get(source)
            gain = 0.0 if column is None else max(
                (
                    float(arrays.cross_base_nominal[0, user, column])
                    for user in victim_columns.get(target, ())
                ),
                default=0.0,
            )
            pair_cache[relation] = gain
        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
    return tuple(result)


def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
    changed = tuple(
        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
    )
    members = tuple(
        CoalitionMember(
            user_id=user,
            reference_action=_physical_action(anchor.mapping[user]),
            selected_action=_physical_action(selected.mapping[user]),
            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
        )
        for user in changed
    )
    affected = sorted(
        {
            identity
            for user in changed
            for identity in (anchor.mapping[user], selected.mapping[user])
            if identity is not None
        }
    )
    before_counts: dict[tuple[int, int], int] = {}
    after_counts: dict[tuple[int, int], int] = {}
    for identity in anchor.mapping.values():
        if identity is not None:
            before_counts[identity] = before_counts.get(identity, 0) + 1
    for identity in selected.mapping.values():
        if identity is not None:
            after_counts[identity] = after_counts.get(identity, 0) + 1
    relations = _cross_gain_terms(tape, step_index, affected)
    beams = tuple(
        AffectedBeamContext(
            beam_key=f"{identity[0]}:{identity[1]}",
            occupancy_before=before_counts.get(identity, 0),
            occupancy_after=after_counts.get(identity, 0),
            active_before=before_counts.get(identity, 0) > 0,
            active_after=after_counts.get(identity, 0) > 0,
            shared_capacity=1.0,
            interference_summary=math.fsum(
                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
            ),
            capacity_margin=float(10 - after_counts.get(identity, 0)),
        )
        for identity in affected
    )
    return CoalitionContext(
        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
        reference_profile=tuple(
            (user, _physical_action(identity)) for user, identity in anchor.assignments
        ),
        members=members,
        affected_beams=beams,
        global_resource_features=(
            len(changed) / max(1, len(anchor.assignments)),
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )


def _coalition_row(
    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
    rows_by_user_action, calibration, run_setting,
):
    context = _coalition_context(
        tape=tape,
        step_index=step_index,
        anchor=anchor,
        selected=selected,
        rows_by_user_action=rows_by_user_action,
    )
    reference = evaluator.evaluate(anchor).outcome(
        phi=ENGINE._phi_for(anchor, anchor)
    )
    unilateral = {}
    for user in context.changed_users:
        mapping = anchor.mapping
        mapping[user] = selected.mapping[user]
        config = ENGINE._configuration(anchor, mapping, kind="pilot-coalition-singleton")
        unilateral[user] = evaluator.evaluate(config).outcome(
            phi=ENGINE._phi_for(anchor, config)
        )
    selected_outcome = evaluator.evaluate(selected).outcome(
        phi=ENGINE._phi_for(anchor, selected)
    )
    return build_coalition_row(
        context=context,
        reference_outcome=reference,
        unilateral_outcomes=unilateral,
        coalition_outcome=selected_outcome,
        world_id=tape.domain,
        world_seed=tape.seed,
        anchor_index=anchor_index,
        decision_time_utc=_utc_at(tape, step_index),
        decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
        setting_id="a-r0",
        lambda_bits_per_j=float(calibration.lambda_bits_per_j),
        eta_ref_bits_per_j=float(calibration.eta_ref),
        kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
        code_digest=CODE_DIGEST,
        physics_digest=PHYSICS_DIGEST,
        catalogue_digest=ENGINE.catalogue_definition()["sha256"],
        setting_digest=run_setting.digest,
        calibration_digest=calibration.digest,
        allocation_manifest_digest=ALLOCATION_DIGEST,
    )


def _write_phase_manifest(path: Path, payload: Mapping[str, object]) -> str:
    return write_once_json(path, {"artifact_label": LABEL, **payload})


def generate_rows(output: Path):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    source_shards = []
    coalition_shards = []
    calibration = None
