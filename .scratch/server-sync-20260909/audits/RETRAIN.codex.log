@dataclass(frozen=True)
class PilotCalibration:
    eta_ref: Fraction
    lambda_bits_per_j: Fraction
    kappa_bits_per_user_step: Fraction
    bits_ref: Fraction
    joules_ref: Fraction
    users: int
    source: str = "one-development-anchor-proxy"

    def __post_init__(self) -> None:
        assert_calibration_prices(
            lambda_bits_per_j=self.lambda_bits_per_j,
            eta_ref=self.eta_ref,
            kappa_bits_per_user_step=self.kappa_bits_per_user_step,
        )

    @property
    def digest(self) -> str:
        return canonical_sha256(self.payload())

    def payload(self) -> dict[str, object]:
        def ratio(value: Fraction) -> list[int]:
            return [value.numerator, value.denominator]

        return {
            "schema": f"{PILOT_SCHEMA}-calibration-proxy-v1",
            "artifact_label": LABEL,
            "source": self.source,
            "eta_ref": ratio(self.eta_ref),
            "lambda_bits_per_j": ratio(self.lambda_bits_per_j),
            "kappa_bits_per_user_step": ratio(self.kappa_bits_per_user_step),
            "bits_ref": ratio(self.bits_ref),
            "joules_ref": ratio(self.joules_ref),
            "users": self.users,
        }


@dataclass(frozen=True)
class AnchorEnvelope:
