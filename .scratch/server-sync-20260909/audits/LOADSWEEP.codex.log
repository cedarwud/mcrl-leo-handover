+#!/usr/bin/env bash
+set -euo pipefail
+
+python_bin=/home/sat/mcrl-leo-handover/.venv/bin/python
+scratch=.scratch/load-regime-sweep-20260910
+runner="$scratch/sweep_runner.py"
+results="$scratch/results"
+logs="$scratch/logs"
+mkdir -p "$results" "$logs"
+
+points=(
+  "100 20"
+  "100 35"
+  "100 50"
+  "100 65"
+  "100 80"
+  "150 50"
+  "200 50"
+  "250 50"
+  "150 65"
+  "200 80"
+  "250 80"
+)
+
+run_one() {
+  set -euo pipefail
+  local users=$1 rate=$2 formulation=$3
+  local stem="u${users}-r${rate}-${formulation}"
+  local output="$results/$stem.json"
+  if [[ -f "$output" ]] && "$python_bin" -c \
+    'import json,sys; d=json.load(open(sys.argv[1])); raise SystemExit(not (d.get("status")=="COMPLETE" and len(d.get("anchors",[]))==8))' \
+    "$output"; then
+    echo "SKIP complete $stem"
+    return
+  fi
+  PYTHONPATH=src \
+  OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \
+    nice -n 15 "$python_bin" "$runner" \
+    --users "$users" --rate-mbps "$rate" --formulation "$formulation" \
+    --output "$output" 2>&1 | tee "$logs/$stem.log"
+}
+export -f run_one
+export python_bin runner results logs
+
+for point in "${points[@]}"; do
+  read -r users rate <<<"$point"
+  for formulation in sealed margin; do
+    printf '%s %s %s\n' "$users" "$rate" "$formulation"
+  done
+done | xargs -P 3 -n 3 bash -c 'run_one "$@"' _
