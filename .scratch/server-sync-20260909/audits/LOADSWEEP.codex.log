#!/usr/bin/env python3
"""Perfect-knowledge set-interaction ceiling on corrected V0.25 physics.

This is a TRAIN-only diagnostic.  It has no learner and intentionally ignores
the ten-second deployment deadline.  Selection uses the exact binary64
decision-boundary outcomes; committed reporting uses all 48 realised
boundaries from the same detached world tape.
"""

from __future__ import annotations

import argparse
from collections import Counter
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import os
from pathlib import Path
import platform
import subprocess
import sys
import time
from typing import Mapping, Sequence


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
PROBE_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)
OUTPUT_PATH = HERE / "oracle-ceiling-result.json"
ETA_REF = Fraction("19720681.00172232")
ANCHORS_PER_WORLD = 5
WORLD_COUNT = 4
SELECTION_WORKERS = 1
OCCUPANT_SUBSET_MAX_SIZE = 4
OCCUPANT_SUBSET_TOTAL_CAP = 1_024
JOINT_CANDIDATE_CAP = 4_096
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"


def _load_probe():
    spec = importlib.util.spec_from_file_location("oracle_v025_probe", PROBE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load the pinned V0.25 probe")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


probe = _load_probe()


def exact_float(value: float) -> Fraction:
    """Treat the simulator's finite binary64 result as an exact coefficient."""

    if not math.isfinite(value):
        raise RuntimeError("non-finite physical coefficient")
    return Fraction.from_float(float(value))


def objective(profile) -> Fraction:
    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)


def served(profile) -> int:
    if isinstance(profile, SelectionMetric):
        return profile.served_count
    return sum(bool(value) for value in profile.score.served_phy.values())


def ratio(bits: float, joules: float) -> float:
    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
        raise RuntimeError("invalid EE components")
    return bits / joules


def relative_gain(numerator: float, denominator: float) -> float | None:
    """Return an anchor-local gain, or None when the reference EE is zero."""

    if denominator == 0.0:
        return None
    return numerator / denominator - 1.0


def frac_payload(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def _configuration(base, mapping: Mapping[int, tuple[int, int] | None], kind: str):
    return probe._configuration(base, dict(mapping), kind=kind)


@dataclass(frozen=True)
class CoordinateResult:
    selected: object
    iterations: int
    passes: int
    terminal_candidates: tuple[object, ...]
    best_alternatives: Mapping[int, tuple[int, int]]
    candidate_comparisons: int


@dataclass(frozen=True)
class SelectionMetric:
    config: object
    bits: float
    joules: float
    served_count: int


_WORKER_TAPE = None


def _selection_worker(task):
    step_index, base, configs = task
    evaluator = probe.StepEvaluator(
        _WORKER_TAPE,
        probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=probe.run_setting_for("a-r0"),
        boundary_indices=(0,),
        fading_quantile_alpha=0.10,
    )
    evaluator.evaluate_many(configs)
    rows = []
    for config in configs:
        profile = evaluator._evaluated.get(config.configuration_id)
        if profile is not None:
            rows.append(
                SelectionMetric(
                    config, profile.bits, profile.joules, served(profile)
                )
            )
    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations


class ParallelSelectionEvaluator:
    """Persistent fork workers over one detached tape; exact stable reduction."""

    def __init__(self, tape, step_index: int, base, pool) -> None:
        self.tape = tape
        self.step_index = step_index
        self.base = base
        self.pool = pool
        self._evaluated: dict[str, SelectionMetric] = {}
        self._invalid: set[str] = set()
        self.physical_evaluations = 0

    def evaluate_many(self, configs: Sequence[object]) -> None:
        missing_by_id = {
            row.configuration_id: row
            for row in configs
            if row.configuration_id not in self._evaluated
            and row.configuration_id not in self._invalid
        }
        missing = tuple(missing_by_id.values())
        if not missing:
            return
        if self.pool is None:
            results = [_selection_worker((self.step_index, self.base, missing))]
        else:
            shards = tuple(
                tuple(missing[index::SELECTION_WORKERS])
                for index in range(SELECTION_WORKERS)
            )
            results = self.pool.map(
                _selection_worker,
                tuple((self.step_index, self.base, shard) for shard in shards),
                chunksize=1,
            )
        unordered = {}
        for rows, invalid, evaluations in results:
            unordered.update((row.config.configuration_id, row) for row in rows)
            self._invalid.update(invalid)
            self.physical_evaluations += evaluations
        for config in missing:
            if config.configuration_id in unordered:
                self._evaluated[config.configuration_id] = unordered[
                    config.configuration_id
                ]

    def evaluate(self, config) -> SelectionMetric:
        self.evaluate_many((config,))
        try:
            return self._evaluated[config.configuration_id]
        except KeyError:
            raise RuntimeError(
                f"invalid selection configuration {config.configuration_id}"
            ) from None


def coordinate_optimum(*, tape, step_index: int, base, evaluator) -> CoordinateResult:
    """Deterministic cyclic best responses to a strict local optimum."""

    options, _ = probe._legal_options(tape, step_index)
    base_profile = evaluator.evaluate(base)
    guard = served(base_profile)
    current = base
    iterations = 0
    passes = 0
    comparisons = 0
    terminal: tuple[object, ...] = ()

    while True:
        passes += 1
        pass_moves = 0
        pass_candidates = []
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(current_profile)
            candidates = []
            current_map = current.mapping
            for identity in options[user]:
                if identity == current_map[user]:
                    continue
                mapping = dict(current_map)
                mapping[user] = identity
                candidates.append(
                    _configuration(base, mapping, "unilateral-coordinate")
                )
            evaluator.evaluate_many(candidates)
            comparisons += len(candidates)
            pass_candidates.extend(candidates)
            best = current
            best_value = current_value
            for candidate in candidates:
                profile = evaluator._evaluated.get(candidate.configuration_id)
                if profile is None or served(profile) < guard:
                    continue
                value = objective(profile)
                if value > best_value or (
                    value == best_value
                    and best is not current
                    and candidate.configuration_id < best.configuration_id
                ):
                    best = candidate
                    best_value = value
            if best.assignments != current.assignments:
                current = best
                iterations += 1
                pass_moves += 1
        if pass_moves == 0:
            terminal = tuple(pass_candidates)
            break
        print(
            json.dumps(
                {
                    "coordinate_step": step_index,
                    "completed_passes": passes,
                    "moves_in_pass": pass_moves,
                    "completed_improving_moves": iterations,
"""Dense catalogue evaluation for the V0.25 rate-target TDM architecture.

This module is deliberately narrow: it implements the exact ``a-r`` radiation
and integration equations for a whole configuration catalogue backed by a
``PrimitiveStepArrays`` object.  The scalar object path remains the authority
used by KATs; this path removes per-row Python objects from real-world units.
"""

from __future__ import annotations

from dataclasses import dataclass
import math

import numpy as np

from mcrl.errors import MCRLContractError

from mcrl.physics_v025.acm import ACM_MODES, rate_target_mode, rate_target_sinr
from mcrl.physics_v025.channel import fading_product_quantile_array, noise_power_w
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
    CIRCUIT_POWER_PER_CHAIN_W,
    D2_MEASUREMENT_STEP_S,
    PA_MAX_EFFICIENCY,
    PA_SATURATION_POWER_W,
    POWER_SOLVER_ITERATION_CAP,
    POWER_SOLVER_TOLERANCE_W,
    RATE_TARGET_BPS,
    SINR_MIN_DB,
)
from mcrl.physics_v025.tapes import PrimitiveStepArrays


# Diagnostic counters are separate from the unchanged BatchARResult API.
# A fresh process/import starts a new counter set. They do not affect choices.
CLEARANCE_DIAGNOSTICS = {
    "slot_configurations_refined": 0,
    "configuration_refinement_updates": 0,
    "maximum_refinement_updates": 0,
    "uncertified_slot_configurations": 0,
}


@dataclass(frozen=True)
class BatchARResult:
    bits: np.ndarray
    joules: np.ndarray
    pa_j: np.ndarray
    circuit_j: np.ndarray
    baseband_j: np.ndarray
    decoding_time_s: np.ndarray
    feasible: np.ndarray
    attained: np.ndarray
    residual_w: np.ndarray
    mode_counts: np.ndarray
    target_mode_counts: np.ndarray
    transmitted_mode_counts: np.ndarray
    realised_decode_successes: np.ndarray
    realised_decode_failures: np.ndarray
    plateau_users: np.ndarray
    transmissions: np.ndarray
    cap_hits: np.ndarray
    valid: np.ndarray
    certificate_status: np.ndarray
    certificate_iterations: np.ndarray
    max_rf_power_w: np.ndarray
    min_decoding_margin_db: np.ndarray
    mean_acm_se_bit_s_hz: np.ndarray


def _readonly(value: np.ndarray) -> np.ndarray:
    result = np.asarray(value)
    result.setflags(write=False)
    return result


def _slot_grid(maximum_occupancy: int) -> tuple[np.ndarray, np.ndarray]:
    boundaries = {0.0, 1.0}
    for occupancy in range(1, maximum_occupancy + 1):
        boundaries.update(index / occupancy for index in range(1, occupancy))
    ordered = np.asarray(sorted(boundaries), dtype=np.float64)
    return (ordered[1:] - ordered[:-1], (ordered[1:] + ordered[:-1]) / 2.0)


def _evaluate_ar_tdm_catalogue_core(
    arrays: PrimitiveStepArrays,
    selected_rows: np.ndarray,
    *,
    field: str = "realised",
    chunk_size: int = 256,
    rate_target_bps: float = RATE_TARGET_BPS,
    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
    boundary_indices: tuple[int, ...] = tuple(range(48)),
    fading_quantile_alpha: float | None = None,
) -> BatchARResult:
    """Evaluate ``C x U`` selected candidate-row indices without row objects.

    A row index of ``-1`` is the explicit null action.  The common rational
    TDM partition is an exact refinement of every configuration's scalar slot
    partition, so splitting a constant slot cannot alter rates or energy.
    """

    rows_all = np.asarray(selected_rows, dtype=np.int64)
    if rows_all.ndim != 2 or rows_all.shape[1] != arrays.users.size:
        raise MCRLContractError("selected_rows must have shape (configurations, users)")
    if field not in {"nominal", "margin", "realised"}:
        raise MCRLContractError("batch field must be nominal, margin, or realised")
    if fading_quantile_alpha is not None and (
        not math.isfinite(fading_quantile_alpha)
        or not 0.0 < fading_quantile_alpha < 1.0
    ):
        raise MCRLContractError("fading quantile alpha must lie strictly in (0,1)")
    if field == "margin" and fading_quantile_alpha is None:
        raise MCRLContractError("margin field requires a fading quantile alpha")
    if (
        not boundary_indices
        or tuple(sorted(set(boundary_indices))) != boundary_indices
        or boundary_indices[0] < 0
        or boundary_indices[-1] >= 48
    ):
        raise MCRLContractError("boundary indices must be unique, ordered, and in 0..47")
    configurations, users = rows_all.shape
    modes = ACM_MODES
    thresholds = np.asarray([row.threshold_linear for row in modes])
    efficiencies = np.asarray([row.spectral_efficiency_bit_per_s_hz for row in modes])
    gamma = np.asarray(
        [0.0]
        + [
            np.nan if rate_target_sinr(rate_target_bps, BEAM_BANDWIDTH_HZ, n) is None
            else float(rate_target_sinr(rate_target_bps, BEAM_BANDWIDTH_HZ, n))
            for n in range(1, users + 1)
        ],
        dtype=np.float64,
    )
    target_mode_index = np.asarray(
        [0]
        + [
            0
            if rate_target_mode(rate_target_bps, BEAM_BANDWIDTH_HZ, n) is None
            else ACM_MODES.index(
                rate_target_mode(rate_target_bps, BEAM_BANDWIDTH_HZ, n)
            )
            + 1
            for n in range(1, users + 1)
        ],
        dtype=np.int64,
    )
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    bits = np.zeros((configurations, users), dtype=np.float64)
    decoding = np.zeros_like(bits)
    feasible_all = np.ones((configurations, users), dtype=np.bool_)
    residual_max = np.zeros(configurations, dtype=np.float64)
    components = np.zeros((configurations, 3), dtype=np.float64)
    mode_counts = np.zeros((configurations, len(modes) + 1), dtype=np.int64)
    target_mode_counts = np.zeros_like(mode_counts)
    transmitted_mode_counts = np.zeros_like(mode_counts)
    realised_decode_successes = np.zeros(configurations, dtype=np.int64)
    realised_decode_failures = np.zeros(configurations, dtype=np.int64)
    plateau = np.ones((configurations, users), dtype=np.bool_)
    seen = np.zeros((configurations, users), dtype=np.bool_)
    transmissions = np.zeros(configurations, dtype=np.int64)
    cap_hits = np.zeros(configurations, dtype=np.int64)
    valid_result = np.ones(configurations, dtype=np.bool_)
    # 0=INVALID, 1=CONVERGED, 2=CONVERGED_SLOW.  A configuration receives
    # the worst certificate observed over its slots and selected boundaries.
    certificate_status = np.ones(configurations, dtype=np.int8)
    certificate_iterations = np.zeros(configurations, dtype=np.int64)
    max_rf_power_w = np.zeros(configurations, dtype=np.float64)
    min_decoding_margin_db = np.full(configurations, np.inf, dtype=np.float64)
    acm_se_sum = np.zeros(configurations, dtype=np.float64)
    acm_se_count = np.zeros(configurations, dtype=np.int64)
    row_to_aggressor = {
        (int(identity[0]), int(identity[1])): index
        for index, identity in enumerate(arrays.aggressor_identities)
    }
    row_aggressor = np.asarray(
        [
            row_to_aggressor.get((int(identity[0]), int(identity[1])), -1)
            for identity in arrays.identities
        ],
        dtype=np.int64,
    )
    beam_code_of = {
        identity: index
        for index, identity in enumerate(
            sorted({(int(row[0]), int(row[1])) for row in arrays.identities.tolist()})
        )
    }
    row_beam_code = np.asarray(
        [
            beam_code_of[(int(identity[0]), int(identity[1]))]
            for identity in arrays.identities
        ],
        dtype=np.int64,
    )
    # Keep rare high-occupancy evacuation profiles out of ordinary chunks;
    # otherwise one such row forces every neighbouring unilateral through a
    # much finer universal rational slot grid.
    initial_maximum = np.zeros(configurations, dtype=np.int64)
    for config_index, selected in enumerate(rows_all):
        selected_codes = row_beam_code[selected[selected >= 0]]
        if selected_codes.size:
            initial_maximum[config_index] = int(
                np.max(np.unique(selected_codes, return_counts=True)[1])
            )
    order = np.argsort(initial_maximum, kind="stable")
    inverse_order = np.argsort(order)
    rows_all = rows_all[order]
    satellite_of = {
        int(identity[0]): int(column)
        for identity, column in zip(
            arrays.aggressor_identities,
            arrays.aggressor_satellite_column,
            strict=True,
        )
    }
    row_satellite = np.asarray(
        [satellite_of.get(int(identity[0]), 0) for identity in arrays.identities],
        dtype=np.int64,
    )
    user_axis = np.arange(users, dtype=np.int64)
    lower_user = user_axis[None, None, :] < user_axis[None, :, None]
    # Quantiles belong to immutable candidate rows, not configurations.  Build
    # each boundary's row table once and gather from it in every catalogue
    # chunk; recomputing unique bins over C x U selections dominated the real
    # four-worker gate despite every scalar quantile already being cached.
    quantile_by_boundary = (
        {}
        if fading_quantile_alpha is None
        else {
            boundary: fading_product_quantile_array(
                arrays.elevations_deg[boundary], fading_quantile_alpha
            )
            for boundary in boundary_indices
        }
    )

    for low in range(0, configurations, chunk_size):
        high = min(configurations, low + chunk_size)
        selected = rows_all[low:high]
        count = high - low
        valid_assignment = selected >= 0
        safe_rows = np.maximum(selected, 0)
        aggressor = row_aggressor[safe_rows]
        safe_aggressor = np.maximum(aggressor, 0)
        beam_code = row_beam_code[safe_rows]
        victim_color = arrays.colors[safe_rows]
        wanted_slot = arrays.row_wanted_slot[safe_rows]
        aggressor_color = victim_color
        aggressor_satellite = row_satellite[safe_rows]
        aggressor_norad = arrays.identities[safe_rows, 0]
        previous_rate = previous_decode = previous_energy = None

        previous_boundary = None
        for boundary in boundary_indices:
            live = valid_assignment & arrays.visible[boundary, safe_rows] \
                & arrays.d2_eligible[boundary, safe_rows] \
                & arrays.cell_reachable[boundary, safe_rows]

