"""Unsealed ladder-floor scalar diagnostic; never edits the declared engine.

`census(tape, step_index, assignments, formulation)` returns JSON-safe counts
and compact distributions. Histograms round to 0.01 dB (maximum rounding
error 0.005 dB); exact extrema and means are retained. Duration weights are
native TDM slot fraction times the 48-point trapezoid boundary weight.
"""

from __future__ import annotations

from collections import Counter, defaultdict
from contextlib import contextmanager
from dataclasses import replace
import math
from typing import Mapping

import numpy as np

from mcrl.physics_v025 import architectures
from mcrl.physics_v025.channel import fading_product_quantile
from mcrl.physics_v025.energy import schedule_energy


SCALAR_CLEARANCE_DIAGNOSTICS = Counter()


@contextmanager
def scalar_formulation(formulation: str):
    """Temporarily replace only the scalar power target for the margin copy.

    Process-local and not thread-safe. The original helper is restored even
    when evaluation raises; nested invocations are rejected.
    """

    if formulation not in {"original", "margin", "margin-cleared"}:
        raise ValueError("formulation must be original, margin, or margin-cleared")
    if formulation == "original":
        yield
        return
    original = architectures._rate_targets
    original_solve = architectures._solve_power
    if getattr(original, "_ladder_floor_variant", False):
        raise RuntimeError("nested scalar margin patches are not supported")

    target_metadata = {}

    def margin_targets(config, geometry, active, members):
        values, forced, reported, modes = original(config, geometry, active, members)
        if config.fading_quantile_alpha is None:
            raise ValueError("margin provisioning requires a fading quantile")
        quantiles = np.asarray(
            [
                fading_product_quantile(
                    geometry.links[index].elevation_deg,
                    config.fading_quantile_alpha,
                )
                for index in active
            ],
            dtype=np.float64,
        )
        provisioned = values.copy()
        provisioned[~forced] /= quantiles[~forced]
        reported_provisioned = tuple(
            None if value is None else float(value / quantile)
            for value, quantile in zip(reported, quantiles, strict=True)
        )
        target_metadata.update(
            user_ids=tuple(geometry.links[index].user_id for index in active),
            quantiles=quantiles,
            thresholds=np.asarray([
                np.nan if mode is None else mode.threshold_linear for mode in modes
            ]),
        )
        return provisioned, forced, reported_provisioned, modes

    def cleared_solve(
        direct, coupling, noise, caps, active_user_ids, config, *,
        target_sinr=None, force_cap=None, enforce_target_clearance=False,
    ):
        power, certificate = original_solve(
            direct, coupling, noise, caps, active_user_ids, config,
            target_sinr=target_sinr, force_cap=force_cap,
            enforce_target_clearance=enforce_target_clearance,
        )
        SCALAR_CLEARANCE_DIAGNOSTICS["calls"] += 1
        if not certificate.valid:
            return power, certificate
        if target_sinr is None or target_metadata.get("user_ids") != active_user_ids:
            raise RuntimeError("strict scalar clearance lacks matching rate-target metadata")
        targets = np.asarray(target_sinr, dtype=np.float64)
        forced = np.zeros_like(power, dtype=np.bool_) if force_cap is None else np.asarray(force_cap, dtype=np.bool_)
        quantiles = target_metadata["quantiles"]
        thresholds = target_metadata["thresholds"]
        remaining = config.solver_iteration_cap - certificate.iterations
        updates = 0
        while True:
            denominators = noise + coupling @ power
            nominal = power * direct / denominators
            deficient = (~forced) & (power < caps) & (
                (nominal < targets) | (nominal * quantiles < thresholds)
            )
            if not np.any(deficient):
                if updates:
                    SCALAR_CLEARANCE_DIAGNOSTICS["refined_calls"] += 1
                SCALAR_CLEARANCE_DIAGNOSTICS["max_updates_per_slot"] = max(
                    SCALAR_CLEARANCE_DIAGNOSTICS["max_updates_per_slot"], updates
                )
                return power, replace(certificate, iterations=certificate.iterations + updates)
            if updates >= remaining:
                SCALAR_CLEARANCE_DIAGNOSTICS["failed_clearances"] += 1
                return power, replace(certificate, status="INVALID", iterations=certificate.iterations + updates)
            required = targets * denominators / direct
            candidate = np.minimum(caps, np.nextafter(required * (1.0 + 2.0e-9), np.inf))
            power[deficient] = np.maximum(power[deficient], candidate[deficient])
            SCALAR_CLEARANCE_DIAGNOSTICS["updated_transmission_rows"] += int(np.sum(deficient))
            SCALAR_CLEARANCE_DIAGNOSTICS["total_refinement_rounds"] += 1
            updates += 1

    margin_targets._ladder_floor_variant = True
    architectures._rate_targets = margin_targets
    if formulation == "margin-cleared":
        architectures._solve_power = cleared_solve
    try:
        yield
    finally:
        architectures._rate_targets = original
        architectures._solve_power = original_solve


class _Histogram:
    def __init__(self):
        self.count = 0
        self.weight = 0.0
        self.total = 0.0
        self.weighted_total = 0.0
        self.minimum = math.inf
        self.maximum = -math.inf
        self.bins = defaultdict(lambda: [0, 0.0])

    def add(self, value: float, weight: float):
        if not math.isfinite(value):
            raise ValueError("nonfinite samples must be counted separately")
        self.count += 1
        self.weight += weight
        self.total += value
        self.weighted_total += value * weight
        self.minimum = min(self.minimum, value)
        self.maximum = max(self.maximum, value)
        key = int(math.floor(value * 100.0 + 0.5))
        self.bins[key][0] += 1
        self.bins[key][1] += weight

    def payload(self):
        return {
            "bin_width_db": 0.01,
            "count": self.count,
            "weight_s": self.weight,
            "min": None if not self.count else self.minimum,
            "max": None if not self.count else self.maximum,
            "sum": self.total,
            "weighted_sum": self.weighted_total,
            "mean": None if not self.count else self.total / self.count,
            "duration_weighted_mean": (
                None if not self.weight else self.weighted_total / self.weight
            ),
            "bins": [
                [key / 100.0, count, weight]
                for key, (count, weight) in sorted(self.bins.items())
            ],
        }


def _boundary_weights(times):
    result = np.zeros(len(times), dtype=np.float64)
    differences = np.diff(np.asarray(times, dtype=np.float64))
    if np.any(differences <= 0.0):
        raise ValueError("geometry times must increase")
    result[:-1] += differences / 2.0
    result[1:] += differences / 2.0
    return result


def census(
    tape,
    step_index: int,
    assignments: Mapping[int, tuple[int, int] | None],
    formulation: str,
    *,
    alpha: float = 0.10,
) -> dict:
    """Census actual scalar TDM attempts over one real 48-boundary anchor.

    `nominal_target_margin_db` uses the unmodified target mode threshold;
    `nominal_provisioned_target_margin_db` uses the threshold requested from
    the solver, including the variant fade margin when applicable.
    `served_target_miss` counts decoded attempts whose SE is below r*n/W;
    it is distinct from complete user-step target attainment.
    """

    samples = tape.geometry_for(step_index=step_index, assignments=assignments)
    if len(samples) != 48:
        raise ValueError("anchor census requires all 48 native boundaries")
    times = [time_s for time_s, _ in samples]
    weights = _boundary_weights(times)
    config = architectures.RadiationConfig(fading_quantile_alpha=alpha)
    engine = architectures.AngleRateTPC_TDM()
    occupancy_counts = defaultdict(Counter)
    modes = Counter()
    margins = {
        name: _Histogram()
        for name in (
            "nominal_tx_margin_db",
            "realised_tx_margin_db",
            "realised_tx_margin_served_db",
            "nominal_target_margin_db",
            "nominal_provisioned_target_margin_db",
            "q_margin_db",
            "elevation_deg",
        )
    }
    total = Counter()
    per_user_bits = {int(user): 0.0 for user in assignments}
    per_user_decode_s = {int(user): 0.0 for user in assignments}
    decoded_users_any = set()
    boundary_bits = 0.0
    integrated_joules = 0.0
    boundary_zero_beams = []
    minimum_residual = math.inf
    maximum_residual = 0.0
    with scalar_formulation(formulation):
        for boundary, ((time_s, geometry), boundary_weight) in enumerate(
            zip(samples, weights, strict=True)
        ):
            radiation = engine.radiate(config, geometry, "realised")
            if not radiation.valid:
                raise RuntimeError(f"invalid scalar certificate at boundary {boundary}")
            energy = schedule_energy(
                tape.inventory,
                ((slot.fraction, dict(slot.beam_rf_w)) for slot in radiation.slots),
                duration_s=1.0,
                idle_power_w=0.0,
            )
            integrated_joules += float(boundary_weight * energy.joules)
            minimum_residual = min(minimum_residual, radiation.certificate.residual_w)
            maximum_residual = max(maximum_residual, radiation.certificate.residual_w)
            by_beam = Counter(link.beam for link in geometry.links)
            for n in by_beam.values():
                occupancy_counts[n]["beam_boundaries"] += 1
                occupancy_counts[n]["beam_duration_s"] += float(boundary_weight)
            elevation_by_user = {link.user_id: link.elevation_deg for link in geometry.links}
            rates = Counter()
            all_decoded = {}
            any_decoded = set()
            any_mode = set()
            for slot in radiation.slots:
                for tx in slot.transmissions:
                    n = by_beam[tx.beam]
                    row = occupancy_counts[n]
                    weight_s = float(boundary_weight * slot.fraction)
                    has_mode = tx.m_tx is not None
                    decoded = bool(tx.realised_outcome.decoded)
                    cap_hit = tx.rf_power_w >= config.beam_cap_w - 1.0e-9
                    se = 0.0 if not has_mode else tx.m_tx.spectral_efficiency_bit_per_s_hz
                    target_miss = decoded and se < config.rate_target_bps * n / config.bandwidth_hz
                    flags = {
                        "attempts": True,
                        "no_mode": not has_mode,
                        "no_mode_uncapped": not has_mode and not cap_hit,
                        "has_mode": has_mode,
                        "decoded": decoded,
                        "decode_failure_with_mode": has_mode and not decoded,
                        "cap_hits": cap_hit,
                        "served_target_miss": target_miss,
                        "served_target_miss_uncapped": target_miss and not cap_hit,
                    }
                    for name, flag in flags.items():
                        if flag:
                            row[name] += 1
                            row[name + "_duration_s"] += weight_s
                            total[name] += 1
                            total[name + "_duration_s"] += weight_s
                    target_name = None if tx.m_target is None else tx.m_target.name
                    mode_name = None if tx.m_tx is None else tx.m_tx.name
                    modes[(target_name or "NO_TARGET", mode_name or "NO_MODE")] += 1
                    elevation = float(elevation_by_user[tx.user_id])
                    quantile = fading_product_quantile(elevation, alpha)
                    q_margin = -10.0 * math.log10(quantile)
                    margins["q_margin_db"].add(q_margin, weight_s)
                    margins["elevation_deg"].add(elevation, weight_s)
                    nominal_db = 10.0 * math.log10(tx.nominal_sinr)
                    if tx.m_target is not None:
                        margins["nominal_target_margin_db"].add(
                            nominal_db - tx.m_target.threshold_db, weight_s
                        )
                    if tx.rate_target_sinr is not None:
                        margins["nominal_provisioned_target_margin_db"].add(
                            nominal_db - 10.0 * math.log10(tx.rate_target_sinr), weight_s
                        )
                    if has_mode:
                        nominal_margin = nominal_db - tx.m_tx.threshold_db
                        realised_margin = 10.0 * math.log10(tx.sinr) - tx.m_tx.threshold_db
                        margins["nominal_tx_margin_db"].add(nominal_margin, weight_s)
                        margins["realised_tx_margin_db"].add(realised_margin, weight_s)
                        if decoded:
                            margins["realised_tx_margin_served_db"].add(realised_margin, weight_s)
                    rates[tx.user_id] += (
                        slot.fraction
                        * tx.bandwidth_hz
                        * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
                    )
                    all_decoded[tx.user_id] = all_decoded.get(tx.user_id, True) and decoded
                    if decoded:
                        decoded_users_any.add(tx.user_id)
                        any_decoded.add(tx.user_id)
                    if has_mode:
                        any_mode.add(tx.user_id)
            if boundary == 0:
                boundary_bits = float(sum(rates.values()) * (times[-1] - times[0]))
                boundary_zero_beams = [
                    {
                        "identity": list(beam),
                        "occupancy": n,
                        "users": sorted(link.user_id for link in geometry.links if link.beam == beam),
                        "served_users": sorted(link.user_id for link in geometry.links if link.beam == beam and link.user_id in any_decoded),
                        "has_mode_users": sorted(link.user_id for link in geometry.links if link.beam == beam and link.user_id in any_mode),
                        "no_mode_users": sorted(link.user_id for link in geometry.links if link.beam == beam and link.user_id not in any_mode),
                    }
                    for beam, n in sorted(by_beam.items())
                ]
            for link in geometry.links:
                n = by_beam[link.beam]
                occupancy_counts[n]["user_boundaries"] += 1
                occupancy_counts[n]["decoded_user_boundaries"] += int(link.user_id in any_decoded)
                occupancy_counts[n]["no_mode_user_boundaries"] += int(link.user_id not in any_mode)
            for user in per_user_bits:
                per_user_bits[user] += float(boundary_weight * rates[user])
                per_user_decode_s[user] += float(boundary_weight * all_decoded.get(user, False))

    count_keys = (
        "attempts", "no_mode", "no_mode_uncapped", "has_mode", "decoded",
        "decode_failure_with_mode", "cap_hits", "served_target_miss", "served_target_miss_uncapped",
    )
    def normalize(row):
        for key in count_keys:
            row.setdefault(key, 0)
            row.setdefault(key + "_duration_s", 0.0)
        row["no_mode_share"] = row["no_mode"] / row["attempts"] if row["attempts"] else None
        row["no_mode_duration_share"] = (
            row["no_mode_duration_s"] / row["attempts_duration_s"]
            if row["attempts_duration_s"] else None
        )
        return dict(row)

    duration = times[-1] - times[0]
    return {
        "schema": "ladder-floor-scalar-census-v1",
        "formulation": formulation,
        "step_index": step_index,
        "alpha": alpha,
        "boundaries": len(samples),
        "duration_s": duration,
        "counts_unit": "one transmission in a native scalar TDM slot at one boundary",
        "duration_weights": "native TDM fraction times trapezoid boundary weight",
        "counts": normalize(total),
        "by_occupancy": {str(n): normalize(row) for n, row in sorted(occupancy_counts.items())},
        "mode_transitions": [
            [target, tx, count] for (target, tx), count in sorted(modes.items())
        ],
        "boundary_zero_beams": boundary_zero_beams,
        "distributions": {name: hist.payload() for name, hist in margins.items()},
        "scalar_integrated_bits": float(sum(per_user_bits.values())),
        "scalar_integrated_joules": integrated_joules,
        "scalar_boundary_zero_bits": boundary_bits,
        "scalar_served_users": sum(value > 0.0 for value in per_user_decode_s.values()),
        "decoded_users_any_attempt": len(decoded_users_any),
        "rate_target_attained_users": sum(
            value >= config.rate_target_bps * duration for value in per_user_bits.values()
        ),
        "per_user_bits": {str(user): value for user, value in per_user_bits.items()},
        "solver_residual_w_min": minimum_residual,
        "solver_residual_w_max": maximum_residual,
    }


__all__ = ["SCALAR_CLEARANCE_DIAGNOSTICS", "census", "scalar_formulation"]
"""Produce compact report inputs; full mode requires all 20 matched anchors."""
from __future__ import annotations

import argparse
from collections import Counter, defaultdict
import gzip
import hashlib
import json
import math
from pathlib import Path

HERE = Path(__file__).resolve().parent
ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
FORMS = ("original", "margin")
COUNT_KEYS = ("attempts", "no_mode", "no_mode_uncapped", "has_mode", "decoded", "served_target_miss", "served_target_miss_uncapped", "decode_failure_with_mode", "cap_hits")
DISTRIBUTIONS = ("q_margin_db", "elevation_deg", "nominal_tx_margin_db", "realised_tx_margin_db", "realised_tx_margin_served_db", "nominal_target_margin_db", "nominal_provisioned_target_margin_db")


def counts(rows):
    out = {}
    for key in COUNT_KEYS:
        out[key] = sum(int(row.get(key, 0)) for row in rows)
        out[key + "_duration_s"] = math.fsum(float(row.get(key + "_duration_s", 0.0)) for row in rows)
    for key in ("no_mode", "no_mode_uncapped", "decoded"):
        out[key + "_share"] = out[key] / out["attempts"] if out["attempts"] else None
        out[key + "_duration_share"] = out[key + "_duration_s"] / out["attempts_duration_s"] if out["attempts_duration_s"] else None
    out["served_target_miss_share_of_decoded"] = out["served_target_miss"] / out["decoded"] if out["decoded"] else None
    return out


def compact_distribution(hist):
    def five(quantiles):
        return {"min": hist["min"], "P05": quantiles["0.05"], "P50": quantiles["0.5"], "P95": quantiles["0.95"], "max": hist["max"]}
    return {
        "count": hist["count"], "duration_s": hist["weight_s"],
        "attempt_weighted": five(hist["quantiles"]),
        "duration_weighted": five(hist["duration_weighted_quantiles"]),
        "quantile_bin_width": hist["quantile_bin_width"],
    }


def merged_distribution(form, name, census, histogram_payload):
    """Development fallback for first1 sample made before ALL was added."""
    hists = [census["pooled"][form][arm]["distributions"][name] for arm in ARMS]
    bins = defaultdict(lambda: [0, []])
    for arm in ARMS:
        for value, count, weight in histogram_payload[form][arm][name]:
            bins[value][0] += count
            bins[value][1].append(weight)
    ordered = [[key, val[0], math.fsum(val[1])] for key, val in sorted(bins.items())]
    def quantile(probability, column):
        if not ordered:
            return None
        target = math.fsum(row[column] for row in ordered) * probability
        cumulative = 0.0
        for row in ordered:
            cumulative += row[column]
            if cumulative >= target:
                return row[0]
        return ordered[-1][0]
    present = [h for h in hists if h["count"]]
    return compact_distribution({
        "count": sum(h["count"] for h in hists),
        "weight_s": math.fsum(h["weight_s"] for h in hists),
        "min": min(h["min"] for h in present) if present else None,
        "max": max(h["max"] for h in present) if present else None,
        "quantiles": {str(p): quantile(p, 1) for p in (0.05, 0.5, 0.95)},
        "duration_weighted_quantiles": {str(p): quantile(p, 2) for p in (0.05, 0.5, 0.95)},
        "quantile_bin_width": 0.01,
    })


def load_json(path):
    return json.loads(path.read_text())


def make_report(*, allow_prefix=False, census_path=None, margin_formulation="margin"):
    forms = ("original", margin_formulation)
    census_path = census_path or HERE / "scalar-census-summary.json"
    if allow_prefix and not census_path.exists():
        census_path = HERE / "scalar-census-summary-first1.json"
    census = load_json(census_path)
    if not census["parity_passed"]:
        raise RuntimeError("scalar/batch parity failed")
    ids = {row["anchor_id"] for row in census["anchors"]}
    if len(ids) != census["anchor_count"]:
        raise RuntimeError("census anchor count mismatch")
    if not allow_prefix and len(ids) != 20:
        raise RuntimeError("final report requires 20 census anchors")
    result_paths = {}
    results = {}
    for form in forms:
        path = HERE / f"{form}-result.json"
        if allow_prefix and not path.exists():
            path = HERE / f"{form}-result.checkpoint.json"
        result_paths[form] = path
        source = load_json(path)
        available = {row["anchor_id"]: row for row in source["anchors"]}
        if not ids <= set(available) or (not allow_prefix and set(available) != ids):
            raise RuntimeError(f"{form} anchor coverage mismatch")
        results[form] = [row for row in source["anchors"] if row["anchor_id"] in ids]
    for old, new in zip(results["original"], results[margin_formulation], strict=True):
        if (old["anchor_id"], old["world_sha256"]) != (new["anchor_id"], new["world_sha256"]):
            raise RuntimeError("formulations do not share identical anchors and tapes")
    histogram_payload = None
    if any("ALL" not in census["pooled"][form] for form in forms):
        hist_path = census_path.parent / census["histograms_file"]
        histogram_payload = json.loads(gzip.decompress(hist_path.read_bytes()))

    out = {
        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM", "anchor_count": len(ids),
        "complete_20_anchor_panel": len(ids) == 20 and not allow_prefix,
        "census_parity_passed": True,
        "counts_unit": "one transmission in a native scalar TDM slot at one boundary",
        "duration_weights": "native TDM fraction times trapezoid boundary weight; primary comparable NO_MODE share",
        "served_count_definition": "dense committed endpoint: any decoded attempt contributes service; separate from rate-target attainment",
        "sources": {form: {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()} for form, path in result_paths.items()},
        "census_source": {"path": str(census_path), "sha256": hashlib.sha256(census_path.read_bytes()).hexdigest()},
        "formulations": {},
    }
    for form in forms:
        anchors = results[form]
        arms = {}
        for arm in ARMS:
            bits = math.fsum(row["committed"][arm]["bits"] for row in anchors)
            joules = math.fsum(row["committed"][arm]["joules"] for row in anchors)
            values = census["pooled"][form][arm]
            arms[arm] = {
                "bits": bits, "joules": joules, "ee_bit_per_j": bits / joules,
                "served_count_sum": sum(row["committed"][arm]["served_count"] for row in anchors),
                "rate_target_attained_users_sum": values["rate_target_attained_users_sum"],
                "counts": counts([values["counts"]]),
                "by_occupancy": {n: counts([local]) for n, local in values["by_occupancy"].items()},
                "distributions": {name: compact_distribution(values["distributions"][name]) for name in DISTRIBUTIONS},
            }
        all_occupancies = sorted({n for arm in ARMS for n in arms[arm]["by_occupancy"]}, key=int)
        arms["ALL"] = {
            "rate_target_attained_users_sum": sum(arms[arm]["rate_target_attained_users_sum"] for arm in ARMS),
            "counts": counts([arms[arm]["counts"] for arm in ARMS]),
            "by_occupancy": {n: counts([arms[arm]["by_occupancy"].get(n, {}) for arm in ARMS]) for n in all_occupancies},
            "distributions": {
                name: compact_distribution(census["pooled"][form]["ALL"]["distributions"][name])
                if "ALL" in census["pooled"][form]
                else merged_distribution(form, name, census, histogram_payload)
                for name in DISTRIBUTIONS
            },
        }
        gains = [row["committed"]["ORACLE_SET"]["ee_bit_per_j"] / row["committed"]["UNILATERAL"]["ee_bit_per_j"] - 1 for row in anchors]
        primary_families = Counter()
        all_alias_families = Counter()
        for row in anchors:
            aliases = row["selection"]["selected_candidate_aliases"]
            primary_families[aliases[0]["family"] if aliases else "UNILATERAL_RETAINED"] += 1
            all_alias_families.update(alias["family"] for alias in aliases)
        out["formulations"][form] = {
            "arms": arms,
            "oracle_over_unilateral_pct": 100 * (arms["ORACLE_SET"]["ee_bit_per_j"] / arms["UNILATERAL"]["ee_bit_per_j"] - 1),
            "unilateral_over_baseline_pct": 100 * (arms["UNILATERAL"]["ee_bit_per_j"] / arms["BASELINE"]["ee_bit_per_j"] - 1),
            "positive_oracle_ee_anchors": sum(g > 0 for g in gains),
            "negative_oracle_ee_anchors": sum(g < 0 for g in gains),
            "zero_oracle_ee_anchors": sum(g == 0 for g in gains),
            "qualifying_set_count": sum(row["selection"]["qualifying_coalition_existed"] for row in anchors),
            "selected_primary_families": dict(primary_families),
            "selected_all_alias_families": dict(all_alias_families),
        }
    return out


def fmt(value, digits=6):
    return "NA" if value is None else f"{value:.{digits}f}"


def tables(data):
    lines = [f"Panel: {data['anchor_count']} anchors; final={data['complete_20_anchor_panel']}", "", "| Formulation | Arm | Bits | J | EE bit/J | Served | Rate attained |", "|---|---|---:|---:|---:|---:|---:|"]
    for form, result in data["formulations"].items():
        for arm in ARMS:
            row = result["arms"][arm]
            lines.append(f"| {form} | {arm} | {fmt(row['bits'],3)} | {fmt(row['joules'])} | {fmt(row['ee_bit_per_j'])} | {row['served_count_sum']} | {row['rate_target_attained_users_sum']} |")
    lines.append("")
    for form, result in data["formulations"].items():
        lines.append(f"{form}: O/U={result['oracle_over_unilateral_pct']:+.6f}%; U/B={result['unilateral_over_baseline_pct']:+.6f}%; positive/negative/zero EE anchors={result['positive_oracle_ee_anchors']}/{result['negative_oracle_ee_anchors']}/{result['zero_oracle_ee_anchors']}; qualifying={result['qualifying_set_count']}; families={result['selected_primary_families']}")
    lines += ["", "| Form | Arm | NO_MODE / attempts | Attempt % | Duration % | Uncapped NO_MODE | Decoded | Served rate miss |", "|---|---|---:|---:|---:|---:|---:|---:|"]
    for form, result in data["formulations"].items():
        for arm, values in result["arms"].items():
            row = values["counts"]
            lines.append(f"| {form} | {arm} | {row['no_mode']} / {row['attempts']} | {fmt(100*row['no_mode_share'],3)} | {fmt(100*row['no_mode_duration_share'],3)} | {row['no_mode_uncapped']} | {row['decoded']} | {row['served_target_miss']} |")
    lines += ["", "| Form | Occupancy, ALL arms | NO_MODE / attempts | Attempt % | Duration % | Uncapped NO_MODE | Decoded |", "|---|---:|---:|---:|---:|---:|---:|"]
    for form, result in data["formulations"].items():
        for n, row in result["arms"]["ALL"]["by_occupancy"].items():
            lines.append(f"| {form} | {n} | {row['no_mode']} / {row['attempts']} | {fmt(100*row['no_mode_share'],3)} | {fmt(100*row['no_mode_duration_share'],3)} | {row['no_mode_uncapped']} | {row['decoded']} |")
    lines += ["", "Distributions below use duration weighting for P05/P50/P95; min/max are unrounded extrema. All distributions and both weightings are in report-data.json.", "", "| Form | Arm | Distribution | min | P05 | P50 | P95 | max |", "|---|---|---|---:|---:|---:|---:|---:|"]
    for form, result in data["formulations"].items():
        for arm, values in result["arms"].items():
            for name in DISTRIBUTIONS[:5]:
                row = values["distributions"][name]["duration_weighted"]
                lines.append(f"| {form} | {arm} | {name} | " + " | ".join(fmt(row[key],3) for key in ("min","P05","P50","P95","max")) + " |")
    return "\n".join(lines) + "\n"


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--allow-prefix", action="store_true")
    parser.add_argument("--census", type=Path)
    parser.add_argument("--margin-formulation", choices=("margin", "margin-cleared"), default="margin")
    parser.add_argument("--output", type=Path, default=HERE / "report-data.json")
    args = parser.parse_args()
    result = make_report(allow_prefix=args.allow_prefix, census_path=args.census, margin_formulation=args.margin_formulation)
    args.output.write_text(json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n")
    table_text = tables(result)
    args.output.with_suffix(".tables.md").write_text(table_text)
    print(table_text)
#!/usr/bin/env python3
"""Fill the diagnostic report from the complete, verified strict experiment."""
import json
import math
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
REPORT = ROOT / "LADDER-FLOOR-2026-09-10.md"
data = json.loads((HERE / "report-data-cleared.json").read_text())
census = json.loads((HERE / "scalar-census-summary-cleared.json").read_text())
activation = json.loads((HERE / "activation-signatures-cleared.json").read_text())
reproduction = json.loads((HERE / "original-reproduction-audit.json").read_text())
assert data["complete_20_anchor_panel"] and census["parity_passed"]
assert reproduction["committed_endpoints_and_configuration_ids_exact"]
forms = data["formulations"]
original, margin = forms["original"], forms["margin-cleared"]
assert margin["arms"]["ALL"]["counts"]["no_mode_uncapped"] == 0
assert margin["arms"]["ALL"]["counts"]["served_target_miss_uncapped"] == 0
gain = margin["oracle_over_unilateral_pct"]
assert 0 < gain < 6.359  # If the completed outcome changes, rewrite the interpretation.
text = REPORT.read_text()
text = text.split("\n", 1)[1]
text = f"The claimed occupancy-activation consolidation mechanism does not survive; oracle-over-unilateral gain falls from +6.359% to {gain:+.3f}%.\n" + text

table = [
    "| Formulation | Selector | Decoded bits (Gbit) | Energy (kJ) | Pooled EE (Mbit/J) | Served / 2,000 | Rate target attained / 2,000 |",
    "|---|---|---:|---:|---:|---:|---:|",
]
for key, label in (("original", "Original"), ("margin-cleared", "Margin provisioned")):
    for arm in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
        v = forms[key]["arms"][arm]
        table.append(f"| {label} | {arm} | {v['bits']/1e9:,.6f} | {v['joules']/1e3:,.6f} | {v['ee_bit_per_j']/1e6:,.6f} | {v['served_count_sum']:,} | {v['rate_target_attained_users_sum']:,} |")
start = text.index("| Formulation | Selector |")
end = text.index("\n\n**The decisive comparison", start)
text = text[:start] + "\n".join(table) + text[end:]
u, o = (margin["arms"][a] for a in ("UNILATERAL", "ORACLE_SET"))
energy_change = 100 * (o["joules"] / u["joules"] - 1)
bits_change = 100 * (o["bits"] / u["bits"] - 1)
decisive = (
    f"**The decisive comparison is +6.359000% versus {gain:+.6f}%.** EE is the ratio of summed bits to summed joules. "
    f"The percentage gain is {100*(1-gain/original['oracle_over_unilateral_pct']):.2f}% smaller. "
    f"In the variant, ORACLE_SET changes energy by {energy_change:+.4f}% and decoded bits by {bits_change:+.4f}% relative to UNILATERAL. "
    f"Its realised EE improves on {margin['positive_oracle_ee_anchors']} anchors and declines on {margin['negative_oracle_ee_anchors']}; the original improves on all 20. "
    f"Positive joint selection-objective improvements still exist on {margin['qualifying_set_count']}/20 variant anchors. "
    "This smaller residual coordination gain does not validate the rejected occupancy-activation mechanism."
)
start = text.index("**The decisive comparison")
end = text.index("\n\nThe selectors maximize", start)
text = text[:start] + decisive + text[end:]

lines = [
    "A numerical trap had to be resolved before this comparison was valid. Simply dividing the target by q while retaining the finite solver unchanged produced **+0.544766%**, but left **1,179 uncapped occupancy-one NO_MODE attempts**. Their deficits below the first threshold were only 5.76e−12 to 2.616e−9 dB, with at least 0.04317 W of cap headroom. The final private variant retains the original solve, then verifies both `SINR_nominal >= Gamma/q` and `q*SINR_nominal >= threshold_target`. It raises only deficient uncapped powers with the existing capped interference update and existing numerical nudge, within the original iteration budget. All selectors were reoptimized after this correction. The uncorrected control is retained separately; it is not the decisive result.",
    "",
    "The census covers all 48 boundaries of all 60 committed profiles per formulation. An attempt is one transmission in a native TDM slot at one boundary. Raw counts can repeat a user's transmission when another beam changes the slot partition; airtime shares weight by the slot fraction and trapezoid boundary duration, making them the more comparable exposure measure.",
    "",
    "| Formulation | Selector | NO_MODE / attempts | Attempt share | Airtime share | Uncapped NO_MODE |",
    "|---|---|---:|---:|---:|---:|",
]
for key, label in (("original", "Original"), ("margin-cleared", "Margin provisioned")):
    for arm in ("BASELINE", "UNILATERAL", "ORACLE_SET"):
        v = forms[key]["arms"][arm]["counts"]
        lines.append(f"| {label} | {arm} | {v['no_mode']:,} / {v['attempts']:,} | {100*v['no_mode_share']:.3f}% | {100*v['no_mode_duration_share']:.3f}% | {v['no_mode_uncapped']:,} |")
lines += [
    "", "Pooling the three selectors, the occupancy breakdown is:", "",
    "| Occupancy | Original NO_MODE / attempts (share) | Margin NO_MODE / attempts (share) | Original airtime share | Margin airtime share |",
    "|---:|---:|---:|---:|---:|",
]
old_occ = original["arms"]["ALL"]["by_occupancy"]
new_occ = margin["arms"]["ALL"]["by_occupancy"]
for n in sorted(set(old_occ) | set(new_occ), key=int):
    pair = (old_occ.get(n), new_occ.get(n))
    counts = ["No observations" if not v else f"{v['no_mode']:,} / {v['attempts']:,} ({100*v['no_mode_share']:.3f}%)" for v in pair]
    exposure = ["—" if not v else f"{100*v['no_mode_duration_share']:.3f}%" for v in pair]
    lines.append(f"| {n} | " + " | ".join(counts + exposure) + " |")
lines += [
    "",
    "These pooled rows mix different link geometries and selected assignments, so their relative outage rates also reflect those differences.",
    "",
    f"**Occupancies one and two are servable under the alternative.** They produce {new_occ['1']['decoded']:,} and {new_occ['2']['decoded']:,} decoded attempts respectively. Across the complete variant census there are **zero uncapped NO_MODE attempts and zero uncapped demoted-rate misses**. Remaining NO_MODE attempts occur at the RF cap. Realised fading can still prevent decoding after a mode is selected. In the original, occupancy one has no decoded attempts; occupancy two has {old_occ['2']['decoded']:,}, confirming that its prohibition was almost universal on these anchors, rather than absolute.",
    "",
