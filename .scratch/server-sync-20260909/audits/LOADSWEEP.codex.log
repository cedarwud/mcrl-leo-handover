@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python_bin=/home/sat/mcrl-leo-handover/.venv/bin/python
+scratch=.scratch/load-regime-sweep-20260910
+mkdir -p "$scratch/diagnostics" "$scratch/logs"
+
+run_one() {
+  set -euo pipefail
+  local result=$1
+  local stem output
+  stem=$(basename "$result" .json)
+  output="$scratch/diagnostics/$stem.json"
+  if [[ -f "$output" ]] && "$python_bin" -c \
+    'import json,sys; d=json.load(open(sys.argv[1])); raise SystemExit(not (d.get("parity_passed") is True and d.get("anchor_count")==8))' \
+    "$output"; then
+    echo "SKIP complete diagnostics $stem"
+    return
+  fi
+  PYTHONPATH=src \
+  OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \
+    nice -n 15 "$python_bin" "$scratch/diagnose_results.py" \
+    --result "$result" --output "$output" 2>&1 | tee "$scratch/logs/$stem-diagnostics.log"
+}
+export -f run_one
+export python_bin scratch
+
+printf '%s\n' "$scratch"/results/u*-r*-*.json | xargs -P 3 -n 1 bash -c 'run_one "$@"' _
