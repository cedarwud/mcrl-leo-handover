+++ b/.scratch/load-regime-sweep-20260910/build_report.py
@@ -0,0 +1,326 @@
+#!/usr/bin/env python3
+"""Validate all receipts and render the load/rate sweep report."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+import hashlib
+import json
+import math
+from pathlib import Path
+import subprocess
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+REPORT = ROOT / "LOAD-REGIME-SWEEP-2026-09-10.md"
+SEALED_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
+FORM_LABEL = {"sealed": "Sealed", "margin": "Margin"}
+POINTS = (
+    (100, 20),
+    (100, 35),
+    (100, 50),
+    (100, 65),
+    (100, 80),
+    (150, 50),
+    (200, 50),
+    (250, 50),
+    (150, 65),
+    (200, 80),
+    (250, 80),
+)
+LOAD_AXIS = ((100, 50), (150, 50), (200, 50), (250, 50))
+RATE_AXIS = ((100, 20), (100, 35), (100, 50), (100, 65), (100, 80))
+JOINT_POINTS = ((150, 65), (200, 80), (250, 80))
+
+
+def load_all():
+    results = {}
+    diagnostics = {}
+    for users, rate in POINTS:
+        for form in FORM_LABEL:
+            key = (users, rate, form)
+            rp = HERE / "results" / f"u{users}-r{rate}-{form}.json"
+            dp = HERE / "diagnostics" / f"u{users}-r{rate}-{form}.json"
+            if not rp.exists() or not dp.exists():
+                raise RuntimeError(f"missing completed artifact for {key}")
+            results[key] = json.loads(rp.read_text())
+            diagnostics[key] = json.loads(dp.read_text())
+    return results, diagnostics
+
+
+def pct(value):
+    return "—" if value is None else f"{100.0 * value:.3f}%"
+
+
+def number(value, digits=3):
+    return "—" if value is None else f"{value:.{digits}f}"
+
+
+def ee_mbit(result, arm):
+    return result["summary"]["pooled"][arm]["ee_bit_per_j"] / 1e6
+
+
+def gap_pct(result):
+    return 100.0 * result["summary"]["oracle_set_over_unilateral_relative"]
+
+
+def point_name(point):
+    users, rate = point
+    if point == (100, 50):
+        return "L100 / R50 (current)"
+    if point in LOAD_AXIS:
+        return f"L{users}"
+    if point in RATE_AXIS:
+        return f"R{rate}"
+    return f"J{users}-{rate}"
+
+
+def validate(results, diagnostics):
+    expected = {(u, r, f) for u, r in POINTS for f in FORM_LABEL}
+    assert set(results) == expected == set(diagnostics)
+    for key in expected:
+        result = results[key]
+        diag = diagnostics[key]
+        assert result["claim_ceiling"] == "DIAGNOSTIC_NOT_CLAIM"
+        assert result["status"] == "COMPLETE"
+        assert result["source_tree"] == SEALED_TREE
+        assert result["sealed_rate_target_bps"] == 50_000_000.0
+        assert result["sealed_constant_changed"] is False
+        assert result["test_split_opened"] is False
+        assert result["learner_used"] is False
+        assert result["policy_run_used"] is False
+        assert result["training_run_used"] is False
+        assert len(result["anchors"]) == 8
+        assert diag["anchor_count"] == 8 and diag["parity_passed"]
+        for arm in ARMS:
+            pooled = result["summary"]["pooled"][arm]
+            audit = diag["arms"][arm]
+            assert abs(audit["scalar_bits"] / pooled["bits"] - 1.0) < 1e-8
+            assert abs(audit["scalar_joules"] / pooled["joules"] - 1.0) < 1e-8
+            assert audit["served_count_sum"] == pooled["served_count_sum"]
+    # Rates share exactly the same projected tapes; load points share masters.
+    by_user_world = defaultdict(set)
+    master_by_world = defaultdict(set)
+    for (users, _rate, _form), result in results.items():
+        for world in result["worlds"]:
+            by_user_world[(users, world["world_index"])].add(world["world_sha256"])
+            master_by_world[world["world_index"]].add(world["master_world_sha256"])
+    assert all(len(values) == 1 for values in by_user_world.values())
+    assert all(len(values) == 1 for values in master_by_world.values())
+    archived_paths = {
+        "sealed": ROOT / ".scratch/ladder-floor-20260910/original-result.json",
+        "margin": ROOT / ".scratch/ladder-floor-20260910/margin-cleared-result.json",
+    }
+    for form, path in archived_paths.items():
+        archived = json.loads(path.read_text())
+        archived_by_id = {row["anchor_id"]: row for row in archived["anchors"]}
+        for row in results[(100, 50, form)]["anchors"]:
+            reference = archived_by_id[row["anchor_id"]]
+            for arm in ARMS:
+                for field in (
+                    "configuration_id",
+                    "bits",
+                    "joules",
+                    "served_count",
+                ):
+                    assert row["committed"][arm][field] == reference["committed"][arm][field]
+    assert subprocess.check_output(
+        ["git", "rev-parse", "HEAD^{tree}"], cwd=ROOT, text=True
+    ).strip() == SEALED_TREE
+
+
+def curve_phrase(results):
+    clauses = []
+    any_growth = False
+    for form in FORM_LABEL:
+        current = gap_pct(results[(100, 50, form)])
+        load_end = gap_pct(results[(250, 50, form)])
+        rate_end = gap_pct(results[(100, 80, form)])
+        joint_values = [
+            (gap_pct(results[(*point, form)]), point) for point in JOINT_POINTS
+        ]
+        joint_max, joint_point = max(joint_values)
+        load_grows = load_end > current + 0.1
+        rate_grows = rate_end > current + 0.1
+        any_growth |= load_grows or rate_grows or joint_max > current + 0.1
+        load_text = "grows" if load_grows else "does not grow"
+        rate_text = "grows" if rate_grows else "does not grow"
+        clauses.append(
+            f"{FORM_LABEL[form].lower()} {load_text} with load to {load_end:+.3f}% at U250/R50 "
+            f"and {rate_text} with rate to {rate_end:+.3f}% at U100/R80; "
+            f"the largest sampled joint-regime gap is {joint_max:+.3f}% at "
+            f"U{joint_point[0]}/R{joint_point[1]}"
+        )
+    opening = (
+        "The joint-over-unilateral gap grows in at least one constrained direction: "
+        if any_growth
+        else "The joint-over-unilateral gap does not grow materially in the sampled constrained regimes: "
+    )
+    return opening + "; ".join(clauses) + "."
+
+
+def curve_table(title, points, results):
+    lines = [
+        f"### {title}",
+        "",
+        "| Point | Users | Rate (Mbit/s) | Formulation | Baseline EE | Unilateral EE | Joint EE | Joint / unilateral | Negative anchors / 8 | Unilateral / baseline |",
+        "|---|---:|---:|---|---:|---:|---:|---:|---:|---:|",
+    ]
+    for point in points:
+        users, rate = point
+        for form in FORM_LABEL:
+            result = results[(users, rate, form)]
+            summary = result["summary"]
+            lines.append(
+                f"| {point_name(point)} | {users} | {rate} | {FORM_LABEL[form]} | "
+                f"{ee_mbit(result, 'BASELINE'):.6f} | {ee_mbit(result, 'UNILATERAL'):.6f} | "
+                f"{ee_mbit(result, 'ORACLE_SET'):.6f} | {gap_pct(result):+.3f}% | "
+                f"{summary['joint_over_unilateral_negative_anchors']} | "
+                f"{100*summary['unilateral_over_baseline_relative']:+.3f}% |"
+            )
+    return lines
+
+
+def metric_table(results, diagnostics):
+    lines = [
+        "## Endpoint and constraint metrics at every point",
+        "",
+        "EE is Mbit/J. Served and target-attained counts are separate sums over 8 anchors; each denominator is `8 × users`. Constraint shares use occupied beam-boundaries. `I-limited` is the share of infeasible user-anchors meeting the declared interference counterfactual, and `top-1` is its aggressor share. Occupancy is mean / maximum over occupied beam-boundaries.",
+        "",
+        "| Point | Form | Selector | EE | Served | Target attained | Cap binds | No eligible mode | Infeasible user-steps | I-limited | Top-1 | Occupancy mean / max | Occupancy distribution (n: beam-boundaries) |",
+        "|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|",
+    ]
+    for users, rate in POINTS:
+        for form in FORM_LABEL:
+            result = results[(users, rate, form)]
+            diag = diagnostics[(users, rate, form)]
+            for arm in ARMS:
+                row = diag["arms"][arm]
+                hist = ", ".join(
+                    f"{n}:{count}"
+                    for n, count in row["occupancy_histogram_beam_boundaries"].items()
+                )
+                lines.append(
+                    f"| {point_name((users, rate))} | {FORM_LABEL[form]} | {arm} | "
+                    f"{ee_mbit(result, arm):.6f} | {row['served_count_sum']} / {8*users} | "
+                    f"{row['rate_target_attained_count_sum']} / {8*users} | "
+                    f"{pct(row['cap_binding_beam_boundary_share'])} | "
+                    f"{pct(row['no_eligible_mode_beam_boundary_share'])} | "
+                    f"{row['infeasible_user_steps']} / {8*users} | "
+                    f"{pct(row['interference_limited_share_of_infeasible_user_steps'])} | "
+                    f"{pct(row['top_one_aggressor_interference_share'])} | "
+                    f"{row['mean_beam_occupancy']:.3f} / {row['maximum_beam_occupancy']} | {hist} |"
+                )
+    return lines
+
+
+def crossings(results, diagnostics):
+    lines = [
+        "## One- and two-per-cent crossings",
+        "",
+        "These are first observed crossings along each ordered one-axis sweep, not interpolated thresholds. Binding columns report the joint selector at that sampled point; table/cap user-step categories can overlap when different boundaries bind for one user-anchor.",
+        "",
+        "| Axis | Form | Threshold | First sampled crossing | Gap | Cap-binding beam-boundaries | No-mode beam-boundaries | I-limited / infeasible user-steps |",
+        "|---|---|---:|---|---:|---:|---:|---:|",
+    ]
+    for axis_name, points in (("Load", LOAD_AXIS), ("Rate", RATE_AXIS)):
+        for form in FORM_LABEL:
+            for threshold in (1.0, 2.0):
+                found = next(
+                    (point for point in points if gap_pct(results[(*point, form)]) >= threshold),
+                    None,
+                )
+                if found is None:
+                    lines.append(
+                        f"| {axis_name} | {FORM_LABEL[form]} | {threshold:.0f}% | Not reached | — | — | — | — |"
+                    )
+                    continue
+                row = diagnostics[(*found, form)]["arms"]["ORACLE_SET"]
+                lines.append(
+                    f"| {axis_name} | {FORM_LABEL[form]} | {threshold:.0f}% | "
+                    f"U{found[0]}/R{found[1]} | {gap_pct(results[(*found, form)]):+.3f}% | "
+                    f"{pct(row['cap_binding_beam_boundary_share'])} | "
+                    f"{pct(row['no_eligible_mode_beam_boundary_share'])} | "
+                    f"{row['interference_limited_infeasible_user_steps']} / {row['infeasible_user_steps']} |"
+                )
+    return lines
+
+
+def build():
+    results, diagnostics = load_all()
+    validate(results, diagnostics)
+    lead = curve_phrase(results)
+    lines = [
+        lead,
+        "",
+        "# Load-regime sweep — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM`",
+        "",
+        "This report answers only where bounded set-level association coordination has diagnostic value. It does not rank sweep points, recommend a setting, or adopt a new constant. Every row is a separate evaluation on a copied run setting. The sealed per-user rate remains **50 Mbit/s**, and **no sealed constant was changed**.",
+        "",
+        "## Curve",
+        "",
+        "Pooled EE is `sum(decoded bits) / sum(joules)` across the same 8 anchors (4 TRAIN worlds × steps 0 and 1). `Joint` is the reused bounded `ORACLE_SET` selector; it includes the certified unilateral fixed point, but committed realised EE can still decline on an anchor because selection uses unchanged boundary-zero objective semantics.",
+        "",
+    ]
+    lines += curve_table("Axis L — offered load at 50 Mbit/s", LOAD_AXIS, results)
+    lines += [""] + curve_table("Axis R — rate target at 100 users", RATE_AXIS, results)
+    lines += [""] + curve_table("Joint load/rate samples", JOINT_POINTS, results)
+    lines += [""] + crossings(results, diagnostics)
+    lines += [""] + metric_table(results, diagnostics)
+    lines += [
+        "",
+        "## Point-by-point sealed-value declaration",
+        "",
+    ]
+    for point in POINTS:
+        lines.append(
+            f"- U{point[0]}/R{point[1]}: diagnostic target {point[1]} Mbit/s; the sealed value is 50 Mbit/s and no sealed constant was changed. Both formulations are separate copied evaluations."
+        )
+    definitions = diagnostics[(100, 50, "sealed")]["definitions"]
+    lines += [
+        "",
+        "## Definitions and interpretation",
+        "",
+        f"- Beam-boundary: {definitions['beam_boundary']}.",
+        f"- Cap-binding: {definitions['cap_binding']}.",
+        f"- No eligible mode: {definitions['no_eligible_mode']}.",
+        f"- Infeasible user-step: {definitions['infeasible_user_step']}.",
+        f"- Interference-limited: {definitions['interference_limited']}.",
+        f"- Top-one aggressor share: {definitions['top_one_aggressor_share']}.",
+        f"- Occupancy: {definitions['occupancy']}. The full realised distribution is printed in every selector row, rather than merging selectors.",
+        "",
+        "The load sweep is genuinely nested. For each domain, the script builds one immutable 250-user master tape, preserving the sealed RNG consumption for users 0–99 and placing only added users on a deterministic split stream, then takes first-N projections. Retained users therefore keep identical geometry, fading, epoch, satellite inventory, seed, horizon, and 48 boundary times across L points. Rate points reuse the same projected tape. Population changes only which prefix users participate. As an exact check, the U100/R50 selections, configuration IDs, bits, joules, and served counts match the prior 20-anchor runner's corresponding 8 sealed and strict-margin anchors field-for-field.",
+        "",
+        "`Sealed` uses the unchanged production batch formulation. `Margin` uses the prior strict private margin-provisioning copy (`cleared_margin_batch.py`), including its numerical clearance check; it does not edit production physics. The price, sign, seed mapping, 30.08 s horizon, circuit price, 1.65 W cap, mode table, fading quantile, baseline served-count guard, and acceptance/tie rules are unchanged.",
+        "",
+        "The bounded joint catalogue is mechanism-limited (occupant subsets through size four, victim plus top contributors, and complete beam evacuation; 4,096-candidate ceiling). Results describe that selector, not a global combinatorial optimum.",
+        "",
+        "## Reproduction and verification",
+        "",
+        "Exact commands, from the workspace root:",
+        "",
+        "```bash",
+        "bash .scratch/load-regime-sweep-20260910/run_all_points.sh",
+        "bash .scratch/load-regime-sweep-20260910/run_all_diagnostics.sh",
+        "/home/sat/mcrl-leo-handover/.venv/bin/python .scratch/load-regime-sweep-20260910/build_report.py",
+        "```",
+        "",
+        "The two run scripts expand every evaluation command to `PYTHONPATH=src`, one BLAS/OpenMP thread, the required interpreter, and `nice -n 15`. Each point receipt records the copied setting, four master/projected tape digests, source commit/tree, reused-runner hash, wrapper hash, no TEST access, and no learner/policy/training run. Diagnostics rebuild each master tape, assert projected digest identity, replay all 24 committed profiles through the independent scalar path, and require bits/joules relative error below `1e-8` with exact served-count parity.",
+        "",
+        "Evidence directory: `.scratch/load-regime-sweep-20260910/` (`results/`, `diagnostics/`, `logs/`, source audit, scripts, and completion criterion). The Git tree remains `1728f6b0462f86d85618a4c73f4d1dd2d2c07376`.",
+        "",
+        "## Coverage",
+        "",
+        "Reached all 11 distinct parameter points under both formulations: 22 point-formulation runs, 8 anchors each, 176 anchor evaluations, plus 528 independent committed-profile scalar replays. **Unreached points: none.** No training run, policy run, or learner was used.",
+    ]
+    text = "\n".join(lines) + "\n"
+    REPORT.write_text(text)
+    print(REPORT)
+
+
+if __name__ == "__main__":
+    build()
diff --git a/.scratch/load-regime-sweep-20260910/diagnose_results.py b/.scratch/load-regime-sweep-20260910/diagnose_results.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad3c8b4c35eee6d3d17a10f1db4dacaa0a2c89ea
--- /dev/null
+++ b/.scratch/load-regime-sweep-20260910/diagnose_results.py
@@ -0,0 +1,407 @@
+#!/usr/bin/env python3
+"""Replay completed sweep selections for target, binding, and occupancy metrics."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+import numpy as np
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+LADDER = ROOT / ".scratch/ladder-floor-20260910"
+sys.path.insert(0, str(LADDER))
+
+import oracle_runner as oracle  # noqa: E402
+from sweep_runner import (  # noqa: E402
+    MASTER_USER_COUNT,
+    nested_tape,
+    stable_extension_mobility,
+)
+from scalar_diagnostics import scalar_formulation  # noqa: E402
+from mcrl.physics_v025 import architectures  # noqa: E402
+from mcrl.physics_v025.energy import schedule_energy  # noqa: E402
+from mcrl.physics_v025.provider_legacy import factory as real_factory  # noqa: E402
+
+
+ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
+CAP_TOLERANCE_W = 1.0e-9
+
+
+def boundary_weights(times: list[float]) -> np.ndarray:
+    values = np.asarray(times, dtype=np.float64)
+    result = np.zeros(values.size, dtype=np.float64)
+    differences = np.diff(values)
+    if np.any(differences <= 0.0):
+        raise ValueError("boundary times must be strictly increasing")
+    result[:-1] += differences / 2.0
+    result[1:] += differences / 2.0
+    return result
+
+
+def profile_diagnostics(
+    *, tape, step_index: int, assignments: dict, formulation: str, rate_bps: float
+) -> dict:
+    samples = tape.geometry_for(step_index=step_index, assignments=assignments)
+    if len(samples) != 48:
+        raise RuntimeError("diagnostic replay requires all 48 boundaries")
+    times = [float(row[0]) for row in samples]
+    weights = boundary_weights(times)
+    duration_s = times[-1] - times[0]
+    config = architectures.RadiationConfig(
+        rate_target_bps=rate_bps, fading_quantile_alpha=0.10
+    )
+    engine = architectures.AngleRateTPC_TDM()
+    assigned_users = tuple(sorted(assignments))
+    per_user_bits = {user: 0.0 for user in assigned_users}
+    decoded_any = set()
+    infeasible = {user: assignments[user] is None for user in assigned_users}
+    table_limited = {user: False for user in assigned_users}
+    cap_limited = {user: False for user in assigned_users}
+    interference_limited = {user: False for user in assigned_users}
+    occupancy = Counter()
+    beam_boundaries = 0
+    cap_beam_boundaries = 0
+    no_mode_beam_boundaries = 0
+    integrated_bits = 0.0
+    integrated_joules = 0.0
+    top_one_interference = 0.0
+    total_interference = 0.0
+
+    scalar_name = "original" if formulation == "sealed" else "margin-cleared"
+    with scalar_formulation(scalar_name):
+        for (_time_s, geometry), weight_s in zip(samples, weights, strict=True):
+            radiation = engine.radiate(config, geometry, "realised")
+            if not radiation.valid:
+                raise RuntimeError("invalid scalar power certificate")
+            energy = schedule_energy(
+                tape.inventory,
+                ((slot.fraction, dict(slot.beam_rf_w)) for slot in radiation.slots),
+                duration_s=1.0,
+                idle_power_w=0.0,
+            )
+            integrated_joules += float(weight_s * energy.joules)
+            links_by_user = {link.user_id: link for link in geometry.links}
+            index_by_user = {
+                link.user_id: index for index, link in enumerate(geometry.links)
+            }
+            by_beam = Counter(link.beam for link in geometry.links)
+            occupancy.update(by_beam.values())
+            beam_boundaries += len(by_beam)
+            boundary_cap_beams = set()
+            boundary_no_mode_beams = set()
+            boundary_rates = Counter()
+            boundary_feasible_users = set()
+
+            for slot in radiation.slots:
+                transmissions = {tx.user_id: tx for tx in slot.transmissions}
+                for tx in slot.transmissions:
+                    if tx.rf_power_w >= config.beam_cap_w - CAP_TOLERANCE_W:
+                        boundary_cap_beams.add(tx.beam)
+                    if tx.m_target is None:
+                        boundary_no_mode_beams.add(tx.beam)
+                        table_limited[tx.user_id] = True
+                    if tx.rate_target_feasible:
+                        boundary_feasible_users.add(tx.user_id)
+                    else:
+                        infeasible[tx.user_id] = True
+                        if tx.m_target is not None:
+                            cap_limited[tx.user_id] = True
+                            link = links_by_user[tx.user_id]
+                            gamma = tx.rate_target_sinr
+                            noise_only_required = (
+                                math.inf
+                                if gamma is None
+                                else gamma * tx.noise_w / link.nominal_gain
+                            )
+                            terms = []
+                            victim_index = index_by_user[tx.user_id]
+                            for aggressor in slot.transmissions:
+                                if aggressor.user_id == tx.user_id:
+                                    continue
+                                aggressor_link = links_by_user[aggressor.user_id]
+                                if aggressor.beam == tx.beam:
+                                    continue
+                                if aggressor_link.color != link.color:
+                                    continue
+                                aggressor_index = index_by_user[aggressor.user_id]
+                                term = float(
+                                    geometry.nominal_cross_gain[
+                                        victim_index, aggressor_index
+                                    ]
+                                    * aggressor.rf_power_w
+                                )
+                                if term > 0.0:
+                                    terms.append(term)
+                            total = math.fsum(terms)
+                            if noise_only_required <= config.beam_cap_w and total > 0.0:
+                                interference_limited[tx.user_id] = True
+                                exposure = float(weight_s * slot.fraction)
+                                top_one_interference += exposure * max(terms)
+                                total_interference += exposure * total
+                    if tx.realised_outcome is not None and tx.realised_outcome.decoded:
+                        decoded_any.add(tx.user_id)
+                        boundary_rates[tx.user_id] += (
+                            slot.fraction
+                            * tx.bandwidth_hz
+                            * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
+                        )
+
+            # A missing assigned user is infeasible in the dense path as well.
+            for user, identity in assignments.items():
+                if identity is not None and user not in boundary_feasible_users:
+                    infeasible[user] = True
+            cap_beam_boundaries += len(boundary_cap_beams)
+            no_mode_beam_boundaries += len(boundary_no_mode_beams)
+            boundary_total = math.fsum(boundary_rates.values())
+            integrated_bits += float(weight_s * boundary_total)
+            for user in assigned_users:
+                per_user_bits[user] += float(weight_s * boundary_rates[user])
+
+    occupied_samples = sum(occupancy.values())
+    occupied_users = sum(n * count for n, count in occupancy.items())
+    infeasible_count = sum(infeasible.values())
+    return {
+        "boundaries": 48,
+        "beam_boundary_count": beam_boundaries,
+        "cap_binding_beam_boundary_count": cap_beam_boundaries,
+        "cap_binding_beam_boundary_share": (
+            cap_beam_boundaries / beam_boundaries if beam_boundaries else None
+        ),
+        "no_eligible_mode_beam_boundary_count": no_mode_beam_boundaries,
+        "no_eligible_mode_beam_boundary_share": (
+            no_mode_beam_boundaries / beam_boundaries if beam_boundaries else None
+        ),
+        "user_steps": len(assigned_users),
+        "infeasible_user_steps": infeasible_count,
+        "table_limited_infeasible_user_steps": sum(
+            infeasible[user] and table_limited[user] for user in assigned_users
+        ),
+        "cap_limited_infeasible_user_steps": sum(
+            infeasible[user] and cap_limited[user] for user in assigned_users
+        ),
+        "interference_limited_infeasible_user_steps": sum(
+            infeasible[user] and interference_limited[user] for user in assigned_users
+        ),
+        "interference_limited_share_of_infeasible_user_steps": (
+            sum(infeasible[user] and interference_limited[user] for user in assigned_users)
+            / infeasible_count
+            if infeasible_count
+            else 0.0
+        ),
+        "top_one_aggressor_interference_share": (
+            top_one_interference / total_interference
+            if total_interference
+            else None
+        ),
+        "top_one_interference_numerator": top_one_interference,
+        "total_interference_denominator": total_interference,
+        "occupancy_histogram_beam_boundaries": {
+            str(n): count for n, count in sorted(occupancy.items())
+        },
+        "mean_beam_occupancy": (
+            occupied_users / occupied_samples if occupied_samples else None
+        ),
+        "maximum_beam_occupancy": max(occupancy, default=0),
+        "scalar_bits": integrated_bits,
+        "scalar_joules": integrated_joules,
+        "served_count": len(decoded_any),
+        "rate_target_attained_count": sum(
+            bits >= rate_bps * duration_s for bits in per_user_bits.values()
+        ),
+    }
+
+
+def pool(rows: list[dict]) -> dict:
+    occupancy = Counter()
+    for row in rows:
+        occupancy.update(
+            {int(n): count for n, count in row["occupancy_histogram_beam_boundaries"].items()}
+        )
+    beam_boundaries = sum(row["beam_boundary_count"] for row in rows)
+    cap = sum(row["cap_binding_beam_boundary_count"] for row in rows)
+    no_mode = sum(row["no_eligible_mode_beam_boundary_count"] for row in rows)
+    infeasible = sum(row["infeasible_user_steps"] for row in rows)
+    interference_limited = sum(
+        row["interference_limited_infeasible_user_steps"] for row in rows
+    )
+    # Reconstructing the ratio from rounded per-profile shares is invalid, so
+    # retain the exact numerator/denominator alongside each profile in v2.
+    top_num = math.fsum(row.get("top_one_interference_numerator", 0.0) for row in rows)
+    top_den = math.fsum(row.get("total_interference_denominator", 0.0) for row in rows)
+    occupied_samples = sum(occupancy.values())
+    return {
+        "beam_boundary_count": beam_boundaries,
+        "cap_binding_beam_boundary_count": cap,
+        "cap_binding_beam_boundary_share": cap / beam_boundaries if beam_boundaries else None,
+        "no_eligible_mode_beam_boundary_count": no_mode,
+        "no_eligible_mode_beam_boundary_share": no_mode / beam_boundaries if beam_boundaries else None,
+        "user_steps": sum(row["user_steps"] for row in rows),
+        "infeasible_user_steps": infeasible,
+        "table_limited_infeasible_user_steps": sum(
+            row["table_limited_infeasible_user_steps"] for row in rows
+        ),
+        "cap_limited_infeasible_user_steps": sum(
+            row["cap_limited_infeasible_user_steps"] for row in rows
+        ),
+        "interference_limited_infeasible_user_steps": interference_limited,
+        "interference_limited_share_of_infeasible_user_steps": (
+            interference_limited / infeasible if infeasible else 0.0
+        ),
+        "top_one_aggressor_interference_share": top_num / top_den if top_den else None,
+        "occupancy_histogram_beam_boundaries": {
+            str(n): count for n, count in sorted(occupancy.items())
+        },
+        "mean_beam_occupancy": (
+            sum(n * count for n, count in occupancy.items()) / occupied_samples
+            if occupied_samples
+            else None
+        ),
+        "maximum_beam_occupancy": max(occupancy, default=0),
+        "served_count_sum": sum(row["served_count"] for row in rows),
+        "rate_target_attained_count_sum": sum(
+            row["rate_target_attained_count"] for row in rows
+        ),
+        "scalar_bits": math.fsum(row["scalar_bits"] for row in rows),
+        "scalar_joules": math.fsum(row["scalar_joules"] for row in rows),
+    }
+
+
+def diagnose(result_path: Path, output: Path) -> dict:
+    started = time.perf_counter()
+    source = json.loads(result_path.read_text())
+    if source["status"] != "COMPLETE" or len(source["anchors"]) != 8:
+        raise RuntimeError("diagnostics require a complete 8-anchor point")
+    users = int(source["users"])
+    rate_bps = float(source["rate_target_bps"])
+    formulation = source["formulation"]
+    anchors_by_world = {}
+    for anchor in source["anchors"]:
+        anchors_by_world.setdefault(int(anchor["world_index"]), []).append(anchor)
+    details = []
+    arm_rows = {arm: [] for arm in ARMS}
+    parity = []
+    for world_index, anchors in sorted(anchors_by_world.items()):
+        domain = oracle.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        with stable_extension_mobility():
+            master_tape = oracle.probe.build_world_tape(
+                domain=domain,
+                provider=real_factory(user_count=MASTER_USER_COUNT),
+                steps=2,
+                start_time_s=0.0,
+            )
+        tape = nested_tape(master_tape, users)
+        expected = next(
+            row["world_sha256"]
+            for row in source["worlds"]
+            if int(row["world_index"]) == world_index
+        )
+        if tape.digest != expected:
+            raise RuntimeError("rebuilt diagnostic tape digest mismatch")
+        for anchor in sorted(anchors, key=lambda row: int(row["step_index"])):
+            for arm in ARMS:
+                committed = anchor["committed"][arm]
+                assignments = {
+                    int(user): None if identity is None else tuple(identity)
+                    for user, identity in committed["assignments"]
+                }
+                row = profile_diagnostics(
+                    tape=tape,
+                    step_index=int(anchor["step_index"]),
+                    assignments=assignments,
+                    formulation=formulation,
+                    rate_bps=rate_bps,
+                )
+                bits_rel = (
+                    row["scalar_bits"] / committed["bits"] - 1.0
+                    if committed["bits"]
+                    else row["scalar_bits"]
+                )
+                joules_rel = row["scalar_joules"] / committed["joules"] - 1.0
+                passed = (
+                    abs(bits_rel) < 1e-8
+                    and abs(joules_rel) < 1e-8
+                    and row["served_count"] == committed["served_count"]
+                )
+                parity.append(
+                    {
+                        "anchor_id": anchor["anchor_id"],
+                        "arm": arm,
+                        "bits_relative_difference": bits_rel,
+                        "joules_relative_difference": joules_rel,
+                        "served_equal": row["served_count"]
+                        == committed["served_count"],
+                        "passed": passed,
+                    }
+                )
+                if not passed:
+                    raise RuntimeError(f"scalar/dense parity failure: {parity[-1]}")
+                arm_rows[arm].append(row)
+                details.append(
+                    {"anchor_id": anchor["anchor_id"], "arm": arm, **row}
+                )
+                print(
+                    json.dumps(
+                        {
+                            "point": result_path.stem,
+                            "anchor": anchor["anchor_id"],
+                            "arm": arm,
+                            "cap_share": row["cap_binding_beam_boundary_share"],
+                            "no_mode_share": row[
+                                "no_eligible_mode_beam_boundary_share"
+                            ],
+                            "elapsed_s": time.perf_counter() - started,
+                        },
+                        sort_keys=True,
+                    ),
+                    flush=True,
+                )
+    result = {
+        "schema": "mcrl-v025-load-regime-diagnostics-v1",
+        "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
+        "source": str(result_path),
+        "source_sha256": hashlib.sha256(result_path.read_bytes()).hexdigest(),
+        "formulation": formulation,
+        "users": users,
+        "rate_target_bps": rate_bps,
+        "anchor_count": len(source["anchors"]),
+        "definitions": {
+            "beam_boundary": "one occupied physical beam at one of 48 realised endpoint boundaries",
+            "cap_binding": "any slot transmission on that beam is within 1e-9 W of the unchanged beam cap",
+            "no_eligible_mode": "the occupancy/rate target has no target ACM mode in the unchanged table (m_target is None)",
+            "infeasible_user_step": "assigned user is target-infeasible at one or more of its 48 boundaries",
+            "interference_limited": "a finite-target cap-infeasible exposure would fit the unchanged cap with nominal noise alone and has positive cochannel interference",
+            "top_one_aggressor_share": "duration-weighted strongest nominal cochannel aggressor term divided by total nominal cochannel interference over interference-limited exposures",
+            "occupancy": "distribution over occupied beam-boundaries after realised eligibility filtering",
+        },
+        "parity_passed": all(row["passed"] for row in parity),
+        "parity": parity,
+        "arms": {arm: pool(rows) for arm, rows in arm_rows.items()},
+        "details": details,
+        "wall_seconds": time.perf_counter() - started,
+    }
+    output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n"
+    )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--result", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    diagnose(args.result, args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.scratch/load-regime-sweep-20260910/run_all_diagnostics.sh b/.scratch/load-regime-sweep-20260910/run_all_diagnostics.sh
