+#!/usr/bin/env python3
+"""Run one unsealed load/rate diagnostic point through the reused selector.
+
+The imported twenty-anchor runner remains unchanged.  This wrapper replaces
+only process-local function references and constructs a copied run setting for
+one evaluation.  It never writes source, manifests, or the sealed setting.
+"""
+
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+from dataclasses import replace
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import subprocess
+import sys
+import time
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+LADDER = ROOT / ".scratch/ladder-floor-20260910"
+sys.path.insert(0, str(LADDER))
+
+import oracle_runner as oracle  # noqa: E402
+from mcrl.physics_v025 import batch as sealed_batch  # noqa: E402
+from mcrl.physics_v025.provider_legacy import factory as real_factory  # noqa: E402
+
+
+CLAIM = "DIAGNOSTIC_NOT_CLAIM"
+SEALED_RATE_BPS = 50_000_000.0
+WORLDS = 4
+ANCHORS_PER_WORLD = 2
+ANCHORS = WORLDS * ANCHORS_PER_WORLD
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=ROOT, text=True, encoding="utf-8"
+    ).strip()
+
+
+@contextmanager
+def diagnostic_point(*, users: int, rate_bps: float, formulation: str):
+    """Install and then restore the point's process-local evaluation seams."""
+
+    if formulation not in {"sealed", "margin"}:
+        raise ValueError("formulation must be sealed or margin")
+    old_run_setting_for = oracle.probe.run_setting_for
+    old_batch = oracle.probe.evaluate_ar_tdm_catalogue
+    sealed = old_run_setting_for("a-r0")
+    copied = replace(
+        sealed,
+        user_count=users,
+        rate_target_bps=rate_bps,
+        regime=f"DIAGNOSTIC-U{users}-R{rate_bps:g}",
+    )
+
+    def run_setting_for(label: str):
+        return copied if label == "a-r0" else old_run_setting_for(label)
+
+    oracle.probe.run_setting_for = run_setting_for
+    if formulation == "sealed":
+        oracle.probe.evaluate_ar_tdm_catalogue = sealed_batch.evaluate_ar_tdm_catalogue
+    else:
+        import cleared_margin_batch
+
+        oracle.probe.evaluate_ar_tdm_catalogue = (
+            cleared_margin_batch.evaluate_ar_tdm_catalogue
+        )
+    try:
+        yield copied
+    finally:
+        oracle.probe.run_setting_for = old_run_setting_for
+        oracle.probe.evaluate_ar_tdm_catalogue = old_batch
+
+
+def summarize(anchors):
+    summary = oracle.summarize(anchors)
+    gains = [
+        row["committed"]["ORACLE_SET"]["ee_bit_per_j"]
+        / row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        - 1.0
+        for row in anchors
+    ]
+    summary.update(
+        joint_over_unilateral_negative_anchors=sum(value < 0.0 for value in gains),
+        joint_over_unilateral_positive_anchors=sum(value > 0.0 for value in gains),
+        joint_over_unilateral_zero_anchors=sum(value == 0.0 for value in gains),
+    )
+    return summary
+
+
+def run_point(*, users: int, rate_bps: float, formulation: str, output: Path):
+    if users < 1 or not math.isfinite(rate_bps) or rate_bps <= 0.0:
+        raise ValueError("users and rate must be positive")
+    started = time.perf_counter()
+    anchors = []
+    worlds = []
+    with diagnostic_point(
+        users=users, rate_bps=rate_bps, formulation=formulation
+    ) as copied_setting:
+        for world_index in range(1, WORLDS + 1):
+            domain = oracle.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+            world_started = time.perf_counter()
+            tape = oracle.probe.build_world_tape(
+                domain=domain,
+                provider=real_factory(user_count=users),
+                steps=ANCHORS_PER_WORLD,
+                start_time_s=0.0,
+            )
+            worlds.append(
+                {
+                    "world_index": world_index,
+                    "domain": domain,
+                    "world_sha256": tape.digest,
+                    "tle_date": tape.tle_date,
+                    "training_seed": tape.training_seed,
+                    "construction_wall_seconds": time.perf_counter()
+                    - world_started,
+                }
+            )
+            oracle._WORKER_TAPE = tape
+            for step_index in range(ANCHORS_PER_WORLD):
+                row = oracle.evaluate_anchor(
+                    tape=tape,
+                    world_index=world_index,
+                    step_index=step_index,
+                    pool=None,
+                )
+                anchors.append(row)
+                partial = {
+                    "schema": "mcrl-v025-load-regime-point-v1",
+                    "claim_ceiling": CLAIM,
+                    "status": "PARTIAL_RUNNING",
+                    "formulation": formulation,
+                    "users": users,
+                    "rate_target_bps": rate_bps,
+                    "sealed_rate_target_bps": SEALED_RATE_BPS,
+                    "sealed_constant_changed": False,
+                    "copied_run_setting": copied_setting.payload(),
+                    "worlds": worlds,
+                    "anchors": anchors,
+                    "summary": summarize(anchors),
+                    "wall_seconds": time.perf_counter() - started,
+                }
+                output.parent.mkdir(parents=True, exist_ok=True)
+                output.with_suffix(".checkpoint.json").write_text(
+                    json.dumps(partial, indent=2, sort_keys=True, allow_nan=False)
+                    + "\n",
+                    encoding="ascii",
+                )
+                print(
+                    json.dumps(
+                        {
+                            "point": f"U{users}-R{rate_bps:g}-{formulation}",
+                            "anchor": row["anchor_id"],
+                            "completed": len(anchors),
+                            "anchor_joint_gap_pct": 100.0
+                            * row["committed"]["ORACLE_SET"][
+                                "relative_ee_gain_over_UNILATERAL"
+                            ],
+                            "wall_seconds": row["wall_seconds"],
+                        },
+                        sort_keys=True,
+                    ),
+                    flush=True,
+                )
+
+    result = {
+        "schema": "mcrl-v025-load-regime-point-v1",
+        "claim_ceiling": CLAIM,
+        "status": "COMPLETE",
+        "formulation": formulation,
+        "users": users,
+        "rate_target_bps": rate_bps,
+        "sealed_rate_target_bps": SEALED_RATE_BPS,
+        "sealed_constant_changed": False,
+        "evaluation_semantics": (
+            "separate diagnostic evaluation on a copied run setting; no sealed "
+            "constant or artifact changed"
+        ),
+        "source_commit": _git("rev-parse", "HEAD"),
+        "source_tree": _git("rev-parse", "HEAD^{tree}"),
+        "runner_reused": str(LADDER / "oracle_runner.py"),
+        "runner_reused_sha256": hashlib.sha256(
+            (LADDER / "oracle_runner.py").read_bytes()
+        ).hexdigest(),
+        "wrapper_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "nice_requested": 15,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in (
+                "OMP_NUM_THREADS",
+                "OPENBLAS_NUM_THREADS",
+                "MKL_NUM_THREADS",
+                "NUMEXPR_NUM_THREADS",
+            )
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "policy_run_used": False,
+        "training_run_used": False,
+        "copied_run_setting": copied_setting.payload(),
+        "worlds": worlds,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    unsigned = json.dumps(
+        result, sort_keys=True, separators=(",", ":"), allow_nan=False
+    ).encode("ascii")
+    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
+    output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--users", type=int, required=True)
+    parser.add_argument("--rate-mbps", type=float, required=True)
+    parser.add_argument("--formulation", choices=("sealed", "margin"), required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    result = run_point(
+        users=args.users,
+        rate_bps=args.rate_mbps * 1e6,
+        formulation=args.formulation,
+        output=args.output,
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

