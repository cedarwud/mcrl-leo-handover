#!/usr/bin/env python3
"""Replay committed original/margin configurations through the scalar copy.

Run with the specified shared Python and PYTHONPATH=src, nice -n 10. A single
process performs all work. Reads completed result files or live checkpoint
snapshots, using only anchors present in both formulations. Writes compact
gzipped census evidence and a readable pooled summary beside this script.
"""

from __future__ import annotations

import argparse
from collections import Counter, defaultdict
import gzip
import json
import math
from pathlib import Path
import time

import oracle_runner
from scalar_diagnostics import census, SCALAR_CLEARANCE_DIAGNOSTICS
from mcrl.physics_v025.provider_legacy import factory as real_factory


HERE = Path(__file__).resolve().parent


def read_result(formulation):
    final = HERE / f"{formulation}-result.json"
    path = final if final.exists() else HERE / f"{formulation}-result.checkpoint.json"
    return json.loads(path.read_text())


def weighted_quantile(bins, probability, weight_column):
    target = sum(row[weight_column] for row in bins) * probability
    cumulative = 0.0
    for row in bins:
        cumulative += row[weight_column]
        if cumulative >= target:
            return row[0]
    return None


def summarize(rows):
    counts = Counter()
    by_occupancy = defaultdict(Counter)
    histograms = {}
    modes = Counter()
    for row in rows:
        for key, value in row["counts"].items():
            if not key.endswith("share"):
                counts[key] += value
        for n, local in row["by_occupancy"].items():
            for key, value in local.items():
                if not key.endswith("share"):
                    by_occupancy[n][key] += value
        for target, tx, count in row["mode_transitions"]:
            modes[(target, tx)] += count
        for name, local in row["distributions"].items():
            global_hist = histograms.setdefault(name, {
                "count": 0, "weight_s": 0.0, "sum": 0.0, "weighted_sum": 0.0,
                "min": math.inf, "max": -math.inf, "bins": defaultdict(lambda: [0, 0.0]),
            })
            for key in ("count", "weight_s", "sum", "weighted_sum"):
                global_hist[key] += local[key]
            if local["count"]:
                global_hist["min"] = min(global_hist["min"], local["min"])
                global_hist["max"] = max(global_hist["max"], local["max"])
            for value, count, duration in local["bins"]:
                global_hist["bins"][value][0] += count
                global_hist["bins"][value][1] += duration
    def finish_counts(row):
        row["no_mode_share"] = row["no_mode"] / row["attempts"] if row["attempts"] else None
        row["no_mode_duration_share"] = row["no_mode_duration_s"] / row["attempts_duration_s"] if row["attempts_duration_s"] else None
        return dict(row)
    for name, hist in histograms.items():
        hist["bins"] = [[key, *values] for key, values in sorted(hist["bins"].items())]
        hist["mean"] = hist["sum"] / hist["count"] if hist["count"] else None
        hist["duration_weighted_mean"] = hist["weighted_sum"] / hist["weight_s"] if hist["weight_s"] else None
        hist["quantiles"] = {
            str(p): weighted_quantile(hist["bins"], p, 1)
            for p in (0.0, 0.05, 0.25, 0.50, 0.75, 0.95, 1.0)
        }
        hist["duration_weighted_quantiles"] = {
            str(p): weighted_quantile(hist["bins"], p, 2)
            for p in (0.0, 0.05, 0.25, 0.50, 0.75, 0.95, 1.0)
        }
        hist["quantile_bin_width"] = 0.01
        if not hist["count"]:
            hist["min"] = hist["max"] = None
    return {
        "anchor_count": len(rows),
        "counts": finish_counts(counts),
        "by_occupancy": {n: finish_counts(row) for n, row in sorted(by_occupancy.items(), key=lambda item: int(item[0]))},
        "distributions": histograms,
        "mode_transitions": [[target, tx, count] for (target, tx), count in sorted(modes.items())],
        "scalar_integrated_bits": sum(row["scalar_integrated_bits"] for row in rows),
        "scalar_integrated_joules": sum(row["scalar_integrated_joules"] for row in rows),
        "scalar_served_users_sum": sum(row["scalar_served_users"] for row in rows),
        "rate_target_attained_users_sum": sum(row["rate_target_attained_users"] for row in rows),
    }


def run(limit=None, margin_formulation="margin"):
    started = time.perf_counter()
    forms = ("original", margin_formulation)
    results = {formulation: read_result(formulation) for formulation in forms}
    anchors = {
        formulation: {row["anchor_id"]: row for row in result["anchors"]}
        for formulation, result in results.items()
    }
    common = sorted(set(anchors["original"]) & set(anchors[margin_formulation]))
    if limit is None and len(common) != 20:
        raise RuntimeError(f"full census requires all 20 matched anchors; found {len(common)}")
    if limit is not None:
        common = common[:limit]
    pooled_rows = defaultdict(list)
    parity = []
    details = []
    loaded_domain = None
    loaded_digest = None
    world_digests = {}
    tape = None
    for anchor_id in common:
        reference = anchors["original"][anchor_id]
        domain = reference["world_domain"]
        if domain != loaded_domain:
            tape = oracle_runner.probe.build_world_tape(
                domain=domain, provider=real_factory(), steps=5, start_time_s=0.0,
            )
            loaded_domain = domain
            loaded_digest = tape.digest
            world_digests[domain] = loaded_digest
        for formulation in forms:
            if anchors[formulation][anchor_id]["world_sha256"] != loaded_digest:
                raise RuntimeError(f"rebuilt tape digest mismatch for {formulation} {anchor_id}")
        for formulation in forms:
            anchor = anchors[formulation][anchor_id]
            step = int(anchor["step_index"])
            for selector, profile in anchor["committed"].items():
                mapping = {int(user): None if identity is None else tuple(identity) for user, identity in profile["assignments"]}
                local = census(tape, step, mapping, formulation)
                bits_relative = local["scalar_integrated_bits"] / profile["bits"] - 1.0 if profile["bits"] else local["scalar_integrated_bits"]
                joules_relative = local["scalar_integrated_joules"] / profile["joules"] - 1.0
                passed = abs(bits_relative) < 1.0e-8 and abs(joules_relative) < 1.0e-8 and local["decoded_users_any_attempt"] == profile["served_count"]
                parity_row = {
                    "anchor_id": anchor_id, "formulation": formulation, "selector": selector,
                    "bits_relative_difference": bits_relative, "joules_relative_difference": joules_relative,
                    "scalar_served": local["scalar_served_users"], "scalar_any_attempt_served": local["decoded_users_any_attempt"], "batch_served": profile["served_count"],
                    "passed": passed,
                }
                parity.append(parity_row)
                pooled_rows[(formulation, selector)].append(local)
                details.append({
                    "anchor_id": anchor_id, "formulation": formulation, "selector": selector,
                    **{key: value for key, value in local.items() if key not in {"distributions", "per_user_bits"}},
                })
                print(json.dumps({**parity_row, "no_mode_share": local["counts"]["no_mode_share"], "elapsed_s": time.perf_counter() - started}), flush=True)
                if not passed:
                    raise RuntimeError(f"scalar/batch parity failure: {parity_row}")
    result = {
        "schema": "ladder-floor-census-pooled-v1", "anchor_count": len(common),
        "parity_passed": all(row["passed"] for row in parity), "parity": parity,
        "pooled": {
            formulation: {
                selector: summarize(pooled_rows[(formulation, selector)])
                for selector in ("BASELINE", "UNILATERAL", "ORACLE_SET")
            }
            for formulation in forms
        },
        "anchors": details, "world_sha256": world_digests, "wall_seconds": time.perf_counter() - started,
        "scalar_clearance_diagnostics": dict(SCALAR_CLEARANCE_DIAGNOSTICS),
    }
    for formulation in forms:
        result["pooled"][formulation]["ALL"] = summarize([
            row
            for selector in ("BASELINE", "UNILATERAL", "ORACLE_SET")
            for row in pooled_rows[(formulation, selector)]
        ])
        result["pooled"][formulation]["ALL"]["unique_anchor_count"] = len(common)
    suffix = "-cleared" if margin_formulation == "margin-cleared" else ""
    suffix += "" if limit is None else f"-first{limit}"
    hist_output = HERE / f"scalar-census-histograms{suffix}.json.gz"
    hist_payload = {
        formulation: {
            selector: {name: hist["bins"] for name, hist in values["distributions"].items()}
            for selector, values in arms.items()
        }
        for formulation, arms in result["pooled"].items()
    }
    with gzip.open(hist_output, "wt", compresslevel=6) as stream:
        json.dump(hist_payload, stream, separators=(",", ":"), allow_nan=False)
    for arms in result["pooled"].values():
        for values in arms.values():
            for hist in values["distributions"].values():
                del hist["bins"]
    result["histograms_file"] = hist_output.name
    output = HERE / f"scalar-census-summary{suffix}.json"
    output.write_text(json.dumps(result, indent=2, allow_nan=False) + "\n")
    return result


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--limit", type=int)
    parser.add_argument("--margin-formulation", choices=("margin", "margin-cleared"), default="margin")
    args = parser.parse_args()
    run(args.limit, args.margin_formulation)

