+# Load-regime sweep completion criterion
+
+Complete when `LOAD-REGIME-SWEEP-2026-09-10.md` reports all requested metrics
+for both the sealed and strict margin-provisioning formulations at 4 load-only
+points, 5 rate-only points, and 3 additional joint points, using the same 8
+matched anchors per point, and the saved receipt passes the report builder's
+coverage, parity, sealed-tree, and finite-number assertions.
+
diff --git a/.scratch/load-regime-sweep-20260910/sweep_runner.py b/.scratch/load-regime-sweep-20260910/sweep_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..61bbad9da996b43055c22c1a6d4657cdff78540b
--- /dev/null
+++ b/.scratch/load-regime-sweep-20260910/sweep_runner.py
@@ -0,0 +1,395 @@
+#!/usr/bin/env python3
+"""Run one unsealed load/rate diagnostic point through the reused selector.
+
+The imported twenty-anchor runner remains unchanged.  This wrapper replaces
+only process-local function references and constructs a copied run setting for
+one evaluation.  It never writes source, manifests, or the sealed setting.
+"""
+
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+from dataclasses import replace
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import subprocess
+import sys
+import time
+
+import numpy as np
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+LADDER = ROOT / ".scratch/ladder-floor-20260910"
+sys.path.insert(0, str(LADDER))
+
+import oracle_runner as oracle  # noqa: E402
+from mcrl.physics_v025 import batch as sealed_batch  # noqa: E402
+from mcrl.env import scenario as scenario_module  # noqa: E402
+from mcrl.env.mobility import RandomWanderingUsers, _reflect  # noqa: E402
+from mcrl.physics_v025.provider_legacy import factory as real_factory  # noqa: E402
+from mcrl.physics_v025.tapes import fixed_carrier_actions  # noqa: E402
+
+
+CLAIM = "DIAGNOSTIC_NOT_CLAIM"
+SEALED_RATE_BPS = 50_000_000.0
+WORLDS = 4
+ANCHORS_PER_WORLD = 2
+ANCHORS = WORLDS * ANCHORS_PER_WORLD
+MASTER_USER_COUNT = 250
+SEALED_USER_COUNT = 100
+
+
+_ROW_VECTOR_FIELDS = (
+    "row_user_column",
+    "legacy_action_index",
+    "colors",
+    "row_wanted_slot",
+)
+_BOUNDARY_ROW_FIELDS = (
+    "elevations_deg",
+    "d2_entry_elevations_deg",
+    "slants_km",
+    "d2_distances_km",
+    "visible",
+    "d2_eligible",
+    "cell_reachable",
+    "nominal_gain",
+    "realised_gain",
+    "remaining_visibility_s",
+    "remaining_d2_s",
+    "visibility_right_censored",
+    "d2_right_censored",
+)
+
+
+def nested_tape(master, users: int):
+    """Project a maximum-population tape while retaining common-user geometry."""
+
+    if not 1 <= users <= MASTER_USER_COUNT:
+        raise ValueError("diagnostic population exceeds the fixed master tape")
+    selected_users = tuple(row for row in master.user_layout if row.user_id < users)
+    if len(selected_users) != users:
+        raise RuntimeError("master tape user identities are not the expected dense prefix")
+    steps = []
+    for step in master.steps:
+        arrays = step.arrays
+        if arrays is None:
+            raise RuntimeError("real diagnostic tape must use compact arrays")
+        row_mask = arrays.row_user_column < users
+        updates = {"users": arrays.users[:users]}
+        for name in _ROW_VECTOR_FIELDS:
+            updates[name] = getattr(arrays, name)[row_mask]
+        updates["identities"] = arrays.identities[row_mask, :]
+        for name in _BOUNDARY_ROW_FIELDS:
+            updates[name] = getattr(arrays, name)[:, row_mask]
+        updates.update(
+            cross_base_nominal=arrays.cross_base_nominal[:, :users, :],
+            fading_by_satellite=arrays.fading_by_satellite[:, :users, :],
+            receive_gain_by_wanted_slot=arrays.receive_gain_by_wanted_slot[
+                :, :users, :, :
+            ],
+        )
+        steps.append(replace(step, arrays=replace(arrays, **updates)))
+    carriers = fixed_carrier_actions(
+        domain=master.domain,
+        steps=steps,
+        users=tuple(row.user_id for row in selected_users),
+    )
+    step_layouts = tuple(
+        tuple(row for row in layout if row.user_id < users)
+        for layout in master.step_user_layouts
+    )
+    return replace(
+        master,
+        user_layout=selected_users,
+        steps=tuple(steps),
+        carriers=carriers,
+        generating_input_digest=None,
+        step_user_layouts=step_layouts,
+    )
+
+
+class StableExtensionUsers(RandomWanderingUsers):
+    """Preserve the sealed first 100 trajectories; split added-user randomness."""
+
+    def __init__(self, config=None):
+        super().__init__(config)
+        self._extension_rng = None
+
+    def reset(self, rng):
+        base_count = min(SEALED_USER_COUNT, self.config.num_users)
+        extra_count = self.config.num_users - base_count
+        half = self.config.half_extent_km
+        base_xy = rng.uniform(-half, half, size=(base_count, 2))
+        base_heading = rng.uniform(0.0, 2.0 * math.pi, size=base_count)
+        state = json.dumps(
+            rng.bit_generator.state, sort_keys=True, separators=(",", ":")
+        ).encode("ascii")
+        extension_seed = int.from_bytes(hashlib.sha256(state).digest()[:16], "big")
+        self._extension_rng = np.random.default_rng(extension_seed)
+        extra_xy = self._extension_rng.uniform(-half, half, size=(extra_count, 2))
+        extra_heading = self._extension_rng.uniform(
+            0.0, 2.0 * math.pi, size=extra_count
+        )
+        self._xy_km = np.concatenate((base_xy, extra_xy), axis=0)
+        self._heading_rad = np.concatenate((base_heading, extra_heading), axis=0)
+        return self.positions_km
+
+    def step(self, rng):
+        if self._xy_km is None or self._heading_rad is None:
+            raise RuntimeError("stable extension mobility was not reset")
+        if self._extension_rng is None:
+            raise RuntimeError("stable extension RNG was not initialized")
+        base_count = min(SEALED_USER_COUNT, self.config.num_users)
+        extra_count = self.config.num_users - base_count
+        base_turn = rng.uniform(
+            -self.config.max_turn_rad,
+            self.config.max_turn_rad,
+            size=base_count,
+        )
+        extra_turn = self._extension_rng.uniform(
+            -self.config.max_turn_rad,
+            self.config.max_turn_rad,
+            size=extra_count,
+        )
+        turn = np.concatenate((base_turn, extra_turn))
+        heading = (self._heading_rad + turn) % (2.0 * math.pi)
+        moved = self._xy_km + self.config.step_km * np.stack(
+            (np.cos(heading), np.sin(heading)), axis=1
+        )
+        self._xy_km, self._heading_rad = _reflect(
+            moved, heading, self.config.half_extent_km
+        )
+        return self.positions_km
+
+
+@contextmanager
+def stable_extension_mobility():
+    """Process-local copied mobility seam; always restore the source binding."""
+
+    original = scenario_module.RandomWanderingUsers
+    scenario_module.RandomWanderingUsers = StableExtensionUsers
+    try:
+        yield
+    finally:
+        scenario_module.RandomWanderingUsers = original
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(
+        ["git", *args], cwd=ROOT, text=True, encoding="utf-8"
+    ).strip()
+
+
+@contextmanager
+def diagnostic_point(*, users: int, rate_bps: float, formulation: str):
+    """Install and then restore the point's process-local evaluation seams."""
+
+    if formulation not in {"sealed", "margin"}:
+        raise ValueError("formulation must be sealed or margin")
+    old_run_setting_for = oracle.probe.run_setting_for
+    old_batch = oracle.probe.evaluate_ar_tdm_catalogue
+    sealed = old_run_setting_for("a-r0")
+    copied = replace(
+        sealed,
+        user_count=users,
+        rate_target_bps=rate_bps,
+        regime=f"DIAGNOSTIC-U{users}-R{rate_bps:g}",
+    )
+
+    def run_setting_for(label: str):
+        return copied if label == "a-r0" else old_run_setting_for(label)
+
+    oracle.probe.run_setting_for = run_setting_for
+    if formulation == "sealed":
+        oracle.probe.evaluate_ar_tdm_catalogue = sealed_batch.evaluate_ar_tdm_catalogue
+    else:
+        import cleared_margin_batch
+
+        oracle.probe.evaluate_ar_tdm_catalogue = (
+            cleared_margin_batch.evaluate_ar_tdm_catalogue
+        )
+    try:
+        yield copied
+    finally:
+        oracle.probe.run_setting_for = old_run_setting_for
+        oracle.probe.evaluate_ar_tdm_catalogue = old_batch
+
+
+def summarize(anchors):
+    summary = oracle.summarize(anchors)
+    gains = [
+        row["committed"]["ORACLE_SET"]["ee_bit_per_j"]
+        / row["committed"]["UNILATERAL"]["ee_bit_per_j"]
+        - 1.0
+        for row in anchors
+    ]
+    summary.update(
+        joint_over_unilateral_negative_anchors=sum(value < 0.0 for value in gains),
+        joint_over_unilateral_positive_anchors=sum(value > 0.0 for value in gains),
+        joint_over_unilateral_zero_anchors=sum(value == 0.0 for value in gains),
+    )
+    return summary
+
+
+def run_point(*, users: int, rate_bps: float, formulation: str, output: Path):
+    if users < 1 or not math.isfinite(rate_bps) or rate_bps <= 0.0:
+        raise ValueError("users and rate must be positive")
+    started = time.perf_counter()
+    anchors = []
+    worlds = []
+    with diagnostic_point(
+        users=users, rate_bps=rate_bps, formulation=formulation
+    ) as copied_setting:
+        for world_index in range(1, WORLDS + 1):
+            domain = oracle.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+            world_started = time.perf_counter()
+            with stable_extension_mobility():
+                master_tape = oracle.probe.build_world_tape(
+                    domain=domain,
+                    provider=real_factory(user_count=MASTER_USER_COUNT),
+                    steps=ANCHORS_PER_WORLD,
+                    start_time_s=0.0,
+                )
+            tape = nested_tape(master_tape, users)
+            worlds.append(
+                {
+                    "world_index": world_index,
+                    "domain": domain,
+                    "world_sha256": tape.digest,
+                    "master_user_count": MASTER_USER_COUNT,
+                    "master_world_sha256": master_tape.digest,
+                    "tle_date": tape.tle_date,
+                    "training_seed": tape.training_seed,
+                    "construction_wall_seconds": time.perf_counter()
+                    - world_started,
+                }
+            )
+            oracle._WORKER_TAPE = tape
+            for step_index in range(ANCHORS_PER_WORLD):
+                row = oracle.evaluate_anchor(
+                    tape=tape,
+                    world_index=world_index,
+                    step_index=step_index,
+                    pool=None,
+                )
+                anchors.append(row)
+                partial = {
+                    "schema": "mcrl-v025-load-regime-point-v1",
+                    "claim_ceiling": CLAIM,
+                    "status": "PARTIAL_RUNNING",
+                    "formulation": formulation,
+                    "users": users,
+                    "rate_target_bps": rate_bps,
+                    "sealed_rate_target_bps": SEALED_RATE_BPS,
+                    "sealed_constant_changed": False,
+                    "copied_run_setting": copied_setting.payload(),
+                    "worlds": worlds,
+                    "anchors": anchors,
+                    "summary": summarize(anchors),
+                    "wall_seconds": time.perf_counter() - started,
+                }
+                output.parent.mkdir(parents=True, exist_ok=True)
+                output.with_suffix(".checkpoint.json").write_text(
+                    json.dumps(partial, indent=2, sort_keys=True, allow_nan=False)
+                    + "\n",
+                    encoding="ascii",
+                )
+                print(
+                    json.dumps(
+                        {
+                            "point": f"U{users}-R{rate_bps:g}-{formulation}",
+                            "anchor": row["anchor_id"],
+                            "completed": len(anchors),
+                            "anchor_joint_gap_pct": 100.0
+                            * row["committed"]["ORACLE_SET"][
+                                "relative_ee_gain_over_UNILATERAL"
+                            ],
+                            "wall_seconds": row["wall_seconds"],
+                        },
+                        sort_keys=True,
+                    ),
+                    flush=True,
+                )
+
+    result = {
+        "schema": "mcrl-v025-load-regime-point-v1",
+        "claim_ceiling": CLAIM,
+        "status": "COMPLETE",
+        "formulation": formulation,
+        "users": users,
+        "rate_target_bps": rate_bps,
+        "sealed_rate_target_bps": SEALED_RATE_BPS,
+        "sealed_constant_changed": False,
+        "evaluation_semantics": (
+            "separate diagnostic evaluation on a copied run setting and an "
+            "immutable prefix projection of a 250-user master tape whose first "
+            "100 trajectories reproduce the sealed population; added-user "
+            "randomness is split in the copy; no sealed constant or artifact changed"
+        ),
+        "source_commit": _git("rev-parse", "HEAD"),
+        "source_tree": _git("rev-parse", "HEAD^{tree}"),
+        "runner_reused": str(LADDER / "oracle_runner.py"),
+        "runner_reused_sha256": hashlib.sha256(
+            (LADDER / "oracle_runner.py").read_bytes()
+        ).hexdigest(),
+        "wrapper_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "nice_requested": 15,
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in (
+                "OMP_NUM_THREADS",
+                "OPENBLAS_NUM_THREADS",
+                "MKL_NUM_THREADS",
+                "NUMEXPR_NUM_THREADS",
+            )
+        },
+        "test_split_opened": False,
+        "learner_used": False,
+        "policy_run_used": False,
+        "training_run_used": False,
+        "copied_run_setting": copied_setting.payload(),
+        "worlds": worlds,
+        "anchors": anchors,
+        "summary": summarize(anchors),
+        "wall_seconds": time.perf_counter() - started,
+    }
+    unsigned = json.dumps(
+        result, sort_keys=True, separators=(",", ":"), allow_nan=False
+    ).encode("ascii")
+    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
+    output.write_text(
+        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--users", type=int, required=True)
+    parser.add_argument("--rate-mbps", type=float, required=True)
+    parser.add_argument("--formulation", choices=("sealed", "margin"), required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    result = run_point(
+        users=args.users,
+        rate_bps=args.rate_mbps * 1e6,
+        formulation=args.formulation,
+        output=args.output,
+    )
+    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/.scratch/load-regime-sweep-20260910/build_report.py b/.scratch/load-regime-sweep-20260910/build_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..20398df6b4bdcd363250c704ff02a0f60f1ddbad
--- /dev/null
+++ b/.scratch/load-regime-sweep-20260910/build_report.py
@@ -0,0 +1,326 @@
+#!/usr/bin/env python3
+"""Validate all receipts and render the load/rate sweep report."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+import hashlib
+import json
+import math
+from pathlib import Path
+import subprocess
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+REPORT = ROOT / "LOAD-REGIME-SWEEP-2026-09-10.md"
+SEALED_TREE = "1728f6b0462f86d85618a4c73f4d1dd2d2c07376"
+ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
+FORM_LABEL = {"sealed": "Sealed", "margin": "Margin"}
+POINTS = (
+    (100, 20),
+    (100, 35),
+    (100, 50),
+    (100, 65),
+    (100, 80),
+    (150, 50),
+    (200, 50),
+    (250, 50),
+    (150, 65),
+    (200, 80),
+    (250, 80),
+)
+LOAD_AXIS = ((100, 50), (150, 50), (200, 50), (250, 50))
+RATE_AXIS = ((100, 20), (100, 35), (100, 50), (100, 65), (100, 80))
+JOINT_POINTS = ((150, 65), (200, 80), (250, 80))
+
+
+def load_all():
+    results = {}
+    diagnostics = {}
+    for users, rate in POINTS:
+        for form in FORM_LABEL:
+            key = (users, rate, form)
+            rp = HERE / "results" / f"u{users}-r{rate}-{form}.json"
+            dp = HERE / "diagnostics" / f"u{users}-r{rate}-{form}.json"
+            if not rp.exists() or not dp.exists():
+                raise RuntimeError(f"missing completed artifact for {key}")
+            results[key] = json.loads(rp.read_text())
+            diagnostics[key] = json.loads(dp.read_text())
+    return results, diagnostics
+
+
+def pct(value):
+    return "—" if value is None else f"{100.0 * value:.3f}%"
+
+
+def number(value, digits=3):
+    return "—" if value is None else f"{value:.{digits}f}"
+
+
+def ee_mbit(result, arm):
+    return result["summary"]["pooled"][arm]["ee_bit_per_j"] / 1e6
+
+
+def gap_pct(result):
+    return 100.0 * result["summary"]["oracle_set_over_unilateral_relative"]
+
+
+def point_name(point):
+    users, rate = point
+    if point == (100, 50):
+        return "L100 / R50 (current)"
+    if point in LOAD_AXIS:
+        return f"L{users}"
+    if point in RATE_AXIS:
+        return f"R{rate}"
+    return f"J{users}-{rate}"
+
+
+def validate(results, diagnostics):
+    expected = {(u, r, f) for u, r in POINTS for f in FORM_LABEL}
+    assert set(results) == expected == set(diagnostics)
+    for key in expected:
+        result = results[key]
+        diag = diagnostics[key]
+        assert result["claim_ceiling"] == "DIAGNOSTIC_NOT_CLAIM"
+        assert result["status"] == "COMPLETE"
+        assert result["source_tree"] == SEALED_TREE
+        assert result["sealed_rate_target_bps"] == 50_000_000.0
+        assert result["sealed_constant_changed"] is False
+        assert result["test_split_opened"] is False
+        assert result["learner_used"] is False
+        assert result["policy_run_used"] is False
+        assert result["training_run_used"] is False
+        assert len(result["anchors"]) == 8
+        assert diag["anchor_count"] == 8 and diag["parity_passed"]
+        for arm in ARMS:
+            pooled = result["summary"]["pooled"][arm]
+            audit = diag["arms"][arm]
+            assert abs(audit["scalar_bits"] / pooled["bits"] - 1.0) < 1e-8
+            assert abs(audit["scalar_joules"] / pooled["joules"] - 1.0) < 1e-8
+            assert audit["served_count_sum"] == pooled["served_count_sum"]
+    # Rates share exactly the same projected tapes; load points share masters.
+    by_user_world = defaultdict(set)
+    master_by_world = defaultdict(set)
+    for (users, _rate, _form), result in results.items():
+        for world in result["worlds"]:
+            by_user_world[(users, world["world_index"])].add(world["world_sha256"])
+            master_by_world[world["world_index"]].add(world["master_world_sha256"])
+    assert all(len(values) == 1 for values in by_user_world.values())
+    assert all(len(values) == 1 for values in master_by_world.values())
+    archived_paths = {
+        "sealed": ROOT / ".scratch/ladder-floor-20260910/original-result.json",
+        "margin": ROOT / ".scratch/ladder-floor-20260910/margin-cleared-result.json",
+    }
+    for form, path in archived_paths.items():
+        archived = json.loads(path.read_text())
+        archived_by_id = {row["anchor_id"]: row for row in archived["anchors"]}
+        for row in results[(100, 50, form)]["anchors"]:
+            reference = archived_by_id[row["anchor_id"]]
+            for arm in ARMS:
+                for field in (
+                    "configuration_id",
+                    "bits",
+                    "joules",
+                    "served_count",
+                ):
+                    assert row["committed"][arm][field] == reference["committed"][arm][field]
+    assert subprocess.check_output(
+        ["git", "rev-parse", "HEAD^{tree}"], cwd=ROOT, text=True
+    ).strip() == SEALED_TREE
+
+
+def curve_phrase(results):
+    clauses = []
+    any_growth = False
+    for form in FORM_LABEL:
+        current = gap_pct(results[(100, 50, form)])
+        load_end = gap_pct(results[(250, 50, form)])
+        rate_end = gap_pct(results[(100, 80, form)])
+        joint_values = [
+            (gap_pct(results[(*point, form)]), point) for point in JOINT_POINTS
+        ]
+        joint_max, joint_point = max(joint_values)
+        load_grows = load_end > current + 0.1
+        rate_grows = rate_end > current + 0.1
+        any_growth |= load_grows or rate_grows or joint_max > current + 0.1
+        load_text = "grows" if load_grows else "does not grow"
+        rate_text = "grows" if rate_grows else "does not grow"
+        clauses.append(
+            f"{FORM_LABEL[form].lower()} {load_text} with load to {load_end:+.3f}% at U250/R50 "
+            f"and {rate_text} with rate to {rate_end:+.3f}% at U100/R80; "
+            f"the largest sampled joint-regime gap is {joint_max:+.3f}% at "
+            f"U{joint_point[0]}/R{joint_point[1]}"
+        )
+    opening = (
+        "The joint-over-unilateral gap grows in at least one constrained direction: "
+        if any_growth
+        else "The joint-over-unilateral gap does not grow materially in the sampled constrained regimes: "
+    )
+    return opening + "; ".join(clauses) + "."
+
+
+def curve_table(title, points, results):
+    lines = [
+        f"### {title}",
+        "",
+        "| Point | Users | Rate (Mbit/s) | Formulation | Baseline EE | Unilateral EE | Joint EE | Joint / unilateral | Negative anchors / 8 | Unilateral / baseline |",
+        "|---|---:|---:|---|---:|---:|---:|---:|---:|---:|",
+    ]
+    for point in points:
+        users, rate = point
+        for form in FORM_LABEL:
+            result = results[(users, rate, form)]
+            summary = result["summary"]
+            lines.append(
+                f"| {point_name(point)} | {users} | {rate} | {FORM_LABEL[form]} | "
+                f"{ee_mbit(result, 'BASELINE'):.6f} | {ee_mbit(result, 'UNILATERAL'):.6f} | "
+                f"{ee_mbit(result, 'ORACLE_SET'):.6f} | {gap_pct(result):+.3f}% | "
+                f"{summary['joint_over_unilateral_negative_anchors']} | "
+                f"{100*summary['unilateral_over_baseline_relative']:+.3f}% |"
+            )
+    return lines
+
+
+def metric_table(results, diagnostics):
+    lines = [
+        "## Endpoint and constraint metrics at every point",
+        "",
+        "EE is Mbit/J. Served and target-attained counts are separate sums over 8 anchors; each denominator is `8 × users`. Constraint shares use occupied beam-boundaries. `I-limited` is the share of infeasible user-anchors meeting the declared interference counterfactual, and `top-1` is its aggressor share. Occupancy is mean / maximum over occupied beam-boundaries.",
+        "",
+        "| Point | Form | Selector | EE | Served | Target attained | Cap binds | No eligible mode | Infeasible user-steps | I-limited | Top-1 | Occupancy mean / max | Occupancy distribution (n: beam-boundaries) |",
+        "|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|",
+    ]
+    for users, rate in POINTS:
+        for form in FORM_LABEL:
+            result = results[(users, rate, form)]
+            diag = diagnostics[(users, rate, form)]
+            for arm in ARMS:
+                row = diag["arms"][arm]
+                hist = ", ".join(
+                    f"{n}:{count}"
+                    for n, count in row["occupancy_histogram_beam_boundaries"].items()
+                )
+                lines.append(
+                    f"| {point_name((users, rate))} | {FORM_LABEL[form]} | {arm} | "
+                    f"{ee_mbit(result, arm):.6f} | {row['served_count_sum']} / {8*users} | "
+                    f"{row['rate_target_attained_count_sum']} / {8*users} | "
+                    f"{pct(row['cap_binding_beam_boundary_share'])} | "
+                    f"{pct(row['no_eligible_mode_beam_boundary_share'])} | "
+                    f"{row['infeasible_user_steps']} / {8*users} | "
+                    f"{pct(row['interference_limited_share_of_infeasible_user_steps'])} | "
+                    f"{pct(row['top_one_aggressor_interference_share'])} | "
+                    f"{row['mean_beam_occupancy']:.3f} / {row['maximum_beam_occupancy']} | {hist} |"
+                )
+    return lines
+
+
+def crossings(results, diagnostics):
+    lines = [
+        "## One- and two-per-cent crossings",
+        "",
+        "These are first observed crossings along each ordered one-axis sweep, not interpolated thresholds. Binding columns report the joint selector at that sampled point; table/cap user-step categories can overlap when different boundaries bind for one user-anchor.",
+        "",
+        "| Axis | Form | Threshold | First sampled crossing | Gap | Cap-binding beam-boundaries | No-mode beam-boundaries | I-limited / infeasible user-steps |",
+        "|---|---|---:|---|---:|---:|---:|---:|",
+    ]
+    for axis_name, points in (("Load", LOAD_AXIS), ("Rate", RATE_AXIS)):
+        for form in FORM_LABEL:
+            for threshold in (1.0, 2.0):
+                found = next(
+                    (point for point in points if gap_pct(results[(*point, form)]) >= threshold),
+                    None,
+                )
+                if found is None:
+                    lines.append(
+                        f"| {axis_name} | {FORM_LABEL[form]} | {threshold:.0f}% | Not reached | — | — | — | — |"
+                    )
+                    continue
+                row = diagnostics[(*found, form)]["arms"]["ORACLE_SET"]
+                lines.append(
+                    f"| {axis_name} | {FORM_LABEL[form]} | {threshold:.0f}% | "
+                    f"U{found[0]}/R{found[1]} | {gap_pct(results[(*found, form)]):+.3f}% | "
+                    f"{pct(row['cap_binding_beam_boundary_share'])} | "
+                    f"{pct(row['no_eligible_mode_beam_boundary_share'])} | "
+                    f"{row['interference_limited_infeasible_user_steps']} / {row['infeasible_user_steps']} |"
+                )
+    return lines
+
+
+def build():
+    results, diagnostics = load_all()
+    validate(results, diagnostics)
+    lead = curve_phrase(results)
+    lines = [
+        lead,
+        "",
+        "# Load-regime sweep — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM`",
+        "",
+        "This report answers only where bounded set-level association coordination has diagnostic value. It does not rank sweep points, recommend a setting, or adopt a new constant. Every row is a separate evaluation on a copied run setting. The sealed per-user rate remains **50 Mbit/s**, and **no sealed constant was changed**.",
+        "",
+        "## Curve",
+        "",
+        "Pooled EE is `sum(decoded bits) / sum(joules)` across the same 8 anchors (4 TRAIN worlds × steps 0 and 1). `Joint` is the reused bounded `ORACLE_SET` selector; it includes the certified unilateral fixed point, but committed realised EE can still decline on an anchor because selection uses unchanged boundary-zero objective semantics.",
+        "",
+    ]
+    lines += curve_table("Axis L — offered load at 50 Mbit/s", LOAD_AXIS, results)
+    lines += [""] + curve_table("Axis R — rate target at 100 users", RATE_AXIS, results)
+    lines += [""] + curve_table("Joint load/rate samples", JOINT_POINTS, results)
+    lines += [""] + crossings(results, diagnostics)
+    lines += [""] + metric_table(results, diagnostics)
+    lines += [
+        "",
+        "## Point-by-point sealed-value declaration",
+        "",
+    ]
+    for point in POINTS:
+        lines.append(
+            f"- U{point[0]}/R{point[1]}: diagnostic target {point[1]} Mbit/s; the sealed value is 50 Mbit/s and no sealed constant was changed. Both formulations are separate copied evaluations."
+        )
+    definitions = diagnostics[(100, 50, "sealed")]["definitions"]
+    lines += [
+        "",
+        "## Definitions and interpretation",
+        "",
+        f"- Beam-boundary: {definitions['beam_boundary']}.",
+        f"- Cap-binding: {definitions['cap_binding']}.",
+        f"- No eligible mode: {definitions['no_eligible_mode']}.",
+        f"- Infeasible user-step: {definitions['infeasible_user_step']}.",
+        f"- Interference-limited: {definitions['interference_limited']}.",
+        f"- Top-one aggressor share: {definitions['top_one_aggressor_share']}.",
+        f"- Occupancy: {definitions['occupancy']}. The full realised distribution is printed in every selector row, rather than merging selectors.",
+        "",
+        "The load sweep is genuinely nested. For each domain, the script builds one immutable 250-user master tape, preserving the sealed RNG consumption for users 0–99 and placing only added users on a deterministic split stream, then takes first-N projections. Retained users therefore keep identical geometry, fading, epoch, satellite inventory, seed, horizon, and 48 boundary times across L points. Rate points reuse the same projected tape. Population changes only which prefix users participate. As an exact check, the U100/R50 selections, configuration IDs, bits, joules, and served counts match the prior 20-anchor runner's corresponding 8 sealed and strict-margin anchors field-for-field.",
+        "",
+        "`Sealed` uses the unchanged production batch formulation. `Margin` uses the prior strict private margin-provisioning copy (`cleared_margin_batch.py`), including its numerical clearance check; it does not edit production physics. The price, sign, seed mapping, 30.08 s horizon, circuit price, 1.65 W cap, mode table, fading quantile, baseline served-count guard, and acceptance/tie rules are unchanged.",
+        "",
+        "The bounded joint catalogue is mechanism-limited (occupant subsets through size four, victim plus top contributors, and complete beam evacuation; 4,096-candidate ceiling). Results describe that selector, not a global combinatorial optimum.",
+        "",
+        "## Reproduction and verification",
+        "",
+        "Exact commands, from the workspace root:",
+        "",
+        "```bash",
+        "bash .scratch/load-regime-sweep-20260910/run_all_points.sh",
+        "bash .scratch/load-regime-sweep-20260910/run_all_diagnostics.sh",
+        "/home/sat/mcrl-leo-handover/.venv/bin/python .scratch/load-regime-sweep-20260910/build_report.py",
+        "```",
+        "",
+        "The two run scripts expand every evaluation command to `PYTHONPATH=src`, one BLAS/OpenMP thread, the required interpreter, and `nice -n 15`. Each point receipt records the copied setting, four master/projected tape digests, source commit/tree, reused-runner hash, wrapper hash, no TEST access, and no learner/policy/training run. Diagnostics rebuild each master tape, assert projected digest identity, replay all 24 committed profiles through the independent scalar path, and require bits/joules relative error below `1e-8` with exact served-count parity.",
+        "",
+        "Evidence directory: `.scratch/load-regime-sweep-20260910/` (`results/`, `diagnostics/`, `logs/`, source audit, scripts, and completion criterion). The Git tree remains `1728f6b0462f86d85618a4c73f4d1dd2d2c07376`.",
+        "",
+        "## Coverage",
+        "",
+        "Reached all 11 distinct parameter points under both formulations: 22 point-formulation runs, 8 anchors each, 176 anchor evaluations, plus 528 independent committed-profile scalar replays. **Unreached points: none.** No training run, policy run, or learner was used.",
+    ]
+    text = "\n".join(lines) + "\n"
+    REPORT.write_text(text)
+    print(REPORT)
+
+
+if __name__ == "__main__":
+    build()
