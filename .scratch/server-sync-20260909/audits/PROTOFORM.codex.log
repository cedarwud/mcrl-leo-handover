    17	
    18	class StageCContractError(RuntimeError):
    19	    """A fail-closed Stage C contract check failed."""
    20	
    21	
    22	def canonical_json_bytes(value: Any) -> bytes:
    23	    """Return the one admitted JSON representation."""
    24	
    25	    try:
    26	        return json.dumps(
    27	            value,
    28	            sort_keys=True,
    29	            separators=(",", ":"),
    30	            ensure_ascii=True,
    31	            allow_nan=False,
    32	        ).encode("ascii")
    33	    except (TypeError, ValueError, UnicodeEncodeError) as error:
    34	        raise StageCContractError("value is not canonical finite JSON") from error
    35	
    36	
    37	def canonical_sha256(value: Any) -> str:
    38	    return sha256(canonical_json_bytes(value)).hexdigest()
    39	
    40	
    41	def file_sha256(path: str | Path) -> str:
    42	    source = Path(path)
    43	    if source.is_symlink() or not source.is_file():
    44	        raise StageCContractError(f"artifact is not a regular file: {source}")
    45	    digest = sha256()
    46	    with source.open("rb") as stream:
    47	        for block in iter(lambda: stream.read(1024 * 1024), b""):
    48	            digest.update(block)
    49	    return digest.hexdigest()
    50	
    51	
    52	def float_hex(value: float | int) -> str:
    53	    number = float(value)
    54	    if not (number == number and abs(number) != float("inf")):
    55	        raise StageCContractError("receipt floats must be finite")
    56	    return number.hex()
    57	
    58	
    59	def parse_float_hex(value: object, *, field: str) -> float:
    60	    if not isinstance(value, str):
    61	        raise StageCContractError(f"{field} must be a hexadecimal float string")
    62	    try:
    63	        number = float.fromhex(value)
    64	    except ValueError as error:
    65	        raise StageCContractError(f"{field} is not a hexadecimal float") from error
    66	    if not (number == number and abs(number) != float("inf")):
    67	        raise StageCContractError(f"{field} must be finite")
    68	    if number.hex() != value:
    69	        raise StageCContractError(f"{field} is not canonical float.hex output")
    70	    return number
    71	
    72	
    73	def _write_once_bytes(path: Path, payload: bytes) -> str:
    74	    """Publish complete bytes without an overwrite race, then make read-only."""
    75	
    76	    path.parent.mkdir(parents=True, exist_ok=True)
    77	    if path.exists() or path.is_symlink():
    78	        raise StageCContractError(f"refusing to overwrite artifact: {path}")
    79	    temporary = path.parent / f".{path.name}.{secrets.token_hex(12)}.tmp"
    80	    descriptor: int | None = None
    81	    try:
    82	        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    83	        with os.fdopen(descriptor, "wb", closefd=True) as stream:
    84	            descriptor = None
    85	            stream.write(payload)
    86	            stream.flush()
    87	            os.fsync(stream.fileno())
    88	        try:
    89	            os.link(temporary, path)
    90	        except FileExistsError as error:
    91	            raise StageCContractError(f"refusing to overwrite artifact: {path}") from error
    92	        path.chmod(0o444)
    93	        directory_fd = os.open(path.parent, os.O_RDONLY)
    94	        try:
    95	            os.fsync(directory_fd)
    96	        finally:
    97	            os.close(directory_fd)
    98	    finally:
    99	        if descriptor is not None:
   100	            os.close(descriptor)
   101	        try:
   102	            temporary.unlink()
   103	        except FileNotFoundError:
   104	            pass
   105	    return sha256(payload).hexdigest()
   106	
   107	
   108	def write_once_with_sha256(path: str | Path, payload: bytes) -> str:
   109	    """Write one immutable artifact and its immediate immutable SHA sidecar."""
   110	
   111	    destination = Path(path)
   112	    digest = _write_once_bytes(destination, payload)
   113	    _write_once_bytes(
   114	        destination.with_name(destination.name + ".sha256"),
   115	        f"{digest}  {destination.name}\n".encode("ascii"),
   116	    )
   117	    return digest
   118	
   119	
   120	def write_once_json(path: str | Path, value: Any) -> str:
   121	    return write_once_with_sha256(path, canonical_json_bytes(value) + b"\n")
   122	
   123	
   124	def verify_sha256_sidecar(path: str | Path) -> str:
   125	    source = Path(path)
   126	    sidecar = source.with_name(source.name + ".sha256")
   127	    if sidecar.is_symlink() or not sidecar.is_file():
   128	        raise StageCContractError(f"missing SHA-256 sidecar: {sidecar}")
   129	    try:
   130	        parts = sidecar.read_text(encoding="ascii").strip().split()
   131	    except OSError as error:
   132	        raise StageCContractError(f"cannot read SHA-256 sidecar: {sidecar}") from error
   133	    if len(parts) != 2 or parts[1] != source.name:
   134	        raise StageCContractError(f"malformed SHA-256 sidecar: {sidecar}")
   135	    expected = parts[0]
   136	    if len(expected) != 64 or any(char not in "0123456789abcdef" for char in expected):
   137	        raise StageCContractError(f"malformed SHA-256 digest: {sidecar}")
   138	    actual = file_sha256(source)
   139	    if actual != expected:
   140	        raise StageCContractError(f"SHA-256 mismatch for {source}")
   141	    return actual
   142	
   143	
   144	def read_verified_json(path: str | Path) -> Any:
   145	    source = Path(path)
   146	    verify_sha256_sidecar(source)
   147	    try:
   148	        encoded = source.read_bytes()
   149	        payload = json.loads(encoded.decode("ascii"))
   150	    except (OSError, UnicodeError, json.JSONDecodeError) as error:
   151	        raise StageCContractError(f"cannot read canonical JSON: {source}") from error
   152	    if encoded != canonical_json_bytes(payload) + b"\n":
   153	        raise StageCContractError(f"noncanonical JSON artifact: {source}")
   154	    return payload
   155	
   156	
