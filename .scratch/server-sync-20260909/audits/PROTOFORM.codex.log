  1141	    def load_checkpoint(self, path: str | Path) -> None:
  1142	        payload = read_verified_json(path)
  1143	        expected_neutral = {
  1144	            route: self.neutral_sources[route].digest for route in ROUTES
  1145	        }
  1146	        expected_source_map = {
  1147	            arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS
  1148	        }
  1149	        if (
  1150	            payload.get("schema") != "mcrl-v025-stagec-v1-lineage-checkpoint-v1"
  1151	            or payload.get("learner_seed") != self.learner_seed
  1152	            or payload.get("initialization_sha256") != self.initialization_sha256
  1153	            or canonical_sha256(payload.get("initialization")) != self.initialization_sha256
  1154	            or payload.get("legacy_trainer_literals_sha256") != LEGACY_TRAINER_LITERALS_SHA256
  1155	            or canonical_sha256(payload.get("legacy_trainer_literals"))
  1156	            != LEGACY_TRAINER_LITERALS_SHA256
  1157	            or payload.get("checkpoint_every_source_epochs")
  1158	            != CHECKPOINT_EVERY_SOURCE_EPOCHS
  1159	            or payload.get("epoch_budget") != LEGACY_EPOCH_BUDGET
  1160	            or payload.get("stopping_rule") != "exact_epoch_budget_no_early_selection"
  1161	            or payload.get("training_physics_digest") != self.physics_digest
  1162	            or payload.get("batch_digests") != {
  1163	                "C1": self.q1_batch.digest, "C2": self.q2_batch.digest, "C3": self.c3_batch.digest
  1164	            }
  1165	            or payload.get("neutral_source_digests") != expected_neutral
  1166	            or payload.get("source_map") != expected_source_map
  1167	            or payload.get("zero_bootstrap") is not True
  1168	        ):
  1169	            raise StageCContractError("checkpoint authority drifted")
