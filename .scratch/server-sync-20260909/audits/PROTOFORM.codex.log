     2	
     3	The helpers in this module deliberately do not depend on ``physics_v025``.
     4	That package is still moving; Stage C authenticates values at its boundary and
     5	keeps the adapter replaceable.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	from hashlib import sha256
    11	import json
    12	import os
    13	from pathlib import Path
    14	import secrets
    15	from typing import Any
