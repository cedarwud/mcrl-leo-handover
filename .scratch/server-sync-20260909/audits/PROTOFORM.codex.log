   549	@dataclass(frozen=True, slots=True)
   550	class CoalitionBatch:
   551	    """Typed C3 scalar batch over complete set-conditioned contexts."""
   552	
   553	    contexts: tuple[CoalitionContext, ...]
   554	    invariant_states: np.ndarray
   555	    target_psi: np.ndarray
   556	    row_identities: tuple[str, ...]
   557	    source_authority_sha256: str
   558	    source_identity: str
   559	    physics_digest: str
   560	    member_width: int
   561	    digest: str
   562	
   563	    @classmethod
   564	    def create(
   565	        cls,
   566	        shards: Sequence[CoalitionShard],
   567	        *,
   568	        source_identity: str = "informed",
   569	        target_override: Sequence[float] | None = None,
   570	    ) -> "CoalitionBatch":
   571	        rows = tuple(row for shard in shards for row in shard.rows)
   572	        if not rows:
   573	            raise StageCContractError("C3 coalition batch cannot be empty")
   574	        physics = {row.physics_digest for row in rows}
   575	        if len(physics) != 1:
   576	            raise StageCContractError("C3 coalition shards mix physics digests")
   577	        physics_digest = next(iter(physics))
   578	        widths = {len(member.invariant_features) for row in rows for member in row.context.members}
   579	        if len(widths) != 1:
   580	            raise StageCContractError("C3 coalition member width drifted")
   581	        member_width = next(iter(widths))
   582	        contexts = tuple(row.context for row in rows)
   583	        states = np.stack(
   584	            [context.invariant_vector(member_width=member_width) for context in contexts]
   585	        )
   586	        targets = np.asarray(
   587	            [
   588	                parse_float_hex(row.psi_normalized_hex, field="psi_normalized")
   589	                for row in rows
   590	            ]
   591	            if target_override is None
   592	            else target_override,
   593	            dtype=np.float64,
   594	        )
   595	        if targets.shape != (len(rows),) or not np.isfinite(targets).all():
   596	            raise StageCContractError("C3 scalar target shape drifted")
   597	        identities = tuple(
   598	            f"{row.world_id}|{row.anchor_id}|{','.join(map(str, row.context.changed_users))}"
   599	            for row in rows
   600	        )
   601	        authority = canonical_sha256(
   602	            {
   603	                "schema": "mcrl-v025-stagec-c3-source-authority-v1",
   604	                "shards": [shard.file_sha256 for shard in shards],
   605	                "row_schemas": sorted({row.schema for row in rows}),
   606	                "catalogues": sorted({row.catalogue_digest for row in rows}),
   607	                "physics": sorted({row.physics_digest for row in rows}),
   608	            }
   609	        )
   610	        payload = {
   611	            "schema": "mcrl-v025-stagec-c3-coalition-batch-v1",
   612	            "source_identity": source_identity,
   613	            "shape": list(states.shape),
   614	            "states": [[float_hex(value) for value in row] for row in states],
   615	            "targets": [float_hex(value) for value in targets],
   616	            "row_identities": list(identities),
   617	            "source_authority_sha256": authority,
   618	            "anchored_zero_empty_and_singleton": True,
   619	            "physics_digest": physics_digest,
   620	            "permutation_invariant": True,
   621	        }
   622	        return cls(
   623	            contexts,
   624	            states,
   625	            targets,
   626	            identities,
   627	            authority,
   628	            source_identity,
   629	            physics_digest,
   630	            member_width,
   631	            canonical_sha256(payload),
   632	        )
   633	
   634	    def neutral(self, definition: NeutralSourceDefinition) -> "CoalitionBatch":
   635	        if definition.route != "C3":
   636	            raise StageCContractError("C3 batch requires the C3 neutral definition")
   637	        # Preserve support, strata, weights, order, and dose exactly.  The
   638	        # definition digest makes the source identity explicit in checkpoints.
   639	        return CoalitionBatch(
   640	            contexts=self.contexts,
   641	            invariant_states=self.invariant_states.copy(),
   642	            target_psi=np.zeros_like(self.target_psi),
   643	            row_identities=self.row_identities,
   644	            source_authority_sha256=self.source_authority_sha256,
   645	            source_identity=f"neutral:{definition.digest}",
   646	            physics_digest=self.physics_digest,
   647	            member_width=self.member_width,
   648	            digest=canonical_sha256(
   649	                {
   650	                    "informed_batch": self.digest,
   651	                    "neutral_source_sha256": definition.digest,
   652	                    "targets": [float_hex(0.0) for _ in self.target_psi],
   653	                }
   654	            ),
   655	        )
