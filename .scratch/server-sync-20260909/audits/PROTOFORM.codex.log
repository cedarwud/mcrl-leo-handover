   263	@dataclass(slots=True)
   264	class LinearHead:
   265	    weights: np.ndarray
   266	    bias: float
   267	
   268	    def clone(self) -> "LinearHead":
   269	        return LinearHead(self.weights.copy(), float(self.bias))
   270	
   271	    def score(self, state: Sequence[float]) -> float:
   272	        values = np.asarray(state, dtype=np.float64)
   273	        if values.shape != self.weights.shape:
   274	            raise StageCContractError("learner state shape drifted")
   275	        return float(values @ self.weights + self.bias)
   276	
   277	    def update(self, batch: PairwiseBatch, *, learning_rate: float, gauge_weight: float) -> float:
   278	        # Pairwise fixed-target regression with a reference-zero gauge. No
   279	        # reward, next state, target network, discount, or bootstrap exists.
   280	        reference_q = batch.reference_states @ self.weights + self.bias
   281	        candidate_q = batch.candidate_states @ self.weights + self.bias
   282	        residual = candidate_q - reference_q - batch.target_deltas
   283	        count = float(batch.target_deltas.size)
   284	        gradient_w = (2.0 / count) * ((batch.candidate_states - batch.reference_states).T @ residual)
   285	        gradient_w += (2.0 * gauge_weight / count) * (batch.reference_states.T @ reference_q)
   286	        gradient_b = float((2.0 * gauge_weight / count) * reference_q.sum())
   287	        self.weights -= learning_rate * gradient_w
   288	        self.bias -= learning_rate * gradient_b
   289	        loss = float(np.mean(residual * residual) + gauge_weight * np.mean(reference_q * reference_q))
   290	        if not np.isfinite(self.weights).all() or not np.isfinite(self.bias) or not np.isfinite(loss):
   291	            raise StageCContractError("non-finite learner update")
   292	        return loss
   293	
   294	
   295	@dataclass(slots=True)
   296	class ThreeRouteModel:
   297	    heads: dict[Route, LinearHead]
   298	    trained_arm: str | None = None
   299	    source_map_sha256: str | None = None
   300	
   301	    def clone(self) -> "ThreeRouteModel":
   302	        return ThreeRouteModel(
   303	            {route: head.clone() for route, head in self.heads.items()},
   304	            self.trained_arm,
   305	            self.source_map_sha256,
   306	        )
   307	
   308	    def score(self, route: Route, state: Sequence[float]) -> float:
   309	        return self.heads[route].score(state)
   310	
   311	    def payload(self) -> dict[str, object]:
   312	        return {
   313	            route: {
   314	                "weights_hex": [float_hex(value) for value in self.heads[route].weights],
   315	                "bias_hex": float_hex(self.heads[route].bias),
   316	            }
   317	            for route in ROUTES
   318	        }
   319	
   320	
   321	def _initial_model(seed: int, dimensions: Mapping[Route, int]) -> ThreeRouteModel:
   322	    rng = np.random.default_rng(seed)
   323	    return ThreeRouteModel(
   324	        {
   325	            route: LinearHead(rng.normal(0.0, 0.01, dimensions[route]), 0.0)
   326	            for route in ROUTES
   327	        }
   328	    )
