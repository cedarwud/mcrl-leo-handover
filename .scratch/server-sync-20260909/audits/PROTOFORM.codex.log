    69	def _schema_payload(version: str, features: Sequence[FeatureSpec]) -> dict[str, object]:
    70	    return {
    71	        "schema": version,
    72	        "normalization": "raw_value / positive_frozen_scale; signed values retained",
    73	        "shape": [len(features)],
    74	        "features": [
    75	            {"name": item.name, "unit": item.unit, "scale_hex": float_hex(item.scale)}
    76	            for item in features
    77	        ],
    78	        "removed": ["recurrence_power", "entry_gain_ratio", "segment_age"],
    79	    }
    80	
    81	
    82	Q2_FEATURES = Q2_CURRENT_FEATURES + tuple(
    83	    FeatureSpec(f"offset_{offset}_{feature.name}", feature.unit, feature.scale)
    84	    for offset in (1, 2, 3)
    85	    for feature in Q2_OFFSET_FEATURES
    86	)
    87	Q1_SCHEMA = _schema_payload(Q1_SCHEMA_VERSION, Q1_FEATURES)
    88	Q2_SCHEMA = _schema_payload(Q2_SCHEMA_VERSION, Q2_FEATURES)
    89	Q1_SCHEMA_SHA256 = canonical_sha256(Q1_SCHEMA)
    90	Q2_SCHEMA_SHA256 = canonical_sha256(Q2_SCHEMA)
