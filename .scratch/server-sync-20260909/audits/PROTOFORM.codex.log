   331	class LineageOrchestrator:
   332	    """Five matched learned arms plus an external BASELINE policy."""
   333	
   334	    def __init__(
   335	        self,
   336	        *,
   337	        learner_seed: int,
   338	        batches: Mapping[Route, PairwiseBatch],
   339	        learning_rate: float = 0.02,
   340	        gauge_weight: float = 0.01,
   341	    ) -> None:
   342	        if set(batches) != set(ROUTES):
   343	            raise StageCContractError("orchestrator needs exactly C1/C2/C3 batches")
   344	        self.learner_seed = int(learner_seed)
   345	        self.batches = dict(batches)
   346	        self.learning_rate = float(learning_rate)
   347	        self.gauge_weight = float(gauge_weight)
   348	        dimensions = {route: batch.reference_states.shape[1] for route, batch in batches.items()}
   349	        template = _initial_model(self.learner_seed, dimensions)
   350	        self.initialization_payload = template.payload()
   351	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
   352	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
   353	        self.completed_source_epochs = 0
   354	        self.route_update_count = 0
   355	        self.loss_history: list[dict[str, object]] = []
   356	
   357	    @property
   358	    def batch_digests(self) -> dict[str, str]:
   359	        return {route: self.batches[route].digest for route in ROUTES}
   360	
   361	    @property
   362	    def source_authority_sha256(self) -> str:
   363	        authorities = {
   364	            batch.source_authority_sha256 for batch in self.batches.values()
   365	        }
   366	        if len(authorities) != 1:
   367	            raise StageCContractError("route batches disagree on source authority")
   368	        return next(iter(authorities))
   369	
   370	    def train_epoch(self) -> dict[str, dict[str, float]]:
   371	        """One deterministic pass over C1, C2, C3 fixed aggregate batches."""
   372	
   373	        epoch_losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
   374	        for route in ROUTES:
   375	            informed = self.batches[route]
   376	            neutral = informed.neutral()
   377	            for arm in LEARNED_ARMS:
   378	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
   379	                epoch_losses[arm][route] = self.models[arm].heads[route].update(
   380	                    batch,
   381	                    learning_rate=self.learning_rate,
   382	                    gauge_weight=self.gauge_weight,
   383	                )
   384	            self.route_update_count += 1
   385	        self.completed_source_epochs += 1
   386	        self.loss_history.append({"epoch": self.completed_source_epochs, "losses": epoch_losses})
   387	        return epoch_losses
   388	
   389	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
   390	        if isinstance(epochs, bool) or epochs < 0:
   391	            raise StageCContractError("epochs must be a nonnegative integer")
   392	        for _ in range(epochs):
   393	            self.train_epoch()
   394	            if (
   395	                checkpoint_directory is not None
   396	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
   397	            ):
   398	                path = Path(checkpoint_directory) / (
   399	                    f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
   400	                )
   401	                self.write_checkpoint(path)
   402	
   403	    def checkpoint_payload(self) -> dict[str, object]:
   404	        return {
   405	            "schema": CHECKPOINT_SCHEMA,
   406	            "learner_seed": self.learner_seed,
   407	            "completed_source_epochs": self.completed_source_epochs,
   408	            "route_update_count": self.route_update_count,
   409	            "updates_per_source_epoch": len(ROUTES),
   410	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
   411	            "q1_schema_sha256": Q1_SCHEMA_SHA256,
   412	            "q2_schema_sha256": Q2_SCHEMA_SHA256,
   413	            "batch_digests": self.batch_digests,
   414	            "source_authority_sha256": self.source_authority_sha256,
   415	            "initialization_sha256": self.initialization_sha256,
   416	            "initialization": self.initialization_payload,
   417	            "arm_order": list(ARM_ORDER),
   418	            "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS},
   419	            "arm_order": list(ARM_ORDER),
   420	            "arms": {arm: self.models[arm].payload() for arm in LEARNED_ARMS},
   421	            "optimizer": {
   422	                "kind": "deterministic_full_batch_gradient_descent",
   423	                "learning_rate_hex": float_hex(self.learning_rate),
   424	                "gauge_weight_hex": float_hex(self.gauge_weight),
   425	                "state": "stateless",
   426	            },
   427	            "zero_bootstrap": True,
   428	        }
   429	
   430	    def write_checkpoint(self, path: str | Path) -> str:
   431	        return write_once_json(path, self.checkpoint_payload())
   432	
   433	    def load_checkpoint(self, path: str | Path) -> None:
   434	        payload = read_verified_json(path)
   435	        if not isinstance(payload, dict) or payload.get("schema") != CHECKPOINT_SCHEMA:
   436	            raise StageCContractError("unsupported checkpoint schema")
   437	        fixed = {
   438	            "learner_seed": self.learner_seed,
   439	            "batch_digests": self.batch_digests,
   440	            "source_authority_sha256": self.source_authority_sha256,
   441	            "initialization_sha256": self.initialization_sha256,
   442	            "initialization": self.initialization_payload,
   443	            "arm_order": list(ARM_ORDER),
   444	            "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS},
   445	            "arm_order": list(ARM_ORDER),
   446	            "q1_schema_sha256": Q1_SCHEMA_SHA256,
   447	            "q2_schema_sha256": Q2_SCHEMA_SHA256,
   448	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
   449	            "updates_per_source_epoch": len(ROUTES),
   450	            "zero_bootstrap": True,
   451	        }
   452	        for field, expected in fixed.items():
   453	            if payload.get(field) != expected:
   454	                raise StageCContractError(f"checkpoint {field} mismatch")
   455	        optimizer = payload.get("optimizer")
   456	        expected_optimizer = {
   457	            "kind": "deterministic_full_batch_gradient_descent",
   458	            "learning_rate_hex": float_hex(self.learning_rate),
   459	            "gauge_weight_hex": float_hex(self.gauge_weight),
   460	            "state": "stateless",
   461	        }
   462	        if optimizer != expected_optimizer:
   463	            raise StageCContractError("checkpoint optimizer state mismatch")
   464	        completed = int(payload.get("completed_source_epochs", -1))
   465	        updates = int(payload.get("route_update_count", -1))
   466	        if completed < 0 or updates != completed * len(ROUTES):
   467	            raise StageCContractError("checkpoint source-epoch cursor is invalid")
   468	        arms = payload.get("arms")
   469	        if not isinstance(arms, dict) or set(arms) != set(LEARNED_ARMS):
   470	            raise StageCContractError("checkpoint arm inventory drifted")
   471	        for arm in LEARNED_ARMS:
   472	            arm_payload = arms[arm]
   473	            if not isinstance(arm_payload, dict) or set(arm_payload) != set(ROUTES):
   474	                raise StageCContractError("checkpoint head inventory drifted")
   475	            for route in ROUTES:
   476	                head_payload = arm_payload[route]
   477	                if not isinstance(head_payload, dict):
   478	                    raise StageCContractError("checkpoint head payload drifted")
   479	                weights = np.asarray(
   480	                    [parse_float_hex(value, field="weight") for value in head_payload["weights_hex"]],
   481	                    dtype=np.float64,
   482	                )
   483	                if weights.shape != self.models[arm].heads[route].weights.shape:
   484	                    raise StageCContractError("checkpoint head shape drifted")
   485	                self.models[arm].heads[route].weights[:] = weights
   486	                self.models[arm].heads[route].bias = parse_float_hex(
   487	                    head_payload["bias_hex"], field="bias"
   488	                )
   489	        self.completed_source_epochs = completed
   490	        self.route_update_count = updates
   620	            "permutation_invariant": True,
   621	        }
   622	        return cls(
   623	            contexts,
   624	            states,
   625	            targets,
   626	            identities,
   627	            authority,
   628	            source_identity,
   629	            physics_digest,
   630	            member_width,
   631	            canonical_sha256(payload),
   632	        )
   633	
   634	    def neutral(self, definition: NeutralSourceDefinition) -> "CoalitionBatch":
   635	        if definition.route != "C3":
   636	            raise StageCContractError("C3 batch requires the C3 neutral definition")
   637	        # Preserve support, strata, weights, order, and dose exactly.  The
   638	        # definition digest makes the source identity explicit in checkpoints.
   639	        return CoalitionBatch(
   640	            contexts=self.contexts,
   641	            invariant_states=self.invariant_states.copy(),
   642	            target_psi=np.zeros_like(self.target_psi),
   643	            row_identities=self.row_identities,
   644	            source_authority_sha256=self.source_authority_sha256,
   645	            source_identity=f"neutral:{definition.digest}",
   646	            physics_digest=self.physics_digest,
   647	            member_width=self.member_width,
   648	            digest=canonical_sha256(
   649	                {
   650	                    "informed_batch": self.digest,
   651	                    "neutral_source_sha256": definition.digest,
   652	                    "targets": [float_hex(0.0) for _ in self.target_psi],
   653	                }
   654	            ),
   655	        )
