    98	def validate_physics_admission(
    99	    admission: object | None,
   100	    *,
   101	    synthetic_identity: str | None = None,
   102	) -> None:
   103	    """Section H gate for any source/label construction entry point."""
   104	
   105	    if admission is None:
   106	        raise StageCContractError("H gate requires explicit physics admission")
   107	    if admission is SYNTHETIC_PHYSICS_HOLD:
   108	        if synthetic_identity is None or not synthetic_identity.startswith("V025_SYNTHETIC/"):
   109	            raise StageCContractError(
   110	                "synthetic H-gate authority cannot admit a non-synthetic identity"
   111	            )
   112	        return
   113	    if isinstance(admission, Mapping) and admission.get("decision") == "PHYSICS-GO":
   114	        digest = admission.get("authority_sha256")
   115	        if not isinstance(digest, str) or len(digest) != 64 or any(
   116	            char not in "0123456789abcdef" for char in digest
   117	        ):
   118	            raise StageCContractError("PHYSICS-GO lacks authenticated authority")
   119	        return
   120	    raise StageCContractError("H gate blocks non-synthetic source construction")

