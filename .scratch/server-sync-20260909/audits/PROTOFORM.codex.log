   959	                "weights_hex": [float_hex(value) for value in self.q1.weights],
   960	                "bias_hex": float_hex(self.q1.bias),
   961	            },
   962	            "C2": self.q2.payload() if isinstance(self.q2, AdamMLPHead) else {
   963	                "kind": "pairwise_zero_bootstrap_linear",
   964	                "weights_hex": [float_hex(value) for value in self.q2.weights],
   965	                "bias_hex": float_hex(self.q2.bias),
   966	            },
   967	            "C3": self.psi.payload(),
   968	        }
