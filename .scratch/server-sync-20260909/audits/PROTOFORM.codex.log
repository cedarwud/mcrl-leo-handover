  1184	        updates = int(payload.get("route_update_count", -1))
  1185	        if (
  1186	            completed <= 0
  1187	            or completed > LEGACY_EPOCH_BUDGET
  1188	            or completed % CHECKPOINT_EVERY_SOURCE_EPOCHS
