new file mode 100644
index 0000000000000000000000000000000000000000..6662dc8f58d2b29cb9a3ac9924852071dbcc7f45
--- /dev/null
+++ b/.scratch/protoform/run_matrix.py
@@ -0,0 +1,392 @@
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import struct
+from pathlib import Path
+
+import numpy as np
+
+from mcrl.stagec_v025.canonical import canonical_json_bytes, canonical_sha256, write_once_json
+from mcrl.stagec_v025.learner import (
+    ARM_ORDER,
+    CHECKPOINT_EVERY_SOURCE_EPOCHS,
+    LEARNED_ARMS,
+    LEGACY_EPOCH_BUDGET,
+    ROUTES,
+    CoalitionBatch,
+    PairwiseBatch,
+    V1LineageOrchestrator,
+    default_synthetic_neutral_sources,
+)
+
+
+ROOT = Path("/home/sat/mcrl-v025-certprofile-ws/.scratch/protoform")
+CASES = ROOT / "cases"
+MATRIX_PATH = ROOT / "matrix.json"
+SEALED_LEARNER = Path(
+    "/home/sat/mcrl-v025-stagec4b-snapshot-20260909/src/mcrl/stagec_v025/learner.py"
+)
+PHYSICS = "b" * 64
+AUTHORITY = "a" * 64
+SEED = 20260910
+
+
+def fixture() -> V1LineageOrchestrator:
+    q1 = PairwiseBatch.create(
+        "C1",
+        [[0.0]],
+        [[1.0]],
+        [0.25],
+        ["fixture|q1|0"],
+        AUTHORITY,
+        physics_digest=PHYSICS,
+    )
+    q2 = PairwiseBatch.create(
+        "C2",
+        [[0.5]],
+        [[-0.25]],
+        [-0.125],
+        ["fixture|q2|0"],
+        AUTHORITY,
+        physics_digest=PHYSICS,
+    )
+    c3 = CoalitionBatch(
+        contexts=(),
+        invariant_states=np.asarray([[0.25]], dtype=np.float64),
+        target_psi=np.asarray([0.375], dtype=np.float64),
+        row_identities=("fixture|c3|0",),
+        source_authority_sha256=AUTHORITY,
+        source_identity="informed",
+        physics_digest=PHYSICS,
+        member_width=1,
+        digest=canonical_sha256(
+            {
+                "schema": "protoform-trivial-c3-fixture-v1",
+                "state": [float(0.25).hex()],
+                "target": [float(0.375).hex()],
+                "physics": PHYSICS,
+            }
+        ),
+    )
+    return V1LineageOrchestrator(
+        learner_seed=SEED,
+        q1_batch=q1,
+        q2_batch=q2,
+        c3_batch=c3,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+
+
+def set_cursor(orchestrator: V1LineageOrchestrator, completed: int) -> None:
+    orchestrator.completed_source_epochs = completed
+    orchestrator.route_update_count = completed * len(ROUTES)
+
+
+def error_text(error: BaseException) -> str:
+    return f"{type(error).__name__}: {error}"
+
+
+def raw_state_bytes(orchestrator: V1LineageOrchestrator) -> bytes:
+    encoded = bytearray()
+    encoded.extend(struct.pack(">qq", orchestrator.completed_source_epochs, orchestrator.route_update_count))
+    for arm in LEARNED_ARMS:
+        model = orchestrator.models[arm]
+        for head in (model.q1, model.q2, model.psi.network):
+            for group in (
+                head.weights,
+                head.biases,
+                head.first_moment_w,
+                head.second_moment_w,
+                head.first_moment_b,
+                head.second_moment_b,
+            ):
+                for array in group:
+                    encoded.extend(np.ascontiguousarray(array).tobytes(order="C"))
+            encoded.extend(struct.pack(">q", head.adam_step))
+    return bytes(encoded)
+
+
+def payload_state_bytes(orchestrator: V1LineageOrchestrator) -> bytes:
+    return canonical_json_bytes(orchestrator.checkpoint_payload())
+
+
+def write_then_load(label: str, completed: int) -> dict[str, object]:
+    source = fixture()
+    set_cursor(source, completed)
+    path = CASES / f"{label}.json"
+    record: dict[str, object] = {
+        "label": label,
+        "completed_source_epochs": completed,
+        "learned_arms": list(LEARNED_ARMS),
+        "arm_slot_count": len(LEARNED_ARMS),
+        "declared_checkpoint_cadence": CHECKPOINT_EVERY_SOURCE_EPOCHS,
+        "path": str(path.relative_to(ROOT)),
+    }
+    try:
+        digest = source.write_checkpoint(path)
+        record["writer"] = "PASS"
+        record["file_sha256"] = digest
+    except BaseException as error:
+        record["writer"] = "FAIL"
+        record["writer_error"] = error_text(error)
+        record["loader"] = "NOT_RUN"
+        record["verdict"] = "FAIL"
+        return record
+    target = fixture()
+    try:
+        target.load_checkpoint(path)
+        record["loader"] = "PASS"
+        record["verdict"] = "PASS"
+        record["payload_bytes_equal_after_load"] = payload_state_bytes(source) == payload_state_bytes(target)
+        record["raw_state_bytes_equal_after_load"] = raw_state_bytes(source) == raw_state_bytes(target)
+    except BaseException as error:
+        record["loader"] = "FAIL"
+        record["loader_error"] = error_text(error)
+        record["verdict"] = "FAIL"
+    return record
+
+
+def raw_payload_load_probe(label: str, payload: dict[str, object]) -> dict[str, object]:
+    path = CASES / f"{label}.json"
+    record: dict[str, object] = {"label": label, "path": str(path.relative_to(ROOT))}
+    try:
+        digest = write_once_json(path, payload)
+        record["canonical_writer"] = "PASS"
+        record["file_sha256"] = digest
+    except BaseException as error:
+        record["canonical_writer"] = "FAIL"
+        record["writer_error"] = error_text(error)
+        record["loader"] = "NOT_RUN"
+        record["verdict"] = "FAIL"
+        return record
+    target = fixture()
+    try:
+        target.load_checkpoint(path)
+        record["loader"] = "PASS"
+        record["verdict"] = "PASS"
+    except BaseException as error:
+        record["loader"] = "FAIL"
+        record["loader_error"] = error_text(error)
+        record["verdict"] = "FAIL"
+    return record
+
+
+def inventory_probe(label: str, learned_count: int, external_count: int) -> dict[str, object]:
+    source = fixture()
+    set_cursor(source, 500)
+    payload = source.checkpoint_payload()
+    arms = payload["arms"]
+    assert isinstance(arms, dict)
+    extra_learned = [f"EXTRA_LEARNED_{index}" for index in range(1, learned_count - len(LEARNED_ARMS) + 1)]
+    for arm in extra_learned:
+        arms[arm] = copy.deepcopy(arms["FULL"])
+    for index in range(1, external_count + 1):
+        arms[f"EXTERNAL_CONTROL_{index}"] = copy.deepcopy(arms["FULL"])
+    record = raw_payload_load_probe(label, payload)
+    record.update(
+        {
+            "completed_source_epochs": 500,
+            "learned_arm_count": learned_count,
+            "external_control_count": external_count,
+            "arm_slot_count": len(arms),
+            "arm_slots": list(arms),
+        }
+    )
+    return record
+
+
+def resume_probe(label: str, checkpoint_epoch: int) -> dict[str, object]:
+    uninterrupted = fixture()
+    set_cursor(uninterrupted, checkpoint_epoch)
+    path = CASES / f"{label}.json"
+    checkpoint_sha256 = uninterrupted.write_checkpoint(path)
+    resumed = fixture()
+    resumed.load_checkpoint(path)
+
+    pre_payload_equal = payload_state_bytes(uninterrupted) == payload_state_bytes(resumed)
+    pre_raw_equal = raw_state_bytes(uninterrupted) == raw_state_bytes(resumed)
+    uninterrupted.train_epoch()
+    resumed.train_epoch()
+    uninterrupted_payload = payload_state_bytes(uninterrupted)
+    resumed_payload = payload_state_bytes(resumed)
+    uninterrupted_raw = raw_state_bytes(uninterrupted)
+    resumed_raw = raw_state_bytes(resumed)
+    payload_equal = uninterrupted_payload == resumed_payload
+    raw_equal = uninterrupted_raw == resumed_raw
+    return {
+        "label": label,
+        "checkpoint_epoch": checkpoint_epoch,
+        "comparison_epoch": checkpoint_epoch + 1,
+        "file_sha256": checkpoint_sha256,
+        "declared_checkpoint_cadence": CHECKPOINT_EVERY_SOURCE_EPOCHS,
+        "pre_update_payload_bytes_equal": pre_payload_equal,
+        "pre_update_raw_state_bytes_equal": pre_raw_equal,
+        "post_update_payload_bytes_equal": payload_equal,
+        "post_update_raw_state_bytes_equal": raw_equal,
+        "uninterrupted_payload_sha256": hashlib.sha256(uninterrupted_payload).hexdigest(),
+        "resumed_payload_sha256": hashlib.sha256(resumed_payload).hexdigest(),
+        "uninterrupted_raw_state_sha256": hashlib.sha256(uninterrupted_raw).hexdigest(),
+        "resumed_raw_state_sha256": hashlib.sha256(resumed_raw).hexdigest(),
+        "verdict": "PASS" if pre_payload_equal and pre_raw_equal and payload_equal and raw_equal else "FAIL",
+    }
+
+
+def mutation_probe(label: str, mutate) -> dict[str, object]:
+    source = fixture()
+    set_cursor(source, 500)
+    payload = source.checkpoint_payload()
+    mutate(payload)
+    return raw_payload_load_probe(label, payload)
+
+
+def main() -> None:
+    if CASES.exists() or MATRIX_PATH.exists():
+        raise RuntimeError("protoform output already exists; refusing to overwrite")
+    CASES.mkdir(parents=True)
+
+    epochs = {
+        str(epoch): write_then_load(f"epochs-{epoch}", epoch)
+        for epoch in (500, 2000, 2001, 3000, 9000)
+    }
+
+    source_2001 = fixture()
+    set_cursor(source_2001, 2001)
+    epoch_2001_loader_probe = raw_payload_load_probe(
+        "epochs-2001-canonical-load-probe", source_2001.checkpoint_payload()
+    )
+
+    arms_8 = inventory_probe("arms-8-learned", learned_count=8, external_count=0)
+    arms_9 = inventory_probe("arms-8-learned-plus-1-external", learned_count=8, external_count=1)
+
+    cadence_100_roundtrip = write_then_load("cadence-100-at-500", 500)
+    cadence_100_resume = resume_probe("cadence-100-resume-at-100", 100)
+
+    cadence_500_source = fixture()
+    set_cursor(cadence_500_source, 500)
+    cadence_500_payload = cadence_500_source.checkpoint_payload()
+    cadence_500_payload["checkpoint_every_source_epochs"] = 500
+    cadence_500_declared = raw_payload_load_probe("cadence-500-declared", cadence_500_payload)
+    cadence_500_operational_resume = resume_probe("cadence-500-sparse-emission-resume-at-500", 500)
+    cadence_500_operational_resume["protocol_note"] = (
+        "The file was emitted at a 500-epoch spacing but still declares the sealed cadence 100. "
+        "This proves operational sparse emission, not expressibility of declared cadence 500."
+    )
+
+    read_verification_probes = {
+        "wrong_seed": mutation_probe(
+            "probe-wrong-seed", lambda payload: payload.__setitem__("learner_seed", SEED + 1)
+        ),
+        "wrong_batch_digest": mutation_probe(
+            "probe-wrong-batch-digest",
+            lambda payload: payload["batch_digests"].__setitem__("C1", "0" * 64),
+        ),
+        "stored_only_optimizer": mutation_probe(
+            "probe-stored-only-optimizer",
+            lambda payload: payload.__setitem__("optimizer", "mutated-stored-only-value"),
+        ),
+        "stored_only_inner_kind": mutation_probe(
+            "probe-stored-only-inner-kind",
+            lambda payload: payload["arms"]["FULL"]["C1"].__setitem__("kind", "mutated-kind"),
+        ),
+        "ignored_extra_model_route": mutation_probe(
+            "probe-extra-model-route",
+            lambda payload: payload["arms"]["FULL"].__setitem__(
+                "C4", copy.deepcopy(payload["arms"]["FULL"]["C1"])
+            ),
+        ),
+        "ignored_extra_top_level_schema_digest": mutation_probe(
+            "probe-extra-q1-schema-digest",
+            lambda payload: payload.__setitem__("q1_schema_sha256", "0" * 64),
+        ),
+        "ignored_extra_manifest_digest": mutation_probe(
+            "probe-extra-manifest-digest",
+            lambda payload: payload.__setitem__("allocation_manifest_digest", "0" * 64),
+        ),
+    }
+
+    matrix = {
+        "diagnostic_status": "DIAGNOSTIC_NOT_CLAIM",
+        "source": {
+            "sealed_snapshot_root": "/home/sat/mcrl-v025-stagec4b-snapshot-20260909",
+            "learner_path": str(SEALED_LEARNER),
+            "learner_sha256": hashlib.sha256(SEALED_LEARNER.read_bytes()).hexdigest(),
+            "workspace_contains_stagec_v025": False,
+        },
+        "fixture": {
+            "kind": "trivial one-row deterministic in-memory batch fixture",
+            "learner_seed": SEED,
+            "actual_training_updates_per_resume_branch": 1,
+            "no_sealed_artifact_written": True,
+        },
+        "sealed_constants": {
+            "learned_arms": list(LEARNED_ARMS),
+            "external_policy_order": list(ARM_ORDER),
+            "routes": list(ROUTES),
+            "max_epochs": LEGACY_EPOCH_BUDGET,
+            "checkpoint_cadence": CHECKPOINT_EVERY_SOURCE_EPOCHS,
+        },
+        "epoch_cases": epochs,
+        "epoch_2001_loader_probe_after_canonical_low_level_write": epoch_2001_loader_probe,
+        "arm_inventory_cases": {
+            "8_learned": arms_8,
+            "8_learned_plus_1_external": arms_9,
+        },
+        "cadence_cases": {
+            "declared_100_roundtrip_at_epoch_500": cadence_100_roundtrip,
+            "declared_100_resume_at_epoch_100": cadence_100_resume,
+            "declared_500": cadence_500_declared,
+            "sparse_emission_every_500_while_declaring_100": cadence_500_operational_resume,
+        },
+        "read_verification_probes": read_verification_probes,
+        "largest_roundtrip_verified_protocol": {
+            "arm_inventory": list(LEARNED_ARMS),
+            "learned_arm_count": len(LEARNED_ARMS),
+            "external_controls_serialized": 0,
+            "max_completed_source_epochs": 2000,
+            "declared_checkpoint_cadence": 100,
+            "roundtrip": epochs["2000"]["verdict"],
+            "resume_bit_exact": cadence_100_resume["verdict"],
+        },
+    }
+
+    assert epochs["500"]["verdict"] == "PASS"
+    assert epochs["2000"]["verdict"] == "PASS"
+    assert epochs["2001"]["writer_error"] == (
+        "StageCContractError: automatic checkpoints are written only at 100-epoch boundaries"
+    )
+    assert epoch_2001_loader_probe["loader_error"] == (
+        "StageCContractError: checkpoint source cursor drifted"
+    )
+    assert epochs["3000"]["loader_error"] == "StageCContractError: checkpoint source cursor drifted"
+    assert epochs["9000"]["loader_error"] == "StageCContractError: checkpoint source cursor drifted"
+    assert arms_8["loader_error"] == "StageCContractError: checkpoint arm inventory drifted"
+    assert arms_9["loader_error"] == "StageCContractError: checkpoint arm inventory drifted"
+    assert cadence_500_declared["loader_error"] == "StageCContractError: checkpoint authority drifted"
+    assert cadence_100_resume["verdict"] == "PASS"
+    assert cadence_500_operational_resume["verdict"] == "PASS"
+    assert read_verification_probes["wrong_seed"]["verdict"] == "FAIL"
+    assert read_verification_probes["wrong_batch_digest"]["verdict"] == "FAIL"
+    for key in (
+        "stored_only_optimizer",
+        "stored_only_inner_kind",
+        "ignored_extra_model_route",
+        "ignored_extra_top_level_schema_digest",
+        "ignored_extra_manifest_digest",
+    ):
+        assert read_verification_probes[key]["verdict"] == "PASS"
+
+    MATRIX_PATH.write_text(json.dumps(matrix, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({
+        "matrix": str(MATRIX_PATH),
+        "largest": matrix["largest_roundtrip_verified_protocol"],
+        "epoch_verdicts": {key: value["verdict"] for key, value in epochs.items()},
+        "resume_100": cadence_100_resume["verdict"],
+        "declared_cadence_500": cadence_500_declared["verdict"],
+        "sparse_500_resume": cadence_500_operational_resume["verdict"],
+    }, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
