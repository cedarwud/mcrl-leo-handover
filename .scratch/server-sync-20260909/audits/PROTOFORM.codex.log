   971	class V1LineageOrchestrator:
   972	    """C7 matched five-arm learner with a scalar set-conditioned C3 route."""
   973	
   974	    def __init__(
   975	        self,
   976	        *,
   977	        learner_seed: int,
   978	        q1_batch: PairwiseBatch,
   979	        q2_batch: PairwiseBatch,
   980	        c3_batch: CoalitionBatch,
   981	        neutral_sources: Mapping[Route, NeutralSourceDefinition],
   982	    ) -> None:
   983	        if q1_batch.route != "C1" or q2_batch.route != "C2":
   984	            raise StageCContractError("v1 action batches must be C1 then C2")
   985	        if set(neutral_sources) != set(ROUTES) or any(
   986	            neutral_sources[route].route != route for route in ROUTES
   987	        ):
   988	            raise StageCContractError("all three sealed neutral-source definitions are required")
   989	        if len({q1_batch.physics_digest, q2_batch.physics_digest, c3_batch.physics_digest}) != 1:
   990	            raise StageCContractError("C1/C2/C3 training physics digests disagree")
   991	        self.learner_seed = int(learner_seed)
   992	        self.q1_batch = q1_batch
   993	        self.q2_batch = q2_batch
   994	        self.c3_batch = c3_batch
   995	        self.neutral_sources = dict(neutral_sources)
   996	        self.physics_digest = q1_batch.physics_digest
   997	        rng = np.random.default_rng(self.learner_seed)
   998	        template = V1ThreeRouteModel(
   999	            AdamMLPHead.create(
  1000	                q1_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C1"], rng
  1001	            ),
  1002	            AdamMLPHead.create(
  1003	                q2_batch.reference_states.shape[1], LEGACY_TRAINER_LITERALS["C2"], rng
  1004	            ),
  1005	            AdamSetInteractionHead(
  1006	                AdamMLPHead.create(
  1007	                    c3_batch.invariant_states.shape[1], LEGACY_TRAINER_LITERALS["C3"], rng
  1008	                ),
  1009	                c3_batch.member_width,
  1010	            ),
  1011	        )
  1012	        self.initialization_payload = template.payload()
  1013	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
  1014	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
  1015	        for arm, model in self.models.items():
  1016	            model.trained_arm = arm
  1017	            model.source_map_sha256 = canonical_sha256(dict(SOURCE_MAP[arm]))
  1018	        self.completed_source_epochs = 0
  1019	        self.route_update_count = 0
  1020	
  1021	    def train_epoch(self) -> dict[str, dict[str, float]]:
  1022	        if self.completed_source_epochs >= LEGACY_EPOCH_BUDGET:
  1023	            raise StageCContractError("legacy exact epoch budget is already complete")
  1024	        losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
  1025	        for route, informed in (("C1", self.q1_batch), ("C2", self.q2_batch)):
  1026	            definition = self.neutral_sources[route]
  1027	            neutral = informed.neutral(definition)
  1028	            for arm in LEARNED_ARMS:
  1029	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
  1030	                head = self.models[arm].q1 if route == "C1" else self.models[arm].q2
  1031	                assert isinstance(head, AdamMLPHead)
  1032	                losses[arm][route] = head.update(batch)
  1033	            self.route_update_count += 1
  1034	        neutral_c3 = self.c3_batch.neutral(self.neutral_sources["C3"])
  1035	        for arm in LEARNED_ARMS:
  1036	            batch = self.c3_batch if SOURCE_MAP[arm]["C3"] == "informed" else neutral_c3
  1037	            head = self.models[arm].psi
  1038	            assert isinstance(head, AdamSetInteractionHead)
  1039	            losses[arm]["C3"] = head.update(batch)
  1040	        self.route_update_count += 1
  1041	        self.completed_source_epochs += 1
  1042	        return losses
  1043	
  1044	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
  1045	        if isinstance(epochs, bool) or not isinstance(epochs, int) or epochs < 0:
  1046	            raise StageCContractError("epochs must be a nonnegative integer")
  1047	        if self.completed_source_epochs + epochs > LEGACY_EPOCH_BUDGET:
  1048	            raise StageCContractError("legacy exact epoch budget would be exceeded")
  1049	        for _ in range(epochs):
  1050	            self.train_epoch()
  1051	            if (
  1052	                checkpoint_directory is not None
  1053	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
  1054	            ):
  1055	                self.write_checkpoint(
  1056	                    Path(checkpoint_directory)
  1057	                    / f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
  1058	                )
  1059	
  1060	    def fit_to_budget(self, *, checkpoint_directory: str | Path) -> None:
  1061	        """Production fit: exhaust the frozen budget and checkpoint every 100 epochs."""
  1062	
  1063	        self.train(
  1064	            LEGACY_EPOCH_BUDGET - self.completed_source_epochs,
  1065	            checkpoint_directory=checkpoint_directory,
  1066	        )
