   853	@dataclass(slots=True)
   854	class SetInteractionHead:
   855	    """Two-layer permutation-invariant scalar Psi MLP with hard zero anchors."""
   856	
   857	    input_weights: np.ndarray
   858	    input_bias: np.ndarray
   859	    output_weights: np.ndarray
   860	    output_bias: float
   861	    member_width: int
   862	
   863	    def clone(self) -> "SetInteractionHead":
   864	        return SetInteractionHead(
   865	            self.input_weights.copy(),
   866	            self.input_bias.copy(),
   867	            self.output_weights.copy(),
   868	            float(self.output_bias),
   869	            self.member_width,
   870	        )
   871	
   872	    def _hidden(self, values: np.ndarray) -> np.ndarray:
   873	        if values.shape[-1] != self.input_weights.shape[1]:
   874	            raise StageCContractError("set-interaction state shape drifted")
   875	        return np.tanh(values @ self.input_weights.T + self.input_bias)
   876	
   877	    def score(self, context: CoalitionContext) -> float:
   878	        if len(context.members) <= 1:
   879	            return 0.0
   880	        values = context.invariant_vector(member_width=self.member_width)
   881	        return float(self._hidden(values) @ self.output_weights + self.output_bias)
   882	
   883	    def update(self, batch: CoalitionBatch, *, learning_rate: float) -> float:
   884	        hidden = self._hidden(batch.invariant_states)
   885	        predictions = hidden @ self.output_weights + self.output_bias
   886	        residual = predictions - batch.target_psi
   887	        count = float(batch.target_psi.size)
   888	        scale = 2.0 / count
   889	        output_weights_before = self.output_weights.copy()
   890	        self.output_weights -= learning_rate * scale * (hidden.T @ residual)
   891	        self.output_bias -= learning_rate * float(scale * residual.sum())
   892	        hidden_gradient = residual[:, None] * output_weights_before[None, :] * (1.0 - hidden * hidden)
   893	        self.input_weights -= learning_rate * scale * (hidden_gradient.T @ batch.invariant_states)
   894	        self.input_bias -= learning_rate * scale * hidden_gradient.sum(axis=0)
   895	        loss = float(np.mean(residual * residual))
   896	        if not all(
   897	            np.isfinite(value).all()
   898	            for value in (self.input_weights, self.input_bias, self.output_weights)
   899	        ) or not np.isfinite(self.output_bias):
   900	            raise StageCContractError("non-finite C3 learner update")
   901	        return loss
   902	
   903	    def fit_closed_form(self, batch: CoalitionBatch, *, ridge: float = 1e-10) -> float:
   904	        """Deterministic synthetic/KAT fit of the same scalar squared-error head."""
   905	
   906	        hidden = self._hidden(batch.invariant_states)
   907	        design = np.column_stack((hidden, np.ones(hidden.shape[0])))
   908	        gram = design.T @ design + ridge * np.eye(design.shape[1])
   909	        solution = np.linalg.solve(gram, design.T @ batch.target_psi)
   910	        self.output_weights[:] = solution[:-1]
   911	        self.output_bias = float(solution[-1])
   912	        residual = design @ solution - batch.target_psi
   913	        return float(np.mean(residual * residual))
   914	
   915	    def payload(self) -> dict[str, object]:
   916	        return {
   917	            "kind": "permutation_invariant_set_conditioned_scalar",
   918	            "architecture": "two_layer_tanh_mlp_on_uncapped_user_beam_and_cross_gain_edge_set_pools",
   919	            "input_weights_hex": [
   920	                [float_hex(value) for value in row] for row in self.input_weights
   921	            ],
   922	            "input_bias_hex": [float_hex(value) for value in self.input_bias],
   923	            "output_weights_hex": [float_hex(value) for value in self.output_weights],
   924	            "output_bias_hex": float_hex(self.output_bias),
   925	            "member_width": self.member_width,
   926	            "anchors": {"empty": 0.0, "singleton": 0.0},
   927	        }
