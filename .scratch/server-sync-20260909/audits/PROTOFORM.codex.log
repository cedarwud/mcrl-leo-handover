  1113	    @staticmethod
  1114	    def _restore_adam_head(head: AdamMLPHead, payload: Mapping[str, object]) -> None:
  1115	        def decode(values: object, shapes: Sequence[tuple[int, ...]], field: str) -> list[np.ndarray]:
  1116	            if not isinstance(values, list) or len(values) != len(shapes):
  1117	                raise StageCContractError(f"checkpoint {field} layer inventory drifted")
  1118	            arrays: list[np.ndarray] = []
  1119	            for encoded, shape in zip(values, shapes, strict=True):
  1120	                array = np.asarray(encoded, dtype=object)
  1121	                flat = [parse_float_hex(value, field=field) for value in array.reshape(-1)]
  1122	                restored = np.asarray(flat, dtype=np.float64).reshape(shape)
  1123	                arrays.append(restored)
  1124	            return arrays
  1125	        mapping = (
  1126	            ("weights_hex", head.weights),
  1127	            ("biases_hex", head.biases),
  1128	            ("adam_first_moment_weights_hex", head.first_moment_w),
  1129	            ("adam_second_moment_weights_hex", head.second_moment_w),
  1130	            ("adam_first_moment_biases_hex", head.first_moment_b),
  1131	            ("adam_second_moment_biases_hex", head.second_moment_b),
  1132	        )
  1133	        for field, destination in mapping:
  1134	            restored = decode(payload.get(field), [value.shape for value in destination], field)
  1135	            for target, source in zip(destination, restored, strict=True):
  1136	                target[:] = source
  1137	        head.adam_step = int(payload.get("adam_step", -1))
  1138	        if head.adam_step < 0:
  1139	            raise StageCContractError("checkpoint Adam cursor drifted")
