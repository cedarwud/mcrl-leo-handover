  1104	            self.completed_source_epochs == 0
  1105	            or self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS
  1106	        ):
  1107	            raise StageCContractError("automatic checkpoints are written only at 100-epoch boundaries")
