+        "python": sys.executable,
+        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+        "process_count": 1,
+        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+        "random_seed": RANDOM_SEED,
