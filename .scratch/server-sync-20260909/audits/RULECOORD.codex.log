def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
    assignments = {
        0: (100, 1),
        1: (200, 2),
        2: (300, 3),
        3: (400, 4),
    }
    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}

    candidates = multi_aggressor_relief_candidates(
        assignments,
        victim_aggressors={0: (1, 2, 3)},
        best_alternatives=alternatives,
    )

    assert [row.metadata[-1] for row in candidates] == [
        ("moved_users", (1, 2)),
        ("moved_users", (1, 2, 3)),
    ]
    assert candidates[0].assignments == (
        (0, (100, 1)),
        (1, (201, 2)),
        (2, (301, 3)),
        (3, (400, 4)),
    )


def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
    assignments = {
        0: (100, 1),
        1: (200, 2),
        2: (200, 2),
        3: (300, 3),
        4: (300, 3),
        5: (300, 3),
        6: (400, 4),
        7: (400, 4),
        8: (400, 4),
        9: (400, 4),
    }
    alternatives = {user: (900 + user, user) for user in assignments}

    candidates = beam_evacuation_candidates(
        assignments,
        best_alternatives=alternatives,
    )

    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
    for row in candidates:
        beam = dict(row.metadata)["beam"]
        moved = dict(row.metadata)["moved_users"]
        assert all(dict(row.assignments)[user] != beam for user in moved)

