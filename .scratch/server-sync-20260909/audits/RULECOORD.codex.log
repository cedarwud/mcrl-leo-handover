            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
