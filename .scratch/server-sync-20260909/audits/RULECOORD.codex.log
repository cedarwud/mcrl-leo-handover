#!/usr/bin/env python3
"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.

This is deliberately a diagnostic, not a claim-panel runner.  It imports the
stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
objective, service-guard, and immutable-tape loading seams.
"""

from __future__ import annotations

import argparse
from dataclasses import asdict
from fractions import Fraction
import hashlib
import importlib.util
import json
import math
from pathlib import Path
import sys
import time
from typing import Iterable, Mapping, Sequence

import numpy as np


REPO = Path(__file__).resolve().parents[1]
if str(REPO / "src") not in sys.path:
    sys.path.insert(0, str(REPO / "src"))

from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
from mcrl.physics_v025.architectures import (  # noqa: E402
    RadiationConfig,
    architecture_for,
)
from mcrl.physics_v025.batch import evaluate_ar_tdm_catalogue  # noqa: E402
from mcrl.physics_v025.channel import (  # noqa: E402
    fading_product_quantile,
    noise_power_w,
)
from mcrl.physics_v025.constants_v025 import (  # noqa: E402
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
)
from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
    RuleCandidate,
    activation_occupancy,
    beam_evacuation_candidates,
    multi_aggressor_relief_candidates,
    occupancy_activation_candidates,
)
from mcrl.physics_v025.tapes import digest_payload  # noqa: E402


HARNESS_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)
DEFAULT_CALIBRATION = Path(
    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
)
DEFAULT_WORLD_MANIFEST = Path(
    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
)
DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
FAMILIES = (
    "occupancy_activation",
    "multi_aggressor_relief",
    "beam_evacuation",
)
DECISION_BUDGET_S = 10.0
ALPHA = 0.10
SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"


class RuleRunError(RuntimeError):
    pass


def _load_harness():
    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
    if spec is None or spec.loader is None:
        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(8 * 1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def _exact_payload(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
    served = sum(bool(value) for value in profile.score.served_phy.values())
    return {
        "configuration_id": profile.config.configuration_id,
        "bits": profile.bits,
        "joules": profile.joules,
        "ee_bits_per_j": profile.bits / profile.joules,
        "served_count": served,
        "decision_served_count": decision_served,
        "changed_users": profile.config.changed_users,
        "objective": _exact_payload(objective),
        "objective_float": float(objective),
    }


def _configuration(harness, base, candidate: RuleCandidate):
    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)


def _decision_surface(tape, step_index: int):
    step = tape.steps[step_index]
    if step.arrays is None:
        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
    arrays = step.arrays
    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
        int(user): [] for user in arrays.users
    }
    slants: dict[tuple[int, tuple[int, int]], float] = {}
    elevations: dict[tuple[int, tuple[int, int]], float] = {}
    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
    for row in np.flatnonzero(live).tolist():
        user = int(arrays.users[int(arrays.row_user_column[row])])
        beam = tuple(int(value) for value in arrays.identities[row])
        slant = float(arrays.slants_km[0, row])
        elevation = float(arrays.elevations_deg[0, row])
        quantile = fading_product_quantile(elevation, ALPHA)
        key = (user, beam)
        options[user].append((slant, beam))
        slants[key] = slant
        elevations[key] = elevation
        predicted_cap_sinr[key] = (
            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
        )
    legal_options = {
        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
        for user, rows in options.items()
    }
    return legal_options, slants, elevations, predicted_cap_sinr


def _best_alternatives(
    assignments: Mapping[int, tuple[int, int] | None],
    legal_options: Mapping[int, Sequence[tuple[int, int]]],
    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
    legal: dict[int, tuple[int, int]] = {}
    with_null: dict[int, tuple[int, int] | None] = {}
    for user in sorted(assignments):
        current = assignments[user]
        alternatives = [
            beam for beam in legal_options.get(user, ()) if beam != current
        ]
        if alternatives:
            best = min(
                alternatives,
                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
            )
            legal[user] = best
            with_null[user] = best
        else:
            with_null[user] = None
    return legal, with_null


def _qualifying_victim_aggressors(
    tape,
    step_index: int,
    assignments: Mapping[int, tuple[int, int] | None],
    *,
    rate_target_bps: float,
) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
    radiation = architecture_for("a-r").radiate(
        RadiationConfig(
            rate_target_bps=rate_target_bps,
            fading_quantile_alpha=ALPHA,
        ),
        geometry,
        "margin",
    )
    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
    lowest = min(mode.threshold_linear for mode in ACM_MODES)
    qualified: dict[int, tuple[int, ...]] = {}
    census: list[dict[str, object]] = []
    for slot_index, slot in enumerate(radiation.slots):
        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
        for victim_tx in slot.transmissions:
            victim = victim_tx.user_id
            victim_index = index_by_user[victim]
            victim_link = geometry.links[victim_index]
            contributions = []
            for aggressor_tx in slot.transmissions:
                aggressor = aggressor_tx.user_id
                if aggressor == victim:
                    continue
                aggressor_index = index_by_user[aggressor]
                aggressor_link = geometry.links[aggressor_index]
                if (
                    aggressor_link.beam == victim_link.beam
                    or aggressor_link.color != victim_link.color
                ):
                    continue
                received = (
                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
                    * aggressor_tx.rf_power_w
                )
                if received > 0.0:
                    contributions.append((received, aggressor))
            contributions.sort(key=lambda row: (-row[0], row[1]))
            if len(contributions) < 2:
                continue
            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
            total_interference = math.fsum(value for value, _user in contributions)
            no_interference_sinr = quantile * wanted / victim_tx.noise_w
            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
            after_top1_sinr = quantile * wanted / (
                victim_tx.noise_w + total_interference - contributions[0][0]
            )
            interference_limited = full_sinr < lowest <= no_interference_sinr
            not_single_rescued = after_top1_sinr < lowest
            if interference_limited and not_single_rescued:
                ranked = tuple(user for _value, user in contributions)
                qualified[victim] = ranked
                census.append(
                    {
                        "victim_user": victim,
                        "slot_index": slot_index,
                        "aggressor_count": len(ranked),
                        "full_predicted_sinr": full_sinr,
                        "noise_only_predicted_sinr": no_interference_sinr,
                        "after_top1_predicted_sinr": after_top1_sinr,
                        "lowest_mode_threshold": lowest,
                        "top_aggressors": list(ranked[:3]),
                    }
                )
    return qualified, census


def _ordered_rule_candidates(
    harness,
    tape,
    step_index: int,
    base,
    *,
    rate_target_bps: float,
):

