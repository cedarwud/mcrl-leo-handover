def _ordered_rule_candidates(
    harness,
    tape,
    step_index: int,
    base,
    *,
    rate_target_bps: float,
):
    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
    legal_best, nullable_best = _best_alternatives(
        base.mapping, legal_options, cap_sinr
    )
    victim_aggressors, victim_census = _qualifying_victim_aggressors(
        tape,
        step_index,
        base.mapping,
        rate_target_bps=rate_target_bps,
    )
    families = {
        "occupancy_activation": occupancy_activation_candidates(
            base.mapping,
            legal_options=legal_options,
            slant_km=slants,
            elevation_deg=elevations,
            rate_target_bps=rate_target_bps,
            fading_quantile_alpha=ALPHA,
        ),
        "multi_aggressor_relief": multi_aggressor_relief_candidates(
            base.mapping,
            victim_aggressors=victim_aggressors,
            best_alternatives=legal_best,
        ),
        "beam_evacuation": beam_evacuation_candidates(
            base.mapping,
            best_alternatives=nullable_best,
        ),
    }
    ordered = tuple(row for family in FAMILIES for row in families[family])
    configs = tuple(_configuration(harness, base, row) for row in ordered)
    occupancy: dict[tuple[int, int], list[int]] = {}
    for user, beam in base.assignments:
        if beam is not None:
            occupancy.setdefault(beam, []).append(user)
    threshold_rows = []
    for beam, members in sorted(occupancy.items()):
        if len(members) != 1:
            continue
        user = members[0]
        elevation = elevations[(user, beam)]
        threshold_rows.append(
            {
                "beam": list(beam),
                "user": user,
                "elevation_deg": elevation,
                "activation_occupancy": activation_occupancy(
                    elevation,
                    rate_target_bps=rate_target_bps,
                    fading_quantile_alpha=ALPHA,
                    maximum_occupancy=len(base.assignments),
                ),
            }
        )
    occupancy_counts: dict[str, int] = {}
    for members in occupancy.values():
        key = str(len(members))
        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
    return ordered, configs, {
        "family_generated": {name: len(families[name]) for name in FAMILIES},
        "singleton_activation_thresholds": threshold_rows,
        "starting_occupancy_beam_counts": occupancy_counts,
        "qualifying_multi_aggressor_victims": victim_census,
        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
    }, legal_options


def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
    return harness._objective(profile, calibration) + (
        calibration.kappa_bits_per_user_step
        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
    )


def _served(profile) -> int:
    return sum(bool(value) for value in profile.score.served_phy.values())


def _evaluate_rule(
    harness,
    tape,
    setting,
    run_setting,
    calibration,
    step_index: int,
    base,
    cell_rekeys,
    previously_served,
):
    started = time.perf_counter()
    candidates, configs, census, legal_options = _ordered_rule_candidates(
        harness,
        tape,
        step_index,
        base,
        rate_target_bps=run_setting.rate_target_bps,
    )
    print(
        f"step={step_index} rule candidates={len(configs)} "
        f"families={census['family_generated']}",
        flush=True,
    )
    full = harness.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=base,
        cell_rekeyed_users=cell_rekeys,
        previously_served_users=previously_served,
        field="realised",
        run_setting=run_setting,
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=ALPHA,
    )
    guard = harness.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=base,
        cell_rekeyed_users=cell_rekeys,
        previously_served_users=previously_served,
        field="margin",
        run_setting=run_setting,
        boundary_indices=(0,),
        fading_quantile_alpha=ALPHA,
    )
    unique = (base, *configs)
    full.evaluate_many(unique)
    print(f"step={step_index} rule full exact scored", flush=True)
    guard.evaluate_many(unique)
    print(f"step={step_index} rule guard scored", flush=True)
    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
        raise RuleRunError("BASE failed exact engine evaluation")
    base_profile = full.evaluate(base)
    base_guard = guard.evaluate(base)
    base_served = _served(base_guard)
    base_objective = _objective(
        harness, base_profile, calibration, base, base, cell_rekeys
    )
    selected = base
    selected_candidate: RuleCandidate | None = None
    family_guard_passed = {name: 0 for name in FAMILIES}
    family_improving = {name: 0 for name in FAMILIES}
    for candidate, config in zip(candidates, configs, strict=True):
        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
            continue
        if _served(guard.evaluate(config)) < base_served:
            continue
        family_guard_passed[candidate.family] += 1
        value = _objective(
            harness, full.evaluate(config), calibration, base, config, cell_rekeys
        )
        if value > base_objective:
            family_improving[candidate.family] += 1
            if selected_candidate is None:
                selected = config
                selected_candidate = candidate
    wall_s = time.perf_counter() - started
    selected_profile = full.evaluate(selected)
    selected_guard = guard.evaluate(selected)
    selected_objective = _objective(
        harness, selected_profile, calibration, base, selected, cell_rekeys
    )
    return {
        "selected": selected,
        "selected_candidate": selected_candidate,
        "selected_profile": selected_profile,
        "selected_guard": selected_guard,
        "selected_objective": selected_objective,
        "base_profile": base_profile,
        "base_guard": base_guard,
        "base_objective": base_objective,
        "full_evaluator": full,
        "guard_evaluator": guard,
        "legal_options": legal_options,
        "decision_wall_s": wall_s,
        "census": {
            **census,
            "family_guard_passed": family_guard_passed,
            "family_strictly_improving": family_improving,
            "scored_candidates": len(configs),
        },
    }


def _unilateral_to_convergence(
    harness,
    *,
    base,
    legal_options,
    full,
    guard,
    calibration,
    cell_rekeys,
):
    arrays = full.tape.steps[full.step_index].arrays
    if arrays is None:
        raise RuleRunError("UNILATERAL requires the dense real-engine arrays")
    users = tuple(int(value) for value in arrays.users)
    row_of = arrays._row_index()

    def score(configs):
        selected = np.full((len(configs), len(users)), -1, dtype=np.int64)
        absent = np.zeros(len(configs), dtype=np.bool_)
        for config_index, config in enumerate(configs):
            mapping = config.mapping
            for user_column, user in enumerate(users):
                beam = mapping[user]
                if beam is None:
                    continue
                row = row_of.get((user, beam))
                if row is None:
                    absent[config_index] = True
                else:
                    selected[config_index, user_column] = row
        result = evaluate_ar_tdm_catalogue(
            arrays,
            selected,
            field="margin",
            rate_target_bps=full.run_setting.rate_target_bps,
            circuit_power_per_active_chain_w=(
                full.run_setting.circuit_power_per_active_chain_w
            ),
            boundary_indices=(0,),
            fading_quantile_alpha=ALPHA,
        )
        rows = []
        for index, config in enumerate(configs):
            if absent[index] or not bool(result.valid[index]):
                rows.append(None)
                continue
            bits = math.fsum(float(value) for value in result.bits[index])
            joules = float(result.joules[index])
            value = (
                Fraction(str(bits))
                - calibration.eta_ref * Fraction(str(joules))
                + calibration.kappa_bits_per_user_step
                * harness._phi_for(
                    base, config, cell_rekeyed_users=cell_rekeys
                )
            )
            served = int(np.count_nonzero(result.decoding_time_s[index] > 0.0))
            rows.append((value, served))
        return rows

    current = base
    initial = score((base,))[0]
    if initial is None:
        raise RuleRunError("UNILATERAL BASE failed exact decision scoring")
    current_selection_objective, current_decision_served = initial
    base_served = current_decision_served
    iterations = 0
    evaluated_candidates = 0
    started = time.perf_counter()
    while True:
        neighbours = []
        current_map = current.mapping
        for user in sorted(legal_options):
            for beam in legal_options[user]:
                if beam == current_map[user]:
                    continue
                mapping = dict(current_map)
                mapping[user] = beam
                neighbours.append(
                    harness._configuration(base, mapping, kind="unilateral-iterate")
                )
        unique_by_assignment = {row.assignments: row for row in neighbours}
        neighbours = sorted(
            unique_by_assignment.values(), key=lambda row: row.configuration_id
        )
        scored = score(neighbours)
        evaluated_candidates += len(neighbours)
        best = current
        best_selection_objective = current_selection_objective
        best_decision_served = current_decision_served
        for candidate, candidate_score in zip(neighbours, scored, strict=True):
            if candidate_score is None:
                continue
            value, served = candidate_score
            if served < base_served:
                continue
            if value > best_selection_objective or (
                value == best_selection_objective
                and value > current_selection_objective
                and candidate.configuration_id < best.configuration_id
            ):
                best, best_selection_objective, best_decision_served = (
                    candidate,
                    value,
                    served,
                )
        if best_selection_objective <= current_selection_objective:
            break
        current, current_selection_objective, current_decision_served = (
            best,
            best_selection_objective,
            best_decision_served,
        )
        iterations += 1
        print(
            f"unilateral iteration={iterations} candidates={len(neighbours)}",
            flush=True,
        )
    committed_profile = full.evaluate(current)
    committed_objective = _objective(
        harness, committed_profile, calibration, base, current, cell_rekeys
    )
    return {
        "selected": current,
        "profile": committed_profile,
        "decision_served": current_decision_served,
        "objective": committed_objective,
        "selection_objective": _exact_payload(current_selection_objective),
        "iterations": iterations,
        "candidate_evaluations": evaluated_candidates,
        "wall_s": time.perf_counter() - started,
        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
    }


def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
    harness = _load_harness()
    rows = []
    step = 0
    while len(rows) < limit:
        for carrier in harness.REFERENCE_CARRIERS:
            rows.append((step, carrier))
            if len(rows) == limit:
                break
        step += 1
    return tuple(rows)


def run_world(
    world: int,
    *,
    anchor_start: int,
    anchors: int,
    calibration_path: Path,
    world_manifest_path: Path,
) -> dict[str, object]:
    harness = _load_harness()
    setting = harness._setting("a-r0")
    run_setting = harness.run_setting_for("a-r0")
    calibration = harness.load_calibration(calibration_path, setting, run_setting)
    expected_digest, expected_manifest = harness.load_world_binding(
        world_manifest_path, world, run_setting
    )
    tape = harness.load_prepared_world_tape(
        world_manifest_path, world, run_setting
    )
    print(f"world={world} sealed tape loaded and authenticated", flush=True)
    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
        raise RuleRunError("sealed tape binding failed")
    results = []
    pairs = _anchor_pairs(anchor_start + anchors)[anchor_start:]
    for local_index, (step_index, carrier) in enumerate(pairs):
        anchor_index = anchor_start + local_index
        base = harness._base_configuration(tape, step_index, carrier)
        cell_rekeys = harness._rekeyed_users(tape, step_index)

