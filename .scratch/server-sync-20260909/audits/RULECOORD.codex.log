@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
+    "multi_aggressor_relief_candidates",
+    "occupancy_activation_candidates",
+]
diff --git a/tests/physics_v025/test_rule_coordinator.py b/tests/physics_v025/test_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8735c6c8cc08fa4f62c38129ad400d0871724b6
--- /dev/null
+++ b/tests/physics_v025/test_rule_coordinator.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from mcrl.physics_v025.rule_coordinator import (
+    RuleCandidate,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+
+
+def test_activation_occupancy_matches_verified_ten_degree_witness() -> None:
+    from mcrl.physics_v025.rule_coordinator import activation_occupancy
+
+    assert activation_occupancy(10.0) == 3
+
+
+def test_occupancy_activation_targets_only_singletons_and_moves_nearest_arrivals() -> None:
+    singleton = (100, 1)
+    doubleton = (200, 2)
+    assignments = {0: singleton, 1: (300, 3), 2: (400, 4), 3: doubleton, 4: doubleton}
+    legal = {
+        0: (singleton,),
+        1: ((300, 3), singleton),
+        2: ((400, 4), singleton),
+        3: (doubleton,),
+        4: (doubleton,),
+    }
+    slants = {(1, singleton): 700.0, (2, singleton): 600.0}
+    elevations = {(0, singleton): 10.0}
+
+    candidates = occupancy_activation_candidates(
+        assignments,
+        legal_options=legal,
+        slant_km=slants,
+        elevation_deg=elevations,
+    )
+
+    assert candidates == (
+        RuleCandidate(
+            family="occupancy_activation",
+            key=(singleton,),
+            assignments=((0, singleton), (1, singleton), (2, singleton), (3, doubleton), (4, doubleton)),
+            metadata=(
+                ("beam", singleton),
+                ("starting_occupancy", 1),
+                ("activation_occupancy", 3),
+                ("moved_users", (2, 1)),
+                ("elevation_deg", 10.0),
+            ),
+        ),
+    )
+
+
+def test_multi_aggressor_relief_emits_top_two_then_top_three_per_victim() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (300, 3),
+        3: (400, 4),
+    }
+    alternatives = {1: (201, 2), 2: (301, 3), 3: (401, 4)}
+
+    candidates = multi_aggressor_relief_candidates(
+        assignments,
+        victim_aggressors={0: (1, 2, 3)},
+        best_alternatives=alternatives,
+    )
+
+    assert [row.metadata[-1] for row in candidates] == [
+        ("moved_users", (1, 2)),
+        ("moved_users", (1, 2, 3)),
+    ]
+    assert candidates[0].assignments == (
+        (0, (100, 1)),
+        (1, (201, 2)),
+        (2, (301, 3)),
+        (3, (400, 4)),
+    )
+
+
+def test_beam_evacuation_targets_only_starting_occupancy_two_or_three() -> None:
+    assignments = {
+        0: (100, 1),
+        1: (200, 2),
+        2: (200, 2),
+        3: (300, 3),
+        4: (300, 3),
+        5: (300, 3),
+        6: (400, 4),
+        7: (400, 4),
+        8: (400, 4),
+        9: (400, 4),
+    }
+    alternatives = {user: (900 + user, user) for user in assignments}
+
+    candidates = beam_evacuation_candidates(
+        assignments,
+        best_alternatives=alternatives,
+    )
+
+    assert [dict(row.metadata)["starting_occupancy"] for row in candidates] == [2, 3]
+    for row in candidates:
+        beam = dict(row.metadata)["beam"]
+        moved = dict(row.metadata)["moved_users"]
+        assert all(dict(row.assignments)[user] != beam for user in moved)

diff --git a/scripts/run_v025_rule_coordinator.py b/scripts/run_v025_rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e7cc15dbd11618ceec9c0bceb976746d67db300
--- /dev/null
+++ b/scripts/run_v025_rule_coordinator.py
@@ -0,0 +1,948 @@
+#!/usr/bin/env python3
+"""Evaluate the fixed V0.25 coordinator on sealed real TRAIN anchors.
+
+This is deliberately a diagnostic, not a claim-panel runner.  It imports the
+stage-4h engine harness only to reuse its sealed Configuration, StepEvaluator,
+objective, service-guard, and immutable-tape loading seams.
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+if str(REPO / "src") not in sys.path:
+    sys.path.insert(0, str(REPO / "src"))
+
+from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
+from mcrl.physics_v025.architectures import (  # noqa: E402
+    RadiationConfig,
+    architecture_for,
+)
+from mcrl.physics_v025.channel import (  # noqa: E402
+    fading_product_quantile,
+    noise_power_w,
+)
+from mcrl.physics_v025.constants_v025 import (  # noqa: E402
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+)
+from mcrl.physics_v025.rule_coordinator import (  # noqa: E402
+    RuleCandidate,
+    activation_occupancy,
+    beam_evacuation_candidates,
+    multi_aggressor_relief_candidates,
+    occupancy_activation_candidates,
+)
+from mcrl.physics_v025.tapes import digest_payload  # noqa: E402
+
+
+HARNESS_PATH = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_CALIBRATION = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/calibration-manifest.json"
+)
+DEFAULT_WORLD_MANIFEST = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal/world-manifest.json"
+)
+DEFAULT_OUTPUT = REPO / ".scratch/multi-catfish-v025-rule-coordinator/results"
+REPORT_PATH = REPO / "RULE-COORDINATOR-2026-09-09.md"
+FAMILIES = (
+    "occupancy_activation",
+    "multi_aggressor_relief",
+    "beam_evacuation",
+)
+DECISION_BUDGET_S = 10.0
+ALPHA = 0.10
+SCHEMA = "mcrl-v025-rule-coordinator-diagnostic-v1"
+
+
+class RuleRunError(RuntimeError):
+    pass
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location("v025_stage4h_harness", HARNESS_PATH)
+    if spec is None or spec.loader is None:
+        raise RuleRunError(f"cannot import stage-4h harness: {HARNESS_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        while chunk := handle.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _exact_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _profile_payload(profile, *, decision_served: int, objective: Fraction) -> dict[str, object]:
+    served = sum(bool(value) for value in profile.score.served_phy.values())
+    return {
+        "configuration_id": profile.config.configuration_id,
+        "bits": profile.bits,
+        "joules": profile.joules,
+        "ee_bits_per_j": profile.bits / profile.joules,
+        "served_count": served,
+        "decision_served_count": decision_served,
+        "changed_users": profile.config.changed_users,
+        "objective": _exact_payload(objective),
+        "objective_float": float(objective),
+    }
+
+
+def _configuration(harness, base, candidate: RuleCandidate):
+    return harness._configuration(base, dict(candidate.assignments), kind=candidate.family)
+
+
+def _decision_surface(tape, step_index: int):
+    step = tape.steps[step_index]
+    if step.arrays is None:
+        raise RuleRunError("formal real-world tape unexpectedly lacks dense arrays")
+    arrays = step.arrays
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    options: dict[int, list[tuple[float, tuple[int, int]]]] = {
+        int(user): [] for user in arrays.users
+    }
+    slants: dict[tuple[int, tuple[int, int]], float] = {}
+    elevations: dict[tuple[int, tuple[int, int]], float] = {}
+    predicted_cap_sinr: dict[tuple[int, tuple[int, int]], float] = {}
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    for row in np.flatnonzero(live).tolist():
+        user = int(arrays.users[int(arrays.row_user_column[row])])
+        beam = tuple(int(value) for value in arrays.identities[row])
+        slant = float(arrays.slants_km[0, row])
+        elevation = float(arrays.elevations_deg[0, row])
+        quantile = fading_product_quantile(elevation, ALPHA)
+        key = (user, beam)
+        options[user].append((slant, beam))
+        slants[key] = slant
+        elevations[key] = elevation
+        predicted_cap_sinr[key] = (
+            BEAM_RF_CAP_W * float(arrays.nominal_gain[0, row]) * quantile / noise
+        )
+    legal_options = {
+        user: tuple(beam for _slant, beam in sorted(rows, key=lambda row: (row[0], row[1])))
+        for user, rows in options.items()
+    }
+    return legal_options, slants, elevations, predicted_cap_sinr
+
+
+def _best_alternatives(
+    assignments: Mapping[int, tuple[int, int] | None],
+    legal_options: Mapping[int, Sequence[tuple[int, int]]],
+    predicted_cap_sinr: Mapping[tuple[int, tuple[int, int]], float],
+) -> tuple[dict[int, tuple[int, int]], dict[int, tuple[int, int] | None]]:
+    legal: dict[int, tuple[int, int]] = {}
+    with_null: dict[int, tuple[int, int] | None] = {}
+    for user in sorted(assignments):
+        current = assignments[user]
+        alternatives = [
+            beam for beam in legal_options.get(user, ()) if beam != current
+        ]
+        if alternatives:
+            best = min(
+                alternatives,
+                key=lambda beam: (-predicted_cap_sinr[(user, beam)], beam),
+            )
+            legal[user] = best
+            with_null[user] = best
+        else:
+            with_null[user] = None
+    return legal, with_null
+
+
+def _qualifying_victim_aggressors(
+    tape,
+    step_index: int,
+    assignments: Mapping[int, tuple[int, int] | None],
+    *,
+    rate_target_bps: float,
+) -> tuple[dict[int, tuple[int, ...]], list[dict[str, object]]]:
+    geometry = tape.geometry_for(step_index=step_index, assignments=assignments)[0][1]
+    radiation = architecture_for("a-r").radiate(
+        RadiationConfig(
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        geometry,
+        "margin",
+    )
+    index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
+    lowest = min(mode.threshold_linear for mode in ACM_MODES)
+    qualified: dict[int, tuple[int, ...]] = {}
+    census: list[dict[str, object]] = []
+    for slot_index, slot in enumerate(radiation.slots):
+        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
+        for victim_tx in slot.transmissions:
+            victim = victim_tx.user_id
+            victim_index = index_by_user[victim]
+            victim_link = geometry.links[victim_index]
+            contributions = []
+            for aggressor_tx in slot.transmissions:
+                aggressor = aggressor_tx.user_id
+                if aggressor == victim:
+                    continue
+                aggressor_index = index_by_user[aggressor]
+                aggressor_link = geometry.links[aggressor_index]
+                if (
+                    aggressor_link.beam == victim_link.beam
+                    or aggressor_link.color != victim_link.color
+                ):
+                    continue
+                received = (
+                    float(geometry.nominal_cross_gain[victim_index, aggressor_index])
+                    * aggressor_tx.rf_power_w
+                )
+                if received > 0.0:
+                    contributions.append((received, aggressor))
+            contributions.sort(key=lambda row: (-row[0], row[1]))
+            if len(contributions) < 2:
+                continue
+            quantile = fading_product_quantile(victim_link.elevation_deg, ALPHA)
+            wanted = victim_tx.rf_power_w * victim_link.nominal_gain
+            total_interference = math.fsum(value for value, _user in contributions)
+            no_interference_sinr = quantile * wanted / victim_tx.noise_w
+            full_sinr = quantile * wanted / (victim_tx.noise_w + total_interference)
+            after_top1_sinr = quantile * wanted / (
+                victim_tx.noise_w + total_interference - contributions[0][0]
+            )
+            interference_limited = full_sinr < lowest <= no_interference_sinr
+            not_single_rescued = after_top1_sinr < lowest
+            if interference_limited and not_single_rescued:
+                ranked = tuple(user for _value, user in contributions)
+                qualified[victim] = ranked
+                census.append(
+                    {
+                        "victim_user": victim,
+                        "slot_index": slot_index,
+                        "aggressor_count": len(ranked),
+                        "full_predicted_sinr": full_sinr,
+                        "noise_only_predicted_sinr": no_interference_sinr,
+                        "after_top1_predicted_sinr": after_top1_sinr,
+                        "lowest_mode_threshold": lowest,
+                        "top_aggressors": list(ranked[:3]),
+                    }
+                )
+    return qualified, census
+
+
+def _ordered_rule_candidates(
+    harness,
+    tape,
+    step_index: int,
+    base,
+    *,
+    rate_target_bps: float,
+):
+    legal_options, slants, elevations, cap_sinr = _decision_surface(tape, step_index)
+    legal_best, nullable_best = _best_alternatives(
+        base.mapping, legal_options, cap_sinr
+    )
+    victim_aggressors, victim_census = _qualifying_victim_aggressors(
+        tape,
+        step_index,
+        base.mapping,
+        rate_target_bps=rate_target_bps,
+    )
+    families = {
+        "occupancy_activation": occupancy_activation_candidates(
+            base.mapping,
+            legal_options=legal_options,
+            slant_km=slants,
+            elevation_deg=elevations,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=ALPHA,
+        ),
+        "multi_aggressor_relief": multi_aggressor_relief_candidates(
+            base.mapping,
+            victim_aggressors=victim_aggressors,
+            best_alternatives=legal_best,
+        ),
+        "beam_evacuation": beam_evacuation_candidates(
+            base.mapping,
+            best_alternatives=nullable_best,
+        ),
+    }
+    ordered = tuple(row for family in FAMILIES for row in families[family])
+    configs = tuple(_configuration(harness, base, row) for row in ordered)
+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for user, beam in base.assignments:
+        if beam is not None:
+            occupancy.setdefault(beam, []).append(user)
+    threshold_rows = []
+    for beam, members in sorted(occupancy.items()):
+        if len(members) != 1:
+            continue
+        user = members[0]
+        elevation = elevations[(user, beam)]
+        threshold_rows.append(
+            {
+                "beam": list(beam),
+                "user": user,
+                "elevation_deg": elevation,
+                "activation_occupancy": activation_occupancy(
+                    elevation,
+                    rate_target_bps=rate_target_bps,
+                    fading_quantile_alpha=ALPHA,
+                    maximum_occupancy=len(base.assignments),
+                ),
+            }
+        )
+    occupancy_counts: dict[str, int] = {}
+    for members in occupancy.values():
+        key = str(len(members))
+        occupancy_counts[key] = occupancy_counts.get(key, 0) + 1
+    return ordered, configs, {
+        "family_generated": {name: len(families[name]) for name in FAMILIES},
+        "singleton_activation_thresholds": threshold_rows,
+        "starting_occupancy_beam_counts": occupancy_counts,
+        "qualifying_multi_aggressor_victims": victim_census,
+        "alternative_definition": "highest alpha=.10 predicted cap-link SINR; physical-ID tie",
+    }, legal_options
+
+
+def _objective(harness, profile, calibration, base, candidate, cell_rekeys) -> Fraction:
+    return harness._objective(profile, calibration) + (
+        calibration.kappa_bits_per_user_step
+        * harness._phi_for(base, candidate, cell_rekeyed_users=cell_rekeys)
+    )
+
+
+def _served(profile) -> int:
+    return sum(bool(value) for value in profile.score.served_phy.values())
+
+
+def _evaluate_rule(
+    harness,
+    tape,
+    setting,
+    run_setting,
+    calibration,
+    step_index: int,
+    base,
+    cell_rekeys,
+    previously_served,
+):
+    started = time.perf_counter()
+    candidates, configs, census, legal_options = _ordered_rule_candidates(
+        harness,
+        tape,
+        step_index,
+        base,
+        rate_target_bps=run_setting.rate_target_bps,
+    )
+    print(
+        f"step={step_index} rule candidates={len(configs)} "
+        f"families={census['family_generated']}",
+        flush=True,
+    )
+    full = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="realised",
+        run_setting=run_setting,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    guard = harness.StepEvaluator(
+        tape,
+        setting,
+        step_index,
+        transition_from=base,
+        cell_rekeyed_users=cell_rekeys,
+        previously_served_users=previously_served,
+        field="margin",
+        run_setting=run_setting,
+        boundary_indices=(0,),
+        fading_quantile_alpha=ALPHA,
+    )
+    unique = (base, *configs)
+    full.evaluate_many(unique)
+    print(f"step={step_index} rule full exact scored", flush=True)
+    guard.evaluate_many(unique)
+    print(f"step={step_index} rule guard scored", flush=True)
+    if base.configuration_id not in full._evaluated or base.configuration_id not in guard._evaluated:
+        raise RuleRunError("BASE failed exact engine evaluation")
+    base_profile = full.evaluate(base)
+    base_guard = guard.evaluate(base)
+    base_served = _served(base_guard)
+    base_objective = _objective(
+        harness, base_profile, calibration, base, base, cell_rekeys
+    )
+    selected = base
+    selected_candidate: RuleCandidate | None = None
+    family_guard_passed = {name: 0 for name in FAMILIES}
+    family_improving = {name: 0 for name in FAMILIES}
+    for candidate, config in zip(candidates, configs, strict=True):
+        if config.configuration_id not in full._evaluated or config.configuration_id not in guard._evaluated:
+            continue
+        if _served(guard.evaluate(config)) < base_served:
+            continue
+        family_guard_passed[candidate.family] += 1
+        value = _objective(
+            harness, full.evaluate(config), calibration, base, config, cell_rekeys
+        )
+        if value > base_objective:
+            family_improving[candidate.family] += 1
+            if selected_candidate is None:
+                selected = config
+                selected_candidate = candidate
+    wall_s = time.perf_counter() - started
+    selected_profile = full.evaluate(selected)
+    selected_guard = guard.evaluate(selected)
+    selected_objective = _objective(
+        harness, selected_profile, calibration, base, selected, cell_rekeys
+    )
+    return {
+        "selected": selected,
+        "selected_candidate": selected_candidate,
+        "selected_profile": selected_profile,
+        "selected_guard": selected_guard,
+        "selected_objective": selected_objective,
+        "base_profile": base_profile,
+        "base_guard": base_guard,
+        "base_objective": base_objective,
+        "full_evaluator": full,
+        "guard_evaluator": guard,
+        "legal_options": legal_options,
+        "decision_wall_s": wall_s,
+        "census": {
+            **census,
+            "family_guard_passed": family_guard_passed,
+            "family_strictly_improving": family_improving,
+            "scored_candidates": len(configs),
+        },
+    }
+
+
+def _unilateral_to_convergence(
+    harness,
+    *,
+    base,
+    legal_options,
+    full,
+    guard,
+    calibration,
+    cell_rekeys,
+):
+    current = base
+    current_profile = full.evaluate(current)
+    current_objective = _objective(
+        harness, current_profile, calibration, base, current, cell_rekeys
+    )
+    base_served = _served(guard.evaluate(base))
+    iterations = 0
+    evaluated_candidates = 0
+    started = time.perf_counter()
+    while True:
+        neighbours = []
+        current_map = current.mapping
+        for user in sorted(legal_options):
+            for beam in legal_options[user]:
+                if beam == current_map[user]:
+                    continue
+                mapping = dict(current_map)
+                mapping[user] = beam
+                neighbours.append(
+                    harness._configuration(base, mapping, kind="unilateral-iterate")
+                )
+        unique_by_assignment = {row.assignments: row for row in neighbours}
+        neighbours = sorted(
+            unique_by_assignment.values(), key=lambda row: row.configuration_id
+        )
+        full.evaluate_many(neighbours)
+        guard.evaluate_many(neighbours)
+        evaluated_candidates += len(neighbours)
+        best = current
+        best_profile = current_profile
+        best_objective = current_objective
+        for candidate in neighbours:
+            if (
+                candidate.configuration_id not in full._evaluated
+                or candidate.configuration_id not in guard._evaluated
+                or _served(guard.evaluate(candidate)) < base_served
+            ):
+                continue
+            profile = full.evaluate(candidate)
+            value = _objective(
+                harness, profile, calibration, base, candidate, cell_rekeys
+            )
+            if value > best_objective or (
+                value == best_objective
+                and value > current_objective
+                and candidate.configuration_id < best.configuration_id
+            ):
+                best, best_profile, best_objective = candidate, profile, value
+        if best_objective <= current_objective:
+            break
+        current, current_profile, current_objective = (
+            best,
+            best_profile,
+            best_objective,
+        )
+        iterations += 1
+        print(
+            f"unilateral iteration={iterations} candidates={len(neighbours)}",
+            flush=True,
+        )
+    return {
+        "selected": current,
+        "profile": current_profile,
+        "guard": guard.evaluate(current),
+        "objective": current_objective,
+        "iterations": iterations,
+        "candidate_evaluations": evaluated_candidates,
+        "wall_s": time.perf_counter() - started,
+        "termination": "NO_STRICTLY_IMPROVING_LEGAL_SINGLE_USER_MOVE",
+    }
+
+
+def _anchor_pairs(limit: int) -> tuple[tuple[int, str], ...]:
+    harness = _load_harness()
+    rows = []
+    step = 0
+    while len(rows) < limit:
+        for carrier in harness.REFERENCE_CARRIERS:
+            rows.append((step, carrier))
+            if len(rows) == limit:
+                break
+        step += 1
+    return tuple(rows)
+
+
+def run_world(
+    world: int,
+    *,
+    anchors: int,
+    calibration_path: Path,
+    world_manifest_path: Path,
+) -> dict[str, object]:
+    harness = _load_harness()
+    setting = harness._setting("a-r0")
+    run_setting = harness.run_setting_for("a-r0")
+    calibration = harness.load_calibration(calibration_path, setting, run_setting)
+    expected_digest, expected_manifest = harness.load_world_binding(
+        world_manifest_path, world, run_setting
+    )
+    tape = harness.load_prepared_world_tape(
+        world_manifest_path, world, run_setting
+    )
+    print(f"world={world} sealed tape loaded and authenticated", flush=True)
+    if tape.digest != expected_digest or tape.manifest() != expected_manifest:
+        raise RuleRunError("sealed tape binding failed")
+    results = []
+    for anchor_index, (step_index, carrier) in enumerate(_anchor_pairs(anchors)):
+        base = harness._base_configuration(tape, step_index, carrier)
+        cell_rekeys = harness._rekeyed_users(tape, step_index)
+        previously_served = harness._previously_served_users(
+            tape, step_index, carrier
+        )
+        rule = _evaluate_rule(
+            harness,
+            tape,
+            setting,
+            run_setting,
+            calibration,
+            step_index,
+            base,
+            cell_rekeys,
+            previously_served,
+        )
+        unilateral = _unilateral_to_convergence(
+            harness,
+            base=base,
+            legal_options=rule["legal_options"],
+            full=rule["full_evaluator"],
+            guard=rule["guard_evaluator"],
+            calibration=calibration,
+            cell_rekeys=cell_rekeys,
+        )
+        selected_candidate = rule["selected_candidate"]
+        results.append(
+            {
+                "world": world,
+                "world_domain": tape.domain,
+                "world_seed": tape.seed,
+                "anchor_index": anchor_index,
+                "step_index": step_index,
+                "carrier": carrier,
+                "arms": {
+                    "BASELINE": _profile_payload(
+                        rule["base_profile"],
+                        decision_served=_served(rule["base_guard"]),
+                        objective=rule["base_objective"],
+                    ),
+                    "UNILATERAL": {
+                        **_profile_payload(
+                            unilateral["profile"],
+                            decision_served=_served(unilateral["guard"]),
+                            objective=unilateral["objective"],
+                        ),
+                        "iterations": unilateral["iterations"],
+                        "candidate_evaluations": unilateral["candidate_evaluations"],
+                        "wall_s": unilateral["wall_s"],
+                        "termination": unilateral["termination"],
+                    },
+                    "RULE": {
+                        **_profile_payload(
+                            rule["selected_profile"],
+                            decision_served=_served(rule["selected_guard"]),
+                            objective=rule["selected_objective"],
+                        ),
+                        "fired_family": (
+                            None if selected_candidate is None else selected_candidate.family
+                        ),
+                        "candidate_key": (
+                            None if selected_candidate is None else list(selected_candidate.key)
+                        ),
+                        "candidate_metadata": (
+                            None
+                            if selected_candidate is None
+                            else {key: value for key, value in selected_candidate.metadata}
+                        ),
+                        "decision_wall_s": rule["decision_wall_s"],
+                        "decision_budget_s": DECISION_BUDGET_S,
+                        "within_budget": rule["decision_wall_s"] <= DECISION_BUDGET_S,
+                    },
+                },
+                "rule_census": rule["census"],
+            }
+        )
+        print(
+            f"world={world} anchor={anchor_index + 1}/{anchors} "
+            f"rule={rule['decision_wall_s']:.3f}s "
+            f"uni={unilateral['wall_s']:.3f}s "
+            f"family={None if selected_candidate is None else selected_candidate.family}",
+            flush=True,
+        )
+    payload = {
+        "schema": SCHEMA + "-world",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "world": world,
+        "world_domain": tape.domain,
+        "world_seed": tape.seed,
+        "anchor_count": len(results),
+        "anchors": results,
+        "sealed_inputs": {
+            "calibration_manifest": str(calibration_path),
+            "calibration_file_sha256": _sha256(calibration_path),
+            "calibration_sha256": calibration.digest,
+            "world_manifest": str(world_manifest_path),
+            "world_manifest_file_sha256": _sha256(world_manifest_path),
+            "world_tape_sha256": tape.digest,
+            "run_setting_sha256": run_setting.digest,
+        },
+        "rule": {
+            "order": list(FAMILIES),
+            "strict_improvement": True,
+            "service_guard": "decision-instant served count >= BASELINE",
+            "decision_budget_s": DECISION_BUDGET_S,
+            "fading_quantile_alpha": ALPHA,
+            "learned_components": 0,
+        },
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _pooled(anchors: Sequence[Mapping[str, object]], arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm] for anchor in anchors]  # type: ignore[index]
+    bits = math.fsum(float(row["bits"]) for row in rows)  # type: ignore[index]
+    joules = math.fsum(float(row["joules"]) for row in rows)  # type: ignore[index]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bits_per_j": bits / joules,
+        "served_total": sum(int(row["served_count"]) for row in rows),  # type: ignore[index]
+        "served_counts": [int(row["served_count"]) for row in rows],  # type: ignore[index]
+    }
+
+
+def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
+    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
+    if any(row.get("status") != "COMPLETE" for row in receipts):
+        raise RuleRunError("cannot merge an incomplete world receipt")
+    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
+    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
+    rule_over_uni = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
+    )
+    rule_over_base = (
+        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
+    )
+    families = {}
+    for family in FAMILIES:
+        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
+        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
+        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
+        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
+        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
+        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
+        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
+        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
+        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
+        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
+        families[family] = {
+            "generated": generated,
+            "service_guard_passed": guarded,
+            "strictly_improving": improving,
+            "fired": len(fired),
+            "delta_bits_vs_baseline": rule_bits - base_bits,
+            "delta_joules_vs_baseline": rule_joules - base_joules,
+            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
+            ),
+            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
+                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
+            ),
+        }
+    threshold_rows = [
+        row
+        for anchor in anchors
+        for row in anchor["rule_census"]["singleton_activation_thresholds"]
+        if row["activation_occupancy"] is not None
+    ]
+    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
+    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
+    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
+    served_noninferior = all(
+        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
+        for anchor in anchors
+    )
+    payload = {
+        "schema": SCHEMA + "-merged",
+        "status": "COMPLETE",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "training": False,
+        "test_split_opened": False,
+        "anchor_count": len(anchors),
+        "worlds": sorted({anchor["world"] for anchor in anchors}),
+        "pooled": pooled,
+        "rule_over_unilateral_relative_gain": rule_over_uni,
+        "rule_over_baseline_relative_gain": rule_over_base,
+        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
+        "family_breakdown": families,
+        "activation_thresholds": {
+            "observations": len(threshold_values),
+            "minimum_required_occupancy": min(threshold_values),
+            "maximum_required_occupancy": max(threshold_values),
+            "required_occupancy_range": max(threshold_values) - min(threshold_values),
+            "counts": {
+                str(value): threshold_values.count(value)
+                for value in sorted(set(threshold_values))
+            },
+            "elevation_min_deg": min(elevations),
+            "elevation_max_deg": max(elevations),
+        },
+        "decision_times_s": {
+            "budget": DECISION_BUDGET_S,
+            "mean": math.fsum(times) / len(times),
+            "p50": float(np.quantile(times, 0.50)),
+            "p95": float(np.quantile(times, 0.95)),
+            "maximum": max(times),
+            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
+            "classification": (
+                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
+            ),
+        },
+        "anchors": anchors,
+        "source_receipts": [
+            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
+            for path, receipt in zip(paths, receipts, strict=True)
+        ],
+    }
+    payload["receipt_sha256"] = digest_payload(payload)
+    return payload
+
+
+def _fmt_ee(value: float) -> str:
+    return f"{value:,.3f}"
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    pooled = result["pooled"]
+    anchors = result["anchors"]
+    family = result["family_breakdown"]
+    times = result["decision_times_s"]
+    thresholds = result["activation_thresholds"]
+    lines = [
+        "# Rule coordinator diagnostic — 2026-09-09",
+        "",
+        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
+        "",
+        "## Pooled energy efficiency",
+        "",
+        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
+        "|---|---:|---:|---:|",
+    ]
+    for arm in ("BASELINE", "UNILATERAL", "RULE"):
+        row = pooled[arm]
+        lines.append(
+            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
+        )
+    lines.extend(
+        [
+            "",
+            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
+            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
+            "",
+            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
+            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
+            "",
+            "## Served counts at every anchor",
+            "",
+            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
+            "",
+            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
+            "|---:|---:|---:|---|---:|---:|---:|---|",
+        ]
+    )
+    for anchor in anchors:
+        arms = anchor["arms"]
+        cells = {
+            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
+            for arm in ("BASELINE", "UNILATERAL", "RULE")
+        }
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
+            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
+            f"{arms['RULE']['fired_family'] or 'none'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Per-family breakdown",
+            "",
+            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
+            "",
+            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for name in FAMILIES:
+        row = family[name]
+        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
+        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
+        lines.append(
+            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
+            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
+            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
+        )
+    lines.extend(
+        [
+            "",
+            "### Occupancy correction and elevation-dependent threshold",
+            "",
+            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
+            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
+            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
+            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
+            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
+            "",
+            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
+            "",
+            "## Rule decision times",
+            "",
+            f"Declared budget: **{times['budget']:.1f} s**, unchanged. Classification: **{times['classification']}**. "
+            f"Mean {times['mean']:.6f} s; p50 {times['p50']:.6f} s; p95 {times['p95']:.6f} s; max {times['maximum']:.6f} s; "
+            f"{times['within_budget_count']}/{result['anchor_count']} anchors within budget.",
+            "",
+            "| world | anchor | RULE decision (s) | within 10 s | UNILATERAL convergence (s) | iterations |",
+            "|---:|---:|---:|---|---:|---:|",
+        ]
+    )
+    for anchor in anchors:
+        rule = anchor["arms"]["RULE"]
+        uni = anchor["arms"]["UNILATERAL"]
+        lines.append(
+            f"| {anchor['world']} | {anchor['anchor_index']} | {rule['decision_wall_s']:.6f} | "
+            f"{'yes' if rule['within_budget'] else 'no'} | {uni['wall_s']:.6f} | {uni['iterations']} |"
+        )
+    lines.extend(
+        [
+            "",
+            "## Method and integrity",
+            "",
+            f"- Evaluated {result['anchor_count']} real TRAIN anchor/carrier contexts from worlds {result['worlds']} under sealed `a-r0` calibration. Every scored configuration used the full 48-boundary realised engine; no proxy, learned value, model, or head selected RULE or UNILATERAL.",
+            "- BASELINE is the incumbent fixed reference assignment at that anchor. UNILATERAL repeatedly chooses the best strict exact-objective single-user legal move until none improves. RULE scores all generated candidates, applies the unchanged decision-instant served-count guard, and commits the first strict exact-objective improvement in the declared family order.",
+            "- Multi-aggressor victims are below the lowest transmitted-mode threshold with interference, clear it in noise, and remain below it after algebraically removing the largest nominal interference contribution. Top aggressors are ranked by received nominal interference watts in the victim's TDM slot; each moves to its highest α=.10 predicted cap-link-SINR legal alternative.",
+            "- Beam evacuation targets only starting occupancy 2 or 3. Users with no non-origin legal alternative take explicit NULL, which remains subject to the unchanged service guard.",
+            f"- Merged receipt SHA-256: `{result['receipt_sha256']}`. Raw receipts are under `{DEFAULT_OUTPUT}`. No large intermediate was created: immutable multi-gigabyte tapes were read in place, and `/tmp` was not used.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _write_json(path: Path, payload: Mapping[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--world", type=int)
+    mode.add_argument("--merge", action="store_true")
+    parser.add_argument("--anchors", type=int, default=10)
+    parser.add_argument("--calibration", type=Path, default=DEFAULT_CALIBRATION)
+    parser.add_argument("--world-manifest", type=Path, default=DEFAULT_WORLD_MANIFEST)
+    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--inputs", nargs="*", type=Path)
+    args = parser.parse_args(argv)
+    if args.world is not None:
+        if args.world not in {1, 2, 3, 4} or args.anchors < 1:
+            raise SystemExit("world must be 1..4 and anchors must be positive")
+        payload = run_world(
+            args.world,
+            anchors=args.anchors,
+            calibration_path=args.calibration,
+            world_manifest_path=args.world_manifest,
+        )
+        path = args.output / f"world-{args.world}.json"
+        _write_json(path, payload)
+        print(json.dumps({"status": "COMPLETE", "path": str(path), "receipt_sha256": payload["receipt_sha256"]}))
+        return 0
+    inputs = args.inputs or [args.output / "world-1.json", args.output / "world-2.json"]
+    result = merge_worlds(inputs)
+    _write_json(args.output / "merged.json", result)
+    REPORT_PATH.write_text(render_report(result), encoding="utf-8")
+    print(REPORT_PATH.read_text(encoding="utf-8"))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/mcrl/physics_v025/rule_coordinator.py b/src/mcrl/physics_v025/rule_coordinator.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ab566578f59e88915958cce89da3e575bc2546e
--- /dev/null
+++ b/src/mcrl/physics_v025/rule_coordinator.py
@@ -0,0 +1,194 @@
+"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+from .acm import ACM_MODES, rate_target_sinr
+from .channel import fading_product_quantile
+from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS
+
+BeamIdentity = tuple[int, int]
+Assignment = BeamIdentity | None
+
+
+@dataclass(frozen=True)
+class RuleCandidate:
+    """One deterministic rule candidate before exact engine scoring."""
+
+    family: str
+    key: tuple[object, ...]
+    assignments: tuple[tuple[int, Assignment], ...]
+    metadata: tuple[tuple[str, object], ...]
+
+
+def activation_occupancy(
+    elevation_deg: float,
+    *,
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+    maximum_occupancy: int = 100,
+) -> int | None:
+    """First occupancy whose target SINR selects the lowest transmitted mode."""
+
+    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
+    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
+    for occupancy in range(1, maximum_occupancy + 1):
+        gamma = rate_target_sinr(
+            rate_target_bps,
+            BEAM_BANDWIDTH_HZ,
+            occupancy,
+        )
+        if gamma is None:
+            return None
+        if quantile * gamma >= lowest_threshold:
+            return occupancy
+    return None
+
+
+def occupancy_activation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    legal_options: Mapping[int, Sequence[BeamIdentity]],
+    slant_km: Mapping[tuple[int, BeamIdentity], float],
+    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
+    rate_target_bps: float = RATE_TARGET_BPS,
+    fading_quantile_alpha: float = 0.10,
+) -> tuple[RuleCandidate, ...]:
+    """Build singleton-beam activation candidates in physical-identity order."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        if len(occupants) != 1:
+            continue
+        incumbent_user = occupants[0]
+        elevation = elevation_deg.get((incumbent_user, beam))
+        if elevation is None:
+            continue
+        threshold = activation_occupancy(
+            elevation,
+            rate_target_bps=rate_target_bps,
+            fading_quantile_alpha=fading_quantile_alpha,
+            maximum_occupancy=len(assignments),
+        )
+        if threshold is None or threshold <= 1:
+            continue
+        arrivals = sorted(
+            (
+                (slant_km[(user, beam)], user)
+                for user, current in assignments.items()
+                if current != beam
+                and beam in legal_options.get(user, ())
+                and (user, beam) in slant_km
+            ),
+            key=lambda row: (row[0], row[1]),
+        )
+        needed = threshold - 1
+        if len(arrivals) < needed:
+            continue
+        moved = tuple(user for _slant, user in arrivals[:needed])
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = beam
+        rows.append(
+            RuleCandidate(
+                family="occupancy_activation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", 1),
+                    ("activation_occupancy", threshold),
+                    ("moved_users", moved),
+                    ("elevation_deg", elevation),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+def multi_aggressor_relief_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    victim_aggressors: Mapping[int, Sequence[int]],
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Move each qualifying victim's top two and top three aggressors."""
+
+    rows: list[RuleCandidate] = []
+    for victim in sorted(victim_aggressors):
+        ranked = tuple(victim_aggressors[victim])
+        for size in (2, 3):
+            moved = ranked[:size]
+            if len(moved) != size or any(user not in best_alternatives for user in moved):
+                continue
+            candidate = dict(assignments)
+            for user in moved:
+                candidate[user] = best_alternatives[user]
+            if any(candidate[user] == assignments[user] for user in moved):
+                continue
+            rows.append(
+                RuleCandidate(
+                    family="multi_aggressor_relief",
+                    key=(victim, size),
+                    assignments=tuple(sorted(candidate.items())),
+                    metadata=(
+                        ("victim_user", victim),
+                        ("coalition_size", size),
+                        ("moved_users", moved),
+                    ),
+                )
+            )
+    return tuple(rows)
+
+
+def beam_evacuation_candidates(
+    assignments: Mapping[int, Assignment],
+    *,
+    best_alternatives: Mapping[int, Assignment],
+) -> tuple[RuleCandidate, ...]:
+    """Evacuate every beam whose starting occupancy is exactly two or three."""
+
+    members: dict[BeamIdentity, list[int]] = {}
+    for user, beam in assignments.items():
+        if beam is not None:
+            members.setdefault(beam, []).append(user)
+    rows: list[RuleCandidate] = []
+    for beam, occupants in sorted(members.items()):
+        moved = tuple(sorted(occupants))
+        if len(moved) not in {2, 3} or any(
+            user not in best_alternatives for user in moved
+        ):
+            continue
+        candidate = dict(assignments)
+        for user in moved:
+            candidate[user] = best_alternatives[user]
+        if any(candidate[user] == beam for user in moved):
+            continue
+        rows.append(
+            RuleCandidate(
+                family="beam_evacuation",
+                key=(beam,),
+                assignments=tuple(sorted(candidate.items())),
+                metadata=(
+                    ("beam", beam),
+                    ("starting_occupancy", len(moved)),
+                    ("moved_users", moved),
+                ),
+            )
+        )
+    return tuple(rows)
+
+
+__all__ = [
+    "RuleCandidate",
+    "activation_occupancy",
+    "beam_evacuation_candidates",
