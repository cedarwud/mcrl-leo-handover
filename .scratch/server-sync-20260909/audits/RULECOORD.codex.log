def merge_worlds(paths: Sequence[Path]) -> dict[str, object]:
    receipts = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
    if any(row.get("status") != "COMPLETE" for row in receipts):
        raise RuleRunError("cannot merge an incomplete world receipt")
    anchors = [anchor for receipt in receipts for anchor in receipt["anchors"]]
    pooled = {arm: _pooled(anchors, arm) for arm in ("BASELINE", "UNILATERAL", "RULE")}
    rule_over_uni = (
        pooled["RULE"]["ee_bits_per_j"] / pooled["UNILATERAL"]["ee_bits_per_j"] - 1.0
    )
    rule_over_base = (
        pooled["RULE"]["ee_bits_per_j"] / pooled["BASELINE"]["ee_bits_per_j"] - 1.0
    )
    families = {}
    for family in FAMILIES:
        fired = [anchor for anchor in anchors if anchor["arms"]["RULE"]["fired_family"] == family]
        generated = sum(anchor["rule_census"]["family_generated"][family] for anchor in anchors)
        guarded = sum(anchor["rule_census"]["family_guard_passed"][family] for anchor in anchors)
        improving = sum(anchor["rule_census"]["family_strictly_improving"][family] for anchor in anchors)
        base_bits = math.fsum(anchor["arms"]["BASELINE"]["bits"] for anchor in fired)
        base_joules = math.fsum(anchor["arms"]["BASELINE"]["joules"] for anchor in fired)
        rule_bits = math.fsum(anchor["arms"]["RULE"]["bits"] for anchor in fired)
        rule_joules = math.fsum(anchor["arms"]["RULE"]["joules"] for anchor in fired)
        uni_bits = math.fsum(anchor["arms"]["UNILATERAL"]["bits"] for anchor in fired)
        uni_joules = math.fsum(anchor["arms"]["UNILATERAL"]["joules"] for anchor in fired)
        families[family] = {
            "generated": generated,
            "service_guard_passed": guarded,
            "strictly_improving": improving,
            "fired": len(fired),
            "delta_bits_vs_baseline": rule_bits - base_bits,
            "delta_joules_vs_baseline": rule_joules - base_joules,
            "pooled_ee_relative_vs_baseline_on_fired_anchors": (
                None if not fired else (rule_bits / rule_joules) / (base_bits / base_joules) - 1.0
            ),
            "pooled_ee_relative_vs_unilateral_on_fired_anchors": (
                None if not fired else (rule_bits / rule_joules) / (uni_bits / uni_joules) - 1.0
            ),
        }
    threshold_rows = [
        row
        for anchor in anchors
        for row in anchor["rule_census"]["singleton_activation_thresholds"]
        if row["activation_occupancy"] is not None
    ]
    threshold_values = [int(row["activation_occupancy"]) for row in threshold_rows]
    elevations = [float(row["elevation_deg"]) for row in threshold_rows]
    times = [float(anchor["arms"]["RULE"]["decision_wall_s"]) for anchor in anchors]
    served_noninferior = all(
        anchor["arms"]["RULE"]["served_count"] >= anchor["arms"]["UNILATERAL"]["served_count"]
        for anchor in anchors
    )
    payload = {
        "schema": SCHEMA + "-merged",
        "status": "COMPLETE",
        "classification": "DIAGNOSTIC_NOT_CLAIM",
        "training": False,
        "test_split_opened": False,
        "anchor_count": len(anchors),
        "worlds": sorted({anchor["world"] for anchor in anchors}),
        "pooled": pooled,
        "rule_over_unilateral_relative_gain": rule_over_uni,
        "rule_over_baseline_relative_gain": rule_over_base,
        "rule_served_noninferior_to_unilateral_at_every_anchor": served_noninferior,
        "family_breakdown": families,
        "activation_thresholds": {
            "observations": len(threshold_values),
            "minimum_required_occupancy": min(threshold_values),
            "maximum_required_occupancy": max(threshold_values),
            "required_occupancy_range": max(threshold_values) - min(threshold_values),
            "counts": {
                str(value): threshold_values.count(value)
                for value in sorted(set(threshold_values))
            },
            "elevation_min_deg": min(elevations),
            "elevation_max_deg": max(elevations),
        },
        "decision_times_s": {
            "budget": DECISION_BUDGET_S,
            "mean": math.fsum(times) / len(times),
            "p50": float(np.quantile(times, 0.50)),
            "p95": float(np.quantile(times, 0.95)),
            "maximum": max(times),
            "within_budget_count": sum(value <= DECISION_BUDGET_S for value in times),
            "classification": (
                "DEPLOYABLE" if all(value <= DECISION_BUDGET_S for value in times) else "CEILING"
            ),
        },
        "anchors": anchors,
        "source_receipts": [
            {"path": str(path), "receipt_sha256": receipt["receipt_sha256"]}
            for path, receipt in zip(paths, receipts, strict=True)
        ],
    }
    payload["receipt_sha256"] = digest_payload(payload)
    return payload


def _fmt_ee(value: float) -> str:
    return f"{value:,.3f}"


def render_report(result: Mapping[str, object]) -> str:
    pooled = result["pooled"]
    anchors = result["anchors"]
    family = result["family_breakdown"]
    times = result["decision_times_s"]
    thresholds = result["activation_thresholds"]
    lines = [
        "# Rule coordinator diagnostic — 2026-09-09",
        "",
        "Status: `DIAGNOSTIC_NOT_CLAIM`. No learning, model, head, training, or TEST/claim-panel data were used.",
        "",
        "## Pooled energy efficiency",
        "",
        "| arm | pooled bits | pooled joules | pooled EE (bit/J) |",
        "|---|---:|---:|---:|",
    ]
    for arm in ("BASELINE", "UNILATERAL", "RULE"):
        row = pooled[arm]
        lines.append(
            f"| **{arm}** | {row['bits']:,.3f} | {row['joules']:,.6f} | **{_fmt_ee(row['ee_bits_per_j'])}** |"
        )
    lines.extend(
        [
            "",
            f"**RULE versus UNILATERAL: {result['rule_over_unilateral_relative_gain']:+.6%}.** "
            f"RULE versus BASELINE: {result['rule_over_baseline_relative_gain']:+.6%}.",
            "",
            "The RULE-over-UNILATERAL contrast is service-valid at every anchor: "
            + ("**yes**." if result["rule_served_noninferior_to_unilateral_at_every_anchor"] else "**no**; RULE served fewer users on at least one anchor, so the EE gain does not count."),
            "",
            "## Served counts at every anchor",
            "",
            "Counts are users with any realised PHY service during the exact 48-boundary interval. Parentheses show decision-instant guard counts.",
            "",
            "| world | anchor | step | carrier | BASELINE | UNILATERAL | RULE | RULE family |",
            "|---:|---:|---:|---|---:|---:|---:|---|",
        ]
    )
    for anchor in anchors:
        arms = anchor["arms"]
        cells = {
            arm: f"{arms[arm]['served_count']} ({arms[arm]['decision_served_count']})"
            for arm in ("BASELINE", "UNILATERAL", "RULE")
        }
        lines.append(
            f"| {anchor['world']} | {anchor['anchor_index']} | {anchor['step_index']} | {anchor['carrier']} | "
            f"{cells['BASELINE']} | {cells['UNILATERAL']} | {cells['RULE']} | "
            f"{arms['RULE']['fired_family'] or 'none'} |"
        )
    lines.extend(
        [
            "",
            "## Per-family breakdown",
            "",
            "`generated` is every deterministic candidate scored by the exact engine; the rule commits the first strict improvement in family/key order.",
            "",
            "| family | generated | guard-passed | improving | fired | Δ bits vs BASELINE | Δ J vs BASELINE | EE vs BASELINE on fired anchors | EE vs UNILATERAL on fired anchors |",
            "|---|---:|---:|---:|---:|---:|---:|---:|---:|",
        ]
    )
    for name in FAMILIES:
        row = family[name]
        vs_base = row["pooled_ee_relative_vs_baseline_on_fired_anchors"]
        vs_uni = row["pooled_ee_relative_vs_unilateral_on_fired_anchors"]
        lines.append(
            f"| {name} | {row['generated']} | {row['service_guard_passed']} | {row['strictly_improving']} | {row['fired']} | "
            f"{row['delta_bits_vs_baseline']:+,.3f} | {row['delta_joules_vs_baseline']:+,.6f} | "
            f"{'n/a' if vs_base is None else f'{vs_base:+.6%}'} | {'n/a' if vs_uni is None else f'{vs_uni:+.6%}'} |"
        )
    lines.extend(
        [
            "",
            "### Occupancy correction and elevation-dependent threshold",
            "",
            "Only beams with **starting occupancy exactly 1** seed activation candidates. Starting-occupancy-2 activation coalitions are not mixed into this family. "
            f"Across {thresholds['observations']} singleton-beam observations at actual elevations "
            f"{thresholds['elevation_min_deg']:.3f}–{thresholds['elevation_max_deg']:.3f}°, the required occupancy ranged from "
            f"{thresholds['minimum_required_occupancy']} to {thresholds['maximum_required_occupancy']} "
            f"(variation {thresholds['required_occupancy_range']}; counts {json.dumps(thresholds['counts'], sort_keys=True)}).",
            "",
            "The threshold is recomputed as the first `n` for which the engine's actual-elevation `q_0.10(elevation) × Gamma_r(n)` reaches the lowest frozen ACM threshold; the 10° known-answer test requires `n=3`.",
            "",
            "## Rule decision times",
