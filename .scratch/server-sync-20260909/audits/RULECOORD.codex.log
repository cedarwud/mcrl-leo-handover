"""Fixed, auditable candidate rules for the V0.25 coordinator diagnostic."""

from __future__ import annotations

from dataclasses import dataclass
from typing import Mapping, Sequence

from .acm import ACM_MODES, rate_target_sinr
from .channel import fading_product_quantile
from .constants_v025 import BEAM_BANDWIDTH_HZ, RATE_TARGET_BPS

BeamIdentity = tuple[int, int]
Assignment = BeamIdentity | None


@dataclass(frozen=True)
class RuleCandidate:
    """One deterministic rule candidate before exact engine scoring."""

    family: str
    key: tuple[object, ...]
    assignments: tuple[tuple[int, Assignment], ...]
    metadata: tuple[tuple[str, object], ...]


def activation_occupancy(
    elevation_deg: float,
    *,
    rate_target_bps: float = RATE_TARGET_BPS,
    fading_quantile_alpha: float = 0.10,
    maximum_occupancy: int = 100,
) -> int | None:
    """First occupancy whose target SINR selects the lowest transmitted mode."""

    lowest_threshold = min(mode.threshold_linear for mode in ACM_MODES)
    quantile = fading_product_quantile(elevation_deg, fading_quantile_alpha)
    for occupancy in range(1, maximum_occupancy + 1):
        gamma = rate_target_sinr(
            rate_target_bps,
            BEAM_BANDWIDTH_HZ,
            occupancy,
        )
        if gamma is None:
            return None
        if quantile * gamma >= lowest_threshold:
            return occupancy
    return None


def occupancy_activation_candidates(
    assignments: Mapping[int, Assignment],
    *,
    legal_options: Mapping[int, Sequence[BeamIdentity]],
    slant_km: Mapping[tuple[int, BeamIdentity], float],
    elevation_deg: Mapping[tuple[int, BeamIdentity], float],
    rate_target_bps: float = RATE_TARGET_BPS,
    fading_quantile_alpha: float = 0.10,
) -> tuple[RuleCandidate, ...]:
    """Build singleton-beam activation candidates in physical-identity order."""

    members: dict[BeamIdentity, list[int]] = {}
    for user, beam in assignments.items():
        if beam is not None:
            members.setdefault(beam, []).append(user)
    rows: list[RuleCandidate] = []
    for beam, occupants in sorted(members.items()):
        if len(occupants) != 1:
            continue
        incumbent_user = occupants[0]
        elevation = elevation_deg.get((incumbent_user, beam))
        if elevation is None:
            continue
        threshold = activation_occupancy(
            elevation,
            rate_target_bps=rate_target_bps,
            fading_quantile_alpha=fading_quantile_alpha,
            maximum_occupancy=len(assignments),
        )
        if threshold is None or threshold <= 1:
            continue
        arrivals = sorted(
            (
                (slant_km[(user, beam)], user)
                for user, current in assignments.items()
                if current != beam
                and beam in legal_options.get(user, ())
                and (user, beam) in slant_km
            ),
            key=lambda row: (row[0], row[1]),
        )
        needed = threshold - 1
        if len(arrivals) < needed:
            continue
        moved = tuple(user for _slant, user in arrivals[:needed])
        candidate = dict(assignments)
        for user in moved:
            candidate[user] = beam
        rows.append(
            RuleCandidate(
                family="occupancy_activation",
                key=(beam,),
                assignments=tuple(sorted(candidate.items())),
                metadata=(
                    ("beam", beam),
                    ("starting_occupancy", 1),
                    ("activation_occupancy", threshold),
                    ("moved_users", moved),
                    ("elevation_deg", elevation),
                ),
            )
        )
    return tuple(rows)


def multi_aggressor_relief_candidates(
    assignments: Mapping[int, Assignment],
    *,
    victim_aggressors: Mapping[int, Sequence[int]],
    best_alternatives: Mapping[int, Assignment],
) -> tuple[RuleCandidate, ...]:
    """Move each qualifying victim's top two and top three aggressors."""

    rows: list[RuleCandidate] = []
    for victim in sorted(victim_aggressors):
        ranked = tuple(victim_aggressors[victim])
        for size in (2, 3):
            moved = ranked[:size]
            if len(moved) != size or any(user not in best_alternatives for user in moved):
                continue
            candidate = dict(assignments)
            for user in moved:
                candidate[user] = best_alternatives[user]
            if any(candidate[user] == assignments[user] for user in moved):
                continue
            rows.append(
                RuleCandidate(
                    family="multi_aggressor_relief",
                    key=(victim, size),
                    assignments=tuple(sorted(candidate.items())),
                    metadata=(
                        ("victim_user", victim),
                        ("coalition_size", size),
                        ("moved_users", moved),
                    ),
                )
            )
    return tuple(rows)


def beam_evacuation_candidates(
    assignments: Mapping[int, Assignment],
    *,
    best_alternatives: Mapping[int, Assignment],
) -> tuple[RuleCandidate, ...]:
    """Evacuate every beam whose starting occupancy is exactly two or three."""

    members: dict[BeamIdentity, list[int]] = {}
    for user, beam in assignments.items():
        if beam is not None:
            members.setdefault(beam, []).append(user)
    rows: list[RuleCandidate] = []
    for beam, occupants in sorted(members.items()):
        moved = tuple(sorted(occupants))
        if len(moved) not in {2, 3} or any(
            user not in best_alternatives for user in moved
        ):
            continue
        candidate = dict(assignments)
        for user in moved:
            candidate[user] = best_alternatives[user]
        if any(candidate[user] == beam for user in moved):
            continue
        rows.append(
            RuleCandidate(
                family="beam_evacuation",
                key=(beam,),
                assignments=tuple(sorted(candidate.items())),
                metadata=(
                    ("beam", beam),
                    ("starting_occupancy", len(moved)),
                    ("moved_users", moved),
                ),
            )
        )
    return tuple(rows)


__all__ = [
    "RuleCandidate",
    "activation_occupancy",
    "beam_evacuation_candidates",
    "multi_aggressor_relief_candidates",
    "occupancy_activation_candidates",
]

