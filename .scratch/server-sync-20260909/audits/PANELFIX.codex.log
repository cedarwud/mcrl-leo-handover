        "sha256": Q1_V1_SCHEMA_SHA256,
    },
    "normalization": "raw_value / positive_frozen_scale; signed values retained",
    "shape": [len(Q1_V2_FEATURES)],
    "features": [
        {
            "name": feature.name,
            "unit": feature.unit,
            "scale_hex": float_hex(feature.scale),
        }
        for feature in Q1_V2_FEATURES
    ],
    "changes": {
        "repaired": [
            "off_axis_angle: true satellite-to-(beam centre,user) angle at decision boundary 0, converted from physics degrees to schema radians"
        ],
        "added": [
            "focal_link_elevation: provider boundary-0 elevation in the physics degree convention"
        ],
        "removed_exact_redundancies": [
            "beam_active_before_focal",
            "previous_beam_active_for_action",
        ],
        "retained_structural_coordinate": [
            "missing_incumbent: meaningful for tapes with an unserved prior mapping; structurally zero on the measured pilot tapes"
        ],
        "null_action_geometry": (
