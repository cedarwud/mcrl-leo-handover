                "generation order; per anchor, the deployed bounded-union-v2 catalogue "
                "plus the two named reference profiles; base first then configuration-ID order"
            ),
        },
        "reference_objects": {
            "certified_fixed_point": {
                "name": "offline certified guarded-F first-improvement fixed point",
                "construction": (
                    "exact realised boundary-0 deterministic cyclic first-improvement from "
                    "the anchor base; complete no-strict-improvement terminal certificate"
                ),
                "information_class": "exact realised boundary-0 oracle; no future-boundary information",
                "budget_s": None, "fixed_point_traversal_order": TRAVERSAL,
            },
            "anytime_incumbent": {
                "name": "10 s anytime first-improvement incumbent",
                "construction": (
                    "last fully evaluated and accepted iterate no later than 10.0 seconds "
                    "under the same ordered first-improvement traversal"
                ),
                "information_class": "exact realised boundary-0 oracle available by the 10 s checkpoint",
                "budget_s": 10.0, "fixed_point_traversal_order": TRAVERSAL,
            },
        },
        "coordinator_budget_s": 10.0,
        "runner_instrumentation": {
            "producer": str(Path(__file__).resolve()),
            "physics_evaluations_per_arm_recorded": False,
            "wall_clock_to_decision_per_arm_recorded": False,
            "missing_fields_required_addition": (
                "the five-arm online runner must record per-arm physics evaluations and "
                "wall-clock time to committed decision; panel construction timings are not substitutes"
            ),
        },
        "anchors": anchors, "synthetic_smoke_not_evidence": smoke,
        "full_buffer_no_demand_cap": True,
    }
    atomic_json(args.output, panel)
    panel_digest = sha256(args.output)
    args.output.with_name(args.output.name + ".sha256").write_text(
        f"{panel_digest}  {args.output.name}\n", encoding="ascii",
    )
    receipt = {
        "schema": "mcrl-v025-panelbuild-receipt-v1", "panel": str(args.output.resolve()),
        "panel_sha256": panel_digest, "anchor_count": len(anchors), "run_identity": run_identity,
        "run_digest": run_digest, "audits": audits, "process_count": 1,
        "nice": os.getpriority(os.PRIO_PROCESS, 0),
        "thread_pins": {name: os.environ[name] for name in THREAD_VARIABLES},
        "peak_rss_bytes": check_rss(), "synthetic_smoke_not_evidence": smoke,
        "c3_encoding": {
            "checkpoint_input_width": widths["C3"],
            "member_width": widths["C3_MEMBER"],
            "production_full_width": 240,
            "global_resource_feature_prefix_count": widths["C3"] - 234,
            "ordered_global_resource_features": [
                "changed_user_fraction", "affected_beam_fraction",
                "occupancy_before_per_user", "occupancy_after_per_user",
                "pairwise_cross_gain_sum", "pairwise_cross_gain_max",
            ],
            "fixture_limitation": (
                "the nominated synthetic smoke fixture owns only the first three ordered "
                "global-resource features; this dry run is not deployable C3 evidence"
                if smoke else None
            ),
        },
    }
    atomic_json(args.output.with_name(args.output.stem + ".receipt.json"), receipt)
    if sha256(PILOT_PATH) != pilot_hash or sha256(PANELCEIL_PATH) != panelceil_hash:
        raise RuntimeError("read-only source code changed during panel construction")
    print(f"panel_sha256={panel_digest}", flush=True)
    print(f"peak_rss_bytes={check_rss()} final", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

