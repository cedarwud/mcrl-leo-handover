@dataclass(frozen=True, slots=True)
class FeatureRow:
    q1_state: tuple[float, ...]
    q2_state: tuple[float, ...]
    outage: bool


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("ascii")).hexdigest()


def peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def check_rss() -> int:
    value = peak_rss_bytes()
    if value >= MAX_RSS_BYTES:
        raise MemoryError(f"peak RSS {value} is not below 5 GB")
    return value


def enforce_runtime() -> None:
    if Path(sys.executable).resolve() != PYTHON.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}; required {PYTHON}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        os.nice(15 - os.getpriority(os.PRIO_PROCESS, 0))
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("could not enforce nice -n 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARIABLES
           if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins drifted: {bad}")
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    new_hard = MAX_RSS_BYTES if hard == resource.RLIM_INFINITY else min(hard, MAX_RSS_BYTES)
    resource.setrlimit(resource.RLIMIT_AS, (min(MAX_RSS_BYTES, new_hard), new_hard))


def atomic_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    temporary.replace(path)


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def checkpoint_shape(path: Path) -> dict[str, int]:
    payload = json.loads(path.read_text(encoding="ascii"))
    result: dict[str, int] = {}
    for route in ("C1", "C2", "C3"):
        heads = [payload["arms"][arm][route] for arm in payload["arms"]]
        widths = {len(head["weights_hex"][0]) for head in heads}
        if len(widths) != 1:
            raise RuntimeError(f"checkpoint {route} widths differ by arm")
        result[route] = next(iter(widths))
    member_widths = {payload["arms"][arm]["C3"]["member_width"] for arm in payload["arms"]}
    if len(member_widths) != 1:
        raise RuntimeError("checkpoint C3 member widths differ by arm")
    result["C3_MEMBER"] = int(next(iter(member_widths)))
    return result


def verify_sidecar(path: Path, expected: str) -> None:
    if sha256(path) != expected:
        raise RuntimeError(f"authenticated input changed: {path}")
    sidecar = path.with_name(path.name + ".sha256")
    if not sidecar.is_file() or sidecar.read_text(encoding="ascii").split()[0] != expected:
        raise RuntimeError(f"missing or mismatched SHA-256 sidecar: {path}")


def load_exact_feature_rows(source: Mapping[str, object], widths: Mapping[str, int]):
    path = Path(str(source["view_path"]))
    raw_lines = path.read_bytes().splitlines()
    values = [json.loads(line.decode("ascii")) for line in raw_lines]
    if not values or values[0].get("schema") != "mcrl-v025-exact-source-view-shard-v1":
        raise RuntimeError(f"exact source-view header drifted: {path}")
    if values[0].get("global_anchor_index") != source["index"]:
        raise RuntimeError("exact source-view anchor identity drifted")
    result = {}
    for raw, payload in zip(raw_lines[1:], values[1:], strict=True):
        canonical = json.dumps(
            payload, sort_keys=True, separators=(",", ":"), allow_nan=False,
        ).encode("ascii")
        if raw != canonical or "exact_source_view" not in payload:
            raise RuntimeError("exact source-view row is noncanonical or lacks its receipt")
        action = payload["action"]
        identity = (
            None if action["norad_id"] is None
            else (int(action["norad_id"]), int(action["beam_chain_id"]))
        )
        q1 = tuple(float.fromhex(value) for value in payload["q1_state"])
        q2 = tuple(float.fromhex(value) for value in payload["q2_state"])
        if len(q1) != widths["C1"] or len(q2) != widths["C2"]:
            raise RuntimeError("authenticated exact source-view feature width drifted")
        key = (int(payload["user_id"]), identity)
        if key in result:
            raise RuntimeError(f"duplicate exact feature row: {key}")
        result[key] = FeatureRow(q1, q2, bool(payload["outage"]))
    if len(result) != int(values[0]["row_count"]):
        raise RuntimeError("exact source-view row count drifted")
    return result


def discover_panel(limit: int) -> list[dict[str, object]]:
    rows = []
    for index in range(limit):
        root = STAGING / f"global-{index:03d}"
        result_path = root / f"BUILD_NOT_CLAIM-anchor-{index:03d}.result.json"
        if not result_path.is_file():
            break
        payload = json.loads(result_path.read_text(encoding="ascii"))
        step_index, carrier_index = divmod(index, len(CARRIERS))
        expected = (index, 1, step_index, carrier_index, CARRIERS[carrier_index])
        actual = (
            payload["global_anchor_index"], payload["world_index"], payload["step_index"],
            payload["carrier_index"], payload["carrier"],
        )
        if actual != expected:
            raise RuntimeError(f"declared generation order drifted at global anchor {index}")
        physics = root / "physics" / str(payload["physics_relative_path"])
        view = root / "views" / str(payload["view_relative_path"])
        verify_sidecar(physics, str(payload["physics_sha256"]))
        verify_sidecar(view, str(payload["view_sha256"]))
        rows.append({
            "index": index, "step_index": step_index, "carrier": payload["carrier"],
            "world_id": payload["world_id"], "result_path": str(result_path),
            "result_sha256": sha256(result_path), "physics_path": str(physics),
            "physics_sha256": payload["physics_sha256"], "view_path": str(view),
            "view_sha256": payload["view_sha256"],
        })
    if not rows:
        raise RuntimeError("exact-source corpus has no contiguous anchor prefix")
    return rows


def load_calibration(pilot):
    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
    ratio = lambda name: Fraction(*payload[name])
    return pilot.PilotCalibration(
        eta_ref=ratio("eta_ref"), lambda_bits_per_j=ratio("lambda_bits_per_j"),
        kappa_bits_per_user_step=ratio("kappa_bits_per_user_step"),
        bits_ref=ratio("bits_ref"), joules_ref=ratio("joules_ref"),
        users=int(payload["users"]),
    )


def panelceil_snapshot() -> tuple[dict[int, dict[str, object]], dict[str, object] | None]:
    if not PANELCEIL_RECEIPT.is_file():
        return {}, None
    try:
        payload = json.loads(PANELCEIL_RECEIPT.read_text(encoding="ascii"))
    except (OSError, json.JSONDecodeError):
        return {}, None
    if payload.get("status") != "COMPLETE":
        return {}, {"status": payload.get("status"), "path": str(PANELCEIL_RECEIPT)}
    claimed = payload.get("receipt_sha256")
    unsigned = dict(payload)
    unsigned.pop("receipt_sha256", None)
    if claimed != canonical_sha256(unsigned):
        raise RuntimeError("PANELCEIL receipt authentication failed")
    rows = {int(row["global_anchor_index"]): row for row in payload["anchors"]}
    return rows, {
        "status": "COMPLETE", "path": str(PANELCEIL_RECEIPT),
        "file_sha256": sha256(PANELCEIL_RECEIPT), "receipt_sha256": claimed,
        "anchor_count": len(rows),
    }


def mapping_from_receipt(rows: Sequence[Sequence[object]]) -> dict[int, tuple[int, int] | None]:
    return {
        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
        for user, identity in rows
    }


def profile_id(configuration_id: str) -> str:
    return "profile:" + hashlib.sha256(configuration_id.encode("ascii")).hexdigest()


def outcome(pilot, tape, step_index: int, incumbent, profile) -> dict[str, float | int]:
    attained = profile.score.rate_target_attained
    if attained is None:
        raise RuntimeError("physical profile omitted rate-target attainment")
    rekeys = pilot.ENGINE._rekeyed_users(tape, step_index)
    events = pilot.ENGINE._physical_events(
        incumbent, profile.config, cell_rekeyed_users=rekeys,
    )
    users = len(profile.config.assignments)
    return {
        "full_buffer_bits": float(profile.bits), "joules": float(profile.joules),
        "rate_target_attained": sum(bool(value) for value in attained.values()),
        "rate_target_opportunities": len(attained),
        "service_available": sum(bool(value) for value in profile.score.served_phy.values()),
        "service_opportunities": users,
        "handovers": sum(event.kind in {"beam_change", "satellite_change", "cell_rekey"}
                         for event in events),
        "handover_opportunities": users, "deadline_misses": 0, "decisions": 0,
    }


def receipt_outcome(pilot, tape, step_index: int, incumbent, config,
                    metric: Mapping[str, object]) -> dict[str, float | int]:
    events = pilot.ENGINE._physical_events(
        incumbent, config,
        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
    )
    users = int(metric["user_count"])
    return {
        "full_buffer_bits": float(metric["bits"]), "joules": float(metric["joules"]),
        "rate_target_attained": int(metric["rate_target_attained_count"]),
        "rate_target_opportunities": users, "service_available": int(metric["served_count"]),
        "service_opportunities": users,
        "handovers": sum(event.kind in {"beam_change", "satellite_change", "cell_rekey"}
                         for event in events),
        "handover_opportunities": users, "deadline_misses": 0, "decisions": 0,
    }


def c3_state(pilot, tape, step_index: int, base, config, rows_by_action,
             width: int, member_width: int) -> tuple[int, list[float]]:
    changed = tuple(user for user in sorted(base.mapping)
                    if base.mapping[user] != config.mapping[user])
    if len(changed) <= 1:
        return len(changed), [0.0] * width
    context = pilot._coalition_context(
        tape=tape, step_index=step_index, anchor=base, selected=config,
        rows_by_user_action=rows_by_action,
    )
    full = context.invariant_vector(member_width=member_width).tolist()
    # The production context currently has six trailing global-resource
    # scalars.  A checkpoint declares how many of that ordered prefix it owns.
    fixed_width = len(full) - len(context.global_resource_features)
    globals_owned = width - fixed_width
    if globals_owned < 1 or globals_owned > len(context.global_resource_features):
        raise RuntimeError(
            f"checkpoint C3 width {width} cannot encode production context width {len(full)}"
        )
    return len(changed), full[:fixed_width + globals_owned]


def build_anchor(*, pilot, panelceil, calibration, tape, source: Mapping[str, object],
                 widths: Mapping[str, int], reused: Mapping[str, object] | None,
                 cached_anchor: Mapping[str, object] | None,
                 total: int) -> tuple[dict[str, object], dict[str, object]]:
    index = int(source["index"])
    step_index = int(source["step_index"])
    carrier = str(source["carrier"])
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    started = time.perf_counter()

    catalogue, census = pilot.ENGINE._catalogue_with_census(
        tape, step_index, base, setting=setting, calibration=calibration,
        counter=pilot.ENGINE.EvaluationCounter(), run_setting=run_setting,
    )

    reused_names: list[str] = []
    reused_metrics: dict[tuple[tuple[int, tuple[int, int] | None], ...], Mapping[str, object]] = {}
    if reused is not None:
        if reused.get("anchor_id") != f"{source['world_id']}|{step_index}|{carrier}":
            raise RuntimeError(f"PANELCEIL anchor identity mismatch at {index}")
        first_metric = reused["committed"]["U_FIRST"]
        anytime_metric = reused["committed"]["U_FIRST_AT_10"]
        fixed = pilot.ENGINE._configuration(
            base, mapping_from_receipt(first_metric["assignments"]), kind="panelbuild-reused-fixed",
        )
        anytime = pilot.ENGINE._configuration(
            base, mapping_from_receipt(anytime_metric["assignments"]), kind="panelbuild-reused-anytime",
        )
        if not reused["first_improvement"]["termination_certificate"]["complete"]:
            raise RuntimeError("PANELCEIL first-improvement certificate is incomplete")
        reused_metrics[fixed.assignments] = first_metric
        reused_metrics[anytime.assignments] = anytime_metric
        reused_names.extend(("certified_fixed_point", "anytime_incumbent_10s"))
    else:
        search = panelceil.first_improvement(
            pilot.ENGINE, calibration, tape, step_index, base, incumbent, run_setting,
        )
        if not search.receipt["termination_certificate"]["complete"]:
            raise RuntimeError("first-improvement search lacks a complete terminal certificate")
        fixed = search.selected
        if cached_anchor is None:
            anytime = panelceil.config_at(search, 10.0)
        else:
            expected_fixed = str(cached_anchor["certified_fixed_point_profile_id"])
            expected_anytime = str(cached_anchor["anytime_incumbent_profile_id"])
            if profile_id(fixed.configuration_id) != expected_fixed:
                raise RuntimeError("recomputed fixed-point identity differs from outcome cache")
            matching = [config for _elapsed, config in search.moves
                        if profile_id(config.configuration_id) == expected_anytime]
            if not matching:
                raise RuntimeError("cached 10-second incumbent is absent from recomputed search path")
            anytime = matching[-1]

    unique = {row.assignments: row for row in catalogue}
    unique[fixed.assignments] = fixed
    unique[anytime.assignments] = anytime
    ordered = (base,) + tuple(sorted(
        (row for assignments, row in unique.items() if assignments != base.assignments),
        key=lambda row: row.configuration_id,
    ))

    rows_by_action = load_exact_feature_rows(source, widths)
    required_actions = {
        (user, config.mapping[user])
        for config in ordered for user in base.mapping
        if config.mapping[user] != base.mapping[user]
    }
    required_actions.update((user, identity) for user, identity in base.assignments)
    missing_actions = sorted(
        required_actions - set(rows_by_action),
        key=lambda row: (row[0], (-1, -1) if row[1] is None else row[1]),
    )
    feature_evaluations = 0
    feature_source = "authenticated exact-source view"
    if missing_actions:
        previous_fallback = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
        try:
            built = pilot._build_anchor_rows(
                tape=tape, setting=setting, run_setting=run_setting,
                calibration=calibration, step_index=step_index, carrier=carrier,
                anchor_index=index, include_coalition=False, full_legal_actions=True,
            )
        finally:
            pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = previous_fallback
        if built["base"].assignments != base.assignments or built["incumbent"].assignments != incumbent.assignments:
            raise RuntimeError("exact feature builder base/incumbent drifted")
        exact_full = built["rows_by_user_action"]
        absent = set(missing_actions) - set(exact_full)
        if absent:
            raise RuntimeError(f"exact physics did not supply required actions: {sorted(absent)!r}")
        rows_by_action.update({key: exact_full[key] for key in missing_actions})
        feature_evaluations = int(built["physics_calls"])
        feature_source = "authenticated exact-source view plus exact targeted-action regeneration"

    cached_outcomes = {}
    if cached_anchor is not None:
        if cached_anchor.get("anchor_id") != f"{source['world_id']}|{step_index}|{carrier}":
            raise RuntimeError("outcome-cache anchor identity drifted")
        cached_outcomes = {
            str(profile["profile_id"]): profile["outcome"]
            for profile in cached_anchor["profiles"]
        }

    evaluator = pilot.ENGINE.StepEvaluator(
        tape, setting, step_index, transition_from=incumbent,
        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
        field="realised", counter=pilot.ENGINE.EvaluationCounter(),
        run_setting=run_setting, boundary_indices=tuple(range(48)),
    )
    to_evaluate = [
        row for row in ordered
        if row.assignments not in reused_metrics
        and profile_id(row.configuration_id) not in cached_outcomes
    ]
    for offset in range(0, len(to_evaluate), OUTCOME_BATCH_SIZE):
        evaluator.evaluate_many(tuple(to_evaluate[offset:offset + OUTCOME_BATCH_SIZE]))
        check_rss()

    profiles = []
    invalid = []
    for config in ordered:
        metric = reused_metrics.get(config.assignments)
        if metric is not None:
            physical = receipt_outcome(pilot, tape, step_index, incumbent, config, metric)
        elif profile_id(config.configuration_id) in cached_outcomes:
            physical = cached_outcomes[profile_id(config.configuration_id)]
        else:
            evaluated = evaluator._evaluated.get(config.configuration_id)
            if evaluated is None:
                invalid.append(config.configuration_id)
                continue
            physical = outcome(pilot, tape, step_index, incumbent, evaluated)
        pairs_c1 = []
        pairs_c2 = []
        for user in sorted(base.mapping):
            if config.mapping[user] == base.mapping[user]:
                continue
            reference = rows_by_action[(user, base.mapping[user])]
            selected = rows_by_action[(user, config.mapping[user])]
            pairs_c1.append({"reference": list(reference.q1_state), "selected": list(selected.q1_state)})
            pairs_c2.append({"reference": list(reference.q2_state), "selected": list(selected.q2_state)})
        size, state = c3_state(
            pilot, tape, step_index, base, config, rows_by_action,
            widths["C3"], widths["C3_MEMBER"],
        )
        if pairs_c1 and (len(pairs_c1[0]["reference"]) != widths["C1"]
                         or len(pairs_c2[0]["reference"]) != widths["C2"]):
            raise RuntimeError("checkpoint and exact feature widths differ")
        profiles.append({
            "profile_id": profile_id(config.configuration_id),
            "catalogue_order": len(profiles), "C1": pairs_c1, "C2": pairs_c2,
            "C3": {"coalition_size": size, "invariant_state": state},
            "outcome": physical,
        })
    by_assignment = {row.assignments: profile_id(row.configuration_id) for row in ordered}
    if fixed.assignments not in by_assignment or anytime.assignments not in by_assignment:
        raise RuntimeError("reference profile was lost from the common catalogue")
    anchor_id = f"{source['world_id']}|{step_index}|{carrier}"
    anchor = {
        "anchor_id": anchor_id, "world_id": source["world_id"],
        "date": pilot._utc_at(tape, step_index), "world_seed": tape.seed,
        "base_profile_id": profile_id(base.configuration_id),
        "certified_fixed_point_profile_id": by_assignment[fixed.assignments],
        "anytime_incumbent_profile_id": by_assignment[anytime.assignments],
        "profiles": profiles, "arm_instrumentation": None,
    }
    audit = {
        "anchor_id": anchor_id, "global_anchor_index": index,
        "source": dict(source), "catalogue_mode": census["catalogue_mode"],
        "catalogue_profiles_before_full_horizon_filter": len(ordered),
        "catalogue_profiles_emitted": len(profiles), "invalid_profiles": len(invalid),
        "fixed_point_source": "PANELCEIL" if reused is not None else "producer computation",
        "fixed_point_certificate_complete": True,
        "fixed_point_traversal_order": TRAVERSAL,
        "anytime_budget_s": 10.0,
        "catalogue_profile_id_sha256": canonical_sha256(
            [profile["profile_id"] for profile in profiles]
        ),
        "reused_objects": reused_names,
        "feature_source": feature_source,
        "missing_view_actions_regenerated_exactly": len(missing_actions),
        "feature_physics_boundary_evaluations": feature_evaluations,
        "outcome_physics_boundary_evaluations": evaluator.counter.boundary_evaluations,
        "wall_seconds": time.perf_counter() - started, "peak_rss_bytes": check_rss(),
    }
    print(
        f"anchor {index + 1}/{total} profiles={len(profiles)} "
        f"peak_rss_bytes={audit['peak_rss_bytes']}", flush=True,
    )
    return anchor, audit


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--checkpoint", type=Path, default=DEFAULT_CHECKPOINT)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--resume-dir", type=Path, default=DEFAULT_RESUME)
    parser.add_argument("--outcome-cache-dir", type=Path)
    parser.add_argument("--limit", type=int, default=20)
    args = parser.parse_args()
    enforce_runtime()
    if args.limit < 1 or args.limit > 20:
        raise RuntimeError("limit must be in 1..20")
    if args.output.exists():
        raise RuntimeError(f"refusing to overwrite {args.output}")
    checkpoint_digest = sha256(args.checkpoint)
    widths = checkpoint_shape(args.checkpoint)
    sources = discover_panel(args.limit)
    print(f"panel prefix {len(sources)}/{args.limit}", flush=True)
    print(f"peak_rss_bytes={check_rss()} before imports", flush=True)

    panelceil_hash = sha256(PANELCEIL_PATH)
    pilot_hash = sha256(PILOT_PATH)
    panelceil = load_module("panelbuild_panelceil", PANELCEIL_PATH)
    pilot = panelceil.load_pilot()
    calibration = load_calibration(pilot)
    reused, reuse_receipt = panelceil_snapshot()
    if reuse_receipt is None:
        print("PANELCEIL reuse unavailable: receipt absent", flush=True)
    elif not reused:
        print(f"PANELCEIL reuse unavailable: receipt status={reuse_receipt['status']}", flush=True)
    else:
        print(f"PANELCEIL reuse available for {len(reused)} anchors", flush=True)

    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape
    tape = build_world_tape(
        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
        steps=33, start_time_s=0.0,
    )
    print(f"peak_rss_bytes={check_rss()} after tape", flush=True)
    anchors = []
    audits = []
    run_identity = {
        "checkpoint_sha256": checkpoint_digest, "widths": widths,
        "pilot_sha256": pilot_hash, "panelceil_script_sha256": panelceil_hash,
        "panelceil_receipt": reuse_receipt,
        "sources": sources,
        "feature_source_contract": "authenticated exact view; exact physics for required absent actions",
        "outcome_cache": (
            None if args.outcome_cache_dir is None else {
                "path": str(args.outcome_cache_dir.resolve()),
                "files": [
                    {"name": path.name, "sha256": sha256(path)}
                    for path in sorted(args.outcome_cache_dir.glob("anchor-*.json"))
                ],
            }
        ),
    }
    run_digest = canonical_sha256(run_identity)
    fragment_root = args.resume_dir / run_digest
    for source in sources:
        fragment = fragment_root / f"anchor-{int(source['index']):03d}.json"
        cached_anchor = None
        if args.outcome_cache_dir is not None:
            cache_path = args.outcome_cache_dir / f"anchor-{int(source['index']):03d}.json"
            if not cache_path.is_file():
                raise RuntimeError(f"outcome cache omitted {cache_path}")
            cached_anchor = json.loads(cache_path.read_text(encoding="ascii"))["anchor"]
        if fragment.is_file():
            saved = json.loads(fragment.read_text(encoding="ascii"))
            if saved.get("run_digest") != run_digest:
                raise RuntimeError(f"resume fragment input drift: {fragment}")
            anchor, audit = saved["anchor"], saved["audit"]
            print(
                f"anchor {int(source['index']) + 1}/{len(sources)} resume-complete "
                f"peak_rss_bytes={check_rss()}", flush=True,
            )
        else:
            anchor, audit = build_anchor(
                pilot=pilot, panelceil=panelceil, calibration=calibration, tape=tape,
                source=source, widths=widths, reused=reused.get(int(source["index"])),
                cached_anchor=cached_anchor,
                total=len(sources),
            )
            atomic_json(fragment, {"run_digest": run_digest, "anchor": anchor, "audit": audit})
        anchors.append(anchor)
        audits.append(audit)

    anchor_ids = [row["anchor_id"] for row in anchors]
    dates = list(dict.fromkeys(str(row["date"])[:10] for row in anchors))
    worlds = list(dict.fromkeys(str(row["world_id"]) for row in anchors))
    seeds = list(dict.fromkeys(int(row["world_seed"]) for row in anchors))
    smoke = checkpoint_digest == SMOKE_CHECKPOINT_SHA256
    panel = {
        "schema": PANEL_SCHEMA,
        "panel_identity": {
            "name": "EXACTGEN2 declared first-20 Stage-C scoring panel",
            "information_class": (
                "causal decision-instant exact C1/C2 and physical C3 state; outcomes and "
