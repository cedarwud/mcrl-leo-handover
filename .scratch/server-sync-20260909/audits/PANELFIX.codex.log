#!/home/sat/mcrl-leo-handover/.venv/bin/python
"""Score Stage-C five-arm checkpoints on both declared reporting axes.

The scorer is deliberately physics-free.  A panel file owns the common
catalogue, full-buffer physical outcomes, certified fixed point, and the
same-budget anytime incumbent.  Checkpoints own only the learned scores.
"""

from __future__ import annotations

import argparse
import csv
import hashlib
import json
import math
import os
from pathlib import Path
import random
import resource
import statistics
import sys
from typing import Iterable, Mapping, Sequence


THREAD_VARIABLES = (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
)
for _name in THREAD_VARIABLES:
    os.environ[_name] = "1"

INTERPRETER = Path("/home/sat/mcrl-leo-handover/.venv/bin/python")
MAX_RSS_BYTES = 5_000_000_000
REQUIRED_NICE = 15
PROCESS_COUNT = 1
ARMS = ("FULL", "DROP_C1", "DROP_C2", "DROP_C3", "ALL_NEUTRAL_CONTROL")
ROUTES = ("C1", "C2", "C3")
EXPECTED_SOURCE_MAP = {
    "FULL": {"C1": "informed", "C2": "informed", "C3": "informed"},
    "DROP_C1": {"C1": "neutral", "C2": "informed", "C3": "informed"},
    "DROP_C2": {"C1": "informed", "C2": "neutral", "C3": "informed"},
    "DROP_C3": {"C1": "informed", "C2": "informed", "C3": "neutral"},
    "ALL_NEUTRAL_CONTROL": {"C1": "neutral", "C2": "neutral", "C3": "neutral"},
}
CHECKPOINT_SCHEMA = "mcrl-v025-stagec-v1-lineage-checkpoint-v1"
PANEL_SCHEMA = "mcrl-v025-dual-axis-scoring-panel-v1"
RESULT_SCHEMA = "mcrl-v025-dual-axis-score-result-v1"
SMOKE_CHECKPOINT_SHA256 = "bcf99d209c62782eb524ff609e2008d8e8a59828e733791a9e1d9b43fb310428"
NUMERATOR = (
    "sum of saturated full-buffer successfully decoded forward-downlink information bits; "
    "rate target is a power-control setpoint; no demand cap"
)
EE_BOUNDARY = (
    "modelled partial-payload DC energy: user-link PA supply, per-beam chain circuitry, "
    "and common processing increment; declared idle states included"
)


class ScorerContractError(RuntimeError):
    """Raised when an input cannot support the declared estimands."""


def _peak_rss_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def _enforce_resources() -> None:
    if Path(sys.executable).resolve() != INTERPRETER.resolve():
        raise RuntimeError(f"wrong interpreter: {sys.executable}; required {INTERPRETER}")
    current_nice = os.getpriority(os.PRIO_PROCESS, 0)
    if current_nice < REQUIRED_NICE:
        os.nice(REQUIRED_NICE - current_nice)
    if os.getpriority(os.PRIO_PROCESS, 0) < REQUIRED_NICE:
        raise RuntimeError("could not enforce nice -n 15")
    bad = {name: os.environ.get(name) for name in THREAD_VARIABLES if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins drifted: {bad}")
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    new_hard = MAX_RSS_BYTES if hard == resource.RLIM_INFINITY else min(hard, MAX_RSS_BYTES)
    resource.setrlimit(resource.RLIMIT_AS, (min(MAX_RSS_BYTES, new_hard), new_hard))
    if PROCESS_COUNT > 3:
        raise RuntimeError("scorer process inventory exceeds hard cap")


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _canonical_sha256(value: object) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("ascii")
    return hashlib.sha256(encoded).hexdigest()


def _read_json(path: Path) -> object:
    try:
        return json.loads(path.read_text(encoding="ascii"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ScorerContractError(f"cannot parse JSON {path}") from error


def _write_bytes_once(path: Path, content: bytes) -> None:
    if path.exists():
        raise ScorerContractError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("xb") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def _write_json_once(path: Path, value: object) -> None:
    content = json.dumps(value, indent=2, sort_keys=True, allow_nan=False).encode("ascii") + b"\n"
    _write_bytes_once(path, content)


def _require_object(value: object, field: str) -> Mapping[str, object]:
    if not isinstance(value, Mapping):
        raise ScorerContractError(f"{field} must be an object")
    return value


def _finite_number(value: object, field: str, *, nonnegative: bool = False) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ScorerContractError(f"{field} must be numeric")
    number = float(value)
    if not math.isfinite(number) or (nonnegative and number < 0.0):
        raise ScorerContractError(f"{field} must be finite{' and nonnegative' if nonnegative else ''}")
    return number


def _count(value: object, field: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise ScorerContractError(f"{field} must be a nonnegative integer")
    return value


def _decode_vector(values: object, field: str) -> tuple[float, ...]:
    if not isinstance(values, list):
        raise ScorerContractError(f"{field} must be an array")
    result = []
    for value in values:
        if not isinstance(value, str):
            raise ScorerContractError(f"{field} checkpoint values must be float.hex strings")
        try:
            number = float.fromhex(value)
        except ValueError as error:
            raise ScorerContractError(f"{field} contains an invalid float.hex value") from error
        if not math.isfinite(number):
            raise ScorerContractError(f"{field} contains a non-finite value")
        result.append(number)
    return tuple(result)


def _decode_layers(values: object, field: str) -> tuple[tuple[tuple[float, ...], ...], ...]:
    if not isinstance(values, list) or not values:
        raise ScorerContractError(f"{field} must contain layers")
    layers = []
    for layer_index, layer in enumerate(values):
        if not isinstance(layer, list) or not layer:
            raise ScorerContractError(f"{field}[{layer_index}] must be a nonempty matrix")
        rows = tuple(_decode_vector(row, f"{field}[{layer_index}]") for row in layer)
        width = len(rows[0])
        if width == 0 or any(len(row) != width for row in rows):
            raise ScorerContractError(f"{field}[{layer_index}] is ragged")
        layers.append(rows)
    return tuple(layers)


class Head:
    def __init__(self, payload: object, field: str) -> None:
        source = _require_object(payload, field)
        self.kind = source.get("kind")
        expected = (
            "permutation_invariant_set_conditioned_legacy_adam_mlp"
            if field.endswith(".C3")
            else "legacy_heterogeneous_adam_mlp"
        )
        if self.kind != expected:
            raise ScorerContractError(f"{field} kind drifted: {self.kind!r}")
        activation = source.get("activation")
        if activation not in {"relu", "tanh"}:
            raise ScorerContractError(f"{field} activation drifted")
        self.activation = str(activation)
        self.weights = _decode_layers(source.get("weights_hex"), f"{field}.weights_hex")
        biases = source.get("biases_hex")
        if not isinstance(biases, list) or len(biases) != len(self.weights):
            raise ScorerContractError(f"{field} bias layer inventory drifted")
        self.biases = tuple(
            _decode_vector(layer, f"{field}.biases_hex[{index}]")
            for index, layer in enumerate(biases)
        )
        prior = len(self.weights[0])
        for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
            if len(weights) != prior or len(weights[0]) != len(bias):
                raise ScorerContractError(f"{field} layer {index} shape drifted")
            prior = len(bias)
        if prior != 1:
            raise ScorerContractError(f"{field} output width must be one")
        self.input_width = len(self.weights[0])
        member_width = source.get("member_width")
        self.member_width = None if member_width is None else _count(member_width, f"{field}.member_width")

    def score(self, state: Sequence[float]) -> float:
        if len(state) != self.input_width:
            raise ScorerContractError(
                f"model input width {len(state)} differs from checkpoint width {self.input_width}"
            )
        current = [float(value) for value in state]
        for layer_index, (weights, biases) in enumerate(zip(self.weights, self.biases, strict=True)):
            following = [
                math.fsum(current[row] * weights[row][column] for row in range(len(current))) + bias
                for column, bias in enumerate(biases)
            ]
            if layer_index != len(self.weights) - 1:
                if self.activation == "relu":
                    following = [max(0.0, value) for value in following]
                else:
                    following = [math.tanh(value) for value in following]
            current = following
        if not math.isfinite(current[0]):
            raise ScorerContractError("checkpoint produced a non-finite score")
        return current[0]


def _load_checkpoint(path: Path) -> dict[str, object]:
    raw = _read_json(path)
    payload = _require_object(raw, "checkpoint")
    if payload.get("schema") != CHECKPOINT_SCHEMA:
        raise ScorerContractError(f"unsupported checkpoint schema in {path}")
    if payload.get("source_map") != EXPECTED_SOURCE_MAP:
        raise ScorerContractError("checkpoint does not contain the sealed five-arm source map")
    arms = _require_object(payload.get("arms"), "checkpoint.arms")
    if set(arms) != set(ARMS):
        raise ScorerContractError("checkpoint arm inventory must be exactly the five sealed arms")
    completed = _count(payload.get("completed_source_epochs"), "completed_source_epochs")
    if completed == 0 or completed % 100:
        raise ScorerContractError("checkpoint is not on the sealed 100-epoch cadence")
    learner_seed = _count(payload.get("learner_seed"), "learner_seed")
    models = {}
    for arm in ARMS:
        arm_payload = _require_object(arms[arm], f"arms.{arm}")
        if set(arm_payload) != set(ROUTES):
            raise ScorerContractError(f"{arm} does not contain exactly C1/C2/C3")
        models[arm] = {route: Head(arm_payload[route], f"arms.{arm}.{route}") for route in ROUTES}
    widths = {
        route: {models[arm][route].input_width for arm in ARMS}
        for route in ROUTES
    }
    if any(len(values) != 1 for values in widths.values()):
        raise ScorerContractError("model input widths differ across arms")
    return {
        "path": str(path.resolve()),
        "sha256": _sha256(path),
        "completed_source_epochs": completed,
        "learner_seed": learner_seed,
        "training_physics_digest": payload.get("training_physics_digest"),
        "batch_digests": payload.get("batch_digests"),
        "models": models,
        "widths": {route: next(iter(values)) for route, values in widths.items()},
    }


OUTCOME_FIELDS = (
    "full_buffer_bits",
    "joules",
    "rate_target_attained",
    "rate_target_opportunities",
    "service_available",
    "service_opportunities",
    "handovers",
    "handover_opportunities",
    "deadline_misses",
    "decisions",
)


def _validate_outcome(value: object, field: str) -> dict[str, float | int]:
    outcome = _require_object(value, field)
    if set(outcome) != set(OUTCOME_FIELDS):
        raise ScorerContractError(f"{field} outcome field inventory drifted")
    result: dict[str, float | int] = {
        "full_buffer_bits": _finite_number(outcome["full_buffer_bits"], f"{field}.full_buffer_bits", nonnegative=True),
        "joules": _finite_number(outcome["joules"], f"{field}.joules", nonnegative=True),
    }
    if result["joules"] <= 0.0:
        raise ScorerContractError(f"{field}.joules must be positive")
    for name in OUTCOME_FIELDS[2:]:
        result[name] = _count(outcome[name], f"{field}.{name}")
    for numerator, denominator in (
        ("rate_target_attained", "rate_target_opportunities"),
        ("service_available", "service_opportunities"),
        ("handovers", "handover_opportunities"),
        ("deadline_misses", "decisions"),
    ):
        if result[numerator] > result[denominator]:
            raise ScorerContractError(f"{field}.{numerator} exceeds {denominator}")
    return result


def _validate_state_pairs(value: object, field: str, width: int) -> tuple[dict[str, tuple[float, ...]], ...]:
    if not isinstance(value, list):
        raise ScorerContractError(f"{field} must be an array")
    pairs = []
    for index, raw in enumerate(value):
        pair = _require_object(raw, f"{field}[{index}]")
        if set(pair) != {"reference", "selected"}:
            raise ScorerContractError(f"{field}[{index}] must contain reference and selected")
        decoded = {}
        for side in ("reference", "selected"):
            states = pair[side]
            if not isinstance(states, list) or len(states) != width:
                raise ScorerContractError(f"{field}[{index}].{side} width drifted")
            decoded[side] = tuple(_finite_number(item, f"{field}[{index}].{side}") for item in states)
        pairs.append(decoded)
    return tuple(pairs)


def _validate_panel(raw: object, widths: Mapping[str, int], panel_path: Path | None) -> dict[str, object]:
    panel = _require_object(raw, "panel")
    required = {
        "schema", "panel_identity", "reference_objects", "coordinator_budget_s",
        "runner_instrumentation", "anchors", "synthetic_smoke_not_evidence",
        "full_buffer_no_demand_cap",
    }
    if set(panel) != required or panel.get("schema") != PANEL_SCHEMA:
        raise ScorerContractError("scoring panel schema or top-level field inventory drifted")
    if panel.get("full_buffer_no_demand_cap") is not True:
        raise ScorerContractError("panel must attest full-buffer outcomes with no demand cap")
    budget = _finite_number(panel.get("coordinator_budget_s"), "coordinator_budget_s")
    if budget != 10.0:
        raise ScorerContractError("coordinator budget must be the declared 10 seconds")
    identity = _require_object(panel.get("panel_identity"), "panel_identity")
    identity_required = {
        "name", "information_class", "estimand", "numerator", "energy_boundary",
        "anchors", "worlds", "dates", "world_seeds", "fixed_point_traversal_order",
        "provisioning_rule",
    }
    if set(identity) != identity_required:
        raise ScorerContractError("panel identity field inventory drifted")
    if identity.get("numerator") != NUMERATOR or identity.get("energy_boundary") != EE_BOUNDARY:
        raise ScorerContractError("panel numerator or energy boundary is not the declared construction")
    traversal = identity.get("fixed_point_traversal_order")
    if not isinstance(traversal, str) or not traversal.strip():
        raise ScorerContractError("fixed-point traversal order may not be implicit")
    references = _require_object(panel.get("reference_objects"), "reference_objects")
    if set(references) != {"certified_fixed_point", "anytime_incumbent"}:
        raise ScorerContractError("reference inventory must be certified fixed point plus anytime incumbent")
    certified = _require_object(references["certified_fixed_point"], "certified_fixed_point")
    anytime = _require_object(references["anytime_incumbent"], "anytime_incumbent")
    for name, reference in (("certified_fixed_point", certified), ("anytime_incumbent", anytime)):
        if set(reference) != {"name", "construction", "information_class", "budget_s", "fixed_point_traversal_order"}:
            raise ScorerContractError(f"{name} construction metadata drifted")
        if not all(isinstance(reference[key], str) and reference[key] for key in ("name", "construction", "information_class")):
            raise ScorerContractError(f"{name} naming metadata must be nonempty")
        if reference["fixed_point_traversal_order"] != traversal:
            raise ScorerContractError(f"{name} traversal order differs from panel identity")
    if certified["budget_s"] is not None:
        raise ScorerContractError("offline certified fixed point must have a null budget")
    if _finite_number(anytime["budget_s"], "anytime_incumbent.budget_s") != budget:
        raise ScorerContractError("anytime comparator is not at the coordinator's same wall-clock budget")
    instrumentation = _require_object(panel.get("runner_instrumentation"), "runner_instrumentation")
    if set(instrumentation) != {
        "producer", "physics_evaluations_per_arm_recorded", "wall_clock_to_decision_per_arm_recorded",
        "missing_fields_required_addition",
    }:
        raise ScorerContractError("runner instrumentation metadata drifted")
    recorded = (
        instrumentation["physics_evaluations_per_arm_recorded"] is True
        and instrumentation["wall_clock_to_decision_per_arm_recorded"] is True
    )
    if not recorded and not isinstance(instrumentation["missing_fields_required_addition"], str):
        raise ScorerContractError("missing runner instrumentation must name the required addition")
    anchors_raw = panel.get("anchors")
    if not isinstance(anchors_raw, list) or not anchors_raw:
        raise ScorerContractError("panel requires at least one anchor")
    anchors = []
    anchor_ids = set()
    for anchor_index, raw_anchor in enumerate(anchors_raw):
        field = f"anchors[{anchor_index}]"
        anchor = _require_object(raw_anchor, field)
        required_anchor = {
            "anchor_id", "world_id", "date", "world_seed", "base_profile_id",
            "certified_fixed_point_profile_id", "anytime_incumbent_profile_id",
            "profiles", "arm_instrumentation",
        }
        if set(anchor) != required_anchor:
            raise ScorerContractError(f"{field} field inventory drifted")
        anchor_id = anchor.get("anchor_id")
        if not isinstance(anchor_id, str) or not anchor_id or anchor_id in anchor_ids:
            raise ScorerContractError("anchor identities must be unique nonempty strings")
        anchor_ids.add(anchor_id)
        profiles_raw = anchor.get("profiles")
        if not isinstance(profiles_raw, list) or not profiles_raw:
            raise ScorerContractError(f"{field}.profiles must be nonempty")
        profiles = []
        profile_ids = set()
        for profile_index, raw_profile in enumerate(profiles_raw):
            pfield = f"{field}.profiles[{profile_index}]"
            profile = _require_object(raw_profile, pfield)
            if set(profile) != {"profile_id", "catalogue_order", "C1", "C2", "C3", "outcome"}:
                raise ScorerContractError(f"{pfield} field inventory drifted")
            profile_id = profile.get("profile_id")
            if not isinstance(profile_id, str) or not profile_id or profile_id in profile_ids:
                raise ScorerContractError(f"{pfield}.profile_id is invalid or duplicated")
            profile_ids.add(profile_id)
            c3 = _require_object(profile.get("C3"), f"{pfield}.C3")
            if set(c3) != {"coalition_size", "invariant_state"}:
                raise ScorerContractError(f"{pfield}.C3 field inventory drifted")
            invariant = c3["invariant_state"]
            if not isinstance(invariant, list) or len(invariant) != widths["C3"]:
                raise ScorerContractError(f"{pfield}.C3.invariant_state width drifted")
            profiles.append({
                "profile_id": profile_id,
                "catalogue_order": _count(profile.get("catalogue_order"), f"{pfield}.catalogue_order"),
                "C1": _validate_state_pairs(profile.get("C1"), f"{pfield}.C1", widths["C1"]),
                "C2": _validate_state_pairs(profile.get("C2"), f"{pfield}.C2", widths["C2"]),
                "C3": {
                    "coalition_size": _count(c3["coalition_size"], f"{pfield}.C3.coalition_size"),
                    "invariant_state": tuple(
                        _finite_number(item, f"{pfield}.C3.invariant_state") for item in invariant
                    ),
                },
                "outcome": _validate_outcome(profile.get("outcome"), f"{pfield}.outcome"),
            })
        if len({profile["catalogue_order"] for profile in profiles}) != len(profiles):
            raise ScorerContractError(f"{field} catalogue order is not unique")
        profiles.sort(key=lambda item: item["catalogue_order"])
        for reference_field in (
            "base_profile_id", "certified_fixed_point_profile_id", "anytime_incumbent_profile_id"
        ):
            if anchor[reference_field] not in profile_ids:
                raise ScorerContractError(f"{field}.{reference_field} is not in the catalogue")
        arm_instrumentation = anchor.get("arm_instrumentation")
        if recorded:
            arm_rows = _require_object(arm_instrumentation, f"{field}.arm_instrumentation")
            if set(arm_rows) != set(ARMS):
                raise ScorerContractError(f"{field} must record instrumentation for all five arms")
            cleaned_instrumentation = {}
            for arm in ARMS:
                row = _require_object(arm_rows[arm], f"{field}.arm_instrumentation.{arm}")
                if set(row) != {"physics_evaluations", "wall_clock_to_decision_s"}:
                    raise ScorerContractError(f"{field}.{arm} instrumentation fields drifted")
                cleaned_instrumentation[arm] = {
                    "physics_evaluations": _count(row["physics_evaluations"], f"{field}.{arm}.physics_evaluations"),
                    "wall_clock_to_decision_s": _finite_number(
                        row["wall_clock_to_decision_s"], f"{field}.{arm}.wall_clock_to_decision_s", nonnegative=True
                    ),
                }
        else:
            if arm_instrumentation is not None:
                raise ScorerContractError("panel says runner fields are absent but supplies instrumentation")
            cleaned_instrumentation = None
        anchors.append({
            "anchor_id": anchor_id,
            "world_id": anchor.get("world_id"),
            "date": anchor.get("date"),
            "world_seed": anchor.get("world_seed"),
            "base_profile_id": anchor.get("base_profile_id"),
            "certified_fixed_point_profile_id": anchor.get("certified_fixed_point_profile_id"),
            "anytime_incumbent_profile_id": anchor.get("anytime_incumbent_profile_id"),
            "profiles": profiles,
            "arm_instrumentation": cleaned_instrumentation,
        })
    expected_anchor_ids = [anchor["anchor_id"] for anchor in anchors]
    if identity.get("anchors") != expected_anchor_ids:
        raise ScorerContractError("panel identity anchor list differs from anchor rows or order")
    return {
        "path": None if panel_path is None else str(panel_path.resolve()),
        "sha256": _canonical_sha256(panel) if panel_path is None else _sha256(panel_path),
        "identity": dict(identity),
        "references": {"certified_fixed_point": dict(certified), "anytime_incumbent": dict(anytime)},
        "budget_s": budget,
        "instrumentation": dict(instrumentation),
        "instrumentation_recorded": recorded,
        "anchors": anchors,
        "synthetic_smoke_not_evidence": panel.get("synthetic_smoke_not_evidence") is True,
    }


def _profile_score(model: Mapping[str, Head], profile: Mapping[str, object], knockout_all: bool = False) -> float:
    if knockout_all:
        return 0.0
    total = 0.0
    for route in ("C1", "C2"):
        for pair in profile[route]:
            total += model[route].score(pair["selected"]) - model[route].score(pair["reference"])
    c3 = profile["C3"]
    if c3["coalition_size"] > 1:
        total += model["C3"].score(c3["invariant_state"])
    return total


def _select(model: Mapping[str, Head], profiles: Sequence[Mapping[str, object]], *, knockout_all: bool = False) -> Mapping[str, object]:
    best = profiles[0]
    best_score = _profile_score(model, best, knockout_all=knockout_all)
    for profile in profiles[1:]:
        score = _profile_score(model, profile, knockout_all=knockout_all)
        if score > best_score:
            best, best_score = profile, score
    return best


def _pool(outcomes: Iterable[Mapping[str, float | int]]) -> dict[str, float | int]:
    rows = tuple(outcomes)
    totals = {name: math.fsum(float(row[name]) for row in rows) for name in OUTCOME_FIELDS[:2]}
    for name in OUTCOME_FIELDS[2:]:
        totals[name] = sum(int(row[name]) for row in rows)
    bits = float(totals["full_buffer_bits"])
    joules = float(totals["joules"])
    if joules <= 0.0:
        raise ScorerContractError("pooled energy denominator is not positive")
    def rate(numerator: str, denominator: str) -> float | None:
        return None if totals[denominator] == 0 else float(totals[numerator]) / float(totals[denominator])
    return {
        **totals,
        "pooled_ee_bits_per_j": bits / joules,
        "rate_target_attainment": rate("rate_target_attained", "rate_target_opportunities"),
        "service_availability": rate("service_available", "service_opportunities"),
        "handover_rate": rate("handovers", "handover_opportunities"),
        "deadline_miss_rate": rate("deadline_misses", "decisions"),
    }


def _metadata(panel: Mapping[str, object], estimand: str, reference: Mapping[str, object]) -> dict[str, object]:
    identity = panel["identity"]
    return {
        "reference_object": reference["name"],
        "reference_construction": reference["construction"],
        "reference_information_class": reference["information_class"],
        "information_class": identity["information_class"],
        "estimand": estimand,
        "numerator": identity["numerator"],
        "energy_boundary": identity["energy_boundary"],
        "panel_identity": {
            "name": identity["name"], "anchors": identity["anchors"], "worlds": identity["worlds"],
            "dates": identity["dates"], "world_seeds": identity["world_seeds"],
            "provisioning_rule": identity["provisioning_rule"],
        },
        "fixed_point_traversal_order": identity["fixed_point_traversal_order"],
    }


def _relative_difference(value: float, reference: float) -> float | None:
    return None if reference == 0.0 else (value - reference) / reference


def _score_checkpoint(checkpoint: Mapping[str, object], panel: Mapping[str, object]) -> dict[str, object]:
    selections: dict[str, list[Mapping[str, object]]] = {arm: [] for arm in ARMS}
    selected_ids: dict[str, list[str]] = {arm: [] for arm in ARMS}
    neutral_ids = []
    knockout_ids = []
    knockout_outcomes = []
    certified_outcomes = []
    anytime_outcomes = []
    total_anchors = len(panel["anchors"])
    for index, anchor in enumerate(panel["anchors"], start=1):
        print(f"anchor {index}/{total_anchors}", flush=True)
        profiles = anchor["profiles"]
        by_id = {profile["profile_id"]: profile for profile in profiles}
        for arm in ARMS:
            chosen = _select(checkpoint["models"][arm], profiles)
            selections[arm].append(chosen["outcome"])
            selected_ids[arm].append(chosen["profile_id"])
        knockout = _select(checkpoint["models"]["FULL"], profiles, knockout_all=True)
        neutral_ids.append(selected_ids["ALL_NEUTRAL_CONTROL"][-1])
        knockout_ids.append(knockout["profile_id"])
        knockout_outcomes.append(knockout["outcome"])
        certified_outcomes.append(by_id[anchor["certified_fixed_point_profile_id"]]["outcome"])
        anytime_outcomes.append(by_id[anchor["anytime_incumbent_profile_id"]]["outcome"])
    pools = {arm: _pool(selections[arm]) for arm in ARMS}
    knockout_pool = _pool(knockout_outcomes)
    certified_pool = _pool(certified_outcomes)
    anytime_pool = _pool(anytime_outcomes)
    differing = [
        panel["anchors"][index]["anchor_id"]
        for index, (neutral, knockout) in enumerate(zip(neutral_ids, knockout_ids, strict=True))
        if neutral != knockout
    ]
    knockout = {
        **_metadata(
            panel,
            "ALL_NEUTRAL_CONTROL committed selection versus all C1/C2/C3 deployed terms removed from FULL checkpoint",
            {
                "name": "FULL checkpoint all-terms-removed scoring intervention",
                "construction": "set C1=C2=C3 deployed score contributions to exact zero; retain catalogue/order/tie rule; not a sixth trained arm",
                "information_class": panel["identity"]["information_class"],
            },
        ),
        "neutral_selection_profile_ids": neutral_ids,
        "all_knockout_selection_profile_ids": knockout_ids,
        "differing_anchor_ids": differing,
        "differing_anchor_count": len(differing),
        "anchor_count": len(neutral_ids),
        "all_neutral_pooled_ee_bits_per_j": pools["ALL_NEUTRAL_CONTROL"]["pooled_ee_bits_per_j"],
        "all_knockout_pooled_ee_bits_per_j": knockout_pool["pooled_ee_bits_per_j"],
        "pooled_ee_difference_bits_per_j": (
            pools["ALL_NEUTRAL_CONTROL"]["pooled_ee_bits_per_j"] - knockout_pool["pooled_ee_bits_per_j"]
        ),
        "coincide_at_every_anchor": not differing,
    }
    axis_a_rows = []
    neutral = pools["ALL_NEUTRAL_CONTROL"]
    for arm in ARMS:
        reference = {
            "name": "ALL_NEUTRAL_CONTROL" if arm != "ALL_NEUTRAL_CONTROL" else "self",
            "construction": (
                "same-checkpoint matched-row exact-zero-target training for C1/C2/C3 with all heads retained and deployed"
                if arm != "ALL_NEUTRAL_CONTROL" else "the reported arm itself"
            ),
            "information_class": panel["identity"]["information_class"],
        }
        row = {
            **_metadata(panel, "pooled full-buffer EE and operational co-metrics", reference),
            "row_type": "arm",
            "arm": arm,
            "checkpoint_sha256": checkpoint["sha256"],
            "completed_source_epochs": checkpoint["completed_source_epochs"],
            "learner_seed": checkpoint["learner_seed"],
            "selected_profile_ids": selected_ids[arm],
            **pools[arm],
            "demand_cap_applied": False,
        }
        axis_a_rows.append(row)
    for comparator in ("ALL_NEUTRAL_CONTROL", "DROP_C1", "DROP_C2", "DROP_C3"):
        comp = pools[comparator]
        axis_a_rows.append({
            **_metadata(
                panel,
                "difference in pooled full-buffer EE (FULL minus named same-checkpoint arm)",
                {
                    "name": comparator,
                    "construction": (
                        "same-checkpoint matched-row exact-zero-target training for all routes"
                        if comparator == "ALL_NEUTRAL_CONTROL"
                        else f"same-checkpoint matched-row exact-zero-target training for {comparator.removeprefix('DROP_')} with other routes informative"
                    ),
                    "information_class": panel["identity"]["information_class"],
                },
            ),
            "row_type": "contrast",
            "contrast": f"FULL-minus-{comparator}",
            "checkpoint_sha256": checkpoint["sha256"],
            "completed_source_epochs": checkpoint["completed_source_epochs"],
            "learner_seed": checkpoint["learner_seed"],
            "difference_bits_per_j": pools["FULL"]["pooled_ee_bits_per_j"] - comp["pooled_ee_bits_per_j"],
            "relative_difference": _relative_difference(pools["FULL"]["pooled_ee_bits_per_j"], comp["pooled_ee_bits_per_j"]),
            "primary": comparator == "ALL_NEUTRAL_CONTROL",
            "primary_interpretation": "PENDING_CROSS_CHECKPOINT_KNOCKOUT_CLASSIFICATION" if comparator == "ALL_NEUTRAL_CONTROL" else "route_source_substitution_contrast",
            "demand_cap_applied": False,
        })
    axis_b_rows = []
    fixed_ee = certified_pool["pooled_ee_bits_per_j"]
    anytime_ee = anytime_pool["pooled_ee_bits_per_j"]
    for arm in ARMS:
        instrumentation_values = None
        if panel["instrumentation_recorded"]:
            per_anchor = [anchor["arm_instrumentation"][arm] for anchor in panel["anchors"]]
            times = [row["wall_clock_to_decision_s"] for row in per_anchor]
            instrumentation_values = {
                "physics_evaluations_consumed": sum(row["physics_evaluations"] for row in per_anchor),
                "wall_clock_to_decision_s": times,
                "wall_clock_to_decision_mean_s": statistics.fmean(times),
                "wall_clock_to_decision_max_s": max(times),
            }
        row = {
            **_metadata(
                panel,
                "pooled EE attained as a fraction of the offline certified fixed point's pooled EE; same-budget anytime incumbent reported beside the arm",
                panel["references"]["certified_fixed_point"],
            ),
            "arm": arm,
            "checkpoint_sha256": checkpoint["sha256"],
            "completed_source_epochs": checkpoint["completed_source_epochs"],
            "learner_seed": checkpoint["learner_seed"],
            "coordinator_budget_s": panel["budget_s"],
            "arm_pooled_ee_bits_per_j": pools[arm]["pooled_ee_bits_per_j"],
            "certified_fixed_point_pooled_ee_bits_per_j": fixed_ee,
            "attained_ee_fraction_of_certified_fixed_point": pools[arm]["pooled_ee_bits_per_j"] / fixed_ee,
            "anytime_incumbent_reference_object": panel["references"]["anytime_incumbent"]["name"],
            "anytime_incumbent_construction": panel["references"]["anytime_incumbent"]["construction"],
            "anytime_incumbent_information_class": panel["references"]["anytime_incumbent"]["information_class"],
            "anytime_incumbent_budget_s": panel["references"]["anytime_incumbent"]["budget_s"],
            "anytime_incumbent_pooled_ee_bits_per_j": anytime_ee,
            "anytime_incumbent_fraction_of_certified_fixed_point": anytime_ee / fixed_ee,
            "arm_minus_anytime_bits_per_j": pools[arm]["pooled_ee_bits_per_j"] - anytime_ee,
            "arm_relative_to_anytime": _relative_difference(pools[arm]["pooled_ee_bits_per_j"], anytime_ee),
            "budget_compliance_status": "RECORDED" if instrumentation_values else "UNAVAILABLE_RUNNER_NOT_RECORDED",
            "physics_evaluations_consumed": None if instrumentation_values is None else instrumentation_values["physics_evaluations_consumed"],
            "wall_clock_to_decision_s": None if instrumentation_values is None else instrumentation_values["wall_clock_to_decision_s"],
            "wall_clock_to_decision_mean_s": None if instrumentation_values is None else instrumentation_values["wall_clock_to_decision_mean_s"],
            "wall_clock_to_decision_max_s": None if instrumentation_values is None else instrumentation_values["wall_clock_to_decision_max_s"],
            "missing_fields_required_addition": (
                None if instrumentation_values else panel["instrumentation"]["missing_fields_required_addition"]
            ),
        }
        axis_b_rows.append(row)
    return {
        "checkpoint": {key: checkpoint[key] for key in (
            "path", "sha256", "completed_source_epochs", "learner_seed",
            "training_physics_digest", "batch_digests",
        )},
        "axis_a": axis_a_rows,
        "axis_b": axis_b_rows,
        "knockout_check": knockout,
    }


def _smoke_panel(widths: Mapping[str, int]) -> dict[str, object]:
    rng = random.Random(20260910)
    anchor_rows = []
    anchor_ids = ["fixture-world-1/anchor-0", "fixture-world-1/anchor-1", "fixture-world-2/anchor-0"]
    for anchor_index, anchor_id in enumerate(anchor_ids):
        profiles = []
        for profile_index in range(6):
            state_pairs = {}
            for route in ("C1", "C2"):
                reference = [0.0 for _ in range(widths[route])]
                selected = [
                    0.0 if profile_index == 0 else rng.uniform(-1.0, 1.0) * (1.0 + 0.1 * anchor_index)
                    for _ in range(widths[route])
                ]
                state_pairs[route] = [{"reference": reference, "selected": selected}]
            c3_state = [
                0.0 if profile_index == 0 else rng.uniform(-0.5, 0.5)
                for _ in range(widths["C3"])
            ]
            quality = 1.0 + 0.15 * profile_index + 0.03 * anchor_index
            profiles.append({
                "profile_id": f"p{profile_index}",
                "catalogue_order": profile_index,
                **state_pairs,
                "C3": {"coalition_size": 0 if profile_index == 0 else 2, "invariant_state": c3_state},
                "outcome": {
                    "full_buffer_bits": 1_000_000_000.0 * quality,
                    "joules": 120.0 - 5.0 * profile_index + anchor_index,
                    "rate_target_attained": 80 + 3 * profile_index,
                    "rate_target_opportunities": 100,
                    "service_available": 90 + profile_index,
                    "service_opportunities": 100,
                    "handovers": profile_index,
                    "handover_opportunities": 100,
                    "deadline_misses": 0,
                    "decisions": 1,
                },
            })
        anchor_rows.append({
            "anchor_id": anchor_id,
            "world_id": f"fixture-world-{1 + anchor_index // 2}",
            "date": "2099-01-01",
            "world_seed": 9000 + anchor_index,
            "base_profile_id": "p0",
            "certified_fixed_point_profile_id": "p5",
            "anytime_incumbent_profile_id": "p4",
            "profiles": profiles,
            "arm_instrumentation": None,
        })
    traversal = (
        "synthetic smoke: users ascending, legal actions ascending, first strict improvement, "
        "restart at the first user after each commit, stop after a complete no-move sweep"
    )
    return {
        "schema": PANEL_SCHEMA,
        "panel_identity": {
            "name": "synthetic-stagec-dual-axis-smoke-NOT-EVIDENCE",
            "information_class": "synthetic fixture model inputs and synthetic full-buffer physical outcomes",
            "estimand": "pipeline-population check only; no scientific EE estimand",
            "numerator": NUMERATOR,
            "energy_boundary": EE_BOUNDARY,
            "anchors": anchor_ids,
            "worlds": ["fixture-world-1", "fixture-world-2"],
            "dates": ["2099-01-01"],
            "world_seeds": [9000, 9001, 9002],
            "fixed_point_traversal_order": traversal,
            "provisioning_rule": "SYNTHETIC_FIXTURE_NOT_SEALED_OR_CLAIMABLE",
        },
        "reference_objects": {
            "certified_fixed_point": {
                "name": "synthetic offline certified fixed point p5",
                "construction": "fixture-designated terminal p5; construction exists only to exercise the reference plumbing",
                "information_class": "synthetic fixture",
                "budget_s": None,
                "fixed_point_traversal_order": traversal,
            },
            "anytime_incumbent": {
                "name": "synthetic anytime incumbent p4 at 10 seconds",
                "construction": "fixture-designated p4 returned at the same 10-second wall-clock budget",
                "information_class": "synthetic fixture",
                "budget_s": 10.0,
                "fixed_point_traversal_order": traversal,
            },
        },
        "coordinator_budget_s": 10.0,
        "runner_instrumentation": {
            "producer": "/home/sat/mcrl-v025-retrain-ws/scripts/run_stagec_training.py",
            "physics_evaluations_per_arm_recorded": False,
            "wall_clock_to_decision_per_arm_recorded": False,
            "missing_fields_required_addition": (
                "add per checkpoint/anchor/arm physics_evaluations_consumed and monotonic "
                "wall_clock_to_committed_decision_s to the evaluation runner receipt; the training runner cannot supply them"
            ),
        },
        "anchors": anchor_rows,
        "synthetic_smoke_not_evidence": True,
        "full_buffer_no_demand_cap": True,
