def run(checkpoint_paths: Sequence[Path], panel_path: Path | None, output: Path, smoke: bool) -> dict[str, object]:
    if output.exists():
        raise ScorerContractError(f"output directory already exists: {output}")
    checkpoints = [_load_checkpoint(path) for path in _discover_checkpoints(checkpoint_paths)]
    widths = checkpoints[0]["widths"]
    if any(checkpoint["widths"] != widths for checkpoint in checkpoints[1:]):
        raise ScorerContractError("checkpoint model-input schemas differ")
    if smoke:
        if len(checkpoints) != 1 or checkpoints[0]["sha256"] != SMOKE_CHECKPOINT_SHA256:
            raise ScorerContractError("--smoke-fixture requires the declared bcf99d... fixture checkpoint")
        panel_raw = _smoke_panel(widths)
    else:
        if panel_path is None:
            raise ScorerContractError("production scoring requires --panel")
        panel_raw = _read_json(panel_path)
    panel = _validate_panel(panel_raw, widths, panel_path)
    scored = [_score_checkpoint(checkpoint, panel) for checkpoint in checkpoints]
    label, all_coincide = _classification(scored)
    f6 = [row for checkpoint in scored for row in checkpoint["axis_a"]]
    f7 = [row for row in f6 if row["row_type"] == "arm"]
    f8 = [row for checkpoint in scored for row in checkpoint["axis_b"]]
    result = {
        "schema": RESULT_SCHEMA,
        "scorer": str(Path(__file__).resolve()),
        "scorer_sha256": _sha256(Path(__file__)),
        "panel": {key: panel[key] for key in (
            "path", "sha256", "identity", "references", "instrumentation",
            "instrumentation_recorded", "synthetic_smoke_not_evidence",
        )},
        "checkpoints": scored,
        "primary_reference": "ALL_NEUTRAL_CONTROL",
        "base_is_reference": False,
        "primary_contrast_interpretation": label,
        "neutral_and_knockout_coincide_everywhere": all_coincide,
        "loss_values_are_not_ee_evidence": True,
        "tables": {
            "F6_ablation": f6,
            "F7_training_trajectory": f7,
            "F8_recovered_fraction": f8,
        },
        "resource_limits": {
            "python_processes_used": PROCESS_COUNT,
            "max_python_processes": 3,
            "nice": os.getpriority(os.PRIO_PROCESS, 0),
            "blas_threads": {name: os.environ[name] for name in THREAD_VARIABLES},
            "address_space_limit_bytes": MAX_RSS_BYTES,
            "peak_rss_bytes": _peak_rss_bytes(),
        },
    }
    if result["resource_limits"]["peak_rss_bytes"] >= MAX_RSS_BYTES:
        raise MemoryError("peak RSS exceeded the strict per-process bound")
    output.mkdir(parents=True, exist_ok=False)
    _write_json_once(output / "dual-axis-scores.json", result)
    _write_csv(output / "F6-ablation.csv", f6)
    _write_csv(output / "F7-training-trajectory.csv", f7)
    _write_csv(output / "F8-recovered-fraction.csv", f8)
    _write_bytes_once(output / "report.md", _build_report(result).encode("utf-8"))
    return result


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--checkpoints", type=Path, nargs="+", required=True)
    parser.add_argument("--panel", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--smoke-fixture", action="store_true")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    try:
        _enforce_resources()
        args = build_parser().parse_args(argv)
        if args.smoke_fixture == (args.panel is not None):
            raise ScorerContractError("choose exactly one of --panel or --smoke-fixture")
        result = run(args.checkpoints, args.panel, args.output.resolve(), args.smoke_fixture)
        print(json.dumps({
            "event": "dual-axis-scoring-complete",
            "checkpoints": len(result["checkpoints"]),
            "F6_rows": len(result["tables"]["F6_ablation"]),
            "F7_rows": len(result["tables"]["F7_training_trajectory"]),
            "F8_rows": len(result["tables"]["F8_recovered_fraction"]),
            "primary_interpretation": result["primary_contrast_interpretation"],
        }, sort_keys=True), flush=True)
        return 0
    except ScorerContractError as error:
        print(f"SCORER_CONTRACT_ERROR: {error}", file=sys.stderr, flush=True)
        return 2
    finally:
        print(f"PEAK_RSS_BYTES={_peak_rss_bytes()}", flush=True)


if __name__ == "__main__":
    raise SystemExit(main())

