#!/usr/bin/env python3
"""Exact additive-versus-set-residual catalogue toggle on eight V0.25 anchors.

DIAGNOSTIC_NOT_CLAIM.  No learner, training, or policy is imported or run.
Candidate generation is outcome-blind.  Both selectors see the same complete
48-boundary realised profiles and differ only by inclusion of the exact set
residual left after the sealed per-user singleton terms.
"""

from __future__ import annotations

import argparse
from collections import Counter, defaultdict
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import inspect
import itertools
import json
import math
import multiprocessing as mp
import os
from pathlib import Path
import platform
import statistics
import subprocess
import sys
import time
from typing import Mapping, Sequence

import numpy as np


ROOT = Path(__file__).resolve().parents[1]
REFERENCE = Path("/home/sat/mcrl-v025-ladder-ws")
REFERENCE_SRC = REFERENCE / "src"
PROBE_PATH = REFERENCE / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
MARGIN_PATH = ROOT / ".scratch/prefix-ablation-20260910/cleared_margin_batch.py"
SCHEMA = "mcrl-v025-oracle-residual-toggle-v1"
CLAIM = "DIAGNOSTIC_NOT_CLAIM"
WORLD_COUNT = 2
ANCHORS_PER_WORLD = 4
BOUNDARIES = tuple(range(48))
CONTRACT_RATE_BPS = 50_000_000.0
INTERVAL_S = 47 * 0.640
SHARED_BUNDLE_CAP = 1_024
EVACUATION_CAP = 1_024
CONTROL_EXPANSION_SEEDS = 512
CANDIDATE_CAP = 8_192
MAX_DINKELBACH = 128
SELECTORS = ("ADDITIVE_ONLY", "WITH_RESIDUAL")
NUMERATORS = ("capacity", "demand_capped")

sys.path.insert(0, str(REFERENCE_SRC))


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


probe = load_module("oracle_residual_toggle_probe", PROBE_PATH)
margin = load_module("oracle_residual_toggle_margin", MARGIN_PATH)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(
        value, sort_keys=True, separators=(",", ":"), allow_nan=False,
    ).encode("ascii")).hexdigest()


def exact(value: float) -> Fraction:
    value = float(value)
    if not math.isfinite(value):
        raise RuntimeError("non-finite physical value")
    return Fraction.from_float(value)


def _controlled_margin_evaluator():
    """Compile the hash-pinned corrected evaluator with one control input.

    The only numerical change is selection of an adjacent existing ACM target
    mode for specified users.  Thresholds, q10 provisioning, solver, caps,
    decoding, energy, and integration remain byte-for-byte source expressions.
    """

    source = inspect.getsource(margin._evaluate_ar_tdm_catalogue_core)
    replacements = (
        (
            "    fading_quantile_alpha: float | None = None,\n) -> BatchARResult:",
            "    fading_quantile_alpha: float | None = None,\n"
            "    mode_offsets: np.ndarray | None = None,\n"
            "    capture_controls: bool = False,\n"
            ") -> BatchARResult:",
        ),
        (
            "    configurations, users = rows_all.shape\n",
            "    configurations, users = rows_all.shape\n"
            "    if mode_offsets is None:\n"
            "        offsets_all = np.zeros((configurations, users), dtype=np.int8)\n"
            "    else:\n"
            "        offsets_all = np.asarray(mode_offsets, dtype=np.int8)\n"
            "        if offsets_all.shape != (configurations, users):\n"
            "            raise MCRLContractError('mode_offsets must match selected_rows')\n"
            "        if np.any((offsets_all < -1) | (offsets_all > 1)):\n"
            "            raise MCRLContractError('mode offsets must be -1, 0, or +1')\n"
            "    power_control_trace = (np.zeros((configurations, 48, users), dtype=np.float64) if capture_controls else None)\n"
            "    target_mode_trace = (np.full((configurations, 48, users), -1, dtype=np.int16) if capture_controls else None)\n"
            "    transmitted_mode_trace = (np.full((configurations, 48, users), -1, dtype=np.int16) if capture_controls else None)\n",
        ),
        (
            "    rows_all = rows_all[order]\n",
            "    rows_all = rows_all[order]\n    offsets_all = offsets_all[order]\n",
        ),
        (
            "        count = high - low\n",
            "        count = high - low\n        control_offsets = offsets_all[low:high]\n",
        ),
        (
            "                targets = gamma[np.minimum(occupancy, users)] / quantile\n"
            "                forced = active & np.isnan(targets)\n"
            "                targets = np.nan_to_num(targets, nan=1.0)\n",
            "                baseline_target_modes = target_mode_index[np.minimum(occupancy, users)]\n"
            "                desired_target_modes = baseline_target_modes.copy()\n"
            "                down = control_offsets < 0\n"
            "                up = control_offsets > 0\n"
            "                down_origin = np.where(baseline_target_modes == 0, len(modes) + 1, baseline_target_modes)\n"
            "                desired_target_modes = np.where(down, np.maximum(1, down_origin - 1), desired_target_modes)\n"
            "                desired_target_modes = np.where(\n"
            "                    up & (baseline_target_modes > 0),\n"
            "                    np.minimum(len(modes), baseline_target_modes + 1),\n"
            "                    desired_target_modes,\n"
            "                )\n"
            "                raw_targets = np.where(\n"
            "                    desired_target_modes > 0,\n"
            "                    np.maximum(thresholds[np.maximum(desired_target_modes - 1, 0)], SINR_MIN),\n"
            "                    np.nan,\n"
            "                )\n"
            "                targets = raw_targets / quantile\n"
            "                forced = active & np.isnan(targets)\n"
            "                targets = np.nan_to_num(targets, nan=1.0)\n",
        ),
        (
            "                occupancy_targets = target_mode_index[np.minimum(occupancy, users)]\n"
            "                target_threshold = thresholds[np.maximum(occupancy_targets - 1, 0)]\n",
            "                occupancy_targets = desired_target_modes\n"
            "                target_threshold = thresholds[np.maximum(occupancy_targets - 1, 0)]\n",
        ),
        (
            "                has_tx_mode = np.any(eligible_tx_modes, axis=2)\n",
            "                has_tx_mode = np.any(eligible_tx_modes, axis=2)\n"
            "                if capture_controls:\n"
            "                    power_control_trace[low:high, boundary, :] = np.maximum(\n"
            "                        power_control_trace[low:high, boundary, :], np.where(active, power, 0.0)\n"
            "                    )\n"
            "                    target_mode_trace[low:high, boundary, :] = np.where(\n"
            "                        active, desired_target_modes, target_mode_trace[low:high, boundary, :]\n"
            "                    )\n"
            "                    transmitted_mode_trace[low:high, boundary, :] = np.where(\n"
            "                        active, np.where(has_tx_mode, mode_index + 1, 0), transmitted_mode_trace[low:high, boundary, :]\n"
            "                    )\n",
        ),
        (
            "    return BatchARResult(\n",
            "    global LAST_CONTROL_TRACE\n"
            "    LAST_CONTROL_TRACE = None if not capture_controls else {\n"
            "        'rf_power_w': power_control_trace[inverse_order],\n"
            "        'target_mode_index_1based': target_mode_trace[inverse_order],\n"
            "        'transmitted_mode_index_1based': transmitted_mode_trace[inverse_order],\n"
            "    }\n"
            "    return BatchARResult(\n",
        ),
    )
    for old, new in replacements:
        if source.count(old) != 1:
            raise RuntimeError(f"controlled evaluator seam count drifted: {old[:60]!r}")
        source = source.replace(old, new)
    namespace = dict(vars(margin))
    from mcrl.physics_v025.constants_v025 import SINR_MIN
    namespace["SINR_MIN"] = SINR_MIN
    namespace["LAST_CONTROL_TRACE"] = None
    exec(compile(source, str(Path(__file__).resolve()), "exec"), namespace)
    return namespace


CONTROLLED = _controlled_margin_evaluator()
evaluate_controlled = CONTROLLED["_evaluate_ar_tdm_catalogue_core"]


@dataclass(frozen=True)
class Candidate:
    config: object
    offsets: tuple[int, ...]
    candidate_id: str
    families: tuple[str, ...]


def candidate_id(config, offsets: Sequence[int]) -> str:
    sparse = ";".join(f"{i}:{int(v):+d}" for i, v in enumerate(offsets) if v)
    return f"{config.configuration_id}|CTRL:{sparse or 'BASE'}"


def changed_users(base, candidate: Candidate, users: Sequence[int]) -> tuple[int, ...]:
    mapping = candidate.config.mapping
    return tuple(
        user for column, user in enumerate(users)
        if mapping[user] != base.mapping[user] or candidate.offsets[column] != 0
    )


def build_catalogue(tape, step_index: int, base) -> tuple[tuple[Candidate, ...], dict[str, object]]:
    """Outcome-blind direct catalogue; no exact-search prefix or ranking."""

    users = tuple(sorted(base.mapping))
    column = {user: i for i, user in enumerate(users)}
    options, _ = probe._legal_options(tape, step_index)
    records: dict[tuple[tuple, tuple[int, ...]], dict[str, object]] = {}

    def add(mapping, offsets, family: str) -> None:
        config = probe._configuration(base, dict(mapping), kind=f"residual-toggle-{family}")
        offsets_tuple = tuple(int(v) for v in offsets)
        key = (config.assignments, offsets_tuple)
        if key not in records:
            records[key] = {"config": config, "offsets": offsets_tuple, "families": []}
        records[key]["families"].append(family)  # type: ignore[index]

    zero = (0,) * len(users)
    add(base.mapping, zero, "incumbent")

    # All legal association singletons, with no shortlist.
    # All legal association singletons, with no shortlist.
    association_singletons = 0
    for user in users:
        for identity in options[user]:
            if identity == base.mapping[user]:
                continue
            mapping = base.mapping
            mapping[user] = identity
            add(mapping, zero, "legal-association-singleton")
            association_singletons += 1

    # Atomic controls make every joint control exactly decomposable per user.
    for user in users:
        for offset in (-1, 1):
            values = list(zero)
            values[column[user]] = offset
            add(base.mapping, values, "mode-control-singleton")

    by_beam = {
        beam: tuple(user for user in users if base.mapping[user] == beam)
        for beam in sorted({identity for identity in base.mapping.values() if identity is not None})
    }

    # Same-origin-beam subsets, canonical beam/size/subset/destination order.
    bundle_attempts = 0
    for beam, occupants in by_beam.items():
        common_by_subset = None
        for size in range(2, min(4, len(occupants)) + 1):
            for subset in itertools.combinations(occupants, size):
                common_by_subset = set(options[subset[0]])
                for user in subset[1:]:
                    common_by_subset.intersection_update(options[user])
                common_by_subset.discard(beam)
                for destination in sorted(common_by_subset):
                    if bundle_attempts >= SHARED_BUNDLE_CAP:
                        break
                    mapping = base.mapping
                    for user in subset:
                        mapping[user] = destination
                    add(mapping, zero, "shared-beam-bundle")
                    bundle_attempts += 1
                if bundle_attempts >= SHARED_BUNDLE_CAP:
                    break
            if bundle_attempts >= SHARED_BUNDLE_CAP:
                break
        if bundle_attempts >= SHARED_BUNDLE_CAP:
            break

    evacuation_attempts = 0
    for beam, occupants in by_beam.items():
        if not occupants:
            continue
        common = set(options[occupants[0]])
        for user in occupants[1:]:
            common.intersection_update(options[user])
        common.discard(beam)
        for destination in sorted(common):
            if evacuation_attempts >= EVACUATION_CAP:
                break
            mapping = base.mapping
            for user in occupants:
                mapping[user] = destination
            add(mapping, zero, "complete-beam-evacuation")
            evacuation_attempts += 1
        if evacuation_attempts >= EVACUATION_CAP:
            break

    # Beam-wide controls cover shared activation/occupancy without reassignment.
    for _beam, occupants in by_beam.items():
        for offset in (-1, 1):
            values = list(zero)
            for user in occupants:
                values[column[user]] = offset
            add(base.mapping, values, "beam-wide-mode-power-control")

    # Fixed canonical expansion, declared before outcomes: adjacent mode rung
    # for every changed member of the first 512 joint assignment profiles.
    joint_keys = sorted(
        (key for key in records if sum(a != b for a, b in zip(key[0], base.assignments, strict=True)) >= 2),
        key=lambda key: (str(key[0]), key[1]),
    )[:CONTROL_EXPANSION_SEEDS]
    for assignments, _prior_offsets in joint_keys:
        mapping = dict(assignments)
        moved = tuple(user for user in users if mapping[user] != base.mapping[user])
        for offset in (-1, 1):
            values = list(zero)
            for user in moved:
                values[column[user]] = offset
            add(mapping, values, "joint-adjacent-mode-power-control")

    ordered_records = sorted(
        records.values(),
        key=lambda row: candidate_id(row["config"], row["offsets"]),  # type: ignore[arg-type]
    )
    # Incumbent is explicitly first and wins exact ties.
    incumbent_index = next(
        i for i, row in enumerate(ordered_records)
        if row["config"].assignments == base.assignments and not any(row["offsets"])
    )
    incumbent = ordered_records.pop(incumbent_index)
    ordered_records.insert(0, incumbent)
    candidates = tuple(Candidate(
        row["config"], tuple(row["offsets"]),
        candidate_id(row["config"], row["offsets"]),
        tuple(sorted(set(row["families"]))),
    ) for row in ordered_records)
    if len(candidates) > CANDIDATE_CAP:
        raise RuntimeError(f"catalogue exceeded fixed cap: {len(candidates)} > {CANDIDATE_CAP}")
    if association_singletons != 2700:
        raise RuntimeError(f"expected 2,700 legal association singletons, got {association_singletons}")
    family_unique = Counter(family for candidate in candidates for family in candidate.families)
    return candidates, {
        "candidate_count": len(candidates),
        "hard_cap": CANDIDATE_CAP,
        "all_legal_association_singletons": association_singletons,
        "mode_control_singletons": 2 * len(users),
        "shared_bundle_generation_cap": SHARED_BUNDLE_CAP,
        "shared_bundle_attempts": bundle_attempts,
        "complete_evacuation_generation_cap": EVACUATION_CAP,
        "complete_evacuation_attempts": evacuation_attempts,
        "joint_control_expansion_seed_cap": CONTROL_EXPANSION_SEEDS,
        "joint_control_expansion_seeds": len(joint_keys),
        "family_unique_membership": dict(sorted(family_unique.items())),
    }


def evaluate_candidates(tape, step_index: int, candidates: Sequence[Candidate], *, capture=False):
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        raise RuntimeError("real anchor lacks primitive arrays")
    row_of = arrays._row_index()
    users = tuple(int(value) for value in arrays.users)
    rows = np.full((len(candidates), len(users)), -1, dtype=np.int64)
    offsets = np.asarray([candidate.offsets for candidate in candidates], dtype=np.int8)
    for i, candidate in enumerate(candidates):
        for j, user in enumerate(users):
            identity = candidate.config.mapping[user]
            if identity is not None:
                rows[i, j] = row_of.get((user, identity), -1)
    result = evaluate_controlled(
        arrays, rows, field="realised", chunk_size=16,
        rate_target_bps=CONTRACT_RATE_BPS,
        circuit_power_per_active_chain_w=probe.run_setting_for("a-r0").circuit_power_per_active_chain_w,
        boundary_indices=BOUNDARIES, fading_quantile_alpha=0.10,
        mode_offsets=offsets, capture_controls=capture,
    )
    return users, result, CONTROLLED["LAST_CONTROL_TRACE"]


def profile_rows(base, users: Sequence[int], candidates: Sequence[Candidate], result) -> tuple[list[dict], dict]:
    target_bits = exact(CONTRACT_RATE_BPS * INTERVAL_S)
    base_index = 0
    base_capacity = sum((exact(v) for v in result.bits[base_index]), Fraction())
    base_capped = sum((min(exact(v), target_bits) for v in result.bits[base_index]), Fraction())
    base_energy = exact(result.joules[base_index])
    atomic: dict[tuple[int, object, int], int] = {}
    for index, candidate in enumerate(candidates):
        changed = changed_users(base, candidate, users)
        if len(changed) == 1:
            user = changed[0]
            col = users.index(user)
            atomic[(user, candidate.config.mapping[user], candidate.offsets[col])] = index
    rows = []
    for index, candidate in enumerate(candidates):
        capacity = sum((exact(v) for v in result.bits[index]), Fraction())
        capped = sum((min(exact(v), target_bits) for v in result.bits[index]), Fraction())
        energy = exact(result.joules[index])
        changed = changed_users(base, candidate, users)
        additive_capacity = base_capacity
        additive_capped = base_capped
        additive_energy = base_energy
        valid_atomic = True
        for user in changed:
            col = users.index(user)
            key = (user, candidate.config.mapping[user], candidate.offsets[col])
            atomic_index = atomic.get(key)
            if atomic_index is None or not bool(result.valid[atomic_index]):
                valid_atomic = False
                break
            atomic_capacity = sum((exact(v) for v in result.bits[atomic_index]), Fraction())
            atomic_capped = sum((min(exact(v), target_bits) for v in result.bits[atomic_index]), Fraction())
            atomic_energy = exact(result.joules[atomic_index])
            additive_capacity += atomic_capacity - base_capacity
            additive_capped += atomic_capped - base_capped
            additive_energy += atomic_energy - base_energy
        rows.append({
            "index": index,
            "candidate_id": candidate.candidate_id,
            "changed_users": changed,
            "size": len(changed),
            "valid": bool(result.valid[index]) and valid_atomic,
            "served_count": int(np.count_nonzero(result.decoding_time_s[index] > 0.0)),
            "rate_target_attained_count": int(np.count_nonzero(result.bits[index] >= float(target_bits))),
            "capacity": capacity,
            "demand_capped": capped,
            "energy": energy,
            "additive_capacity": additive_capacity,
            "additive_demand_capped": additive_capped,
            "additive_energy": additive_energy,
        })
    base_summary = {
        "served_count": rows[0]["served_count"],
        "capacity": base_capacity,
        "demand_capped": base_capped,
        "energy": base_energy,
    }
    eligible = [row for row in rows if row["valid"] and row["served_count"] >= rows[0]["served_count"]]
    if not eligible or eligible[0]["index"] != 0:
        raise RuntimeError("incumbent is not an eligible fallback")
    return rows, base_summary


def _fraction_pair(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def anchor_task(task: tuple[int, int]) -> dict:
    world_index, step_index = task
    from mcrl.physics_v025.provider_legacy import factory

    started = time.perf_counter()
    domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
    tape = probe.build_world_tape(
        domain=domain, provider=factory(), steps=ANCHORS_PER_WORLD, start_time_s=0.0,
    )
    base = probe._base_configuration(tape, step_index, "nearest-eligible")
    candidates, census = build_catalogue(tape, step_index, base)
    users, result, _trace = evaluate_candidates(tape, step_index, candidates)
    rows, base_summary = profile_rows(base, users, candidates, result)
    if not all(candidate.offsets.__len__() == len(users) for candidate in candidates):
        raise RuntimeError("control vector width drifted")
    compact = []
    for row in rows:
        compact.append({
            **{key: row[key] for key in ("index", "candidate_id", "changed_users", "size", "valid", "served_count", "rate_target_attained_count")},
            **{key: _fraction_pair(row[key]) for key in (
                "capacity", "demand_capped", "energy", "additive_capacity",
                "additive_demand_capped", "additive_energy",
            )},
        })
    return {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "step_index": step_index,
        "world_domain": domain,
        "world_sha256": tape.digest,
        "users": list(users),
        "base_configuration_id": base.configuration_id,
        "base_assignments": list(base.assignments),
        "catalogue": census,
        "candidate_definitions": [{
            "candidate_id": candidate.candidate_id,
            "configuration_id": candidate.config.configuration_id,
            "assignments": list(candidate.config.assignments),
            "mode_offsets_by_user": [[user, candidate.offsets[i]] for i, user in enumerate(users) if candidate.offsets[i]],
            "families": list(candidate.families),
        } for candidate in candidates],
        "profiles": compact,
        "base_guard_served_count": base_summary["served_count"],
        "evaluation": {
            "valid_candidates": int(np.count_nonzero(result.valid)),
            "max_rf_power_w_over_catalogue": float(np.max(result.max_rf_power_w)),
            "wall_seconds": time.perf_counter() - started,
        },
    }


def unpair(pair: Sequence[int]) -> Fraction:
    return Fraction(int(pair[0]), int(pair[1]))


def optimize(anchors: Sequence[Mapping[str, object]], numerator: str, selector: str) -> dict:
    if numerator not in NUMERATORS or selector not in SELECTORS:
        raise RuntimeError("unknown optimization arm")
    eta = sum((unpair(a["profiles"][0][numerator]) for a in anchors), Fraction()) / sum(  # type: ignore[index]
        (unpair(a["profiles"][0]["energy"]) for a in anchors), Fraction()  # type: ignore[index]
    )
    trace = []
    previous = None
    for iteration in range(1, MAX_DINKELBACH + 1):
        selected = []
        selected = []
        for anchor in anchors:
            eligible = [row for row in anchor["profiles"] if  # type: ignore[index]
                        bool(row["valid"]) and int(row["served_count"]) >= int(anchor["base_guard_served_count"])]
            nkey = numerator if selector == "WITH_RESIDUAL" else f"additive_{numerator}"
            ekey = "energy" if selector == "WITH_RESIDUAL" else "additive_energy"
            scored = [(unpair(row[nkey]) - eta * unpair(row[ekey]), row) for row in eligible]
            best_score = max(score for score, _row in scored)
            tied = [row for score, row in scored if score == best_score]
            incumbent = next((row for row in tied if int(row["index"]) == 0), None)
            selected.append(incumbent if incumbent is not None else min(tied, key=lambda row: str(row["candidate_id"])))
        nkey = numerator if selector == "WITH_RESIDUAL" else f"additive_{numerator}"
        ekey = "energy" if selector == "WITH_RESIDUAL" else "additive_energy"
        pseudo_n = sum((unpair(row[nkey]) for row in selected), Fraction())
        pseudo_e = sum((unpair(row[ekey]) for row in selected), Fraction())
        if pseudo_e <= 0:
            raise RuntimeError("Dinkelbach pseudo-energy is not positive")
        new_eta = pseudo_n / pseudo_e
        ids = tuple(str(row["candidate_id"]) for row in selected)
        residual = pseudo_n - eta * pseudo_e
        trace.append({
            "iteration": iteration,
            "eta": _fraction_pair(eta),
            "selected_candidate_ids": list(ids),
            "surplus_residual": _fraction_pair(residual),
        })
        if new_eta == eta:
            break
        if ids == previous:
            raise RuntimeError("selection fixed without exact Dinkelbach price equality")
        previous = ids
        eta = new_eta
    else:
        raise RuntimeError("Dinkelbach iteration cap reached")
    actual_n = sum((unpair(row[numerator]) for row in selected), Fraction())
    actual_e = sum((unpair(row["energy"]) for row in selected), Fraction())
    return {
        "selector": selector,
        "numerator": numerator,
        "iterations": len(trace),
        "optimization_ratio": _fraction_pair(eta),
        "selected_indices": [int(row["index"]) for row in selected],
        "selected_candidate_ids": [str(row["candidate_id"]) for row in selected],
        "actual_numerator": _fraction_pair(actual_n),
        "actual_energy": _fraction_pair(actual_e),
        "actual_ee_bit_per_j": float(actual_n / actual_e),
        "trace": trace,
    }


def selected_detail(anchor: Mapping[str, object], index: int, numerator: str) -> dict:
    row = anchor["profiles"][index]  # type: ignore[index]
    definition = anchor["candidate_definitions"][index]  # type: ignore[index]
    n = unpair(row[numerator])
    energy = unpair(row["energy"])
    additive_n = unpair(row[f"additive_{numerator}"])
    additive_e = unpair(row["additive_energy"])
    eta = n / energy
    residual_at_own_eta = (n - eta * energy) - (additive_n - eta * additive_e)
    return {
        "candidate_id": row["candidate_id"],
        "configuration_id": definition["configuration_id"],
        "changed_users": row["changed_users"],
        "candidate_size": row["size"],
        "families": definition["families"],
        "assignments": definition["assignments"],
        "mode_offsets_by_user": definition["mode_offsets_by_user"],
        "numerator_bits": float(n),
        "energy_j": float(energy),
        "ee_bit_per_j": float(eta),
        "served_count": row["served_count"],
        "rate_target_attained_count": row["rate_target_attained_count"],
        "exact_set_residual_at_candidate_ratio": _fraction_pair(residual_at_own_eta),
    }


def add_selection_results(anchors: list[dict], optimizations: dict) -> dict:
    summary = {}
    for numerator in NUMERATORS:
        additive = optimizations[f"{numerator}:ADDITIVE_ONLY"]
        residual = optimizations[f"{numerator}:WITH_RESIDUAL"]
        per_anchor = []
        for i, anchor in enumerate(anchors):
            ai, ri = additive["selected_indices"][i], residual["selected_indices"][i]
            a = selected_detail(anchor, ai, numerator)
            r = selected_detail(anchor, ri, numerator)
            per_anchor.append({
                "anchor_id": anchor["anchor_id"],
                "different_configuration": a["candidate_id"] != r["candidate_id"],
                "gain_relative": r["ee_bit_per_j"] / a["ee_bit_per_j"] - 1.0,
                "ADDITIVE_ONLY": a,
                "WITH_RESIDUAL": r,
            })
        ae = float(additive["actual_ee_bit_per_j"])
        re = float(residual["actual_ee_bit_per_j"])
        summary[numerator] = {
            "pooled_gain_relative": re / ae - 1.0,
            "pooled_gain_percentage_points": 100.0 * (re / ae - 1.0),
            "screen_pass_10_percent": re / ae - 1.0 >= 0.10,
            "different_selections": sum(row["different_configuration"] for row in per_anchor),
            "anchor_count": len(per_anchor),
            "per_anchor": per_anchor,
        }
        for selector, opt in (("ADDITIVE_ONLY", additive), ("WITH_RESIDUAL", residual)):
            details = [row[selector] for row in per_anchor]
            numerator_total = sum(float(row["numerator_bits"]) for row in details)
            energy_total = sum(float(row["energy_j"]) for row in details)
            summary[numerator][selector] = {
                "numerator_bits": numerator_total,
                "energy_j": energy_total,
                "pooled_ee_bit_per_j": numerator_total / energy_total,
                "served_count": sum(int(row["served_count"]) for row in details),
                "rate_target_attained_count": sum(int(row["rate_target_attained_count"]) for row in details),
                "candidate_size_distribution": dict(sorted(Counter(str(row["candidate_size"]) for row in details).items())),
            }
    return summary


def attach_selected_records(anchors: list[dict], optimizations: Mapping[str, object]) -> dict:
    selected_keys = sorted({
        (numerator, selector, anchor_index, int(optimizations[f"{numerator}:{selector}"]["selected_indices"][anchor_index]))  # type: ignore[index]
        for numerator in NUMERATORS for selector in SELECTORS for anchor_index in range(len(anchors))
    })
    records = []
    mode_names = ("NO_MODE",) + tuple(row.name for row in probe.ACM_MODES)
    for anchor_index, anchor in enumerate(anchors):
        indices = sorted({index for _n, _s, ai, index in selected_keys if ai == anchor_index})
        if not indices:
            continue
        from mcrl.physics_v025.provider_legacy import factory
        tape = probe.build_world_tape(
            domain=str(anchor["world_domain"]), provider=factory(),
            steps=ANCHORS_PER_WORLD, start_time_s=0.0,
        )
        candidates_all = []
        base = probe._base_configuration(tape, int(anchor["step_index"]), "nearest-eligible")
        for index in indices:
            definition = anchor["candidate_definitions"][index]
            mapping = {int(user): None if identity is None else (int(identity[0]), int(identity[1]))
                       for user, identity in definition["assignments"]}
            config = probe._configuration(base, mapping, kind="residual-toggle-custody")
            offsets_by_user = {int(user): int(value) for user, value in definition["mode_offsets_by_user"]}
            users = tuple(int(v) for v in anchor["users"])
            offsets = tuple(offsets_by_user.get(user, 0) for user in users)
            candidates_all.append(Candidate(config, offsets, str(definition["candidate_id"]), tuple(definition["families"])))
        users, result, trace = evaluate_candidates(tape, int(anchor["step_index"]), candidates_all, capture=True)
        if trace is None:
            raise RuntimeError("selected control trace was not captured")
        target_bits = CONTRACT_RATE_BPS * INTERVAL_S
        for local, original_index in enumerate(indices):
            definition = anchor["candidate_definitions"][original_index]
            deliveries = [{
                "user": user,
                "assignment": next(identity for uid, identity in definition["assignments"] if int(uid) == user),
                "mode_offset": dict((int(u), int(v)) for u, v in definition["mode_offsets_by_user"]).get(user, 0),
                "delivered_bits": float(result.bits[local, col]),
                "demand_capped_bits": min(float(result.bits[local, col]), target_bits),
                "decoding_time_s": float(result.decoding_time_s[local, col]),
                "served": bool(result.decoding_time_s[local, col] > 0.0),
                "rate_target_attained": bool(result.bits[local, col] >= target_bits),
                "rate_target_feasible_all_boundaries": bool(result.feasible[local, col]),
            } for col, user in enumerate(users)]
            controls = [{
                "boundary": boundary,
                "users": [{
                    "user": user,
                    "rf_power_w": float(trace["rf_power_w"][local, boundary, col]),
                    "target_mode": (
                        "INACTIVE" if int(trace["target_mode_index_1based"][local, boundary, col]) < 0
                        else mode_names[int(trace["target_mode_index_1based"][local, boundary, col])]
                    ),
                    "transmitted_mode": (
                        "INACTIVE" if int(trace["transmitted_mode_index_1based"][local, boundary, col]) < 0
                        else mode_names[int(trace["transmitted_mode_index_1based"][local, boundary, col])]
                    ),
                } for col, user in enumerate(users)]
            } for boundary in BOUNDARIES]
            record = {
                "anchor_id": anchor["anchor_id"],
                "candidate_index": original_index,
                "candidate_id": definition["candidate_id"],
                "configuration_id": definition["configuration_id"],
                "assignments": definition["assignments"],
                "mode_offsets_by_user": definition["mode_offsets_by_user"],
                "power_and_mode_controls": controls,
                "per_user_delivery": deliveries,
                "totals": {
                    "capacity_bits": float(np.sum(result.bits[local])),
                    "demand_capped_bits": math.fsum(row["demand_capped_bits"] for row in deliveries),
                    "energy_j": float(result.joules[local]),
                    "served_count": sum(row["served"] for row in deliveries),
                    "rate_target_attained_count": sum(row["rate_target_attained"] for row in deliveries),
                },
            }
            record["record_sha256"] = canonical_sha256(record)
            records.append(record)
    return {
        "records": records,
        "records_sha256": canonical_sha256(records),
        "record_count": len(records),
    }


def fmt_pct(value: float) -> str:
    return f"{100.0 * value:+.2f}%"


def render_report(receipt: Mapping[str, object]) -> str:
    s = receipt["summary"]
    cap = s["capacity"]
    dem = s["demand_capped"]
    below = cap["pooled_gain_relative"] < 0.10 or dem["pooled_gain_relative"] < 0.10
    first = (
        f"**The pooled gain from enabling the exact set residual is {fmt_pct(cap['pooled_gain_relative'])} "
        f"for delivered capacity and {fmt_pct(dem['pooled_gain_relative'])} demand-capped; "
        f"{'below' if below else 'at or above'} the predeclared ten per cent screen.**"
    )
    lines = [first, "", "# Oracle residual toggle — 2026-09-10", "", "`DIAGNOSTIC_NOT_CLAIM`", "",
             "## Decisive result", ""]
    for numerator, label in (("capacity", "Delivered capacity"), ("demand_capped", "Demand-capped")):
        row = s[numerator]
        lines += [f"### {label}", "", "| selector | pooled EE (Mbit/J) | numerator (Gbit) | energy (J) | served | rate-target attained | selected-size counts |", "| --- | ---: | ---: | ---: | ---: | ---: | --- |"]
        for selector in SELECTORS:
            x = row[selector]
            lines.append(f"| `{selector}` | {x['pooled_ee_bit_per_j']/1e6:.6f} | {x['numerator_bits']/1e9:.6f} | {x['energy_j']:.6f} | {x['served_count']} | {x['rate_target_attained_count']} | `{x['candidate_size_distribution']}` |")
        lines += ["", f"Residual gain: **{fmt_pct(row['pooled_gain_relative'])}**; selectors differ on **{row['different_selections']}/{row['anchor_count']}** anchors; 10% screen: **{'PASS' if row['screen_pass_10_percent'] else 'BELOW'}**.", "",
                  "| anchor | additive EE | residual EE | gain | different | sizes A/R | served A/R | target A/R |", "| --- | ---: | ---: | ---: | :---: | ---: | ---: | ---: |"]
        for a in row["per_anchor"]:
            aa, rr = a["ADDITIVE_ONLY"], a["WITH_RESIDUAL"]
            lines.append(f"| {a['anchor_id']} | {aa['ee_bit_per_j']/1e6:.6f} | {rr['ee_bit_per_j']/1e6:.6f} | {fmt_pct(a['gain_relative'])} | {'yes' if a['different_configuration'] else 'no'} | {aa['candidate_size']}/{rr['candidate_size']} | {aa['served_count']}/{rr['served_count']} | {aa['rate_target_attained_count']}/{rr['rate_target_attained_count']} |")
        lines.append("")
    lines += [
        "## Fixed catalogue and selector rules", "",
        "The rules were fixed before evaluating outcomes. Each anchor catalogue is built directly around the nearest-eligible incumbent; no exact-search, local-search, or learned prefix is run.", "",
        "- incumbent;",
