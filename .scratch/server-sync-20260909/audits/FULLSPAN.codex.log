def evaluate_candidates(tape, step_index: int, candidates: Sequence[Candidate], *, capture=False):
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        raise RuntimeError("real anchor lacks primitive arrays")
    row_of = arrays._row_index()
    users = tuple(int(value) for value in arrays.users)
    rows = np.full((len(candidates), len(users)), -1, dtype=np.int64)
    offsets = np.asarray([candidate.offsets for candidate in candidates], dtype=np.int8)
    for i, candidate in enumerate(candidates):
        for j, user in enumerate(users):
            identity = candidate.config.mapping[user]
            if identity is not None:
                rows[i, j] = row_of.get((user, identity), -1)
    result = evaluate_controlled(
        arrays, rows, field="realised", chunk_size=16,
        rate_target_bps=CONTRACT_RATE_BPS,
        circuit_power_per_active_chain_w=probe.run_setting_for("a-r0").circuit_power_per_active_chain_w,
        boundary_indices=BOUNDARIES, fading_quantile_alpha=0.10,
        mode_offsets=offsets, capture_controls=capture,
    )
    return users, result, CONTROLLED["LAST_CONTROL_TRACE"]


def profile_rows(base, users: Sequence[int], candidates: Sequence[Candidate], result) -> tuple[list[dict], dict]:
    target_bits = exact(CONTRACT_RATE_BPS * INTERVAL_S)
    base_index = 0
    base_capacity = sum((exact(v) for v in result.bits[base_index]), Fraction())
    base_capped = sum((min(exact(v), target_bits) for v in result.bits[base_index]), Fraction())
    base_energy = exact(result.joules[base_index])
    atomic: dict[tuple[int, object, int], int] = {}
    for index, candidate in enumerate(candidates):
        changed = changed_users(base, candidate, users)
        if len(changed) == 1:
            user = changed[0]
            col = users.index(user)
            atomic[(user, candidate.config.mapping[user], candidate.offsets[col])] = index
    rows = []
    for index, candidate in enumerate(candidates):
        capacity = sum((exact(v) for v in result.bits[index]), Fraction())
        capped = sum((min(exact(v), target_bits) for v in result.bits[index]), Fraction())
        energy = exact(result.joules[index])
        changed = changed_users(base, candidate, users)
        additive_capacity = base_capacity
        additive_capped = base_capped
        additive_energy = base_energy
        valid_atomic = True
        for user in changed:
            col = users.index(user)
            key = (user, candidate.config.mapping[user], candidate.offsets[col])
            atomic_index = atomic.get(key)
            if atomic_index is None or not bool(result.valid[atomic_index]):
                valid_atomic = False
                break
            atomic_capacity = sum((exact(v) for v in result.bits[atomic_index]), Fraction())
            atomic_capped = sum((min(exact(v), target_bits) for v in result.bits[atomic_index]), Fraction())
            atomic_energy = exact(result.joules[atomic_index])
            additive_capacity += atomic_capacity - base_capacity
            additive_capped += atomic_capped - base_capped
            additive_energy += atomic_energy - base_energy
        rows.append({
            "index": index,
            "candidate_id": candidate.candidate_id,
            "changed_users": changed,
            "size": len(changed),
            "valid": bool(result.valid[index]) and valid_atomic,
            "served_count": int(np.count_nonzero(result.decoding_time_s[index] > 0.0)),
            "rate_target_attained_count": int(np.count_nonzero(result.bits[index] >= float(target_bits))),
            "capacity": capacity,
            "demand_capped": capped,
            "energy": energy,
            "additive_capacity": additive_capacity,
            "additive_demand_capped": additive_capped,
            "additive_energy": additive_energy,
        })
    base_summary = {
        "served_count": rows[0]["served_count"],
        "capacity": base_capacity,
        "demand_capped": base_capped,
        "energy": base_energy,
    }
    eligible = [row for row in rows if row["valid"] and row["served_count"] >= rows[0]["served_count"]]
    if not eligible or eligible[0]["index"] != 0:
        raise RuntimeError("incumbent is not an eligible fallback")
    return rows, base_summary


def _fraction_pair(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def anchor_task(task: tuple[int, int]) -> dict:
    world_index, step_index = task
    from mcrl.physics_v025.provider_legacy import factory

    started = time.perf_counter()
    domain = probe.PROBE_WORLD_DOMAINS[world_index - 1]
    tape = probe.build_world_tape(
        domain=domain, provider=factory(), steps=ANCHORS_PER_WORLD, start_time_s=0.0,
    )
    base = probe._base_configuration(tape, step_index, "nearest-eligible")
    candidates, census = build_catalogue(tape, step_index, base)
    users, result, _trace = evaluate_candidates(tape, step_index, candidates)
    rows, base_summary = profile_rows(base, users, candidates, result)
    if not all(candidate.offsets.__len__() == len(users) for candidate in candidates):
        raise RuntimeError("control vector width drifted")
    compact = []
    for row in rows:
        compact.append({
            **{key: row[key] for key in ("index", "candidate_id", "changed_users", "size", "valid", "served_count", "rate_target_attained_count")},
            **{key: _fraction_pair(row[key]) for key in (
                "capacity", "demand_capped", "energy", "additive_capacity",
                "additive_demand_capped", "additive_energy",
            )},
        })
    return {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "step_index": step_index,
        "world_domain": domain,
        "world_sha256": tape.digest,
        "users": list(users),
        "base_configuration_id": base.configuration_id,
        "base_assignments": list(base.assignments),
        "catalogue": census,
        "candidate_definitions": [{
            "candidate_id": candidate.candidate_id,
            "configuration_id": candidate.config.configuration_id,
            "assignments": list(candidate.config.assignments),
            "mode_offsets_by_user": [[user, candidate.offsets[i]] for i, user in enumerate(users) if candidate.offsets[i]],
            "families": list(candidate.families),
        } for candidate in candidates],
        "profiles": compact,
        "base_guard_served_count": base_summary["served_count"],
        "evaluation": {
            "valid_candidates": int(np.count_nonzero(result.valid)),
            "max_rf_power_w_over_catalogue": float(np.max(result.max_rf_power_w)),
            "wall_seconds": time.perf_counter() - started,
        },
    }


def unpair(pair: Sequence[int]) -> Fraction:
    return Fraction(int(pair[0]), int(pair[1]))


def optimize(anchors: Sequence[Mapping[str, object]], numerator: str, selector: str) -> dict:
    if numerator not in NUMERATORS or selector not in SELECTORS:
        raise RuntimeError("unknown optimization arm")
    eta = sum((unpair(a["profiles"][0][numerator]) for a in anchors), Fraction()) / sum(  # type: ignore[index]
        (unpair(a["profiles"][0]["energy"]) for a in anchors), Fraction()  # type: ignore[index]
    )
    trace = []
    previous = None
    for iteration in range(1, MAX_DINKELBACH + 1):
        selected = []
        for anchor in anchors:
            eligible = [row for row in anchor["profiles"] if  # type: ignore[index]
                        bool(row["valid"]) and int(row["served_count"]) >= int(anchor["base_guard_served_count"])]
            nkey = numerator if selector == "WITH_RESIDUAL" else f"additive_{numerator}"
            ekey = "energy" if selector == "WITH_RESIDUAL" else "additive_energy"
            scored = [(unpair(row[nkey]) - eta * unpair(row[ekey]), row) for row in eligible]
            best_score = max(score for score, _row in scored)
            tied = [row for score, row in scored if score == best_score]
            incumbent = next((row for row in tied if int(row["index"]) == 0), None)
            selected.append(incumbent if incumbent is not None else min(tied, key=lambda row: str(row["candidate_id"])))
        nkey = numerator if selector == "WITH_RESIDUAL" else f"additive_{numerator}"
        ekey = "energy" if selector == "WITH_RESIDUAL" else "additive_energy"
        pseudo_n = sum((unpair(row[nkey]) for row in selected), Fraction())
        pseudo_e = sum((unpair(row[ekey]) for row in selected), Fraction())
        if pseudo_e <= 0:
            raise RuntimeError("Dinkelbach pseudo-energy is not positive")
        new_eta = pseudo_n / pseudo_e
        ids = tuple(str(row["candidate_id"]) for row in selected)
        residual = pseudo_n - eta * pseudo_e
        trace.append({
            "iteration": iteration,
            "eta": _fraction_pair(eta),
            "selected_candidate_ids": list(ids),
            "surplus_residual": _fraction_pair(residual),
        })
        if new_eta == eta:
            break
        if ids == previous:
            raise RuntimeError("selection fixed without exact Dinkelbach price equality")
        previous = ids
        eta = new_eta
    else:
        raise RuntimeError("Dinkelbach iteration cap reached")
    actual_n = sum((unpair(row[numerator]) for row in selected), Fraction())
    actual_e = sum((unpair(row["energy"]) for row in selected), Fraction())
    return {
        "selector": selector,
        "numerator": numerator,
        "iterations": len(trace),
        "optimization_ratio": _fraction_pair(eta),
        "selected_indices": [int(row["index"]) for row in selected],
        "selected_candidate_ids": [str(row["candidate_id"]) for row in selected],
        "actual_numerator": _fraction_pair(actual_n),
        "actual_energy": _fraction_pair(actual_e),
        "actual_ee_bit_per_j": float(actual_n / actual_e),
        "trace": trace,
    }


def selected_detail(anchor: Mapping[str, object], index: int, numerator: str) -> dict:
    row = anchor["profiles"][index]  # type: ignore[index]
    definition = anchor["candidate_definitions"][index]  # type: ignore[index]
    n = unpair(row[numerator])
    energy = unpair(row["energy"])
    additive_n = unpair(row[f"additive_{numerator}"])
    additive_e = unpair(row["additive_energy"])
    eta = n / energy
    residual_at_own_eta = (n - eta * energy) - (additive_n - eta * additive_e)
    return {
        "candidate_id": row["candidate_id"],
        "configuration_id": definition["configuration_id"],
        "changed_users": row["changed_users"],
        "candidate_size": row["size"],
        "families": definition["families"],
        "assignments": definition["assignments"],
        "mode_offsets_by_user": definition["mode_offsets_by_user"],
        "numerator_bits": float(n),
        "energy_j": float(energy),
        "ee_bit_per_j": float(eta),
        "served_count": row["served_count"],
        "rate_target_attained_count": row["rate_target_attained_count"],
        "exact_set_residual_at_candidate_ratio": _fraction_pair(residual_at_own_eta),
    }


def add_selection_results(anchors: list[dict], optimizations: dict) -> dict:
    summary = {}
    for numerator in NUMERATORS:
        additive = optimizations[f"{numerator}:ADDITIVE_ONLY"]
        residual = optimizations[f"{numerator}:WITH_RESIDUAL"]
        per_anchor = []
        for i, anchor in enumerate(anchors):
            ai, ri = additive["selected_indices"][i], residual["selected_indices"][i]
            a = selected_detail(anchor, ai, numerator)
            r = selected_detail(anchor, ri, numerator)
            per_anchor.append({
                "anchor_id": anchor["anchor_id"],
                "different_configuration": a["candidate_id"] != r["candidate_id"],
                "gain_relative": r["ee_bit_per_j"] / a["ee_bit_per_j"] - 1.0,
                "ADDITIVE_ONLY": a,

