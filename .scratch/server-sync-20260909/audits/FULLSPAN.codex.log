              "## Scope", "",
              "This is an exact-arithmetic selector toggle over a bounded, predeclared catalogue and a fixed physical evaluator. It changes no sealed constant, threshold, sign, seed, horizon, price, service guard, acceptance rule, or declared physics. Binary64 simulator outputs are lifted exactly to `Fraction` before decomposition, residual construction, tie comparison, and common-price optimization. The result is diagnostic opportunity evidence only.", ""]
    return "\n".join(lines)


def run(args) -> dict:
    if not 1 <= args.workers <= 2:
        raise RuntimeError("workers must be 1 or 2")
    started = time.perf_counter()
    tasks = [(world, step) for world in range(1, WORLD_COUNT + 1) for step in range(ANCHORS_PER_WORLD)]
    if args.workers == 1:
        anchors = []
        for task in tasks:
            row = anchor_task(task)
            anchors.append(row)
            print(json.dumps({"completed": row["anchor_id"], "catalogue": row["catalogue"]["candidate_count"], "seconds": row["evaluation"]["wall_seconds"]}), flush=True)
    else:
        if "fork" not in mp.get_all_start_methods():
            raise RuntimeError("two-worker run requires POSIX fork")
        with mp.get_context("fork").Pool(args.workers) as pool:
            anchors = []
            for row in pool.imap(anchor_task, tasks, chunksize=1):
                anchors.append(row)
                print(json.dumps({"completed": row["anchor_id"], "catalogue": row["catalogue"]["candidate_count"], "seconds": row["evaluation"]["wall_seconds"]}), flush=True)
    anchors.sort(key=lambda row: (row["world_index"], row["step_index"]))
    optimizations = {
        f"{numerator}:{selector}": optimize(anchors, numerator, selector)
        for numerator in NUMERATORS for selector in SELECTORS
    }
    summary = add_selection_results(anchors, optimizations)
    selected_records = attach_selected_records(anchors, optimizations)
    args.selected_records.parent.mkdir(parents=True, exist_ok=True)
    args.selected_records.write_text(json.dumps(selected_records, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
    receipt = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM,
        "planning_screen_relative": 0.10,
        "runner_sha256": sha256(Path(__file__).resolve()),
        "probe_source_sha256": sha256(PROBE_PATH),
        "margin_source_sha256": sha256(MARGIN_PATH),
        "workspace_commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
        "reference_commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=REFERENCE, text=True).strip(),
        "python": sys.executable,
        "python_version": platform.python_version(),
        "thread_environment": {name: os.environ.get(name) for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS")},
        "workers": args.workers,
        "learner_used": False,
        "training_run_used": False,
        "policy_run_used": False,
        "test_split_opened": False,
        "provisioning": "corrected Gamma_target/q_0.10(elevation) with strict target clearance",
        "horizon": "realised boundaries 0..47, trapezoidal 30.08 s endpoint",
        "contract_rate_bps": CONTRACT_RATE_BPS,
        "catalogue_generation": {
            "outcome_blind": True, "exact_search_prefix": False,
            "shared_bundle_cap": SHARED_BUNDLE_CAP,
            "evacuation_cap": EVACUATION_CAP,
            "joint_control_expansion_seeds": CONTROL_EXPANSION_SEEDS,
            "candidate_cap": CANDIDATE_CAP,
        },
        "anchors": anchors,
        "optimizations": optimizations,
        "summary": summary,
        "selected_records": {key: value for key, value in selected_records.items() if key != "records"},
        "selected_records_file": str(args.selected_records),
        "selected_records_file_sha256": sha256(args.selected_records),
        "wall_seconds": time.perf_counter() - started,
    }
    receipt["receipt_sha256"] = canonical_sha256(receipt)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(receipt, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
    receipt["output_file_sha256"] = sha256(args.output)
    args.report.write_text(render_report(receipt), encoding="utf-8")
    return receipt


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workers", type=int, default=2)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--selected-records", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    args = parser.parse_args()
    result = run(args)
    print(json.dumps(result["summary"], indent=2, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

