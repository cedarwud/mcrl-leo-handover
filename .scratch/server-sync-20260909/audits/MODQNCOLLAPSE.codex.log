        ("episodes_completed", EXPECTED_EPISODES),
        ("checkpoint_sha256", EXPECTED_CHECKPOINT_SHA256),
        ("role", "main-training"),
        ("resumed", False),
        ("resume_next_episode", EXPECTED_EPISODES),
    ):
        _require_exact_field(status, field, expected, label="status")

