@@ -0,0 +1,377 @@
+#!/usr/bin/env python3
+"""Concentration-only rollout of authenticated MODQN in its training environment."""
+
+from __future__ import annotations
+
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import resource
+import sys
+import time
+from typing import Callable
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-mqcollapse-ws")
+TRAINING_ROOT = Path("/home/sat/mcrl-leo-handover-20260825-corrected")
+TRAINING_SRC = TRAINING_ROOT / "src"
+ADAPTER_PATH = Path(
+    "/home/sat/mcrl-v025-retrain-ws/.scratch/"
+    "multi-catfish-v023-baseline-adapter/baseline_adapter.py"
+)
+CHECKPOINT_PATH = (
+    TRAINING_ROOT
+    / "artifacts"
+    / "training-2026-08-25-rerun01"
+    / "main"
+    / "final-checkpoint.pt"
+)
+STATUS_PATH = CHECKPOINT_PATH.with_name("status.json")
+PREREG_PATH = TRAINING_ROOT / "artifacts" / "PREREG-FROZEN-2026-08-25-R2.json"
+EXPECTED_CHECKPOINT_SHA256 = (
+    "e6b063efea8608fd1e46ac15d5442aa8d1171dffc9f0b5e8cc209eca1b09c28b"
+)
+EXPECTED_TRAINING_CODE_SHA256 = (
+    "544fcf078f7e0d74c38e79288081c60357bc64b59540120dbe4e30bffe014ec4"
+)
+EXPECTED_PREREG_SHA256 = (
+    "8bf13e289e18d663699a39c778dfe5af5b7538781c08b42bf5d085776cd44543"
+)
+THREAD_ENV = (
+    "OMP_NUM_THREADS",
+    "OPENBLAS_NUM_THREADS",
+    "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS",
+    "VECLIB_MAXIMUM_THREADS",
+    "BLIS_NUM_THREADS",
+)
+RSS_CAP_BYTES = 4_000_000_000
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def peak_rss_bytes() -> int:
+    # Linux ru_maxrss is KiB.
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def assert_resources() -> None:
+    for name in THREAD_ENV:
+        if os.environ.get(name) != "1":
+            raise RuntimeError(f"{name} must equal 1")
+    actual_nice = os.getpriority(os.PRIO_PROCESS, 0)
+    if actual_nice < 16:
+        raise RuntimeError(f"nice value {actual_nice} is below required 16")
+    # Keep virtual address space below the RSS ceiling as an additional hard stop.
+    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
+    requested = 3_900_000_000
+    effective = requested if hard == resource.RLIM_INFINITY else min(requested, hard)
+    resource.setrlimit(resource.RLIMIT_AS, (effective, hard))
+
+
+def assert_memory() -> None:
+    peak = peak_rss_bytes()
+    if peak >= RSS_CAP_BYTES:
+        raise MemoryError(f"peak RSS {peak} reached the {RSS_CAP_BYTES}-byte cap")
+
+
+def load_adapter_module():
+    spec = importlib.util.spec_from_file_location("authenticated_baseline_adapter", ADAPTER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not create baseline-adapter import spec")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def make_environment(users: int):
+    from mcrl.env.constants import TLE_ROOT_DEFAULT
+    from mcrl.env.ephemeris import TRAIN, BlockAlternatingSplit, EpisodeStartSampler
+    from mcrl.env.mobility import MobilityConfig
+    from mcrl.env.scenario import ScenarioConfig, ScenarioDriver
+    from mcrl.env.step import StepEnvironment
+    from mcrl.env.tle import TleArchive
+    from mcrl.runtime.trainer_env import TrainerEnvironment
+
+    archive = TleArchive(Path(TLE_ROOT_DEFAULT).expanduser())
+    driver = ScenarioDriver(
+        archive,
+        ScenarioConfig(mobility=MobilityConfig(num_users=users)),
+    )
+    split = BlockAlternatingSplit.for_archive(archive)
+    sampler = EpisodeStartSampler.for_archive(archive, split, TRAIN)
+    if sampler.part != TRAIN:
+        raise RuntimeError("sampler escaped the legacy TRAIN split")
+    return TrainerEnvironment(StepEnvironment(driver), sampler)
+
+
+def myopic_actions(states, masks):
+    import numpy as np
+    from mcrl.env.action_contract import NO_OP_ACTION
+
+    actions = np.full(len(states), NO_OP_ACTION, dtype=np.int64)
+    for uid, (state, action_mask) in enumerate(zip(states, masks, strict=True)):
+        mask = np.asarray(action_mask.mask, dtype=np.bool_)
+        if np.any(mask):
+            quality = np.asarray(state.channel_quality, dtype=np.float64)
+            actions[uid] = int(np.argmax(np.where(mask, quality, -np.inf)))
+    return actions
+
+
+def profile_metrics(observation, actions, users: int) -> dict[str, object]:
+    from mcrl.env.action_contract import NO_OP_ACTION
+
+    physical: list[tuple[int, int]] = []
+    action_slots: list[int] = []
+    for uid, raw_action in enumerate(actions):
+        action = int(raw_action)
+        if action == NO_OP_ACTION:
+            continue
+        association = observation.candidates.slot_tables[uid].association(action)
+        physical.append((int(association.norad_id), int(association.cell_id)))
+        action_slots.append(action)
+
+    physical_counts = Counter(physical)
+    slot_counts = Counter(action_slots)
+    satellites = {norad for norad, _cell in physical_counts}
+    return {
+        "modal_frac": (max(physical_counts.values(), default=0) / users),
+        "active_beams": len(physical_counts),
+        "active_satellites": len(satellites),
+        "argmax_distinct": len(slot_counts) / users,
+        "no_op_users": users - len(action_slots),
+        "physical_occupancies": sorted(physical_counts.values()),
+        "slot_occupancies": sorted(slot_counts.values()),
+    }
+
+
+def summarize(rows: list[dict[str, object]], steps: int) -> dict[str, object]:
+    import numpy as np
+
+    scalar_fields = (
+        "modal_frac",
+        "active_beams",
+        "active_satellites",
+        "argmax_distinct",
+        "no_op_users",
+    )
+
+    def summarize_group(group: list[dict[str, object]]) -> dict[str, object]:
+        result: dict[str, object] = {}
+        for field in scalar_fields:
+            values = np.asarray([row[field] for row in group], dtype=np.float64)
+            result[field] = {
+                "mean": float(np.mean(values)),
+                "min": float(np.min(values)),
+                "max": float(np.max(values)),
+            }
+        physical_hist: Counter[int] = Counter()
+        slot_hist: Counter[int] = Counter()
+        for row in group:
+            physical_hist.update(int(value) for value in row["physical_occupancies"])
+            slot_hist.update(int(value) for value in row["slot_occupancies"])
+        result["physical_occupancy_histogram"] = {
+            str(key): physical_hist[key] for key in sorted(physical_hist)
+        }
+        result["slot_occupancy_histogram"] = {
+            str(key): slot_hist[key] for key in sorted(slot_hist)
+        }
+        return result
+
+    return {
+        "pooled_profiles": summarize_group(rows),
+        "by_step": {
+            str(step): summarize_group(
+                [row for row in rows if int(row["step_index"]) == step]
+            )
+            for step in range(steps)
+        },
+    }
+
+
+def rollout(
+    *,
+    label: str,
+    seeds: tuple[int, ...],
+    users: int,
+    steps: int,
+    selector: Callable,
+) -> tuple[list[dict[str, object]], Counter[int]]:
+    import numpy as np
+
+    rows: list[dict[str, object]] = []
+    total_actions: Counter[int] = Counter()
+    for scenario_index, seed in enumerate(seeds, start=1):
+        environment = make_environment(users)
+        seed_children = np.random.SeedSequence(seed).spawn(2)
+        env_rng = np.random.default_rng(seed_children[0])
+        mobility_rng = np.random.default_rng(seed_children[1])
+        states, masks, observation = environment.reset(env_rng, mobility_rng)
+        for step_index in range(steps):
+            actions = selector(states, masks)
+            metric = profile_metrics(observation, actions, users)
+            metric.update(
+                {
+                    "scenario_index": scenario_index,
+                    "seed": seed,
+                    "step_index": step_index,
+                }
+            )
+            rows.append(metric)
+            total_actions.update(int(action) for action in actions if int(action) >= 0)
+            result = environment.step(actions, env_rng)
+            expected_done = step_index == steps - 1
+            if bool(result.done) != expected_done:
+                raise RuntimeError("legacy episode length drifted")
