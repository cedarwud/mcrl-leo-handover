+
+
+def myopic_actions(states, masks):
+    import numpy as np
+    from mcrl.env.action_contract import NO_OP_ACTION
+
+    actions = np.full(len(states), NO_OP_ACTION, dtype=np.int64)
+    for uid, (state, action_mask) in enumerate(zip(states, masks, strict=True)):
+        mask = np.asarray(action_mask.mask, dtype=np.bool_)
+        if np.any(mask):
+            quality = np.asarray(state.channel_quality, dtype=np.float64)
+            actions[uid] = int(np.argmax(np.where(mask, quality, -np.inf)))
+    return actions
+
+
+def profile_metrics(observation, actions, users: int) -> dict[str, object]:
+    from mcrl.env.action_contract import NO_OP_ACTION
+
+    physical: list[tuple[int, int]] = []
+    action_slots: list[int] = []
+    for uid, raw_action in enumerate(actions):
+        action = int(raw_action)
+        if action == NO_OP_ACTION:
+            continue
+        association = observation.candidates.slot_tables[uid].association(action)
+        physical.append((int(association.norad_id), int(association.cell_id)))
+        action_slots.append(action)
+
+    physical_counts = Counter(physical)
+    slot_counts = Counter(action_slots)
+    satellites = {norad for norad, _cell in physical_counts}
+    return {
+        "modal_frac": (max(physical_counts.values(), default=0) / users),
+        "active_beams": len(physical_counts),
+        "active_satellites": len(satellites),
+        "argmax_distinct": len(slot_counts) / users,
+        "no_op_users": users - len(action_slots),
+        "physical_occupancies": sorted(physical_counts.values()),
+        "slot_occupancies": sorted(slot_counts.values()),
+    }
+
+
+def summarize(rows: list[dict[str, object]], steps: int) -> dict[str, object]:
+    import numpy as np
+
+    scalar_fields = (
+        "modal_frac",
+        "active_beams",
+        "active_satellites",
+        "argmax_distinct",
+        "no_op_users",
+    )
+
+    def summarize_group(group: list[dict[str, object]]) -> dict[str, object]:
+        result: dict[str, object] = {}
+        for field in scalar_fields:
+            values = np.asarray([row[field] for row in group], dtype=np.float64)
+            result[field] = {
+                "mean": float(np.mean(values)),
+                "min": float(np.min(values)),
+                "max": float(np.max(values)),
+            }
+        physical_hist: Counter[int] = Counter()
+        slot_hist: Counter[int] = Counter()
+        for row in group:
+            physical_hist.update(int(value) for value in row["physical_occupancies"])
+            slot_hist.update(int(value) for value in row["slot_occupancies"])
+        result["physical_occupancy_histogram"] = {
+            str(key): physical_hist[key] for key in sorted(physical_hist)
+        }
+        result["slot_occupancy_histogram"] = {
+            str(key): slot_hist[key] for key in sorted(slot_hist)
+        }
+        return result
+
+    return {
+        "pooled_profiles": summarize_group(rows),
+        "by_step": {
+            str(step): summarize_group(
+                [row for row in rows if int(row["step_index"]) == step]
+            )
+            for step in range(steps)
+        },
+    }
+
+
+def rollout(
+    *,
+    label: str,
+    seeds: tuple[int, ...],
+    users: int,
+    steps: int,
+    selector: Callable,
+) -> tuple[list[dict[str, object]], Counter[int]]:
+    import numpy as np
+
+    rows: list[dict[str, object]] = []
+    total_actions: Counter[int] = Counter()
+    for scenario_index, seed in enumerate(seeds, start=1):
+        environment = make_environment(users)
+        seed_children = np.random.SeedSequence(seed).spawn(2)
+        env_rng = np.random.default_rng(seed_children[0])
+        mobility_rng = np.random.default_rng(seed_children[1])
+        states, masks, observation = environment.reset(env_rng, mobility_rng)
+        for step_index in range(steps):
+            actions = selector(states, masks)
+            metric = profile_metrics(observation, actions, users)
+            metric.update(
+                {
+                    "scenario_index": scenario_index,
+                    "seed": seed,
+                    "step_index": step_index,
+                }
+            )
+            rows.append(metric)
+            total_actions.update(int(action) for action in actions if int(action) >= 0)
+            result = environment.step(actions, env_rng)
+            expected_done = step_index == steps - 1
+            if bool(result.done) != expected_done:
+                raise RuntimeError("legacy episode length drifted")
+            states = list(result.user_states)
+            masks = list(result.action_masks)
+            observation = environment.last_outcome.observation
+        assert_memory()
+        print(
+            f"progress {label}: {scenario_index}/{len(seeds)} scenarios; "
+            f"peak RSS {peak_rss_bytes()} bytes",
+            file=sys.stderr,
+            flush=True,
+        )
+    return rows, total_actions
+
+
+def main() -> None:
+    started = time.monotonic()
+    assert_resources()
+    if str(TRAINING_SRC) not in sys.path:
+        sys.path.insert(0, str(TRAINING_SRC))
+
+    from mcrl.runtime import probe_p6, training_pipeline
+
+    pre_digest = sha256(CHECKPOINT_PATH)
+    if pre_digest != EXPECTED_CHECKPOINT_SHA256:
+        raise RuntimeError("checkpoint pre-run digest mismatch")
+    if sha256(PREREG_PATH) != EXPECTED_PREREG_SHA256:
+        raise RuntimeError("training preregistration bytes drifted")
+    status = json.loads(STATUS_PATH.read_text(encoding="utf-8"))
+    recorded_code = status["run_fingerprint"]["code_sha256"]
+    live_code = training_pipeline._code_sha256(training_pipeline._default_code_paths())
+    if recorded_code != EXPECTED_TRAINING_CODE_SHA256 or live_code != recorded_code:
+        raise RuntimeError("training source fingerprint does not match checkpoint receipt")
+
+    recorded_dependencies = status["run_fingerprint"]["dependencies"]
+    live_dependencies = training_pipeline._installed_dependency_versions()
+    if live_dependencies != recorded_dependencies:
+        raise RuntimeError(
+            f"runtime dependency drift: {live_dependencies!r} != {recorded_dependencies!r}"
+        )
+
+    adapter_module = load_adapter_module()
+    adapter = adapter_module.BaselineAdapter.from_artifacts(
+        checkpoint_path=CHECKPOINT_PATH,
+        status_path=STATUS_PATH,
+    )
+    if adapter.binding() != {
+        "checkpoint_sha256": EXPECTED_CHECKPOINT_SHA256,
+        "state_dim": 112,
+        "action_dim": 28,
+        "training_episodes": 9000,
+        "contract_fields_excluded": True,
+    }:
+        raise RuntimeError("adapter binding drifted")
+
+    seeds = tuple(int(seed) for seed in probe_p6.P6_EVALUATION_SEEDS)
+    if len(seeds) != 10:
+        raise RuntimeError("frozen development-seed count drifted")
+    users = 100
+    steps = 10
+
+    modqn_rows, modqn_actions = rollout(
+        label="MODQN",
+        seeds=seeds,
+        users=users,
+        steps=steps,
+        selector=adapter.select_actions,
+    )
+    myopic_rows, myopic_slot_counts = rollout(
+        label="myopic",
+        seeds=seeds,
+        users=users,
+        steps=steps,
+        selector=myopic_actions,
+    )
+
+    post_digest = sha256(CHECKPOINT_PATH)
+    if post_digest != pre_digest:
+        raise RuntimeError("checkpoint changed during rollout")
+    assert_memory()
+
+    result = {
+        "schema": "modqn-collapse-concentration-v1",
+        "scope": {
+            "environment": "byte-matched 2026-08-25 training source snapshot",
+            "split": "TRAIN",
+            "scenario_count": len(seeds),
+            "seeds": list(seeds),
+            "users": users,
+            "steps_per_scenario": steps,
+            "profiles_per_policy": len(seeds) * steps,
+            "myopic_rule": (
+                "per user, lowest-index masked argmax of native linear "
+                "candidate channel_quality (candidate SINR); NO_OP iff mask empty"
+            ),
+        },
+        "provenance": {
+            "training_root": str(TRAINING_ROOT),
+            "training_code_sha256_recorded": recorded_code,
+            "training_code_sha256_live": live_code,
+            "dependencies_recorded": recorded_dependencies,
+            "dependencies_live": live_dependencies,
+            "checkpoint_path": str(CHECKPOINT_PATH),
+            "checkpoint_sha256_before": pre_digest,
+            "checkpoint_sha256_after": post_digest,
+            "adapter_path": str(ADAPTER_PATH),
+            "adapter_sha256": sha256(ADAPTER_PATH),
+            "prereg_path": str(PREREG_PATH),
+            "prereg_sha256": sha256(PREREG_PATH),
+        },
+        "resources": {
+            "python_processes_launched_concurrently": 1,
+            "nice": os.getpriority(os.PRIO_PROCESS, 0),
+            "thread_environment": {name: os.environ[name] for name in THREAD_ENV},
+            "peak_rss_bytes": peak_rss_bytes(),
+            "peak_rss_mib": peak_rss_bytes() / (1024 * 1024),
+            "elapsed_seconds": time.monotonic() - started,
+        },
+        "policies": {
+            "MODQN": summarize(modqn_rows, steps)
+            | {
+                "chosen_action_slot_counts": {
+                    str(key): modqn_actions.get(key, 0) for key in range(28)
+                }
+            },
+            "myopic": summarize(myopic_rows, steps)
+            | {
+                "chosen_action_slot_counts": {
+                    str(key): myopic_slot_counts.get(key, 0) for key in range(28)
+                }
+            },
+        },
+    }
+    print("RESULT_JSON_BEGIN")
+    print(json.dumps(result, sort_keys=True, indent=2, allow_nan=False))
+    print("RESULT_JSON_END")
+    print(f"peak RSS: {peak_rss_bytes()} bytes ({peak_rss_bytes() / 1048576:.2f} MiB)")
+    print(f"elapsed: {time.monotonic() - started:.2f} seconds")
+    print(f"checkpoint SHA-256 before: {pre_digest}")
+    print(f"checkpoint SHA-256 after:  {post_digest}")
+
+
+if __name__ == "__main__":
+    main()

