   118	def myopic_actions(states, masks):
   119	    import numpy as np
   120	    from mcrl.env.action_contract import NO_OP_ACTION
   121	
   122	    actions = np.full(len(states), NO_OP_ACTION, dtype=np.int64)
   123	    for uid, (state, action_mask) in enumerate(zip(states, masks, strict=True)):
   124	        mask = np.asarray(action_mask.mask, dtype=np.bool_)
   125	        if np.any(mask):
   126	            quality = np.asarray(state.channel_quality, dtype=np.float64)
   127	            actions[uid] = int(np.argmax(np.where(mask, quality, -np.inf)))
   128	    return actions
