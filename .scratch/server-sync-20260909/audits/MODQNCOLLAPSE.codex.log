    97	def make_environment(users: int):
    98	    from mcrl.env.constants import TLE_ROOT_DEFAULT
    99	    from mcrl.env.ephemeris import TRAIN, BlockAlternatingSplit, EpisodeStartSampler
   100	    from mcrl.env.mobility import MobilityConfig
   101	    from mcrl.env.scenario import ScenarioConfig, ScenarioDriver
   102	    from mcrl.env.step import StepEnvironment
   103	    from mcrl.env.tle import TleArchive
   104	    from mcrl.runtime.trainer_env import TrainerEnvironment
   105	
   106	    archive = TleArchive(Path(TLE_ROOT_DEFAULT).expanduser())
   107	    driver = ScenarioDriver(
   108	        archive,
   109	        ScenarioConfig(mobility=MobilityConfig(num_users=users)),
   110	    )
   111	    split = BlockAlternatingSplit.for_archive(archive)
   112	    sampler = EpisodeStartSampler.for_archive(archive, split, TRAIN)
   113	    if sampler.part != TRAIN:
   114	        raise RuntimeError("sampler escaped the legacy TRAIN split")
   115	    return TrainerEnvironment(StepEnvironment(driver), sampler)
