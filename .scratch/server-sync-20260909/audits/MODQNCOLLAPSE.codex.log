+
+    pre_digest = sha256(CHECKPOINT_PATH)
+    if pre_digest != EXPECTED_CHECKPOINT_SHA256:
+        raise RuntimeError("checkpoint pre-run digest mismatch")
+    if sha256(PREREG_PATH) != EXPECTED_PREREG_SHA256:
+        raise RuntimeError("training preregistration bytes drifted")
