   131	def profile_metrics(observation, actions, users: int) -> dict[str, object]:
   132	    from mcrl.env.action_contract import NO_OP_ACTION
   133	
   134	    physical: list[tuple[int, int]] = []
   135	    action_slots: list[int] = []
   136	    for uid, raw_action in enumerate(actions):
   137	        action = int(raw_action)
   138	        if action == NO_OP_ACTION:
   139	            continue
   140	        association = observation.candidates.slot_tables[uid].association(action)
   141	        physical.append((int(association.norad_id), int(association.cell_id)))
   142	        action_slots.append(action)
   143	
   144	    physical_counts = Counter(physical)
   145	    slot_counts = Counter(action_slots)
   146	    satellites = {norad for norad, _cell in physical_counts}
   147	    return {
   148	        "modal_frac": (max(physical_counts.values(), default=0) / users),
   149	        "active_beams": len(physical_counts),
   150	        "active_satellites": len(satellites),
   151	        "argmax_distinct": len(slot_counts) / users,
   152	        "no_op_users": users - len(action_slots),
   153	        "physical_occupancies": sorted(physical_counts.values()),
   154	        "slot_occupancies": sorted(slot_counts.values()),
   155	    }
