+        )
+        ledger = {
+            "input_and_precompute_s": input_precompute,
+            "candidate_generation_s": candidate_generation,
+            "search_bookkeeping_s": search_bookkeeping,
+            "unique_oracle_solves_critical_path_s": oracle_solves,
+            "validation_and_output_s": validation_output,
+            "waiting_s": waiting,
