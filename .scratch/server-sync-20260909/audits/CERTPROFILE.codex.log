+    certification_timing = None
+    if certification_profile:
+        feasible_ids = {
+            row.configuration_id for row in guarded_stage2
+        }
+        winner_id = str(pre_fallback["FULL"])
+        timed_stage2 = [
+            row
+            for row in stage2_shards
