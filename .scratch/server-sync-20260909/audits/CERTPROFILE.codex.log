+#!/usr/bin/env python3
+"""Profile uncensored FULL-coordinator certification on tail-heavy anchors."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+import numpy as np
+
+
+REPO = Path(__file__).resolve().parents[1]
+RUNNER = (
+    REPO
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_FORMAL_ROOT = Path(
+    "/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal"
+)
+
+
+def load_runner():
+    spec = importlib.util.spec_from_file_location("v025_cert_profile_runner", RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {RUNNER}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def tail_proxy(runner, tape, step_index: int, carrier: str) -> dict[str, object]:
+    """Outcome-blind catalogue-work proxy over the full 90-anchor inventory."""
+
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("formal dense tape is required")
+    live = arrays.visible[0] & arrays.d2_eligible[0] & arrays.cell_reachable[0]
+    base = runner._base_configuration(tape, step_index, carrier)
+    alternatives = []
+    for user in sorted(base.mapping):
+        identities = {
+            tuple(int(value) for value in arrays.identities[row])
+            for row in np.flatnonzero(live).tolist()
+            if int(arrays.users[int(arrays.row_user_column[row])]) == user
+        }
+        alternatives.append(len(identities - {base.mapping[user]}))
+    top = sorted(alternatives, reverse=True)[: runner.PAIRWISE_TOP_K_USERS]
+    pairwise_upper = sum(
+        top[left] * top[right]
+        for left in range(len(top))
+        for right in range(left + 1, len(top))
+    )
+    return {
+        "step_index": step_index,
+        "carrier": carrier,
+        "live_legal_rows": int(np.count_nonzero(live)),
+        "users_with_alternatives": sum(value > 0 for value in alternatives),
+        "unilateral_upper": sum(alternatives),
+        "pairwise_upper": pairwise_upper,
+        "proxy": pairwise_upper + sum(alternatives),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--formal-root", type=Path, default=DEFAULT_FORMAL_ROOT
+    )
+    parser.add_argument("--world", type=int, default=1)
+    parser.add_argument("--anchors", type=int, default=24)
+    parser.add_argument("--workers", type=int, default=4)
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=REPO / ".scratch/cert-profile/raw-profile.json",
+    )
+    args = parser.parse_args()
+    if not 1 <= args.anchors <= 90:
+        raise SystemExit("--anchors must be in 1..90")
+    if not 1 <= args.workers <= 4:
+        raise SystemExit("--workers must be in 1..4")
+
+    runner = load_runner()
+    setting = runner._setting("a-r0")
+    run_setting = runner.run_setting_for("a-r0")
+    calibration_path = args.formal_root / "calibration-manifest.json"
+    manifest_path = args.formal_root / "world-manifest.json"
+    load_started = time.perf_counter()
+    calibration = runner.load_calibration(
+        calibration_path, setting, run_setting
+    )
+    tape = runner.load_prepared_world_tape(
+        manifest_path, args.world, run_setting
+    )
+    load_elapsed = time.perf_counter() - load_started
+
+    inventory = [
+        tail_proxy(runner, tape, step, carrier)
+        for step in range(30)
+        for carrier in runner.REFERENCE_CARRIERS
+    ]
+    ranked = sorted(
+        inventory,
+        key=lambda row: (
+            -int(row["proxy"]),
+            -int(row["live_legal_rows"]),
+            int(row["step_index"]),
+            runner.REFERENCE_CARRIERS.index(str(row["carrier"])),
+        ),
+    )
+    selected = ranked[: args.anchors]
+
+    rows = []
+    run_started = time.perf_counter()
+    for index, anchor in enumerate(selected, start=1):
+        step = int(anchor["step_index"])
+        carrier = str(anchor["carrier"])
+        print(
+            f"[{index}/{len(selected)}] step={step} carrier={carrier} "
+            f"proxy={anchor['proxy']}",
+            file=sys.stderr,
+            flush=True,
+        )
+        result = runner.execute_step(
+            tape=tape,
+            setting=setting,
+            step_index=step,
+            carrier=carrier,
+            calibration=calibration,
+            counter=runner.EvaluationCounter(),
+            incumbent=runner._base_configuration(tape, max(0, step - 1), carrier),
+            c2_horizon_offsets=run_setting.c2_horizon_offsets,
+            run_setting=run_setting,
+            selection_workers=args.workers,
+            enforce_deadline=False,
+            certification_profile=True,
+        )
+        profile = result["certification_profile"]
+        if profile is None:
+            raise RuntimeError("runner omitted certification profile")
+        if profile["t_winner_s"] is None or profile["t_first_s"] is None:
+            raise RuntimeError("profile lacks a complete feasible candidate timestamp")
+        if not math.isclose(
+            float(profile["ledger_sum_s"]),
+            float(profile["t_total_s"]),
+            rel_tol=0.0,
+            abs_tol=1.0e-9,
+        ):
+            raise RuntimeError("exclusive ledger does not reconcile")
+        rows.append(
+            {
+                **anchor,
+                "world_domain": tape.domain,
+                "world_sha256": tape.digest,
+                "profile": profile,
+                "catalogue_count": result["e1_certificate"]["candidate_count"],
+                "stage2_count": result["selection_approximations"]["stage2_count"],
+                "production_deadline_s": result["coordinator"]["deadline_s"],
+                "production_guard_s": runner.S_UNI_BUDGET_GUARD_S,
+                "uncensored_full_configuration_id": result[
+                    "selection_approximations"
+                ]["pre_fallback_selections"]["FULL"],
+            }
+        )
+
+    payload = {
+        "schema": "mcrl-v025-certification-profile-v1",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "source_commit": "75c5c78c",
+        "reference_arm": "FULL",
+        "world": args.world,
+        "workers": args.workers,
+        "cutoff_enforced": False,
+        "production_budget_changed": False,
+        "selection_method": (
+            "top anchors from the complete 30-step x 3-carrier inventory by "
+            "outcome-blind upper proxy: unilateral alternatives plus pairwise "
+            "products among the ten widest users"
+        ),
+        "inventory_count": len(inventory),
+        "selected_anchor_count": len(rows),
+        "formal_tape_load_s": load_elapsed,
+        "profile_run_s": time.perf_counter() - run_started,
+        "selected_inventory": selected,
+        "rows": rows,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    print(args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
