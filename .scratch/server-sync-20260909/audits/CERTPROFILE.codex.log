    *,
    pool: ProcessPoolExecutor | None,
        return WORLD_PROVIDER_FACTORY()
    try:
        return WORLD_PROVIDER_FACTORY(user_count=run_setting.user_count)  # type: ignore[call-arg]
    except TypeError as error:
