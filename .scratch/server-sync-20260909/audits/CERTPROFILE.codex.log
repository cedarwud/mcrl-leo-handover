new file mode 100644
index 0000000000000000000000000000000000000000..e37516a8c9cbbe2e6e024a3d360b7148fa0eadea
--- /dev/null
+++ b/scripts/profile_s_uni_certification.py
@@ -0,0 +1,227 @@
+#!/usr/bin/env python3
+"""Measure when the S_UNI winner is found and certified, without its cutoff."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+
+REPO = Path(__file__).resolve().parents[1]
+RUNNER = REPO / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+DEFAULT_FORMAL_ROOT = Path("/home/sat/mcrl-v025-codex-ws-engine/.tmp/stage4h-formal")
+
+
+def load_runner():
+    spec = importlib.util.spec_from_file_location("v025_s_uni_cert_profile", RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {RUNNER}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def evaluator_for(runner, tape, setting, run_setting, step: int, carrier: str):
+    base = runner._base_configuration(tape, step, carrier)
+    incumbent = runner._base_configuration(tape, max(0, step - 1), carrier)
+    counter = runner.EvaluationCounter()
+    evaluator = runner.StepEvaluator(
+        tape,
+        setting,
+        step,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step),
+        previously_served_users=runner._previously_served_users(tape, step, carrier),
+        field="margin",
+        fading_quantile_alpha=0.10,
+        counter=counter,
+        run_setting=run_setting,
+        boundary_indices=(0,),
+    )
+    return base, incumbent, evaluator
+
+
+def run_one(
+    runner,
+    tape,
+    setting,
+    run_setting,
+    *,
+    step: int,
+    carrier: str,
+    enforce_deadline: bool,
+    traced: bool,
+):
+    base, incumbent, evaluator = evaluator_for(
+        runner, tape, setting, run_setting, step, carrier
+    )
+    trace = {} if traced else None
+    selected, iterations, wall_s, missed, termination = runner._s_uni_select(
+        base=base,
+        incumbent=incumbent,
+        tape=tape,
+        step_index=step,
+        evaluator=evaluator,
+        calibration=CALIBRATION,
+        compute_budget_s=runner.S_UNI_COMPUTE_BUDGET_S,
+        run_setting=run_setting,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step),
+        enforce_deadline=enforce_deadline,
+        certification_trace=trace,
+    )
+    return {
+        "step_index": step,
+        "carrier": carrier,
+        "selected_configuration_id": selected.configuration_id,
+        "best_response_iterations": iterations,
+        "wall_s": wall_s,
+        "deadline_missed": missed,
+        "termination": termination,
+        "trace": trace,
+    }
+
+
+def write_payload(path: Path, payload: dict[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+CALIBRATION = None
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--formal-root", type=Path, default=DEFAULT_FORMAL_ROOT)
+    parser.add_argument("--world", type=int, default=1)
+    parser.add_argument("--anchors", type=int, default=24)
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=REPO / ".scratch/cert-profile/s-uni-profile.json",
+    )
+    args = parser.parse_args()
+    if not 20 <= args.anchors <= 90:
+        raise SystemExit("--anchors must be in 20..90")
+
+    runner = load_runner()
+    setting = runner._setting("a-r0")
+    run_setting = runner.run_setting_for("a-r0")
+    load_started = time.perf_counter()
+    global CALIBRATION
+    CALIBRATION = runner.load_calibration(
+        args.formal_root / "calibration-manifest.json", setting, run_setting
+    )
+    tape = runner.load_prepared_world_tape(
+        args.formal_root / "world-manifest.json", args.world, run_setting
+    )
+    load_s = time.perf_counter() - load_started
+
+    screening = []
+    for index, (step, carrier) in enumerate(
+        (
+            (step, carrier)
+            for step in range(30)
+            for carrier in runner.REFERENCE_CARRIERS
+        ),
+        start=1,
+    ):
+        print(
+            f"[screen {index}/90] step={step} carrier={carrier}",
+            file=sys.stderr,
+            flush=True,
+        )
+        screening.append(
+            run_one(
+                runner,
+                tape,
+                setting,
+                run_setting,
+                step=step,
+                carrier=carrier,
+                enforce_deadline=True,
+                traced=False,
+            )
+        )
+
+    ranked = sorted(
+        screening,
+        key=lambda row: (
+            -int(bool(row["deadline_missed"])),
+            -float(row["wall_s"]),
+            int(row["step_index"]),
+            runner.REFERENCE_CARRIERS.index(str(row["carrier"])),
+        ),
+    )
+    selected = ranked[: args.anchors]
+    payload: dict[str, object] = {
+        "schema": "mcrl-v025-s-uni-certification-profile-v1",
+        "classification": "DIAGNOSTIC_NOT_CLAIM",
+        "source_commit": "75c5c78c",
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "processes": 1,
+        "production_compute_budget_s": runner.S_UNI_COMPUTE_BUDGET_S,
+        "production_guard_s": runner.S_UNI_BUDGET_GUARD_S,
+        "formal_tape_load_s": load_s,
+        "screening_method": (
+            "all 90 anchors (30 steps x three carriers) under the unchanged "
+            "production cutoff; rank misses first, then descending observed wall time"
+        ),
+        "screening": screening,
+        "selected_anchor_count": len(selected),
+        "selected_from_inventory_count": len(screening),
+        "rows": [],
+    }
+    write_payload(args.output, payload)
+
+    profile_started = time.perf_counter()
+    rows = payload["rows"]
+    assert isinstance(rows, list)
+    for index, anchor in enumerate(selected, start=1):
+        print(
+            f"[uncensored {index}/{len(selected)}] step={anchor['step_index']} "
+            f"carrier={anchor['carrier']} screened={float(anchor['wall_s']):.3f}s",
+            file=sys.stderr,
+            flush=True,
+        )
+        row = run_one(
+            runner,
+            tape,
+            setting,
+            run_setting,
+            step=int(anchor["step_index"]),
+            carrier=str(anchor["carrier"]),
+            enforce_deadline=False,
+            traced=True,
+        )
+        trace = row["trace"]
+        if not isinstance(trace, dict):
+            raise RuntimeError("trace was not populated")
+        required = ("t_first_s", "t_winner_s", "t_certified_s", "t_total_s")
+        if any(trace.get(name) is None for name in required):
+            raise RuntimeError(f"uncensored trace lacks {required}")
+        if not math.isclose(
+            float(trace["ledger_sum_s"]),
+            float(trace["t_total_s"]),
+            rel_tol=0.0,
+            abs_tol=1.0e-9,
+        ):
+            raise RuntimeError("exclusive ledger does not reconcile")
+        row["screened_wall_s"] = anchor["wall_s"]
+        row["screened_deadline_missed"] = anchor["deadline_missed"]
+        rows.append(row)
+        payload["profile_elapsed_s"] = time.perf_counter() - profile_started
+        write_payload(args.output, payload)
+
+    print(args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

