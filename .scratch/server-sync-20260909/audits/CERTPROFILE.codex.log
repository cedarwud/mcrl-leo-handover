+
+        def critical_path(rows: Sequence[Mapping[str, object]]) -> float:
+            timed = [
+                row
+                for row in rows
+                if "worker_started_perf_counter_s" in row
+                and "worker_completed_perf_counter_s" in row
+            ]
+            if not timed:
+                return 0.0
+            return max(
+                float(row["worker_completed_perf_counter_s"]) for row in timed
+            ) - min(float(row["worker_started_perf_counter_s"]) for row in timed)
+
+        stage1_critical = critical_path(stage1_shards)
+        stage2_critical = critical_path(stage2_shards)
