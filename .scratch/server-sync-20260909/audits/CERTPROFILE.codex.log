                        )
                    ) / rx_peak
                    cross = (1.2e-13 + 0.1e-13 * user) * rx_ratio
                    nominal_cross.append((aggressor_norad, cross))
                    cross_fading = keyed_fading_gain(
                        world=world_seed,
                        user=user,
