            ),
            "matched_qos_noninferior": j1_matched_qos,
            "matched_qos_certificate": j1_qos_certificate,
            "u_all_configuration": u1.config.configuration_id,
            "solver_residual_w_max": solver_residual_w_max,
        },
        "s0_certificate": {
