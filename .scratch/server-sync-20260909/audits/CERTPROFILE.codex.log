+        ]
+        first_completions = [
+            float(row["worker_completed_perf_counter_s"])
+            for row in timed_stage2
+            if any(
+                configuration_id != base.configuration_id
+                and configuration_id in feasible_ids
+                for configuration_id in row["configuration_ids"]
+            )
+        ]
+        winner_completions = [
+            float(row["worker_completed_perf_counter_s"])
+            for row in timed_stage2
+            if winner_id in row["configuration_ids"]
