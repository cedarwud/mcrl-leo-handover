diff --git a/.scratch/beamwidth/final_beamwidth_curve.py b/.scratch/beamwidth/final_beamwidth_curve.py
new file mode 100644
index 0000000000000000000000000000000000000000..f8e221ef9780cb76f1ac66c645690af76a9cc035
--- /dev/null
+++ b/.scratch/beamwidth/final_beamwidth_curve.py
@@ -0,0 +1,704 @@
+#!/usr/bin/env python3
+"""Strict-clearance, correctly paired five-width beam diagnostic.
+
+This adapter deliberately imports the established first-improvement and
+reseeded-joint implementations from the read-only harness workspace.  It does
+not reproduce either search algorithm locally.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import sys
+import time
+from typing import Mapping, Sequence
+
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+HARNESS_REPO = Path("/home/sat/mcrl-v025-harness-ws")
+HARNESS_ANYTIME = HARNESS_REPO / "harness/anytime.py"
+HARNESS_RESEEDED = HARNESS_REPO / "harness/reseeded_span.py"
+BEAM_RUNNER = HERE / "run_beamwidth_network.py"
+STRICT_ADAPTER = HERE / "strict_clearance_adapter.py"
+OUTPUT_REPORT = REPO / "FINAL-BEAMWIDTH-CURVE-2026-09-10.md"
+WIDTHS = ("1.66", "2.40", "3.32", "4.50", "6.65")
+RULES = ("SEALED", "STRICT")
+ARMS = ("U_best", "U_first", "J_from_best", "J_from_first")
+EXPECTED_FIRST_DIGEST = "003bdee1df908fddf652f2f8069c31a6297a7f7178bbb83338d09b3f4add9928"
+EXPECTED_STRICT_DENSE_DIGEST = "bf9f3cfecba54125c6a7736f550032e6bd7292f03f8fc6281f1d02979c14a85f"
+SCHEMA = "mcrl-v025-final-beamwidth-curve-arm-v1"
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    encoded = json.dumps(
+        unsigned,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def load_json(path: Path, *, verify_digest: bool = False) -> dict:
+    payload = json.loads(path.read_text(encoding="ascii"))
+    if verify_digest:
+        expected = payload.get("receipt_sha256")
+        actual = canonical_digest(payload)
+        if expected != actual:
+            raise RuntimeError(f"receipt digest mismatch: {path}: {actual} != {expected}")
+    return payload
+
+
+def write_receipt(payload: dict, path: Path) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def load_beam_runner():
+    sys.path.insert(0, str(HERE))
+    spec = importlib.util.spec_from_file_location("final_beam_reference", BEAM_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load beam-width reference runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def import_harness_implementations():
+    sys.path.insert(0, str(HARNESS_REPO))
+    from harness.anytime import first_improvement_unilateral
+    from harness.reseeded_span import (
+        _committed_metric,
+        _committed_profiles,
+        _joint_from_seed,
+    )
+
+    return (
+        first_improvement_unilateral,
+        _joint_from_seed,
+        _committed_profiles,
+        _committed_metric,
+    )
+
+
+def source_path(rule: str, width: str) -> Path:
+    if rule == "SEALED":
+        return HERE / f"sealed-diagnostics-one-sided-{width}.json"
+    if rule == "STRICT":
+        return HERE / f"strict-margin-sweep-one-sided-{width}.json"
+    raise RuntimeError(f"unknown rule: {rule}")
+
+
+def output_path(rule: str, width: str) -> Path:
+    return HERE / f"final-{rule.lower()}-one-sided-{width}.json"
+
+
+def configure(reference, rule: str, width: str) -> None:
+    reference.channel_module.TX_FULL_HPBW_DEG = 2.0 * float(width)
+    if rule == "SEALED":
+        reference.PROVISIONING_RULE = "sealed"
+        reference.probe.evaluate_ar_tdm_catalogue = __import__(
+            "mcrl.physics_v025.batch", fromlist=["evaluate_ar_tdm_catalogue"]
+        ).evaluate_ar_tdm_catalogue
+    elif rule == "STRICT":
+        reference.PROVISIONING_RULE = "margin-strict"
+        reference.probe.evaluate_ar_tdm_catalogue = (
+            reference.strict_clearance_adapter.evaluate_ar_tdm_catalogue
+        )
+    else:
+        raise RuntimeError(f"unknown rule: {rule}")
+
+
+def metric_from_source(source_metric: Mapping[str, object]) -> dict:
+    required = (
+        "configuration_id",
+        "bits",
+        "joules",
+        "ee_bit_per_j",
+        "served_count",
+        "rate_target_attained_count",
+    )
+    missing = [key for key in required if key not in source_metric]
+    if missing:
+        raise RuntimeError(f"standing metric lacks required fields: {missing}")
+    return {key: source_metric[key] for key in required}
+
+
+def anchor_by_id(receipt: Mapping[str, object]) -> dict[str, dict]:
+    return {row["anchor_id"]: row for row in receipt["anchors"]}
+
+
+def measure_anchor(
+    reference,
+    tape,
+    world_index: int,
+    step_index: int,
+    standing: Mapping[str, object],
+    first_improvement_unilateral,
+    joint_from_seed,
+    committed_profiles,
+    committed_metric,
+) -> dict:
+    anchor_id = f"V025_PROBE_R2/world/{world_index}:step/{step_index}"
+    if standing["anchor_id"] != anchor_id:
+        raise RuntimeError("standing anchor identity mismatch")
+    if standing["world_sha256"] != tape.digest:
+        raise RuntimeError(f"world digest mismatch at {anchor_id}")
+
+    run = first_improvement_unilateral(reference, tape, step_index)
+    base = run.base
+    if base.configuration_id != standing["committed"]["BASELINE"]["configuration_id"]:
+        raise RuntimeError(f"baseline configuration mismatch at {anchor_id}")
+    u_first = run.selected
+    j_first, joint_selection = joint_from_seed(
+        reference, tape, step_index, base, u_first
+    )
+    profiles = committed_profiles(
+        reference, tape, step_index, base, (u_first, j_first)
+    )
+    u_first_metric = committed_metric(reference, profiles[u_first.configuration_id])
+    j_first_metric = committed_metric(reference, profiles[j_first.configuration_id])
+
+    if u_first_metric["rate_target_user_count"] != 100:
+        raise RuntimeError(f"U_first user count mismatch at {anchor_id}")
+    if j_first_metric["rate_target_user_count"] != 100:
+        raise RuntimeError(f"J_from_first user count mismatch at {anchor_id}")
+    if not joint_selection["strict_selection_objective_improvement"]:
+        raise RuntimeError(f"joint selector found no strict improvement at {anchor_id}")
+    if joint_selection["guard_reference"] != "BASELINE selection-time served_PHY count":
+        raise RuntimeError(f"joint guard reference changed at {anchor_id}")
+
+    committed = {
+        "U_best": metric_from_source(standing["committed"]["UNILATERAL"]),
+        "U_first": u_first_metric,
+        "J_from_best": metric_from_source(standing["committed"]["ORACLE_SET"]),
+        "J_from_first": j_first_metric,
+    }
+    return {
+        "anchor_id": anchor_id,
+        "world_index": world_index,
+        "step_index": step_index,
+        "world_sha256": tape.digest,
+        "tle_date": tape.tle_date,
+        "training_seed": tape.training_seed,
+        "unilateral_first": run.receipt,
+        "joint_selection_from_first": joint_selection,
+        "committed": committed,
+        "committed_metric_source": {
+            "U_best": "standing strict/sealed beam-width receipt",
+            "U_first": "new singleton 48-boundary evaluation",
+            "J_from_best": "standing strict/sealed beam-width receipt",
+            "J_from_first": "new singleton 48-boundary evaluation",
+        },
+    }
+
+
+def gain(over: float, base: float) -> float:
+    return over / base - 1.0
+
+
+PAIRINGS = (
+    ("J_from_best", "U_best", "published"),
+    ("J_from_first", "U_first", "correct"),
+    ("J_from_best", "U_first", "cross_best_joint_over_first_unilateral"),
+    ("J_from_first", "U_best", "cross_first_joint_over_best_unilateral"),
+)
+
+
+def summarize(anchors: Sequence[Mapping[str, object]]) -> dict:
+    pooled = {}
+    for arm in ARMS:
+        metrics = [row["committed"][arm] for row in anchors]
+        bits = math.fsum(float(row["bits"]) for row in metrics)
+        joules = math.fsum(float(row["joules"]) for row in metrics)
+        pooled[arm] = {
+            "bits": bits,
+            "joules": joules,
+            "ee_bit_per_j": bits / joules,
+            "served_count_sum": sum(int(row["served_count"]) for row in metrics),
+            "rate_target_attained_count_sum": sum(
+                int(row["rate_target_attained_count"]) for row in metrics
+            ),
+            "rate_target_user_count_sum": 100 * len(metrics),
+        }
+    pairings = {}
+    for joint, unilateral, name in PAIRINGS:
+        local = [
+            gain(
+                float(row["committed"][joint]["ee_bit_per_j"]),
+                float(row["committed"][unilateral]["ee_bit_per_j"]),
+            )
+            for row in anchors
+        ]
+        pairings[name] = {
+            "joint": joint,
+            "unilateral": unilateral,
+            "pooled_relative_ee_gain": gain(
+                pooled[joint]["ee_bit_per_j"], pooled[unilateral]["ee_bit_per_j"]
+            ),
+            "negative_anchor_count": sum(value < 0.0 for value in local),
+            "zero_anchor_count": sum(value == 0.0 for value in local),
+            "positive_anchor_count": sum(value > 0.0 for value in local),
+            "per_anchor": [
+                {"anchor_id": row["anchor_id"], "relative_ee_gain": value}
+                for row, value in zip(anchors, local, strict=True)
+            ],
+        }
+
+    published = pairings["published"]["pooled_relative_ee_gain"]
+    intermediate = pairings["cross_best_joint_over_first_unilateral"][
+        "pooled_relative_ee_gain"
+    ]
+    correct = pairings["correct"]["pooled_relative_ee_gain"]
+    search_order = intermediate - published
+    seed = correct - intermediate
+    if not math.isclose(search_order + seed, correct - published, rel_tol=0.0, abs_tol=2e-15):
+        raise RuntimeError("gap-change decomposition does not close")
+    return {
+        "anchor_count": len(anchors),
+        "pooled": pooled,
+        "pairings": pairings,
+        "gap_change_decomposition": {
+            "definition": (
+                "published J_from_best/U_best -> replace denominator with U_first "
+                "at fixed J_from_best -> reseed joint arm to J_from_first at fixed U_first"
+            ),
+            "published_gap": published,
+            "search_order_part": search_order,
+            "intermediate_gap_J_from_best_over_U_first": intermediate,
+            "seed_part": seed,
+            "correct_gap": correct,
+            "net_change": correct - published,
+        },
+        "all_first_fixed_points_differ_from_best": all(
+            row["committed"]["U_first"]["configuration_id"]
+            != row["committed"]["U_best"]["configuration_id"]
+            for row in anchors
+        ),
+        "all_joint_seeds_are_first_fixed_points": all(
+            row["joint_selection_from_first"]["seed_configuration_id"]
+            == row["committed"]["U_first"]["configuration_id"]
+            for row in anchors
+        ),
+        "joint_strict_selection_improvement_count": sum(
+            bool(row["joint_selection_from_first"]["strict_selection_objective_improvement"])
+            for row in anchors
+        ),
+    }
+
+
+def preflight() -> None:
+    if sha256(HARNESS_ANYTIME) != EXPECTED_FIRST_DIGEST:
+        raise RuntimeError("first-improvement implementation digest changed")
+    reference = load_beam_runner()
+    strict_digest = reference.strict_clearance_adapter.SOURCE_SHA256[
+        "cleared_margin_batch.py"
+    ]
+    if strict_digest != EXPECTED_STRICT_DENSE_DIGEST:
+        raise RuntimeError("strict dense implementation digest changed")
+    for width in WIDTHS:
+        sealed = load_json(source_path("SEALED", width))
+        strict = load_json(source_path("STRICT", width), verify_digest=True)
+        if len(sealed["anchors"]) != 8 or len(strict["anchors"]) != 8:
+            raise RuntimeError(f"source receipt is not 8 anchors at {width}")
+        if strict.get("provisioning_rule") != "margin-strict":
+            raise RuntimeError(f"strict receipt uses wrong provisioning rule at {width}")
+        if strict["strict_clearance_source_sha256"]["cleared_margin_batch.py"] != strict_digest:
+            raise RuntimeError(f"strict receipt source mismatch at {width}")
+        for receipt in (sealed, strict):
+            for row in receipt["anchors"]:
+                for arm in ("UNILATERAL", "ORACLE_SET"):
+                    if "rate_target_attained_count" not in row["committed"][arm]:
+                        raise RuntimeError(f"missing separate target metric at {row['anchor_id']}")
+    print(
+        json.dumps(
+            {
+                "status": "PASS",
+                "source_anchor_receipts": 10,
+                "source_anchors": 80,
+                "first_improvement_implementation_sha256": EXPECTED_FIRST_DIGEST,
+                "strict_dense_implementation_sha256": strict_digest,
+            },
+            sort_keys=True,
+        )
+    )
+
+
+def run(rule: str, width: str, output: Path, resume: bool) -> None:
+    if rule not in RULES or width not in WIDTHS:
+        raise RuntimeError("run must use a declared rule and width")
+    if sha256(HARNESS_ANYTIME) != EXPECTED_FIRST_DIGEST:
+        raise RuntimeError("first-improvement implementation digest changed")
+    reference = load_beam_runner()
+    (
+        first_improvement_unilateral,
+        joint_from_seed,
+        committed_profiles,
+        committed_metric,
+    ) = import_harness_implementations()
+    configure(reference, rule, width)
+    source = load_json(source_path(rule, width), verify_digest=(rule == "STRICT"))
+    source_rows = anchor_by_id(source)
+    source_file_sha = sha256(source_path(rule, width))
+    payload = {
+        "schema": SCHEMA,
+        "claim_ceiling": CLAIM_CEILING,
+        "complete": False,
+        "rule": rule,
+        "one_sided_half_power_deg": float(width),
+        "full_hpbw_deg": 2.0 * float(width),
+        "source_receipt": str(source_path(rule, width).relative_to(REPO)),
+        "source_receipt_file_sha256": source_file_sha,
+        "first_improvement_implementation": str(HARNESS_ANYTIME),
+        "first_improvement_implementation_sha256": sha256(HARNESS_ANYTIME),
+        "reseeded_joint_implementation": str(HARNESS_RESEEDED),
+        "reseeded_joint_implementation_file_sha256": sha256(HARNESS_RESEEDED),
+        "beam_reference_implementation": str(BEAM_RUNNER.relative_to(REPO)),
+        "beam_reference_implementation_sha256": sha256(BEAM_RUNNER),
+        "strict_clearance_source_sha256": (
+            reference.strict_clearance_adapter.SOURCE_SHA256 if rule == "STRICT" else None
+        ),
+        "strict_clearance_adapter_sha256": sha256(STRICT_ADAPTER),
+        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0",
+        "tie_break": "higher F, then lexicographically smaller configuration_id among non-seed candidates",
+        "service_guard": "both joint arms use selection-time served_PHY count >= neutral BASELINE served_PHY count",
+        "committed_endpoint": "each selected configuration evaluated over all 48 realised boundaries at fading_quantile_alpha=0.10",
+        "catalogue_caps": {
+            "occupant_subset_max_size": reference.OCCUPANT_SUBSET_MAX_SIZE,
+            "occupant_subset_total_cap": reference.OCCUPANT_SUBSET_TOTAL_CAP,
+            "joint_candidate_cap": reference.JOINT_CANDIDATE_CAP,
+        },
+        "world_count": 2,
+        "steps_per_world": 4,
+        "users_per_anchor": 100,
+        "anchors": [],
+        "started_unix": time.time(),
+        "python": sys.executable,
+        "python_version": platform.python_version(),
+        "thread_environment": {
+            name: os.environ.get(name)
+            for name in (
+                "OMP_NUM_THREADS",
+                "OPENBLAS_NUM_THREADS",
+                "MKL_NUM_THREADS",
+                "NUMEXPR_NUM_THREADS",
+            )
+        },
+    }
+    if resume and output.exists():
+        old = load_json(output, verify_digest=True)
+        for key in (
+            "schema",
+            "rule",
+            "one_sided_half_power_deg",
+            "source_receipt_file_sha256",
+            "first_improvement_implementation_sha256",
+            "reseeded_joint_implementation_file_sha256",
+            "beam_reference_implementation_sha256",
+        ):
+            if old.get(key) != payload.get(key):
+                raise RuntimeError(f"cannot resume after mismatch in {key}")
+        payload["anchors"] = old["anchors"]
+        payload["started_unix"] = old["started_unix"]
+        if "finished_unix" in old:
+            payload["finished_unix"] = old["finished_unix"]
+    completed = {row["anchor_id"] for row in payload["anchors"]}
+
+    from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+    for world_index in (1, 2):
+        domain = reference.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        tape = reference.probe.build_world_tape(
+            domain=domain,
+            provider=real_factory(),
+            steps=4,
+            start_time_s=0.0,
+        )
+        reference._WORKER_TAPE = tape
+        for step_index in range(4):
+            anchor_id = f"V025_PROBE_R2/world/{world_index}:step/{step_index}"
+            if anchor_id in completed:
+                continue
+            started = time.perf_counter()
+            row = measure_anchor(
+                reference,
+                tape,
+                world_index,
+                step_index,
+                source_rows[anchor_id],
+                first_improvement_unilateral,
+                joint_from_seed,
+                committed_profiles,
+                committed_metric,
+            )
+            row["wall_seconds"] = time.perf_counter() - started
+            payload["anchors"].append(row)
+            payload["anchors"].sort(key=lambda item: (item["world_index"], item["step_index"]))
+            payload["summary"] = summarize(payload["anchors"])
+            payload["complete"] = len(payload["anchors"]) == 8
+            write_receipt(payload, output)
+            print(
+                json.dumps(
+                    {
+                        "rule": rule,
+                        "width": width,
+                        "anchor": anchor_id,
+                        "anchors_complete": len(payload["anchors"]),
+                        "correct_gap_pct_so_far": 100.0
+                        * payload["summary"]["pairings"]["correct"]["pooled_relative_ee_gain"],
+                        "wall_seconds": row["wall_seconds"],
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+    if len(payload["anchors"]) != 8:
+        raise RuntimeError("run did not reach all eight anchors")
+    payload["complete"] = True
+    payload["summary"] = summarize(payload["anchors"])
+    payload.setdefault("finished_unix", time.time())
+    write_receipt(payload, output)
+
+
+def signed_pct(value: float, digits: int = 6) -> str:
+    return f"{100.0 * value:+.{digits}f}%"
+
+
+def file_hash_lines(paths: Sequence[Path]) -> list[str]:
+    return [f"{sha256(path)}  {path.relative_to(REPO)}" for path in paths]
+
+
+def build_report() -> str:
+    receipts = {
+        (rule, width): load_json(output_path(rule, width), verify_digest=True)
+        for rule in RULES
+        for width in WIDTHS
+    }
+    for (rule, width), receipt in receipts.items():
+        if not receipt.get("complete") or receipt["summary"]["anchor_count"] != 8:
+            raise RuntimeError(f"incomplete final receipt: {rule} {width}")
+        summary = receipt["summary"]
+        if not summary["all_joint_seeds_are_first_fixed_points"]:
+            raise RuntimeError(f"incorrect pairing detected: {rule} {width}")
+        if summary["joint_strict_selection_improvement_count"] != 8:
+            raise RuntimeError(f"joint selection did not improve all anchors: {rule} {width}")
+    strict_curve = [
+        receipts[("STRICT", width)]["summary"]["pairings"]["correct"][
+            "pooled_relative_ee_gain"
+        ]
+        for width in WIDTHS
+    ]
+    sealed_curve = [
+        receipts[("SEALED", width)]["summary"]["pairings"]["correct"][
+            "pooled_relative_ee_gain"
+        ]
+        for width in WIDTHS
+    ]
+    strict_monotone = all(right > left for left, right in zip(strict_curve, strict_curve[1:]))
+    sealed_monotone = all(right > left for left, right in zip(sealed_curve, sealed_curve[1:]))
+    gap_166 = strict_curve[0]
+    gap_332 = strict_curve[2]
+    if gap_166 < 0.0:
+        lead = (
+            f"**Yes. The strict-clearance, correctly paired corrected-rule gap is still negative at 1.66°: "
