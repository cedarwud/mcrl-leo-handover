class ParallelSelectionEvaluator:
    """Persistent fork workers over one detached tape; exact stable reduction."""

    def __init__(self, tape, step_index: int, base, pool) -> None:
        self.tape = tape
        self.step_index = step_index
        self.base = base
        self.pool = pool
        self._evaluated: dict[str, SelectionMetric] = {}
        self._invalid: set[str] = set()
        self.physical_evaluations = 0

    def evaluate_many(self, configs: Sequence[object]) -> None:
        missing_by_id = {
            row.configuration_id: row
            for row in configs
            if row.configuration_id not in self._evaluated
            and row.configuration_id not in self._invalid
        }
        missing = tuple(missing_by_id.values())
        if not missing:
            return
        if self.pool is None:
            results = [_selection_worker((self.step_index, self.base, missing))]
        else:
            shards = tuple(
                tuple(missing[index::SELECTION_WORKERS])
                for index in range(SELECTION_WORKERS)
            )
            results = self.pool.map(
                _selection_worker,
                tuple((self.step_index, self.base, shard) for shard in shards),
                chunksize=1,
            )
        unordered = {}
        for rows, invalid, evaluations in results:
            unordered.update((row.config.configuration_id, row) for row in rows)
            self._invalid.update(invalid)
            self.physical_evaluations += evaluations
        for config in missing:
            if config.configuration_id in unordered:
                self._evaluated[config.configuration_id] = unordered[
                    config.configuration_id
                ]

    def evaluate(self, config) -> SelectionMetric:
        self.evaluate_many((config,))
        try:
            return self._evaluated[config.configuration_id]
        except KeyError:
            raise RuntimeError(
                f"invalid selection configuration {config.configuration_id}"
            ) from None


def coordinate_optimum(*, tape, step_index: int, base, evaluator) -> CoordinateResult:
    """Deterministic cyclic best responses to a strict local optimum."""

    options, _ = probe._legal_options(tape, step_index)
    base_profile = evaluator.evaluate(base)
    guard = served(base_profile)
    current = base
    iterations = 0
    passes = 0
    comparisons = 0
    terminal: tuple[object, ...] = ()

    while True:
        passes += 1
        pass_moves = 0
        pass_candidates = []
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(current_profile)
            candidates = []
            current_map = current.mapping
            for identity in options[user]:
                if identity == current_map[user]:
                    continue
                mapping = dict(current_map)
                mapping[user] = identity
                candidates.append(
                    _configuration(base, mapping, "unilateral-coordinate")
                )
            evaluator.evaluate_many(candidates)
            comparisons += len(candidates)
            pass_candidates.extend(candidates)
            best = current
            best_value = current_value
            for candidate in candidates:
                profile = evaluator._evaluated.get(candidate.configuration_id)
                if profile is None or served(profile) < guard:
                    continue
                value = objective(profile)
                if value > best_value or (
                    value == best_value
                    and best is not current
                    and candidate.configuration_id < best.configuration_id
                ):
                    best = candidate
                    best_value = value
            if best.assignments != current.assignments:
                current = best
                iterations += 1
                pass_moves += 1
        if pass_moves == 0:
            terminal = tuple(pass_candidates)
            break
        print(
            json.dumps(
                {
                    "coordinate_step": step_index,
                    "completed_passes": passes,
                    "moves_in_pass": pass_moves,
                    "completed_improving_moves": iterations,
                    "unique_selection_evaluations": evaluator.physical_evaluations,
                },
                sort_keys=True,
            ),
            flush=True,
        )

    # Every action here was physically evaluated in the terminal certificate.
    # The alternate is chosen per user only to instantiate physically-defined
    # coalition memberships; users are never ranked by this value.
    best_alternatives: dict[int, tuple[int, int]] = {}
    current_map = current.mapping
    for user in sorted(options):
        rows = []
        for identity in options[user]:
            if identity == current_map[user]:
                continue
            mapping = dict(current_map)
            mapping[user] = identity
            candidate = _configuration(base, mapping, "terminal-alternate")
            profile = evaluator._evaluated.get(candidate.configuration_id)
            if profile is not None:
                rows.append((objective(profile), candidate.configuration_id, identity))
        if rows:
            best_alternatives[user] = min(
                rows, key=lambda row: (-row[0], row[1])
            )[2]

    return CoordinateResult(
        current,
        iterations,
        passes,
        terminal,
        best_alternatives,
        comparisons,
    )


def _interference_contributors(
    *, tape, step_index: int, current, victim: int
) -> tuple[int, ...]:
    """Rank users by physical nominal interference, never by reward marginal."""

    mapping = current.mapping
    victim_beam = mapping[victim]
    if victim_beam is None:
        return ()
    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
    step = tape.steps[step_index]
    scores = []
    if step.arrays is not None:
        arrays = step.arrays
        arrays = step.arrays
        victim_row = arrays._row_index().get((victim, victim_beam))
        aggressor_of = arrays._aggressor_index()
        if victim_row is None:
            return ()
        for user, beam in sorted(mapping.items()):
            if user == victim or beam is None or beam == victim_beam:
                continue
            aggressor_index = aggressor_of.get(beam)
            if aggressor_index is None:
                continue
            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
            score = gain / occupancy[beam]
            if score > 0.0:
                scores.append((score, user))
    else:
        boundary = step.boundary_at(0)
        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
        victim_row = by_key.get((victim, victim_beam))
        if victim_row is None:
            return ()
        cross = dict(victim_row.nominal_cross_gain_by_identity)
        for user, beam in sorted(mapping.items()):
            if user == victim or beam is None or beam == victim_beam:
                continue
            score = cross.get(beam, 0.0) / occupancy[beam]
            if score > 0.0:
                scores.append((score, user))
    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))


def build_joint_candidates(
    *, tape, step_index: int, base, unilateral, best_alternatives
) -> tuple[tuple[object, ...], Mapping[tuple, tuple[dict[str, object], ...]], dict[str, int]]:
    """Build a bounded catalogue from occupancy and interference mechanisms."""

    options, _ = probe._legal_options(tape, step_index)
    current_map = unilateral.mapping
    by_beam: dict[tuple[int, int], tuple[int, ...]] = {}
    for beam in sorted({row for row in current_map.values() if row is not None}):
        by_beam[beam] = tuple(
            user for user, identity in sorted(current_map.items()) if identity == beam
        )

    aliases: dict[tuple, list[dict[str, object]]] = {}
    configs: dict[tuple, object] = {}
    family_rows = Counter()

    def add(mapping, *, family: str, coalition: Sequence[int], detail: str) -> None:
        changed = tuple(
            user
            for user in sorted(current_map)
            if mapping[user] != current_map[user]
        )
        if len(changed) < 2:
            return
        assignments = tuple(sorted(mapping.items()))
        aliases.setdefault(assignments, []).append(
            {
                "family": family,
                "coalition_users": list(sorted(coalition)),
                "changed_users": list(changed),
                "detail": detail,
            }
        )
        if assignments not in configs:
            configs[assignments] = _configuration(base, mapping, family)
            family_rows[family] += 1

    occupant_rows = 0
    for beam, occupants in by_beam.items():
        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
            for coalition in itertools.combinations(occupants, size):
                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                    break
                if any(user not in best_alternatives for user in coalition):
                    continue
                mapping = dict(current_map)
                for user in coalition:
                    mapping[user] = best_alternatives[user]
                add(
                    mapping,
                    family="beam-occupant-subset",
                    coalition=coalition,
                    detail=f"origin={beam[0]}:{beam[1]};size={size}",
                )
                occupant_rows += 1
            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                break
        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
            break

    for victim in sorted(current_map):
        if victim not in best_alternatives:
            continue
        contributors = _interference_contributors(
            tape=tape, step_index=step_index, current=unilateral, victim=victim
        )
        for count in (2, 3):
            if len(contributors) < count:
                continue
            coalition = (victim, *contributors[:count])
            if any(user not in best_alternatives for user in coalition):
                continue
            mapping = dict(current_map)
            for user in coalition:
                mapping[user] = best_alternatives[user]
            add(
                mapping,
                family=f"victim-plus-top-{count}-contributors",
                coalition=coalition,
                detail=f"victim={victim};contributors={','.join(map(str, contributors[:count]))}",
            )

    for beam, occupants in by_beam.items():
        if len(occupants) < 2:
            continue
        common = set(options[occupants[0]])
        for user in occupants[1:]:
            common.intersection_update(options[user])
        common.discard(beam)
        for destination in sorted(common):
            mapping = dict(current_map)
            for user in occupants:
                mapping[user] = destination
            add(
                mapping,
                family="complete-beam-evacuation",
                coalition=occupants,
                detail=(
                    f"origin={beam[0]}:{beam[1]};"
                    f"destination={destination[0]}:{destination[1]}"
                ),
            )

    ordered = tuple(configs[key] for key in sorted(configs))
    if len(ordered) > JOINT_CANDIDATE_CAP:
        raise RuntimeError(
            f"mechanism catalogue exceeds fixed bound: {len(ordered)} > {JOINT_CANDIDATE_CAP}"
        )
    return (
        ordered,
        {key: tuple(value) for key, value in aliases.items()},
        dict(sorted(family_rows.items())),
    )


def interference_structure(*, tape, step_index: int, selected) -> dict[str, object]:
    """Classify infeasible user-steps by an exact zero-cross-interference rerun.

    The assignment, beam occupancy, direct links, rate target, RF cap, and all
    other constants are held fixed.  A user-step is interference-limited only
    when it is infeasible with the physical cross-gain matrix and feasible at
    every boundary when that matrix alone is zeroed.  Top-1 share is computed
    over the failing transmissions of those interference-limited user-steps,
    with TDM-slot and trapezoidal boundary weights.
    """

    assignments = selected.mapping
    users = tuple(sorted(assignments))
    actual_all = {user: True for user in users}
    zero_all = {user: True for user in users}
    contributions: dict[int, list[tuple[float, float]]] = {
        user: [] for user in users
    }
    geometries = tape.geometry_for(step_index=step_index, assignments=assignments)
    architecture = (
        MarginAngleRateTPC_TDM()
        if PROVISIONING_RULE == "margin"
        else AngleRateTPC_TDM()
    )
    config = RadiationConfig(fading_quantile_alpha=0.10)
    cap_binding_boundaries = 0
    no_mode_boundaries = 0
    boundary_observations = 0
    occupied_beam_boundary_observations = 0
    occupancy_sum = 0
    occupancy_max = 0
    occupancy_one_uncapped_no_mode_attempts = 0
    occupancy_one_uncapped_no_mode_within_1e8_db = 0
    occupancy_one_uncapped_no_mode_deficits_db = []

    for boundary_index, (_absolute_time, geometry) in enumerate(geometries):
        boundary_observations += 1
        endpoint_weight = 0.5 if boundary_index in (0, len(geometries) - 1) else 1.0
        zeros = np.zeros_like(geometry.nominal_cross_gain)
        zero_geometry = Geometry(geometry.links, zeros, zeros)
        if PROVISIONING_RULE == "margin-strict":
            with strict_clearance_adapter.scalar_formulation("margin-cleared"):
                actual = architecture.radiate(config, geometry, "nominal")
                without_cross = architecture.radiate(
                    config, zero_geometry, "nominal"
                )
        else:
            actual = architecture.radiate(config, geometry, "nominal")
            without_cross = architecture.radiate(config, zero_geometry, "nominal")
        actual_rows = actual.per_user_rate_target_feasible or {}
        zero_rows = without_cross.per_user_rate_target_feasible or {}
        live_users = {link.user_id for link in geometry.links}
        occupancies = Counter(link.beam for link in geometry.links)
        occupied_beam_boundary_observations += len(occupancies)
        occupancy_sum += sum(occupancies.values())
        occupancy_max = max(occupancy_max, max(occupancies.values(), default=0))
        cap_binding_boundaries += int(
            any(
                math.isclose(
                    tx.rf_power_w,
                    config.beam_cap_w,
                    rel_tol=0.0,
                    abs_tol=1.0e-9,
                )
                for slot in actual.slots
                for tx in slot.transmissions
            )
        )
        no_mode_boundaries += int(
            any(
                tx.m_tx is None
                for slot in actual.slots
                for tx in slot.transmissions
            )
        )
        for slot in actual.slots:
            for tx in slot.transmissions:
                uncapped_no_mode_n1 = (
                    occupancies[tx.beam] == 1
                    and tx.m_tx is None
                    and tx.rf_power_w < config.beam_cap_w - 1.0e-9
                )
                if not uncapped_no_mode_n1:
                    continue
                occupancy_one_uncapped_no_mode_attempts += 1
                if tx.margin_predicted_sinr is None:
                    raise RuntimeError("ACM attempt lacks margin-predicted SINR")
                floor = min(
                    ACM_MODES,
                    key=lambda mode: mode.threshold_linear,
                )
                deficit_db = 10.0 * math.log10(
                    floor.threshold_linear / tx.margin_predicted_sinr
                )
                occupancy_one_uncapped_no_mode_deficits_db.append(deficit_db)
                occupancy_one_uncapped_no_mode_within_1e8_db += int(
                    0.0 <= deficit_db <= 1.0e-8
                )
        for user in users:
            actual_all[user] &= user in live_users and bool(actual_rows.get(user, False))
            zero_all[user] &= user in live_users and bool(zero_rows.get(user, False))

        index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
        for slot in actual.slots:
            tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
            for tx in slot.transmissions:
                if tx.rate_target_feasible is None or bool(tx.rate_target_feasible):
                    continue
                victim_index = index_by_user[tx.user_id]
                victim_link = geometry.links[victim_index]
                terms = []
                for aggressor in slot.transmissions:
                    if aggressor.user_id == tx.user_id:
                        continue
                    aggressor_index = index_by_user[aggressor.user_id]
                    aggressor_link = geometry.links[aggressor_index]
                    if aggressor_link.beam == victim_link.beam:
                        continue
                    if aggressor_link.color != victim_link.color:
                        continue
                    term = (
                        float(geometry.nominal_cross_gain[victim_index, aggressor_index])
                        * aggressor.rf_power_w
                    )
                    if term > 0.0:
                        terms.append(term)
                total = math.fsum(terms)
                if total > 0.0:
                    weight = endpoint_weight * slot.fraction
                    contributions[tx.user_id].append((weight * max(terms), weight * total))

    infeasible = tuple(user for user in users if not actual_all[user])
    interference_limited = tuple(
        user for user in infeasible if zero_all[user]
    )
    weighted_top1 = math.fsum(
        top1
        for user in interference_limited
        for top1, _total in contributions[user]
    )
    weighted_total = math.fsum(
        total
        for user in interference_limited
        for _top1, total in contributions[user]
    )
    return {
        "user_steps": len(users),
        "infeasible_user_steps": len(infeasible),
        "interference_limited_user_steps": len(interference_limited),
        "weighted_top1_interference_w": weighted_top1,
        "weighted_total_interference_w": weighted_total,
        "boundary_observations": boundary_observations,
        "cap_binding_boundaries": cap_binding_boundaries,
        "no_eligible_mode_boundaries": no_mode_boundaries,
        "occupancy_one_uncapped_no_mode_attempts": (
            occupancy_one_uncapped_no_mode_attempts
        ),
        "occupancy_one_uncapped_no_mode_within_1e8_db": (
            occupancy_one_uncapped_no_mode_within_1e8_db
        ),
        "occupancy_one_uncapped_no_mode_deficit_db_min": (
            None
            if not occupancy_one_uncapped_no_mode_deficits_db
            else min(occupancy_one_uncapped_no_mode_deficits_db)
        ),
        "occupancy_one_uncapped_no_mode_deficit_db_max": (
            None
            if not occupancy_one_uncapped_no_mode_deficits_db
            else max(occupancy_one_uncapped_no_mode_deficits_db)
        ),
        "occupied_beam_boundary_observations": occupied_beam_boundary_observations,
        "occupancy_sum": occupancy_sum,
        "mean_beam_occupancy": (
            0.0
            if occupied_beam_boundary_observations == 0
            else occupancy_sum / occupied_beam_boundary_observations
        ),
        "max_beam_occupancy": occupancy_max,
        "definition": (
            "infeasible under physical cross-gain and feasible at every boundary "
            "when cross-gain alone is zeroed"
        ),
    }

            ),
            "cap_binding_boundaries": sum(
                int(row["committed"][name]["interference_structure"]["cap_binding_boundaries"])  # type: ignore[index]
                for row in anchors
            ),
            "no_eligible_mode_boundaries": sum(
                int(row["committed"][name]["interference_structure"]["no_eligible_mode_boundaries"])  # type: ignore[index]
                for row in anchors
            ),
            "occupancy_one_uncapped_no_mode_attempts": sum(
                int(row["committed"][name]["interference_structure"]["occupancy_one_uncapped_no_mode_attempts"])  # type: ignore[index]
                for row in anchors
            ),
            "occupancy_one_uncapped_no_mode_within_1e8_db": sum(
                int(row["committed"][name]["interference_structure"]["occupancy_one_uncapped_no_mode_within_1e8_db"])  # type: ignore[index]
                for row in anchors
            ),
            "occupied_beam_boundary_observations": sum(
                int(row["committed"][name]["interference_structure"]["occupied_beam_boundary_observations"])  # type: ignore[index]
                for row in anchors
            ),
            "occupancy_sum": sum(
                int(row["committed"][name]["interference_structure"]["occupancy_sum"])  # type: ignore[index]
                for row in anchors
            ),
            "max_beam_occupancy": max(
                int(row["committed"][name]["interference_structure"]["max_beam_occupancy"])  # type: ignore[index]
                for row in anchors
            ),
        }
        diagnostics = pooled[name]["interference_structure"]
        boundaries = diagnostics["boundary_observations"]
        occupied_beams = diagnostics["occupied_beam_boundary_observations"]
        diagnostics["cap_binding_boundary_share"] = (
            0.0 if boundaries == 0 else diagnostics["cap_binding_boundaries"] / boundaries
        )
        diagnostics["no_eligible_mode_boundary_share"] = (
            0.0
            if boundaries == 0
            else diagnostics["no_eligible_mode_boundaries"] / boundaries
        )
        diagnostics["mean_beam_occupancy"] = (
            0.0 if occupied_beams == 0 else diagnostics["occupancy_sum"] / occupied_beams
        )
        rf = pooled[name]["rf_transmission_observations"]
        pooled[name]["rf_cap_transmission_share"] = (
            0.0 if rf == 0 else pooled[name]["rf_cap_hits"] / rf
        )
    return {
        "anchor_count": len(anchors),
        "world_count": len({str(row["world_domain"]) for row in anchors}),
        "qualifying_coalition_anchor_count": sum(
            bool(row["selection"]["qualifying_coalition_existed"]) for row in anchors  # type: ignore[index]
        ),
        "negative_committed_oracle_gap_anchor_count": sum(
            row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"]  # type: ignore[index]
            is not None
            and row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] < 0.0  # type: ignore[index]
            for row in anchors
        ),
        "pooled": pooled,
        "oracle_set_over_unilateral_relative": relative_gain(
            pooled["ORACLE_SET"]["ee_bit_per_j"],
            pooled["UNILATERAL"]["ee_bit_per_j"],
        ),
        "unilateral_over_baseline_relative": relative_gain(
            pooled["UNILATERAL"]["ee_bit_per_j"],
            pooled["BASELINE"]["ee_bit_per_j"],
        ),
        "exact_evaluation_count": {
            "unique_selection_configurations": sum(
                int(row["selection"]["unique_selection_configuration_evaluations"])  # type: ignore[index]
                for row in anchors
            ),
            "selection_boundary_evaluations": sum(
                int(row["selection"]["selection_physical_boundary_evaluations"])  # type: ignore[index]
                for row in anchors
            ),
            "committed_unique_configurations": sum(
                int(row["committed_unique_configuration_evaluations"])
                for row in anchors
            ),
            "committed_boundary_evaluations": sum(
                int(row["committed_physical_boundary_evaluations"])
                for row in anchors
            ),
            "unilateral_candidate_comparisons": sum(
                int(row["selection"]["unilateral_candidate_comparisons"])  # type: ignore[index]
                for row in anchors
            ),
            "joint_unique_candidates": sum(
                int(row["selection"]["joint_catalogue_unique"])  # type: ignore[index]
                for row in anchors
            ),
        },
    }


def run(
    *,
    worlds: int,
    anchors_per_world: int,
    synthetic: bool,
    one_sided_hp_deg: float,
    provisioning_rule: str,
) -> dict[str, object]:
    from mcrl.physics_v025.provider_legacy import factory as real_factory

    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
        raise RuntimeError("requested run exceeds the fixed 2-world x 5-anchor panel")
    if one_sided_hp_deg not in DECLARED_ONE_SIDED_HP_DEG:
        raise RuntimeError(
            "diagnostic one-sided half-power angle must be one of "
            f"{DECLARED_ONE_SIDED_HP_DEG} degrees"
        )
    full_hpbw_deg = 2.0 * one_sided_hp_deg
    # Runtime-only diagnostic override.  The imported function resolves this
    # module global at call time; no source or constant file is edited.
    channel_module.TX_FULL_HPBW_DEG = full_hpbw_deg
    if provisioning_rule not in {"sealed", "margin", "margin-strict"}:
        raise RuntimeError(
            "provisioning rule must be sealed, margin, or margin-strict"
        )
    global PROVISIONING_RULE
    PROVISIONING_RULE = provisioning_rule
    if provisioning_rule == "margin":
        probe.evaluate_ar_tdm_catalogue = margin_batch.evaluate_ar_tdm_catalogue
    elif provisioning_rule == "margin-strict":
        probe.evaluate_ar_tdm_catalogue = (
            strict_clearance_adapter.evaluate_ar_tdm_catalogue
        )
    else:
        probe.evaluate_ar_tdm_catalogue = __import__(
            "mcrl.physics_v025.batch", fromlist=["evaluate_ar_tdm_catalogue"]
        ).evaluate_ar_tdm_catalogue
    started = time.perf_counter()
    anchors = []
    world_rows = []
    for world_index in range(1, worlds + 1):
        domain = (
            probe.SYNTHETIC_WORLD_DOMAINS[world_index - 1]
            if synthetic
            else probe.PROBE_WORLD_DOMAINS[world_index - 1]
        )
        provider = probe.TinySyntheticProvider(users=3) if synthetic else real_factory()
        world_started = time.perf_counter()
        tape = probe.build_world_tape(
            domain=domain,
            provider=provider,
            steps=anchors_per_world,
            start_time_s=0.0,
        )
        world_rows.append(
            {
                "world_index": world_index,
                "domain": domain,
                "world_sha256": tape.digest,
                "tle_date": tape.tle_date,
                "training_seed": tape.training_seed,
                "construction_wall_seconds": time.perf_counter() - world_started,
            }
        )
        global _WORKER_TAPE
        _WORKER_TAPE = tape
        pool_context = None
        if not synthetic:
            if "fork" not in mp.get_all_start_methods():
                raise RuntimeError("exact parallel selector requires POSIX fork")
            pool_context = mp.get_context("fork").Pool(SELECTION_WORKERS)
        try:
            for step_index in range(anchors_per_world):
                row = evaluate_anchor(
                    tape=tape,
                    world_index=world_index,
                    step_index=step_index,
                    pool=pool_context,
                )
                anchors.append(row)
                print(
                    json.dumps(
                        {
                            "anchor": row["anchor_id"],
                            "unilateral_iterations": row["selection"]["unilateral_iterations"],
                            "joint_candidates": row["selection"]["joint_catalogue_unique"],
                            "qualifying": row["selection"]["qualifying_coalition_existed"],
                            "oracle_ee_gain_pct": (
                                None
                                if row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] is None
                                else 100.0
                                * row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"]
                            ),
                            "wall_seconds": row["wall_seconds"],
                        },
                        sort_keys=True,
                    ),
                    flush=True,
                )
        finally:
            if pool_context is not None:
                pool_context.close()
                pool_context.join()
    result = {
        "schema": "mcrl-v025-beamwidth-design-sweep-network-v2",
        "claim_ceiling": CLAIM_CEILING,
        "beamwidth_diagnostic": {
            "full_hpbw_deg": full_hpbw_deg,
            "off_axis_half_power_deg": one_sided_hp_deg,
            "input_convention": "one-sided off-boresight half-power angle",
            "declared_design_axis_deg": list(DECLARED_ONE_SIDED_HP_DEG),
            "implementation": "runtime-only channel-module global override before tape construction",
            "constant_file_changed": False,
            "all_other_constants_held_fixed": True,
        },
        "provisioning_rule": provisioning_rule,
        "provisioning_definition": (
            "Gamma_margin(e,n)=Gamma(n)/q_0.10(e)"
            if provisioning_rule in {"margin", "margin-strict"}
            else "Gamma(n)"
        ),
        "clearance_implementation": (
            "adjudicated strict post-solve scalar+dense clearance"
            if provisioning_rule == "margin-strict"
            else "inherited single final update and 1+2e-9 nudge"
        ),
        "margin_batch_source_sha256": hashlib.sha256(
            (HERE / "margin_batch.py").read_bytes()
        ).hexdigest(),
        "strict_clearance_source_sha256": (
            strict_clearance_adapter.SOURCE_SHA256
            if provisioning_rule == "margin-strict"
            else None
        ),
        "source_commit": _git("rev-parse", "HEAD"),
        "source_tree": _git("rev-parse", "HEAD^{tree}"),
        "probe_source_sha256": hashlib.sha256(PROBE_PATH.read_bytes()).hexdigest(),
        "python": sys.executable,
        "python_version": platform.python_version(),
        "process_limit": 3,
        "processes_used": 1 if synthetic else 1 + SELECTION_WORKERS,
        "thread_environment": {
            name: os.environ.get(name)
            for name in (
                "OMP_NUM_THREADS",
                "OPENBLAS_NUM_THREADS",
                "MKL_NUM_THREADS",
                "NUMEXPR_NUM_THREADS",
            )
        },
        "test_split_opened": False,
        "learner_used": False,
        "ten_second_deadline": "IGNORED_BY_DESIGN_FOR_CEILING",
        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
        "service_guard": "selection-time served count >= BASELINE served count",
        "worlds": world_rows,
        "anchors": anchors,
        "summary": summarize(anchors),
        "wall_seconds": time.perf_counter() - started,
        "synthetic_self_test": synthetic,
    }
    unsigned = json.dumps(
        result, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")
    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
    parser.add_argument("--one-sided-hp-deg", type=float, required=True)
    parser.add_argument(
        "--provisioning-rule",
        choices=("sealed", "margin", "margin-strict"),
        default="sealed",
    )
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    worlds = 1 if args.self_test else args.worlds
    anchors = 1 if args.self_test else args.anchors_per_world
    result = run(
        worlds=worlds,
        anchors_per_world=anchors,
        synthetic=args.self_test,
        one_sided_hp_deg=args.one_sided_hp_deg,
        provisioning_rule=args.provisioning_rule,
    )
    summary = result["summary"]
    if args.self_test:
        assert summary["anchor_count"] == 1
        assert result["test_split_opened"] is False
        assert result["learner_used"] is False
        print(json.dumps(summary, indent=2, sort_keys=True))
        return 0
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    print(json.dumps(summary, indent=2, sort_keys=True), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
    joules = math.fsum(float(metric["joules"]) for metric in metrics)
    return {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count_sum": sum(int(metric["served_count"]) for metric in metrics),
        "rate_target_attained_count_sum": sum(
            int(metric["rate_target_attained_count"]) for metric in metrics
        ),
        "rate_target_user_count_sum": sum(
            int(metric["rate_target_user_count"]) for metric in metrics
        ),
    }


PAIRINGS = (
    ("J_from_first", "U_first", "correctly_paired"),
    ("J_from_best", "U_best", "archived_pairing"),
    ("J_from_best", "U_first", "cross_old_joint_over_better_local"),
    ("J_from_first", "U_best", "cross_reseeded_joint_over_old_local"),
)


def _summarize(rows: Sequence[Mapping[str, object]]) -> dict:
    pooled = {arm: _pool(rows, arm) for arm in ARMS}
    pairings = {}
    for over, base, name in PAIRINGS:
        per_anchor = [
            {
                "anchor_id": row["anchor_id"],
                "relative_ee_gain": _gain(
                    float(row["committed"][over]["ee_bit_per_j"]),
                    float(row["committed"][base]["ee_bit_per_j"]),
                ),
            }
            for row in rows
        ]
        pairings[name] = {
            "over": over,
            "base": base,
            "pooled_relative_ee_gain": _gain(
                float(pooled[over]["ee_bit_per_j"]),
                float(pooled[base]["ee_bit_per_j"]),
            ),
            "negative_anchor_count": sum(
                row["relative_ee_gain"] < 0.0 for row in per_anchor
            ),
            "zero_anchor_count": sum(row["relative_ee_gain"] == 0.0 for row in per_anchor),
            "positive_anchor_count": sum(row["relative_ee_gain"] > 0.0 for row in per_anchor),
            "per_anchor": per_anchor,
        }

    ub = float(pooled["U_best"]["ee_bit_per_j"])
    uf = float(pooled["U_first"]["ee_bit_per_j"])
    jb = float(pooled["J_from_best"]["ee_bit_per_j"])
    jf = float(pooled["J_from_first"]["ee_bit_per_j"])
    archived = _gain(jb, ub)
    arithmetic = {
        "normalization": "U_best pooled EE",
        "search_order_U_first_minus_U_best": (uf - ub) / ub,
        "correct_coordination_J_from_first_minus_U_first": (jf - uf) / ub,
        "joint_seed_effect_J_from_best_minus_J_from_first": (jb - jf) / ub,
        "sum_equals_archived_span": archived,
    }
    if not math.isclose(
        sum(value for key, value in arithmetic.items() if key != "normalization" and key != "sum_equals_archived_span"),
        archived,
        rel_tol=0.0,
        abs_tol=2e-15,
    ):
        raise RuntimeError("arithmetic decomposition does not close")

    return {
        "anchor_count": len(rows),
        "pooled": pooled,
        "pairings": pairings,
        "joint_arms_same_configuration_count": sum(
            row["committed"]["J_from_best"]["configuration_id"]
            == row["committed"]["J_from_first"]["configuration_id"]
            for row in rows
        ),
        "selected_coalition_size_distribution": {
            arm: dict(
                sorted(
                    Counter(
                        str(row["joint_selection"][arm]["selected_coalition_size"])
                        for row in rows
                    ).items(),
                    key=lambda item: int(item[0]),
                )
            )
            for arm in ("J_from_best", "J_from_first")
        },
        "standing_metric_singleton_re_evaluation_max_abs_delta": {
            arm: {
                key: max(
                    abs(float(row["standing_metric_re_evaluation_delta"][arm][key]))
                    for row in rows
                )
                for key in ("bits", "joules", "ee_bit_per_j")
            }
            for arm in ("BASELINE", "U_best", "U_first", "J_from_best")
        },
        "archived_span_decomposition_additive_relative_to_U_best": arithmetic,
        "archived_span_decomposition_multiplicative": {
            "search_order_U_first_over_U_best": _gain(uf, ub),
            "correct_coordination_J_from_first_over_U_first": _gain(jf, uf),
            "joint_seed_effect_J_from_best_over_J_from_first": _gain(jb, jf),
            "product_minus_one_equals_archived_span": archived,
        },
    }


def _measure_anchor(reference, tape, world_index: int, step_index: int, archived, anytime) -> dict:
    base = reference.probe._base_configuration(tape, step_index, "nearest-eligible")
    archived_committed = archived["committed"]
    u_first_metric = anytime["checkpoints"]["convergence"]
    if base.configuration_id != archived_committed["BASELINE"]["configuration_id"]:
        raise RuntimeError("generated baseline does not match archive")
    u_best = _configuration(reference, base, archived_committed["UNILATERAL"], "reseeded-U-best")
    u_first = _configuration(reference, base, u_first_metric, "reseeded-U-first")

    j_best, select_best = _joint_from_seed(reference, tape, step_index, base, u_best)
    j_first, select_first = _joint_from_seed(reference, tape, step_index, base, u_first)
    if j_best.configuration_id != archived_committed["ORACLE_SET"]["configuration_id"]:
        raise RuntimeError("J_from_best did not reproduce the archived joint selector")

    configs = {
        "BASELINE": base,
        "U_best": u_best,
        "U_first": u_first,
        "J_from_best": j_best,
        "J_from_first": j_first,
    }
    profiles = _committed_profiles(reference, tape, step_index, base, tuple(configs.values()))
    re_evaluated = {
        arm: _committed_metric(reference, profiles[config.configuration_id])
        for arm, config in configs.items()
    }
    sources = {
        "BASELINE": archived_committed["BASELINE"],
        "U_best": archived_committed["UNILATERAL"],
        "U_first": u_first_metric,
        "J_from_best": archived_committed["ORACLE_SET"],
    }
    committed = {
        arm: _source_metric(source, re_evaluated[arm])
        for arm, source in sources.items()
    }
    committed["J_from_first"] = re_evaluated["J_from_first"]

    return {
        "anchor_id": archived["anchor_id"],
        "world_index": world_index,
        "step_index": step_index,
        "world_sha256": tape.digest,
        "guard_reference": "BASELINE selection-time served_PHY count for both joint arms",
        "committed": committed,
        "committed_metric_source": {
            "BASELINE": "archived standing-harness receipt",
            "U_best": "archived standing-harness receipt",
            "U_first": "completed anytime receipt",
            "J_from_best": "archived standing-harness receipt",
            "J_from_first": "new singleton 48-boundary evaluation",
        },
        "standing_metric_re_evaluation_delta": {
            arm: _re_evaluation_delta(source, re_evaluated[arm])
            for arm, source in sources.items()
        },
        "joint_selection": {
            "J_from_best": select_best,
            "J_from_first": select_first,
        },
        "joint_arms_same_configuration": j_best.configuration_id == j_first.configuration_id,
    }


def run_variant(variant_name: str, output: Path, resume: bool = False) -> dict:
    if variant_name not in ARCHIVED:
        raise RuntimeError(f"unsupported variant: {variant_name}")
    tree = sealed_module.verify()
    reference = sealed_module.reference_runner()
    variant, _installed, _sealed = install_variant(variant_name)
    archived_receipt = _load_receipt(ARCHIVED[variant_name])
    anytime_receipt = _load_receipt(ANYTIME[variant_name])
    if not anytime_receipt.get("complete") or len(anytime_receipt["anchors"]) != 20:
        raise RuntimeError("first-improvement receipt is not a complete converged panel")
    first_digest = hashlib.sha256(FIRST_IMPROVEMENT_IMPLEMENTATION.read_bytes()).hexdigest()
    runner_digest = _algorithm_digest()
    reference_digest = hashlib.sha256(sealed_module.REFERENCE_RUNNER.read_bytes()).hexdigest()

    payload = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM_CEILING,
        "complete": False,
        "variant": variant_name,
        "panel": panel_module.FULL20.name,
        "variant_source_sha256": variant.source_sha256,
        "sealed_manifest_sha256": tree.manifest_sha256,
        "probe_source_sha256": tree.probe_sha256,
        "archived_receipt": str(ARCHIVED[variant_name].relative_to(REPO)),
        "archived_receipt_sha256": archived_receipt["receipt_sha256"],
        "anytime_receipt": str(ANYTIME[variant_name].relative_to(REPO)),
        "anytime_receipt_sha256": anytime_receipt["receipt_sha256"],
        "first_improvement_implementation": str(FIRST_IMPROVEMENT_IMPLEMENTATION.relative_to(REPO)),
        "first_improvement_implementation_sha256": first_digest,
        "reseeded_span_implementation": str(RUNNER_IMPLEMENTATION.relative_to(REPO)),
        "reseeded_span_algorithm_sha256": runner_digest,
        "catalogue_implementation": str(sealed_module.REFERENCE_RUNNER.relative_to(REPO)),
        "catalogue_implementation_sha256": reference_digest,
        "catalogue_builder": "the same reference.build_joint_candidates function is invoked for both seeds",
        "catalogue_constants": {
            "occupant_subset_max_size": reference.OCCUPANT_SUBSET_MAX_SIZE,
            "occupant_subset_total_cap": reference.OCCUPANT_SUBSET_TOTAL_CAP,
            "joint_candidate_cap": reference.JOINT_CANDIDATE_CAP,
        },
        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0",
        "tie_break": "higher F, then lexicographically smaller configuration_id among non-seed candidates",
        "service_guard": "each joint arm requires selection-time served_PHY count >= its anchor's BASELINE selection-time served_PHY count",
        "deadline": "none; both bounded catalogues are exhausted",
        "committed_endpoint": "standing metrics retained from their source receipts; new J_from_first and rate-target attainment evaluated over the realised 48-boundary endpoint at fading_quantile_alpha=0.10",
        "arms": list(ARMS),
        "anchors": [],
        "worlds": [],
    }
    if resume and output.exists():
        old = _load_receipt(output)
        for key in (
            "schema",
            "variant",
            "sealed_manifest_sha256",
            "variant_source_sha256",
            "archived_receipt_sha256",
            "anytime_receipt_sha256",
            "first_improvement_implementation_sha256",
            "catalogue_implementation_sha256",
        ):
            if old.get(key) != payload.get(key):
                raise RuntimeError(f"cannot resume: receipt mismatch in {key}")
        payload["anchors"] = old["anchors"]

    archive_by_id = {row["anchor_id"]: row for row in archived_receipt["anchors"]}
    anytime_by_id = {row["anchor_id"]: row for row in anytime_receipt["anchors"]}
    completed = {row["anchor_id"] for row in payload["anchors"]}
    cache = HarnessCache(enabled=True)
    tapes = {}
    from mcrl.physics_v025.provider_legacy import factory as real_factory

    for world_index in panel_module.FULL20.worlds:
        domain = reference.probe.PROBE_WORLD_DOMAINS[world_index - 1]
        key = cache.world_key(
            sealed_manifest=tree.manifest_sha256,
            domain=domain,
            steps=panel_module.FULL20.tape_steps,
            start_time_s=0.0,
            provider="mcrl.physics_v025.provider_legacy.factory",
        )
        tape, meta, elapsed, hit = cache.world(
            key,
            lambda domain=domain: reference.probe.build_world_tape(
                domain=domain,
                provider=real_factory(),
                steps=panel_module.FULL20.tape_steps,
                start_time_s=0.0,
            ),
        )
        tapes[world_index] = tape
        payload["worlds"].append(
            {
                "world_index": world_index,
                "world_sha256": tape.digest,
                "cache_hit": hit,
                "load_or_construction_seconds": elapsed,
                **meta,
            }
        )

    for world_index, step_index in panel_module.FULL20.anchors:
        anchor_id = f"V025_PROBE_R2/world/{world_index}:step/{step_index}"
        if anchor_id in completed:
            continue
        print(json.dumps({"starting_anchor": anchor_id, "variant": variant_name}), flush=True)
        row = _measure_anchor(
            reference,
            tapes[world_index],
            world_index,
            step_index,
            archive_by_id[anchor_id],
            anytime_by_id[anchor_id],
        )
        payload["anchors"].append(row)
        payload["anchors"].sort(key=lambda item: (item["world_index"], item["step_index"]))
        payload["summary"] = _summarize(payload["anchors"])
        _write_receipt(payload, output)
        print(
            json.dumps(
                {
                    "finished_anchor": anchor_id,
                    "J_from_best_size": row["joint_selection"]["J_from_best"]["selected_coalition_size"],
                    "J_from_first_size": row["joint_selection"]["J_from_first"]["selected_coalition_size"],
                    "same_joint_configuration": row["joint_arms_same_configuration"],
                },
                sort_keys=True,
            ),
            flush=True,
        )

    payload["complete"] = len(payload["anchors"]) == len(panel_module.FULL20.anchors)
    payload["summary"] = _summarize(payload["anchors"])
    _write_receipt(payload, output)
    return payload


def _pct(value: float) -> str:
    return f"{100.0 * value:+.4f}%"


def _short_anchor(anchor_id: str) -> str:
    return anchor_id.replace("V025_PROBE_R2/world/", "w").replace(":step/", "/s")


def _display_path(path: Path) -> Path:
    resolved = path.resolve()
    try:
        return resolved.relative_to(REPO)
    except ValueError:
        return path


def build_report(sealed_path: Path, margin_path: Path) -> str:
    receipts = {
        "SEALED": _load_receipt(sealed_path),
        "MARGIN_Q": _load_receipt(margin_path),
    }
    for name, receipt in receipts.items():
        if not receipt.get("complete") or receipt.get("variant") != name:
            raise RuntimeError(f"incomplete or mismatched receipt: {name}")

    correct = {
        name: receipt["summary"]["pairings"]["correctly_paired"]["pooled_relative_ee_gain"]
        for name, receipt in receipts.items()
    }
    negative = {
        name: receipt["summary"]["pairings"]["correctly_paired"]["negative_anchor_count"]
        for name, receipt in receipts.items()
    }
    lead_qualifier = (
        "Near-zero/negative correctly paired coordination span"
        if any(value <= 0.005 for value in correct.values())
        else "Correctly paired coordination span"
    )
    lines = [
        f"**{lead_qualifier} (`J_from_first` over `U_first`): `SEALED` {_pct(correct['SEALED'])} ({negative['SEALED']}/20 negative anchors); `MARGIN_Q` {_pct(correct['MARGIN_Q'])} ({negative['MARGIN_Q']}/20 negative anchors).**",
        "",
        "# Reseeded coordination span — V0.25 twenty-anchor panel",
        "",
        "`DIAGNOSTIC_NOT_CLAIM`. No learner, training run, or policy run was performed. No sealed constant, threshold, sign, seed, horizon, price, service guard, acceptance rule, sealed artefact, or frozen manifest was changed.",
        "",
        "## Direct answers",
        "",
    ]
    sp = receipts["SEALED"]["summary"]["pairings"]
    mp = receipts["MARGIN_Q"]["summary"]["pairings"]
    strict = {
        name: sum(
            bool(row["joint_selection"]["J_from_first"]["strict_selection_objective_improvement"])
            for row in receipt["anchors"]
        )
        for name, receipt in receipts.items()
    }
    lines.extend([
        f"1. **Same-search coordination span:** **SEALED {_pct(sp['correctly_paired']['pooled_relative_ee_gain'])}**; **MARGIN_Q {_pct(mp['correctly_paired']['pooled_relative_ee_gain'])}**.",
        "",
        f"2. **Does the joint selector beat its own better seed?** In the selection-time objective, yes: strict improvement on {strict['SEALED']}/20 `SEALED` anchors and {strict['MARGIN_Q']}/20 `MARGIN_Q` anchors. In committed EE, `SEALED` is positive/zero/negative on {sp['correctly_paired']['positive_anchor_count']}/{sp['correctly_paired']['zero_anchor_count']}/{sp['correctly_paired']['negative_anchor_count']} anchors; `MARGIN_Q` is {mp['correctly_paired']['positive_anchor_count']}/{mp['correctly_paired']['zero_anchor_count']}/{mp['correctly_paired']['negative_anchor_count']}. The signed per-anchor values are below.",
        "",
        f"3. **How much was search-order artefact?** The archived headline changes from {_pct(sp['archived_pairing']['pooled_relative_ee_gain'])} to {_pct(sp['correctly_paired']['pooled_relative_ee_gain'])} under `SEALED`, an overstatement of {100.0 * (sp['archived_pairing']['pooled_relative_ee_gain'] - sp['correctly_paired']['pooled_relative_ee_gain']):.4f} percentage points. Under `MARGIN_Q`, it changes from {_pct(mp['archived_pairing']['pooled_relative_ee_gain'])} to {_pct(mp['correctly_paired']['pooled_relative_ee_gain'])}, an understatement of {100.0 * (mp['correctly_paired']['pooled_relative_ee_gain'] - mp['archived_pairing']['pooled_relative_ee_gain']):.4f} points. The exact three-way decomposition below separates unilateral search order, correctly paired coordination, and joint-seed effect.",
    ])
    lines.extend([
        "",
        "The selection-time and committed signs answer different questions: selection uses the fixed one-boundary exact `F`, while the reported coordination span uses the 48-boundary committed EE.",
        "",
        "## Pooled committed endpoint",
        "",
        "Efficiency is pooled as `sum(bits) / sum(joules)` over the same twenty anchors.",
        "",
        "| rule | arm | bits (Tbit) | joules | EE (Mbit/J) |",
        "|---|---|---:|---:|---:|",
    ])
    for name in ("SEALED", "MARGIN_Q"):
        pooled = receipts[name]["summary"]["pooled"]
        for arm in ARMS:
            row = pooled[arm]
            lines.append(
                f"| `{name}` | `{arm}` | {row['bits'] / 1e12:.6f} | {row['joules']:.6f} | {row['ee_bit_per_j'] / 1e6:.6f} |"
            )

    lines.extend([
        "",
        "## Served count and rate-target attainment (separate outcomes)",
        "",
        "`served_PHY` counts positive realised decoding time. `rate_target_attained` counts users whose integrated committed bits reach the fixed rate target. They are reported independently and are not combined into one service measure.",
        "",
        "| rule | arm | served_PHY count | rate-target attained | anchor-user observations |",
        "|---|---|---:|---:|---:|",
    ])
    for name in ("SEALED", "MARGIN_Q"):
        pooled = receipts[name]["summary"]["pooled"]
        for arm in ARMS:
            row = pooled[arm]
            lines.append(
                f"| `{name}` | `{arm}` | {row['served_count_sum']} | {row['rate_target_attained_count_sum']} | {row['rate_target_user_count_sum']} |"
            )

    lines.extend([
        "",
        "## All four pairings",
        "",
        "| rule | pairing | pooled EE gain | negative / zero / positive anchors |",
        "|---|---|---:|---:|",
    ])
    pairing_order = (
                    if reference.objective(profile) > current_value:
                        accepted = candidate
                        break
                if accepted is not None:
                    current = accepted
                    accepted_moves += 1
                    moves_this_pass += 1
                    moves.append((timed.elapsed(), current))
                    break
        pass_finished = timed.elapsed()
        if moves_this_pass == 0:
            finding_seconds = pass_started
            certification_seconds = pass_finished - pass_started
            finding_profiles = profiles_before_pass
            finding_invalid = invalid_before_pass
            finding_completed_at = completed_before_pass
            terminal_evaluations = timed.evaluator.physical_evaluations - physical_before_pass
            break
        passes_with_moves += 1
        pass_rows.append(
            {
                "pass": passes_with_moves,
                "started_seconds": pass_started,
                "finished_seconds": pass_finished,
                "accepted_moves": moves_this_pass,
            }
        )

    receipt = {
        "algorithm": "deterministic cyclic first-improvement",
        "candidate_order": "users sorted; each user's sealed legal options in sealed order",
        "microbatch_size": UNILATERAL_BATCH_SIZE,
        "baseline_served_guard": guard,
        "legal_option_census": census,
        "accepted_moves": accepted_moves,
        "passes_with_moves": passes_with_moves,
        "candidate_comparisons_through_certificate": candidate_comparisons,
        "physically_submitted_candidates_through_certificate": physically_submitted,
        "finding_physical_evaluations": physical_before_pass,
        "terminal_certificate_physical_evaluations": terminal_evaluations,
        "last_improvement_seconds": moves[-1][0],
        "finding_seconds": finding_seconds,
        "terminal_certificate_seconds": certification_seconds,
        "measured_total_including_certificate_seconds": pass_finished,
        "terminal_certificate_excluded_from_anytime": True,
        "passes": pass_rows,
        "move_times_seconds": [row[0] for row in moves[1:]],
        "selected": _config_payload(current),
    }
    return UnilateralRun(
        base,
        current,
        moves,
        receipt,
        finding_profiles,
        finding_invalid,
        finding_completed_at,
    )


def config_at(run: UnilateralRun, seconds: float):
    selected = run.base
    for accepted_at, config in run.moves:
        if accepted_at > seconds:
            break
        selected = config
    return selected


def _best_alternatives_with_budget(
    reference,
    tape,
    step_index: int,
    base,
    seed,
    timed: TimedEvaluator,
    allowance: float,
):
    options, _ = reference.probe._legal_options(tape, step_index)
    best_alternatives: dict[int, tuple[int, int]] = {}
    comparisons = 0
    for user in sorted(options):
        candidates = tuple(
            _candidate(reference, base, seed, user, identity, "joint-seed-alternate")
            for identity in options[user]
            if identity != seed.mapping[user]
        )
        # Per-user batching matches the archived construction of a physically
        # best alternate, while allowing a budget check between users.
        if timed.elapsed() >= allowance:
            return None, comparisons, "alternate-sweep-budget"
        timed.evaluate_many(candidates)
        if timed.elapsed() > allowance:
            return None, comparisons, "alternate-sweep-budget"
        rows = []
        for candidate in candidates:
            comparisons += 1
            profile = timed.evaluator._evaluated.get(candidate.configuration_id)
            if profile is not None:
                rows.append(
                    (
                        reference.objective(profile),
                        candidate.configuration_id,
                        candidate.mapping[user],
                    )
                )
        if rows:
            best_alternatives[user] = min(rows, key=lambda row: (-row[0], row[1]))[2]
    return best_alternatives, comparisons, None


def deadline_joint_search(
    reference,
    tape,
    step_index: int,
    run: UnilateralRun,
    seed_seconds: float,
) -> tuple[object, dict[str, object]]:
    """Use only the time remaining to 30.08 s after obtaining a timed seed."""

    seed = config_at(run, seed_seconds)
    allowance = max(0.0, DEADLINE_SECONDS - seed_seconds)
    if allowance == 0.0:
        return seed, {
            "seed_seconds": seed_seconds,
            "joint_allowance_seconds": 0.0,
            "joint_wall_seconds": 0.0,
            "total_end_to_end_seconds": seed_seconds,
            "stopped_phase": "no-budget-after-seed",
            "catalogue_complete": False,
            "catalogue_unique": 0,
            "joint_candidates_completed": 0,
            "joint_improvements_accepted": 0,
            "selected": _config_payload(seed),
        }

    started = time.perf_counter()
    timed = TimedEvaluator.create(reference, tape, step_index, run.base, started)
    available_profiles = {
        key: profile
        for key, profile in run.finding_profiles.items()
        if run.finding_completed_at.get(key, math.inf) <= seed_seconds
    }
    available_invalid = {
        key
        for key in run.finding_invalid
        if run.finding_completed_at.get(key, math.inf) <= seed_seconds
    }
    timed.preload(available_profiles, tuple(available_invalid))
    seed_profile = timed.evaluator._evaluated.get(seed.configuration_id)
    if seed_profile is None:
        seed_profile = timed.profile(seed)
    base_profile = timed.evaluator._evaluated.get(run.base.configuration_id)
    if base_profile is None:
        base_profile = timed.profile(run.base)
    if seed_profile is None or base_profile is None:
        raise RuntimeError("joint search seed or base is invalid")
    guard = reference.served(base_profile)
    best = seed
    best_profile = seed_profile

    alternatives, alternate_comparisons, stopped = _best_alternatives_with_budget(
        reference, tape, step_index, run.base, seed, timed, allowance
    )
    candidates: tuple[object, ...] = ()
    aliases = {}
    family_counts = {}
    completed = 0
    improvements = 0
    catalogue_complete = False
    crossed_budget_by = 0.0

    if alternatives is not None:
        candidates, aliases, family_counts = reference.build_joint_candidates(
            tape=tape,
            step_index=step_index,
            base=run.base,
            unilateral=seed,
            best_alternatives=alternatives,
        )
        catalogue_complete = True
        if timed.elapsed() > allowance:
            stopped = "catalogue-construction-budget"
        else:
            stopped = "catalogue-exhausted"
            for offset in range(0, len(candidates), JOINT_BATCH_SIZE):
                if timed.elapsed() >= allowance:
                    stopped = "joint-evaluation-budget"
                    break
                batch = candidates[offset : offset + JOINT_BATCH_SIZE]
                timed.evaluate_many(batch)
                elapsed = timed.elapsed()
                if elapsed > allowance:
                    crossed_budget_by = elapsed - allowance
                    stopped = "joint-evaluation-budget"
                    break
                completed += len(batch)
                for candidate in batch:
                    profile = timed.evaluator._evaluated.get(candidate.configuration_id)
                    if profile is None or reference.served(profile) < guard:
                        continue
                    value = reference.objective(profile)
                    best_value = reference.objective(best_profile)
                    if value > best_value or (
                        value == best_value
                        and best is not seed
                        and candidate.configuration_id < best.configuration_id
                    ):
                        best = candidate
                        best_profile = profile
                        improvements += 1

    elapsed = timed.elapsed()
    available_at = (
        seed_seconds + elapsed
        if stopped == "catalogue-exhausted"
        else DEADLINE_SECONDS
    )
    return best, {
        "seed_seconds": seed_seconds,
        "joint_allowance_seconds": allowance,
        "unilateral_cache_profiles_available": len(available_profiles),
        "unilateral_cache_invalid_available": len(available_invalid),
        "alternate_comparisons": alternate_comparisons,
        "joint_wall_seconds": elapsed,
        "budget_crossing_overshoot_seconds": crossed_budget_by,
        "total_end_to_end_seconds": available_at,
        "stopped_phase": stopped,
        "catalogue_complete": catalogue_complete,
        "catalogue_unique": len(candidates),
        "catalogue_aliases": sum(len(rows) for rows in aliases.values()),
        "family_unique_counts": family_counts,
        "joint_microbatch_size": JOINT_BATCH_SIZE,
        "joint_candidates_completed": completed,
        "joint_improvements_accepted": improvements,
        "selected": _config_payload(best),
    }


def _committed_profiles(reference, tape, step_index: int, base, configs):
    evaluator = reference.probe.StepEvaluator(
        tape,
        reference.probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=reference.probe.run_setting_for("a-r0"),
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    unique = {row.configuration_id: row for row in configs}
    evaluator.evaluate_many(tuple(unique.values()))
    return {
        key: evaluator._evaluated[value.configuration_id]
        for key, value in unique.items()
        if value.configuration_id in evaluator._evaluated
    }


def measure_anchor(reference, tape, world_index: int, step_index: int, archived) -> dict:
    run = first_improvement_unilateral(reference, tape, step_index)
    checkpoint_configs = {
        f"{seconds:g}": config_at(run, seconds) for seconds in CHECKPOINTS
    }
    checkpoint_configs["convergence"] = run.selected
    joint_configs = {}
    joint_rows = {}
    for seconds in JOINT_SEED_SECONDS:
        key = f"{seconds:g}"
        joint_configs[key], joint_rows[key] = deadline_joint_search(
            reference, tape, step_index, run, seconds
        )

    all_configs = [run.base, *checkpoint_configs.values(), *joint_configs.values()]
    committed = _committed_profiles(
        reference, tape, step_index, run.base, all_configs
    )

    def metric(config):
        try:
            return _metric_payload(reference, committed[config.configuration_id])
        except KeyError:
            raise RuntimeError(
                f"committed configuration invalid: {config.configuration_id}"
            ) from None

    base_metric = metric(run.base)
    checkpoints = {key: metric(config) for key, config in checkpoint_configs.items()}
    for key, config in joint_configs.items():
        joint_rows[key]["committed"] = metric(config)

    archived_unilateral = archived["committed"]["UNILATERAL"]
    return {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "step_index": step_index,
        "world_domain": tape.domain,
        "world_sha256": tape.digest,
        "baseline": base_metric,
        "unilateral": run.receipt,
        "checkpoints": checkpoints,
        "joint_within_30_08": joint_rows,
        "first_improvement_fixed_point_matches_archived_best_improvement": (
            checkpoints["convergence"]["assignments"]
            == archived_unilateral["assignments"]
        ),
        "archived_best_improvement": archived_unilateral,
    }


def _pool_metrics(rows: Sequence[Mapping[str, object]], accessor) -> dict[str, object]:
    metrics = [accessor(row) for row in rows]
    bits = math.fsum(float(row["bits"]) for row in metrics)
    joules = math.fsum(float(row["joules"]) for row in metrics)
    return {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count_sum": sum(int(row["served_count"]) for row in metrics),
    }


def _gain(numerator: float, denominator: float) -> float:
    return numerator / denominator - 1.0


def summarize(rows: Sequence[Mapping[str, object]]) -> dict[str, object]:
    baseline = _pool_metrics(rows, lambda row: row["baseline"])
    archived_convergence = _pool_metrics(
        rows, lambda row: row["archived_best_improvement"]
    )
    curve = {}
    for key in (*[f"{value:g}" for value in CHECKPOINTS], "convergence"):
        pooled = _pool_metrics(rows, lambda row, key=key: row["checkpoints"][key])
        per_anchor_gain = [
            _gain(
                float(row["checkpoints"][key]["ee_bit_per_j"]),
                float(row["baseline"]["ee_bit_per_j"]),
            )
            for row in rows
        ]
        curve[key] = {
            "pooled": pooled,
            "pooled_gain_over_baseline": _gain(
                float(pooled["ee_bit_per_j"]), float(baseline["ee_bit_per_j"])
            ),
            "paired_anchor_gain_over_baseline_distribution": distribution(per_anchor_gain),
            "per_anchor_gain_over_baseline": [
                {"anchor_id": row["anchor_id"], "gain": value}
                for row, value in zip(rows, per_anchor_gain)
            ],
        }

    deadline_gain = float(curve["30.08"]["pooled_gain_over_baseline"])
    converged_gain = float(curve["convergence"]["pooled_gain_over_baseline"])
    archived_converged_gain = _gain(
        float(archived_convergence["ee_bit_per_j"]),
        float(baseline["ee_bit_per_j"]),
    )
    anchor_fractions = []
    archived_anchor_fractions = []
    for row in rows:
        base_ee = float(row["baseline"]["ee_bit_per_j"])
        deadline_ee = float(row["checkpoints"]["30.08"]["ee_bit_per_j"])
        converged_ee = float(row["checkpoints"]["convergence"]["ee_bit_per_j"])
        denominator = converged_ee - base_ee
        fraction = None if denominator == 0.0 else (deadline_ee - base_ee) / denominator
        anchor_fractions.append({"anchor_id": row["anchor_id"], "fraction": fraction})
        archived_ee = float(row["archived_best_improvement"]["ee_bit_per_j"])
        archived_denominator = archived_ee - base_ee
        archived_fraction = (
            None
            if archived_denominator == 0.0
            else (deadline_ee - base_ee) / archived_denominator
        )
        archived_anchor_fractions.append(
            {"anchor_id": row["anchor_id"], "fraction": archived_fraction}
        )
    defined_fractions = [
        float(row["fraction"]) for row in anchor_fractions if row["fraction"] is not None
    ]
    defined_archived_fractions = [
        float(row["fraction"])
        for row in archived_anchor_fractions
        if row["fraction"] is not None
    ]

    certification = {
        "finding_seconds": distribution(
            [float(row["unilateral"]["finding_seconds"]) for row in rows]
        ),
        "last_improvement_seconds": distribution(
            [float(row["unilateral"]["last_improvement_seconds"]) for row in rows]
        ),
        "terminal_certificate_seconds": distribution(
            [float(row["unilateral"]["terminal_certificate_seconds"]) for row in rows]
        ),
        "total_including_certificate_seconds": distribution(
            [
                float(row["unilateral"]["measured_total_including_certificate_seconds"])
                for row in rows

