+        ]
+        for width in WIDTHS
+    ]
+    sealed_curve = [
+        receipts[("SEALED", width)]["summary"]["pairings"]["correct"][
+            "pooled_relative_ee_gain"
+        ]
+        for width in WIDTHS
+    ]
+    strict_monotone = all(right > left for left, right in zip(strict_curve, strict_curve[1:]))
+    sealed_monotone = all(right > left for left, right in zip(sealed_curve, sealed_curve[1:]))
+    gap_166 = strict_curve[0]
+    gap_332 = strict_curve[2]
