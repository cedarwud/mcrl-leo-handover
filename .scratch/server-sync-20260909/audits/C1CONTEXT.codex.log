            if knockout != "C1":
                total += model.score("C1", table.q1_states[selected]) - model.score(
                    "C1", table.q1_states[baseline]
                )
            if knockout != "C2":
                total += model.score("C2", table.q2_states[selected]) - model.score(
                    "C2", table.q2_states[baseline]
                )
        return total

