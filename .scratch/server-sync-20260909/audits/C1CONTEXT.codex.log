"""Level-vs-order learnability probe for the C1 target (DIAGNOSTIC_NOT_CLAIM).

Offline numpy fits on the probe output of scripts/probe_c1_production_target.py.
This is NOT a pipeline training run: no checkpoint, receipt, manifest or sealed
artefact is read or written, no constant/threshold/seed/horizon is changed, and
no learner in src/ is invoked.  It exists only to estimate how hard the *value*
problem is versus the *ordering* problem for the same admissible 16-D Q1 vector.

Anchors are split 16 train / 8 test so nothing here is an in-sample claim.

    PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \
        scripts/probe_c1_learnability.py
"""

from __future__ import annotations

import json
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / ".scratch" / "c1c2-target-design"
TRAIN_ANCHORS = 16
STEPS = 6000


def mlp_init(widths, rng):
    weights = [rng.normal(0.0, np.sqrt(2.0 / a), (a, b)) for a, b in zip(widths[:-1], widths[1:])]
    biases = [np.zeros(b) for b in widths[1:]]
    return weights, biases


def mlp_forward(weights, biases, x):
    acts = [x]
    pres = []
    cur = x
    for index, (w, b) in enumerate(zip(weights, biases)):
        pre = cur @ w + b
        pres.append(pre)
        cur = pre if index == len(weights) - 1 else np.maximum(pre, 0.0)
        acts.append(cur)
    return cur[:, 0], acts, pres


def mlp_backward(weights, acts, pres, dout):
    grad = dout[:, None]
    gw = [None] * len(weights)
    gb = [None] * len(weights)
    for index in reversed(range(len(weights))):
        gw[index] = acts[index].T @ grad
        gb[index] = grad.sum(axis=0)
        if index:
            grad = grad @ weights[index].T
            grad = grad * (pres[index - 1] > 0.0)
    return gw, gb


def adam_fit(x, y, widths, seed, *, steps=STEPS, lr=1e-3, pairs=None):
    """Full-batch Adam.  Squared loss on y, or pairwise logistic loss if pairs."""
    rng = np.random.default_rng(seed)
    weights, biases = mlp_init(widths, rng)
    mw = [np.zeros_like(v) for v in weights]
    vw = [np.zeros_like(v) for v in weights]
    mb = [np.zeros_like(v) for v in biases]
    vb = [np.zeros_like(v) for v in biases]
    for step in range(1, steps + 1):
        pred, acts, pres = mlp_forward(weights, biases, x)
        if pairs is None:
            dout = (2.0 / x.shape[0]) * (pred - y)
        else:
            left, right = pairs
            margin = pred[left] - pred[right]
            sigmoid = 1.0 / (1.0 + np.exp(-np.clip(margin, -30, 30)))
            dout = np.zeros_like(pred)
            np.add.at(dout, left, (sigmoid - 1.0) / left.size)
            np.add.at(dout, right, (1.0 - sigmoid) / left.size)
        gw, gb = mlp_backward(weights, acts, pres, dout)
        for arrays, grads, first, second in ((weights, gw, mw, vw), (biases, gb, mb, vb)):
            for i in range(len(arrays)):
                first[i] = 0.9 * first[i] + 0.1 * grads[i]
                second[i] = 0.999 * second[i] + 0.001 * grads[i] * grads[i]
                arrays[i] -= lr * (first[i] / (1 - 0.9**step)) / (
                    np.sqrt(second[i] / (1 - 0.999**step)) + 1e-8
                )
    return weights, biases


def order_metrics(score, truth, groups):
    concordant = comparable = hits = total = 0
    for gid in np.unique(groups):
        mask = groups == gid
        t, s = truth[mask], score[mask]
        if t.size < 2:
            continue
        dt = t[:, None] - t[None, :]
        ds = s[:, None] - s[None, :]
        upper = np.triu(np.ones_like(dt, dtype=bool), 1) & (np.abs(dt) > 0)
        comparable += int(upper.sum())
        concordant += int((upper & (np.sign(dt) == np.sign(ds))).sum())
        total += 1
        hits += int(t[int(np.argmax(s))] >= t.max() - 1e-12)
    return {
        "pairwise_order_acc": concordant / comparable if comparable else float("nan"),
        "top1": hits / total if total else float("nan"),
        "pairs": comparable,
        "groups": total,
    }


def r2(pred, truth):
    total = float(((truth - truth.mean()) ** 2).sum())
    return 1.0 - float(((truth - pred) ** 2).sum()) / total if total else float("nan")


def build_pairs(groups, truth, rng, cap=200000):
    left, right = [], []
    for gid in np.unique(groups):
        idx = np.flatnonzero(groups == gid)
        for a in range(len(idx)):
            for b in range(a + 1, len(idx)):
                i, j = idx[a], idx[b]
                if truth[i] == truth[j]:
                    continue
                if truth[i] > truth[j]:
                    left.append(i); right.append(j)
                else:
                    left.append(j); right.append(i)
    left = np.asarray(left); right = np.asarray(right)
    if left.size > cap:
        pick = rng.choice(left.size, cap, replace=False)
        left, right = left[pick], right[pick]
    return left, right


def main() -> None:
    payload = json.loads((OUT / "production-c1.json").read_text())
    recs = [r for r in payload["records"] if r["q1_state"] is not None]
    x = np.array([r["q1_state"] for r in recs])
    y = np.array([r["y"] for r in recs])
    cheap = np.array([r["own"] + r["phi"] for r in recs])
    anchor = np.array([r["anchor"] for r in recs])
    group = np.unique(np.array([f"{a}|{u}" for a, u in zip(anchor, [r["user"] for r in recs])]),
                      return_inverse=True)[1]
    train = anchor < TRAIN_ANCHORS
    test = ~train
    rng = np.random.default_rng(20260910)

    results: dict[str, object] = {
        "train_rows": int(train.sum()), "test_rows": int(test.sum()),
        "train_anchors": TRAIN_ANCHORS, "test_anchors": int(len(set(anchor[test].tolist()))),
        "note": "held-out by anchor; relu MLP, full-batch Adam, 6000 steps",
    }

    configs = {
        "production_head_16_8_1_regression_on_y": ((x.shape[1], 8, 1), y, None),
        "wide_16_64_64_1_regression_on_y": ((x.shape[1], 64, 64, 1), y, None),
        "wide_16_64_64_1_regression_on_own_plus_phi": ((x.shape[1], 64, 64, 1), cheap, None),
    }
    for name, (widths, target, _) in configs.items():
        w, b = adam_fit(x[train], target[train], widths, seed=7)
        pred_test, _, _ = mlp_forward(w, b, x[test])
        entry = {
            "test_r2_on_own_target": r2(pred_test, target[test]),
            "test_r2_against_production_y": r2(pred_test, y[test]),
            "test_order_vs_production_y": order_metrics(pred_test, y[test], group[test]),
            "test_sign_accuracy_vs_production_y": float(
                np.mean((pred_test > 0) == (y[test] > 0))
            ),
        }
        results[name] = entry

    # Ranking objective: same capacity, no level supervision at all.
    pairs = build_pairs(group[train], y[train], rng)
    w, b = adam_fit(x[train], y[train], (x.shape[1], 64, 64, 1), seed=7, pairs=pairs)
    pred_test, _, _ = mlp_forward(w, b, x[test])
    results["wide_16_64_64_1_pairwise_ranking_loss"] = {
        "train_pairs": int(pairs[0].size),
        "test_order_vs_production_y": order_metrics(pred_test, y[test], group[test]),
        "note": "scale-free; no r2 is meaningful",
    }

    # Reference ceilings.
    results["reference"] = {
        "chance_pairwise": 0.5,
        "oracle_own_plus_energy_plus_phi_order": order_metrics(
            np.array([r["own"] + r["energy"] + r["phi"] for r in recs])[test], y[test], group[test]
        ),
        "test_y_sd": float(y[test].std()),
        "test_frac_positive_y": float((y[test] > 0).mean()),
    }

    (OUT / "learnability.json").write_text(json.dumps(results, indent=2, default=float))
    print(json.dumps(results, indent=2, default=float))


if __name__ == "__main__":
    main()
