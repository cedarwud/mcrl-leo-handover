+    parser.add_argument("--phase", choices=("build", "tune", "final"), required=True)
+    parser.add_argument("--anchor-part", choices=("development", "test"))
+    args = parser.parse_args(argv)
+    OUT.mkdir(parents=True, exist_ok=True)
+    if args.phase == "build":
+        if args.anchor_part is None:
