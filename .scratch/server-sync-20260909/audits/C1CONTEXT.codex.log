index 0000000000000000000000000000000000000000..4ffbd50f2b6aaaf75cdec8286fc659b67e904bef
--- /dev/null
+++ b/.scratch/c1-resource-context/spec.md
@@ -0,0 +1,55 @@
+# C1 resource-context diagnostic specification
+
+`DIAGNOSTIC_NOT_CLAIM`. Frozen before any fit for this diagnostic.
+
+## Protocol
+
+- Reuse `scripts/compare_target_parametrisations.py`: exact coalition corpus,
+  split function, seed `20260910`, fixed-ReLU random-feature ridge with raw
+  linear skip, grid `width in {64,128}` by `ridge in {1e-6,1e-4,1e-2}`,
+  validation-RMSE selection, and final train+validation refit.
+- A fitting row is exactly one coalition row from that comparison. A shared
+  per-user scorer is fitted through the sum of its member-level feature
+  differences, so every arm sees exactly the same fitting rows.
+- Exact singleton labels come only from the corpus Fraction receipts. The pilot
+  fallback label is never read as a target.
+- `Q1_ONLY`: selected-minus-reference random-feature design over the sealed
+  16-D Q1 state.
+- `Q1_PLUS_CONTEXT`: the same pairwise design over Q1 plus all admissible 163
+  resource coordinates. Because the stored interaction vector is coalition
+  wide, each resource vector is rebuilt for the singleton transition from the
+  reference profile using the same encoder formulas. The reference resource
+  vector is zero, fixing the exact base-action gauge.
+- `Q1_PLUS_CONTEXT_MINUS_EXTERNALITY`: identical features, fitted to the sum
+  of `own + energy + phi` exact singleton terms. Its reported held-out metrics
+  are nevertheless against the full exact C1 target, matching the stated
+  externality-removal oracle comparison.
+- `LEAKY_ORACLE`: `own, externality, energy, phi` as inputs to the same
+  estimator family and grid, fitted to full exact C1; marked `NOT_DEPLOYABLE`.
+- Each arm chooses once from the frozen grid by validation RMSE against its
+  declared fitting target. No post-test tuning.
+
+## Metrics
+
+- Held-out explained variance `1 - Var(error)/Var(target)` and RMSE against
+  exact full C1.
+- Pairwise ordering is micro-accuracy over every unequal exact pair within a
+  `(world, anchor, user)` candidate pool. The exact zero/base action is included
+  with prediction zero. Predicted ties are incorrect.
+- The same three metrics are reported for each held-out anchor.
+- Leave-one-step-out spread is the minimum and maximum metric obtained by
+  omitting each held-out `(world, anchor_index // 3)` block in turn.
+- Context attribution is one no-refit permutation-importance pass on the held-
+  out set: for each coordinate, permute that coordinate among non-base actions
+  within each candidate pool using deterministic SHA-256 ranks salted by seed
+  and coordinate; importance is baseline ordering minus permuted ordering.
+- End-to-end metric is mean exact selection regret on the parametrisation
+  comparison's held-out pools after adding the same frozen learned interaction
+  prediction to `Q1_ONLY` or `Q1_PLUS_CONTEXT` coalition sums.
+
+## Materiality convention
+
+The context gain is called material only if it is at least `0.0252` absolute
+pairwise-ordering points (10% of the stated `0.650 -> 0.902` gap) and remains
+positive in every leave-one-step-out recomputation. This is a diagnostic
+description, not a sealed acceptance threshold.
diff --git a/scripts/compare_c1_resource_context.py b/scripts/compare_c1_resource_context.py
new file mode 100644
index 0000000000000000000000000000000000000000..0da5987aa85ced8ea96886bd592bee287e6f6494
--- /dev/null
+++ b/scripts/compare_c1_resource_context.py
@@ -0,0 +1,1033 @@
+#!/usr/bin/env python3
+"""Test admissible singleton resource context for the exact C1 head.
+
+DIAGNOSTIC_NOT_CLAIM. Offline fits on copies for measurement only. This never
+invokes the production learner or policy and never writes a sealed artifact.
+
+The protocol was frozen in `.scratch/c1-resource-context/spec.md` before fit.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import defaultdict
+from dataclasses import dataclass
+from fractions import Fraction
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import sys
+import time
+from typing import Mapping, Sequence
+
+import numpy as np
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+import compare_target_parametrisations as cmp  # noqa: E402
+
+
+OUT = ROOT / ".scratch/c1-resource-context"
+DEVELOPMENT_TERMS = OUT / "unilateral-development.jsonl"
+TEST_TERMS = OUT / "unilateral-test.jsonl"
+TUNING = OUT / "tuning.json"
+RESULTS = OUT / "results.json"
+REPORT = ROOT / "C1-RESOURCE-CONTEXT-2026-09-10.md"
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+SOURCE = ROOT / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+SMALL_INDEX = cmp.SMALL_ROOT / "PILOT_NOT_CLAIM-family-index.jsonl"
+CONTEXT_WIDTH = cmp.BASE_CONTEXT_WIDTH - cmp.MEMBER_CONTEXT_WIDTH
+LEAKY_WIDTH = 4
+MATERIAL_GAIN = 0.1 * (0.902 - 0.650)
+
+
+@dataclass(slots=True)
+class RawRow:
+    row: cmp.Row
+    context: Mapping[str, object]
+    receipt: Mapping[str, object]
+
+
+@dataclass(slots=True)
+class Sample:
+    key: str
+    anchor: tuple[str, int]
+    split: str
+    user: int
+    selected_q1: np.ndarray
+    reference_q1: np.ndarray
+    resource: np.ndarray
+    target: float
+    own: float | None = None
+    externality: float | None = None
+    energy: float | None = None
+    phi: float | None = None
+
+    def terms(self) -> np.ndarray:
+        values = (self.own, self.externality, self.energy, self.phi)
+        if any(value is None for value in values):
+            raise RuntimeError(f"missing exact terms for {self.key}")
+        return np.asarray(values, dtype=np.float64)
+
+
+@dataclass(slots=True)
+class PairBank:
+    mean: np.ndarray
+    scale: np.ndarray
+    weights: np.ndarray
+    bias: np.ndarray
+
+
+@dataclass(slots=True)
+class PairModel:
+    bank: PairBank
+    width: int
+    ridge: float
+    coefficients: np.ndarray
+
+    def predict_pairs(self, selected: np.ndarray, reference: np.ndarray) -> np.ndarray:
+        left = (selected - self.bank.mean) / self.bank.scale
+        right = (reference - self.bank.mean) / self.bank.scale
+        left_hidden = np.maximum(
+            left @ self.bank.weights[: self.width].T + self.bank.bias[: self.width], 0.0
+        )
+        right_hidden = np.maximum(
+            right @ self.bank.weights[: self.width].T + self.bank.bias[: self.width], 0.0
+        )
+        design = np.concatenate((left - right, left_hidden - right_hidden), axis=1)
+        return design @ self.coefficients
+
+
+def load_pilot():
+    spec = importlib.util.spec_from_file_location("c1_resource_context_pilot", PILOT_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {PILOT_PATH}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def fraction(value: Sequence[int]) -> Fraction:
+    return Fraction(int(value[0]), int(value[1]))
+
+
+def action_identity(payload: Mapping[str, object]) -> tuple[int, int] | None:
+    if payload["norad_id"] is None:
+        return None
+    return int(payload["norad_id"]), int(payload["beam_chain_id"])
+
+
+def sample_key(anchor: tuple[str, int], user: int, identity: tuple[int, int] | None) -> str:
+    suffix = "NULL" if identity is None else f"{identity[0]}:{identity[1]}"
+    return f"{anchor[0]}|{anchor[1]}|{user}|{suffix}"
+
+
+def receipt_index() -> dict[tuple[str, int, str], Mapping[str, object]]:
+    manifest = cmp.small_manifest()
+    cmp.verify_file_sha256(SMALL_INDEX, str(manifest["family_index_sha256"]))
+    result = {}
+    with SMALL_INDEX.open(encoding="ascii") as handle:
+        header = json.loads(next(handle))
+        for line in handle:
+            payload = json.loads(line)
+            key = (
+                str(payload["world_id"]), int(payload["anchor_index"]),
+                str(payload["configuration_id"]),
+            )
+            result[key] = payload["exact_objective_receipt"]
+    if len(result) != int(header["row_count"]):
+        raise RuntimeError("small receipt index row-count drift")
+    return result
+
+
+def load_small_raw(splits: set[str]) -> list[RawRow]:
+    manifest = cmp.small_manifest()
+    receipts = receipt_index()
+    shard_receipts = {row["path"]: row for row in manifest["shards"]}
+    rows: list[RawRow] = []
+    for world_number in (1, 2):
+        for anchor_index in range(90):
+            split = cmp.split_for(world_number, anchor_index)
+            if split not in splits:
+                continue
+            relative = (
+                f"rows/world-{world_number}/"
+                f"PILOT_NOT_CLAIM-mechanism-anchor-{anchor_index:03d}.jsonl"
+            )
+            path = cmp.SMALL_ROOT / relative
+            cmp.verify_file_sha256(path, shard_receipts[relative]["sha256"])
+            with path.open(encoding="ascii") as handle:
+                header = json.loads(next(handle))
+                payloads = [json.loads(line) for line in handle]
+            if len(payloads) != int(header["row_count"]):
+                raise RuntimeError("small shard row-count drift")
+            for payload in payloads:
+                row = cmp.row_from_payload(payload, source="mechanism")
+                key = (row.anchor[0], row.anchor[1], row.configuration_id)
+                rows.append(RawRow(row, payload["context"], receipts[key]))
+    return rows
+
+
+def load_large_raw(path: Path, splits: set[str]) -> list[RawRow]:
+    rows: list[RawRow] = []
+    with path.open(encoding="ascii") as handle:
+        header = json.loads(next(handle))
+        payloads = [json.loads(line) for line in handle]
+    if len(payloads) != int(header["rows"]):
+        raise RuntimeError("large row-count drift")
+    for payload in payloads:
+        split = cmp.key_split(str(payload["world_id"]), int(payload["anchor_index"]))
+        if split not in splits:
+            continue
+        row = cmp.row_from_payload(payload, source="s0-large")
+        rows.append(RawRow(row, payload["context"], payload["exact_objective_receipt"]))
+    return rows
+
+
+def load_raw(splits: set[str]) -> list[RawRow]:
+    rows = load_small_raw(splits)
+    if splits & {"train", "validation"}:
+        rows += load_large_raw(cmp.LARGE_DEVELOPMENT, splits & {"train", "validation"})
+    if "test" in splits:
+        rows += load_large_raw(cmp.LARGE_TEST, {"test"})
+    return rows
+
+
+def resource_feature_names() -> list[str]:
+    beam_fields = (
+        "occupancy_before", "occupancy_after", "active_delta", "shared_capacity",
+        "interference_summary", "capacity_margin", "present",
+    )
+    names = [f"affected_beam.{pool}.{field}" for pool in ("sum", "max", "min", "mean") for field in beam_fields]
+    names += [
+        f"pair[{index:02d}].{field}"
+        for index in range(32)
+        for field in ("source_hash", "target_hash", "gain", "present")
+    ]
+    names.append("pair.residual_gain_sum")
+    names += [
+        "global.changed_user_fraction", "global.affected_beam_fraction",
+        "global.served_before_fraction", "global.served_after_fraction",
+        "global.cross_gain_sum", "global.cross_gain_max",
+    ]
+    if len(names) != CONTEXT_WIDTH:
+        raise RuntimeError("resource name width drift")
+    return names
+
+
+def prepared_resource_context(context: Mapping[str, object]):
+    reference = {
+        int(row["user_id"]): action_identity(row["action"])
+        for row in context["reference_profile"]
+    }
+    before_counts: dict[tuple[int, int], int] = defaultdict(int)
+    for identity in reference.values():
+        if identity is not None:
+            before_counts[identity] += 1
+    relation_map = {
+        (str(row["source_beam_key"]), str(row["target_beam_key"])): float.fromhex(row["gain_hex"])
+        for row in context["pairwise_cross_gain_terms"]
+    }
+    return reference, before_counts, relation_map
+
+
+def singleton_resource(context: Mapping[str, object], member: Mapping[str, object], prepared=None) -> np.ndarray:
+    reference, before_counts, relation_map = (
+        prepared_resource_context(context) if prepared is None else prepared
+    )
+    user = int(member["user_id"])
+    before = reference[user]
+    after = action_identity(member["selected_action"])
+    affected = sorted({identity for identity in (before, after) if identity is not None})
+    if not affected:
+        raise RuntimeError("changed singleton has no affected beam")
+    after_counts = dict(before_counts)
+    if before is not None:
+        after_counts[before] = after_counts.get(before, 0) - 1
+    if after is not None:
+        after_counts[after] = after_counts.get(after, 0) + 1
+    affected_keys = {f"{identity[0]}:{identity[1]}" for identity in affected}
+    relations = [
+        (source, target, relation_map[(source, target)])
+        for source in sorted(affected_keys) for target in sorted(affected_keys)
+        if source != target and (source, target) in relation_map
+    ]
+    expected_pairs = len(affected) * (len(affected) - 1)
+    if len(relations) != expected_pairs:
+        raise RuntimeError("singleton cross-gain subset is incomplete")
+    beam_rows = []
+    for identity in affected:
+        key = f"{identity[0]}:{identity[1]}"
+        b, a = before_counts.get(identity, 0), after_counts.get(identity, 0)
+        beam_rows.append([
+            float(b), float(a), float(a > 0) - float(b > 0), 1.0,
+            math.fsum(gain for _source, target, gain in relations if target == key),
+            float(10 - a), 1.0,
+        ])
+    beams = np.asarray(beam_rows, dtype=np.float64)
+    beam_pool = np.concatenate((beams.sum(0), beams.max(0), beams.min(0), beams.mean(0)))
+    ranked = sorted(relations, key=lambda row: (-abs(row[2]), row[0], row[1]))
+    retained = sorted(ranked[:32], key=lambda row: (row[0], row[1]))
+    pair_block = np.zeros((32, 4), dtype=np.float64)
+    for index, (source, target, gain) in enumerate(retained):
+        pair_block[index] = (cmp.hash01(source), cmp.hash01(target), gain, 1.0)
+    residual = math.fsum(row[2] for row in ranked[32:])
+    users = len(reference)
+    globals_ = np.asarray([
+        1.0 / users, len(affected) / users,
+        math.fsum(before_counts.values()) / users,
+        math.fsum(after_counts.values()) / users,
+        math.fsum(gain for _source, _target, gain in relations),
+        max((gain for _source, _target, gain in relations), default=0.0),
+    ])
+    vector = np.concatenate((beam_pool, pair_block.reshape(-1), [residual], globals_))
+    if vector.shape != (CONTEXT_WIDTH,) or not np.isfinite(vector).all():
+        raise RuntimeError("singleton resource width/finiteness drift")
+    return vector
+
+
+def samples_and_members(rows: Sequence[RawRow]) -> tuple[dict[str, Sample], list[list[str]]]:
+    samples: dict[str, Sample] = {}
+    member_keys: list[list[str]] = []
+    for raw in rows:
+        by_user = {int(row["user"]): fraction(row["difference"]) for row in raw.receipt["singletons"]}
+        members = sorted(raw.context["members"], key=lambda row: int(row["user_id"]))
+        prepared = prepared_resource_context(raw.context)
+        if set(by_user) != {int(member["user_id"]) for member in members}:
+            raise RuntimeError("receipt/context member mismatch")
+        keys = []
+        kappa = Fraction(str(raw.row.kappa))
+        for member in members:
+            user = int(member["user_id"])
+            identity = action_identity(member["selected_action"])
+            key = sample_key(raw.row.anchor, user, identity)
+            sample = Sample(
+                key=key, anchor=raw.row.anchor, split=raw.row.split, user=user,
+                selected_q1=cmp.decode_hex(member["selected_q1_row_hex"]),
+                reference_q1=cmp.decode_hex(member["incumbent_q1_row_hex"]),
+                resource=singleton_resource(raw.context, member, prepared),
+                target=float(by_user[user] / kappa),
+            )
+            old = samples.get(key)
+            if old is None:
+                samples[key] = sample
+            elif (
+                abs(old.target - sample.target) > 2e-12
+                or not np.array_equal(old.selected_q1, sample.selected_q1)
+                or not np.array_equal(old.reference_q1, sample.reference_q1)
+                or not np.array_equal(old.resource, sample.resource)
+            ):
+                raise RuntimeError(f"duplicate singleton drift for {key}")
+            keys.append(key)
+        if len(keys) != raw.row.size:
+            raise RuntimeError("coalition size/member count drift")
+        member_keys.append(keys)
+    return samples, member_keys
+
+
+def load_calibration(pilot):
+    payload = json.loads((SOURCE / "PILOT_NOT_CLAIM-rows-manifest.json").read_text())["calibration"]
+    as_fraction = lambda key: Fraction(*payload[key])
+    return pilot.PilotCalibration(
+        eta_ref=as_fraction("eta_ref"),
+        lambda_bits_per_j=as_fraction("lambda_bits_per_j"),
+        kappa_bits_per_user_step=as_fraction("kappa_bits_per_user_step"),
+        bits_ref=as_fraction("bits_ref"), joules_ref=as_fraction("joules_ref"),
+        users=int(payload["users"]), source=str(payload["source"]),
+    )
+
+
+def build_terms(anchor_part: str) -> None:
+    splits = {"train", "validation"} if anchor_part == "development" else {"test"}
+    destination = DEVELOPMENT_TERMS if anchor_part == "development" else TEST_TERMS
+    if destination.exists():
+        raise SystemExit(f"refusing to overwrite {destination}")
+    raw_rows = load_raw(splits)
+    samples, _member_keys = samples_and_members(raw_rows)
+    pilot = load_pilot()
+    calibration = load_calibration(pilot)
+    eta = Fraction(str(float(calibration.eta_ref)))
+    kappa = Fraction(str(float(calibration.kappa_bits_per_user_step)))
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    by_world: dict[str, dict[int, list[Sample]]] = defaultdict(lambda: defaultdict(list))
+    for sample in samples.values():
+        by_world[sample.anchor[0]][sample.anchor[1]].append(sample)
+    output: list[dict[str, object]] = []
+    max_residual = 0.0
+    started = time.perf_counter()
+    for world_id in sorted(by_world):
+        tape = pilot.build_world_tape(
+            domain=world_id,
+            provider=pilot.LegacyWorldProvider(role="c1-resource-context-diagnostic"),
+            steps=33, start_time_s=0.0,
+        )
+        for anchor_index in sorted(by_world[world_id]):
+            anchor_started = time.perf_counter()
+            step_index, carrier_offset = divmod(anchor_index, len(pilot.ENGINE.REFERENCE_CARRIERS))
+            carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_offset]
+            anchor = pilot.ENGINE._base_configuration(tape, step_index, carrier)
+            incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
+            evaluator = pilot.ENGINE.StepEvaluator(
+                tape, setting, step_index, transition_from=incumbent,
+                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+                field="nominal", counter=pilot.ENGINE.EvaluationCounter(),
+                run_setting=run_setting, boundary_indices=(0,),
+            )
+            configs = {anchor.assignments: anchor}
+            config_for: dict[str, object] = {}
+            for sample in by_world[world_id][anchor_index]:
+                parts = sample.key.rsplit("|", 1)[1]
+                identity = None if parts == "NULL" else tuple(int(value) for value in parts.split(":"))
+                mapping = anchor.mapping
+                mapping[sample.user] = identity
+                config = pilot.ENGINE._configuration(anchor, mapping, kind="c1-resource-context-singleton")
+                configs[config.assignments] = config
+                config_for[sample.key] = config
+            evaluator.evaluate_many(tuple(configs.values()))
+            base_profile = evaluator.evaluate(anchor)
+            base_outcome = base_profile.outcome(phi=pilot.ENGINE._phi_for(anchor, anchor))
+            base_user_bits = dict(base_outcome.per_user_bits)
+            for sample in sorted(by_world[world_id][anchor_index], key=lambda row: row.key):
+                config = config_for[sample.key]
+                if config.configuration_id in evaluator._invalid:
+                    raise RuntimeError(f"receipt singleton became invalid: {sample.key}")
+                profile = evaluator.evaluate(config)
+                outcome = profile.outcome(phi=pilot.ENGINE._phi_for(anchor, config))
+                user_bits = dict(outcome.per_user_bits)
+                own = (user_bits.get(sample.user, Fraction()) - base_user_bits.get(sample.user, Fraction())) / kappa
+                bits_total = (outcome.bits - base_outcome.bits) / kappa
+                externality = bits_total - own
+                energy = -eta * (outcome.joules - base_outcome.joules) / kappa
+                phi = outcome.phi - base_outcome.phi
+                exact = own + externality + energy + phi
+                residual = abs(float(exact) - sample.target)
+                max_residual = max(max_residual, residual)
+                if residual > 2e-12:
+                    raise RuntimeError(f"exact singleton receipt mismatch {sample.key}: {residual}")
+                output.append({
+                    "key": sample.key, "world_id": world_id, "anchor_index": anchor_index,
+                    "user": sample.user, "target_hex": sample.target.hex(),
+                    "own_hex": float(own).hex(), "externality_hex": float(externality).hex(),
+                    "energy_hex": float(energy).hex(), "phi_hex": float(phi).hex(),
+                })
+            print(json.dumps({
+                "event": "anchor", "anchor_part": anchor_part, "world_id": world_id,
+                "anchor_index": anchor_index, "unique_singletons": len(by_world[world_id][anchor_index]),
+                "wall_s": time.perf_counter() - anchor_started,
+            }), flush=True)
+    header = {
+        "schema": "mcrl-v025-c1-resource-context-unilateral-terms-v1",
+        "artifact_label": "DIAGNOSTIC_NOT_CLAIM", "anchor_part": anchor_part,
+        "split_seed": cmp.SEED, "rows": len(output),
+        "max_exact_target_residual": max_residual,
+        "evaluation_path": "fresh StepEvaluator; base and all corpus singleton actions in one evaluate_many call",
+        "elapsed_wall_s": time.perf_counter() - started,
+    }
+    encoded = "\n".join(json.dumps(value, sort_keys=True, separators=(",", ":")) for value in (header, *output)) + "\n"
+    destination.write_text(encoded, encoding="ascii")
+    digest = hashlib.sha256(destination.read_bytes()).hexdigest()
+    destination.with_suffix(destination.suffix + ".sha256").write_text(f"{digest}  {destination.name}\n")
+    print(json.dumps({"event": "complete", "path": str(destination), **header, "sha256": digest}, sort_keys=True))
+
+
+def load_terms(path: Path) -> tuple[Mapping[str, object], dict[str, tuple[float, float, float, float]]]:
+    expected = path.with_suffix(path.suffix + ".sha256").read_text().split()[0]
+    actual = hashlib.sha256(path.read_bytes()).hexdigest()
+    if actual != expected:
+        raise RuntimeError(f"term cache SHA-256 mismatch for {path}")
+    result = {}
+    with path.open(encoding="ascii") as handle:
+        header = json.loads(next(handle))
+        for line in handle:
+            row = json.loads(line)
+            result[str(row["key"])] = tuple(
+                float.fromhex(row[name])
+                for name in ("own_hex", "externality_hex", "energy_hex", "phi_hex")
+            )
+    if len(result) != int(header["rows"]):
+        raise RuntimeError("term cache row-count drift")
+    return header, result
+
+
+def attach_terms(samples: Mapping[str, Sample], terms: Mapping[str, tuple[float, float, float, float]]) -> None:
+    if set(samples) != set(terms):
+        missing = sorted(set(samples) - set(terms))[:3]
+        extra = sorted(set(terms) - set(samples))[:3]
+        raise RuntimeError(f"sample/term key mismatch; missing={missing}, extra={extra}")
+    for key, sample in samples.items():
+        sample.own, sample.externality, sample.energy, sample.phi = terms[key]
+        if abs(float(sample.terms().sum()) - sample.target) > 2e-12:
+            raise RuntimeError(f"loaded decomposition identity mismatch for {key}")
+
+
+def state_pair(sample: Sample, feature: str) -> tuple[np.ndarray, np.ndarray]:
+    if feature == "q1":
+        return sample.selected_q1, sample.reference_q1
+    if feature == "context":
+        return (
+            np.concatenate((sample.selected_q1, sample.resource)),
+            np.concatenate((sample.reference_q1, np.zeros(CONTEXT_WIDTH))),
+        )
+    if feature == "leaky":
+        return sample.terms(), np.zeros(LEAKY_WIDTH)
+    raise ValueError(feature)
+
+
+def fit_pair_bank(raw_rows: Sequence[RawRow], member_keys: Sequence[Sequence[str]], samples: Mapping[str, Sample], feature: str) -> PairBank:
+    blocks = []
+    for _row, keys in zip(raw_rows, member_keys, strict=True):
+        pairs = [state_pair(samples[key], feature) for key in keys]
+        # Preserve the prior harness's all-selected then all-reference order
+        # within every fitting row; duplicates retain their original weight.
+        blocks.append(np.concatenate(
+            (np.asarray([pair[0] for pair in pairs]), np.asarray([pair[1] for pair in pairs])), axis=0
+        ))
+    values = np.concatenate(blocks, axis=0)
+    mean = values.mean(axis=0)
+    scale = values.std(axis=0)
+    scale[scale < 1e-12] = 1.0
+    rng = np.random.default_rng(cmp.SEED)
+    width = values.shape[1]
+    weights = rng.normal(0.0, math.sqrt(2.0 / width), size=(max(cmp.WIDTHS), width))
+    bias = rng.normal(0.0, 0.25, size=max(cmp.WIDTHS))
+    return PairBank(mean, scale, weights, bias)
+
+
+def row_design(raw_rows: Sequence[RawRow], member_keys: Sequence[Sequence[str]], samples: Mapping[str, Sample], bank: PairBank, feature: str) -> np.ndarray:
+    selected_rows = []
+    reference_rows = []
+    offsets = [0]
+    for keys in member_keys:
+        for key in keys:
+            left, right = state_pair(samples[key], feature)
+            selected_rows.append(left)
+            reference_rows.append(right)
+        offsets.append(len(selected_rows))
+    selected = np.asarray(selected_rows, dtype=np.float64)
+    reference = np.asarray(reference_rows, dtype=np.float64)
+    left = (selected - bank.mean) / bank.scale
+    right = (reference - bank.mean) / bank.scale
+    left_hidden = np.maximum(left @ bank.weights.T + bank.bias, 0.0)
+    right_hidden = np.maximum(right @ bank.weights.T + bank.bias, 0.0)
+    occurrence = np.concatenate((left - right, left_hidden - right_hidden), axis=1)
+    result = np.empty((len(raw_rows), occurrence.shape[1]), dtype=np.float64)
+    for index in range(len(raw_rows)):
+        result[index] = occurrence[offsets[index] : offsets[index + 1]].sum(axis=0)
+    return result
+
+
+def fit_pair_model(design: np.ndarray, target: np.ndarray, bank: PairBank, width: int, ridge: float) -> PairModel:
+    dimension = bank.mean.size
+    columns = np.concatenate((np.arange(dimension), np.arange(dimension, dimension + width)))
+    coefficients = cmp.solve_ridge(design[:, columns], target, ridge, intercept=False)
+    return PairModel(bank, width, ridge, coefficients)
+
+
+def predict_row_design(model: PairModel, design: np.ndarray) -> np.ndarray:
+    dimension = model.bank.mean.size
+    columns = np.concatenate((np.arange(dimension), np.arange(dimension, dimension + model.width)))
+    return design[:, columns] @ model.coefficients
+
+
+def aggregate_target(raw_rows: Sequence[RawRow], member_keys: Sequence[Sequence[str]], samples: Mapping[str, Sample], target: str) -> np.ndarray:
+    result = []
+    for raw, keys in zip(raw_rows, member_keys, strict=True):
+        if target == "full":
+            # Preserve each row's own exact encoded aggregate. Independently
+            # built corpora can differ by ~1e-14 on a duplicate singleton.
+            result.append(raw.row.additive)
+        elif target == "minus_externality":
+            result.append(math.fsum(samples[key].terms()[[0, 2, 3]].sum() for key in keys))
+        else:
+            raise ValueError(target)
+    return np.asarray(result, dtype=np.float64)
+
+
+def prepare_partition(splits: set[str], terms_path: Path):
+    raw = load_raw(splits)
+    samples, member_keys = samples_and_members(raw)
+    header, terms = load_terms(terms_path)
+    attach_terms(samples, terms)
+    return raw, samples, member_keys, header
+
+
+ARM_DEFINITIONS = {
+    "Q1_ONLY": ("q1", "full"),
+    "Q1_PLUS_CONTEXT": ("context", "full"),
+    "Q1_PLUS_CONTEXT_MINUS_EXTERNALITY": ("context", "minus_externality"),
+    "LEAKY_ORACLE": ("leaky", "full"),
+}
+
+
+def tune() -> None:
+    if TUNING.exists():
+        raise SystemExit(f"refusing to overwrite {TUNING}")
+    raw, samples, member_keys, terms_header = prepare_partition(
+        {"train", "validation"}, DEVELOPMENT_TERMS
+    )
+    train_indices = [i for i, row in enumerate(raw) if row.row.split == "train"]
+    val_indices = [i for i, row in enumerate(raw) if row.row.split == "validation"]
+    feature_cache: dict[str, tuple[PairBank, np.ndarray]] = {}
+    payload: dict[str, object] = {
+        "schema": "mcrl-v025-c1-resource-context-tuning-v1",
+        "artifact_label": "DIAGNOSTIC_NOT_CLAIM", "seed": cmp.SEED,
+        "grid": [{"width": width, "ridge": ridge} for width, ridge in cmp.GRID],
+        "criterion": "validation RMSE against each arm's declared aggregate exact target",
+        "split": {
+            "unit": "three-anchor block within world", "train_rows": len(train_indices),
+            "validation_rows": len(val_indices), "test_loaded": False,
+        },
+        "development_term_cache_sha256": hashlib.sha256(DEVELOPMENT_TERMS.read_bytes()).hexdigest(),
+        "development_term_cache": terms_header,
+        "arms": {},
+    }
+    for arm, (feature, target_name) in ARM_DEFINITIONS.items():
+        if feature not in feature_cache:
+            bank = fit_pair_bank(raw, member_keys, samples, feature)
+            design = row_design(raw, member_keys, samples, bank, feature)
+            feature_cache[feature] = bank, design
+        bank, design = feature_cache[feature]
+        target = aggregate_target(raw, member_keys, samples, target_name)
+        trials = []
+        for width, ridge in cmp.GRID:
+            model = fit_pair_model(design[train_indices], target[train_indices], bank, width, ridge)
+            pred = predict_row_design(model, design[val_indices])
+            trials.append({"width": width, "ridge": ridge, "validation_rmse": cmp.rmse(target[val_indices], pred)})
+        chosen = min(trials, key=lambda row: (row["validation_rmse"], row["width"], row["ridge"]))
+        payload["arms"][arm] = {"feature": feature, "fit_target": target_name, "chosen": chosen, "trials": trials}
+        print(json.dumps({"event": "arm-tuned", "arm": arm, "chosen": chosen}, sort_keys=True), flush=True)
+    prior = json.loads(cmp.TUNING_PATH.read_text())
+    q1_choice = payload["arms"]["Q1_ONLY"]["chosen"]
+    if q1_choice != prior["chosen"]["per_user_additive"]:
+        raise RuntimeError("Q1_ONLY did not reproduce frozen per-user additive tuning")
+    TUNING.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"event": "tuning-complete", "path": str(TUNING)}, sort_keys=True))
+
+
+def order_summary(truth: np.ndarray, prediction: np.ndarray, groups: np.ndarray, mask: np.ndarray | None = None) -> dict[str, object]:
+    if mask is None:
+        mask = np.ones(truth.size, dtype=bool)
+    concordant = comparable = group_count = 0
+    for group in np.unique(groups[mask]):
+        indices = np.flatnonzero(mask & (groups == group))
+        if indices.size < 2:
+            continue
+        exact = truth[indices]
+        pred = prediction[indices]
+        delta_exact = exact[:, None] - exact[None, :]
+        delta_pred = pred[:, None] - pred[None, :]
+        upper = np.triu(np.ones(delta_exact.shape, dtype=bool), 1) & (delta_exact != 0.0)
+        comparable += int(upper.sum())
+        concordant += int((upper & (np.sign(delta_exact) == np.sign(delta_pred))).sum())
+        group_count += 1
+    return {
+        "pairwise_ordering": concordant / comparable if comparable else None,
+        "comparable_pairs": comparable, "candidate_pools": group_count,
+    }
+
+
+def metrics(truth: np.ndarray, prediction: np.ndarray, groups: np.ndarray, mask: np.ndarray | None = None) -> dict[str, object]:
+    if mask is None:
+        mask = np.ones(truth.size, dtype=bool)
+    result = cmp.value_summary(truth[mask], prediction[mask])
+    result.update(order_summary(truth, prediction, groups, mask))
+    result["rows_including_base"] = int(mask.sum())
+    return result
+
+
+def sample_predictions(samples: Sequence[Sample], models: Mapping[str, PairModel]) -> dict[str, np.ndarray]:
+    result = {}
+    for arm, model in models.items():
+        feature = ARM_DEFINITIONS[arm][0]
+        pairs = [state_pair(sample, feature) for sample in samples]
+        selected = np.asarray([pair[0] for pair in pairs])
+        reference = np.asarray([pair[1] for pair in pairs])
+        result[arm] = model.predict_pairs(selected, reference)
+    return result
+
+
+def evaluation_arrays(samples: Mapping[str, Sample], predictions: Mapping[str, np.ndarray]):
+    ordered = sorted(samples.values(), key=lambda row: row.key)
+    if any(values.size != len(ordered) for values in predictions.values()):
+        raise RuntimeError("sample prediction length drift")
+    truth: list[float] = []
+    anchors: list[str] = []
+    steps: list[str] = []
+    groups: list[str] = []
+    keys: list[str] = []
+    is_base: list[bool] = []
+    arm_values: dict[str, list[float]] = {arm: [] for arm in predictions}
+    by_group: dict[tuple[tuple[str, int], int], list[int]] = defaultdict(list)
+    for index, sample in enumerate(ordered):
+        by_group[(sample.anchor, sample.user)].append(index)
+    for (anchor, user), indices in sorted(by_group.items()):
+        anchor_key = f"{anchor[0]}|{anchor[1]}"
+        step_key = f"{anchor[0]}|{anchor[1] // 3}"
+        group_key = f"{anchor_key}|{user}"
+        truth.append(0.0); anchors.append(anchor_key); steps.append(step_key); groups.append(group_key)
+        keys.append(f"{group_key}|BASE"); is_base.append(True)
+        for arm in predictions:
+            arm_values[arm].append(0.0)
+        for index in indices:
+            sample = ordered[index]
+            truth.append(sample.target); anchors.append(anchor_key); steps.append(step_key); groups.append(group_key)
+            keys.append(sample.key); is_base.append(False)
+            for arm, values in predictions.items():
+                arm_values[arm].append(float(values[index]))
+    return {
+        "truth": np.asarray(truth), "anchor": np.asarray(anchors), "step": np.asarray(steps),
+        "group": np.asarray(groups), "key": np.asarray(keys), "is_base": np.asarray(is_base),
+        "predictions": {arm: np.asarray(values) for arm, values in arm_values.items()},
+        "ordered_nonbase": ordered,
+    }
+
+
+def stratified_and_loso(arrays: Mapping[str, object]) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
+    truth = arrays["truth"]
+    groups = arrays["group"]
+    anchors = arrays["anchor"]
+    steps = arrays["step"]
+    global_metrics = {}
+    by_anchor = {}
+    loso = {}
+    for arm, prediction in arrays["predictions"].items():
+        global_metrics[arm] = metrics(truth, prediction, groups)
+        by_anchor[arm] = {
+            anchor: metrics(truth, prediction, groups, anchors == anchor)
+            for anchor in sorted(np.unique(anchors))
+        }
+        omissions = []
+        for step in sorted(np.unique(steps)):
+            value = metrics(truth, prediction, groups, steps != step)
+            omissions.append({"omitted_step": step, **value})
+        loso[arm] = {
+            "omissions": omissions,
+            "spread": {
+                name: {
+                    "min": min(row[name] for row in omissions),
+                    "max": max(row[name] for row in omissions),
+                }
+                for name in ("explained_variance", "rmse", "pairwise_ordering")
+            },
+        }
+    return global_metrics, by_anchor, loso
+
+
+def permutation_attribution(samples: Mapping[str, Sample], model: PairModel, arrays: Mapping[str, object]) -> list[dict[str, object]]:
+    ordered = arrays["ordered_nonbase"]
+    pairs = [state_pair(sample, "context") for sample in ordered]
+    selected = np.asarray([pair[0] for pair in pairs])
+    reference = np.asarray([pair[1] for pair in pairs])
+    z_left = (selected - model.bank.mean) / model.bank.scale
+    z_right = (reference - model.bank.mean) / model.bank.scale
+    pre_left = z_left @ model.bank.weights[: model.width].T + model.bank.bias[: model.width]
+    hidden_left = np.maximum(pre_left, 0.0)
+    hidden_right = np.maximum(
+        z_right @ model.bank.weights[: model.width].T + model.bank.bias[: model.width], 0.0
+    )
+    dimension = model.bank.mean.size
+    raw_coef = model.coefficients[:dimension]
+    hidden_coef = model.coefficients[dimension:]
+    base_nonbase = (z_left - z_right) @ raw_coef + (hidden_left - hidden_right) @ hidden_coef
+    truth = arrays["truth"]
+    groups = arrays["group"]
+    is_base = arrays["is_base"]
+    baseline = float(order_summary(truth, arrays["predictions"]["Q1_PLUS_CONTEXT"], groups)["pairwise_ordering"])
+    nonbase_positions = np.flatnonzero(~is_base)
+    if nonbase_positions.size != len(ordered):
+        raise RuntimeError("nonbase evaluation order drift")
+    sample_groups: dict[str, list[int]] = defaultdict(list)
+    for index, sample in enumerate(ordered):
+        sample_groups[f"{sample.anchor[0]}|{sample.anchor[1]}|{sample.user}"].append(index)
+    names = resource_feature_names()
+    rows = []
+    for resource_index, name in enumerate(names):
+        column = cmp.Q1_WIDTH + resource_index
+        original = selected[:, column]
+        permuted = original.copy()
+        for group, indices_list in sample_groups.items():
+            if len(indices_list) < 2:
+                continue
+            indices = np.asarray(indices_list)
+            ranked = sorted(
+                indices_list,
+                key=lambda index: hashlib.sha256(
+                    f"{cmp.SEED}|{resource_index}|{group}|{ordered[index].key}".encode()
+                ).digest(),
+            )
+            ranked_array = np.asarray(ranked)
+            permuted[ranked_array] = original[np.roll(ranked_array, 1)]
+        delta = (permuted - original) / model.bank.scale[column]
+        adjusted_hidden = np.maximum(
+            pre_left + delta[:, None] * model.bank.weights[: model.width, column][None, :], 0.0
+        )
+        changed = base_nonbase + delta * raw_coef[column] + (adjusted_hidden - hidden_left) @ hidden_coef
+        full_prediction = arrays["predictions"]["Q1_PLUS_CONTEXT"].copy()
+        full_prediction[nonbase_positions] = changed
+        permuted_order = float(order_summary(truth, full_prediction, groups)["pairwise_ordering"])
+        rows.append({
+            "resource_index": resource_index, "model_input_index": column, "name": name,
+            "baseline_ordering": baseline, "permuted_ordering": permuted_order,
+            "importance": baseline - permuted_order,
+            "varying": bool(np.ptp(original) > 0.0),
+        })
+    return sorted(rows, key=lambda row: (-row["importance"], row["resource_index"]))
+
+
+def fmt(value: float | None) -> str:
+    return "N/A" if value is None else f"{value:.6f}"
+
+
+def md_table(headers: Sequence[str], rows: Sequence[Sequence[object]]) -> str:
+    lines = ["| " + " | ".join(headers) + " |", "|" + "|".join("---" for _ in headers) + "|"]
+    lines += ["| " + " | ".join(str(value) for value in row) + " |" for row in rows]
+    return "\n".join(lines)
+
+
+def render_report(result: Mapping[str, object]) -> str:
+    overall = result["held_out"]
+    q1 = overall["Q1_ONLY"]["pairwise_ordering"]
+    context = overall["Q1_PLUS_CONTEXT"]["pairwise_ordering"]
+    gain = context - q1
+    material = bool(result["materiality"]["material"])
+    lead = (
+        f"**Held-out pairwise ordering is {context:.6f} with admissible resource context versus "
+        f"{q1:.6f} without it (gain {gain:+.6f}): the gain is "
+        f"{'material' if material else 'not material'} by the predeclared diagnostic convention.**"
+    )
+    arm_rows = []
+    for arm in ARM_DEFINITIONS:
+        row = overall[arm]
+        arm_rows.append((arm, row["rows_including_base"], fmt(row["explained_variance"]), fmt(row["rmse"]), fmt(row["pairwise_ordering"]), row["comparable_pairs"]))
+    anchor_headers = ["anchor"]
+    for arm in ARM_DEFINITIONS:
+        anchor_headers += [f"{arm} EV", f"{arm} RMSE", f"{arm} order"]
+    anchor_rows = []
+    anchors = sorted(result["by_anchor"]["Q1_ONLY"])
+    for anchor in anchors:
+        values: list[object] = [anchor]
+        for arm in ARM_DEFINITIONS:
+            row = result["by_anchor"][arm][anchor]
+            values += [fmt(row["explained_variance"]), fmt(row["rmse"]), fmt(row["pairwise_ordering"])]
+        anchor_rows.append(values)
+    spread_rows = []
+    for arm in ARM_DEFINITIONS:
+        spread = result["leave_one_step_out"][arm]["spread"]
+        spread_rows.append((
+            arm,
+            f"{fmt(spread['explained_variance']['min'])}–{fmt(spread['explained_variance']['max'])}",
+            f"{fmt(spread['rmse']['min'])}–{fmt(spread['rmse']['max'])}",
+            f"{fmt(spread['pairwise_ordering']['min'])}–{fmt(spread['pairwise_ordering']['max'])}",
+        ))
+    attr_rows = [
+        (row["resource_index"], row["name"], fmt(row["importance"]), fmt(row["permuted_ordering"]))
+        for row in result["attribution"][:15]
+    ]
+    tuning_rows = [
+        (arm, result["tuning"]["arms"][arm]["chosen"]["width"], result["tuning"]["arms"][arm]["chosen"]["ridge"], fmt(result["tuning"]["arms"][arm]["chosen"]["validation_rmse"]))
+        for arm in ARM_DEFINITIONS
+    ]
+    end = result["end_to_end"]
+    report = [
+        lead, "", "# C1 resource-context diagnostic — 2026-09-10", "", "`DIAGNOSTIC_NOT_CLAIM`", "",
+        "No production training run, policy run, or acceptance test was performed. This is an offline fit on copies for measurement only. No sealed contract, target, scorer, schema digest, manifest, constant, threshold, sign, seed, horizon, price, service guard, or acceptance rule was modified.", "",
+        "## Direct answer", "",
+        f"Adding the admissible singleton resource context changes ordering by {gain:+.6f}, closing {100.0 * gain / (0.902 - 0.650):.2f}% of the stated 0.252 gap. The leave-one-step-out context gain ranges from {result['materiality']['loso_gain_min']:+.6f} to {result['materiality']['loso_gain_max']:+.6f}. Under the frozen rule (gain at least {MATERIAL_GAIN:.4f} and positive for every omission), this is {'material' if material else 'not material'}.", "",
+        "## Admissibility finding", "",
+        "The coordinate formulas are admissible, but the stored coalition-wide values are not valid C1 inputs as-is. `scripts/run_v025_pilot_c3.py:844-906` builds affected beams, before/after occupancies, active-state changes, capacity margins, pairwise cross-gains and six globals solely from the reference/selected assignments and the decision-time tape. `_cross_gain_terms` at `:806-841` reads static `cross_base_nominal` arrays; neither function accepts an evaluator or outcome. The interaction path consumes `CoalitionContext.invariant_vector` (`src/mcrl/stagec_v025/coalitions.py:231-280`) through `model.interaction`, and the selector calls it while scoring catalogue profiles (`src/mcrl/stagec_v025/deployment.py:717-736`).", "",
+        "A coalition-wide vector depends on the other proposed member actions, while the C1 interface is action-local (`deployment.py:626-645`). I therefore did not feed those stored values to C1. For every exact singleton receipt I rebuilt the same 163 coordinate formulas from the reference profile and that focal `(user, action)` alone. No coordinate family was excluded: all 28 affected-beam pool values, 129 pairwise-cross-gain values, and six globals pass the pre-decision/no-fixed-point rule in this singleton form. The candidate outcome, label, power fixed point, and whole-network result are absent from feature construction.", "",
+        "## Frozen protocol and fit", "",
+        f"The harness uses {result['corpus']['coalition_rows']} exact coalition fitting rows and {result['corpus']['unique_singletons']} unique singleton actions across the frozen split. It reuses seed `{cmp.SEED}`, the three-anchor-block split, the fixed-ReLU random-feature ridge family with raw linear skip, and the exact six-point grid from the parametrisation comparison. Each shared per-user scorer is fitted through the sum of its member differences on the original coalition rows. Exact singleton targets are read from Fraction receipts; the pilot fallback is never read as a target.", "",
+        md_table(("arm", "width", "ridge", "validation RMSE"), tuning_rows), "",
+        "`Q1_PLUS_CONTEXT_MINUS_EXTERNALITY` is fitted to `own + energy + Φ`, then assessed against full exact C1. `LEAKY_ORACLE` uses the exact `own`, `externality`, `energy`, and `Φ` terms as input to the same estimator and grid and is `NOT_DEPLOYABLE`.", "",
+        "## Held-out first-route metrics", "",
+        md_table(("scorer", "rows incl. base", "explained variance", "RMSE", "pairwise ordering", "comparable pairs"), arm_rows), "",
+        "Pairwise ordering is micro-accuracy over unequal exact pairs within each `(world, anchor, user)` candidate pool, with the exact zero/base action included and predicted ties counted as incorrect.", "",
+        "## By held-out anchor", "",
+        md_table(anchor_headers, anchor_rows), "",
+        "## Leave-one-step-out spread", "",
+        "Each range below is the min–max across the ten recomputations that omit one held-out `(world, anchor_index // 3)` block (three carrier anchors).", "",
+        md_table(("scorer", "explained variance", "RMSE", "pairwise ordering"), spread_rows), "",
+        "## Context-coordinate attribution", "",
+        "The single predeclared attribution is held-out, no-refit, seeded cyclic permutation within each non-base candidate pool. Importance is the full-context ordering minus ordering after permuting that one coordinate. The 15 largest values are:", "",
+        md_table(("resource index", "coordinate", "ordering importance", "permuted ordering"), attr_rows), "",
+        f"{result['attribution_varying']} of 163 coordinates vary on held-out singleton actions; zero/negative importance means this fitted model did not rely beneficially on that coordinate under the declared perturbation.", "",
+        "## End-to-end selection effect", "",
+        f"On the parametrisation comparison's same 30 held-out pools, the offline sealed-decomposition formula (learned per-user sum plus the already-frozen learned interaction head) has mean selection regret {end['Q1_ONLY']['mean_regret']:.6f} without context and {end['Q1_PLUS_CONTEXT']['mean_regret']:.6f} with context. The change is {end['Q1_PLUS_CONTEXT']['mean_regret'] - end['Q1_ONLY']['mean_regret']:+.6f} normalized objective units (negative is better). The Q1-only route reproduces the prior ADDITIVE mean regret to {end['q1_only_reproduction_abs_error']:.3e}.", "",
+        "## Interpretation", "",
+        result["interpretation"], "",
+        "## What this did not reach", "",
+        "This does not authorize a production feature or interface change. It does not run the policy, estimate downstream policy value, search the full combinatorial action space, or establish an acceptance result. It does not test sizes 7–99, because they are absent from the frozen corpus. The mechanism rows still lack per-row served-count receipts, so no service-guard stratification was reached. The context arm tests a diagnostic singleton reconstruction; the current sealed C1 interface does not accept these coordinates, and the stored coalition-wide context cannot simply be wired into it. No confidence interval, repeated seed, alternate split, alternate estimator, or post-test tuning was performed.", "",
+        "## Reproduction", "", "```bash",
+        "cd /home/sat/mcrl-v025-selector-ws", "",
+        "PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+        "  scripts/compare_c1_resource_context.py --phase build --anchor-part development", "",
+        "PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+        "  scripts/compare_c1_resource_context.py --phase tune", "",
+        "PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+        "  scripts/compare_c1_resource_context.py --phase build --anchor-part test", "",
+        "PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python \\",
+        "  scripts/compare_c1_resource_context.py --phase final", "```", "",
+        "Machine-readable outputs: `.scratch/c1-resource-context/tuning.json`, `.scratch/c1-resource-context/results.json`, and the two authenticated unilateral-term caches in that directory.",
+    ]
+    return "\n".join(report) + "\n"
+
+
+def final() -> None:
+    tuning = json.loads(TUNING.read_text())
+    development_raw, development_samples, development_keys, development_header = prepare_partition(
+        {"train", "validation"}, DEVELOPMENT_TERMS
+    )
+    test_raw, test_samples, test_keys, test_header = prepare_partition({"test"}, TEST_TERMS)
+    development_rows = [raw.row for raw in development_raw]
+    test_rows = [raw.row for raw in test_raw]
+    models: dict[str, PairModel] = {}
+    test_designs: dict[str, np.ndarray] = {}
+    final_feature_cache: dict[str, tuple[PairBank, np.ndarray, np.ndarray]] = {}
+    for arm, (feature, target_name) in ARM_DEFINITIONS.items():
+        if feature not in final_feature_cache:
+            bank = fit_pair_bank(development_raw, development_keys, development_samples, feature)
+            development_design = row_design(development_raw, development_keys, development_samples, bank, feature)
+            test_design = row_design(test_raw, test_keys, test_samples, bank, feature)
+            final_feature_cache[feature] = bank, development_design, test_design
+        bank, development_design, test_design = final_feature_cache[feature]
+        target = aggregate_target(development_raw, development_keys, development_samples, target_name)
+        choice = tuning["arms"][arm]["chosen"]
+        models[arm] = fit_pair_model(
+            development_design, target, bank, int(choice["width"]), float(choice["ridge"])
+        )
+        test_designs[arm] = test_design
+
+    ordered_test_samples = sorted(test_samples.values(), key=lambda row: row.key)
+    nonbase_predictions = sample_predictions(ordered_test_samples, models)
+    arrays = evaluation_arrays(test_samples, nonbase_predictions)
+    held_out, by_anchor, loso = stratified_and_loso(arrays)
+    attribution = permutation_attribution(test_samples, models["Q1_PLUS_CONTEXT"], arrays)
+
+    # Refit the already-frozen interaction arm exactly as the parametrisation
+    # comparison did, then combine it with the two per-user coalition sums.
+    prior_tuning = json.loads(cmp.TUNING_PATH.read_text())
+    bank = cmp.fit_q1_bank(development_rows)
+    _dev_member, development_full, _dev_member_only = cmp.feature_matrices(development_rows, bank)
+    _test_member, test_full, _test_member_only = cmp.feature_matrices(test_rows, bank)
+    _dev_add, development_psi, _dev_joint = cmp.labels(development_rows)
+    interaction_choice = prior_tuning["chosen"]["interaction"]
+    interaction_model = cmp.fit_set_model(
+        development_full, development_psi,
+        int(interaction_choice["width"]), float(interaction_choice["ridge"]),
+    )
+    interaction_prediction = interaction_model.predict(test_full)
+    train_support = {row.size for row in development_rows}
+    end_to_end = {}
+    for arm in ("Q1_ONLY", "Q1_PLUS_CONTEXT"):
+        additive_prediction = predict_row_design(models[arm], test_designs[arm])
+        summary = cmp.selection_summary(test_rows, additive_prediction + interaction_prediction, train_support)
+        end_to_end[arm] = {"mean_regret": summary["mean"], "decisions": summary["decisions"]}
+    prior_results = json.loads(cmp.RESULTS_PATH.read_text())
+    prior_mean = prior_results["predictors"]["ADDITIVE"]["selection"]["mean"]
+    reproduction_error = abs(end_to_end["Q1_ONLY"]["mean_regret"] - prior_mean)
+    if reproduction_error > 1e-12:
+        raise RuntimeError(f"Q1-only end-to-end reproduction failed: {reproduction_error}")
+
+    ordering_gain = held_out["Q1_PLUS_CONTEXT"]["pairwise_ordering"] - held_out["Q1_ONLY"]["pairwise_ordering"]
+    omission_by_step = {
+        row["omitted_step"]: row["pairwise_ordering"]
+        for row in loso["Q1_ONLY"]["omissions"]
+    }
+    context_omission_by_step = {
+        row["omitted_step"]: row["pairwise_ordering"]
+        for row in loso["Q1_PLUS_CONTEXT"]["omissions"]
+    }
+    loso_gains = [context_omission_by_step[step] - value for step, value in omission_by_step.items()]
+    material = ordering_gain >= MATERIAL_GAIN and min(loso_gains) > 0.0
+    minus = held_out["Q1_PLUS_CONTEXT_MINUS_EXTERNALITY"]
+    oracle = held_out["LEAKY_ORACLE"]
+    if material:
+        interpretation = (
+            f"The hypothesis is supported in this diagnostic: admissible resource context raises held-out ordering by "
+            f"{ordering_gain:.6f} and meets the frozen materiality convention. The externality-removed arm reaches "
+            f"{minus['pairwise_ordering']:.6f}, while the `NOT_DEPLOYABLE` defining-term oracle reaches "
+            f"{oracle['pairwise_ordering']:.6f}. This identifies a measurable feature-sufficiency contribution, "
+            "but the end-to-end regret result and current C1 interface limitation still govern whether it is a useful repair."
+        )
+    else:
+        interpretation = (
+            f"The hypothesis is not supported as a material repair in this diagnostic. Admissible resource context changes "
+            f"held-out ordering by only {ordering_gain:+.6f}. The externality-removed arm reaches "
+            f"{minus['pairwise_ordering']:.6f}, and the `NOT_DEPLOYABLE` defining-term oracle reaches "
+            f"{oracle['pairwise_ordering']:.6f}; the remaining gap is therefore not closed merely by exposing these encoded resource summaries to the fitted per-user head."
+        )
+
+    all_raw = development_raw + test_raw
+    all_samples = dict(development_samples)
+    all_samples.update(test_samples)
+    result = {
+        "schema": "mcrl-v025-c1-resource-context-results-v1",
+        "artifact_label": "DIAGNOSTIC_NOT_CLAIM", "seed": cmp.SEED,
+        "materiality": {
+            "reference_gap": 0.902 - 0.650, "minimum_gain": MATERIAL_GAIN,
+            "requires_all_loso_gains_positive": True, "observed_gain": ordering_gain,
+            "loso_gain_min": min(loso_gains), "loso_gain_max": max(loso_gains),
+            "material": material,
+        },
+        "admissibility": {
+            "stored_coalition_context_directly_admissible_for_c1": False,
+            "reason": "depends on other proposed member actions and is unavailable at the sealed action-local C1 call",
+            "singleton_reconstruction_admissible": True,
+            "included_coordinates": CONTEXT_WIDTH, "excluded_coordinate_families": [],
+            "construction_inputs": "reference assignments, focal user/action, decision-time cross-gain tape only",
+        },
+        "corpus": {
+            "coalition_rows": len(all_raw), "development_rows": len(development_raw),
+            "test_rows": len(test_raw), "unique_singletons": len(all_samples),
+            "development_unique_singletons": len(development_samples),
+            "test_unique_singletons": len(test_samples),
+            "development_term_cache": development_header, "test_term_cache": test_header,
+        },
+        "tuning": tuning, "held_out": held_out, "by_anchor": by_anchor,
+        "leave_one_step_out": loso, "attribution": attribution,
+        "attribution_varying": sum(bool(row["varying"]) for row in attribution),
+        "end_to_end": {
+            **end_to_end, "prior_additive_mean_regret": prior_mean,
+            "q1_only_reproduction_abs_error": reproduction_error,
+        },
+        "interpretation": interpretation,
+    }
+    RESULTS.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    REPORT.write_text(render_report(result))
+    print(json.dumps({
+        "event": "final-complete", "q1_only_ordering": held_out["Q1_ONLY"]["pairwise_ordering"],
+        "q1_plus_context_ordering": held_out["Q1_PLUS_CONTEXT"]["pairwise_ordering"],
+        "gain": ordering_gain, "material": material,
+        "q1_only_mean_regret": end_to_end["Q1_ONLY"]["mean_regret"],
+        "q1_plus_context_mean_regret": end_to_end["Q1_PLUS_CONTEXT"]["mean_regret"],
+        "report": str(REPORT), "results": str(RESULTS),
+    }, sort_keys=True))
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--phase", choices=("build", "tune", "final"), required=True)
+    parser.add_argument("--anchor-part", choices=("development", "test"))
+    args = parser.parse_args(argv)
+    OUT.mkdir(parents=True, exist_ok=True)
+    if args.phase == "build":
+        if args.anchor_part is None:
+            parser.error("--phase build requires --anchor-part")
+        build_terms(args.anchor_part)
+    elif args.anchor_part is not None:
+        parser.error("--anchor-part is only valid with --phase build")
+    elif args.phase == "tune":
+        tune()
+    else:
+        final()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

