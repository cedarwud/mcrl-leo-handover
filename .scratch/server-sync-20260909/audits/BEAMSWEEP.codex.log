+                    "construction": name,
+                    "configuration_id": config.configuration_id,
+                    "nominal_required_power_over_cap": ratio,
+                    "nominal_required_power_over_cap_hex": ratio.hex(),
+                    "rf_cap_hits": int(profile.rf_cap_hits),
+                    "rf_transmission_observations": int(
+                        profile.rf_transmission_observations
+                    ),
+                }
+            )
+        print(
+            f"anchor {position}/{len(panel)} cap audit completed "
+            f"peak RSS {source.assert_rss()/2**30:.3f} GiB",
+            flush=True,
+        )
+
+    by_name = {}
+    for name in NAMES:
+        values = [
+            row["nominal_required_power_over_cap"]
+            for row in rows
+            if row["construction"] == name
+        ]
