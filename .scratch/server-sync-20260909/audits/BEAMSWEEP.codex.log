+#!/usr/bin/env python3
+"""DESIGN-PHASE EXPLORATION: selected-configuration RF-cap audit."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+from pathlib import Path
+import resource
+import time
+
+import run_width
+
+
+NAMES = ("BASE", "U_FIRST_AT_10", "U_FIRST", "U_BEST", "J_FROM_FIRST")
+
+
+def mapping_from_metric(metric: dict) -> dict[int, tuple[int, int] | None]:
+    return {
+        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
+        for user, identity in metric["assignments"]
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--width", type=float, required=True)
+    args = parser.parse_args()
+    if args.width not in run_width.DECLARED_GRID_DEG:
+        raise RuntimeError("width is outside the predeclared grid")
+
+    resource.setrlimit(
+        resource.RLIMIT_RSS, (run_width.MAX_RSS_BYTES, run_width.MAX_RSS_BYTES)
+    )
+    run_width.start_rss_watchdog()
+    source = run_width.load_source_runner()
+    source.assert_runtime()
+    panel = source.frozen_panel()
+    pilot = source.load_pilot()
+    from mcrl.physics_v025 import channel
+    from mcrl.physics_v025.constants_v025 import BEAM_RF_CAP_W
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    channel.TX_FULL_HPBW_DEG = 2.0 * args.width
+    receipt_path = (
+        run_width.WORKSPACE / ".scratch/beamsweep" / f"width-{args.width:.2f}.json"
+    )
+    receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+    if receipt["status"] != "COMPLETE":
+        raise RuntimeError("sweep receipt is not complete")
+    if float(receipt["beam_width_sweep"]["one_sided_half_power_deg"]) != args.width:
+        raise RuntimeError("receipt width mismatch")
+
+    started = time.perf_counter()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33,
+        start_time_s=0.0,
+    )
+    print(
+        f"peak RSS {source.assert_rss()/2**30:.3f} GiB after cap-audit tape",
+        flush=True,
+    )
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    rows = []
+    for position, (panel_row, anchor) in enumerate(
+        zip(panel, receipt["anchors"], strict=True), 1
+    ):
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
+        incumbent = pilot.ENGINE._base_configuration(
+            tape, max(0, step_index - 1), carrier
+        )
+        configs = {}
+        for name in NAMES:
+            stored = anchor["committed"][name]
+            mapping = mapping_from_metric(stored)
+            assignments = tuple(sorted(mapping.items()))
+            config = pilot.ENGINE.Configuration(
+                stored["configuration_id"],
+                assignments,
+                sum(mapping[user] != base.mapping[user] for user in mapping),
+                "beamsweep-cap-audit-exact-replay",
+            )
+            if config.configuration_id != stored["configuration_id"]:
+                raise RuntimeError(f"configuration ID mismatch for {position}/{name}")
+            configs[name] = config
+        evaluator = pilot.ENGINE.StepEvaluator(
+            tape,
+            pilot.ENGINE._setting("a-r0"),
+            step_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
+            field="nominal",
+            counter=pilot.ENGINE.EvaluationCounter(),
+            run_setting=run_setting,
+            boundary_indices=(0,),
+        )
+        evaluator.evaluate_many(tuple(configs.values()))
+        for name, config in configs.items():
+            profile = evaluator._evaluated.get(config.configuration_id)
+            if profile is None:
+                raise RuntimeError(f"invalid nominal cap-audit config {position}/{name}")
+            ratio = float(profile.required_power_w_max) / float(BEAM_RF_CAP_W)
+            rows.append(
+                {
+                    "global_anchor_index": int(panel_row["global_anchor_index"]),
+                    "construction": name,
+                    "configuration_id": config.configuration_id,
+                    "nominal_required_power_over_cap": ratio,
+                    "nominal_required_power_over_cap_hex": ratio.hex(),
+                    "rf_cap_hits": int(profile.rf_cap_hits),
+                    "rf_transmission_observations": int(
+                        profile.rf_transmission_observations
+                    ),
+                }
+            )
+        print(
+            f"anchor {position}/{len(panel)} cap audit completed "
+            f"peak RSS {source.assert_rss()/2**30:.3f} GiB",
+            flush=True,
+        )
+
+    by_name = {}
+    for name in NAMES:
+        values = [
+            row["nominal_required_power_over_cap"]
+            for row in rows
+            if row["construction"] == name
+        ]
+        hits = sum(
+            row["rf_cap_hits"] for row in rows if row["construction"] == name
+        )
+        observations = sum(
+            row["rf_transmission_observations"]
+            for row in rows
+            if row["construction"] == name
+        )
+        by_name[name] = {
+            "configuration_anchor_count": len(values),
+            "ratio_exactly_one_count": sum(value == 1.0 for value in values),
+            "ratio_min": min(values),
+            "ratio_max": max(values),
+            "rf_cap_hits_boundary0": hits,
+            "rf_transmission_observations_boundary0": observations,
+            "rf_cap_hit_share_boundary0": hits / observations,
+        }
+    payload = {
+        "schema": "mcrl-v025-beam-width-selected-configuration-cap-audit-v1",
+        "status": "DESIGN_PHASE_EXPLORATION_NOT_CLAIM",
+        "scope": (
+            "five selected constructions x 12 anchors, nominal boundary 0; "
+            "not the full action-row corpus"
+        ),
+        "one_sided_half_power_deg": args.width,
+        "full_hpbw_deg_runtime_override": 2.0 * args.width,
+        "rows": rows,
+        "summary_by_construction": by_name,
+        "ratio_exactly_one_count": sum(
+            row["nominal_required_power_over_cap"] == 1.0 for row in rows
+        ),
+        "configuration_anchor_count": len(rows),
+        "ratio_min": min(row["nominal_required_power_over_cap"] for row in rows),
+        "ratio_max": max(row["nominal_required_power_over_cap"] for row in rows),
+        "wall_seconds": time.perf_counter() - started,
+        "peak_rss_bytes": source.assert_rss(),
+        "python": os.path.realpath(os.sys.executable),
+    }
+    output = (
+        run_width.WORKSPACE
+        / ".scratch/beamsweep"
+        / f"cap-audit-{args.width:.2f}.json"
+    )
+    output.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    print(
+        f"peak RSS {payload['peak_rss_bytes']/2**30:.3f} GiB final cap audit",
+        flush=True,
+    )
+    print(json.dumps({key: payload[key] for key in (
+        "ratio_exactly_one_count", "configuration_anchor_count",
+        "ratio_min", "ratio_max", "wall_seconds",
+    )}, sort_keys=True), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
