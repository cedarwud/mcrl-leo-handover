+173532550200716da64d5724d24137cfa8ca505587f9e1929fc4a67e476328c5  .scratch/beamsweep/width-3.32.json
+ab14e201897df142d7023e2cba6f0fb866295c1768b7217a5d89692865a33409  .scratch/beamsweep/cap-audit-1.66.json
+78363035417a719bc50e74b7a2d2c54778768a726481d6f826ba8b5660b3c046  .scratch/beamsweep/cap-audit-2.40.json
