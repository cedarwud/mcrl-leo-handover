   354	def best_improvement(runner, calibration, tape, step_index, base, incumbent, run_setting) -> SearchRun:
   355	    evaluator = new_selection_evaluator(runner, tape, step_index, incumbent, run_setting)
   356	    base_profile = evaluator.evaluate(base)
   357	    guard = served(base_profile)
   358	    started = time.perf_counter()
   359	    options, census = runner._legal_options(tape, step_index)
   360	    rekeys = runner._rekeyed_users(tape, step_index)
   361	    current = base
   362	    moves: list[tuple[float, object]] = [(0.0, base)]
   363	    passes_with_moves = comparisons = 0
   364	    while True:
   365	        pass_started = time.perf_counter() - started
   366	        moves_this_pass = 0
   367	        terminal_counts = {
   368	            "legal_unilateral_alternatives_evaluated": 0,
   369	            "physically_invalid_alternatives": 0,
   370	            "service_guard_rejected_alternatives": 0,
   371	            "strictly_improving_alternatives": 0,
   372	        }
   373	        for user in sorted(options):
   374	            current_profile = evaluator.evaluate(current)
   375	            current_value = objective(
   376	                runner, calibration, incumbent, current, current_profile, rekeys
   377	            )
   378	            candidates = tuple(candidate(
   379	                runner, base, current, user, identity,
   380	                "panelceil-best-improvement",
   381	            ) for identity in options[user] if identity != current.mapping[user])
   382	            for offset in range(0, len(candidates), UNILATERAL_BATCH_SIZE):
   383	                evaluator.evaluate_many(
   384	                    candidates[offset:offset + UNILATERAL_BATCH_SIZE]
   385	                )
   386	            terminal_counts["legal_unilateral_alternatives_evaluated"] += len(candidates)
   387	            improving = []
   388	            for row in candidates:
   389	                comparisons += 1
   390	                profile = evaluator._evaluated.get(row.configuration_id)
   391	                if profile is None:
   392	                    terminal_counts["physically_invalid_alternatives"] += 1
   393	                    continue
