   433	def interference_contributors(tape, step_index: int, current, victim: int) -> tuple[int, ...]:
   434	    mapping = current.mapping
   435	    victim_beam = mapping[victim]
   436	    if victim_beam is None:
   437	        return ()
   438	    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
   439	    arrays = tape.steps[step_index].arrays
   440	    if arrays is None:
   441	        raise RuntimeError("exact panel requires primitive arrays")
   442	    victim_row = arrays._row_index().get((victim, victim_beam))
   443	    aggressor_of = arrays._aggressor_index()
   444	    if victim_row is None:
   445	        return ()
   446	    scores = []
   447	    for user, beam in sorted(mapping.items()):
   448	        if user == victim or beam is None or beam == victim_beam:
   449	            continue
   450	        column = aggressor_of.get(beam)
   451	        if column is None:
   452	            continue
   453	        score = arrays._cross_at_index(0, victim_row, column)[0] / occupancy[beam]
   454	        if score > 0.0:
   455	            scores.append((score, user))
   456	    return tuple(user for _, user in sorted(scores, key=lambda item: (-item[0], item[1])))
