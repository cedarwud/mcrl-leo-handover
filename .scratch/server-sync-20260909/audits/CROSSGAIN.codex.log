                    occupancy_after=len(tables),
                    active_before=True,
                    active_after=True,
                    shared_capacity=1.0,
                    interference_summary=0.0,
                    capacity_margin=1.0,
                ),
            ),
            global_resource_features=(0.0, 0.0, 1.0),
        )


