        uncapped = _coalition_row("synergy", tmp_count=5, members=(0, 1, 2, 3, 4))
        assert uncapped.capped_decomposition is False
        assert uncapped.credit_split == "NOT_COMPUTED_LARGE_SET"
        assert float.fromhex(uncapped.decomposition_weight_hex) == 1.0
        decomposition = capped_coalition_decomposition(tuple(range(5)))
        assert decomposition == ((tuple(range(5)), 1.0),)
        uncapped_rows = tuple(
