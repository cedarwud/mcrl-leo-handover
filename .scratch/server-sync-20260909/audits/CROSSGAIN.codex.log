+        for index, (source, target, gain) in enumerate(retained):
+            block[index] = (
+                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
+                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
+                gain,
+                1.0,
+            )
+        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))
