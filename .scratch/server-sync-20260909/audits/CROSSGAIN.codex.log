codex
For the diagnostic I found 180 existing coalition shards across the two pilot worlds. They already retain the raw relation tuples in their serialized contexts even though the old head reduced them; relation counts are 2, 6, or 12, so the declared K=32 drops none of these rows (residual is exactly zero for this pilot). I’ll fit the same deterministic cross-validated ridge procedure to scalar-only versus scalar-plus-pair encodings and report out-of-sample \(R^2\), not training fit.
exec
/bin/bash -lc "nice -n 10 env PYTHONPATH=src /home/sat/mcrl-leo-handover/.venv/bin/python - <<'PY'
from dataclasses import replace
from pathlib import Path
import glob, json, hashlib
import numpy as np
from mcrl.stagec_v025.coalitions import AffectedBeamContext, CoalitionContext, CoalitionMember
from mcrl.stagec_v025.state import PhysicalAction

def f(x): return float.fromhex(x)
def action(x): return PhysicalAction(x['norad_id'], x['beam_chain_id'])
def load_context(p):
    return CoalitionContext(
        anchor_id=p['anchor_id'],
        reference_profile=tuple((r['user_id'], action(r['action'])) for r in p['reference_profile']),
        members=tuple(CoalitionMember(
            r['user_id'], action(r['reference_action']), action(r['selected_action']),
            tuple(map(f, r['selected_q1_row_hex'])), tuple(map(f, r['incumbent_q1_row_hex'])),
            r['missing_incumbent'],
        ) for r in p['members']),
        affected_beams=tuple(AffectedBeamContext(
            r['beam_key'], r['occupancy_before'], r['occupancy_after'], r['active_before'],
            r['active_after'], f(r['shared_capacity_hex']), f(r['interference_summary_hex']),
            f(r['capacity_margin_hex']),
        ) for r in p['affected_beams']),
        global_resource_features=tuple(map(f, p['global_resource_features_hex'])),
        pairwise_cross_gain_terms=tuple((r['source_beam_key'], r['target_beam_key'], f(r['gain_hex'])) for r in p['pairwise_cross_gain_terms']),
    )
paths=sorted(glob.glob('artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM/rows/world-*/*coalition*.jsonl'))
old=[]; full=[]; y=[]; folds=[]
for path in paths:
    with open(path, encoding='ascii') as stream:
        next(stream); row=json.loads(next(stream))
    ctx=load_context(row['context'])
    width=len(ctx.members[0].invariant_features)
    full.append(ctx.invariant_vector(member_width=width))
    old.append(replace(ctx, pairwise_cross_gain_terms=()).invariant_vector(member_width=width))
    y.append(f(row['psi_normalized_hex']))
    identity=f\"{row['world_id']}|{row['anchor_id']}\"
    folds.append(int.from_bytes(hashlib.sha256(identity.encode()).digest()[:8], 'big') % 5)
y=np.asarray(y); folds=np.asarray(folds)

def cv_ridge(X):
    X=np.asarray(X)
    predictions_by_alpha=[]
    alphas=np.logspace(-6, 6, 25)
    for alpha in alphas:
        prediction=np.empty(len(y))
        for fold in range(5):
            train=folds "'!= fold; test=~train
            mean=X[train].mean(axis=0); scale=X[train].std(axis=0)
            keep=scale > 1e-14
            ztrain=(X[train][:,keep]-mean[keep])/scale[keep]
            ztest=(X[test][:,keep]-mean[keep])/scale[keep]
            design=np.column_stack((np.ones(train.sum()), ztrain))
            test_design=np.column_stack((np.ones(test.sum()), ztest))
            penalty=np.eye(design.shape[1]); penalty[0,0]=0
            coef=np.linalg.solve(design.T@design + alpha*penalty, design.T@y[train])
            prediction[test]=test_design@coef
        predictions_by_alpha.append(prediction)
    scores=np.asarray([1-np.sum((y-p)**2)/np.sum((y-y.mean())**2) for p in predictions_by_alpha])
    best=int(np.argmax(scores))
    return alphas[best], scores[best], predictions_by_alpha[best]
for label,X in [('"'old_scalar',old),('with_pair_block',full)]:
    alpha,r2,p=cv_ridge(X)
    print(label, 'n=',len(y),'p=',np.asarray(X).shape[1], 'alpha=',alpha,'cv_r2=',format(r2,'.12g'),'sse=',format(np.sum((y-p)**2),'.12g'))
print('target_variance=',format(np.var(y),'.12g'),'target_mean=',format(np.mean(y),'.12g'),'target_range=',(float(y.min()),float(y.max())))
