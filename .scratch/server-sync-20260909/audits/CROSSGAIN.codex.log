@dataclass(frozen=True, slots=True)
class CoalitionShard:
    path: Path
    file_sha256: str
    rows_sha256: str
    rows: tuple[CoalitionRow, ...]


def write_coalition_shard(path: str | Path, rows: Iterable[CoalitionRow]) -> CoalitionShard:
    material = tuple(rows)
    if not material:
        raise StageCContractError("cannot write an empty coalition shard")
    payloads = [row.payload() for row in material]
    rows_sha256 = canonical_sha256(payloads)
    header = {
        "schema": COALITION_SHARD_SCHEMA,
        "context_schema": COALITION_CONTEXT_SCHEMA,
        "context_payloads_sha256": canonical_sha256(
            [row.context.payload() for row in material]
        ),
        "split": "TRAIN",
        "row_count": len(material),
        "rows_sha256": rows_sha256,
        "interaction_label_coalition_size": "UNCAPPED",
        "max_reporting_shapley_coalition_size": MAX_LABEL_COALITION_SIZE,
        "row_schema": COALITION_ROW_SCHEMA,
        "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
    }
    encoded = b"\n".join(canonical_json_bytes(value) for value in (header, *payloads)) + b"\n"
    destination = Path(path)
    digest = write_once_with_sha256(destination, encoded)
    return CoalitionShard(destination, digest, rows_sha256, material)


def _action(payload: Mapping[str, object]) -> PhysicalAction:
    return PhysicalAction(
        None if payload["norad_id"] is None else int(payload["norad_id"]),
        None if payload["beam_chain_id"] is None else int(payload["beam_chain_id"]),
    )


def _context(payload: Mapping[str, object]) -> CoalitionContext:
    actual_schema = payload.get("context_schema", "<missing>")
    if actual_schema != COALITION_CONTEXT_SCHEMA:
        raise StageCContractError(
            "coalition context schema drifted: "
            f"expected {COALITION_CONTEXT_SCHEMA!r}, got {actual_schema!r}"
        )
                parse_float_hex(row["gain_hex"], field="pairwise_cross_gain"),
            )
            for row in payload["pairwise_cross_gain_terms"]
        ),
    )
    encoded_residual = parse_float_hex(
        payload["pairwise_cross_gain_residual_sum_hex"],
        field="pairwise_cross_gain_residual_sum",
    )
    _retained, expected_residual = context._bounded_pairwise_cross_gain_terms()
    if encoded_residual != expected_residual:
        raise StageCContractError(
            "coalition context pairwise residual drifted: "
            f"expected {float_hex(expected_residual)}, got {float_hex(encoded_residual)}"
        )
    return context


def read_coalition_shard(path: str | Path) -> CoalitionShard:
    source = Path(path)
    digest = verify_sha256_sidecar(source)
    try:
        raw_lines = source.read_bytes().splitlines()
        values = [json.loads(line.decode("ascii")) for line in raw_lines]
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise StageCContractError("cannot parse coalition shard") from error
    if not values or not isinstance(values[0], Mapping):
        raise StageCContractError("coalition shard header is missing")
    header = values[0]
    actual_versions = {
        "shard": header.get("schema", "<missing>"),
        "row": header.get("row_schema", "<missing>"),
        "context": header.get("context_schema", "<missing>"),
    }
    expected_versions = {
        "shard": COALITION_SHARD_SCHEMA,
        "row": COALITION_ROW_SCHEMA,
        "context": COALITION_CONTEXT_SCHEMA,
    }
    if actual_versions != expected_versions:
        raise StageCContractError(
            "coalition shard schema drifted: "
            f"expected {expected_versions}, got {actual_versions}"
        )
    expected_header = {
        "interaction_label_coalition_size": "UNCAPPED",
        "max_reporting_shapley_coalition_size": MAX_LABEL_COALITION_SIZE,
        "row_count": len(values) - 1,
        "row_schema": COALITION_ROW_SCHEMA,
        "rows_sha256": header.get("rows_sha256"),
        "schema": COALITION_SHARD_SCHEMA,
        "context_schema": COALITION_CONTEXT_SCHEMA,
        "context_payloads_sha256": header.get("context_payloads_sha256"),
        "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
        "split": "TRAIN",
    }
    if header != expected_header:
        raise StageCContractError(
            f"coalition shard header drifted for {COALITION_SHARD_SCHEMA}: "
            f"expected keys={sorted(expected_header)}, got keys={sorted(header)}"
        )
    if any(line != canonical_json_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise StageCContractError("coalition shard is not canonical JSONL")
    rows: list[CoalitionRow] = []
    for payload in values[1:]:
        if not isinstance(payload, Mapping) or set(payload) != set(CoalitionRow.__dataclass_fields__):
            raise StageCContractError("coalition row schema drifted")
        context = _context(payload["context"])
        scalar = {key: value for key, value in payload.items() if key != "context"}
        scalar["original_changed_users"] = tuple(
            int(user) for user in scalar["original_changed_users"]
            int(user) for user in scalar["original_changed_users"]
        )
        rows.append(CoalitionRow(context=context, **scalar))
    material = tuple(rows)
    rows_sha256 = canonical_sha256([row.payload() for row in material])
    if rows_sha256 != header["rows_sha256"]:
        raise StageCContractError("coalition shard row digest drifted")
    contexts_sha256 = canonical_sha256([row.context.payload() for row in material])
    if contexts_sha256 != header["context_payloads_sha256"]:
        raise StageCContractError(
            "coalition shard context payload digest drifted: "
            f"expected {header['context_payloads_sha256']}, got {contexts_sha256}"
        )
    return CoalitionShard(source, digest, rows_sha256, material)


__all__ = [
    "AffectedBeamContext",
    "COALITION_CONTEXT_SCHEMA",
    "COALITION_ROW_SCHEMA",
    "COALITION_SHARD_SCHEMA",
    "CoalitionContext",
    "CoalitionMember",
    "CoalitionRow",
    "CoalitionShard",
    "MAX_LABEL_COALITION_SIZE",

