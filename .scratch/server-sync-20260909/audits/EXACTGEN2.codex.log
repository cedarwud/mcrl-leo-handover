   754	def build_world_shared(pilot, world_index: int, first: int, stop: int,
   755	                       deadline: float) -> list[dict[str, object]]:
   756	    global _SHARED_WORLD
   757	    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
