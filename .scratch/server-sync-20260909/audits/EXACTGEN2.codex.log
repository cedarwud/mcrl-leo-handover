def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def atomic_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("wb") as handle:
        handle.write(json.dumps(payload, sort_keys=True, indent=2, allow_nan=False).encode())
        handle.write(b"\n")
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def assert_runtime() -> None:
    if sys.executable != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins are not all one: {bad}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below 15")


def load_pilot():
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    name = f"exact_source_build_pilot_{os.getpid()}"
    spec = importlib.util.spec_from_file_location(name, RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load pilot runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def load_calibration(pilot):
    payload = json.loads(CALIBRATION.read_text())

    def fraction(name: str) -> Fraction:
        numerator, denominator = payload[name]
        return Fraction(numerator, denominator)

    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
        bits_ref=fraction("bits_ref"),
        joules_ref=fraction("joules_ref"),
        users=int(payload["users"]),
    )


def fraction_payload(value: Fraction) -> dict[str, object]:
    return {
        "fraction": [value.numerator, value.denominator],
        "float_hex": float.hex(float(value)),
    }


def profile_payload(profile) -> dict[str, object]:
    return {
        "whole_network_bits_hex": float.hex(profile.bits),
        "whole_network_joules_hex": float.hex(profile.joules),
        "per_user_bits_hex": [
            [int(user), float.hex(float(bits))]
            for user, bits in sorted(profile.score.bits.items())
        ],
    }


def surrogate_labels(pilot, *, tape, step_index: int, carrier: str, user: int,
                     identity, base, incumbent, config, calibration,
                     row_indices) -> dict[str, object]:
    base_metric = pilot._primitive_metrics(
        tape, step_index, user, base.mapping[user], row_indices
    )
    metric = pilot._primitive_metrics(tape, step_index, user, identity, row_indices)
    base_gain = max(base_metric["gain"], 1e-300)
    ratio = max(metric["gain"], 1e-300) / base_gain
    if identity is None or not metric["legal"]:
        c1_normalized_without_phi = -1.0
    else:
        c1_normalized_without_phi = math.tanh(math.log(max(ratio, 1e-30)))
    c1_bits = float(calibration.kappa_bits_per_user_step) * c1_normalized_without_phi
    phi = pilot.ENGINE._phi_for(incumbent, config) - pilot.ENGINE._phi_for(incumbent, base)

    alive = True
    c2_normalized = 0.0
    for offset in (1, 2, 3):
        projected = step_index + offset
        future_metric = pilot._primitive_metrics(
            tape, projected, user, identity, row_indices
        )
        future_base = pilot.ENGINE._base_configuration(
            tape, projected, carrier
        ).mapping[user]
        future_base_metric = pilot._primitive_metrics(
            tape, projected, user, future_base, row_indices
        )
        future_ratio = max(future_metric["gain"], 1e-300) / max(
            future_base_metric["gain"], 1e-300
        )
        survives = bool(future_metric["legal"] and identity is not None)
        if alive:
            c2_normalized += (
                math.tanh(math.log(max(future_ratio, 1e-30))) if survives else -1.0
            )
            alive = survives
        else:
            c2_normalized -= 1.0
    c2_bits = float(calibration.kappa_bits_per_user_step) * c2_normalized
    return {
        "method": "provider-primitive-fallback-for-same-row",
        "c1_core_bits_hex": float.hex(c1_bits),
        "c1_phi_difference_hex": float.hex(float(phi)),
        "c1_normalized_total_hex": float.hex(
            c1_bits / float(calibration.kappa_bits_per_user_step) + float(phi)
        ),
        "c2_label_bits_hex": float.hex(c2_bits),
        "c2_normalized_total_hex": float.hex(c2_normalized),
    }


def write_anchor_shard(path: Path, header: dict[str, object], payloads: Iterable[dict[str, object]]) -> tuple[str, int, int]:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    digest = hashlib.sha256()
    row_count = 0
    with temporary.open("wb") as handle:
        for payload in (header, *payloads):
            encoded = canonical_bytes(payload) + b"\n"
            handle.write(encoded)
            digest.update(encoded)
            if payload is not header:
                row_count += 1
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)
    file_hash = digest.hexdigest()
    sidecar = path.with_suffix(path.suffix + ".sha256")
    sidecar_tmp = sidecar.with_name(f".{sidecar.name}.{os.getpid()}.tmp")
    sidecar_tmp.write_text(f"{file_hash}  {path.name}\n")
    sidecar_tmp.replace(sidecar)
    return file_hash, row_count, path.stat().st_size



def build_anchor(pilot, *, tape, setting, run_setting, calibration, world_index: int,
                 step_index: int, carrier_index: int, global_index: int) -> dict[str, object]:
    runner_before = sha256(RUNNER)
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("source fallback value was not true before in-process override")
    captured_forecasts = {}
    original_forecast = pilot.ENGINE._batched_stage2_forecasts

    def capture_forecast(**kwargs):
        result = original_forecast(**kwargs)
        captured_forecasts.update(result[0])
        return result

    carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_index]
    pilot.ENGINE._batched_stage2_forecasts = capture_forecast
    pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
    started = time.perf_counter()
    try:
        built = pilot._build_anchor_rows(
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step_index=step_index,
            carrier=carrier,
            anchor_index=step_index * len(CARRIERS) + carrier_index,
            include_coalition=False,
            full_legal_actions=False,
        )
    finally:
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = True
        pilot.ENGINE._batched_stage2_forecasts = original_forecast
    build_wall = time.perf_counter() - started
    if not captured_forecasts:
        raise AssertionError("exact branch did not call the batched forecast path")

    base = built["base"]
    incumbent = built["incumbent"]
    current = built["current_evaluator"]
    base_profile = current._evaluated[base.configuration_id]
    base_projections = captured_forecasts[base.configuration_id]
    rekeyed = pilot.ENGINE._rekeyed_users(tape, step_index)
    row_indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    from mcrl.physics_v025.targets import c1_difference_surplus, c2_persistence_forecast

    payloads = []
    gauge_max = Fraction()
    decomposition_max = Fraction()
    c2_decomposition_max = Fraction()
    attribution_max = 0.0
    default_payload = profile_payload(base_profile)
    default_phi = pilot.ENGINE._phi_for(
        incumbent, base, cell_rekeyed_users=rekeyed
    )
    for row in built["rows"]:
        identity = pilot._identity(row.action)
        mapping = base.mapping
        mapping[row.user_id] = identity
        config = pilot.ENGINE._configuration(base, mapping, kind="exact-source-attribution")
        profile = current._evaluated[config.configuration_id]
        candidate_phi = pilot.ENGINE._phi_for(
            incumbent, config, cell_rekeyed_users=rekeyed
        )
        c1 = c1_difference_surplus(
            profile.outcome(phi=candidate_phi),
            base_profile.outcome(phi=default_phi),
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        c2 = c2_persistence_forecast(
            captured_forecasts[config.configuration_id],
            base_projections,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        c1_residual = c1.normalized_total - (
            c1.difference_surplus_bits / calibration.kappa_bits_per_user_step
            + c1.phi_difference
        )
        c2_residual = c2.normalized_total - (
            (c2.forecast_surplus_bits - c2.persistence_penalty_bits)
            / calibration.kappa_bits_per_user_step
        )
        decomposition_max = max(decomposition_max, abs(c1_residual))
        c2_decomposition_max = max(c2_decomposition_max, abs(c2_residual))
        if row.reference_action:
            gauge_max = max(gauge_max, abs(c1.normalized_total))
        attribution_max = max(
            attribution_max,
            abs(math.fsum(profile.score.bits.values()) - profile.bits),
            abs(math.fsum(base_profile.score.bits.values()) - base_profile.bits),
        )
        surrogate = surrogate_labels(
            pilot,
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            user=row.user_id,
            identity=identity,
            base=base,
            incumbent=incumbent,
            config=config,
            calibration=calibration,
            row_indices=row_indices,
        )
        payload = row.payload()
        payload["exact_source"] = {
            "schema": "mcrl-v025-exact-source-extension-v1",
            "c1_difference_surplus": {
                "core_bits": fraction_payload(c1.difference_surplus_bits),
                "phi_difference": fraction_payload(c1.phi_difference),
                "normalized_total": fraction_payload(c1.normalized_total),
                "decomposition_residual": fraction_payload(c1_residual),
            },
            "c2_persistence_forecast": {
                "forecast_surplus_bits": fraction_payload(c2.forecast_surplus_bits),
                "lost_offsets": c2.lost_offsets,
                "persistence_penalty_bits": fraction_payload(c2.persistence_penalty_bits),
                "label_bits": fraction_payload(
                    c2.forecast_surplus_bits - c2.persistence_penalty_bits
                ),
                "normalized_total": fraction_payload(c2.normalized_total),
                "decomposition_residual": fraction_payload(c2_residual),
            },
            "candidate": profile_payload(profile),
            "default": default_payload,
            "surrogate": surrogate,
            "evaluation_path": {
                "candidate_current": "evaluate_many",
                "default_current": "evaluate_many",
                "candidate_forecasts": "evaluate_many",
                "default_forecasts": "evaluate_many",
                "post_population_access": "evaluate-cache-hit",
                "c1_target": "c1_difference_surplus",
                "c2_target": "c2_persistence_forecast",
                "surrogate": "provider-primitive-array-lookup",
                "boundary_indices": [0],
            },
        }
        payloads.append(payload)

    anchor_within_world = step_index * len(CARRIERS) + carrier_index
    relative = Path(f"world-{world_index + 1}") / f"{LABEL}-exact-source-anchor-{anchor_within_world:03d}.jsonl"
    staging_path = STAGING / f"global-{global_index:03d}" / relative
    header = {
        "schema": "mcrl-v025-exact-source-shard-v1",
        "artifact_label": LABEL,
        "world_index": world_index + 1,
        "world_id": tape.domain,
        "global_anchor_index": global_index,
        "anchor_index_within_world": anchor_within_world,
        "step_index": step_index,
        "carrier_index": carrier_index,
        "carrier": carrier,
        "row_count": len(payloads),
        "existing_row_schema": payloads[0]["schema"],
        "extension_schema": "mcrl-v025-exact-source-extension-v1",
    }
    file_hash, row_count, byte_count = write_anchor_shard(staging_path, header, payloads)
    record = {
        "global_anchor_index": global_index,
        "world_index": world_index + 1,
        "world_id": tape.domain,
        "anchor_index_within_world": anchor_within_world,
        "step_index": step_index,
        "carrier_index": carrier_index,
        "carrier": carrier,
        "relative_path": relative.as_posix(),
        "staging_path": staging_path.relative_to(OUTPUT).as_posix(),
        "file_sha256": file_hash,
        "row_count": row_count,
        "byte_count": byte_count,
        "build_wall_s": build_wall,
        "physics_boundary_evaluations": int(built["physics_calls"]),
        "skipped_invalid": int(built["skipped_invalid"]),
        "gauge_max_abs": fraction_payload(gauge_max),
        "c1_decomposition_max_abs": fraction_payload(decomposition_max),
        "c2_decomposition_max_abs": fraction_payload(c2_decomposition_max),
        "per_user_attribution_sum_max_abs_bits": attribution_max,
        "runner_sha256_before": runner_before,
        "runner_sha256_after": sha256(RUNNER),
        "fallback_source_value_restored": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True,
    }
    if record["runner_sha256_after"] != runner_before:
        raise AssertionError("runner bytes changed during anchor build")
    if gauge_max or decomposition_max or c2_decomposition_max or attribution_max:
        raise AssertionError(f"exact identities failed: {record}")
    atomic_json(staging_path.with_suffix(".result.json"), record)
    return record


def world_plan_worker(plan: tuple[int, ...], deadline: float) -> list[dict[str, object]]:
    assert_runtime()
    if _SHARED_WORLD is None:
        raise RuntimeError("shared world was not prepared before fork")
    pilot, tape, setting, run_setting, calibration, world_index, tape_wall = _SHARED_WORLD
    if tuple(pilot.ENGINE.REFERENCE_CARRIERS) != CARRIERS:
        raise AssertionError("carrier order drifted")
    records = []
    for global_index in plan:
        if time.time() >= deadline:
            break
        within = global_index - world_index * ANCHORS_PER_WORLD
        step_index, carrier_index = divmod(within, len(CARRIERS))
        record = build_anchor(
            pilot,
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            world_index=world_index,
            step_index=step_index,
            carrier_index=carrier_index,

