def world_plan_worker(plan: tuple[int, ...], deadline: float) -> list[dict[str, object]]:
    assert_runtime()
    if _SHARED_WORLD is None:
        raise RuntimeError("shared world was not prepared before fork")
    pilot, tape, setting, run_setting, calibration, world_index, tape_wall = _SHARED_WORLD
    if tuple(pilot.ENGINE.REFERENCE_CARRIERS) != CARRIERS:
        raise AssertionError("carrier order drifted")
    records = []
    for global_index in plan:
        if time.time() >= deadline:
            break
        within = global_index - world_index * ANCHORS_PER_WORLD
        step_index, carrier_index = divmod(within, len(CARRIERS))
        record = build_anchor(
            pilot,
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            world_index=world_index,
            step_index=step_index,
            carrier_index=carrier_index,
            global_index=global_index,
        )
        record["worker_tape_build_wall_s"] = tape_wall
        records.append(record)
        print(
            json.dumps(
                {
                    "phase": "exact-source-build",
                    "completed_global_anchor": global_index,
                    "world": world_index + 1,
                    "step": step_index,
                    "carrier": CARRIERS[carrier_index],
                    "rows": record["row_count"],
                    "wall_s": round(float(record["build_wall_s"]), 3),
                }
            ),
            flush=True,
        )
    return records


def build_world_shared(pilot, world_index: int, first: int, stop: int,
                       deadline: float) -> list[dict[str, object]]:
    global _SHARED_WORLD
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape

    tape_started = time.perf_counter()
    tape = build_world_tape(
        domain=pilot.TRAIN_WORLDS[world_index],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=33,
        start_time_s=0.0,
    )
    tape_wall = time.perf_counter() - tape_started
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    calibration = load_calibration(pilot)
    _SHARED_WORLD = (
        pilot, tape, setting, run_setting, calibration, world_index, tape_wall
    )
    plans = tuple(
        tuple(range(first + residue, stop, 4))
        for residue in range(4)
        if first + residue < stop
    )
    records = []
    context = mp.get_context("fork")
    # The parent computes residue 0 while three forked children compute the
    # other residues.  All four share the read-only dense tape pages.
    with concurrent.futures.ProcessPoolExecutor(
        max_workers=min(3, max(1, len(plans) - 1)), mp_context=context
    ) as executor:
        futures = [
            executor.submit(world_plan_worker, plan, deadline)
            for plan in plans[1:]
        ]
        records.extend(world_plan_worker(plans[0], deadline))
        for future in concurrent.futures.as_completed(futures):
            records.extend(future.result())
    _SHARED_WORLD = None
    del tape
    gc.collect()
    return records


def average_ranks(values: list[float]) -> list[float]:
    order = sorted(range(len(values)), key=lambda index: (values[index], index))
    ranks = [0.0] * len(values)
    position = 0
    while position < len(order):
        end = position + 1
        value = values[order[position]]
        while end < len(order) and values[order[end]] == value:
            end += 1
        rank = (position + 1 + end) / 2.0
        for index in order[position:end]:
            ranks[index] = rank
        position = end
    return ranks


def correlation(first: list[float], second: list[float]) -> float:
    mean_first = statistics.fmean(first)
    mean_second = statistics.fmean(second)
    numerator = math.fsum(
        (left - mean_first) * (right - mean_second)
        for left, right in zip(first, second, strict=True)
    )
    denominator = math.sqrt(
        math.fsum((value - mean_first) ** 2 for value in first)
        * math.fsum((value - mean_second) ** 2 for value in second)
    )
    return numerator / denominator


def verify(records: list[dict[str, object]]) -> dict[str, object]:
    exact_c1: list[float] = []
    surrogate_c1: list[float] = []
    exact_c2: list[float] = []
    surrogate_c2: list[float] = []
    exact_combined: list[float] = []
    surrogate_combined: list[float] = []
    groups: dict[tuple[int, int], list[tuple[int, float, float, float, float, float, float]]] = {}
    gauge_max = 0.0
    c1_residual_max = 0.0
    c2_residual_max = 0.0
    attribution_max = 0.0
    rows_seen = 0
    for record in records:
        path = ROWS / str(record["relative_path"])
        if sha256(path) != record["file_sha256"]:
            raise AssertionError(f"shard hash mismatch: {path}")
        with path.open() as handle:
            header = json.loads(next(handle))
            count = 0
            for line in handle:
                payload = json.loads(line)
                count += 1
                rows_seen += 1
                extension = payload["exact_source"]
                c1 = float.fromhex(extension["c1_difference_surplus"]["normalized_total"]["float_hex"])
                s1 = float.fromhex(extension["surrogate"]["c1_normalized_total_hex"])
                c2 = float.fromhex(extension["c2_persistence_forecast"]["normalized_total"]["float_hex"])
                s2 = float.fromhex(extension["surrogate"]["c2_normalized_total_hex"])
                exact_c1.append(c1)
                surrogate_c1.append(s1)
                exact_c2.append(c2)
                surrogate_c2.append(s2)
                exact_combined.append(c1 + c2)
                surrogate_combined.append(s1 + s2)
                key = (int(record["global_anchor_index"]), int(payload["user_id"]))
                groups.setdefault(key, []).append(
                    (int(payload["action_index"]), c1, s1, c2, s2, c1 + c2, s1 + s2)
                )
                if payload["reference_action"]:
                    gauge_max = max(gauge_max, abs(c1))
                c1_residual_max = max(
                    c1_residual_max,
                    abs(float.fromhex(extension["c1_difference_surplus"]["decomposition_residual"]["float_hex"])),
                )
                c2_residual_max = max(
                    c2_residual_max,
                    abs(float.fromhex(extension["c2_persistence_forecast"]["decomposition_residual"]["float_hex"])),
                )
                for endpoint in ("candidate", "default"):
                    values = [
                        float.fromhex(row[1])
                        for row in extension[endpoint]["per_user_bits_hex"]
                    ]
                    expected = float.fromhex(extension[endpoint]["whole_network_bits_hex"])
                    attribution_max = max(attribution_max, abs(math.fsum(values) - expected))
            if count != header["row_count"] or count != record["row_count"]:
                raise AssertionError(f"row-count mismatch: {path}")

    def disagreement(column_exact: int, column_surrogate: int) -> dict[str, object]:
        differing = 0
        for rows in groups.values():
            exact_winner = min(rows, key=lambda row: (-row[column_exact], row[0]))[0]
            surrogate_winner = min(rows, key=lambda row: (-row[column_surrogate], row[0]))[0]
            differing += int(exact_winner != surrogate_winner)
        return {
            "groups": len(groups),
            "different": differing,
            "fraction": differing / len(groups),
            "tie_break": "lowest action_index among exact-equal maxima",
        }

    result = {
        "schema": "mcrl-v025-exact-source-verification-v1",
        "artifact_label": LABEL,
        "anchors": len(records),
        "rows": rows_seen,
        "groups": len(groups),
        "c1_gauge_max_abs": gauge_max,
        "c1_decomposition_identity_max_abs": c1_residual_max,
        "c2_decomposition_identity_max_abs": c2_residual_max,
        "per_user_bits_sum_identity_max_abs_bits": attribution_max,
        "c1_exact_vs_surrogate": {
            "pearson_correlation": correlation(exact_c1, surrogate_c1),
            "spearman_rank_correlation": correlation(
                average_ranks(exact_c1), average_ranks(surrogate_c1)
            ),
            "argmax_disagreement": disagreement(1, 2),
        },
        "c2_exact_vs_surrogate": {
            "pearson_correlation": correlation(exact_c2, surrogate_c2),
            "spearman_rank_correlation": correlation(
                average_ranks(exact_c2), average_ranks(surrogate_c2)
            ),
            "argmax_disagreement": disagreement(3, 4),
        },
        "c1_plus_c2_exact_vs_surrogate": {
            "pearson_correlation": correlation(exact_combined, surrogate_combined),
            "spearman_rank_correlation": correlation(
                average_ranks(exact_combined), average_ranks(surrogate_combined)
            ),
            "argmax_disagreement": disagreement(5, 6),
        },
        "evaluation_path": {
            "candidate_and_default_current": "evaluate_many",
            "candidate_and_default_forecasts": "evaluate_many",
            "access_after_population": "evaluate-cache-hit",
            "boundary_indices": [0],
        },
    }
    if any((gauge_max, c1_residual_max, c2_residual_max, attribution_max)):
        raise AssertionError(f"verification identity failed: {result}")
    return result


def promote_prefix(staged_records: list[dict[str, object]]) -> list[dict[str, object]]:
    by_index = {int(row["global_anchor_index"]): row for row in staged_records}
    prefix = []
    for index in range(TOTAL_ANCHORS):
        if index not in by_index:
            break
        record = by_index[index]
        source = OUTPUT / str(record["staging_path"])
        destination = ROWS / str(record["relative_path"])
        destination.parent.mkdir(parents=True, exist_ok=True)
        source.replace(destination)
        source_sidecar = source.with_suffix(source.suffix + ".sha256")
        destination_sidecar = destination.with_suffix(destination.suffix + ".sha256")
        source_sidecar.replace(destination_sidecar)
        prefix.append(record)
    return prefix


def one_anchor_child(pilot, tape, setting, run_setting, calibration, world_index: int,
                     global_index: int, tape_wall: float) -> None:
    """Build exactly one anchor, then exit so evaluator memory is reclaimed."""
    first = world_index * ANCHORS_PER_WORLD
    within = global_index - first
    step_index, carrier_index = divmod(within, len(CARRIERS))
    record = build_anchor(
        pilot,
        tape=tape,
        setting=setting,
        run_setting=run_setting,
        calibration=calibration,
        world_index=world_index,
        step_index=step_index,
        carrier_index=carrier_index,
        global_index=global_index,
    )
    record["worker_tape_build_wall_s"] = tape_wall
    # build_anchor already wrote the authoritative result checkpoint.


def main() -> int:
    assert_runtime()
    if MANIFEST.exists():
        raise RuntimeError(f"completed manifest already exists: {MANIFEST}")
    calibration_result = json.loads(CALIBRATION_RESULTS.read_text())
    reconciled_rate = float(calibration_result["reconciled"]["exact_mean_s_per_anchor"])
    projected = reconciled_rate * TOTAL_ANCHORS / 4
    if projected >= BUILD_BUDGET_S:
        planned = int(BUILD_BUDGET_S * 4 // reconciled_rate)
    else:
        planned = TOTAL_ANCHORS
    OUTPUT.mkdir(parents=True, exist_ok=True)
    STAGING.mkdir(exist_ok=True)
    build_started_wall = PART2_BUDGET_ORIGIN_UNIX_S
    build_started_mono = time.monotonic()
    deadline = PART2_BUDGET_ORIGIN_UNIX_S + BUILD_BUDGET_S
    runner_before = sha256(RUNNER)
    pilot = load_pilot()
    all_records = [
        json.loads(path.read_text())
        for path in sorted(STAGING.rglob("*.result.json"))
    ]
    existing = {int(row["global_anchor_index"]) for row in all_records}
    # Four concurrent full-tape evaluators proved slower than one because of
    # memory-bandwidth pressure.  A single long-lived process now maximizes the
    # number of completed anchors while remaining below the hard cap.
    for world_index in range(WORLD_COUNT):
        first = world_index * ANCHORS_PER_WORLD
        stop = min((world_index + 1) * ANCHORS_PER_WORLD, planned)
        if first >= stop or time.time() >= deadline:
            break
        from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
        from mcrl.physics_v025.tapes import build_world_tape
        tape_started = time.perf_counter()
        tape = build_world_tape(
            domain=pilot.TRAIN_WORLDS[world_index],
            provider=LegacyWorldProvider(role="pilot-source"),
            steps=33,
            start_time_s=0.0,
        )
        tape_wall = time.perf_counter() - tape_started
        setting = pilot.ENGINE._setting("a-r0")
        run_setting = pilot.ENGINE.run_setting_for("a-r0")
        calibration = load_calibration(pilot)
        child_context = mp.get_context("fork")
        for global_index in range(first, stop):
            if global_index in existing:
                continue
            if time.time() >= deadline:
                break
            within = global_index - first
            step_index, carrier_index = divmod(within, len(CARRIERS))
            child = child_context.Process(
                target=one_anchor_child,
                args=(
                    pilot, tape, setting, run_setting, calibration,
                    world_index, global_index, tape_wall,
                ),
            )
            child.start()
            child.join()
            if child.exitcode != 0:
                print(json.dumps({
                    "phase": "exact-source-build-anchor-child-failed",
                    "global_anchor": global_index,
                    "exit_code": child.exitcode,
                }), flush=True)
                break
            anchor_within_world = step_index * len(CARRIERS) + carrier_index
            result_path = (
                STAGING / f"global-{global_index:03d}" / f"world-{world_index + 1}"
                / f"{LABEL}-exact-source-anchor-{anchor_within_world:03d}.result.json"
            )
            record = json.loads(result_path.read_text())
            record["worker_tape_build_wall_s"] = tape_wall
            all_records.append(record)
            existing.add(global_index)
            print(json.dumps({
                "phase": "exact-source-build-single-worker",
                "completed_global_anchor": global_index,
                "world": world_index + 1,
                "step": step_index,
                "carrier": CARRIERS[carrier_index],
                "rows": record["row_count"],
                "wall_s": round(float(record["build_wall_s"]), 3),
            }), flush=True)
            gc.collect()
        del tape
        gc.collect()
        completed = {int(row["global_anchor_index"]) for row in all_records}
        if any(index not in completed for index in range(first, stop)):
            break
    runner_after = sha256(RUNNER)
    if runner_after != runner_before:
        raise AssertionError("pilot runner bytes changed during build")
    prefix = promote_prefix(all_records)
    discarded_nonprefix = len(all_records) - len(prefix)
    # Staging contains only this build's recoverable temporary checkpoints.
    # Once the clean prefix is promoted, discard non-prefix and result scratch.
    shutil.rmtree(STAGING)
    verification = verify(prefix)
    atomic_json(VERIFICATION, verification)
    manifest_records = []
    for record in prefix:
        clean = dict(record)
        clean.pop("staging_path", None)
        manifest_records.append(clean)
    manifest = {
        "schema": "mcrl-v025-exact-source-build-manifest-v1",
        "artifact_label": LABEL,
        "status": "complete" if len(prefix) == TOTAL_ANCHORS else "truncated-prefix",
        "not_a_claim": True,
        "declared_order": {
