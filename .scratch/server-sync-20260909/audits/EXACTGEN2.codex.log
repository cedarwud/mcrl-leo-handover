   802	def average_ranks(values: list[float]) -> list[float]:
   803	    order = sorted(range(len(values)), key=lambda index: (values[index], index))
   804	    ranks = [0.0] * len(values)
   805	    position = 0
   806	    while position < len(order):
   807	        end = position + 1
   808	        value = values[order[position]]
   809	        while end < len(order) and values[order[end]] == value:
   810	            end += 1
   811	        rank = (position + 1 + end) / 2.0
   812	        for index in order[position:end]:
   813	            ranks[index] = rank
   814	        position = end
   815	    return ranks
   816	
   817	
   818	def correlation(first: list[float], second: list[float]) -> float:
   819	    mean_first = statistics.fmean(first)
   820	    mean_second = statistics.fmean(second)
   821	    numerator = math.fsum(
   822	        (left - mean_first) * (right - mean_second)
   823	        for left, right in zip(first, second, strict=True)
   824	    )
   825	    denominator = math.sqrt(
   826	        math.fsum((value - mean_first) ** 2 for value in first)
   827	        * math.fsum((value - mean_second) ** 2 for value in second)
   828	    )
   829	    return numerator / denominator
