        aggressors = [
            (int(identity[0]), int(identity[1]))
            for identity in self.aggressor_identities
        ]
        rows: list[PrimitiveCandidate] = []
        for row, raw_identity in enumerate(self.identities):
            identity = (int(raw_identity[0]), int(raw_identity[1]))
            nominal_identity = []
