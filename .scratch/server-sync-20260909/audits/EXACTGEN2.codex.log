#!/usr/bin/env python3
"""Reconcile exact versus primitive source-row build timings.

DIAGNOSTIC_NOT_CLAIM.  The pilot fallback is changed only on the imported
module object.  No source or sealed artefact is written.
"""

from __future__ import annotations

import concurrent.futures
from fractions import Fraction
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import statistics
import sys
import time


WORKSPACE = Path("/home/sat/mcrl-v025-datepool-ws")
SOURCE_ROOT = Path("/home/sat/mcrl-v025-c1c2suff-ws")
RUNNER = SOURCE_ROOT / "scripts/run_v025_pilot_c3.py"
CALIBRATION = (
    SOURCE_ROOT
    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
    / "PILOT_NOT_CLAIM-calibration.json"
)
OUT = WORKSPACE / ".scratch/exact-source-build/calibration-results.json"
PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
THREAD_VARS = (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
)
ANCHORS = (
    (0, 0, 0),
    (0, 0, 1),
    (0, 0, 2),
    (1, 0, 0),
)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def assert_runtime() -> None:
    if sys.executable != PYTHON:
        raise RuntimeError(f"wrong interpreter: {sys.executable}")
    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
    if bad:
        raise RuntimeError(f"BLAS thread pins are not all one: {bad}")
    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
        raise RuntimeError("process niceness is below 15")


def load_pilot():
    sys.path.insert(0, str(SOURCE_ROOT / "src"))
    name = f"exact_source_calibration_pilot_{os.getpid()}"
    spec = importlib.util.spec_from_file_location(name, RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load pilot runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def load_calibration(pilot):
    payload = json.loads(CALIBRATION.read_text())

    def fraction(name: str) -> Fraction:
        numerator, denominator = payload[name]
        return Fraction(numerator, denominator)

    return pilot.PilotCalibration(
        eta_ref=fraction("eta_ref"),
        lambda_bits_per_j=fraction("lambda_bits_per_j"),
        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
        bits_ref=fraction("bits_ref"),
        joules_ref=fraction("joules_ref"),
        users=int(payload["users"]),
    )


def timed_build(pilot, *, tape, setting, run_setting, calibration, step, carrier,
                anchor_index, path: str, include_coalition: bool) -> dict[str, object]:
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("fallback source value was not true before timing")
    if path == "exact":
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
        builder = pilot._build_anchor_rows
    elif path == "primitive":
        builder = pilot._build_anchor_rows
    else:
        raise ValueError(path)
    started = time.perf_counter()
    try:
        built = builder(
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step_index=step,
            carrier=carrier,
            anchor_index=anchor_index,
            include_coalition=include_coalition,
            full_legal_actions=False,
        )
    finally:
        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = True
    wall = time.perf_counter() - started
    return {
        "path": path,
        "include_coalition": include_coalition,
        "wall_s": wall,
        "source_rows": len(built["rows"]),
        "coalition_rows": int(built["coalition_row"] is not None),
        "physics_boundary_evaluations": int(built["physics_calls"]),
        "current_physical_evaluations": int(built["current_evaluator"].physical_evaluations),
        "catalogue_count": int(built["catalogue_count"]),
    }


def worker(specification: tuple[int, int, int]) -> dict[str, object]:
    assert_runtime()
    runner_before = sha256(RUNNER)
    pilot = load_pilot()
    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
        raise AssertionError("sealed fallback source value is not true")
    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
    from mcrl.physics_v025.tapes import build_world_tape

    world_index, step, carrier_index = specification
    tape_started = time.perf_counter()
    tape = build_world_tape(
        domain=pilot.TRAIN_WORLDS[world_index],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=4,
        start_time_s=0.0,
    )
    tape_wall = time.perf_counter() - tape_started
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    calibration = load_calibration(pilot)
    carrier = pilot.ENGINE.REFERENCE_CARRIERS[carrier_index]
    anchor_index = step * len(pilot.ENGINE.REFERENCE_CARRIERS) + carrier_index
    measurements = []
    for path in ("primitive", "exact"):
        row = timed_build(
            pilot,
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step=step,
            carrier=carrier,
            anchor_index=anchor_index,
            path=path,
            include_coalition=False,
        )
        row["cache_condition"] = "fresh-evaluators; warm-import-and-tape"
        measurements.append(row)
    if specification == ANCHORS[0]:
        for path in ("primitive", "exact"):
            row = timed_build(
                pilot,
                tape=tape,
                setting=setting,
                run_setting=run_setting,
                calibration=calibration,
                step=step,
                carrier=carrier,
                anchor_index=anchor_index,
                path=path,
                include_coalition=True,
            )
            row["cache_condition"] = "fresh-evaluators; warm-import-and-tape"
            measurements.append(row)
        repeat = timed_build(
            pilot,
            tape=tape,
            setting=setting,
            run_setting=run_setting,
            calibration=calibration,
            step=step,
            carrier=carrier,
            anchor_index=anchor_index,
            path="exact",
            include_coalition=False,
        )
        repeat["cache_condition"] = "repeat-exact; warm-import-tape-and-OS"
        measurements.append(repeat)
    runner_after = sha256(RUNNER)
    if runner_after != runner_before:
        raise AssertionError("pilot runner bytes changed")
    return {
        "world_index": world_index,
        "world": tape.domain,
        "step": step,
        "carrier_index": carrier_index,
        "carrier": carrier,
        "anchor_index_within_world": anchor_index,
        "tape_steps": len(tape.steps),
        "tape_build_wall_s_excluded": tape_wall,
        "selection_boundary_indices": list(pilot.ENGINE.SELECTION_BOUNDARY_INDICES),
        "runner_sha256_before": runner_before,
        "runner_sha256_after": runner_after,
        "measurements": measurements,
    }


def main() -> int:
    assert_runtime()
    started = time.perf_counter()
    rows = []
    # The coordinator is itself a Python process.  It computes one anchor while
    # three children compute the others, keeping the literal process total at 4.
    with concurrent.futures.ProcessPoolExecutor(max_workers=3) as executor:
        futures = {executor.submit(worker, item): item for item in ANCHORS[1:]}
        own = worker(ANCHORS[0])
        rows.append(own)
        short = [
            {
                "path": value["path"],
                "coalition": value["include_coalition"],
                "wall_s": round(float(value["wall_s"]), 3),
                "physics": value["physics_boundary_evaluations"],
            }
            for value in own["measurements"]
        ]
        print(json.dumps({"completed_anchor": ANCHORS[0], "measurements": short}), flush=True)
        for future in concurrent.futures.as_completed(futures):
            item = futures[future]
            row = future.result()
            rows.append(row)
            short = [
                {
                    "path": value["path"],
                    "coalition": value["include_coalition"],
                    "wall_s": round(float(value["wall_s"]), 3),
                    "physics": value["physics_boundary_evaluations"],
                }
                for value in row["measurements"]
            ]
            print(json.dumps({"completed_anchor": item, "measurements": short}), flush=True)
    rows.sort(key=lambda row: (row["world_index"], row["step"], row["carrier_index"]))
    baseline = [
        value
        for row in rows
        for value in row["measurements"]
        if not value["include_coalition"]
        and value["cache_condition"] == "fresh-evaluators; warm-import-and-tape"
    ]
    exact = [row for row in baseline if row["path"] == "exact"]
    primitive = [row for row in baseline if row["path"] == "primitive"]
    exact_mean = statistics.fmean(float(row["wall_s"]) for row in exact)
    primitive_mean = statistics.fmean(float(row["wall_s"]) for row in primitive)
    payload = {
        "schema": "v025-exact-source-calibration-v1",
        "label": "DIAGNOSTIC_NOT_CLAIM",
        "interpreter": sys.executable,
        "max_processes": 4,
        "nice": os.getpriority(os.PRIO_PROCESS, 0),
        "blas_threads": {name: os.environ[name] for name in THREAD_VARS},
        "anchor_specifications": [list(row) for row in ANCHORS],
        "results": rows,
        "reconciled": {
            "configuration": {
                "include_coalition": False,
                "full_legal_actions": False,
                "one_carrier_per_anchor": True,
                "selection_and_forecast_boundaries": [0],
                "tape_build_excluded": True,
                "fresh_evaluators": True,
#!/usr/bin/env python3
"""Build the declared exact-path V0.25 source corpus.

This is a new BUILD_NOT_CLAIM artefact.  The source runner is loaded read-only;
PILOT_PRIMITIVE_SOURCE_FALLBACK is overridden only on each imported module
object while an anchor is built.
"""

