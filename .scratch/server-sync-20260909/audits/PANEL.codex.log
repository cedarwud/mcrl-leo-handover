def head(payload):
    def arrays(key):
        return [np.vectorize(float.fromhex, otypes=[float])(np.asarray(a)) for a in payload[key]]
    opt = payload["optimizer"]
    return AdamMLPHead(
        arrays("weights_hex"), arrays("biases_hex"),
        arrays("adam_first_moment_weights_hex"), arrays("adam_second_moment_weights_hex"),
        arrays("adam_first_moment_biases_hex"), arrays("adam_second_moment_biases_hex"),
        payload["activation"], opt["learning_rate"], *opt["betas"], opt["epsilon"],
        opt["weight_decay"], payload["gauge_beta"], payload["loss_weight"], payload["adam_step"],
    )


def digest(value):
