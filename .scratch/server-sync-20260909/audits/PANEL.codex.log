result = {"label": "DIAGNOSTIC_NOT_CLAIM", "scope": "conditional proposal/catalogue seam; no policy or learner", "checkpoints": identities, "head_equalities_to_full": head_equalities, "tape_seconds": tape_s, "world_domain": tape.domain, "world_seed": tape.seed, "engine_sha256": hashlib.sha256(ENGINE_PATH.read_bytes()).hexdigest(), "anchors": records, "total_seconds": time.perf_counter() - started}
