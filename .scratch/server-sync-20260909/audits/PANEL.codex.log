# --- captured from the pre-seam tree, before any file in this change was edited
PRE_SEAM_ROW_COUNT = 12
PRE_SEAM_ROWS_BLOB_SHA256 = "73cfb9b232347a50fc154d83185b1be9100917238ba8c1bcbd8dcb3ebdf6afee"
PRE_SEAM_ROWS_CANONICAL_SHA256 = "8ac8affe787bc589c7e1183b568395ddbf12f8ba04a892b6d7c79f3ae3f1a0f3"
PRE_SEAM_SHARD_FILE_SHA256 = "6572064e8048e991534178e9be61880329ec5056b602789033f2d6f1630ee0bb"
PRE_SEAM_Q1_SCHEMA_SHA256 = "c002ea883a4ab727f9e00cc15866f5b9d37abca645963fd3db2f2db7c6cc887a"
PRE_SEAM_Q2_SCHEMA_SHA256 = "a891dd9831d76bccd981cef054ff204fa1d49c3cf6e5f3265015f16f1057019c"
PRE_SEAM_Q1_WIDTH = 16
PRE_SEAM_Q2_WIDTH = 22


def _rows(**kwargs) -> tuple:
    return tuple(
        row
        for anchor in make_synthetic_anchors()
        for row in extract_source_rows(anchor, **kwargs)
    )


def _blob(rows) -> bytes:
    return b"\n".join(canonical_json_bytes(row.payload()) for row in rows) + b"\n"


def test_default_rows_are_byte_identical_to_the_pre_seam_encoder() -> None:
    """D2: the default path reproduces today's rows byte for byte."""

    rows = _rows()
    assert len(rows) == PRE_SEAM_ROW_COUNT
    assert hashlib.sha256(_blob(rows)).hexdigest() == PRE_SEAM_ROWS_BLOB_SHA256
    assert (
        canonical_sha256([row.payload() for row in rows])
        == PRE_SEAM_ROWS_CANONICAL_SHA256
    )


def test_implicit_and_explicit_default_selection_agree_byte_for_byte() -> None:
    """Naming the default variant explicitly must change nothing at all."""

    implicit = _blob(_rows())
    explicit = _blob(_rows(encoder=encoder_variant(DEFAULT_ENCODER_VARIANT)))
    assert implicit == explicit


def test_default_schema_digests_and_widths_are_unmoved() -> None:
    variant = encoder_variant(DEFAULT_ENCODER_VARIANT)
    assert variant.q1_schema_sha256 == PRE_SEAM_Q1_SCHEMA_SHA256 == Q1_SCHEMA_SHA256
    assert variant.q2_schema_sha256 == PRE_SEAM_Q2_SCHEMA_SHA256 == Q2_SCHEMA_SHA256
    assert variant.q1_width == PRE_SEAM_Q1_WIDTH == len(Q1_FEATURES)
    assert variant.q2_width == PRE_SEAM_Q2_WIDTH == len(Q2_FEATURES)
    assert "encoder_variant" not in variant.q1_schema
    assert "encoder_variant" not in variant.q2_schema


def test_default_shard_file_is_byte_identical(tmp_path: Path) -> None:
    """Persistence, not just in-memory rows."""

    shard = write_source_shard(tmp_path / "source.jsonl", _rows())
    assert shard.file_sha256 == PRE_SEAM_SHARD_FILE_SHA256
    assert shard.rows_sha256 == PRE_SEAM_ROWS_CANONICAL_SHA256


def test_active_variant_defaults_to_production() -> None:
    assert active_encoder_variant().name == DEFAULT_ENCODER_VARIANT
    assert os.environ.get("MCRL_STAGEC_ENCODER_VARIANT") in (None, "", DEFAULT_ENCODER_VARIANT)


# --- D3: the throwaway proof variant -----------------------------------------


def test_identity_plus_zero_widens_by_exactly_one_zero() -> None:
    variant = encoder_variant(IDENTITY_PLUS_ZERO_NAME)
    default = encoder_variant(DEFAULT_ENCODER_VARIANT)
    assert variant.q1_width == default.q1_width + 1
    assert variant.q2_width == default.q2_width + 1
    for row, base in zip(_rows(encoder=variant), _rows(), strict=True):
        assert row.q1_state[:-1] == base.q1_state
        assert row.q2_state[:-1] == base.q2_state
        assert row.q1_state[-1] == 0.0
        assert row.q2_state[-1] == 0.0


def test_identity_plus_zero_round_trips_through_a_shard(tmp_path: Path) -> None:
    """D3: rows build, persist and read back at the wider width."""

    variant = encoder_variant(IDENTITY_PLUS_ZERO_NAME)
    rows = _rows(encoder=variant)
    shard = write_source_shard(tmp_path / "wide.jsonl", rows)
    restored = read_source_shard(tmp_path / "wide.jsonl")
    assert restored.rows == rows
    assert shard.file_sha256 != PRE_SEAM_SHARD_FILE_SHA256
    assert len(restored.rows[0].q1_state) == variant.q1_width


def test_identity_plus_zero_train_steps_at_the_wider_width(tmp_path: Path) -> None:
    """D3: the width change reaches the scalar heads with no other edit."""

    variant = encoder_variant(IDENTITY_PLUS_ZERO_NAME)
    shard = write_source_shard(tmp_path / "wide.jsonl", _rows(encoder=variant))
    batches = build_pairwise_batches((shard,))
    assert batches["C1"].reference_states.shape[1] == variant.q1_width
    assert batches["C2"].reference_states.shape[1] == variant.q2_width
    assert batches["C3"].reference_states.shape[1] == variant.q1_width + variant.q2_width


# --- provenance: a row can never be silently misattributed --------------------


def test_rows_resolve_back_to_the_encoder_that_built_them() -> None:
    for name in (DEFAULT_ENCODER_VARIANT, IDENTITY_PLUS_ZERO_NAME):
        variant = encoder_variant(name)
        row = _rows(encoder=variant)[0]
        assert (
            variant_for_digests(row.q1_schema_sha256, row.q2_schema_sha256).name == name
        )


def test_unregistered_digest_pair_is_rejected_on_read_back(tmp_path: Path) -> None:
    rows = _rows()
    payload = rows[0].payload()
    payload["q1_schema_sha256"] = "0" * 64
    path = tmp_path / "forged.jsonl"
    path.write_bytes(canonical_json_bytes(payload) + b"\n")
    with pytest.raises(StageCContractError):
        variant_for_digests(payload["q1_schema_sha256"], payload["q2_schema_sha256"])


def test_a_shard_may_not_mix_encoder_variants(tmp_path: Path) -> None:
    mixed = (*_rows()[:6], *_rows(encoder=encoder_variant(IDENTITY_PLUS_ZERO_NAME))[6:])
    with pytest.raises(StageCContractError, match="mixes encoder variants"):
        write_source_shard(tmp_path / "mixed.jsonl", mixed)


def test_a_variant_reusing_the_default_feature_list_still_gets_its_own_digests() -> None:
    """Digest uniqueness is by construction: non-default names are hashed in.

    This is the property that makes digest-based attribution sound.  A repair
    that changes *values* but not feature names/scales would otherwise be
    indistinguishable from production on the wire.
    """

    name = "SEAM_TEST_SAME_FEATURES_AS_DEFAULT"
    variant = (
        encoder_variant(name)
        if name in registered_encoder_variants()
        else register_encoder_variant(
            name,
            q1_features=Q1_FEATURES,
            q2_features=Q2_FEATURES,
            # Same features, different values: the wire must still tell them apart.
            q1_raw=lambda item: tuple(v + 1.0 for v in default_q1_raw(item)),
            q2_raw=lambda item: tuple(v + 1.0 for v in default_q2_raw(item)),
        )
    )
    default = encoder_variant(DEFAULT_ENCODER_VARIANT)
    assert variant.q1_features == default.q1_features
    assert variant.q1_width == default.q1_width
    assert variant.q1_schema_sha256 != default.q1_schema_sha256
    assert variant.q2_schema_sha256 != default.q2_schema_sha256
    assert variant.q1_schema["encoder_variant"] == name
    row = _rows(encoder=variant)[0]
    assert variant_for_digests(row.q1_schema_sha256, row.q2_schema_sha256).name == name


def test_duplicate_variant_name_is_rejected() -> None:
    with pytest.raises(StageCContractError, match="already registered"):
        register_encoder_variant(
