            q1_candidate = tuple(
                1.0 if index in {0, 2, 7} else 0.0
                for index in range(encoder.q1_width)
            )
            q2_candidate = tuple(
                1.0 if index in {1, 3, 12} else 0.0
                for index in range(encoder.q2_width)
            )
            result.append(
