+++ b/scripts/run_v025_pilot_c3.py
@@ -33,7 +33,12 @@
 from mcrl.physics_v025.constants_v025 import BEAM_RF_CAP_W, DECISION_INTERVAL_S
 from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
 from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape, digest_payload, seed_from_domain
-from mcrl.physics_v025.targets import c2_persistence_forecast, matched_anchor_decomposition
