        candidate = next(
            (row for row in tape.steps[step_index].boundaries[0].candidates
             if row.user_id == user and row.identity == identity),
            None,
        )
        if candidate is None:
            return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
        return {
            "legal": candidate.legal,
            "gain": candidate.nominal_gain,
            "remaining_d2": candidate.remaining_d2_s,
            "remaining_visibility": candidate.remaining_visibility_s,
        }
    row = indices[step_index].get((user, identity))
    if row is None:
        return {"legal": False, "gain": 0.0, "remaining_d2": 0.0, "remaining_visibility": 0.0}
    return {
        "legal": bool(arrays.visible[0, row] and arrays.d2_eligible[0, row] and arrays.cell_reachable[0, row]),
        "gain": float(arrays.nominal_gain[0, row]),
        "remaining_d2": float(arrays.remaining_d2_s[0, row]),
        "remaining_visibility": float(arrays.remaining_visibility_s[0, row]),
    }


def _build_anchor_rows_primitive(
    *, tape, setting, run_setting, calibration, step_index, carrier,
    anchor_index, include_coalition, full_legal_actions,
):
    """Schema-complete provider-primitive fallback for bounded pilot compute."""

    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    indices = {
        offset: tape.steps[offset].arrays._row_index()
        for offset in range(step_index, min(step_index + 4, len(tape.steps)))
        if tape.steps[offset].arrays is not None
    }
    # The generating-input digest already authenticates the provider inputs
    # and boundary-zero bytes. Computing ``tape.digest`` here hashes every
    # dense 33x48 array and dominates an entire anchor on this snapshot.
    tape_digest = tape.generating_input_digest or canonical_sha256({
        "domain": tape.domain,
        "seed": tape.seed,
        "provider": tape.protocol.provider_source_digest,
    })
    future_bases = {
        offset: ENGINE._base_configuration(tape, step_index + offset, carrier)
        for offset in (1, 2, 3)
    }
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape, setting, step_index, transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal", counter=counter, run_setting=run_setting,
        boundary_indices=(0,),
    )
    base_profile = current.evaluate(base)
    source_rows = []
    rows_by_user_action = {}
    for user in sorted(by_user):
        actions = []
        identities = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        base_metric = _primitive_metrics(
            tape, step_index, user, base.mapping[user], indices
        )
        base_gain = max(base_metric["gain"], 1e-300)
        for identity in by_user[user]:
            metric = _primitive_metrics(tape, step_index, user, identity, indices)
            ratio = max(metric["gain"], 1e-300) / base_gain
            gain_db = 10.0 * math.log10(max(ratio, 1e-30))
            if identity is None or not metric["legal"]:
                normalized_delta = -1.0
            else:
                normalized_delta = math.tanh(math.log(max(ratio, 1e-30)))
            candidate_margin = base_profile.min_decoding_margin_db + gain_db
            required_ratio = min(1e6, max(0.0, base_profile.required_power_w_max / BEAM_RF_CAP_W / max(ratio, 1e-12)))
            se = max(0.0, base_profile.mean_acm_se_bit_s_hz * min(4.0, max(0.0, ratio)))
            forecast_rows = []
            c2_normalized = 0.0
            alive = True
            for offset in (1, 2, 3):
                projected = step_index + offset
                future_metric = _primitive_metrics(tape, projected, user, identity, indices)
                future_base = future_bases[offset].mapping[user]
                future_base_metric = _primitive_metrics(tape, projected, user, future_base, indices)
                future_ratio = max(future_metric["gain"], 1e-300) / max(future_base_metric["gain"], 1e-300)
                survives = bool(future_metric["legal"] and identity is not None)
                if alive:
                    c2_normalized += math.tanh(math.log(max(future_ratio, 1e-30))) if survives else -1.0
                    alive = survives
                else:
                    c2_normalized -= 1.0
                forecast_rows.append(ForecastObservation(
                    valid=survives,
                    survival=survives,
                    minimum_decoding_margin_db=base_profile.min_decoding_margin_db + 10.0 * math.log10(max(future_ratio, 1e-30)),
                    mean_acm_spectral_efficiency=max(0.0, se * min(4.0, max(0.0, future_ratio))),
                ))
            phi = ENGINE._phi_for(incumbent, configs[(user, identity)]) - ENGINE._phi_for(incumbent, base)
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = 0 if identity is None else previous_beam.get(identity, 0)
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=candidate_margin,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=se,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=metric["remaining_d2"],
                remaining_visibility_time_s=metric["remaining_visibility"],
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent.mapping[user],
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=identity is not None and identity in previous_beam,
                previous_satellite_active_for_action=identity is not None and identity[0] in previous_satellite,
                previous_beam_max_rf_over_cap=0.0 if identity is None else min(1.0, required_ratio),
                missing_incumbent=incumbent.mapping[user] is None,
                candidate_current_nominal_decoding_margin_db=candidate_margin,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(forecast_rows[0].mean_acm_spectral_efficiency - se) / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W * (1.0 - required_ratio),
                forecasts=tuple(forecast_rows),
                c1_label_bits=float(calibration.kappa_bits_per_user_step) * normalized_delta,
                c1_phi_difference=float(phi),
                c2_label_bits=float(calibration.kappa_bits_per_user_step) * c2_normalized,
                legal=True,
                terminal=step_index == 29,
                outage=not bool(metric["legal"]),
            )
            actions.append(seal_action_evaluation(
                observation,
                source_provenance_sha256=canonical_sha256({
                    "artifact_label": LABEL, "method": "provider-primitive-fallback",
                    "world": tape_digest, "step": step_index, "carrier": carrier,
                    "user": user, "identity": identity,
                }),
                forecast_method_sha256=canonical_sha256({
                    "method": "provider-primitive-boundary-0", "offsets": [1, 2, 3]
                }),
            ))
            identities.append(identity)
        envelope = AnchorEnvelope(
            world_id=tape.domain, split="TRAIN", world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}", anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user, setting_id="a-r0", code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST, launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest, calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape), allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]), actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row
    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)
    return {
        "base": base, "incumbent": incumbent, "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action, "current_evaluator": current,
        "coalition_row": coalition_row, "census": census, "skipped_invalid": 0,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
                background_occupancy_excluding_focal=background_occupancy,
                beam_active_before_focal=identity is not None and identity in beam_before,
                satellite_active_before_focal=identity is not None and identity[0] in satellite_before,
                off_axis_angle_rad=0.0,
                remaining_d2_time_s=0.0 if primitive is None else primitive["remaining_d2"],
                remaining_visibility_time_s=(
                    0.0 if primitive is None else primitive["remaining_visibility"]
                ),
                refresh_phase=tape.steps[step_index].refresh_phase,
                previous_served_association_for_action=identity == incumbent_identity,
                previous_served_load_for_action=previous_load,
                previous_beam_active_for_action=(
                    identity is not None and identity in previous_beam
                ),
                previous_satellite_active_for_action=(
                    identity is not None and identity[0] in previous_satellite
                ),
                previous_beam_max_rf_over_cap=(
                    0.0 if identity is None else min(1.0, required_ratio)
                ),
                missing_incumbent=missing_incumbent,
                candidate_current_nominal_decoding_margin_db=profile.min_decoding_margin_db,
                incumbent_nominal_decoding_margin_db=base_profile.min_decoding_margin_db,
                forecast_se_trend_bit_s_hz_per_s=(
                    projections[0].mean_acm_se_bit_s_hz
                    - profile.mean_acm_se_bit_s_hz
                )
                / DECISION_INTERVAL_S,
                required_power_cap_margin_w=BEAM_RF_CAP_W - profile.required_power_w_max,
                forecasts=tuple(
                    ForecastObservation(
                        valid=row.valid,
                        survival=row.survives,
                        minimum_decoding_margin_db=row.min_decoding_margin_db,
                        mean_acm_spectral_efficiency=row.mean_acm_se_bit_s_hz,
                    )
                    for row in projections
                ),
                c1_label_bits=float(core),
                c1_phi_difference=float(phi),
                c2_label_bits=float(c2.forecast_surplus_bits - c2.persistence_penalty_bits),
                legal=True,
                terminal=step_index == 29,
                outage=not bool(profile.score.served_phy.get(user, False)),
            )
            provenance = canonical_sha256(
                {
                    "artifact_label": LABEL,
                    "world": tape.digest,
                    "step": step_index,
                    "carrier": carrier,
                    "user": user,
                    "configuration": config.configuration_id,
                }
            )
            actions.append(
                seal_action_evaluation(
                    observation,
                    source_provenance_sha256=provenance,
                    forecast_method_sha256=canonical_sha256(
                        {
                            "engine": ENGINE.SCHEMA,
                            "offsets": [1, 2, 3],
                            "boundaries": list(ENGINE.SELECTION_BOUNDARY_INDICES),
                        }
                    ),
                )
            )
            identities.append(identity)
        if base.mapping[user] not in identities or None not in identities:
            raise RuntimeError("source action set lost BASE or the explicit null action")
        envelope = AnchorEnvelope(
            world_id=tape.domain,
            split="TRAIN",
            world_seed=tape.seed,
            anchor_id=f"{tape.domain}|{step_index}|{carrier}",
            anchor_index=anchor_index,
            decision_time_utc=_utc_at(tape, step_index),
            decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
            user_id=user,
            setting_id="a-r0",
            code_digest=CODE_DIGEST,
            physics_digest=PHYSICS_DIGEST,
            launch_digest=LAUNCH_DIGEST,
            catalogue_digest=ENGINE.catalogue_definition()["sha256"],
            setting_digest=run_setting.digest,
            calibration_digest=calibration.digest,
            provider_digest=tape.protocol.provider_source_digest,
            archive_digest=_archive_digest(tape),
            allocation_manifest_digest=ALLOCATION_DIGEST,
            lambda_bits_per_j=float(calibration.lambda_bits_per_j),
            eta_ref_bits_per_j=float(calibration.eta_ref),
            kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
            base_action_index=identities.index(base.mapping[user]),
            actions=tuple(actions),
        )
        extracted = extract_source_rows(envelope)
        source_rows.extend(extracted)
        for row in extracted:
            rows_by_user_action[(user, _identity(row.action))] = row

    coalition_row = None
    catalogue_count = 0
    if include_coalition:
        catalogue, _catalogue_census = ENGINE._catalogue_with_census(
            tape,
            step_index,
            base,
            setting=setting,
            calibration=calibration,
            counter=counter,
            run_setting=run_setting,
        )
        current.evaluate_many(catalogue)
        catalogue_count = len(catalogue)
        factors = ENGINE._selection_factor_scores(
            base=base,
            incumbent=incumbent,
            catalog=tuple(
                row for row in catalogue if row.configuration_id not in current._invalid
            ),
            evaluated=current._evaluated,
            calibration=calibration,
            cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        )
        pairwise = [
            row
            for row in catalogue
            if row.changed_users == 2
            and row.configuration_id in factors
        ]
        if not pairwise:
            raise RuntimeError("sealed catalogue produced no trainable joint coalition")
        selected = min(
            pairwise,
            key=lambda row: (
                -float(factors[row.configuration_id]["C1"] + factors[row.configuration_id]["C3"]),
                row.configuration_id,
            ),
        )
        coalition_row = _coalition_row(
            tape=tape,
            step_index=step_index,
            carrier=carrier,
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            run_setting=run_setting,
        )
    return {
        "base": base,
        "incumbent": incumbent,
        "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action,
        "current_evaluator": current,
        "coalition_row": coalition_row,
        "census": census,
        "skipped_invalid": skipped_invalid,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
    return values


def _structural_interactions(anchor, catalogue):
    return {
        config.configuration_id: {
            "changed": tuple(
                user for user in anchor.mapping
                if config.mapping[user] != anchor.mapping[user]
            ),
            "joint": 0.0, "additive": 0.0, "psi": 0.0,
        }
        for config in catalogue
    }


def _build_u_catalogue(
    tape, step_index, a0, u, standard_catalogue, evaluator, calibration,
    rows_by_user_action,
):
    started = time.perf_counter()
    options, _ = ENGINE._legal_options(tape, step_index)
    evaluator.evaluate(u)
    candidates_by_user = {}
    for user in sorted(options):
        candidates = []
        for identity in options[user]:
            if identity == u.mapping[user]:
                continue
            mapping = u.mapping
            mapping[user] = identity
            config = ENGINE._configuration(a0, mapping, kind="pilot-u-unilateral")
            reference = rows_by_user_action[(user, u.mapping[user])]
            selected = rows_by_user_action[(user, identity)]
            score = (
                float.fromhex(selected.c1_label_normalized_hex)
                + float.fromhex(selected.c2_label_normalized_hex)
                - float.fromhex(reference.c1_label_normalized_hex)
                - float.fromhex(reference.c2_label_normalized_hex)
            )
            candidates.append((Fraction(str(score)), config))
        candidates_by_user[user] = candidates
    moves = {}
    for user in sorted(options):
        moves[user] = sorted(
            candidates_by_user[user],
            key=lambda row: (-row[0], row[1].configuration_id),
        )
    ranked = sorted(
        (user for user in moves if moves[user]),
        key=lambda user: (-abs(float(moves[user][0][0])), user),
    )[:10]
    rows = [a0, u]
    rows.extend(row for row in standard_catalogue if row.changed_users == 1)
    rows.extend(
        row for row in standard_catalogue if row.kind in {"s0-top-two", "beam-evacuation"}
    )
    for first, second in itertools.combinations(ranked, 2):
        mapping = u.mapping
        mapping[first] = moves[first][0][1].mapping[first]
        mapping[second] = moves[second][0][1].mapping[second]
        rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-pairwise-top10"))
    for beam in sorted({identity for identity in u.mapping.values() if identity is not None}):
        mapping = u.mapping
        changed = False
        for user in sorted(mapping):
            if mapping[user] == beam and moves.get(user):
                mapping[user] = moves[user][0][1].mapping[user]
                changed = True
        if changed:
            rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-beam-evacuation"))
    unique = {row.assignments: row for row in rows}
    ordered = tuple(sorted(unique.values(), key=lambda row: row.configuration_id))
    if len(ordered) > ENGINE.CATALOGUE_CAP:
        ordered = ordered[: ENGINE.CATALOGUE_CAP]
    return ordered, ranked, time.perf_counter() - started


def _exact_s0_boundary0(base, catalogue, evaluator, rows_by_user_action):
    """Primitive proposal ranking plus exact nominal bounded-set S0."""

    unilateral = [row for row in catalogue if row.changed_users == 1]
    top_ids = []
    for user in sorted(base.mapping):
        proposals = [
            row for row in unilateral
            if row.mapping[user] != base.mapping[user]
        ]
        ranked = sorted(
            proposals,
            key=lambda row: (
                -(
                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
                ),
                row.configuration_id,
            ),
        )[: ENGINE.TOP_PROPOSALS]
        top_ids.extend(row.configuration_id for row in ranked)
    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
    allowed.extend(
        row for row in catalogue
        if row.changed_users > 1
        and all(
            any(
                proposal.mapping[user] == identity
                for proposal in unilateral
                if proposal.configuration_id in top_ids
            )
            for user, identity in row.assignments
            if identity != base.mapping[user]
        )
    )
    evaluator.evaluate_many(tuple(allowed))
    allowed = [
        row for row in allowed if row.configuration_id not in evaluator._invalid
    ]
    return min(
        allowed,
        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
    )


def _select_for_anchor(
    anchor_name, anchor, catalogue, exact, models, rows_by_user_action,
    tape, step_index, exact_s0,
):
    selections = {}
    diagnostics = {}
    legal_catalogue = [row for row in catalogue if row.configuration_id in exact]
    contexts = {}
    for config in legal_catalogue:
        if len(exact[config.configuration_id]["changed"]) >= 2:
            contexts[config.configuration_id] = _coalition_context(
                tape=tape, step_index=step_index, anchor=anchor,
                selected=config, rows_by_user_action=rows_by_user_action,
            )
    for seed in LEARNER_SEEDS:
        exact_scores = []
        additive_scores = []
        learned_scores_by_arm = {arm: [] for arm in PILOT_ARMS}
        deltas_by_arm = {}
        c2_tie_pairs = 0
        c2_eligible_pairs = 0
        for arm in PILOT_ARMS:
            model = models[(seed, arm)]
            deltas = {}
            for (user, action), row in rows_by_user_action.items():
                reference = rows_by_user_action[(user, anchor.mapping[user])]
                q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
                deltas[(user, action)] = (
                    model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
                    + q2_delta
                )
                if arm == "FULL" and action != anchor.mapping[user]:
                    c2_eligible_pairs += 1
                    c2_tie_pairs += int(q2_delta == 0.0)
            deltas_by_arm[arm] = deltas
        c2_tie_fraction = (
            c2_tie_pairs / c2_eligible_pairs if c2_eligible_pairs else None
        )
        for config in legal_catalogue:
            context = contexts.get(config.configuration_id)
            full_additive = math.fsum(
                deltas_by_arm["FULL"][(user, config.mapping[user])]
                for user in anchor.mapping
            )
            exact_scores.append((full_additive + exact[config.configuration_id]["psi"], config.configuration_id, config))
            additive_scores.append((full_additive, config.configuration_id, config))
            for arm in PILOT_ARMS:
                model = models[(seed, arm)]
                score = math.fsum(
                    deltas_by_arm[arm][(user, config.mapping[user])]
                    for user in anchor.mapping
                )
                if context is not None:
                    score += model.interaction(context)
                learned_scores_by_arm[arm].append((score, config.configuration_id, config))
        exact_choice = min(exact_scores, key=lambda row: (-row[0], row[1]))[2]
        additive_choice = min(additive_scores, key=lambda row: (-row[0], row[1]))[2]
        selections[(seed, "S0")] = exact_s0
        for arm in PILOT_ARMS:
            selections[(seed, arm)] = min(
                learned_scores_by_arm[arm], key=lambda row: (-row[0], row[1])
            )[2]
        diagnostics[seed] = {
            "top_choice_agreement": selections[(seed, "FULL")].assignments == exact_choice.assignments,
            "additive_choice": additive_choice,
            "exact_choice": exact_choice,
            "anchor": anchor_name,
            # Minimal-pilot C2 tie statistic: over the FULL arm, the fraction of
            # non-incumbent (user, action) candidates whose C2 head score is
            # exactly equal to the incumbent's, i.e. C2 cannot discriminate the
            # move at all and the ranking falls through to C1 + the tie-break.
            "c2_tie": c2_tie_fraction,
            "c2_tie_pairs": c2_tie_pairs,
            "c2_eligible_pairs": c2_eligible_pairs,
        }
    return selections, diagnostics


def evaluate(output: Path, calibration, model_payloads, batches):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    print(json.dumps({"artifact_label": LABEL, "phase": "evaluation",
                      "event": "restore_models_start"}), flush=True)
    models = _restore_models(model_payloads, batches)
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    records = []
    phase_latencies = []
    for world_offset, domain in enumerate(EVALUATION_WORLDS, start=3):
        tape_started = time.perf_counter()
        print(json.dumps({"artifact_label": LABEL, "phase": "evaluation",
                          "event": "tape_build_start", "world": domain,
                          "steps": EVAL_TAPE_STEPS}), flush=True)
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(role="pilot-evaluation"),
            steps=EVAL_TAPE_STEPS,
            start_time_s=0.0,
        )
        print(json.dumps({"artifact_label": LABEL, "phase": "evaluation",
                          "event": "tape_build_done", "world": domain,
                          "wall_s": time.perf_counter() - tape_started}), flush=True)
        anchor_index = 0
        for step_index in range(EVAL_ANCHOR_STEPS):
            for carrier in ENGINE.REFERENCE_CARRIERS[:EVAL_CARRIER_LIMIT]:
                anchor_started = time.perf_counter()
                feature_started = time.perf_counter()
                built = _build_anchor_rows(
                    tape=tape,
                    setting=setting,
                    run_setting=run_setting,
                    calibration=calibration,
                    step_index=step_index,
                    carrier=carrier,
                    anchor_index=anchor_index,
                    include_coalition=False,
                    full_legal_actions=True,
                )
                feature_wall = time.perf_counter() - feature_started
                carrier_base = built["base"]
                incumbent = built["incumbent"]
                rows = built["rows_by_user_action"]
                current = built["current_evaluator"]
                standard_started = time.perf_counter()
                standard_catalogue, _ = ENGINE._catalogue_with_census(
                    tape,
                    step_index,
                    carrier_base,
                    setting=setting,
                    calibration=calibration,
                    run_setting=run_setting,
                )
                exact_a0 = _structural_interactions(
                    carrier_base, standard_catalogue
                )
                exact_s0 = _exact_s0_boundary0(
                    carrier_base, standard_catalogue, current, rows
                )
                standard_wall = time.perf_counter() - standard_started
                u, u_iterations, u_wall, u_missed, u_certificate = ENGINE._s_uni_select(
                    base=carrier_base,
                    incumbent=incumbent,
                    tape=tape,
                    step_index=step_index,
                    evaluator=current,
                    calibration=calibration,
                    compute_budget_s=5.0,
                    run_setting=run_setting,
                    cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
                )
                u_catalogue, ranked_users, u_catalogue_wall = _build_u_catalogue(
                    tape, step_index, carrier_base, u, standard_catalogue,
                    current, calibration, rows,
                )
                exact_u = _structural_interactions(u, u_catalogue)
                u_joint_catalogue = tuple(
                    row for row in u_catalogue
                    if len(exact_u[row.configuration_id]["changed"]) >= 2
                )
                exact_u.update(
                    _exact_interactions(
                        u, incumbent, u_joint_catalogue, current, calibration
                    )
                )
                u_positive_joint_rows = [
                    row for row in exact_u.values()
                    if len(row["changed"]) >= 2 and row["joint"] > 0.0
                ]
                u_positive_joint_sizes = sorted(
                    {len(row["changed"]) for row in u_positive_joint_rows}
                )
                variants = {
                    "P-a0": (carrier_base, standard_catalogue, exact_a0),
                    "P-u": (u, u_catalogue, exact_u),
                }
                realised = ENGINE.StepEvaluator(
                    tape,
                    setting,
                    step_index,
                    transition_from=incumbent,
                    cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
                    field="realised",
                    run_setting=run_setting,
                )
                for variant, (catalogue_anchor, catalogue, exact) in variants.items():
                    selections, diagnostics = _select_for_anchor(
                        variant,
                        catalogue_anchor,
                        catalogue,
                        exact,
                        models,
                        rows,
                        tape,
                        step_index,
                        exact_s0,
                    )
                    selected_full_catalogue = tuple({
                        selections[(seed, "FULL")].assignments:
                        selections[(seed, "FULL")]
                        for seed in LEARNER_SEEDS
                    }.values())
                    exact.update(
                        _exact_interactions(
                            catalogue_anchor, incumbent, selected_full_catalogue,
                            current, calibration,
                        )
                    )
                    for seed in LEARNER_SEEDS:
                        selections[(seed, "BASELINE")] = carrier_base
                        selections[(seed, "S_UNI")] = u
                    additive_configs = {
                        row["additive_choice"].assignments: row["additive_choice"]
                        for row in diagnostics.values()
                    }
                    realised.evaluate_many(
                        tuple({
                            **{row.assignments: row for row in selections.values()},
                            **additive_configs,
                        }.values())
                    )
                    for seed in LEARNER_SEEDS:
                        for arm in REPORTED_ARMS:
                            config = selections[(seed, arm)]
                            profile = realised.evaluate(config)
                            outcome = profile.outcome()
                            handovers = ENGINE._physical_events(
                                incumbent,
                                config,
                                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
                            )
                            exact_row = exact.get(config.configuration_id, {"psi": 0.0, "joint": 0.0, "changed": ()})
                            records.append(
                                {
                                    "artifact_label": LABEL,
                                    "world_id": domain,
                                    "world_seed": tape.seed,
                                    "anchor_index": anchor_index,
                                    "step_index": step_index,
                                    "carrier": carrier,
                                    "catalogue_anchor": variant,
                                    "learner_seed": seed,
                                    "arm": arm,
                                    "configuration_id": config.configuration_id,
                                    "configuration_id": config.configuration_id,
                                    "changed_users": config.changed_users,
                                    "bits": profile.bits,
                                    "joules": profile.joules,
                                    "pooled_ee_bits_per_j": None if profile.joules == 0 else profile.bits / profile.joules,
                                    "availability": float(outcome.useful_availability),
                                    "handover_count": sum(event.kind in {"beam_change", "satellite_change", "reentry"} for event in handovers),
                                    "handover_opportunities": len(handovers),
                                    "rf_cap_hits": profile.rf_cap_hits,
                                    "rf_transmission_observations": profile.rf_transmission_observations,
                                    "psi_anchor_normalized": exact_row["psi"],
                                    "joint_delta_anchor_normalized": exact_row["joint"],
                                    "top_choice_agreement": diagnostics.get(seed, {}).get("top_choice_agreement") if arm == "FULL" else None,
                                    "c2_tie_break": diagnostics.get(seed, {}).get("c2_tie") if arm == "FULL" else None,
                                    "u_any_positive_joint_escape": bool(u_positive_joint_rows),
                                    "u_positive_joint_sizes": u_positive_joint_sizes,
                                    "s_uni_iterations": u_iterations,
                                    "s_uni_wall_s": u_wall,
                                    "s_uni_deadline_missed": u_missed,
                                    "s_uni_termination_certificate": u_certificate,
                                }
                            )
                        full_config = selections[(seed, "FULL")]
                        additive_config = diagnostics[seed]["additive_choice"]
                        base_profile = realised.evaluate(carrier_base)
                        full_profile = realised.evaluate(full_config)
                        additive_profile = realised.evaluate(additive_config)
                        full_row = records[-len(REPORTED_ARMS)]
                        v_ca_bits = full_profile.bits - additive_profile.bits
                        v_ca_energy_bits = -float(calibration.eta_ref) * (
                            full_profile.joules - additive_profile.joules
                        )
                        v_ca_phi_bits = float(calibration.kappa_bits_per_user_step) * float(
                            ENGINE._phi_for(incumbent, full_config)
                            - ENGINE._phi_for(incumbent, additive_config)
                        )
                        full_row.update({
                            "v_ca_bits_component": v_ca_bits,
                            "v_ca_energy_component_bits": v_ca_energy_bits,
                            "v_ca_phi_component_bits": v_ca_phi_bits,
                            "v_ca_net_bits": v_ca_bits + v_ca_energy_bits + v_ca_phi_bits,
                            "additive_choice_joint_delta": exact.get(
                                additive_config.configuration_id, {"joint": 0.0}
                            )["joint"],
                        })
                        singles = []
                        for user in sorted(carrier_base.mapping):
                            if full_config.mapping[user] == carrier_base.mapping[user]:
                                continue
                            mapping = carrier_base.mapping
                            mapping[user] = full_config.mapping[user]
                            singleton = ENGINE._configuration(carrier_base, mapping, kind="pilot-report-singleton")
                            realised.evaluate_many((singleton,))
                            if singleton.configuration_id not in realised._invalid:
                                singles.append(realised.evaluate(singleton))
                        if singles:
                            decomposition = matched_anchor_decomposition(
                                base=(base_profile.outcome(),),
                                selected=(full_profile.outcome(),),
                                singleton_selected=tuple((row.outcome(),) for row in singles),
                            )
                            full_row["g_A"] = float(decomposition.g_additive)
                            full_row["g_I"] = float(decomposition.g_interaction)
                phase_latencies.append(
                    {
                        "world_id": domain,
                        "anchor_index": anchor_index,
                        "feature_construction_s": feature_wall,
                        "catalogue_a0_s": standard_wall,
                        "catalogue_u_extra_s": u_catalogue_wall,
                        "s_uni_s": u_wall,
                        "total_s": time.perf_counter() - anchor_started,
                        "physics_boundary_evaluations": (
                            built["physics_calls"] + current.physical_evaluations + realised.physical_evaluations
                        ),
                        "catalogue_a0_count": len(standard_catalogue),
                        "catalogue_u_count": len(u_catalogue),
                        "u_top10_users_by_abs_d": ranked_users,
                    }
                )
                anchor_index += 1
                print(
                    json.dumps(
                        {
                            "artifact_label": LABEL,
                            "phase": "evaluation",
                            "world": world_offset,
                            "anchor": anchor_index,
                            "anchors_total": 90,
                        }
                    ),
                    flush=True,
                )
    receipt_path = output / "evaluation" / f"{LABEL}-raw-receipts.jsonl"
    receipt_path.parent.mkdir(parents=True, exist_ok=True)
    with receipt_path.open("x", encoding="ascii") as stream:
        for row in records:
            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n")
    digest = hashlib.sha256(receipt_path.read_bytes()).hexdigest()
    receipt_path.with_name(receipt_path.name + ".sha256").write_text(
        f"{digest}  {receipt_path.name}\n", encoding="ascii"
    )
    manifest = {
        "schema": f"{PILOT_SCHEMA}-evaluation-manifest-v1",
        "phase_wall_s": time.perf_counter() - phase_started,
        "phase_core_s": time.process_time() - cpu_started,
        "receipt_rows": len(records),
        "receipt_bytes": receipt_path.stat().st_size,
        "receipt_sha256": digest,
        "latencies": phase_latencies,
    }
    _write_phase_manifest(output / f"{LABEL}-evaluation-manifest.json", manifest)
    return records, manifest


def _quantiles(values):
    if not values:
        return {"min": None, "p05": None, "p50": None, "p95": None, "max": None}
    return {
        name: float(np.quantile(values, q))
        for name, q in (("min", 0.0), ("p05", 0.05), ("p50", 0.5), ("p95", 0.95), ("max", 1.0))
    }


def summarize(records, row_manifest, training_manifest, evaluation_manifest):
    summary = {"anchors": {}, "contrasts": {}, "latency": {}}
    for variant in ("P-a0", "P-u"):
        summary["anchors"][variant] = {}
        subset = [row for row in records if row["catalogue_anchor"] == variant]
        for arm in REPORTED_ARMS:
            rows = [row for row in subset if row["arm"] == arm]
            bits = math.fsum(row["bits"] for row in rows)
            joules = math.fsum(row["joules"] for row in rows)
            summary["anchors"][variant][arm] = {
                "bits": bits,
                "joules": joules,
                "pooled_ee_bits_per_j": None if joules == 0 else bits / joules,
                "availability": math.fsum(row["availability"] for row in rows) / len(rows),
                "handover_rate": math.fsum(row["handover_count"] for row in rows) / math.fsum(row["handover_opportunities"] for row in rows),
                "cap_hit_rate": math.fsum(row["rf_cap_hits"] for row in rows) / max(1, math.fsum(row["rf_transmission_observations"] for row in rows)),
            }
        full = summary["anchors"][variant]["FULL"]
        for comparator in ("DROP_C3", "S0", "S_UNI"):
            other = summary["anchors"][variant][comparator]
            key = f"{variant}:FULL-vs-{comparator}"
            summary["contrasts"][key] = (
                None
                if full["pooled_ee_bits_per_j"] is None or other["pooled_ee_bits_per_j"] is None
                else full["pooled_ee_bits_per_j"] / other["pooled_ee_bits_per_j"] - 1.0
            )
        full_rows = [row for row in subset if row["arm"] == "FULL"]
        anchor_rows = {
            (row["world_id"], row["anchor_index"]): row for row in full_rows
        }
        reversal_rows = [
            row for row in full_rows if row.get("additive_choice_joint_delta", 0.0) < 0.0
        ]
        sizes = sorted(
            {
                int(size)
                for row in anchor_rows.values()
                for size in row.get("u_positive_joint_sizes", [])
            }
            | {int(row["changed_users"]) for row in full_rows}
        )
        summary["anchors"][variant]["diagnostics"] = {
            "positive_joint_escape_fraction_from_u": sum(
                bool(row["u_any_positive_joint_escape"])
                for row in anchor_rows.values()
            ) / len(anchor_rows),
            "selected_psi_distribution": _quantiles([row["psi_anchor_normalized"] for row in full_rows]),
            "g_A_distribution": _quantiles([row["g_A"] for row in full_rows if "g_A" in row]),
            "g_I_distribution": _quantiles([row["g_I"] for row in full_rows if "g_I" in row]),
            "top_choice_agreement": sum(bool(row["top_choice_agreement"]) for row in full_rows) / len(full_rows),
            "harmful_acceptance_rate": sum(row["joint_delta_anchor_normalized"] < 0.0 for row in full_rows) / len(full_rows),
            "c2_tie_frequency": sum(bool(row["c2_tie_break"]) for row in full_rows) / len(full_rows),
            "c2_tie_pair_fraction_mean": (
                math.fsum(row["c2_tie_break"] or 0.0 for row in full_rows) / len(full_rows)
            ),
            "v_ca": {
                field: math.fsum(row[field] for row in full_rows)
                for field in (
                    "v_ca_bits_component", "v_ca_energy_component_bits",
                    "v_ca_phi_component_bits", "v_ca_net_bits",
                )
            },
            "additive_reversal_frequency": len(reversal_rows) / len(full_rows),
            "additive_reversals_prevented_fraction": (
                None if not reversal_rows else sum(
                    row["joint_delta_anchor_normalized"] >= 0.0
                    for row in reversal_rows
                ) / len(reversal_rows)
            ),
            "escape_and_harm_by_coalition_size": {
                str(size): {
                    "escape_opportunities": sum(
                        size in row.get("u_positive_joint_sizes", [])
                        for row in anchor_rows.values()
                    ),
                    "selected": sum(row["changed_users"] == size for row in full_rows),
                    "harmful": sum(
                        row["changed_users"] == size
                        and row["joint_delta_anchor_normalized"] < 0.0
                        for row in full_rows
                    ),
                }
                for size in sizes
            },
        }
    latencies = evaluation_manifest["latencies"]
    for field in (
        "feature_construction_s", "catalogue_a0_s", "catalogue_u_extra_s", "s_uni_s", "total_s", "physics_boundary_evaluations"
    ):
        summary["latency"][field] = _quantiles([float(row[field]) for row in latencies])
    summary["resources"] = {
        "rows_wall_s": row_manifest["phase_wall_s"],
        "rows_core_s": row_manifest["phase_core_s"],
        "training_wall_s": training_manifest["phase_wall_s"],
        "training_core_s": training_manifest["phase_core_s"],
        "evaluation_wall_s": evaluation_manifest["phase_wall_s"],
        "evaluation_core_s": evaluation_manifest["phase_core_s"],
    }
    return summary


def _scope_paragraph() -> str:
    return (
        f"**Scope of this run.** Evaluation worlds {list(EVALUATION_WORLDS)}; "
        f"{EVAL_ANCHOR_STEPS} anchor steps x "
        f"{'nearest-eligible carrier only' if EVAL_CARRIER_LIMIT == 1 else str(EVAL_CARRIER_LIMIT) + ' carriers'}; "
        f"learner seeds {list(LEARNER_DOMAINS)} ({len(LEARNER_SEEDS)}); "
        f"learned arms {list(PILOT_ARMS)} plus BASELINE, S0, S_UNI; "
        f"checkpoint epoch {EVAL_EPOCH} (NOT the sealed {LEGACY_EPOCH_BUDGET}); "
        f"training rows restricted to `rows/{ROW_WORLD_GLOB}` "
        f"(first {ROW_ANCHOR_LIMIT} anchor shards)."
        if EVAL_ANCHOR_STEPS < 30 else
        "**Scope of this run.** Full pilot scale."
    )


def write_report(summary, row_manifest, training_manifest, evaluation_manifest):
    lines = [
        "# V0.25 pilot C3 report — 2026-09-09",
        "",
        f"**{LABEL}. Every artefact and every numerical value in this report is {LABEL}.**",
        "",
        "This is quarantined engineering evidence only. No scientific conclusion, configuration selection, or claim is made.",
        "",
        _scope_paragraph(),
        "",
        "## Rows",
        "",
        "| World | Anchors | Q1/Q2 rows | C3 rows | Bytes |",
        "|---|---:|---:|---:|---:|",
    ]
    for row in row_manifest["worlds"]:
        lines.append(
            f"| {row['world_id']} | {row['anchors']} | {row['source_rows']} | {row['coalition_rows']} | {row['source_bytes'] + row['coalition_bytes']} |"
        )
    lines.extend([
        "",
        "The pilot calibration proxy and every row carry explicit lambda, eta, and kappa exact ratios/hex values. The formal calibration was absent from the launch copy; see DEFECTS.",
        "",
        "## Training",
        "",
        f"Learned arm-seed lineages ran with concurrency {training_manifest['concurrency']}; external BASELINE seed records were emitted separately. Neutral batches were hoisted once per worker. Each learned lineage completed {LEGACY_EPOCH_BUDGET} source epochs with a checkpoint every 100 epochs; **this report evaluates the epoch-{EVAL_EPOCH} checkpoint**.",
        "",
        "## Realised pooled results",
        "",
    ])
    for variant in ("P-a0", "P-u"):
        lines.extend([
            f"### {variant}",
            "",
            "| Arm | Sum B | Sum E | Pooled EE | Availability | Handover rate | Cap-hit rate |",
            "|---|---:|---:|---:|---:|---:|---:|",
        ])
        for arm, row in summary["anchors"][variant].items():
            if arm == "diagnostics":
                continue
            lines.append(
                f"| {arm} | {row['bits']:.9g} | {row['joules']:.9g} | {row['pooled_ee_bits_per_j']:.9g} | {row['availability']:.9g} | {row['handover_rate']:.9g} | {row['cap_hit_rate']:.9g} |"
            )
        lines.append("")
        for comparator in ("DROP_C3", "S0", "S_UNI"):
            value = summary["contrasts"][f"{variant}:FULL-vs-{comparator}"]
            lines.append(f"- FULL vs {comparator}: relative pooled-EE difference = {value:.9g}.")
        diagnostics = summary["anchors"][variant]["diagnostics"]
        lines.extend([
            f"- Strictly improving selected joint escape from the catalogue anchor: {diagnostics['positive_joint_escape_fraction_from_u']:.9g}.",
            f"- Selected Psi distribution (min/p05/p50/p95/max): {diagnostics['selected_psi_distribution']}.",
            f"- Matched-anchor g_A distribution: {diagnostics['g_A_distribution']}.",
            f"- Matched-anchor g_I distribution: {diagnostics['g_I_distribution']}.",
            f"- Learned/exact top-choice agreement: {diagnostics['top_choice_agreement']:.9g}.",
            f"- Harmful-acceptance rate: {diagnostics['harmful_acceptance_rate']:.9g}.",
            f"- C2 tie-break frequency: {diagnostics['c2_tie_frequency']:.9g}.",
            f"- V_CA (unclipped realised bits, -eta*energy, Phi, net bit-equivalent components): {diagnostics['v_ca']}.",
            f"- Additive-reversal frequency: {diagnostics['additive_reversal_frequency']:.9g}; prevented fraction: {diagnostics['additive_reversals_prevented_fraction']}.",
            f"- Escape/harm counts by selected coalition size: {diagnostics['escape_and_harm_by_coalition_size']}.",
            "",
        ])
    lines.extend([
        "## Catalogue-anchor comparison and latency",
        "",
        f"P-u extra catalogue wall-time distribution: {summary['latency']['catalogue_u_extra_s']}.",
        f"Full decision total wall-time distribution: {summary['latency']['total_s']}.",
        f"Feature-construction wall-time distribution: {summary['latency']['feature_construction_s']}.",
        f"Catalogue-generation wall-time distribution: {summary['latency']['catalogue_a0_s']}.",
        f"Physics-call distribution: {summary['latency']['physics_boundary_evaluations']}.",
        "Timeout frequency is the mean of the raw `s_uni_deadline_missed` field; all timeout outcomes include the executed fallback.",
        "",
        "The C2 tie-break diagnostic is the fraction of non-incumbent (user, action) candidates whose C2 head score is exactly equal to the incumbent's under the FULL arm, i.e. C2 cannot discriminate the move and the ranking falls through to C1 plus the stable configuration-ID tie-break. `c2_tie_frequency` is the fraction of anchor-seed decisions with any such tie; `c2_tie_pair_fraction_mean` is the mean per-decision tie fraction. See DEFECTS.",
        "",
        "## Four experiments (kept separate)",
        "",
        "1. Learned neutral-source experiment: run here (FULL, DROP_C1, DROP_C2, DROP_C3, ALL_NEUTRAL_CONTROL, BASELINE).",
        "2. Oracle factor-score removal: not run; stage-4 physics receipts remain separate.",
        "3. Checkpoint knockout: not run in this pilot.",
        "4. Architecture removal: named only and not run, as required.",
        "",
        "## Resource use",
        "",
        "| Phase | Wall hours | Core hours |",
        "|---|---:|---:|",
    ])
    for phase in ("rows", "training", "evaluation"):
        lines.append(
            f"| {phase} | {summary['resources'][phase + '_wall_s'] / 3600:.6g} | {summary['resources'][phase + '_core_s'] / 3600:.6g} |"
        )
    lines.extend([
        "",
        "## DEFECTS",
        "",
        "- The launcher copy was not a usable Git repository (`.git` was empty), so no baseline diff or commit could be made.",
        "- Stage-C build 3 imported `coalition_identity`, absent from the stage-4d target snapshot. A compatibility implementation restored both exact B4 identities and accepts uncapped selected coalitions.",
        "- The fixed provider imported `ProviderAttestation`, absent from the stage-4d tape snapshot, and lacked the older `protocol_outputs` method. A data-only attestation seam and adapter were added; physical calculations are unchanged.",

