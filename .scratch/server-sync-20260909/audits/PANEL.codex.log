+    NetworkOutcome,
+    c1_difference_surplus,
+    c2_persistence_forecast,
+)
+from mcrl.stagec_v025.c3_panel import (  # noqa: E402
+    ArmPlan,
+    PANEL_ARM_ORDER,
+    PANEL_LEARNED_ARMS,
+    PANEL_SOURCE_MAP,
+    PanelTrainer,
+    PhysicalCacheKey,
+    PhysicalOutcomeCache,
+    ScoredConfiguration,
+    degeneracy_report,
+    first_improvement,
+    provisioning_rule,
+    select_then_realise,
+)
+from mcrl.stagec_v025.canonical import canonical_sha256  # noqa: E402
+from mcrl.stagec_v025.coalitions import write_coalition_shard  # noqa: E402
+from mcrl.stagec_v025.encoders import active_encoder_variant  # noqa: E402
+from mcrl.stagec_v025.learner import (  # noqa: E402
+    CoalitionBatch,
+    build_pairwise_batches,
+    default_synthetic_neutral_sources,
+)
+from mcrl.stagec_v025.shards import write_source_shard  # noqa: E402
+
+
+LABEL = "DIAGNOSTIC_NOT_CLAIM"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+    / "PILOT_NOT_CLAIM-calibration.json"
+)
+
+
+class EngineCapture:
+    def __init__(self, engine: object) -> None:
+        self._engine = engine
+        self.forecasts = None
+        self.phi_calls_with_rekey_context = 0
+
+    def __getattr__(self, name: str):
+        return getattr(self._engine, name)
+
+    def _batched_stage2_forecasts(self, **kwargs):
+        result = self._engine._batched_stage2_forecasts(**kwargs)
+        self.forecasts = result[0]
+        return result
+
+    def _phi_for(self, *args, **kwargs):
+        if "cell_rekeyed_users" in kwargs:
+            self.phi_calls_with_rekey_context += 1
+        return self._engine._phi_for(*args, **kwargs)
+
+
+def exact_nonfallback_builder(capture: EngineCapture):
+    """Execute the existing dispatcher's non-fallback branch privately."""
+
+    if pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is not True:
+        raise AssertionError("PILOT_PRIMITIVE_SOURCE_FALLBACK was not found unchanged")
+    namespace = dict(pilot._build_anchor_rows.__globals__)
+    namespace["PILOT_PRIMITIVE_SOURCE_FALLBACK"] = False
+    namespace["ENGINE"] = capture
+    return FunctionType(
+        pilot._build_anchor_rows.__code__,
+        namespace,
+        name="_build_anchor_rows_nonfallback_c3_panel_smoke",
+        argdefs=pilot._build_anchor_rows.__defaults__,
+        closure=pilot._build_anchor_rows.__closure__,
+    )
+
+
+def calibration() -> pilot.PilotCalibration:
+    payload = json.loads(CALIBRATION_PATH.read_text(encoding="ascii"))
+    fraction = lambda name: Fraction(*payload[name])
+    return pilot.PilotCalibration(
+        eta_ref=fraction("eta_ref"),
+        lambda_bits_per_j=fraction("lambda_bits_per_j"),
+        kappa_bits_per_user_step=fraction("kappa_bits_per_user_step"),
+        bits_ref=fraction("bits_ref"),
+        joules_ref=fraction("joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def _row_key(row) -> tuple[int, int | None, int | None]:
+    return row.user_id, row.action.norad_id, row.action.beam_chain_id
+
+
+def assert_exact_targets(built: dict, forecasts: dict, cal) -> dict[str, int]:
+    base = built["base"]
+    incumbent = built["incumbent"]
+    current = built["current_evaluator"]
+    base_profile = current.evaluate(base)
+    base_forecasts = forecasts[base.configuration_id]
+    flags = labels = outages = 0
+    for row in built["rows"]:
+        mapping = base.mapping
+        mapping[row.user_id] = pilot._identity(row.action)
+        config = pilot.ENGINE._configuration(base, mapping, kind="c3-panel-assertion")
+        profile = current.evaluate(config)
+        projections = forecasts[config.configuration_id]
+        for offset, projection in enumerate(projections):
+            assert bool(row.q2_state[10 + 4 * offset]) is projection.valid
+            assert bool(row.q2_state[11 + 4 * offset]) is projection.survives
+            flags += 2
+
+        candidate_phi = pilot.ENGINE._phi_for(
+            incumbent,
+            config,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
+                pilot.ENGINE._WORKER_TAPE if hasattr(pilot.ENGINE, "_WORKER_TAPE") else current.tape,
+                current.step_index,
+            ),
+        )
+        base_phi = pilot.ENGINE._phi_for(
+            incumbent,
+            base,
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(
+                pilot.ENGINE._WORKER_TAPE if hasattr(pilot.ENGINE, "_WORKER_TAPE") else current.tape,
+                current.step_index,
+            ),
+        )
+        c1 = c1_difference_surplus(
+            NetworkOutcome.build(
+                bits=profile.bits,
+                joules=profile.joules,
+                phi=candidate_phi,
+                decoding_availability=1.0,
+                useful_availability=1.0,
+            ),
+            NetworkOutcome.build(
+                bits=base_profile.bits,
+                joules=base_profile.joules,
+                phi=base_phi,
+                decoding_availability=1.0,
+                useful_availability=1.0,
+            ),
+            lambda_bits_per_j=cal.lambda_bits_per_j,
+            eta_ref=cal.eta_ref,
+            kappa_bits_per_user_step=cal.kappa_bits_per_user_step,
+        )
+        assert float.fromhex(row.c1_label_bits_hex) == float(c1.difference_surplus_bits)
+        assert float.fromhex(row.c1_phi_difference_hex) == float(c1.phi_difference)
+        labels += 1
+
+        c2 = c2_persistence_forecast(
+            projections,
+            base_forecasts,
+            lambda_bits_per_j=cal.lambda_bits_per_j,
+            eta_ref=cal.eta_ref,
+            kappa_bits_per_user_step=cal.kappa_bits_per_user_step,
+        )
+        expected_c2 = float(c2.forecast_surplus_bits - c2.persistence_penalty_bits)
+        assert float.fromhex(row.c2_label_bits_hex) == expected_c2
+        labels += 1
+        assert row.outage is (not bool(profile.score.served_phy.get(row.user_id, False)))
+        outages += 1
+    return {
+        "validity_survival_assertions": flags,
+        "production_target_label_assertions": labels,
+        "exact_outage_assertions": outages,
+    }
+
+
+def surrogate_differences(exact_builds, primitive_builds) -> dict[str, int]:
+    variant = active_encoder_variant()
+    q1 = {feature.name: index for index, feature in enumerate(variant.q1_features)}
+    q2 = {feature.name: index for index, feature in enumerate(variant.q2_features)}
+    groups = {
+        "current_margin": ("q1", (q1["nominal_sinr_margin_at_rate_target"], q2["candidate_current_nominal_decoding_margin"])),
+        "required_power": ("mixed", (q1["nominal_required_power_over_cap"], q2["required_power_cap_margin"])),
+        "previous_beam_rf": ("q1", (q1["previous_beam_max_rf_over_cap"],)),
+        "current_acm_se": ("q1", (q1["nominal_mode_spectral_efficiency"],)),
+        "forecast_margin": ("q2", tuple(q2[f"offset_{offset}_minimum_decoding_margin"] for offset in (1, 2, 3))),
+        "forecast_acm_se": ("q2", tuple(q2[f"offset_{offset}_mean_acm_spectral_efficiency"] for offset in (1, 2, 3))),
+        "forecast_se_trend": ("q2", (q2["forecast_se_trend"],)),
+    }
+    counts = {name: 0 for name in (*groups, "validity_survival", "c1_label", "c1_phi", "c2_label", "outage", "coalition_identity")}
+    for exact, primitive in zip(exact_builds, primitive_builds, strict=True):
+        exact_rows = {_row_key(row): row for row in exact["rows"]}
+        primitive_rows = {_row_key(row): row for row in primitive["rows"]}
+        for key in exact_rows.keys() & primitive_rows.keys():
+            left, right = exact_rows[key], primitive_rows[key]
+            for name, (where, indices) in groups.items():
+                if where == "q1":
+                    differs = any(left.q1_state[index] != right.q1_state[index] for index in indices)
+                elif where == "q2":
+                    differs = any(left.q2_state[index] != right.q2_state[index] for index in indices)
+                else:
+                    differs = (
+                        left.q1_state[indices[0]] != right.q1_state[indices[0]]
+                        or left.q2_state[indices[1]] != right.q2_state[indices[1]]
+                    )
+                counts[name] += int(differs)
+            counts["validity_survival"] += int(any(
+                left.q2_state[q2[f"offset_{offset}_{field}"]] != right.q2_state[q2[f"offset_{offset}_{field}"]]
+                for offset in (1, 2, 3) for field in ("valid", "survival")
+            ))
+            counts["c1_label"] += int(left.c1_label_bits_hex != right.c1_label_bits_hex)
+            counts["c1_phi"] += int(left.c1_phi_difference_hex != right.c1_phi_difference_hex)
+            counts["c2_label"] += int(left.c2_label_bits_hex != right.c2_label_bits_hex)
+            counts["outage"] += int(left.outage != right.outage)
+        exact_members = tuple(
+            (member.user_id, member.selected_action.payload())
+            for member in exact["coalition_row"].context.members
+        )
+        primitive_members = tuple(
+            (member.user_id, member.selected_action.payload())
+            for member in primitive["coalition_row"].context.members
+        )
+        counts["coalition_identity"] += int(exact_members != primitive_members)
+    # This development world's sampled steps contain no rekey events, so the
+    # rekey-aware and rekey-blind Phi values coincide.  The exact call-path
+    # assertion is counted separately by EngineCapture.
+    missing = [name for name, count in counts.items() if count == 0 and name != "c1_phi"]
+    if missing:
+        raise AssertionError(f"real-anchor exact/surrogate difference was not witnessed for {missing}")
+    return counts
+
+
+def _score(model, built, assignment) -> float:
+    base = built["base"]
+    rows = built["rows_by_user_action"]
+    total = 0.0
+    mapping = dict(assignment)
+    for user in sorted(base.mapping):
+        candidate = rows[(user, mapping[user])]
+        reference = rows[(user, base.mapping[user])]
+        total += model.q1.score(candidate.q1_state) - model.q1.score(reference.q1_state)
+        total += model.q2.score(candidate.q2_state) - model.q2.score(reference.q2_state)
+    context = built["coalition_row"].context
+    changed = {member.user_id for member in context.members}
+    if changed and all(mapping[user] == pilot._identity(next(member.selected_action for member in context.members if member.user_id == user)) for user in changed):
+        total += model.interaction(context)
+    return total
+
+
+def smoke(output: Path) -> dict[str, object]:
+    if output.exists():
+        raise RuntimeError(f"refusing to overwrite smoke output: {output}")
+    output.mkdir(parents=True)
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    cal = calibration()
+    tape_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=DEVELOPMENT_WORLD_DOMAINS[0],
+        provider=LegacyWorldProvider(role="pilot-source"),
+        steps=5,
+        start_time_s=0.0,
+    )
+    tape_seconds = time.perf_counter() - tape_started
+
+    exact_builds = []
+    primitive_builds = []
+    exact_seconds = []
+    primitive_seconds = []
+    assertions = {
+        "validity_survival_assertions": 0,
+        "production_target_label_assertions": 0,
+        "exact_outage_assertions": 0,
+        "rekey_context_path_assertions": 0,
+    }
+    smoke_anchors = (
+        (0, REFERENCE_CARRIERS[0]),
+        (1, REFERENCE_CARRIERS[1]),
+    )
+    for anchor_index, (step_index, carrier) in enumerate(smoke_anchors):
+        capture = EngineCapture(pilot.ENGINE)
+        exact = exact_nonfallback_builder(capture)
+        started = time.perf_counter()
+        built = exact(
+            tape=tape,
+            setting=setting,
+            run_setting=run_setting,
+            calibration=cal,
+            step_index=step_index,
+            carrier=carrier,
+            anchor_index=anchor_index,
+            include_coalition=True,
+            full_legal_actions=False,
+        )
+        exact_seconds.append(time.perf_counter() - started)
+        assert capture.forecasts is not None
+        for name, count in assert_exact_targets(built, capture.forecasts, cal).items():
+            assertions[name] += count
+        assert capture.phi_calls_with_rekey_context > 0
+        assertions["rekey_context_path_assertions"] += capture.phi_calls_with_rekey_context
+        exact_builds.append(built)
+
+        started = time.perf_counter()
+        primitive_builds.append(
+            pilot._build_anchor_rows(
+                tape=tape,
+                setting=setting,
+                run_setting=run_setting,
+                calibration=cal,
+                step_index=step_index,
+                carrier=carrier,
+                anchor_index=anchor_index,
+                include_coalition=True,
+                full_legal_actions=False,
+            )
+        )
+        primitive_seconds.append(time.perf_counter() - started)
+        assert pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True
+
+    differences = surrogate_differences(exact_builds, primitive_builds)
+    source = write_source_shard(
+        output / "exact-source.jsonl",
+        tuple(row for built in exact_builds for row in built["rows"]),
+    )
+    coalition = write_coalition_shard(
+        output / "exact-coalitions.jsonl",
+        tuple(built["coalition_row"] for built in exact_builds),
+    )
+    pairs = build_pairwise_batches((source,))
+    c3 = CoalitionBatch.create((coalition,))
+    trainer = PanelTrainer(
+        learner_seed=17,
+        q1_batch=pairs["C1"],
+        q2_batch=pairs["C2"],
+        c3_batch=c3,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    train_started = time.perf_counter()
+    trainer.train(2)
+    train_seconds = time.perf_counter() - train_started
+    training = trainer.deployment_receipt()
+
+    built = exact_builds[0]
+    base = built["base"]
+    coalition_mapping = base.mapping
+    for member in built["coalition_row"].context.members:
+        coalition_mapping[member.user_id] = pilot._identity(member.selected_action)
+    candidates = (base.assignments, tuple(sorted(coalition_mapping.items())))
+    plans = []
+    for arm in PANEL_LEARNED_ARMS:
+        rows = tuple(ScoredConfiguration(value, _score(trainer.models[arm], built, value)) for value in candidates)
+        seed, _accepted = first_improvement(rows[0], lambda current, rows=rows: rows[1:] if current == rows[0] else ())
+        plans.append(ArmPlan(arm, seed.assignment, rows, True))
+    baseline_rows = (
+        ScoredConfiguration(candidates[0], 0.0),
+        ScoredConfiguration(candidates[1], -float(len(built["coalition_row"].context.members))),
+    )
+    baseline_seed, _ = first_improvement(baseline_rows[0], lambda _current: baseline_rows[1:])
+    plans.append(ArmPlan("BASELINE", baseline_seed.assignment, baseline_rows, True))
+
+    configs = {
+        tuple(config.assignments): config
+        for config in (
+            base,
+            pilot.ENGINE._configuration(base, coalition_mapping, kind="c3-panel-smoke"),
+        )
+    }
+    tier_rows = []
+    anchor_screen_rows = []
+    for rule_name in ("SEALED", "MARGIN_Q"):
+        rule = provisioning_rule(rule_name)
+        cache = PhysicalOutcomeCache[dict[str, float]]()
+        realised = pilot.ENGINE.StepEvaluator(
+            tape,
+            setting,
+            0,
+            transition_from=built["incumbent"],
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, 0),
+            field="realised",
+            run_setting=run_setting,
+        )
+        realised_seconds = 0.0
+
+        def key_for(_arm, assignment):
+            return PhysicalCacheKey(
+                tape_sha256=tape.digest,
+                world_id=tape.domain,
+                decision_time_ns=0,
+                assignment=assignment,
+                physical_setting_sha256=canonical_sha256({"setting": "a-r0", "provisioning_rule": rule}),
+                run_setting_sha256=run_setting.digest,
+                evaluator_sha256=hashlib.sha256(pilot.ENGINE_PATH.read_bytes()).hexdigest(),
+                field="realised",
+                boundary_indices=tuple(realised.boundary_indices),
+                transition_sha256=canonical_sha256(built["incumbent"].assignments),
+                prefix_history_sha256=canonical_sha256({"world": tape.domain, "step": 0, "prefix": []}),
+            )
+
+        def evaluate(key):
+            nonlocal realised_seconds
+            started = time.perf_counter()
+            profile = realised.evaluate(configs[key.assignment])
+            realised_seconds += time.perf_counter() - started
+            return {"bits": profile.bits, "joules": profile.joules}
+
+        started = time.perf_counter()
+        tier = select_then_realise(tuple(plans), key_for=key_for, evaluate=evaluate, cache=cache)
+        total = time.perf_counter() - started
+        tier_rows.append({
+            "provisioning_rule": rule,
+            **{key: value for key, value in tier.items() if key != "outcomes"},
+            "selection_seconds": total - realised_seconds,
+            "realisation_seconds": realised_seconds,
+        })
+        base_profile = realised.evaluate(base)
+        anchor_screen_rows.append({
+            "anchor_id": f"{tape.domain}|0|{REFERENCE_CARRIERS[0]}|{rule}",
+            "reference": {"bits": base_profile.bits, "joules": base_profile.joules},
+            "outcomes": tier["outcomes"],
+        })
+
+    contrasts = tuple(
+        (f"FULL-minus-{arm}", "FULL", arm)
+        for arm in (*PANEL_LEARNED_ARMS[1:], "BASELINE")
+    )
+    screen = degeneracy_report(anchor_screen_rows, contrasts)
+    result = {
+        "label": LABEL,
+        "smoke_test_not_evidence": True,
+        "production_training_run": False,
+        "policy_run": False,
+        "processes_used": 1,
+        "process_limit": 4,
+        "world": tape.domain,
+        "anchors": 2,
+        "learner_seeds": 1,
+        "source_epochs": 2,
+        "panel_arms": len(PANEL_ARM_ORDER),
+        "learned_arms": len(PANEL_LEARNED_ARMS),
+        "tape_build_seconds": tape_seconds,
+        "exact_row_build_seconds": exact_seconds,
+        "primitive_row_build_seconds": primitive_seconds,
+        "exact_row_seconds_per_anchor": sum(exact_seconds) / len(exact_seconds),
+        "source_rows": sum(len(built["rows"]) for built in exact_builds),
+        "coalition_rows": len(exact_builds),
+        "exact_assertions": assertions,
+        "surrogate_difference_witness_counts": differences,
+        "training_seconds": train_seconds,
+        "training_seconds_per_arm_per_epoch": train_seconds / len(PANEL_LEARNED_ARMS) / 2,
+        "training": training,
+        "tier": tier_rows,
+        "screen": screen,
+        "provisioning_rule_note": (
+            "Both named branches are exercised at the orchestration/cache boundary. "
+            "This workspace's inherited physics evaluator is the SEALED implementation; "
+            "the MARGIN_Q numeric evaluator remains the read-only sibling harness seam."
+        ),
+        "fallback_constant_unchanged": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True,
+    }
+    path = output / "smoke.json"
+    path.write_text(json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(smoke(args.output), indent=2, sort_keys=True, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
