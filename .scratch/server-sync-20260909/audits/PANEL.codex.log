@dataclass(frozen=True)
class Configuration:
    configuration_id: str
    assignments: tuple[tuple[int, tuple[int, int] | None], ...]
    changed_users: int
    kind: str

    @property
    def mapping(self) -> dict[int, tuple[int, int] | None]:
        return dict(self.assignments)


@dataclass(frozen=True)
class EvaluatedProfile:
    config: Configuration
    score: CellScore
    energy_components: Mapping[str, float]
    lit_beam_seconds: float
    lit_satellite_seconds: float
    acm_mode_counts: Mapping[str, int]
    se_plateau_user_steps: int
    user_step_observations: int
    rf_cap_hits: int
    rf_transmission_observations: int
    treatment_t_same_instant_comparison: Mapping[str, object] | None
    certificate_status: str = "CONVERGED"
    certificate_iterations: int = 0
    required_power_w_max: float = 0.0
    min_decoding_margin_db: float = -100.0
    mean_acm_se_bit_s_hz: float = 0.0

    @property
    def bits(self) -> float:
        return math.fsum(self.score.bits.values())

    @property
    def joules(self) -> float:
        return self.score.joules

    def outcome(self, *, phi: Fraction = Fraction()) -> NetworkOutcome:
        opportunities = max(1, len(self.score.bits)) * DECISION_INTERVAL_S
        decoding = math.fsum(self.score.decoding_time_s.values()) / opportunities
        useful = math.fsum(self.score.useful_time_s.values()) / opportunities
        return NetworkOutcome.build(
            bits=sum((Fraction(str(value)) for value in self.score.bits.values()), Fraction()),
            joules=self.joules,
            phi=phi,
            decoding_availability=min(1.0, max(0.0, decoding)),
            useful_availability=min(1.0, max(0.0, useful)),
            per_user_bits=self.score.bits,
        )


diff --git a/src/mcrl/stagec_v025/c3_panel.py b/src/mcrl/stagec_v025/c3_panel.py
new file mode 100644
index 0000000000000000000000000000000000000000..f768e26c3a6b352d78e806b78d72f24ae84dea53
--- /dev/null
+++ b/src/mcrl/stagec_v025/c3_panel.py
@@ -0,0 +1,464 @@
+"""C3 neutral-source panel instrument.
+
+This module is deliberately an instrument, not an experiment runner.  It
+defines the complete 2^3 learned source factorial, trains every retained head,
+keeps arm-owned proposal/catalogue state separate, realises only the union of
+selected physical configurations, and reports (never filters) the declared
+reference-degeneracy split.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from fractions import Fraction
+import math
+from typing import Callable, Generic, Mapping, Sequence, TypeVar
+
+from .canonical import StageCContractError, canonical_sha256
+from .learner import (
+    AdamMLPHead,
+    AdamSetInteractionHead,
+    CoalitionBatch,
+    NeutralSourceDefinition,
+    PairwiseBatch,
+    ROUTES,
+    Route,
+    V1LineageOrchestrator,
+    V1ThreeRouteModel,
+)
+
+
+# The listed intervention is the complete binary factorial: eight learned
+# arms.  BASELINE is the ninth panel arm and has no learned heads.
+PANEL_LEARNED_ARMS = (
+    "FULL",
+    "DROP_C1",
+    "DROP_C2",
+    "DROP_C3",
+    "ONLY_C1",
+    "ONLY_C2",
+    "ONLY_C3",
+    "ALL_NEUTRAL_CONTROL",
+)
+EXTERNAL_CONTROL = "BASELINE"
+PANEL_ARM_ORDER = (*PANEL_LEARNED_ARMS, EXTERNAL_CONTROL)
+PANEL_SOURCE_MAP: Mapping[str, Mapping[Route, str]] = {
+    "FULL": {"C1": "informed", "C2": "informed", "C3": "informed"},
+    "DROP_C1": {"C1": "neutral", "C2": "informed", "C3": "informed"},
+    "DROP_C2": {"C1": "informed", "C2": "neutral", "C3": "informed"},
+    "DROP_C3": {"C1": "informed", "C2": "informed", "C3": "neutral"},
+    "ONLY_C1": {"C1": "informed", "C2": "neutral", "C3": "neutral"},
+    "ONLY_C2": {"C1": "neutral", "C2": "informed", "C3": "neutral"},
+    "ONLY_C3": {"C1": "neutral", "C2": "neutral", "C3": "informed"},
+    "ALL_NEUTRAL_CONTROL": {"C1": "neutral", "C2": "neutral", "C3": "neutral"},
+}
+PROVISIONING_RULES = ("SEALED", "MARGIN_Q")
+
+
+def provisioning_rule(name: str) -> str:
+    """Validate the named physics rule selected by the command line."""
+
+    if name not in PROVISIONING_RULES:
+        raise StageCContractError(
+            f"unknown provisioning rule {name!r}; expected one of {PROVISIONING_RULES}"
+        )
+    return name
+
+
+class PanelTrainer:
+    """Matched initialization and all-head updates for the eight learned arms."""
+
+    def __init__(
+        self,
+        *,
+        learner_seed: int,
+        q1_batch: PairwiseBatch,
+        q2_batch: PairwiseBatch,
+        c3_batch: CoalitionBatch,
+        neutral_sources: Mapping[Route, NeutralSourceDefinition],
+    ) -> None:
+        # Reuse the production initializer and head implementations.  The
+        # production five-arm schema is not changed or reinterpreted.
+        base = V1LineageOrchestrator(
+            learner_seed=learner_seed,
+            q1_batch=q1_batch,
+            q2_batch=q2_batch,
+            c3_batch=c3_batch,
+            neutral_sources=neutral_sources,
+        )
+        template = base.models["FULL"]
+        self.learner_seed = int(learner_seed)
+        self.initialization_sha256 = base.initialization_sha256
+        self.models = {arm: template.clone() for arm in PANEL_LEARNED_ARMS}
+        self.informed = {"C1": q1_batch, "C2": q2_batch, "C3": c3_batch}
+        self.neutral = {
+            "C1": base._neutral_q1,
+            "C2": base._neutral_q2,
+            "C3": base._neutral_c3,
+        }
+        self.completed_source_epochs = 0
+        self.head_updates = {
+            arm: {route: 0 for route in ROUTES} for arm in PANEL_LEARNED_ARMS
+        }
+
+    def train_epoch(self) -> dict[str, dict[str, float]]:
+        losses = {arm: {} for arm in PANEL_LEARNED_ARMS}
+        for arm in PANEL_LEARNED_ARMS:
+            model = self.models[arm]
+            for route in ROUTES:
+                batch = (
+                    self.informed[route]
+                    if PANEL_SOURCE_MAP[arm][route] == "informed"
+                    else self.neutral[route]
+                )
+                if route == "C1":
+                    head = model.q1
+                elif route == "C2":
+                    head = model.q2
+                else:
+                    head = model.psi
+                if isinstance(head, AdamMLPHead):
+                    losses[arm][route] = head.update(batch)  # type: ignore[arg-type]
+                elif isinstance(head, AdamSetInteractionHead):
+                    losses[arm][route] = head.update(batch)  # type: ignore[arg-type]
+                else:  # pragma: no cover - production initializer invariant
+                    raise StageCContractError("panel trainer received a non-Adam head")
+                self.head_updates[arm][route] += 1
+        self.completed_source_epochs += 1
+        return losses
+
+    def train(self, epochs: int) -> None:
+        if isinstance(epochs, bool) or not isinstance(epochs, int) or epochs < 0:
+            raise StageCContractError("smoke epoch count must be a nonnegative integer")
+        for _ in range(epochs):
+            self.train_epoch()
+
+    def deployment_receipt(self) -> dict[str, object]:
+        expected = self.completed_source_epochs
+        for arm, routes in self.head_updates.items():
+            if set(routes) != set(ROUTES) or any(value != expected for value in routes.values()):
+                raise StageCContractError(f"{arm} did not update every retained head")
+            if set(self.models[arm].payload()) != set(ROUTES):
+                raise StageCContractError(f"{arm} does not deploy every retained head")
+        return {
+            "learned_arms": list(PANEL_LEARNED_ARMS),
+            "external_control": EXTERNAL_CONTROL,
+            "source_map": {arm: dict(PANEL_SOURCE_MAP[arm]) for arm in PANEL_LEARNED_ARMS},
+            "initialization_sha256": self.initialization_sha256,
+            "completed_source_epochs": expected,
+            "head_updates": self.head_updates,
+            "all_learned_arms_retain_update_deploy_all_heads": True,
+        }
+
+
+Assignment = tuple[tuple[int, tuple[int, int] | None], ...]
+
+
+def canonical_assignment(mapping: Mapping[int, tuple[int, int] | None]) -> Assignment:
+    return tuple(sorted((int(user), identity) for user, identity in mapping.items()))
+
+
+@dataclass(frozen=True, slots=True)
+class ScoredConfiguration:
+    assignment: Assignment
+    nominal_score: float
+    eligible: bool = True
+
+    def __post_init__(self) -> None:
+        if not math.isfinite(self.nominal_score):
+            raise StageCContractError("nominal selection score must be finite")
+
+    @property
+    def digest(self) -> str:
+        return canonical_sha256({"assignment": self.assignment})
+
+
+@dataclass(frozen=True, slots=True)
+class ArmPlan:
+    arm: str
+    seed: Assignment
+    catalogue: tuple[ScoredConfiguration, ...]
+    first_improvement_used: bool
+
+    def __post_init__(self) -> None:
+        if self.arm not in PANEL_ARM_ORDER:
+            raise StageCContractError(f"unknown panel arm {self.arm}")
+        if not self.catalogue:
+            raise StageCContractError("an arm-owned catalogue cannot be empty")
+        if not self.first_improvement_used:
+            raise StageCContractError("every panel arm must declare first-improvement")
+
+    @property
+    def seed_sha256(self) -> str:
+        return canonical_sha256({"seed": self.seed})
+
+    @property
+    def catalogue_sha256(self) -> str:
+        return canonical_sha256(
+            [
+                {
+                    "assignment": row.assignment,
+                    "nominal_score_hex": row.nominal_score.hex(),
+                    "eligible": row.eligible,
+                }
+                for row in self.catalogue
+            ]
+        )
+
+
+def first_improvement(
+    initial: ScoredConfiguration,
+    neighbours: Callable[[ScoredConfiguration], Sequence[ScoredConfiguration]],
+) -> tuple[ScoredConfiguration, int]:
+    """Ordered first strict improvement to a fixed point."""
+
+    current = initial
+    accepted = 0
+    while True:
+        for candidate in neighbours(current):
+            if candidate.eligible and candidate.nominal_score > current.nominal_score:
+                current = candidate
+                accepted += 1
+                break
+        else:
+            return current, accepted
+
+
+@dataclass(frozen=True, slots=True)
+class PhysicalCacheKey:
+    tape_sha256: str
+    world_id: str
+    decision_time_ns: int
+    assignment: Assignment
+    physical_setting_sha256: str
+    run_setting_sha256: str
+    evaluator_sha256: str
+    field: str
+    boundary_indices: tuple[int, ...]
+    transition_sha256: str
+    prefix_history_sha256: str
+
+    def __post_init__(self) -> None:
+        for name in (
+            "tape_sha256",
+            "physical_setting_sha256",
+            "run_setting_sha256",
+            "evaluator_sha256",
+            "transition_sha256",
+            "prefix_history_sha256",
+        ):
+            value = getattr(self, name)
+            if len(value) != 64 or any(c not in "0123456789abcdef" for c in value):
+                raise StageCContractError(f"physical cache {name} is not a SHA-256")
+        if not self.world_id or self.decision_time_ns < 0:
+            raise StageCContractError("physical cache world/time context is invalid")
+        if self.field not in {"nominal", "margin", "realised"}:
+            raise StageCContractError("physical cache field is invalid")
+        if not self.boundary_indices or tuple(sorted(set(self.boundary_indices))) != self.boundary_indices:
+            raise StageCContractError("physical cache boundaries must be nonempty ordered unique")
+
+    @property
+    def digest(self) -> str:
+        return canonical_sha256(
+            {
+                "schema": "mcrl-v025-c3-panel-physical-cache-key-v1",
+                "tape_sha256": self.tape_sha256,
+                "world_id": self.world_id,
+                "decision_time_ns": self.decision_time_ns,
+                "assignment": self.assignment,
+                "physical_setting_sha256": self.physical_setting_sha256,
+                "run_setting_sha256": self.run_setting_sha256,
+                "evaluator_sha256": self.evaluator_sha256,
+                "field": self.field,
+                "boundary_indices": self.boundary_indices,
+                "transition_sha256": self.transition_sha256,
+                "prefix_history_sha256": self.prefix_history_sha256,
+            }
+        )
+
+
+OutcomeT = TypeVar("OutcomeT")
+
+
+class PhysicalOutcomeCache(Generic[OutcomeT]):
+    """Shared physical cache that is unavailable until selection is sealed."""
+
+    def __init__(self) -> None:
+        self._rows: dict[str, OutcomeT] = {}
+        self._selection_sealed = False
+        self.hits = 0
+        self.misses = 0
+
+    def begin_selection(self) -> None:
+        self._selection_sealed = False
+
+    def seal_selection(self) -> None:
+        self._selection_sealed = True
+
+    def realise(
+        self, key: PhysicalCacheKey, evaluate: Callable[[PhysicalCacheKey], OutcomeT]
+    ) -> OutcomeT:
+        if not self._selection_sealed:
+            raise StageCContractError("realised outcome cache accessed before all selections sealed")
+        if key.digest in self._rows:
+            self.hits += 1
+            return self._rows[key.digest]
+        value = evaluate(key)
+        self._rows[key.digest] = value
+        self.misses += 1
+        return value
+
+
+def _select(plan: ArmPlan) -> ScoredConfiguration:
+    eligible = [row for row in plan.catalogue if row.eligible]
+    if not eligible:
+        raise StageCContractError(f"{plan.arm} has no eligible nominal candidate")
+    # Catalogue order is the stable tie break; realised outcomes are absent.
+    return max(enumerate(eligible), key=lambda row: (row[1].nominal_score, -row[0]))[1]
+
+
+def select_then_realise(
+    plans: Sequence[ArmPlan],
+    *,
+    key_for: Callable[[str, Assignment], PhysicalCacheKey],
+    evaluate: Callable[[PhysicalCacheKey], OutcomeT],
+    cache: PhysicalOutcomeCache[OutcomeT],
+) -> dict[str, object]:
+    """Select from arm-owned catalogues, then realise the chosen-key union."""
+
+    if tuple(plan.arm for plan in plans) != PANEL_ARM_ORDER:
+        raise StageCContractError("panel plans must contain every arm in declared order")
+    cache.begin_selection()
+    selected = {plan.arm: _select(plan) for plan in plans}
+    # This barrier is the anti-leak invariant.  No cache method is called in
+    # the selection loop above, and the cache itself rejects such a call.
+    cache.seal_selection()
+    keys = {arm: key_for(arm, row.assignment) for arm, row in selected.items()}
+    realised_by_key = {
+        key.digest: cache.realise(key, evaluate)
+        for key in {value.digest: value for value in keys.values()}.values()
+    }
+    return {
+        "selected": {arm: row.assignment for arm, row in selected.items()},
+        "outcomes": {arm: realised_by_key[keys[arm].digest] for arm in PANEL_ARM_ORDER},
+        "seed_sha256": {plan.arm: plan.seed_sha256 for plan in plans},
+        "catalogue_sha256": {plan.arm: plan.catalogue_sha256 for plan in plans},
+        "selection_completed_before_cache_lookups": True,
+        "chosen_configurations": len(selected),
+        "union_realised_configurations": len(realised_by_key),
+        "cache_hits": cache.hits,
+        "cache_misses": cache.misses,
+        "search": "ordered_first_strict_improvement",
+    }
+
+
+def _fraction(value: int | float | Fraction) -> Fraction:
+    if isinstance(value, Fraction):
+        return value
+    if isinstance(value, int):
+        return Fraction(value)
+    if not math.isfinite(value):
+        raise StageCContractError("reporting outcome must be finite")
+    return Fraction.from_float(value)
+
+
+def _ratio(bits: int | float | Fraction, joules: int | float | Fraction) -> Fraction:
+    energy = _fraction(joules)
+    if energy <= 0:
+        raise StageCContractError("reporting energy must be positive")
+    return _fraction(bits) / energy
+
+
+def degeneracy_report(
+    anchors: Sequence[Mapping[str, object]],
+    contrasts: Sequence[tuple[str, str, str]],
+) -> dict[str, object]:
+    """Report exact-sign reference status and both pooled contrast marginals.
+
+    Each anchor must contain ``outcomes`` (arm -> {bits, joules}) and a
+    head-independent certified ``reference`` outcome.  No row is removed from
+    the returned all-anchor material; the restricted view is supplementary.
+    """
+
+    if not anchors:
+        raise StageCContractError("degeneracy report needs at least one anchor")
+    status: dict[str, dict[str, bool]] = {}
+    for row in anchors:
+        anchor_id = str(row["anchor_id"])
+        outcomes = row["outcomes"]
+        reference = row["reference"]
+        if not isinstance(outcomes, Mapping) or not isinstance(reference, Mapping):
+            raise StageCContractError("malformed degeneracy-report anchor")
+        ref_bits, ref_joules = reference["bits"], reference["joules"]
+        status[anchor_id] = {}
+        for arm, outcome in outcomes.items():
+            if not isinstance(outcome, Mapping):
+                raise StageCContractError("malformed arm outcome")
+            # Cross multiplication gives the exact sign in integer/rational or
+            # exact binary64 arithmetic; there is no tolerance or threshold.
+            below = (
+                _fraction(outcome["bits"]) * _fraction(ref_joules)
+                < _fraction(ref_bits) * _fraction(outcome["joules"])
+            )
+            status[anchor_id][str(arm)] = below
+
+    def pooled(rows: Sequence[Mapping[str, object]], arm: str) -> Fraction:
+        bits = sum((_fraction(row["outcomes"][arm]["bits"]) for row in rows), Fraction())
+        joules = sum((_fraction(row["outcomes"][arm]["joules"]) for row in rows), Fraction())
+        return _ratio(bits, joules)
+
+    reports: dict[str, object] = {}
+    for name, left, right in contrasts:
+        if any(left not in row["outcomes"] or right not in row["outcomes"] for row in anchors):
+            raise StageCContractError(f"contrast {name} names an absent arm")
+        restricted = [
+            row
+            for row in anchors
+            if not status[str(row["anchor_id"])][left]
+            and not status[str(row["anchor_id"])][right]
+        ]
+
+        def marginal(rows: Sequence[Mapping[str, object]]) -> float | None:
+            if not rows:
+                return None
+            denominator = pooled(rows, right)
+            return None if denominator == 0 else float(pooled(rows, left) / denominator - 1)
+
+        reports[name] = {
+            "arms": [left, right],
+            "all_anchor": {
+                "anchor_count": len(anchors),
+                "marginal_relative_pooled_ee": marginal(anchors),
+            },
+            "all_arms_at_or_above_reference": {
+                "anchor_count": len(restricted),
+                "anchor_ids": [str(row["anchor_id"]) for row in restricted],
+                "marginal_relative_pooled_ee": marginal(restricted),
+            },
+        }
+    return {
+        "screen": "exact sign against head-independent certified fixed point",
+        "role": "REPORTING_ONLY_NOT_A_FILTER",
+        "anchors_retained": len(anchors),
+        "below_reference": status,
+        "contrasts": reports,
+    }
+
+
+__all__ = [
+    "ArmPlan",
+    "EXTERNAL_CONTROL",
+    "PANEL_ARM_ORDER",
+    "PANEL_LEARNED_ARMS",
+    "PANEL_SOURCE_MAP",
+    "PROVISIONING_RULES",
+    "PanelTrainer",
+    "PhysicalCacheKey",
+    "PhysicalOutcomeCache",
+    "ScoredConfiguration",
+    "canonical_assignment",
+    "degeneracy_report",
+    "first_improvement",
+    "provisioning_rule",
+    "select_then_realise",
+]
diff --git a/tests/stagec_v025/test_c3_panel_harness.py b/tests/stagec_v025/test_c3_panel_harness.py
new file mode 100644
index 0000000000000000000000000000000000000000..2412b7922d027b9c2092e876068f07a0d596939e
--- /dev/null
+++ b/tests/stagec_v025/test_c3_panel_harness.py
@@ -0,0 +1,213 @@
+"""Contract tests for the C3 panel instrument (DIAGNOSTIC_NOT_CLAIM)."""
+
+from __future__ import annotations
+
+from fractions import Fraction
+from pathlib import Path
+
+import pytest
+
+from mcrl.stagec_v025.c3_panel import (
+    ArmPlan,
+    PANEL_ARM_ORDER,
+    PANEL_LEARNED_ARMS,
+    PANEL_SOURCE_MAP,
+    PanelTrainer,
+    PhysicalCacheKey,
+    PhysicalOutcomeCache,
+    ScoredConfiguration,
+    canonical_assignment,
+    degeneracy_report,
+    first_improvement,
+    provisioning_rule,
+    select_then_realise,
+)
+from mcrl.stagec_v025.canonical import StageCContractError
+from mcrl.stagec_v025.learner import (
+    ROUTES,
+    build_pairwise_batches,
+    default_synthetic_neutral_sources,
+)
+from mcrl.stagec_v025.shards import write_source_shard
+from mcrl.stagec_v025.state import extract_source_rows
+from mcrl.stagec_v025.synthetic import (
+    _synthetic_coalition_batch,
+    make_synthetic_anchors,
+)
+
+
+HEX = "a" * 64
+
+
+def _assignment(value: int):
+    return canonical_assignment({0: (100 + value, 10 + value)})
+
+
+def _plan(arm: str, selected: int = 1) -> ArmPlan:
+    return ArmPlan(
+        arm=arm,
+        seed=_assignment(0),
+        catalogue=(
+            ScoredConfiguration(_assignment(0), 0.0),
+            ScoredConfiguration(_assignment(selected), 1.0),
+        ),
+        first_improvement_used=True,
+    )
+
+
+def _key(_arm: str, assignment) -> PhysicalCacheKey:
+    return PhysicalCacheKey(
+        tape_sha256=HEX,
+        world_id="V025_PROBE/world/1",
+        decision_time_ns=0,
+        assignment=assignment,
+        physical_setting_sha256=HEX,
+        run_setting_sha256=HEX,
+        evaluator_sha256=HEX,
+        field="realised",
+        boundary_indices=(0, 1),
+        transition_sha256=HEX,
+        prefix_history_sha256=HEX,
+    )
+
+
+def test_arm_inventory_is_complete_binary_factorial_plus_external_control() -> None:
+    assert len(PANEL_LEARNED_ARMS) == 8
+    assert len(PANEL_ARM_ORDER) == 9
+    assert set(tuple(PANEL_SOURCE_MAP[arm][route] for route in ROUTES) for arm in PANEL_LEARNED_ARMS) == {
+        tuple("informed" if mask & (1 << index) else "neutral" for index in range(3))
+        for mask in range(8)
+    }
+
+
+def test_every_learned_arm_retains_updates_and_deploys_every_head(tmp_path: Path) -> None:
+    rows = tuple(
+        row
+        for anchor in make_synthetic_anchors()
+        for row in extract_source_rows(anchor)
+    )
+    source = write_source_shard(tmp_path / "source.jsonl", rows)
+    pairs = build_pairwise_batches((source,))
+    c3, _shard = _synthetic_coalition_batch(tmp_path, rows)
+    trainer = PanelTrainer(
+        learner_seed=17,
+        q1_batch=pairs["C1"],
+        q2_batch=pairs["C2"],
+        c3_batch=c3,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    trainer.train(2)
+    receipt = trainer.deployment_receipt()
+    assert receipt["all_learned_arms_retain_update_deploy_all_heads"] is True
+    assert all(
+        receipt["head_updates"][arm] == {"C1": 2, "C2": 2, "C3": 2}
+        for arm in PANEL_LEARNED_ARMS
+    )
+    assert all(set(model.payload()) == set(ROUTES) for model in trainer.models.values())
+
+
+def test_ordered_search_is_first_improvement_not_best_improvement() -> None:
+    rows = {value: ScoredConfiguration(_assignment(value), float(value)) for value in range(4)}
+    path = {
+        rows[0].digest: (rows[1], rows[3]),
+        rows[1].digest: (rows[2],),
+        rows[2].digest: (),
+        rows[3].digest: (),
+    }
+    selected, accepted = first_improvement(rows[0], lambda row: path[row.digest])
+    assert selected == rows[2]
+    assert accepted == 2
+    assert selected != rows[3]  # best-improvement's first choice
+
+
+def test_shared_physical_cache_cannot_leak_into_selection() -> None:
+    plans = tuple(_plan(arm, selected=1 if index < 5 else 2) for index, arm in enumerate(PANEL_ARM_ORDER))
+    key_calls = 0
+
+    class BarrierCache(PhysicalOutcomeCache[dict]):
+        def realise(self, key, evaluate):
+            # If realisation is moved inside the per-arm selection loop this
+            # test fails on the first arm, before all nine keys exist.
+            assert key_calls == len(PANEL_ARM_ORDER)
+            return super().realise(key, evaluate)
+
+    cache = BarrierCache()
+
+    def key_for(arm, assignment):
+        nonlocal key_calls
+        key_calls += 1
+        return _key(arm, assignment)
+
+    receipt = select_then_realise(
+        plans,
+        key_for=key_for,
+        evaluate=lambda key: {"poison": -10_000 if key.assignment == _assignment(1) else 10_000},
+        cache=cache,
+    )
+    assert receipt["selection_completed_before_cache_lookups"] is True
+    assert receipt["union_realised_configurations"] == 2
+    assert receipt["cache_misses"] == 2
+    assert all(receipt["selected"][arm] == plans[index].catalogue[1].assignment for index, arm in enumerate(PANEL_ARM_ORDER))
+
+    unsealed = PhysicalOutcomeCache()
+    with pytest.raises(StageCContractError, match="before all selections sealed"):
+        unsealed.realise(_key("FULL", _assignment(1)), lambda _key: {})
+
+
+def test_physical_cache_key_binds_every_declared_context_dimension() -> None:
+    base = _key("FULL", _assignment(1))
+    mutations = {
+        "tape_sha256": "b" * 64,
+        "world_id": "V025_PROBE/world/2",
+        "decision_time_ns": 1,
+        "assignment": _assignment(2),
+        "physical_setting_sha256": "b" * 64,
+        "run_setting_sha256": "b" * 64,
+        "evaluator_sha256": "b" * 64,
+        "field": "nominal",
+        "boundary_indices": (0,),
+        "transition_sha256": "b" * 64,
+        "prefix_history_sha256": "b" * 64,
+    }
+    payload = {field: getattr(base, field) for field in mutations}
+    for field, value in mutations.items():
+        changed = {**payload, field: value}
+        # Fill fields that are not in the mutation table from the base.
+        for name in base.__dataclass_fields__:
+            changed.setdefault(name, getattr(base, name))
+        assert PhysicalCacheKey(**changed).digest != base.digest
+
+
+def test_degeneracy_screen_is_exact_sign_reporting_not_filtering() -> None:
+    anchors = (
+        {
+            "anchor_id": "a0",
+            "reference": {"bits": Fraction(10), "joules": Fraction(2)},
+            "outcomes": {
+                "FULL": {"bits": Fraction(11), "joules": Fraction(2)},
+                "DROP_C1": {"bits": Fraction(9), "joules": Fraction(2)},
+            },
+        },
+        {
+            "anchor_id": "a1",
+            "reference": {"bits": Fraction(10), "joules": Fraction(2)},
+            "outcomes": {
+                "FULL": {"bits": Fraction(10), "joules": Fraction(2)},
+                "DROP_C1": {"bits": Fraction(12), "joules": Fraction(2)},
+            },
+        },
+    )
+    report = degeneracy_report(anchors, (("FULL-minus-DROP_C1", "FULL", "DROP_C1"),))
+    contrast = report["contrasts"]["FULL-minus-DROP_C1"]
+    assert report["role"] == "REPORTING_ONLY_NOT_A_FILTER"
+    assert report["anchors_retained"] == 2
+    assert report["below_reference"]["a0"] == {"FULL": False, "DROP_C1": True}
+    assert contrast["all_anchor"]["anchor_count"] == 2
+    assert contrast["all_arms_at_or_above_reference"]["anchor_ids"] == ["a1"]
+
+
+def test_both_provisioning_rules_are_named_and_no_third_rule_is_accepted() -> None:
+    assert provisioning_rule("SEALED") == "SEALED"
+    assert provisioning_rule("MARGIN_Q") == "MARGIN_Q"
+    with pytest.raises(StageCContractError):
+        provisioning_rule("POSTHOC")

