+    pairs = build_pairwise_batches((source,))
+    c3 = CoalitionBatch.create((coalition,))
+    trainer = PanelTrainer(
+        learner_seed=17,
+        q1_batch=pairs["C1"],
+        q2_batch=pairs["C2"],
+        c3_batch=c3,
+        neutral_sources=default_synthetic_neutral_sources(),
+    )
+    train_started = time.perf_counter()
+    trainer.train(2)
+    train_seconds = time.perf_counter() - train_started
+    training = trainer.deployment_receipt()
+
+    built = exact_builds[0]
+    base = built["base"]
+    coalition_mapping = base.mapping
+    for member in built["coalition_row"].context.members:
+        coalition_mapping[member.user_id] = pilot._identity(member.selected_action)
+    candidates = (base.assignments, tuple(sorted(coalition_mapping.items())))
+    plans = []
+    for arm in PANEL_LEARNED_ARMS:
+        rows = tuple(ScoredConfiguration(value, _score(trainer.models[arm], built, value)) for value in candidates)
+        seed, _accepted = first_improvement(rows[0], lambda current, rows=rows: rows[1:] if current == rows[0] else ())
+        plans.append(ArmPlan(arm, seed.assignment, rows, True))
+    baseline_rows = (
+        ScoredConfiguration(candidates[0], 0.0),
+        ScoredConfiguration(candidates[1], -float(len(built["coalition_row"].context.members))),
+    )
+    baseline_seed, _ = first_improvement(baseline_rows[0], lambda _current: baseline_rows[1:])
+    plans.append(ArmPlan("BASELINE", baseline_seed.assignment, baseline_rows, True))
+
+    configs = {
+        tuple(config.assignments): config
+        for config in (
+            base,
+            pilot.ENGINE._configuration(base, coalition_mapping, kind="c3-panel-smoke"),
+        )
+    }
+    tier_rows = []
+    anchor_screen_rows = []
+    for rule_name in ("SEALED", "MARGIN_Q"):
+        rule = provisioning_rule(rule_name)
+        cache = PhysicalOutcomeCache[dict[str, float]]()
+        realised = pilot.ENGINE.StepEvaluator(
+            tape,
+            setting,
+            0,
+            transition_from=built["incumbent"],
+            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, 0),
+            field="realised",
+            run_setting=run_setting,
+        )
+        realised_seconds = 0.0
+
+        def key_for(_arm, assignment):
+            return PhysicalCacheKey(
+                tape_sha256=tape.digest,
+                world_id=tape.domain,
+                decision_time_ns=0,
+                assignment=assignment,
+                physical_setting_sha256=canonical_sha256({"setting": "a-r0", "provisioning_rule": rule}),
+                run_setting_sha256=run_setting.digest,
+                evaluator_sha256=hashlib.sha256(pilot.ENGINE_PATH.read_bytes()).hexdigest(),
+                field="realised",
+                boundary_indices=tuple(realised.boundary_indices),
+                transition_sha256=canonical_sha256(built["incumbent"].assignments),
+                prefix_history_sha256=canonical_sha256({"world": tape.domain, "step": 0, "prefix": []}),
+            )
+
+        def evaluate(key):
+            nonlocal realised_seconds
+            started = time.perf_counter()
+            profile = realised.evaluate(configs[key.assignment])
+            realised_seconds += time.perf_counter() - started
+            return {"bits": profile.bits, "joules": profile.joules}
+
+        started = time.perf_counter()
+        tier = select_then_realise(tuple(plans), key_for=key_for, evaluate=evaluate, cache=cache)
+        total = time.perf_counter() - started
+        tier_rows.append({
+            "provisioning_rule": rule,
+            **{key: value for key, value in tier.items() if key != "outcomes"},
+            "selection_seconds": total - realised_seconds,
+            "realisation_seconds": realised_seconds,
+        })
+        base_profile = realised.evaluate(base)
+        anchor_screen_rows.append({
+            "anchor_id": f"{tape.domain}|0|{REFERENCE_CARRIERS[0]}|{rule}",
+            "reference": {"bits": base_profile.bits, "joules": base_profile.joules},
+            "outcomes": tier["outcomes"],
+        })
+
+    contrasts = tuple(
+        (f"FULL-minus-{arm}", "FULL", arm)
+        for arm in (*PANEL_LEARNED_ARMS[1:], "BASELINE")
+    )
+    screen = degeneracy_report(anchor_screen_rows, contrasts)
+    result = {
+        "label": LABEL,
+        "smoke_test_not_evidence": True,
+        "production_training_run": False,
+        "policy_run": False,
+        "processes_used": 1,
+        "process_limit": 4,
+        "world": tape.domain,
+        "anchors": 2,
+        "learner_seeds": 1,
+        "source_epochs": 2,
+        "panel_arms": len(PANEL_ARM_ORDER),
+        "learned_arms": len(PANEL_LEARNED_ARMS),
+        "tape_build_seconds": tape_seconds,
+        "exact_row_build_seconds": exact_seconds,
+        "primitive_row_build_seconds": primitive_seconds,
+        "exact_row_seconds_per_anchor": sum(exact_seconds) / len(exact_seconds),
+        "source_rows": sum(len(built["rows"]) for built in exact_builds),
+        "coalition_rows": len(exact_builds),
+        "exact_assertions": assertions,
+        "surrogate_difference_witness_counts": differences,
+        "training_seconds": train_seconds,
+        "training_seconds_per_arm_per_epoch": train_seconds / len(PANEL_LEARNED_ARMS) / 2,
+        "training": training,
+        "tier": tier_rows,
+        "screen": screen,
+        "provisioning_rule_note": (
+            "Both named branches are exercised at the orchestration/cache boundary. "
+            "This workspace's inherited physics evaluator is the SEALED implementation; "
+            "the MARGIN_Q numeric evaluator remains the read-only sibling harness seam."
+        ),
+        "fallback_constant_unchanged": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK is True,
+    }
+    path = output / "smoke.json"
+    path.write_text(json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n", encoding="ascii")
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(smoke(args.output), indent=2, sort_keys=True, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
