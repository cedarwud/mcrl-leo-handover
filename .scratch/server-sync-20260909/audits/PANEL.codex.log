    beta1: float
    beta2: float
    epsilon: float
    weight_decay: float
    gauge_beta: float
    loss_weight: float
    adam_step: int = 0

    @classmethod
    def create(cls, input_dim: int, literal: Mapping[str, object], rng: np.random.Generator) -> "AdamMLPHead":
