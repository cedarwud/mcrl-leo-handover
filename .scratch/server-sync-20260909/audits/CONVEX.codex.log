     1	"""V0.25 channel and antenna scalar helpers.
     2	
     3	The helpers are pure and vectorised where useful.  Random draws require an
     4	explicit generator so candidate ordering or counterfactual evaluation cannot
     5	silently acquire a private RNG stream.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import math
    11	
    12	import numpy as np
    13	
    14	from mcrl.errors import MCRLContractError
    15	from mcrl.runtime.bessel import _miller_array, bessel_j_array, bessel_j_miller
    16	
    17	from .constants_v025 import (
    18	    BOLTZMANN_J_PER_K,
    19	    CARRIER_FREQUENCY_HZ,
    20	    RICIAN_K_FACTOR_DB,
    21	    RX_ENVELOPE_A_DBI,
    22	    RX_ENVELOPE_B,
    23	    RX_GAIN_FLOOR_DBI,
    24	    RX_GAIN_MAX_DBI,
    25	    RX_S465_THETA_MIN_DEG,
    26	    SPEED_OF_LIGHT_M_S,
    27	    SYSTEM_TEMPERATURE_K,
    28	    SCINTILLATION_ELEVATION_DEG,
    29	    SCINTILLATION_LOSS_DB,
    30	    SHADOW_SIGMA_DB,
    31	    SHADOW_SIGMA_ELEVATION_DEG,
    32	    MINIMUM_ELEVATION_DEG,
    33	    TX_FULL_HPBW_DEG,
    34	    TX_G0_LINEAR,
    35	)
    36	
    37	_BESSEL_MU_COEFFICIENT = 2.07123
    38	_MU_ZERO = 1.0e-10
    39	
    40	
    41	def noise_power_w(bandwidth_hz: float) -> float:
    42	    """Return ``k*T_sys*bandwidth`` in watts."""
    43	
    44	    if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
    45	        raise ValueError("bandwidth_hz must be finite and positive")
    46	    return BOLTZMANN_J_PER_K * SYSTEM_TEMPERATURE_K * bandwidth_hz
    47	
    48	
    49	def free_space_path_gain(slant_km: np.ndarray | float) -> np.ndarray:
    50	    """Linear free-space gain; doubling distance gives exactly one quarter."""
    51	
    52	    distance = np.asarray(slant_km, dtype=np.float64)
    53	    if not np.all(np.isfinite(distance)) or np.any(distance <= 0.0):
    54	        raise MCRLContractError("slant range must be finite and positive")
    55	    wavelength = SPEED_OF_LIGHT_M_S / CARRIER_FREQUENCY_HZ
    56	    return (wavelength / (4.0 * math.pi * distance * 1000.0)) ** 2
    57	
    58	
    59	def db_loss_gain(loss_db: np.ndarray | float) -> np.ndarray:
    60	    """Convert a nonnegative dB loss to its linear power multiplier."""
    61	
    62	    loss = np.asarray(loss_db, dtype=np.float64)
    63	    if not np.all(np.isfinite(loss)) or np.any(loss < 0.0):
    64	        raise MCRLContractError("loss_db must be finite and nonnegative")
    65	    return 10.0 ** (-loss / 10.0)
    66	
    67	
    68	def scintillation_loss_db(elevation_deg: np.ndarray | float) -> np.ndarray:
    69	    """Retained 20-GHz deterministic table, linearly interpolated and clamped."""
    70	
    71	    elevation = np.asarray(elevation_deg, dtype=np.float64)
    72	    if not np.all(np.isfinite(elevation)) or np.any((elevation < -90.0) | (elevation > 90.0)):
    73	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
    74	    return np.interp(
    75	        np.clip(elevation, SCINTILLATION_ELEVATION_DEG[0], SCINTILLATION_ELEVATION_DEG[-1]),
    76	        SCINTILLATION_ELEVATION_DEG,
    77	        SCINTILLATION_LOSS_DB,
    78	    )
    79	
    80	
    81	def shadow_sigma_db(elevation_deg: np.ndarray | float) -> np.ndarray:
    82	    """Retained Ka-LOS zero-mean-dB shadow sigma table."""
    83	
    84	    elevation = np.asarray(elevation_deg, dtype=np.float64)
    85	    if not np.all(np.isfinite(elevation)) or np.any((elevation < -90.0) | (elevation > 90.0)):
    86	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
    87	    return np.interp(
    88	        np.clip(elevation, SHADOW_SIGMA_ELEVATION_DEG[0], SHADOW_SIGMA_ELEVATION_DEG[-1]),
    89	        SHADOW_SIGMA_ELEVATION_DEG,
    90	        SHADOW_SIGMA_DB,
    91	    )
    92	
    93	
    94	def transmit_gain_linear(theta_deg: np.ndarray | float) -> np.ndarray:
    95	    """HOBS ideal aperture pattern, with full-HPBW converted once."""
    96	
    97	    theta = np.asarray(theta_deg, dtype=np.float64)
    98	    if not np.all(np.isfinite(theta)):
    99	        raise MCRLContractError("off-axis angles must be finite")
   100	    half_power = math.radians(TX_FULL_HPBW_DEG / 2.0)
   101	    mu = _BESSEL_MU_COEFFICIENT * np.sin(np.radians(theta)) / math.sin(half_power)
   102	    flat = np.atleast_1d(mu).ravel()
   103	    on_axis = np.abs(flat) < _MU_ZERO
   104	    safe = np.where(on_axis, 1.0, flat)
   105	    # The historical ascending series is already measurably inaccurate at
   106	    # mu=34.  Route the new engine to stable Miller recursion from mu>=20;
   107	    # keep the vectorised series only in its well-conditioned main-lobe range.
   108	    stable = np.abs(safe) >= 20.0
   109	    j1 = np.empty_like(safe)
   110	    j3 = np.empty_like(safe)
   111	    if np.any(~stable):
   112	        series_rows = bessel_j_array((1, 3), safe[~stable])
   113	        j1[~stable] = series_rows[0]
   114	        j3[~stable] = series_rows[1]
   115	    if np.any(stable):
   116	        stable_values = safe[stable]
   117	        stable_rows = _miller_array((1, 3), np.abs(stable_values))
   118	        signs = np.where(stable_values < 0.0, -1.0, 1.0)
   119	        j1[stable] = stable_rows[0] * signs
   120	        j3[stable] = stable_rows[1] * signs
   121	    bracket = j1 / (2.0 * safe) + 36.0 * j3 / safe**3
   122	    result = TX_G0_LINEAR * bracket**2
   123	    result[on_axis] = TX_G0_LINEAR
   124	    return result.reshape(theta.shape)
   125	
   126	
   127	def receive_gain_dbi(separation_deg: np.ndarray | float) -> np.ndarray:
   128	    """S.465-6 envelope with the declared near-axis approximation.
   129	
   130	    For this terminal ``D/lambda < 50`` and the applicable lower boundary is
   131	    2.043298703 degrees.  S.465-6 supplies ``32 - 25 log10(theta)`` from that
   132	    boundary to 48 degrees and the -10 dBi continuation thereafter.  Below
   133	    the boundary V0.25 deliberately extends the same analytic envelope up to
   134	    the independently sourced 35 dBi terminal peak.  That last branch is an
   135	    engineering approximation, not a prescription of S.465-6.
   136	    """
   137	
   138	    separation = np.asarray(separation_deg, dtype=np.float64)
   139	    if not np.all(np.isfinite(separation)) or np.any(separation < 0.0):
   140	        raise MCRLContractError("receive separations must be finite and nonnegative")
   141	    with np.errstate(divide="ignore"):
   142	        near_axis_approximation = RX_ENVELOPE_A_DBI - RX_ENVELOPE_B * np.log10(
   143	            np.maximum(separation, 1.0e-12)
   144	        )
   145	        s465_envelope = RX_ENVELOPE_A_DBI - RX_ENVELOPE_B * np.log10(
   146	            np.maximum(separation, RX_S465_THETA_MIN_DEG)
   147	        )
   148	    result = np.where(
   149	        separation < RX_S465_THETA_MIN_DEG,
   150	        near_axis_approximation,
   151	        s465_envelope,
   152	    )
   153	    return np.clip(result, RX_GAIN_FLOOR_DBI, RX_GAIN_MAX_DBI)
   154	
   155	
   156	def receive_gain_linear(separation_deg: np.ndarray | float) -> np.ndarray:
   157	    return 10.0 ** (receive_gain_dbi(separation_deg) / 10.0)
   158	
   159	
   160	def interference_receive_gain_linear(
   161	    separation_deg: np.ndarray | float,
   162	    *,
   163	    same_satellite: np.ndarray | bool,
   164	) -> np.ndarray:
   165	    """Receive gain used in the interference sum, including boresight override."""
   166	
   167	    separation = np.asarray(separation_deg, dtype=np.float64)
   168	    same = np.asarray(same_satellite, dtype=np.bool_)
   169	    try:
   170	        separation, same = np.broadcast_arrays(separation, same)
   171	    except ValueError as error:
   172	        raise MCRLContractError("separation and satellite-identity masks do not broadcast") from error
   173	    envelope = receive_gain_linear(separation)
   174	    peak = 10.0 ** (RX_GAIN_MAX_DBI / 10.0)
   175	    return np.where(same, peak, envelope)
   176	
   177	
   178	def rician_power_gain(
   179	    rng: np.random.Generator,
   180	    size: tuple[int, ...],
   181	    *,
   182	    k_factor_db: float = RICIAN_K_FACTOR_DB,
   183	) -> np.ndarray:
   184	    """Unit-mean Rician power gain."""
   185	
   186	    if not isinstance(rng, np.random.Generator):
   187	        raise TypeError("rng must be an explicit numpy Generator")
   188	    if not math.isfinite(k_factor_db):
   189	        raise ValueError("k_factor_db must be finite")
   190	    k_linear = 10.0 ** (k_factor_db / 10.0)
   191	    los = math.sqrt(k_linear / (k_linear + 1.0))
   192	    sigma = math.sqrt(1.0 / (2.0 * (k_linear + 1.0)))
   193	    real = los + sigma * rng.standard_normal(size)
   194	    imaginary = sigma * rng.standard_normal(size)
   195	    return real**2 + imaginary**2
   196	
   197	
   198	def shadow_linear_mean(sigma_db: float) -> float:
   199	    """Mean of ``10**(-X/10)`` for ``X ~ Normal(0, sigma_db**2)``."""
   200	
   201	    if not math.isfinite(sigma_db) or sigma_db < 0.0:
   202	        raise ValueError("sigma_db must be finite and nonnegative")
   203	    return math.exp(0.5 * (sigma_db * math.log(10.0) / 10.0) ** 2)
   204	
   205	
   206	def keyed_component_seed(
   207	    world: int,
   208	    user: int,
   209	    norad: int,
   210	    absolute_time_ns: int,
   210	    absolute_time_ns: int,
   211	    component: str,
   212	) -> int:
   213	    """Stable action/history-free key material for external tape builders."""
   214	
   215	    import hashlib
   216	
   217	    payload = f"{world}|{user}|{norad}|{absolute_time_ns}|{component}".encode("ascii")
   218	    return int.from_bytes(hashlib.sha256(payload).digest()[:8], "big")
   219	
   220	
   221	def keyed_fading_gain(
   222	    *,
   223	    world: int,
   224	    user: int,
   225	    norad: int,
   226	    absolute_time_ns: int,
   227	    elevation_deg: float,
   228	) -> float:
   229	    """Return the action-independent realised fading gain at the actual elevation.
   230	
   231	    Shadow and Rician components use separate stable keys.  Elevation is not
   232	    part of either key: two elevations therefore reuse the same standard-
   233	    normal variate while the elevation-dependent shadow sigma and
   234	    scintillation table genuinely alter the realised channel.  This is the
   235	    intended common-random-number comparison and prevents the legacy fixed
   236	    10-degree shadow fallback from returning.
   237	    """
   238	
   239	    if not math.isfinite(elevation_deg) or not -90.0 <= elevation_deg <= 90.0:
   240	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
   241	    shadow_rng = np.random.default_rng(
   242	        keyed_component_seed(world, user, norad, absolute_time_ns, "shadow")
   243	    )
   244	    rician_rng = np.random.default_rng(
   245	        keyed_component_seed(world, user, norad, absolute_time_ns, "rician")
   246	    )
   247	    sigma_db = float(shadow_sigma_db(elevation_deg))
   248	    shadow_db = sigma_db * float(shadow_rng.standard_normal())
   249	    deterministic_loss_db = float(scintillation_loss_db(elevation_deg))
   250	    rician = float(rician_power_gain(rician_rng, (1,))[0])
   251	    return rician * 10.0 ** (-(shadow_db + deterministic_loss_db) / 10.0)
   252	
   253	
   254	def _splitmix64(values: np.ndarray) -> np.ndarray:
   255	    """Vectorisable stateless 64-bit mixer used for keyed boundary tapes."""
   256	
   257	    with np.errstate(over="ignore"):
   258	        values = values + np.uint64(0x9E3779B97F4A7C15)
   259	        values = (values ^ (values >> np.uint64(30))) * np.uint64(0xBF58476D1CE4E5B9)
   260	        values = (values ^ (values >> np.uint64(27))) * np.uint64(0x94D049BB133111EB)
   261	    return values ^ (values >> np.uint64(31))
   262	
   263	
   264	def _keyed_uniform(base: np.ndarray, stream: int) -> np.ndarray:
   265	    mixed = _splitmix64(base ^ np.uint64(stream))
   266	    return ((mixed >> np.uint64(11)).astype(np.float64) + 0.5) * (2.0 ** -53)
   267	
   268	
   269	def _keyed_normal(base: np.ndarray, stream: int) -> np.ndarray:
   270	    first = _keyed_uniform(base, stream)
   271	    second = _keyed_uniform(base, stream ^ 0xD1B54A32D192ED03)
   272	    return np.sqrt(-2.0 * np.log(first)) * np.cos(2.0 * np.pi * second)
   273	
   274	
   275	def keyed_fading_gain_array(
   276	    *,
   277	    world: int,
   278	    user: np.ndarray,
   279	    norad: np.ndarray,
   280	    absolute_time_ns: np.ndarray,
   281	    elevation_deg: np.ndarray,
   282	) -> np.ndarray:
   283	    """Dense counterpart of :func:`keyed_fading_gain` for provider tapes."""
   284	
   285	    elevation = np.asarray(elevation_deg, dtype=np.float64)
   286	    if not np.all(np.isfinite(elevation)) or np.any((elevation < -90.0) | (elevation > 90.0)):
