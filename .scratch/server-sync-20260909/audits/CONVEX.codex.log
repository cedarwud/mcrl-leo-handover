   319	def _solve_power(
   320	    direct: np.ndarray,
   321	    coupling: np.ndarray,
   322	    noise: np.ndarray,
   323	    caps: np.ndarray,
   324	    active_user_ids: tuple[int, ...],
   325	    config: RadiationConfig,
   326	    *,
   327	    target_sinr: np.ndarray | None = None,
   328	    force_cap: np.ndarray | None = None,
   329	    enforce_target_clearance: bool = False,
   330	) -> tuple[np.ndarray, PowerCertificate]:
   331	    """Capped standard-interference fixed point, always initialised at zero."""
   332	
   333	    targets = (
   334	        np.full(len(active_user_ids), config.target_sinr, dtype=np.float64)
   335	        if target_sinr is None
   336	        else np.asarray(target_sinr, dtype=np.float64)
   337	    )
   338	    forced = (
   339	        np.zeros(len(active_user_ids), dtype=np.bool_)
   340	        if force_cap is None
   341	        else np.asarray(force_cap, dtype=np.bool_)
   342	    )
   343	    if targets.shape != caps.shape or forced.shape != caps.shape:
   344	        raise MCRLContractError("power target, forced-cap mask, and caps must share shape")
   345	    power = np.zeros(len(active_user_ids), dtype=np.float64)
   346	    residual = math.inf
   347	    recent_changes: list[float] = []
   348	    status: Literal["CONVERGED", "CONVERGED_SLOW"] = "CONVERGED"
   349	    for iteration in range(1, config.solver_iteration_cap + 1):
   350	        updated = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   351	        updated[forced] = caps[forced]
   352	        if not np.all(np.isfinite(updated)) or np.any(
   353	            updated + config.solver_tolerance_w < power
   354	        ):
   355	            return power, PowerCertificate(
   356	                "INVALID", iteration, math.inf, config.solver_tolerance_w
   357	            )
   358	        change = np.abs(updated - power)
   359	        residual = float(np.max(change)) if power.size else 0.0
   360	        relative = float(
   361	            np.max(change / np.maximum(np.abs(updated), np.finfo(float).tiny))
   362	        ) if power.size else 0.0
   363	        recent_changes.append(residual)
   364	        if len(recent_changes) > 1_000:
   365	            recent_changes.pop(0)
   366	        power = updated
   367	        if residual <= config.solver_tolerance_w or relative <= 1.0e-9:
   368	            break
   369	    else:
   370	        if (
   371	            len(recent_changes) == 1_000
   372	            and max(recent_changes) < 1.0e-6
   373	            and all(
   374	                right <= left + np.finfo(float).eps
   375	                for left, right in zip(recent_changes, recent_changes[1:])
   376	            )
   377	        ):
   378	            status = "CONVERGED_SLOW"
   379	        else:
   380	            return power, PowerCertificate(
   381	                "INVALID", config.solver_iteration_cap, residual, config.solver_tolerance_w
   382	            )
   383	    if enforce_target_clearance and power.size:
   384	        # A monotone fixed-point sequence approaches the threshold from below.
   385	        # Preserve the established full-path endpoint by taking one final
   386	        # update, then move one negligible solver-scale step into the
   387	        # certified feasible half-space.
   388	        power = np.minimum(caps, targets * (noise + coupling @ power) / direct)
   389	        power[forced] = caps[forced]
   390	        power = np.minimum(caps, np.nextafter(power * (1.0 + 2.0e-9), np.inf))
   391	        power[forced] = caps[forced]
   392	    return power, PowerCertificate(
   393	        status,
   394	        iteration,
   395	        residual,
   396	        config.solver_tolerance_w,
   397	        tuple(active_user_ids[index] for index in np.flatnonzero(power >= caps - config.solver_tolerance_w)),
   398	    )
