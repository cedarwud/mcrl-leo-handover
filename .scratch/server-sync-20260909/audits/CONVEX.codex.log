     1	"""Partial-payload energy accounting for the V0.25 engine."""
     2	
     3	from __future__ import annotations
     4	
     5	from dataclasses import dataclass
     6	import math
     7	from typing import Iterable, Mapping
     8	
     9	from mcrl.errors import MCRLContractError
    10	
    11	from .architectures import BeamIdentity
    12	from .constants_v025 import (
    13	    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
    14	    BEAM_RF_CAP_W,
    15	    CIRCUIT_POWER_PER_CHAIN_W,
    16	    PA_MAX_EFFICIENCY,
    17	    PA_SATURATION_POWER_W,
    18	    P_BUS_W,
    19	    STANDBY_FRACTION,
    20	)
    21	
    22	
    23	def pa_efficiency(rf_power_w: float) -> float:
    24	    """Square-root PA efficiency; zero RF has zero efficiency."""
    25	
    26	    if not math.isfinite(rf_power_w) or rf_power_w < 0.0:
    27	        raise MCRLContractError("RF power must be finite and nonnegative")
    28	    if rf_power_w == 0.0:
    29	        return 0.0
    30	    return min(PA_MAX_EFFICIENCY, PA_MAX_EFFICIENCY * math.sqrt(rf_power_w / PA_SATURATION_POWER_W))
    31	
    32	
    33	def pa_supply_power_w(rf_power_w: float) -> float:
    34	    """``sqrt(p*p_sat)/eta_max`` for positive RF, exactly zero at zero."""
    35	
    36	    if not math.isfinite(rf_power_w) or rf_power_w < 0.0:
    37	        raise MCRLContractError("RF power must be finite and nonnegative")
    38	    return 0.0 if rf_power_w == 0.0 else math.sqrt(rf_power_w * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY
    39	
    40	
    41	PRIMARY_IDLE_POWER_W = 0.0
    42	SENSITIVITY_IDLE_POWER_W = STANDBY_FRACTION * pa_supply_power_w(BEAM_RF_CAP_W)
    43	
    44	
    45	@dataclass(frozen=True)
    46	class HardwareInventory:
    47	    """Physical beam-chain identities fixed before actions and horizons."""
    48	
    49	    chains: tuple[BeamIdentity, ...]
    50	
    51	    def __post_init__(self) -> None:
    52	        if len(set(self.chains)) != len(self.chains):
    53	            raise MCRLContractError("hardware inventory contains duplicate identities")
    54	        if tuple(sorted(self.chains)) != self.chains:
    55	            raise MCRLContractError("hardware inventory must use frozen sorted identity order")
    56	        if any(len(identity) != 2 for identity in self.chains):
    57	            raise MCRLContractError("inventory identities must be (NORAD, beam-chain)")
    58	
    59	    @classmethod
    60	    def fixed(cls, identities: Iterable[BeamIdentity]) -> "HardwareInventory":
    61	        return cls(tuple(sorted((int(norad), int(chain)) for norad, chain in identities)))
    62	
    63	
    64	@dataclass(frozen=True)
    65	class EnergyInterval:
    66	    duration_s: float
    67	    beam_rf_w: Mapping[BeamIdentity, float]
    68	
    69	
    70	@dataclass(frozen=True)
    71	class EnergyReceipt:
    72	    joules: float
    73	    pa_j: float
    74	    circuit_j: float
    75	    standby_j: float
    76	    baseband_j: float
    77	    bus_j: float
    78	
    79	    def verify(self) -> None:
    80	        components = (self.pa_j, self.circuit_j, self.standby_j, self.baseband_j, self.bus_j)
    81	        if any(not math.isfinite(value) or value < 0.0 for value in components):
    82	            raise MCRLContractError("energy components must be finite and nonnegative")
    83	        if not math.isclose(math.fsum(components), self.joules, rel_tol=0.0, abs_tol=1.0e-12):
    84	            raise MCRLContractError("energy receipt components do not sum to joules")
    85	
    86	
    87	def interval_energy(
    88	    inventory: HardwareInventory,
    89	    interval: EnergyInterval,
    90	    *,
    91	    idle_power_w: float = PRIMARY_IDLE_POWER_W,
    92	    bus_power_w: float = P_BUS_W,
    93	    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
    94	) -> EnergyReceipt:
    95	    """Evaluate the declared physical-inventory formula for one interval."""
    96	
    97	    if not math.isfinite(interval.duration_s) or interval.duration_s < 0.0:
    98	        raise MCRLContractError("interval duration must be finite and nonnegative")
    99	    if not math.isfinite(idle_power_w) or idle_power_w < 0.0:
   100	        raise MCRLContractError("idle power must be finite and nonnegative")
   101	    if not math.isfinite(circuit_power_per_active_chain_w) or circuit_power_per_active_chain_w < 0.0:
   102	        raise MCRLContractError("active-chain circuit power must be finite and nonnegative")
   103	    if bus_power_w != 0.0:
   104	        raise MCRLContractError("V0.25 stage-1 endpoint declares P_bus=0 exclusion")
   105	    inventory_set = set(inventory.chains)
   106	    supplied = set(interval.beam_rf_w)
   107	    if not supplied <= inventory_set:
   108	        raise MCRLContractError("radiation names a chain outside the fixed inventory")
   109	    if any(not math.isfinite(value) or value < 0.0 for value in interval.beam_rf_w.values()):
   110	        raise MCRLContractError("beam RF values must be finite and nonnegative")
   111	    duration = interval.duration_s
   112	    pa_j = circuit_j = standby_j = 0.0
   113	    active_satellites: set[int] = set()
   114	    active_by_satellite: dict[int, int] = {}
   115	    for identity, raw_rf in interval.beam_rf_w.items():
   116	        rf = float(raw_rf)
   117	        if rf > 0.0:
   118	            active_satellites.add(identity[0])
   119	            active_by_satellite[identity[0]] = active_by_satellite.get(identity[0], 0) + 1
   120	            pa_j += max(idle_power_w, pa_supply_power_w(rf)) * duration
   121	            circuit_j += circuit_power_per_active_chain_w * duration
   122	    if idle_power_w > 0.0:
   123	        # Sensitivity-only physical census: every represented satellite owns
   124	        # 12 RF chains, independent of the number of realisable earth cells.
   125	        represented_satellites = {identity[0] for identity in inventory.chains}
   126	        if any(active_by_satellite.get(satellite, 0) > 12 for satellite in represented_satellites):
   127	            raise MCRLContractError("active beams exceed the declared 12-chain satellite census")
   128	        idle_chains = sum(
   129	            12 - active_by_satellite.get(satellite, 0)
   130	            for satellite in represented_satellites
   131	        )
   132	        standby_j = idle_chains * idle_power_w * duration
   133	    baseband_j = len(active_satellites) * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W * duration
   134	    receipt = EnergyReceipt(
   135	        math.fsum((pa_j, circuit_j, standby_j, baseband_j)),
   136	        pa_j,
   137	        circuit_j,
   138	        standby_j,
   139	        baseband_j,
   140	        0.0,
   141	    )
   142	    receipt.verify()
   143	    return receipt
   144	
   145	
   146	def schedule_energy(
   147	    inventory: HardwareInventory,
   148	    slots: Iterable[tuple[float, Mapping[BeamIdentity, float]]],
   149	    *,
   150	    duration_s: float,
   151	    idle_power_w: float = PRIMARY_IDLE_POWER_W,
   152	    circuit_power_per_active_chain_w: float = CIRCUIT_POWER_PER_CHAIN_W,
   153	) -> EnergyReceipt:
   154	    """Integrate a slot schedule, preserving nonlinear PA averaging."""
   155	
   156	    schedule = tuple(slots)
   157	    if any(not math.isfinite(fraction) or fraction < 0.0 for fraction, _ in schedule):
   158	        raise MCRLContractError("slot fractions must be finite and nonnegative")
   159	    if not math.isclose(math.fsum(fraction for fraction, _ in schedule), 1.0, rel_tol=0.0, abs_tol=1e-12):
   160	        raise MCRLContractError("slot fractions must sum to one")
   161	    receipts = [
   162	        interval_energy(
   163	            inventory,
   164	            EnergyInterval(duration_s * fraction, beam_rf),
   165	            idle_power_w=idle_power_w,
   166	            circuit_power_per_active_chain_w=circuit_power_per_active_chain_w,
   167	        )
   168	        for fraction, beam_rf in schedule
   169	    ]
   170	    result = EnergyReceipt(
   171	        *(math.fsum(getattr(receipt, field) for receipt in receipts) for field in (
   172	            "joules", "pa_j", "circuit_j", "standby_j", "baseband_j", "bus_j"
   173	        ))
   174	    )
   175	    result.verify()
   176	    return result
   177	
   178	
   179	def event_energy_sensitivity(
   180	    event_counts: Mapping[str, int], event_cost_j: Mapping[str, float]
   181	) -> float:
   182	    """Separately named extension; primary V0.25 energy never calls this."""
   183	
   184	    if set(event_counts) != set(event_cost_j):
   185	        raise MCRLContractError("event counts and sensitivity costs must share keys")
   186	    if any(type(count) is not int or count < 0 for count in event_counts.values()):
   187	        raise MCRLContractError("event counts must be nonnegative exact integers")
   188	    if any(not math.isfinite(cost) or cost < 0.0 for cost in event_cost_j.values()):
   189	        raise MCRLContractError("event sensitivity costs must be finite and nonnegative")
   190	    return math.fsum(event_counts[name] * event_cost_j[name] for name in sorted(event_counts))
   191	
