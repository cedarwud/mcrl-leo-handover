    29	@dataclass(frozen=True)
    30	class Link:
    31	    """One attempted user link and its physical beam identity."""
    32	
    33	    user_id: int
    34	    beam: BeamIdentity
    35	    color: int
    36	    nominal_gain: float
    37	    realised_gain: float | None = None
    38	
    39	    def __post_init__(self) -> None:
    40	        if type(self.user_id) is not int or self.user_id < 0:
    41	            raise MCRLContractError("user_id must be a nonnegative exact integer")
    42	        if len(self.beam) != 2 or any(type(value) is not int for value in self.beam):
    43	            raise MCRLContractError("beam must be the physical (NORAD, chain) identity")
    44	        if type(self.color) is not int or self.color < 0:
    45	            raise MCRLContractError("color must be a nonnegative exact integer")
    46	        for label, value in (
    47	            ("nominal_gain", self.nominal_gain),
    48	            ("realised_gain", self.realised_gain),
    49	        ):
    50	            if value is not None and (not math.isfinite(value) or value <= 0.0):
    51	                raise MCRLContractError(f"{label} must be finite and positive")
    52	
