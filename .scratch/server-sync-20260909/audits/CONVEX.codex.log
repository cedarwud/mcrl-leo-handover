   281	                candidate.dwell.neighborhood_cell_ids,
   282	                (1, NUM_SATELLITE_SLOTS),
   283	            )
   284	            decisions.append(
   285	                _StepState(
   286	                    _readonly(driver.user_ecef_km()),
   287	                    _readonly(driver.user_xy_km),
   288	                    _readonly(flat_norads),
