   125	
   126	def _parse_start(value: dt.datetime | dt.date | str) -> dt.datetime:
   127	    if isinstance(value, str):
   128	        try:
   129	            parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
   130	        except ValueError as error:
   131	            raise ValueError("start_utc must be ISO-8601") from error
   132	    elif isinstance(value, dt.datetime):
   133	        parsed = value
   134	    elif isinstance(value, dt.date):
   135	        parsed = dt.datetime.combine(value, dt.time(), tzinfo=dt.timezone.utc)
   136	    else:
   137	        raise TypeError("start_utc must be a date, datetime, ISO string, or None")
   138	    if parsed.tzinfo is None:
   139	        raise ValueError("start_utc must be timezone-aware")
   140	    return parsed.astimezone(dt.timezone.utc)
