   319	def _solve_power(
   320	    direct: np.ndarray,
   321	    coupling: np.ndarray,
   322	    noise: np.ndarray,
   323	    caps: np.ndarray,
   324	    active_user_ids: tuple[int, ...],
   325	    config: RadiationConfig,
   326	    *,
   327	    target_sinr: np.ndarray | None = None,
   328	    force_cap: np.ndarray | None = None,
   329	    enforce_target_clearance: bool = False,
   330	) -> tuple[np.ndarray, PowerCertificate]:
   331	    """Capped standard-interference fixed point, always initialised at zero."""
