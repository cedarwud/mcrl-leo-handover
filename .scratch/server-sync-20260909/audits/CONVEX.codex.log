+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import lru_cache
+import math
+
+import numpy as np
+
+from mcrl.physics_v025.acm import ACMMode, ACM_MODES, rate_target_mode, rate_target_sinr
+from mcrl.physics_v025.channel import noise_power_w, transmit_gain_linear
+from mcrl.physics_v025.constants_v025 import (
+    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    CIRCUIT_POWER_PER_CHAIN_W,
+    ENGINE_VERSION,
+    PA_SATURATION_POWER_W,
+    RATE_TARGET_BPS,
+    RX_GAIN_MAX_DBI,
+    TX_FULL_HPBW_DEG,
+)
+from mcrl.physics_v025.energy import pa_supply_power_w
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.stagec_v025.mechanism_corpus import engine_table_q10
+
+
+REFERENCE_ELEVATION_DEG = 30.0
+REFERENCE_SLANT_KM = 750.0
+REFERENCE_OFF_AXIS_DEG = 0.0
+OFF_AXIS_GRID_DEG = (0.0, TX_FULL_HPBW_DEG / 4.0, TX_FULL_HPBW_DEG / 2.0)
+SLANT_GRID_KM = (500.0, 750.0, 1000.0)
+MAX_POPULATION = 24
+
+
+@dataclass(frozen=True)
+class BeamPoint:
+    occupancy: int
+    required_se: float
+    mode: ACMMode
+    controller_threshold_linear: float
+    controller_threshold_db: float
+    required_rf_w: float
+    radiated_rf_w: float
+    pa_supply_w: float
+    total_one_beam_w: float
+
+    @property
+    def feasible(self) -> bool:
+        return self.required_rf_w <= BEAM_RF_CAP_W
+
+    @property
+    def aggregate_delivered_bps(self) -> float:
+        # n equal 1/n TDM shares sum back to one full-band mode rate.
+        return BEAM_BANDWIDTH_HZ * self.mode.spectral_efficiency_bit_per_s_hz
+
+
+@dataclass(frozen=True)
+class Optimum:
+    partition: tuple[int, ...]
+    active_beams: int
+    active_satellites: int
+    delivered_bps: float
+    power_w: float
+    ee_bits_per_j: float
+
+
+def nominal_direct_gain(theta_deg: float, slant_km: float, elevation_deg: float) -> float:
+    """Use the provider's exact direct-nominal composition."""
+
+    receive_peak = np.asarray(10.0 ** (RX_GAIN_MAX_DBI / 10.0), dtype=np.float64)
+    path = LegacyWorldProvider._nominal_path_without_scintillation(
+        np.asarray(slant_km, dtype=np.float64),
+        np.asarray(elevation_deg, dtype=np.float64),
+        receive_peak,
+    )
+    transmit = transmit_gain_linear(np.asarray(theta_deg, dtype=np.float64))
+    return float(transmit * path)
+
+
+def beam_curve(
+    rule: str,
+    theta_deg: float = REFERENCE_OFF_AXIS_DEG,
+    slant_km: float = REFERENCE_SLANT_KM,
+    elevation_deg: float = REFERENCE_ELEVATION_DEG,
+) -> dict[int, BeamPoint]:
+    if rule not in {"SEALED", "MARGIN"}:
+        raise ValueError(rule)
+    direct = nominal_direct_gain(theta_deg, slant_km, elevation_deg)
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    divisor = 1.0 if rule == "SEALED" else engine_table_q10(elevation_deg)
+    result: dict[int, BeamPoint] = {}
+    for occupancy in range(1, 13):
+        mode = rate_target_mode(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
+        target = rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, occupancy)
+        assert mode is not None and target is not None
+        required_rf = target * noise / direct / divisor
+        radiated = min(required_rf, BEAM_RF_CAP_W)
+        pa = pa_supply_power_w(radiated)
+        result[occupancy] = BeamPoint(
+            occupancy=occupancy,
+            required_se=RATE_TARGET_BPS * occupancy / BEAM_BANDWIDTH_HZ,
+            mode=mode,
+            controller_threshold_linear=target,
+            controller_threshold_db=10.0 * math.log10(target),
+            required_rf_w=required_rf,
+            radiated_rf_w=radiated,
+            pa_supply_w=pa,
+            total_one_beam_w=pa
+            + CIRCUIT_POWER_PER_CHAIN_W
+            + BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
+        )
+    return result
+
+
+@lru_cache(maxsize=None)
+def integer_partitions(total: int, minimum: int = 1) -> tuple[tuple[int, ...], ...]:
+    if total == 0:
+        return ((),)
+    rows: list[tuple[int, ...]] = []
+    for first in range(minimum, total + 1):
+        for rest in integer_partitions(total - first, first):
+            rows.append((first,) + rest)
+    return tuple(rows)
+
+
+def optimise(
+    population: int,
+    rule: str,
+    theta_deg: float = REFERENCE_OFF_AXIS_DEG,
+    slant_km: float = REFERENCE_SLANT_KM,
+    elevation_deg: float = REFERENCE_ELEVATION_DEG,
+    *,
+    fixed_costs: bool = True,
+    satellite_placement: str = "packed",
+) -> Optimum:
+    curve = beam_curve(rule, theta_deg, slant_km, elevation_deg)
+    candidates: list[Optimum] = []
+    for partition in integer_partitions(population):
+        if any(size not in curve or not curve[size].feasible for size in partition):
+            continue
+        beams = len(partition)
+        if satellite_placement == "packed":
+            satellites = 1
+        elif satellite_placement == "separate":
+            satellites = beams
+        else:
+            raise ValueError(satellite_placement)
+        delivered = math.fsum(curve[size].aggregate_delivered_bps for size in partition)
+        pa = math.fsum(pa_supply_power_w(curve[size].required_rf_w) for size in partition)
+        fixed = (
+            beams * CIRCUIT_POWER_PER_CHAIN_W
+            + satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
+            if fixed_costs
+            else 0.0
+        )
+        power = pa + fixed
+        candidates.append(
+            Optimum(partition, beams, satellites, delivered, power, delivered / power)
+        )
+    if not candidates:
+        raise RuntimeError("no feasible partition")
+    # Deterministic tie-break: fewer beams, then lexicographically larger loads.
+    return max(candidates, key=lambda row: (row.ee_bits_per_j, -row.active_beams, row.partition))
+
+
+def partition_text(partition: tuple[int, ...]) -> str:
+    return "+".join(str(value) for value in partition)
+
+
+def first_cap(curve: dict[int, BeamPoint]) -> int | None:
+    return next((n for n, row in curve.items() if not row.feasible), None)
+
+
+def d1_table(rule: str) -> list[str]:
+    curve = beam_curve(rule)
+    rows = [
+        "| n | required SE (bit/s/Hz) | selected mode | target (dB) | RF needed (W) | RF radiated (W) | PA supply (W) | chain+baseband total (W) | RF x to n+1 |",
+        "|---:|---:|:---|---:|---:|---:|---:|---:|---:|",
+    ]
+    for n, point in curve.items():
+        next_point = curve.get(n + 1)
+        growth = "n/a" if next_point is None else f"{next_point.required_rf_w / point.required_rf_w:.4f}"
+        rf_needed = f"{point.required_rf_w:.6f}" + (" **CAP**" if not point.feasible else "")
+        rows.append(
+            f"| {n} | {point.required_se:.6f} | {point.mode.name} | "
+            f"{point.controller_threshold_db:.6f} | {rf_needed} | "
+            f"{point.radiated_rf_w:.6f} | {point.pa_supply_w:.6f} | "
+            f"{point.total_one_beam_w:.6f} | {growth} |"
+        )
+    return rows
+
+
+def d2_table() -> list[str]:
+    rows = [
+        "| N | SEALED beams | SEALED occupancies | SEALED EE (Mbit/J) | MARGIN beams | MARGIN occupancies | MARGIN EE (Mbit/J) |",
+        "|---:|---:|:---|---:|---:|:---|---:|",
+    ]
+    for population in range(1, MAX_POPULATION + 1):
+        sealed = optimise(population, "SEALED")
+        margin = optimise(population, "MARGIN")
+        rows.append(
+            f"| {population} | {sealed.active_beams} | {partition_text(sealed.partition)} | "
+            f"{sealed.ee_bits_per_j / 1e6:.6f} | {margin.active_beams} | "
+            f"{partition_text(margin.partition)} | {margin.ee_bits_per_j / 1e6:.6f} |"
+        )
+    return rows
+
+
+def d3_table() -> list[str]:
+    rows = [
+        "| off-axis (deg) | slant (km) | SEALED feasible max n | SEALED N=24 optimum | MARGIN feasible max n | MARGIN N=24 optimum |",
+        "|---:|---:|---:|:---|---:|:---|",
+    ]
+    for theta in OFF_AXIS_GRID_DEG:
+        for slant in SLANT_GRID_KM:
+            sealed_curve = beam_curve("SEALED", theta, slant)
+            margin_curve = beam_curve("MARGIN", theta, slant)
+            sealed_max = max(n for n, row in sealed_curve.items() if row.feasible)
+            margin_max = max(n for n, row in margin_curve.items() if row.feasible)
+            sealed = optimise(24, "SEALED", theta, slant)
+            margin = optimise(24, "MARGIN", theta, slant)
+            rows.append(
+                f"| {theta:.2f} | {slant:.0f} | {sealed_max} | "
+                f"{sealed.active_beams} beams: {partition_text(sealed.partition)} | "
+                f"{margin_max} | {margin.active_beams} beams: {partition_text(margin.partition)} |"
+            )
+    return rows
+
+
+def geometry_summary(rule: str) -> tuple[int, int, int, int, int]:
+    changed = 0
+    comparisons = 0
+    min_beams = 10**9
+    max_beams = 0
+    occupancy_values: set[int] = set()
+    reference = {n: optimise(n, rule).partition for n in range(1, MAX_POPULATION + 1)}
+    for theta in OFF_AXIS_GRID_DEG:
+        for slant in SLANT_GRID_KM:
+            for population in range(1, MAX_POPULATION + 1):
+                result = optimise(population, rule, theta, slant)
+                comparisons += 1
+                changed += result.partition != reference[population]
+                min_beams = min(min_beams, result.active_beams)
+                max_beams = max(max_beams, result.active_beams)
+                occupancy_values.update(result.partition)
+    return changed, comparisons, min_beams, max_beams, len(occupancy_values)
+
+
+def d4_table() -> list[str]:
+    rows = [
+        "| N | SEALED with fixed costs | SEALED zero fixed | MARGIN with fixed costs | MARGIN zero fixed |",
+        "|---:|:---|:---|:---|:---|",
+    ]
+    for population in range(1, MAX_POPULATION + 1):
+        values = [
+            optimise(population, "SEALED", fixed_costs=True),
+            optimise(population, "SEALED", fixed_costs=False),
+            optimise(population, "MARGIN", fixed_costs=True),
+            optimise(population, "MARGIN", fixed_costs=False),
+        ]
+        rows.append(
+            f"| {population} | "
+            + " | ".join(f"{row.active_beams}: {partition_text(row.partition)}" for row in values)
+            + " |"
+        )
+    return rows
+
+
+def main() -> None:
+    q10 = engine_table_q10(REFERENCE_ELEVATION_DEG)
+    gain = nominal_direct_gain(
+        REFERENCE_OFF_AXIS_DEG, REFERENCE_SLANT_KM, REFERENCE_ELEVATION_DEG
+    )
+    noise = noise_power_w(BEAM_BANDWIDTH_HZ)
+    max_mode = max(ACM_MODES, key=lambda mode: mode.spectral_efficiency_bit_per_s_hz)
+    sealed_curve = beam_curve("SEALED")
+    margin_curve = beam_curve("MARGIN")
+    sealed_geo = geometry_summary("SEALED")
+    margin_geo = geometry_summary("MARGIN")
+    sealed_n24 = optimise(24, "SEALED")
+    margin_n24 = optimise(24, "MARGIN")
+    sealed_zero_n24 = optimise(24, "SEALED", fixed_costs=False)
+    margin_zero_n24 = optimise(24, "MARGIN", fixed_costs=False)
+
+    out: list[str] = []
+    add = out.append
+    add("Interior optima exist under both SEALED and MARGIN; the finite-N optimum changes with off-axis angle (and slant range) on the tested grid.")
+    add("")
+    add("# OCCUPANCY-CONVEXITY-2026-09-10")
+    add("")
+    add("`DIAGNOSTIC_NOT_CLAIM` — deterministic closed-form/numeric analysis; no training, learner, or policy run.")
+    add("")
+    add("## Result in one paragraph")
+    add("")
+    add(
+        "At the reference isolated-link geometry (boresight, 750 km slant, 30 deg elevation), both rules have an interior energy-efficiency optimum: for N=24, both choose "
+        f"{sealed_n24.active_beams} packed beams with occupancies `{partition_text(sealed_n24.partition)}` under the primary fixed-cost accounting. "
+        "Across N=1..24 the optimum is neither always one beam nor always one user per beam. Removing chain and baseband costs does not destroy the interior result: at N=24 both rules choose "
+        f"`{partition_text(sealed_zero_n24.partition)}`. Thus the discrete ACM threshold/mode-capacity and PA physics—not fixed costs alone—create the interior optimum. Geometry still changes finite-population partitions because it rescales PA power relative to fixed costs and changes cap feasibility."
+    )
+    add("")
+    add("## Scope and production-law audit")
+    add("")
+    add(
+        f"The literal engine ID is `{ENGINE_VERSION}`, with primary architecture `a-r`, rather than the shortened ID in the question ([constants_v025.py:16](src/mcrl/physics_v025/constants_v025.py#L16), [constants_v025.py:18](src/mcrl/physics_v025/constants_v025.py#L18)). "
+        "The sealed target is 50 Mbit/s; total bandwidth is 500 MHz with reuse 3, so one beam has B=166.6666667 MHz ([constants_v025.py:23](src/mcrl/physics_v025/constants_v025.py#L23), [constants_v025.py:25](src/mcrl/physics_v025/constants_v025.py#L25), [constants_v025.py:47](src/mcrl/physics_v025/constants_v025.py#L47))."
+    )
+    add("")
+    add(
+        "The TDM scheduler gives each of n beam members one equal 1/n interval ([architectures.py:268](src/mcrl/physics_v025/architectures.py#L268), [architectures.py:278](src/mcrl/physics_v025/architectures.py#L278)). Therefore required spectral efficiency is exactly `eta_req(n)=r*n/B=0.3n bit/s/Hz`, which production computes directly before choosing the lowest-threshold qualifying mode ([acm.py:77](src/mcrl/physics_v025/acm.py#L77), [acm.py:95](src/mcrl/physics_v025/acm.py#L95)). The rate endpoint sums full-band ACM rate over those slot fractions ([architectures.py:245](src/mcrl/physics_v025/architectures.py#L245)); hence this report's pooled numerator is actual delivered ACM capacity, not target-clamped `N*r*`."
+    )
+    add("")
+    add(
+        "The frozen EN 302 307-1 table is at [constants_v025.py:92](src/mcrl/physics_v025/constants_v025.py#L92). Production converts raw bit/symbol efficiency and ideal Es/N0 using `eta=efficiency/(1+rolloff)` and `threshold_dB=ideal+1.7-10log10(1+rolloff)` ([acm.py:30](src/mcrl/physics_v025/acm.py#L30)); roll-off 0.20 and margin 1.7 dB are sealed at [constants_v025.py:43](src/mcrl/physics_v025/constants_v025.py#L43). "
+        f"The maximum is {max_mode.name}, eta={max_mode.spectral_efficiency_bit_per_s_hz:.9f} bit/s/Hz; n=13 is the first required SE above it. For n=1, the controller uses the separately rounded PHY floor through `max(mode threshold, SINR_MIN)` ([acm.py:104](src/mcrl/physics_v025/acm.py#L104), [constants_v025.py:48](src/mcrl/physics_v025/constants_v025.py#L48))."
+    )
+    add("")
+    add(
+        "For an isolated beam, the coupled solver reduces analytically to `p_req=Gamma*N_noise/g_nom`; production's general update and cap are at [architectures.py:319](src/mcrl/physics_v025/architectures.py#L319) and [architectures.py:349](src/mcrl/physics_v025/architectures.py#L349). The current a-r controller always solves on nominal gains ([architectures.py:671](src/mcrl/physics_v025/architectures.py#L671)); production adds a negligible `1+2e-9` numerical clearance nudge after solving ([architectures.py:383](src/mcrl/physics_v025/architectures.py#L383)). Tables below report the mathematical threshold target exactly, without that solver-certification nudge. Inter-beam interference is zero by construction here because no cross-beam geometry was specified; this isolates the occupancy/activation trade-off asked for."
+    )
+    add("")
+    add(
+        "Nominal direct gain follows the provider exactly: transmit pattern times the path factor ([provider_legacy.py:725](src/mcrl/physics_v025/provider_legacy.py#L725)); the nominal path removes scintillation ([provider_legacy.py:488](src/mcrl/physics_v025/provider_legacy.py#L488)) and contains free-space/gaseous loss plus peak receive gain. The channel's free-space formula and noise formula are at [channel.py:41](src/mcrl/physics_v025/channel.py#L41) and [channel.py:49](src/mcrl/physics_v025/channel.py#L49). At the reference geometry, "
+        f"`g_nom={gain:.12e}` W/W and `N_noise={noise:.12e}` W."
+    )
+    add("")
+    add(
+        "The off-axis law uses full HPBW 3.32 deg and G0=2000 ([constants_v025.py:75](src/mcrl/physics_v025/constants_v025.py#L75)). It converts to the 1.66 deg one-sided half-power edge, sets `mu=2.07123 sin(theta)/sin(1.66 deg)`, and evaluates `G=2000[J1(mu)/(2mu)+36J3(mu)/mu^3]^2` ([channel.py:37](src/mcrl/physics_v025/channel.py#L37), [channel.py:94](src/mcrl/physics_v025/channel.py#L94), [channel.py:121](src/mcrl/physics_v025/channel.py#L121))."
+    )
+    add("")
+    add(
+        f"The RF cap is {BEAM_RF_CAP_W:.2f} W; 5 dB backoff gives P_sat={PA_SATURATION_POWER_W:.12f} W and eta_max=0.35 ([constants_v025.py:34](src/mcrl/physics_v025/constants_v025.py#L34)). Supply is `sqrt(p*P_sat)/eta_max` ([energy.py:33](src/mcrl/physics_v025/energy.py#L33)). Active-chain circuit power is 0.338 W and active-satellite baseband power is 0.200 W ([constants_v025.py:38](src/mcrl/physics_v025/constants_v025.py#L38)); accounting charges circuit per positive-RF chain and baseband once per active satellite ([energy.py:111](src/mcrl/physics_v025/energy.py#L111)). Thus 'always-on chain' here means always charged while the chain radiates, not while inactive."
+    )
+    add("")
+    add("### MARGIN is a diagnostic, not a sealed production option")
+    add("")
+    add(
+        "No MARGIN provisioner or fading-quantile constant exists under `physics_v025`. The task-defined MARGIN calculation therefore uses the project's nearest authenticated fading quantile: elevation-specific q10 from [mechanism_corpus.py:47](src/mcrl/stagec_v025/mechanism_corpus.py#L47) and [mechanism_corpus.py:95](src/mcrl/stagec_v025/mechanism_corpus.py#L95). It is the 10th percentile of the production Rician-times-lognormal-shadow-times-deterministic-scintillation multiplier, evaluated by 192-point Gauss-Hermite quadrature and 60 bisections ([mechanism_corpus.py:53](src/mcrl/stagec_v025/mechanism_corpus.py#L53), [mechanism_corpus.py:78](src/mcrl/stagec_v025/mechanism_corpus.py#L78)). "
+        f"At 30 deg, `q10={q10:.12f}`. MARGIN uses `p_req=Gamma*N_noise/(g_nom*q10)`, so a q10 fade lands on the same mode threshold. SEALED uses divisor 1."
+    )
+    add("")
+    add("## D1 — power versus occupancy")
+    add("")
+    add("Reference geometry: isolated link, 0 deg off-axis, 750 km slant, 30 deg elevation. `RF needed` is uncapped demand; `RF radiated` and both power columns apply the 1.65 W production cap. The growth column is uncapped RF-demand growth from n to n+1.")
+    add("")
+    add("### SEALED — nominal threshold exactly (current law)")
+    add("")
+    out.extend(d1_table("SEALED"))
+    add("")
+    add(
+        f"SEALED first hits the RF cap at n={first_cap(sealed_curve)}. Required SE first exceeds the table maximum at n=13."
+    )
+    add("")
+    add("### MARGIN — threshold divided by elevation-specific fading q10 (diagnostic)")
+    add("")
+    out.extend(d1_table("MARGIN"))
+    add("")
+    add(
+        f"MARGIN first hits the RF cap at n={first_cap(margin_curve)}. Required SE first exceeds the table maximum at n=13. Once capped, PA and total power remain at their cap values even though uncapped need continues to grow."
+    )
+    add("")
+    add("## D2 — efficiency-optimal partition, N=1..24")
+    add("")
+    add(
+        "For partition occupancies `(n1,...,nk)`, delivered rate is `sum_b B*eta_mode(nb)` and power is `sum_b(P_PA(p_req(nb))+0.338)+0.200` W. All beams are packed on one active satellite, because no per-satellite beam ceiling is declared and this is the energy-minimizing placement. Infeasible occupancies (uncapped RF above 1.65 W or no ACM mode) are excluded because all N users must be served. EE is delivered bit/s divided by watts, i.e. bit/J."
+    )
+    add("")
+    out.extend(d2_table())
+    add("")
+    add(
+        "This is an interior solution for both rules. At N=24 each uses 4 beams with `3+7+7+7`; over the full sweep the optimum varies with the integer remainder and ACM steps, rather than collapsing to either corner. If every beam is forced onto a distinct satellite, the extra 0.200 W per beam changes only SEALED N=9 (`4+5` to `9`) and N=24 (`3+7+7+7` to `8+8+8`), and MARGIN N=24 (`3+7+7+7` to `8+8+8`) at this geometry; all other N partitions are unchanged."
+    )
+    add("")
