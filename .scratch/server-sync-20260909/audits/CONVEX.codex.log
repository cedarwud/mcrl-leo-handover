    54	@dataclass(frozen=True)
    55	class Geometry:
    56	    """A history-free scheduled geometry sample.
    57	
    58	    Cross-gain entry ``[victim, aggressor]`` is received watts per aggressor
    59	    RF watt before colour, serving-beam, and waveform-overlap masks.
    60	    """
    61	
    62	    links: tuple[Link, ...]
    63	    nominal_cross_gain: np.ndarray
    64	    realised_cross_gain: np.ndarray | None = None
    65	
    66	    def __post_init__(self) -> None:
    67	        users = len(self.links)
    68	        if users == 0:
    69	            if np.asarray(self.nominal_cross_gain).shape != (0, 0):
    70	                raise MCRLContractError("empty geometry needs a (0,0) cross-gain matrix")
    71	            empty = np.zeros((0, 0), dtype=np.float64)
    72	            empty.setflags(write=False)
    73	            object.__setattr__(self, "nominal_cross_gain", empty)
    74	            object.__setattr__(self, "realised_cross_gain", None)
    75	            return
    76	        ids = [link.user_id for link in self.links]
    77	        if len(set(ids)) != users:
    78	            raise MCRLContractError("user identities must be unique")
    79	        for name in ("nominal_cross_gain", "realised_cross_gain"):
    80	            value = getattr(self, name)
    81	            if value is None:
    82	                continue
    83	            matrix = np.asarray(value, dtype=np.float64)
    84	            if matrix.shape != (users, users):
    85	                raise MCRLContractError(f"{name} must have shape ({users},{users})")
    86	            if not np.all(np.isfinite(matrix)) or np.any(matrix < 0.0):
    87	                raise MCRLContractError(f"{name} must be finite and nonnegative")
    88	            frozen = np.array(matrix, copy=True)
    89	            frozen.setflags(write=False)
    90	            object.__setattr__(self, name, frozen)
    91	
    92	    def gains(self, field: FieldKind) -> np.ndarray:
    93	        if field == "nominal":
    94	            return np.asarray([link.nominal_gain for link in self.links], dtype=np.float64)
    95	        return np.asarray(
    96	            [
    97	                link.nominal_gain if link.realised_gain is None else link.realised_gain
    98	                for link in self.links
    99	            ],
   100	            dtype=np.float64,
   101	        )
   102	
   103	    def cross(self, field: FieldKind) -> np.ndarray:
   104	        if field == "realised" and self.realised_cross_gain is not None:
   105	            return np.asarray(self.realised_cross_gain, dtype=np.float64)
   106	        return np.asarray(self.nominal_cross_gain, dtype=np.float64)
