   257	class RadiationArchitecture(Protocol):
   258	    code: ArchitectureCode
   259	
   260	    def radiate(
   261	        self,
   262	        config: RadiationConfig,
   263	        geometry: Geometry,
   264	        nominal_or_realised: FieldKind,
   265	    ) -> RadiationResult: ...
   266	
   267	
   268	def _beam_members(geometry: Geometry) -> dict[BeamIdentity, tuple[int, ...]]:
   269	    grouped: dict[BeamIdentity, list[int]] = {}
   270	    for index, link in enumerate(geometry.links):
   271	        grouped.setdefault(link.beam, []).append(index)
   272	    return {
   273	        beam: tuple(sorted(indices, key=lambda index: geometry.links[index].user_id))
   274	        for beam, indices in sorted(grouped.items())
   275	    }
   276	
   277	
   278	def _tdm_slots(geometry: Geometry) -> tuple[tuple[float, float, tuple[int, ...]], ...]:
   279	    grouped = _beam_members(geometry)
   280	    if not grouped:
   281	        return ((0.0, 1.0, ()),)
   282	    boundaries = {0.0, 1.0}
   283	    for members in grouped.values():
   284	        boundaries.update(offset / len(members) for offset in range(1, len(members)))
   285	    ordered = sorted(boundaries)
   286	    result = []
   287	    for start, end in zip(ordered, ordered[1:]):
   288	        midpoint = (start + end) / 2.0
   289	        active = tuple(
   290	            members[min(int(midpoint * len(members)), len(members) - 1)]
   291	            for members in grouped.values()
   292	        )
   293	        result.append((start, end, active))
   294	    return tuple(result)
   295	
   296	
   297	def _masked_coupling(
   298	    geometry: Geometry,
   299	    active: tuple[int, ...],
   300	    field: FieldKind,
   301	    overlap: np.ndarray | None = None,
   302	) -> np.ndarray:
   303	    count = len(active)
   304	    coupling = np.zeros((count, count), dtype=np.float64)
   305	    cross = geometry.cross(field)
   306	    for row, victim in enumerate(active):
   307	        victim_link = geometry.links[victim]
   308	        for column, aggressor in enumerate(active):
   309	            aggressor_link = geometry.links[aggressor]
   310	            if victim == aggressor or victim_link.beam == aggressor_link.beam:
   311	                continue
   312	            if victim_link.color != aggressor_link.color:
   313	                continue
   314	            factor = 1.0 if overlap is None else float(overlap[row, column])
   315	            coupling[row, column] = cross[victim, aggressor] * factor
   316	    return coupling
