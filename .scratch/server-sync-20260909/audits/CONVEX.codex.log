   832	def architecture_for(code: str) -> RadiationArchitecture:
   833	    """Return the declared architecture without aliases or module mutation."""
   834	
   835	    if code == "b":
   836	        return FixedRF()
   837	    if code == "a-\u03b3":
   838	        return AngleTPC_TDM()
   839	    if code == "a\u2032-\u03b3":
   840	        return AngleTPC_FDM()
   841	    if code == "a-r":
   842	        return AngleRateTPC_TDM()
   843	    if code == "a\u2032-r":
   844	        return AngleRateTPC_FDM()
   845	    raise MCRLContractError(f"unknown V0.25 architecture {code!r}")
