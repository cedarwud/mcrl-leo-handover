   178	class LegacyWorldProvider:
   179	    """Real TRAIN-only primitive provider using the legacy world generator.
   180	
   181	    ``start_utc`` is a test/audit seam.  Normal worlds leave it unset and the
   182	    legacy TRAIN sampler derives the epoch from ``world_seed``.  A supplied
   183	    TEST or embargo date is rejected before a TLE file is loaded.
   184	    """
   185	
   186	    def __init__(
   187	        self,
   188	        *,
   189	        tle_root: str | Path = DEFAULT_TLE_ROOT,
   190	        start_utc: dt.datetime | dt.date | str | None = None,
   191	        steps: int = CANONICAL_STEPS,
   192	        role: str = "physics-matrix",
   193	        learner_seed: int | None = None,
   194	    ) -> None:
   195	        if type(steps) is not int or steps < 1:
   196	            raise ValueError("steps must be a positive exact integer")
   197	        self.tle_root = Path(tle_root).expanduser()
   198	        self.requested_steps = steps
   199	        if not role:
   200	            raise ValueError("role must be nonempty")
   201	        if learner_seed is not None and (type(learner_seed) is not int or learner_seed < 0):
   202	            raise ValueError("learner_seed must be None or a nonnegative exact integer")
   203	        if role == "physics-matrix" and learner_seed is not None:
   204	            raise MCRLContractError("the learner-free physics matrix must attest learner_seed=None")
   205	        self.role = role
   206	        self.learner_seed = learner_seed
   207	        # Controller T6: a shortened rehearsal truncates a canonical world;
   208	        # it must never change the 30-step shortlist/inventory universe.
   209	        self.steps = CANONICAL_STEPS
   210	        self._forced_start = None if start_utc is None else _parse_start(start_utc)
   211	        self._archive = _TrainOnlyArchive(self.tle_root)
   212	        self._split = BlockAlternatingSplit.for_archive(self._archive)
   213	        if self._forced_start is not None:
   214	            part = self._split.part_for(self._forced_start.date())
   215	            if part != TRAIN or not self._archive.has(self._forced_start.date()):
   216	                raise MCRLContractError(
   217	                    f"legacy provider is TRAIN-only; {self._forced_start.date()} is {part}"
   218	                )
   219	        self._world_seed: int | None = None
   220	        self._world: _WorldState | None = None
   221	        self._time_origin_s: float | None = None
   222	
   223	    def _start_for(self, world_seed: int) -> dt.datetime:
   224	        if self._forced_start is not None:
   225	            return self._forced_start
   226	        env_rng = _evaluation_rngs(world_seed)[0]
   227	        sampler = EpisodeStartSampler.for_archive(
   228	            self._archive, self._split, TRAIN, time_step_s=DECISION_INTERVAL_S
   229	        )
   230	        result = sampler.draw(env_rng)
   231	        if self._split.part_for(result.date()) != TRAIN:
   232	            raise MCRLContractError("TRAIN sampler returned a non-TRAIN date")
   233	        return result
   234	
   235	    def _ensure(self, world_seed: int) -> _WorldState:
   236	        seed = int(world_seed)
   237	        if seed != world_seed or seed < 0:
   238	            raise MCRLContractError("world_seed must be a nonnegative exact integer")
   239	        if self._world is not None:
   240	            if self._world_seed != seed:
   241	                raise MCRLContractError("one provider instance binds exactly one world seed")
   242	            return self._world
   243	
   244	        start = self._start_for(seed)
   245	        # Child zero owns the exact TRAIN epoch draw in _start_for; child one
   246	        # owns mobility.  There is deliberately no fresh-stream replay check:
   247	        # such a check is true by construction and cannot detect seed drift.
   248	        _env_rng, mobility_rng, _action_rng, _control_rng = _evaluation_rngs(seed)
   249	
   250	        mobility = MobilityConfig(num_users=MobilityConfig().num_users)
   251	        config = ScenarioConfig(
   252	            mobility=mobility,
   253	            steps_per_episode=self.steps,
   254	        )
   255	        driver = ScenarioDriver(self._archive, config)
   256	        decisions = []
   257	        candidate = driver.reset(start, mobility_rng)
   258	        selection = select_elements(
   259	            self._archive,
   260	            start,
   261	            max_age_h=config.ephemeris.max_tle_age_h,
   262	            search_days=config.ephemeris.epoch_search_days,
   263	        )
   264	        tle_files = tuple(
   265	            (
   266	                self._archive.load(file_date).path.name,
   267	                self._archive.load(file_date).sha256,
   268	            )
   269	            for file_date in selection.source_dates
   270	        )
   271	        for index in range(CANONICAL_TAPE_STEPS):
   272	            if index:
   273	                candidate = driver.step(mobility_rng)
   274	            flat_norads = np.repeat(
   275	                candidate.window_norad_ids, NUM_BEAM_SLOTS, axis=1
   276	            )
