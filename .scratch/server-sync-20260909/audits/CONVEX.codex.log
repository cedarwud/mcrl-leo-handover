   143	class _TrainOnlyArchive(TleArchive):
   144	    """Archive view that fails closed before opening a TEST daily file."""
   145	
   146	    def __init__(self, root: str | Path) -> None:
   147	        super().__init__(root)
   148	        split = BlockAlternatingSplit.for_archive(self)
   149	        self._test_dates = frozenset(split.available_dates(self, TEST))
   150	        self._opened_dates: set[dt.date] = set()
   151	
   152	    def load(self, file_date: dt.date):
   153	        if file_date in self._test_dates:
   154	            raise MCRLContractError(
   155	                f"refusing to read TEST TLE date {file_date} through TRAIN provider"
   156	            )
   157	        daily = super().load(file_date)
   158	        self._opened_dates.add(file_date)
   159	        return daily
   160	
   161	    @property
   162	    def opened_dates(self) -> tuple[dt.date, ...]:
   163	        return tuple(sorted(self._opened_dates))
   164	
   165	    def index_sha256(self) -> str:
   166	        """Bind the frozen archive index without reading TEST file contents."""
   167	
   168	        return hashlib.sha256(
   169	            canonical_bytes(
   170	                [
   171	                    [file_date.isoformat(), path.name]
   172	                    for file_date, path in sorted(self._paths.items())
   173	                ]
   174	            )
   175	        ).hexdigest()
