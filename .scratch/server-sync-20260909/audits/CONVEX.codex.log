   182	@dataclass(frozen=True)
   183	class RadiationResult:
   184	    architecture: ArchitectureCode
   185	    field: FieldKind
   186	    slots: tuple[RadiationSlot, ...]
   187	    certificate: PowerCertificate
   188	    rate_target_bps: float | None = None
   189	
   190	    @property
   191	    def valid(self) -> bool:
   192	        return self.certificate.valid
   193	
   194	    @property
   195	    def per_user_wanted_w(self) -> dict[int, float]:
   196	        result: dict[int, float] = {}
   197	        for slot in self.slots:
   198	            for tx in slot.transmissions:
   199	                result[tx.user_id] = result.get(tx.user_id, 0.0) + slot.fraction * tx.wanted_w
   200	        return result
   201	
   202	    @property
   203	    def per_user_interference_w(self) -> dict[int, tuple[float, float]]:
   204	        result: dict[int, tuple[float, float]] = {}
   205	        for slot in self.slots:
   206	            for tx in slot.transmissions:
   207	                old = result.get(tx.user_id, (0.0, 0.0))
   208	                result[tx.user_id] = (
   209	                    old[0] + slot.fraction * tx.intra_interference_w,
   210	                    old[1] + slot.fraction * tx.inter_interference_w,
   211	                )
   212	        return result
   213	
   214	    @property
   215	    def per_user_rate_target_feasible(self) -> dict[int, bool] | None:
   216	        """Controller feasibility by user, distinct from realised PHY service."""
   217	
   218	        rows: dict[int, bool] = {}
   219	        saw_target = False
   220	        for slot in self.slots:
   221	            for tx in slot.transmissions:
   222	                if tx.rate_target_feasible is None:
   223	                    continue
   224	                saw_target = True
   225	                rows[tx.user_id] = rows.get(tx.user_id, True) and tx.rate_target_feasible
   226	        return rows if saw_target or self.rate_target_bps is not None else None
   227	
   228	    @property
   229	    def rate_target_attained(self) -> dict[int, bool] | None:
   230	        """Realised achieved-ACM target status over this normalized user-step."""
   231	
   232	        transmission_targets = {
   233	            tx.rate_target_bps
   234	            for slot in self.slots
   235	            for tx in slot.transmissions
   236	            if tx.rate_target_bps is not None
   237	        }
   238	        if self.rate_target_bps is None:
   239	            if transmission_targets:
   240	                raise MCRLContractError("non-target radiation contains a rate target")
   241	            return None
   242	        if transmission_targets and transmission_targets != {self.rate_target_bps}:
   243	            raise MCRLContractError("radiation result contains inconsistent rate targets")
   244	        target = self.rate_target_bps
   245	        rates: dict[int, float] = {}
   246	        model = ACMRate()
   247	        for slot in self.slots:
   248	            for tx in slot.transmissions:
   249	                rates.setdefault(tx.user_id, 0.0)
   250	                if model.served(tx.sinr, allocated=True):
   251	                    rates[tx.user_id] += slot.fraction * model.rate_bps(
   252	                        tx.sinr, tx.bandwidth_hz
   253	                    )
   254	        return {user: rate >= target for user, rate in rates.items()}
   255	
