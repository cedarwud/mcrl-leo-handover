import math
import numpy as np
from mcrl.physics_v025.channel import transmit_gain_linear, noise_power_w
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.constants_v025 import *
from mcrl.physics_v025.acm import rate_target_mode, rate_target_sinr
from mcrl.physics_v025.energy import pa_supply_power_w
from mcrl.stagec_v025.mechanism_corpus import engine_table_q10
q=engine_table_q10(30)
rx=np.array(10**(RX_GAIN_MAX_DBI/10))
def curve(theta=0,r=750,el=30,margin=False):
 path=float(LegacyWorldProvider._nominal_path_without_scintillation(np.array(r),np.array(el),rx))
 direct=float(transmit_gain_linear(np.array(theta)))*path
 rows=[]
 for n in range(1,14):
  mode=rate_target_mode(RATE_TARGET_BPS,BEAM_BANDWIDTH_HZ,n)
  if not mode: rows.append(None); continue
  gam=rate_target_sinr(RATE_TARGET_BPS,BEAM_BANDWIDTH_HZ,n)
  req=gam*noise_power_w(BEAM_BANDWIDTH_HZ)/direct/(engine_table_q10(el) if margin else 1)
  total=pa_supply_power_w(min(req,BEAM_RF_CAP_W))+CIRCUIT_POWER_PER_CHAIN_W+BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
  rows.append((n,mode.name,mode.spectral_efficiency_bit_per_s_hz,mode.threshold_db,req,total))
 return rows
for mar in [0,1]:
 print('M',mar)
 for x in curve(margin=mar): print(x)

def parts(n,lo=1):
 if n==0: yield (); return
 for i in range(lo,n+1):
  for rest in parts(n-i,i): yield (i,)+rest

def opt(N,theta=0,r=750,el=30,margin=False,actualbits=False,bbmode='one',fixed=True):
 rows=curve(theta,r,el,margin)
 d={x[0]:x for x in rows if x is not None and x[4]<=BEAM_RF_CAP_W+1e-15}
 ans=[]
 for p in parts(N):
  if any(x not in d for x in p):continue
  power=sum(pa_supply_power_w(d[x][4])+(CIRCUIT_POWER_PER_CHAIN_W if fixed else 0) for x in p)+((BASEBAND_POWER_PER_ACTIVE_SATELLITE_W if fixed else 0)*(len(p) if bbmode=='each' else 1))
  bits=sum(BEAM_BANDWIDTH_HZ*d[x][2] for x in p) if actualbits else N*RATE_TARGET_BPS
  ans.append((bits/power,p,power,bits))
 return max(ans,key=lambda x:(x[0],tuple(-a for a in x[1])))
for actual in [0,1]:
 for mar in [0,1]:
  print('actual',actual,'margin',mar)
  for N in range(1,25): print(N,opt(N,margin=mar,actualbits=actual)[:3])
