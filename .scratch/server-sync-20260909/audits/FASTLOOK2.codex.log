#!/usr/bin/env python3
"""Two-anchor fixed-assignment control-law fast look (diagnostic only)."""

from __future__ import annotations

import datetime as dt
import importlib.util
import json
import math
from pathlib import Path
import sys
import time

import numpy as np


REPO = Path(__file__).resolve().parents[1]
RUNNER_PATH = REPO / ".scratch/oracle-ceiling30/run_oracle_ceiling30.py"
RECEIPT_PATH = REPO / ".scratch/oracle-ceiling30-margin/results/date-2025-11-04.json"
OUTPUT_PATH = REPO / ".scratch/control-law-fast-look-result.json"
DATE = "2025-11-04"
ANCHOR_STEPS = (0, 1)
POWER_MULTIPLIERS = (0.0, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875, 1.0, 1.125, 1.25, 1.5, 2.0)


def load(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


sealed = load("control_fast_look_sealed", RUNNER_PATH)

from mcrl.env.ephemeris import BlockAlternatingSplit, TRAIN
from mcrl.env.tle import TleArchive
from mcrl.physics_v025.acm import ACM_MODES, rate_target_sinr
from mcrl.physics_v025.channel import fading_product_quantile_array, noise_power_w
from mcrl.physics_v025.constants_v025 import (
    BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
    CIRCUIT_POWER_PER_CHAIN_W,
    D2_MEASUREMENT_STEP_S,
    PA_MAX_EFFICIENCY,
    PA_SATURATION_POWER_W,
    POWER_SOLVER_ITERATION_CAP,
    POWER_SOLVER_TOLERANCE_W,
    RATE_TARGET_BPS,
)
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
import mcrl.physics_v025.tapes as tape_module


THRESHOLDS = np.asarray([row.threshold_linear for row in ACM_MODES])
EFFICIENCIES = np.asarray([row.spectral_efficiency_bit_per_s_hz for row in ACM_MODES])
NOISE = noise_power_w(BEAM_BANDWIDTH_HZ)


def parse_configuration(configuration_id: str) -> dict[int, tuple[int, int] | None]:
    if not configuration_id.startswith("CFG:"):
        raise RuntimeError("fast look requires an explicit committed configuration")
    result = {}
    for encoded in configuration_id[4:].split(";"):
        user_text, *identity = encoded.split(":")
        result[int(user_text)] = None if identity == ["NULL"] else (int(identity[0]), int(identity[1]))
    return result


def slot_grid(maximum_occupancy: int) -> tuple[np.ndarray, np.ndarray]:
    boundaries = {0.0, 1.0}
    for occupancy in range(1, maximum_occupancy + 1):
        boundaries.update(index / occupancy for index in range(1, occupancy))
    ordered = np.asarray(sorted(boundaries), dtype=np.float64)
    return ordered[1:] - ordered[:-1], (ordered[1:] + ordered[:-1]) / 2.0


def best_realised_modes(powers: np.ndarray, direct: np.ndarray, cross: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    sinr = powers * direct / (NOISE + cross @ powers)
    eligible = sinr[:, None] >= THRESHOLDS[None, :]
    indices = np.argmax(np.where(eligible, EFFICIENCIES[None, :], -1.0), axis=1)
    has_mode = np.any(eligible, axis=1) & (powers > 0.0)
    se = np.where(has_mode, EFFICIENCIES[indices], 0.0)
    return se, np.where(has_mode, indices, -1)


def energy_w(powers: np.ndarray, satellites: np.ndarray) -> float:
    positive = powers > 0.0
    pa = np.sum(np.where(positive, np.sqrt(powers * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY, 0.0))
    circuit = np.sum(positive) * CIRCUIT_POWER_PER_CHAIN_W
    baseband = len(set(int(value) for value in satellites[positive])) * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W
    return float(pa + circuit + baseband)


def declared_power(targets: np.ndarray, direct: np.ndarray, cross: np.ndarray, forced: np.ndarray) -> np.ndarray:
    power = np.zeros(len(targets), dtype=np.float64)
    done = False
    for _iteration in range(1, POWER_SOLVER_ITERATION_CAP + 1):
        updated = np.minimum(BEAM_RF_CAP_W, targets * (NOISE + cross @ power) / direct)
        updated[forced] = BEAM_RF_CAP_W
        if np.any(updated + POWER_SOLVER_TOLERANCE_W < power) or not np.all(np.isfinite(updated)):
            raise RuntimeError("invalid corrected declared-law power iteration")
        change = np.abs(updated - power)
        relative = np.max(change / np.maximum(np.abs(updated), np.finfo(float).tiny))
        power = updated
        if np.max(change) <= POWER_SOLVER_TOLERANCE_W or relative <= 1.0e-9:
            done = True
            break
    if not done:
        raise RuntimeError("corrected declared-law power solve did not converge")
    final = np.minimum(BEAM_RF_CAP_W, targets * (NOISE + cross @ power) / direct)
    final[forced] = BEAM_RF_CAP_W
    power = np.minimum(BEAM_RF_CAP_W, np.nextafter(final * (1.0 + 2.0e-9), np.inf))
    power[forced] = BEAM_RF_CAP_W
    return power


def grid_for(declared: float) -> np.ndarray:
    values = {min(BEAM_RF_CAP_W, declared * multiplier) for multiplier in POWER_MULTIPLIERS}
    values.add(BEAM_RF_CAP_W)
    values.add(declared)
    return np.asarray(sorted(values), dtype=np.float64)


def joint_coordinate_search(
    declared: np.ndarray,
    minimum_se: np.ndarray,
    direct: np.ndarray,
    cross: np.ndarray,
    satellites: np.ndarray,
    eta: float,
) -> tuple[np.ndarray, np.ndarray, int]:
    powers = declared.copy()
    se, _ = best_realised_modes(powers, direct, cross)
    comparisons = 0
    for _pass in range(4):
        moves = 0
        for column in range(len(powers)):
            best_power = powers[column]
            best_se = se
            best_value = float(np.sum(se) * BEAM_BANDWIDTH_HZ - eta * energy_w(powers, satellites))
            for candidate_power in grid_for(float(declared[column])):
                comparisons += 1
                candidate = powers.copy()
                candidate[column] = candidate_power
                candidate_se, _ = best_realised_modes(candidate, direct, cross)
                if np.any(candidate_se + 1.0e-15 < minimum_se):
                    continue
                value = float(np.sum(candidate_se) * BEAM_BANDWIDTH_HZ - eta * energy_w(candidate, satellites))
                if value > best_value + 1.0e-7 or (abs(value - best_value) <= 1.0e-7 and candidate_power < best_power):
                    best_power = float(candidate_power)
                    best_se = candidate_se
                    best_value = value
            if best_power != powers[column]:
                powers[column] = best_power
                se = best_se
                moves += 1
        if moves == 0:
            break
    return powers, se, comparisons


def local_independent_search(
    declared: np.ndarray,
    minimum_se: np.ndarray,
    direct: np.ndarray,
    cross: np.ndarray,
    satellites: np.ndarray,
    eta: float,
) -> tuple[np.ndarray, np.ndarray]:
    chosen = declared.copy()
    declared_se, _ = best_realised_modes(declared, direct, cross)
    for column in range(len(declared)):
        best_power = declared[column]
        best_value = declared_se[column] * BEAM_BANDWIDTH_HZ - eta * energy_w(
            np.asarray([declared[column]]), np.asarray([satellites[column]])
        )
        for candidate_power in grid_for(float(declared[column])):
            candidate = declared.copy()
            candidate[column] = candidate_power
            candidate_se, _ = best_realised_modes(candidate, direct, cross)
            if candidate_se[column] + 1.0e-15 < minimum_se[column]:
                continue
            own_energy = energy_w(np.asarray([candidate_power]), np.asarray([satellites[column]]))
            value = candidate_se[column] * BEAM_BANDWIDTH_HZ - eta * own_energy
            if value > best_value + 1.0e-7 or (abs(value - best_value) <= 1.0e-7 and candidate_power < best_power):
                best_power = float(candidate_power)
                best_value = float(value)
        chosen[column] = best_power
    final_se, _ = best_realised_modes(chosen, direct, cross)
    return chosen, final_se


def build_slots(arrays, mapping):
    row_of = arrays._row_index()
    users = np.asarray([int(value) for value in arrays.users], dtype=np.int64)
    selected = np.asarray([row_of[(int(user), mapping[int(user)])] for user in users], dtype=np.int64)
    row_to_aggressor = {
        (int(identity[0]), int(identity[1])): index
        for index, identity in enumerate(arrays.aggressor_identities)
    }
    aggressor = np.asarray([
        row_to_aggressor[(int(arrays.identities[row, 0]), int(arrays.identities[row, 1]))]
        for row in selected
    ], dtype=np.int64)
    beam_identities = np.asarray(arrays.identities[selected], dtype=np.int64)
    beam_codes = {tuple(identity): index for index, identity in enumerate(sorted(set(map(tuple, beam_identities.tolist()))))}
    beam_code = np.asarray([beam_codes[tuple(identity)] for identity in beam_identities.tolist()], dtype=np.int64)
    satellite_of = {
        int(identity[0]): int(column)
        for identity, column in zip(arrays.aggressor_identities, arrays.aggressor_satellite_column, strict=True)
    }
    aggressor_satellite = np.asarray([satellite_of[int(identity[0])] for identity in beam_identities], dtype=np.int64)
    wanted_slot = arrays.row_wanted_slot[selected]
    color = arrays.colors[selected]
    lower_user = np.arange(len(users))[None, :] < np.arange(len(users))[:, None]

    slots = []
    for boundary in range(48):
        live = arrays.visible[boundary, selected] & arrays.d2_eligible[boundary, selected] & arrays.cell_reachable[boundary, selected]
        same_beam = beam_code[:, None] == beam_code[None, :]
        occupancy = np.sum(same_beam & live[None, :], axis=1)
        fractions, midpoints = slot_grid(int(np.max(occupancy, initial=1)))
        rank = np.sum(same_beam & live[None, :] & lower_user, axis=1)
        direct_nominal_all = arrays.nominal_gain[boundary, selected]
        direct_realised_all = arrays.realised_gain[boundary, selected]
        quantile_all = fading_product_quantile_array(arrays.elevations_deg[boundary], 0.10)[selected]
        base_cross = arrays.cross_base_nominal[boundary, np.arange(len(users))[:, None], aggressor[None, :]]
        receive = arrays.receive_gain_by_wanted_slot[
            boundary,
            np.arange(len(users))[:, None],
            wanted_slot[:, None],
            aggressor_satellite[None, :],
        ]
        nominal_cross_all = base_cross * receive
        nominal_cross_all *= (color[:, None] == color[None, :]) & ~same_beam
        realised_cross_all = nominal_cross_all * arrays.fading_by_satellite[
            boundary, np.arange(len(users))[:, None], aggressor_satellite[None, :]
        ]
        for fraction, midpoint in zip(fractions, midpoints, strict=True):
            active_mask = live & (rank == np.floor(midpoint * occupancy).astype(np.int64))
            active = np.flatnonzero(active_mask)
            if not active.size:
                continue
            occ = occupancy[active]
            gamma = np.asarray([
                np.nan if rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, int(value)) is None
                else rate_target_sinr(RATE_TARGET_BPS, BEAM_BANDWIDTH_HZ, int(value))
                for value in occ
            ], dtype=np.float64)
            quantile = quantile_all[active]
            targets = gamma / quantile
            forced = np.isnan(targets)
            targets = np.nan_to_num(targets, nan=1.0)
            nominal_cross = nominal_cross_all[np.ix_(active, active)]
            realised_cross = realised_cross_all[np.ix_(active, active)]
            declared = declared_power(targets, direct_nominal_all[active], nominal_cross, forced)
            nominal_sinr = declared * direct_nominal_all[active] / (NOISE + nominal_cross @ declared)
            predicted = nominal_sinr * quantile
            eligible = predicted[:, None] >= THRESHOLDS[None, :]
            declared_modes = np.argmax(np.where(eligible, EFFICIENCIES[None, :], -1.0), axis=1)
            has_declared_mode = np.any(eligible, axis=1)
            realised_sinr = declared * direct_realised_all[active] / (NOISE + realised_cross @ declared)
            declared_se = np.where(
                has_declared_mode & (realised_sinr >= THRESHOLDS[declared_modes]),
                EFFICIENCIES[declared_modes],
                0.0,
            )
            slots.append({
                "boundary": boundary,
                "fraction": float(fraction),
                "users": users[active],
                "satellites": beam_identities[active, 0],
                "direct": direct_realised_all[active],
                "cross": realised_cross,
                "declared_power": declared,
                "declared_se": declared_se,
                "declared_modes": np.where(has_declared_mode, declared_modes, -1),
            })
    return slots, users


def integrate(slots, users, key: str) -> dict[str, object]:
    user_column = {int(user): index for index, user in enumerate(users)}
    rates = np.zeros((48, len(users)), dtype=np.float64)
    decode = np.zeros((48, len(users)), dtype=np.bool_)
    watts = np.zeros(48, dtype=np.float64)
    mode_counts = np.zeros(len(ACM_MODES) + 1, dtype=np.int64)
    for slot in slots:
        boundary = slot["boundary"]
        fraction = slot["fraction"]
        se = slot[f"{key}_se"]
        powers = slot[f"{key}_power"]
        indices = np.asarray([user_column[int(user)] for user in slot["users"]])
        rates[boundary, indices] += fraction * se * BEAM_BANDWIDTH_HZ
        decode[boundary, indices] |= se > 0.0
        watts[boundary] += fraction * energy_w(powers, slot["satellites"])
        _se, modes = best_realised_modes(powers, slot["direct"], slot["cross"])
        for mode in modes:
            mode_counts[int(mode) + 1] += 1
    bits_by_user = np.sum(0.5 * (rates[:-1] + rates[1:]) * D2_MEASUREMENT_STEP_S, axis=0)
    decoding_time = np.sum(0.5 * (decode[:-1].astype(float) + decode[1:].astype(float)) * D2_MEASUREMENT_STEP_S, axis=0)
    joules = float(np.sum(0.5 * (watts[:-1] + watts[1:]) * D2_MEASUREMENT_STEP_S))
    bits = float(np.sum(bits_by_user))
    return {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count": int(np.sum(decoding_time > 0.0)),
        "rate_target_attained_count": int(np.sum(bits_by_user >= RATE_TARGET_BPS * 47 * D2_MEASUREMENT_STEP_S)),
        "mode_counts": {("NO_MODE" if i == 0 else ACM_MODES[i - 1].name): int(value) for i, value in enumerate(mode_counts) if value},
    }


