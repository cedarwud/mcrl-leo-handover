def _selection_worker(task):
    step_index, base, configs = task
    evaluator = probe.StepEvaluator(
        _WORKER_TAPE,
        probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=probe.run_setting_for("a-r0"),
        boundary_indices=(0,),
        fading_quantile_alpha=0.10,
    )
    evaluator.evaluate_many(configs)
    rows = []
