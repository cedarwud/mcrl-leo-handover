            boundary = int(slot["boundary"])
            fraction = float(slot["fraction"])
            powers = slot[f"{key}_power"]
            delivered_se = slot[f"{key}_se"]
            if key == "declared":
                transmitted_modes = slot["declared_modes"]
            else:
                recomputed_se, transmitted_modes = prior.best_realised_modes(
                    powers, slot["direct"], slot["cross"]
                )
                if not np.array_equal(recomputed_se, delivered_se):
                    raise RuntimeError("recorded searched modes do not reproduce searched delivery")
            transmissions = []
            for local_index, user in enumerate(slot["users"]):
                user_id = int(user)
                mode_index = int(transmitted_modes[local_index])
                delivered_bits = float(
                    fraction
                    * float(delivered_se[local_index])
                    * prior.BEAM_BANDWIDTH_HZ
                    * prior.D2_MEASUREMENT_STEP_S
                )
                boundary_bits[boundary, user_column[user_id]] += delivered_bits
                beam_identity = slot["_beam_identities"][local_index]
                transmissions.append(
                    {
                        "beam_identity": [int(beam_identity[0]), int(beam_identity[1])],
                        "delivered_bits_for_one_boundary_interval_s": delivered_bits,
                        "radiated_power_w": float(powers[local_index]),
                        "transmitted_mode": (
                            "NO_TRANSMISSION" if mode_index < 0 else prior.ACM_MODES[mode_index].name
                        ),
                        "transmitted_mode_index": mode_index,
                        "user_id": user_id,
                    }
                )
            start = slot["_subslot_start"]
            end = slot["_subslot_end"]
            raw_records.append(
                {
                    "active_beam_count": len(transmissions),
                    "boundary_index": boundary,
                    "boundary_time_s": float(boundary * prior.D2_MEASUREMENT_STEP_S),
                    "endpoint_trapezoid_weight": 0.5 if boundary in {0, 47} else 1.0,
                    "rational_subslot_end": [end.numerator, end.denominator],
                    "rational_subslot_index": int(slot["_subslot_index"]),
                    "rational_subslot_start": [start.numerator, start.denominator],
                    "transmissions": transmissions,
                }
            )

        weights = np.ones(48, dtype=np.float64)
        weights[[0, 47]] = 0.5
        bits_by_user = np.sum(boundary_bits * weights[:, None], axis=0)
        demand_bits = float(prior.RATE_TARGET_BPS * 47 * prior.D2_MEASUREMENT_STEP_S)
        attained = bits_by_user >= demand_bits
        per_user = [
            {
                "delivered_bits_over_endpoint": float(bits_by_user[index]),
                "rate_target_attained": bool(attained[index]),
                "user_id": int(user),
            }
            for index, user in enumerate(users)
        ]
        attainment_by_user = {row["user_id"]: row["rate_target_attained"] for row in per_user}
        for record in raw_records:
            for transmission in record["transmissions"]:
                transmission["rate_target_attained_over_endpoint"] = attainment_by_user[
                    transmission["user_id"]
                ]
        if not math.isclose(float(np.sum(bits_by_user)), metrics["bits"], rel_tol=2e-15):
            raise RuntimeError("recorded per-user delivery does not reproduce aggregate bits")
        if int(np.sum(attained)) != metrics["rate_target_attained_count"]:
            raise RuntimeError("recorded attainment flags do not reproduce aggregate count")
        records = {
            "delivery_field_definition": (
                "fraction_of_TDM_subslot * realised_delivered_spectral_efficiency * "
                "beam_bandwidth_hz * 0.640_s; sum with recorded endpoint trapezoid weights"
            ),
            "per_user_endpoint": per_user,
            "subslots": raw_records,
        }
        metrics["records"] = records
        metrics["records_sha256"] = sha256_json(records)
        return metrics

    prior.build_slots = recorded_build_slots
    prior.integrate = recorded_integrate


def accounting(bits_by_user: list[float], joules: float, demand_bits: float) -> dict[str, object]:
    attained = [bits >= demand_bits for bits in bits_by_user]
    numerators = {
        "CAPACITY": math.fsum(bits_by_user),
        "DEMAND_CAPPED": math.fsum(min(bits, demand_bits) for bits in bits_by_user),
        "ATTAINMENT_ONLY": math.fsum(bits for bits, flag in zip(bits_by_user, attained, strict=True) if flag),
    }
    return {
        name: {"credited_bits": value, "efficiency_bit_per_j": value / joules}
        for name, value in numerators.items()
    }


def add_rescoring(prior, result: dict[str, object]) -> None:
    demand_bits = float(prior.RATE_TARGET_BPS * 47 * prior.D2_MEASUREMENT_STEP_S)
    for anchor in result["anchors"]:
        for policy_name in ("declared", "best_found"):
            policy = anchor[policy_name]
            bits_by_user = [
                row["delivered_bits_over_endpoint"] for row in policy["records"]["per_user_endpoint"]
            ]
            policy["accounting"] = accounting(bits_by_user, policy["joules"], demand_bits)

    pooled_accounting = {}
    for numerator in ("CAPACITY", "DEMAND_CAPPED", "ATTAINMENT_ONLY"):
        declared_bits = math.fsum(
            anchor["declared"]["accounting"][numerator]["credited_bits"]
            for anchor in result["anchors"]
        )
        found_bits = math.fsum(
            anchor["best_found"]["accounting"][numerator]["credited_bits"]
            for anchor in result["anchors"]
        )
        declared_joules = math.fsum(anchor["declared"]["joules"] for anchor in result["anchors"])
        found_joules = math.fsum(anchor["best_found"]["joules"] for anchor in result["anchors"])
        declared_ee = declared_bits / declared_joules
        found_ee = found_bits / found_joules
        pooled_accounting[numerator] = {
            "best_found_credited_bits": found_bits,
            "best_found_efficiency_bit_per_j": found_ee,
            "declared_credited_bits": declared_bits,
            "declared_efficiency_bit_per_j": declared_ee,
            "relative_gain": found_ee / declared_ee - 1.0,
        }
    result["pooled"]["accounting"] = pooled_accounting

    split = {
        "baseline_attainers": {"user_anchor_count": 0, "capacity_extra_bits": 0.0, "demand_capped_extra_bits": 0.0},
        "baseline_non_attainers": {"user_anchor_count": 0, "capacity_extra_bits": 0.0, "demand_capped_extra_bits": 0.0},
    }
    for anchor in result["anchors"]:
        declared_rows = {row["user_id"]: row for row in anchor["declared"]["records"]["per_user_endpoint"]}
        found_rows = {row["user_id"]: row for row in anchor["best_found"]["records"]["per_user_endpoint"]}
        if declared_rows.keys() != found_rows.keys():
            raise RuntimeError("declared and best-found user records differ")
        for user_id, declared_row in declared_rows.items():
            found_row = found_rows[user_id]
            group = "baseline_attainers" if declared_row["rate_target_attained"] else "baseline_non_attainers"
            split[group]["user_anchor_count"] += 1
            split[group]["capacity_extra_bits"] += (
                found_row["delivered_bits_over_endpoint"] - declared_row["delivered_bits_over_endpoint"]
            )
            split[group]["demand_capped_extra_bits"] += (
                min(found_row["delivered_bits_over_endpoint"], demand_bits)
                - min(declared_row["delivered_bits_over_endpoint"], demand_bits)
            )
    if split["baseline_non_attainers"]["user_anchor_count"] != 58:
        raise RuntimeError("baseline non-attainer cohort is not the expected 58 user-anchors")
    total_extra = sum(group["capacity_extra_bits"] for group in split.values())
    expected_extra = (
        pooled_accounting["CAPACITY"]["best_found_credited_bits"]
        - pooled_accounting["CAPACITY"]["declared_credited_bits"]
    )
    if not math.isclose(total_extra, expected_extra, rel_tol=2e-15):
        raise RuntimeError("cohort split does not reconcile with pooled capacity increment")
    result["extra_bits_split_by_declared_attainment"] = split
    result["accounting_definitions"] = {
        "endpoint_duration_s": float(47 * prior.D2_MEASUREMENT_STEP_S),
        "per_user_contracted_demand_bits": demand_bits,
        "CAPACITY": "sum of delivered ACM-capacity bits after boundary/subslot integration",
        "DEMAND_CAPPED": (
            "sum over user-anchors of min(integrated delivered bits, "
            "RATE_TARGET_BPS * endpoint_duration_s); cap is applied after per-user endpoint "
            "integration and before pooling"
        ),
        "ATTAINMENT_ONLY": (
            "sum of integrated delivered ACM-capacity bits only for user-anchors whose "
            "integrated delivery attains RATE_TARGET_BPS * endpoint_duration_s"
        ),
    }
    manifest = [
        {
            "anchor_id": anchor["anchor_id"],
            "declared_records_sha256": anchor["declared"]["records_sha256"],
            "best_found_records_sha256": anchor["best_found"]["records_sha256"],
        }
        for anchor in result["anchors"]
    ]
    result["records_digest_manifest"] = manifest
    result["records_manifest_sha256"] = sha256_json(manifest)
    result["provenance"] = {
        "prior_script_path": str(PRIOR_SCRIPT),
        "prior_script_sha256": hashlib.sha256(PRIOR_SCRIPT.read_bytes()).hexdigest(),
        "prior_result_path": str(PRIOR_RESULT),
        "prior_result_sha256": hashlib.sha256(PRIOR_RESULT.read_bytes()).hexdigest(),
        "recording_change": "instrumentation and rescoring only; prior search functions executed unchanged",
    }


def main() -> int:
    prior = load_prior()
    prior.OUTPUT_PATH = OUTPUT_PATH
    install_recording(prior)
    with contextlib.redirect_stdout(io.StringIO()):
        return_code = prior.main()
    if return_code != 0:
        return return_code
    result = json.loads(OUTPUT_PATH.read_text(encoding="ascii"))
    add_rescoring(prior, result)
    OUTPUT_PATH.write_text(
        json.dumps(result, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n",
        encoding="ascii",
    )
    compact = {
        "pooled_accounting": result["pooled"]["accounting"],
        "extra_bits_split_by_declared_attainment": result["extra_bits_split_by_declared_attainment"],
        "records_manifest_sha256": result["records_manifest_sha256"],
        "wall_seconds": result["wall_seconds"],
    }
    print(json.dumps(compact, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

