+    def recorded_build_slots(arrays, mapping):
+        slots, users = original_build_slots(arrays, mapping)
+        by_boundary: dict[int, list[dict[str, object]]] = {}
+        for slot in slots:
+            by_boundary.setdefault(int(slot["boundary"]), []).append(slot)
+            identities = [mapping[int(user)] for user in slot["users"]]
+            if any(identity is None for identity in identities):
+                raise RuntimeError("active user has no fixed beam identity")
+            if len(set(identities)) != len(identities):
+                raise RuntimeError("rational subslot has more than one user on an active beam")
+            slot["_beam_identities"] = identities
