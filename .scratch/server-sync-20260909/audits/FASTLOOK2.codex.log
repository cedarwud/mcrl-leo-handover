+        declared_bits = math.fsum(
+            anchor["declared"]["accounting"][numerator]["credited_bits"]
+            for anchor in result["anchors"]
+        )
+        found_bits = math.fsum(
+            anchor["best_found"]["accounting"][numerator]["credited_bits"]
+            for anchor in result["anchors"]
