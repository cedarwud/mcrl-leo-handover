index 0000000000000000000000000000000000000000..0209055a0916ef9c224f077969d02214f249db0b
--- /dev/null
+++ b/harness/anytime_report.py
@@ -0,0 +1,238 @@
+"""Render the anytime unilateral receipts as the requested Markdown report."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ANYTIME = {
+    "SEALED": ROOT / "receipts/anytime-sealed-full20.json",
+    "MARGIN_Q": ROOT / "receipts/anytime-margin-q-full20.json",
+}
+BEST = {
+    "SEALED": ROOT / "receipts/anytime-best-timing-sealed.json",
+    "MARGIN_Q": ROOT / "receipts/anytime-best-timing-margin-q.json",
+}
+TIMES = ("1", "2", "5", "10", "20", "30.08", "45", "60", "convergence")
+
+
+def pct(value) -> str:
+    return "n/a" if value is None else f"{100 * float(value):.2f}%"
+
+
+def num(value, digits=2) -> str:
+    return "n/a" if value is None else f"{float(value):.{digits}f}"
+
+
+def aid(value: str) -> str:
+    return value.replace("V025_PROBE_R2/world/", "w").replace(":step/", "/s")
+
+
+def dist_cells(d: dict) -> str:
+    return " / ".join(num(d[key]) for key in ("min", "q25", "median", "q75", "max", "mean"))
+
+
+def render() -> str:
+    data = {key: json.loads(path.read_text(encoding="ascii")) for key, path in ANYTIME.items()}
+    best = {key: json.loads(path.read_text(encoding="ascii")) for key, path in BEST.items()}
+    for name in data:
+        assert data[name]["complete"] and len(data[name]["anchors"]) == 20
+        assert best[name]["complete"] and len(best[name]["anchors"]) == 20
+        assert best[name]["summary"]["matches_archived_assignment_count"] == 20
+
+    lines = []
+    add = lines.append
+    ss = data["SEALED"]["summary"]
+    ms = data["MARGIN_Q"]["summary"]
+    add(
+        f"At 30.08 seconds, **{pct(ss['deadline_prize_fraction'])}** of the converged "
+        f"first-improvement unilateral gain is available under `SEALED` and "
+        f"**{pct(ms['deadline_prize_fraction'])}** under `MARGIN_Q` "
+        f"(against the archived best-improvement endpoints: "
+        f"**{pct(ss['deadline_prize_fraction_vs_archived_best_improvement'])}** and "
+        f"**{pct(ms['deadline_prize_fraction_vs_archived_best_improvement'])}**)."
+    )
+    add("")
+    add("# Anytime unilateral search — V0.25 twenty-anchor panel")
+    add("")
+    add("`DIAGNOSTIC_NOT_CLAIM`. No learner, training run, or policy run was performed. No sealed constant, threshold, sign, seed, horizon, price, service guard, acceptance rule, sealed artifact, or frozen manifest was changed.")
+    add("")
+    add("## Decision")
+    add("")
+    add("Most of the prize is available before the deadline under both provisioning rules. By 20 seconds the first-improvement search has already obtained 69.51% (`SEALED`) and 77.03% (`MARGIN_Q`) of its eventual pooled gain; by 30.08 seconds those fractions are 81.74% and 87.85%. Therefore the proposed argument—*the converged exact search misses the interval, so a learned method may claim the within-interval win*—fails on this panel. A learned method would need to beat the actual anytime incumbent at the same wall-clock budget, not the legal base configuration or a convergence certificate time.")
+    add("")
+    add("First-improvement changed the local-search path and the fixed point on all 20 anchors under both rules. Its converged pooled EE is 8.13% above the archived best-improvement endpoint under `SEALED` and 1.62% above it under `MARGIN_Q`. Accordingly, every prize fraction below is shown against both endpoints where relevant.")
+    add("")
+    add("## Method and timing contract")
+    add("")
+    add("The legal nearest-eligible base assignment is the incumbent from time zero. Users and their legal options retain sealed deterministic order. Alternatives are evaluated in ordered microbatches of 16 using one persistent `StepEvaluator`; when a batch returns, the first strict `F = B - eta_ref E` improvement satisfying the unchanged baseline served-count guard is committed immediately and later alternatives for that user are not evaluated. Thus a checkpoint receives only a move whose evaluation completed by that timestamp, never a candidate credited with hindsight. The microbatch is the sealed dense evaluator's native vectorized path; scalar calls were piloted and rejected as an implementation defect after taking 176.84 seconds on the first anchor.")
+    add("")
+    add("The stopwatch starts before base construction and `_legal_options`; it includes all configuration/candidate construction, physical selection evaluation, and cache misses. The immutable exogenous world tape is the input to a decision and was loaded once per world from the standing content-addressed cache; its load times remain in each receipt. The 48-boundary committed evaluation is run only after timing to measure the true action endpoint and cannot affect the search path. The final complete no-move sweep is executed only as a separate certification probe; its evaluations are excluded from the anytime and joint caches.")
+    add("")
+    add("Runs used one process via `nice -n 15` on an Intel Core Ultra 7 265KF (20 logical CPUs, one thread per core). `OMP_NUM_THREADS`, `OPENBLAS_NUM_THREADS`, `MKL_NUM_THREADS`, and `NUMEXPR_NUM_THREADS` were all pinned to 1. The interpreter was `/home/sat/mcrl-leo-handover/.venv/bin/python`; `PYTHONPATH=src`. The runtime reported no active native threadpool. The sealed manifest is `d5e94654510225aaf6ca7f8422ecd12ba64e8f3b8690c55a55d791063db8b916`; the anytime implementation SHA-256 is `003bdee1df908fddf652f2f8069c31a6297a7f7178bbb83338d09b3f4add9928`.")
+
+    add("")
+    add("## D1 — Anytime quality curve")
+    for name, payload in data.items():
+        s = payload["summary"]
+        base = s["baseline_pooled"]
+        add("")
+        add(f"### `{name}` pooled curve")
+        add("")
+        add("| time (s) | bits (Tbit) | joules | EE (Mbit/J) | gain over base | prize vs first-impr. | prize vs archived |")
+        add("|---:|---:|---:|---:|---:|---:|---:|")
+        add(f"| 0/base | {base['bits']/1e12:.6f} | {base['joules']:.3f} | {base['ee_bit_per_j']/1e6:.6f} | 0.00% | 0.00% | 0.00% |")
+        conv = s["anytime_curve"]["convergence"]["pooled_gain_over_baseline"]
+        archived = s["archived_best_improvement_gain_over_baseline"]
+        for key in TIMES:
+            row = s["anytime_curve"][key]
+            p = row["pooled"]
+            label = "convergence" if key == "convergence" else key
+            add(f"| {label} | {p['bits']/1e12:.6f} | {p['joules']:.3f} | {p['ee_bit_per_j']/1e6:.6f} | {pct(row['pooled_gain_over_baseline'])} | {pct(row['pooled_gain_over_baseline']/conv)} | {pct(row['pooled_gain_over_baseline']/archived)} |")
+
+        add("")
+        add("Paired anchor-local true-EE gain over each anchor's base:")
+        add("")
+        add("| time (s) | min | q25 | median | q75 | max | mean |")
+        add("|---:|---:|---:|---:|---:|---:|---:|")
+        for key in TIMES:
+            d = s["anytime_curve"][key]["paired_anchor_gain_over_baseline_distribution"]
+            add("| " + ("convergence" if key == "convergence" else key) + " | " + " | ".join(pct(d[x]) for x in ("min", "q25", "median", "q75", "max", "mean")) + " |")
+
+        add("")
+        add("Per-anchor committed EE (Mbit/J); each cell is the true 48-boundary endpoint of the configuration actually held at that time:")
+        add("")
+        add("| anchor | base | 1 | 2 | 5 | 10 | 20 | 30.08 | 45 | 60 | convergence |")
+        add("|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|")
+        for row in payload["anchors"]:
+            vals = [row["baseline"]["ee_bit_per_j"] / 1e6] + [row["checkpoints"][k]["ee_bit_per_j"] / 1e6 for k in TIMES]
+            add("| " + aid(row["anchor_id"]) + " | " + " | ".join(f"{v:.4f}" for v in vals) + " |")
+
+    add("")
+    add("## D2 — Fraction of the prize at 30.08 seconds")
+    add("")
+    add("The pooled fraction is `(EE_30.08 - EE_base) / (EE_converged - EE_base)`, with EE pooled as summed bits over summed joules. Anchor fractions use the paired anchor-local form.")
+    add("")
+    add("| rule | pooled vs first-impr. | pooled vs archived | anchor spread vs first-impr. (min/q25/median/q75/max/mean) | worst anchor |")
+    add("|---|---:|---:|---|---|")
+    for name, payload in data.items():
+        s = payload["summary"]; d = s["deadline_prize_fraction_distribution"]; w = s["worst_anchor_at_deadline"]
+        add(f"| `{name}` | {pct(s['deadline_prize_fraction'])} | {pct(s['deadline_prize_fraction_vs_archived_best_improvement'])} | {' / '.join(pct(d[k]) for k in ('min','q25','median','q75','max','mean'))} | {aid(w['anchor_id'])}: {pct(w['fraction'])} |")
+    add("")
+    add("Per-anchor fractions (first-improvement endpoint / archived best-improvement endpoint):")
+    add("")
+    add("| anchor | SEALED | MARGIN_Q |")
+    add("|---|---:|---:|")
+    maps = {}
+    for name, payload in data.items():
+        first = {aid(r["anchor_id"]): r["fraction"] for r in payload["summary"]["deadline_prize_fraction_per_anchor"]}
+        old = {aid(r["anchor_id"]): r["fraction"] for r in payload["summary"]["deadline_prize_fraction_vs_archived_per_anchor"]}
+        maps[name] = {k: (first[k], old[k]) for k in first}
+    for anchor in maps["SEALED"]:
