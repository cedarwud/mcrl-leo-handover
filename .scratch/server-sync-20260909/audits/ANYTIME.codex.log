diff --git a/harness/anytime.py b/harness/anytime.py
new file mode 100644
index 0000000000000000000000000000000000000000..9d0b8e8c181b470e06dc11d3d2cc39fc11e44e2e
--- /dev/null
+++ b/harness/anytime.py
@@ -0,0 +1,922 @@
+"""Anytime instrumentation for the sealed unilateral and bounded joint search.
+
+The physics and all decision rules come from the verified archived runner.  This
+module changes only search scheduling: unilateral alternatives are inspected in
+deterministic order and the first strict improvement is committed immediately.
+The terminal no-move pass is timed separately and its cache entries are never
+made available to the deadline-limited experiments.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import statistics
+import subprocess
+import time
+from typing import Mapping, Sequence
+
+from harness import panel as panel_module
+from harness import sealed as sealed_module
+from harness.cache import HarnessCache
+from harness.runner import install_variant
+
+
+SCHEMA = "mcrl-v025-anytime-unilateral-v1"
+CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
+CHECKPOINTS = (1.0, 2.0, 5.0, 10.0, 20.0, 30.08, 45.0, 60.0)
+JOINT_SEED_SECONDS = (10.0, 20.0, 30.08)
+DEADLINE_SECONDS = 30.08
+# The sealed evaluator's native operation is a dense catalogue.  Ordered
+# microbatches retain first-improvement semantics (the first improving row in
+# the batch wins) without paying one NumPy catalogue setup per alternative.
+UNILATERAL_BATCH_SIZE = 16
+JOINT_BATCH_SIZE = 32
+REPO = Path(__file__).resolve().parents[1]
+REFERENCE_RECEIPTS = {
+    "SEALED": REPO / "receipts/sealed-full20-warm.json",
+    "MARGIN_Q": REPO / "receipts/margin-q-full20.json",
+}
+
+
+def _git(*args: str) -> str:
+    try:
+        return subprocess.check_output(
+            ["git", *args], cwd=REPO, text=True, encoding="utf-8"
+        ).strip()
+    except (OSError, subprocess.CalledProcessError):
+        return "UNAVAILABLE"
+
+
+def _quantile(values: Sequence[float], q: float) -> float | None:
+    if not values:
+        return None
+    ordered = sorted(float(value) for value in values)
+    position = (len(ordered) - 1) * q
+    lower = math.floor(position)
+    upper = math.ceil(position)
+    if lower == upper:
+        return ordered[lower]
+    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)
+
+
+def distribution(values: Sequence[float]) -> dict[str, float | int | None]:
+    rows = [float(value) for value in values]
+    return {
+        "count": len(rows),
+        "min": min(rows) if rows else None,
+        "q25": _quantile(rows, 0.25),
+        "median": statistics.median(rows) if rows else None,
+        "q75": _quantile(rows, 0.75),
+        "max": max(rows) if rows else None,
+        "mean": statistics.fmean(rows) if rows else None,
+    }
+
+
+def _config_payload(config) -> dict[str, object]:
+    return {
+        "configuration_id": config.configuration_id,
+        "assignments": list(config.assignments),
+    }
+
+
+def _metric_payload(reference, profile) -> dict[str, object]:
+    return {
+        **_config_payload(profile.config),
+        "bits": float(profile.bits),
+        "joules": float(profile.joules),
+        "ee_bit_per_j": reference.ratio(profile.bits, profile.joules),
+        "served_count": reference.served(profile),
+    }
+
+
+@dataclass
+class TimedEvaluator:
+    """One persistent StepEvaluator plus completion timestamps for cache entries."""
+
+    reference: object
+    evaluator: object
+    started: float
+    completed_at: dict[str, float]
+
+    @classmethod
+    def create(cls, reference, tape, step_index: int, base, started: float):
+        evaluator = reference.probe.StepEvaluator(
+            tape,
+            reference.probe._setting("a-r0"),
+            step_index,
+            transition_from=base,
+            field="realised",
+            run_setting=reference.probe.run_setting_for("a-r0"),
+            boundary_indices=(0,),
+            fading_quantile_alpha=0.10,
+        )
+        return cls(reference, evaluator, started, {})
+
+    def elapsed(self) -> float:
+        return time.perf_counter() - self.started
+
+    def evaluate_many(self, configs: Sequence[object]) -> None:
+        missing = [
+            row
+            for row in configs
+            if row.configuration_id not in self.evaluator._evaluated
+            and row.configuration_id not in self.evaluator._invalid
+        ]
+        if not missing:
+            return
+        self.evaluator.evaluate_many(tuple(missing))
+        finished = self.elapsed()
+        for row in missing:
+            self.completed_at.setdefault(row.configuration_id, finished)
+
+    def profile(self, config):
+        self.evaluate_many((config,))
+        return self.evaluator._evaluated.get(config.configuration_id)
+
+    def preload(self, profiles: Mapping[str, object], invalid: Sequence[str] = ()) -> None:
+        self.evaluator._evaluated.update(profiles)
+        self.evaluator._invalid.update(invalid)
+
+
+@dataclass
+class UnilateralRun:
+    base: object
+    selected: object
+    moves: list[tuple[float, object]]
+    receipt: dict[str, object]
+    finding_profiles: dict[str, object]
+    finding_invalid: set[str]
+    finding_completed_at: dict[str, float]
+
+
+def _candidate(reference, base, current, user: int, identity, kind: str):
+    mapping = dict(current.mapping)
+    mapping[user] = identity
+    return reference._configuration(base, mapping, kind)
+
+
+def first_improvement_unilateral(reference, tape, step_index: int) -> UnilateralRun:
+    """Run first-improvement; isolate the final no-move pass as certification."""
+
+    started = time.perf_counter()
+    base = reference.probe._base_configuration(tape, step_index, "nearest-eligible")
+    current = base
+    moves: list[tuple[float, object]] = [(0.0, base)]
+    options, census = reference.probe._legal_options(tape, step_index)
+    timed = TimedEvaluator.create(reference, tape, step_index, base, started)
+    base_profile = timed.profile(base)
+    if base_profile is None:
+        raise RuntimeError("legal base configuration was invalid")
+    guard = reference.served(base_profile)
+    passes_with_moves = 0
+    accepted_moves = 0
+    candidate_comparisons = 0
+    physically_submitted = 0
+    pass_rows: list[dict[str, object]] = []
+
+    while True:
+        pass_started = timed.elapsed()
+        # This snapshot is the cache an implementation omitting the terminal
+        # certificate actually owns.  It is deliberately taken before the pass.
+        profiles_before_pass = dict(timed.evaluator._evaluated)
+        invalid_before_pass = set(timed.evaluator._invalid)
+        completed_before_pass = dict(timed.completed_at)
+        physical_before_pass = timed.evaluator.physical_evaluations
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = timed.profile(current)
+            if current_profile is None:
+                raise RuntimeError("accepted incumbent disappeared from cache")
+            current_value = reference.objective(current_profile)
+            identities = [
+                identity for identity in options[user] if identity != current.mapping[user]
+            ]
+            for offset in range(0, len(identities), UNILATERAL_BATCH_SIZE):
+                batch = tuple(
+                    _candidate(
+                        reference,
+                        base,
+                        current,
+                        user,
+                        identity,
+                        "anytime-unilateral-first-improvement",
+                    )
+                    for identity in identities[offset : offset + UNILATERAL_BATCH_SIZE]
+                )
+                timed.evaluate_many(batch)
+                physically_submitted += len(batch)
+                accepted = None
+                for candidate in batch:
+                    candidate_comparisons += 1
+                    profile = timed.evaluator._evaluated.get(candidate.configuration_id)
+                    if profile is None or reference.served(profile) < guard:
+                        continue
+                    if reference.objective(profile) > current_value:
+                        accepted = candidate
+                        break
+                if accepted is not None:
+                    current = accepted
+                    accepted_moves += 1
+                    moves_this_pass += 1
+                    moves.append((timed.elapsed(), current))
+                    break
+        pass_finished = timed.elapsed()
+        if moves_this_pass == 0:
+            finding_seconds = pass_started
+            certification_seconds = pass_finished - pass_started
+            finding_profiles = profiles_before_pass
+            finding_invalid = invalid_before_pass
+            finding_completed_at = completed_before_pass
+            terminal_evaluations = timed.evaluator.physical_evaluations - physical_before_pass
+            break
+        passes_with_moves += 1
+        pass_rows.append(
+            {
+                "pass": passes_with_moves,
+                "started_seconds": pass_started,
+                "finished_seconds": pass_finished,
+                "accepted_moves": moves_this_pass,
+            }
+        )
+
+    receipt = {
+        "algorithm": "deterministic cyclic first-improvement",
+        "candidate_order": "users sorted; each user's sealed legal options in sealed order",
+        "microbatch_size": UNILATERAL_BATCH_SIZE,
+        "baseline_served_guard": guard,
+        "legal_option_census": census,
+        "accepted_moves": accepted_moves,
+        "passes_with_moves": passes_with_moves,
+        "candidate_comparisons_through_certificate": candidate_comparisons,
+        "physically_submitted_candidates_through_certificate": physically_submitted,
+        "finding_physical_evaluations": physical_before_pass,
+        "terminal_certificate_physical_evaluations": terminal_evaluations,
+        "last_improvement_seconds": moves[-1][0],
+        "finding_seconds": finding_seconds,
+        "terminal_certificate_seconds": certification_seconds,
+        "measured_total_including_certificate_seconds": pass_finished,
+        "terminal_certificate_excluded_from_anytime": True,
+        "passes": pass_rows,
+        "move_times_seconds": [row[0] for row in moves[1:]],
+        "selected": _config_payload(current),
+    }
+    return UnilateralRun(
+        base,
+        current,
+        moves,
+        receipt,
+        finding_profiles,
+        finding_invalid,
+        finding_completed_at,
+    )
+
+
+def config_at(run: UnilateralRun, seconds: float):
+    selected = run.base
+    for accepted_at, config in run.moves:
+        if accepted_at > seconds:
+            break
+        selected = config
+    return selected
+
+
+def _best_alternatives_with_budget(
+    reference,
+    tape,
+    step_index: int,
+    base,
+    seed,
+    timed: TimedEvaluator,
+    allowance: float,
+):
+    options, _ = reference.probe._legal_options(tape, step_index)
+    best_alternatives: dict[int, tuple[int, int]] = {}
+    comparisons = 0
+    for user in sorted(options):
+        candidates = tuple(
+            _candidate(reference, base, seed, user, identity, "joint-seed-alternate")
+            for identity in options[user]
+            if identity != seed.mapping[user]
+        )
+        # Per-user batching matches the archived construction of a physically
+        # best alternate, while allowing a budget check between users.
+        if timed.elapsed() >= allowance:
+            return None, comparisons, "alternate-sweep-budget"
+        timed.evaluate_many(candidates)
+        if timed.elapsed() > allowance:
+            return None, comparisons, "alternate-sweep-budget"
+        rows = []
+        for candidate in candidates:
+            comparisons += 1
+            profile = timed.evaluator._evaluated.get(candidate.configuration_id)
+            if profile is not None:
+                rows.append(
+                    (
+                        reference.objective(profile),
+                        candidate.configuration_id,
+                        candidate.mapping[user],
+                    )
+                )
+        if rows:
+            best_alternatives[user] = min(rows, key=lambda row: (-row[0], row[1]))[2]
+    return best_alternatives, comparisons, None
+
+
+def deadline_joint_search(
+    reference,
+    tape,
+    step_index: int,
+    run: UnilateralRun,
+    seed_seconds: float,
+) -> tuple[object, dict[str, object]]:
+    """Use only the time remaining to 30.08 s after obtaining a timed seed."""
+
+    seed = config_at(run, seed_seconds)
+    allowance = max(0.0, DEADLINE_SECONDS - seed_seconds)
+    if allowance == 0.0:
+        return seed, {
+            "seed_seconds": seed_seconds,
+            "joint_allowance_seconds": 0.0,
+            "joint_wall_seconds": 0.0,
+            "total_end_to_end_seconds": seed_seconds,
+            "stopped_phase": "no-budget-after-seed",
+            "catalogue_complete": False,
+            "catalogue_unique": 0,
+            "joint_candidates_completed": 0,
+            "joint_improvements_accepted": 0,
+            "selected": _config_payload(seed),
+        }
+
+    started = time.perf_counter()
+    timed = TimedEvaluator.create(reference, tape, step_index, run.base, started)
+    available_profiles = {
+        key: profile
+        for key, profile in run.finding_profiles.items()
+        if run.finding_completed_at.get(key, math.inf) <= seed_seconds
+    }
+    available_invalid = {
+        key
+        for key in run.finding_invalid
+        if run.finding_completed_at.get(key, math.inf) <= seed_seconds
+    }
+    timed.preload(available_profiles, tuple(available_invalid))
+    seed_profile = timed.evaluator._evaluated.get(seed.configuration_id)
+    if seed_profile is None:
+        seed_profile = timed.profile(seed)
+    base_profile = timed.evaluator._evaluated.get(run.base.configuration_id)
+    if base_profile is None:
+        base_profile = timed.profile(run.base)
+    if seed_profile is None or base_profile is None:
+        raise RuntimeError("joint search seed or base is invalid")
+    guard = reference.served(base_profile)
+    best = seed
+    best_profile = seed_profile
+
+    alternatives, alternate_comparisons, stopped = _best_alternatives_with_budget(
+        reference, tape, step_index, run.base, seed, timed, allowance
+    )
+    candidates: tuple[object, ...] = ()
+    aliases = {}
+    family_counts = {}
+    completed = 0
+    improvements = 0
+    catalogue_complete = False
+    crossed_budget_by = 0.0
+
+    if alternatives is not None:
+        candidates, aliases, family_counts = reference.build_joint_candidates(
+            tape=tape,
+            step_index=step_index,
+            base=run.base,
+            unilateral=seed,
+            best_alternatives=alternatives,
+        )
+        catalogue_complete = True
+        if timed.elapsed() > allowance:
+            stopped = "catalogue-construction-budget"
+        else:
+            stopped = "catalogue-exhausted"
+            for offset in range(0, len(candidates), JOINT_BATCH_SIZE):
+                if timed.elapsed() >= allowance:
+                    stopped = "joint-evaluation-budget"
+                    break
+                batch = candidates[offset : offset + JOINT_BATCH_SIZE]
+                timed.evaluate_many(batch)
+                elapsed = timed.elapsed()
+                if elapsed > allowance:
+                    crossed_budget_by = elapsed - allowance
+                    stopped = "joint-evaluation-budget"
+                    break
+                completed += len(batch)
+                for candidate in batch:
+                    profile = timed.evaluator._evaluated.get(candidate.configuration_id)
+                    if profile is None or reference.served(profile) < guard:
+                        continue
+                    value = reference.objective(profile)
+                    best_value = reference.objective(best_profile)
+                    if value > best_value or (
+                        value == best_value
+                        and best is not seed
+                        and candidate.configuration_id < best.configuration_id
+                    ):
+                        best = candidate
+                        best_profile = profile
+                        improvements += 1
+
+    elapsed = timed.elapsed()
+    available_at = (
+        seed_seconds + elapsed
+        if stopped == "catalogue-exhausted"
+        else DEADLINE_SECONDS
+    )
+    return best, {
+        "seed_seconds": seed_seconds,
+        "joint_allowance_seconds": allowance,
+        "unilateral_cache_profiles_available": len(available_profiles),
+        "unilateral_cache_invalid_available": len(available_invalid),
+        "alternate_comparisons": alternate_comparisons,
+        "joint_wall_seconds": elapsed,
+        "budget_crossing_overshoot_seconds": crossed_budget_by,
+        "total_end_to_end_seconds": available_at,
+        "stopped_phase": stopped,
+        "catalogue_complete": catalogue_complete,
+        "catalogue_unique": len(candidates),
+        "catalogue_aliases": sum(len(rows) for rows in aliases.values()),
+        "family_unique_counts": family_counts,
+        "joint_microbatch_size": JOINT_BATCH_SIZE,
+        "joint_candidates_completed": completed,
+        "joint_improvements_accepted": improvements,
+        "selected": _config_payload(best),
+    }
+
+
+def _committed_profiles(reference, tape, step_index: int, base, configs):
+    evaluator = reference.probe.StepEvaluator(
+        tape,
+        reference.probe._setting("a-r0"),
+        step_index,
+        transition_from=base,
+        field="realised",
+        run_setting=reference.probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=0.10,
+    )
+    unique = {row.configuration_id: row for row in configs}
+    evaluator.evaluate_many(tuple(unique.values()))
+    return {
+        key: evaluator._evaluated[value.configuration_id]
+        for key, value in unique.items()
+        if value.configuration_id in evaluator._evaluated
+    }
+
+
+def measure_anchor(reference, tape, world_index: int, step_index: int, archived) -> dict:
+    run = first_improvement_unilateral(reference, tape, step_index)
+    checkpoint_configs = {
+        f"{seconds:g}": config_at(run, seconds) for seconds in CHECKPOINTS
+    }
+    checkpoint_configs["convergence"] = run.selected
+    joint_configs = {}
+    joint_rows = {}
+    for seconds in JOINT_SEED_SECONDS:
+        key = f"{seconds:g}"
+        joint_configs[key], joint_rows[key] = deadline_joint_search(
+            reference, tape, step_index, run, seconds
+        )
+
+    all_configs = [run.base, *checkpoint_configs.values(), *joint_configs.values()]
+    committed = _committed_profiles(
+        reference, tape, step_index, run.base, all_configs
+    )
+
+    def metric(config):
+        try:
+            return _metric_payload(reference, committed[config.configuration_id])
+        except KeyError:
+            raise RuntimeError(
+                f"committed configuration invalid: {config.configuration_id}"
+            ) from None
+
+    base_metric = metric(run.base)
+    checkpoints = {key: metric(config) for key, config in checkpoint_configs.items()}
+    for key, config in joint_configs.items():
+        joint_rows[key]["committed"] = metric(config)
+
+    archived_unilateral = archived["committed"]["UNILATERAL"]
+    return {
+        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
+        "world_index": world_index,
+        "step_index": step_index,
+        "world_domain": tape.domain,
+        "world_sha256": tape.digest,
+        "baseline": base_metric,
+        "unilateral": run.receipt,
+        "checkpoints": checkpoints,
+        "joint_within_30_08": joint_rows,
+        "first_improvement_fixed_point_matches_archived_best_improvement": (
+            checkpoints["convergence"]["assignments"]
+            == archived_unilateral["assignments"]
+        ),
+        "archived_best_improvement": archived_unilateral,
+    }
+
+
+def _pool_metrics(rows: Sequence[Mapping[str, object]], accessor) -> dict[str, object]:
+    metrics = [accessor(row) for row in rows]
+    bits = math.fsum(float(row["bits"]) for row in metrics)
+    joules = math.fsum(float(row["joules"]) for row in metrics)
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_bit_per_j": bits / joules,
+        "served_count_sum": sum(int(row["served_count"]) for row in metrics),
+    }
+
+
+def _gain(numerator: float, denominator: float) -> float:
+    return numerator / denominator - 1.0
+
+
+def summarize(rows: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    baseline = _pool_metrics(rows, lambda row: row["baseline"])
+    archived_convergence = _pool_metrics(
+        rows, lambda row: row["archived_best_improvement"]
+    )
+    curve = {}
+    for key in (*[f"{value:g}" for value in CHECKPOINTS], "convergence"):
+        pooled = _pool_metrics(rows, lambda row, key=key: row["checkpoints"][key])
+        per_anchor_gain = [
+            _gain(
+                float(row["checkpoints"][key]["ee_bit_per_j"]),
+                float(row["baseline"]["ee_bit_per_j"]),
+            )
+            for row in rows
+        ]
+        curve[key] = {
+            "pooled": pooled,
+            "pooled_gain_over_baseline": _gain(
+                float(pooled["ee_bit_per_j"]), float(baseline["ee_bit_per_j"])
+            ),
+            "paired_anchor_gain_over_baseline_distribution": distribution(per_anchor_gain),
+            "per_anchor_gain_over_baseline": [
+                {"anchor_id": row["anchor_id"], "gain": value}
+                for row, value in zip(rows, per_anchor_gain)
+            ],
+        }
+
+    deadline_gain = float(curve["30.08"]["pooled_gain_over_baseline"])
+    converged_gain = float(curve["convergence"]["pooled_gain_over_baseline"])
+    archived_converged_gain = _gain(
+        float(archived_convergence["ee_bit_per_j"]),
+        float(baseline["ee_bit_per_j"]),
+    )
+    anchor_fractions = []
+    archived_anchor_fractions = []
+    for row in rows:
+        base_ee = float(row["baseline"]["ee_bit_per_j"])
+        deadline_ee = float(row["checkpoints"]["30.08"]["ee_bit_per_j"])
+        converged_ee = float(row["checkpoints"]["convergence"]["ee_bit_per_j"])
+        denominator = converged_ee - base_ee
+        fraction = None if denominator == 0.0 else (deadline_ee - base_ee) / denominator
+        anchor_fractions.append({"anchor_id": row["anchor_id"], "fraction": fraction})
+        archived_ee = float(row["archived_best_improvement"]["ee_bit_per_j"])
+        archived_denominator = archived_ee - base_ee
+        archived_fraction = (
+            None
+            if archived_denominator == 0.0
+            else (deadline_ee - base_ee) / archived_denominator
+        )
+        archived_anchor_fractions.append(
+            {"anchor_id": row["anchor_id"], "fraction": archived_fraction}
+        )
+    defined_fractions = [
+        float(row["fraction"]) for row in anchor_fractions if row["fraction"] is not None
+    ]
+    defined_archived_fractions = [
+        float(row["fraction"])
+        for row in archived_anchor_fractions
+        if row["fraction"] is not None
+    ]
+
+    certification = {
+        "finding_seconds": distribution(
+            [float(row["unilateral"]["finding_seconds"]) for row in rows]
+        ),
+        "last_improvement_seconds": distribution(
+            [float(row["unilateral"]["last_improvement_seconds"]) for row in rows]
+        ),
+        "terminal_certificate_seconds": distribution(
+            [float(row["unilateral"]["terminal_certificate_seconds"]) for row in rows]
+        ),
+        "total_including_certificate_seconds": distribution(
+            [
+                float(row["unilateral"]["measured_total_including_certificate_seconds"])
+                for row in rows
+            ]
+        ),
+        "per_anchor": [
+            {
+                "anchor_id": row["anchor_id"],
+                "finding_seconds": row["unilateral"]["finding_seconds"],
+                "last_improvement_seconds": row["unilateral"]["last_improvement_seconds"],
+                "terminal_certificate_seconds": row["unilateral"][
+                    "terminal_certificate_seconds"
+                ],
+                "total_including_certificate_seconds": row["unilateral"][
+                    "measured_total_including_certificate_seconds"
+                ],
+            }
+            for row in rows
+        ],
+    }
+
+    joint = {}
+    for seed_key in (f"{value:g}" for value in JOINT_SEED_SECONDS):
+        pooled = _pool_metrics(
+            rows, lambda row, seed_key=seed_key: row["joint_within_30_08"][seed_key]["committed"]
+        )
+        joint[seed_key] = {
+            "pooled": pooled,
+            "pooled_gain_over_baseline": _gain(
+                float(pooled["ee_bit_per_j"]), float(baseline["ee_bit_per_j"])
+            ),
+            "fraction_of_archived_best_improvement_prize": (
+                None
+                if archived_converged_gain == 0.0
+                else _gain(
+                    float(pooled["ee_bit_per_j"]),
+                    float(baseline["ee_bit_per_j"]),
+                )
+                / archived_converged_gain
+            ),
+            "total_end_to_end_seconds_distribution": distribution(
+                [
+                    float(row["joint_within_30_08"][seed_key]["total_end_to_end_seconds"])
+                    for row in rows
+                ]
+            ),
+            "catalogue_completed_anchor_count": sum(
+                row["joint_within_30_08"][seed_key]["stopped_phase"]
+                == "catalogue-exhausted"
+                for row in rows
+            ),
+            "anchors_with_joint_improvement": sum(
+                row["joint_within_30_08"][seed_key]["committed"]["assignments"]
+                != row["checkpoints"][seed_key]["assignments"]
+                for row in rows
+            ),
+            "per_anchor": [
+                {
+                    "anchor_id": row["anchor_id"],
+                    **row["joint_within_30_08"][seed_key],
+                }
+                for row in rows
+            ],
+        }
+
+    return {
+        "anchor_count": len(rows),
+        "baseline_pooled": baseline,
+        "archived_best_improvement_pooled": archived_convergence,
+        "archived_best_improvement_gain_over_baseline": archived_converged_gain,
+        "anytime_curve": curve,
+        "deadline_prize_fraction": (
+            None if converged_gain == 0.0 else deadline_gain / converged_gain
+        ),
+        "deadline_prize_fraction_distribution": distribution(defined_fractions),
+        "deadline_prize_fraction_per_anchor": anchor_fractions,
+        "worst_anchor_at_deadline": (
+            None
+            if not defined_fractions
+            else min(
+                (row for row in anchor_fractions if row["fraction"] is not None),
+                key=lambda row: row["fraction"],
+            )
+        ),
+        "deadline_prize_fraction_vs_archived_best_improvement": (
+            None
+            if archived_converged_gain == 0.0
+            else deadline_gain / archived_converged_gain
+        ),
+        "deadline_prize_fraction_vs_archived_distribution": distribution(
+            defined_archived_fractions
+        ),
+        "deadline_prize_fraction_vs_archived_per_anchor": archived_anchor_fractions,
+        "worst_anchor_vs_archived_at_deadline": (
+            None
+            if not defined_archived_fractions
+            else min(
+                (
+                    row
+                    for row in archived_anchor_fractions
+                    if row["fraction"] is not None
+                ),
+                key=lambda row: row["fraction"],
+            )
+        ),
+        "certification": certification,
+        "joint_within_30_08": joint,
+        "first_improvement_convergence_relative_to_archived_best_improvement": _gain(
+            float(curve["convergence"]["pooled"]["ee_bit_per_j"]),
+            float(archived_convergence["ee_bit_per_j"]),
+        ),
+        "first_improvement_fixed_point_matches_archived_count": sum(
+            bool(row["first_improvement_fixed_point_matches_archived_best_improvement"])
+            for row in rows
+        ),
+    }
+
+
+def _hardware() -> dict[str, object]:
+    model = "UNKNOWN"
+    try:
+        for line in Path("/proc/cpuinfo").read_text(encoding="ascii").splitlines():
+            if line.startswith("model name"):
+                model = line.partition(":")[2].strip()
+                break
+    except OSError:
+        pass
+    threadpools = []
+    try:
+        from threadpoolctl import threadpool_info
+
+        threadpools = threadpool_info()
+    except ImportError:
+        pass
+    return {
+        "platform": platform.platform(),
+        "cpu_model": model,
+        "logical_cpu_count": os.cpu_count(),
+        "processes_used": 1,
+        "thread_environment": {
+            key: os.environ.get(key)
+            for key in (
+                "OMP_NUM_THREADS",
+                "OPENBLAS_NUM_THREADS",
+                "MKL_NUM_THREADS",
+                "NUMEXPR_NUM_THREADS",
+            )
+        },
+        "runtime_threadpools": threadpools,
+    }
+
+
+def _write(payload: dict, output: Path) -> None:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    encoded = json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+    ).encode("ascii")
+    payload["receipt_sha256"] = hashlib.sha256(encoded).hexdigest()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(
+        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+
+
+def run_panel(
+    *,
+    variant_name: str,
+    output: Path,
+    resume: bool = False,
+    progress: bool = True,
+) -> dict:
+    tree = sealed_module.verify()
+    reference = sealed_module.reference_runner()
+    board = panel_module.FULL20
+    variant, _installed, _sealed = install_variant(variant_name)
+    reference_path = REFERENCE_RECEIPTS[variant_name]
+    archived_receipt = json.loads(reference_path.read_text(encoding="ascii"))
+    archived = {row["anchor_id"]: row for row in archived_receipt["anchors"]}
+
+    payload = {
+        "schema": SCHEMA,
+        "claim_ceiling": CLAIM_CEILING,
+        "complete": False,
+        "variant": variant_name,
+        "variant_source": variant.source,
+        "variant_source_sha256": variant.source_sha256,
+        "panel": board.name,
+        "checkpoints_seconds": list(CHECKPOINTS),
+        "deadline_seconds": DEADLINE_SECONDS,
+        "joint_seed_seconds": list(JOINT_SEED_SECONDS),
+        "sealed_manifest_sha256": tree.manifest_sha256,
+        "probe_source_sha256": tree.probe_sha256,
+        "reference_receipt": str(reference_path.relative_to(REPO)),
+        "reference_receipt_sha256": archived_receipt["receipt_sha256"],
+        "source_commit": _git("rev-parse", "HEAD"),
+        "source_tree": _git("rev-parse", "HEAD^{tree}"),
+        "python": platform.python_version(),
+        "python_executable": os.sys.executable,
+        "hardware": _hardware(),
+        "timing_scope": (
+            "Per-anchor stopwatch starts before base and legal-option construction. "
+            "It includes candidate construction, every selection evaluation and cache "
+            "miss. The immutable exogenous world tape is input and its construction is "
+            "reported separately. Untimed 48-boundary evaluation only scores returned actions."
+        ),
+        "unilateral_algorithm": (
+            "Cyclic first-improvement, accepting the first strictly F-improving, "
+            "service-guard-feasible move in sealed option order. Persistent configuration "
+            "evaluation cache. Terminal no-move sweep measured separately and excluded."
+        ),
+        "joint_budget_rule": (
+            "The seed consumes its nominal 10, 20 or 30.08 seconds of the same 30.08-second "
+            "budget. Only unilateral cache entries completed by the seed time are reusable. "
+            "Construction of physically best per-user alternatives and the existing bounded "
+            "joint catalogue consumes the remainder. The returned action is the best feasible "
+            "candidate whose evaluation batch completed by the deadline."
+        ),
+        "anchors": [],
+        "worlds": [],
+    }
+    if resume and output.exists():
+        old = json.loads(output.read_text(encoding="ascii"))
+        for key in (
+            "schema",
+            "variant",
+            "sealed_manifest_sha256",
+            "variant_source_sha256",
+            "checkpoints_seconds",
+        ):
+            if old.get(key) != payload.get(key):
+                raise RuntimeError(f"cannot resume: receipt mismatch in {key}")
+        payload["anchors"] = old["anchors"]
+
+    completed = {row["anchor_id"] for row in payload["anchors"]}
+    cache = HarnessCache(enabled=True)
+    tapes = {}
+    for world_index in board.worlds:
+        domain = reference.probe.PROBE_WORLD_DOMAINS[world_index - 1]
+        key = cache.world_key(
+            sealed_manifest=tree.manifest_sha256,
+            domain=domain,
+            steps=board.tape_steps,
+            start_time_s=0.0,
+            provider="mcrl.physics_v025.provider_legacy.factory",
+        )
+        from mcrl.physics_v025.provider_legacy import factory as real_factory
+
+        tape, meta, elapsed, hit = cache.world(
+            key,
+            lambda domain=domain: reference.probe.build_world_tape(
+                domain=domain,
+                provider=real_factory(),
+                steps=board.tape_steps,
+                start_time_s=0.0,
+            ),
+        )
+        tapes[world_index] = tape
+        payload["worlds"].append(
+            {
+                "world_index": world_index,
+                "world_sha256": tape.digest,
+                "cache_key": key,
+                "cache_hit": hit,
+                "load_or_construction_seconds": elapsed,
+                **meta,
+            }
+        )
+
+    for world_index, step_index in board.anchors:
+        anchor_id = f"V025_PROBE_R2/world/{world_index}:step/{step_index}"
+        if anchor_id in completed:
+            continue
+        if progress:
+            print(json.dumps({"starting_anchor": anchor_id, "variant": variant_name}), flush=True)
+        row = measure_anchor(
+            reference, tapes[world_index], world_index, step_index, archived[anchor_id]
+        )
+        payload["anchors"].append(row)
+        payload["anchors"].sort(key=lambda item: (item["world_index"], item["step_index"]))
+        payload["summary"] = summarize(payload["anchors"])
+        _write(payload, output)
+        if progress:
+            print(
+                json.dumps(
+                    {
+                        "finished_anchor": anchor_id,
+                        "finding_seconds": row["unilateral"]["finding_seconds"],
+                        "certificate_seconds": row["unilateral"]["terminal_certificate_seconds"],
+                        "deadline_gain_over_baseline": (
+                            row["checkpoints"]["30.08"]["ee_bit_per_j"]
+                            / row["baseline"]["ee_bit_per_j"]
+                            - 1.0
+                        ),
+                    },
+                    sort_keys=True,
+                ),
+                flush=True,
+            )
+
+    payload["complete"] = len(payload["anchors"]) == len(board.anchors)
+    payload["summary"] = summarize(payload["anchors"])
+    _write(payload, output)
+    return payload
