def evaluate_anchor(*, tape, world_index: int, step_index: int, pool=None) -> dict[str, object]:
    setting = probe._setting("a-r0")
    run_setting = probe.run_setting_for("a-r0")
    base = probe._base_configuration(tape, step_index, "nearest-eligible")
    selection = ParallelSelectionEvaluator(tape, step_index, base, pool)
    started = time.perf_counter()
    coordinate = coordinate_optimum(
        tape=tape,
        step_index=step_index,
        base=base,
        evaluator=selection,
    )
    unilateral = coordinate.selected
    before_joint_evaluations = selection.physical_evaluations
    candidates, aliases, family_counts = build_joint_candidates(
        tape=tape,
        step_index=step_index,
        base=base,
        unilateral=unilateral,
        best_alternatives=coordinate.best_alternatives,
    )
    selection.evaluate_many(candidates)
    base_profile = selection.evaluate(base)
    unilateral_profile = selection.evaluate(unilateral)
    guard = served(base_profile)
    best = unilateral
    best_profile = unilateral_profile
    for candidate in candidates:
        profile = selection._evaluated.get(candidate.configuration_id)
        if profile is None or served(profile) < guard:
            continue
        value = objective(profile)
        best_value = objective(best_profile)
        if value > best_value or (
            value == best_value
            and best is not unilateral
            and candidate.configuration_id < best.configuration_id
        ):
            best, best_profile = candidate, profile

    coalition_users = tuple(
        user
        for user in sorted(unilateral.mapping)
        if unilateral.mapping[user] != best.mapping[user]
    )
    psi = Fraction()
    singleton_sum = Fraction()
    if coalition_users:
        for user in coalition_users:
            mapping = unilateral.mapping
            mapping[user] = best.mapping[user]
            singleton = _configuration(base, mapping, "oracle-singleton-component")
            singleton_profile = selection.evaluate(singleton)
            singleton_sum += objective(singleton_profile) - objective(unilateral_profile)
        psi = (
            objective(best_profile)
            - objective(unilateral_profile)
            - singleton_sum
        )

    committed_counter = probe.EvaluationCounter()
    committed = probe.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=base,
        field="realised",
        counter=committed_counter,
        run_setting=run_setting,
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    unique = {
        row.configuration_id: row for row in (base, unilateral, best)
    }
    committed.evaluate_many(tuple(unique.values()))

    profiles = {
        "BASELINE": committed.evaluate(base),
        "UNILATERAL": committed.evaluate(unilateral),
        "ORACLE_SET": committed.evaluate(best),
    }
    chosen_aliases = aliases.get(best.assignments, ())
    qualifying = bool(coalition_users) and objective(best_profile) > objective(
        unilateral_profile
    )
    row = {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "world_domain": tape.domain,
        "world_sha256": tape.digest,
        "tle_date": tape.tle_date,
        "training_seed": tape.training_seed,
        "step_index": step_index,
        "selection": {
            "field": "realised",
            "boundary_indices": [0],
            "held_snapshot_seconds": 30.08,
            "eta_ref": frac_payload(ETA_REF),
            "baseline_served_guard": guard,
            "unilateral_iterations": coordinate.iterations,
            "unilateral_passes": coordinate.passes,
            "unilateral_terminal_certified": True,
            "unilateral_candidate_comparisons": coordinate.candidate_comparisons,
            "joint_catalogue_unique": len(candidates),
            "joint_catalogue_aliases": sum(len(value) for value in aliases.values()),
            "joint_family_unique_counts": family_counts,
            "qualifying_coalition_existed": qualifying,
            "selected_coalition_size": len(coalition_users) if qualifying else 0,
            "selected_coalition_users": list(coalition_users) if qualifying else [],
            "selected_candidate_aliases": list(chosen_aliases) if qualifying else [],
            "selected_joint_served": served(best_profile),
            "selected_joint_F_gain_bits": float(
                objective(best_profile) - objective(unilateral_profile)
            ),
            "selected_singleton_sum_bits": float(singleton_sum),
            "selected_Psi_A_bits": float(psi),
            "selected_Psi_A_exact": frac_payload(psi),
            "unique_selection_configuration_evaluations": selection.physical_evaluations,
            "unilateral_unique_evaluations_before_joint": before_joint_evaluations,
            "new_joint_unique_evaluations": (
                selection.physical_evaluations - before_joint_evaluations
            ),
            "selection_physical_boundary_evaluations": selection.physical_evaluations,
        },
        "committed": {
            name: {
                "configuration_id": profile.config.configuration_id,
                "assignments": list(profile.config.assignments),
                "bits": profile.bits,
                "joules": profile.joules,
                "ee_bit_per_j": ratio(profile.bits, profile.joules),
                "served_count": served(profile),
            }
            for name, profile in profiles.items()
        },
        "committed_unique_configuration_evaluations": len(unique),
        "committed_physical_boundary_evaluations": committed_counter.boundary_evaluations,
        "wall_seconds": time.perf_counter() - started,
    }
    row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] = relative_gain(
        row["committed"]["ORACLE_SET"]["ee_bit_per_j"],
        row["committed"]["UNILATERAL"]["ee_bit_per_j"],
    )
    row["committed"]["UNILATERAL"]["relative_ee_gain_over_BASELINE"] = relative_gain(
        row["committed"]["UNILATERAL"]["ee_bit_per_j"],
        row["committed"]["BASELINE"]["ee_bit_per_j"],
    )
    if served(best_profile) < guard:
        raise RuntimeError("ORACLE_SET violated the literal selection-time service guard")
    if objective(best_profile) < objective(unilateral_profile):
        raise RuntimeError("ORACLE_SET is worse than its included UNILATERAL reference")
    return row


def _git(*args: str) -> str:
    return subprocess.check_output(
        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
    ).strip()


def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
    selectors = ("BASELINE", "UNILATERAL", "ORACLE_SET")
    pooled = {}
    for name in selectors:
        bits = math.fsum(float(row["committed"][name]["bits"]) for row in anchors)  # type: ignore[index]
        joules = math.fsum(float(row["committed"][name]["joules"]) for row in anchors)  # type: ignore[index]
"""One command for the whole instrument.

    bin/harness run       --variant SEALED --panel FULL20 --out receipts/x.json
    bin/harness verify-sealed
    bin/harness reproduce
    bin/harness screen    --variant MARGIN_Q
    bin/harness agreement --screen a.json --full b.json
    bin/harness profile
    bin/harness show      receipts/x.json
    bin/harness diff      receipts/a.json receipts/b.json
    bin/harness dist      receipts/x.json --over ORACLE_SET --base UNILATERAL
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

from harness import panel as panel_module
from harness import query as query_module
from harness import report
from harness import variants as variants_module

REPO = Path(__file__).resolve().parents[1]
ARCHIVE_ORIGINAL = REPO / "ladder-archive/original-result.json"
ARCHIVE_MARGIN = REPO / "ladder-archive/margin-result.json"
ARCHIVED_ORACLE_OVER_UNILATERAL = 0.06358999957766232

# H4: the screen promotion rule, declared here before any screen was run.
# It is data, not prose, so it cannot be quietly restated after the fact.
PROMOTION_RULE = {
    "id": "screen-promotion-rule-v1",
    "declared": "2026-09-09",
    "screen_panel": "SCREEN2",
    "full_panel": "FULL20",
    "statement": (
        "A variant is promoted from SCREEN2 to FULL20 if and only if all four "
        "conditions below hold on the SCREEN2 receipt. The rule is a "
        "spend-authorisation rule for compute. It is not evidence about the "
        "variant, it does not rank variants, and a variant that fails it may "
        "still be run on FULL20 by explicit instruction, which must be "
        "recorded as an override in the promotion receipt."
    ),
    "conditions": [
        "C1 the SEALED bit-identity proof passes at the same sealed manifest digest",
        "C2 both SCREEN2 anchors completed with no evaluation error",
        "C3 both SCREEN2 anchors have a defined ORACLE_SET-over-UNILATERAL gain, "
        "that is, UNILATERAL pooled EE is non-zero on the screen",
        "C4 the screen's two world digests equal the FULL20 world digests for "
        "worlds 1 and 2, so the screen rows are literal FULL20 rows",
    ],
    "explicitly_not_a_condition": [
        "the sign of any gain",
        "the magnitude of any gain",
        "agreement with any other variant",
        "whether the result looks favourable",
    ],
}


def _print_json(payload) -> None:
    print(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False))


def _arms(value: str | None):
    if not value:
        return report.ARMS
    return tuple(part.strip() for part in value.split(",") if part.strip())


def cmd_variants(args) -> int:
    table = variants_module.registry()
    for name in sorted(table):
        variant = table[name]
        marker = " (default)" if name == variants_module.DEFAULT_VARIANT else ""
        print(f"{name}{marker}\n  source: {variant.source}\n  {variant.description}\n")
    return 0


def cmd_panels(args) -> int:
    for name in sorted(panel_module.PANELS):
        board = panel_module.get(name)
        print(f"{name}: {len(board.anchors)} anchors, tape_steps={board.tape_steps}")
        print(f"  {board.description}")
        print(f"  anchors: {list(board.anchors)}\n")
    return 0


def cmd_run(args) -> int:
    from harness import runner

    arms = _arms(args.arms)
    result = runner.run_panel(
        variant_name=args.variant,
        panel_name=args.panel,
        arms=arms,
        use_cache=not args.no_cache,
        output=args.out,
        progress=not args.quiet,
    )
    table = report.pooled(result["anchors"], arms)
    print()
    print(f"variant={result['variant']}  panel={result['panel']}  "
          f"anchors={len(result['anchors'])}")
    print(f"receipt_sha256={result['receipt_sha256']}")
    print(f"sealed_manifest_sha256={result['sealed_manifest_sha256']}")
    print(f"world_sha256={[row['world_sha256'] for row in result['worlds']]}")
    print()
    print(report.pooled_table(table, arms))
    print()
    print(report.gains_table(report.pooled_gains(table, arms)))
    print()
    print(report.anchor_table(result["anchors"], arms))
    print()
    print(f"wall_seconds={result['wall_seconds']:.3f}  cache={result['cache']['stats']}")
    if args.out:
        print(f"receipt written: {args.out}")
    return 0


def cmd_verify_sealed(args) -> int:
    from harness import proof

    verdict = proof.sealed_bit_identity()
    if args.out:
        args.out.parent.mkdir(parents=True, exist_ok=True)
        args.out.write_text(
            json.dumps(verdict, indent=2, sort_keys=True) + "\n", encoding="ascii"
        )
    summary = {
        "verdict": verdict["verdict"],
        "sealed_manifest_sha256": verdict["sealed_manifest_sha256"],
        "probe_source_sha256": verdict["probe_source_sha256"],
        "structural": verdict["structural"],
        "sealed_fixture_cases_alpha_none": verdict["sealed_fixture_parity_alpha_none"][
            "case_count"
        ],
        "sealed_all_fields_equal_alpha_none": verdict[
            "sealed_fixture_parity_alpha_none"
        ]["all_cases_equal"],
        "sealed_all_fields_equal_alpha_0_10": verdict[
            "sealed_fixture_parity_alpha_0_10"
        ]["all_cases_equal"],
        "margin_q_all_fields_equal_alpha_none": verdict[
            "margin_q_fixture_parity_alpha_none"
        ]["all_cases_equal"],
        "teeth_positive_control": verdict["teeth_positive_control"],
        "route_ok": verdict["route"]["ok"],
    }
    _print_json(summary)
    if args.out:
        print(f"proof written: {args.out}")
    return 0 if verdict["verdict"] == "PASS" else 1


def _canonical(value):
    """Normalise tuple/list shape so a fresh row and a stored row compare equal.

    A freshly evaluated anchor holds Python tuples where a JSON receipt holds
    lists.  That is a serialisation difference, not a physical one, so both
    sides are put through the same JSON round trip before comparison.
    """

    return json.loads(json.dumps(value, allow_nan=False))


