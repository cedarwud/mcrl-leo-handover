    print()
    print(
        "recomputed pooled matches stored summary: "
        f"{payload['recomputed_pooled_matches_stored_summary']}"
    )
    return 0


def cmd_diff(args) -> int:
    left = query_module.load(args.left)
    right = query_module.load(args.right)
    _print_json(query_module.difference(left, right, _arms(args.arms)))
    return 0


def cmd_dist(args) -> int:
    receipt = query_module.load(args.receipt)
    payload = query_module.distribution(receipt, args.over, args.base)
    if args.json:
        _print_json(payload)
        return 0
    print(f"variant={payload['variant']}  panel={payload['panel']}  "
          f"gain={args.over} over {args.base}")
    print(f"receipt_sha256={payload['receipt_sha256']}")
    print(
        f"defined={payload['defined_anchor_count']} "
        f"undefined={payload['undefined_anchor_count']} "
        f"negative={payload['negative_anchor_count']} "
        f"zero={payload['zero_anchor_count']} "
        f"positive={payload['positive_anchor_count']}"
    )
    for key in ("min", "q25", "median", "q75", "max", "mean"):
        value = payload[key]
        print(f"  {key:<7}{'n/a' if value is None else f'{value:+.12f}'}")
    print("  negative anchors:")
    if not payload["negative_anchors"]:
        print("    (none)")
    for row in payload["negative_anchors"]:
        print(f"    {row['anchor_id']:<34}{row['gain']:+.12f}")
    print("  per anchor:")
    for row in payload["per_anchor"]:
        print(f"    {row['anchor_id']:<34}{row['gain']:+.12f}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="harness", description="V0.25 twenty-anchor evaluation harness."
    )
    sub = parser.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run", help="run a named variant on a named panel")
    run.add_argument("--variant", default=variants_module.DEFAULT_VARIANT)
    run.add_argument("--panel", default="FULL20")
    run.add_argument("--arms", default=None, help="comma separated; default all three")
    run.add_argument("--out", type=Path, default=None)
    run.add_argument("--no-cache", action="store_true")
    run.add_argument("--quiet", action="store_true")
    run.set_defaults(func=cmd_run)

    sub.add_parser("variants", help="list registered physics variants").set_defaults(
        func=cmd_variants
    )
    sub.add_parser("panels", help="list registered anchor panels").set_defaults(
        func=cmd_panels
    )
    sub.add_parser("rule", help="print the declared screen promotion rule").set_defaults(
        func=cmd_rule
    )

    verify = sub.add_parser("verify-sealed", help="prove SEALED is bit-identical")
    verify.add_argument("--out", type=Path, default=None)
    verify.set_defaults(func=cmd_verify_sealed)

    reproduce = sub.add_parser(
        "reproduce", help="reproduce an archived published figure in one command"
    )
    reproduce.add_argument("--variant", default="SEALED")
    reproduce.add_argument("--archive", type=Path, default=ARCHIVE_ORIGINAL)
    reproduce.add_argument(
        "--target", type=float, default=ARCHIVED_ORACLE_OVER_UNILATERAL
    )
    reproduce.add_argument("--out", type=Path, default=None)
    reproduce.add_argument("--no-cache", action="store_true")
    reproduce.add_argument("--quiet", action="store_true")
    reproduce.set_defaults(func=cmd_reproduce)

    screen = sub.add_parser("screen", help="run the two-anchor screen and apply the rule")
    screen.add_argument("--variant", default=variants_module.DEFAULT_VARIANT)
    screen.add_argument("--out", type=Path, default=None)
    screen.add_argument("--full-receipt", type=Path, default=None)
    screen.add_argument("--no-cache", action="store_true")
    screen.add_argument("--quiet", action="store_true")
    screen.set_defaults(func=cmd_screen)

    agreement = sub.add_parser("agreement", help="screen versus full panel agreement")
    agreement.add_argument("--screen", type=Path, required=True)
    agreement.add_argument("--full", type=Path, required=True)
    agreement.set_defaults(func=cmd_agreement)

    prof = sub.add_parser("profile", help="where the panel time goes")
    prof.add_argument("--variant", default=variants_module.DEFAULT_VARIANT)
    prof.add_argument("--anchors", type=int, default=1)
    prof.add_argument("--out", type=Path, default=None)
    prof.add_argument("--no-cache", action="store_true")
    prof.set_defaults(func=cmd_profile)

    audit = sub.add_parser(
        "cache-audit", help="prove the world-tape cache is variant-independent"
    )
    audit.add_argument("--world", type=int, default=1)
    audit.add_argument("--out", type=Path, default=None)
    audit.set_defaults(func=cmd_cache_audit)

    show = sub.add_parser("show", help="pooled figures for a stored run")
    show.add_argument("receipt", type=Path)
    show.add_argument("--arms", default=None)
    show.add_argument("--json", action="store_true")
    show.set_defaults(func=cmd_show)

    diff = sub.add_parser("diff", help="difference between two stored runs")
    diff.add_argument("left", type=Path)
    diff.add_argument("right", type=Path)
    diff.add_argument("--arms", default=None)
    diff.set_defaults(func=cmd_diff)

    dist = sub.add_parser("dist", help="per-anchor distribution of an arm-over-arm gain")
    dist.add_argument("receipt", type=Path)
    dist.add_argument("--over", default="ORACLE_SET")
    dist.add_argument("--base", default="UNILATERAL")
    dist.add_argument("--json", action="store_true")
    dist.set_defaults(func=cmd_dist)

    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
"""Fast tests for the harness itself. No physics is evaluated here."""

from __future__ import annotations

import json
from pathlib import Path

import pytest

from harness import cache as cache_module
from harness import panel as panel_module
from harness import query as query_module
from harness import report
from harness import sealed as sealed_module
from harness import variants as variants_module
from harness.cli import PROMOTION_RULE

ARCHIVE = Path(__file__).resolve().parents[2] / "ladder-archive/original-result.json"


@pytest.fixture(scope="module")
def archive() -> dict:
    return json.loads(ARCHIVE.read_text(encoding="ascii"))


def test_sealed_tree_matches_its_manifest() -> None:
    tree = sealed_module.verify()
    assert tree.file_count > 0
    assert tree.probe_sha256 == sealed_module.EXPECTED_PROBE_SHA256


def test_default_variant_is_sealed_and_registry_is_discovered() -> None:
    assert variants_module.DEFAULT_VARIANT == "SEALED"
    assert "SEALED" in variants_module.names()
    assert "MARGIN_Q" in variants_module.names()


def test_unknown_variant_and_panel_are_refused() -> None:
    with pytest.raises(KeyError):
        variants_module.get("NOT_A_VARIANT")
    with pytest.raises(KeyError):
        panel_module.get("NOT_A_PANEL")


def test_screen_is_a_literal_subset_of_the_full_panel() -> None:
    assert set(panel_module.SCREEN2.anchors) <= set(panel_module.FULL20.anchors)
    assert panel_module.SCREEN2.tape_steps == panel_module.FULL20.tape_steps


def test_pooled_recomputation_reproduces_the_archived_summary(archive) -> None:
    table = report.pooled(archive["anchors"], report.ARMS)
    for arm in report.ARMS:
        for key in ("bits", "joules", "ee_bit_per_j", "served_count_sum"):
            assert table[arm][key] == archive["summary"]["pooled"][arm][key]


def test_pooled_gain_reproduces_the_archived_headline(archive) -> None:
    gains = report.pooled_gains(report.pooled(archive["anchors"]))
    assert (
        gains["ORACLE_SET_over_UNILATERAL"]
        == archive["summary"]["oracle_set_over_unilateral_relative"]
    )
    assert (
        gains["UNILATERAL_over_BASELINE"]
        == archive["summary"]["unilateral_over_baseline_relative"]
    )


def test_gain_distribution_counts_every_anchor(archive) -> None:
    distribution = report.gain_distribution(
        archive["anchors"], "ORACLE_SET", "UNILATERAL"
    )
    assert (
        distribution["defined_anchor_count"] + distribution["undefined_anchor_count"]
        == len(archive["anchors"])
    )
    assert (
        distribution["negative_anchor_count"]
        + distribution["zero_anchor_count"]
        + distribution["positive_anchor_count"]
        == distribution["defined_anchor_count"]
    )
    assert len(distribution["negative_anchors"]) == distribution["negative_anchor_count"]
    assert distribution["min"] <= distribution["median"] <= distribution["max"]


def test_query_difference_of_a_receipt_with_itself_is_zero(archive) -> None:
    delta = query_module.difference(archive, archive)
    assert delta["anchor_sets_identical"] is True
    for arm in report.ARMS:
        for value in delta["delta_pooled_right_minus_left"][arm].values():
            assert value == 0
    for value in delta["delta_pooled_gains_right_minus_left"].values():
        assert value == 0


def test_cache_keys_are_deterministic_and_input_sensitive() -> None:
    store = cache_module.HarnessCache(enabled=False)
    common = dict(
        sealed_manifest="a" * 64,
        domain="V025_PROBE_R2/world/1",
        steps=5,
        start_time_s=0.0,
        provider="p",
    )
    assert store.world_key(**common) == store.world_key(**common)
    assert store.world_key(**{**common, "steps": 4}) != store.world_key(**common)
    anchor = dict(
        sealed_manifest="a" * 64,
        variant="SEALED",
        variant_source="c" * 64,
        world_sha256="b" * 64,
        step_index=0,
    )
    assert store.anchor_key(**anchor) == store.anchor_key(**anchor)
    assert (
        store.anchor_key(**{**anchor, "variant": "MARGIN_Q"})
        != store.anchor_key(**anchor)
    )
    assert (
        store.anchor_key(**{**anchor, "variant_source": "d" * 64})
        != store.anchor_key(**anchor)
    )


def test_every_variant_records_its_own_source_digest() -> None:
    for variant in variants_module.registry().values():
        assert len(variant.source_sha256) == 64


