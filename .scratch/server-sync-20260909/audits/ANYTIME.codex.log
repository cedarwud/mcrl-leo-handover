+    print(f"receipt written: {args.out}")
+    return 0
+
+
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(
         prog="harness", description="V0.25 twenty-anchor evaluation harness."
@@ -560,6 +584,15 @@
     dist.add_argument("--json", action="store_true")
     dist.set_defaults(func=cmd_dist)
 
+    anytime = sub.add_parser(
+        "anytime", help="measure first-improvement unilateral anytime quality"
+    )
+    anytime.add_argument("--variant", default=variants_module.DEFAULT_VARIANT)
+    anytime.add_argument("--out", type=Path, required=True)
+    anytime.add_argument("--resume", action="store_true")
