#!/usr/bin/env python3
"""Perfect-knowledge set-interaction ceiling on corrected V0.25 physics.

This is a TRAIN-only diagnostic.  It has no learner and intentionally ignores
the ten-second deployment deadline.  Selection uses the exact binary64
decision-boundary outcomes; committed reporting uses all 48 realised
boundaries from the same detached world tape.
"""

from __future__ import annotations

import argparse
from collections import Counter
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import os
from pathlib import Path
import platform
import subprocess
import sys
import time
from typing import Mapping, Sequence


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
PROBE_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)
OUTPUT_PATH = HERE / "oracle-ceiling-result.json"
ETA_REF = Fraction("19720681.00172232")
ANCHORS_PER_WORLD = 5
WORLD_COUNT = 4
SELECTION_WORKERS = 1
OCCUPANT_SUBSET_MAX_SIZE = 4
OCCUPANT_SUBSET_TOTAL_CAP = 1_024
JOINT_CANDIDATE_CAP = 4_096
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"


def _load_probe():
    spec = importlib.util.spec_from_file_location("oracle_v025_probe", PROBE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load the pinned V0.25 probe")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


probe = _load_probe()


def exact_float(value: float) -> Fraction:
    """Treat the simulator's finite binary64 result as an exact coefficient."""

    if not math.isfinite(value):
        raise RuntimeError("non-finite physical coefficient")
    return Fraction.from_float(float(value))


def objective(profile) -> Fraction:
    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)


def served(profile) -> int:
    if isinstance(profile, SelectionMetric):
        return profile.served_count
    return sum(bool(value) for value in profile.score.served_phy.values())


def ratio(bits: float, joules: float) -> float:
    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
        raise RuntimeError("invalid EE components")
    return bits / joules


def relative_gain(numerator: float, denominator: float) -> float | None:
    """Return an anchor-local gain, or None when the reference EE is zero."""

    if denominator == 0.0:
        return None
    return numerator / denominator - 1.0


def frac_payload(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def _configuration(base, mapping: Mapping[int, tuple[int, int] | None], kind: str):
    return probe._configuration(base, dict(mapping), kind=kind)


@dataclass(frozen=True)
class CoordinateResult:
    selected: object
    iterations: int
    passes: int
    terminal_candidates: tuple[object, ...]
    best_alternatives: Mapping[int, tuple[int, int]]
    candidate_comparisons: int


@dataclass(frozen=True)
class SelectionMetric:
    config: object
    bits: float
    joules: float
    served_count: int


_WORKER_TAPE = None


def _selection_worker(task):
    step_index, base, configs = task
    evaluator = probe.StepEvaluator(
        _WORKER_TAPE,
        probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=probe.run_setting_for("a-r0"),
        boundary_indices=(0,),
        fading_quantile_alpha=0.10,
    )
    evaluator.evaluate_many(configs)
    rows = []
    for config in configs:
        profile = evaluator._evaluated.get(config.configuration_id)
        if profile is not None:
            rows.append(
                SelectionMetric(
                    config, profile.bits, profile.joules, served(profile)
                )
            )
    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations


class ParallelSelectionEvaluator:
    """Persistent fork workers over one detached tape; exact stable reduction."""

    def __init__(self, tape, step_index: int, base, pool) -> None:
        self.tape = tape
        self.step_index = step_index
        self.base = base
        self.pool = pool
        self._evaluated: dict[str, SelectionMetric] = {}
        self._invalid: set[str] = set()
        self.physical_evaluations = 0

    def evaluate_many(self, configs: Sequence[object]) -> None:
        missing_by_id = {
            row.configuration_id: row
            for row in configs
            if row.configuration_id not in self._evaluated
            and row.configuration_id not in self._invalid
        }
        missing = tuple(missing_by_id.values())
        if not missing:
            return
        if self.pool is None:
            results = [_selection_worker((self.step_index, self.base, missing))]
        else:
            shards = tuple(
                tuple(missing[index::SELECTION_WORKERS])
                for index in range(SELECTION_WORKERS)
            )
            results = self.pool.map(
                _selection_worker,
                tuple((self.step_index, self.base, shard) for shard in shards),
                chunksize=1,
            )
        unordered = {}
        for rows, invalid, evaluations in results:
            unordered.update((row.config.configuration_id, row) for row in rows)
            self._invalid.update(invalid)
            self.physical_evaluations += evaluations
        for config in missing:
            if config.configuration_id in unordered:
                self._evaluated[config.configuration_id] = unordered[
                    config.configuration_id
                ]

    def evaluate(self, config) -> SelectionMetric:
        self.evaluate_many((config,))
        try:
            return self._evaluated[config.configuration_id]
        except KeyError:
            raise RuntimeError(
                f"invalid selection configuration {config.configuration_id}"
            ) from None


def coordinate_optimum(*, tape, step_index: int, base, evaluator) -> CoordinateResult:
    """Deterministic cyclic best responses to a strict local optimum."""

    options, _ = probe._legal_options(tape, step_index)
    base_profile = evaluator.evaluate(base)
    guard = served(base_profile)
    current = base
    iterations = 0
    passes = 0
    comparisons = 0
    terminal: tuple[object, ...] = ()

    while True:
        passes += 1
        pass_moves = 0
        pass_candidates = []
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(current_profile)
            candidates = []
            current_map = current.mapping
            for identity in options[user]:
                if identity == current_map[user]:
                    continue
                mapping = dict(current_map)
                mapping[user] = identity
                candidates.append(
                    _configuration(base, mapping, "unilateral-coordinate")
                )
            evaluator.evaluate_many(candidates)
            comparisons += len(candidates)
            pass_candidates.extend(candidates)
            best = current
            best_value = current_value
            for candidate in candidates:
                profile = evaluator._evaluated.get(candidate.configuration_id)
                if profile is None or served(profile) < guard:
                    continue
                value = objective(profile)
                if value > best_value or (
                    value == best_value
                    and best is not current
                    and candidate.configuration_id < best.configuration_id
                ):
                    best = candidate
                    best_value = value
            if best.assignments != current.assignments:
                current = best
                iterations += 1
                pass_moves += 1
        if pass_moves == 0:
            terminal = tuple(pass_candidates)
            break
        print(
            json.dumps(
                {
                    "coordinate_step": step_index,
                    "completed_passes": passes,
                    "moves_in_pass": pass_moves,
                    "completed_improving_moves": iterations,
                    "unique_selection_evaluations": evaluator.physical_evaluations,
                },
                sort_keys=True,
            ),
            flush=True,
        )

    # Every action here was physically evaluated in the terminal certificate.
    # The alternate is chosen per user only to instantiate physically-defined
    # coalition memberships; users are never ranked by this value.
    best_alternatives: dict[int, tuple[int, int]] = {}
    current_map = current.mapping
    for user in sorted(options):
        rows = []
        for identity in options[user]:
            if identity == current_map[user]:
                continue
            mapping = dict(current_map)
            mapping[user] = identity
            candidate = _configuration(base, mapping, "terminal-alternate")
            profile = evaluator._evaluated.get(candidate.configuration_id)
            if profile is not None:
                rows.append((objective(profile), candidate.configuration_id, identity))
        if rows:
            best_alternatives[user] = min(
                rows, key=lambda row: (-row[0], row[1])
            )[2]

    return CoordinateResult(
        current,
        iterations,
        passes,
        terminal,
        best_alternatives,
        comparisons,
    )


def _interference_contributors(
    *, tape, step_index: int, current, victim: int
) -> tuple[int, ...]:
    """Rank users by physical nominal interference, never by reward marginal."""

    mapping = current.mapping
    victim_beam = mapping[victim]
    if victim_beam is None:
        return ()
    occupancy = Counter(identity for identity in mapping.values() if identity is not None)
    step = tape.steps[step_index]
    scores = []
    if step.arrays is not None:
        arrays = step.arrays
        victim_row = arrays._row_index().get((victim, victim_beam))
        aggressor_of = arrays._aggressor_index()
        if victim_row is None:
            return ()
        for user, beam in sorted(mapping.items()):
            if user == victim or beam is None or beam == victim_beam:
                continue
            aggressor_index = aggressor_of.get(beam)
            if aggressor_index is None:
                continue
            gain = arrays._cross_at_index(0, victim_row, aggressor_index)[0]
            score = gain / occupancy[beam]
            if score > 0.0:
                scores.append((score, user))
    else:
        boundary = step.boundary_at(0)
        by_key = {(row.user_id, row.identity): row for row in boundary.candidates}
        victim_row = by_key.get((victim, victim_beam))
        if victim_row is None:
            return ()
        cross = dict(victim_row.nominal_cross_gain_by_identity)
        for user, beam in sorted(mapping.items()):
            if user == victim or beam is None or beam == victim_beam:
                continue
            score = cross.get(beam, 0.0) / occupancy[beam]
            if score > 0.0:
                scores.append((score, user))
    return tuple(user for _score, user in sorted(scores, key=lambda row: (-row[0], row[1])))


def build_joint_candidates(
    *, tape, step_index: int, base, unilateral, best_alternatives
) -> tuple[tuple[object, ...], Mapping[tuple, tuple[dict[str, object], ...]], dict[str, int]]:
    """Build a bounded catalogue from occupancy and interference mechanisms."""

    options, _ = probe._legal_options(tape, step_index)
    current_map = unilateral.mapping
    by_beam: dict[tuple[int, int], tuple[int, ...]] = {}
    for beam in sorted({row for row in current_map.values() if row is not None}):
        by_beam[beam] = tuple(
            user for user, identity in sorted(current_map.items()) if identity == beam
        )

    aliases: dict[tuple, list[dict[str, object]]] = {}
    configs: dict[tuple, object] = {}
    family_rows = Counter()

    def add(mapping, *, family: str, coalition: Sequence[int], detail: str) -> None:
        changed = tuple(
            user
            for user in sorted(current_map)
            if mapping[user] != current_map[user]
        )
        if len(changed) < 2:
            return
        assignments = tuple(sorted(mapping.items()))
        aliases.setdefault(assignments, []).append(
            {
                "family": family,
                "coalition_users": list(sorted(coalition)),
                "changed_users": list(changed),
                "detail": detail,
            }
        )
        if assignments not in configs:
            configs[assignments] = _configuration(base, mapping, family)
            family_rows[family] += 1

    occupant_rows = 0
    for beam, occupants in by_beam.items():
        for size in range(2, min(OCCUPANT_SUBSET_MAX_SIZE, len(occupants)) + 1):
            for coalition in itertools.combinations(occupants, size):
                if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                    break
                if any(user not in best_alternatives for user in coalition):
                    continue
                mapping = dict(current_map)
                for user in coalition:
                    mapping[user] = best_alternatives[user]
                add(
                    mapping,
                    family="beam-occupant-subset",
                    coalition=coalition,
                    detail=f"origin={beam[0]}:{beam[1]};size={size}",
                )
                occupant_rows += 1
            if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
                break
        if occupant_rows >= OCCUPANT_SUBSET_TOTAL_CAP:
            break

    for victim in sorted(current_map):
        if victim not in best_alternatives:
            continue
        contributors = _interference_contributors(
            tape=tape, step_index=step_index, current=unilateral, victim=victim
        )
        for count in (2, 3):
            if len(contributors) < count:
                continue
            coalition = (victim, *contributors[:count])
            if any(user not in best_alternatives for user in coalition):
                continue
            mapping = dict(current_map)
            for user in coalition:
                mapping[user] = best_alternatives[user]
            add(
                mapping,
                family=f"victim-plus-top-{count}-contributors",
                coalition=coalition,
                detail=f"victim={victim};contributors={','.join(map(str, contributors[:count]))}",
            )

    for beam, occupants in by_beam.items():
        if len(occupants) < 2:
            continue
        common = set(options[occupants[0]])
        for user in occupants[1:]:
            common.intersection_update(options[user])
        common.discard(beam)
        for destination in sorted(common):
            mapping = dict(current_map)
            for user in occupants:
                mapping[user] = destination
            add(
                mapping,
                family="complete-beam-evacuation",
                coalition=occupants,
                detail=(
                    f"origin={beam[0]}:{beam[1]};"
                    f"destination={destination[0]}:{destination[1]}"
                ),
            )

    ordered = tuple(configs[key] for key in sorted(configs))
    if len(ordered) > JOINT_CANDIDATE_CAP:
        raise RuntimeError(
            f"mechanism catalogue exceeds fixed bound: {len(ordered)} > {JOINT_CANDIDATE_CAP}"
        )
    return (
        ordered,
        {key: tuple(value) for key, value in aliases.items()},
        dict(sorted(family_rows.items())),
    )


def evaluate_anchor(*, tape, world_index: int, step_index: int, pool=None) -> dict[str, object]:
    setting = probe._setting("a-r0")
    run_setting = probe.run_setting_for("a-r0")
    base = probe._base_configuration(tape, step_index, "nearest-eligible")
    selection = ParallelSelectionEvaluator(tape, step_index, base, pool)
    started = time.perf_counter()
    coordinate = coordinate_optimum(
        tape=tape,
        step_index=step_index,
        base=base,
        evaluator=selection,
    )
    unilateral = coordinate.selected
    before_joint_evaluations = selection.physical_evaluations
    candidates, aliases, family_counts = build_joint_candidates(
        tape=tape,
        step_index=step_index,
        base=base,
        unilateral=unilateral,
        best_alternatives=coordinate.best_alternatives,
    )
    selection.evaluate_many(candidates)
    base_profile = selection.evaluate(base)
    unilateral_profile = selection.evaluate(unilateral)
    guard = served(base_profile)
    best = unilateral
    best_profile = unilateral_profile
    for candidate in candidates:
        profile = selection._evaluated.get(candidate.configuration_id)
        if profile is None or served(profile) < guard:
            continue
        value = objective(profile)
        best_value = objective(best_profile)
        if value > best_value or (
            value == best_value
            and best is not unilateral
            and candidate.configuration_id < best.configuration_id
        ):
            best, best_profile = candidate, profile

    coalition_users = tuple(
        user
        for user in sorted(unilateral.mapping)
        if unilateral.mapping[user] != best.mapping[user]
    )
    psi = Fraction()
    singleton_sum = Fraction()
    if coalition_users:
        for user in coalition_users:
            mapping = unilateral.mapping
            mapping[user] = best.mapping[user]
            singleton = _configuration(base, mapping, "oracle-singleton-component")
            singleton_profile = selection.evaluate(singleton)
            singleton_sum += objective(singleton_profile) - objective(unilateral_profile)
        psi = (
            objective(best_profile)
            - objective(unilateral_profile)
            - singleton_sum
        )

    committed_counter = probe.EvaluationCounter()
    committed = probe.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=base,
        field="realised",
        counter=committed_counter,
        run_setting=run_setting,
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    unique = {
        row.configuration_id: row for row in (base, unilateral, best)
    }
    committed.evaluate_many(tuple(unique.values()))

    profiles = {
        "BASELINE": committed.evaluate(base),
        "UNILATERAL": committed.evaluate(unilateral),
        "ORACLE_SET": committed.evaluate(best),
    }
    chosen_aliases = aliases.get(best.assignments, ())
    qualifying = bool(coalition_users) and objective(best_profile) > objective(
        unilateral_profile
    )
    row = {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "world_domain": tape.domain,
        "world_sha256": tape.digest,
        "tle_date": tape.tle_date,
        "training_seed": tape.training_seed,
        "step_index": step_index,
        "selection": {
            "field": "realised",
            "boundary_indices": [0],
            "held_snapshot_seconds": 30.08,
            "eta_ref": frac_payload(ETA_REF),
            "baseline_served_guard": guard,
            "unilateral_iterations": coordinate.iterations,
            "unilateral_passes": coordinate.passes,
            "unilateral_terminal_certified": True,
            "unilateral_candidate_comparisons": coordinate.candidate_comparisons,
            "joint_catalogue_unique": len(candidates),
            "joint_catalogue_aliases": sum(len(value) for value in aliases.values()),
            "joint_family_unique_counts": family_counts,
            "qualifying_coalition_existed": qualifying,
            "selected_coalition_size": len(coalition_users) if qualifying else 0,
            "selected_coalition_users": list(coalition_users) if qualifying else [],
            "selected_candidate_aliases": list(chosen_aliases) if qualifying else [],
            "selected_joint_served": served(best_profile),
            "selected_joint_F_gain_bits": float(
                objective(best_profile) - objective(unilateral_profile)
            ),
            "selected_singleton_sum_bits": float(singleton_sum),
            "selected_Psi_A_bits": float(psi),
            "selected_Psi_A_exact": frac_payload(psi),
            "unique_selection_configuration_evaluations": selection.physical_evaluations,
            "unilateral_unique_evaluations_before_joint": before_joint_evaluations,
            "new_joint_unique_evaluations": (
                selection.physical_evaluations - before_joint_evaluations
            ),
            "selection_physical_boundary_evaluations": selection.physical_evaluations,
        },
        "committed": {
            name: {
                "configuration_id": profile.config.configuration_id,
                "assignments": list(profile.config.assignments),
                "bits": profile.bits,
                "joules": profile.joules,
                "ee_bit_per_j": ratio(profile.bits, profile.joules),
                "served_count": served(profile),
            }
            for name, profile in profiles.items()
        },
        "committed_unique_configuration_evaluations": len(unique),
        "committed_physical_boundary_evaluations": committed_counter.boundary_evaluations,
        "wall_seconds": time.perf_counter() - started,
    }
    row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] = relative_gain(
        row["committed"]["ORACLE_SET"]["ee_bit_per_j"],
        row["committed"]["UNILATERAL"]["ee_bit_per_j"],
    )
    row["committed"]["UNILATERAL"]["relative_ee_gain_over_BASELINE"] = relative_gain(
        row["committed"]["UNILATERAL"]["ee_bit_per_j"],
        row["committed"]["BASELINE"]["ee_bit_per_j"],
    )
    if served(best_profile) < guard:
        raise RuntimeError("ORACLE_SET violated the literal selection-time service guard")
    if objective(best_profile) < objective(unilateral_profile):
        raise RuntimeError("ORACLE_SET is worse than its included UNILATERAL reference")
    return row


def _git(*args: str) -> str:
    return subprocess.check_output(
        ["git", *args], cwd=REPO, text=True, encoding="utf-8"
    ).strip()


def summarize(anchors: Sequence[Mapping[str, object]]) -> dict[str, object]:
    selectors = ("BASELINE", "UNILATERAL", "ORACLE_SET")
    pooled = {}
    for name in selectors:
        bits = math.fsum(float(row["committed"][name]["bits"]) for row in anchors)  # type: ignore[index]
        joules = math.fsum(float(row["committed"][name]["joules"]) for row in anchors)  # type: ignore[index]
        pooled[name] = {
            "bits": bits,
            "joules": joules,
            "ee_bit_per_j": ratio(bits, joules),
            "served_count_sum": sum(
                int(row["committed"][name]["served_count"]) for row in anchors  # type: ignore[index]
            ),
        }
    return {
        "anchor_count": len(anchors),
        "world_count": len({str(row["world_domain"]) for row in anchors}),
        "qualifying_coalition_anchor_count": sum(
            bool(row["selection"]["qualifying_coalition_existed"]) for row in anchors  # type: ignore[index]
        ),
        "pooled": pooled,
"""One panel run: variant in, receipt out.

The anchor evaluation itself is not restated here.  It is imported verbatim
from the sealed reference runner (``harness.sealed.reference_runner``), which
is the exact file that produced the archived twenty-anchor receipts.  This
module supplies only what surrounds it: the panel, the named variant seam,
the caches, and the receipt.
"""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess
import sys
import time

from harness import panel as panel_module
from harness import sealed as sealed_module
from harness import variants as variants_module
from harness.cache import HarnessCache

ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
SCHEMA = "mcrl-v025-perfect-knowledge-oracle-ceiling-v1"
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
REPO = Path(__file__).resolve().parents[1]

# Archived receipts label the two known variants with these formulation names.
FORMULATION_ALIAS = {"SEALED": "original", "MARGIN_Q": "margin"}


def _git(*args: str) -> str:
    try:
        return subprocess.check_output(
            ["git", *args], cwd=REPO, text=True, encoding="utf-8"
        ).strip()
    except (subprocess.CalledProcessError, OSError):
        return "UNAVAILABLE"


def install_variant(name: str):
    """Resolve a named variant and install it on the single physics seam.

    Returns ``(variant, installed, sealed_default)``.  For ``SEALED`` the
    installed object must be the very object the probe already holds; that
    identity is asserted here so a mis-registered SEALED cannot run at all.
    """

    reference = sealed_module.reference_runner()
    sealed_default = sealed_module.pristine_evaluator()
    variant = variants_module.get(name)
    installed = variant.build(sealed_module)
    if name == variants_module.DEFAULT_VARIANT and installed is not sealed_default:
        raise RuntimeError(
            "SEALED must resolve to the sealed evaluator object itself"
        )
    reference.probe.evaluate_ar_tdm_catalogue = installed
    return variant, installed, sealed_default


def run_panel(
    *,
    variant_name: str = variants_module.DEFAULT_VARIANT,
    panel_name: str = "FULL20",
    arms: tuple[str, ...] = ARMS,
    use_cache: bool = True,
    output: Path | None = None,
    progress: bool = True,
) -> dict:
    unknown = [arm for arm in arms if arm not in ARMS]
    if unknown:
        raise RuntimeError(f"unknown arms: {unknown}; known: {list(ARMS)}")
    tree = sealed_module.verify()
    reference = sealed_module.reference_runner()
    board = panel_module.get(panel_name)
    variant, installed, sealed_default = install_variant(variant_name)
    cache = HarnessCache(enabled=use_cache)

    from mcrl.physics_v025.provider_legacy import factory as real_factory

    started = time.perf_counter()
    anchors: list[dict] = []
    world_rows: list[dict] = []
    world_cache_hit: dict[int, bool] = {}
    anchor_cache_hit: list[bool] = []
    tapes: dict[int, object] = {}

    for world_index in board.worlds:
        domain = reference.probe.PROBE_WORLD_DOMAINS[world_index - 1]
        key = cache.world_key(
            sealed_manifest=tree.manifest_sha256,
            domain=domain,
            steps=board.tape_steps,
            start_time_s=0.0,
            provider="mcrl.physics_v025.provider_legacy.factory",
        )

        def build(domain=domain):
            return reference.probe.build_world_tape(
                domain=domain,
                provider=real_factory(),
                steps=board.tape_steps,
                start_time_s=0.0,
            )

        tape, meta, elapsed, hit = cache.world(key, build)
        tapes[world_index] = tape
        world_cache_hit[world_index] = hit
        world_rows.append({"world_index": world_index, "cache_key": key, **meta})
        if progress:
            print(
                json.dumps(
                    {
                        "world": domain,
                        "world_sha256": tape.digest,
                        "cache": "hit" if hit else "miss",
                        "seconds": elapsed,
                    },
                    sort_keys=True,
                ),
                flush=True,
            )

    for world_index, step_index in board.anchors:
        tape = tapes[world_index]
        key = cache.anchor_key(
            sealed_manifest=tree.manifest_sha256,
            variant=variant_name,
            variant_source=variant.source_sha256,
            world_sha256=tape.digest,
            step_index=step_index,
        )

        def build(tape=tape, world_index=world_index, step_index=step_index):
            reference._WORKER_TAPE = tape
            return reference.evaluate_anchor(
                tape=tape,
                world_index=world_index,
                step_index=step_index,
                pool=None,
            )

        row, hit = cache.anchor(key, build)
        anchors.append(row)
        anchor_cache_hit.append(hit)
        if progress:
            print(
                json.dumps(
                    {
                        "anchor": row["anchor_id"],
                        "cache": "hit" if hit else "miss",
                        "qualifying": row["selection"]["qualifying_coalition_existed"],
                        "oracle_ee_gain_pct": (
                            None
                            if row["committed"]["ORACLE_SET"][
                                "relative_ee_gain_over_UNILATERAL"
                            ]
                            is None
                            else 100.0
                            * row["committed"]["ORACLE_SET"][
                                "relative_ee_gain_over_UNILATERAL"
                            ]
                        ),
                        "wall_seconds": row["wall_seconds"],
                    },
                    sort_keys=True,
                ),
                flush=True,
            )

    measured = time.perf_counter() - started
    result = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM_CEILING,
        "variant": variant_name,
        "variant_description": variant.description,
        "variant_source": variant.source,
        "variant_source_sha256": variant.source_sha256,
        "formulation": FORMULATION_ALIAS.get(variant_name, variant_name.lower()),
        "panel": board.name,
        "panel_description": board.description,
        "panel_tape_steps": board.tape_steps,
        "reported_arms": list(arms),
        "arms_computed": list(ARMS),
        "arms_note": (
            "All three arms are always computed: ORACLE_SET is defined "
            "relative to UNILATERAL and both are guarded by the BASELINE "
            "served count. --arms restricts reporting, not computation."
        ),
        "sealed_manifest_sha256": tree.manifest_sha256,
        "sealed_file_count": tree.file_count,
        "probe_source_sha256": tree.probe_sha256,
        "source_commit": _git("rev-parse", "HEAD"),
        "source_tree": _git("rev-parse", "HEAD^{tree}"),
        "python": sys.executable,
        "python_version": platform.python_version(),
        "process_limit": 3,
        "processes_used": 1,
        "thread_environment": {
            name: os.environ.get(name)
            for name in (
                "OMP_NUM_THREADS",
                "OPENBLAS_NUM_THREADS",
                "MKL_NUM_THREADS",
                "NUMEXPR_NUM_THREADS",
            )
        },
        "test_split_opened": False,
        "learner_used": False,
        "ten_second_deadline": "IGNORED_BY_DESIGN_FOR_CEILING",
        "selection_objective": (
            "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s"
        ),
        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
        "service_guard": "selection-time served count >= BASELINE served count",
        "worlds": world_rows,
        "anchors": anchors,
        "summary": reference.summarize(anchors),
        "cache": {
            "enabled": use_cache,
            "root": str(cache.root) if use_cache else None,
            "world_cache_hit": {str(k): v for k, v in sorted(world_cache_hit.items())},
            "anchor_cache_hits": sum(anchor_cache_hit),
            "anchor_cache_misses": len(anchor_cache_hit) - sum(anchor_cache_hit),
            "stats": cache.stats.as_dict(),
        },
        "wall_seconds": measured,
        "wall_seconds_note": (
            "Measured wall time of this invocation. Anchor rows served from "
            "the anchor cache carry their original solve time in "
            "anchors[].wall_seconds; that time was not spent again."
        ),
        "synthetic_self_test": False,
    }
    unsigned = json.dumps(
        result, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")
    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
    if output is not None:
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(
            json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="ascii",
        )
    return result
"""Locate, verify and load the vendored sealed physics tree.

The sealed tree under ``sealed/`` is a byte-identical copy of the source tree
that produced the archived twenty-anchor receipts.  Nothing in this module
writes to it.  ``MANIFEST.sha256`` is checked on every load, so any harness
number can be traced back to an exact set of physics bytes.
"""

from __future__ import annotations

from dataclasses import dataclass
import hashlib
import importlib.util
from pathlib import Path
import sys

REPO = Path(__file__).resolve().parents[1]
SEALED_ROOT = REPO / "sealed"
SEALED_SRC = SEALED_ROOT / "src"
MANIFEST_PATH = SEALED_ROOT / "MANIFEST.sha256"
REFERENCE_RUNNER = SEALED_ROOT / ".scratch/ladder-floor-20260910/oracle_runner.py"
PROBE = SEALED_ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"

# Recorded in the archived receipts; the tree is worthless if this drifts.
EXPECTED_PROBE_SHA256 = "f4122d6784cb56de7743c55d51dc80a6c968ccea601d637cd1b41a8b5604c76c"


class SealedTreeError(RuntimeError):
    """The vendored sealed tree does not match its manifest."""


@dataclass(frozen=True)
class SealedTree:
    root: Path
    manifest_sha256: str
    file_count: int
    probe_sha256: str


def _read_manifest() -> list[tuple[str, str]]:
    rows = []
    for line in MANIFEST_PATH.read_text(encoding="ascii").splitlines():
        if not line.strip():
            continue
        digest, _, relative = line.partition("  ")
        rows.append((digest, relative))
    return rows


def verify() -> SealedTree:
    """Re-hash every vendored file and compare against the manifest."""

    rows = _read_manifest()
    for digest, relative in rows:
        path = SEALED_ROOT / relative
        if not path.is_file():
            raise SealedTreeError(f"sealed file is missing: {relative}")
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        if actual != digest:
            raise SealedTreeError(
                f"sealed file changed: {relative} {actual} != {digest}"
            )
    probe_sha256 = hashlib.sha256(PROBE.read_bytes()).hexdigest()
    if probe_sha256 != EXPECTED_PROBE_SHA256:
        raise SealedTreeError(
            f"probe source digest {probe_sha256} != archived {EXPECTED_PROBE_SHA256}"
        )
    manifest_sha256 = hashlib.sha256(MANIFEST_PATH.read_bytes()).hexdigest()
    return SealedTree(SEALED_ROOT, manifest_sha256, len(rows), probe_sha256)


_REFERENCE = None


def reference_runner():
    """Import the archived evaluation loop verbatim, from the sealed tree.

    The anchor evaluation, the unilateral certificate, the bounded coalition
    catalogue and the pooled summary are used exactly as the bytes that
    produced ``ladder-archive/original-result.json``.  The harness adds the
    panel, the variant seam, the caches and the receipt around them; it does
    not restate any physics.
    """

    global _REFERENCE
    if _REFERENCE is not None:
        return _REFERENCE
    verify()
    if str(SEALED_SRC) not in sys.path:
        sys.path.insert(0, str(SEALED_SRC))
    spec = importlib.util.spec_from_file_location(
        "harness_sealed_oracle_runner", REFERENCE_RUNNER
    )
    if spec is None or spec.loader is None:
        raise SealedTreeError("cannot load the sealed reference runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    # Captured once, before anything can install a variant, so the identity
    # guard compares against the pristine sealed evaluator rather than
    # against whatever the previous command happened to leave installed.
    module.__harness_pristine_evaluator__ = module.probe.evaluate_ar_tdm_catalogue
    _REFERENCE = module
    return module


def pristine_evaluator():
    """The sealed ``evaluate_ar_tdm_catalogue`` as first imported."""

    return reference_runner().__harness_pristine_evaluator__


def load_module(name: str, path: Path, package: str | None = None):
    """Load a sealed-tree module by absolute path, with the sealed src on sys.path.

    ``package`` sets ``__package__`` so a sealed module written with relative
    imports resolves them against the real package, without that module being
    the one registered under its canonical name.
    """

    reference_runner()
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise SealedTreeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    if package is not None:
        importlib.import_module(package)
        module.__package__ = package
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module
"""Fixed anchor panels.

An anchor is a ``(world_index, step_index)`` pair.  Every panel builds its
world tapes with the same ``tape_steps``, so an anchor row from a small panel
is bit-identical to the same anchor row from the full panel: a screen is a
literal subset of the full panel, never a different computation.
"""

from __future__ import annotations

from dataclasses import dataclass

TAPE_STEPS = 5
WORLD_COUNT = 4


@dataclass(frozen=True)
class Panel:
    name: str
    tape_steps: int
    anchors: tuple[tuple[int, int], ...]
    description: str

    @property
    def worlds(self) -> tuple[int, ...]:
        seen = []
        for world_index, _ in self.anchors:
            if world_index not in seen:
                seen.append(world_index)
        return tuple(seen)


FULL20 = Panel(
    name="FULL20",
    tape_steps=TAPE_STEPS,
    anchors=tuple(
        (world_index, step_index)
        for world_index in range(1, WORLD_COUNT + 1)
        for step_index in range(TAPE_STEPS)
    ),
    description="The published panel: 4 real worlds x 5 consecutive anchors.",
)

# Declared before use; see the screen ladder section of the report.
SCREEN2 = Panel(
    name="SCREEN2",
    tape_steps=TAPE_STEPS,
    anchors=((1, 0), (2, 0)),
    description=(
        "Two anchors, one per world, worlds 1 and 2, step 0. Tapes are built "
        "with the full panel's 5 steps, so both rows are bit-identical to the "
        "corresponding FULL20 rows."
    ),
)

PANELS = {panel.name: panel for panel in (FULL20, SCREEN2)}


def get(name: str) -> Panel:
    if name not in PANELS:
        raise KeyError(f"unknown panel {name!r}; known: {', '.join(sorted(PANELS))}")
    return PANELS[name]
"""Named physics-variant registry.

A variant is one named replacement for the dense catalogue evaluator seam
``probe.evaluate_ar_tdm_catalogue``.  Nothing else in the evaluation loop is
allowed to differ between variants: the panel, the anchors, the selector, the
service guard, the objective and the committed endpoint are shared.

Adding a variant is one new file in this directory that defines ``NAME``,
``DESCRIPTION`` and ``build(sealed)``.  Discovery is automatic; no other file
in the harness changes.
"""

from __future__ import annotations

from dataclasses import dataclass
import hashlib
import importlib
from pathlib import Path
import pkgutil
from typing import Callable

DEFAULT_VARIANT = "SEALED"


@dataclass(frozen=True)
class Variant:
    name: str
    description: str
    build: Callable[[object], Callable]
    source: str
    source_sha256: str


def _discover() -> dict[str, Variant]:
    found: dict[str, Variant] = {}
    for info in sorted(pkgutil.iter_modules(__path__), key=lambda row: row.name):
        module = importlib.import_module(f"{__name__}.{info.name}")
        name = getattr(module, "NAME", None)
        if name is None:
            continue
        if name in found:
            raise RuntimeError(f"duplicate variant name: {name}")
        found[name] = Variant(
            name=name,
            description=module.DESCRIPTION,
            build=module.build,
            source=f"{__name__}.{info.name}",
            source_sha256=hashlib.sha256(
                Path(module.__file__).read_bytes()
            ).hexdigest(),
        )
    return found


_REGISTRY: dict[str, Variant] | None = None


def registry() -> dict[str, Variant]:
    global _REGISTRY
    if _REGISTRY is None:
        _REGISTRY = _discover()
    return _REGISTRY


def names() -> tuple[str, ...]:
    return tuple(sorted(registry()))


def get(name: str) -> Variant:
    table = registry()
    if name not in table:
        raise KeyError(f"unknown variant {name!r}; known: {', '.join(sorted(table))}")
    return table[name]

