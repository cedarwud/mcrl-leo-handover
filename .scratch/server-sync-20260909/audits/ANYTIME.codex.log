    text = json.dumps(PROMOTION_RULE["conditions"]).lower()
    for forbidden in ("gain is positive", "larger", "better", "favourable", "improve"):
        assert forbidden not in text
    assert PROMOTION_RULE["screen_panel"] == "SCREEN2"
    assert PROMOTION_RULE["full_panel"] == "FULL20"
    assert len(PROMOTION_RULE["conditions"]) == 4
