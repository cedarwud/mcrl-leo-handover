FIRST_IMPROVEMENT_IMPLEMENTATION = REPO / "harness/anytime.py"
RUNNER_IMPLEMENTATION = Path(__file__).resolve()
ARCHIVED = {
    "SEALED": REPO / "receipts/sealed-full20-warm.json",
