def _canonical_digest(payload: Mapping[str, object]) -> str:
    unsigned = dict(payload)
    unsigned.pop("receipt_sha256", None)
    encoded = json.dumps(
        unsigned,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
        allow_nan=False,
    ).encode("ascii")
    return hashlib.sha256(encoded).hexdigest()


def _load_receipt(path: Path) -> dict:
    payload = json.loads(path.read_text(encoding="ascii"))
    expected = payload.get("receipt_sha256")
    actual = _canonical_digest(payload)
    if expected != actual:
        raise RuntimeError(f"receipt digest mismatch: {path}: {actual} != {expected}")
    return payload


def _write_receipt(payload: dict, path: Path) -> None:
    payload["receipt_sha256"] = _canonical_digest(payload)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
        encoding="ascii",
    )


def _configuration(reference, base, metric: Mapping[str, object], kind: str):
    mapping = {}
    for user, identity in metric["assignments"]:
        mapping[int(user)] = None if identity is None else tuple(identity)
    config = reference._configuration(base, mapping, kind)
    if config.configuration_id != metric["configuration_id"]:
        raise RuntimeError(f"configuration reconstruction mismatch for {kind}")
    return config


def _candidate(reference, base, seed, user: int, identity, kind: str):
    mapping = seed.mapping
    mapping[user] = identity
    return reference._configuration(base, mapping, kind)


def _joint_from_seed(reference, tape, step_index: int, base, seed) -> tuple[object, dict]:
    """Exhaust the archived joint construction from one supplied seed."""

    reference._WORKER_TAPE = tape
    evaluator = reference.ParallelSelectionEvaluator(tape, step_index, base, None)
    base_profile = evaluator.evaluate(base)
    seed_profile = evaluator.evaluate(seed)
    guard = reference.served(base_profile)
    options, census = reference.probe._legal_options(tape, step_index)

    best_alternatives = {}
    alternate_comparisons = 0
    for user in sorted(options):
        candidates = tuple(
            _candidate(
                reference,
                base,
                seed,
                user,
                identity,
                "reseeded-terminal-alternate",
            )
            for identity in options[user]
            if identity != seed.mapping[user]
        )
        evaluator.evaluate_many(candidates)
        alternate_comparisons += len(candidates)
        rows = []
        for candidate in candidates:
            profile = evaluator._evaluated.get(candidate.configuration_id)
            if profile is not None:
                rows.append(
                    (
                        reference.objective(profile),
                        candidate.configuration_id,
                        candidate.mapping[user],
                    )
                )
        if rows:
            best_alternatives[user] = min(rows, key=lambda row: (-row[0], row[1]))[2]

    candidates, aliases, family_counts = reference.build_joint_candidates(
        tape=tape,
        step_index=step_index,
        base=base,
        unilateral=seed,
        best_alternatives=best_alternatives,
    )
    before_joint = evaluator.physical_evaluations
    evaluator.evaluate_many(candidates)
    best = seed
    best_profile = seed_profile
    for candidate in candidates:
        profile = evaluator._evaluated.get(candidate.configuration_id)
        if profile is None or reference.served(profile) < guard:
            continue
        value = reference.objective(profile)
        best_value = reference.objective(best_profile)
        if value > best_value or (
            value == best_value
            and best is not seed
            and candidate.configuration_id < best.configuration_id
        ):
            best = candidate
            best_profile = profile

    if reference.served(best_profile) < guard:
        raise RuntimeError("joint selection violated the baseline served-count guard")
    if reference.objective(best_profile) < reference.objective(seed_profile):
        raise RuntimeError("joint selector returned an objective worse than its seed")

    changed = tuple(
        user
        for user in sorted(seed.mapping)
        if seed.mapping[user] != best.mapping[user]
    )
    strict = reference.objective(best_profile) > reference.objective(seed_profile)
    chosen_aliases = aliases.get(best.assignments, ()) if strict else ()
    return best, {
        "seed_configuration_id": seed.configuration_id,
        "baseline_served_guard": guard,
        "guard_reference": "BASELINE selection-time served_PHY count",
        "legal_option_census": census,
        "best_alternative_user_count": len(best_alternatives),
        "alternate_comparisons": alternate_comparisons,
        "joint_catalogue_unique": len(candidates),
        "joint_catalogue_aliases": sum(len(rows) for rows in aliases.values()),
        "joint_family_unique_counts": family_counts,
        "joint_unique_evaluations": evaluator.physical_evaluations - before_joint,
        "selection_physical_evaluations": evaluator.physical_evaluations,
        "strict_selection_objective_improvement": strict,
        "selection_objective_gain_bits": float(
            reference.objective(best_profile) - reference.objective(seed_profile)
        ),
        "selected_joint_served": reference.served(best_profile),
        "selected_coalition_size": len(changed) if strict else 0,
        "selected_coalition_users": list(changed) if strict else [],
        "selected_candidate_aliases": list(chosen_aliases),
        "selected_configuration_id": best.configuration_id,
    }


def _committed_profiles(reference, tape, step_index: int, base, configs):
    evaluator = reference.probe.StepEvaluator(
        tape,
        reference.probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=reference.probe.run_setting_for("a-r0"),
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    unique = {row.configuration_id: row for row in configs}
    # Score every committed action in its own dense call.  This makes an arm's
    # endpoint independent of which other arms happen to share this report and
    # exactly reproduces the archived scalar results on the difficult w1/s3
    # SEALED case (a five-row mixed batch differed at binary64 roundoff in the
    # iterative power solver, while a one-row call matches the archive).
    for config in unique.values():
        evaluator.evaluate_many((config,))
    profiles = {}
    for key, config in unique.items():
        profile = evaluator._evaluated.get(key)
        if profile is None:
            raise RuntimeError(f"invalid committed configuration: {key}")
        profiles[key] = profile
    return profiles


def _committed_metric(reference, profile) -> dict:
    attained = profile.score.rate_target_attained
    if attained is None:
        raise RuntimeError("a-r0 committed profile omitted rate-target attainment")
    metric = _metric_payload(reference, profile)
    metric["rate_target_attained_count"] = sum(bool(value) for value in attained.values())
    metric["rate_target_user_count"] = len(attained)
    return metric


def _source_metric(source: Mapping[str, object], re_evaluated: Mapping[str, object]) -> dict:
    """Preserve a standing receipt metric while adding its missing attainment count."""

    if source["configuration_id"] != re_evaluated["configuration_id"]:
        raise RuntimeError("source and re-evaluated configurations differ")
    if json.dumps(source["assignments"], separators=(",", ":")) != json.dumps(
        re_evaluated["assignments"], separators=(",", ":")
    ):
        raise RuntimeError("source and re-evaluated assignments differ")
    if int(source["served_count"]) != int(re_evaluated["served_count"]):
        raise RuntimeError("source and re-evaluated served counts differ")
    metric = dict(source)
    metric["rate_target_attained_count"] = re_evaluated[
        "rate_target_attained_count"
    ]
    metric["rate_target_user_count"] = re_evaluated["rate_target_user_count"]
    return metric


def _re_evaluation_delta(source: Mapping[str, object], re_evaluated: Mapping[str, object]) -> dict:
    return {
        key: float(re_evaluated[key]) - float(source[key])
        for key in ("bits", "joules", "ee_bit_per_j")
    }


def _algorithm_digest() -> str:
    functions = (
        _joint_from_seed,
        _committed_profiles,
        _committed_metric,
        _source_metric,
        _measure_anchor,
        _summarize,
    )
    source = "\n".join(inspect.getsource(function) for function in functions)
    return hashlib.sha256(source.encode("utf-8")).hexdigest()


def _gain(over: float, base: float) -> float:
    return over / base - 1.0


def _pool(rows: Sequence[Mapping[str, object]], arm: str) -> dict:
    metrics = [row["committed"][arm] for row in rows]
    bits = math.fsum(float(metric["bits"]) for metric in metrics)
    joules = math.fsum(float(metric["joules"]) for metric in metrics)
    return {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count_sum": sum(int(metric["served_count"]) for metric in metrics),
        "rate_target_attained_count_sum": sum(
            int(metric["rate_target_attained_count"]) for metric in metrics
        ),
        "rate_target_user_count_sum": sum(
            int(metric["rate_target_user_count"]) for metric in metrics
        ),
    }


PAIRINGS = (
    ("J_from_first", "U_first", "correctly_paired"),
    ("J_from_best", "U_best", "archived_pairing"),
    ("J_from_best", "U_first", "cross_old_joint_over_better_local"),
    ("J_from_first", "U_best", "cross_reseeded_joint_over_old_local"),
)


def _summarize(rows: Sequence[Mapping[str, object]]) -> dict:
    pooled = {arm: _pool(rows, arm) for arm in ARMS}
    pairings = {}
    for over, base, name in PAIRINGS:
        per_anchor = [
            {
                "anchor_id": row["anchor_id"],
                "relative_ee_gain": _gain(
                    float(row["committed"][over]["ee_bit_per_j"]),
                    float(row["committed"][base]["ee_bit_per_j"]),
                ),
            }
            for row in rows
        ]
        pairings[name] = {
            "over": over,
            "base": base,
            "pooled_relative_ee_gain": _gain(
                float(pooled[over]["ee_bit_per_j"]),
                float(pooled[base]["ee_bit_per_j"]),
            ),
            "negative_anchor_count": sum(
                row["relative_ee_gain"] < 0.0 for row in per_anchor
            ),
            "zero_anchor_count": sum(row["relative_ee_gain"] == 0.0 for row in per_anchor),
            "positive_anchor_count": sum(row["relative_ee_gain"] > 0.0 for row in per_anchor),
            "per_anchor": per_anchor,
        }

    ub = float(pooled["U_best"]["ee_bit_per_j"])
    uf = float(pooled["U_first"]["ee_bit_per_j"])
    jb = float(pooled["J_from_best"]["ee_bit_per_j"])
    jf = float(pooled["J_from_first"]["ee_bit_per_j"])
    archived = _gain(jb, ub)
    arithmetic = {
        "normalization": "U_best pooled EE",
        "search_order_U_first_minus_U_best": (uf - ub) / ub,
        "correct_coordination_J_from_first_minus_U_first": (jf - uf) / ub,
        "joint_seed_effect_J_from_best_minus_J_from_first": (jb - jf) / ub,
        "sum_equals_archived_span": archived,
    }
    if not math.isclose(
        sum(value for key, value in arithmetic.items() if key != "normalization" and key != "sum_equals_archived_span"),
        archived,
        rel_tol=0.0,
        abs_tol=2e-15,
    ):
        raise RuntimeError("arithmetic decomposition does not close")

    return {
        "anchor_count": len(rows),
        "pooled": pooled,
        "pairings": pairings,
        "joint_arms_same_configuration_count": sum(
            row["committed"]["J_from_best"]["configuration_id"]
            == row["committed"]["J_from_first"]["configuration_id"]
            for row in rows
        ),
        "selected_coalition_size_distribution": {
            arm: dict(
                sorted(
                    Counter(
                        str(row["joint_selection"][arm]["selected_coalition_size"])
                        for row in rows
                    ).items(),
                    key=lambda item: int(item[0]),
                )
            )
            for arm in ("J_from_best", "J_from_first")
        },
        "standing_metric_singleton_re_evaluation_max_abs_delta": {
            arm: {
                key: max(
                    abs(float(row["standing_metric_re_evaluation_delta"][arm][key]))
                    for row in rows
                )
                for key in ("bits", "joules", "ee_bit_per_j")
            }
"""One panel run: variant in, receipt out.

The anchor evaluation itself is not restated here.  It is imported verbatim
from the sealed reference runner (``harness.sealed.reference_runner``), which
is the exact file that produced the archived twenty-anchor receipts.  This
module supplies only what surrounds it: the panel, the named variant seam,
the caches, and the receipt.
"""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess
import sys
import time

from harness import panel as panel_module
from harness import sealed as sealed_module
from harness import variants as variants_module
from harness.cache import HarnessCache

ARMS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
SCHEMA = "mcrl-v025-perfect-knowledge-oracle-ceiling-v1"
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
REPO = Path(__file__).resolve().parents[1]

# Archived receipts label the two known variants with these formulation names.
FORMULATION_ALIAS = {"SEALED": "original", "MARGIN_Q": "margin"}


def _git(*args: str) -> str:
    try:
        return subprocess.check_output(
            ["git", *args], cwd=REPO, text=True, encoding="utf-8"
        ).strip()
    except (subprocess.CalledProcessError, OSError):
        return "UNAVAILABLE"


def install_variant(name: str):
    """Resolve a named variant and install it on the single physics seam.

    Returns ``(variant, installed, sealed_default)``.  For ``SEALED`` the
    installed object must be the very object the probe already holds; that
    identity is asserted here so a mis-registered SEALED cannot run at all.
    """

    reference = sealed_module.reference_runner()
    sealed_default = sealed_module.pristine_evaluator()
    variant = variants_module.get(name)
    installed = variant.build(sealed_module)
    if name == variants_module.DEFAULT_VARIANT and installed is not sealed_default:
        raise RuntimeError(
            "SEALED must resolve to the sealed evaluator object itself"
        )
    reference.probe.evaluate_ar_tdm_catalogue = installed
    return variant, installed, sealed_default


def run_panel(
    *,
    variant_name: str = variants_module.DEFAULT_VARIANT,
    panel_name: str = "FULL20",
    arms: tuple[str, ...] = ARMS,
    use_cache: bool = True,
    output: Path | None = None,
    progress: bool = True,
) -> dict:
    unknown = [arm for arm in arms if arm not in ARMS]
    if unknown:
        raise RuntimeError(f"unknown arms: {unknown}; known: {list(ARMS)}")
    tree = sealed_module.verify()
    reference = sealed_module.reference_runner()
    board = panel_module.get(panel_name)
    variant, installed, sealed_default = install_variant(variant_name)
    cache = HarnessCache(enabled=use_cache)

    from mcrl.physics_v025.provider_legacy import factory as real_factory

    started = time.perf_counter()
    anchors: list[dict] = []
    world_rows: list[dict] = []
    world_cache_hit: dict[int, bool] = {}
    anchor_cache_hit: list[bool] = []
    tapes: dict[int, object] = {}

    for world_index in board.worlds:
        domain = reference.probe.PROBE_WORLD_DOMAINS[world_index - 1]
        key = cache.world_key(
            sealed_manifest=tree.manifest_sha256,
            domain=domain,
            steps=board.tape_steps,
            start_time_s=0.0,
            provider="mcrl.physics_v025.provider_legacy.factory",
        )

        def build(domain=domain):
            return reference.probe.build_world_tape(
                domain=domain,
                provider=real_factory(),
                steps=board.tape_steps,
                start_time_s=0.0,
            )

        tape, meta, elapsed, hit = cache.world(key, build)
        tapes[world_index] = tape
        world_cache_hit[world_index] = hit
        world_rows.append({"world_index": world_index, "cache_key": key, **meta})
        if progress:
            print(
                json.dumps(
                    {
                        "world": domain,
                        "world_sha256": tape.digest,
                        "cache": "hit" if hit else "miss",
                        "seconds": elapsed,
                    },
                    sort_keys=True,
                ),
                flush=True,
            )

    for world_index, step_index in board.anchors:
        tape = tapes[world_index]
        key = cache.anchor_key(
            sealed_manifest=tree.manifest_sha256,
            variant=variant_name,
            variant_source=variant.source_sha256,
            world_sha256=tape.digest,
            step_index=step_index,
        )

        def build(tape=tape, world_index=world_index, step_index=step_index):
            reference._WORKER_TAPE = tape
            return reference.evaluate_anchor(
                tape=tape,
                world_index=world_index,
                step_index=step_index,
                pool=None,
            )

        row, hit = cache.anchor(key, build)
        anchors.append(row)
        anchor_cache_hit.append(hit)
        if progress:
            print(
                json.dumps(
                    {
                        "anchor": row["anchor_id"],
                        "cache": "hit" if hit else "miss",
                        "qualifying": row["selection"]["qualifying_coalition_existed"],
                        "oracle_ee_gain_pct": (
                            None
                            if row["committed"]["ORACLE_SET"][
                                "relative_ee_gain_over_UNILATERAL"
                            ]
                            is None
                            else 100.0
                            * row["committed"]["ORACLE_SET"][
                                "relative_ee_gain_over_UNILATERAL"
                            ]
                        ),
                        "wall_seconds": row["wall_seconds"],
                    },
                    sort_keys=True,
                ),
                flush=True,
            )

    measured = time.perf_counter() - started
    result = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM_CEILING,
        "variant": variant_name,
        "variant_description": variant.description,
        "variant_source": variant.source,
        "variant_source_sha256": variant.source_sha256,
        "formulation": FORMULATION_ALIAS.get(variant_name, variant_name.lower()),
        "panel": board.name,
        "panel_description": board.description,
        "panel_tape_steps": board.tape_steps,
        "reported_arms": list(arms),
        "arms_computed": list(ARMS),
        "arms_note": (
            "All three arms are always computed: ORACLE_SET is defined "
            "relative to UNILATERAL and both are guarded by the BASELINE "
            "served count. --arms restricts reporting, not computation."
        ),
        "sealed_manifest_sha256": tree.manifest_sha256,
        "sealed_file_count": tree.file_count,
        "probe_source_sha256": tree.probe_sha256,
        "source_commit": _git("rev-parse", "HEAD"),
        "source_tree": _git("rev-parse", "HEAD^{tree}"),
        "python": sys.executable,
        "python_version": platform.python_version(),
        "process_limit": 3,
        "processes_used": 1,
        "thread_environment": {
            name: os.environ.get(name)
            for name in (
                "OMP_NUM_THREADS",
                "OPENBLAS_NUM_THREADS",
                "MKL_NUM_THREADS",
                "NUMEXPR_NUM_THREADS",
            )
        },
        "test_split_opened": False,
        "learner_used": False,
        "ten_second_deadline": "IGNORED_BY_DESIGN_FOR_CEILING",
        "selection_objective": (
            "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s"
        ),
        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
        "service_guard": "selection-time served count >= BASELINE served count",
        "worlds": world_rows,
        "anchors": anchors,
        "summary": reference.summarize(anchors),
        "cache": {
            "enabled": use_cache,
            "root": str(cache.root) if use_cache else None,
            "world_cache_hit": {str(k): v for k, v in sorted(world_cache_hit.items())},
            "anchor_cache_hits": sum(anchor_cache_hit),
            "anchor_cache_misses": len(anchor_cache_hit) - sum(anchor_cache_hit),
            "stats": cache.stats.as_dict(),
        },
        "wall_seconds": measured,
        "wall_seconds_note": (
            "Measured wall time of this invocation. Anchor rows served from "
            "the anchor cache carry their original solve time in "
            "anchors[].wall_seconds; that time was not spent again."
        ),
        "synthetic_self_test": False,
    }
    unsigned = json.dumps(
        result, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")
    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
    if output is not None:
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(
            json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="ascii",
        )
    return result

