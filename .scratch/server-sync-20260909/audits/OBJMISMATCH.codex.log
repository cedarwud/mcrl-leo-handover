def config_at(run: UnilateralRun, seconds: float):
    selected = run.base
    for accepted_at, config in run.moves:
        if accepted_at > seconds:
            break
        selected = config
    return selected


def _best_alternatives_with_budget(
    reference,
    tape,
    step_index: int,
    base,
    seed,
    timed: TimedEvaluator,
    allowance: float,
):
    options, _ = reference.probe._legal_options(tape, step_index)
    best_alternatives: dict[int, tuple[int, int]] = {}
    comparisons = 0
    for user in sorted(options):
        candidates = tuple(
            _candidate(reference, base, seed, user, identity, "joint-seed-alternate")
            for identity in options[user]
            if identity != seed.mapping[user]
        )
        # Per-user batching matches the archived construction of a physically
        # best alternate, while allowing a budget check between users.
        if timed.elapsed() >= allowance:
            return None, comparisons, "alternate-sweep-budget"
        timed.evaluate_many(candidates)
        if timed.elapsed() > allowance:
            return None, comparisons, "alternate-sweep-budget"
        rows = []
        for candidate in candidates:
            comparisons += 1
            profile = timed.evaluator._evaluated.get(candidate.configuration_id)
            if profile is not None:
                rows.append(
                    (
                        reference.objective(profile),
                        candidate.configuration_id,
                        candidate.mapping[user],
                    )
                )
        if rows:
            best_alternatives[user] = min(rows, key=lambda row: (-row[0], row[1]))[2]
    return best_alternatives, comparisons, None


def deadline_joint_search(
    reference,
    tape,
    step_index: int,
    run: UnilateralRun,
    seed_seconds: float,
) -> tuple[object, dict[str, object]]:
    """Use only the time remaining to 30.08 s after obtaining a timed seed."""

    seed = config_at(run, seed_seconds)
    allowance = max(0.0, DEADLINE_SECONDS - seed_seconds)
    if allowance == 0.0:
        return seed, {
            "seed_seconds": seed_seconds,
            "joint_allowance_seconds": 0.0,
            "joint_wall_seconds": 0.0,
            "total_end_to_end_seconds": seed_seconds,
            "stopped_phase": "no-budget-after-seed",
            "catalogue_complete": False,
            "catalogue_unique": 0,
            "joint_candidates_completed": 0,
            "joint_improvements_accepted": 0,
            "selected": _config_payload(seed),
        }

    started = time.perf_counter()
    timed = TimedEvaluator.create(reference, tape, step_index, run.base, started)
    available_profiles = {
        key: profile
        for key, profile in run.finding_profiles.items()
        if run.finding_completed_at.get(key, math.inf) <= seed_seconds
    }
    available_invalid = {
        key
        for key in run.finding_invalid
        if run.finding_completed_at.get(key, math.inf) <= seed_seconds
    }
    timed.preload(available_profiles, tuple(available_invalid))
    seed_profile = timed.evaluator._evaluated.get(seed.configuration_id)
    if seed_profile is None:
        seed_profile = timed.profile(seed)
    base_profile = timed.evaluator._evaluated.get(run.base.configuration_id)
    if base_profile is None:
        base_profile = timed.profile(run.base)
    if seed_profile is None or base_profile is None:
        raise RuntimeError("joint search seed or base is invalid")
    guard = reference.served(base_profile)
    best = seed
    best_profile = seed_profile

    alternatives, alternate_comparisons, stopped = _best_alternatives_with_budget(
        reference, tape, step_index, run.base, seed, timed, allowance
    )
    candidates: tuple[object, ...] = ()
    aliases = {}
    family_counts = {}
    completed = 0
    improvements = 0
    catalogue_complete = False
    crossed_budget_by = 0.0

    if alternatives is not None:
        candidates, aliases, family_counts = reference.build_joint_candidates(
            tape=tape,
            step_index=step_index,
            base=run.base,
            unilateral=seed,
            best_alternatives=alternatives,
        )
        catalogue_complete = True
        if timed.elapsed() > allowance:
            stopped = "catalogue-construction-budget"
        else:
            stopped = "catalogue-exhausted"
            for offset in range(0, len(candidates), JOINT_BATCH_SIZE):
                if timed.elapsed() >= allowance:
                    stopped = "joint-evaluation-budget"
                    break
                batch = candidates[offset : offset + JOINT_BATCH_SIZE]
                timed.evaluate_many(batch)
                elapsed = timed.elapsed()
                if elapsed > allowance:
                    crossed_budget_by = elapsed - allowance
                    stopped = "joint-evaluation-budget"
                    break
                completed += len(batch)
                for candidate in batch:
                    profile = timed.evaluator._evaluated.get(candidate.configuration_id)
                    if profile is None or reference.served(profile) < guard:
                        continue
                    value = reference.objective(profile)
                    best_value = reference.objective(best_profile)
                    if value > best_value or (
                        value == best_value
                        and best is not seed
                        and candidate.configuration_id < best.configuration_id
                    ):
                        best = candidate
                        best_profile = profile
                        improvements += 1

    elapsed = timed.elapsed()
    available_at = (
        seed_seconds + elapsed
        if stopped == "catalogue-exhausted"
        else DEADLINE_SECONDS
    )
    return best, {
        "seed_seconds": seed_seconds,
        "joint_allowance_seconds": allowance,
        "unilateral_cache_profiles_available": len(available_profiles),
        "unilateral_cache_invalid_available": len(available_invalid),
        "alternate_comparisons": alternate_comparisons,
        "joint_wall_seconds": elapsed,
        "budget_crossing_overshoot_seconds": crossed_budget_by,
        "total_end_to_end_seconds": available_at,
        "stopped_phase": stopped,
        "catalogue_complete": catalogue_complete,
        "catalogue_unique": len(candidates),
        "catalogue_aliases": sum(len(rows) for rows in aliases.values()),
        "family_unique_counts": family_counts,
        "joint_microbatch_size": JOINT_BATCH_SIZE,
        "joint_candidates_completed": completed,
        "joint_improvements_accepted": improvements,
        "selected": _config_payload(best),
    }


def _committed_profiles(reference, tape, step_index: int, base, configs):
    evaluator = reference.probe.StepEvaluator(
        tape,
        reference.probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=reference.probe.run_setting_for("a-r0"),
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    unique = {row.configuration_id: row for row in configs}
    evaluator.evaluate_many(tuple(unique.values()))
    return {
        key: evaluator._evaluated[value.configuration_id]
        for key, value in unique.items()
        if value.configuration_id in evaluator._evaluated
    }


def measure_anchor(reference, tape, world_index: int, step_index: int, archived) -> dict:
    run = first_improvement_unilateral(reference, tape, step_index)
    checkpoint_configs = {
        f"{seconds:g}": config_at(run, seconds) for seconds in CHECKPOINTS
    }
    checkpoint_configs["convergence"] = run.selected
    joint_configs = {}
    joint_rows = {}
    for seconds in JOINT_SEED_SECONDS:
        key = f"{seconds:g}"
        joint_configs[key], joint_rows[key] = deadline_joint_search(
            reference, tape, step_index, run, seconds
        )

    all_configs = [run.base, *checkpoint_configs.values(), *joint_configs.values()]
    committed = _committed_profiles(
        reference, tape, step_index, run.base, all_configs
    )

    def metric(config):
        try:
            return _metric_payload(reference, committed[config.configuration_id])
        except KeyError:
            raise RuntimeError(
                f"committed configuration invalid: {config.configuration_id}"
            ) from None

    base_metric = metric(run.base)
    checkpoints = {key: metric(config) for key, config in checkpoint_configs.items()}
    for key, config in joint_configs.items():
        joint_rows[key]["committed"] = metric(config)

    archived_unilateral = archived["committed"]["UNILATERAL"]
    return {
        "anchor_id": f"V025_PROBE_R2/world/{world_index}:step/{step_index}",
        "world_index": world_index,
        "step_index": step_index,
        "world_domain": tape.domain,
        "world_sha256": tape.digest,
        "baseline": base_metric,
        "unilateral": run.receipt,
        "checkpoints": checkpoints,
        "joint_within_30_08": joint_rows,
        "first_improvement_fixed_point_matches_archived_best_improvement": (
            checkpoints["convergence"]["assignments"]
            == archived_unilateral["assignments"]
        ),
        "archived_best_improvement": archived_unilateral,
    }


def _pool_metrics(rows: Sequence[Mapping[str, object]], accessor) -> dict[str, object]:
    metrics = [accessor(row) for row in rows]
    bits = math.fsum(float(row["bits"]) for row in metrics)
    joules = math.fsum(float(row["joules"]) for row in metrics)
    return {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count_sum": sum(int(row["served_count"]) for row in metrics),
    }


def _gain(numerator: float, denominator: float) -> float:
    return numerator / denominator - 1.0


def summarize(rows: Sequence[Mapping[str, object]]) -> dict[str, object]:
    baseline = _pool_metrics(rows, lambda row: row["baseline"])
    archived_convergence = _pool_metrics(
        rows, lambda row: row["archived_best_improvement"]
    )
    curve = {}
    for key in (*[f"{value:g}" for value in CHECKPOINTS], "convergence"):
        pooled = _pool_metrics(rows, lambda row, key=key: row["checkpoints"][key])
        per_anchor_gain = [
            _gain(
                float(row["checkpoints"][key]["ee_bit_per_j"]),
                float(row["baseline"]["ee_bit_per_j"]),
            )
            for row in rows
        ]
        curve[key] = {
            "pooled": pooled,
            "pooled_gain_over_baseline": _gain(
                float(pooled["ee_bit_per_j"]), float(baseline["ee_bit_per_j"])
            ),
            "paired_anchor_gain_over_baseline_distribution": distribution(per_anchor_gain),
            "per_anchor_gain_over_baseline": [
                {"anchor_id": row["anchor_id"], "gain": value}
                for row, value in zip(rows, per_anchor_gain)
            ],
        }

    deadline_gain = float(curve["30.08"]["pooled_gain_over_baseline"])
    converged_gain = float(curve["convergence"]["pooled_gain_over_baseline"])
    archived_converged_gain = _gain(
        float(archived_convergence["ee_bit_per_j"]),
        float(baseline["ee_bit_per_j"]),
    )
    anchor_fractions = []
    archived_anchor_fractions = []
    for row in rows:
        base_ee = float(row["baseline"]["ee_bit_per_j"])
        deadline_ee = float(row["checkpoints"]["30.08"]["ee_bit_per_j"])
        converged_ee = float(row["checkpoints"]["convergence"]["ee_bit_per_j"])
        denominator = converged_ee - base_ee
        fraction = None if denominator == 0.0 else (deadline_ee - base_ee) / denominator
        anchor_fractions.append({"anchor_id": row["anchor_id"], "fraction": fraction})
        archived_ee = float(row["archived_best_improvement"]["ee_bit_per_j"])
        archived_denominator = archived_ee - base_ee
        archived_fraction = (
            None
            if archived_denominator == 0.0
            else (deadline_ee - base_ee) / archived_denominator
        )
        archived_anchor_fractions.append(
            {"anchor_id": row["anchor_id"], "fraction": archived_fraction}
        )
    defined_fractions = [
        float(row["fraction"]) for row in anchor_fractions if row["fraction"] is not None
    ]
    defined_archived_fractions = [
        float(row["fraction"])
        for row in archived_anchor_fractions
        if row["fraction"] is not None
    ]

    certification = {
        "finding_seconds": distribution(
            [float(row["unilateral"]["finding_seconds"]) for row in rows]
        ),
        "last_improvement_seconds": distribution(
            [float(row["unilateral"]["last_improvement_seconds"]) for row in rows]
        ),
        "terminal_certificate_seconds": distribution(
            [float(row["unilateral"]["terminal_certificate_seconds"]) for row in rows]
        ),
        "total_including_certificate_seconds": distribution(
            [
                float(row["unilateral"]["measured_total_including_certificate_seconds"])
                for row in rows
            ]
        ),
        "per_anchor": [
            {
                "anchor_id": row["anchor_id"],
                "finding_seconds": row["unilateral"]["finding_seconds"],
                "last_improvement_seconds": row["unilateral"]["last_improvement_seconds"],
                "terminal_certificate_seconds": row["unilateral"][
                    "terminal_certificate_seconds"
                ],
                "total_including_certificate_seconds": row["unilateral"][
                    "measured_total_including_certificate_seconds"
                ],
            }
            for row in rows
        ],
    }

    joint = {}
    for seed_key in (f"{value:g}" for value in JOINT_SEED_SECONDS):
        pooled = _pool_metrics(
            rows, lambda row, seed_key=seed_key: row["joint_within_30_08"][seed_key]["committed"]
        )
        joint[seed_key] = {
            "pooled": pooled,
            "pooled_gain_over_baseline": _gain(
                float(pooled["ee_bit_per_j"]), float(baseline["ee_bit_per_j"])
            ),
            "fraction_of_archived_best_improvement_prize": (
                None
                if archived_converged_gain == 0.0
                else _gain(
                    float(pooled["ee_bit_per_j"]),
                    float(baseline["ee_bit_per_j"]),
                )
                / archived_converged_gain
            ),
            "total_end_to_end_seconds_distribution": distribution(
                [
                    float(row["joint_within_30_08"][seed_key]["total_end_to_end_seconds"])
                    for row in rows
                ]
            ),
            "catalogue_completed_anchor_count": sum(
                row["joint_within_30_08"][seed_key]["stopped_phase"]
                == "catalogue-exhausted"
                for row in rows
            ),
            "anchors_with_joint_improvement": sum(
                row["joint_within_30_08"][seed_key]["committed"]["assignments"]
                != row["checkpoints"][seed_key]["assignments"]
                for row in rows
            ),
            "per_anchor": [
                {
                    "anchor_id": row["anchor_id"],
                    **row["joint_within_30_08"][seed_key],
                }
                for row in rows
            ],
        }

    return {
        "anchor_count": len(rows),
        "baseline_pooled": baseline,
        "archived_best_improvement_pooled": archived_convergence,
        "archived_best_improvement_gain_over_baseline": archived_converged_gain,
        "anytime_curve": curve,
        "deadline_prize_fraction": (
            None if converged_gain == 0.0 else deadline_gain / converged_gain
        ),
        "deadline_prize_fraction_distribution": distribution(defined_fractions),
        "deadline_prize_fraction_per_anchor": anchor_fractions,
        "worst_anchor_at_deadline": (
            None
            if not defined_fractions
            else min(
                (row for row in anchor_fractions if row["fraction"] is not None),
                key=lambda row: row["fraction"],
            )
def _algorithm_digest() -> str:
    functions = (
        _joint_from_seed,
        _committed_profiles,
        _committed_metric,
        _source_metric,
        _measure_anchor,
        _summarize,
    )
    source = "\n".join(inspect.getsource(function) for function in functions)
    return hashlib.sha256(source.encode("utf-8")).hexdigest()


def _gain(over: float, base: float) -> float:
    return over / base - 1.0


def _pool(rows: Sequence[Mapping[str, object]], arm: str) -> dict:
    metrics = [row["committed"][arm] for row in rows]
    bits = math.fsum(float(metric["bits"]) for metric in metrics)
    joules = math.fsum(float(metric["joules"]) for metric in metrics)
    return {
        "bits": bits,
        "joules": joules,
        "ee_bit_per_j": bits / joules,
        "served_count_sum": sum(int(metric["served_count"]) for metric in metrics),
        "rate_target_attained_count_sum": sum(
            int(metric["rate_target_attained_count"]) for metric in metrics
        ),
        "rate_target_user_count_sum": sum(
            int(metric["rate_target_user_count"]) for metric in metrics
        ),
    }


PAIRINGS = (
    ("J_from_first", "U_first", "correctly_paired"),
    ("J_from_best", "U_best", "archived_pairing"),
    ("J_from_best", "U_first", "cross_old_joint_over_better_local"),
    ("J_from_first", "U_best", "cross_reseeded_joint_over_old_local"),
)


def _summarize(rows: Sequence[Mapping[str, object]]) -> dict:
    pooled = {arm: _pool(rows, arm) for arm in ARMS}
    pairings = {}
    for over, base, name in PAIRINGS:
        per_anchor = [
            {
                "anchor_id": row["anchor_id"],
                "relative_ee_gain": _gain(
                    float(row["committed"][over]["ee_bit_per_j"]),
                    float(row["committed"][base]["ee_bit_per_j"]),
                ),
            }
            for row in rows
        ]
        pairings[name] = {
            "over": over,
            "base": base,
            "pooled_relative_ee_gain": _gain(
                float(pooled[over]["ee_bit_per_j"]),
                float(pooled[base]["ee_bit_per_j"]),
            ),
            "negative_anchor_count": sum(
                row["relative_ee_gain"] < 0.0 for row in per_anchor
            ),
            "zero_anchor_count": sum(row["relative_ee_gain"] == 0.0 for row in per_anchor),
            "positive_anchor_count": sum(row["relative_ee_gain"] > 0.0 for row in per_anchor),
            "per_anchor": per_anchor,
        }

    ub = float(pooled["U_best"]["ee_bit_per_j"])
    uf = float(pooled["U_first"]["ee_bit_per_j"])
    jb = float(pooled["J_from_best"]["ee_bit_per_j"])
    jf = float(pooled["J_from_first"]["ee_bit_per_j"])
    archived = _gain(jb, ub)
    arithmetic = {
        "normalization": "U_best pooled EE",
        "search_order_U_first_minus_U_best": (uf - ub) / ub,
        "correct_coordination_J_from_first_minus_U_first": (jf - uf) / ub,
        "joint_seed_effect_J_from_best_minus_J_from_first": (jb - jf) / ub,
        "sum_equals_archived_span": archived,
    }
    if not math.isclose(
        sum(value for key, value in arithmetic.items() if key != "normalization" and key != "sum_equals_archived_span"),
        archived,
        rel_tol=0.0,
        abs_tol=2e-15,
    ):
        raise RuntimeError("arithmetic decomposition does not close")

    return {
        "anchor_count": len(rows),
        "pooled": pooled,
        "pairings": pairings,
        "joint_arms_same_configuration_count": sum(
            row["committed"]["J_from_best"]["configuration_id"]
            == row["committed"]["J_from_first"]["configuration_id"]
            for row in rows
        ),
        "selected_coalition_size_distribution": {
            arm: dict(
                sorted(
                    Counter(
                        str(row["joint_selection"][arm]["selected_coalition_size"])
                        for row in rows
                    ).items(),
                    key=lambda item: int(item[0]),
                )
            )
            for arm in ("J_from_best", "J_from_first")
        },
        "standing_metric_singleton_re_evaluation_max_abs_delta": {
            arm: {
                key: max(
                    abs(float(row["standing_metric_re_evaluation_delta"][arm][key]))
                    for row in rows
                )
                for key in ("bits", "joules", "ee_bit_per_j")
            }
            for arm in ("BASELINE", "U_best", "U_first", "J_from_best")
        },
        "archived_span_decomposition_additive_relative_to_U_best": arithmetic,
        "archived_span_decomposition_multiplicative": {
            "search_order_U_first_over_U_best": _gain(uf, ub),
            "correct_coordination_J_from_first_over_U_first": _gain(jf, uf),
            "joint_seed_effect_J_from_best_over_J_from_first": _gain(jb, jf),
            "product_minus_one_equals_archived_span": archived,
        },
    }


def _measure_anchor(reference, tape, world_index: int, step_index: int, archived, anytime) -> dict:
    base = reference.probe._base_configuration(tape, step_index, "nearest-eligible")
    archived_committed = archived["committed"]
    u_first_metric = anytime["checkpoints"]["convergence"]
    if base.configuration_id != archived_committed["BASELINE"]["configuration_id"]:
        raise RuntimeError("generated baseline does not match archive")
    u_best = _configuration(reference, base, archived_committed["UNILATERAL"], "reseeded-U-best")
    u_first = _configuration(reference, base, u_first_metric, "reseeded-U-first")

    j_best, select_best = _joint_from_seed(reference, tape, step_index, base, u_best)
    j_first, select_first = _joint_from_seed(reference, tape, step_index, base, u_first)
    if j_best.configuration_id != archived_committed["ORACLE_SET"]["configuration_id"]:
        raise RuntimeError("J_from_best did not reproduce the archived joint selector")

    configs = {
        "BASELINE": base,
        "U_best": u_best,
        "U_first": u_first,
        "J_from_best": j_best,
        "J_from_first": j_first,
    }
    profiles = _committed_profiles(reference, tape, step_index, base, tuple(configs.values()))
    re_evaluated = {
        arm: _committed_metric(reference, profiles[config.configuration_id])
        for arm, config in configs.items()
    }
    sources = {
        "BASELINE": archived_committed["BASELINE"],
        "U_best": archived_committed["UNILATERAL"],
        "U_first": u_first_metric,
        "J_from_best": archived_committed["ORACLE_SET"],
    }
    committed = {
        arm: _source_metric(source, re_evaluated[arm])
        for arm, source in sources.items()
    }
    committed["J_from_first"] = re_evaluated["J_from_first"]

    return {
        "anchor_id": archived["anchor_id"],
        "world_index": world_index,
        "step_index": step_index,
        "world_sha256": tape.digest,
        "guard_reference": "BASELINE selection-time served_PHY count for both joint arms",
        "committed": committed,
        "committed_metric_source": {
            "BASELINE": "archived standing-harness receipt",
            "U_best": "archived standing-harness receipt",
            "U_first": "completed anytime receipt",
            "J_from_best": "archived standing-harness receipt",
            "J_from_first": "new singleton 48-boundary evaluation",
        },
        "standing_metric_re_evaluation_delta": {
            arm: _re_evaluation_delta(source, re_evaluated[arm])
            for arm, source in sources.items()
        },
        "joint_selection": {
            "J_from_best": select_best,
            "J_from_first": select_first,
        },
        "joint_arms_same_configuration": j_best.configuration_id == j_first.configuration_id,
    }


def run_variant(variant_name: str, output: Path, resume: bool = False) -> dict:
    if variant_name not in ARCHIVED:
        raise RuntimeError(f"unsupported variant: {variant_name}")
    tree = sealed_module.verify()
    reference = sealed_module.reference_runner()
    variant, _installed, _sealed = install_variant(variant_name)
    archived_receipt = _load_receipt(ARCHIVED[variant_name])
    anytime_receipt = _load_receipt(ANYTIME[variant_name])
    if not anytime_receipt.get("complete") or len(anytime_receipt["anchors"]) != 20:
        raise RuntimeError("first-improvement receipt is not a complete converged panel")
    first_digest = hashlib.sha256(FIRST_IMPROVEMENT_IMPLEMENTATION.read_bytes()).hexdigest()
    runner_digest = _algorithm_digest()
    reference_digest = hashlib.sha256(sealed_module.REFERENCE_RUNNER.read_bytes()).hexdigest()

    payload = {
        "schema": SCHEMA,
        "claim_ceiling": CLAIM_CEILING,
        "complete": False,
        "variant": variant_name,
        "panel": panel_module.FULL20.name,
        "variant_source_sha256": variant.source_sha256,
        "sealed_manifest_sha256": tree.manifest_sha256,
        "probe_source_sha256": tree.probe_sha256,
        "archived_receipt": str(ARCHIVED[variant_name].relative_to(REPO)),
        "archived_receipt_sha256": archived_receipt["receipt_sha256"],
        "anytime_receipt": str(ANYTIME[variant_name].relative_to(REPO)),
        "anytime_receipt_sha256": anytime_receipt["receipt_sha256"],
        "first_improvement_implementation": str(FIRST_IMPROVEMENT_IMPLEMENTATION.relative_to(REPO)),
        "first_improvement_implementation_sha256": first_digest,
        "reseeded_span_implementation": str(RUNNER_IMPLEMENTATION.relative_to(REPO)),
        "reseeded_span_algorithm_sha256": runner_digest,
        "catalogue_implementation": str(sealed_module.REFERENCE_RUNNER.relative_to(REPO)),
        "catalogue_implementation_sha256": reference_digest,
        "catalogue_builder": "the same reference.build_joint_candidates function is invoked for both seeds",
        "catalogue_constants": {
            "occupant_subset_max_size": reference.OCCUPANT_SUBSET_MAX_SIZE,
            "occupant_subset_total_cap": reference.OCCUPANT_SUBSET_TOTAL_CAP,
            "joint_candidate_cap": reference.JOINT_CANDIDATE_CAP,
        },
        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0",
        "tie_break": "higher F, then lexicographically smaller configuration_id among non-seed candidates",
        "service_guard": "each joint arm requires selection-time served_PHY count >= its anchor's BASELINE selection-time served_PHY count",
        "deadline": "none; both bounded catalogues are exhausted",
        "committed_endpoint": "standing metrics retained from their source receipts; new J_from_first and rate-target attainment evaluated over the realised 48-boundary endpoint at fading_quantile_alpha=0.10",
        "arms": list(ARMS),
        "anchors": [],
        "worlds": [],
    }
    if resume and output.exists():
        old = _load_receipt(output)
        for key in (
            "schema",
            "variant",
            "sealed_manifest_sha256",
            "variant_source_sha256",
            "archived_receipt_sha256",
            "anytime_receipt_sha256",
            "first_improvement_implementation_sha256",
            "catalogue_implementation_sha256",
        ):
            if old.get(key) != payload.get(key):
                raise RuntimeError(f"cannot resume: receipt mismatch in {key}")
        payload["anchors"] = old["anchors"]

    archive_by_id = {row["anchor_id"]: row for row in archived_receipt["anchors"]}
    anytime_by_id = {row["anchor_id"]: row for row in anytime_receipt["anchors"]}
    completed = {row["anchor_id"] for row in payload["anchors"]}
    cache = HarnessCache(enabled=True)
    tapes = {}
    from mcrl.physics_v025.provider_legacy import factory as real_factory

    for world_index in panel_module.FULL20.worlds:
        domain = reference.probe.PROBE_WORLD_DOMAINS[world_index - 1]
        key = cache.world_key(
            sealed_manifest=tree.manifest_sha256,
            domain=domain,
            steps=panel_module.FULL20.tape_steps,
            start_time_s=0.0,
            provider="mcrl.physics_v025.provider_legacy.factory",
        )
        tape, meta, elapsed, hit = cache.world(
            key,
            lambda domain=domain: reference.probe.build_world_tape(
                domain=domain,
                provider=real_factory(),
                steps=panel_module.FULL20.tape_steps,
                start_time_s=0.0,
            ),
        )
        tapes[world_index] = tape
        payload["worlds"].append(
            {
                "world_index": world_index,
                "world_sha256": tape.digest,
                "cache_hit": hit,
                "load_or_construction_seconds": elapsed,
                **meta,
            }
        )

    for world_index, step_index in panel_module.FULL20.anchors:
        anchor_id = f"V025_PROBE_R2/world/{world_index}:step/{step_index}"
        if anchor_id in completed:
            continue
        print(json.dumps({"starting_anchor": anchor_id, "variant": variant_name}), flush=True)
        row = _measure_anchor(
            reference,
            tapes[world_index],
            world_index,
            step_index,
            archive_by_id[anchor_id],
            anytime_by_id[anchor_id],
        )
        payload["anchors"].append(row)
        payload["anchors"].sort(key=lambda item: (item["world_index"], item["step_index"]))
        payload["summary"] = _summarize(payload["anchors"])
        _write_receipt(payload, output)
        print(
            json.dumps(
                {
                    "finished_anchor": anchor_id,
                    "J_from_best_size": row["joint_selection"]["J_from_best"]["selected_coalition_size"],
                    "J_from_first_size": row["joint_selection"]["J_from_first"]["selected_coalition_size"],
                    "same_joint_configuration": row["joint_arms_same_configuration"],
                },
                sort_keys=True,
            ),
            flush=True,
        )

    payload["complete"] = len(payload["anchors"]) == len(panel_module.FULL20.anchors)
    payload["summary"] = _summarize(payload["anchors"])
    _write_receipt(payload, output)
    return payload


def _pct(value: float) -> str:
    return f"{100.0 * value:+.4f}%"


def _short_anchor(anchor_id: str) -> str:
    return anchor_id.replace("V025_PROBE_R2/world/", "w").replace(":step/", "/s")


def _display_path(path: Path) -> Path:
    resolved = path.resolve()
    try:
        return resolved.relative_to(REPO)
    except ValueError:
        return path


def build_report(sealed_path: Path, margin_path: Path) -> str:
    receipts = {
        "SEALED": _load_receipt(sealed_path),
        "MARGIN_Q": _load_receipt(margin_path),
    }
    for name, receipt in receipts.items():
        if not receipt.get("complete") or receipt.get("variant") != name:
            raise RuntimeError(f"incomplete or mismatched receipt: {name}")

    correct = {
        name: receipt["summary"]["pairings"]["correctly_paired"]["pooled_relative_ee_gain"]
        for name, receipt in receipts.items()
    }
    negative = {
        name: receipt["summary"]["pairings"]["correctly_paired"]["negative_anchor_count"]
        for name, receipt in receipts.items()
    }
    lead_qualifier = (
        "Near-zero/negative correctly paired coordination span"
        if any(value <= 0.005 for value in correct.values())
        else "Correctly paired coordination span"
    )
    lines = [
        f"**{lead_qualifier} (`J_from_first` over `U_first`): `SEALED` {_pct(correct['SEALED'])} ({negative['SEALED']}/20 negative anchors); `MARGIN_Q` {_pct(correct['MARGIN_Q'])} ({negative['MARGIN_Q']}/20 negative anchors).**",
        "",
        "# Reseeded coordination span — V0.25 twenty-anchor panel",
        "",
        "`DIAGNOSTIC_NOT_CLAIM`. No learner, training run, or policy run was performed. No sealed constant, threshold, sign, seed, horizon, price, service guard, acceptance rule, sealed artefact, or frozen manifest was changed.",
        "",
        "## Direct answers",
        "",
    ]
    sp = receipts["SEALED"]["summary"]["pairings"]
    mp = receipts["MARGIN_Q"]["summary"]["pairings"]
    strict = {
        name: sum(
            bool(row["joint_selection"]["J_from_first"]["strict_selection_objective_improvement"])
            for row in receipt["anchors"]
        )
        for name, receipt in receipts.items()
    }
    lines.extend([
        f"1. **Same-search coordination span:** **SEALED {_pct(sp['correctly_paired']['pooled_relative_ee_gain'])}**; **MARGIN_Q {_pct(mp['correctly_paired']['pooled_relative_ee_gain'])}**.",
        "",
        f"2. **Does the joint selector beat its own better seed?** In the selection-time objective, yes: strict improvement on {strict['SEALED']}/20 `SEALED` anchors and {strict['MARGIN_Q']}/20 `MARGIN_Q` anchors. In committed EE, `SEALED` is positive/zero/negative on {sp['correctly_paired']['positive_anchor_count']}/{sp['correctly_paired']['zero_anchor_count']}/{sp['correctly_paired']['negative_anchor_count']} anchors; `MARGIN_Q` is {mp['correctly_paired']['positive_anchor_count']}/{mp['correctly_paired']['zero_anchor_count']}/{mp['correctly_paired']['negative_anchor_count']}. The signed per-anchor values are below.",
        "",
        f"3. **How much was search-order artefact?** The archived headline changes from {_pct(sp['archived_pairing']['pooled_relative_ee_gain'])} to {_pct(sp['correctly_paired']['pooled_relative_ee_gain'])} under `SEALED`, an overstatement of {100.0 * (sp['archived_pairing']['pooled_relative_ee_gain'] - sp['correctly_paired']['pooled_relative_ee_gain']):.4f} percentage points. Under `MARGIN_Q`, it changes from {_pct(mp['archived_pairing']['pooled_relative_ee_gain'])} to {_pct(mp['correctly_paired']['pooled_relative_ee_gain'])}, an understatement of {100.0 * (mp['correctly_paired']['pooled_relative_ee_gain'] - mp['archived_pairing']['pooled_relative_ee_gain']):.4f} points. The exact three-way decomposition below separates unilateral search order, correctly paired coordination, and joint-seed effect.",
    ])
    lines.extend([
        "",
        "The selection-time and committed signs answer different questions: selection uses the fixed one-boundary exact `F`, while the reported coordination span uses the 48-boundary committed EE.",
        "",
        "## Pooled committed endpoint",
        "",
        "Efficiency is pooled as `sum(bits) / sum(joules)` over the same twenty anchors.",
        "",
        "| rule | arm | bits (Tbit) | joules | EE (Mbit/J) |",
        "|---|---|---:|---:|---:|",
    ])
    for name in ("SEALED", "MARGIN_Q"):
        pooled = receipts[name]["summary"]["pooled"]
        for arm in ARMS:
            row = pooled[arm]
            lines.append(
                f"| `{name}` | `{arm}` | {row['bits'] / 1e12:.6f} | {row['joules']:.6f} | {row['ee_bit_per_j'] / 1e6:.6f} |"
            )

    lines.extend([
        "",
        "## Served count and rate-target attainment (separate outcomes)",
        "",
        "`served_PHY` counts positive realised decoding time. `rate_target_attained` counts users whose integrated committed bits reach the fixed rate target. They are reported independently and are not combined into one service measure.",
        "",
        "| rule | arm | served_PHY count | rate-target attained | anchor-user observations |",
        "|---|---|---:|---:|---:|",
    ])
    for name in ("SEALED", "MARGIN_Q"):
        pooled = receipts[name]["summary"]["pooled"]
        for arm in ARMS:
            row = pooled[arm]
            lines.append(
                f"| `{name}` | `{arm}` | {row['served_count_sum']} | {row['rate_target_attained_count_sum']} | {row['rate_target_user_count_sum']} |"
            )

    lines.extend([
        "",
        "## All four pairings",
        "",
        "| rule | pairing | pooled EE gain | negative / zero / positive anchors |",
        "|---|---|---:|---:|",
    ])
    pairing_order = (
        ("correctly_paired", "`J_from_first` over `U_first` — correct"),
        ("archived_pairing", "`J_from_best` over `U_best` — archived"),
        ("cross_old_joint_over_better_local", "`J_from_best` over `U_first` — cross"),
        ("cross_reseeded_joint_over_old_local", "`J_from_first` over `U_best` — cross"),
    )
    for name in ("SEALED", "MARGIN_Q"):
        pairings = receipts[name]["summary"]["pairings"]
        for key, label in pairing_order:
            row = pairings[key]
            lines.append(
                f"| `{name}` | {label} | {_pct(row['pooled_relative_ee_gain'])} | {row['negative_anchor_count']} / {row['zero_anchor_count']} / {row['positive_anchor_count']} |"
            )

    lines.extend([
        "",
        "## Does each joint selector beat its own seed?",
        "",
        "Each cell is the anchor-local committed-EE gain and its sign. Selection was by the fixed one-boundary exact `F`, so a negative committed-EE cell does not imply that the selector accepted a negative selection-objective move.",
        "",
        "| anchor | SEALED `J_best/U_best` | SEALED `J_first/U_first` | MARGIN_Q `J_best/U_best` | MARGIN_Q `J_first/U_first` |",
        "|---|---:|---:|---:|---:|",
    ])
    per = {}
    for name in ("SEALED", "MARGIN_Q"):
        pair = receipts[name]["summary"]["pairings"]
        per[name] = {
            "best": {row["anchor_id"]: row["relative_ee_gain"] for row in pair["archived_pairing"]["per_anchor"]},
            "first": {row["anchor_id"]: row["relative_ee_gain"] for row in pair["correctly_paired"]["per_anchor"]},
        }
    for anchor_id in per["SEALED"]["best"]:
        values = (
            per["SEALED"]["best"][anchor_id],
            per["SEALED"]["first"][anchor_id],
            per["MARGIN_Q"]["best"][anchor_id],
            per["MARGIN_Q"]["first"][anchor_id],
        )
        cells = " | ".join(_pct(value) for value in values)
        lines.append(f"| {_short_anchor(anchor_id)} | {cells} |")

    lines.extend([
        "",
        "## Search-order artefact and exact decomposition",
        "",
        "The archived pooled span is decomposed additively in EE, with every term divided by `U_best` EE:",
        "",
        "`(J_best − U_best) / U_best = (U_first − U_best) / U_best + (J_first − U_first) / U_best + (J_best − J_first) / U_best`.",
        "",
        "The three terms are respectively the unilateral search-order effect, correctly paired coordination (expressed on the archived denominator), and the joint-seed effect. This is an exact accounting identity, not a causal model.",
        "",
        "| rule | archived span | search-order term | correct coordination term | joint-seed term | search-order / archived |",
        "|---|---:|---:|---:|---:|---:|",
    ])
    for name in ("SEALED", "MARGIN_Q"):
        s = receipts[name]["summary"]
        d = s["archived_span_decomposition_additive_relative_to_U_best"]
        archived = d["sum_equals_archived_span"]
        search = d["search_order_U_first_minus_U_best"]
        lines.append(
            f"| `{name}` | {_pct(archived)} | {_pct(search)} | {_pct(d['correct_coordination_J_from_first_minus_U_first'])} | {_pct(d['joint_seed_effect_J_from_best_minus_J_from_first'])} | {100.0 * search / archived:.2f}% |"
        )

