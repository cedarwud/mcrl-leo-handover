"""MARGIN_Q -- provision against Gamma divided by the judged fading quantile.

The sealed path provisions transmit power against the rate-target SINR
threshold ``Gamma`` and is then judged at the alpha-fading quantile ``q``.
This variant provisions against ``Gamma / q`` -- that is, it adds a fading
margin of ``-10 log10(q)`` dB, using the *same* quantile the committed mode
selection is later judged at.  Exactly one line of the sealed evaluator
differs; every other equation is the sealed one.
"""

from __future__ import annotations

NAME = "MARGIN_Q"
DESCRIPTION = (
    "Provision against Gamma / q, where q is the same alpha-fading product "
    "quantile the committed mode selection is judged at "
    "(margin_dB = -10 log10 q). All other equations are sealed."
)


def build(sealed):
    module = sealed.load_module(
        "harness_variant_margin_q",
        sealed.SEALED_ROOT / ".scratch/ladder-floor-20260910/margin_batch.py",
    )
    return module.evaluate_ar_tdm_catalogue

