SCHEMA = "mcrl-v025-anytime-unilateral-v1"
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
CHECKPOINTS = (1.0, 2.0, 5.0, 10.0, 20.0, 30.08, 45.0, 60.0)
JOINT_SEED_SECONDS = (10.0, 20.0, 30.08)
DEADLINE_SECONDS = 30.08
# The sealed evaluator's native operation is a dense catalogue.  Ordered
# microbatches retain first-improvement semantics (the first improving row in
# the batch wins) without paying one NumPy catalogue setup per alternative.
UNILATERAL_BATCH_SIZE = 16
JOINT_BATCH_SIZE = 32
