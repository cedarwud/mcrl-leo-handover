import json
import math
from pathlib import Path

from harness.reseeded_span import (
    ARMS,
    REPO,
    _algorithm_digest,
    _canonical_digest,
    build_report,
)


PATHS = {
    "SEALED": REPO / "receipts/reseeded-span-sealed.json",
    "MARGIN_Q": REPO / "receipts/reseeded-span-margin-q.json",
}


def receipts():
    return {
        name: json.loads(path.read_text(encoding="ascii"))
        for name, path in PATHS.items()
    }


def test_receipts_are_complete_self_consistent_and_use_current_algorithm():
    for name, receipt in receipts().items():
        assert receipt["variant"] == name
        assert receipt["complete"] is True
        assert len(receipt["anchors"]) == 20
        assert receipt["receipt_sha256"] == _canonical_digest(receipt)
        assert receipt["reseeded_span_algorithm_sha256"] == _algorithm_digest()
        assert receipt["first_improvement_implementation_sha256"] == (
            "003bdee1df908fddf652f2f8069c31a6297a7f7178bbb83338d09b3f4add9928"
        )


def test_pooled_metrics_pairings_and_decomposition_recompute():
    for receipt in receipts().values():
        summary = receipt["summary"]
        for arm in ARMS:
            rows = [row["committed"][arm] for row in receipt["anchors"]]
            bits = math.fsum(row["bits"] for row in rows)
            joules = math.fsum(row["joules"] for row in rows)
            pooled = summary["pooled"][arm]
            assert pooled["bits"] == bits
            assert pooled["joules"] == joules
            assert pooled["ee_bit_per_j"] == bits / joules
            assert pooled["served_count_sum"] == sum(row["served_count"] for row in rows)
            assert pooled["rate_target_attained_count_sum"] == sum(
                row["rate_target_attained_count"] for row in rows
            )

        for pairing in summary["pairings"].values():
            over = summary["pooled"][pairing["over"]]["ee_bit_per_j"]
            base = summary["pooled"][pairing["base"]]["ee_bit_per_j"]
            assert pairing["pooled_relative_ee_gain"] == over / base - 1.0
            values = [row["relative_ee_gain"] for row in pairing["per_anchor"]]
            assert pairing["negative_anchor_count"] == sum(value < 0 for value in values)
            assert pairing["zero_anchor_count"] == sum(value == 0 for value in values)
            assert pairing["positive_anchor_count"] == sum(value > 0 for value in values)

        decomposition = summary[
            "archived_span_decomposition_additive_relative_to_U_best"
        ]
        terms = (
            decomposition["search_order_U_first_minus_U_best"],
            decomposition["correct_coordination_J_from_first_minus_U_first"],
            decomposition["joint_seed_effect_J_from_best_minus_J_from_first"],
        )
        assert math.isclose(
            sum(terms),
            decomposition["sum_equals_archived_span"],
            rel_tol=0.0,
            abs_tol=2e-15,
        )


def test_selection_controls_and_report_are_exact():
    data = receipts()
    for receipt in data.values():
        assert receipt["summary"]["joint_arms_same_configuration_count"] == 0
        for row in receipt["anchors"]:
            for arm in ("J_from_best", "J_from_first"):
                selected = row["joint_selection"][arm]
