def _git(*args: str) -> str:
    try:
        return subprocess.check_output(
            ["git", *args], cwd=REPO, text=True, encoding="utf-8"
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return "UNAVAILABLE"


def _quantile(values: Sequence[float], q: float) -> float | None:
    if not values:
        return None
    ordered = sorted(float(value) for value in values)
    position = (len(ordered) - 1) * q
    lower = math.floor(position)
    upper = math.ceil(position)
    if lower == upper:
        return ordered[lower]
    return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)


def distribution(values: Sequence[float]) -> dict[str, float | int | None]:
    rows = [float(value) for value in values]
    return {
        "count": len(rows),
        "min": min(rows) if rows else None,
        "q25": _quantile(rows, 0.25),
        "median": statistics.median(rows) if rows else None,
        "q75": _quantile(rows, 0.75),
        "max": max(rows) if rows else None,
        "mean": statistics.fmean(rows) if rows else None,
    }


def _config_payload(config) -> dict[str, object]:
    return {
        "configuration_id": config.configuration_id,
        "assignments": list(config.assignments),
    }


def _metric_payload(reference, profile) -> dict[str, object]:
    return {
        **_config_payload(profile.config),
        "bits": float(profile.bits),
        "joules": float(profile.joules),
        "ee_bit_per_j": reference.ratio(profile.bits, profile.joules),
        "served_count": reference.served(profile),
    }


@dataclass
class TimedEvaluator:
    """One persistent StepEvaluator plus completion timestamps for cache entries."""

    reference: object
    evaluator: object
    started: float
    completed_at: dict[str, float]

    @classmethod
    def create(cls, reference, tape, step_index: int, base, started: float):
        evaluator = reference.probe.StepEvaluator(
            tape,
            reference.probe._setting("a-r0"),
            step_index,
            transition_from=base,
            field="realised",
            run_setting=reference.probe.run_setting_for("a-r0"),
            boundary_indices=(0,),
            fading_quantile_alpha=0.10,
        )
        return cls(reference, evaluator, started, {})

    def elapsed(self) -> float:
        return time.perf_counter() - self.started

    def evaluate_many(self, configs: Sequence[object]) -> None:
        missing = [
            row
            for row in configs
            if row.configuration_id not in self.evaluator._evaluated
            and row.configuration_id not in self.evaluator._invalid
        ]
        if not missing:
            return
        self.evaluator.evaluate_many(tuple(missing))
        finished = self.elapsed()
        for row in missing:
            self.completed_at.setdefault(row.configuration_id, finished)

    def profile(self, config):
        self.evaluate_many((config,))
        return self.evaluator._evaluated.get(config.configuration_id)

    def preload(self, profiles: Mapping[str, object], invalid: Sequence[str] = ()) -> None:
        self.evaluator._evaluated.update(profiles)
        self.evaluator._invalid.update(invalid)


@dataclass
class UnilateralRun:
    base: object
    selected: object
    moves: list[tuple[float, object]]
    receipt: dict[str, object]
    finding_profiles: dict[str, object]
    finding_invalid: set[str]
    finding_completed_at: dict[str, float]


def _candidate(reference, base, current, user: int, identity, kind: str):
    mapping = dict(current.mapping)
    mapping[user] = identity
    return reference._configuration(base, mapping, kind)


def first_improvement_unilateral(reference, tape, step_index: int) -> UnilateralRun:
    """Run first-improvement; isolate the final no-move pass as certification."""

    started = time.perf_counter()
    base = reference.probe._base_configuration(tape, step_index, "nearest-eligible")
    current = base
    moves: list[tuple[float, object]] = [(0.0, base)]
    options, census = reference.probe._legal_options(tape, step_index)
    timed = TimedEvaluator.create(reference, tape, step_index, base, started)
    base_profile = timed.profile(base)
    if base_profile is None:
        raise RuntimeError("legal base configuration was invalid")
    guard = reference.served(base_profile)
    passes_with_moves = 0
    accepted_moves = 0
    candidate_comparisons = 0
    physically_submitted = 0
    pass_rows: list[dict[str, object]] = []

    while True:
        pass_started = timed.elapsed()
        # This snapshot is the cache an implementation omitting the terminal
        # certificate actually owns.  It is deliberately taken before the pass.
        profiles_before_pass = dict(timed.evaluator._evaluated)
        invalid_before_pass = set(timed.evaluator._invalid)
        completed_before_pass = dict(timed.completed_at)
        physical_before_pass = timed.evaluator.physical_evaluations
        moves_this_pass = 0
        for user in sorted(options):
            current_profile = timed.profile(current)
            if current_profile is None:
                raise RuntimeError("accepted incumbent disappeared from cache")
            current_value = reference.objective(current_profile)
            identities = [
                identity for identity in options[user] if identity != current.mapping[user]
            ]
            for offset in range(0, len(identities), UNILATERAL_BATCH_SIZE):
                batch = tuple(
                    _candidate(
                        reference,
                        base,
                        current,
                        user,
                        identity,
                        "anytime-unilateral-first-improvement",
                    )
                    for identity in identities[offset : offset + UNILATERAL_BATCH_SIZE]
                )
                timed.evaluate_many(batch)
                physically_submitted += len(batch)
                accepted = None
                for candidate in batch:
                    candidate_comparisons += 1
                    profile = timed.evaluator._evaluated.get(candidate.configuration_id)
                    if profile is None or reference.served(profile) < guard:
                        continue
                    if reference.objective(profile) > current_value:
                        accepted = candidate
                        break
                if accepted is not None:
                    current = accepted
                    accepted_moves += 1
                    moves_this_pass += 1
                    moves.append((timed.elapsed(), current))
                    break
        pass_finished = timed.elapsed()
        if moves_this_pass == 0:
            finding_seconds = pass_started
            certification_seconds = pass_finished - pass_started
            finding_profiles = profiles_before_pass
            finding_invalid = invalid_before_pass
            finding_completed_at = completed_before_pass
            terminal_evaluations = timed.evaluator.physical_evaluations - physical_before_pass
            break
        passes_with_moves += 1
        pass_rows.append(
            {
                "pass": passes_with_moves,
                "started_seconds": pass_started,
                "finished_seconds": pass_finished,
                "accepted_moves": moves_this_pass,
            }
        )

    receipt = {
        "algorithm": "deterministic cyclic first-improvement",
        "candidate_order": "users sorted; each user's sealed legal options in sealed order",
        "microbatch_size": UNILATERAL_BATCH_SIZE,
        "baseline_served_guard": guard,
        "legal_option_census": census,
        "accepted_moves": accepted_moves,
        "passes_with_moves": passes_with_moves,
        "candidate_comparisons_through_certificate": candidate_comparisons,
        "physically_submitted_candidates_through_certificate": physically_submitted,
        "finding_physical_evaluations": physical_before_pass,
        "terminal_certificate_physical_evaluations": terminal_evaluations,
        "last_improvement_seconds": moves[-1][0],
        "finding_seconds": finding_seconds,
        "terminal_certificate_seconds": certification_seconds,
        "measured_total_including_certificate_seconds": pass_finished,
        "terminal_certificate_excluded_from_anytime": True,
        "passes": pass_rows,
        "move_times_seconds": [row[0] for row in moves[1:]],
        "selected": _config_payload(current),
    }
    return UnilateralRun(
        base,
        current,
        moves,
        receipt,
        finding_profiles,
        finding_invalid,
        finding_completed_at,
    )


def config_at(run: UnilateralRun, seconds: float):
"""Reseed the archived bounded joint selector from both unilateral fixed points.

This diagnostic reuses the archived best-improvement and measured converged
first-improvement assignments.  For each seed it invokes the same exhaustive
alternate sweep, the same sealed bounded-catalogue builder, the same service
guard, objective, tie-break, and 48-boundary committed evaluator.
"""

from __future__ import annotations

import argparse
from collections import Counter
import hashlib
import inspect
import json
import math
from pathlib import Path
from typing import Mapping, Sequence

from harness import panel as panel_module
from harness import sealed as sealed_module
from harness.anytime import _metric_payload
