"""Anytime instrumentation for the sealed unilateral and bounded joint search.

The physics and all decision rules come from the verified archived runner.  This
module changes only search scheduling: unilateral alternatives are inspected in
deterministic order and the first strict improvement is committed immediately.
The terminal no-move pass is timed separately and its cache entries are never
made available to the deadline-limited experiments.
"""

from __future__ import annotations

from dataclasses import dataclass
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import statistics
import subprocess
import time
from typing import Mapping, Sequence

