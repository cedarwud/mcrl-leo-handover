   225	def _counts(mapping: Mapping[int, tuple[int, int] | None], focal: int) -> tuple[dict, dict]:
   226	    beam: dict[tuple[int, int], int] = {}
   227	    satellite: dict[int, int] = {}
   228	    for user, identity in mapping.items():
   229	        if user == focal or identity is None:
   230	            continue
   231	        beam[identity] = beam.get(identity, 0) + 1
   232	        satellite[identity[0]] = satellite.get(identity[0], 0) + 1
   233	    return beam, satellite
