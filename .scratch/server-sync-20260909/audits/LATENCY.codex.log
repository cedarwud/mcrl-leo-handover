   847	@dataclass(slots=True)
   848	class SetInteractionHead:
   849	    """Two-layer permutation-invariant scalar Psi MLP with hard zero anchors."""
   850	
   851	    input_weights: np.ndarray
   852	    input_bias: np.ndarray
   853	    output_weights: np.ndarray
   854	    output_bias: float
   855	    member_width: int
   856	
   857	    def clone(self) -> "SetInteractionHead":
   858	        return SetInteractionHead(
   859	            self.input_weights.copy(),
   860	            self.input_bias.copy(),
   861	            self.output_weights.copy(),
   862	            float(self.output_bias),
   863	            self.member_width,
   864	        )
   865	
   866	    def _hidden(self, values: np.ndarray) -> np.ndarray:
   867	        if values.shape[-1] != self.input_weights.shape[1]:
   868	            raise StageCContractError("set-interaction state shape drifted")
   869	        return np.tanh(values @ self.input_weights.T + self.input_bias)
   870	
   871	    def score(self, context: CoalitionContext) -> float:
   872	        if len(context.members) <= 1:
   873	            return 0.0
   874	        values = context.invariant_vector(member_width=self.member_width)
   875	        return float(self._hidden(values) @ self.output_weights + self.output_bias)
   876	
   877	    def update(self, batch: CoalitionBatch, *, learning_rate: float) -> float:
   878	        hidden = self._hidden(batch.invariant_states)
   879	        predictions = hidden @ self.output_weights + self.output_bias
   880	        residual = predictions - batch.target_psi
   881	        count = float(batch.target_psi.size)
   882	        scale = 2.0 / count
   883	        output_weights_before = self.output_weights.copy()
   884	        self.output_weights -= learning_rate * scale * (hidden.T @ residual)
   885	        self.output_bias -= learning_rate * float(scale * residual.sum())
   886	        hidden_gradient = residual[:, None] * output_weights_before[None, :] * (1.0 - hidden * hidden)
   887	        self.input_weights -= learning_rate * scale * (hidden_gradient.T @ batch.invariant_states)
   888	        self.input_bias -= learning_rate * scale * hidden_gradient.sum(axis=0)
   889	        loss = float(np.mean(residual * residual))
   890	        if not all(
   891	            np.isfinite(value).all()
   892	            for value in (self.input_weights, self.input_bias, self.output_weights)
   893	        ) or not np.isfinite(self.output_bias):
   894	            raise StageCContractError("non-finite C3 learner update")
   895	        return loss
   896	
   897	    def fit_closed_form(self, batch: CoalitionBatch, *, ridge: float = 1e-10) -> float:
   898	        """Deterministic synthetic/KAT fit of the same scalar squared-error head."""
   899	
   900	        hidden = self._hidden(batch.invariant_states)
   901	        design = np.column_stack((hidden, np.ones(hidden.shape[0])))
   902	        gram = design.T @ design + ridge * np.eye(design.shape[1])
   903	        solution = np.linalg.solve(gram, design.T @ batch.target_psi)
   904	        self.output_weights[:] = solution[:-1]
   905	        self.output_bias = float(solution[-1])
   906	        residual = design @ solution - batch.target_psi
   907	        return float(np.mean(residual * residual))
   908	
   909	    def payload(self) -> dict[str, object]:
   910	        return {
   911	            "kind": "permutation_invariant_set_conditioned_scalar",
   912	            "architecture": "two_layer_tanh_mlp_on_sum_max_and_padded_resource_context",
   913	            "input_weights_hex": [
   914	                [float_hex(value) for value in row] for row in self.input_weights
   915	            ],
   916	            "input_bias_hex": [float_hex(value) for value in self.input_bias],
   917	            "output_weights_hex": [float_hex(value) for value in self.output_weights],
   918	            "output_bias_hex": float_hex(self.output_bias),
   919	            "member_width": self.member_width,
   920	            "anchors": {"empty": 0.0, "singleton": 0.0},
   921	        }
