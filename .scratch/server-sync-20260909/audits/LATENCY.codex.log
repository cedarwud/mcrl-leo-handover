   795	    def payload(self) -> dict[str, object]:
   796	        encode = lambda arrays: [
   797	            [[float_hex(value) for value in row] for row in array]
   798	            if array.ndim == 2 else [float_hex(value) for value in array]
   799	            for array in arrays
   800	        ]
   801	        return {
   802	            "kind": "legacy_heterogeneous_adam_mlp",
