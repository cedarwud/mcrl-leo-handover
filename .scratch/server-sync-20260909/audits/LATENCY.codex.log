   111	def _sha_files(paths: Iterable[Path]) -> str:
   112	    digest = hashlib.sha256()
   113	    for path in sorted(paths):
   114	        digest.update(path.relative_to(ROOT).as_posix().encode())
   115	        digest.update(b"\0")
   116	        digest.update(path.read_bytes())
   117	        digest.update(b"\0")
   118	    return digest.hexdigest()
   119	
   120	
   121	CODE_DIGEST = _sha_files(
   122	    [Path(__file__), *sorted((ROOT / "src/mcrl/stagec_v025").glob("*.py"))]
