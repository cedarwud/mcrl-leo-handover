    92	def _engine() -> ModuleType:
    93	    name = "mcrl_v025_pilot_matrix_engine"
    94	    if name in sys.modules:
    95	        return sys.modules[name]
    96	    spec = importlib.util.spec_from_file_location(name, ENGINE_PATH)
    97	    if spec is None or spec.loader is None:
    98	        raise RuntimeError(f"cannot load engine at {ENGINE_PATH}")
    99	    module = importlib.util.module_from_spec(spec)
   100	    sys.modules[name] = module
   101	    spec.loader.exec_module(module)
   102	    return module
   103	
   104	
   105	ENGINE = _engine()
   106	# Pilot-only compute fallback. The sealed engine remains byte-for-byte intact;
   107	# its forecast helper reads this module constant at call time.
   108	ENGINE.SELECTION_BOUNDARY_INDICES = PILOT_FORECAST_BOUNDARIES
