   753	            gradient = gradient + self.weight_decay * parameter
   754	            first *= self.beta1
   755	            first += (1.0 - self.beta1) * gradient
   756	            second *= self.beta2
   757	            second += (1.0 - self.beta2) * gradient * gradient
   758	            corrected_m = first / (1.0 - self.beta1**self.adam_step)
   759	            corrected_v = second / (1.0 - self.beta2**self.adam_step)
   760	            parameter -= self.learning_rate * corrected_m / (np.sqrt(corrected_v) + self.epsilon)
   761	        for parameter, gradient, first, second in zip(
   762	            self.biases, grad_b, self.first_moment_b, self.second_moment_b, strict=True
   763	        ):
   764	            first *= self.beta1
   765	            first += (1.0 - self.beta1) * gradient
   766	            second *= self.beta2
   767	            second += (1.0 - self.beta2) * gradient * gradient
   768	            parameter -= self.learning_rate * (first / (1.0 - self.beta1**self.adam_step)) / (
   769	                np.sqrt(second / (1.0 - self.beta2**self.adam_step)) + self.epsilon
   770	            )
   771	
   772	    def update(self, batch: PairwiseBatch) -> float:
   773	        reference, ref_a, ref_z = self._forward(batch.reference_states)
   774	        candidate, cand_a, cand_z = self._forward(batch.candidate_states)
   775	        residual = candidate - reference - batch.target_deltas
   776	        count = float(len(residual))
   777	        scale = 2.0 * self.loss_weight / count
   778	        cand_w, cand_b = self._backward(cand_a, cand_z, scale * residual)
   779	        ref_gradient = scale * (-residual + self.gauge_beta * reference)
   780	        ref_w, ref_b = self._backward(ref_a, ref_z, ref_gradient)
   781	        self._adam(
   782	            [left + right for left, right in zip(cand_w, ref_w, strict=True)],
   783	            [left + right for left, right in zip(cand_b, ref_b, strict=True)],
   784	        )
   785	        return float(self.loss_weight * np.mean(residual * residual + self.gauge_beta * reference * reference))
   786	
   787	    def update_scalar(self, states: np.ndarray, targets: np.ndarray) -> float:
   788	        prediction, activations, preactivations = self._forward(states)
   789	        residual = prediction - targets
   790	        scale = 2.0 * self.loss_weight / float(len(residual))
   791	        gradients = self._backward(activations, preactivations, scale * residual)
   792	        self._adam(*gradients)
   793	        return float(self.loss_weight * np.mean(residual * residual))
