   763	class StepEvaluator:
   764	    """Architecture/configuration cache; treatment cells only rescore it."""
   765	
   766	    def __init__(
   767	        self,
   768	        tape: ExogenousWorldTape,
   769	        setting: PhysicsSetting,
   770	        step_index: int,
   771	        *,
   772	        transition_from: Configuration,
   773	        cell_rekeyed_users: Iterable[int] = (),
   774	        field: str = "realised",
   775	        counter: EvaluationCounter | None = None,
   776	        run_setting: SealedRunSetting | None = None,
   777	        boundary_indices: tuple[int, ...] = tuple(range(48)),
   778	    ) -> None:
   779	        self.tape = tape
   780	        self.setting = setting
   781	        self.step_index = step_index
   782	        self.transition_from = transition_from
   783	        self.cell_rekeyed_users = tuple(cell_rekeyed_users)
   784	        self.field = field
   785	        self.counter = counter
   786	        self.run_setting = run_setting_for(setting.label) if run_setting is None else run_setting
   787	        self.boundary_indices = boundary_indices
   788	        self._shared: dict[str, object] = {}
   789	        self._evaluated: dict[str, EvaluatedProfile] = {}
   790	        self._invalid: set[str] = set()
   791	        self.physical_evaluations = 0
   792	
   793	    def evaluate_many(self, configs: Sequence[Configuration]) -> None:
   794	        """Populate the cache through the dense real-world ``a-r0`` path."""
   795	
   796	        missing = [row for row in configs if row.configuration_id not in self._evaluated]
   797	        step = self.tape.steps[self.step_index]
   798	        if not missing or step.arrays is None or self.setting.label != "a-r0":
   799	            for config in missing:
   800	                self.evaluate(config)
   801	            return
   802	        arrays = step.arrays
   803	        row_of = arrays._row_index()
   804	        users = tuple(int(value) for value in arrays.users)
   805	        selected = np.full((len(missing), len(users)), -1, dtype=np.int64)
   806	        absent = np.zeros(len(missing), dtype=np.bool_)
   807	        for config_index, config in enumerate(missing):
   808	            mapping = config.mapping
   809	            for user_column, user in enumerate(users):
   810	                identity = mapping[user]
   811	                if identity is not None:
