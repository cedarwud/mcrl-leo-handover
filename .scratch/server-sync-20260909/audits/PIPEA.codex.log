537:         "reference_object": reference["name"],
538:         "reference_construction": reference["construction"],
539:         "reference_information_class": reference["information_class"],
540:         "information_class": identity["information_class"],
541:         "estimand": estimand,
542:         "numerator": identity["numerator"],
543:         "energy_boundary": identity["energy_boundary"],
544:         "panel_identity": {
545:             "name": identity["name"], "anchors": identity["anchors"], "worlds": identity["worlds"],
546:             "dates": identity["dates"], "world_seeds": identity["world_seeds"],
547:             "provisioning_rule": identity["provisioning_rule"],
548:         },
549:         "fixed_point_traversal_order": identity["fixed_point_traversal_order"],
550:     }
551: 
552: 
553: def _relative_difference(value: float, reference: float) -> float | None:
554:     return None if reference == 0.0 else (value - reference) / reference
