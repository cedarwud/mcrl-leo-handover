107: def _sha256(path: Path) -> str:
108:     digest = hashlib.sha256()
109:     with path.open("rb") as handle:
110:         for block in iter(lambda: handle.read(1024 * 1024), b""):
111:             digest.update(block)
112:     return digest.hexdigest()
