340: def write_anchor_shard(path: Path, header: dict[str, object], payloads: Iterable[dict[str, object]]) -> tuple[str, int, int]:
341:     path.parent.mkdir(parents=True, exist_ok=True)
342:     temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
343:     digest = hashlib.sha256()
344:     row_count = 0
345:     with temporary.open("wb") as handle:
346:         for payload in (header, *payloads):
347:             encoded = canonical_bytes(payload) + b"\n"
348:             handle.write(encoded)
349:             digest.update(encoded)
350:             if payload is not header:
351:                 row_count += 1
352:         handle.flush()
353:         os.fsync(handle.fileno())
354:     temporary.replace(path)
355:     file_hash = digest.hexdigest()
356:     sidecar = path.with_suffix(path.suffix + ".sha256")
357:     sidecar_tmp = sidecar.with_name(f".{sidecar.name}.{os.getpid()}.tmp")
358:     sidecar_tmp.write_text(f"{file_hash}  {path.name}\n")
359:     sidecar_tmp.replace(sidecar)
360:     return file_hash, row_count, path.stat().st_size
