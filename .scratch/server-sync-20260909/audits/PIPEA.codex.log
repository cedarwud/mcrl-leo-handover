96: def atomic_json(path: Path, payload: object) -> None:
97:     path.parent.mkdir(parents=True, exist_ok=True)
98:     temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
99:     with temporary.open("wb") as handle:
100:         handle.write(json.dumps(payload, sort_keys=True, indent=2, allow_nan=False).encode())
101:         handle.write(b"\n")
102:         handle.flush()
103:         os.fsync(handle.fileno())
104:     temporary.replace(path)
