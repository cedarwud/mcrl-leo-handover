89: def _sha256(path: Path) -> str:
90:     digest = hashlib.sha256()
91:     with path.open("rb") as handle:
92:         for block in iter(lambda: handle.read(1024 * 1024), b""):
93:             digest.update(block)
94:     return digest.hexdigest()
95: 
96: 
97: def _canonical_sha256(value: object) -> str:
98:     encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("ascii")
99:     return hashlib.sha256(encoded).hexdigest()
100: 
101: 
102: def _read_json(path: Path) -> object:
103:     try:
104:         return json.loads(path.read_text(encoding="ascii"))
105:     except (OSError, UnicodeError, json.JSONDecodeError) as error:
106:         raise ScorerContractError(f"cannot parse JSON {path}") from error
107: 
108: 
109: def _write_bytes_once(path: Path, content: bytes) -> None:
110:     if path.exists():
111:         raise ScorerContractError(f"refusing to overwrite {path}")
112:     path.parent.mkdir(parents=True, exist_ok=True)
113:     temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
114:     with temporary.open("xb") as handle:
115:         handle.write(content)
116:         handle.flush()
117:         os.fsync(handle.fileno())
118:     temporary.replace(path)
119: 
120: 
121: def _write_json_once(path: Path, value: object) -> None:
122:     content = json.dumps(value, indent=2, sort_keys=True, allow_nan=False).encode("ascii") + b"\n"
123:     _write_bytes_once(path, content)
