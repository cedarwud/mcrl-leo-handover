303: $ env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 bin/harness anytime --variant SEALED --out receipts/anytime-sealed-full20.json
304: $ env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 bin/harness anytime --variant MARGIN_Q --out receipts/anytime-margin-q-full20.json
305: $ env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python -m harness.anytime_best_timing --variant SEALED --out receipts/anytime-best-timing-sealed.json
306: $ env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python -m harness.anytime_best_timing --variant MARGIN_Q --out receipts/anytime-best-timing-margin-q.json
307: $ PYTHONPATH=src /home/sat/mcrl-leo-handover/.venv/bin/python -m harness.anytime_report --out ANYTIME-UNILATERAL-2026-09-10.md
