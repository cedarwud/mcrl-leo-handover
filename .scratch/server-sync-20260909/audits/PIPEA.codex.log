131:     cap = MAX_RSS_BYTES
132:     new_hard = cap if hard == resource.RLIM_INFINITY else min(hard, cap)
133:     resource.setrlimit(resource.RLIMIT_AS, (min(cap, new_hard), new_hard))
134:     if RUNNER_PYTHON_PROCESSES > MAX_PYTHON_PROCESSES:
135:         raise RuntimeError("runner process inventory exceeds hard cap")
136: 
137: 
138: def _write_json(path: Path, payload: object) -> None:
139:     if path.exists():
140:         raise StageCContractError(f"refusing to overwrite {path}")
141:     path.parent.mkdir(parents=True, exist_ok=True)
142:     temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
143:     with temporary.open("wb") as handle:
144:         handle.write(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False).encode("ascii"))
145:         handle.write(b"\n")
146:         handle.flush()
147:         os.fsync(handle.fileno())
148:     temporary.replace(path)
149: 
150: 
151: def _validate_fraction(payload: object, field: str) -> None:
152:     if not isinstance(payload, Mapping) or set(payload) != {"fraction", "float_hex"}:
153:         raise StageCContractError(f"{field} fraction schema drifted")
154:     values = payload["fraction"]
155:     if (
156:         not isinstance(values, list)
157:         or len(values) != 2
158:         or any(isinstance(value, bool) or not isinstance(value, int) for value in values)
159:         or values[1] == 0
160:     ):
161:         raise StageCContractError(f"{field} fraction value drifted")
162:     expected = float.hex(float(Fraction(values[0], values[1])))
163:     if payload["float_hex"] != expected:
164:         raise StageCContractError(f"{field} float/fraction disagreement")
165:     parse_float_hex(payload["float_hex"], field=field)
166: 
167: 
168: def _validate_extension(extension: object) -> None:
169:     if not isinstance(extension, Mapping) or set(extension) != EXTENSION_FIELDS:
170:         raise StageCContractError("exact source extension schema drifted")
171:     if extension["schema"] != SOURCE_EXTENSION_SCHEMA:
172:         raise StageCContractError("exact source extension version drifted")
173:     if not isinstance(extension["row_key"], str) or not extension["row_key"]:
174:         raise StageCContractError("exact source row_key drifted")
175:     if not isinstance(extension["physics_configuration_id"], str):
176:         raise StageCContractError("exact source configuration identity drifted")
177:     c1 = extension["c1_difference_surplus"]
178:     if not isinstance(c1, Mapping) or set(c1) != {
179:         "core_bits", "phi_difference", "normalized_total", "decomposition_residual"
180:     }:
181:         raise StageCContractError("exact C1 target schema drifted")
182:     for name, value in c1.items():
183:         _validate_fraction(value, f"C1.{name}")
184:     c2 = extension["c2_persistence_forecast"]
185:     if not isinstance(c2, Mapping) or set(c2) != {
186:         "forecast_surplus_bits", "lost_offsets", "persistence_penalty_bits",
187:         "label_bits", "normalized_total", "decomposition_residual",
188:     }:
189:         raise StageCContractError("exact C2 target schema drifted")
190:     if isinstance(c2["lost_offsets"], bool) or not isinstance(c2["lost_offsets"], int):
191:         raise StageCContractError("exact C2 lost-offset count drifted")
192:     for name in set(c2) - {"lost_offsets"}:
193:         _validate_fraction(c2[name], f"C2.{name}")
194:     surrogate = extension["surrogate"]
195:     if not isinstance(surrogate, Mapping) or set(surrogate) != {
196:         "method", "c1_core_bits_hex", "c1_phi_difference_hex",
197:         "c1_normalized_total_hex", "c2_label_bits_hex", "c2_normalized_total_hex",
198:     }:
199:         raise StageCContractError("surrogate comparison schema drifted")
200:     for name in set(surrogate) - {"method"}:
201:         parse_float_hex(surrogate[name], field=f"surrogate.{name}")
202:     path = extension["evaluation_path"]
203:     expected_path = {
204:         "exact_candidate_current": "evaluate_many then cache access",
205:         "exact_default_current": "evaluate_many then cache access",
206:         "exact_candidate_forecasts": "evaluate_many",
207:         "exact_default_forecasts": "evaluate_many",
208:         "c1_target": "c1_difference_surplus",
209:         "c2_target": "c2_persistence_forecast",
210:         "surrogate": "provider-primitive-array-lookup",
211:         "boundary_indices": [0],
212:     }
213:     if path != expected_path:
214:         raise StageCContractError("exact source evaluation path drifted")
215: 
216: 
217: def _read_exact_source_view(path: Path) -> tuple[SourceShard, dict[str, object]]:
218:     file_digest = verify_sha256_sidecar(path)
219:     raw_lines = path.read_bytes().splitlines()
220:     try:
221:         values = [json.loads(line.decode("ascii")) for line in raw_lines]
222:     except (UnicodeError, json.JSONDecodeError) as error:
223:         raise StageCContractError(f"cannot parse exact source view {path}") from error
224:     if not values or any(not isinstance(value, Mapping) for value in values):
225:         raise StageCContractError("exact source view requires one header and object rows")
226:     if any(line != canonical_json_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
227:         raise StageCContractError("exact source view is not canonical JSONL")
228:     header = values[0]
229:     if set(header) != SOURCE_HEADER_FIELDS or header["schema"] != SOURCE_VIEW_SCHEMA:
230:         raise StageCContractError("exact source view header schema drifted")
231:     if (
232:         header["existing_row_schema"] != "mcrl-v025-stagec-source-row-v1"
233:         or header["extension_schema"] != SOURCE_EXTENSION_SCHEMA
234:         or header["evaluation_path"] != {
235:             "boundaries": [0],
236:             "current_candidate_and_default": "evaluate_many",
237:             "forecast_candidate_and_default": "evaluate_many",
238:         }
239:     ):
240:         raise StageCContractError("exact source view authority drifted")
241:     expected_row_fields = set(values[1]) if len(values) > 1 else set()
242:     rows = []
243:     row_keys: set[str] = set()
244:     for payload in values[1:]:
245:         if set(payload) != expected_row_fields or "exact_source_view" not in payload:
246:             raise StageCContractError("exact source view row field inventory drifted")
247:         _validate_extension(payload["exact_source_view"])
248:         row_key = str(payload["exact_source_view"]["row_key"])
249:         if row_key in row_keys:
250:             raise StageCContractError("duplicate exact source row_key")
251:         row_keys.add(row_key)
252:         base = {key: value for key, value in payload.items() if key != "exact_source_view"}
253:         row = _row_from_payload(base)
254:         if (
255:             row.world_id != header["world_id"]
256:             or row.anchor_index != header["anchor_index_within_world"]
257:         ):
258:             raise StageCContractError("exact source row/header anchor disagreement")
259:         rows.append(row)
260:     if not rows or len(rows) != int(header["row_count"]):
261:         raise StageCContractError("exact source view row count drifted")
262:     variant = variant_for_digests(rows[0].q1_schema_sha256, rows[0].q2_schema_sha256)
263:     if (
264:         any((row.q1_schema_sha256, row.q2_schema_sha256) !=
265:             (variant.q1_schema_sha256, variant.q2_schema_sha256) for row in rows)
266:         or header["q1_slots"] != variant.q1_width
267:         or header["q2_slots"] != variant.q2_width
268:     ):
269:         raise StageCContractError("exact source feature schema drifted")
270:     shard = SourceShard(path, file_digest, canonical_sha256([row.payload() for row in rows]), tuple(rows))
271:     return shard, dict(header)
272: 
273: 
274: def _candidate_view_files(corpus: Path) -> list[Path]:
275:     promoted = corpus / "views"
276:     staging = corpus / ".staging-separated-v1"
277:     if promoted.is_dir():
278:         root = promoted
279:     elif staging.is_dir():
280:         root = staging
281:     else:
282:         raise StageCContractError("corpus has neither views/ nor .staging-separated-v1/*/views/")
283:     files = sorted(path for path in root.rglob("*.jsonl") if path.is_file() and "views" in path.parts)
284:     if not files:
285:         raise StageCContractError("view layer contains no JSONL shards")
286:     if any("physics" in path.parts for path in files):
287:         raise StageCContractError("physics path was admitted into view inventory")
288:     return files
289: 
290: 
291: def load_corpus(corpus: Path) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
292:     source_shards = []
293:     coalition_shards = []
294:     anchors = []
295:     inventory = []
296:     for path in _candidate_view_files(corpus):
297:         try:
298:             first = json.loads(path.read_bytes().splitlines()[0].decode("ascii"))
299:         except (OSError, IndexError, UnicodeError, json.JSONDecodeError) as error:
300:             raise StageCContractError(f"cannot identify view shard {path}") from error
301:         schema = first.get("schema") if isinstance(first, Mapping) else None
302:         if schema == SOURCE_VIEW_SCHEMA:
303:             shard, header = _read_exact_source_view(path)
304:             source_shards.append(shard)
305:             anchors.append({
306:                 key: header[key] for key in (
307:                     "global_anchor_index", "world_id", "anchor_index_within_world",
308:                     "step_index", "carrier",
309:                 )
310:             })
311:         elif schema == COALITION_SHARD_SCHEMA:
312:             coalition_shards.append(read_coalition_shard(path))
313:         else:
314:             raise StageCContractError(f"unsupported view schema {schema!r}: {path}")
315:         inventory.append({"path": path.relative_to(corpus).as_posix(), "sha256": _sha256(path)})
316:     if not source_shards:
317:         raise StageCContractError("corpus has no exact C1/C2 source view shards")
318:     if not coalition_shards:
319:         raise StageCContractError(
320:             "corpus has no authenticated mcrl-v025-stagec-c3-coalition-shard-v2 view; "
321:             "five-arm training is forbidden"
322:         )
323:     pairs = build_pairwise_batches(tuple(source_shards))
324:     c3 = CoalitionBatch.create(tuple(coalition_shards))
325:     if len({pairs["C1"].physics_digest, pairs["C2"].physics_digest, c3.physics_digest}) != 1:
326:         raise StageCContractError("C1/C2/C3 view physics digests disagree")
327:     first_row = source_shards[0].rows[0]
328:     variant = variant_for_digests(first_row.q1_schema_sha256, first_row.q2_schema_sha256)
329:     corpus_receipt = {
330:         "mode": "exact-view-corpus",
331:         "root": str(corpus.resolve()),
332:         "digest": canonical_sha256(inventory),
333:         "files": inventory,
334:         "anchor_list": sorted(anchors, key=lambda row: row["global_anchor_index"]),
335:         "source_rows": sum(len(shard.rows) for shard in source_shards),
336:         "coalition_rows": sum(len(shard.rows) for shard in coalition_shards),
337:     }
338:     feature = {
339:         "name": variant.name,
340:         "digest": canonical_sha256(variant.schema_manifest()),
341:         "q1_schema_sha256": variant.q1_schema_sha256,
342:         "q2_schema_sha256": variant.q2_schema_sha256,
343:         "q1_width": variant.q1_width,
344:         "q2_width": variant.q2_width,
345:         "view_schema": SOURCE_VIEW_SCHEMA,
346:         "view_extension_schema": SOURCE_EXTENSION_SCHEMA,
347:         "coalition_schema": COALITION_SHARD_SCHEMA,
348:     }
349:     return {"pairs": pairs, "c3": c3}, corpus_receipt, feature
350: 
351: 
352: def build_synthetic_corpus(
353:     output: Path, *, directory_name: str = "synthetic-input"
354: ) -> tuple[dict[str, object], dict[str, object], dict[str, object]]:
355:     material = output / directory_name
356:     material.mkdir(parents=True, exist_ok=False)
357:     rows = tuple(row for anchor in make_synthetic_anchors() for row in extract_source_rows(anchor))
358:     source = write_source_shard(material / "synthetic-source.jsonl", rows)
359:     pairs = build_pairwise_batches((source,))
360:     c3, coalition = _synthetic_coalition_batch(material, rows)
361:     variant = variant_for_digests(rows[0].q1_schema_sha256, rows[0].q2_schema_sha256)
362:     inventory = [
363:         {"path": path.name, "sha256": _sha256(path)}
364:         for path in (source.path, coalition.path)
365:     ]
366:     receipt = {
367:         "mode": "synthetic-fixture-NOT-EVIDENCE",
368:         "root": str(material),
369:         "digest": canonical_sha256(inventory),
370:         "files": inventory,
371:         "anchor_list": sorted({row.anchor_id for row in rows}),
372:         "source_rows": len(rows),
373:         "coalition_rows": len(coalition.rows),
374:     }
375:     feature = {
376:         "name": variant.name,
377:         "digest": canonical_sha256(variant.schema_manifest()),
378:         "q1_schema_sha256": variant.q1_schema_sha256,
379:         "q2_schema_sha256": variant.q2_schema_sha256,
380:         "q1_width": variant.q1_width,
381:         "q2_width": variant.q2_width,
382:         "view_schema": "synthetic-fixture-source-shard-v1",
383:         "coalition_schema": COALITION_SHARD_SCHEMA,
384:     }
385:     return {"pairs": pairs, "c3": c3}, receipt, feature
386: 
387: 
388: def _selection_pool(route: str, model, specification: Mapping[str, object]):
389:     count = int(specification["candidate_count"])
390:     route_offset = {"C1": 0, "C2": 1, "C3": 2, "ALL": 3}[route]
391:     rng = np.random.default_rng(int(specification["pool_rng_seed"]) + route_offset)
392:     q1_width = len(model.q1.weights[0])
393:     q2_width = len(model.q2.weights[0])
394:     user_count = 2 if route in {"C3", "ALL"} else 1
395:     table_rows = []
396:     for user in range(user_count):
397:         actions = [PhysicalAction(80000 + 1000 * user, 1000 * user)]
398:         q1_states = [tuple(0.0 for _ in range(q1_width))]
399:         q2_states = [tuple(0.0 for _ in range(q2_width))]
400:         for index in range(1, count + 1):
401:             actions.append(PhysicalAction(80000 + 1000 * user + index, 1000 * user + index))
402:             q1_states.append(tuple(float(value) for value in (
403:                 rng.normal(size=q1_width) if route in {"C1", "ALL"} else np.zeros(q1_width)
404:             )))
405:             q2_states.append(tuple(float(value) for value in (
406:                 rng.normal(size=q2_width) if route in {"C2", "ALL"} else np.zeros(q2_width)
407:             )))
408:         actions.append(PhysicalAction(None, None))
409:         q1_states.append(tuple(0.0 for _ in range(q1_width)))
410:         q2_states.append(tuple(0.0 for _ in range(q2_width)))
411:         table_rows.append(UserActionTable(
412:             user, tuple(actions), tuple(True for _ in actions), tuple(q1_states), tuple(q2_states)
413:         ))
414:     tables = tuple(table_rows)
415:     catalogue = tuple(tuple(index for _ in tables) for index in range(count + 2))
416:     contexts = {}
417:     for index, profile in enumerate(catalogue):
418:         members = () if index == 0 else tuple(CoalitionMember(
419:             table.user_id, table.actions[0], table.actions[index],
420:             tuple(float(value) for value in (
421:                 rng.normal(size=q1_width) if route in {"C3", "ALL"} else np.zeros(q1_width)
422:             )), tuple(0.0 for _ in range(q1_width)), False,
423:         ) for table in tables)
424:         contexts[profile] = CoalitionContext(
425:             anchor_id="stagec-arm-difference-fixture",
426:             reference_profile=tuple((table.user_id, table.actions[0]) for table in tables), members=members,
427:             affected_beams=(AffectedBeamContext(
428:                 "fixture-beam", 1, 1, True, True,
429:                 1.0 + 0.01 * index, 0.001 * index, 0.5 - 0.0001 * index,
430:             ),),
431:             global_resource_features=(float(index) / count, math.sin(index), math.cos(index)),
432:         )
433:     return tables, catalogue, contexts
434: 
435: 
436: def _route_delta(model, route: str, tables, contexts, profile) -> float:
437:     total = 0.0
438:     for table, index in zip(tables, profile, strict=True):
439:         if route in {"C1", "ALL"}:
440:             total += model.score("C1", table.q1_states[index]) - model.score("C1", table.q1_states[0])
441:         if route in {"C2", "ALL"}:
442:             total += model.score("C2", table.q2_states[index]) - model.score("C2", table.q2_states[0])
443:     if route in {"C3", "ALL"}:
444:         total += model.interaction(contexts[profile]) - model.interaction(contexts[tuple(0 for _ in tables)])
445:     return total
446: 
447: 
448: def run_fixture_gate(batches: Mapping[str, object], output: Path, seed: int) -> dict[str, object]:
449:     specification = json.loads(FIXTURE.read_text(encoding="ascii"))
450:     if set(specification) != {
451:         "schema", "training_epochs", "pool_rng_seed", "candidate_count",
452:         "required_pairs", "fixture_outcomes", "witness_rule",
453:     } or specification["schema"] != "mcrl-v025-stagec-arm-difference-fixture-v1":
454:         raise StageCContractError("checked-in arm-difference fixture schema drifted")
455:     trainer = V1LineageOrchestrator(
456:         learner_seed=seed, q1_batch=batches["pairs"]["C1"], q2_batch=batches["pairs"]["C2"],
457:         c3_batch=batches["c3"], neutral_sources=default_synthetic_neutral_sources(),
458:     )
459:     gate_epochs = int(specification["training_epochs"])
460:     if gate_epochs != CHECKPOINT_EVERY_SOURCE_EPOCHS:
461:         raise StageCContractError("fixture checkpoint boundary drifted")
462:     trainer.train(gate_epochs)
463:     checkpoint = output / "fixture-checkpoint" / f"learner-{seed}-epoch-{gate_epochs:06d}.json"
464:     checkpoint_digest = trainer.write_checkpoint(checkpoint)
465:     restored = V1LineageOrchestrator(
466:         learner_seed=seed, q1_batch=batches["pairs"]["C1"], q2_batch=batches["pairs"]["C2"],
467:         c3_batch=batches["c3"], neutral_sources=default_synthetic_neutral_sources(),
468:     )
469:     restored.load_checkpoint(checkpoint)
470:     trainer.bind_checkpoint_identity()
471:     results = []
472:     for pair in specification["required_pairs"]:
473:         if not isinstance(pair, list) or len(pair) != 3 or pair[0] != "FULL":
474:             raise StageCContractError("fixture pair inventory drifted")
475:         full, comparator, route = pair
476:         if comparator not in LEARNED_ARMS or route not in (*ROUTES, "ALL"):
477:             raise StageCContractError("fixture names an unsupported arm or route")
478:         tables, catalogue, contexts = _selection_pool(route, trainer.models[full], specification)
479:         deltas = {
480:             arm: [_route_delta(trainer.models[arm], route, tables, contexts, profile)
481:                   for profile in catalogue[1:]]
482:             for arm in (full, comparator)
483:         }
484:         witness = max(
485:             range(len(deltas[full])),
486:             key=lambda offset: abs(deltas[full][offset] - deltas[comparator][offset]),
487:         )
488:         action_index = witness + 1
489:         difference = deltas[full][witness] - deltas[comparator][witness]
490:         if difference == 0.0:
491:             raise StageCContractError(f"arm-difference fixture found identical numeric scores for {full}/{comparator}")
492:         shared_catalogue_term = -0.5 * (deltas[full][witness] + deltas[comparator][witness])
493:         def identity(action: PhysicalAction):
494:             return None if action.is_null else (int(action.norad_id), int(action.beam_chain_id))
495:         base_assignment = canonical_assignment({table.user_id: identity(table.actions[0]) for table in tables})
496:         candidate_assignment = canonical_assignment({
497:             table.user_id: identity(table.actions[action_index]) for table in tables
498:         })
499:         selected = {}
500:         adjusted_scores = {}
501:         for arm in (full, comparator):
502:             adjusted = deltas[arm][witness] + shared_catalogue_term
503:             adjusted_scores[arm] = adjusted
504:             base_row = ScoredConfiguration(base_assignment, 0.0)
505:             candidate_row = ScoredConfiguration(candidate_assignment, adjusted)
506:             chosen, _accepted = first_improvement(
507:                 base_row,
508:                 lambda current, base=base_row, candidate=candidate_row: (candidate,) if current == base else (),
509:             )
510:             selected[arm] = (0,) if chosen.assignment == base_assignment else (action_index,)
511:         outcome = specification["fixture_outcomes"]
512:         pooled = {
513:             arm: (float(outcome["base_bits"]) + float(outcome["bits_per_action_index"]) * profile[0])
514:             / (float(outcome["base_joules"]) + float(outcome["joules_per_action_index"]) * profile[0])
515:             for arm, profile in selected.items()
516:         }
517:         passed = selected[full] != selected[comparator] and pooled[full] != pooled[comparator]
518:         results.append({
519:             "pair": f"{full}-vs-{comparator}", "route_pool": route,
520:             "selected_action_index": {arm: profile[0] for arm, profile in selected.items()},
521:             "raw_model_score_delta": {arm: deltas[arm][witness] for arm in (full, comparator)},
522:             "shared_arm_independent_catalogue_term": shared_catalogue_term,
523:             "adjusted_selection_score": adjusted_scores,
524:             "selection_path": "mcrl.stagec_v025.c3_panel.first_improvement",
525:             "pooled_fixture_ee_bits_per_j": pooled, "selection_different": selected[full] != selected[comparator],
526:             "pooled_ee_different": pooled[full] != pooled[comparator], "verdict": "PASS" if passed else "FAIL",
527:         })
528:     verdict = "PASS" if all(row["verdict"] == "PASS" for row in results) else "FAIL"
529:     receipt = {
530:         "schema": specification["schema"], "fixture_path": str(FIXTURE),
531:         "fixture_sha256": _sha256(FIXTURE), "training_epochs": gate_epochs,
532:         "checkpoint": str(checkpoint), "checkpoint_sha256": checkpoint_digest,
533:         "sealed_loader_readback": "PASS", "pairs": results, "verdict": verdict,
534:         "not_ee_evidence": True,
535:     }
536:     if verdict != "PASS":
537:         raise StageCContractError(f"arm-difference fixture gate FAIL: {results}")
538:     return receipt
539: 
540: 
541: def train_requested(batches: Mapping[str, object], output: Path, seeds: Sequence[int], epochs: int, cadence: int):
542:     checkpoint_records = []
543:     seed_timings = []
544:     for seed in seeds:
545:         trainer = V1LineageOrchestrator(
546:             learner_seed=seed, q1_batch=batches["pairs"]["C1"], q2_batch=batches["pairs"]["C2"],
547:             c3_batch=batches["c3"], neutral_sources=default_synthetic_neutral_sources(),
548:         )
549:         started = time.perf_counter()
550:         for _ in range(epochs):
551:             trainer.train_epoch()
552:             if trainer.completed_source_epochs % cadence == 0:
553:                 path = output / "checkpoints" / f"learner-{seed}-epoch-{trainer.completed_source_epochs:06d}.json"
554:                 digest = trainer.write_checkpoint(path)
555:                 restored = V1LineageOrchestrator(
556:                     learner_seed=seed, q1_batch=batches["pairs"]["C1"], q2_batch=batches["pairs"]["C2"],
557:                     c3_batch=batches["c3"], neutral_sources=default_synthetic_neutral_sources(),
558:                 )
559:                 restored.load_checkpoint(path)
560:                 checkpoint_records.append({
561:                     "seed": seed, "completed_source_epochs": trainer.completed_source_epochs,
562:                     "path": str(path), "sha256": digest, "sealed_loader_readback": "PASS",
