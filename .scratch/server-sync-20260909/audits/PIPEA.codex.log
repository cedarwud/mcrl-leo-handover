512: 
513: def _pool(outcomes: Iterable[Mapping[str, float | int]]) -> dict[str, float | int]:
514:     rows = tuple(outcomes)
515:     totals = {name: math.fsum(float(row[name]) for row in rows) for name in OUTCOME_FIELDS[:2]}
516:     for name in OUTCOME_FIELDS[2:]:
517:         totals[name] = sum(int(row[name]) for row in rows)
518:     bits = float(totals["full_buffer_bits"])
519:     joules = float(totals["joules"])
520:     if joules <= 0.0:
521:         raise ScorerContractError("pooled energy denominator is not positive")
522:     def rate(numerator: str, denominator: str) -> float | None:
523:         return None if totals[denominator] == 0 else float(totals[numerator]) / float(totals[denominator])
524:     return {
525:         **totals,
526:         "pooled_ee_bits_per_j": bits / joules,
527:         "rate_target_attainment": rate("rate_target_attained", "rate_target_opportunities"),
528:         "service_availability": rate("service_available", "service_opportunities"),
529:         "handover_rate": rate("handovers", "handover_opportunities"),
530:         "deadline_miss_rate": rate("deadline_misses", "decisions"),
531:     }
532: 
