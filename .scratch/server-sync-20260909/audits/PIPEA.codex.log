125: 
126: def _require_object(value: object, field: str) -> Mapping[str, object]:
127:     if not isinstance(value, Mapping):
128:         raise ScorerContractError(f"{field} must be an object")
129:     return value
130: 
131: 
132: def _finite_number(value: object, field: str, *, nonnegative: bool = False) -> float:
133:     if isinstance(value, bool) or not isinstance(value, (int, float)):
134:         raise ScorerContractError(f"{field} must be numeric")
135:     number = float(value)
136:     if not math.isfinite(number) or (nonnegative and number < 0.0):
137:         raise ScorerContractError(f"{field} must be finite{' and nonnegative' if nonnegative else ''}")
138:     return number
139: 
140: 
141: def _count(value: object, field: str) -> int:
142:     if isinstance(value, bool) or not isinstance(value, int) or value < 0:
143:         raise ScorerContractError(f"{field} must be a nonnegative integer")
144:     return value
145: 
146: 
147: def _decode_vector(values: object, field: str) -> tuple[float, ...]:
148:     if not isinstance(values, list):
149:         raise ScorerContractError(f"{field} must be an array")
150:     result = []
151:     for value in values:
152:         if not isinstance(value, str):
153:             raise ScorerContractError(f"{field} checkpoint values must be float.hex strings")
154:         try:
155:             number = float.fromhex(value)
156:         except ValueError as error:
157:             raise ScorerContractError(f"{field} contains an invalid float.hex value") from error
158:         if not math.isfinite(number):
159:             raise ScorerContractError(f"{field} contains a non-finite value")
160:         result.append(number)
161:     return tuple(result)
162: 
163: 
164: def _decode_layers(values: object, field: str) -> tuple[tuple[tuple[float, ...], ...], ...]:
165:     if not isinstance(values, list) or not values:
166:         raise ScorerContractError(f"{field} must contain layers")
167:     layers = []
168:     for layer_index, layer in enumerate(values):
169:         if not isinstance(layer, list) or not layer:
170:             raise ScorerContractError(f"{field}[{layer_index}] must be a nonempty matrix")
171:         rows = tuple(_decode_vector(row, f"{field}[{layer_index}]") for row in layer)
172:         width = len(rows[0])
173:         if width == 0 or any(len(row) != width for row in rows):
174:             raise ScorerContractError(f"{field}[{layer_index}] is ragged")
175:         layers.append(rows)
176:     return tuple(layers)
177: 
178: 
179: class Head:
180:     def __init__(self, payload: object, field: str) -> None:
181:         source = _require_object(payload, field)
182:         self.kind = source.get("kind")
183:         expected = (
184:             "permutation_invariant_set_conditioned_legacy_adam_mlp"
185:             if field.endswith(".C3")
186:             else "legacy_heterogeneous_adam_mlp"
187:         )
188:         if self.kind != expected:
189:             raise ScorerContractError(f"{field} kind drifted: {self.kind!r}")
190:         activation = source.get("activation")
191:         if activation not in {"relu", "tanh"}:
192:             raise ScorerContractError(f"{field} activation drifted")
193:         self.activation = str(activation)
194:         self.weights = _decode_layers(source.get("weights_hex"), f"{field}.weights_hex")
195:         biases = source.get("biases_hex")
196:         if not isinstance(biases, list) or len(biases) != len(self.weights):
197:             raise ScorerContractError(f"{field} bias layer inventory drifted")
198:         self.biases = tuple(
199:             _decode_vector(layer, f"{field}.biases_hex[{index}]")
200:             for index, layer in enumerate(biases)
201:         )
202:         prior = len(self.weights[0])
203:         for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
204:             if len(weights) != prior or len(weights[0]) != len(bias):
205:                 raise ScorerContractError(f"{field} layer {index} shape drifted")
206:             prior = len(bias)
207:         if prior != 1:
208:             raise ScorerContractError(f"{field} output width must be one")
209:         self.input_width = len(self.weights[0])
210:         member_width = source.get("member_width")
211:         self.member_width = None if member_width is None else _count(member_width, f"{field}.member_width")
212: 
213:     def score(self, state: Sequence[float]) -> float:
214:         if len(state) != self.input_width:
215:             raise ScorerContractError(
216:                 f"model input width {len(state)} differs from checkpoint width {self.input_width}"
217:             )
218:         current = [float(value) for value in state]
219:         for layer_index, (weights, biases) in enumerate(zip(self.weights, self.biases, strict=True)):
220:             following = [
221:                 math.fsum(current[row] * weights[row][column] for row in range(len(current))) + bias
222:                 for column, bias in enumerate(biases)
223:             ]
224:             if layer_index != len(self.weights) - 1:
225:                 if self.activation == "relu":
226:                     following = [max(0.0, value) for value in following]
227:                 else:
228:                     following = [math.tanh(value) for value in following]
229:             current = following
230:         if not math.isfinite(current[0]):
231:             raise ScorerContractError("checkpoint produced a non-finite score")
232:         return current[0]
