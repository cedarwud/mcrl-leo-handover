436:             raise ScorerContractError(f"{field} catalogue order is not unique")
437:         profiles.sort(key=lambda item: item["catalogue_order"])
438:         for reference_field in (
439:             "base_profile_id", "certified_fixed_point_profile_id", "anytime_incumbent_profile_id"
440:         ):
441:             if anchor[reference_field] not in profile_ids:
442:                 raise ScorerContractError(f"{field}.{reference_field} is not in the catalogue")
443:         arm_instrumentation = anchor.get("arm_instrumentation")
444:         if recorded:
445:             arm_rows = _require_object(arm_instrumentation, f"{field}.arm_instrumentation")
446:             if set(arm_rows) != set(ARMS):
447:                 raise ScorerContractError(f"{field} must record instrumentation for all five arms")
448:             cleaned_instrumentation = {}
449:             for arm in ARMS:
450:                 row = _require_object(arm_rows[arm], f"{field}.arm_instrumentation.{arm}")
451:                 if set(row) != {"physics_evaluations", "wall_clock_to_decision_s"}:
452:                     raise ScorerContractError(f"{field}.{arm} instrumentation fields drifted")
453:                 cleaned_instrumentation[arm] = {
454:                     "physics_evaluations": _count(row["physics_evaluations"], f"{field}.{arm}.physics_evaluations"),
455:                     "wall_clock_to_decision_s": _finite_number(
456:                         row["wall_clock_to_decision_s"], f"{field}.{arm}.wall_clock_to_decision_s", nonnegative=True
457:                     ),
458:                 }
459:         else:
460:             if arm_instrumentation is not None:
461:                 raise ScorerContractError("panel says runner fields are absent but supplies instrumentation")
462:             cleaned_instrumentation = None
463:         anchors.append({
464:             "anchor_id": anchor_id,
465:             "world_id": anchor.get("world_id"),
466:             "date": anchor.get("date"),
467:             "world_seed": anchor.get("world_seed"),
468:             "base_profile_id": anchor.get("base_profile_id"),
469:             "certified_fixed_point_profile_id": anchor.get("certified_fixed_point_profile_id"),
470:             "anytime_incumbent_profile_id": anchor.get("anytime_incumbent_profile_id"),
471:             "profiles": profiles,
472:             "arm_instrumentation": cleaned_instrumentation,
473:         })
474:     expected_anchor_ids = [anchor["anchor_id"] for anchor in anchors]
475:     if identity.get("anchors") != expected_anchor_ids:
476:         raise ScorerContractError("panel identity anchor list differs from anchor rows or order")
477:     return {
478:         "path": None if panel_path is None else str(panel_path.resolve()),
479:         "sha256": _canonical_sha256(panel) if panel_path is None else _sha256(panel_path),
480:         "identity": dict(identity),
