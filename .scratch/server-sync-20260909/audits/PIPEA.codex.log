1: """Locate, verify and load the vendored sealed physics tree.
2: 
3: The sealed tree under ``sealed/`` is a byte-identical copy of the source tree
4: that produced the archived twenty-anchor receipts.  Nothing in this module
5: writes to it.  ``MANIFEST.sha256`` is checked on every load, so any harness
6: number can be traced back to an exact set of physics bytes.
7: """
8: 
9: from __future__ import annotations
10: 
11: from dataclasses import dataclass
12: import hashlib
13: import importlib.util
14: from pathlib import Path
15: import sys
16: 
17: REPO = Path(__file__).resolve().parents[1]
18: SEALED_ROOT = REPO / "sealed"
19: SEALED_SRC = SEALED_ROOT / "src"
20: MANIFEST_PATH = SEALED_ROOT / "MANIFEST.sha256"
21: REFERENCE_RUNNER = SEALED_ROOT / ".scratch/ladder-floor-20260910/oracle_runner.py"
22: PROBE = SEALED_ROOT / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
23: 
24: # Recorded in the archived receipts; the tree is worthless if this drifts.
25: EXPECTED_PROBE_SHA256 = "f4122d6784cb56de7743c55d51dc80a6c968ccea601d637cd1b41a8b5604c76c"
26: 
27: 
28: class SealedTreeError(RuntimeError):
29:     """The vendored sealed tree does not match its manifest."""
30: 
31: 
32: @dataclass(frozen=True)
33: class SealedTree:
34:     root: Path
35:     manifest_sha256: str
36:     file_count: int
37:     probe_sha256: str
38: 
39: 
40: def _read_manifest() -> list[tuple[str, str]]:
41:     rows = []
42:     for line in MANIFEST_PATH.read_text(encoding="ascii").splitlines():
43:         if not line.strip():
44:             continue
45:         digest, _, relative = line.partition("  ")
46:         rows.append((digest, relative))
47:     return rows
48: 
49: 
50: def verify() -> SealedTree:
51:     """Re-hash every vendored file and compare against the manifest."""
52: 
53:     rows = _read_manifest()
54:     for digest, relative in rows:
55:         path = SEALED_ROOT / relative
56:         if not path.is_file():
57:             raise SealedTreeError(f"sealed file is missing: {relative}")
58:         actual = hashlib.sha256(path.read_bytes()).hexdigest()
59:         if actual != digest:
60:             raise SealedTreeError(
61:                 f"sealed file changed: {relative} {actual} != {digest}"
62:             )
63:     probe_sha256 = hashlib.sha256(PROBE.read_bytes()).hexdigest()
64:     if probe_sha256 != EXPECTED_PROBE_SHA256:
65:         raise SealedTreeError(
66:             f"probe source digest {probe_sha256} != archived {EXPECTED_PROBE_SHA256}"
