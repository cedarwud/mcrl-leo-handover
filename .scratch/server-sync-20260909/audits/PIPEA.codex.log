68: class PanelTrainer:
69:     """Matched initialization and all-head updates for the eight learned arms."""
70: 
71:     def __init__(
72:         self,
73:         *,
74:         learner_seed: int,
75:         q1_batch: PairwiseBatch,
76:         q2_batch: PairwiseBatch,
77:         c3_batch: CoalitionBatch,
78:         neutral_sources: Mapping[Route, NeutralSourceDefinition],
79:     ) -> None:
80:         # Reuse the production initializer and head implementations.  The
81:         # production five-arm schema is not changed or reinterpreted.
82:         base = V1LineageOrchestrator(
83:             learner_seed=learner_seed,
84:             q1_batch=q1_batch,
