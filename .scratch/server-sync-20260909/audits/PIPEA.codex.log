818: def _discover_checkpoints(paths: Sequence[Path]) -> list[Path]:
819:     found = []
820:     for path in paths:
821:         resolved = path.resolve()
822:         if resolved.is_dir():
823:             for candidate in sorted(resolved.rglob("*.json")):
824:                 try:
825:                     value = _read_json(candidate)
826:                 except ScorerContractError:
827:                     continue
828:                 if isinstance(value, Mapping) and value.get("schema") == CHECKPOINT_SCHEMA:
829:                     found.append(candidate)
830:         elif resolved.is_file():
831:             found.append(resolved)
832:         else:
833:             raise ScorerContractError(f"checkpoint path does not exist: {path}")
834:     unique = []
835:     seen = set()
836:     for path in found:
837:         identity = str(path.resolve())
838:         if identity not in seen:
839:             unique.append(path)
840:             seen.add(identity)
841:     if not unique:
842:         raise ScorerContractError("no Stage-C checkpoint was found")
843:     return unique
