1: """C3 neutral-source panel instrument.
2: 
3: This module is deliberately an instrument, not an experiment runner.  It
4: defines the complete 2^3 learned source factorial, trains every retained head,
5: keeps arm-owned proposal/catalogue state separate, realises only the union of
6: selected physical configurations, and reports (never filters) the declared
7: reference-degeneracy split.
8: """
9: 
10: from __future__ import annotations
11: 
12: from dataclasses import dataclass
13: from fractions import Fraction
14: import math
15: from typing import Callable, Generic, Mapping, Sequence, TypeVar
16: 
17: from .canonical import StageCContractError, canonical_sha256
18: from .learner import (
19:     AdamMLPHead,
20:     AdamSetInteractionHead,
21:     CoalitionBatch,
22:     NeutralSourceDefinition,
23:     PairwiseBatch,
24:     ROUTES,
25:     Route,
26:     V1LineageOrchestrator,
27:     V1ThreeRouteModel,
28: )
29: 
30: 
31: # The listed intervention is the complete binary factorial: eight learned
32: # arms.  BASELINE is the ninth panel arm and has no learned heads.
33: PANEL_LEARNED_ARMS = (
34:     "FULL",
35:     "DROP_C1",
36:     "DROP_C2",
37:     "DROP_C3",
38:     "ONLY_C1",
39:     "ONLY_C2",
40:     "ONLY_C3",
41:     "ALL_NEUTRAL_CONTROL",
42: )
43: EXTERNAL_CONTROL = "BASELINE"
44: PANEL_ARM_ORDER = (*PANEL_LEARNED_ARMS, EXTERNAL_CONTROL)
45: PANEL_SOURCE_MAP: Mapping[str, Mapping[Route, str]] = {
46:     "FULL": {"C1": "informed", "C2": "informed", "C3": "informed"},
47:     "DROP_C1": {"C1": "neutral", "C2": "informed", "C3": "informed"},
48:     "DROP_C2": {"C1": "informed", "C2": "neutral", "C3": "informed"},
49:     "DROP_C3": {"C1": "informed", "C2": "informed", "C3": "neutral"},
50:     "ONLY_C1": {"C1": "informed", "C2": "neutral", "C3": "neutral"},
51:     "ONLY_C2": {"C1": "neutral", "C2": "informed", "C3": "neutral"},
52:     "ONLY_C3": {"C1": "neutral", "C2": "neutral", "C3": "informed"},
53:     "ALL_NEUTRAL_CONTROL": {"C1": "neutral", "C2": "neutral", "C3": "neutral"},
54: }
55: PROVISIONING_RULES = ("SEALED", "MARGIN_Q")
56: 
57: 
58: def provisioning_rule(name: str) -> str:
59:     """Validate the named physics rule selected by the command line."""
60: 
61:     if name not in PROVISIONING_RULES:
62:         raise StageCContractError(
63:             f"unknown provisioning rule {name!r}; expected one of {PROVISIONING_RULES}"
64:         )
65:     return name
66: 
