738:     def select_timed(self, *, deadline_s: float = DEPLOYMENT_DEADLINE_S, **kwargs: object) -> SelectorDecision:
739:         """F2: validate BASE in the parent, then kill the coordinator on timeout."""
740: 
741:         base_profile = kwargs.get("base_profile")
742:         jointly_legal = kwargs.get("jointly_legal")
743:         service_guard = kwargs.get("service_guard")
744:         if (
745:             not isinstance(base_profile, tuple)
746:             or not callable(jointly_legal)
747:             or not callable(service_guard)
748:             or not jointly_legal(base_profile)
749:             or not service_guard(base_profile)
750:         ):
751:             raise StageCContractError("timed selector requires prevalidated BASE")
752:         if deadline_s <= 0.0:
753:             raise StageCContractError("selector deadline must be positive")
754:         context = multiprocessing.get_context("fork")
755:         parent, child = context.Pipe(duplex=False)
756: 
757:         def work() -> None:
758:             try:
759:                 child.send(("ok", self.select(**kwargs)))
760:             except BaseException as error:
761:                 child.send(("error", type(error).__name__))
762:             finally:
763:                 child.close()
764: 
765:         started = time.monotonic()
766:         process = context.Process(target=work, name="stagec-profile-selector")
767:         process.start()
768:         child.close()
769:         process.join(deadline_s)
770:         if process.is_alive():
771:             pid = process.pid
772:             process.kill()
773:             process.join()
774:             parent.close()
775:             return SelectorDecision(
776:                 self.mode,
777:                 base_profile,
778:                 0.0,
779:                 True,
780:                 "runner_deadline_process_killed",
781:                 None,
782:                 0,
783:                 time.monotonic() - started,
784:                 pid,
785:                 not process.is_alive(),
786:             )
787:         elapsed = time.monotonic() - started
788:         if not parent.poll():
789:             parent.close()
790:             return SelectorDecision(
791:                 self.mode, base_profile, 0.0, True, "coordinator_worker_failed", None, 0,
792:                 elapsed, process.pid, False,
793:             )
794:         status, payload = parent.recv()
795:         parent.close()
796:         if status != "ok" or not isinstance(payload, SelectorDecision):
797:             return SelectorDecision(
798:                 self.mode, base_profile, 0.0, True,
799:                 f"coordinator_worker_error:{payload}", None, 0, elapsed, process.pid, False,
800:             )
801:         return SelectorDecision(
802:             payload.mode, payload.profile, payload.score, payload.used_fallback,
803:             payload.fallback_reason, payload.local_optimum_certified,
804:             payload.evaluated_profiles, elapsed, process.pid, False,
805:         )
