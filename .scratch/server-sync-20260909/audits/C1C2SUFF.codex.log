from collections import defaultdict
from fractions import Fraction
import json, struct, hashlib
from scripts.diagnose_v025_c1c2_sufficiency import _calibration,_relabel_anchor
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS,REFERENCE_CARRIERS,build_world_tape
T=build_world_tape(domain=DEVELOPMENT_WORLD_DOMAINS[0],provider=LegacyWorldProvider(role='pilot-source'),steps=4,start_time_s=0.0)
rows=[]
for a in (0,1): rows.extend(_relabel_anchor(T,_calibration(),a))
g=defaultdict(list)
for r in rows:g[(r.q1,r.q2)].append(r)
cs=[v for v in g.values() if len(v)>1 and len({r.c2_target_exact for r in v})>1]
v=cs[0]
a,b=v
def hx(q):return struct.pack(f'>{len(q)}d',*q).hex()
