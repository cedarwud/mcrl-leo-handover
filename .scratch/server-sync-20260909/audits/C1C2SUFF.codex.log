"""Acceptance witness for production C1/C2 label generation.

The legacy-provider tape is real production input.  Runtime is bounded by
retaining one user and at most three singleton configurations per anchor; no
physics, price, horizon, service, or acceptance constant is changed.
"""

from __future__ import annotations

from fractions import Fraction
import json
from pathlib import Path
import sys

import pytest

from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
from mcrl.physics_v025.targets import (
    c1_difference_surplus,
    c2_persistence_forecast,
)
from mcrl.stagec_v025.canonical import parse_float_hex


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "scripts"))
import run_v025_pilot_c3 as pilot  # noqa: E402

NORMALIZED_ABS_TOL = 1e-9
ANCHOR_STEPS = (0, 1)
CARRIER = "nearest-eligible"


def _fraction(pair: list[int]) -> Fraction:
    return Fraction(pair[0], pair[1])


@pytest.fixture(scope="module")
def real_context():
    tape = build_world_tape(
        domain=DEVELOPMENT_WORLD_DOMAINS[0],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=max(ANCHOR_STEPS) + 4,
        start_time_s=0.0,
    )
    payload = json.loads(
        (
            ROOT
            / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
            / "PILOT_NOT_CLAIM-calibration.json"
        ).read_text()
    )
    calibration = pilot.PilotCalibration(
        eta_ref=_fraction(payload["eta_ref"]),
        lambda_bits_per_j=_fraction(payload["lambda_bits_per_j"]),
        kappa_bits_per_user_step=_fraction(payload["kappa_bits_per_user_step"]),
        bits_ref=_fraction(payload["bits_ref"]),
        joules_ref=_fraction(payload["joules_ref"]),
        users=int(payload["users"]),
    )
    return tape, pilot.ENGINE._setting("a-r0"), pilot.ENGINE.run_setting_for("a-r0"), calibration


def _limit_to_real_singletons(monkeypatch: pytest.MonkeyPatch) -> None:
    original = pilot._action_configs

    def limited(tape, step_index, base, run_setting, *, full_legal):
        by_user, configs, census = original(
            tape, step_index, base, run_setting, full_legal=full_legal
        )
        for user in sorted(by_user):
            reference = base.mapping[user]
            alternatives = tuple(
                identity
                for identity in by_user[user]
                if identity is not None and identity != reference
            )
            if alternatives:
                identities = tuple(dict.fromkeys((reference, alternatives[0], None)))
                return (
                    {user: identities},
                    {(user, identity): configs[(user, identity)] for identity in identities},
                    census,
                )
        raise AssertionError("real anchor exposed no non-reference singleton")

    monkeypatch.setattr(pilot, "_action_configs", limited)


def _anchor_rows(real_context, monkeypatch: pytest.MonkeyPatch, step_index: int):
    tape, setting, run_setting, calibration = real_context
    _limit_to_real_singletons(monkeypatch)
    built = pilot._build_anchor_rows(
        tape=tape,
        setting=setting,
        run_setting=run_setting,
        calibration=calibration,
        step_index=step_index,
        carrier=CARRIER,
        anchor_index=step_index,
        include_coalition=False,
    )
    return built, tape, setting, run_setting, calibration


def _exact_singletons(built, tape, setting, run_setting, calibration, step_index: int):
    base = pilot.ENGINE._base_configuration(tape, step_index, CARRIER)
    incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), CARRIER)
    configs = {base.configuration_id: base}
    for row in built["rows"]:
        identity = pilot._identity(row.action)
        mapping = base.mapping
        mapping[row.user_id] = identity
        config = pilot.ENGINE._configuration(base, mapping, kind="acceptance-singleton")
        configs[config.configuration_id] = config

    counter = pilot.ENGINE.EvaluationCounter()
    evaluator = pilot.ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    evaluator.evaluate_many(tuple(configs.values()))
    valid = tuple(
        config
        for config in configs.values()
        if config.configuration_id not in evaluator._invalid
    )
    forecasts, _ = pilot.ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=CARRIER,
        configs=valid,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_profile = evaluator.evaluate(base)
    base_outcome = base_profile.outcome(
        phi=pilot.ENGINE._phi_for(
            incumbent,
            base,
            cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
        )
    )
    return base, incumbent, evaluator, forecasts, base_outcome


@pytest.mark.parametrize("step_index", ANCHOR_STEPS)
def test_production_c1_labels_equal_exact_evaluator_singletons(
    real_context, monkeypatch: pytest.MonkeyPatch, step_index: int
) -> None:
    built, tape, setting, run_setting, calibration = _anchor_rows(
        real_context, monkeypatch, step_index
    )
    base, incumbent, evaluator, _forecasts, base_outcome = _exact_singletons(
        built, tape, setting, run_setting, calibration, step_index
    )
    for row in built["rows"]:
        identity = pilot._identity(row.action)
        mapping = base.mapping
        mapping[row.user_id] = identity
        config = pilot.ENGINE._configuration(base, mapping, kind="acceptance-singleton")
        if config.configuration_id in evaluator._invalid:
            continue
        candidate = evaluator.evaluate(config).outcome(
            phi=pilot.ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
            )
        )
        exact = c1_difference_surplus(
            candidate,
            base_outcome,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        actual = parse_float_hex(
            row.c1_label_normalized_hex, field="c1_label_normalized_hex"
        )
        expected = float(exact.normalized_total)
        assert actual == pytest.approx(expected, abs=NORMALIZED_ABS_TOL, rel=0.0), (
            "production C1 label disagrees with exact evaluator singleton: "
            f"anchor={step_index} user={row.user_id} action={identity} "
            f"actual={actual:.17g} exact={expected:.17g} "
            f"abs_tol={NORMALIZED_ABS_TOL}"
        )


@pytest.mark.parametrize("step_index", ANCHOR_STEPS)
def test_production_c2_labels_equal_exact_evaluator_singletons(
    real_context, monkeypatch: pytest.MonkeyPatch, step_index: int
) -> None:
    built, tape, setting, run_setting, calibration = _anchor_rows(
        real_context, monkeypatch, step_index
    )
    base, _incumbent, evaluator, forecasts, _base_outcome = _exact_singletons(
        built, tape, setting, run_setting, calibration, step_index
    )
    for row in built["rows"]:
        identity = pilot._identity(row.action)
        mapping = base.mapping
        mapping[row.user_id] = identity
        config = pilot.ENGINE._configuration(base, mapping, kind="acceptance-singleton")
        if config.configuration_id in evaluator._invalid:
            continue
        exact = c2_persistence_forecast(
            forecasts[config.configuration_id],
            forecasts[base.configuration_id],
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
        )
        actual = parse_float_hex(
            row.c2_label_normalized_hex, field="c2_label_normalized_hex"
        )
        expected = float(exact.normalized_total)
        assert actual == pytest.approx(expected, abs=NORMALIZED_ABS_TOL, rel=0.0), (
            "production C2 label disagrees with exact evaluator singleton: "
            f"anchor={step_index} user={row.user_id} action={identity} "
            f"actual={actual:.17g} exact={expected:.17g} "
            f"abs_tol={NORMALIZED_ABS_TOL}"
        )
