@dataclass(frozen=True)
class ExactRow:
    anchor: int
    q1: tuple[float, ...]
    q2: tuple[float, ...]
    c1_structure: tuple[float, ...]
    c2_structure: tuple[float, ...]
    c1_target: float
    c2_target: float


def _f(value: Fraction) -> float:
    return float(value)


def _relabel_anchor(tape, calibration, anchor_index: int) -> list[ExactRow]:
    step_index, carrier_index = divmod(anchor_index, len(REFERENCE_CARRIERS))
    carrier = REFERENCE_CARRIERS[carrier_index]
    setting = pilot.ENGINE._setting("a-r0")
    run_setting = pilot.ENGINE.run_setting_for("a-r0")
    shard = read_source_shard(
        EXISTING_ROWS / f"PILOT_NOT_CLAIM-source-anchor-{anchor_index:03d}.jsonl"
    )
    base = pilot.ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = pilot.ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    configs = {base.configuration_id: base}
    row_configs = []
    for row in shard.rows:
        mapping = base.mapping
        mapping[row.user_id] = pilot._identity(row.action)
        config = pilot.ENGINE._configuration(base, mapping, kind="sufficiency-replay")
        configs[config.configuration_id] = config
        row_configs.append((row, config))

    counter = pilot.ENGINE.EvaluationCounter()
    evaluator = pilot.ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=pilot.ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    evaluator.evaluate_many(tuple(configs.values()))
    valid = tuple(
        config
        for config in configs.values()
        if config.configuration_id not in evaluator._invalid
    )
    forecasts, _ = pilot.ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_profile = evaluator.evaluate(base)
    rekeys = pilot.ENGINE._rekeyed_users(tape, step_index)
    base_outcome = base_profile.outcome(
        phi=pilot.ENGINE._phi_for(incumbent, base, cell_rekeyed_users=rekeys)
    )
    kappa = calibration.kappa_bits_per_user_step
    eta = calibration.eta_ref
    result = []
    for row, config in row_configs:
        if row.reference_action or config.configuration_id in evaluator._invalid:
            continue
        profile = evaluator.evaluate(config)
        outcome = profile.outcome(
            phi=pilot.ENGINE._phi_for(incumbent, config, cell_rekeyed_users=rekeys)
        )
        c1 = c1_difference_surplus(
            outcome,
            base_outcome,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=eta,
            kappa_bits_per_user_step=kappa,
        )
        candidate_forecasts = forecasts[config.configuration_id]
        c2 = c2_persistence_forecast(
            candidate_forecasts,
            forecasts[base.configuration_id],
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=eta,
            kappa_bits_per_user_step=kappa,
        )
        c1_structure = (
            _f(outcome.bits / kappa),
            _f(eta * outcome.joules / kappa),
            _f(outcome.phi),
            _f(base_outcome.bits / kappa),
            _f(eta * base_outcome.joules / kappa),
            _f(base_outcome.phi),
            float(profile.required_power_w_max / 1.65),
            float(profile.score.decoding_time_s.get(row.user_id, 0.0)),
        )
        c2_values: list[float] = []
        for candidate_projection, default_projection in zip(
            candidate_forecasts, forecasts[base.configuration_id], strict=True
        ):
            for projection in (candidate_projection, default_projection):
                c2_values.extend(
                    (
                        _f(projection.outcome.bits / kappa),
                        _f(eta * projection.outcome.joules / kappa),
                        _f(projection.outcome.decoding_availability),
                        _f(projection.outcome.useful_availability),
                        float(projection.valid),
                        float(projection.survives),
                        -1.0 if projection.required_power_w is None else projection.required_power_w / 1.65,
                    )
                )
        result.append(
            ExactRow(
                anchor_index,
                row.q1_state,
                row.q2_state,
                c1_structure,
                tuple(c2_values),
                float(c1.normalized_total),
                float(c2.normalized_total),
            )
        )
    return result


def _standardize(train: np.ndarray, other: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    mean = train.mean(axis=0)
    scale = train.std(axis=0)
    scale[scale < 1e-12] = 1.0
    return (train - mean) / scale, (other - mean) / scale


def _knn_predict(
    train_x: np.ndarray,
    train_y: np.ndarray,
    test_x: np.ndarray,
    *,
    neighbors: int,
    chunk_size: int = 128,
) -> np.ndarray:
    predictions = []
    k = min(neighbors, len(train_x))
    train_norm = np.einsum("ij,ij->i", train_x, train_x)
    for start in range(0, len(test_x), chunk_size):
        chunk = test_x[start : start + chunk_size]
        distances = (
            np.einsum("ij,ij->i", chunk, chunk)[:, None]
            + train_norm[None, :]
            - 2.0 * chunk @ train_x.T
        )
        indices = np.argpartition(distances, kth=k - 1, axis=1)[:, :k]
        selected_distances = np.take_along_axis(distances, indices, axis=1)
        weights = 1.0 / np.maximum(selected_distances, 1e-12)
        selected_y = train_y[indices]
        predictions.append((weights * selected_y).sum(axis=1) / weights.sum(axis=1))
    return np.concatenate(predictions)


def _explained_variance(actual: np.ndarray, predicted: np.ndarray) -> float:
    variance = float(np.var(actual))
    return float("nan") if variance == 0.0 else 1.0 - float(np.var(actual - predicted)) / variance


def _fit_route(
    rows: list[ExactRow],
    *,
    route: str,
    train_anchors: set[int],
    validation_anchors: set[int],
    test_anchors: set[int],
) -> dict[str, object]:
    q_name = {"C1": "q1", "C2": "q2"}[route]
    target_name = f"{route.lower()}_target"
    structure_name = f"{route.lower()}_structure"
    candidates = (1, 3, 7, 15, 31)

    def matrix(selected: list[ExactRow], include_structure: bool) -> np.ndarray:
        values = []
        for row in selected:
            q = getattr(row, q_name)
            structure = getattr(row, structure_name)
            values.append((*q, *structure) if include_structure else q)
        return np.asarray(values, dtype=np.float64)

    def select(anchors: set[int]) -> list[ExactRow]:
        return [row for row in rows if row.anchor in anchors]

    fit_rows = select(train_anchors)
    validation_rows = select(validation_anchors)
    all_train_rows = select(train_anchors | validation_anchors)
    test_rows = select(test_anchors)
    fit_y = np.asarray([getattr(row, target_name) for row in fit_rows])
    validation_y = np.asarray([getattr(row, target_name) for row in validation_rows])
    all_train_y = np.asarray([getattr(row, target_name) for row in all_train_rows])
    test_y = np.asarray([getattr(row, target_name) for row in test_rows])

    results = {}
    for name, include_structure in (("q_only", False), ("q_plus_discarded_structure", True)):
        fit_x = matrix(fit_rows, include_structure)
        validation_x = matrix(validation_rows, include_structure)
        fit_x, validation_x = _standardize(fit_x, validation_x)
        scores = {}
        for neighbors in candidates:
            prediction = _knn_predict(
                fit_x, fit_y, validation_x, neighbors=neighbors
            )
            scores[neighbors] = _explained_variance(validation_y, prediction)
        selected_k = max(scores, key=lambda value: (scores[value], -value))

        train_x = matrix(all_train_rows, include_structure)
        test_x = matrix(test_rows, include_structure)
        train_x, test_x = _standardize(train_x, test_x)
        prediction = _knn_predict(
            train_x, all_train_y, test_x, neighbors=selected_k
        )
        residual = test_y - prediction
        results[name] = {
            "model": "standardized inverse-distance k-nearest-neighbor",
            "selected_k": selected_k,
            "validation_explained_variance_by_k": {
                str(key): value for key, value in scores.items()
            },
            "held_out_explained_variance": _explained_variance(test_y, prediction),
            "held_out_rmse": float(np.sqrt(np.mean(residual * residual))),
            "held_out_mae": float(np.mean(np.abs(residual))),
        }
    results["explained_variance_gap"] = (
        results["q_plus_discarded_structure"]["held_out_explained_variance"]
        - results["q_only"]["held_out_explained_variance"]
    )
    return results


def explainability(anchor_count: int) -> dict[str, object]:
    if anchor_count < 6 or anchor_count > 90:
        raise ValueError("anchor_count must be in [6, 90]")
    anchor_indices = tuple(range(anchor_count))
    max_step = max(index // len(REFERENCE_CARRIERS) for index in anchor_indices)
    tape = build_world_tape(
        domain=DEVELOPMENT_WORLD_DOMAINS[0],
        provider=LegacyWorldProvider(role="pilot-source"),
        steps=max_step + 4,
        start_time_s=0.0,
    )
    calibration = _calibration()
    rows = []
    for anchor_index in anchor_indices:
        rows.extend(_relabel_anchor(tape, calibration, anchor_index))
        print(
            json.dumps(
                {"phase": "exact-relabel", "anchor": anchor_index, "rows": len(rows)}
            ),
            file=sys.stderr,
            flush=True,
        )
    rng = np.random.default_rng(20260909)
    shuffled = list(anchor_indices)
    rng.shuffle(shuffled)
    test_count = max(2, anchor_count // 4)
    validation_count = max(1, anchor_count // 6)
    test = set(shuffled[:test_count])
    validation = set(shuffled[test_count : test_count + validation_count])
    train = set(shuffled[test_count + validation_count :])
    return {
        "source": str(EXISTING_ROWS.relative_to(ROOT)),
        "world": DEVELOPMENT_WORLD_DOMAINS[0],
        "anchor_indices": list(anchor_indices),
        "exact_relabelled_nonreference_valid_rows": len(rows),
        "split_unit": "whole anchor",
        "train_anchors": sorted(train),
        "validation_anchors": sorted(validation),
        "test_anchors": sorted(test),
        "split_seed": 20260909,
        "c1": _fit_route(
            rows,
            route="C1",
            train_anchors=train,
            validation_anchors=validation,
            test_anchors=test,
        ),
        "c2": _fit_route(
            rows,
            route="C2",
            train_anchors=train,
            validation_anchors=validation,
            test_anchors=test,
        ),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--anchors", type=int, default=12)
    parser.add_argument("--collisions-only", action="store_true")
    args = parser.parse_args()
    payload = {"collisions": collision_witnesses()}
    if not args.collisions_only:
        payload["explainability"] = explainability(args.anchors)
    print(json.dumps(payload, sort_keys=True, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
def network_objective(
    outcome: NetworkOutcome,
    *,
    lambda_bits_per_j: int | float | str | Fraction,
    eta_ref: int | float | str | Fraction,
    kappa_bits_per_user_step: int | float | str | Fraction,
) -> Fraction:
    """F = B - eta_ref E for the whole network; Phi stays separate."""

    eta, _kappa = assert_calibration_prices(
        lambda_bits_per_j=lambda_bits_per_j,
        eta_ref=eta_ref,
        kappa_bits_per_user_step=kappa_bits_per_user_step,
    )
    return outcome.bits - eta * outcome.joules


@dataclass(frozen=True)
class C1Label:
    difference_surplus_bits: Fraction
    phi_difference: Fraction
    normalized_total: Fraction


def c1_difference_surplus(
    candidate: NetworkOutcome,
    default: NetworkOutcome,
    *,
    lambda_bits_per_j: int | float | str | Fraction,
    eta_ref: int | float | str | Fraction,
    kappa_bits_per_user_step: int | float | str | Fraction,
) -> C1Label:
    """Whole-network C1 difference versus the declared default action."""

    eta, kappa = assert_calibration_prices(
        lambda_bits_per_j=lambda_bits_per_j,
        eta_ref=eta_ref,
        kappa_bits_per_user_step=kappa_bits_per_user_step,
    )
    core = (candidate.bits - default.bits) - eta * (candidate.joules - default.joules)
    # Phi_1=.5 and Phi_2=1 are prices in κ-bit units.  Dividing the physical
    # surplus by κ and then adding Phi therefore keeps the target dimensionless.
    phi = candidate.phi - default.phi
    return C1Label(core, phi, core / kappa + phi)


@dataclass(frozen=True)
class OffsetProjection:
    offset_index: int
    valid: bool
    survives: bool
    outcome: NetworkOutcome
    background_power_recomputed: bool
    required_power_w: float | None
    power_cap_w: float | None
    min_decoding_margin_db: float
    mean_acm_se_bit_s_hz: float

    def __post_init__(self) -> None:
        if self.offset_index not in range(1, FORECAST_OFFSETS + 1):
            raise MCRLContractError("forecast offset is outside the frozen three offsets")
        if not self.background_power_recomputed:
            raise MCRLContractError("projection reused stale background powers")
        if not math.isfinite(self.min_decoding_margin_db) or not math.isfinite(self.mean_acm_se_bit_s_hz):
            raise MCRLContractError("projection margin/SE must be finite")
        if (self.required_power_w is None) != (self.power_cap_w is None):
            raise MCRLContractError("required power and cap must be supplied together")
        if self.required_power_w is not None and (
            not math.isfinite(self.required_power_w)
            or not math.isfinite(self.power_cap_w)
            or self.required_power_w < 0.0
            or self.power_cap_w <= 0.0
        ):
            raise MCRLContractError("invalid projected required-power/cap values")

    @property
    def required_power_cap_margin_w(self) -> float | None:
        if self.required_power_w is None or self.power_cap_w is None:
            return None
        return self.power_cap_w - self.required_power_w


ProjectionEvaluator = Callable[[int, float, Mapping[int, PhysicalIdentity | None], bool], OffsetProjection]


def project_three_offsets(
    *,
    assignments: Mapping[int, PhysicalIdentity | None],
    evaluator: ProjectionEvaluator,
    architecture: str,
    lambda_bits_per_j: int | float | str | Fraction,
    eta_ref: int | float | str | Fraction,
    kappa_bits_per_user_step: int | float | str | Fraction,
) -> tuple[OffsetProjection, ...]:
    """Project three physical offsets and force background re-optimisation."""

    assert_calibration_prices(
        lambda_bits_per_j=lambda_bits_per_j,
        eta_ref=eta_ref,
        kappa_bits_per_user_step=kappa_bits_per_user_step,
    )
    rows = tuple(
        evaluator(index, index * DECISION_INTERVAL_S, assignments, True)
        for index in range(1, FORECAST_OFFSETS + 1)
    )
    if architecture in {"a-r", "a′-r"} and any(
        row.required_power_w is None or row.power_cap_w is None for row in rows
    ):
        raise MCRLContractError("rate-target forecast lacks required-power/cap fields")
    return rows


@dataclass(frozen=True)
class C2Label:
    forecast_surplus_bits: Fraction
    lost_offsets: int
    persistence_penalty_bits: Fraction
    normalized_total: Fraction
    projections: tuple[OffsetProjection, ...]


def c2_persistence_forecast(
    candidate: Sequence[OffsetProjection],
    default: Sequence[OffsetProjection],
    *,
    lambda_bits_per_j: int | float | str | Fraction,
    eta_ref: int | float | str | Fraction,
    kappa_bits_per_user_step: int | float | str | Fraction | None = None,
    kappa_bits_per_user_s: int | float | str | Fraction | None = None,
    horizon_offsets: int = FORECAST_OFFSETS,
) -> C2Label:
    """OPS-3-style absorbing persistence with one -kappa per lost offset.

    The failed offset's attempted transmission is already present in its
    ``NetworkOutcome``.  Only later offsets are made absorbing losses; live
    recovery outside this forecast remains possible.
    """

    if (kappa_bits_per_user_step is None) == (kappa_bits_per_user_s is None):
        raise MCRLContractError("supply exactly one kappa normalization keyword")
    kappa_value = (
        kappa_bits_per_user_step
        if kappa_bits_per_user_step is not None
        else kappa_bits_per_user_s
    )
    eta, kappa = assert_calibration_prices(
        lambda_bits_per_j=lambda_bits_per_j,
        eta_ref=eta_ref,
        kappa_bits_per_user_step=kappa_value,
    )
    candidate_rows, default_rows = tuple(candidate), tuple(default)
    if horizon_offsets not in {1, 2, FORECAST_OFFSETS}:
        raise MCRLContractError("C2 horizon sensitivity must use the first 1, 2, or 3 offsets")
    if len(candidate_rows) != FORECAST_OFFSETS or len(default_rows) != FORECAST_OFFSETS:
        raise MCRLContractError("C2 requires exactly three candidate and default projections")
    if tuple(row.offset_index for row in candidate_rows) != (1, 2, 3):
        raise MCRLContractError("candidate forecast offsets are not ordered 1,2,3")
    if tuple(row.offset_index for row in default_rows) != (1, 2, 3):
        raise MCRLContractError("default forecast offsets are not ordered 1,2,3")
    alive = True
    core = Fraction()
    lost = 0
    retained: list[OffsetProjection] = []
    for selected, baseline in zip(
        candidate_rows[:horizon_offsets], default_rows[:horizon_offsets], strict=True
    ):
        if not selected.background_power_recomputed or not baseline.background_power_recomputed:
            raise MCRLContractError("C2 projection did not recompute background powers")
        if alive:
            core += (selected.outcome.bits - baseline.outcome.bits) - eta * (
                selected.outcome.joules - baseline.outcome.joules
            )
            retained.append(selected)
            if not selected.valid or not selected.survives:
                alive = False
                lost += 1
        else:
            lost += 1
            retained.append(selected)
    penalty = kappa * lost
    return C2Label(core, lost, penalty, (core - penalty) / kappa, tuple(retained))
    catalogue_count = 0
    if include_coalition:
        catalogue, _ = ENGINE._catalogue_with_census(
            tape, step_index, base, setting=setting, calibration=calibration,
            counter=counter, run_setting=run_setting,
        )
        pairwise = [row for row in catalogue if row.changed_users == 2]
        selected = min(pairwise, key=lambda row: row.configuration_id)
        current.evaluate_many((base, selected))
        coalition_row = _coalition_row(
            tape=tape, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, anchor=base, selected=selected,
            evaluator=current, rows_by_user_action=rows_by_user_action,
            calibration=calibration, run_setting=run_setting,
        )
        catalogue_count = len(catalogue)
    return {
        "base": base, "incumbent": incumbent, "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action, "current_evaluator": current,
        "coalition_row": coalition_row, "census": census, "skipped_invalid": 0,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


def _build_anchor_rows(
    *,
    tape,
    setting,
    run_setting,
    calibration: PilotCalibration,
    step_index: int,
    carrier: str,
    anchor_index: int,
    include_coalition: bool,
    full_legal_actions: bool = False,
):
    if PILOT_PRIMITIVE_SOURCE_FALLBACK:
        return _build_anchor_rows_primitive(
            tape=tape, setting=setting, run_setting=run_setting,
            calibration=calibration, step_index=step_index, carrier=carrier,
            anchor_index=anchor_index, include_coalition=include_coalition,
            full_legal_actions=full_legal_actions,
        )
    base = ENGINE._base_configuration(tape, step_index, carrier)
    incumbent = ENGINE._base_configuration(tape, max(0, step_index - 1), carrier)
    by_user, configs, census = _action_configs(
        tape, step_index, base, run_setting, full_legal=full_legal_actions
    )
    counter = ENGINE.EvaluationCounter()
    current = ENGINE.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
        field="nominal",
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    unique = {
        base.configuration_id: base,
        **{row.configuration_id: row for row in configs.values()},
    }
    current.evaluate_many(tuple(unique.values()))
    valid_configs = tuple(
        row for row in unique.values() if row.configuration_id not in current._invalid
    )
    base_profile = current.evaluate(base)
    forecasts, _forecast_receipts = ENGINE._batched_stage2_forecasts(
        tape=tape,
        setting=setting,
        anchor_step=step_index,
        carrier=carrier,
        configs=valid_configs,
        counter=counter,
        calibration=calibration,
        run_setting=run_setting,
    )
    base_forecasts = forecasts[base.configuration_id]
    source_rows = []
    rows_by_user_action = {}
    skipped_invalid = 0
    primitive_row_index = (
        tape.steps[step_index].arrays._row_index()
        if tape.steps[step_index].arrays is not None
        else None
    )
    for user in sorted(by_user):
        actions: list[ActionEvaluation] = []
        identities: list[tuple[int, int] | None] = []
        beam_before, satellite_before = _counts(base.mapping, user)
        previous_beam, previous_satellite = _counts(incumbent.mapping, user)
        for identity in by_user[user]:
            config = configs[(user, identity)]
            if config.configuration_id in current._invalid:
                skipped_invalid += 1
                continue
            profile = current.evaluate(config)
            projections = forecasts[config.configuration_id]
            c2 = c2_persistence_forecast(
                projections,
                base_forecasts,
                lambda_bits_per_j=calibration.lambda_bits_per_j,
                eta_ref=calibration.eta_ref,
                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            )
            core = (
                Fraction(str(profile.bits - base_profile.bits))
                - calibration.eta_ref * Fraction(str(profile.joules - base_profile.joules))
            )
            phi = ENGINE._phi_for(
                incumbent,
                config,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            ) - ENGINE._phi_for(
                incumbent,
                base,
                cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
            )
            primitive = _candidate_primitives(
                tape, step_index, user, identity, row_index=primitive_row_index
            )
            incumbent_identity = incumbent.mapping[user]
            missing_incumbent = incumbent_identity is None
            background_occupancy = 0 if identity is None else beam_before.get(identity, 0)
            previous_load = (
                0 if identity is None else previous_beam.get(identity, 0)
            )
            required_ratio = profile.required_power_w_max / BEAM_RF_CAP_W
            observation = ActionEvaluation(
                action=_physical_action(identity),
                nominal_sinr_margin_at_rate_target_db=profile.min_decoding_margin_db,
                nominal_required_power_over_cap=required_ratio,
                nominal_mode_spectral_efficiency=profile.mean_acm_se_bit_s_hz,
