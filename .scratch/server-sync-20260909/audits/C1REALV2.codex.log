+    metrics, prediction, models = original_high_capacity_cv(*args, **kwargs)
+    metrics["architecture"] = (
+        "fixed-seed 15-256-256 ReLU random features plus raw slots and ridge output"
+    )
+    metrics["trainable_output_parameters"] = 528
+    return metrics, prediction, models
+
+
+analysis.high_capacity_cv = high_capacity_cv
+analysis.main()
+
+output_index = sys.argv.index("--output") + 1
+output_path = Path(sys.argv[output_index])
+payload = json.loads(output_path.read_text(encoding="utf-8"))
+payload["schema"] = "c1-declared-target-learnability-diagnostic-v2"
+payload["q1_schema"] = {
+    "name": v2.Q1_V2_SCHEMA_VERSION,
+    "sha256": v2.Q1_V2_SCHEMA_SHA256,
