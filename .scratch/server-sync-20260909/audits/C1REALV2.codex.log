+V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+sealed = (PILOT_PATH, V2_PATH, ROOT / "src/mcrl/stagec_v025/learner.py")
+before = {str(path): sha256(path) for path in sealed}
+
+spec = importlib.util.spec_from_file_location("c1_declared_v1_analysis", V1_ANALYZE)
+if spec is None or spec.loader is None:
+    raise RuntimeError("could not load v1 analysis")
+analysis = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = analysis
+spec.loader.exec_module(analysis)
+
+import numpy as np
+import q1_schema_v2 as v2
+
+
+analysis.SCRATCH = SCRATCH
+analysis.Q1_FEATURES = v2.Q1_V2_FEATURES
+
+
+def matrix_summary(matrix: np.ndarray) -> dict[str, object]:
+    singular = np.linalg.svd(matrix, compute_uv=False)
+    rank = int(np.linalg.matrix_rank(matrix))
+    condition = math.inf if singular[-1] == 0.0 else float(singular[0] / singular[-1])
+    return {
+        "rank": rank,
+        "columns": int(matrix.shape[1]),
+        "condition_number": None if not math.isfinite(condition) else condition,
+        "condition_number_class": "infinite" if not math.isfinite(condition) else "finite",
+        "singular_values": [float(value) for value in singular],
+    }
+
+
+def slot_audit(data) -> dict[str, object]:
+    scales = np.asarray([feature.scale for feature in v2.Q1_V2_FEATURES], dtype=np.float64)
+    raw = data.exact_x * scales
+    live = np.flatnonzero(raw.std(axis=0, ddof=0) > 0.0)
+    constants = [
+        {
+            "slot": index,
+            "name": v2.Q1_V2_FEATURES[index].name,
+            "value": float(raw[0, index]),
+        }
+        for index in range(raw.shape[1])
+        if np.unique(raw[:, index]).size == 1
+    ]
+    return {
+        "nominal_dimension": 15,
+        "raw_design_matrix": matrix_summary(raw),
+        "after_dropping_exactly_constant_columns": matrix_summary(raw[:, live]),
+        "exactly_constant_slots": constants,
+        "exact_indicator_duplicates_retained": 0,
+        "effective_dimension": 14,
+        "effective_dimension_derivation": (
+            "15 serialized columns minus one documented structurally constant "
+            "missing_incumbent coordinate"
+        ),
+        "indexing": "zero-based",
+    }
+
+
+analysis.slot_audit = slot_audit
+original_high_capacity_cv = analysis.high_capacity_cv
+
+
+def high_capacity_cv(*args, **kwargs):
+    metrics, prediction, models = original_high_capacity_cv(*args, **kwargs)
+    metrics["architecture"] = (
+        "fixed-seed 15-256-256 ReLU random features plus raw slots and ridge output"
+    )
+    metrics["trainable_output_parameters"] = 528
+    return metrics, prediction, models
+
+
+analysis.high_capacity_cv = high_capacity_cv
+analysis.main()
+
+output_index = sys.argv.index("--output") + 1
+output_path = Path(sys.argv[output_index])
+payload = json.loads(output_path.read_text(encoding="utf-8"))
+payload["schema"] = "c1-declared-target-learnability-diagnostic-v2"
+payload["q1_schema"] = {
+    "name": v2.Q1_V2_SCHEMA_VERSION,
+    "sha256": v2.Q1_V2_SCHEMA_SHA256,
+    "shape": [len(v2.Q1_V2_FEATURES)],
+    "feature_names": list(v2.Q1_V2_FEATURE_NAMES),
+    "file": str(V2_PATH),
+    "file_sha256": before[str(V2_PATH)],
+}
+payload["v1_comparator"] = {
+    "result": str(V1_RESULTS.resolve().relative_to(ROOT)),
+    "sha256": sha256(V1_RESULTS),
+}
+payload["generation"]["schema_change_only"] = True
+payload["generation"]["parent_exact_rows"] = (
+    "the same cached, target-verified exact-path v1 rows used by the v1 model; "
+    "only q1_state was projected through q1_schema_v2"
+)
+
+after = {str(path): sha256(path) for path in sealed}
+changed = [path for path in before if before[path] != after[path]]
+if changed:
+    raise RuntimeError(f"sealed inputs changed during analysis: {changed}")
+peak_self = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+peak_children = int(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)
+payload["resource_policy"] = {
+    "python_process_cap": 3,
+    "analysis_python_processes": "one parent plus at most two fork workers",
+    "nice": __import__("os").nice(0),
+    "blas_threads": 1,
+    "rlimit_as_bytes_per_process": RSS_LIMIT_BYTES,
+    "peak_rss_kb_parent": peak_self,
+    "peak_rss_kb_children_max": peak_children,
+}
+payload["sealed_file_sha256_before"] = before
+payload["sealed_file_sha256_after"] = after
+payload["changed_files"] = changed
+output_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+print(f"PEAK_RSS_KB_PARENT={peak_self}", flush=True)
+print(f"PEAK_RSS_KB_CHILDREN_MAX={peak_children}", flush=True)
+
