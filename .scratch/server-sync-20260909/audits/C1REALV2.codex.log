index 0000000000000000000000000000000000000000..1458dfa34350e971f185a762b8205ccb8e0c12ad
--- /dev/null
+++ b/.scratch/c1-declared-v2/verify_exact_adapter_v2.py
@@ -0,0 +1,229 @@
+#!/usr/bin/env python3
+"""Traverse the direct Q1-v2 exact adapter and compare with the fitted panel."""
+
+from __future__ import annotations
+
+import argparse
+from fractions import Fraction
+import hashlib
+import json
+from pathlib import Path
+import resource
+import time
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+
+ROOT = Path(__file__).resolve().parents[2]
+V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+CALIBRATION_PATH = (
+    ROOT
+    / "artifacts/v025-pilot-c3-20260909-PILOT_NOT_CLAIM"
+    / "PILOT_NOT_CLAIM-calibration.json"
+)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def ratio(payload: dict[str, object], key: str) -> Fraction:
+    values = payload[key]
+    return Fraction(int(values[0]), int(values[1]))
+
+
+def load_calibration(path: Path, pilot):
+    payload = json.loads(path.read_text(encoding="ascii"))
+    return pilot.PilotCalibration(
+        eta_ref=ratio(payload, "eta_ref"),
+        lambda_bits_per_j=ratio(payload, "lambda_bits_per_j"),
+        kappa_bits_per_user_step=ratio(payload, "kappa_bits_per_user_step"),
+        bits_ref=ratio(payload, "bits_ref"),
+        joules_ref=ratio(payload, "joules_ref"),
+        users=int(payload["users"]),
+    )
+
+
+def payload_identity(payload: dict[str, object]) -> tuple[int, int] | None:
+    if bool(payload["null_action"]):
+        return None
+    action = payload["action"]
+    return int(action["norad_id"]), int(action["beam_chain_id"])
+
+
+def fitted_key(row: dict[str, object]) -> tuple[int, int, tuple[int, int] | None]:
+    identity = row["identity"]
+    physical = None if identity is None else (int(identity[0]), int(identity[1]))
+    return int(row["user_id"]), int(row["action_index"]), physical
+
+
+def actual_key(payload: dict[str, object]) -> tuple[int, int, tuple[int, int] | None]:
+    return int(payload["user_id"]), int(payload["action_index"]), payload_identity(payload)
+
+
+def load_fitted(path: Path, stop_step: int) -> dict[int, dict[tuple, dict[str, object]]]:
+    result = {}
+    with path.open(encoding="utf-8") as stream:
+        for line in stream:
+            record = json.loads(line)
+            if record["kind"] != "anchor" or int(record["step_index"]) >= stop_step:
+                continue
+            result[int(record["step_index"])] = {
+                fitted_key(row): row for row in record["rows"]
+            }
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--world-index", type=int, choices=(1, 2), required=True)
+    parser.add_argument("--stop-step", type=int, required=True)
+    parser.add_argument("--fitted-input", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    watched = (PILOT_PATH, V2_PATH, CALIBRATION_PATH, args.fitted_input)
+    before = {str(path): sha256(path) for path in watched}
+
+    import q1_schema_v2 as v2
+    import scripts.run_v025_pilot_c3 as pilot
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+    from mcrl.stagec_v025.canonical import parse_float_hex
+
+    domain = DEVELOPMENT_WORLD_DOMAINS[args.world_index - 1]
+    setting = pilot.ENGINE._setting("a-r0")
+    run_setting = pilot.ENGINE.run_setting_for("a-r0")
+    calibration = load_calibration(CALIBRATION_PATH, pilot)
+    fitted = load_fitted(args.fitted_input, args.stop_step)
+    if set(fitted) != set(range(args.stop_step)):
+        raise RuntimeError("fitted panel does not contain the requested step prefix")
+
+    original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
+    provider_started = time.perf_counter()
+    provider = LegacyWorldProvider(role="pilot-source")
+    tape = build_world_tape(
+        domain=domain,
+        provider=provider,
+        steps=33,
+        start_time_s=0.0,
+    )
+    provider_wall_s = time.perf_counter() - provider_started
+
+    anchor_receipts = []
+    rows = 0
+    max_q1_abs = 0.0
+    max_parent_q1_abs = 0.0
+    max_target_abs = 0.0
+    max_elevation_error = 0.0
+    for step_index in range(args.stop_step):
+        started = time.perf_counter()
+        geometry = v2.DecisionGeometryResolverV2(tape, provider, step_index)
+        max_elevation_error = max(
+            max_elevation_error,
+            float(geometry.maximum_elevation_crosscheck_error_deg),
+        )
+        exact = v2.build_exact_rows_v2(
+            pilot,
+            geometry_lookup=geometry,
+            tape=tape,
+            setting=setting,
+            run_setting=run_setting,
+            calibration=calibration,
+            step_index=step_index,
+            carrier="nearest-eligible",
+            anchor_index=step_index,
+            include_coalition=False,
+            full_legal_actions=False,
+        )
+        actual_rows = exact["rows"]
+        parent_rows = exact["rows_v1"]
+        expected = fitted[step_index]
+        if len(actual_rows) != len(parent_rows) or len(actual_rows) != len(expected):
+            raise RuntimeError(f"row-count mismatch at step {step_index}")
+        for payload, parent in zip(actual_rows, parent_rows, strict=True):
+            key = actual_key(payload)
+            cached = expected.pop(key)
+            actual_q1 = tuple(parse_float_hex(value, field="q1 v2") for value in payload["q1_state"])
+            parent_q1 = tuple(float(value) for value in parent.q1_state)
+            target = parse_float_hex(payload["c1_label_normalized_hex"], field="declared")
+            max_q1_abs = max(
+                max_q1_abs,
+                max(abs(a - b) for a, b in zip(actual_q1, cached["q1"], strict=True)),
+            )
+            max_parent_q1_abs = max(
+                max_parent_q1_abs,
+                max(abs(a - b) for a, b in zip(parent_q1, cached["q1_v1"], strict=True)),
+            )
+            max_target_abs = max(max_target_abs, abs(target - float(cached["declared"])))
+            if payload["q1_schema_sha256"] != v2.Q1_V2_SCHEMA_SHA256:
+                raise RuntimeError("exact adapter emitted wrong schema digest")
+            rows += 1
+        if expected:
+            raise RuntimeError(f"unmatched fitted rows at step {step_index}")
+        elapsed = time.perf_counter() - started
+        receipt = {
+            "step_index": step_index,
+            "rows": len(actual_rows),
+            "wall_s": elapsed,
+            "physics_calls": int(exact["physics_calls"]),
+            "skipped_invalid": int(exact["skipped_invalid"]),
+        }
+        anchor_receipts.append(receipt)
+        print(json.dumps({"world": args.world_index, **receipt}, sort_keys=True), flush=True)
+
+    after = {str(path): sha256(path) for path in watched}
+    changed = [path for path in before if before[path] != after[path]]
+    if changed:
+        raise RuntimeError(f"watched input changed: {changed}")
+    if max(max_q1_abs, max_parent_q1_abs, max_target_abs) != 0.0:
+        raise RuntimeError("direct exact adapter disagrees with fitted panel")
+    peak_rss_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    result = {
+        "artifact": "C1_DECLARED_TARGET_LEARNABILITY_V2_EXACT_ADAPTER_AUDIT",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "interpreter": __import__("sys").executable,
+        "world_id": domain,
+        "world_index": args.world_index,
+        "setting": "a-r0",
+        "carrier": "nearest-eligible",
+        "anchors": args.stop_step,
+        "rows": rows,
+        "provider_wall_s": provider_wall_s,
+        "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
+        "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
+        "pilot_flag_original": original_flag,
+        "pilot_flag_after": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
+        "direct_adapter": "q1_schema_v2.build_exact_rows_v2",
+        "maximum_absolute_difference": {
+            "q1_v2": max_q1_abs,
+            "q1_v1_parent": max_parent_q1_abs,
+            "declared_target": max_target_abs,
+        },
+        "maximum_elevation_crosscheck_error_deg": max_elevation_error,
+        "resource_policy": {
+            "python_processes_for_this_worker": 1,
+            "nice": __import__("os").nice(0),
+            "blas_threads": 1,
+            "rlimit_as_bytes": RSS_LIMIT_BYTES,
+            "peak_rss_kb": peak_rss_kb,
+        },
+        "watched_sha256_before": before,
+        "watched_sha256_after": after,
+        "changed_files": changed,
+        "anchor_receipts": anchor_receipts,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(f"PEAK_RSS_KB={peak_rss_kb}", flush=True)
+    print(json.dumps({"written": str(args.output), "anchors": args.stop_step, "rows": rows}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/C1-DECLARED-TARGET-LEARNABILITY-V2-2026-09-10.md b/C1-DECLARED-TARGET-LEARNABILITY-V2-2026-09-10.md
