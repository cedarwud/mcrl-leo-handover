+#!/usr/bin/env python3
+"""Run the unchanged C1 learnability protocol on projected Q1 v2 rows."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import resource
