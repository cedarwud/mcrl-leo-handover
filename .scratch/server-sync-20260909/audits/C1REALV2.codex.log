index 0000000000000000000000000000000000000000..5b86012243da1cf313548f74c870768a67b6edef
--- /dev/null
+++ b/.scratch/c1-declared-v2/analyze_v2.py
@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+"""Run the unchanged C1 learnability protocol on projected Q1 v2 rows."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import resource
+import sys
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRATCH = ROOT / ".scratch/c1-declared-v2"
+V1_ANALYZE = ROOT / ".scratch/c1-declared/analyze.py"
+V1_RESULTS = ROOT / ".scratch/c1-declared/results.json"
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+V2_PATH = Path("/home/sat/mcrl-v025-design-ws/q1_schema_v2.py")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+sealed = (PILOT_PATH, V2_PATH, ROOT / "src/mcrl/stagec_v025/learner.py")
+before = {str(path): sha256(path) for path in sealed}
+
+spec = importlib.util.spec_from_file_location("c1_declared_v1_analysis", V1_ANALYZE)
+if spec is None or spec.loader is None:
+    raise RuntimeError("could not load v1 analysis")
+analysis = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = analysis
+spec.loader.exec_module(analysis)
+
+import numpy as np
+import q1_schema_v2 as v2
+
+
+analysis.SCRATCH = SCRATCH
+analysis.Q1_FEATURES = v2.Q1_V2_FEATURES
+
+
+def matrix_summary(matrix: np.ndarray) -> dict[str, object]:
+    singular = np.linalg.svd(matrix, compute_uv=False)
+    rank = int(np.linalg.matrix_rank(matrix))
+    condition = math.inf if singular[-1] == 0.0 else float(singular[0] / singular[-1])
+    return {
+        "rank": rank,
+        "columns": int(matrix.shape[1]),
+        "condition_number": None if not math.isfinite(condition) else condition,
+        "condition_number_class": "infinite" if not math.isfinite(condition) else "finite",
+        "singular_values": [float(value) for value in singular],
+    }
+
+
+def slot_audit(data) -> dict[str, object]:
+    scales = np.asarray([feature.scale for feature in v2.Q1_V2_FEATURES], dtype=np.float64)
+    raw = data.exact_x * scales
+    live = np.flatnonzero(raw.std(axis=0, ddof=0) > 0.0)
+    constants = [
+        {
+            "slot": index,
+            "name": v2.Q1_V2_FEATURES[index].name,
+            "value": float(raw[0, index]),
+        }
+        for index in range(raw.shape[1])
+        if np.unique(raw[:, index]).size == 1
+    ]
+    return {
+        "nominal_dimension": 15,
+        "raw_design_matrix": matrix_summary(raw),
+        "after_dropping_exactly_constant_columns": matrix_summary(raw[:, live]),
+        "exactly_constant_slots": constants,
+        "exact_indicator_duplicates_retained": 0,
+        "effective_dimension": 14,
+        "effective_dimension_derivation": (
+            "15 serialized columns minus one documented structurally constant "
+            "missing_incumbent coordinate"
+        ),
+        "indexing": "zero-based",
+    }
+
+
+analysis.slot_audit = slot_audit
+original_high_capacity_cv = analysis.high_capacity_cv
+
+
+def high_capacity_cv(*args, **kwargs):
+    metrics, prediction, models = original_high_capacity_cv(*args, **kwargs)
+    metrics["architecture"] = (
+        "fixed-seed 15-256-256 ReLU random features plus raw slots and ridge output"
+    )
+    metrics["trainable_output_parameters"] = 528
+    return metrics, prediction, models
+
+
+analysis.high_capacity_cv = high_capacity_cv
+analysis.main()
+
+output_index = sys.argv.index("--output") + 1
+output_path = Path(sys.argv[output_index])
+payload = json.loads(output_path.read_text(encoding="utf-8"))
+payload["schema"] = "c1-declared-target-learnability-diagnostic-v2"
+payload["q1_schema"] = {
+    "name": v2.Q1_V2_SCHEMA_VERSION,
+    "sha256": v2.Q1_V2_SCHEMA_SHA256,
+    "shape": [len(v2.Q1_V2_FEATURES)],
+    "feature_names": list(v2.Q1_V2_FEATURE_NAMES),
+    "file": str(V2_PATH),
+    "file_sha256": before[str(V2_PATH)],
+}
+payload["v1_comparator"] = {
+    "result": str(V1_RESULTS.resolve().relative_to(ROOT)),
+    "sha256": sha256(V1_RESULTS),
+}
+payload["generation"]["schema_change_only"] = True
+payload["generation"]["parent_exact_rows"] = (
+    "the same cached, target-verified exact-path v1 rows used by the v1 model; "
+    "only q1_state was projected through q1_schema_v2"
+)
+
+after = {str(path): sha256(path) for path in sealed}
+changed = [path for path in before if before[path] != after[path]]
+if changed:
+    raise RuntimeError(f"sealed inputs changed during analysis: {changed}")
+peak_self = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+peak_children = int(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)
+payload["resource_policy"] = {
+    "python_process_cap": 3,
+    "analysis_python_processes": "one parent plus at most two fork workers",
+    "nice": __import__("os").nice(0),
+    "blas_threads": 1,
+    "rlimit_as_bytes_per_process": RSS_LIMIT_BYTES,
+    "peak_rss_kb_parent": peak_self,
+    "peak_rss_kb_children_max": peak_children,
+}
+payload["sealed_file_sha256_before"] = before
+payload["sealed_file_sha256_after"] = after
+payload["changed_files"] = changed
+output_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+print(f"PEAK_RSS_KB_PARENT={peak_self}", flush=True)
+print(f"PEAK_RSS_KB_CHILDREN_MAX={peak_children}", flush=True)
+
diff --git a/.scratch/c1-declared-v2/project_exact_rows_v2.py b/.scratch/c1-declared-v2/project_exact_rows_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..487ebd3968e1d0ea33feb0b0b8967bee5d1a2689
--- /dev/null
+++ b/.scratch/c1-declared-v2/project_exact_rows_v2.py
@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+"""Project the cached verified exact-path C1 rows onto the Q1 v2 schema."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import resource
+from types import SimpleNamespace
+
+
+RSS_LIMIT_BYTES = 5 * 1024**3
+resource.setrlimit(resource.RLIMIT_AS, (RSS_LIMIT_BYTES, RSS_LIMIT_BYTES))
+
+ROOT = Path(__file__).resolve().parents[2]
+V2_ROOT = Path("/home/sat/mcrl-v025-design-ws")
+V2_PATH = V2_ROOT / "q1_schema_v2.py"
+PILOT_PATH = ROOT / "scripts/run_v025_pilot_c3.py"
+EXPECTED_SCHEMA_SHA256 = (
+    "66ed4a3f9222ac7f20f4334ffab92f6164d2dad203cbac7f7d4e1728ae4ad654"
+)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_records(path: Path) -> tuple[dict[str, object], list[dict[str, object]]]:
+    metadata = None
+    anchors = []
+    with path.open(encoding="utf-8") as stream:
+        for line in stream:
+            record = json.loads(line)
+            if record["kind"] == "metadata":
+                metadata = record
+            elif record["kind"] == "anchor":
+                anchors.append(record)
+            else:
+                raise RuntimeError(f"unknown record kind in {path}")
+    if metadata is None:
+        raise RuntimeError(f"metadata missing from {path}")
+    return metadata, anchors
+
+
+def row_proxy(row: dict[str, object]) -> SimpleNamespace:
+    identity = row["identity"]
+    if identity is None:
+        action = SimpleNamespace(norad_id=None, beam_chain_id=None)
+    else:
+        action = SimpleNamespace(norad_id=int(identity[0]), beam_chain_id=int(identity[1]))
+    return SimpleNamespace(
+        null_action=identity is None,
+        user_id=int(row["user_id"]),
+        action=action,
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--inputs", type=Path, nargs=2, required=True)
+    parser.add_argument("--outputs", type=Path, nargs=2, required=True)
+    parser.add_argument("--receipt", type=Path, required=True)
+    args = parser.parse_args()
+
+    sealed_paths = (
+        PILOT_PATH,
+        V2_PATH,
+        ROOT / "src/mcrl/stagec_v025/learner.py",
+        ROOT / "src/mcrl/physics_v025/targets.py",
+        *args.inputs,
+    )
+    before = {str(path): sha256(path) for path in sealed_paths}
+
+    import q1_schema_v2 as v2
+    import scripts.run_v025_pilot_c3 as pilot
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import DEVELOPMENT_WORLD_DOMAINS, build_world_tape
+
+    if Path(v2.__file__).resolve() != V2_PATH:
+        raise RuntimeError(f"wrong q1_schema_v2 import: {v2.__file__}")
+    if v2.Q1_V2_SCHEMA_SHA256 != EXPECTED_SCHEMA_SHA256:
+        raise RuntimeError("Q1 v2 schema digest mismatch")
+
+    original_flag = pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK
+    worlds = []
+    maximum_elevation_error = 0.0
+    total_rows = 0
+    total_anchors = 0
+    try:
+        # The cached parents were generated under this exact-path module flag.
+        # Keep the imported module in that state while applying the exact v2
+        # projection; restore it before exit and prove the file did not change.
+        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = False
+        for world_index, (input_path, output_path) in enumerate(
+            zip(args.inputs, args.outputs, strict=True), start=1
+        ):
+            source_metadata, anchors = load_records(input_path)
+            domain = DEVELOPMENT_WORLD_DOMAINS[world_index - 1]
+            if source_metadata["world_id"] != domain:
+                raise RuntimeError("world ordering mismatch")
+            provider = LegacyWorldProvider(role="pilot-source")
+            tape = build_world_tape(
+                domain=domain,
+                provider=provider,
+                steps=33,
+                start_time_s=0.0,
+            )
+            output_path.parent.mkdir(parents=True, exist_ok=True)
+            with output_path.open("w", encoding="utf-8") as stream:
+                projected_metadata = {
+                    **source_metadata,
+                    "projection": "cached verified exact-path v1 parent plus q1_schema_v2 geometry projection",
+                    "parent_input": str(input_path.resolve().relative_to(ROOT)),
+                    "parent_sha256": before[str(input_path)],
+                    "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
+                    "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
+                    "q1_shape": [len(v2.Q1_V2_FEATURES)],
+                    "pilot_flag_set_in_process_for_declared": False,
+                }
+                stream.write(json.dumps(projected_metadata, sort_keys=True) + "\n")
+                for anchor in anchors:
+                    step_index = int(anchor["step_index"])
+                    resolver = v2.DecisionGeometryResolverV2(tape, provider, step_index)
+                    maximum_elevation_error = max(
+                        maximum_elevation_error,
+                        float(resolver.maximum_elevation_crosscheck_error_deg),
+                    )
+                    projected_rows = []
+                    for row in anchor["rows"]:
+                        proxy = row_proxy(row)
+                        angle, elevation = resolver(proxy)
+                        old_exact = tuple(float(value) for value in row["q1"])
+                        old_surrogate = tuple(float(value) for value in row["surrogate_q1"])
+                        exact_v2 = v2.upgrade_q1_state_v2(
+                            old_exact,
+                            off_axis_angle_rad=angle,
+                            focal_elevation_deg=elevation,
+                            null_action=proxy.null_action,
+                        )
+                        surrogate_v2 = v2.upgrade_q1_state_v2(
+                            old_surrogate,
+                            off_axis_angle_rad=angle,
+                            focal_elevation_deg=elevation,
+                            null_action=proxy.null_action,
+                        )
+                        if len(exact_v2) != 15 or len(surrogate_v2) != 15:
+                            raise RuntimeError("v2 projection shape drifted")
+                        projected_rows.append(
+                            {
+                                **row,
+                                "q1_v1": list(old_exact),
+                                "surrogate_q1_v1": list(old_surrogate),
+                                "q1": list(exact_v2),
+                                "surrogate_q1": list(surrogate_v2),
+                                "off_axis_angle_rad": angle,
+                                "focal_link_elevation_deg": elevation,
+                                "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
+                            }
+                        )
+                    projected_anchor = {**anchor, "rows": projected_rows}
+                    stream.write(
+                        json.dumps(projected_anchor, separators=(",", ":"), sort_keys=True)
+                        + "\n"
+                    )
+                    stream.flush()
+                    total_rows += len(projected_rows)
+                    total_anchors += 1
+                    print(
+                        json.dumps(
+                            {
+                                "projected_world": world_index,
+                                "step": step_index,
+                                "rows": len(projected_rows),
+                            },
+                            sort_keys=True,
+                        ),
+                        flush=True,
+                    )
+            worlds.append(
+                {
+                    "world_id": domain,
+                    "anchors": len(anchors),
+                    "rows": sum(len(anchor["rows"]) for anchor in anchors),
+                    "output": str(output_path.resolve().relative_to(ROOT)),
+                    "output_sha256": sha256(output_path),
+                }
+            )
+            del tape, provider
+    finally:
+        pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK = original_flag
+
+    after = {str(path): sha256(path) for path in sealed_paths}
+    changed = [path for path in before if before[path] != after[path]]
+    if changed:
+        raise RuntimeError(f"sealed inputs changed: {changed}")
+    peak_rss_kb = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+    receipt = {
+        "artifact": "C1_DECLARED_TARGET_LEARNABILITY_V2_PROJECTION",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "interpreter": __import__("sys").executable,
+        "resource_policy": {
+            "python_processes": 1,
+            "nice": __import__("os").nice(0),
+            "blas_threads": 1,
+            "rlimit_as_bytes": RSS_LIMIT_BYTES,
+            "peak_rss_kb": peak_rss_kb,
+        },
+        "q1_schema": v2.Q1_V2_SCHEMA_VERSION,
+        "q1_schema_sha256": v2.Q1_V2_SCHEMA_SHA256,
+        "q1_schema_file_sha256": before[str(V2_PATH)],
+        "pilot_flag_original": original_flag,
+        "pilot_flag_during_projection": False,
+        "pilot_flag_restored": pilot.PILOT_PRIMITIVE_SOURCE_FALLBACK,
+        "sealed_file_sha256_before": before,
+        "sealed_file_sha256_after": after,
+        "changed_files": changed,
+        "maximum_elevation_crosscheck_error_deg": maximum_elevation_error,
+        "anchors": total_anchors,
+        "rows": total_rows,
+        "worlds": worlds,
+    }
+    args.receipt.parent.mkdir(parents=True, exist_ok=True)
+    args.receipt.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
+    print(f"PEAK_RSS_KB={peak_rss_kb}", flush=True)
+    print(json.dumps({"written": str(args.receipt), "anchors": total_anchors, "rows": total_rows}))
+
+
+if __name__ == "__main__":
+    main()

