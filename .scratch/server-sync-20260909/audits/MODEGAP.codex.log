+            "```",
+            "",
+            f"- source commit: `{payload['provenance']['source_commit']}`; tracked tree: `{payload['provenance']['tracked_tree']}`",
+            f"- evaluator script SHA-256 before report rendering: `{payload['provenance']['script_sha256']}`",
+            f"- imported matrix runner SHA-256: `{payload['provenance']['runner_sha256']}`",
+            f"- sealed ACM table SHA-256: `{ACM_TABLE_SHA256}`",
