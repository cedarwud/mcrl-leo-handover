    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load the archived matrix runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


RUNNER = load_runner()

from mcrl.physics_v025.constants_v025 import (  # noqa: E402
    BEAM_BANDWIDTH_HZ,
    BEAM_RF_CAP_W,
    CIRCUIT_POWER_PER_CHAIN_W,
    RATE_TARGET_BPS,
)
from mcrl.physics_v025.provider_legacy import LegacyWorldProvider  # noqa: E402
from mcrl.physics_v025.tapes import (  # noqa: E402
    PROBE_WORLD_DOMAINS,
    build_world_tape,
)


SETTING = RUNNER._setting("a-r0")
RUN_SETTING = RUNNER.run_setting_for("a-r0")
CALIBRATION = SimpleNamespace(
    eta_ref=ETA_REF,
    lambda_bits_per_j=ETA_REF,
    kappa_bits_per_user_step=KAPPA,
)


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def exact_float(value: float) -> Fraction:
    if not math.isfinite(value):
        raise RuntimeError("non-finite scored value")
    return Fraction(str(value))


def profile_core(profile) -> Fraction:
    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)


def full_objective(base, config, profile, cell_rekeys: Iterable[int]) -> Fraction:
    return profile_core(profile) + KAPPA * RUNNER._phi_for(
        base, config, cell_rekeyed_users=cell_rekeys
    )


def served_count(profile) -> int:
    return sum(bool(value) for value in profile.score.served_phy.values())


def ee(profile) -> float:
    if profile.joules <= 0.0:
        raise RuntimeError("non-positive energy denominator")
    return profile.bits / profile.joules


def identity_for_row(arrays, row: int) -> tuple[int, int]:
    return tuple(int(value) for value in arrays.identities[row])


def row_maps(arrays):
    result: dict[tuple[int, tuple[int, int]], int] = {}
    for row, raw_identity in enumerate(arrays.identities):
        user = int(arrays.users[int(arrays.row_user_column[row])])
        identity = tuple(int(value) for value in raw_identity)
        result[(user, identity)] = row
    return result


def configuration(base, changes: Mapping[int, tuple[int, int]], kind: str):
    mapping = base.mapping
    mapping.update(changes)
    return RUNNER._configuration(base, mapping, kind=kind)


def deduplicate_candidates(rows: list[dict[str, object]]) -> list[dict[str, object]]:
    by_assignments: dict[tuple[tuple[int, tuple[int, int] | None], ...], dict[str, object]] = {}
    for row in rows:
        config = row["config"]
        key = config.assignments
        prior = by_assignments.get(key)
        if prior is None:
            by_assignments[key] = row
            continue
        prior["mechanisms"].update(row["mechanisms"])
        prior["events"].extend(row["events"])
    return sorted(by_assignments.values(), key=lambda row: row["config"].configuration_id)


def interference_tail(
    *, tape, step_index: int, base
) -> tuple[list[dict[str, object]], dict[str, int], object]:
    """Return physical tail victims and top aggressor users at boundary zero."""

    # Force one scalar evaluation so the diagnostic observes the same solved
    # radiation object as the authoritative scalar engine path.
    scalar = RUNNER.StepEvaluator(
        tape,
        SETTING,
        step_index,
        transition_from=base,
        cell_rekeyed_users=RUNNER._rekeyed_users(tape, step_index),
        field="realised",
        run_setting=RUN_SETTING,
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )
    scalar_base = scalar.evaluate(base)

    shared = scalar._shared[base.configuration_id]
    radiation = shared.integrated[0].radiation
    geometry = tape.geometry_for(step_index=step_index, assignments=base.mapping)[0][1]
    link_index = {link.user_id: index for index, link in enumerate(geometry.links)}
    records: dict[int, list[tuple[object, object, dict[int, float]]]] = defaultdict(list)
    seen_infeasible: set[int] = set()
    interference_limited: set[int] = set()

    for slot in radiation.slots:
        tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
        for victim in slot.transmissions:
            if victim.rate_target_sinr is None or victim.rate_target_feasible is not False:
                continue
            seen_infeasible.add(victim.user_id)
            vindex = link_index[victim.user_id]
            nominal_direct = geometry.links[vindex].nominal_gain
            noise_only_required = victim.rate_target_sinr * victim.noise_w / nominal_direct
            if noise_only_required > BEAM_RF_CAP_W + 1e-12:
                continue
            interference_limited.add(victim.user_id)
            terms: dict[int, float] = {}
            for aggressor_user, aggressor in tx_by_user.items():
                if aggressor_user == victim.user_id:
                    continue
                aindex = link_index[aggressor_user]
                vlink = geometry.links[vindex]
                alink = geometry.links[aindex]
                if vlink.beam == alink.beam or vlink.color != alink.color:
                    continue
                term = float(geometry.nominal_cross_gain[vindex, aindex]) * aggressor.rf_power_w
                if term > 0.0:
                    terms[aggressor_user] = term
            records[victim.user_id].append((slot, victim, terms))

    tail = []
    rescued_top1 = 0
    for victim_user in sorted(interference_limited):
        rows = records[victim_user]
        aggregate: dict[int, float] = defaultdict(float)
        for slot, _victim, terms in rows:
            for user, term in terms.items():
                aggregate[user] += slot.fraction * term
        ranked = tuple(
            user for user, value in sorted(aggregate.items(), key=lambda item: (-item[1], item[0]))
            if value > 0.0
        )
        if not ranked:
            continue
        top1 = ranked[0]
        clears_every_slot = True
        for _slot, victim, terms in rows:
            vindex = link_index[victim_user]
            nominal_wanted = victim.rf_power_w * geometry.links[vindex].nominal_gain
            remaining = math.fsum(terms.values()) - terms.get(top1, 0.0)
            post_sinr = nominal_wanted / (victim.noise_w + max(0.0, remaining))
            if post_sinr + 1e-15 < victim.rate_target_sinr:
                clears_every_slot = False
                break
        if clears_every_slot:
            rescued_top1 += 1
            continue
        tail.append(
            {
                "victim_user": victim_user,
                "ranked_aggressors": ranked,
                "aggregate_nominal_interference_w": {
                    str(user): aggregate[user] for user in ranked
                },
            }
        )
    return tail, {
        "target_infeasible_victims": len(seen_infeasible),
        "interference_limited_victims": len(interference_limited),
        "top1_rescued_victims": rescued_top1,
        "tail_victims": len(tail),
    }, scalar_base


def evaluate_anchor(tape, world_index: int, step_index: int) -> dict[str, object]:
    started = time.perf_counter()
    base = RUNNER._base_configuration(tape, step_index, "nearest-eligible")
    cell_rekeys = RUNNER._rekeyed_users(tape, step_index)
    options, legal_census = RUNNER._legal_options(tape, step_index)
    arrays = tape.steps[step_index].arrays
    if arrays is None:
        raise RuntimeError("real provider did not expose primitive arrays")
    by_key = row_maps(arrays)

    evaluator = RUNNER.StepEvaluator(
        tape,
        SETTING,
        step_index,
        transition_from=base,
        cell_rekeyed_users=cell_rekeys,
        previously_served_users=RUNNER._previously_served_users(
            tape, step_index, "nearest-eligible"
        ),
        field="realised",
        run_setting=RUN_SETTING,
        boundary_indices=tuple(range(48)),
        fading_quantile_alpha=0.10,
    )

    legal_alternatives_considered = sum(
        identity != base.mapping[user]
        for user in options
        for identity in options[user]
    )

    # Highest decision-instant nominal wanted-link margin.  The common cap and
    # noise make nominal gain sufficient for the ordering; no outcome is
    # opened to choose this destination.
    best_alt: dict[int, tuple[int, int]] = {}
    for user in sorted(options):
        candidates = [
            (float(arrays.nominal_gain[0, by_key[(user, identity)]]), identity)
            for identity in options[user]
            if identity != base.mapping[user]
        ]
        if candidates:
            best_alt[user] = min(candidates, key=lambda row: (-row[0], row[1]))[1]

    occupants: dict[tuple[int, int], list[int]] = defaultdict(list)
    for user, identity in base.assignments:
        if identity is not None:
            occupants[identity].append(user)
    occupancy_histogram = Counter(len(users) for users in occupants.values())
