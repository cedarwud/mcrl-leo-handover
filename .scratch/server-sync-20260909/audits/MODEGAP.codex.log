                continue
            row = by_key[(user, beam)]
            arrivals.append((float(arrays.slants_km[0, row]), user))
        nearest = tuple(user for _slant, user in sorted(arrivals)[:2])
        if len(nearest) != 2:
            continue
        changes = {user: beam for user in nearest}
        candidates.append(
            {
                "config": configuration(base, changes, "occupancy-activation"),
                "members": nearest,
                "mechanisms": {"occupancy_activation"},
                "events": [{"source_occupancy": occupancy, "target_beam": beam}],
            }
        )
        mechanism_generated["occupancy_activation"] += 1

    # 2. Multi-aggressor tail at the actual decision-instant radiation state.
    tail, tail_census, scalar_base_profile = interference_tail(
        tape=tape, step_index=step_index, base=base
    )
    mechanism_eligible_events["multi_aggressor_relief"] = tail_census["tail_victims"]
    for victim in tail:
        ranked = victim["ranked_aggressors"]
        for size in (2, 3):
            members = tuple(ranked[:size])
            if len(members) != size or any(user not in best_alt for user in members):
                continue
            changes = {user: best_alt[user] for user in members}
            candidates.append(
                {
                    "config": configuration(base, changes, "multi-aggressor-relief"),
                    "members": members,
                    "mechanisms": {"multi_aggressor_relief"},
                    "events": [
                        {
                            "victim_user": victim["victim_user"],
                            "top_k": size,
                            "aggregate_nominal_interference_w": victim[
                                "aggregate_nominal_interference_w"
                            ],
                        }
                    ],
                }
            )
            mechanism_generated["multi_aggressor_relief"] += 1

    # 3. Complete evacuation of every occupancy-2/3 base beam.
    for beam, members_list in sorted(occupants.items()):
        if len(members_list) not in (2, 3):
            continue
        mechanism_eligible_events["complete_beam_evacuation"] += 1
        members = tuple(sorted(members_list))
        if any(user not in best_alt or best_alt[user] == beam for user in members):
            continue
        changes = {user: best_alt[user] for user in members}
        candidates.append(
            {
                "config": configuration(base, changes, "complete-beam-evacuation"),
                "members": members,
                "mechanisms": {"complete_beam_evacuation"},
                "events": [{"source_beam": beam, "source_occupancy": len(members)}],
            }
        )
        mechanism_generated["complete_beam_evacuation"] += 1

    candidates = deduplicate_candidates(candidates)
    candidate_sizes_tested = Counter(len(tuple(row["members"])) for row in candidates)
    singleton_configs: dict[tuple[int, tuple[int, int]], object] = {}
    for candidate in candidates:
        config = candidate["config"]
        for user in tuple(candidate["members"]):
            identity = config.mapping[user]
            if identity is None:
                continue
            singleton_configs[(user, identity)] = configuration(
                base, {user: identity}, "prevalence-matched-singleton"
            )
    evaluator.evaluate_many(
        [base, *singleton_configs.values(), *[row["config"] for row in candidates]]
    )
    base_profile = evaluator.evaluate(base)
    if not math.isclose(scalar_base_profile.bits, base_profile.bits, rel_tol=1e-12, abs_tol=2e-6):
        raise RuntimeError("dense/scalar base bits disagree")
    if not math.isclose(scalar_base_profile.joules, base_profile.joules, rel_tol=1e-12, abs_tol=1e-8):
        raise RuntimeError("dense/scalar base energy disagree")
    base_f = full_objective(base, base, base_profile, cell_rekeys)
    base_served = served_count(base_profile)
    base_ee = ee(base_profile)
    unilateral_scores: dict[tuple[int, tuple[int, int]], tuple[Fraction, object]] = {}
    for key, config in singleton_configs.items():
        if config.configuration_id in evaluator._invalid:
            continue
        profile = evaluator.evaluate(config)
        unilateral_scores[key] = (
            full_objective(base, config, profile, cell_rekeys) - base_f,
            profile,
        )
    qualifying = []
    invalid_joint = 0
    for candidate in candidates:
        config = candidate["config"]
        if config.configuration_id in evaluator._invalid:
            invalid_joint += 1
            continue
        profile = evaluator.evaluate(config)
        members = tuple(candidate["members"])
        singleton_d: dict[int, Fraction] = {}
        singleton_ee_gain: dict[int, float] = {}
        complete = True
        for user in members:
            identity = config.mapping[user]
            key = (user, identity)
            if identity is None or key not in unilateral_scores:
                complete = False
                break
            delta, singleton_profile = unilateral_scores[key]
            singleton_d[user] = delta
            singleton_ee_gain[user] = ee(singleton_profile) / base_ee - 1.0
        if not complete:
            continue
        joint_f = full_objective(base, config, profile, cell_rekeys)
        joint_delta = joint_f - base_f
        joint_served = served_count(profile)
        joint_ee_gain = ee(profile) / base_ee - 1.0
        if all(value <= 0 for value in singleton_d.values()) and joint_delta > 0 and joint_served >= base_served:
            qualifying.append(
                {
                    "configuration_id": config.configuration_id,
                    "members": list(members),
                    "size": len(members),
                    "mechanisms": sorted(candidate["mechanisms"]),
                    "d_bits_equivalent": {
                        str(user): float(value) for user, value in singleton_d.items()
                    },
                    "joint_delta_bits_equivalent": float(joint_delta),
                    "base_bits": base_profile.bits,
                    "base_joules": base_profile.joules,
                    "base_ee_bits_per_j": base_ee,
                    "joint_bits": profile.bits,
                    "joint_joules": profile.joules,
                    "joint_ee_bits_per_j": ee(profile),
                    "joint_ee_gain": joint_ee_gain,
                    "singleton_ee_gain": {
                        str(user): value for user, value in singleton_ee_gain.items()
                    },
                    "base_served": base_served,
                    "joint_served": joint_served,
                    "events": candidate["events"],
                }
            )

    best = None
    if qualifying:
        best = min(
            qualifying,
            key=lambda row: (-row["joint_ee_gain"], row["configuration_id"]),
        )
    mechanism_qualifies = {
        name: any(name in row["mechanisms"] for row in qualifying)
        for name in (
            "occupancy_activation",
            "multi_aggressor_relief",
            "complete_beam_evacuation",
        )
    }
    return {
        "world_index": world_index,
        "world_domain": tape.domain,
        "anchor_index": step_index,
        "base": {
            "bits": base_profile.bits,
            "joules": base_profile.joules,
            "ee_bits_per_j": base_ee,
            "served": base_served,
            "active_beams": len(occupants),
            "occupancy_histogram": {str(k): v for k, v in sorted(occupancy_histogram.items())},
        },
        "low_occupancy": low_occupancy,
        "legal_census": legal_census,
        "tail_census": tail_census,
        "mechanism_eligible_events": dict(mechanism_eligible_events),
        "mechanism_generated": dict(mechanism_generated),
        "unique_candidate_coalitions": len(candidates),
        "candidate_sizes_tested": {
            str(size): count for size, count in sorted(candidate_sizes_tested.items())
        },
        "invalid_joint_profiles": invalid_joint,
        "unilateral_profiles": len(singleton_configs),
        "legal_alternatives_considered_without_outcome": legal_alternatives_considered,
        "qualifying_count": len(qualifying),
        "mechanism_qualifies": mechanism_qualifies,
        "qualifying": qualifying,
        "best_qualifying": best,
        "physical_boundary_evaluations": evaluator.physical_evaluations + 48,
        "elapsed_s": time.perf_counter() - started,
    }


def fmt_percent(numerator: int, denominator: int) -> str:
    return f"{100.0 * numerator / denominator:.1f}%" if denominator else "undefined"


def render_report(payload: Mapping[str, object]) -> str:
    anchors = payload["anchors"]
    total = len(anchors)
    positive = [row for row in anchors if row["qualifying_count"] > 0]
    mechanism_names = (
        ("occupancy_activation", "Occupancy activation"),
        ("multi_aggressor_relief", "Multi-aggressor relief"),
        ("complete_beam_evacuation", "Complete beam evacuation"),
    )
    gains = sorted(row["best_qualifying"]["joint_ee_gain"] for row in positive)
    low1 = sum(row["low_occupancy"]["occupancy_1_beams"] for row in anchors)
    low2 = sum(row["low_occupancy"]["occupancy_2_beams"] for row in anchors)
    active = sum(row["low_occupancy"]["active_beams"] for row in anchors)
    qualifying_sizes = Counter()
    best_sizes = Counter()
    for row in anchors:
        for candidate in row["qualifying"]:
            qualifying_sizes[candidate["size"]] += 1
        if row["best_qualifying"] is not None:
            best_sizes[row["best_qualifying"]["size"]] += 1
    candidate_sizes = {
        int(key): value
        for key, value in payload["search_budget"]["candidate_sizes_tested"].items()
    }

    lines = [
        f"# {len(positive)}/{total} = {fmt_percent(len(positive), total)}",
        "",
        "`DIAGNOSTIC_NOT_CLAIM` — prevalence census, 2026-09-09.",
        "",
    ]
    if not positive:
        lines.extend(
            [
                "**Qualifying coalitions were absent within this fixed physical-event search budget.** "
                "This means rare-or-absent under the tested constructions, not a proof that no profitable "
                "coalition exists in these worlds.",
                "",
            ]
        )
    elif len(positive) / total < 0.1:
        lines.extend(
            [
                "**Qualifying coalitions were rare within this fixed physical-event search budget.**",
                "",
            ]
        )
    else:
        lines.extend(
            [
                "**Qualifying coalitions were common in the tested slice: at least one was observed at "
                f"{len(positive)}/{total} real anchors.** This is a within-world diagnostic estimate, "
                "not an across-world prevalence claim.",
                "",
            ]
        )

    lines.extend(["## Mechanism prevalence", "", "| mechanism | anchors with >=1 | fraction of all anchors | physical events exposed | candidates generated |", "|---|---:|---:|---:|---:|"])
    for key, label in mechanism_names:
        count = sum(bool(row["mechanism_qualifies"][key]) for row in anchors)
        eligible = sum(row["mechanism_eligible_events"].get(key, 0) for row in anchors)
        generated = sum(row["mechanism_generated"].get(key, 0) for row in anchors)
        lines.append(f"| {label} | {count}/{total} | {fmt_percent(count, total)} | {eligible} | {generated} |")
    lines.extend(
        [
            "",
            "Mechanism rows can overlap: a single physical assignment may be generated by more than one rule. "
            "The headline numerator is the union over mechanisms and therefore is not the sum of the rows.",
            "",
            "Multi-aggressor relief had no trigger-eligible victim events in this slice, so its zero row "
            "reflects zero candidate exposure under the fixed rule as well as zero qualifying anchors.",
            "",
            "## Energy-efficiency outcome",
            "",
        ]
    )
    if gains:
        lines.extend(
            [
                "For the best qualifying coalition at each positive anchor, "
                "`EE(joint)/EE(anchor) - 1` was:",
                "",
                f"- minimum: **{min(gains):.6f} ({100 * min(gains):.3f}%)**",
                f"- median: **{statistics.median(gains):.6f} ({100 * statistics.median(gains):.3f}%)**",
                f"- maximum: **{max(gains):.6f} ({100 * max(gains):.3f}%)**",
                "",
            ]
        )
    else:
        lines.extend(["No qualifying anchor exists, so the requested min/median/max EE-gain distribution is undefined.", ""])

    lines.extend(
        [
            "The acceptance objective remained the sealed full objective `B - eta_ref E + kappa phi`; "
            "EE is reported separately as the owner-facing outcome and was not substituted into acceptance.",
            "",
            "## Coalition sizes",
            "",
            f"- candidate coalitions tested by size: `{dict(sorted(candidate_sizes.items()))}`",
            f"- unique qualifying coalitions by size: `{dict(sorted(qualifying_sizes.items()))}`",
            f"- best-per-positive-anchor coalitions by size: `{dict(sorted(best_sizes.items()))}`",
            "",
            "## Occupancy exposure",
            "",
            f"Across {total} anchors there were **{low1} beam-anchor incidences at occupancy 1** and "
            f"**{low2} at occupancy 2**, out of {active} active beam-anchor incidences. "
            f"Their shares were {fmt_percent(low1, active)} and {fmt_percent(low2, active)}, respectively.",
            "",
            "## Coverage and search budget",
            "",
            f"- worlds: **{payload['coverage']['worlds']}** (`{', '.join(payload['coverage']['world_domains'])}`)",
            f"- anchors: **{total}** ({payload['coverage']['anchors_per_world']} per world)",
            f"- users per world: **{payload['configuration']['users']}**",
            f"- base carrier: `{payload['configuration']['carrier']}`",
            f"- objective field: corrected causal ACM, `{payload['configuration']['field']}` keyed fading, "
            f"48 boundaries, alpha={payload['configuration']['alpha']}",
            f"- unique joint candidate profiles tested: **{payload['search_budget']['unique_joint_candidates']}**",
            f"- legal unilateral profiles evaluated to form matched marginals / fixed best alternatives: "
            f"**{payload['search_budget']['unilateral_profiles']}**",
            f"- physical boundary evaluations: **{payload['search_budget']['physical_boundary_evaluations']}**",
            f"- wall time: **{payload['search_budget']['elapsed_s']:.1f} s**; concurrency: one process; nice level 10",
            "",
            "This was a breadth-first, non-exhaustive census. A zero or low fraction means "
            "**rare within this budget**, not mathematically absent: only the three fixed physical-event "
            "constructions were tested, with one deterministic destination rule for relief/evacuation.",
            "",
            "## Fixed rules and provenance",
            "",
            "- Occupancy activation tested the two nearest legal arrivals into every occupancy-1/2 base beam.",
            "- Multi-aggressor relief tested top-2 and top-3 aggressor-user sets only for interference-limited "
            "victims whose largest aggressor alone did not clear every decision-instant victim slot.",
            "- Complete evacuation tested every occupancy-2/3 base beam; all occupants moved.",
            "- For already physically selected relief/evacuation members, the destination was that user's "
            "highest decision-instant nominal wanted-link-margin legal alternative, with a stable physical-ID "
            "tie-break. Users and coalitions were never ranked by `|d_i|`; outcomes did not choose destinations.",
            f"- source commit: `{payload['provenance']['source_commit']}`; tracked tree: `{payload['provenance']['tree']}`",
            f"- runner SHA-256: `{payload['provenance']['runner_sha256']}`",
            f"- eta_ref=lambda: `{payload['configuration']['eta_ref']}` bit/J; kappa: `{payload['configuration']['kappa']}` bit/user-step",
            f"- RF cap {BEAM_RF_CAP_W} W; target {RATE_TARGET_BPS / 1e6:.0f} Mbit/s; bandwidth {BEAM_BANDWIDTH_HZ / 1e6:.6f} MHz; "
            f"active-chain circuit assumption {CIRCUIT_POWER_PER_CHAIN_W} W",
            "- no threshold, sign, seed, horizon, price, service guard, or acceptance rule was changed.",
            "",
            "Fresh tape receipts:",
            "",
        ]
    )
    for row in payload["tapes"]:
        lines.append(
            f"- `{row['domain']}`: seed `{row['seed']}`, tape digest `{row['tape_digest']}`, "
            f"local manifest SHA-256 `{row['local_manifest_sha256']}`"
        )

    if positive:
        lines.extend(["", "## Best qualifying coalition at each positive anchor", "", "| world | anchor | mechanism(s) | size | base EE (Mbit/J) | joint EE (Mbit/J) | EE gain | served base->joint |", "|---:|---:|---|---:|---:|---:|---:|---:|"])
        for anchor in positive:
            best = anchor["best_qualifying"]
            lines.append(
                f"| {anchor['world_index']} | {anchor['anchor_index']} | {', '.join(best['mechanisms'])} | "
                f"{best['size']} | {best['base_ee_bits_per_j'] / 1e6:.6f} | "
                f"{best['joint_ee_bits_per_j'] / 1e6:.6f} | {100 * best['joint_ee_gain']:.3f}% | "
                f"{best['base_served']}->{best['joint_served']} |"
            )
    lines.extend(
        [
            "",
            "Raw per-anchor candidates, matched marginals, F/EE outcomes, service counts, physical-event "
            "receipts, tape hashes, and timing are in `.scratch/prevalence-census/output/prevalence-census.json`.",
            "",
        ]
    )
    return "\n".join(lines)


def validate(payload: Mapping[str, object], report: str, minimum_anchors: int) -> None:
    anchors = payload["anchors"]
    if len(anchors) < minimum_anchors:
        raise RuntimeError(f"only {len(anchors)} anchors, minimum is {minimum_anchors}")
    required = (
        "Mechanism prevalence",
        "Energy-efficiency outcome",
        "Coalition sizes",
        "Occupancy exposure",
        "Coverage and search budget",
    )
    if any(text not in report for text in required):
        raise RuntimeError("report omits a required section")
    for anchor in anchors:
        for row in anchor["qualifying"]:
            if not all(value <= 0.0 for value in row["d_bits_equivalent"].values()):
                raise RuntimeError("qualifying row has a positive singleton marginal")
            if not row["joint_delta_bits_equivalent"] > 0.0:
                raise RuntimeError("qualifying row lacks strict joint improvement")
            if row["joint_served"] < row["base_served"]:
                raise RuntimeError("qualifying row violates the service guard")
            expected = row["joint_ee_bits_per_j"] / row["base_ee_bits_per_j"] - 1.0
            if not math.isclose(expected, row["joint_ee_gain"], rel_tol=0.0, abs_tol=1e-15):
                raise RuntimeError("EE gain arithmetic drifted")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--worlds", type=int, default=4)
    parser.add_argument("--anchors-per-world", type=int, default=30)
    parser.add_argument("--minimum-anchors", type=int, default=20)
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if not 1 <= args.worlds <= len(PROBE_WORLD_DOMAINS):
        raise SystemExit("--worlds must be in 1..4")
    if not 1 <= args.anchors_per_world <= 30:
        raise SystemExit("--anchors-per-world must be in 1..30")
    started = time.perf_counter()
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    tape_dir = OUT_DIR / "fresh-tapes"
    tape_dir.mkdir(parents=True, exist_ok=True)
    anchors = []
    tape_rows = []
    for world_index, domain in enumerate(PROBE_WORLD_DOMAINS[: args.worlds], start=1):
        tape_started = time.perf_counter()
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(user_count=100),
            steps=33,
            start_time_s=0.0,
        )
        manifest_bytes = json.dumps(
            tape.manifest(), indent=2, sort_keys=True
        ).encode("utf-8") + b"\n"
        manifest_path = tape_dir / f"probe-r2-world-{world_index}-manifest.json"
        temporary = manifest_path.with_suffix(".json.tmp")
        temporary.write_bytes(manifest_bytes)
        os.replace(temporary, manifest_path)
        tape_rows.append(
            {
                "world_index": world_index,
                "domain": domain,
                "seed": tape.seed,
                "tape_digest": tape.digest,
                "local_manifest_sha256": sha256_bytes(manifest_bytes),
                "manifest_bytes": len(manifest_bytes),
                "build_s": time.perf_counter() - tape_started,
            }
        )
        for step_index in range(args.anchors_per_world):
            row = evaluate_anchor(tape, world_index, step_index)
            anchors.append(row)
            print(
                json.dumps(
                    {
                        "world": world_index,
                        "anchor": step_index,
                        "candidates": row["unique_candidate_coalitions"],
                        "qualifying": row["qualifying_count"],
                        "elapsed_s": round(row["elapsed_s"], 3),
                    },
                    sort_keys=True,
# Prevalence census specification

`DIAGNOSTIC_NOT_CLAIM`.

Completion criterion: one unattended command must build fresh local tapes for
the real `V025_PROBE_R2` evaluation worlds, evaluate at least 20 real anchors,
and write a self-validating `PREVALENCE-CENSUS-2026-09-09.md` containing the
overall qualifying-anchor fraction, the three mechanism fractions, best-joint
EE-gain min/median/max, coalition sizes, low-occupancy beam counts, and the
world/anchor/search budget.

The qualifying rule is fixed before outcomes are opened:

1. every member's full-objective unilateral difference is at most zero;
2. the full coalition's objective difference is strictly positive; and
3. the coalition's positive-decoding-time served count is at least the
   anchor's.

The objective is the sealed matrix objective
`B - eta_ref E + kappa phi`, using the stage-4h exact prices and physical
handover preference. The reported outcome is pooled energy efficiency
`B/E`; it is not substituted for the acceptance objective.

Candidates are deterministic physical-event constructions:

- occupancy activation: for every base beam of occupancy 1 or 2, move the two
  nearest non-occupants for whom that beam is live and legal into it;
- multi-aggressor relief: at boundary zero, identify interference-limited
  target-infeasible victims for whom deleting the largest aggregate nominal
  aggressor at the fixed solved powers still does not clear every victim
  slot, then try the top-2 and top-3 aggressor-user sets; and
- complete beam evacuation: for every base beam of occupancy 2 or 3, move all
  occupants off it.

For multi-aggressor and evacuation members, the destination is the member's
highest decision-instant nominal wanted-link margin among legal alternatives
(stable physical-ID tie-break). This selects an action only after the member
is identified by a physical event; users and coalitions are never ranked by
`|d_i|`, and no outcome is opened to choose a destination.

All counterfactuals use the corrected causal `a-r0` ACM, realised keyed fading,
48 boundaries, alpha 0.10, 50 Mbit/s target, 1.65 W cap, 0.338 W active-chain
circuit assumption, nearest-eligible base carrier, unchanged service guard,
and the 100-user primary regime.
