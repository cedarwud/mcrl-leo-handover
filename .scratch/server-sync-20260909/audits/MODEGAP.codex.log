+#!/usr/bin/env python3
+"""Measure realised ACM headroom without changing V0.25 transmit powers.
+
+This is a diagnostic evaluator, not a selector.  It regenerates one sealed
+PROBE_R2 world, evaluates the pipeline's committed BASE configurations under
+the corrected alpha=.10 causal ACM rule, and re-credits each active
+transmission with the highest sealed ACM mode cleared by its realised SINR.
+No power solve is rerun for the counterfactual.
+"""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+import hashlib
+import importlib.util
+import json
+import math
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+from typing import Iterable, Mapping, Sequence
+
+from mcrl.physics_v025.acm import ACM_MODES, select_mode
+from mcrl.physics_v025.adapter import _rescore_boundary
+from mcrl.physics_v025.constants_v025 import (
+    ACM_TABLE_SHA256,
+    BEAM_BANDWIDTH_HZ,
+    BEAM_RF_CAP_W,
+    CIRCUIT_POWER_PER_CHAIN_W,
+    DECISION_INTERVAL_S,
+    RATE_TARGET_BPS,
+)
+from mcrl.physics_v025.integration import BoundarySample, integrate_47_subintervals
+from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+from mcrl.physics_v025.tapes import PROBE_WORLD_DOMAINS, build_world_tape
+
+
+ROOT = Path(__file__).resolve().parent
+RUNNER_PATH = (
+    ROOT
+    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
+)
+DEFAULT_JSON = ROOT / ".scratch/mode-selection-gap/mode-selection-gap.json"
+DEFAULT_REPORT = ROOT / "MODE-SELECTION-GAP-2026-09-10.md"
+ALPHA = 0.10
+FIELD = "realised"
+CARRIER = "nearest-eligible"
+SETTING_LABEL = "a-r0"
+
+
+def load_runner():
+    spec = importlib.util.spec_from_file_location("v025_mode_gap_runner", RUNNER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load V0.25 matrix runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+RUNNER = load_runner()
+SETTING = RUNNER._setting(SETTING_LABEL)
+RUN_SETTING = RUNNER.run_setting_for(SETTING_LABEL)
+
+# A rung is the sealed mode's increasing spectral-efficiency rank.  That is
+# the operational order used by select_mode (which maximises efficiency), not
+# the literal table row, because the sealed table contains threshold crossings.
+MODES_BY_EFFICIENCY = tuple(
+    sorted(ACM_MODES, key=lambda mode: mode.efficiency_bit_per_symbol)
+)
+RUNG = {mode.name: index for index, mode in enumerate(MODES_BY_EFFICIENCY)}
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def git_value(*args: str) -> str:
+    return subprocess.run(
+        ("git", *args), cwd=ROOT, check=True, text=True, capture_output=True
+    ).stdout.strip()
+
+
+def mode_name(mode) -> str:
+    return "NO_MODE" if mode is None else mode.name
+
+
+def mode_rung(mode) -> int:
+    return -1 if mode is None else RUNG[mode.name]
+
+
+def boundary_occupancies(radiation) -> dict[tuple[int, int], int]:
+    users_by_beam: dict[tuple[int, int], set[int]] = defaultdict(set)
+    for slot in radiation.slots:
+        for tx in slot.transmissions:
+            users_by_beam[tuple(tx.beam)].add(int(tx.user_id))
+    return {beam: len(users) for beam, users in users_by_beam.items()}
+
+
+def custom_receipt(shared, events, *, upgraded: bool):
+    # RadiationBoundary is frozen, so pass inventory/roster explicitly through
+    # a small closure rather than mutate the physical object.
+    points = []
+    for boundary in shared.integrated:
+        original = _rescore_boundary(
+            boundary,
+            shared.inventory,
+            SETTING,
+            shared.users,
+            shared.circuit_power_per_active_chain_w,
+        )
+        rates = {user: 0.0 for user in original.rate_bps}
+        decoded = {user: True for user in original.rate_bps}
+        seen = {user: False for user in original.rate_bps}
+        for slot in boundary.radiation.slots:
+            for tx in slot.transmissions:
+                user = int(tx.user_id)
+                seen[user] = True
+                mode = select_mode(tx.sinr) if upgraded else tx.m_tx
+                passed = mode is not None and tx.sinr >= mode.threshold_linear
+                decoded[user] &= passed
+                if passed:
+                    rates[user] += (
+                        slot.fraction
+                        * tx.bandwidth_hz
+                        * mode.spectral_efficiency_bit_per_s_hz
+                    )
+        decoded = {user: decoded[user] and seen[user] for user in decoded}
+        points.append(BoundarySample(boundary.time_s, rates, original.power_w, decoded))
+    return integrate_47_subintervals(
+        points,
+        interruptions=events,
+        interruption_enabled=SETTING.interruption == "on",
+    )
+
+
+def demand_capped_bits(per_user_bits: Mapping[int, float]) -> float:
+    cap = RATE_TARGET_BPS * DECISION_INTERVAL_S
+    return math.fsum(min(bits, cap) for bits in per_user_bits.values())
+
+
+def evaluate_anchor(tape, anchor: int, incumbent, previously_served: set[int]):
+    config = RUNNER._base_configuration(tape, anchor, CARRIER)
+    rekeyed = RUNNER._rekeyed_users(tape, anchor)
+    evaluator = RUNNER.StepEvaluator(
+        tape,
+        SETTING,
+        anchor,
+        transition_from=incumbent,
+        cell_rekeyed_users=rekeyed,
+        previously_served_users=tuple(sorted(previously_served)),
+        field=FIELD,
+        run_setting=RUN_SETTING,
+        boundary_indices=tuple(range(48)),
+        fading_quantile_alpha=ALPHA,
+    )
+    profile = evaluator.evaluate(config)
+    shared = evaluator._shared[config.configuration_id]
+    events = RUNNER._interruption_events(
+        incumbent,
+        config,
+        shared.integrated[0].time_s,
+        cell_rekeyed_users=rekeyed,
+        previously_served_users=tuple(sorted(previously_served)),
+    )
+    declared = custom_receipt(shared, events, upgraded=False)
+    upgraded = custom_receipt(shared, events, upgraded=True)
+
+    for user in profile.score.bits:
+        if not math.isclose(
+            declared.bits[user], profile.score.bits[user], rel_tol=1e-12, abs_tol=2e-6
+        ):
+            raise RuntimeError(f"anchor {anchor}: declared-bit reconstruction drift")
+    if not math.isclose(declared.joules, profile.joules, rel_tol=1e-12, abs_tol=1e-8):
+        raise RuntimeError(f"anchor {anchor}: energy reconstruction drift")
+
+    observations = []
+    power_payload = []
+    for boundary_index, boundary in enumerate(shared.integrated):
+        occupancies = boundary_occupancies(boundary.radiation)
+        for slot_index, slot in enumerate(boundary.radiation.slots):
+            for tx in slot.transmissions:
+                supported = select_mode(tx.sinr)
+                tx_rung = mode_rung(tx.m_tx)
+                supported_rung = mode_rung(supported)
+                sinr_db = 10.0 * math.log10(max(tx.sinr, sys.float_info.min))
+                observations.append(
+                    {
+                        "anchor": anchor,
+                        "boundary": boundary_index,
+                        "boundary_time_s": boundary.time_s,
+                        "slot": slot_index,
+                        "slot_start_fraction": slot.start_fraction,
+                        "slot_end_fraction": slot.end_fraction,
+                        "slot_fraction": slot.fraction,
+                        "user": int(tx.user_id),
+                        "beam": [int(value) for value in tx.beam],
+                        "occupancy": occupancies[tuple(tx.beam)],
+                        "rf_power_w": tx.rf_power_w,
+                        "transmitted_mode": mode_name(tx.m_tx),
+                        "transmitted_threshold_db": (
+                            None if tx.m_tx is None else tx.m_tx.threshold_db
+                        ),
+                        "transmitted_rung": tx_rung,
+                        "realised_sinr_linear": tx.sinr,
+                        "realised_sinr_db": sinr_db,
+                        "highest_supported_mode": mode_name(supported),
+                        "highest_supported_threshold_db": (
+                            None if supported is None else supported.threshold_db
+                        ),
+                        "highest_supported_rung": supported_rung,
+                        "rung_gap": supported_rung - tx_rung,
+                        "db_gap": (
+                            None if tx.m_tx is None else sinr_db - tx.m_tx.threshold_db
+                        ),
+                        "declared_decoded": bool(
+                            tx.realised_outcome is not None
+                            and tx.realised_outcome.decoded
+                        ),
+                    }
+                )
+                power_payload.append(
+                    (
+                        anchor,
+                        boundary_index,
+                        slot_index,
+                        int(tx.user_id),
+                        tx.rf_power_w.hex(),
+                    )
+                )
+
+    declared_bits = math.fsum(declared.bits.values())
+    upgraded_bits = math.fsum(upgraded.bits.values())
+    return (
+        {
+            "anchor": anchor,
+            "configuration_id": config.configuration_id,
+            "assignment_sha256": RUNNER.digest_payload(config.assignments),
+            "boundaries": len(shared.integrated),
+            "transmission_observations": len(observations),
+            "declared_bits": declared_bits,
+            "upgraded_bits": upgraded_bits,
+            "declared_demand_capped_bits": demand_capped_bits(declared.bits),
+            "upgraded_demand_capped_bits": demand_capped_bits(upgraded.bits),
+            "joules": declared.joules,
+            "declared_ee_bits_per_j": declared_bits / declared.joules,
+            "upgraded_ee_bits_per_j": upgraded_bits / declared.joules,
+            "declared_demand_capped_ee_bits_per_j": (
+                demand_capped_bits(declared.bits) / declared.joules
+            ),
+            "upgraded_demand_capped_ee_bits_per_j": (
+                demand_capped_bits(upgraded.bits) / declared.joules
+            ),
+            "power_vector_sha256": hashlib.sha256(
+                json.dumps(power_payload, separators=(",", ":")).encode("ascii")
+            ).hexdigest(),
+        },
+        observations,
+        config,
+        {user for user, seconds in profile.score.decoding_time_s.items() if seconds > 0.0},
+    )
+
+
+def stats(rows: Sequence[Mapping[str, object]]) -> dict[str, object]:
+    rung = [int(row["rung_gap"]) for row in rows]
+    db = [float(row["db_gap"]) for row in rows if row["db_gap"] is not None]
+    if not rung:
+        raise RuntimeError("empty transmission stratum")
+    return {
+        "slots": len(rows),
+        "db_gap_slots": len(db),
+        "mean_rung_gap": statistics.fmean(rung),
+        "median_rung_gap": statistics.median(rung),
+        "fraction_zero_rungs": sum(value == 0 for value in rung) / len(rung),
+        "fraction_three_or_more_rungs": sum(value >= 3 for value in rung) / len(rung),
+        "fraction_negative_rungs": sum(value < 0 for value in rung) / len(rung),
+        "mean_db_gap": statistics.fmean(db) if db else None,
+        "median_db_gap": statistics.median(db) if db else None,
+        "fraction_no_transmitted_mode": sum(
+            row["transmitted_mode"] == "NO_MODE" for row in rows
+        )
+        / len(rows),
+        "fraction_declared_decode_failure": sum(
+            not bool(row["declared_decoded"]) for row in rows
+        )
+        / len(rows),
+    }
+
+
+def aggregate(anchor_rows, observations):
+    joules = math.fsum(row["joules"] for row in anchor_rows)
+    declared_bits = math.fsum(row["declared_bits"] for row in anchor_rows)
+    upgraded_bits = math.fsum(row["upgraded_bits"] for row in anchor_rows)
+    declared_capped = math.fsum(
+        row["declared_demand_capped_bits"] for row in anchor_rows
+    )
+    upgraded_capped = math.fsum(
+        row["upgraded_demand_capped_bits"] for row in anchor_rows
+    )
+    by_occupancy = {}
+    for occupancy in sorted({int(row["occupancy"]) for row in observations}):
+        by_occupancy[str(occupancy)] = stats(
+            [row for row in observations if int(row["occupancy"]) == occupancy]
+        )
+    return {
+        "gap_statistics": stats(observations),
+        "gap_statistics_by_occupancy": by_occupancy,
+        "delivered_capacity": {
+            "declared_bits": declared_bits,
+            "upgraded_bits": upgraded_bits,
+            "extra_bits": upgraded_bits - declared_bits,
+            "joules_unchanged": joules,
+            "declared_bits_per_j": declared_bits / joules,
+            "upgraded_bits_per_j": upgraded_bits / joules,
+            "extra_bits_per_j": (upgraded_bits - declared_bits) / joules,
+            "relative_bits_and_ee_gain": upgraded_bits / declared_bits - 1.0,
+        },
+        "demand_capped": {
+            "declared_bits": declared_capped,
+            "upgraded_bits": upgraded_capped,
+            "extra_bits": upgraded_capped - declared_capped,
+            "joules_unchanged": joules,
+            "declared_bits_per_j": declared_capped / joules,
+            "upgraded_bits_per_j": upgraded_capped / joules,
+            "extra_bits_per_j": (upgraded_capped - declared_capped) / joules,
+            "relative_bits_and_ee_gain": upgraded_capped / declared_capped - 1.0,
+        },
+    }
+
+
+def pct(value: float) -> str:
+    return f"{100.0 * value:.2f}%"
+
+
+def fmt_gap(value) -> str:
+    return "n/a" if value is None else f"{float(value):.3f}"
+
+
+def render(payload: Mapping[str, object], json_path: Path) -> str:
+    overall = payload["aggregate"]["gap_statistics"]
+    delivered = payload["aggregate"]["delivered_capacity"]
+    capped = payload["aggregate"]["demand_capped"]
+    lines = [
+        (
+            f"**Median gap: {overall['median_rung_gap']:.1f} rungs and "
+            f"{overall['median_db_gap']:.3f} dB; mode selection alone offers "
+            f"{delivered['extra_bits_per_j']:,.0f} extra bit/J delivered "
+            f"({capped['extra_bits_per_j']:,.0f} bit/J demand-capped), at identical transmit power.**"
+        ),
+        "",
+        "# Mode-selection gap diagnostic — 2026-09-10",
+        "",
+        "`DIAGNOSTIC_NOT_CLAIM` · `FAST_DIAGNOSIS` · pure evaluation of the existing law.",
+        "",
+    ]
+    if float(overall["fraction_zero_rungs"]) >= 0.5:
+        lines.extend(
+            [
+                "**The transmitted mode was usually already the highest mode supported by realised SINR; "
+                "the proposed explanation is refuted on this slice.**",
+                "",
+            ]
+        )
+    else:
+        lines.extend(
+            [
+                "**The transmitted mode was usually below the highest mode supported by realised SINR; "
+                "the proposed explanation is supported on this slice.**",
+                "",
+            ]
+        )
+    lines.extend(
+        [
+            "## Slot-level result",
+            "",
+            "Rung gaps are signed: `highest realised-supported rung - transmitted rung`. "
+            "Rungs are the sealed modes ordered by increasing spectral efficiency, matching the law's "
+            "greatest-efficiency selector. `NO_MODE` is a virtual rung -1. Decibel-gap statistics require "
+            "an actual transmitted mode and therefore exclude `NO_MODE` rows; every such row remains in "
+            "the rung distribution and raw ledger.",
+            "",
+            "| occupancy | slot observations | mean rung gap | median rung gap | zero rungs | >=3 rungs | mean dB gap | median dB gap | no transmitted mode | decode failure |",
+            "|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    table_rows = [("all", overall)] + list(
+        payload["aggregate"]["gap_statistics_by_occupancy"].items()
+    )
+    for occupancy, row in table_rows:
+        lines.append(
+            f"| {occupancy} | {row['slots']} | {row['mean_rung_gap']:.3f} | "
+            f"{row['median_rung_gap']:.3f} | {pct(row['fraction_zero_rungs'])} | "
+            f"{pct(row['fraction_three_or_more_rungs'])} | {fmt_gap(row['mean_db_gap'])} | "
+            f"{fmt_gap(row['median_db_gap'])} | {pct(row['fraction_no_transmitted_mode'])} | "
+            f"{pct(row['fraction_declared_decode_failure'])} |"
+        )
+    lines.extend(
+        [
+            "",
+            "Each raw row records anchor/boundary/slot/user/beam, occupancy, exact RF power, transmitted "
+            "mode and threshold, realised SINR, highest supported sealed mode, signed rung gap, and dB gap.",
+            "",
+            "## Same-power mode-only counterfactual",
+            "",
+            "| credit view | declared bits (Gbit) | highest-supported bits (Gbit) | same joules | declared Mbit/J | highest-supported Mbit/J | extra bit/J | relative gain |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+    )
+    for label, row in (("Delivered capacity", delivered), ("Demand-capped", capped)):
+        lines.append(
+            f"| {label} | {row['declared_bits']/1e9:.6f} | {row['upgraded_bits']/1e9:.6f} | "
+            f"{row['joules_unchanged']:.6f} | {row['declared_bits_per_j']/1e6:.6f} | "
+            f"{row['upgraded_bits_per_j']/1e6:.6f} | {row['extra_bits_per_j']:,.3f} | "
+            f"{pct(row['relative_bits_and_ee_gain'])} |"
+        )
+    lines.extend(
+        [
+            "",
+            (
+                f"**Mode selection alone makes {delivered['extra_bits_per_j']:,.3f} extra delivered bit/J "
+                f"available, or {capped['extra_bits_per_j']:,.3f} extra bit/J after capping each user's "
+                f"per-anchor credit at {RATE_TARGET_BPS/1e6:.0f} Mbit/s, with every RF power held fixed.**"
+            ),
+            "",
+            "The delivered view credits the full capacity of the highest mode cleared by realised SINR. "
+            "The demand-capped view applies `min(user integrated bits, 50 Mbit/s × 30.08 s)` separately "
+            "for each user and anchor. Both reuse the declared radiation objects and their energy; the "
+            "counterfactual changes only the credited mode.",
+            "",
+            "## Coverage and committed configuration",
+            "",
+            f"- real world: `{payload['world']['domain']}` (seed `{payload['world']['seed']}`, tape digest `{payload['world']['tape_digest']}`)",
+            f"- anchors: `{payload['coverage']['anchors']}`; 48 realised boundaries per anchor; {payload['coverage']['transmission_observations']} active transmission-slot observations",
+            f"- configuration: corrected causal `{SETTING_LABEL}`, `{FIELD}` keyed fading, `MARGIN_Q` alpha={ALPHA:.2f}, carrier `{CARRIER}`",
+            "- committed assignment: `BASE:nearest-eligible`; the authoritative ten-anchor stage-4h smoke records every FULL decision missing the sealed deadline and atomically committing BASE, so anchors 0–3 are direct committed-pipeline configurations, not searched replacements",
+            f"- sealed constants retained: RF cap {BEAM_RF_CAP_W:.2f} W, target {RATE_TARGET_BPS/1e6:.0f} Mbit/s, bandwidth {BEAM_BANDWIDTH_HZ/1e6:.6f} MHz, active-chain circuit {CIRCUIT_POWER_PER_CHAIN_W:.3f} W",
+            "- power isolation: the script runs one declared evaluation per anchor, then re-credits its immutable `Transmission` records; it performs no second power solve and asserts exact equality of the common energy denominator",
+            "",
+            "Per-anchor power-vector SHA-256 values:",
+            "",
+        ]
+    )
+    for row in payload["anchors"]:
+        lines.append(
+            f"- anchor {row['anchor']}: `{row['power_vector_sha256']}`; "
+            f"{row['transmission_observations']} observations; {row['joules']:.6f} J"
+        )
+    lines.extend(
+        [
+            "",
+            "## Reproduction",
+            "",
+            "From the workspace root:",
+            "",
+            "```bash",
+            "PYTHONPATH=src nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python diagnose_mode_selection_gap.py --world 1 --anchors 0 1 2 3",
+            "sha256sum diagnose_mode_selection_gap.py MODE-SELECTION-GAP-2026-09-10.md .scratch/mode-selection-gap/mode-selection-gap.json",
+            "```",
+            "",
+            f"- source commit: `{payload['provenance']['source_commit']}`; tracked tree: `{payload['provenance']['tracked_tree']}`",
+            f"- evaluator script SHA-256 before report rendering: `{payload['provenance']['script_sha256']}`",
+            f"- imported matrix runner SHA-256: `{payload['provenance']['runner_sha256']}`",
+            f"- sealed ACM table SHA-256: `{ACM_TABLE_SHA256}`",
+            f"- raw ledger: `{json_path.relative_to(ROOT)}`",
+            "",
+            "The JSON contains all slot observations plus the exact aggregates used above. Validation "
+            "fails closed if there are fewer than four anchors or 48 boundaries per anchor, if baseline "
+            "bit reconstruction differs from the ordinary evaluator, if energy changes, or if any "
+            "highest-supported mode fails its own realised threshold.",
+            "",
+            "## Interpretation",
+            "",
+            "The occupancy breakdown tests the stated prediction directly: lower occupancy requires a "
+            "lower target spectral efficiency and thus can leave more power-funded headroom above the "
+            "transmitted mode. This is diagnostic evidence on one real world and four committed anchors, "
+            "not an efficacy claim or a proposal to alter the sealed law.",
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def validate(payload: Mapping[str, object]) -> None:
+    anchors = payload["anchors"]
+    observations = payload["observations"]
+    if len(anchors) < 4:
+        raise RuntimeError("at least four anchors are required")
+    if any(row["boundaries"] != 48 for row in anchors):
+        raise RuntimeError("an anchor did not expose all 48 boundaries")
+    if not observations:
+        raise RuntimeError("no active transmission slots were observed")
+    for row in observations:
+        supported = (
+            None
+            if row["highest_supported_mode"] == "NO_MODE"
+            else next(
+                mode
+                for mode in ACM_MODES
+                if mode.name == row["highest_supported_mode"]
+            )
+        )
+        if supported is not None and row["realised_sinr_linear"] < supported.threshold_linear:
+            raise RuntimeError("supported mode does not clear its realised threshold")
+    delivered = payload["aggregate"]["delivered_capacity"]
+    capped = payload["aggregate"]["demand_capped"]
+    if delivered["upgraded_bits"] + 1e-6 < delivered["declared_bits"]:
+        raise RuntimeError("highest-supported selection reduced delivered bits")
+    if capped["upgraded_bits"] + 1e-6 < capped["declared_bits"]:
+        raise RuntimeError("highest-supported selection reduced demand-capped bits")
+    if delivered["joules_unchanged"] != capped["joules_unchanged"]:
+        raise RuntimeError("energy denominator changed between credit views")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--world", type=int, default=1)
+    parser.add_argument("--anchors", type=int, nargs="+", default=[0, 1, 2, 3])
+    parser.add_argument("--json", type=Path, default=DEFAULT_JSON)
+    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    if not 1 <= args.world <= len(PROBE_WORLD_DOMAINS):
+        raise SystemExit(f"--world must be in 1..{len(PROBE_WORLD_DOMAINS)}")
+    anchors = sorted(set(args.anchors))
+    if len(anchors) < 4 or anchors[0] < 0 or anchors[-1] >= 30:
+        raise SystemExit("supply at least four distinct anchors in 0..29")
+    domain = PROBE_WORLD_DOMAINS[args.world - 1]
+    tape = build_world_tape(
+        domain=domain,
+        provider=LegacyWorldProvider(user_count=100),
+        steps=33,
+        start_time_s=0.0,
+    )
+    rows = []
+    observations = []
+    # The formal FULL trajectory committed BASE at every anchor.  Carry its
+    # assignment and served-state history through the requested anchors.
+    incumbent = RUNNER._base_configuration(tape, 0, CARRIER)
+    previously_served: set[int] = set()
+    selected = set(anchors)
+    for anchor in range(anchors[-1] + 1):
+        if anchor not in selected:
+            # Advance the committed carrier state; no physics is needed until
+            # the first selected gap-measurement anchor.
+            incumbent = RUNNER._base_configuration(tape, anchor, CARRIER)
+            continue
+        row, slot_rows, config, newly_served = evaluate_anchor(
+            tape, anchor, incumbent, previously_served
+        )
+        rows.append(row)
+        observations.extend(slot_rows)
+        incumbent = config
+        previously_served.update(newly_served)
+        print(
+            json.dumps(
+                {
+                    "anchor": anchor,
+                    "slots": row["transmission_observations"],
+                    "declared_Mbit_per_J": row["declared_ee_bits_per_j"] / 1e6,
+                    "mode_only_Mbit_per_J": row["upgraded_ee_bits_per_j"] / 1e6,
+                },
+                sort_keys=True,
+            ),
+            flush=True,
+        )
+    payload = {
+        "schema": "mcrl-v025-mode-selection-gap-diagnostic-v1",
+        "status": "DIAGNOSTIC_NOT_CLAIM",
+        "world": {
+            "index": args.world,
+            "domain": domain,
+            "seed": tape.seed,
+            "tape_digest": tape.digest,
+        },
+        "coverage": {
+            "anchors": anchors,
+            "boundaries_per_anchor": 48,
+            "transmission_observations": len(observations),
+        },
+        "configuration": {
+            "setting": SETTING_LABEL,
+            "field": FIELD,
+            "fading_quantile_alpha": ALPHA,
+            "carrier": CARRIER,
+            "rate_target_bps": RATE_TARGET_BPS,
+            "bandwidth_hz": BEAM_BANDWIDTH_HZ,
+            "rf_cap_w": BEAM_RF_CAP_W,
+            "demand_cap_semantics": "min(per-user integrated anchor bits, r_star * 30.08 s)",
+            "rung_semantics": "increasing spectral-efficiency rank; NO_MODE=-1",
+        },
+        "anchors": rows,
+        "observations": observations,
+        "aggregate": aggregate(rows, observations),
+        "provenance": {
+            "source_commit": git_value("rev-parse", "HEAD"),
+            "tracked_tree": git_value("rev-parse", "HEAD^{tree}"),
+            "script_sha256": sha256_file(Path(__file__).resolve()),
+            "runner_sha256": sha256_file(RUNNER_PATH),
+            "acm_table_sha256": ACM_TABLE_SHA256,
+        },
+    }
+    validate(payload)
+    args.json.parent.mkdir(parents=True, exist_ok=True)
+    args.json.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+    report = render(payload, args.json.resolve())
+    args.report.write_text(report)
+    print(json.dumps(payload["aggregate"], indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

