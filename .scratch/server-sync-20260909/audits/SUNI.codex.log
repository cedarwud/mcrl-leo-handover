def load_runner():
    spec = importlib.util.spec_from_file_location("v025_s_uni_cert_profile", RUNNER)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {RUNNER}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def evaluator_for(runner, tape, setting, run_setting, step: int, carrier: str):
    base = runner._base_configuration(tape, step, carrier)
    incumbent = runner._base_configuration(tape, max(0, step - 1), carrier)
    counter = runner.EvaluationCounter()
    evaluator = runner.StepEvaluator(
        tape,
        setting,
        step,
        transition_from=incumbent,
        cell_rekeyed_users=runner._rekeyed_users(tape, step),
        previously_served_users=runner._previously_served_users(tape, step, carrier),
        field="margin",
        fading_quantile_alpha=0.10,
        counter=counter,
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    return base, incumbent, evaluator


