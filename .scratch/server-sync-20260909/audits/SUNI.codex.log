        enforce_deadline=enforce_deadline,
        certification_trace=trace,
    )
    return {
        "step_index": step,
        "carrier": carrier,
        "selected_configuration_id": selected.configuration_id,
        "best_response_iterations": iterations,
        "wall_s": wall_s,
        "deadline_missed": missed,
        "termination": termination,
        "trace": trace,
    }


