# one anchor
# --------------------------------------------------------------------------
def run_anchor(
    *,
    tape,
    setting,
    run_setting,
    step_index,
    calibration,
    uni_budget_s,
    max_iterations,
    option_mode="full",
    option_cap=8,
    search_mode="gauss-seidel",
    log=print,
):
    started = time.perf_counter()
    base = R._base_configuration(tape, step_index, CARRIER)
    incumbent = base
    cell_rekeys = R._rekeyed_users(tape, step_index)
    options, census, option_receipt = probe_option_set(
        tape, step_index, run_setting=run_setting, mode=option_mode, cap=option_cap
    )
    users = tuple(sorted(user.user_id for user in tape.user_layout))

    selection = R.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=cell_rekeys,
        field="nominal",
        run_setting=run_setting,
        boundary_indices=(0,),
    )
    evaluate_batch(selection, [base])
    if base.configuration_id in selection._invalid:
        raise R.ProbeError("BASE has an invalid selection-time power certificate")
    base_selection = selection.evaluate(base)
    base_served = sum(base_selection.score.served_phy.values())

    u, iterations, termination, sweeps, uni_wall = iterated_unilateral_optimum(
        base=base,
        incumbent=incumbent,
        options=options,
        evaluator=selection,
        calibration=calibration,
        cell_rekeys=cell_rekeys,
        budget_s=uni_budget_s,
        max_iterations=max_iterations,
        search_mode=search_mode,
    )
    log(
        f"  step {step_index}: u iterations={iterations} sweeps={sweeps} "
        f"termination={termination} wall={uni_wall:.1f}s"
    )

    at_u = analyse_anchor_from(
        anchor=u,
        base=base,
        incumbent=incumbent,
        options=options,
        evaluator=selection,
        calibration=calibration,
        cell_rekeys=cell_rekeys,
        users=users,
        base_served=base_served,
        anchor_tag="u",
    )
    at_a0 = analyse_anchor_from(
        anchor=base,
        base=base,
        incumbent=incumbent,
        options=options,
        evaluator=selection,
        calibration=calibration,
        cell_rekeys=cell_rekeys,
        users=users,
        base_served=base_served,
        anchor_tag="a0",
    )

    # ---- realised 48-boundary pooled-EE profiles ----
    realised = R.StepEvaluator(
        tape,
        setting,
        step_index,
        transition_from=incumbent,
        cell_rekeyed_users=cell_rekeys,
        run_setting=run_setting,
    )
    best_u = at_u.pop("_best_config")
    best_u_improving = at_u.pop("_best_improving_config")
    at_a0.pop("_best_config")
    at_a0.pop("_best_improving_config")
    wanted = [base, u]
    if best_u is not None:
        wanted.append(best_u)
    evaluate_batch(realised, wanted)
    realised_rows = {}
    for tag, config in (("a0", base), ("u", u), ("best_joint_from_u", best_u)):
        if config is None or config.configuration_id in realised._invalid:
            realised_rows[tag] = None
            continue
        profile = realised.evaluate(config)
        realised_rows[tag] = {
            "bits": profile.bits,
            "joules": profile.joules,
            "ee_bit_per_j": profile.bits / profile.joules if profile.joules else None,
            "served_users": int(sum(profile.score.served_phy.values())),
            "certificate_status": profile.certificate_status,
            "rf_cap_hits": profile.rf_cap_hits,
            "rf_transmission_observations": profile.rf_transmission_observations,
            "acm_mode_counts": dict(profile.acm_mode_counts),
            "mean_acm_se_bit_s_hz": profile.mean_acm_se_bit_s_hz,
            "lit_beam_seconds": profile.lit_beam_seconds,
        }

    # ---- descriptive context at the carrier anchor ----
    base_map = base.mapping
    served_assignments = [v for v in base_map.values() if v is not None]
    active = sorted(set(served_assignments))
    context = {
        "users_total": len(users),
        "users_with_beam_at_a0": len(served_assignments),
        "active_beams_at_a0": len(active),
        "mean_users_per_active_beam_at_a0": (
            len(served_assignments) / len(active) if active else None
        ),
        "beams_evacuable_entirely_at_a0": at_a0["beams_evacuable_entirely"],
        "beams_evacuable_entirely_at_u": at_u["beams_evacuable_entirely"],
        "active_beams_at_u": at_u["active_beams"],
        "full_successor_legal_count": census["full_successor_legal_count"],
        "mean_searched_options_per_user": (
            math.fsum(len(options[user]) for user in users) / len(users)
        ),
        "users_with_no_searched_option": sum(1 for user in users if not options[user]),
    }

    return {
        "artifact_label": LABEL,
        "step_index": step_index,
        "carrier": CARRIER,
        "option_receipt": option_receipt,
        "u_iterations": iterations,
        "u_sweeps": sweeps,
        "u_termination": termination,
        "u_certified": termination.startswith("CERTIFIED"),
        "u_wall_s": uni_wall,
        "u_changed_users_vs_a0": len(_changed(base, u)),
        "base_served_users": int(base_served),
        "at_u": at_u,
        "at_a0": at_a0,
        "realised": realised_rows,
        "context": context,
        "anchor_wall_s": time.perf_counter() - started,
        "boundary_evaluations": selection.physical_evaluations + realised.physical_evaluations,
    }


