+PANEL_RUNNER = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/run_panelceil.py")
+CLEAN_RECEIPT = Path("/home/sat/mcrl-v025-rank2-ws/.scratch/cleanpath/cleanpath-receipt.json")
+OUTPUT = WORKSPACE / ".scratch/basin2/basin2-receipt.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+BATCH = 256
+ARM_NAMES = (
+    "RANDOM", "ROUND_ROBIN", "RSS_MAX", "NEAREST_ELIGIBLE",
+    "MYOPIC_GREEDY", "FIRST_IMPROVEMENT_FP",
+)
+PUBLISHED_EE_MBIT_J = {
+    "RANDOM": 11.233999,
+    "ROUND_ROBIN": 3.441227,
+    "RSS_MAX": 41.621560,
+    "NEAREST_ELIGIBLE": 11.027760,
+    "MYOPIC_GREEDY": 28.668530,
+    "FIRST_IMPROVEMENT_FP": 13.430253,
+}
+SCALAR_EVALUATE_CALLS = 0
+RANDOM_SEED = 20260910
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: dict) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def atomic_write(payload: dict) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
+    temporary.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(OUTPUT)
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def check_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError(f"peak RSS {peak_rss_bytes()} is not below 5 GB")
+
+
+def load_panel():
+    name = "basin2_panelceil_reference"
+    spec = importlib.util.spec_from_file_location(name, PANEL_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load PANELCEIL runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def forbid_scalar_evaluate(runner) -> None:
+    original = runner.StepEvaluator.evaluate
+
+    def forbidden(*args, **kwargs):
+        del args, kwargs
+        global SCALAR_EVALUATE_CALLS
+        SCALAR_EVALUATE_CALLS += 1
+        raise AssertionError("scalar StepEvaluator.evaluate is forbidden on BASIN2 surfaces")
+
+    forbidden.__name__ = "scalar_evaluate_forbidden_on_basin2"
+    forbidden.__wrapped__ = original
+    runner.StepEvaluator.evaluate = forbidden
+    assert runner.StepEvaluator.evaluate is forbidden
+
+
+def fresh_evaluator(runner, tape, step_index, incumbent, run_setting, field, boundaries):
+    evaluator = runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field=field, counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=boundaries,
+    )
+    assert evaluator.boundary_indices == boundaries
+    return evaluator
+
+
+def dedupe(configs):
+    return tuple({row.configuration_id: row for row in configs}.values())
+
+
+def profile(evaluator, config):
+    result = evaluator._evaluated.get(config.configuration_id)
+    if result is None:
+        raise RuntimeError(f"profile absent from dense cache: {config.configuration_id}")
+    return result
+
+
+def f_value(runner, calibration, evaluator, config) -> Fraction:
+    return runner._objective(profile(evaluator, config), calibration)
+
+
+def fraction_payload(value: Fraction) -> dict[str, object]:
+    return {
+        "numerator": value.numerator,
+        "denominator": value.denominator,
+        "rational": str(value),
+        "float": float(value),
+    }
+
+
+def configuration_from_receipt(runner, base, arm_row, kind):
+    mapping = {
+        int(user): None if identity is None else (int(identity[0]), int(identity[1]))
+        for user, identity in arm_row["committed"]["assignments"]
+    }
+    config = runner._configuration(base, mapping, kind=kind)
+    if config.configuration_id != arm_row["configuration_id"]:
+        raise RuntimeError(f"reconstructed {kind} configuration ID differs")
+    return config
+
+
+def direct_configurations(runner, tape, step_index, base, anchor_index):
+    options, _ = runner._legal_options(tape, step_index)
+    rng = random.Random(RANDOM_SEED + anchor_index)
+    random_mapping = {
+        user: None if not identities else identities[rng.randrange(len(identities))]
+        for user, identities in sorted(options.items())
+    }
+    loads = Counter()
+    round_robin_mapping = {}
+    for user, identities in sorted(options.items()):
+        if not identities:
+            round_robin_mapping[user] = None
+            continue
+        _ordinal, identity = min(
+            enumerate(identities), key=lambda item: (loads[item[1]], item[0])
+        )
+        round_robin_mapping[user] = identity
+        loads[identity] += 1
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("frozen exact panel omitted primitive arrays")
+    row_of = arrays._row_index()
+    rss_mapping = {}
+    for user, identities in sorted(options.items()):
+        if not identities:
+            rss_mapping[user] = None
+            continue
+        _ordinal, identity = min(
+            enumerate(identities),
+            key=lambda item: (
+                -float(arrays.nominal_gain[0, row_of[(user, item[1])]]), item[0]
+            ),
+        )
+        rss_mapping[user] = identity
+    return {
+        "NEAREST_ELIGIBLE": base,
+        "RANDOM": runner._configuration(base, random_mapping, kind="basin2-random"),
+        "ROUND_ROBIN": runner._configuration(base, round_robin_mapping, kind="basin2-round-robin"),
+        "RSS_MAX": runner._configuration(base, rss_mapping, kind="basin2-rss-max"),
+    }
+
+
+def changed_users(left, right) -> tuple[int, ...]:
+    return tuple(
+        user for user in sorted(left.mapping)
+        if left.mapping[user] != right.mapping[user]
+    )
+
+
+def with_target_users(runner, base, target, users, kind):
+    mapping = dict(base.mapping)
+    for user in users:
+        mapping[user] = target.mapping[user]
+    return runner._configuration(base, mapping, kind=kind)
+
+
+def barrier_analysis(panel, runner, calibration, tape, step_index, base, rss,
+                     incumbent, run_setting):
+    """Exhaust k-subsets toward RSS until the first improving cardinality."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    users = changed_users(base, rss)
+    prefixes = [base]
+    for k in range(1, len(users) + 1):
+        prefixes.append(with_target_users(
+            runner, base, rss, users[:k], f"basin2-prefix-{k}"
+        ))
+    singles = [with_target_users(
+        runner, base, rss, (user,), f"basin2-single-{user}"
+    ) for user in users]
+    # Mandatory invariant: BASE is in this first call together with candidates.
+    first_call = dedupe((base, rss, *prefixes[1:], *singles))
+    assert first_call[0].configuration_id == base.configuration_id
+    assert len(first_call) > 1
+    evaluator.evaluate_many(first_call)
+    base_profile = profile(evaluator, base)
+    base_f = runner._objective(base_profile, calibration)
+    guard = panel.served(base_profile)
+
+    trajectory = []
+    prefix_first = None
+    for k, row in enumerate(prefixes):
+        row_profile = profile(evaluator, row)
+        value = runner._objective(row_profile, calibration)
+        item = {
+            "k": k,
+            "changed_user": None if k == 0 else users[k - 1],
+            "configuration_id": row.configuration_id,
+            "f": fraction_payload(value),
+            "delta_f": fraction_payload(value - base_f),
+            "served": panel.served(row_profile),
+            "guarded": panel.served(row_profile) >= guard,
+            "strict_improvement": panel.served(row_profile) >= guard and value > base_f,
+        }
+        if item["strict_improvement"] and prefix_first is None:
+            prefix_first = k
+        trajectory.append(item)
+
+    singleton_rows = []
+    for user, row in zip(users, singles, strict=True):
+        row_profile = profile(evaluator, row)
+        value = runner._objective(row_profile, calibration)
+        singleton_rows.append({
+            "user": user,
+            "configuration_id": row.configuration_id,
+            "f": fraction_payload(value),
+            "delta_f": fraction_payload(value - base_f),
+            "served": panel.served(row_profile),
+            "guarded": panel.served(row_profile) >= guard,
+            "strict_improvement": panel.served(row_profile) >= guard and value > base_f,
+        })
+
+    tested_by_k = {"1": len(single_rows := singles)}
+    improving_singles = [row for row in singleton_rows if row["strict_improvement"]]
+    minimum_k = 1 if improving_singles else None
+    witness = None
+    if improving_singles:
+        witness = min(
+            improving_singles,
+            key=lambda item: (-Fraction(item["f"]["numerator"], item["f"]["denominator"]),
+                              item["configuration_id"]),
+        )
+
+    # The ascending prefix gives a finite upper bound.  Exhaust every lower
+    # cardinality, in lexicographic user-combination order, until an exact
+    # guarded improvement is found.
+    upper = prefix_first if prefix_first is not None else len(users)
+    for k in range(2, upper + 1):
+        if minimum_k is not None:
+            break
+        tested = 0
+        combinations = itertools.combinations(users, k)
+        while True:
+            chunk = list(itertools.islice(combinations, BATCH))
+            if not chunk:
+                break
+            rows = [with_target_users(
+                runner, base, rss, members, f"basin2-k{k}"
+            ) for members in chunk]
+            evaluator.evaluate_many(rows)
+            tested += len(rows)
+            found = None
+            for members, row in zip(chunk, rows, strict=True):
+                row_profile = profile(evaluator, row)
+                value = runner._objective(row_profile, calibration)
+                if panel.served(row_profile) >= guard and value > base_f:
+                    found = {
+                        "users": list(members),
+                        "configuration_id": row.configuration_id,
+                        "f": fraction_payload(value),
+                        "delta_f": fraction_payload(value - base_f),
+                        "served": panel.served(row_profile),
+                    }
+                    break
+            keep = {base.configuration_id, rss.configuration_id, *(
+                row.configuration_id for row in prefixes
+            ), *(row.configuration_id for row in singles)}
+            for row in rows:
+                if row.configuration_id not in keep:
+                    evaluator._evaluated.pop(row.configuration_id, None)
+            if found is not None:
+                minimum_k = k
+                witness = found
+                break
+        tested_by_k[str(k)] = tested
+
+    result = {
+        "selection_path": "fresh realised dense StepEvaluator(boundary_indices=(0,)); first evaluate_many contains BASE, RSS_MAX, prefixes, and all target-direction singletons",
+        "distance": len(users),
+        "differing_users_ascending": list(users),
+        "guard": guard,
+        "base_f": fraction_payload(base_f),
+        "trajectory": trajectory,
+        "prefix_first_improvement_k": prefix_first,
+        "singletons": singleton_rows,
+        "improving_singleton_count": len(improving_singles),
+        "minimum_simultaneous_change_k": minimum_k,
+        "witness": witness,
+        "subsets_tested_by_k": tested_by_k,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return result
+
+
+def rank_f_analysis(panel, runner, calibration, tape, step_index, base, incumbent,
+                    run_setting, configs):
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    rows = dedupe(configs[name] for name in ARM_NAMES)
+    assert any(row.configuration_id == base.configuration_id for row in rows)
+    evaluator.evaluate_many(rows)
+    values = {name: f_value(runner, calibration, evaluator, configs[name]) for name in ARM_NAMES}
+    order = sorted(ARM_NAMES, key=lambda name: (-values[name], name))
+    result = {
+        "selection_path": "fresh realised dense StepEvaluator(boundary_indices=(0,)); one evaluate_many contains all six arms including BASE",
+        "f_by_arm": {name: fraction_payload(values[name]) for name in ARM_NAMES},
+        "order": order,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return result
+
+
+def first_improvement(panel, runner, calibration, tape, step_index, base, start,
+                      incumbent, run_setting, kind):
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "realised", (0,)
+    )
+    options, census = runner._legal_options(tape, step_index)
+    first_user = min(options)
+    warm = tuple(panel.candidate(
+        runner, base, start, first_user, identity, kind
+    ) for identity in options[first_user] if identity != start.mapping[first_user])
+    first_call = dedupe((base, start, *warm[:panel.UNILATERAL_BATCH_SIZE]))
+    assert first_call[0].configuration_id == base.configuration_id
+    assert len(first_call) > 1
+    evaluator.evaluate_many(first_call)
+    guard = panel.served(profile(evaluator, start))
+    current = start
+    moves = comparisons = submissions = 0
+    passes = 0
+    moves_per_pass = []
+    while True:
+        moved = 0
+        for user in sorted(options):
+            current_value = f_value(runner, calibration, evaluator, current)
+            candidates = tuple(panel.candidate(
+                runner, base, current, user, identity, kind
+            ) for identity in options[user] if identity != current.mapping[user])
+            accepted = None
+            for offset in range(0, len(candidates), panel.UNILATERAL_BATCH_SIZE):
+                batch = candidates[offset:offset + panel.UNILATERAL_BATCH_SIZE]
+                evaluator.evaluate_many(batch)
+                submissions += len(batch)
+                for row in batch:
+                    comparisons += 1
+                    row_profile = evaluator._evaluated.get(row.configuration_id)
+                    if row_profile is None or panel.served(row_profile) < guard:
+                        continue
+                    if runner._objective(row_profile, calibration) > current_value:
+                        accepted = row
+                        break
+                if accepted is not None:
+                    break
+            if accepted is not None:
+                current = accepted
+                moves += 1
+                moved += 1
+        passes += 1
+        moves_per_pass.append(moved)
+        if moved == 0:
+            break
+        if passes > 100:
+            raise RuntimeError("first-improvement exceeded 100 passes")
+    result = {
+        "selection_path": "fresh realised dense StepEvaluator(boundary_indices=(0,)); first evaluate_many contains BASE, start, and ordered first-user candidates",
+        "start_configuration_id": start.configuration_id,
+        "selected_configuration_id": current.configuration_id,
+        "guard_from_start": guard,
+        "fixed_point_at_start": moves_per_pass[0] == 0,
+        "moves": moves,
+        "passes_including_certificate": passes,
+        "moves_per_pass": moves_per_pass,
+        "comparisons": comparisons,
+        "submitted_candidate_slots": submissions,
+        "legal_option_census": census,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return current, result
+
+
+def myopic_greedy(panel, runner, calibration, tape, step_index, base, incumbent,
+                  run_setting):
+    """One ascending-user exact best-response sweep on nominal boundary zero."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "nominal", (0,)
+    )
+    options, census = runner._legal_options(tape, step_index)
+    first_user = min(options)
+    warm = tuple(panel.candidate(
+        runner, base, base, first_user, identity, "basin2-myopic"
+    ) for identity in options[first_user] if identity != base.mapping[first_user])
+    first_call = dedupe((base, *warm[:panel.UNILATERAL_BATCH_SIZE]))
+    assert first_call[0].configuration_id == base.configuration_id
+    assert len(first_call) > 1
+    evaluator.evaluate_many(first_call)
+    guard = panel.served(profile(evaluator, base))
+    current = base
+    moves = comparisons = submissions = 0
+    for user in sorted(options):
+        candidates = tuple(panel.candidate(
+            runner, base, current, user, identity, "basin2-myopic"
+        ) for identity in options[user] if identity != current.mapping[user])
+        for offset in range(0, len(candidates), panel.UNILATERAL_BATCH_SIZE):
+            batch = candidates[offset:offset + panel.UNILATERAL_BATCH_SIZE]
+            evaluator.evaluate_many(batch)
+            submissions += len(batch)
+        eligible = [(f_value(runner, calibration, evaluator, current), current.configuration_id, current)]
+        for row in candidates:
+            comparisons += 1
+            row_profile = evaluator._evaluated.get(row.configuration_id)
+            if row_profile is None or panel.served(row_profile) < guard:
+                continue
+            eligible.append((runner._objective(row_profile, calibration), row.configuration_id, row))
+        selected = min(eligible, key=lambda item: (-item[0], item[1]))[2]
+        if selected.mapping[user] != current.mapping[user]:
+            moves += 1
+        current = selected
+    result = {
+        "selection_path": "fresh nominal dense StepEvaluator(boundary_indices=(0,)); first evaluate_many contains BASE and ordered first-user candidates",
+        "selected_configuration_id": current.configuration_id,
+        "guard_from_base": guard,
+        "moves": moves,
+        "passes": 1,
+        "comparisons": comparisons,
+        "submitted_candidate_slots": submissions,
+        "legal_option_census": census,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return current, result
+
+
+def bounded_catalogue(panel, runner, calibration, tape, step_index, base, reference,
+                      incumbent, run_setting, tag):
+    """Rebuild deployed bounded-union-v2 around reference, dense-only."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, "nominal", (0,)
+    )
+    users = tuple(sorted(reference.mapping))
+    all_options, raw_census = runner._legal_options(tape, step_index)
+    options, census = runner._selection_shortlist(
+        tape, step_index, run_setting=run_setting
+    )
+    product_size = math.prod(len(all_options[u]) if all_options[u] else 1 for u in users)
+    if product_size <= runner.COMPLETE_CATALOGUE_LIMIT:
+        raise RuntimeError("unexpected complete-cartesian catalogue on frozen panel")
+    ref_map = reference.mapping
+    unilaterals = {user: [] for user in users}
+    singles_by_move = {}
+    for user in users:
+        for identity in options[user]:
+            if identity == ref_map[user]:
+                continue
+            mapping = dict(ref_map)
+            mapping[user] = identity
+            row = runner._configuration(reference, mapping, kind=f"{tag}-unilateral")
+            unilaterals[user].append(row)
+            singles_by_move[(user, identity)] = row
+    all_singles = [row for values in unilaterals.values() for row in values]
+    first_call = dedupe((base, reference, *all_singles))
+    assert first_call[0].configuration_id == base.configuration_id
+    assert len(first_call) > 1
+    evaluator.evaluate_many(first_call)
+    reference_profile = profile(evaluator, reference)
+    reference_f = runner._objective(reference_profile, calibration)
+    guard = panel.served(reference_profile)
+    best_surplus = {}
+    for user in users:
+        values = []
+        for row in unilaterals[user]:
+            core = f_value(runner, calibration, evaluator, row) - reference_f
+            core += calibration.kappa_bits_per_user_step * runner._phi_for(reference, row)
+            values.append(core)
+        best_surplus[user] = max(values, default=Fraction(-10**30))
+    ranked_users = sorted(users, key=lambda user: (-best_surplus[user], user))[
+        :runner.PAIRWISE_TOP_K_USERS
+    ]
+
+    candidates = [reference, *all_singles]
+    for proposal_rank in range(runner.TOP_PROPOSALS):
+        mapping = dict(ref_map)
+        for user in users:
+            if len(unilaterals[user]) > proposal_rank:
+                mapping[user] = unilaterals[user][proposal_rank].mapping[user]
+        if mapping != ref_map:
+            candidates.append(runner._configuration(
+                reference, mapping, kind=f"{tag}-s0-top-two"
+            ))
+    for first, second in itertools.combinations(ranked_users, 2):
+        for first_row in unilaterals[first][:runner.TOP_PROPOSALS]:
+            for second_row in unilaterals[second][:runner.TOP_PROPOSALS]:
+                mapping = dict(ref_map)
+                mapping[first] = first_row.mapping[first]
+                mapping[second] = second_row.mapping[second]
+                candidates.append(runner._configuration(
+                    reference, mapping, kind=f"{tag}-pairwise-top10-top2"
+                ))
+    for beam in sorted({identity for identity in ref_map.values() if identity is not None}):
+        mapping = dict(ref_map)
+        affected = [user for user in users if ref_map[user] == beam]
+        for user in affected:
+            mapping[user] = next((identity for identity in options[user] if identity != beam), None)
+        if mapping != ref_map:
+            candidates.append(runner._configuration(
+                reference, mapping, kind=f"{tag}-beam-evacuation"
+            ))
+    catalogue = tuple({row.assignments: row for row in candidates}.values())
+    catalogue = (reference,) + tuple(sorted(
+        (row for row in catalogue if row.assignments != reference.assignments),
+        key=lambda row: row.configuration_id,
+    ))
+    if len(catalogue) > runner.CATALOGUE_CAP:
+        raise RuntimeError("bounded catalogue exceeds sealed cap")
+
+    # Beam evacuation may introduce explicit nulls absent from the shortlist.
+    # Materialise every required singleton before any set decomposition.
+    for row in catalogue:
+        for user in changed_users(reference, row):
+            identity = row.mapping[user]
+            key = (user, identity)
+            if key not in singles_by_move:
+                mapping = dict(ref_map)
+                mapping[user] = identity
+                singles_by_move[key] = runner._configuration(
+                    reference, mapping, kind=f"{tag}-required-singleton"
+                )
+    missing_singles = [
+        row for row in singles_by_move.values()
+        if row.configuration_id not in evaluator._evaluated
+    ]
+    for offset in range(0, len(missing_singles), BATCH):
+        evaluator.evaluate_many(missing_singles[offset:offset + BATCH])
+    for offset in range(0, len(catalogue), BATCH):
+        evaluator.evaluate_many(catalogue[offset:offset + BATCH])
+
+    from mcrl.physics_v025.targets import set_score_decomposition
+    scored = []
+    sign_counts = Counter()
+    for row in catalogue:
+        row_profile = evaluator._evaluated.get(row.configuration_id)
+        if row_profile is None:
+            continue
+        changed = changed_users(reference, row)
+        joint_delta = runner._objective(row_profile, calibration) - reference_f
+        singleton_delta = Fraction()
+        interaction = Fraction()
+        if changed:
+            outcomes = {frozenset(): reference_profile.outcome(), frozenset(changed): row_profile.outcome()}
+            valid = True
+            for user in changed:
+                single = singles_by_move[(user, row.mapping[user])]
+                single_profile = evaluator._evaluated.get(single.configuration_id)
+                if single_profile is None:
+                    valid = False
+                    break
+                outcomes[frozenset((user,))] = single_profile.outcome()
+            if not valid:
+                continue
+            decomposition = set_score_decomposition(
+                coalition_users=changed,
+                outcomes_by_subset=outcomes,
+                lambda_bits_per_j=calibration.lambda_bits_per_j,
+                eta_ref=calibration.eta_ref,
+                kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
+            )
+            singleton_delta = sum((value for _user, value in decomposition.d_by_user), Fraction())
+            interaction = decomposition.interaction_bits
+            assert joint_delta == decomposition.joint_change_bits
+            assert joint_delta == singleton_delta + interaction
+            if len(changed) >= 2:
+                sign_counts["positive" if interaction > 0 else "negative" if interaction < 0 else "zero"] += 1
+        scored.append({
+            "config": row,
+            "configuration_id": row.configuration_id,
+            "changed_users": list(changed),
+            "coalition_size": len(changed),
+            "served": panel.served(row_profile),
+            "guarded": panel.served(row_profile) >= guard,
+            "joint_delta": joint_delta,
+            "additive_delta": singleton_delta,
+            "interaction": interaction,
+        })
+    guarded = [row for row in scored if row["guarded"]]
+    exact_selected = min(guarded, key=lambda row: (-row["joint_delta"], row["configuration_id"]))
+    additive_selected = min(guarded, key=lambda row: (-row["additive_delta"], row["configuration_id"]))
+    improving = [row for row in guarded if row["joint_delta"] > 0]
+    interaction_rows = [row for row in scored if row["coalition_size"] >= 2]
+    result = {
+        "selection_path": "fresh nominal dense StepEvaluator(boundary_indices=(0,)); first evaluate_many contains BASE, reference, and every shortlisted singleton",
+        "reference_configuration_id": reference.configuration_id,
+        "reference_is_base": reference.configuration_id == base.configuration_id,
+        "guard_from_reference": guard,
+        "catalogue_mode": "bounded-union-v2",
+        "product_size": product_size,
+        "catalogue_count": len(catalogue),
+        "census": census,
+        "raw_census": raw_census,
+        "ranked_users": ranked_users,
+        "strict_improvement_count": len(improving),
+        "contains_strict_improvement": bool(improving),
+        "best_strict_improvement": None if not improving else {
+            "configuration_id": min(improving, key=lambda row: (-row["joint_delta"], row["configuration_id"]))["configuration_id"],
+            "delta_f": fraction_payload(max(row["joint_delta"] for row in improving)),
+        },
+        "interaction_sign_counts": dict(sign_counts),
+        "interaction_min": None if not interaction_rows else fraction_payload(min(row["interaction"] for row in interaction_rows)),
+        "interaction_max": None if not interaction_rows else fraction_payload(max(row["interaction"] for row in interaction_rows)),
+        "exact_selected": {
+            "configuration_id": exact_selected["configuration_id"],
+            "coalition_size": exact_selected["coalition_size"],
+            "joint_delta": fraction_payload(exact_selected["joint_delta"]),
+            "additive_delta": fraction_payload(exact_selected["additive_delta"]),
+            "interaction": fraction_payload(exact_selected["interaction"]),
+        },
+        "additive_selected": {
+            "configuration_id": additive_selected["configuration_id"],
+            "coalition_size": additive_selected["coalition_size"],
+            "joint_delta": fraction_payload(additive_selected["joint_delta"]),
+            "additive_delta": fraction_payload(additive_selected["additive_delta"]),
+            "interaction": fraction_payload(additive_selected["interaction"]),
+        },
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    selected_configs = {
+        f"{tag}_EXACT": exact_selected["config"],
+        f"{tag}_ADDITIVE": additive_selected["config"],
+    }
+    del evaluator
+    gc.collect()
+    return result, selected_configs
+
+
+def diversity(config):
+    chosen = [identity for identity in config.mapping.values() if identity is not None]
+    counts = Counter(chosen)
+    return {
+        "modal_frac": 0.0 if not counts else max(counts.values()) / len(config.mapping),
+        "active_beams": len(counts),
+        "active_satellites": len({identity[0] for identity in counts}),
+    }
+
+
+def endpoint_metrics(panel, runner, calibration, tape, step_index, base, incumbent, run_setting, configs):
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting,
+        "realised", tuple(range(48)),
+    )
+    rows = dedupe(configs.values())
+    assert any(row.configuration_id == base.configuration_id for row in rows)
+    evaluator.evaluate_many(rows)
+    metrics = {}
+    for name, config in configs.items():
+        row = panel.metric(profile(evaluator, config))
+        row["f_at_eta_ref"] = fraction_payload(runner._objective(profile(evaluator, config), calibration))
+        row["diversity"] = diversity(config)
+        metrics[name] = row
+    result = {
+        "path": "one separate fresh realised dense StepEvaluator(boundary_indices=tuple(range(48))); one evaluate_many contains every compared profile including BASE",
+        "metrics": metrics,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return result
+
+
+def pool_metric(anchors, tag):
+    rows = [anchor["endpoint"]["metrics"][tag] for anchor in anchors]
+    bits = math.fsum(float(row["bits"]) for row in rows)
+    joules = math.fsum(float(row["joules"]) for row in rows)
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_mbit_per_j": bits / joules / 1e6,
+        "served_count": sum(int(row["served_count"]) for row in rows),
+        "rate_target_attained_count": sum(int(row["rate_target_attained_count"]) for row in rows),
+        "user_count": sum(int(row["user_count"]) for row in rows),
+        "modal_frac_mean": math.fsum(float(row["diversity"]["modal_frac"]) for row in rows) / len(rows),
+        "active_beams_mean": math.fsum(float(row["diversity"]["active_beams"]) for row in rows) / len(rows),
+        "active_satellites_mean": math.fsum(float(row["diversity"]["active_satellites"]) for row in rows) / len(rows),
+    }
+
+
+def main() -> int:
+    check_runtime()
+    started = time.perf_counter()
+    panel = load_panel()
+    frozen = panel.frozen_panel()
+    clean = json.loads(CLEAN_RECEIPT.read_text(encoding="utf-8"))
