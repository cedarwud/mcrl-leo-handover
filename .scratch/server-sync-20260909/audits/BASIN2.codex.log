+            > Fraction(row["exact_f_rank"]["f_by_arm"]["FIRST_IMPROVEMENT_FP"]["numerator"], row["exact_f_rank"]["f_by_arm"]["FIRST_IMPROVEMENT_FP"]["denominator"])
+            for row in payload["anchors"]
