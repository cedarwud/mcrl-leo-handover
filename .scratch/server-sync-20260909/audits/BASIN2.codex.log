#!/usr/bin/env python3
"""PROBE_NOT_CLAIM -- interaction-existence probe re-anchored at the iterated
exact unilateral optimum ``u``.

The one question: in which pre-declared regime, if any, does a *positive*
interaction term exist at all?

Around the carrier anchor ``a0`` the interaction residual is necessarily mostly
negative (users collide on the same good beams).  Re-anchored at a certified
iterated unilateral optimum ``u`` every legal single-user move is non-improving
under the coordinator objective, so any strictly improving *joint* move from
``u`` must carry Psi_A^u > 0.  Existence of such moves is the cleanest test of
whether a coordination layer can have any value in this physics.

This script reuses the stage-4d engine snapshot runner verbatim (evaluator,
guards, objective, catalogue kinds, set-score decomposition).  It computes no
learned quantity and writes no formal namespace.

Every artefact is labelled PROBE_NOT_CLAIM.
"""

from __future__ import annotations

import argparse
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import os
from pathlib import Path
import pickle
import sys
import time

LABEL = "PROBE_NOT_CLAIM"
HERE = Path(__file__).resolve().parent
REPO = HERE.parents[2]
RUNNER = HERE / "run_v025_matrix_probe.py"
if str(REPO / "src") not in sys.path:
    sys.path.insert(0, str(REPO / "src"))

_spec = importlib.util.spec_from_file_location("v025_matrix_probe_runner", RUNNER)
R = importlib.util.module_from_spec(_spec)
assert _spec.loader is not None
# ``dataclasses`` resolves ``cls.__module__`` through ``sys.modules``; register
# the module before executing it or every frozen dataclass in the runner fails.
sys.modules["v025_matrix_probe_runner"] = R
_spec.loader.exec_module(R)

from mcrl.errors import MCRLContractError  # noqa: E402
from mcrl.physics_v025.acm import ACM_MODES  # noqa: E402
from mcrl.physics_v025.calibration import (  # noqa: E402
    CalibrationValues,
    nominal_greedy_reference,
)
from mcrl.physics_v025.constants_v025 import DECISION_INTERVAL_S  # noqa: E402
from mcrl.physics_v025.matrix import run_setting_for  # noqa: E402
from mcrl.physics_v025.tapes import (  # noqa: E402
    CALIBRATION_WORLD_DOMAINS,
    DEVELOPMENT_WORLD_DOMAINS,
)
from mcrl.physics_v025.targets import set_score_decomposition  # noqa: E402


# Pre-declared regimes under test.  The value is the sealed run-setting id
# consumed by ``run_setting_for``; R6 is an alias of the a-gamma0 matrix cell.
REGIME_RUN_ID = {
    "a-r0": "a-r0",
    "R3": "R3",
    "R4": "R4",
    "R1": "R1",
    "R7": "R7",
    "R6": "a-γ0",
}
CARRIER = "nearest-eligible"
BATCH = 256


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------
def _f(value) -> float:
    return float(value)


def evaluate_batch(evaluator, configs):
    """``evaluate_many`` that fails closed per row on the non-batch path.

    The a-r TDM batch kernel marks an invalid power certificate in
    ``_invalid``; the generic per-configuration path raises instead, which would
    abort a whole anchor.  This wrapper gives both paths the same semantics.
    """

    step = evaluator.tape.steps[evaluator.step_index]
    if step.arrays is not None and evaluator.setting.label == "a-r0":
        evaluator.evaluate_many(configs)
        return
    for config in configs:
        if config.configuration_id in evaluator._evaluated:
            continue
        if config.configuration_id in evaluator._invalid:
            continue
        try:
            evaluator.evaluate(config)
        except (MCRLContractError, R.ProbeError):
            evaluator._invalid.add(config.configuration_id)


def _cfg(anchor, mapping, kind):
    """Content-addressed configuration; ``changed_users`` is not relied upon."""

    return R._configuration(anchor, mapping, kind=kind)


def _changed(anchor, config) -> tuple[int, ...]:
    anchor_map = anchor.mapping
    return tuple(
        user for user, identity in config.assignments if anchor_map[user] != identity
    )


def _quantiles(values):
    if not values:
        return {"n": 0, "min": None, "median": None, "max": None, "mean": None}
    ordered = sorted(values)
    n = len(ordered)
    mid = n // 2
    median = ordered[mid] if n % 2 else 0.5 * (ordered[mid - 1] + ordered[mid])
    return {
        "n": n,
        "min": ordered[0],
        "median": median,
        "max": ordered[-1],
        "mean": math.fsum(ordered) / n,
    }


# --------------------------------------------------------------------------
# approximate per-regime calibration on the two sealed V025_CAL_R2 worlds
# --------------------------------------------------------------------------
def probe_option_set(tape, step_index, *, run_setting, mode, cap):
    """Legal per-user option set used by the unilateral search.

    ``full`` is the complete decision-instant legal set (what the sealed
    ``_s_uni_select`` searches).  ``shortlist`` is the sealed bounded-catalogue
    option set (top eight live actions by nominal single-link margin), further
    truncated to ``cap`` entries.  The restricted mode exists only for the
    non-batch a-gamma architecture, whose per-configuration cost is ~50x the
    a-r TDM batch kernel.
    """

    if mode == "full":
        options, census = R._legal_options(tape, step_index)
        return options, census, {"option_set": "FULL_LEGAL", "option_cap": None}
    options, census = R._selection_shortlist(tape, step_index, run_setting=run_setting)
    truncated = {user: rows[:cap] for user, rows in options.items()}
    return (
        truncated,
        census,
        {"option_set": "SEALED_MARGIN_SHORTLIST_TRUNCATED", "option_cap": cap},
    )


def probe_calibration(
    setting,
    run_setting,
    tapes,
    *,
    steps_per_world,
    reference="nominal-greedy",
    log=print,
):
    """Reduced-step reconstruction of ``_calibrate`` (declared approximation).

    ``reference='nominal-greedy'`` keeps the sealed reference policy (greedy
    over the bounded catalogue) and the sealed realised 48-boundary committed
    evaluation, but takes the *selection* view at the coordinator's k=0 nominal
    boundary rather than the full 48-boundary nominal view, and uses only a
    joules = sum((row.joules for row in observations), Fraction())
    time_s = sum((row.time_s for row in observations), Fraction())
    users = observations[0].users
    decision_steps = sum(row.decision_steps for row in observations)
    eta_ref, kappa = _prices(
        bits, joules, users=users, decision_steps=decision_steps, time_s=time_s
    )
    return CalibrationValues(
        setting.label,
        setting.digest,
        eta_ref,
        eta_ref,
        kappa,
        bits,
        joules,
        users,
        decision_steps,
        time_s,
        tuple(row.world_domain for row in observations),
        tuple(row.selected_configuration_id for row in observations),
    )


# --------------------------------------------------------------------------
# iterated exact unilateral optimum
# --------------------------------------------------------------------------
def iterated_unilateral_optimum(
    *,
    base,
    incumbent,
    options,
    evaluator,
    calibration,
    cell_rekeys,
    budget_s,
    max_iterations,
    search_mode="gauss-seidel",
):
    """Same evaluator, guard and objective as the coordinator's S_UNI arm.

    Unlike the sealed ``_s_uni_select`` this returns the best profile reached so
    far when the budget expires (rather than falling back to BASE) and reports
    the termination certificate explicitly.

    ``search_mode='jacobi'`` is the original best-single-move iteration: every
    sweep re-scores the whole legal single-user neighbourhood and commits the one
    best move, so it needs one full sweep per committed move.
    ``search_mode='gauss-seidel'`` is round-robin best response: each user in turn
    is moved to its own best legal guarded option against the *current* profile,
    committing immediately.  Both terminate on the same certificate -- a complete
    pass over every user and every legal option in which no single-user deviation
    strictly improves the coordinator objective -- and both use the identical
    evaluator, service guard and objective.  Gauss-Seidel reaches that certificate
    in a handful of passes instead of one pass per committed move.
    """

    started = time.perf_counter()
    kappa = calibration.kappa_bits_per_user_step

    def objective(config, profile):
        return R._objective(profile, calibration) + kappa * R._phi_for(
            incumbent, config, cell_rekeyed_users=cell_rekeys
        )

    base_profile = evaluator.evaluate(base)
    base_served = sum(base_profile.score.served_phy.values())
    current = base
    iterations = 0
    sweeps = 0

    if search_mode == "gauss-seidel":
        while True:
            committed_this_pass = 0
            for user in sorted(options):
                candidates = []
                for identity in options[user]:
                    if identity == current.mapping[user]:
                        continue
                    mapping = current.mapping
                    mapping[user] = identity
                    candidates.append(_cfg(base, mapping, "probe-uni-iterate"))
                if not candidates:
                    continue
                evaluate_batch(evaluator, candidates)
                best = current
                best_value = objective(current, evaluator.evaluate(current))
                for candidate in candidates:
                    if candidate.configuration_id in evaluator._invalid:
                        continue
                    profile = evaluator.evaluate(candidate)
                    if sum(profile.score.served_phy.values()) < base_served:
                        continue
                    value = objective(candidate, profile)
                    if value > best_value or (
                        value == best_value
                        and candidate.configuration_id < best.configuration_id
                    ):
                        best, best_value = candidate, value
                if best.assignments != current.assignments:
                    current = best
                    iterations += 1
                    committed_this_pass += 1
                    if iterations >= max_iterations:
                        return (
                            current,
                            iterations,
                            "BUDGET_LIMITED_MAX_ITERATIONS",
                            sweeps,
                            time.perf_counter() - started,
                        )
                if time.perf_counter() - started > budget_s:
                    return (
                        current,
                        iterations,
                        "BUDGET_LIMITED_MID_SWEEP",
                        sweeps,
                        time.perf_counter() - started,
                    )
            sweeps += 1
            if committed_this_pass == 0:
                return (
                    current,
                    iterations,
                    "CERTIFIED_NO_IMPROVING_LEGAL_UNILATERAL",
                    sweeps,
                    time.perf_counter() - started,
                )
            if time.perf_counter() - started > budget_s:
                return (
                    current,
                    iterations,
                    "BUDGET_LIMITED_AFTER_SWEEP",
                    sweeps,
                    time.perf_counter() - started,
                )

    while True:
        candidates = []
        for user in sorted(options):
            for identity in options[user]:
                if identity == current.mapping[user]:
                    continue
                mapping = current.mapping
                mapping[user] = identity
                candidates.append(_cfg(base, mapping, "probe-uni-iterate"))
        for offset in range(0, len(candidates), BATCH):
            evaluate_batch(evaluator, candidates[offset : offset + BATCH])
            if time.perf_counter() - started > budget_s:
                return current, iterations, "BUDGET_LIMITED_MID_SWEEP", sweeps, time.perf_counter() - started
        sweeps += 1
        best = current
        best_value = objective(current, evaluator.evaluate(current))
        for candidate in candidates:
            if candidate.configuration_id in evaluator._invalid:
                continue
            profile = evaluator.evaluate(candidate)
            if sum(profile.score.served_phy.values()) < base_served:
                continue
            value = objective(candidate, profile)
            if value > best_value or (
                value == best_value and candidate.configuration_id < best.configuration_id
            ):
                best, best_value = candidate, value
        if best.assignments == current.assignments:
            return (
                current,
                iterations,
                "CERTIFIED_NO_IMPROVING_LEGAL_UNILATERAL",
                sweeps,
                time.perf_counter() - started,
            )
        current = best
        iterations += 1
        if iterations >= max_iterations:
            return current, iterations, "BUDGET_LIMITED_MAX_ITERATIONS", sweeps, time.perf_counter() - started
        if time.perf_counter() - started > budget_s:
            return current, iterations, "BUDGET_LIMITED_AFTER_SWEEP", sweeps, time.perf_counter() - started


# --------------------------------------------------------------------------
# bounded joint neighbourhood around one anchor
# --------------------------------------------------------------------------
def analyse_anchor_from(
    *,
    anchor,
    base,
    incumbent,
    options,
    evaluator,
    calibration,
    cell_rekeys,
    users,
    base_served,
    anchor_tag,
):
    """Enumerate the bounded joint neighbourhood around ``anchor`` and score it.

    Returns per-anchor statistics for this anchor point.  ``base`` remains the
    carrier reference used for the service guard and for Phi bookkeeping.
    """

    kappa = calibration.kappa_bits_per_user_step
    anchor_map = anchor.mapping

    def objective(config, profile):
        return R._objective(profile, calibration) + kappa * R._phi_for(
            incumbent, config, cell_rekeyed_users=cell_rekeys
        )

    # ---- single-user moves from the anchor: d_i and the per-user ranking ----
    singles: dict[int, list] = {user: [] for user in users}
    single_rows = []
    for user in users:
        for identity in options[user]:
            if identity == anchor_map[user]:
                continue
            mapping = dict(anchor_map)
            mapping[user] = identity
            row = _cfg(anchor, mapping, "probe-single")
            singles[user].append(row)
            single_rows.append(row)
    for offset in range(0, len(single_rows), BATCH):
        evaluate_batch(evaluator, single_rows[offset : offset + BATCH])

    anchor_profile = evaluator.evaluate(anchor)
    anchor_outcome = anchor_profile.outcome()
    anchor_f = R._objective(anchor_profile, calibration)
    anchor_g = objective(anchor, anchor_profile)

    # per-user: best legal single move by the coordinator objective (guarded)
    ranked_options: dict[int, list] = {}
    d_best: dict[int, Fraction] = {}
    for user in users:
        scored = []
        for row in singles[user]:
            if row.configuration_id in evaluator._invalid:
                continue
            profile = evaluator.evaluate(row)
            if sum(profile.score.served_phy.values()) < base_served:
                continue
            scored.append((objective(row, profile), row))
        scored.sort(key=lambda item: (-item[0], item[1].configuration_id))
        ranked_options[user] = [row for _value, row in scored]
        if scored:
            best_row = scored[0][1]
            d_best[user] = (
                R._objective(evaluator.evaluate(best_row), calibration) - anchor_f
            )
    top_users = sorted(
        d_best, key=lambda user: (-abs(d_best[user]), user)
    )[: R.PAIRWISE_TOP_K_USERS]

    # ---- bounded joint neighbourhood ----
    candidates: dict[str, tuple] = {}

    def add(mapping, kind):
        if mapping == anchor_map:
            return
        row = _cfg(anchor, mapping, kind)
        candidates.setdefault(row.configuration_id, (row, kind))

    # (i) pairwise moves among the top-K users by |d_i|, top-two options each
    for first, second in itertools.combinations(sorted(top_users), 2):
        for first_row in ranked_options[first][: R.TOP_PROPOSALS]:
            for second_row in ranked_options[second][: R.TOP_PROPOSALS]:
                mapping = dict(anchor_map)
                mapping[first] = first_row.mapping[first]
                mapping[second] = second_row.mapping[second]
                add(mapping, "pairwise-topK-top2")

    # (ii) one evacuation set per active beam of the anchor
    active_beams = sorted({v for v in anchor_map.values() if v is not None})
    evacuable_entirely = 0
    for beam in active_beams:
        affected = [user for user in users if anchor_map[user] == beam]
        mapping = dict(anchor_map)
        complete = True
        for user in affected:
            alternative = next(
                (identity for identity in options[user] if identity != beam), None
            )
            mapping[user] = alternative
            if alternative is None:
                complete = False
        if complete:
            evacuable_entirely += 1
        add(mapping, "beam-evacuation")

    # (iii) the S0 proposals: complete profiles assembled from each user's
    #       rank-r single-user proposal identity
    for proposal_rank in range(R.TOP_PROPOSALS):
        mapping = dict(anchor_map)
        for user in users:
            rows = ranked_options[user]
            if len(rows) > proposal_rank:
                mapping[user] = rows[proposal_rank].mapping[user]
        add(mapping, "s0-top-two")

    rows = [row for row, _kind in candidates.values()]
    for offset in range(0, len(rows), BATCH):
        evaluate_batch(evaluator, rows[offset : offset + BATCH])

    # ---- score every joint candidate ----
    scored_candidates = []
    invalid_candidates = 0
    guard_rejected = 0
    missing_singleton = 0
    for row, kind in candidates.values():
        if row.configuration_id in evaluator._invalid:
            invalid_candidates += 1
            continue
        changed = _changed(anchor, row)
        if len(changed) < 2:
            continue
        profile = evaluator.evaluate(row)
        served = sum(profile.score.served_phy.values())
        # singleton outcomes for the decomposition
        outcomes = {frozenset(): anchor_outcome}
        ok = True
        for user in changed:
            mapping = dict(anchor_map)
            mapping[user] = row.mapping[user]
            single = _cfg(anchor, mapping, "probe-single")
            if single.configuration_id in evaluator._invalid:
                ok = False
                break
            outcomes[frozenset((user,))] = evaluator.evaluate(single).outcome()
        if not ok:
            missing_singleton += 1
            continue
        outcomes[frozenset(changed)] = profile.outcome()
        decomposition = set_score_decomposition(
            coalition_users=changed,
            outcomes_by_subset=outcomes,
            lambda_bits_per_j=calibration.lambda_bits_per_j,
            eta_ref=calibration.eta_ref,
            kappa_bits_per_user_step=calibration.kappa_bits_per_user_step,
            phi_difference=(
                R._phi_for(incumbent, row, cell_rekeyed_users=cell_rekeys)
                - R._phi_for(incumbent, anchor, cell_rekeyed_users=cell_rekeys)
            ),
        )
        candidate_f = R._objective(profile, calibration)
        candidate_g = objective(row, profile)
        guarded = served >= base_served
        if not guarded:
            guard_rejected += 1
        scored_candidates.append(
            {
                "configuration_id": row.configuration_id,
                "kind": kind,
                "coalition_size": len(changed),
                "psi_bits": decomposition.interaction_bits,
                "joint_change_bits": decomposition.joint_change_bits,
                "sum_d_bits": sum(
                    (value for _user, value in decomposition.d_by_user), Fraction()
                ),
                "max_d_bits": max(
                    (value for _user, value in decomposition.d_by_user), default=Fraction()
                ),
                "f": candidate_f,
                "g": candidate_g,
                "guarded": guarded,
                "improves_g": guarded and candidate_g > anchor_g,
                "improves_f": guarded and candidate_f > anchor_f,
                "profile": profile,
                "config": row,
            }
        )

    improving = [row for row in scored_candidates if row["improves_g"]]
    improving_f = [row for row in scored_candidates if row["improves_f"]]
    guarded_rows = [row for row in scored_candidates if row["guarded"]]
    best = max(
        guarded_rows,
        key=lambda row: (row["g"], row["configuration_id"]),
        default=None,
    )
    best_improving = max(
        improving, key=lambda row: (row["g"], row["configuration_id"]), default=None
    )
    # positive-Psi census independent of improvement
    positive_psi = [row for row in scored_candidates if row["psi_bits"] > 0]

    # single-user sign audit: is every d_i <= 0 at this anchor?
    positive_d_users = sorted(user for user, value in d_best.items() if value > 0)

    return {
        "anchor_tag": anchor_tag,
        "anchor_configuration_id": anchor.configuration_id,
        "anchor_f_bits": _f(anchor_f),
        "anchor_g_bits": _f(anchor_g),
        "anchor_bits": anchor_profile.bits,
        "anchor_joules": anchor_profile.joules,
        "single_user_moves_enumerated": len(single_rows),
        "users_with_legal_guarded_single_move": len(d_best),
        "d_best_min": _f(min(d_best.values())) if d_best else None,
        "d_best_max": _f(max(d_best.values())) if d_best else None,
        "positive_d_user_count": len(positive_d_users),
        "top_users_by_abs_d": top_users,
        "active_beams": len(active_beams),
