+    }
+    payload["exact_f_totals"] = {arm: fraction_payload(value) for arm, value in f_totals.items()}
+    payload["exact_f_order"] = sorted(ARM_NAMES, key=lambda arm: (-f_totals[arm], arm))
+    payload["ee_order"] = sorted(ARM_NAMES, key=lambda arm: (-payload["pooled"][arm]["ee_mbit_per_j"], arm))
