+#!/usr/bin/env python3
+"""Rebuild the frozen six-arm static family on dense-only evaluator paths.
+
+Selection: each search arm gets one fresh boundary-0 StepEvaluator.  BASE is
+dense-populated through evaluate_many before any profile is read, and all
+candidates use that same evaluator.  Endpoints: all six selected profiles enter one separate fresh realised
+full-48 evaluate_many call per anchor.  Scalar StepEvaluator.evaluate is
+replaced by a fail-closed assertion for the whole measured surface.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from fractions import Fraction
+import gc
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import random
+import resource
+import sys
+import time
+
+
+WORKSPACE = Path("/home/sat/mcrl-v025-rank2-ws")
+PANEL_RUNNER = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/run_panelceil.py")
+PANEL_RECEIPT = Path("/home/sat/mcrl-v025-ceiling30-ws/.scratch/panelceil/panelceil-receipt.json")
+PUBLISHED_RECEIPT = Path("/home/sat/mcrl-v025-rank-ws/.scratch/statics/statics-receipt.json")
+OUTPUT = WORKSPACE / ".scratch/cleanpath/cleanpath-receipt.json"
+PYTHON = "/home/sat/mcrl-leo-handover/.venv/bin/python"
+THREAD_VARS = (
+    "OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
+    "NUMEXPR_NUM_THREADS", "VECLIB_MAXIMUM_THREADS", "BLIS_NUM_THREADS",
+)
+MAX_RSS_BYTES = 5_000_000_000
+RANDOM_SEED = 20260910
+ARM_NAMES = (
+    "RANDOM", "ROUND_ROBIN", "RSS_MAX", "NEAREST_ELIGIBLE",
+    "MYOPIC_GREEDY", "FIRST_IMPROVEMENT_FP",
+)
+SEARCH_ARMS = ("MYOPIC_GREEDY", "FIRST_IMPROVEMENT_FP")
+PUBLISHED_EE_MBIT_J = {
+    "RANDOM": 11.233999,
+    "ROUND_ROBIN": 3.441227,
+    "RSS_MAX": 41.621560,
+    "NEAREST_ELIGIBLE": 11.027760,
+    "MYOPIC_GREEDY": 28.668530,
+    "FIRST_IMPROVEMENT_FP": 13.430253,
+}
+SCALAR_EVALUATE_CALLS = 0
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def canonical_digest(payload: dict) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    return hashlib.sha256(json.dumps(
+        unsigned, sort_keys=True, separators=(",", ":"), allow_nan=False,
+    ).encode("utf-8")).hexdigest()
+
+
+def atomic_write(payload: dict) -> None:
+    payload["receipt_sha256"] = canonical_digest(payload)
+    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
+    temporary = OUTPUT.with_name(f".{OUTPUT.name}.{os.getpid()}.tmp")
+    temporary.write_text(
+        json.dumps(payload, sort_keys=True, indent=2, allow_nan=False) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(OUTPUT)
+
+
+def peak_rss_bytes() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024
+
+
+def check_runtime() -> None:
+    if sys.executable != PYTHON:
+        raise RuntimeError(f"wrong interpreter: {sys.executable}")
+    if os.getpriority(os.PRIO_PROCESS, 0) < 15:
+        raise RuntimeError("niceness is below 15")
+    bad = {name: os.environ.get(name) for name in THREAD_VARS if os.environ.get(name) != "1"}
+    if bad:
+        raise RuntimeError(f"thread pins are not all one: {bad}")
+    if peak_rss_bytes() >= MAX_RSS_BYTES:
+        raise MemoryError(f"peak RSS {peak_rss_bytes()} is not below 5 GB")
+
+
+def load_panel():
+    name = "cleanpath_panelceil_reference"
+    spec = importlib.util.spec_from_file_location(name, PANEL_RUNNER)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("cannot load PANELCEIL runner")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def forbid_scalar_evaluate(runner) -> None:
+    """Fail the run if any code on the measured surface calls scalar evaluate."""
+    original = runner.StepEvaluator.evaluate
+
+    def forbidden(*args, **kwargs):
+        del args, kwargs
+        global SCALAR_EVALUATE_CALLS
+        SCALAR_EVALUATE_CALLS += 1
+        raise AssertionError("scalar StepEvaluator.evaluate is forbidden on clean path")
+
+    forbidden.__name__ = "scalar_evaluate_forbidden_on_clean_path"
+    forbidden.__wrapped__ = original
+    runner.StepEvaluator.evaluate = forbidden
+    assert runner.StepEvaluator.evaluate is forbidden
+
+
+def fresh_evaluator(runner, tape, step_index, incumbent, run_setting, field, boundaries):
+    return runner.StepEvaluator(
+        tape, runner._setting("a-r0"), step_index,
+        transition_from=incumbent,
+        cell_rekeyed_users=runner._rekeyed_users(tape, step_index),
+        field=field, counter=runner.EvaluationCounter(),
+        run_setting=run_setting, boundary_indices=boundaries,
+    )
+
+
+def configured(runner, base, mapping, kind: str):
+    return runner._configuration(base, mapping, kind=kind)
+
+
+def random_configuration(runner, tape, step_index: int, base, anchor_index: int):
+    options, _ = runner._legal_options(tape, step_index)
+    rng = random.Random(RANDOM_SEED + anchor_index)
+    mapping = {
+        user: (None if not identities else identities[rng.randrange(len(identities))])
+        for user, identities in sorted(options.items())
+    }
+    return configured(runner, base, mapping, "cleanpath-random")
+
+
+def round_robin_configuration(runner, tape, step_index: int, base):
+    options, _ = runner._legal_options(tape, step_index)
+    loads: Counter[tuple[int, int]] = Counter()
+    mapping = {}
+    for user, identities in sorted(options.items()):
+        if not identities:
+            mapping[user] = None
+            continue
+        _, identity = min(
+            enumerate(identities), key=lambda item: (loads[item[1]], item[0])
+        )
+        mapping[user] = identity
+        loads[identity] += 1
+    return configured(runner, base, mapping, "cleanpath-round-robin")
+
+
+def rss_max_configuration(runner, tape, step_index: int, base):
+    options, _ = runner._legal_options(tape, step_index)
+    arrays = tape.steps[step_index].arrays
+    if arrays is None:
+        raise RuntimeError("frozen exact panel must expose primitive arrays")
+    row_of = arrays._row_index()
+    mapping = {}
+    for user, identities in sorted(options.items()):
+        if not identities:
+            mapping[user] = None
+            continue
+        _, identity = min(
+            enumerate(identities),
+            key=lambda item: (
+                -float(arrays.nominal_gain[0, row_of[(user, item[1])]]), item[0]
+            ),
+        )
+        mapping[user] = identity
+    return configured(runner, base, mapping, "cleanpath-rss-max")
+
+
+def dense_search(panel, runner, calibration, tape, step_index, base, incumbent,
+                 run_setting, *, field: str, rule: str, converged: bool, kind: str):
+    """Run one search arm using only one fresh dense boundary-0 evaluator."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting, field, (0,)
+    )
+    options, census = runner._legal_options(tape, step_index)
+    rekeys = runner._rekeyed_users(tape, step_index)
+
+    # BASE enters through the same dense-only evaluator as every candidate.
+    # Populate it before the first read while preserving the frozen candidate
+    # microbatch shape exactly; this is the established SURFACE clean path.
+    evaluator.evaluate_many((base,))
+    base_profile = evaluator._evaluated.get(base.configuration_id)
+    if base_profile is None:
+        raise RuntimeError("dense BASE is invalid")
+    guard = panel.served(base_profile)
+
+    current = base
+    passes = moves = comparisons = submitted = 0
+    started = time.perf_counter()
+    while True:
+        moves_this_pass = 0
+        for user in sorted(options):
+            current_profile = evaluator._evaluated.get(current.configuration_id)
+            if current_profile is None:
+                raise RuntimeError("current profile absent from dense cache")
+            current_value: Fraction = panel.objective(
+                runner, calibration, incumbent, current, current_profile, rekeys
+            )
+            candidates = tuple(
+                panel.candidate(runner, base, current, user, identity, kind)
+                for identity in options[user]
+                if identity != current.mapping[user]
+            )
+            accepted = None
+            if rule == "first":
+                for offset in range(0, len(candidates), panel.UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + panel.UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                    for row in batch:
+                        comparisons += 1
+                        profile = evaluator._evaluated.get(row.configuration_id)
+                        if profile is None or panel.served(profile) < guard:
+                            continue
+                        value = panel.objective(
+                            runner, calibration, incumbent, row, profile, rekeys
+                        )
+                        if value > current_value:
+                            accepted = row
+                            break
+                    if accepted is not None:
+                        break
+            elif rule == "best":
+                for offset in range(0, len(candidates), panel.UNILATERAL_BATCH_SIZE):
+                    batch = candidates[offset:offset + panel.UNILATERAL_BATCH_SIZE]
+                    evaluator.evaluate_many(batch)
+                    submitted += len(batch)
+                eligible = [(current_value, current.configuration_id, current)]
+                for row in candidates:
+                    comparisons += 1
+                    profile = evaluator._evaluated.get(row.configuration_id)
+                    if profile is None or panel.served(profile) < guard:
+                        continue
+                    value = panel.objective(
+                        runner, calibration, incumbent, row, profile, rekeys
+                    )
+                    eligible.append((value, row.configuration_id, row))
+                selected = min(eligible, key=lambda item: (-item[0], item[1]))[2]
+                if selected.mapping[user] != current.mapping[user]:
+                    accepted = selected
+            else:
+                raise ValueError(rule)
+            if accepted is not None:
+                current = accepted
+                moves += 1
+                moves_this_pass += 1
+        passes += 1
+        if not converged or moves_this_pass == 0:
+            break
+        if passes > 100:
+            raise RuntimeError("search exceeded 100 passes")
+
+    detail = {
+        "field": field,
+        "rule": rule,
+        "passes_mode": "converged" if converged else "one",
+        "moves": moves,
+        "passes_including_certificate": passes,
+        "guard": guard,
+        "comparisons": comparisons,
+        "submitted_candidate_slots": submitted,
+        "legal_option_census": census,
+        "selection_seconds": time.perf_counter() - started,
+        "base_entered_dense_before_candidates_in_same_evaluator": True,
+        "scalar_evaluate_calls": SCALAR_EVALUATE_CALLS,
+        "physical_boundary_evaluations": evaluator.physical_evaluations,
+    }
+    del evaluator
+    gc.collect()
+    return current, detail
+
+
+def diversity(config, options) -> dict[str, float | int]:
+    chosen = [identity for identity in config.mapping.values() if identity is not None]
+    counts = Counter(chosen)
+    user_count = len(config.mapping)
+    ordinals = []
+    for user, identity in sorted(config.mapping.items()):
+        if identity is not None:
+            ordinals.append(options[user].index(identity))
+    return {
+        "modal_frac": 0.0 if not counts else max(counts.values()) / user_count,
+        "active_beams": len(counts),
+        "active_satellites": len({identity[0] for identity in counts}),
+        "argmax_distinct": len(set(ordinals)),
+        "assigned_users": len(chosen),
+        "user_count": user_count,
+    }
+
+
+def endpoint_metrics(panel, runner, tape, step_index, incumbent, run_setting, configs):
+    """One fresh full-48 realised evaluator and one batch call for all six arms."""
+    evaluator = fresh_evaluator(
+        runner, tape, step_index, incumbent, run_setting,
+        "realised", tuple(range(48)),
+    )
+    evaluator.evaluate_many(tuple(configs[name] for name in ARM_NAMES))
+    result = {}
+    for name in ARM_NAMES:
+        config = configs[name]
+        profile = evaluator._evaluated.get(config.configuration_id)
+        if profile is None:
+            raise RuntimeError(f"invalid committed config for {name}")
+        result[name] = panel.metric(profile)
+    del evaluator
+    gc.collect()
+    return result
+
+
+def summarize(values):
+    return {
+        "mean": math.fsum(values) / len(values),
+        "min": min(values),
+        "max": max(values),
+    }
+
+
+def pool(anchors, arm: str) -> dict[str, object]:
+    rows = [anchor["arms"][arm]["committed"] for anchor in anchors]
+    bits = math.fsum(float(row["bits"]) for row in rows)
+    joules = math.fsum(float(row["joules"]) for row in rows)
+    diversities = [anchor["arms"][arm]["diversity"] for anchor in anchors]
+    return {
+        "bits": bits,
+        "joules": joules,
+        "ee_mbit_per_j": bits / joules / 1e6,
+        "served_count": sum(int(row["served_count"]) for row in rows),
+        "rate_target_attained_count": sum(
+            int(row["rate_target_attained_count"]) for row in rows
+        ),
+        "user_count": sum(int(row["user_count"]) for row in rows),
+        "modal_frac": summarize([float(row["modal_frac"]) for row in diversities]),
+        "active_beams": summarize([float(row["active_beams"]) for row in diversities]),
+        "active_satellites": summarize([
+            float(row["active_satellites"]) for row in diversities
+        ]),
+        "argmax_distinct": summarize([
+            float(row["argmax_distinct"]) for row in diversities
+        ]),
+    }
+
+
+def published_search_counts(published_anchor: dict, arm: str) -> tuple[int, int]:
+    detail = published_anchor["arms"][arm]["detail"]
+    if arm == "MYOPIC_GREEDY":
+        return int(detail["users_changing_choice"]), 1
+    return int(detail["accepted_moves"]), int(detail["total_passes_including_certificate"])
+
+
+def main() -> int:
+    check_runtime()
+    overall_started = time.perf_counter()
+    panel = load_panel()
+    panel_receipt = json.loads(PANEL_RECEIPT.read_text(encoding="utf-8"))
+    published = json.loads(PUBLISHED_RECEIPT.read_text(encoding="utf-8"))
+    frozen = published.get("panel")
+    if not isinstance(frozen, list) or len(frozen) != 12:
+        raise RuntimeError("published receipt does not contain the 12 frozen anchors")
+    if panel_receipt.get("status") != "COMPLETE":
+        raise RuntimeError("PANELCEIL receipt is not complete")
+    if published.get("status") != "COMPLETE":
+        raise RuntimeError("published static receipt is not complete")
+    if panel_receipt.get("receipt_sha256") != panel.canonical_digest(panel_receipt):
+        raise RuntimeError("PANELCEIL receipt digest failed")
+    if published.get("receipt_sha256") != canonical_digest(published):
+        raise RuntimeError("published static receipt digest failed")
+
+    pilot = panel.load_pilot()
+    runner = pilot.ENGINE
+    calibration = panel.load_calibration(pilot)
+    run_setting = runner.run_setting_for("a-r0")
+    forbid_scalar_evaluate(runner)
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB before tape", flush=True)
+    tape_started = time.perf_counter()
+    tape = build_world_tape(
+        domain=pilot.TRAIN_WORLDS[0], provider=LegacyWorldProvider(role="pilot-source"),
+        steps=33, start_time_s=0.0,
+    )
+    tape_seconds = time.perf_counter() - tape_started
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB after tape", flush=True)
+
+    payload = {
+        "schema": "mcrl-v025-static-baseline-family-cleanpath-v1",
+        "status": "RUNNING",
+        "claim_status": "DESIGN_PHASE_MEASUREMENT_NOT_A_CLAIM",
+        "panel": frozen,
+        "panel_count": len(frozen),
+        "panel_enumeration": "12 frozen declarations from digest-checked published receipt; transient staging paths not read",
+        "panel_runner_sha256": sha256(PANEL_RUNNER),
+        "panel_receipt_sha256": panel_receipt["receipt_sha256"],
+        "published_receipt_file_sha256": sha256(PUBLISHED_RECEIPT),
+        "published_receipt_sha256": published["receipt_sha256"],
+        "runner_sha256": None,
+        "world_tape": {
+            "domain": tape.domain, "seed": tape.seed, "digest": tape.digest,
+            "construction_seconds": tape_seconds,
+        },
+        "python": sys.executable,
+        "niceness": os.getpriority(os.PRIO_PROCESS, 0),
+        "process_count": 1,
+        "thread_pins": {name: os.environ[name] for name in THREAD_VARS},
+        "random_seed": RANDOM_SEED,
+        "selection_path": {
+            "evaluator": "fresh StepEvaluator(field per arm, boundary_indices=(0,))",
+            "population": "one evaluate_many-only cache; BASE is populated before reads, then candidates use the same evaluator",
+            "profile_reads": "StepEvaluator._evaluated after dense population",
+            "scalar_evaluate_fail_closed": True,
+        },
+        "endpoint_path": {
+            "evaluator": "one separate fresh realised StepEvaluator(boundary_indices=range(48)) per anchor",
+            "population": "one evaluate_many call containing all six selected profiles",
+        },
+        "anchors": [],
+    }
+
+    for position, panel_row in enumerate(frozen, 1):
+        index = int(panel_row["global_anchor_index"])
+        step_index = int(panel_row["step_index"])
+        carrier = str(panel_row["carrier"])
+        base = runner._base_configuration(tape, step_index, carrier)
+        incumbent = runner._base_configuration(tape, max(0, step_index - 1), carrier)
+        options, _ = runner._legal_options(tape, step_index)
+        configs = {
+            "NEAREST_ELIGIBLE": base,
+            "RANDOM": random_configuration(runner, tape, step_index, base, index),
+            "ROUND_ROBIN": round_robin_configuration(runner, tape, step_index, base),
+            "RSS_MAX": rss_max_configuration(runner, tape, step_index, base),
+        }
+        details = {}
+        configs["MYOPIC_GREEDY"], details["MYOPIC_GREEDY"] = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent, run_setting,
+            field="nominal", rule="best", converged=False,
+            kind="cleanpath-myopic-greedy",
+        )
+        configs["FIRST_IMPROVEMENT_FP"], details["FIRST_IMPROVEMENT_FP"] = dense_search(
+            panel, runner, calibration, tape, step_index, base, incumbent, run_setting,
+            field="realised", rule="first", converged=True,
+            kind="cleanpath-first-improvement",
+        )
+        committed = endpoint_metrics(
+            panel, runner, tape, step_index, incumbent, run_setting, configs
+        )
+        published_anchor = published["anchors"][index]
+        arms = {}
+        for name in ARM_NAMES:
+            published_id = published_anchor["arms"][name]["configuration_id"]
+            arm = {
+                "selection_evaluator_touched": name in SEARCH_ARMS,
+                "configuration_id": configs[name].configuration_id,
+                "published_configuration_id": published_id,
+                "configuration_matches_published": configs[name].configuration_id == published_id,
+                "committed": committed[name],
+                "diversity": diversity(configs[name], options),
+            }
+            if name in SEARCH_ARMS:
+                published_moves, published_passes = published_search_counts(
+                    published_anchor, name
+                )
+                arm["selection"] = details[name]
+                arm["published_moves"] = published_moves
+                arm["published_passes_including_certificate"] = published_passes
+            arms[name] = arm
+        payload["anchors"].append({
+            "global_anchor_index": index,
+            "anchor_id": f"{panel_row['world_id']}|{step_index}|{carrier}",
+            "step_index": step_index,
+            "carrier": carrier,
+            "arms": arms,
+            "peak_rss_bytes": peak_rss_bytes(),
+        })
+        payload["pooled"] = {arm: pool(payload["anchors"], arm) for arm in ARM_NAMES}
+        payload["peak_rss_bytes"] = peak_rss_bytes()
+        check_runtime()
+        atomic_write(payload)
+        print(
+            f"anchor {position}/{len(frozen)} completed peak RSS "
+            f"{peak_rss_bytes()/2**30:.3f} GiB "
+            + json.dumps({
+                "global": index,
+                "myopic_moves": details["MYOPIC_GREEDY"]["moves"],
+                "fp_moves": details["FIRST_IMPROVEMENT_FP"]["moves"],
+                "fp_passes": details["FIRST_IMPROVEMENT_FP"]["passes_including_certificate"],
+            }, sort_keys=True),
+            flush=True,
+        )
+
+    payload["pooled"] = {arm: pool(payload["anchors"], arm) for arm in ARM_NAMES}
+    payload["published_comparison"] = {
+        arm: {
+            "published_rounded_6_mbit_per_j": PUBLISHED_EE_MBIT_J[arm],
+            "published_receipt_mbit_per_j": float(published["pooled"][arm]["ee_bit_per_j"]) / 1e6,
+            "clean_mbit_per_j": float(payload["pooled"][arm]["ee_mbit_per_j"]),
+            "clean_minus_published_receipt_mbit_per_j": (
+                float(payload["pooled"][arm]["ee_mbit_per_j"])
+                - float(published["pooled"][arm]["ee_bit_per_j"]) / 1e6
+            ),
+            "configuration_ids_matching": sum(
+                bool(row["arms"][arm]["configuration_matches_published"])
+                for row in payload["anchors"]
+            ),
+        }
+        for arm in ARM_NAMES
+    }
+    payload["scalar_evaluate_calls"] = SCALAR_EVALUATE_CALLS
+    assert SCALAR_EVALUATE_CALLS == 0
+    payload["status"] = "COMPLETE"
+    payload["peak_rss_bytes"] = peak_rss_bytes()
+    payload["wall_seconds"] = time.perf_counter() - overall_started
+    payload["runner_sha256"] = sha256(Path(__file__))
+    atomic_write(payload)
+    check_runtime()
+    print(f"peak RSS {peak_rss_bytes()/2**30:.3f} GiB final ({peak_rss_bytes()} bytes)", flush=True)
+    print(json.dumps({
+        arm: payload["pooled"][arm]["ee_mbit_per_j"] for arm in ARM_NAMES
+    }, sort_keys=True), flush=True)
+    print(f"scalar_evaluate_calls={SCALAR_EVALUATE_CALLS}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
