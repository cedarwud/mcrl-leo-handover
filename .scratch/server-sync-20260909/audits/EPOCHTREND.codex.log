def _quantiles(values):
    if not values:
        return {"min": None, "p05": None, "p50": None, "p95": None, "max": None}
    return {
        name: float(np.quantile(values, q))
        for name, q in (("min", 0.0), ("p05", 0.05), ("p50", 0.5), ("p95", 0.95), ("max", 1.0))
    }


def summarize(records, row_manifest, training_manifest, evaluation_manifest):
    summary = {"anchors": {}, "contrasts": {}, "latency": {}}
    for variant in ("P-a0", "P-u"):
        summary["anchors"][variant] = {}
        subset = [row for row in records if row["catalogue_anchor"] == variant]
        for arm in REPORTED_ARMS:
            rows = [row for row in subset if row["arm"] == arm]
            bits = math.fsum(row["bits"] for row in rows)
            joules = math.fsum(row["joules"] for row in rows)
            summary["anchors"][variant][arm] = {
                "bits": bits,
                "joules": joules,
                "pooled_ee_bits_per_j": None if joules == 0 else bits / joules,
                "availability": math.fsum(row["availability"] for row in rows) / len(rows),
                "handover_rate": math.fsum(row["handover_count"] for row in rows) / math.fsum(row["handover_opportunities"] for row in rows),
                "cap_hit_rate": math.fsum(row["rf_cap_hits"] for row in rows) / max(1, math.fsum(row["rf_transmission_observations"] for row in rows)),
            }
        full = summary["anchors"][variant]["FULL"]
        for comparator in ("DROP_C3", "S0", "S_UNI"):
            other = summary["anchors"][variant][comparator]
            key = f"{variant}:FULL-vs-{comparator}"
            summary["contrasts"][key] = (
                None
                if full["pooled_ee_bits_per_j"] is None or other["pooled_ee_bits_per_j"] is None
                else full["pooled_ee_bits_per_j"] / other["pooled_ee_bits_per_j"] - 1.0
            )
        full_rows = [row for row in subset if row["arm"] == "FULL"]
        anchor_rows = {
            (row["world_id"], row["anchor_index"]): row for row in full_rows
        }
        reversal_rows = [
            row for row in full_rows if row.get("additive_choice_joint_delta", 0.0) < 0.0
        ]
        sizes = sorted(
            {
                int(size)
                for row in anchor_rows.values()
                for size in row.get("u_positive_joint_sizes", [])
            }
            | {int(row["changed_users"]) for row in full_rows}
        )
        summary["anchors"][variant]["diagnostics"] = {
            "positive_joint_escape_fraction_from_u": sum(
                bool(row["u_any_positive_joint_escape"])
                for row in anchor_rows.values()
            ) / len(anchor_rows),
            "selected_psi_distribution": _quantiles([row["psi_anchor_normalized"] for row in full_rows]),
            "g_A_distribution": _quantiles([row["g_A"] for row in full_rows if "g_A" in row]),
            "g_I_distribution": _quantiles([row["g_I"] for row in full_rows if "g_I" in row]),
            "top_choice_agreement": sum(bool(row["top_choice_agreement"]) for row in full_rows) / len(full_rows),
            "harmful_acceptance_rate": sum(row["joint_delta_anchor_normalized"] < 0.0 for row in full_rows) / len(full_rows),
            "c2_tie_frequency": sum(bool(row["c2_tie_break"]) for row in full_rows) / len(full_rows),
            "c2_tie_pair_fraction_mean": (
                math.fsum(row["c2_tie_break"] or 0.0 for row in full_rows) / len(full_rows)
            ),
            "v_ca": {
                field: math.fsum(row[field] for row in full_rows)
                for field in (
                    "v_ca_bits_component", "v_ca_energy_component_bits",
                    "v_ca_phi_component_bits", "v_ca_net_bits",
                )
            },
            "additive_reversal_frequency": len(reversal_rows) / len(full_rows),
            "additive_reversals_prevented_fraction": (
                None if not reversal_rows else sum(
                    row["joint_delta_anchor_normalized"] >= 0.0
                    for row in reversal_rows
                ) / len(reversal_rows)
            ),
            "escape_and_harm_by_coalition_size": {
                str(size): {
                    "escape_opportunities": sum(
                        size in row.get("u_positive_joint_sizes", [])
                        for row in anchor_rows.values()
                    ),
                    "selected": sum(row["changed_users"] == size for row in full_rows),
                    "harmful": sum(
                        row["changed_users"] == size
                        and row["joint_delta_anchor_normalized"] < 0.0
                        for row in full_rows
                    ),
                }
                for size in sizes
            },
        }
    latencies = evaluation_manifest["latencies"]
    for field in (
        "feature_construction_s", "catalogue_a0_s", "catalogue_u_extra_s", "s_uni_s", "total_s", "physics_boundary_evaluations"
    ):
        summary["latency"][field] = _quantiles([float(row[field]) for row in latencies])
    summary["resources"] = {
        "rows_wall_s": row_manifest["phase_wall_s"],
        "rows_core_s": row_manifest["phase_core_s"],
        "training_wall_s": training_manifest["phase_wall_s"],
        "training_core_s": training_manifest["phase_core_s"],
        "evaluation_wall_s": evaluation_manifest["phase_wall_s"],
        "evaluation_core_s": evaluation_manifest["phase_core_s"],
    }
    return summary


def _scope_paragraph() -> str:
    return (
        f"**Scope of this run.** Evaluation worlds {list(EVALUATION_WORLDS)}; "
        f"{EVAL_ANCHOR_STEPS} anchor steps x "
        f"{'nearest-eligible carrier only' if EVAL_CARRIER_LIMIT == 1 else str(EVAL_CARRIER_LIMIT) + ' carriers'}; "
        f"learner seeds {list(LEARNER_DOMAINS)} ({len(LEARNER_SEEDS)}); "
        f"learned arms {list(PILOT_ARMS)} plus BASELINE, S0, S_UNI; "
        f"checkpoint epoch {EVAL_EPOCH} (NOT the sealed {LEGACY_EPOCH_BUDGET}); "
        f"training rows restricted to `rows/{ROW_WORLD_GLOB}` "
        f"(first {ROW_ANCHOR_LIMIT} anchor shards)."
        if EVAL_ANCHOR_STEPS < 30 else
        "**Scope of this run.** Full pilot scale."
    )


def write_report(summary, row_manifest, training_manifest, evaluation_manifest):
    lines = [
        "# V0.25 pilot C3 report — 2026-09-09",
        "",
        f"**{LABEL}. Every artefact and every numerical value in this report is {LABEL}.**",
        "",
        "This is quarantined engineering evidence only. No scientific conclusion, configuration selection, or claim is made.",
        "",
        _scope_paragraph(),
        "",
        "## Rows",
        "",
        "| World | Anchors | Q1/Q2 rows | C3 rows | Bytes |",
        "|---|---:|---:|---:|---:|",
    ]
    for row in row_manifest["worlds"]:
        lines.append(
            f"| {row['world_id']} | {row['anchors']} | {row['source_rows']} | {row['coalition_rows']} | {row['source_bytes'] + row['coalition_bytes']} |"
        )
    lines.extend([
        "",
        "The pilot calibration proxy and every row carry explicit lambda, eta, and kappa exact ratios/hex values. The formal calibration was absent from the launch copy; see DEFECTS.",
        "",
        "## Training",
        "",
        f"Learned arm-seed lineages ran with concurrency {training_manifest['concurrency']}; external BASELINE seed records were emitted separately. Neutral batches were hoisted once per worker. Each learned lineage completed {LEGACY_EPOCH_BUDGET} source epochs with a checkpoint every 100 epochs; **this report evaluates the epoch-{EVAL_EPOCH} checkpoint**.",
        "",
        "## Realised pooled results",
        "",
    ])
    for variant in ("P-a0", "P-u"):
        lines.extend([
            f"### {variant}",
            "",
            "| Arm | Sum B | Sum E | Pooled EE | Availability | Handover rate | Cap-hit rate |",
            "|---|---:|---:|---:|---:|---:|---:|",
        ])
        for arm, row in summary["anchors"][variant].items():
            if arm == "diagnostics":
                continue
            lines.append(
                f"| {arm} | {row['bits']:.9g} | {row['joules']:.9g} | {row['pooled_ee_bits_per_j']:.9g} | {row['availability']:.9g} | {row['handover_rate']:.9g} | {row['cap_hit_rate']:.9g} |"
            )
        lines.append("")
        for comparator in ("DROP_C3", "S0", "S_UNI"):
            value = summary["contrasts"][f"{variant}:FULL-vs-{comparator}"]
            lines.append(f"- FULL vs {comparator}: relative pooled-EE difference = {value:.9g}.")
        diagnostics = summary["anchors"][variant]["diagnostics"]
        lines.extend([
            f"- Strictly improving selected joint escape from the catalogue anchor: {diagnostics['positive_joint_escape_fraction_from_u']:.9g}.",
            f"- Selected Psi distribution (min/p05/p50/p95/max): {diagnostics['selected_psi_distribution']}.",
            f"- Matched-anchor g_A distribution: {diagnostics['g_A_distribution']}.",
            f"- Matched-anchor g_I distribution: {diagnostics['g_I_distribution']}.",
            f"- Learned/exact top-choice agreement: {diagnostics['top_choice_agreement']:.9g}.",
            f"- Harmful-acceptance rate: {diagnostics['harmful_acceptance_rate']:.9g}.",
            f"- C2 tie-break frequency: {diagnostics['c2_tie_frequency']:.9g}.",
            f"- V_CA (unclipped realised bits, -eta*energy, Phi, net bit-equivalent components): {diagnostics['v_ca']}.",
            f"- Additive-reversal frequency: {diagnostics['additive_reversal_frequency']:.9g}; prevented fraction: {diagnostics['additive_reversals_prevented_fraction']}.",
            f"- Escape/harm counts by selected coalition size: {diagnostics['escape_and_harm_by_coalition_size']}.",
            "",
        ])
    lines.extend([
        "## Catalogue-anchor comparison and latency",
        "",
        f"P-u extra catalogue wall-time distribution: {summary['latency']['catalogue_u_extra_s']}.",
        f"Full decision total wall-time distribution: {summary['latency']['total_s']}.",
        f"Feature-construction wall-time distribution: {summary['latency']['feature_construction_s']}.",
        f"Catalogue-generation wall-time distribution: {summary['latency']['catalogue_a0_s']}.",
        f"Physics-call distribution: {summary['latency']['physics_boundary_evaluations']}.",
        "Timeout frequency is the mean of the raw `s_uni_deadline_missed` field; all timeout outcomes include the executed fallback.",
        "",
        "The C2 tie-break diagnostic is the fraction of non-incumbent (user, action) candidates whose C2 head score is exactly equal to the incumbent's under the FULL arm, i.e. C2 cannot discriminate the move and the ranking falls through to C1 plus the stable configuration-ID tie-break. `c2_tie_frequency` is the fraction of anchor-seed decisions with any such tie; `c2_tie_pair_fraction_mean` is the mean per-decision tie fraction. See DEFECTS.",
        "",
        "## Four experiments (kept separate)",
        "",
        "1. Learned neutral-source experiment: run here (FULL, DROP_C1, DROP_C2, DROP_C3, ALL_NEUTRAL_CONTROL, BASELINE).",
        "2. Oracle factor-score removal: not run; stage-4 physics receipts remain separate.",
        "3. Checkpoint knockout: not run in this pilot.",
        "4. Architecture removal: named only and not run, as required.",
        "",
        "## Resource use",
        "",
        "| Phase | Wall hours | Core hours |",
        "|---|---:|---:|",
    ])
    for phase in ("rows", "training", "evaluation"):
        lines.append(
            f"| {phase} | {summary['resources'][phase + '_wall_s'] / 3600:.6g} | {summary['resources'][phase + '_core_s'] / 3600:.6g} |"
        )
    lines.extend([
        "",
        "## DEFECTS",
        "",
        "- The launcher copy was not a usable Git repository (`.git` was empty), so no baseline diff or commit could be made.",
        "- Stage-C build 3 imported `coalition_identity`, absent from the stage-4d target snapshot. A compatibility implementation restored both exact B4 identities and accepts uncapped selected coalitions.",
        "- The fixed provider imported `ProviderAttestation`, absent from the stage-4d tape snapshot, and lacked the older `protocol_outputs` method. A data-only attestation seam and adapter were added; physical calculations are unchanged.",
        "- Stage-C build 3 predated amendment v1.2: it capped interaction labels at four and omitted a pairwise cross-gain relation block. The pilot changed labels to uncapped, retained the <=4 Shapley cap for reporting only, and added pooled physical-ID/cross-gain relations.",
        "- No signed formal calibration manifest was present because stage 4d stopped on HOLD. The pilot uses an explicitly labelled one-development-anchor proxy solely to complete wiring; every row carries its exact values.",
        "- The engine does not expose candidate off-axis angle at the Stage-C adapter seam. The smallest schema-complete pilot fills that Q1 field with 0 and records this defect; this is not admissible evidence.",
        "- Power-invalid shortlisted actions have no engine outcome object. They are counted and omitted from rows; BASE and explicit NULL are required to remain.",
        "- The old T1 acceptance assertion expected the superseded four-user label cap. T1/T2 logic otherwise ran; the full T3 Monte Carlo gate was stopped after ten wall minutes to protect the pilot compute budget.",
        "- Build 3 has no explicit C2 tie-break implementation. Stable total score then configuration ID is used. The C2 tie statistic reported here was implemented by this pilot as the smallest schema-satisfying measurement (exact C2-score equality against the incumbent); it measures head indiscriminability, not a build-3 tie-break code path.",
        "- V_CA and coalition-size anti-pattern strata were not first-class build-3 receipt fields. The pilot records V_CA as the realised FULL-minus-additive-selector F difference, with bits, -eta*energy and Phi components unclipped, and emits explicit size strata.",
        "- To remain inside the six-core-hour ceiling after timing the real provider, Q2 forecasts use boundary 0 at each of the three sealed offsets rather than all five coarse boundaries, and training uses a deterministic 4096-pair aggregate while preserving all raw rows. This is a schema-complete pilot fallback, not sealed evidence.",
        "- Exact full-network C1/C2 evaluation for every shortlisted source action exceeded the compute ceiling. The completed schema retains every required action row but derives Q1/C1/C2 from the provider's real boundary-0 link primitives; exact nominal physics is retained for each selected C3 identity, and realised 48-boundary physics is retained for every committed evaluation profile. These approximate source labels are PILOT_NOT_CLAIM.",
        "- Exact S0 over 48 boundaries for every catalogue profile was unbounded in the joined engine. The pilot ranks S0's top-two proposals with provider-primitive C1+C2, applies the same bounded evacuation rule, evaluates that set with exact nominal boundary-0 physics, then evaluates the committed S0 profile over all 48 realised boundaries.",
        "- Exhaustive exact interaction decomposition over every catalogue row was also unbounded. Exact Psi is computed for every P-u joint escape candidate and every selected FULL coalition; other rows retain learned scoring only. P-u top-10 users are primitive-ranked by |d_i^u|. The pilot S_UNI wall budget was reduced to 5 seconds, with the engine's fallback and termination certificate retained verbatim.",
        "",
        f"Raw evaluation rows: {evaluation_manifest['receipt_rows']}; bytes: {evaluation_manifest['receipt_bytes']}; SHA-256: `{evaluation_manifest['receipt_sha256']}`.",
        "",
    ])
    REPORT_PATH.write_text("\n".join(lines), encoding="utf-8")
    digest = hashlib.sha256(REPORT_PATH.read_bytes()).hexdigest()
    REPORT_PATH.with_name(REPORT_PATH.name + ".sha256").write_text(
        f"{digest}  {REPORT_PATH.name}\n", encoding="ascii"
    )
    return digest


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument(
        "--resume-evaluation", action="store_true",
        help="resume from immutable completed row/training artifacts",
    )
    parser.add_argument("--min-pilot", action="store_true",
                        help="minimal PILOT_NOT_CLAIM scale: world 3, 5 anchors, "
                             "nearest carrier, 2 seeds, FULL/DROP_C3/BASELINE, epoch 200")
    args = parser.parse_args(argv)
    if args.min_pilot:
        global EVALUATION_WORLDS, LEARNER_DOMAINS, LEARNER_SEEDS, REPORTED_ARMS
        global PILOT_ARMS, EVAL_ANCHOR_STEPS, EVAL_CARRIER_LIMIT, EVAL_EPOCH
        global ROW_WORLD_GLOB, ROW_ANCHOR_LIMIT, REPORT_PATH
        EVALUATION_WORLDS = DEVELOPMENT_WORLD_DOMAINS[2:3]
        LEARNER_DOMAINS = LEARNER_DOMAINS[:2]
        LEARNER_SEEDS = LEARNER_SEEDS[:2]
        PILOT_ARMS = ("FULL", "DROP_C3")
        REPORTED_ARMS = (*PILOT_ARMS, "BASELINE", "S0", "S_UNI")
        EVAL_ANCHOR_STEPS = 5
        EVAL_CARRIER_LIMIT = 1
        EVAL_EPOCH = 200
        ROW_WORLD_GLOB = "world-1"
        ROW_ANCHOR_LIMIT = 5
        global EVAL_TAPE_STEPS
        EVAL_TAPE_STEPS = EVAL_ANCHOR_STEPS + 3
        REPORT_PATH = ROOT / "V025-PILOT-MIN-REPORT-2026-09-09.md"
    if args.output.exists() and not args.resume_evaluation:
        raise SystemExit(f"refusing to overwrite pilot output: {args.output}")
    if args.resume_evaluation and not args.output.exists():
        raise SystemExit(f"resume output does not exist: {args.output}")
    args.output.mkdir(parents=True, exist_ok=args.resume_evaluation)
    total_started = time.perf_counter()
    if args.resume_evaluation:
        row_manifest, training_manifest, calibration, models, batches = (
            _load_completed_training(args.output)
        )
    else:
        rows, coalitions, calibration, row_manifest = generate_rows(args.output)
        models, training_manifest, batches = train(args.output, rows, coalitions)
    records, evaluation_manifest = evaluate(
        args.output, calibration, models, batches
    )
    summary = summarize(records, row_manifest, training_manifest, evaluation_manifest)
    _write_phase_manifest(
        args.output / f"{LABEL}-summary.json",
        {
            "schema": f"{PILOT_SCHEMA}-summary-v1",
            "total_wall_s": time.perf_counter() - total_started,
            "summary": summary,
        },
    )
    report_digest = write_report(
        summary, row_manifest, training_manifest, evaluation_manifest
    )
    print(
        json.dumps(
            {
                "artifact_label": LABEL,
                "status": "COMPLETE",
                "output": str(args.output),
                "report": str(REPORT_PATH),
                "report_sha256": report_digest,
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
