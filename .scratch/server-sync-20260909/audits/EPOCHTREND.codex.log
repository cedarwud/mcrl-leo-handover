                    compute_budget_s=5.0,
                    run_setting=run_setting,
                    cell_rekeyed_users=ENGINE._rekeyed_users(tape, step_index),
                )
                u_catalogue, ranked_users, u_catalogue_wall = _build_u_catalogue(
                    tape, step_index, carrier_base, u, standard_catalogue,
                    current, calibration, rows,
                )
                exact_u = _structural_interactions(u, u_catalogue)
                u_joint_catalogue = tuple(
                    row for row in u_catalogue
                    if len(exact_u[row.configuration_id]["changed"]) >= 2
                )
                exact_u.update(
                    _exact_interactions(
                        u, incumbent, u_joint_catalogue, current, calibration
                    )
                )
                u_positive_joint_rows = [
                    row for row in exact_u.values()
                    if len(row["changed"]) >= 2 and row["joint"] > 0.0
                ]
                u_positive_joint_sizes = sorted(
                    {len(row["changed"]) for row in u_positive_joint_rows}
