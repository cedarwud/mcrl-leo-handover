                ),
                default=0.0,
            )
            pair_cache[relation] = gain
        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
    return tuple(result)


def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
    changed = tuple(
        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
    )
    members = tuple(
        CoalitionMember(
            user_id=user,
            reference_action=_physical_action(anchor.mapping[user]),
            selected_action=_physical_action(selected.mapping[user]),
            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
        )
        for user in changed
    )
    affected = sorted(
        {
            identity
            for user in changed
            for identity in (anchor.mapping[user], selected.mapping[user])
            if identity is not None
        }
    )
    before_counts: dict[tuple[int, int], int] = {}
    after_counts: dict[tuple[int, int], int] = {}
    for identity in anchor.mapping.values():
        if identity is not None:
            before_counts[identity] = before_counts.get(identity, 0) + 1
    for identity in selected.mapping.values():
        if identity is not None:
            after_counts[identity] = after_counts.get(identity, 0) + 1
    relations = _cross_gain_terms(tape, step_index, affected)
    beams = tuple(
        AffectedBeamContext(
            beam_key=f"{identity[0]}:{identity[1]}",
            occupancy_before=before_counts.get(identity, 0),
            occupancy_after=after_counts.get(identity, 0),
            active_before=before_counts.get(identity, 0) > 0,
            active_after=after_counts.get(identity, 0) > 0,
            shared_capacity=1.0,
            interference_summary=math.fsum(
                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
            ),
            capacity_margin=float(10 - after_counts.get(identity, 0)),
        )
        for identity in affected
    )
    return CoalitionContext(
        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
        reference_profile=tuple(
            (user, _physical_action(identity)) for user, identity in anchor.assignments
        ),
        members=members,
        affected_beams=beams,
        global_resource_features=(
            len(changed) / max(1, len(anchor.assignments)),
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )


def _coalition_row(
    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
    rows_by_user_action, calibration, run_setting,
):
    context = _coalition_context(
        tape=tape,
        step_index=step_index,
        anchor=anchor,
        selected=selected,
        rows_by_user_action=rows_by_user_action,
    )
    reference = evaluator.evaluate(anchor).outcome(
        phi=ENGINE._phi_for(anchor, anchor)
    )
    unilateral = {}
    for user in context.changed_users:
        mapping = anchor.mapping
        mapping[user] = selected.mapping[user]
        config = ENGINE._configuration(anchor, mapping, kind="pilot-coalition-singleton")
        unilateral[user] = evaluator.evaluate(config).outcome(
            phi=ENGINE._phi_for(anchor, config)
        )
    selected_outcome = evaluator.evaluate(selected).outcome(
        phi=ENGINE._phi_for(anchor, selected)
    )
    return build_coalition_row(
        context=context,
        reference_outcome=reference,
        unilateral_outcomes=unilateral,
        coalition_outcome=selected_outcome,
        world_id=tape.domain,
        world_seed=tape.seed,
        anchor_index=anchor_index,
        decision_time_utc=_utc_at(tape, step_index),
        decision_time_ns=int(round(step_index * DECISION_INTERVAL_S * 1e9)),
        setting_id="a-r0",
        lambda_bits_per_j=float(calibration.lambda_bits_per_j),
        eta_ref_bits_per_j=float(calibration.eta_ref),
        kappa_normalization_bits=float(calibration.kappa_bits_per_user_step),
        code_digest=CODE_DIGEST,
        physics_digest=PHYSICS_DIGEST,
        catalogue_digest=ENGINE.catalogue_definition()["sha256"],
        setting_digest=run_setting.digest,
        calibration_digest=calibration.digest,
        allocation_manifest_digest=ALLOCATION_DIGEST,
    )


def _write_phase_manifest(path: Path, payload: Mapping[str, object]) -> str:
    return write_once_json(path, {"artifact_label": LABEL, **payload})


def generate_rows(output: Path):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    source_shards = []
    coalition_shards = []
    calibration = None
    world_records = []
    for world_index, domain in enumerate(TRAIN_WORLDS, start=1):
        provider_started = time.perf_counter()
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(role="pilot-source"),
            steps=33,
            start_time_s=0.0,
        )
        provider_wall = time.perf_counter() - provider_started
        if calibration is None:
            calibration = _pilot_calibration(tape, setting, run_setting)
            _write_phase_manifest(output / f"{LABEL}-calibration.json", calibration.payload())
        skipped = physics_calls = catalogue_rows = 0
        source_row_count = coalition_row_count = source_bytes = coalition_bytes = 0
        source_hashes = []
        coalition_hashes = []
        anchor_started = time.perf_counter()
        anchor_index = 0
        for step_index in range(30):
            for carrier in ENGINE.REFERENCE_CARRIERS:
                built = _build_anchor_rows(
                    tape=tape,
                    setting=setting,
                    run_setting=run_setting,
                    calibration=calibration,
                    step_index=step_index,
                    carrier=carrier,
                    anchor_index=anchor_index,
                    include_coalition=True,
                )
                source_path = (
                    output / "rows" / f"world-{world_index}"
                    / f"{LABEL}-source-anchor-{anchor_index:03d}.jsonl"
                )
                coalition_path = (
                    output / "rows" / f"world-{world_index}"
                    / f"{LABEL}-coalition-anchor-{anchor_index:03d}.jsonl"
                )
                source_shard = write_source_shard(source_path, built["rows"])
                coalition_shard = write_coalition_shard(
                    coalition_path, (built["coalition_row"],)
                )
                source_shards.append(source_shard)
                coalition_shards.append(coalition_shard)
                source_row_count += len(built["rows"])
                coalition_row_count += 1
                source_bytes += source_path.stat().st_size
                coalition_bytes += coalition_path.stat().st_size
                source_hashes.append(source_shard.file_sha256)
                coalition_hashes.append(coalition_shard.file_sha256)
                skipped += built["skipped_invalid"]
                physics_calls += built["physics_calls"]
                catalogue_rows += built["catalogue_count"]
                anchor_index += 1
                print(
                    json.dumps(
                        {
                            "artifact_label": LABEL,
                            "phase": "rows",
                            "world": world_index,
                            "anchor": anchor_index,
                            "anchors_total": 90,
                        }
                    ),
                    flush=True,
                )
        world_records.append(
            {
                "world_id": domain,
                "world_seed": tape.seed,
                "anchors": anchor_index,
                "source_rows": source_row_count,
                "coalition_rows": coalition_row_count,
                "source_bytes": source_bytes,
                "coalition_bytes": coalition_bytes,
                "provider_wall_s": provider_wall,
                "anchor_wall_s": time.perf_counter() - anchor_started,
                "skipped_power_invalid_actions": skipped,
                "physics_boundary_evaluations": physics_calls,
                "catalogue_rows_considered": catalogue_rows,
                "source_shards_sha256": canonical_sha256(source_hashes),
                "coalition_shards_sha256": canonical_sha256(coalition_hashes),
            }
        )
    assert calibration is not None
    manifest = {
        "schema": f"{PILOT_SCHEMA}-rows-manifest-v1",
        "phase_wall_s": time.perf_counter() - phase_started,
        "phase_core_s": time.process_time() - cpu_started,
        "worlds": world_records,
        "total_source_rows": sum(row["source_rows"] for row in world_records),
        "total_coalition_rows": sum(row["coalition_rows"] for row in world_records),
        "total_bytes": sum(
            row["source_bytes"] + row["coalition_bytes"] for row in world_records
        ),
        "calibration": calibration.payload(),
    }
    _write_phase_manifest(output / f"{LABEL}-rows-manifest.json", manifest)
    return source_shards, coalition_shards, calibration, manifest


