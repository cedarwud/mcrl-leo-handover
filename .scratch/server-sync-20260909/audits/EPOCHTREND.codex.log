    for beam in sorted({identity for identity in u.mapping.values() if identity is not None}):
        mapping = u.mapping
        changed = False
        for user in sorted(mapping):
            if mapping[user] == beam and moves.get(user):
                mapping[user] = moves[user][0][1].mapping[user]
                changed = True
        if changed:
            rows.append(ENGINE._configuration(a0, mapping, kind="pilot-u-beam-evacuation"))
    unique = {row.assignments: row for row in rows}
    ordered = tuple(sorted(unique.values(), key=lambda row: row.configuration_id))
    if len(ordered) > ENGINE.CATALOGUE_CAP:
        ordered = ordered[: ENGINE.CATALOGUE_CAP]
    return ordered, ranked, time.perf_counter() - started


def _exact_s0_boundary0(base, catalogue, evaluator, rows_by_user_action):
    """Primitive proposal ranking plus exact nominal bounded-set S0."""

    unilateral = [row for row in catalogue if row.changed_users == 1]
    top_ids = []
    for user in sorted(base.mapping):
        proposals = [
            row for row in unilateral
            if row.mapping[user] != base.mapping[user]
        ]
        ranked = sorted(
            proposals,
            key=lambda row: (
                -(
                    float.fromhex(rows_by_user_action[(user, row.mapping[user])].c1_label_normalized_hex)
                    + float.fromhex(rows_by_user_action[(user, row.mapping[user])].c2_label_normalized_hex)
                ),
                row.configuration_id,
            ),
        )[: ENGINE.TOP_PROPOSALS]
        top_ids.extend(row.configuration_id for row in ranked)
    allowed = [base] + [row for row in unilateral if row.configuration_id in top_ids]
    allowed.extend(
        row for row in catalogue
        if row.changed_users > 1
        and all(
            any(
                proposal.mapping[user] == identity
                for proposal in unilateral
                if proposal.configuration_id in top_ids
            )
            for user, identity in row.assignments
            if identity != base.mapping[user]
        )
    )
    evaluator.evaluate_many(tuple(allowed))
    allowed = [
        row for row in allowed if row.configuration_id not in evaluator._invalid
    ]
    return min(
        allowed,
        key=lambda row: (-evaluator.evaluate(row).bits, row.configuration_id),
    )


def _select_for_anchor(
    anchor_name, anchor, catalogue, exact, models, rows_by_user_action,
    tape, step_index, exact_s0,
):
    selections = {}
    diagnostics = {}
    legal_catalogue = [row for row in catalogue if row.configuration_id in exact]
    contexts = {}
    for config in legal_catalogue:
        if len(exact[config.configuration_id]["changed"]) >= 2:
            contexts[config.configuration_id] = _coalition_context(
                tape=tape, step_index=step_index, anchor=anchor,
                selected=config, rows_by_user_action=rows_by_user_action,
            )
    for seed in LEARNER_SEEDS:
        exact_scores = []
        additive_scores = []
        learned_scores_by_arm = {arm: [] for arm in PILOT_ARMS}
        deltas_by_arm = {}
        c2_tie_pairs = 0
        c2_eligible_pairs = 0
        for arm in PILOT_ARMS:
            model = models[(seed, arm)]
            deltas = {}
            for (user, action), row in rows_by_user_action.items():
                reference = rows_by_user_action[(user, anchor.mapping[user])]
                q2_delta = model.q2.score(row.q2_state) - model.q2.score(reference.q2_state)
                deltas[(user, action)] = (
                    model.q1.score(row.q1_state) - model.q1.score(reference.q1_state)
                    + q2_delta
                )
                if arm == "FULL" and action != anchor.mapping[user]:
                    c2_eligible_pairs += 1
                    c2_tie_pairs += int(q2_delta == 0.0)
            deltas_by_arm[arm] = deltas
        c2_tie_fraction = (
            c2_tie_pairs / c2_eligible_pairs if c2_eligible_pairs else None
        )
        for config in legal_catalogue:
            context = contexts.get(config.configuration_id)
            full_additive = math.fsum(
                deltas_by_arm["FULL"][(user, config.mapping[user])]
                for user in anchor.mapping
            )
            exact_scores.append((full_additive + exact[config.configuration_id]["psi"], config.configuration_id, config))
            additive_scores.append((full_additive, config.configuration_id, config))
            for arm in PILOT_ARMS:
                model = models[(seed, arm)]
                score = math.fsum(
                    deltas_by_arm[arm][(user, config.mapping[user])]
                    for user in anchor.mapping
                )
                if context is not None:
                    score += model.interaction(context)
                learned_scores_by_arm[arm].append((score, config.configuration_id, config))
        exact_choice = min(exact_scores, key=lambda row: (-row[0], row[1]))[2]
        additive_choice = min(additive_scores, key=lambda row: (-row[0], row[1]))[2]
        selections[(seed, "S0")] = exact_s0
        for arm in PILOT_ARMS:
            selections[(seed, arm)] = min(
                learned_scores_by_arm[arm], key=lambda row: (-row[0], row[1])
            )[2]
        diagnostics[seed] = {
            "top_choice_agreement": selections[(seed, "FULL")].assignments == exact_choice.assignments,
            "additive_choice": additive_choice,
            "exact_choice": exact_choice,
            "anchor": anchor_name,
            # Minimal-pilot C2 tie statistic: over the FULL arm, the fraction of
            # non-incumbent (user, action) candidates whose C2 head score is
            # exactly equal to the incumbent's, i.e. C2 cannot discriminate the
            # move at all and the ranking falls through to C1 + the tie-break.
            "c2_tie": c2_tie_fraction,
            "c2_tie_pairs": c2_tie_pairs,
            "c2_eligible_pairs": c2_eligible_pairs,
        }
    return selections, diagnostics


def evaluate(output: Path, calibration, model_payloads, batches):
    phase_started = time.perf_counter()
    cpu_started = time.process_time()
    print(json.dumps({"artifact_label": LABEL, "phase": "evaluation",
                      "event": "restore_models_start"}), flush=True)
    models = _restore_models(model_payloads, batches)
    setting = ENGINE._setting("a-r0")
    run_setting = ENGINE.run_setting_for("a-r0")
    records = []
    phase_latencies = []
    for world_offset, domain in enumerate(EVALUATION_WORLDS, start=3):
        tape_started = time.perf_counter()
        print(json.dumps({"artifact_label": LABEL, "phase": "evaluation",
                          "event": "tape_build_start", "world": domain,
                          "steps": EVAL_TAPE_STEPS}), flush=True)
        tape = build_world_tape(
            domain=domain,
            provider=LegacyWorldProvider(role="pilot-evaluation"),
            steps=EVAL_TAPE_STEPS,
            start_time_s=0.0,
        )
        print(json.dumps({"artifact_label": LABEL, "phase": "evaluation",
                          "event": "tape_build_done", "world": domain,
                          "wall_s": time.perf_counter() - tape_started}), flush=True)
        anchor_index = 0
        for step_index in range(EVAL_ANCHOR_STEPS):
            for carrier in ENGINE.REFERENCE_CARRIERS[:EVAL_CARRIER_LIMIT]:
                anchor_started = time.perf_counter()
                feature_started = time.perf_counter()
                built = _build_anchor_rows(
                    tape=tape,
                    setting=setting,
