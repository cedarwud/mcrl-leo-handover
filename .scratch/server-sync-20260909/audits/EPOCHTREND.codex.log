                exact_s0 = _exact_s0_boundary0(
                    carrier_base, standard_catalogue, current, rows
                )
                standard_wall = time.perf_counter() - standard_started
                u, u_iterations, u_wall, u_missed, u_certificate = ENGINE._s_uni_select(
                    base=carrier_base,
                    incumbent=incumbent,
                    tape=tape,
