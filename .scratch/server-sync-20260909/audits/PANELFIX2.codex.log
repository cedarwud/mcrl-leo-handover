"""Named encoder-variant seam for the Stage-C per-action feature vectors.

Everything about *which* scalars enter ``q1_state``/``q2_state``, in what
order and at what frozen scale lives behind a named :class:`EncoderVariant`.
Row building, serialization, read-back, training and evaluation discover the
feature width and the schema digests from the variant, so no downstream module
hardcodes 16 or 22.

Registration invariants that make a row impossible to misattribute:

* every variant's ``(q1_schema_sha256, q2_schema_sha256)`` pair is unique --
  registration fails loudly on collision, so the digests a row already carries
  resolve back to exactly one variant name via :func:`variant_for_digests`;
* the *default* variant's schema payload is byte-frozen (it omits the
  ``encoder_variant`` key) because its digests are already published in sealed
  shards, checkpoints and terminal reports.  Every other variant carries its
  name inside the hashed payload, which is what makes the pair unique by
  construction.

The extractor callables take one engine-neutral action evaluation and are only
ever read attribute-wise, so this module deliberately imports nothing from
``state`` -- that is what keeps the import graph acyclic.
"""

from __future__ import annotations

from dataclasses import dataclass, field
import importlib
import math
import os
from typing import Callable, Mapping, Sequence

from .canonical import StageCContractError, canonical_sha256, float_hex


Q1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
Q2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"

#: The production encoder as shipped in contract v1.  Selecting it must yield
#: rows byte-identical to the pre-seam code.
DEFAULT_ENCODER_VARIANT = "V025_CONTRACT_V1"

#: Process-wide selection levers used by the comparison runner.  ``_MODULES_ENV``
#: names importable modules whose import side effect is variant registration,
#: so a new variant never requires editing training or evaluation code.
_VARIANT_ENV = "MCRL_STAGEC_ENCODER_VARIANT"
_MODULES_ENV = "MCRL_STAGEC_ENCODER_MODULES"
_DEFAULT_PLUGIN_MODULES = ("mcrl.stagec_v025.encoder_variants",)


@dataclass(frozen=True, slots=True)
class FeatureSpec:
    name: str
    unit: str
    scale: float


def _schema_payload(
    version: str, features: Sequence[FeatureSpec], *, variant: str
) -> dict[str, object]:
    payload: dict[str, object] = {
        "schema": version,
        "normalization": "raw_value / positive_frozen_scale; signed values retained",
        "shape": [len(features)],
        "features": [
            {"name": item.name, "unit": item.unit, "scale_hex": float_hex(item.scale)}
            for item in features
        ],
        "removed": ["recurrence_power", "entry_gain_ratio", "segment_age"],
    }
    if variant != DEFAULT_ENCODER_VARIANT:
        # Deliberate asymmetry: the default payload is frozen byte-for-byte
        # because its digest is already sealed into published artefacts.  Any
        # other variant binds its name into the hashed payload, which makes the
        # digest pair unique by construction rather than by luck.
        payload["encoder_variant"] = variant
    return payload


def _normalize(
    raw: Sequence[float], specs: Sequence[FeatureSpec]
) -> tuple[float, ...]:
    if len(raw) != len(specs):
        raise StageCContractError("state field count disagrees with schema")
    result = tuple(float(value) / spec.scale for value, spec in zip(raw, specs, strict=True))
    if not all(math.isfinite(value) for value in result):
        raise StageCContractError("state values must be finite")
    return result


@dataclass(frozen=True, slots=True)
class EncoderVariant:
    """One named way of turning an action evaluation into the two vectors."""

    name: str
    q1_features: tuple[FeatureSpec, ...]
    q2_features: tuple[FeatureSpec, ...]
    q1_raw: Callable[[object], Sequence[float]]
    q2_raw: Callable[[object], Sequence[float]]
    q1_schema: Mapping[str, object] = field(repr=False)
    q2_schema: Mapping[str, object] = field(repr=False)
    q1_schema_sha256: str = ""
    q2_schema_sha256: str = ""

    @property
    def q1_width(self) -> int:
        return len(self.q1_features)

    @property
    def q2_width(self) -> int:
        return len(self.q2_features)

    def encode_q1(self, action: object) -> tuple[float, ...]:
        return _normalize(self.q1_raw(action), self.q1_features)

    def encode_q2(self, action: object) -> tuple[float, ...]:
        return _normalize(self.q2_raw(action), self.q2_features)

    def schema_manifest(self) -> dict[str, object]:
        return {
            "q1": {**self.q1_schema, "sha256": self.q1_schema_sha256},
            "q2": {**self.q2_schema, "sha256": self.q2_schema_sha256},
        }


_REGISTRY: dict[str, EncoderVariant] = {}
_DIGEST_INDEX: dict[tuple[str, str], str] = {}


def register_encoder_variant(
    name: str,
    *,
    q1_features: Sequence[FeatureSpec],
    q2_features: Sequence[FeatureSpec],
    q1_raw: Callable[[object], Sequence[float]],
    q2_raw: Callable[[object], Sequence[float]],
) -> EncoderVariant:
    """Register one named encoder.  Collisions are contract errors, not warnings."""

    if not name or not name.isascii() or name != name.strip() or " " in name:
        raise StageCContractError("encoder variant name must be a bare ASCII token")
    if name in _REGISTRY:
        raise StageCContractError(f"encoder variant {name!r} is already registered")
    q1 = tuple(q1_features)
    q2 = tuple(q2_features)
    if not q1 or not q2:
        raise StageCContractError("encoder variant must define both feature vectors")
    for spec in (*q1, *q2):
        if not math.isfinite(spec.scale) or spec.scale <= 0.0:
            raise StageCContractError("feature scales must be positive and finite")
    q1_schema = _schema_payload(Q1_SCHEMA_VERSION, q1, variant=name)
    q2_schema = _schema_payload(Q2_SCHEMA_VERSION, q2, variant=name)
    variant = EncoderVariant(
        name=name,
        q1_features=q1,
        q2_features=q2,
        q1_raw=q1_raw,
        q2_raw=q2_raw,
        q1_schema=q1_schema,
        q2_schema=q2_schema,
        q1_schema_sha256=canonical_sha256(q1_schema),
        q2_schema_sha256=canonical_sha256(q2_schema),
    )
    key = (variant.q1_schema_sha256, variant.q2_schema_sha256)
    if key in _DIGEST_INDEX:
        raise StageCContractError(
            f"encoder variant {name!r} shares its q1/q2 schema digests with "
            f"{_DIGEST_INDEX[key]!r}; rows could not be attributed to one encoder"
        )
    _REGISTRY[name] = variant
    _DIGEST_INDEX[key] = name
    return variant


def _load_plugin_modules() -> None:
    raw = os.environ.get(_MODULES_ENV)
    names = (
        tuple(part.strip() for part in raw.split(",") if part.strip())
        if raw
        else _DEFAULT_PLUGIN_MODULES
    )
    for module in names:
        try:
            importlib.import_module(module)
        except ImportError as error:
            raise StageCContractError(
                f"encoder variant module {module!r} is not importable"
            ) from error


def encoder_variant(name: str | None = None) -> EncoderVariant:
    """Resolve a variant by name, importing registration modules if needed."""

    wanted = DEFAULT_ENCODER_VARIANT if name is None else str(name)
    if wanted not in _REGISTRY:
        _load_plugin_modules()
    if wanted not in _REGISTRY:
        raise StageCContractError(
            f"unknown encoder variant {wanted!r}; registered: "
            f"{', '.join(sorted(_REGISTRY)) or '<none>'}"
        )
    return _REGISTRY[wanted]


def active_encoder_variant() -> EncoderVariant:
    """The variant selected for this process, defaulting to production."""

    return encoder_variant(os.environ.get(_VARIANT_ENV) or DEFAULT_ENCODER_VARIANT)


def variant_for_digests(q1_schema_sha256: str, q2_schema_sha256: str) -> EncoderVariant:
    """Resolve the encoder a persisted row was built with.  Never guesses."""

    key = (str(q1_schema_sha256), str(q2_schema_sha256))
    if key not in _DIGEST_INDEX:
        _load_plugin_modules()
    if key not in _DIGEST_INDEX:
        raise StageCContractError(
            "state schema digests do not match any registered encoder variant"
        )
    return _REGISTRY[_DIGEST_INDEX[key]]


def registered_encoder_variants() -> tuple[str, ...]:
    return tuple(sorted(_REGISTRY))


__all__ = [
    "DEFAULT_ENCODER_VARIANT",
    "EncoderVariant",
    "FeatureSpec",
    "Q1_SCHEMA_VERSION",
    "Q2_SCHEMA_VERSION",
    "active_encoder_variant",
    "encoder_variant",
    "register_encoder_variant",
    "registered_encoder_variants",
    "variant_for_digests",
]
"""Non-production encoder variants.

Importing this module is the entire cost of adding a variant: no training code,
no evaluation arm, no serialization constant and no schema version changes.
The comparison runner imports it through ``MCRL_STAGEC_ENCODER_MODULES``.
"""

from __future__ import annotations

from .encoders import FeatureSpec, register_encoder_variant
from .state import Q1_FEATURES, Q2_FEATURES, default_q1_raw, default_q2_raw


IDENTITY_PLUS_ZERO_NAME = "IDENTITY_PLUS_ZERO"

#: Deliberately meaningless: one always-zero scalar appended to each vector.
#: It exists only to prove the seam carries a width change end to end without
#: prejudging any real encoder repair.  It must never be used for a claim.
_PAD = FeatureSpec("identity_plus_zero_pad", "constant", 1.0)


IDENTITY_PLUS_ZERO = register_encoder_variant(
    IDENTITY_PLUS_ZERO_NAME,
    q1_features=(*Q1_FEATURES, _PAD),
    q2_features=(*Q2_FEATURES, _PAD),
    q1_raw=lambda item: (*default_q1_raw(item), 0.0),
    q2_raw=lambda item: (*default_q2_raw(item), 0.0),
)


__all__ = ["IDENTITY_PLUS_ZERO", "IDENTITY_PLUS_ZERO_NAME"]
    ) -> tuple[tuple[tuple[str, str, float], ...], float]:
        """Top-K by magnitude, returned in canonical key order plus residual sum."""

        ranked = sorted(
            self.pairwise_cross_gain_terms,
            key=lambda row: (-abs(row[2]), row[0], row[1]),
        )
        retained = tuple(
            sorted(
                ranked[:PAIRWISE_CROSS_GAIN_TOP_K],
                key=lambda row: (row[0], row[1]),
            )
        )
        residual_sum = math.fsum(row[2] for row in ranked[PAIRWISE_CROSS_GAIN_TOP_K:])
        return retained, residual_sum

    def pairwise_cross_gain_vector(self) -> np.ndarray:
        """Fixed-width ordered pair block used by the interaction encoder."""

        retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
        block = np.zeros((PAIRWISE_CROSS_GAIN_TOP_K, 4), dtype=np.float64)
        for index, (source, target, gain) in enumerate(retained):
            block[index] = (
                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
                gain,
                1.0,
            )
        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))

    def invariant_vector(self, *, member_width: int) -> np.ndarray:
        """DeepSets-style deterministic encoding; IDs/order are not features."""

        if len(self.members) <= 1:
            # Empty and singleton values are hard anchored by the head, but a
            # stable vector remains useful for schema and KAT checks.
            member_matrix = np.zeros((1, member_width), dtype=np.float64)
        else:
            member_matrix = np.asarray(
                [member.invariant_features for member in self.members],
                dtype=np.float64,
            )
            if member_matrix.shape[1] != member_width:
                raise StageCContractError("coalition member feature width drifted")
        beams = tuple(sorted(self.affected_beams, key=lambda beam: beam.beam_key))
        beam_features = np.asarray([
            [
                beam.occupancy_before,
                beam.occupancy_after,
                float(beam.active_after) - float(beam.active_before),
                beam.shared_capacity,
                beam.interference_summary,
                beam.capacity_margin,
                1.0,
            ]
            for beam in beams
        ], dtype=np.float64)
        beam_pool = np.concatenate(
            (
                beam_features.sum(axis=0),
                beam_features.max(axis=0),
                beam_features.min(axis=0),
                beam_features.mean(axis=0),
            )
        )
        vector = np.concatenate(
            (
                np.asarray([float(len(self.members))], dtype=np.float64),
                member_matrix.sum(axis=0),
                member_matrix.max(axis=0),
                beam_pool,
                self.pairwise_cross_gain_vector(),
                np.asarray(self.global_resource_features, dtype=np.float64),
            )
        )
        if not np.isfinite(vector).all():
            anchor_index=anchor_index,
            anchor=base,
            selected=selected,
            evaluator=current,
            rows_by_user_action=rows_by_user_action,
            calibration=calibration,
            run_setting=run_setting,
        )
    return {
        "base": base,
        "incumbent": incumbent,
        "rows": tuple(source_rows),
        "rows_by_user_action": rows_by_user_action,
        "current_evaluator": current,
        "coalition_row": coalition_row,
        "census": census,
        "skipped_invalid": skipped_invalid,
        "catalogue_count": catalogue_count,
        "physics_calls": counter.boundary_evaluations,
    }


_CROSS_GAIN_CACHE = {}


def _cross_gain_terms(tape, step_index: int, affected: Sequence[tuple[int, int]]):
    step = tape.steps[step_index]
    if step.arrays is None:
        return ()
    arrays = step.arrays
    cache_key = (tape.seed, step_index)
    cached = _CROSS_GAIN_CACHE.get(cache_key)
    if cached is None:
        aggressors = {
            tuple(int(value) for value in identity): index
            for index, identity in enumerate(arrays.aggressor_identities)
        }
        victim_columns = {}
        for row, identity in enumerate(arrays.identities.tolist()):
            key = tuple(int(value) for value in identity)
            victim_columns.setdefault(key, []).append(
                int(arrays.row_user_column[row])
            )
        cached = (aggressors, victim_columns, {})
        _CROSS_GAIN_CACHE[cache_key] = cached
    aggressors, victim_columns, pair_cache = cached
    result = []
    for source, target in itertools.permutations(sorted(set(affected)), 2):
        relation = (source, target)
        gain = pair_cache.get(relation)
        if gain is None:
            column = aggressors.get(source)
            gain = 0.0 if column is None else max(
                (
                    float(arrays.cross_base_nominal[0, user, column])
                    for user in victim_columns.get(target, ())
                ),
                default=0.0,
            )
            pair_cache[relation] = gain
        result.append((f"{source[0]}:{source[1]}", f"{target[0]}:{target[1]}", gain))
    return tuple(result)


def _coalition_context(*, tape, step_index, anchor, selected, rows_by_user_action):
    changed = tuple(
        user for user in sorted(anchor.mapping) if selected.mapping[user] != anchor.mapping[user]
    )
    members = tuple(
        CoalitionMember(
            user_id=user,
            reference_action=_physical_action(anchor.mapping[user]),
            selected_action=_physical_action(selected.mapping[user]),
            selected_q1_row=rows_by_user_action[(user, selected.mapping[user])].q1_state,
            incumbent_q1_row=rows_by_user_action[(user, anchor.mapping[user])].q1_state,
            missing_incumbent=rows_by_user_action[(user, selected.mapping[user])].outage,
        )
        for user in changed
    )
    affected = sorted(
        {
            identity
            for user in changed
            for identity in (anchor.mapping[user], selected.mapping[user])
            if identity is not None
        }
    )
    before_counts: dict[tuple[int, int], int] = {}
    after_counts: dict[tuple[int, int], int] = {}
    for identity in anchor.mapping.values():
        if identity is not None:
            before_counts[identity] = before_counts.get(identity, 0) + 1
    for identity in selected.mapping.values():
        if identity is not None:
            after_counts[identity] = after_counts.get(identity, 0) + 1
    relations = _cross_gain_terms(tape, step_index, affected)
    beams = tuple(
        AffectedBeamContext(
            beam_key=f"{identity[0]}:{identity[1]}",
            occupancy_before=before_counts.get(identity, 0),
            occupancy_after=after_counts.get(identity, 0),
            active_before=before_counts.get(identity, 0) > 0,
            active_after=after_counts.get(identity, 0) > 0,
            shared_capacity=1.0,
            interference_summary=math.fsum(
                gain for _source, target, gain in relations if target == f"{identity[0]}:{identity[1]}"
            ),
            capacity_margin=float(10 - after_counts.get(identity, 0)),
        )
        for identity in affected
    )
    return CoalitionContext(
        anchor_id=f"{tape.domain}|{step_index}|{anchor.configuration_id}",
        reference_profile=tuple(
            (user, _physical_action(identity)) for user, identity in anchor.assignments
        ),
        members=members,
        affected_beams=beams,
        global_resource_features=(
            len(changed) / max(1, len(anchor.assignments)),
            len(affected) / max(1, len(anchor.assignments)),
            math.fsum(before_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(after_counts.values()) / max(1, len(anchor.assignments)),
            math.fsum(gain for _source, _target, gain in relations),
            max((gain for _source, _target, gain in relations), default=0.0),
        ),
        pairwise_cross_gain_terms=relations,
    )


def _coalition_row(
    *, tape, step_index, carrier, anchor_index, anchor, selected, evaluator,
    rows_by_user_action, calibration, run_setting,
):
    context = _coalition_context(
        tape=tape,
        step_index=step_index,
        anchor=anchor,
        selected=selected,
        rows_by_user_action=rows_by_user_action,
    )
    reference = evaluator.evaluate(anchor).outcome(
        phi=ENGINE._phi_for(anchor, anchor)
    )
    unilateral = {}
    for user in context.changed_users:
        mapping = anchor.mapping
        mapping[user] = selected.mapping[user]
        config = ENGINE._configuration(anchor, mapping, kind="pilot-coalition-singleton")
        unilateral[user] = evaluator.evaluate(config).outcome(
            phi=ENGINE._phi_for(anchor, config)
            if member["selected_q1_row_hex"] != old_selected:
                raise RuntimeError("coalition selected Q1 row differs from source parent")
            if member["incumbent_q1_row_hex"] != old_reference:
                raise RuntimeError("coalition incumbent Q1 row differs from source parent")
            member["selected_q1_row_hex"] = new_selected
            member["incumbent_q1_row_hex"] = new_reference
            replacements += 2
    header = {
        **header,
        "context_payloads_sha256": canonical_sha256(
            [row["context"] for row in rows]
        ),
        "rows_sha256": canonical_sha256(rows),
    }
    digest = write_jsonl(destination, [header, *rows])
    return digest, len(rows), replacements


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def install_reader_adapter(runner: object) -> dict[str, object]:
    import mcrl.stagec_v025.encoders as encoders

    default = encoders.encoder_variant()
    name = "CORPUS_Q1_V2_READER_ADAPTER"
    key = (q1v2.Q1_V2_SCHEMA_SHA256, default.q2_schema_sha256)
    if name in encoders._REGISTRY or key in encoders._DIGEST_INDEX:
        raise RuntimeError("reader adapter registration unexpectedly pre-exists")
    q1_features = tuple(
        encoders.FeatureSpec(item.name, item.unit, item.scale)
        for item in q1v2.Q1_V2_FEATURES
    )
    variant = encoders.EncoderVariant(
        name=name,
        q1_features=q1_features,
        q2_features=default.q2_features,
        q1_raw=lambda _item: (),
        q2_raw=default.q2_raw,
        q1_schema=q1v2.Q1_V2_SCHEMA,
        q2_schema=default.q2_schema,
        q1_schema_sha256=q1v2.Q1_V2_SCHEMA_SHA256,
        q2_schema_sha256=default.q2_schema_sha256,
    )
    encoders._REGISTRY[name] = variant
    encoders._DIGEST_INDEX[key] = name
    resolved = runner.variant_for_digests(*key)
    if resolved is not variant:
        raise RuntimeError("production reader did not resolve the v2 adapter")
    return {
        "name": name,
        "method": "in-process registration in the production runner's encoder registry",
        "persistent_source_edits": False,
        "q1_schema_sha256": variant.q1_schema_sha256,
        "q2_schema_sha256": variant.q2_schema_sha256,
        "q1_width": variant.q1_width,
        "q2_width": variant.q2_width,
    }


