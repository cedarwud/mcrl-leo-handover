    for checkpoint in result["checkpoints"]:
        check = checkpoint["knockout_check"]
        lines.append(
            f"| {checkpoint['checkpoint']['completed_source_epochs']} | {checkpoint['checkpoint']['learner_seed']} | "
            f"{check['differing_anchor_count']} | {check['anchor_count']} | {_fmt(check['pooled_ee_difference_bits_per_j'])} |"
        )
    lines.extend([
        "",
        "## F6 — five-arm ablation",
        "",
        "Reference for the primary contrast is `ALL_NEUTRAL_CONTROL`, never `BASE`. Values are pooled on the full-buffer numerator with no demand cap.",
        "",
        "| epoch | arm/contrast | pooled EE or difference (bit/J) | relative difference | primary interpretation |",
        "|---:|---|---:|---:|---|",
    ])
    for row in result["tables"]["F6_ablation"]:
        label = row.get("arm", row.get("contrast"))
        value = row.get("pooled_ee_bits_per_j", row.get("difference_bits_per_j"))
        lines.append(
            f"| {row['completed_source_epochs']} | {label} | {_fmt(value)} | {_fmt(row.get('relative_difference'))} | "
            f"{row.get('primary_interpretation', '')} |"
        )
    lines.extend([
        "",
        "## F7 — training trajectory",
        "",
        "| epoch | arm | pooled EE (bit/J) | target attainment | availability | handover rate | deadline-miss rate |",
        "|---:|---|---:|---:|---:|---:|---:|",
    ])
    for row in result["tables"]["F7_training_trajectory"]:
        lines.append(
            f"| {row['completed_source_epochs']} | {row['arm']} | {_fmt(row['pooled_ee_bits_per_j'])} | "
            f"{_fmt(row['rate_target_attainment'])} | {_fmt(row['service_availability'])} | "
            f"{_fmt(row['handover_rate'])} | {_fmt(row['deadline_miss_rate'])} |"
        )
    lines.extend([
        "",
        "## F8 — recovered fraction under the 10-second coordinator budget",
        "",
        f"Certified reference: {panel['references']['certified_fixed_point']['construction']} "
        f"(information class: {panel['references']['certified_fixed_point']['information_class']}). "
        f"Anytime comparator: {panel['references']['anytime_incumbent']['construction']} "
        f"(information class: {panel['references']['anytime_incumbent']['information_class']}).",
        "",
        "| epoch | arm | arm/fixed point | anytime/fixed point | arm − anytime (bit/J) | physics evals | wall time | budget status |",
        "|---:|---|---:|---:|---:|---:|---:|---|",
    ])
    for row in result["tables"]["F8_recovered_fraction"]:
        lines.append(
            f"| {row['completed_source_epochs']} | {row['arm']} | {_fmt(row['attained_ee_fraction_of_certified_fixed_point'])} | "
            f"{_fmt(row['anytime_incumbent_fraction_of_certified_fixed_point'])} | {_fmt(row['arm_minus_anytime_bits_per_j'])} | "
            f"{_fmt(row['physics_evaluations_consumed'])} | {_fmt(row['wall_clock_to_decision_mean_s'])} | "
            f"{row['budget_compliance_status']} |"
        )
    if not panel["instrumentation_recorded"]:
