        "",
        "- Derived on paper: differences, relative differences, and EE fractions are deterministic arithmetic on the verified pooled numerators and denominators.",
        "",
        "- Inferred: only the cross-checkpoint knockout classification is an interpretation of decision equality. No source-substitution claim is made when equality holds everywhere.",
        "",
    ])
    return "\n".join(lines)


def run(checkpoint_paths: Sequence[Path], panel_path: Path | None, output: Path, smoke: bool) -> dict[str, object]:
    if output.exists():
        raise ScorerContractError(f"output directory already exists: {output}")
    checkpoints = [_load_checkpoint(path) for path in _discover_checkpoints(checkpoint_paths)]
    widths = checkpoints[0]["widths"]
    if any(checkpoint["widths"] != widths for checkpoint in checkpoints[1:]):
        raise ScorerContractError("checkpoint model-input schemas differ")
    if smoke:
        if len(checkpoints) != 1 or checkpoints[0]["sha256"] != SMOKE_CHECKPOINT_SHA256:
            raise ScorerContractError("--smoke-fixture requires the declared bcf99d... fixture checkpoint")
        panel_raw = _smoke_panel(widths)
    else:
        if panel_path is None:
            raise ScorerContractError("production scoring requires --panel")
        panel_raw = _read_json(panel_path)
    panel = _validate_panel(panel_raw, widths, panel_path)
    scored = [_score_checkpoint(checkpoint, panel) for checkpoint in checkpoints]
    label, all_coincide = _classification(scored)
    f6 = [row for checkpoint in scored for row in checkpoint["axis_a"]]
    f7 = [row for row in f6 if row["row_type"] == "arm"]
    f8 = [row for checkpoint in scored for row in checkpoint["axis_b"]]
    result = {
        "schema": RESULT_SCHEMA,
        "scorer": str(Path(__file__).resolve()),
        "scorer_sha256": _sha256(Path(__file__)),
        "panel": {key: panel[key] for key in (
            "path", "sha256", "identity", "references", "instrumentation",
            "instrumentation_recorded", "synthetic_smoke_not_evidence",
