    _write_csv(output / "F6-ablation.csv", f6)
    _write_csv(output / "F7-training-trajectory.csv", f7)
    _write_csv(output / "F8-recovered-fraction.csv", f8)
    _write_bytes_once(output / "report.md", _build_report(result).encode("utf-8"))
    return result


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--checkpoints", type=Path, nargs="+", required=True)
    parser.add_argument("--panel", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--smoke-fixture", action="store_true")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    try:
        _enforce_resources()
        args = build_parser().parse_args(argv)
        if args.smoke_fixture == (args.panel is not None):
            raise ScorerContractError("choose exactly one of --panel or --smoke-fixture")
        result = run(args.checkpoints, args.panel, args.output.resolve(), args.smoke_fixture)
        print(json.dumps({
            "event": "dual-axis-scoring-complete",
            "checkpoints": len(result["checkpoints"]),
            "F6_rows": len(result["tables"]["F6_ablation"]),
            "F7_rows": len(result["tables"]["F7_training_trajectory"]),
            "F8_rows": len(result["tables"]["F8_recovered_fraction"]),
            "primary_interpretation": result["primary_contrast_interpretation"],
        }, sort_keys=True), flush=True)
        return 0
    except ScorerContractError as error:
        print(f"SCORER_CONTRACT_ERROR: {error}", file=sys.stderr, flush=True)
        return 2
    finally:
        print(f"PEAK_RSS_BYTES={_peak_rss_bytes()}", flush=True)


if __name__ == "__main__":
    raise SystemExit(main())

