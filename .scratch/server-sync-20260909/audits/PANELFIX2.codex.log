COALITION_CONTEXT_SCHEMA = "mcrl-v025-stagec-c3-coalition-context-v2"
COALITION_ROW_SCHEMA = "mcrl-v025-stagec-c3-coalition-row-v2"
COALITION_SHARD_SCHEMA = "mcrl-v025-stagec-c3-coalition-shard-v2"
PAIRWISE_CROSS_GAIN_TOP_K = 32
MAX_LABEL_COALITION_SIZE = 4


@dataclass(frozen=True, slots=True)
class CoalitionMember:
    user_id: int
    reference_action: PhysicalAction
    selected_action: PhysicalAction
    selected_q1_row: tuple[float, ...]
    incumbent_q1_row: tuple[float, ...]
    missing_incumbent: bool

    def __post_init__(self) -> None:
        if (
            not self.selected_q1_row
            or len(self.selected_q1_row) != len(self.incumbent_q1_row)
            or not all(
                math.isfinite(value)
                for value in (*self.selected_q1_row, *self.incumbent_q1_row)
            )
        ):
            raise StageCContractError("selected and incumbent Q1 rows must be finite and aligned")

    @property
    def invariant_features(self) -> tuple[float, ...]:
        def identity(action: PhysicalAction) -> tuple[float, float]:
            if action.is_null:
                return (-1.0, -1.0)
            assert action.norad_id is not None and action.beam_chain_id is not None
            return (
                int.from_bytes(hashlib.sha256(f"sat:{action.norad_id}".encode()).digest()[:8], "big") / 2**64,
                int.from_bytes(hashlib.sha256(f"beam:{action.beam_chain_id}".encode()).digest()[:8], "big") / 2**64,
            )

        reference_identity = identity(self.reference_action)
        selected_identity = identity(self.selected_action)
        return (
            *self.selected_q1_row,
            *self.incumbent_q1_row,
            float(self.missing_incumbent),
            *reference_identity,
            *selected_identity,
            float(self.reference_action != self.selected_action),
        )


@dataclass(frozen=True, slots=True)
class AffectedBeamContext:
    beam_key: str
    occupancy_before: int
    occupancy_after: int
    active_before: bool
    active_after: bool
    shared_capacity: float
    interference_summary: float
    capacity_margin: float = 0.0

    def __post_init__(self) -> None:
        if self.occupancy_before < 0 or self.occupancy_after < 0:
            raise StageCContractError("coalition occupancy must be nonnegative")
        if self.shared_capacity < 0.0 or not all(
            math.isfinite(value)
            for value in (self.shared_capacity, self.interference_summary, self.capacity_margin)
        ):
            raise StageCContractError("coalition shared-resource context is invalid")


@dataclass(frozen=True, slots=True)
class CoalitionContext:
    anchor_id: str
    reference_profile: tuple[tuple[int, PhysicalAction], ...]
    members: tuple[CoalitionMember, ...]
    affected_beams: tuple[AffectedBeamContext, ...]
    global_resource_features: tuple[float, ...]
    pairwise_cross_gain_terms: tuple[tuple[str, str, float], ...] = ()

    def __post_init__(self) -> None:
        reference_users = tuple(user for user, _ in self.reference_profile)
        member_users = tuple(member.user_id for member in self.members)
        if (
            not reference_users
            or reference_users != tuple(sorted(reference_users))
            or len(set(reference_users)) != len(reference_users)
        ):
            raise StageCContractError("coalition a0 must be a complete sorted user profile")
        if len(set(member_users)) != len(member_users) or not set(member_users) <= set(reference_users):
            raise StageCContractError("changed users must be unique members of a0")
        if not self.affected_beams:
            raise StageCContractError("coalition context requires affected resource rows")
        if not self.global_resource_features or not all(
            math.isfinite(value) for value in self.global_resource_features
        ):
            raise StageCContractError("global coalition features must be finite and nonempty")
        widths = {len(member.invariant_features) for member in self.members}
        if len(widths) > 1:
            raise StageCContractError("coalition member feature widths differ")
        beam_keys = {beam.beam_key for beam in self.affected_beams}
        if any(
            source not in beam_keys
            or target not in beam_keys
            or source == target
            or not math.isfinite(gain)
            or gain < 0.0
            for source, target, gain in self.pairwise_cross_gain_terms
        ):
            raise StageCContractError("pairwise cross-gain relation context is invalid")
        relation_keys = [(source, target) for source, target, _gain in self.pairwise_cross_gain_terms]
        if len(relation_keys) != len(set(relation_keys)):
            raise StageCContractError("pairwise cross-gain relation keys must be unique")
        object.__setattr__(
            self,
            "pairwise_cross_gain_terms",
            tuple(sorted(self.pairwise_cross_gain_terms, key=lambda row: (row[0], row[1]))),
        )

    @property
    def changed_users(self) -> tuple[int, ...]:
        return tuple(sorted(member.user_id for member in self.members))

    @property
    def payload_sha256(self) -> str:
        return canonical_sha256(self.payload())

    def payload(self) -> dict[str, object]:
        _retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
        return {
            "context_schema": COALITION_CONTEXT_SCHEMA,
            "anchor_id": self.anchor_id,
            "reference_profile": [
                {"user_id": user, "action": action.payload()}
                for user, action in self.reference_profile
            ],
            "members": [
                {
                    "user_id": member.user_id,
                    "reference_action": member.reference_action.payload(),
                    "selected_action": member.selected_action.payload(),
                    "selected_q1_row_hex": [
                        float_hex(value) for value in member.selected_q1_row
                    ],
                    "incumbent_q1_row_hex": [
                        float_hex(value) for value in member.incumbent_q1_row
                    ],
                    "missing_incumbent": member.missing_incumbent,
                }
                for member in sorted(self.members, key=lambda item: item.user_id)
            ],
            "affected_beams": [
                {
                    "beam_key": beam.beam_key,
                    "occupancy_before": beam.occupancy_before,
                    "occupancy_after": beam.occupancy_after,
                    "active_before": beam.active_before,
                    "active_after": beam.active_after,
                    "shared_capacity_hex": float_hex(beam.shared_capacity),
                    "interference_summary_hex": float_hex(beam.interference_summary),
                    "capacity_margin_hex": float_hex(beam.capacity_margin),
                }
                for beam in sorted(self.affected_beams, key=lambda item: item.beam_key)
            ],
            "global_resource_features_hex": [
                float_hex(value) for value in self.global_resource_features
            ],
            "pairwise_cross_gain_top_k": PAIRWISE_CROSS_GAIN_TOP_K,
            "pairwise_cross_gain_residual_sum_hex": float_hex(residual_sum),
            "pairwise_cross_gain_terms": [
                {
                    "source_beam_key": source,
                    "target_beam_key": target,
                    "gain_hex": float_hex(gain),
                }
                for source, target, gain in self.pairwise_cross_gain_terms
            ],
        }

    def _bounded_pairwise_cross_gain_terms(
        self,
    ) -> tuple[tuple[tuple[str, str, float], ...], float]:
        """Top-K by magnitude, returned in canonical key order plus residual sum."""

        ranked = sorted(
            self.pairwise_cross_gain_terms,
            key=lambda row: (-abs(row[2]), row[0], row[1]),
        )
        retained = tuple(
            sorted(
                ranked[:PAIRWISE_CROSS_GAIN_TOP_K],
                key=lambda row: (row[0], row[1]),
            )
        )
        residual_sum = math.fsum(row[2] for row in ranked[PAIRWISE_CROSS_GAIN_TOP_K:])
        return retained, residual_sum

    def pairwise_cross_gain_vector(self) -> np.ndarray:
        """Fixed-width ordered pair block used by the interaction encoder."""

        retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
        block = np.zeros((PAIRWISE_CROSS_GAIN_TOP_K, 4), dtype=np.float64)
        for index, (source, target, gain) in enumerate(retained):
            block[index] = (
                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
                gain,
                1.0,
            )
        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))

    def invariant_vector(self, *, member_width: int) -> np.ndarray:
"""Named encoder-variant seam for the Stage-C per-action feature vectors.

Everything about *which* scalars enter ``q1_state``/``q2_state``, in what
order and at what frozen scale lives behind a named :class:`EncoderVariant`.
Row building, serialization, read-back, training and evaluation discover the
feature width and the schema digests from the variant, so no downstream module
hardcodes 16 or 22.

Registration invariants that make a row impossible to misattribute:

* every variant's ``(q1_schema_sha256, q2_schema_sha256)`` pair is unique --
  registration fails loudly on collision, so the digests a row already carries
  resolve back to exactly one variant name via :func:`variant_for_digests`;
* the *default* variant's schema payload is byte-frozen (it omits the
  ``encoder_variant`` key) because its digests are already published in sealed
  shards, checkpoints and terminal reports.  Every other variant carries its
  name inside the hashed payload, which is what makes the pair unique by
  construction.

The extractor callables take one engine-neutral action evaluation and are only
ever read attribute-wise, so this module deliberately imports nothing from
``state`` -- that is what keeps the import graph acyclic.
"""

from __future__ import annotations

from dataclasses import dataclass, field
import importlib
import math
import os
from typing import Callable, Mapping, Sequence

from .canonical import StageCContractError, canonical_sha256, float_hex


Q1_SCHEMA_VERSION = "mcrl-v025-stagec-q1-action-v1"
Q2_SCHEMA_VERSION = "mcrl-v025-stagec-q2-action-v1"

