 succeeded in 0ms:
            seen.add(identity)
    if not unique:
        raise ScorerContractError("no Stage-C checkpoint was found")
    return unique


def _classification(results: Sequence[Mapping[str, object]]) -> tuple[str, bool]:
    all_coincide = all(result["knockout_check"]["coincide_at_every_anchor"] for result in results)
    label = (
        "knockout_contrast_no_source_substitution_claim"
        if all_coincide else "neutral_source_substitution_contrast_decision_separated_from_knockout"
    )
    for result in results:
        for row in result["axis_a"]:
            if row.get("contrast") == "FULL-minus-ALL_NEUTRAL_CONTROL":
                row["primary_interpretation"] = label
    return label, all_coincide


def _flatten(rows: Sequence[Mapping[str, object]]) -> list[dict[str, object]]:
    def scalar(value: object) -> object:
        if isinstance(value, (Mapping, list, tuple)):
            return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
        return value
    return [{key: scalar(value) for key, value in row.items()} for row in rows]


def _write_csv(path: Path, rows: Sequence[Mapping[str, object]]) -> None:
    flat = _flatten(rows)
    fields = []
    for row in flat:
        for key in row:
            if key not in fields:
                fields.append(key)
    if path.exists():
        raise ScorerContractError(f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("x", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="raise")
        writer.writeheader()
        writer.writerows(flat)
        handle.flush()
        os.fsync(handle.fileno())
    temporary.replace(path)


def _fmt(value: object) -> str:
    if value is None:
        return "UNAVAILABLE"
    if isinstance(value, float):
        return f"{value:.10g}"
    return str(value)


