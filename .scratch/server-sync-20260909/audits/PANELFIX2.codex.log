def rebuild_coalition_view(
    source_path: Path,
    destination: Path,
    by_action: dict[tuple[int, int | None, int | None], tuple[list[str], list[str]]],
) -> tuple[str, int, int]:
    verify_sidecar(source_path)
    raw_lines = source_path.read_bytes().splitlines()
    values = [json.loads(line.decode("ascii")) for line in raw_lines]
    if any(line != canonical_bytes(value) for line, value in zip(raw_lines, values, strict=True)):
        raise RuntimeError("parent coalition shard is not canonical JSONL")
    header, rows = values[0], values[1:]
    if header.get("schema") != COALITION_SHARD_SCHEMA:
        raise RuntimeError("parent coalition schema drifted")
    if len(rows) != int(header["row_count"]):
        raise RuntimeError("parent coalition row count drifted")
    replacements = 0
    for row in rows:
        members = row["context"]["members"]
        for member in members:
            user_id = int(member["user_id"])
            selected = action_key(user_id, member["selected_action"])
            reference = action_key(user_id, member["reference_action"])
            try:
                old_selected, new_selected = by_action[selected]
                old_reference, new_reference = by_action[reference]
            except KeyError as error:
                raise RuntimeError("coalition member action absent from source view") from error
            if member["selected_q1_row_hex"] != old_selected:
                raise RuntimeError("coalition selected Q1 row differs from source parent")
            if member["incumbent_q1_row_hex"] != old_reference:
                raise RuntimeError("coalition incumbent Q1 row differs from source parent")
            member["selected_q1_row_hex"] = new_selected
            member["incumbent_q1_row_hex"] = new_reference
            replacements += 2
    header = {
        **header,
        "context_payloads_sha256": canonical_sha256(
            [row["context"] for row in rows]
        ),
        "rows_sha256": canonical_sha256(rows),
    }
    digest = write_jsonl(destination, [header, *rows])
    return digest, len(rows), replacements


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module
