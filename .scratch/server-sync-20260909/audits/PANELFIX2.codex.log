        "loss_values_are_not_ee_evidence": True,
        "tables": {
            "F6_ablation": f6,
            "F7_training_trajectory": f7,
            "F8_recovered_fraction": f8,
        },
        "resource_limits": {
            "python_processes_used": PROCESS_COUNT,
            "max_python_processes": 3,
            "nice": os.getpriority(os.PRIO_PROCESS, 0),
            "blas_threads": {name: os.environ[name] for name in THREAD_VARIABLES},
            "address_space_limit_bytes": MAX_RSS_BYTES,
            "peak_rss_bytes": _peak_rss_bytes(),
        },
    }
    if result["resource_limits"]["peak_rss_bytes"] >= MAX_RSS_BYTES:
        raise MemoryError("peak RSS exceeded the strict per-process bound")
    output.mkdir(parents=True, exist_ok=False)
