    """Deterministic cyclic best responses to a strict local optimum."""

    options, _ = probe._legal_options(tape, step_index)
    base_profile = evaluator.evaluate(base)
    guard = served(base_profile)
    current = base
    iterations = 0
    passes = 0
    comparisons = 0
    terminal: tuple[object, ...] = ()

    while True:
        passes += 1
        pass_moves = 0
        pass_candidates = []
        for user in sorted(options):
            current_profile = evaluator.evaluate(current)
            current_value = objective(current_profile)
            candidates = []
            current_map = current.mapping
            for identity in options[user]:
                if identity == current_map[user]:
                    continue
"""Private diagnostic copy seam for margin-provisioned dense evaluation.

The sealed evaluator is never edited.  Two private functions are compiled from
its installed source after one audited substitution at the provisioning line:
``Gamma`` is divided either by the fading quantile or by an all-ones divisor.
The latter exists solely for the required bit-identity assertion.
"""

from __future__ import annotations

import inspect

import numpy as np

from mcrl.physics_v025 import batch as _sealed


_OLD = "targets = gamma[np.minimum(occupancy, users)]"
_NEW = (
    "provisioning_divisor = (quantile if _USE_MARGIN_QUANTILE "
    "else np.ones_like(quantile))\n"
    "                targets = gamma[np.minimum(occupancy, users)] / provisioning_divisor"
)


def _private_core(*, use_margin_quantile: bool):
    source = inspect.getsource(_sealed._evaluate_ar_tdm_catalogue_core)
    if source.count(_OLD) != 1:
        raise RuntimeError("sealed provisioning seam no longer has the audited shape")
    namespace = dict(vars(_sealed))
    namespace["_USE_MARGIN_QUANTILE"] = use_margin_quantile
    exec(compile(source.replace(_OLD, _NEW), __file__, "exec"), namespace)
    return namespace["_evaluate_ar_tdm_catalogue_core"]


evaluate_ar_tdm_catalogue = _private_core(use_margin_quantile=True)
evaluate_ar_tdm_catalogue_divisor_one = _private_core(use_margin_quantile=False)


__all__ = [
    "evaluate_ar_tdm_catalogue",
    "evaluate_ar_tdm_catalogue_divisor_one",
]
