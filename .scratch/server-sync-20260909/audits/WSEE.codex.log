    def valid(self) -> bool:
        return self.certificate.valid

    @property
    def per_user_wanted_w(self) -> dict[int, float]:
        result: dict[int, float] = {}
        for slot in self.slots:
            for tx in slot.transmissions:
                result[tx.user_id] = result.get(tx.user_id, 0.0) + slot.fraction * tx.wanted_w
        return result

    @property
    def per_user_interference_w(self) -> dict[int, tuple[float, float]]:
        result: dict[int, tuple[float, float]] = {}
        for slot in self.slots:
            for tx in slot.transmissions:
                old = result.get(tx.user_id, (0.0, 0.0))
                result[tx.user_id] = (
                    old[0] + slot.fraction * tx.intra_interference_w,
                    old[1] + slot.fraction * tx.inter_interference_w,
                )
        return result

    @property
    def per_user_rate_target_feasible(self) -> dict[int, bool] | None:
        """Controller feasibility by user, distinct from realised PHY service."""

        rows: dict[int, bool] = {}
        saw_target = False
        for slot in self.slots:
            for tx in slot.transmissions:
                if tx.rate_target_feasible is None:
                    continue
                saw_target = True
                rows[tx.user_id] = rows.get(tx.user_id, True) and tx.rate_target_feasible
        return rows if saw_target or self.rate_target_bps is not None else None

    @property
    def rate_target_attained(self) -> dict[int, bool] | None:
        """Realised achieved-ACM target status over this normalized user-step."""

        transmission_targets = {
            tx.rate_target_bps
            for slot in self.slots
            for tx in slot.transmissions
            if tx.rate_target_bps is not None
        }
        if self.rate_target_bps is None:
            if transmission_targets:
                raise MCRLContractError("non-target radiation contains a rate target")
            return None
        if transmission_targets and transmission_targets != {self.rate_target_bps}:
            raise MCRLContractError("radiation result contains inconsistent rate targets")
        target = self.rate_target_bps
        rates: dict[int, float] = {}
        for slot in self.slots:
            for tx in slot.transmissions:
                rates.setdefault(tx.user_id, 0.0)
                if tx.realised_outcome is None:
                    raise MCRLContractError("ACM transmission lacks a decode outcome")
                if tx.realised_outcome.decoded:
                    rates[tx.user_id] += (
                        slot.fraction
                        * tx.bandwidth_hz
                        * tx.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
                    )
        return {user: rate >= target for user, rate in rates.items()}


class RadiationArchitecture(Protocol):
    code: ArchitectureCode

    def radiate(
        self,
        config: RadiationConfig,
        geometry: Geometry,
        nominal_or_realised: FieldKind,
    ) -> RadiationResult: ...


def _beam_members(geometry: Geometry) -> dict[BeamIdentity, tuple[int, ...]]:
    grouped: dict[BeamIdentity, list[int]] = {}
    for index, link in enumerate(geometry.links):
        grouped.setdefault(link.beam, []).append(index)
    return {
        beam: tuple(sorted(indices, key=lambda index: geometry.links[index].user_id))
        for beam, indices in sorted(grouped.items())
    }


def _tdm_slots(geometry: Geometry) -> tuple[tuple[float, float, tuple[int, ...]], ...]:
    grouped = _beam_members(geometry)
    if not grouped:
        return ((0.0, 1.0, ()),)
    boundaries = {0.0, 1.0}
    for members in grouped.values():
        boundaries.update(offset / len(members) for offset in range(1, len(members)))
    ordered = sorted(boundaries)
    result = []
    for start, end in zip(ordered, ordered[1:]):
        midpoint = (start + end) / 2.0
        active = tuple(
            members[min(int(midpoint * len(members)), len(members) - 1)]
            for members in grouped.values()
        )
        result.append((start, end, active))
    return tuple(result)


def _masked_coupling(
    geometry: Geometry,
    active: tuple[int, ...],
    field: FieldKind,
    overlap: np.ndarray | None = None,
) -> np.ndarray:
    count = len(active)
    coupling = np.zeros((count, count), dtype=np.float64)
    cross = geometry.cross(field)
    for row, victim in enumerate(active):
        victim_link = geometry.links[victim]
        for column, aggressor in enumerate(active):
            aggressor_link = geometry.links[aggressor]
            if victim == aggressor or victim_link.beam == aggressor_link.beam:
                continue
            if victim_link.color != aggressor_link.color:
                continue
            factor = 1.0 if overlap is None else float(overlap[row, column])
            coupling[row, column] = cross[victim, aggressor] * factor
    return coupling


def _solve_power(
    direct: np.ndarray,
    coupling: np.ndarray,
    noise: np.ndarray,
    caps: np.ndarray,
    active_user_ids: tuple[int, ...],
    config: RadiationConfig,
    *,
    target_sinr: np.ndarray | None = None,
    force_cap: np.ndarray | None = None,
    enforce_target_clearance: bool = False,
) -> tuple[np.ndarray, PowerCertificate]:
    """Capped standard-interference fixed point, always initialised at zero."""

    targets = (
        np.full(len(active_user_ids), config.target_sinr, dtype=np.float64)
        if target_sinr is None
        else np.asarray(target_sinr, dtype=np.float64)
    )
    forced = (
        np.zeros(len(active_user_ids), dtype=np.bool_)
        if force_cap is None
        else np.asarray(force_cap, dtype=np.bool_)
    )
    if targets.shape != caps.shape or forced.shape != caps.shape:
        raise MCRLContractError("power target, forced-cap mask, and caps must share shape")
    power = np.zeros(len(active_user_ids), dtype=np.float64)
    residual = math.inf
    recent_changes: list[float] = []
    status: Literal["CONVERGED", "CONVERGED_SLOW"] = "CONVERGED"
    for iteration in range(1, config.solver_iteration_cap + 1):
        updated = np.minimum(caps, targets * (noise + coupling @ power) / direct)
        updated[forced] = caps[forced]
        if not np.all(np.isfinite(updated)) or np.any(
            updated + config.solver_tolerance_w < power
        ):
            return power, PowerCertificate(
                "INVALID", iteration, math.inf, config.solver_tolerance_w
            )
        change = np.abs(updated - power)
        residual = float(np.max(change)) if power.size else 0.0
        relative = float(
            np.max(change / np.maximum(np.abs(updated), np.finfo(float).tiny))
        ) if power.size else 0.0
        recent_changes.append(residual)
        if len(recent_changes) > 1_000:
            recent_changes.pop(0)
        power = updated
        if residual <= config.solver_tolerance_w or relative <= 1.0e-9:
            break
    else:
        if (
            len(recent_changes) == 1_000
            and max(recent_changes) < 1.0e-6
            and all(
                right <= left + np.finfo(float).eps
                for left, right in zip(recent_changes, recent_changes[1:])
            )
        ):
            status = "CONVERGED_SLOW"
        else:
            return power, PowerCertificate(
                "INVALID", config.solver_iteration_cap, residual, config.solver_tolerance_w
            )
    if enforce_target_clearance and power.size:
        # A monotone fixed-point sequence approaches the threshold from below.
        # Preserve the established full-path endpoint by taking one final
        # update, then move one negligible solver-scale step into the
        # certified feasible half-space.
        power = np.minimum(caps, targets * (noise + coupling @ power) / direct)
        power = np.minimum(caps, targets * (noise + coupling @ power) / direct)
        power[forced] = caps[forced]
        power = np.minimum(caps, np.nextafter(power * (1.0 + 2.0e-9), np.inf))
        power[forced] = caps[forced]
    return power, PowerCertificate(
        status,
        iteration,
        residual,
        config.solver_tolerance_w,
        tuple(active_user_ids[index] for index in np.flatnonzero(power >= caps - config.solver_tolerance_w)),
    )


def _transmissions(
    geometry: Geometry,
    active: tuple[int, ...],
    power: np.ndarray,
    direct: np.ndarray,
    coupling: np.ndarray,
    noise: np.ndarray,
    bandwidth: np.ndarray,
    subbands: tuple[tuple[float, float], ...],
    *,
    nominal_direct: np.ndarray,
    nominal_coupling: np.ndarray,
    fading_quantile_alpha: float | None,
    rate_target_bps: float | None = None,
    rate_target_sinr_values: tuple[float | None, ...] | None = None,
    rate_target_feasible: tuple[bool, ...] | None = None,
    m_target_values: tuple[ACMMode | None, ...] | None = None,
) -> tuple[Transmission, ...]:
    rows = []
    nominal_denominators = noise + nominal_coupling @ power
    nominal_sinr_values = power * nominal_direct / nominal_denominators
    for row, index in enumerate(active):
        link = geometry.links[index]
        intra = 0.0
        inter = 0.0
        for column, aggressor in enumerate(active):
            term = coupling[row, column] * power[column]
            if geometry.links[aggressor].beam[0] == link.beam[0]:
                intra += term
            else:
                inter += term
        nominal_sinr = float(nominal_sinr_values[row])
        quantile = (
            1.0
            if fading_quantile_alpha is None
            else fading_product_quantile(link.elevation_deg, fading_quantile_alpha)
        )
        m_tx = select_transmitted_mode(nominal_sinr, quantile)
        actual_sinr = float(
            power[row] * direct[row] / (noise[row] + intra + inter)
        )
        outcome = decode_transmitted_mode(m_tx, actual_sinr)
        rows.append(
            Transmission(
                user_id=link.user_id,
                beam=link.beam,
                rf_power_w=float(power[row]),
                wanted_w=float(power[row] * direct[row]),
                intra_interference_w=float(intra),
                inter_interference_w=float(inter),
                noise_w=float(noise[row]),
                bandwidth_hz=float(bandwidth[row]),
                subband=subbands[row],
                rate_target_bps=rate_target_bps,
                rate_target_sinr=(
                    None if rate_target_sinr_values is None else rate_target_sinr_values[row]
                ),
                rate_target_feasible=(
                    None if rate_target_feasible is None else rate_target_feasible[row]
                ),
                m_target=(
                    None if m_target_values is None else m_target_values[row]
                ),
                m_tx=m_tx,
                realised_outcome=outcome,
                nominal_sinr=nominal_sinr,
                margin_predicted_sinr=nominal_sinr * quantile,
            )
        )
    return tuple(rows)


def _aggregate_certificates(certificates: list[PowerCertificate]) -> PowerCertificate:
    if not certificates:
        return PowerCertificate("FIXED", 0, 0.0, POWER_SOLVER_TOLERANCE_W)
    invalid = any(c.status == "INVALID" for c in certificates)
    statuses = {c.status for c in certificates}
    status: Literal["FIXED", "CONVERGED", "CONVERGED_SLOW", "INVALID"] = (
        "INVALID"
        if invalid
        else "FIXED"
        if statuses == {"FIXED"}
        else "CONVERGED_SLOW"
        if "CONVERGED_SLOW" in statuses
        else "CONVERGED"
    )
    return PowerCertificate(
        status,
        sum(c.iterations for c in certificates),
        max(c.residual_w for c in certificates),
        certificates[0].tolerance_w,
        tuple(sorted({uid for c in certificates for uid in c.saturated_users})),
    )


class FixedRF:
    """Architecture b: fixed 1.65-W RF per active full-band TDM beam."""

    code: Literal["b"] = "b"

    def radiate(
        self, config: RadiationConfig, geometry: Geometry, nominal_or_realised: FieldKind
    ) -> RadiationResult:
        direct_all = geometry.gains(
            nominal_or_realised,
            fading_quantile_alpha=config.fading_quantile_alpha,
        )
        slots: list[RadiationSlot] = []
        certificates: list[PowerCertificate] = []
        for start, end, active in _tdm_slots(geometry):
            power = np.full(len(active), config.beam_cap_w, dtype=np.float64)
            direct = direct_all[list(active)] if active else np.zeros(0)
            coupling = _masked_coupling(geometry, active, nominal_or_realised)
            nominal_direct = geometry.gains("nominal")[list(active)] if active else np.zeros(0)
            nominal_coupling = _masked_coupling(geometry, active, "nominal")
            noise = np.full(len(active), noise_power_w(config.bandwidth_hz))
            bandwidth = np.full(len(active), config.bandwidth_hz)
            certificate = PowerCertificate("FIXED", 0, 0.0, config.solver_tolerance_w)
            certificates.append(certificate)
            slots.append(
                RadiationSlot(
                    start,
                    end,
                    tuple((geometry.links[index].beam, config.beam_cap_w) for index in active),
                    _transmissions(
                        geometry,
                        active,
                        power,
                        direct,
                        coupling,
                        noise,
                        bandwidth,
                        tuple((0.0, config.bandwidth_hz) for _ in active),
                        nominal_direct=nominal_direct,
                        nominal_coupling=nominal_coupling,
                        fading_quantile_alpha=config.fading_quantile_alpha,
                    ),
                    certificate,
                )
            )
        return RadiationResult(self.code, nominal_or_realised, tuple(slots), _aggregate_certificates(certificates))


class AngleTPC_TDM:
    """Architecture a: nominal target-SINR power control with full-band TDM."""

    code: Literal["a-\u03b3"] = "a-\u03b3"

    def radiate(
        self, config: RadiationConfig, geometry: Geometry, nominal_or_realised: FieldKind
    ) -> RadiationResult:
        nominal_direct = geometry.gains("nominal")
        field_direct = geometry.gains(
            nominal_or_realised,
            fading_quantile_alpha=config.fading_quantile_alpha,
        )
        slots: list[RadiationSlot] = []
        certificates: list[PowerCertificate] = []
        for start, end, active in _tdm_slots(geometry):
            nominal_coupling = _masked_coupling(geometry, active, "nominal")
            noise = np.full(len(active), noise_power_w(config.bandwidth_hz))
            power, certificate = _solve_power(
                nominal_direct[list(active)] if active else np.zeros(0),
                nominal_coupling,
                noise,
                np.full(len(active), config.beam_cap_w),
                tuple(geometry.links[index].user_id for index in active),
                config,
            )
            certificates.append(certificate)
            field_coupling = _masked_coupling(geometry, active, nominal_or_realised)
            bandwidth = np.full(len(active), config.bandwidth_hz)
            slots.append(
                RadiationSlot(
                    start,
                    end,
                    tuple((geometry.links[index].beam, float(power[row])) for row, index in enumerate(active)),
                    _transmissions(
                    transmitted_mode_counts[low:high],
                    (flat_config, flat_tx_modes),
                    1,
                )
                flat_target_modes = target_mode_index[
                    occupancy[flat_config, flat_user]
                ]
                np.add.at(
                    target_mode_counts[low:high],
                    (flat_config, flat_target_modes),
                    1,
                )
                realised_decode_successes[low:high] += np.sum(served, axis=1)
                realised_decode_failures[low:high] += np.sum(
                    active & ~served, axis=1
                )
                seen[low:high] |= active
                top_mode_index = int(np.argmax(efficiencies))
                plateau[low:high] &= ~active | (mode_index == top_mode_index)
                transmissions[low:high] += np.sum(active, axis=1)
                cap_hits[low:high] += np.sum(
                    active & (power >= BEAM_RF_CAP_W - 1.0e-9), axis=1
                )
                pa_w = np.sum(
                    np.where(
                        active & (power > 0.0),
                        np.sqrt(power * PA_SATURATION_POWER_W) / PA_MAX_EFFICIENCY,
                        0.0,
                    ),
                    axis=1,
                )
                circuit_w = np.sum(active & (power > 0.0), axis=1) * circuit_power_per_active_chain_w
                same_sat = aggressor_norad[:, :, None] == aggressor_norad[:, None, :]
                earlier_active_sat = np.any(
                    same_sat & (active[:, None, :] & lower_user), axis=2
                )
                active_satellites = np.sum(active & ~earlier_active_sat, axis=1)
                boundary_energy += fraction * np.stack(
                    (
                        pa_w,
                        circuit_w,
                        active_satellites * BASEBAND_POWER_PER_ACTIVE_SATELLITE_W,
                    ),
                    axis=1,
                )

            # The scalar roster path records a missing in-step transmission as
            # infeasible, rather than silently dropping that user.
            feasible_all[low:high] &= boundary_feasible
            if previous_rate is not None and previous_boundary is not None:
                elapsed_s = (boundary - previous_boundary) * D2_MEASUREMENT_STEP_S
                bits[low:high] += 0.5 * (previous_rate + boundary_rate) * elapsed_s
                decoding[low:high] += 0.5 * (
                    previous_decode.astype(np.float64) + boundary_decode.astype(np.float64)
                ) * elapsed_s
                components[low:high] += 0.5 * (previous_energy + boundary_energy) * elapsed_s
            previous_rate = boundary_rate
            previous_decode = boundary_decode
            previous_energy = boundary_energy
            previous_boundary = boundary

        # A one-boundary nominal snapshot is a decision-instant score held
        # over the decision interval.  Multi-boundary grids use trapezoids.
        if len(boundary_indices) == 1 and previous_rate is not None:
            duration_s = 47 * D2_MEASUREMENT_STEP_S
            bits[low:high] += previous_rate * duration_s
            decoding[low:high] += previous_decode.astype(np.float64) * duration_s
            components[low:high] += previous_energy * duration_s

    joules = np.sum(components, axis=1)
    attained = bits >= rate_target_bps * (47 * D2_MEASUREMENT_STEP_S)
    return BatchARResult(
        *(
            _readonly(value)
            for value in (
                bits[inverse_order],
                joules[inverse_order],
                components[inverse_order, 0],
                components[inverse_order, 1],
                components[inverse_order, 2],
                decoding[inverse_order],
                feasible_all[inverse_order],
                attained[inverse_order],
                residual_max[inverse_order],
                mode_counts[inverse_order],
                target_mode_counts[inverse_order],
                transmitted_mode_counts[inverse_order],
                realised_decode_successes[inverse_order],
                realised_decode_failures[inverse_order],
                np.sum(plateau & seen, axis=1)[inverse_order],
                transmissions[inverse_order],
                cap_hits[inverse_order],
                valid_result[inverse_order],
                certificate_status[inverse_order],
                certificate_iterations[inverse_order],
                max_rf_power_w[inverse_order],
                np.where(
                    np.isfinite(min_decoding_margin_db[inverse_order]),
                    min_decoding_margin_db[inverse_order],
                    -100.0,
                ),
                np.divide(
                    acm_se_sum[inverse_order],
                    acm_se_count[inverse_order],
                    out=np.zeros(configurations, dtype=np.float64),
                    where=acm_se_count[inverse_order] > 0,
                ),
            )
        )
    )


def evaluate_ar_tdm_catalogue(
    arrays: PrimitiveStepArrays,
    selected_rows: np.ndarray,
    *,
                for row in anchors
            ),
            "occupancy_sum": sum(
                int(row["committed"][name]["interference_structure"]["occupancy_sum"])  # type: ignore[index]
                for row in anchors
            ),
            "max_beam_occupancy": max(
                int(row["committed"][name]["interference_structure"]["max_beam_occupancy"])  # type: ignore[index]
                for row in anchors
            ),
        }
        diagnostics = pooled[name]["interference_structure"]
        boundaries = diagnostics["boundary_observations"]
        occupied_beams = diagnostics["occupied_beam_boundary_observations"]
        diagnostics["cap_binding_boundary_share"] = (
            0.0 if boundaries == 0 else diagnostics["cap_binding_boundaries"] / boundaries
        )
        diagnostics["no_eligible_mode_boundary_share"] = (
            0.0
            if boundaries == 0
            else diagnostics["no_eligible_mode_boundaries"] / boundaries
        )
        diagnostics["mean_beam_occupancy"] = (
            0.0 if occupied_beams == 0 else diagnostics["occupancy_sum"] / occupied_beams
        )
        rf = pooled[name]["rf_transmission_observations"]
        pooled[name]["rf_cap_transmission_share"] = (
            0.0 if rf == 0 else pooled[name]["rf_cap_hits"] / rf
        )
    return {
        "anchor_count": len(anchors),
        "world_count": len({str(row["world_domain"]) for row in anchors}),
        "qualifying_coalition_anchor_count": sum(
            bool(row["selection"]["qualifying_coalition_existed"]) for row in anchors  # type: ignore[index]
        ),
        "negative_committed_oracle_gap_anchor_count": sum(
            row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"]  # type: ignore[index]
            is not None
            and row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] < 0.0  # type: ignore[index]
            for row in anchors
        ),
        "pooled": pooled,
        "oracle_set_over_unilateral_relative": relative_gain(
            pooled["ORACLE_SET"]["ee_bit_per_j"],
            pooled["UNILATERAL"]["ee_bit_per_j"],
        ),
        "unilateral_over_baseline_relative": relative_gain(
            pooled["UNILATERAL"]["ee_bit_per_j"],
            pooled["BASELINE"]["ee_bit_per_j"],
        ),
        "exact_evaluation_count": {
            "unique_selection_configurations": sum(
                int(row["selection"]["unique_selection_configuration_evaluations"])  # type: ignore[index]
                for row in anchors
            ),
            "selection_boundary_evaluations": sum(
                int(row["selection"]["selection_physical_boundary_evaluations"])  # type: ignore[index]
                for row in anchors
            ),
            "committed_unique_configurations": sum(
                int(row["committed_unique_configuration_evaluations"])
                for row in anchors
            ),
            "committed_boundary_evaluations": sum(
                int(row["committed_physical_boundary_evaluations"])
                for row in anchors
            ),
            "unilateral_candidate_comparisons": sum(
                int(row["selection"]["unilateral_candidate_comparisons"])  # type: ignore[index]
                for row in anchors
            ),
            "joint_unique_candidates": sum(
                int(row["selection"]["joint_catalogue_unique"])  # type: ignore[index]
                for row in anchors
            ),
        },
    }


def run(
    *,
    worlds: int,
    anchors_per_world: int,
    synthetic: bool,
    one_sided_hp_deg: float,
    provisioning_rule: str,
) -> dict[str, object]:
    from mcrl.physics_v025.provider_legacy import factory as real_factory

    if not 1 <= worlds <= WORLD_COUNT or not 1 <= anchors_per_world <= ANCHORS_PER_WORLD:
        raise RuntimeError("requested run exceeds the fixed 2-world x 5-anchor panel")
    if one_sided_hp_deg not in DECLARED_ONE_SIDED_HP_DEG:
        raise RuntimeError(
            "diagnostic one-sided half-power angle must be one of "
            f"{DECLARED_ONE_SIDED_HP_DEG} degrees"
        )
    full_hpbw_deg = 2.0 * one_sided_hp_deg
    # Runtime-only diagnostic override.  The imported function resolves this
    # module global at call time; no source or constant file is edited.
    channel_module.TX_FULL_HPBW_DEG = full_hpbw_deg
    if provisioning_rule not in {"sealed", "margin"}:
        raise RuntimeError("provisioning rule must be sealed or margin")
    global PROVISIONING_RULE
    PROVISIONING_RULE = provisioning_rule
    probe.evaluate_ar_tdm_catalogue = (
        margin_batch.evaluate_ar_tdm_catalogue
        if provisioning_rule == "margin"
        else __import__(
            "mcrl.physics_v025.batch", fromlist=["evaluate_ar_tdm_catalogue"]
        ).evaluate_ar_tdm_catalogue
    )
    started = time.perf_counter()
    anchors = []
    world_rows = []
    for world_index in range(1, worlds + 1):
        domain = (
            probe.SYNTHETIC_WORLD_DOMAINS[world_index - 1]
            if synthetic
            else probe.PROBE_WORLD_DOMAINS[world_index - 1]
        )
        provider = probe.TinySyntheticProvider(users=3) if synthetic else real_factory()
        world_started = time.perf_counter()
        tape = probe.build_world_tape(
            domain=domain,
            provider=provider,
            steps=anchors_per_world,
            start_time_s=0.0,
        )
        world_rows.append(
            {
                "world_index": world_index,
                "domain": domain,
                "world_sha256": tape.digest,
                "tle_date": tape.tle_date,
                "training_seed": tape.training_seed,
                "construction_wall_seconds": time.perf_counter() - world_started,
            }
        )
        global _WORKER_TAPE
        _WORKER_TAPE = tape
        pool_context = None
        if not synthetic:
            if "fork" not in mp.get_all_start_methods():
                raise RuntimeError("exact parallel selector requires POSIX fork")
            pool_context = mp.get_context("fork").Pool(SELECTION_WORKERS)
        try:
            for step_index in range(anchors_per_world):
                row = evaluate_anchor(
                    tape=tape,
                    world_index=world_index,
                    step_index=step_index,
                    pool=pool_context,
                )
                anchors.append(row)
                print(
                    json.dumps(
                        {
                            "anchor": row["anchor_id"],
                            "unilateral_iterations": row["selection"]["unilateral_iterations"],
                            "joint_candidates": row["selection"]["joint_catalogue_unique"],
                            "qualifying": row["selection"]["qualifying_coalition_existed"],
                            "oracle_ee_gain_pct": (
                                None
                                if row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] is None
                                else 100.0
                                * row["committed"]["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"]
                            ),
                            "wall_seconds": row["wall_seconds"],
                        },
                        sort_keys=True,
                    ),
                    flush=True,
                )
        finally:
            if pool_context is not None:
                pool_context.close()
                pool_context.join()
    result = {
        "schema": "mcrl-v025-beamwidth-design-sweep-network-v2",
        "claim_ceiling": CLAIM_CEILING,
        "beamwidth_diagnostic": {
            "full_hpbw_deg": full_hpbw_deg,
            "off_axis_half_power_deg": one_sided_hp_deg,
            "input_convention": "one-sided off-boresight half-power angle",
            "declared_design_axis_deg": list(DECLARED_ONE_SIDED_HP_DEG),
            "implementation": "runtime-only channel-module global override before tape construction",
            "constant_file_changed": False,
            "all_other_constants_held_fixed": True,
        },
        "provisioning_rule": provisioning_rule,
        "provisioning_definition": (
            "Gamma_margin(e,n)=Gamma(n)/q_0.10(e)"
            if provisioning_rule == "margin"
            else "Gamma(n)"
        ),
        "margin_batch_source_sha256": hashlib.sha256(
            (HERE / "margin_batch.py").read_bytes()
        ).hexdigest(),
        "source_commit": _git("rev-parse", "HEAD"),
        "source_tree": _git("rev-parse", "HEAD^{tree}"),
        "probe_source_sha256": hashlib.sha256(PROBE_PATH.read_bytes()).hexdigest(),
        "python": sys.executable,
        "python_version": platform.python_version(),
        "process_limit": 3,
        "processes_used": 1 if synthetic else 1 + SELECTION_WORKERS,
        "thread_environment": {
            name: os.environ.get(name)
            for name in (
                "OMP_NUM_THREADS",
                "OPENBLAS_NUM_THREADS",
                "MKL_NUM_THREADS",
                "NUMEXPR_NUM_THREADS",
            )
        },
        "test_split_opened": False,
        "learner_used": False,
        "ten_second_deadline": "IGNORED_BY_DESIGN_FOR_CEILING",
        "selection_objective": "exact binary64 F = B - eta_ref*E at realised boundary 0, held for 30.08 s",
        "committed_endpoint": "corrected causal ACM, realised 48-boundary endpoint",
        "service_guard": "selection-time served count >= BASELINE served count",
        "worlds": world_rows,
        "anchors": anchors,
        "summary": summarize(anchors),
        "wall_seconds": time.perf_counter() - started,
        "synthetic_self_test": synthetic,
    }
    unsigned = json.dumps(
        result, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
    ).encode("ascii")
    result["receipt_sha256"] = hashlib.sha256(unsigned).hexdigest()
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--worlds", type=int, default=WORLD_COUNT)
    parser.add_argument("--anchors-per-world", type=int, default=ANCHORS_PER_WORLD)
    parser.add_argument("--output", type=Path, default=OUTPUT_PATH)
    parser.add_argument("--one-sided-hp-deg", type=float, required=True)
    parser.add_argument(
        "--provisioning-rule", choices=("sealed", "margin"), default="sealed"
    )
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    worlds = 1 if args.self_test else args.worlds
    anchors = 1 if args.self_test else args.anchors_per_world
    result = run(
        worlds=worlds,
        anchors_per_world=anchors,
        synthetic=args.self_test,
        one_sided_hp_deg=args.one_sided_hp_deg,
        provisioning_rule=args.provisioning_rule,
    )
    summary = result["summary"]
    if args.self_test:
        assert summary["anchor_count"] == 1
        assert result["test_split_opened"] is False
        assert result["learner_used"] is False
        print(json.dumps(summary, indent=2, sort_keys=True))
        return 0
    args.output.parent.mkdir(parents=True, exist_ok=True)
#!/usr/bin/env python3
"""Replay recorded sealed selections to add non-selection diagnostics."""

from __future__ import annotations

import argparse
import importlib.util
import json
from pathlib import Path
import sys


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
sys.path.insert(0, str(HERE))


def _load_runner():
    path = HERE / "run_beamwidth_network.py"
    spec = importlib.util.spec_from_file_location("sealed_replay_runner", path)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load beam-width runner")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


runner = _load_runner()

from mcrl.physics_v025 import batch as sealed_batch
from mcrl.physics_v025.provider_legacy import factory


def _configuration_from_id(base, configuration_id: str):
    if configuration_id.startswith("BASE:"):
        return base
    mapping = {}
    for assignment in configuration_id[4:].split(";"):
        user, norad, chain = assignment.split(":")
        mapping[int(user)] = (int(norad), int(chain))
    config = runner.probe._configuration(base, mapping, kind="sealed-diagnostic-replay")
    if config.configuration_id != configuration_id:
        raise RuntimeError("configuration reconstruction failed")
    return config


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("receipts", nargs="+", type=Path)
    parser.add_argument("--output-dir", type=Path, required=True)
    args = parser.parse_args()
    outputs = []
    runner.PROVISIONING_RULE = "sealed"
    runner.probe.evaluate_ar_tdm_catalogue = sealed_batch.evaluate_ar_tdm_catalogue
    for receipt_path in args.receipts:
        source = json.loads(receipt_path.read_text(encoding="ascii"))
        width = float(source["beamwidth_diagnostic"]["off_axis_half_power_deg"])
        runner.channel_module.TX_FULL_HPBW_DEG = 2.0 * width
        tapes = {}
        for world_index in (1, 2):
            tape = runner.probe.build_world_tape(
                domain=runner.probe.PROBE_WORLD_DOMAINS[world_index - 1],
                provider=factory(),
                steps=4,
                start_time_s=0.0,
            )
            expected = next(
                row for row in source["worlds"] if row["world_index"] == world_index
            )
            if tape.digest != expected["world_sha256"]:
                raise RuntimeError("world digest mismatch")
            tapes[world_index] = tape
        anchors = []
        for recorded in source["anchors"]:
            tape = tapes[int(recorded["world_index"])]
            step_index = int(recorded["step_index"])
            base = runner.probe._base_configuration(tape, step_index, "nearest-eligible")
            configs = {
                name: _configuration_from_id(
                    base, recorded["committed"][name]["configuration_id"]
                )
                for name in ("BASELINE", "UNILATERAL", "ORACLE_SET")
            }
            evaluator = runner.probe.StepEvaluator(
                tape,
                runner.probe._setting("a-r0"),
                step_index,
                transition_from=base,
                field="realised",
                run_setting=runner.probe.run_setting_for("a-r0"),
                boundary_indices=tuple(range(48)),
                fading_quantile_alpha=0.10,
            )
            evaluator.evaluate_many(tuple(configs.values()))
            committed = {}
            for name, config in configs.items():
                profile = evaluator.evaluate(config)
                old = recorded["committed"][name]
                if (
                    profile.bits.hex() != float(old["bits"]).hex()
                    or profile.joules.hex() != float(old["joules"]).hex()
                    or runner.served(profile) != int(old["served_count"])
                ):
                    raise RuntimeError("sealed committed replay differs from receipt")
                committed[name] = {
                    "configuration_id": config.configuration_id,
                    "bits": profile.bits,
                    "joules": profile.joules,
                    "ee_bit_per_j": runner.ratio(profile.bits, profile.joules),
                    "served_count": runner.served(profile),
                    "rate_target_attained_count": sum(
                        bool(value)
                        for value in (profile.score.rate_target_attained or {}).values()
                    ),
                    "rf_cap_hits": profile.rf_cap_hits,
                    "rf_transmission_observations": profile.rf_transmission_observations,
                    "m_tx_counts": dict(profile.m_tx_counts),
                    "interference_structure": runner.interference_structure(
                        tape=tape, step_index=step_index, selected=config
                    ),
                }
            committed["ORACLE_SET"]["relative_ee_gain_over_UNILATERAL"] = (
                runner.relative_gain(
                    committed["ORACLE_SET"]["ee_bit_per_j"],
                    committed["UNILATERAL"]["ee_bit_per_j"],
                )
            )
            committed["UNILATERAL"]["relative_ee_gain_over_BASELINE"] = (
                runner.relative_gain(
                    committed["UNILATERAL"]["ee_bit_per_j"],
                    committed["BASELINE"]["ee_bit_per_j"],
                )
            )
            anchors.append(
                {
                    "anchor_id": recorded["anchor_id"],
                    "world_index": recorded["world_index"],
                    "world_domain": recorded["world_domain"],
                    "step_index": step_index,
                    "selection": recorded["selection"],
                    "committed": committed,
                    "committed_unique_configuration_evaluations": len(
                        {config.configuration_id for config in configs.values()}
                    ),
                    "committed_physical_boundary_evaluations": 48
                    * len({config.configuration_id for config in configs.values()}),
                }
            )
        result = {
            "schema": "mcrl-v025-beamwidth-sealed-diagnostic-replay-v1",
            "claim_ceiling": "DIAGNOSTIC_NOT_CLAIM",
            "source_receipt": str(receipt_path),
            "source_receipt_sha256": source["receipt_sha256"],
            "beamwidth_diagnostic": source["beamwidth_diagnostic"],
            "provisioning_rule": "sealed",
            "anchors": anchors,
            "summary": runner.summarize(anchors),
        }
        output = args.output_dir / f"sealed-diagnostics-one-sided-{width:.2f}.json"
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(
            json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n",
            encoding="ascii",
        )
        outputs.append(str(output))
        print(json.dumps({"completed": str(output), "anchors": len(anchors)}), flush=True)
    print(json.dumps({"outputs": outputs}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

