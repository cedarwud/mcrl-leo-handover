#!/usr/bin/env python3
"""Assert the private provisioning seam is bit-identical at divisor one."""

from __future__ import annotations

import argparse
import dataclasses
import importlib.util
import json
import math
from pathlib import Path
import sys

import numpy as np


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
PROBE_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)


def _load_probe():
    spec = importlib.util.spec_from_file_location("identity_v025_probe", PROBE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load pinned probe")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


probe = _load_probe()

import margin_batch
from mcrl.physics_v025 import batch as sealed_batch
from mcrl.physics_v025 import channel as channel_module
from mcrl.physics_v025.provider_legacy import factory


def _configuration_from_id(base, configuration_id: str):
    if configuration_id.startswith("BASE:"):
        return base
    if not configuration_id.startswith("CFG:"):
        raise RuntimeError(f"unexpected configuration id: {configuration_id}")
    mapping = {}
    for assignment in configuration_id[4:].split(";"):
        user, norad, chain = assignment.split(":")
        mapping[int(user)] = (int(norad), int(chain))
    config = probe._configuration(base, mapping, kind="divisor-one-replay")
    if config.configuration_id != configuration_id:
        raise RuntimeError("configuration-id reconstruction failed")
    return config


def _selected_rows(arrays, configs):
    row_of = arrays._row_index()
    users = tuple(int(value) for value in arrays.users)
    selected = np.full((len(configs), len(users)), -1, dtype=np.int64)
    for config_index, config in enumerate(configs):
        for user_column, user in enumerate(users):
            identity = config.mapping[user]
            if identity is not None:
                selected[config_index, user_column] = row_of[(user, identity)]
    return selected


def _assert_batch_equal(left, right, *, label):
    for field in dataclasses.fields(left):
        a = np.asarray(getattr(left, field.name))
        b = np.asarray(getattr(right, field.name))
        if a.dtype != b.dtype or a.shape != b.shape or a.tobytes() != b.tobytes():
            raise AssertionError(f"{label}: batch field differs: {field.name}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("receipts", nargs="+", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    checked = []
    for receipt_path in args.receipts:
        receipt = json.loads(receipt_path.read_text(encoding="ascii"))
        width = float(receipt["beamwidth_diagnostic"]["off_axis_half_power_deg"])
        channel_module.TX_FULL_HPBW_DEG = 2.0 * width
        tapes = {}
        for world_index in (1, 2):
            tape = probe.build_world_tape(
                domain=probe.PROBE_WORLD_DOMAINS[world_index - 1],
                provider=factory(),
                steps=4,
                start_time_s=0.0,
            )
            expected_world = next(
                row for row in receipt["worlds"] if row["world_index"] == world_index
            )
            if tape.digest != expected_world["world_sha256"]:
                raise AssertionError(f"{receipt_path}: world digest differs")
            tapes[world_index] = tape
        configurations = 0
        catalogue_calls = 0
        for anchor in receipt["anchors"]:
            tape = tapes[int(anchor["world_index"])]
            step_index = int(anchor["step_index"])
            arrays = tape.steps[step_index].arrays
            if arrays is None:
                raise AssertionError("real anchor unexpectedly lacks dense arrays")
            base = probe._base_configuration(tape, step_index, "nearest-eligible")
            names = ("BASELINE", "UNILATERAL", "ORACLE_SET")
            configs = [
                _configuration_from_id(
                    base, anchor["committed"][name]["configuration_id"]
                )
                for name in names
            ]
            selected = _selected_rows(arrays, configs)
            for boundaries in ((0,), tuple(range(48))):
                kwargs = {
                    "field": "realised",
                    "rate_target_bps": probe.run_setting_for("a-r0").rate_target_bps,
                    "circuit_power_per_active_chain_w": probe.run_setting_for(
                        "a-r0"
                    ).circuit_power_per_active_chain_w,
                    "boundary_indices": boundaries,
                    "fading_quantile_alpha": 0.10,
                }
                sealed = sealed_batch._evaluate_ar_tdm_catalogue_core(
                    arrays, selected, **kwargs
                )
                divisor_one = margin_batch.evaluate_ar_tdm_catalogue_divisor_one(
                    arrays, selected, **kwargs
                )
                _assert_batch_equal(
                    sealed,
                    divisor_one,
                    label=f"{receipt_path.name}:{anchor['anchor_id']}:{boundaries}",
                )
                catalogue_calls += 1
            for index, name in enumerate(names):
                recorded = anchor["committed"][name]
                bits = math.fsum(float(value) for value in sealed.bits[index])
                joules = float(sealed.joules[index])
                served = int(np.sum(sealed.decoding_time_s[index] > 0.0))
                if (
                    bits.hex() != float(recorded["bits"]).hex()
                    or joules.hex() != float(recorded["joules"]).hex()
                    or served != int(recorded["served_count"])
                ):
                    raise AssertionError(
                        f"{receipt_path.name}:{anchor['anchor_id']}:{name}: receipt mismatch"
                    )
            configurations += len(configs)
        checked.append(
            {
                "receipt": str(receipt_path),
                "receipt_sha256": receipt["receipt_sha256"],
                "width_deg": width,
                "anchors": len(receipt["anchors"]),
                "committed_configurations": configurations,
                "catalogue_calls": catalogue_calls,
                "status": "BIT_IDENTICAL",
            }
        )
    result = {
        "assertion": "BIT_IDENTICAL",
        "comparison": (
            "every ndarray field from the sealed and divisor-one private dense "
            "evaluators, at boundary 0 and all 48 boundaries"
        ),
        "receipt_record_check": "bits, joules, and served counts match exactly",
        "receipts": checked,
        "total_receipts": len(checked),
        "total_anchors": sum(row["anchors"] for row in checked),
        "total_committed_configurations": sum(
            row["committed_configurations"] for row in checked
        ),
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="ascii"
    )
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
"""Single V0.25 resolution order: schedule, radiate, interfere, decode."""

from __future__ import annotations

from dataclasses import dataclass
import math
from typing import TYPE_CHECKING

import numpy as np

from .acm import ACMRate, RateModel
from .architectures import (
    FieldKind,
    Geometry,
    RadiationArchitecture,
    RadiationConfig,
    RadiationResult,
)
from .energy import EnergyReceipt, HardwareInventory, schedule_energy
from .tapes import PrimitiveStepArrays

if TYPE_CHECKING:
    from .batch import BatchARResult


@dataclass(frozen=True)
class ResolutionResult:
    radiation: RadiationResult
    average_rate_bps: dict[int, float] | None
    bits: dict[int, float] | None
    decoding_time_fraction: dict[int, float] | None
    complete_service: dict[int, bool] | None
    rate_target_attained: dict[int, bool] | None
    rate_target_feasible: dict[int, bool] | None
    energy: EnergyReceipt | None

    @property
    def valid(self) -> bool:
        return self.radiation.valid


def resolve_configuration(
    architecture: RadiationArchitecture | None = None,
    radiation_config: RadiationConfig | None = None,
    geometry: Geometry | None = None,
    rate_model: RateModel | None = None,
    inventory: HardwareInventory | None = None,
    *,
    duration_s: float | None = None,
    field: FieldKind = "realised",
    idle_power_w: float = 0.0,
    batch_arrays: PrimitiveStepArrays | None = None,
    batch_selected_rows: np.ndarray | None = None,
    batch_chunk_size: int = 256,
    batch_rate_target_bps: float | None = None,
    batch_circuit_power_per_active_chain_w: float | None = None,
    batch_boundary_indices: tuple[int, ...] = tuple(range(48)),
    batch_fading_quantile_alpha: float | None = None,
) -> ResolutionResult | "BatchARResult":
    """Resolve one scalar configuration or one dense catalogue request."""

    if batch_arrays is not None or batch_selected_rows is not None:
        if batch_arrays is None or batch_selected_rows is None:
            raise ValueError("dense resolution needs arrays and selected rows together")
        if any(
            value is not None
            for value in (architecture, radiation_config, geometry, rate_model, inventory)
        ) or duration_s is not None:
            raise ValueError("dense and scalar resolution inputs cannot be mixed")
        if idle_power_w != 0.0:
            raise ValueError("idle_power_w is a scalar-only resolution input")
        from .batch import _evaluate_ar_tdm_catalogue_core

        kwargs: dict[str, object] = {
            "field": field,
            "chunk_size": batch_chunk_size,
            "boundary_indices": batch_boundary_indices,
            "fading_quantile_alpha": batch_fading_quantile_alpha,
        }
        if batch_rate_target_bps is not None:
            kwargs["rate_target_bps"] = batch_rate_target_bps
        if batch_circuit_power_per_active_chain_w is not None:
            kwargs["circuit_power_per_active_chain_w"] = (
                batch_circuit_power_per_active_chain_w
            )
        return _evaluate_ar_tdm_catalogue_core(
            batch_arrays,
            batch_selected_rows,
            **kwargs,
        )

    if (
        batch_chunk_size != 256
        or batch_rate_target_bps is not None
        or batch_circuit_power_per_active_chain_w is not None
        or batch_boundary_indices != tuple(range(48))
        or batch_fading_quantile_alpha is not None
    ):
        raise ValueError("batch resolution inputs require arrays and selected rows")

    if any(
        value is None
        for value in (
            architecture,
            radiation_config,
            geometry,
            rate_model,
            inventory,
            duration_s,
        )
    ):
        raise ValueError("scalar resolution inputs are incomplete")

    if not math.isfinite(duration_s) or duration_s < 0.0:
        raise ValueError("duration_s must be finite and nonnegative")
    radiation = architecture.radiate(radiation_config, geometry, field)
    if not radiation.valid:
        return ResolutionResult(radiation, None, None, None, None, None, None, None)

    rates = {link.user_id: 0.0 for link in geometry.links}
    served_fraction = {link.user_id: 0.0 for link in geometry.links}
    allocated_fraction = {link.user_id: 0.0 for link in geometry.links}
    for slot in radiation.slots:
        for transmission in slot.transmissions:
            allocated_fraction[transmission.user_id] += slot.fraction
            if isinstance(rate_model, ACMRate):
                if transmission.realised_outcome is None:
                    raise ValueError("ACM transmission lacks a realised outcome")
                served = transmission.realised_outcome.decoded
            else:
                served = rate_model.served(transmission.sinr, allocated=True)
            if served:
                served_fraction[transmission.user_id] += slot.fraction
                if isinstance(rate_model, ACMRate):
                    rates[transmission.user_id] += (
                        slot.fraction
                        * transmission.bandwidth_hz
                        * transmission.realised_outcome.credited_spectral_efficiency_bit_per_s_hz
                    )
                else:
                    rates[transmission.user_id] += slot.fraction * rate_model.rate_bps(
                        transmission.sinr, transmission.bandwidth_hz
                    )
            # No branch edits radiation: an unsuccessful attempt continues to
            # interfere and consume exactly the energy already scheduled.
    energy = schedule_energy(
        inventory,
        (
            (slot.fraction, dict(slot.beam_rf_w))
            for slot in radiation.slots
        ),
        duration_s=duration_s,
        idle_power_w=idle_power_w,
    )
    bits = {user: rate * duration_s for user, rate in rates.items()}
    complete = {
        user: allocated_fraction[user] > 0.0
        and math.isclose(served_fraction[user], allocated_fraction[user], rel_tol=0.0, abs_tol=1.0e-15)
        for user in rates
    }
    return ResolutionResult(
        radiation,
        rates,
        bits,
        served_fraction,
        complete,
        radiation.rate_target_attained,
        radiation.per_user_rate_target_feasible,
        energy,
    )


__all__ = ["ResolutionResult", "resolve_configuration"]
