def interference_structure(*, tape, step_index: int, selected) -> dict[str, object]:
    """Classify infeasible user-steps by an exact zero-cross-interference rerun.

    The assignment, beam occupancy, direct links, rate target, RF cap, and all
    other constants are held fixed.  A user-step is interference-limited only
    when it is infeasible with the physical cross-gain matrix and feasible at
    every boundary when that matrix alone is zeroed.  Top-1 share is computed
    over the failing transmissions of those interference-limited user-steps,
    with TDM-slot and trapezoidal boundary weights.
    """

    assignments = selected.mapping
    users = tuple(sorted(assignments))
    actual_all = {user: True for user in users}
    zero_all = {user: True for user in users}
    contributions: dict[int, list[tuple[float, float]]] = {
        user: [] for user in users
    }
    geometries = tape.geometry_for(step_index=step_index, assignments=assignments)
    architecture = (
        MarginAngleRateTPC_TDM()
        if PROVISIONING_RULE == "margin"
        else AngleRateTPC_TDM()
    )
    config = RadiationConfig(fading_quantile_alpha=0.10)
    cap_binding_boundaries = 0
    no_mode_boundaries = 0
    boundary_observations = 0
    occupied_beam_boundary_observations = 0
    occupancy_sum = 0
    occupancy_max = 0

    for boundary_index, (_absolute_time, geometry) in enumerate(geometries):
        boundary_observations += 1
        endpoint_weight = 0.5 if boundary_index in (0, len(geometries) - 1) else 1.0
        actual = architecture.radiate(config, geometry, "nominal")
        zeros = np.zeros_like(geometry.nominal_cross_gain)
        zero_geometry = Geometry(geometry.links, zeros, zeros)
        without_cross = architecture.radiate(config, zero_geometry, "nominal")
        actual_rows = actual.per_user_rate_target_feasible or {}
        zero_rows = without_cross.per_user_rate_target_feasible or {}
        live_users = {link.user_id for link in geometry.links}
        occupancies = Counter(link.beam for link in geometry.links)
        occupied_beam_boundary_observations += len(occupancies)
        occupancy_sum += sum(occupancies.values())
        occupancy_max = max(occupancy_max, max(occupancies.values(), default=0))
        cap_binding_boundaries += int(
            any(
                math.isclose(
                    tx.rf_power_w,
                    config.beam_cap_w,
                    rel_tol=0.0,
                    abs_tol=1.0e-9,
                )
                for slot in actual.slots
                for tx in slot.transmissions
            )
        )
        no_mode_boundaries += int(
            any(
                tx.m_tx is None
                for slot in actual.slots
                for tx in slot.transmissions
            )
        )
        for user in users:
            actual_all[user] &= user in live_users and bool(actual_rows.get(user, False))
            zero_all[user] &= user in live_users and bool(zero_rows.get(user, False))

        index_by_user = {link.user_id: index for index, link in enumerate(geometry.links)}
        for slot in actual.slots:
            tx_by_user = {tx.user_id: tx for tx in slot.transmissions}
            for tx in slot.transmissions:
                if tx.rate_target_feasible is None or bool(tx.rate_target_feasible):
                    continue
                victim_index = index_by_user[tx.user_id]
                victim_link = geometry.links[victim_index]
                terms = []
                for aggressor in slot.transmissions:
                    if aggressor.user_id == tx.user_id:
                        continue
                    aggressor_index = index_by_user[aggressor.user_id]
                    aggressor_link = geometry.links[aggressor_index]
                    if aggressor_link.beam == victim_link.beam:
                        continue
                    if aggressor_link.color != victim_link.color:
                        continue
                    term = (
                        float(geometry.nominal_cross_gain[victim_index, aggressor_index])
                        * aggressor.rf_power_w
                    )
                    if term > 0.0:
                        terms.append(term)
                total = math.fsum(terms)
                if total > 0.0:
                    weight = endpoint_weight * slot.fraction
                    contributions[tx.user_id].append((weight * max(terms), weight * total))

    infeasible = tuple(user for user in users if not actual_all[user])
    interference_limited = tuple(
        user for user in infeasible if zero_all[user]
    )
    weighted_top1 = math.fsum(
        top1
        for user in interference_limited
        for top1, _total in contributions[user]
            for value in beam_power.values()
        ):
            raise MCRLContractError("rate-target FDM allocation exceeded the per-beam RF cap")
        field_coupling = _masked_coupling(
            geometry, active, nominal_or_realised, overlap
        )
        slot = RadiationSlot(
            0.0,
            1.0,
            tuple(sorted(beam_power.items())),
            _transmissions(
                geometry,
                active,
                power,
                geometry.gains(
                    nominal_or_realised,
                    fading_quantile_alpha=config.fading_quantile_alpha,
                )[list(active)]
                if active
                else np.zeros(0),
                field_coupling,
                noise,
                bandwidth,
                subbands,
                nominal_direct=nominal_direct,
                nominal_coupling=nominal_coupling,
                fading_quantile_alpha=config.fading_quantile_alpha,
                rate_target_bps=config.rate_target_bps,
                rate_target_sinr_values=reported_targets,
                rate_target_feasible=_target_feasibility(
                    power,
                    nominal_direct,
                    nominal_coupling,
                    noise,
                    reported_targets,
                ),
                m_target_values=target_modes,
            ),
            certificate,
        )
        return RadiationResult(
            self.code,
            nominal_or_realised,
            (slot,),
            certificate,
            config.rate_target_bps,
        )


def architecture_for(code: str) -> RadiationArchitecture:
    """Return the declared architecture without aliases or module mutation."""

    if code == "b":
        return FixedRF()
    if code == "a-\u03b3":
        return AngleTPC_TDM()
    if code == "a\u2032-\u03b3":
        return AngleTPC_FDM()
    if code == "a-r":
        return AngleRateTPC_TDM()
    if code == "a\u2032-r":
        return AngleRateTPC_FDM()
    raise MCRLContractError(f"unknown V0.25 architecture {code!r}")


