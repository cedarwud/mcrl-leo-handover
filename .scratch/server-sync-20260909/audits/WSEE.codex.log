#!/usr/bin/env python3
"""Declared beam half-power-angle sweep on corrected V0.25 physics.

This is a TRAIN-only diagnostic.  It has no learner and intentionally ignores
the ten-second deployment deadline.  Selection uses the exact binary64
decision-boundary outcomes; committed reporting uses all 48 realised
boundaries from the same detached world tape.
"""

from __future__ import annotations

import argparse
from collections import Counter
from dataclasses import dataclass
from fractions import Fraction
import hashlib
import importlib.util
import itertools
import json
import math
import os
from pathlib import Path
import platform
import multiprocessing as mp
import numpy as np
import subprocess
import sys
import time
from typing import Mapping, Sequence


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
PROBE_PATH = (
    REPO
    / ".scratch/multi-catfish-v025-physics-successor/probe/run_v025_matrix_probe.py"
)
OUTPUT_PATH = HERE / "beamwidth-network-result.json"
ETA_REF = Fraction("19720681.00172232")
ANCHORS_PER_WORLD = 5
WORLD_COUNT = 2
SELECTION_WORKERS = 2
OCCUPANT_SUBSET_MAX_SIZE = 4
OCCUPANT_SUBSET_TOTAL_CAP = 1_024
JOINT_CANDIDATE_CAP = 4_096
CLAIM_CEILING = "DIAGNOSTIC_NOT_CLAIM"
DECLARED_ONE_SIDED_HP_DEG = (1.66, 2.40, 3.32, 4.50, 6.65)


def _load_probe():
    spec = importlib.util.spec_from_file_location("oracle_v025_probe", PROBE_PATH)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load the pinned V0.25 probe")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


probe = _load_probe()

import margin_batch
from mcrl.physics_v025 import channel as channel_module
from mcrl.physics_v025 import architectures as architecture_module
from mcrl.physics_v025.architectures import (
    AngleRateTPC_TDM,
    Geometry,
    RadiationConfig,
    RadiationResult,
    RadiationSlot,
)
from mcrl.physics_v025.channel import fading_product_quantile, noise_power_w


PROVISIONING_RULE = "sealed"


class MarginAngleRateTPC_TDM:
    """Scalar diagnostic mirror of ``Gamma_margin(e,n) = Gamma(n) / q(e)``."""

    code = "a-r"

    def radiate(self, config, geometry, nominal_or_realised):
        members = architecture_module._beam_members(geometry)
        nominal_direct_all = geometry.gains("nominal")
        field_direct_all = geometry.gains(
            nominal_or_realised,
            fading_quantile_alpha=config.fading_quantile_alpha,
        )
        slots = []
        certificates = []
        for start, end, active in architecture_module._tdm_slots(geometry):
            nominal_direct = nominal_direct_all[list(active)] if active else np.zeros(0)
            nominal_coupling = architecture_module._masked_coupling(
                geometry, active, "nominal"
            )
            noise = np.full(len(active), noise_power_w(config.bandwidth_hz))
            targets, forced, reported_targets, target_modes = (
                architecture_module._rate_targets(config, geometry, active, members)
            )
            quantiles = np.asarray(
                [
                    fading_product_quantile(
                        geometry.links[index].elevation_deg,
                        config.fading_quantile_alpha,
                    )
                    for index in active
                ],
                dtype=np.float64,
            )
            targets = targets / quantiles
            margin_targets = tuple(
                None if value is None else value / quantile
                for value, quantile in zip(reported_targets, quantiles, strict=True)
            )
            caps = np.full(len(active), config.beam_cap_w)
            power, certificate = architecture_module._solve_power(
                nominal_direct,
                nominal_coupling,
                noise,
                caps,
                tuple(geometry.links[index].user_id for index in active),
                config,
                target_sinr=targets,
                force_cap=forced,
                enforce_target_clearance=True,
            )
            certificates.append(certificate)
            field_coupling = architecture_module._masked_coupling(
                geometry, active, nominal_or_realised
            )
            bandwidth = np.full(len(active), config.bandwidth_hz)
            slots.append(
                RadiationSlot(
                    start,
                    end,
                    tuple(
                        (geometry.links[index].beam, float(power[row]))
                        for row, index in enumerate(active)
                    ),
                    architecture_module._transmissions(
                        geometry,
                        active,
                        power,
                        field_direct_all[list(active)] if active else np.zeros(0),
                        field_coupling,
                        noise,
                        bandwidth,
                        tuple((0.0, config.bandwidth_hz) for _ in active),
                        nominal_direct=nominal_direct,
                        nominal_coupling=nominal_coupling,
                        fading_quantile_alpha=config.fading_quantile_alpha,
                        rate_target_bps=config.rate_target_bps,
                        rate_target_sinr_values=margin_targets,
                        rate_target_feasible=architecture_module._target_feasibility(
                            power,
                            nominal_direct,
                            nominal_coupling,
                            noise,
                            margin_targets,
                        ),
                        m_target_values=target_modes,
                    ),
                    certificate,
                )
            )
        return RadiationResult(
            self.code,
            nominal_or_realised,
            tuple(slots),
            architecture_module._aggregate_certificates(certificates),
            config.rate_target_bps,
        )


def exact_float(value: float) -> Fraction:
    """Treat the simulator's finite binary64 result as an exact coefficient."""

    if not math.isfinite(value):
        raise RuntimeError("non-finite physical coefficient")
    return Fraction.from_float(float(value))


def objective(profile) -> Fraction:
    return exact_float(profile.bits) - ETA_REF * exact_float(profile.joules)


def served(profile) -> int:
    if isinstance(profile, SelectionMetric):
        return profile.served_count
    return sum(bool(value) for value in profile.score.served_phy.values())


def ratio(bits: float, joules: float) -> float:
    if not math.isfinite(bits) or not math.isfinite(joules) or joules <= 0.0:
        raise RuntimeError("invalid EE components")
    return bits / joules


def relative_gain(numerator: float, denominator: float) -> float | None:
    """Return an anchor-local gain, or None when the reference EE is zero."""

    if denominator == 0.0:
        return None
    return numerator / denominator - 1.0


def frac_payload(value: Fraction) -> list[int]:
    return [value.numerator, value.denominator]


def _configuration(base, mapping: Mapping[int, tuple[int, int] | None], kind: str):
    return probe._configuration(base, dict(mapping), kind=kind)


@dataclass(frozen=True)
class CoordinateResult:
    selected: object
    iterations: int
    passes: int
    terminal_candidates: tuple[object, ...]
    best_alternatives: Mapping[int, tuple[int, int]]
    candidate_comparisons: int


@dataclass(frozen=True)
class SelectionMetric:
    config: object
    bits: float
    joules: float
    served_count: int


_WORKER_TAPE = None


def _selection_worker(task):
    step_index, base, configs = task
    evaluator = probe.StepEvaluator(
        _WORKER_TAPE,
        probe._setting("a-r0"),
        step_index,
        transition_from=base,
        field="realised",
        run_setting=probe.run_setting_for("a-r0"),
        boundary_indices=(0,),
        fading_quantile_alpha=0.10,
    )
    evaluator.evaluate_many(configs)
    rows = []
    for config in configs:
        profile = evaluator._evaluated.get(config.configuration_id)
        if profile is not None:
            rows.append(
                SelectionMetric(
                    config, profile.bits, profile.joules, served(profile)
                )
            )
    return rows, tuple(evaluator._invalid), evaluator.physical_evaluations

#!/usr/bin/env python3
"""Build the side-by-side sealed/margin beam-width report from receipts."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
WIDTHS = ("1.66", "2.40", "3.32", "4.50", "6.65")
SELECTORS = ("BASELINE", "UNILATERAL", "ORACLE_SET")
SHORT = {"BASELINE": "B", "UNILATERAL": "U", "ORACLE_SET": "J"}


def load(rule: str, width: str):
    stem = "sealed-diagnostics" if rule == "sealed" else "margin-sweep"
    path = HERE / f"{stem}-one-sided-{width}.json"
    return path, json.loads(path.read_text(encoding="ascii"))


def pct(value):
    return "—" if value is None else f"{100.0 * value:.2f}%"


def ee(value):
    return f"{value / 1.0e6:.3f}"


def no_mode_attempt_share(receipt, selector):
    no_mode = sum(
        int(anchor["committed"][selector]["m_tx_counts"].get("NO_MODE", 0))
        for anchor in receipt["anchors"]
    )
    attempts = sum(
        int(anchor["committed"][selector]["rf_transmission_observations"])
        for anchor in receipt["anchors"]
    )
    return 0.0 if attempts == 0 else no_mode / attempts


def main() -> int:
    data = {
        rule: {width: load(rule, width) for width in WIDTHS}
        for rule in ("sealed", "margin")
    }
    for rule in data:
        for width, (_path, receipt) in data[rule].items():
            summary = receipt["summary"]
            if summary["anchor_count"] != 8 or summary["world_count"] != 2:
                raise RuntimeError(f"incomplete point: {rule} {width}")
            if not all(
                anchor["selection"]["unilateral_terminal_certified"]
                for anchor in receipt["anchors"]
            ):
                raise RuntimeError(f"missing terminal certificate: {rule} {width}")

    margin_curve = [
        100.0
        * data["margin"][width][1]["summary"][
            "oracle_set_over_unilateral_relative"
        ]
        for width in WIDTHS
    ]
    sealed_curve = [
        100.0
        * data["sealed"][width][1]["summary"][
            "oracle_set_over_unilateral_relative"
        ]
        for width in WIDTHS
    ]
    corrected_monotone = all(
        right > left for left, right in zip(margin_curve, margin_curve[1:])
    )
    if corrected_monotone:
        raise RuntimeError("report lead must be revisited: corrected curve became monotone")

    lines = [
        "**No. Under margin provisioning, the coordination gap does not rise monotonically with beam width: the corrected curve is `−0.303%, +1.209%, +0.985%, +3.205%, +7.315%`, versus the sealed curve `+6.502%, +10.397%, +11.563%, +14.639%, +41.949%`.**",
        "",
        "# Beam-width sweep under margin provisioning",
        "",
        "`DIAGNOSTIC_NOT_CLAIM`",
        "",
        "## Direct finding",
        "",
        "The corrected five-point curve is not monotone: it rises from 1.66° to 2.40°, dips at the source-width point, and then rises at 4.50° and 6.65°. The sealed monotone rise therefore does not survive as stated. The corrected gap does not disappear, however: it remains materially positive at the two widest sampled points. These are curves over the fixed panel, not a ranking of antenna widths.",
        "",
        "All five corrected points reached the required 8/8 anchors (40/40 total). No point was omitted. Each point uses 100 users at steps 0–3 from `V025_PROBE_R2/world/1` and `/2`, for 800 user-steps per point.",
        "",
        "| One-sided angle | Full span used | Sealed joint/U gap | Negative anchors | Margin joint/U gap | Negative anchors |",
        "|---:|---:|---:|---:|---:|---:|",
    ]
    for width in WIDTHS:
        full = 2.0 * float(width)
        sealed = data["sealed"][width][1]["summary"]
        margin = data["margin"][width][1]["summary"]
        lines.append(
            f"| {width}° | {full:.2f}° | {pct(sealed['oracle_set_over_unilateral_relative'])} | {sealed['negative_committed_oracle_gap_anchor_count']}/8 | {pct(margin['oracle_set_over_unilateral_relative'])} | {margin['negative_committed_oracle_gap_anchor_count']}/8 |"
        )

    lines += [
        "",
        "Pooled EE is `sum(bits) / sum(joules)`. A negative-anchor count uses each anchor's independently committed 48-boundary EE; it can be nonzero even though the joint configuration has a positive boundary-0 selection-objective certificate.",
        "",
        "## EE and service, both rules",
        "",
        "`B`, `U`, and `J` mean neutral BASELINE, terminal iterated UNILATERAL, and bounded ORACLE_SET. Served means positive decoding time. Target means the count whose integrated achieved rate attains 50 Mbit/s. They are reported separately throughout.",
        "",
        "| Rule | One-sided / full | EE B / U / J (Mbit/J) | Served B / U / J (of 800) | 50-Mbit/s target B / U / J (of 800) |",
        "|:---|:---:|:---|:---|:---|",
    ]
    for rule in ("sealed", "margin"):
        for width in WIDTHS:
            summary = data[rule][width][1]["summary"]
            pooled = summary["pooled"]
            ees = " / ".join(ee(pooled[name]["ee_bit_per_j"]) for name in SELECTORS)
            served = " / ".join(str(pooled[name]["served_count_sum"]) for name in SELECTORS)
            attained = " / ".join(
                str(pooled[name]["rate_target_attained_count_sum"])
                for name in SELECTORS
            )
            lines.append(
                f"| {rule.upper()} | {width}° / {2*float(width):.2f}° | {ees} | {served} | {attained} |"
            )

    lines += [
        "",
        "Under the sealed rule, none of the 4,000 user-steps for any selector attains the rate target (`0/12,000` selector/user-step results), even though many are counted as served. Under margin provisioning the target count becomes nonzero at every width and for every selector.",
        "",
        "## Boundary, interference, and occupancy diagnostics",
        "",
        "A cap boundary is one of the 384 anchor-boundaries at a point where at least one active TDM transmission reaches the 1.65-W per-beam cap. A no-mode boundary is one where at least one active transmission has no eligible ACM mode. Brackets give the separate transmission-attempt share, preventing a single event from being confused with all attempts on that boundary. Interference-limited share is `interference-limited / infeasible user-steps`; top-1 is the weighted strongest-aggressor share over failing transmissions of those interference-limited user-steps. Mean occupancy is pooled across occupied realised beam-boundary cells; maximum is the realised maximum.",
        "",
        "| Rule | Width | Selector | Cap boundaries [attempts] | No-mode boundaries [attempts] | Interference-limited | Top-1 aggressor | Mean / max occupancy |",
        "|:---|---:|:---:|---:|---:|---:|---:|---:|",
    ]
    for rule in ("sealed", "margin"):
        for width in WIDTHS:
            receipt = data[rule][width][1]
            for name in SELECTORS:
                pooled = receipt["summary"]["pooled"][name]
                structure = pooled["interference_structure"]
                lines.append(
                    "| {} | {}° | {} | {} [{}] | {} [{}] | {} | {} | {:.3f} / {} |".format(
                        rule.upper(),
                        width,
                        SHORT[name],
                        pct(structure["cap_binding_boundary_share"]),
                        pct(pooled["rf_cap_transmission_share"]),
                        pct(structure["no_eligible_mode_boundary_share"]),
                        pct(no_mode_attempt_share(receipt, name)),
                        pct(structure["interference_limited_share_of_infeasible"]),
                        pct(structure["top1_aggressor_share"]),
                        structure["mean_beam_occupancy"],
                        structure["max_beam_occupancy"],
                    )
                )

    m166 = data["margin"]["1.66"][1]["summary"]["pooled"]
    m332 = data["margin"]["3.32"][1]["summary"]["pooled"]
    lines += [
        "",
        "## 1.66° model point versus the source-width point",
        "",
        "The evaluated source-width grid point is the requested rounded one-sided `3.32°`, so its runtime full span is `6.64°`. The paper's exact Table-I value is `0.058 rad`, implying one-sided `3.323155°` and full span `6.646310°`; the exact-value distinction is provenance context, not an extra sixth sweep point.",
        "",
        "At corrected 3.32° one-sided, pooled EE is **2.775 / 44.029 / 44.462 Mbit/J** for B/U/J, and the joint-over-unilateral gap is **+0.985%**, with **2/8** negative anchors. Served counts are **230 / 800 / 800**; the separate 50-Mbit/s target counts are **60 / 443 / 434**.",
        "",
        "Compared with corrected 1.66° one-sided, served changes by **−222 / 0 / 0** for B/U/J (`452/800/800 → 230/800/800`), while target attainment changes by **−114 / −107 / −107** (`174/550/541 → 60/443/434`). Thus the optimized selectors still touch every user-step at the source-width point, but substantially fewer attain the requested rate.",
        "",
        "At 3.32°, cap-boundary shares are **100.00% / 59.38% / 55.21%**, no-mode-boundary shares are **100.00% / 12.24% / 13.54%**, interference-limited shares are **100.00% / 82.39% / 84.02%**, top-1 shares are **42.69% / 95.56% / 95.93%**, and mean/max occupancies are **2.462/7, 3.149/13, 3.174/13** for B/U/J.",
        "",
        "## Does wider beam buy coordination value by degrading service?",
        "",
        "**In the wide-beam regime, yes; across all five points, not as a monotone one-for-one law.** The corrected gap falls slightly from +1.209% at 2.40° to +0.985% at 3.32° while target attainment also falls, so every service loss does not buy more set-level value. From 3.32° through 4.50° to 6.65°, however, the gap rises `0.985% → 3.205% → 7.315%` as optimized service degrades and cap/no-mode exposure increases.",
        "",
        "| One-sided width | Corrected gap | Served U / J | Target U / J | Cap-boundary U / J | No-mode-boundary U / J |",
        "|---:|---:|:---:|:---:|:---:|:---:|",
    ]
    for width in WIDTHS:
        receipt = data["margin"][width][1]
        summary = receipt["summary"]
        u = summary["pooled"]["UNILATERAL"]
        j = summary["pooled"]["ORACLE_SET"]
        lines.append(
            f"| {width}° | {pct(summary['oracle_set_over_unilateral_relative'])} | {u['served_count_sum']} / {j['served_count_sum']} | {u['rate_target_attained_count_sum']} / {j['rate_target_attained_count_sum']} | {pct(u['interference_structure']['cap_binding_boundary_share'])} / {pct(j['interference_structure']['cap_binding_boundary_share'])} | {pct(u['interference_structure']['no_eligible_mode_boundary_share'])} / {pct(j['interference_structure']['no_eligible_mode_boundary_share'])} |"
        )

    lines += [
        "",
        "For U/J, cap-boundary exposure rises overall from `32.29%/35.42%` at 1.66° to `79.95%/78.39%` at 6.65°. Target attainment falls `550/541 → 258/269`; served falls `800/800 → 694/722`. At the widest point, the joint selector serves 28 more user-steps and has 11 more target-attaining user-steps than unilateral, while retaining a +7.315% pooled EE gap. This quantifies the service/coordination regime without ranking a width.",
        "",
        "## Controls and trust checks",
        "",
        "Before any margin point was run, the private margin evaluator was set to an all-ones provisioning divisor. Across all five sealed receipts it matched **every ndarray field bit-for-bit** for all 40 anchors and all 120 recorded committed configurations, both at boundary 0 and over the complete 48-boundary grid. The receipt-recorded bits, joules, and served counts also matched exactly. The machine-readable assertion is `.scratch/beamwidth/divisor-one-identity.json`.",
        "",
        "Only the provisioning target changes in the margin runs: `Gamma(n)` becomes `Gamma(n) / q_0.10(e)`. The same quantile remains in transmitted-mode selection. All signs, seeds, horizons, prices, service guard, acceptance rule, rate target, per-beam cap, anchor identities, 100-user populations, unilateral ordering and strict-improvement rule, terminal certificate, joint families and catalogue caps, and 48-boundary committed scoring are unchanged. The two deterministic seeds are `3525272352645343090` and `3445540383109071487`; the corresponding TLE dates are `2026-05-30` and `2025-07-28`. The override is private and runtime-only; no sealed constant, sealed artefact, frozen manifest, source engine file, or other workspace was modified.",
        "",
        "The neutral baseline is nearest-eligible. UNILATERAL is deterministic cyclic exact best response under `F = B − eta_ref E`, with `eta_ref = 19,720,681.00172232 bit/J`, until a full pass contains no strictly improving legal move. ORACLE_SET is the same bounded catalogue: same-beam occupant subsets of size 2–4 (1,024-generation cap), victim plus top-2/top-3 physical contributors, and complete-beam evacuations, under the 4,096 global cap. UNILATERAL remains the included reference and the selection-time served count may not fall below the point's baseline.",
        "",
        "## Exact reproduction commands",
        "",
        "Run from `/home/sat/mcrl-v025-beam-ws`:",
        "",
        "```bash",
        "nice -n 15 env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \\",
        "  /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/beamwidth/assert_divisor_one.py \\",
        "  .scratch/beamwidth/sweep-one-sided-{1.66,2.40,3.32,4.50,6.65}.json \\",
        "  --output .scratch/beamwidth/divisor-one-identity.json",
        "",
        "for hp in 1.66 2.40 3.32 4.50 6.65; do",
        "  nice -n 15 env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \\",
        "    /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/beamwidth/run_beamwidth_network.py \\",
        "    --worlds 2 --anchors-per-world 4 --one-sided-hp-deg \"$hp\" --provisioning-rule margin \\",
        "    --output \".scratch/beamwidth/margin-sweep-one-sided-${hp}.json\"",
        "done",
        "",
        "nice -n 15 env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \\",
        "  /home/sat/mcrl-leo-handover/.venv/bin/python .scratch/beamwidth/replay_sealed_diagnostics.py \\",
        "  .scratch/beamwidth/sweep-one-sided-{1.66,2.40,3.32,4.50,6.65}.json \\",
        "  --output-dir .scratch/beamwidth",
        "",
        "nice -n 15 env PYTHONPATH=src /home/sat/mcrl-leo-handover/.venv/bin/python \\",
        "  .scratch/beamwidth/build_margin_report.py",
        "```",
        "",
        "The margin receipts are `.scratch/beamwidth/margin-sweep-one-sided-{1.66,2.40,3.32,4.50,6.65}.json`; the sealed diagnostic replays are `.scratch/beamwidth/sealed-diagnostics-one-sided-{1.66,2.40,3.32,4.50,6.65}.json`. Each receipt embeds the anchor rows, exact selector configurations, selection certificates, physical evaluation counts, source/tree identifiers, and internal receipt digest where applicable.",
        "",
        "## Receipt file SHA-256",
        "",
        "```text",
    ]
    paths = [HERE / "divisor-one-identity.json"]
    for rule in ("sealed", "margin"):
        paths.extend(data[rule][width][0] for width in WIDTHS)
    paths.extend(
        HERE / name
        for name in (
            "margin_batch.py",
            "run_beamwidth_network.py",
            "assert_divisor_one.py",
            "replay_sealed_diagnostics.py",
            "build_margin_report.py",
        )
    )
    for path in paths:
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        lines.append(f"{digest}  {path.relative_to(REPO)}")
    lines += ["```", ""]
    output = REPO / "BEAMWIDTH-MARGIN-SWEEP-2026-09-10.md"
    output.write_text("\n".join(lines), encoding="utf-8")
    print(output.read_text(encoding="utf-8"), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

