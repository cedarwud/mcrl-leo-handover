  4464	    actual = hashlib.sha256(encoded).hexdigest()
  4465	    if actual != cache_digest:
  4466	        raise ProbeError("prepared world tape digest disagrees with manifest")
  4467	    if sidecar.read_text(encoding="ascii").split() != [actual, target.name]:
  4468	        raise ProbeError("prepared world tape sidecar disagrees")
  4469	    if stat.S_IMODE(target.stat().st_mode) != 0o444:
  4470	        raise ProbeError("prepared world tape is not immutable mode 0444")
