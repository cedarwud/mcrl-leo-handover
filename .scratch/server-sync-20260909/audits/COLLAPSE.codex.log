+    {
+        "name": "v2-design",
+        "directory": Path(
+            "/home/sat/mcrl-v025-design-ws/artifacts/"
+            "firstrun-v2-500ep-20260910T1425Z"
+        ),
+        "corpus_digest": "ab81d942993d005e6eab964e4e1011a8b85cfed49d47fac7448a39e729514016",
+        "q1_width": 15,
+    },
+)
+
+EXPECTED_ANCHORS = 22
+EXPECTED_USERS = 100
+TARGET_EPOCH = 500
+
+
+class ProbeFailure(RuntimeError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def verified_json(path: Path) -> dict[str, Any]:
+    encoded = path.read_bytes()
+    actual = sha256(encoded).hexdigest()
+    sidecar = path.with_name(path.name + ".sha256")
+    if sidecar.is_file():
+        fields = sidecar.read_text(encoding="ascii").split()
+        if not fields or fields[0] != actual:
+            raise ProbeFailure(f"SHA-256 sidecar mismatch: {path}")
+    value = json.loads(encoded)
+    if not isinstance(value, dict):
+        raise ProbeFailure(f"JSON root is not an object: {path}")
+    return value
+
+
+def load_source_rows(receipt: Mapping[str, Any]) -> tuple[dict[str, Any], ...]:
+    corpus = receipt["corpus"]
+    root = Path(corpus["root"])
+    rows: list[dict[str, Any]] = []
+    source_files = [
+        row for row in corpus["files"] if "exact-source" in str(row["path"])
+    ]
+    if len(source_files) != EXPECTED_ANCHORS:
+        raise ProbeFailure("launch receipt does not name exactly 22 source shards")
+    for binding in source_files:
+        relative = Path(binding["path"])
+        path = (root / relative).resolve()
+        if not path.is_relative_to(root.resolve()):
+            raise ProbeFailure("source shard escapes launch-receipt corpus root")
+        if file_sha256(path) != binding["sha256"]:
+            raise ProbeFailure(f"source shard digest mismatch: {path}")
+        lines = path.read_bytes().splitlines()
+        if not lines:
+            raise ProbeFailure(f"empty source shard: {path}")
+        header = json.loads(lines[0])
+        material = [json.loads(line) for line in lines[1:]]
+        if header.get("row_count") != len(material):
+            raise ProbeFailure(f"source shard row count mismatch: {path}")
+        rows.extend(material)
+    if len(rows) != int(corpus["source_rows"]):
+        raise ProbeFailure("source-row total disagrees with launch receipt")
+    if {row.get("split") for row in rows} != {"TRAIN"}:
+        raise ProbeFailure("probe encountered a non-TRAIN row")
+    if {row.get("world_id") for row in rows} != {"V025_PROBE/world/1"}:
+        raise ProbeFailure("probe encountered a non-development world")
+    return tuple(rows)
+
+
+def anchor_tables(
+    rows: Sequence[Mapping[str, Any]],
+) -> dict[str, dict[int, tuple[Mapping[str, Any], ...]]]:
+    grouped: dict[str, dict[int, list[Mapping[str, Any]]]] = defaultdict(
+        lambda: defaultdict(list)
+    )
+    for row in rows:
+        grouped[str(row["anchor_id"])][int(row["user_id"])].append(row)
+    if len(grouped) != EXPECTED_ANCHORS:
+        raise ProbeFailure("source corpus does not contain exactly 22 anchors")
+    result: dict[str, dict[int, tuple[Mapping[str, Any], ...]]] = {}
+    for anchor_id, users in grouped.items():
+        if set(users) != set(range(EXPECTED_USERS)):
+            raise ProbeFailure(f"anchor roster mismatch: {anchor_id}")
+        result[anchor_id] = {}
+        for user, values in users.items():
+            ordered = tuple(sorted(values, key=lambda row: int(row["action_index"])))
+            indices = tuple(int(row["action_index"]) for row in ordered)
+            if indices != tuple(range(len(ordered))):
+                raise ProbeFailure(f"non-contiguous action indices: {anchor_id}, user {user}")
+            masks = {tuple(bool(value) for value in row["action_mask"]) for row in ordered}
+            if len(masks) != 1 or len(next(iter(masks))) != len(ordered):
+                raise ProbeFailure(f"action mask mismatch: {anchor_id}, user {user}")
+            if sum(bool(row["reference_action"]) for row in ordered) != 1:
+                raise ProbeFailure(f"BASE multiplicity mismatch: {anchor_id}, user {user}")
+            result[anchor_id][user] = ordered
+    return result
+
+
+def action(row: Mapping[str, Any]) -> tuple[int, int] | None:
+    payload = row["action"]
+    norad = payload["norad_id"]
+    beam = payload["beam_chain_id"]
+    if norad is None and beam is None:
+        return None
+    if not isinstance(norad, int) or not isinstance(beam, int):
+        raise ProbeFailure("malformed physical action")
+    return (norad, beam)
+
+
+def decode_hex_array(value: Any) -> np.ndarray:
+    raw = np.asarray(value, dtype=object)
+    return np.asarray([float.fromhex(str(item)) for item in raw.reshape(-1)]).reshape(
+        raw.shape
+    )
+
+
+def mlp_scores(head: Mapping[str, Any], states: np.ndarray) -> np.ndarray:
+    current = np.asarray(states, dtype=np.float64)
+    weights = [decode_hex_array(value) for value in head["weights_hex"]]
+    biases = [decode_hex_array(value) for value in head["biases_hex"]]
+    activation = str(head["activation"])
+    for index, (weight, bias) in enumerate(zip(weights, biases, strict=True)):
+        current = current @ weight + bias
+        if index != len(weights) - 1:
+            current = np.maximum(current, 0.0) if activation == "relu" else np.tanh(current)
+    return current[:, 0]
+
+
+def checkpoint_inventory(run: Mapping[str, Any]) -> tuple[dict[str, Any], ...]:
+    directory = Path(run["directory"]) / "checkpoints"
+    selected: list[dict[str, Any]] = []
+    all_epochs: dict[int, list[int]] = defaultdict(list)
+    for path in sorted(directory.glob("learner-*-epoch-*.json")):
+        stem = path.name.removesuffix(".json")
+        learner_text, epoch_text = stem.removeprefix("learner-").split("-epoch-")
+        seed, epoch = int(learner_text), int(epoch_text)
+        all_epochs[seed].append(epoch)
+        if epoch != TARGET_EPOCH:
+            continue
+        payload = verified_json(path)
+        if (
+            payload.get("schema") != "mcrl-v025-stagec-v1-lineage-checkpoint-v1"
+            or int(payload.get("learner_seed", -1)) != seed
+            or int(payload.get("completed_source_epochs", -1)) != epoch
+            or int(payload.get("route_update_count", -1)) != 3 * epoch
+            or set(payload.get("arms", {}))
+            != {"FULL", "DROP_C1", "DROP_C2", "DROP_C3", "ALL_NEUTRAL_CONTROL"}
+        ):
+            raise ProbeFailure(f"checkpoint authority mismatch: {path}")
+        selected.append(
+            {
+                "seed": seed,
+                "epoch": epoch,
+                "path": str(path),
+                "sha256": file_sha256(path),
+                "payload": payload,
+            }
+        )
+    if not selected:
+        raise ProbeFailure(f"no epoch-{TARGET_EPOCH} checkpoints in {directory}")
+    completed = {int(row["seed"]) for row in selected}
+    pending = {
+        str(seed): max(epochs)
+        for seed, epochs in sorted(all_epochs.items())
+        if seed not in completed
+    }
+    for row in selected:
+        row["pending_or_partial_seed_latest_epochs"] = pending
+    return tuple(sorted(selected, key=lambda row: int(row["seed"])))
+
+
+def learned_profiles(
+    tables: Mapping[str, Mapping[int, Sequence[Mapping[str, Any]]]],
+    checkpoints: Sequence[Mapping[str, Any]],
+    *,
+    arm: str = "FULL",
+) -> dict[int, dict[str, tuple[tuple[int, int] | None, ...]]]:
+    result: dict[int, dict[str, tuple[tuple[int, int] | None, ...]]] = {}
+    for checkpoint in checkpoints:
+        model = checkpoint["payload"]["arms"][arm]
+        by_anchor: dict[str, tuple[tuple[int, int] | None, ...]] = {}
+        for anchor_id, users in tables.items():
+            profile: list[tuple[int, int] | None] = []
+            for user in range(EXPECTED_USERS):
+                rows = users[user]
+                q1 = np.asarray(
+                    [[float.fromhex(str(value)) for value in row["q1_state"]] for row in rows]
+                )
+                q2 = np.asarray(
+                    [[float.fromhex(str(value)) for value in row["q2_state"]] for row in rows]
+                )
+                scores = mlp_scores(model["C1"], q1) + mlp_scores(model["C2"], q2)
+                mask = np.asarray(rows[0]["action_mask"], dtype=bool)
+                scores = np.where(mask, scores, -np.inf)
+                selected = int(np.argmax(scores))
+                profile.append(action(rows[selected]))
+            by_anchor[anchor_id] = tuple(profile)
+        result[int(checkpoint["seed"])] = by_anchor
+    return result
+
+
+def base_profiles(
+    tables: Mapping[str, Mapping[int, Sequence[Mapping[str, Any]]]],
+) -> dict[str, tuple[tuple[int, int] | None, ...]]:
+    result = {}
+    for anchor_id, users in tables.items():
+        result[anchor_id] = tuple(
+            action(next(row for row in users[user] if bool(row["reference_action"])))
+            for user in range(EXPECTED_USERS)
+        )
+    return result
+
+
+def myopic_profiles(
+    tables: Mapping[str, Mapping[int, Sequence[Mapping[str, Any]]]],
+) -> dict[str, tuple[tuple[int, int] | None, ...]]:
+    """Independent max-current-nominal-decoding-margin, stable index ties."""
+
+    result = {}
+    for anchor_id, users in tables.items():
+        profile = []
+        for user in range(EXPECTED_USERS):
+            rows = users[user]
+            mask = tuple(bool(value) for value in rows[0]["action_mask"])
+            selected = max(
+                (index for index, legal in enumerate(mask) if legal),
+                key=lambda index: (
+                    float.fromhex(str(rows[index]["q1_state"][0])),
+                    -index,
+                ),
+            )
+            profile.append(action(rows[selected]))
+        result[anchor_id] = tuple(profile)
+    return result
+
+
+def profile_metrics(profile: Sequence[tuple[int, int] | None]) -> dict[str, Any]:
+    if len(profile) != EXPECTED_USERS:
+        raise ProbeFailure("profile roster mismatch")
+    occupancy = Counter(value for value in profile if value is not None)
+    modal_users = max(occupancy.values(), default=0)
+    return {
+        "modal_frac": modal_users / EXPECTED_USERS,
+        "active_beams": len(occupancy),
+        "active_satellites": len({value[0] for value in occupancy}),
+        "argmax_distinct": len(occupancy) / EXPECTED_USERS,
+        "null_users": sum(value is None for value in profile),
+        "occupancies_desc": sorted(occupancy.values(), reverse=True),
+    }
+
+
+def summarize_profiles(
+    profiles: Iterable[tuple[str, Sequence[tuple[int, int] | None]]]
+) -> dict[str, Any]:
+    rows = []
+    histogram: Counter[int] = Counter()
+    for identity, profile in profiles:
+        metric = profile_metrics(profile)
+        rows.append({"identity": identity, **metric})
+        histogram.update(metric["occupancies_desc"])
+    if not rows:
+        raise ProbeFailure("cannot summarize an empty profile set")
+    fields = ("modal_frac", "active_beams", "active_satellites", "argmax_distinct", "null_users")
+    return {
+        "profile_count": len(rows),
+        "means": {field: statistics.fmean(float(row[field]) for row in rows) for field in fields},
+        "ranges": {
+            field: [
+                min(float(row[field]) for row in rows),
+                max(float(row[field]) for row in rows),
+            ]
+            for field in fields
+        },
+        "occupancy_histogram_beam_profile_instances": {
+            str(size): histogram[size] for size in sorted(histogram)
+        },
+        "per_profile": rows,
+    }
+
+
+def parse_anchor(anchor_id: str) -> tuple[int, str]:
+    parts = anchor_id.split("|")
+    if len(parts) != 3 or parts[0] != "V025_PROBE/world/1":
+        raise ProbeFailure(f"unrecognized development anchor: {anchor_id}")
+    return int(parts[1]), parts[2]
+
+
+def geometric_profiles(
+    base: Mapping[str, Sequence[tuple[int, int] | None]],
+) -> dict[str, tuple[tuple[int, int] | None, ...]]:
+    nearest_by_step = {
+        parse_anchor(anchor_id)[0]: tuple(profile)
+        for anchor_id, profile in base.items()
+        if parse_anchor(anchor_id)[1] == "nearest-eligible"
+    }
+    if set(nearest_by_step) != set(range(8)):
+        raise ProbeFailure("training panel lacks nearest-eligible BASE for steps 0..7")
+    return {
+        anchor_id: nearest_by_step[parse_anchor(anchor_id)[0]] for anchor_id in base
+    }
+
+
+def import_engine() -> Any:
+    spec = importlib.util.spec_from_file_location("v025_probe_engine", ENGINE_PATH)
+    if spec is None or spec.loader is None:
+        raise ProbeFailure("cannot load V0.25 probe engine")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def configuration(engine: Any, base: Any, profile: Sequence[tuple[int, int] | None], kind: str) -> Any:
+    mapping = {user: identity for user, identity in enumerate(profile)}
+    return engine._configuration(base, mapping, kind=kind)
+
+
+def run_physics(
+    *,
+    anchors: Sequence[Mapping[str, Any]],
+    learned_by_run: Mapping[str, Mapping[int, Mapping[str, Sequence[tuple[int, int] | None]]]],
+    geometric: Mapping[str, Sequence[tuple[int, int] | None]],
+    myopic: Mapping[str, Sequence[tuple[int, int] | None]],
+    eta_hex_values: Sequence[str],
+) -> dict[str, Any]:
+    engine = import_engine()
+    # Rebuild only the declared development world in memory.  The older local
+    # prepared tape carries a different calibration/setting and is not valid
+    # for these launch-receipt source rows.
+    from mcrl.physics_v025.provider_legacy import LegacyWorldProvider
+    from mcrl.physics_v025.tapes import build_world_tape
+
+    tape = build_world_tape(
+        domain="V025_PROBE/world/1",
+        provider=LegacyWorldProvider(role="base-collapse-diagnostic"),
+        steps=33,
+        start_time_s=0.0,
+    )
+    calibration_payload = verified_json(CALIBRATION_PATH)
+    calibration = type(
+        "DiagnosticCalibration",
+        (),
+        {
+            name: Fraction(*calibration_payload[name])
+            for name in (
+                "eta_ref",
+                "lambda_bits_per_j",
+                "kappa_bits_per_user_step",
+            )
+        },
+    )()
+    if tape.domain != "V025_PROBE/world/1" or len(tape.user_layout) != EXPECTED_USERS:
+        raise ProbeFailure("prepared tape is not the 100-user development world")
+    eta_float = float(calibration.eta_ref)
+    if {float.fromhex(value) for value in eta_hex_values} != {eta_float}:
+        raise ProbeFailure("source-row eta_ref differs from frozen calibration")
+
+    setting = engine._setting("a-r0")
+    run_setting = engine.run_setting_for("a-r0")
+    s_uni_profiles: dict[str, tuple[tuple[int, int] | None, ...]] = {}
+    s_uni_certificates = []
+    endpoint_totals: dict[str, dict[str, float]] = defaultdict(lambda: {"bits": 0.0, "joules": 0.0})
+
+    ordered_anchors = sorted(
+        anchors, key=lambda row: int(row["global_anchor_index"])
+    )
+    for anchor in ordered_anchors:
+        anchor_id = (
+            f"{anchor['world_id']}|{int(anchor['step_index'])}|{anchor['carrier']}"
+        )
+        step_index, carrier = parse_anchor(anchor_id)
+        base = engine._base_configuration(tape, step_index, carrier)
+        incumbent = engine._base_configuration(tape, max(0, step_index - 1), carrier)
+        rekeyed = engine._rekeyed_users(tape, step_index)
+        nominal = engine.StepEvaluator(
+            tape,
+            setting,
+            step_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=rekeyed,
+            field="nominal",
+            run_setting=run_setting,
+            boundary_indices=(0,),
+        )
+        selected, iterations, elapsed, missed, certificate = engine._s_uni_select(
+            base=base,
+            incumbent=incumbent,
+            tape=tape,
+            step_index=step_index,
+            evaluator=nominal,
+            calibration=calibration,
+            compute_budget_s=120.0,
+            run_setting=run_setting,
+            cell_rekeyed_users=rekeyed,
+        )
+        if missed or certificate != "NO_IMPROVING_LEGAL_UNILATERAL":
+            raise ProbeFailure(f"S_UNI did not certify at {anchor_id}: {certificate}")
+        s_uni_profiles[anchor_id] = tuple(
+            None if identity is None else tuple(identity)
+            for _user, identity in selected.assignments
+        )
+        s_uni_certificates.append(
+            {
+                "anchor_id": anchor_id,
+                "iterations": iterations,
+                "elapsed_s": elapsed,
+                "termination": certificate,
+                "diagnostic_compute_budget_s": 120.0,
+                "production_compute_budget_s": engine.S_UNI_COMPUTE_BUDGET_S,
+            }
+        )
+
+        configs: dict[str, Any] = {
+            "carrier_base": base,
+            "geometric": configuration(engine, base, geometric[anchor_id], "probe-geometric"),
+            "myopic": configuration(engine, base, myopic[anchor_id], "probe-myopic"),
+            "s_uni": selected,
+        }
+        for run_name, by_seed in learned_by_run.items():
+            for seed, profiles in by_seed.items():
+                configs[f"learned:{run_name}:{seed}"] = configuration(
+                    engine, base, profiles[anchor_id], f"probe-learned-{run_name}-{seed}"
+                )
+        realised = engine.StepEvaluator(
+            tape,
+            setting,
+            step_index,
+            transition_from=incumbent,
+            cell_rekeyed_users=rekeyed,
+            field="realised",
+            run_setting=run_setting,
+        )
+        # One configuration at a time is exact and substantially lowers the
+        # peak temporary tensor footprint versus a catalogue-wide batch.
+        for config in {value.configuration_id: value for value in configs.values()}.values():
+            realised.evaluate_many((config,))
+        for label, config in configs.items():
+            evaluated = realised.evaluate(config)
+            endpoint_totals[label]["bits"] += evaluated.bits
+            endpoint_totals[label]["joules"] += evaluated.joules
+        del realised, nominal
+        gc.collect()
+
+    endpoints = {}
+    for label, totals in endpoint_totals.items():
+        ee = totals["bits"] / totals["joules"]
+        endpoints[label] = {
+            **totals,
+            "pooled_ee_bits_per_j": ee,
+            "eta_ref_over_pooled_ee": eta_float / ee,
+            "pooled_ee_minus_eta_ref_fraction": ee / eta_float - 1.0,
+        }
+    return {
+        "tape": {
+            "construction": (
+                "in-memory build_world_tape with the source-generation physics code; "
+                "no tape was written"
+            ),
+            "physics_root": str(PHYSICS_ROOT),
+            "engine_path": str(ENGINE_PATH),
+            "engine_sha256": file_sha256(ENGINE_PATH),
+            "domain": tape.domain,
+            "seed": tape.seed,
+            "steps_read": sorted({int(row["step_index"]) for row in ordered_anchors}),
+        },
+        "calibration": {
+            "path": str(CALIBRATION_PATH),
+            "sha256": file_sha256(CALIBRATION_PATH),
+            "eta_ref_bits_per_j": eta_float,
+            "eta_ref_fraction": [calibration.eta_ref.numerator, calibration.eta_ref.denominator],
+            "source": calibration_payload["source"],
+        },
+        "s_uni": {
+            "summary": summarize_profiles(s_uni_profiles.items()),
+            "certificates": s_uni_certificates,
+            "profiles": {
+                anchor_id: [None if value is None else list(value) for value in profile]
+                for anchor_id, profile in s_uni_profiles.items()
+            },
+        },
+        "realised_endpoint_diagnostic_not_an_ee_claim": endpoints,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--skip-physics", action="store_true")
+    args = parser.parse_args()
+
+    run_results: dict[str, Any] = {}
+    base_by_run = {}
+    myopic_by_run = {}
+    learned_by_run = {}
+    eta_values: set[str] = set()
+    anchor_authority = None
+
+    for run in RUNS:
+        receipt_path = Path(run["directory"]) / "launch-receipt.json"
+        receipt = verified_json(receipt_path)
+        if (
+            receipt.get("schema") != "mcrl-v025-stagec-training-launch-receipt-v1"
+            or receipt["corpus"]["digest"] != run["corpus_digest"]
+            or len(receipt["corpus"]["anchor_list"]) != EXPECTED_ANCHORS
+        ):
+            raise ProbeFailure(f"launch-receipt authority mismatch: {receipt_path}")
+        anchors = tuple(receipt["corpus"]["anchor_list"])
+        if anchor_authority is None:
+            anchor_authority = anchors
+        elif anchors != anchor_authority:
+            raise ProbeFailure("live runs do not use the same development anchor panel")
+        rows = load_source_rows(receipt)
+        widths = {len(row["q1_state"]) for row in rows}
+        if widths != {int(run["q1_width"])}:
+            raise ProbeFailure(f"Q1 width mismatch for {run['name']}")
+        eta_values.update(str(row["eta_ref_bits_per_j_hex"]) for row in rows)
+        tables = anchor_tables(rows)
+        checkpoints = checkpoint_inventory(run)
+        learned = learned_profiles(tables, checkpoints)
+        bases = base_profiles(tables)
+        myopic = myopic_profiles(tables)
+        base_by_run[run["name"]] = bases
+        myopic_by_run[run["name"]] = myopic
+        learned_by_run[run["name"]] = learned
+
+        per_seed = {
+            str(seed): summarize_profiles(profiles.items())
+            for seed, profiles in learned.items()
+        }
+        run_results[run["name"]] = {
+            "launch_receipt": str(receipt_path),
+            "launch_receipt_sha256": file_sha256(receipt_path),
+            "corpus_root": receipt["corpus"]["root"],
+            "corpus_digest": receipt["corpus"]["digest"],
+            "q1_width": int(run["q1_width"]),
+            "checkpoint_epoch": TARGET_EPOCH,
+            "checkpoints": [
+                {
+                    key: value
+                    for key, value in checkpoint.items()
+                    if key != "payload"
+                }
+                for checkpoint in checkpoints
+            ],
+            "learned_full": summarize_profiles(
+                (
+                    f"seed={seed}|{anchor_id}",
+                    profile,
+                )
+                for seed, profiles in learned.items()
+                for anchor_id, profile in profiles.items()
+            ),
+            "learned_full_by_seed": per_seed,
+            "carrier_base": summarize_profiles(bases.items()),
+            "myopic": summarize_profiles(myopic.items()),
+        }
+
+    if len(eta_values) != 1:
+        raise ProbeFailure("eta_ref is not fixed across run corpora and anchors")
+    primary = "v2-design"
+    primary_base = base_by_run[primary]
+    primary_myopic = myopic_by_run[primary]
+    geometric = geometric_profiles(primary_base)
+    for run_name in base_by_run:
+        if geometric_profiles(base_by_run[run_name]) != geometric:
+            raise ProbeFailure("geometric carrier profiles differ between corpora")
+        if myopic_by_run[run_name] != primary_myopic:
+            raise ProbeFailure("current-margin myopic profiles differ between corpora")
+
+    payload: dict[str, Any] = {
+        "schema": "mcrl-v025-base-collapse-diagnosis-v1",
+        "scope": {
+            "split": "TRAIN",
+            "world_ids": ["V025_PROBE/world/1"],
+            "anchor_count": EXPECTED_ANCHORS,
+            "unique_step_indices": list(range(8)),
+            "users_per_anchor": EXPECTED_USERS,
+            "probe_script_reads_evaluation_only_dates": False,
+        },
+        "definitions": {
+            "learned_a0": "per-user stable masked argmax(Q1 + Q2), FULL arm",
+            "modal_frac": "largest non-null physical-beam occupancy divided by all 100 users",
+            "active_beams": "distinct selected non-null (NORAD, beam_chain_id) identities",
+            "active_satellites": "distinct selected non-null NORAD identities",
+            "argmax_distinct": "active_beams divided by all 100 users",
+            "null_users": "selected explicit null actions, reported separately",
+            "myopic": (
+                "per-user stable masked argmax of q1_state[0], the current nominal "
+                "SINR/decoding margin at the rate target; no fitted parameters, no "
+                "forecast, and no cross-user coordination"
+            ),
+        },
+        "eta_ref_hex": next(iter(eta_values)),
+        "runs": run_results,
+        "geometric_nearest_eligible": summarize_profiles(geometric.items()),
+    }
+    if not args.skip_physics:
+        assert anchor_authority is not None
+        # Source rows and checkpoint payloads are no longer needed; release
+        # them before constructing the dense physical tape.
+        del rows, tables, checkpoints
+        gc.collect()
+        payload["physics"] = run_physics(
+            anchors=anchor_authority,
+            learned_by_run=learned_by_run,
+            geometric=geometric,
+            myopic=primary_myopic,
+            eta_hex_values=tuple(eta_values),
+        )
+    usage = resource.getrusage(resource.RUSAGE_SELF)
+    payload["probe_process"] = {
+        "python": sys.executable,
+        "peak_rss_kb_before_final_serialization": usage.ru_maxrss,
+    }
+    encoded = json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n"
+    args.output.write_text(encoded, encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "status": "COMPLETE",
+                "output": str(args.output),
+                "output_sha256": file_sha256(args.output),
+                "primary_learned": payload["runs"][primary]["learned_full"]["means"],
+                "myopic": payload["runs"][primary]["myopic"]["means"],
+                "geometric": payload["geometric_nearest_eligible"]["means"],
+                "s_uni": None
+                if args.skip_physics
+                else payload["physics"]["s_uni"]["summary"]["means"],
+                "eta_ref_bits_per_j": float.fromhex(next(iter(eta_values))),
+                "peak_rss_kb": usage.ru_maxrss,
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/scripts/probe_base_collapse.py b/scripts/probe_base_collapse.py
