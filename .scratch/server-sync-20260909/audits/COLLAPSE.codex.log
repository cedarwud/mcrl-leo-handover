    79	def _setting(architecture: ArchitectureCode, treatment: str) -> PhysicsSetting:
    80	    terms = {
    81	        "0": ("0", "0", "off", "ACM"),
    82	        "T": ("T", "0", "off", "ACM"),
    83	        "S": ("0", "f", "off", "ACM"),
    84	        "H": ("0", "0", "on", "ACM"),
    85	        "SH": ("0", "f", "on", "ACM"),
    86	        "U-cap": ("0", "0", "off", "U-cap"),
    87	        "U-margin": ("0", "0", "off", "U-margin"),
    88	    }
    89	    integration, standby, interruption, rate = terms[treatment]
    90	    return PhysicsSetting(architecture, integration, standby, interruption, rate)  # type: ignore[arg-type]
