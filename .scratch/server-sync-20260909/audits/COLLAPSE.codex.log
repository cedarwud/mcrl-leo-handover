   130	def network_objective(
   131	    outcome: NetworkOutcome,
   132	    *,
   133	    lambda_bits_per_j: int | float | str | Fraction,
   134	    eta_ref: int | float | str | Fraction,
   135	    kappa_bits_per_user_step: int | float | str | Fraction,
   136	) -> Fraction:
   137	    """F = B - eta_ref E for the whole network; Phi stays separate."""
   138	
   139	    eta, _kappa = assert_calibration_prices(
   140	        lambda_bits_per_j=lambda_bits_per_j,
   141	        eta_ref=eta_ref,
   142	        kappa_bits_per_user_step=kappa_bits_per_user_step,
   143	    )
   144	    return outcome.bits - eta * outcome.joules
