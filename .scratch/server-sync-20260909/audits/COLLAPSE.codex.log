  1814	def _unilateral_factor_select(
  1815	    *,
  1816	    base: Configuration,
  1817	    catalog: Sequence[Configuration],
  1818	    factors: Mapping[str, Mapping[tuple[int, tuple[int, int] | None], Fraction]],
  1819	) -> Configuration:
  1820	    candidates = [base] + [row for row in catalog if row.changed_users == 1]
  1821	    return _set_select(
  1822	        catalog=candidates,
  1823	        evaluated={},
  1824	        factors=factors,
  1825	        include=("C1", "C2", "C3"),
  1826	        base=base,
  1827	        calibration=None,  # type: ignore[arg-type]
