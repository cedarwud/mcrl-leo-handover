   854	@dataclass(slots=True)
   855	class SetInteractionHead:
   856	    """Two-layer permutation-invariant scalar Psi MLP with hard zero anchors."""
   857	
   858	    input_weights: np.ndarray
   859	    input_bias: np.ndarray
   860	    output_weights: np.ndarray
   861	    output_bias: float
   862	    member_width: int
   863	
   864	    def clone(self) -> "SetInteractionHead":
   865	        return SetInteractionHead(
   866	            self.input_weights.copy(),
   867	            self.input_bias.copy(),
   868	            self.output_weights.copy(),
   869	            float(self.output_bias),
   870	            self.member_width,
   871	        )
   872	
   873	    def _hidden(self, values: np.ndarray) -> np.ndarray:
   874	        if values.shape[-1] != self.input_weights.shape[1]:
   875	            raise StageCContractError("set-interaction state shape drifted")
   876	        return np.tanh(values @ self.input_weights.T + self.input_bias)
   877	
   878	    def score(self, context: CoalitionContext) -> float:
   879	        if len(context.members) <= 1:
   880	            return 0.0
   881	        values = context.invariant_vector(member_width=self.member_width)
   882	        return float(self._hidden(values) @ self.output_weights + self.output_bias)
   883	
   884	    def update(self, batch: CoalitionBatch, *, learning_rate: float) -> float:
   885	        hidden = self._hidden(batch.invariant_states)
   886	        predictions = hidden @ self.output_weights + self.output_bias
   887	        residual = predictions - batch.target_psi
   888	        count = float(batch.target_psi.size)
   889	        scale = 2.0 / count
   890	        output_weights_before = self.output_weights.copy()
   891	        self.output_weights -= learning_rate * scale * (hidden.T @ residual)
   892	        self.output_bias -= learning_rate * float(scale * residual.sum())
   893	        hidden_gradient = residual[:, None] * output_weights_before[None, :] * (1.0 - hidden * hidden)
   894	        self.input_weights -= learning_rate * scale * (hidden_gradient.T @ batch.invariant_states)
   895	        self.input_bias -= learning_rate * scale * hidden_gradient.sum(axis=0)
   896	        loss = float(np.mean(residual * residual))
   897	        if not all(
   898	            np.isfinite(value).all()
   899	            for value in (self.input_weights, self.input_bias, self.output_weights)
   900	        ) or not np.isfinite(self.output_bias):
   901	            raise StageCContractError("non-finite C3 learner update")
   902	        return loss
   903	
   904	    def fit_closed_form(self, batch: CoalitionBatch, *, ridge: float = 1e-10) -> float:
   905	        """Deterministic synthetic/KAT fit of the same scalar squared-error head."""
   906	
   907	        hidden = self._hidden(batch.invariant_states)
   908	        design = np.column_stack((hidden, np.ones(hidden.shape[0])))
   909	        gram = design.T @ design + ridge * np.eye(design.shape[1])
   910	        solution = np.linalg.solve(gram, design.T @ batch.target_psi)
   911	        self.output_weights[:] = solution[:-1]
   912	        self.output_bias = float(solution[-1])
   913	        residual = design @ solution - batch.target_psi
   914	        return float(np.mean(residual * residual))
   915	
   916	    def payload(self) -> dict[str, object]:
   917	        return {
   918	            "kind": "permutation_invariant_set_conditioned_scalar",
   919	            "architecture": "two_layer_tanh_mlp_on_set_pools_and_ordered_pairwise_cross_gain_block",
   920	            "input_weights_hex": [
   921	                [float_hex(value) for value in row] for row in self.input_weights
   922	            ],
   923	            "input_bias_hex": [float_hex(value) for value in self.input_bias],
   924	            "output_weights_hex": [float_hex(value) for value in self.output_weights],
   925	            "output_bias_hex": float_hex(self.output_bias),
   926	            "member_width": self.member_width,
   927	            "anchors": {"empty": 0.0, "singleton": 0.0},
   928	        }
