    45	def classify_physical_transition(
    46	    *,
    47	    user_id: int,
    48	    before: PhysicalIdentity | None,
    49	    after: PhysicalIdentity | None,
    50	    cell_rekey: bool,
    51	    was_previously_served: bool,
    52	) -> HandoverEvent:
    53	    """Classify by physical NORAD/beam-chain, never action slot/cell ID."""
    54	
    55	    if before is None and after is None:
    56	        kind: TransitionKind = "unchanged"
    57	    elif before is None:
    58	        kind = "reentry" if was_previously_served else "initial_entry"
    59	    elif after is None:
    60	        kind = "exit"
    61	    elif before[0] != after[0]:
    62	        kind = "satellite_change"
    63	    elif before[1] != after[1]:
    64	        kind = "beam_change"
    65	    elif cell_rekey:
    66	        kind = "cell_rekey"
    67	    else:
    68	        kind = "unchanged"
    69	    return HandoverEvent(user_id, kind, before, after, cell_rekey)
