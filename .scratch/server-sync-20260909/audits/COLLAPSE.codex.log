    68	            "interruption": self.interruption,
    69	            "rate": self.rate,
    70	            "treatment": self.treatment,
    71	        }
    72	
    73	    @property
    74	    def digest(self) -> str:
    75	        encoded = json.dumps(self.payload(), sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")
    76	        return hashlib.sha256(encoded).hexdigest()
