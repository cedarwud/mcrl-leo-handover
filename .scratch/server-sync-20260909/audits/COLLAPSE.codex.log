    26	
    27	    def __post_init__(self) -> None:
    28	        if self.architecture not in {"b", "a-\u03b3", "a\u2032-\u03b3", "a-r", "a\u2032-r"}:
    29	            raise MCRLContractError("architecture is outside the sealed V0.25 v1.2 matrix")
    30	        if self.integration not in {"0", "T"}:
    31	            raise MCRLContractError("integration must be 0 or T")
    32	        if self.standby not in {"0", "f"}:
    33	            raise MCRLContractError("standby must be 0 or f")
    34	        if self.interruption not in {"off", "on"}:
    35	            raise MCRLContractError("interruption must be off or on")
    36	        if self.rate not in {"ACM", "U-cap", "U-margin"}:
    37	            raise MCRLContractError("rate must be ACM, U-cap, or U-margin")
    38	
    39	    @property
    40	    def treatment(self) -> str:
    41	        signature = (self.integration, self.standby, self.interruption, self.rate)
    42	        mapping = {
    43	            ("0", "0", "off", "ACM"): "0",
    44	            ("T", "0", "off", "ACM"): "T",
    45	            ("0", "f", "off", "ACM"): "S",
    46	            ("0", "0", "on", "ACM"): "H",
    47	            ("0", "f", "on", "ACM"): "SH",
    48	            ("0", "0", "off", "U-cap"): "U-cap",
    49	            ("0", "0", "off", "U-margin"): "U-margin",
    50	        }
    51	        try:
    52	            treatment = mapping[signature]
    53	        except KeyError:
    54	            raise MCRLContractError("setting is outside the predeclared fractional matrix") from None
    55	        if treatment.startswith("U") and self.architecture in {"a-r", "a\u2032-r"}:
    56	            raise MCRLContractError("split-U diagnostics apply only to the original architectures")
    57	        return treatment
    58	
    59	    @property
