  1790	def _set_select(
  1791	    *,
  1792	    catalog: Sequence[Configuration],
  1793	    evaluated: Mapping[str, EvaluatedProfile],
  1794	    factors: Mapping[str, Mapping[tuple[int, tuple[int, int] | None], Fraction]],
  1795	    include: Sequence[str],
  1796	    base: Configuration,
  1797	    calibration: CalibrationValues,
  1798	) -> Configuration:
  1799	    del evaluated, calibration
  1800	    base_map = dict(base.assignments)
  1801	    scored = []
  1802	    for config in catalog:
  1803	        bonus = Fraction()
  1804	        for user, identity in config.assignments:
  1805	            if identity == base_map[user]:
  1806	                continue
  1807	            bonus += sum((factors[name].get((user, identity), Fraction()) for name in include), Fraction())
  1808	        # Factor arms compare only the declared target sum.  Exact F is
  1809	        # reserved for the U1/J1/union ceiling arms and S_UNI comparator.
  1810	        scored.append((bonus, config.configuration_id, config))
  1811	    return min(scored, key=lambda row: (-row[0], row[1]))[2]
