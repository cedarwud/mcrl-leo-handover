   241	def encode_v2_shard(rows: Iterable[Mapping[str, object]]) -> bytes:
   242	    """Serialize a canonical v2 shard with its own digest in every row/header."""
   243	
   244	    material = [dict(row) for row in rows]
   245	    if not material:
   246	        raise Q1SchemaV2Error("cannot encode an empty v2 shard")
   247	    for row in material:
   248	        validate_v2_row_payload(row)
   249	    q2_digests = {row.get("q2_schema_sha256") for row in material}
   250	    if len(q2_digests) != 1:
   251	        raise Q1SchemaV2Error("v2 shard rows disagree on Q2 schema")
   252	    header = {
   253	        "schema": SHARD_V2_SCHEMA_VERSION,
   254	        "row_count": len(material),
   255	        "rows_sha256": canonical_sha256(material),
   256	        "q1_schema_sha256": Q1_V2_SCHEMA_SHA256,
   257	        "q2_schema_sha256": next(iter(q2_digests)),
   258	    }
   259	    return b"\n".join(canonical_json_bytes(value) for value in (header, *material)) + b"\n"
   260	
   261	
   262	def decode_v2_shard(encoded: bytes) -> tuple[dict[str, object], ...]:
   263	    """Read and re-check a canonical v2 shard; v1 remains owned by its reader."""
   264	
   265	    try:
   266	        values = [json.loads(line.decode("ascii")) for line in encoded.splitlines()]
   267	    except (UnicodeError, json.JSONDecodeError) as error:
   268	        raise Q1SchemaV2Error("cannot parse v2 shard") from error
   269	    if not values or not isinstance(values[0], dict):
   270	        raise Q1SchemaV2Error("v2 shard header is missing")
   271	    if encoded != b"\n".join(canonical_json_bytes(value) for value in values) + b"\n":
   272	        raise Q1SchemaV2Error("v2 shard is not canonical JSONL")
   273	    header, rows = values[0], values[1:]
   274	    if (
   275	        header.get("schema") != SHARD_V2_SCHEMA_VERSION
   276	        or header.get("q1_schema_sha256") != Q1_V2_SCHEMA_SHA256
   277	        or header.get("row_count") != len(rows)
   278	        or header.get("rows_sha256") != canonical_sha256(rows)
   279	    ):
   280	        raise Q1SchemaV2Error("v2 shard header/digest check failed")
   281	    for row in rows:
   282	        if not isinstance(row, dict):
   283	            raise Q1SchemaV2Error("v2 shard row is not an object")
   284	        validate_v2_row_payload(row)
   285	    return tuple(rows)
