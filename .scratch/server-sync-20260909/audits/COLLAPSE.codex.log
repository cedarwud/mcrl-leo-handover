   637	            if knockout != "C1":
   638	                total += model.score("C1", table.q1_states[selected]) - model.score(
   639	                    "C1", table.q1_states[baseline]
   640	                )
   240	            if len(reference_rows) != 1:
   241	                raise StageCContractError("every user-anchor requires exactly one BASE row")
   242	            reference = reference_rows[0]
