    72	def phi_qos(events: Iterable[HandoverEvent]) -> Fraction:
    73	    """Return the explicit dimensionless Phi preference (higher is better)."""
    74	
    75	    score = 0.0
    76	    for event in events:
    77	        if event.kind == "satellite_change":
    78	            score -= PHI_SATELLITE_CHANGE
    79	        elif event.kind == "beam_change":
    80	            score -= PHI_SAME_SATELLITE
    81	    return exact(score)
