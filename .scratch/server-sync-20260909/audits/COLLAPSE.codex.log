   272	            "utc": dt.datetime.now(dt.timezone.utc).isoformat(),
   273	            "previous_record_sha256": previous,
   274	        }
   275	        record["record_sha256"] = digest_payload(record)
   276	        handle.seek(0, os.SEEK_END)
   277	        handle.write(canonical_bytes(record) + b"\n")
   278	        handle.flush()
   279	        os.fsync(handle.fileno())
   280	        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
   281	    return str(record["record_sha256"])
