     2	
     3	The helpers are pure and vectorised where useful.  Random draws require an
     4	explicit generator so candidate ordering or counterfactual evaluation cannot
     5	silently acquire a private RNG stream.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import math
    11	
    12	import numpy as np
    13	
    14	from mcrl.errors import MCRLContractError
    15	from mcrl.runtime.bessel import _miller_array, bessel_j_array, bessel_j_miller
    16	
    17	from .constants_v025 import (
    18	    BOLTZMANN_J_PER_K,
    19	    CARRIER_FREQUENCY_HZ,
    20	    RICIAN_K_FACTOR_DB,
    21	    RX_ENVELOPE_A_DBI,
    22	    RX_ENVELOPE_B,
    23	    RX_GAIN_FLOOR_DBI,
    24	    RX_GAIN_MAX_DBI,
    25	    RX_S465_THETA_MIN_DEG,
    26	    SPEED_OF_LIGHT_M_S,
    27	    SYSTEM_TEMPERATURE_K,
    28	    SCINTILLATION_ELEVATION_DEG,
    29	    SCINTILLATION_LOSS_DB,
    30	    SHADOW_SIGMA_DB,
    31	    SHADOW_SIGMA_ELEVATION_DEG,
    32	    MINIMUM_ELEVATION_DEG,
    33	    TX_FULL_HPBW_DEG,
    34	    TX_G0_LINEAR,
