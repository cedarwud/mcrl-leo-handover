    36	
    37	_BESSEL_MU_COEFFICIENT = 2.07123
    38	_MU_ZERO = 1.0e-10
    39	
    40	
    41	def noise_power_w(bandwidth_hz: float) -> float:
    42	    """Return ``k*T_sys*bandwidth`` in watts."""
    43	
    44	    if not math.isfinite(bandwidth_hz) or bandwidth_hz <= 0.0:
    45	        raise ValueError("bandwidth_hz must be finite and positive")
    46	    return BOLTZMANN_J_PER_K * SYSTEM_TEMPERATURE_K * bandwidth_hz
    47	
    48	
    49	def free_space_path_gain(slant_km: np.ndarray | float) -> np.ndarray:
    50	    """Linear free-space gain; doubling distance gives exactly one quarter."""
    51	
    52	    distance = np.asarray(slant_km, dtype=np.float64)
    53	    if not np.all(np.isfinite(distance)) or np.any(distance <= 0.0):
    54	        raise MCRLContractError("slant range must be finite and positive")
    55	    wavelength = SPEED_OF_LIGHT_M_S / CARRIER_FREQUENCY_HZ
    56	    return (wavelength / (4.0 * math.pi * distance * 1000.0)) ** 2
    57	
    58	
    59	def db_loss_gain(loss_db: np.ndarray | float) -> np.ndarray:
    60	    """Convert a nonnegative dB loss to its linear power multiplier."""
    61	
    62	    loss = np.asarray(loss_db, dtype=np.float64)
    63	    if not np.all(np.isfinite(loss)) or np.any(loss < 0.0):
    64	        raise MCRLContractError("loss_db must be finite and nonnegative")
    65	    return 10.0 ** (-loss / 10.0)
    66	
    67	
    68	def scintillation_loss_db(elevation_deg: np.ndarray | float) -> np.ndarray:
    69	    """Retained 20-GHz deterministic table, linearly interpolated and clamped."""
    70	
    71	    elevation = np.asarray(elevation_deg, dtype=np.float64)
    72	    if not np.all(np.isfinite(elevation)) or np.any((elevation < -90.0) | (elevation > 90.0)):
    73	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
    74	    return np.interp(
    75	        np.clip(elevation, SCINTILLATION_ELEVATION_DEG[0], SCINTILLATION_ELEVATION_DEG[-1]),
    76	        SCINTILLATION_ELEVATION_DEG,
    77	        SCINTILLATION_LOSS_DB,
    78	    )
    79	
    80	
    81	def shadow_sigma_db(elevation_deg: np.ndarray | float) -> np.ndarray:
    82	    """Retained Ka-LOS zero-mean-dB shadow sigma table."""
    83	
    84	    elevation = np.asarray(elevation_deg, dtype=np.float64)
    85	    if not np.all(np.isfinite(elevation)) or np.any((elevation < -90.0) | (elevation > 90.0)):
    86	        raise MCRLContractError("elevation must be finite and in [-90,90] degrees")
    87	    return np.interp(
    88	        np.clip(elevation, SHADOW_SIGMA_ELEVATION_DEG[0], SHADOW_SIGMA_ELEVATION_DEG[-1]),
    89	        SHADOW_SIGMA_ELEVATION_DEG,
    90	        SHADOW_SIGMA_DB,
    91	    )
    92	
    93	
    94	def transmit_gain_linear(theta_deg: np.ndarray | float) -> np.ndarray:
    95	    """HOBS ideal aperture pattern, with full-HPBW converted once."""
    96	
    97	    theta = np.asarray(theta_deg, dtype=np.float64)
    98	    if not np.all(np.isfinite(theta)):
    99	        raise MCRLContractError("off-axis angles must be finite")
   100	    half_power = math.radians(TX_FULL_HPBW_DEG / 2.0)
   101	    mu = _BESSEL_MU_COEFFICIENT * np.sin(np.radians(theta)) / math.sin(half_power)
   102	    flat = np.atleast_1d(mu).ravel()
   103	    on_axis = np.abs(flat) < _MU_ZERO
   104	    safe = np.where(on_axis, 1.0, flat)
   105	    # The historical ascending series is already measurably inaccurate at
   106	    # mu=34.  Route the new engine to stable Miller recursion from mu>=20;
   107	    # keep the vectorised series only in its well-conditioned main-lobe range.
   108	    stable = np.abs(safe) >= 20.0
   109	    j1 = np.empty_like(safe)
   110	    j3 = np.empty_like(safe)
   111	    if np.any(~stable):
   112	        series_rows = bessel_j_array((1, 3), safe[~stable])
   113	        j1[~stable] = series_rows[0]
   114	        j3[~stable] = series_rows[1]
   115	    if np.any(stable):
   116	        stable_values = safe[stable]
   117	        stable_rows = _miller_array((1, 3), np.abs(stable_values))
   118	        signs = np.where(stable_values < 0.0, -1.0, 1.0)
   119	        j1[stable] = stable_rows[0] * signs
   120	        j3[stable] = stable_rows[1] * signs
   121	    bracket = j1 / (2.0 * safe) + 36.0 * j3 / safe**3
   122	    result = TX_G0_LINEAR * bracket**2
   123	    result[on_axis] = TX_G0_LINEAR
   124	    return result.reshape(theta.shape)
   125	
   126	
   127	def receive_gain_dbi(separation_deg: np.ndarray | float) -> np.ndarray:
   128	    """S.465-6 envelope with the declared near-axis approximation.
   129	
   130	    For this terminal ``D/lambda < 50`` and the applicable lower boundary is
   131	    2.043298703 degrees.  S.465-6 supplies ``32 - 25 log10(theta)`` from that
   132	    boundary to 48 degrees and the -10 dBi continuation thereafter.  Below
   133	    the boundary V0.25 deliberately extends the same analytic envelope up to
   134	    the independently sourced 35 dBi terminal peak.  That last branch is an
   135	    engineering approximation, not a prescription of S.465-6.
   136	    """
   137	
   138	    separation = np.asarray(separation_deg, dtype=np.float64)
   139	    if not np.all(np.isfinite(separation)) or np.any(separation < 0.0):
   140	        raise MCRLContractError("receive separations must be finite and nonnegative")
   141	    with np.errstate(divide="ignore"):
   142	        near_axis_approximation = RX_ENVELOPE_A_DBI - RX_ENVELOPE_B * np.log10(
   143	            np.maximum(separation, 1.0e-12)
   144	        )
   145	        s465_envelope = RX_ENVELOPE_A_DBI - RX_ENVELOPE_B * np.log10(
   146	            np.maximum(separation, RX_S465_THETA_MIN_DEG)
   147	        )
   148	    result = np.where(
   149	        separation < RX_S465_THETA_MIN_DEG,
   150	        near_axis_approximation,
   151	        s465_envelope,
   152	    )
   153	    return np.clip(result, RX_GAIN_FLOOR_DBI, RX_GAIN_MAX_DBI)
   154	
   155	
   156	def receive_gain_linear(separation_deg: np.ndarray | float) -> np.ndarray:
