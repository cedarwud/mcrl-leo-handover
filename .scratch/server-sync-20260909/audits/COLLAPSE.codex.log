   326	class LineageOrchestrator:
   327	    """Five matched learned arms plus an external BASELINE policy."""
   328	
   329	    def __init__(
   330	        self,
   331	        *,
   332	        learner_seed: int,
   333	        batches: Mapping[Route, PairwiseBatch],
   334	        learning_rate: float = 0.02,
   335	        gauge_weight: float = 0.01,
   336	    ) -> None:
   337	        if set(batches) != set(ROUTES):
   338	            raise StageCContractError("orchestrator needs exactly C1/C2/C3 batches")
   339	        self.learner_seed = int(learner_seed)
   340	        self.batches = dict(batches)
   341	        self.learning_rate = float(learning_rate)
   342	        self.gauge_weight = float(gauge_weight)
   343	        dimensions = {route: batch.reference_states.shape[1] for route, batch in batches.items()}
   344	        template = _initial_model(self.learner_seed, dimensions)
   345	        self.initialization_payload = template.payload()
   346	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
   347	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
   348	        self.completed_source_epochs = 0
   349	        self.route_update_count = 0
   350	        self.loss_history: list[dict[str, object]] = []
   351	
   352	    @property
   353	    def batch_digests(self) -> dict[str, str]:
   354	        return {route: self.batches[route].digest for route in ROUTES}
   355	
   356	    @property
   357	    def source_authority_sha256(self) -> str:
   358	        authorities = {
   359	            batch.source_authority_sha256 for batch in self.batches.values()
   360	        }
   361	        if len(authorities) != 1:
   362	            raise StageCContractError("route batches disagree on source authority")
   363	        return next(iter(authorities))
   364	
   365	    def train_epoch(self) -> dict[str, dict[str, float]]:
   366	        """One deterministic pass over C1, C2, C3 fixed aggregate batches."""
   367	
   368	        epoch_losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
   369	        for route in ROUTES:
   370	            informed = self.batches[route]
   371	            neutral = informed.neutral()
   372	            for arm in LEARNED_ARMS:
   373	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
   374	                epoch_losses[arm][route] = self.models[arm].heads[route].update(
   375	                    batch,
   376	                    learning_rate=self.learning_rate,
   377	                    gauge_weight=self.gauge_weight,
   378	                )
   379	            self.route_update_count += 1
   380	        self.completed_source_epochs += 1
   381	        self.loss_history.append({"epoch": self.completed_source_epochs, "losses": epoch_losses})
   382	        return epoch_losses
   383	
   384	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
   385	        if isinstance(epochs, bool) or epochs < 0:
   386	            raise StageCContractError("epochs must be a nonnegative integer")
   387	        for _ in range(epochs):
   388	            self.train_epoch()
   389	            if (
   390	                checkpoint_directory is not None
   391	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
   392	            ):
   393	                path = Path(checkpoint_directory) / (
   394	                    f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
   395	                )
   396	                self.write_checkpoint(path)
   397	
   398	    def checkpoint_payload(self) -> dict[str, object]:
   399	        return {
   400	            "schema": CHECKPOINT_SCHEMA,
   401	            "learner_seed": self.learner_seed,
   402	            "completed_source_epochs": self.completed_source_epochs,
   403	            "route_update_count": self.route_update_count,
   404	            "updates_per_source_epoch": len(ROUTES),
   405	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
   406	            "q1_schema_sha256": active_encoder_variant().q1_schema_sha256,
   407	            "q2_schema_sha256": active_encoder_variant().q2_schema_sha256,
   408	            "batch_digests": self.batch_digests,
   409	            "source_authority_sha256": self.source_authority_sha256,
   410	            "initialization_sha256": self.initialization_sha256,
   411	            "initialization": self.initialization_payload,
   412	            "arm_order": list(ARM_ORDER),
   413	            "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS},
   414	            "arm_order": list(ARM_ORDER),
   415	            "arms": {arm: self.models[arm].payload() for arm in LEARNED_ARMS},
   416	            "optimizer": {
   417	                "kind": "deterministic_full_batch_gradient_descent",
   418	                "learning_rate_hex": float_hex(self.learning_rate),
   419	                "gauge_weight_hex": float_hex(self.gauge_weight),
   420	                "state": "stateless",
   421	            },
   422	            "zero_bootstrap": True,
   423	        }
   424	
   425	    def write_checkpoint(self, path: str | Path) -> str:
   426	        return write_once_json(path, self.checkpoint_payload())
   427	
   428	    def load_checkpoint(self, path: str | Path) -> None:
   429	        payload = read_verified_json(path)
   430	        if not isinstance(payload, dict) or payload.get("schema") != CHECKPOINT_SCHEMA:
   431	            raise StageCContractError("unsupported checkpoint schema")
   432	        fixed = {
   433	            "learner_seed": self.learner_seed,
   434	            "batch_digests": self.batch_digests,
   435	            "source_authority_sha256": self.source_authority_sha256,
   436	            "initialization_sha256": self.initialization_sha256,
   437	            "initialization": self.initialization_payload,
   438	            "arm_order": list(ARM_ORDER),
   439	            "source_map": {arm: dict(SOURCE_MAP[arm]) for arm in LEARNED_ARMS},
   440	            "arm_order": list(ARM_ORDER),
   441	            "q1_schema_sha256": active_encoder_variant().q1_schema_sha256,
   442	            "q2_schema_sha256": active_encoder_variant().q2_schema_sha256,
   443	            "checkpoint_every_source_epochs": CHECKPOINT_EVERY_SOURCE_EPOCHS,
   444	            "updates_per_source_epoch": len(ROUTES),
   445	            "zero_bootstrap": True,
   446	        }
   447	        for field, expected in fixed.items():
   448	            if payload.get(field) != expected:
   449	                raise StageCContractError(f"checkpoint {field} mismatch")
   450	        optimizer = payload.get("optimizer")
   451	        expected_optimizer = {
   452	            "kind": "deterministic_full_batch_gradient_descent",
   453	            "learning_rate_hex": float_hex(self.learning_rate),
   454	            "gauge_weight_hex": float_hex(self.gauge_weight),
   455	            "state": "stateless",
   456	        }
   457	        if optimizer != expected_optimizer:
   458	            raise StageCContractError("checkpoint optimizer state mismatch")
   459	        completed = int(payload.get("completed_source_epochs", -1))
   460	        updates = int(payload.get("route_update_count", -1))
   461	        if completed < 0 or updates != completed * len(ROUTES):
   462	            raise StageCContractError("checkpoint source-epoch cursor is invalid")
   463	        arms = payload.get("arms")
   464	        if not isinstance(arms, dict) or set(arms) != set(LEARNED_ARMS):
   465	            raise StageCContractError("checkpoint arm inventory drifted")
   466	        for arm in LEARNED_ARMS:
   467	            arm_payload = arms[arm]
   468	            if not isinstance(arm_payload, dict) or set(arm_payload) != set(ROUTES):
   469	                raise StageCContractError("checkpoint head inventory drifted")
   470	            for route in ROUTES:
   471	                head_payload = arm_payload[route]
   472	                if not isinstance(head_payload, dict):
   473	                    raise StageCContractError("checkpoint head payload drifted")
   474	                weights = np.asarray(
   475	                    [parse_float_hex(value, field="weight") for value in head_payload["weights_hex"]],
   476	                    dtype=np.float64,
   477	                )
   478	                if weights.shape != self.models[arm].heads[route].weights.shape:
   479	                    raise StageCContractError("checkpoint head shape drifted")
   480	                self.models[arm].heads[route].weights[:] = weights
   481	                self.models[arm].heads[route].bias = parse_float_hex(
   482	                    head_payload["bias_hex"], field="bias"
   483	                )
   484	        self.completed_source_epochs = completed
   485	        self.route_update_count = updates
