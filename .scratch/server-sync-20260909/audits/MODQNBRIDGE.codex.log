@@ -0,0 +1,507 @@
+"""Option-independent pieces of the V0.25 to legacy MODQN bridge.
+
+The module deliberately does not load a policy or call physics.  In particular,
+``project_v025_anchor`` fails closed because the authenticated V0.25 anchor
+surface does not contain three of the four native legacy observation blocks.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+import hashlib
+import os
+from pathlib import Path
+import stat
+from typing import Iterator, Sequence
+
+import numpy as np
+
+
+NUM_SATELLITE_SLOTS = 4
+NUM_BEAM_SLOTS = 7
+NUM_ACTIONS = NUM_SATELLITE_SLOTS * NUM_BEAM_SLOTS
+LEGACY_STATE_DIM = 4 * NUM_ACTIONS
+NO_OP_ACTION = -1
+EXPECTED_CHECKPOINT_SHA256 = (
+    "e6b063efea8608fd1e46ac15d5442aa8d1171dffc9f0b5e8cc209eca1b09c28b"
+)
+
+
+class BridgeContractError(RuntimeError):
+    """An input cannot satisfy the bridge contract without guessing."""
+
+
+class IncompleteProjectionError(BridgeContractError):
+    """The authenticated V0.25 anchor lacks required legacy state."""
+
+    def __init__(self, missing_indices: Sequence[int]) -> None:
+        self.missing_indices = tuple(int(index) for index in missing_indices)
+        super().__init__(
+            "V0.25 anchor cannot supply the complete legacy 112-D observation; "
+            f"missing legacy indices {self.missing_indices[0]}.."
+            f"{self.missing_indices[-1]} ({len(self.missing_indices)} fields)"
+        )
+
+
+class JointInvalidityError(BridgeContractError):
+    """Independent legacy choices form an invalid V0.25 joint profile."""
+
+
+@dataclass(frozen=True, order=True, slots=True)
+class PhysicalIdentity:
+    """One V0.25 physical action: ``(NORAD, beam-chain)``."""
+
+    norad_id: int
+    beam_chain_id: int
+
+    def __post_init__(self) -> None:
+        if type(self.norad_id) is not int or self.norad_id < 0:
+            raise BridgeContractError("NORAD id must be a nonnegative exact integer")
+        if type(self.beam_chain_id) is not int or self.beam_chain_id < 0:
+            raise BridgeContractError(
+                "beam-chain id must be a nonnegative exact integer"
+            )
+
+
+def slot_coordinates(legacy_slot: int) -> tuple[int, int]:
+    """Return the satellite-major ``(satellite_slot, beam_slot)`` pair."""
+
+    if type(legacy_slot) is not int or not 0 <= legacy_slot < NUM_ACTIONS:
+        raise BridgeContractError(f"legacy slot must be in 0..{NUM_ACTIONS - 1}")
+    return divmod(legacy_slot, NUM_BEAM_SLOTS)
+
+
+def legacy_slot(satellite_slot: int, beam_slot: int) -> int:
+    """Flatten a V0.25 4 x 7 coordinate using ``7*l + j``."""
+
+    if type(satellite_slot) is not int or not 0 <= satellite_slot < NUM_SATELLITE_SLOTS:
+        raise BridgeContractError("satellite slot must be in 0..3")
+    if type(beam_slot) is not int or not 0 <= beam_slot < NUM_BEAM_SLOTS:
+        raise BridgeContractError("beam slot must be in 0..6")
+    return NUM_BEAM_SLOTS * satellite_slot + beam_slot
+
+
+@dataclass(frozen=True, slots=True)
+class ActionRoster:
+    """One user's anchor-local binding between 28 slots and physical actions."""
+
+    identities: tuple[PhysicalIdentity | None, ...]
+    legal: tuple[bool, ...]
+
+    def __post_init__(self) -> None:
+        if len(self.identities) != NUM_ACTIONS or len(self.legal) != NUM_ACTIONS:
+            raise BridgeContractError("action roster must contain exactly 28 slots")
+        if any(type(value) is not bool for value in self.legal):
+            raise BridgeContractError("action roster legal flags must be exact booleans")
+        present = tuple(identity for identity in self.identities if identity is not None)
+        if len(present) != len(set(present)):
+            raise BridgeContractError("physical identities must be unique within a roster")
+        if any(
+            enabled and self.identities[index] is None
+            for index, enabled in enumerate(self.legal)
+        ):
+            raise BridgeContractError("a legal legacy slot must have a physical identity")
+
+    @classmethod
+    def from_v025_rows(
+        cls,
+        *,
+        user_id: int,
+        row_user_ids: Sequence[int] | np.ndarray,
+        legacy_action_indices: Sequence[int] | np.ndarray,
+        physical_identities: Sequence[Sequence[int]] | np.ndarray,
+        decision_legal: Sequence[bool] | np.ndarray,
+    ) -> "ActionRoster":
+        """Build from a V0.25 ``PrimitiveStepArrays`` decision boundary.
+
+        Rows whose ``legacy_action_index`` is ``-1`` are V0.25 audit rows and
+        are intentionally not actions.  All other selected-user rows retain
+        their anchor-local legacy slot, including currently illegal rows.
+        """
+
+        users = np.asarray(row_user_ids)
+        slots = np.asarray(legacy_action_indices)
+        identities = np.asarray(physical_identities)
+        legal_flags = np.asarray(decision_legal)
+        rows = users.shape[0] if users.ndim == 1 else -1
+        if (
+            rows < 0
+            or slots.shape != (rows,)
+            or identities.shape != (rows, 2)
+            or legal_flags.shape != (rows,)
+        ):
+            raise BridgeContractError("V0.25 row arrays have inconsistent shapes")
+        if users.dtype.kind not in "iu" or slots.dtype.kind not in "iu":
+            raise BridgeContractError("V0.25 user and legacy-slot arrays must be integer")
+        if legal_flags.dtype != np.dtype(bool):
+            raise BridgeContractError("V0.25 decision legality must be boolean")
+        if identities.dtype.kind not in "iu":
+            raise BridgeContractError("V0.25 identities must be integer pairs")
+
+        by_slot: list[PhysicalIdentity | None] = [None] * NUM_ACTIONS
+        mask = [False] * NUM_ACTIONS
+        for row in np.flatnonzero(users == user_id).tolist():
+            slot = int(slots[row])
+            if slot == NO_OP_ACTION:
+                continue
+            if not 0 <= slot < NUM_ACTIONS:
+                raise BridgeContractError("V0.25 row has an invalid legacy action index")
+            if by_slot[slot] is not None:
+                raise BridgeContractError("V0.25 rows duplicate a legacy action index")
+            identity = PhysicalIdentity(
+                int(identities[row, 0]), int(identities[row, 1])
+            )
+            by_slot[slot] = identity
+            mask[slot] = bool(legal_flags[row])
+        return cls(tuple(by_slot), tuple(mask))
+
+    @property
+    def mask(self) -> np.ndarray:
+        result = np.asarray(self.legal, dtype=np.bool_)
+        result.setflags(write=False)
+        return result
+
+    def physical_for_slot(
+        self, slot: int, *, require_legal: bool = True
+    ) -> PhysicalIdentity:
+        slot_coordinates(slot)
+        if require_legal and not self.legal[slot]:
+            raise BridgeContractError(f"legacy slot {slot} is not legal")
+        identity = self.identities[slot]
+        if identity is None:
+            raise BridgeContractError(f"legacy slot {slot} has no physical identity")
+        return identity
+
+    def slot_for_physical(
+        self, identity: PhysicalIdentity, *, require_legal: bool = True
+    ) -> int:
+        if not isinstance(identity, PhysicalIdentity):
+            raise BridgeContractError("identity must be PhysicalIdentity")
+        try:
+            slot = self.identities.index(identity)
+        except ValueError:
+            raise BridgeContractError("physical identity is absent from this roster") from None
+        if require_legal and not self.legal[slot]:
+            raise BridgeContractError("physical identity is not legal at this anchor")
+        return slot
+
+    def verify_legal_round_trip(self) -> int:
+        """Assert physical -> slot -> physical identity for every legal option."""
+
+        count = 0
+        for slot, enabled in enumerate(self.legal):
+            if not enabled:
+                continue
+            identity = self.physical_for_slot(slot)
+            if self.physical_for_slot(self.slot_for_physical(identity)) != identity:
+                raise BridgeContractError("physical identity round trip failed")
+            count += 1
+        return count
+
+
+@dataclass(frozen=True, slots=True)
+class ProjectionField:
+    index: int
+    legacy_name: str
+    slot: int
+    unit: str
+    transform: str
+    v025_source: str
+    status: str
+
+
+def projection_fields() -> tuple[ProjectionField, ...]:
+    """Return the complete 112-field audit table in legacy concatenation order."""
+
+    fields: list[ProjectionField] = []
+    definitions = (
+        (
+            "access_vector",
+            "dimensionless 0/1",
+            "raw float32",
+            "previous committed physical association compared with the 28-slot roster",
+            "derived",
+        ),
+        (
+            "channel_quality",
+            "linear SINR (encoded dimensionless)",
+            "float32(log1p(max(SINR_linear, 0)))",
+            "MISSING: V0.25 has direct gain/configuration margins, not the legacy candidate SINR under previous-step interference",
+            "missing",
+        ),
+        (
+            "beam_offsets",
+            "radian",
+            "raw float32 radians",
+            "MISSING: the compact V0.25 tape does not retain the 28 raw direct off-axis angles; the pilot action-row fallback writes 0.0 placeholders",
+            "missing",
+        ),
+        (
+            "beam_loads",
+            "users (encoded users/user)",
+            "float32(pre-admission count) / num_users",
+            "MISSING: V0.25 exposes served/background occupancy, not legacy previous ungated pre-admission demand",
+            "missing",
+        ),
+    )
+    for block, (name, unit, transform, source, status) in enumerate(definitions):
+        for slot in range(NUM_ACTIONS):
+            fields.append(
+                ProjectionField(
+                    block * NUM_ACTIONS + slot,
+                    f"{name}[{slot}]",
+                    slot,
+                    unit,
+                    transform,
+                    source,
+                    status,
+                )
+            )
+    if tuple(field.index for field in fields) != tuple(range(LEGACY_STATE_DIM)):
+        raise AssertionError("projection audit table is not exactly 112 fields")
+    return tuple(fields)
+
+
+@dataclass(frozen=True, slots=True)
+class ProjectionInspection:
+    """The recoverable prefix plus the exact fields that are unavailable."""
+
+    access_vector: np.ndarray
+    missing_indices: tuple[int, ...]
+
+    @property
+    def complete(self) -> bool:
+        return not self.missing_indices
+
+
+def inspect_v025_projection(
+    roster: ActionRoster,
+    *,
+    previous_association: PhysicalIdentity | None,
+) -> ProjectionInspection:
+    """Derive only what the authenticated V0.25 anchor actually supplies."""
+
+    if not isinstance(roster, ActionRoster):
+        raise BridgeContractError("roster must be ActionRoster")
+    access = np.zeros(NUM_ACTIONS, dtype=np.float32)
+    if previous_association is not None:
+        try:
+            slot = roster.slot_for_physical(previous_association, require_legal=False)
+        except BridgeContractError:
+            # The incumbent has left the current candidate roster: legacy x(t-1)
+            # is the all-zero row, not a guessed replacement slot.
+            pass
+        else:
+            access[slot] = np.float32(1.0)
+    access.setflags(write=False)
+    missing = tuple(
+        field.index for field in projection_fields() if field.status == "missing"
+    )
+    return ProjectionInspection(access, missing)
+
+
+def project_v025_anchor(
+    roster: ActionRoster,
+    *,
+    previous_association: PhysicalIdentity | None,
+) -> np.ndarray:
+    """Fail closed instead of fabricating the unavailable 84 state values."""
+
+    inspection = inspect_v025_projection(
+        roster, previous_association=previous_association
+    )
+    if inspection.missing_indices:
+        raise IncompleteProjectionError(inspection.missing_indices)
+    raise AssertionError("projection schema unexpectedly declared itself complete")
+
+
+def _native_block(value: Sequence[float] | np.ndarray, *, name: str) -> np.ndarray:
+    array = np.asarray(value)
+    if array.shape != (NUM_ACTIONS,) or array.dtype.kind not in "biuf":
+        raise BridgeContractError(f"{name} must be a real numeric (28,) array")
+    if not bool(np.isfinite(array).all()):
+        raise BridgeContractError(f"{name} contains nonfinite values")
+    return np.array(array, copy=True)
+
+
+def encode_legacy_native_observation(
+    *,
+    access_vector: Sequence[float] | np.ndarray,
+    channel_quality_linear: Sequence[float] | np.ndarray,
+    beam_offsets_rad: Sequence[float] | np.ndarray,
+    beam_loads_users: Sequence[float] | np.ndarray,
+    num_users: int,
+) -> np.ndarray:
+    """Reproduce the admitted adapter's encoding for native legacy inputs.
+
+    This is a parity/KAT seam only.  It does not claim that V0.25 supplies the
+    three missing native blocks and is intentionally not called by
+    :func:`project_v025_anchor`.
+    """
+
+    if type(num_users) is not int or num_users < 1:
+        raise BridgeContractError("num_users must be a positive exact integer")
+    access = _native_block(access_vector, name="access_vector")
+    quality = _native_block(channel_quality_linear, name="channel_quality_linear")
+    angles = _native_block(beam_offsets_rad, name="beam_offsets_rad")
+    loads = _native_block(beam_loads_users, name="beam_loads_users")
+    if not bool(np.isin(access, (0, 1)).all()) or np.count_nonzero(access) > 1:
+        raise BridgeContractError("access_vector must be one-hot or empty")
+    if bool(np.any(quality < 0)) or bool(np.any(loads < 0)):
+        raise BridgeContractError("channel quality and beam loads must be nonnegative")
+    encoded = np.concatenate(
+        (
+            access.astype(np.float32),
+            np.log1p(np.maximum(quality.astype(np.float64), 0.0)).astype(np.float32),
+            angles.astype(np.float32),
+            loads.astype(np.float32) / num_users,
+        )
+    )
+    if encoded.shape != (LEGACY_STATE_DIM,):
+        raise AssertionError("legacy encoding did not produce 112 values")
+    encoded.setflags(write=False)
+    return encoded
+
+
+def masked_argmax(
+    scores: Sequence[float] | np.ndarray,
+    mask: Sequence[bool] | np.ndarray,
+) -> int:
+    """Legacy edge rule: lowest-index legal maximum, or ``-1`` if empty."""
+
+    values = np.asarray(scores, dtype=np.float64)
+    legal = np.asarray(mask)
+    if values.shape != (NUM_ACTIONS,) or legal.shape != (NUM_ACTIONS,):
+        raise BridgeContractError("scores and mask must each have shape (28,)")
+    if legal.dtype != np.dtype(bool):
+        raise BridgeContractError("mask must be boolean")
+    indices = np.flatnonzero(legal)
+    if indices.size == 0:
+        return NO_OP_ACTION
+    if not bool(np.isfinite(values[legal]).all()):
+        raise BridgeContractError("legal scores must be finite")
+    masked = values.copy()
+    masked[~legal] = -np.inf
+    return int(np.argmax(masked))
+
+
+def validate_per_user_actions(
+    actions: Sequence[int] | np.ndarray,
+    rosters: Sequence[ActionRoster],
+) -> np.ndarray:
+    """Require a legal slot, or no-op exactly when that user's mask is empty."""
+
+    chosen = np.asarray(actions)
+    if chosen.dtype.kind not in "iu" or chosen.shape != (len(rosters),):
+        raise BridgeContractError("one integer action is required per user")
+    for user, raw in enumerate(chosen.tolist()):
+        action = int(raw)
+        roster = rosters[user]
+        if action == NO_OP_ACTION:
+            if any(roster.legal):
+                raise BridgeContractError(
+                    f"user {user} emitted no-op despite a nonempty mask"
+                )
+            continue
+        if not 0 <= action < NUM_ACTIONS or not roster.legal[action]:
+            raise BridgeContractError(
+                f"user {user} selected an illegal legacy slot {action}"
+            )
+    result = np.asarray(chosen, dtype=np.int64).copy()
+    result.setflags(write=False)
+    return result
+
+
+def finalize_joint_profile(
+    actions: Sequence[int] | np.ndarray,
+    rosters: Sequence[ActionRoster],
+    *,
+    jointly_valid: bool,
+) -> np.ndarray:
+    """Validate per-user choices and fail closed on joint invalidity.
+
+    The legacy adapter selects rows independently and owns no joint repair.
+    Choosing a V0.25 catalogue score/fallback here would define the comparator,
+    so this option-independent bridge rejects an invalid joint profile.
+    """
+
+    chosen = validate_per_user_actions(actions, rosters)
+    if type(jointly_valid) is not bool:
+        raise BridgeContractError("jointly_valid must be an exact boolean")
+    if not jointly_valid:
+        raise JointInvalidityError(
+            "legacy adapter defines no joint repair; owner binding is required"
+        )
+    return chosen
+
+
+def checkpoint_sha256(path: str | Path) -> str:
+    """Hash one regular, non-symlink checkpoint through a no-follow descriptor."""
+
+    candidate = Path(path)
+    absolute = Path(os.path.abspath(candidate))
+    if Path(os.path.realpath(candidate)) != absolute:
+        raise BridgeContractError("checkpoint path must not contain a symlink")
+    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
+    descriptor = os.open(os.fspath(candidate), flags)
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode):
+            raise BridgeContractError("checkpoint must be a regular file")
+        digest = hashlib.sha256()
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            digest.update(chunk)
+        return digest.hexdigest()
+    finally:
+        os.close(descriptor)
+
+
+@contextmanager
+def unchanged_checkpoint(
+    path: str | Path,
+    *,
+    expected_sha256: str = EXPECTED_CHECKPOINT_SHA256,
+) -> Iterator[str]:
+    """Assert the checkpoint digest both before and after a read-only operation."""
+
+    before = checkpoint_sha256(path)
+    if before != expected_sha256:
+        raise BridgeContractError(
+            f"checkpoint digest mismatch before operation: {before}"
+        )
+    try:
+        yield before
+    finally:
+        after = checkpoint_sha256(path)
+        if after != before or after != expected_sha256:
+            raise BridgeContractError(
+                f"checkpoint bytes changed: before={before}, after={after}"
+            )
+
+
+__all__ = [
+    "ActionRoster",
+    "BridgeContractError",
+    "EXPECTED_CHECKPOINT_SHA256",
+    "IncompleteProjectionError",
+    "JointInvalidityError",
+    "LEGACY_STATE_DIM",
+    "NO_OP_ACTION",
+    "NUM_ACTIONS",
+    "PhysicalIdentity",
+    "checkpoint_sha256",
+    "encode_legacy_native_observation",
+    "finalize_joint_profile",
+    "inspect_v025_projection",
+    "legacy_slot",
+    "masked_argmax",
+    "project_v025_anchor",
+    "projection_fields",
+    "slot_coordinates",
+    "unchanged_checkpoint",
+    "validate_per_user_actions",
+]
