+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+
+import numpy as np
+
+
+WORKSPACE = Path(__file__).resolve().parents[1]
+SOURCE_ROOT = WORKSPACE / "src"
+V025_ROOT = Path("/home/sat/mcrl-v025-retrain-ws")
+V025_SOURCE_ROOT = V025_ROOT / "src"
+ADAPTER_PATH = (
+    V025_ROOT
+    / ".scratch/multi-catfish-v023-baseline-adapter/baseline_adapter.py"
+)
+CHECKPOINT_PATH = (
+    V025_ROOT
+    / "artifacts/training-2026-08-25-rerun01/main/final-checkpoint.pt"
+)
+for path in (SOURCE_ROOT, V025_SOURCE_ROOT):
+    if str(path) not in sys.path:
+        sys.path.insert(0, str(path))
+
+from modqn_bridge import (  # noqa: E402
+    ActionRoster,
+    BridgeContractError,
+    EXPECTED_CHECKPOINT_SHA256,
+    IncompleteProjectionError,
+    JointInvalidityError,
+    NO_OP_ACTION,
+    NUM_ACTIONS,
+    PhysicalIdentity,
+    checkpoint_sha256,
+    encode_legacy_native_observation,
+    finalize_joint_profile,
+    inspect_v025_projection,
+    legacy_slot,
+    masked_argmax,
+    project_v025_anchor,
+    projection_fields,
+    slot_coordinates,
+    unchanged_checkpoint,
+)
+
+
+def _load_legacy_adapter_module():
+    name = "modqn_bridge_test_legacy_adapter"
+    if name in sys.modules:
+        return sys.modules[name]
+    spec = importlib.util.spec_from_file_location(name, ADAPTER_PATH)
+    if spec is None or spec.loader is None:
+        raise RuntimeError("could not load legacy adapter")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _roster(seed: int, legal_slots: set[int]) -> ActionRoster:
+    identities = tuple(
+        PhysicalIdentity(seed + slot // 7, 10_000 + seed * 100 + slot % 7)
+        for slot in range(NUM_ACTIONS)
+    )
+    return ActionRoster(
+        identities,
+        tuple(slot in legal_slots for slot in range(NUM_ACTIONS)),
+    )
+
+
+class SlotRosterTests(unittest.TestCase):
+    def test_flat_slot_roster_is_exact_4_by_7(self) -> None:
+        for slot in range(NUM_ACTIONS):
+            satellite, beam = slot_coordinates(slot)
+            self.assertEqual(legacy_slot(satellite, beam), slot)
+
+    def test_v025_rows_round_trip_every_legal_physical_identity(self) -> None:
+        # Two deterministic TRAIN/development-form fixtures.  Row order is
+        # reversed and each user has a V0.25 non-action audit row (-1), as the
+        # production compact tape does.
+        for fixture, user_id in (
+            ("V025_PROBE/world/1", 17),
+            ("V025_PROBE/world/2", 23),
+        ):
+            del fixture  # the domain label documents the KAT role; no live anchor is opened.
+            rows = []
+            legal_slots = {0, 2, 6, 7, 13, 14, 20, 21, 27}
+            for slot in reversed(range(NUM_ACTIONS)):
+                rows.append(
+                    (
+                        user_id,
+                        slot,
+                        (60_000 + 10 * (slot // 7) + user_id, 500 + slot % 7),
+                        slot in legal_slots,
+                    )
+                )
+            rows.extend(
+                (
+                    user_id,
+                    NO_OP_ACTION,
+                    (70_000 + user_id, 999),
+                    False,
+                )
+                for _ in range(1)
+            )
+            rows.append((user_id + 1, 0, (80_000, 123), True))
+            roster = ActionRoster.from_v025_rows(
+                user_id=user_id,
+                row_user_ids=np.asarray([row[0] for row in rows], dtype=np.int64),
+                legacy_action_indices=np.asarray(
+                    [row[1] for row in rows], dtype=np.int64
+                ),
+                physical_identities=np.asarray(
+                    [row[2] for row in rows], dtype=np.int64
+                ),
+                decision_legal=np.asarray([row[3] for row in rows], dtype=bool),
+            )
+            self.assertEqual(roster.verify_legal_round_trip(), len(legal_slots))
+            for slot in legal_slots:
+                identity = roster.physical_for_slot(slot)
+                self.assertEqual(roster.slot_for_physical(identity), slot)
+                self.assertEqual(roster.physical_for_slot(slot), identity)
+
+    def test_roster_rejects_ambiguous_identity(self) -> None:
+        identities = [PhysicalIdentity(1, index) for index in range(NUM_ACTIONS)]
+        identities[-1] = identities[0]
+        with self.assertRaisesRegex(BridgeContractError, "unique"):
+            ActionRoster(tuple(identities), (True,) * NUM_ACTIONS)
+
+
+class ProjectionTests(unittest.TestCase):
+    def test_complete_field_inventory_and_fail_closed_projection(self) -> None:
+        roster = _roster(100, {0, 1, 7})
+        incumbent = roster.physical_for_slot(7)
+        fields = projection_fields()
+        self.assertEqual([field.index for field in fields], list(range(112)))
+        self.assertEqual(sum(field.status == "derived" for field in fields), 28)
+        self.assertEqual(sum(field.status == "missing" for field in fields), 84)
+        inspection = inspect_v025_projection(
+            roster, previous_association=incumbent
+        )
+        expected = np.zeros(28, dtype=np.float32)
+        expected[7] = 1.0
+        np.testing.assert_array_equal(inspection.access_vector, expected)
+        self.assertFalse(inspection.complete)
+        self.assertEqual(inspection.missing_indices, tuple(range(28, 112)))
+        with self.assertRaises(IncompleteProjectionError) as raised:
+            project_v025_anchor(roster, previous_association=incumbent)
+        self.assertEqual(raised.exception.missing_indices, tuple(range(28, 112)))
+
+    def test_missing_incumbent_is_the_legacy_all_zero_access_row(self) -> None:
+        roster = _roster(100, {0})
+        absent = PhysicalIdentity(999_999, 999_999)
+        inspection = inspect_v025_projection(
+            roster, previous_association=absent
+        )
+        np.testing.assert_array_equal(
+            inspection.access_vector, np.zeros(NUM_ACTIONS, dtype=np.float32)
+        )
+
+    def test_native_input_identity_matches_production_legacy_encoder(self) -> None:
+        from mcrl.env.step_types import UserState
+        from mcrl.runtime.state_encoding import encode_state
+
+        access = np.zeros(NUM_ACTIONS, dtype=np.float64)
+        access[5] = 1.0
+        quality = np.linspace(0.0, 27.0, NUM_ACTIONS, dtype=np.float64)
+        angles = np.linspace(-0.25, 0.25, NUM_ACTIONS, dtype=np.float64)
+        loads = np.arange(NUM_ACTIONS, dtype=np.float64)
+        originals = tuple(value.copy() for value in (access, quality, angles, loads))
+        actual = encode_legacy_native_observation(
+            access_vector=access,
+            channel_quality_linear=quality,
+            beam_offsets_rad=angles,
+            beam_loads_users=loads,
+            num_users=100,
+        )
+        expected = encode_state(
+            UserState(access, quality, angles, loads, None),
+            100,
+            SimpleNamespace(
+                snr_encoding="log1p",
+                theta_encoding="raw_radians",
+                offset_scale_km=100.0,
+                load_normalization="divide_by_num_users",
+            ),
+            include_contract_block=False,
+        )
+        np.testing.assert_array_equal(actual, expected)
+        self.assertEqual(actual.shape, (112,))
+        self.assertFalse(actual.flags.writeable)
+        for value, original in zip((access, quality, angles, loads), originals, strict=True):
+            np.testing.assert_array_equal(value, original)
+
+
+class EdgeRuleTests(unittest.TestCase):
+    def test_lowest_index_tie_matches_the_legacy_adapter(self) -> None:
+        adapter = _load_legacy_adapter_module()
+        scores = np.full(NUM_ACTIONS, -10.0)
+        scores[3] = scores[11] = 9.0
+        mask = np.zeros(NUM_ACTIONS, dtype=bool)
+        mask[[3, 11, 20]] = True
+        self.assertEqual(masked_argmax(scores, mask), 3)
+        self.assertEqual(adapter.BaselineAdapter._masked_argmax(scores, mask), 3)
+
+    def test_empty_mask_matches_legacy_adapter_no_op(self) -> None:
+        adapter = _load_legacy_adapter_module()
+        scores = np.arange(NUM_ACTIONS, dtype=np.float64)
+        empty = np.zeros(NUM_ACTIONS, dtype=bool)
+        self.assertEqual(masked_argmax(scores, empty), NO_OP_ACTION)
+        self.assertEqual(
+            adapter.BaselineAdapter._masked_argmax(scores, empty),
+            adapter.NO_OP_ACTION,
+        )
+
+    def test_joint_invalidity_rejects_without_defining_a_repair(self) -> None:
+        rosters = (_roster(100, {0, 1}), _roster(200, {0, 1}))
+        with self.assertRaisesRegex(JointInvalidityError, "owner binding"):
+            finalize_joint_profile((1, 1), rosters, jointly_valid=False)
+        accepted = finalize_joint_profile((1, 0), rosters, jointly_valid=True)
+        np.testing.assert_array_equal(accepted, np.asarray([1, 0]))
+        self.assertFalse(accepted.flags.writeable)
+
+    def test_no_op_is_legal_only_for_an_empty_mask(self) -> None:
+        with self.assertRaisesRegex(BridgeContractError, "nonempty mask"):
+            finalize_joint_profile(
+                (NO_OP_ACTION,), (_roster(100, {0}),), jointly_valid=True
+            )
+        empty = _roster(100, set())
+        np.testing.assert_array_equal(
+            finalize_joint_profile(
+                (NO_OP_ACTION,), (empty,), jointly_valid=True
+            ),
+            np.asarray([NO_OP_ACTION]),
+        )
+
+
+class CheckpointIntegrityTests(unittest.TestCase):
+    def test_checkpoint_load_does_not_change_bytes(self) -> None:
+        adapter_module = _load_legacy_adapter_module()
+        before = checkpoint_sha256(CHECKPOINT_PATH)
+        self.assertEqual(before, EXPECTED_CHECKPOINT_SHA256)
+        with unchanged_checkpoint(CHECKPOINT_PATH) as admitted:
+            self.assertEqual(admitted, before)
+            adapter = adapter_module.BaselineAdapter.from_artifacts(
+                CHECKPOINT_PATH, CHECKPOINT_PATH.with_name("status.json")
+            )
+            self.assertEqual(adapter.state_dim, 112)
+            self.assertEqual(adapter.action_dim, 28)
+            self.assertEqual(adapter.checkpoint_sha256, before)
+        after = checkpoint_sha256(CHECKPOINT_PATH)
+        self.assertEqual(after, before)
+        self.assertEqual(after, EXPECTED_CHECKPOINT_SHA256)
+
+
+if __name__ == "__main__":
+    unittest.main()

