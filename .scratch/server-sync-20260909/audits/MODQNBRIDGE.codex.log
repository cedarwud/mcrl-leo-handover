                    key: object = (
                        aggressor.identity
                        if victim.nominal_cross_gain_by_identity
                        else aggressor.identity[0]
                    )
                    nominal_cross[victim_index, aggressor_index] = nominal_map.get(key, 0.0)
                    realised_cross[victim_index, aggressor_index] = realised_map.get(key, 0.0)
            geometry = Geometry(
                tuple(
