   297	            raise MCRLContractError("C2 projection did not recompute background powers")
   298	        if alive:
   299	            core += (selected.outcome.bits - baseline.outcome.bits) - eta * (
   300	                selected.outcome.joules - baseline.outcome.joules
   301	            )
   302	            retained.append(selected)
   303	            if not selected.valid or not selected.survives:
   304	                alive = False
   305	                lost += 1
   306	        else:
   307	            lost += 1
   308	            retained.append(selected)
   309	    penalty = kappa * lost
   310	    return C2Label(core, lost, penalty, (core - penalty) / kappa, tuple(retained))
