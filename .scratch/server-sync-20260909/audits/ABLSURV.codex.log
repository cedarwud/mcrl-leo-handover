   424	@dataclass(frozen=True)
   425	class SetScoreDecomposition:
   426	    """Executable v1.5 decomposition of one complete changed-user set.
   427	
   428	    ``d_by_user``, ``interaction_bits`` and ``joint_change_bits`` are in the
   429	    physical F units (bits at the frozen energy price). ``c1`` and ``c3`` are
   430	    the dimensionless physical identity terms; ``factor_c1`` adds the separate
   431	    dimensionless Phi preference for the factor-arm selector.
   432	    """
   433	
   434	    coalition_users: tuple[int, ...]
   435	    d_by_user: tuple[tuple[int, Fraction], ...]
   436	    interaction_bits: Fraction
   437	    shapley_interaction_by_user: tuple[tuple[int, Fraction], ...]
   438	    credit_split: str
   439	    joint_change_bits: Fraction
   440	    phi_difference: Fraction
   441	    c1: Fraction
   442	    c3: Fraction
   443	
   444	    @property
   445	    def factor_c1(self) -> Fraction:
   446	        """C1 selector value: exact physical singleton core plus Phi."""
   447	
   448	        return self.c1 + self.phi_difference
   449	
   450	
   451	def set_score_decomposition(
   452	    *,
   453	    coalition_users: Sequence[int],
   454	    outcomes_by_subset: Mapping[frozenset[int], NetworkOutcome],
   455	    lambda_bits_per_j: int | float | str | Fraction,
   456	    eta_ref: int | float | str | Fraction,
   457	    kappa_bits_per_user_step: int | float | str | Fraction,
   458	    phi_difference: int | float | str | Fraction = 0,
   459	) -> SetScoreDecomposition:
   460	    """Compute the O(|A|) set decomposition and bounded reporting credit.
   461	
   462	    The physical decomposition needs only the empty, singleton, and complete
   463	    coalition outcomes.  Exact Shapley credit is a reporting-only supplement
   464	    when ``|A| <= 4`` and the caller supplies the complete small powerset.
   465	    Large coalitions never enumerate subsets and explicitly report that no
   466	    per-user split was computed.
   467	    """
   468	
   469	    users = tuple(sorted(int(user) for user in coalition_users))
   470	    if len(set(users)) != len(users):
   471	        raise MCRLContractError("set-score coalition users must be unique")
   472	    sparse_required = {
   473	        frozenset(),
   474	        frozenset(users),
   475	        *(frozenset((user,)) for user in users),
   476	    }
   477	    supplied = set(outcomes_by_subset)
   478	    if not sparse_required <= supplied:
   479	        raise MCRLContractError(
   480	            "set-score decomposition needs empty, singleton, and complete outcomes"
   481	        )
   482	    eta, kappa = assert_calibration_prices(
   483	        lambda_bits_per_j=lambda_bits_per_j,
   484	        eta_ref=eta_ref,
   485	        kappa_bits_per_user_step=kappa_bits_per_user_step,
   486	    )
   487	    phi = exact(phi_difference)
   488	    values = {
   489	        subset: outcome.bits - eta * outcome.joules
   490	        for subset, outcome in outcomes_by_subset.items()
   491	    }
   492	    base = values[frozenset()]
   493	    d_by_user = tuple(
   494	        (user, values[frozenset((user,))] - base) for user in users
   495	    )
   496	    joint = values[frozenset(users)] - base
   497	    interaction = joint - sum((value for _user, value in d_by_user), Fraction())
   498	    complete_powerset = {
   499	        frozenset(subset)
   500	        for size in range(len(users) + 1)
   501	        for subset in itertools.combinations(users, size)
   502	    }
   503	    if len(users) < 2:
   504	        credits = tuple((user, Fraction()) for user in users)
   505	        credit_split = "EXACT_TRIVIAL"
   506	    elif len(users) <= 4 and supplied == complete_powerset:
   507	        allocated = c3_set_interaction(
   508	            coalition_users=users,
   509	            outcomes_by_subset=outcomes_by_subset,
   510	            lambda_bits_per_j=lambda_bits_per_j,
   511	            eta_ref=eta_ref,
   512	            kappa_bits_per_user_step=kappa_bits_per_user_step,
   513	        )
   514	        credits = allocated.z3_by_user
   515	        credit_split = "EXACT_SHAPLEY_SMALL_SET"
   516	    else:
   517	        credits = ()
   518	        credit_split = "NOT_COMPUTED_LARGE_SET" if len(users) > 4 else "NOT_SUPPLIED_SMALL_SET"
   519	    if credits and sum((value for _user, value in credits), Fraction()) != interaction:
   520	        raise MCRLContractError("set-score Shapley credits do not conserve Psi_A")
   521	    c1 = sum((value for _user, value in d_by_user), Fraction()) / kappa
   522	    c3 = interaction / kappa
   523	    if c1 + c3 != joint / kappa:
   524	        raise MCRLContractError("C1 + C3 does not equal the complete F change")
   525	    return SetScoreDecomposition(
   526	        users,
   527	        d_by_user,
   528	        interaction,
   529	        credits,
   530	        credit_split,
   531	        joint,
   532	        phi,
   533	        c1,
   534	        c3,
   535	    )
