   534	            strata=("setting_id", "coalition_size" if route == "C3" else "action_count"),
   535	            overlap="one_to_one_row_identity_overlap_with_informative_source",
   536	            row_weights="identical_unit_weights_in_stable_row_order",
   537	            optimization_dose="one_full_batch_update_per_source_epoch",
   538	        )
   539	        for route in ROUTES
