   178	        # uses CoalitionBatch and never consumes a per-action C3 label.
   179	        return 0.0
   180	    field = {
   181	        "C1": row.c1_label_normalized_hex,
   182	        "C2": row.c2_label_normalized_hex,
   183	    }[route]
   184	    return parse_float_hex(field, field=f"{route}.normalized_label")
