   245	            # stable vector remains useful for schema and KAT checks.
   246	            member_matrix = np.zeros((1, member_width), dtype=np.float64)
   247	        else:
   248	            member_matrix = np.asarray(
   249	                [member.invariant_features for member in self.members],
   250	                dtype=np.float64,
   251	            )
   252	            if member_matrix.shape[1] != member_width:
   253	                raise StageCContractError("coalition member feature width drifted")
