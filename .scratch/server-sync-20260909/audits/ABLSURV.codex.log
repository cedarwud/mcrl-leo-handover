   257	                beam.occupancy_before,
   258	                beam.occupancy_after,
   259	                float(beam.active_after) - float(beam.active_before),
   260	                beam.shared_capacity,
   261	                beam.interference_summary,
   262	                beam.capacity_margin,
   263	                1.0,
   264	            ]
   265	            for beam in beams
   266	        ], dtype=np.float64)
   267	        beam_pool = np.concatenate(
   268	            (
   269	                beam_features.sum(axis=0),
   270	                beam_features.max(axis=0),
   271	                beam_features.min(axis=0),
   272	                beam_features.mean(axis=0),
   273	            )
   274	        )
   275	        vector = np.concatenate(
   276	            (
   277	                np.asarray([float(len(self.members))], dtype=np.float64),
