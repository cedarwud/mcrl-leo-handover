   288	        raise MCRLContractError("default forecast offsets are not ordered 1,2,3")
   289	    alive = True
   290	    core = Fraction()
   291	    lost = 0
   292	    retained: list[OffsetProjection] = []
   293	    for selected, baseline in zip(
   294	        candidate_rows[:horizon_offsets], default_rows[:horizon_offsets], strict=True
