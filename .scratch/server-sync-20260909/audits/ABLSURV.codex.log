   503	class ProfileSelector:
   504	    """One C2 selector class implementing S3, S0, and S_UNI."""
   505	
   506	    def __init__(self, mode: SelectorMode) -> None:
   507	        if mode not in {"S3", "S0", "S_UNI"}:
   508	            raise StageCContractError("unknown selector mode")
   509	        self.mode = mode
   510	
   511	    @staticmethod
   512	    def repair_reference(
   513	        *,
   514	        model: V1ThreeRouteModel,
   515	        tables: Sequence[UserActionTable],
   516	        catalogue: Sequence[Profile],
   517	        jointly_legal: Callable[[Profile], bool],
   518	    ) -> Profile:
   519	        """A3 production Q1+Q2 proposal with deterministic joint repair."""
   520	
   521	        proposal = tuple(
   522	            masked_argmax(
   523	                tuple(
   524	                    model.score("C1", q1) + model.score("C2", q2)
   525	                    for q1, q2 in zip(table.q1_states, table.q2_states, strict=True)
   526	                ),
   527	                table.action_mask,
   528	            )
   529	            for table in tables
   530	        )
   531	        if jointly_legal(proposal):
   532	            return proposal
   533	        legal = tuple(profile for profile in catalogue if jointly_legal(profile))
   534	        if not legal:
   535	            raise StageCContractError("joint conflict repair found no legal catalogue profile")
   536	        best = legal[0]
   537	        best_score = float("-inf")
   538	        for profile in legal:
   539	            score = sum(
   540	                model.score("C1", table.q1_states[index])
   541	                + model.score("C2", table.q2_states[index])
   542	                for table, index in zip(tables, profile, strict=True)
   543	            )
   544	            if score > best_score:
   545	                best, best_score = profile, score
   546	        return best
   547	
   548	    @staticmethod
   549	    def _profile_payload(profile: Profile, tables: Sequence[UserActionTable]) -> list[dict[str, object]]:
   550	        if len(profile) != len(tables):
   551	            raise StageCContractError("profile is incomplete")
   552	        return [
   553	            {"user_id": table.user_id, "action": table.actions[index].payload()}
   554	            for table, index in zip(tables, profile, strict=True)
   555	        ]
   556	
   557	    @classmethod
   558	    def _authenticate_inputs(
   559	        cls,
   560	        *,
   561	        base_profile: Profile,
   562	        tables: Sequence[UserActionTable],
   563	        catalogue: Sequence[Profile],
   564	        coordinator_information: CoordinatorInformation,
   565	        arm_information_interfaces: Mapping[str, ArmInformationInterface],
   566	        matched_information_sha256: str,
   567	        coalition_context: Mapping[Profile, CoalitionContext] | None,
   568	    ) -> None:
   569	        required_arms = (*ARM_ORDER, "S0", "S_UNI")
   570	        actual = authenticate_matched_catalogues(
   571	            arm_information_interfaces, required_arms=required_arms
   572	        )
   573	        if actual != matched_information_sha256:
   574	            raise StageCContractError("selector A4 equality authenticator drifted")
   575	        if coordinator_information.catalogue_sha256 != next(
   576	            iter(arm_information_interfaces.values())
   577	        ).catalogue_sha256:
   578	            raise StageCContractError("selector catalogue differs from A4 authority")
   579	        if coordinator_information.source_provenance_sha256 != next(
   580	            iter(arm_information_interfaces.values())
   581	        ).source_provenance_sha256:
   582	            raise StageCContractError("selector source provenance differs from A4 authority")
   583	        supplied = {canonical_sha256(cls._profile_payload(profile, tables)) for profile in catalogue}
   584	        authorised = {
   585	            canonical_sha256(profile.payload()) for profile in coordinator_information.catalogue
   586	        }
   587	        if supplied != authorised:
   588	            raise StageCContractError("selector catalogue differs from I_coordinator")
   589	        reference = tuple(
   590	            action for action in coordinator_information.references.proposal_a0
   591	        )
   592	        if [action.payload() for action in reference] != [
   593	            item["action"] for item in cls._profile_payload(base_profile, tables)
   594	        ]:
   595	            raise StageCContractError("selector BASE differs from authenticated a0")
   596	        if coalition_context is None:
   597	            return
   598	        expected_profiles = set(catalogue) | {base_profile}
   599	        if set(coalition_context) != expected_profiles:
   600	            raise StageCContractError("coalition contexts do not cover the catalogue exactly")
   601	        expected_reference = tuple(
   602	            (table.user_id, table.actions[index])
   603	            for table, index in zip(tables, base_profile, strict=True)
   604	        )
   605	        for profile, context in coalition_context.items():
   606	            if context.anchor_id != coordinator_information.anchor_id:
   607	                raise StageCContractError("coalition context anchor is unauthenticated")
   608	            if context.reference_profile != expected_reference:
   609	                raise StageCContractError("coalition context reference profile is unauthenticated")
   610	            changed = {
   611	                table.user_id: (table.actions[base], table.actions[selected])
   612	                for table, base, selected in zip(tables, base_profile, profile, strict=True)
   613	                if selected != base
   614	            }
   615	            members = {member.user_id: member for member in context.members}
   616	            if set(members) != set(changed):
   617	                raise StageCContractError("coalition changed-user set differs from catalogue profile")
   618	            for user, (reference_action, selected_action) in changed.items():
   619	                member = members[user]
   620	                if (
   621	                    member.reference_action != reference_action
   622	                    or member.selected_action != selected_action
   623	                ):
   624	                    raise StageCContractError("coalition physical actions differ from catalogue profile")
   625	
   626	    @staticmethod
   627	    def _additive_score(
   628	        model: V1ThreeRouteModel,
   629	        tables: Sequence[UserActionTable],
   630	        profile: Profile,
   631	        reference: Profile,
   632	        *,
   633	        knockout: str | None,
   634	    ) -> float:
   635	        total = 0.0
   636	        for table, selected, baseline in zip(tables, profile, reference, strict=True):
   637	            if knockout != "C1":
   638	                total += model.score("C1", table.q1_states[selected]) - model.score(
   639	                    "C1", table.q1_states[baseline]
   640	                )
   641	            if knockout != "C2":
   642	                total += model.score("C2", table.q2_states[selected]) - model.score(
   643	                    "C2", table.q2_states[baseline]
   644	                )
   645	        return total
   646	
   647	    def select(
   648	        self,
   649	        *,
   650	        base_profile: Profile,
   651	        tables: Sequence[UserActionTable],
   652	        catalogue: Sequence[Profile],
   653	        jointly_legal: Callable[[Profile], bool],
   654	        service_guard: Callable[[Profile], bool],
   655	        model: V1ThreeRouteModel | None = None,
   656	        coalition_context: Mapping[Profile, CoalitionContext] | None = None,
   657	        exact_psi: Callable[[Profile], float] | None = None,
   658	        exact_nominal_score: Callable[[Profile], float] | None = None,
   659	        knockout_route: Route | None = None,
   660	        coordinator_information: CoordinatorInformation,
   661	        arm_information_interfaces: Mapping[str, ArmInformationInterface],
   662	        matched_information_sha256: str,
   663	        model_checkpoint_sha256: str | None = None,
   664	        knockout_experiment: CheckpointKnockoutExperiment | None = None,
   665	    ) -> SelectorDecision:
   666	        self._authenticate_inputs(
   667	            base_profile=base_profile,
   668	            tables=tables,
   669	            catalogue=catalogue,
   670	            coordinator_information=coordinator_information,
   671	            arm_information_interfaces=arm_information_interfaces,
   672	            matched_information_sha256=matched_information_sha256,
   673	            coalition_context=coalition_context if self.mode != "S_UNI" else None,
   674	        )
   675	        if self.mode == "S3" and model_checkpoint_sha256 is None:
   676	            raise StageCContractError("S3 requires a deployed checkpoint identity")
   677	        if knockout_route is not None:
   678	            if (
   679	                knockout_experiment is None
   680	                or model_checkpoint_sha256 != knockout_experiment.checkpoint_sha256
   681	                or knockout_route not in knockout_experiment.zeroed_deployed_routes
   682	            ):
   683	                raise StageCContractError("knockout is not bound to the deployed checkpoint")
   684	        if not jointly_legal(base_profile) or not service_guard(base_profile):
   685	            raise StageCContractError("selector requires a prevalidated BASE")
   686	        if self.mode == "S_UNI":
   687	            if exact_nominal_score is None:
   688	                raise StageCContractError("S_UNI requires exact nominal joint physics")
   689	            current = base_profile
   690	            evaluated = 0
   691	            while True:
   692	                best = current
   693	                best_score = exact_nominal_score(current)
   694	                evaluated += 1
   695	                for user_index, table in enumerate(tables):
   696	                    for action_index, legal in enumerate(table.action_mask):
   697	                        if not legal or action_index == current[user_index]:
   698	                            continue
   699	                        candidate = (*current[:user_index], action_index, *current[user_index + 1 :])
   700	                        if not jointly_legal(candidate) or not service_guard(candidate):
   701	                            continue
   702	                        score = exact_nominal_score(candidate)
   703	                        evaluated += 1
   704	                        if score > best_score:
   705	                            best, best_score = candidate, score
   706	                if best == current:
   707	                    return SelectorDecision("S_UNI", current, best_score, False, None, True, evaluated)
   708	                current = best
   709	
   710	        if model is None or coalition_context is None:
   711	            raise StageCContractError(f"{self.mode} requires model and coalition contexts")
   712	        if self.mode == "S0" and exact_psi is None:
   713	            raise StageCContractError("S0 requires exact Psi")
   714	        best = base_profile
   715	        best_score = float("-inf")
   716	        evaluated = 0
   717	        for profile in (base_profile, *catalogue):
   718	            if len(profile) != len(tables) or not jointly_legal(profile) or not service_guard(profile):
   719	                continue
   720	            additive = self._additive_score(
   721	                model, tables, profile, base_profile, knockout=knockout_route
   722	            )
   723	            interaction = 0.0
   724	            if knockout_route != "C3":
   725	                interaction = (
   726	                    model.interaction(coalition_context[profile])
   727	                    if self.mode == "S3"
   728	                    else float(exact_psi(profile))
   729	                )
   730	            score = additive + interaction
   731	            evaluated += 1
   732	            if score > best_score:
   733	                best, best_score = profile, score
   734	        if evaluated == 0:
   735	            return SelectorDecision(self.mode, base_profile, 0.0, True, "empty_legal_catalogue", None, 0)
   736	        return SelectorDecision(self.mode, best, best_score, False, None, None, evaluated)
