   208	    def _bounded_pairwise_cross_gain_terms(
   209	        self,
   210	    ) -> tuple[tuple[tuple[str, str, float], ...], float]:
   211	        """Top-K by magnitude, returned in canonical key order plus residual sum."""
   212	
   213	        ranked = sorted(
   214	            self.pairwise_cross_gain_terms,
   215	            key=lambda row: (-abs(row[2]), row[0], row[1]),
   216	        )
   217	        retained = tuple(
   218	            sorted(
   219	                ranked[:PAIRWISE_CROSS_GAIN_TOP_K],
   220	                key=lambda row: (row[0], row[1]),
   221	            )
   222	        )
   223	        residual_sum = math.fsum(row[2] for row in ranked[PAIRWISE_CROSS_GAIN_TOP_K:])
   224	        return retained, residual_sum
   225	
   226	    def pairwise_cross_gain_vector(self) -> np.ndarray:
   227	        """Fixed-width ordered pair block used by the interaction encoder."""
   228	
   229	        retained, residual_sum = self._bounded_pairwise_cross_gain_terms()
   230	        block = np.zeros((PAIRWISE_CROSS_GAIN_TOP_K, 4), dtype=np.float64)
   231	        for index, (source, target, gain) in enumerate(retained):
   232	            block[index] = (
   233	                int.from_bytes(hashlib.sha256(source.encode()).digest()[:8], "big") / 2**64,
   234	                int.from_bytes(hashlib.sha256(target.encode()).digest()[:8], "big") / 2**64,
   235	                gain,
   236	                1.0,
   237	            )
   238	        return np.concatenate((block.reshape(-1), np.asarray([residual_sum])))
