   187	def build_pairwise_batches(shards: Sequence[SourceShard]) -> dict[Route, PairwiseBatch]:
   188	    rows = tuple(row for shard in shards for row in shard.rows)
   189	    physics = {row.physics_digest for row in rows}
   190	    if len(physics) != 1:
   191	        raise StageCContractError("pairwise source shards mix physics digests")
   192	    physics_digest = next(iter(physics))
   193	    source_authority_sha256 = canonical_sha256(
   194	        {
   195	            "schema": "mcrl-v025-stagec-source-authority-v1",
   196	            "shards": [shard.file_sha256 for shard in shards],
   197	            "authorities": sorted(
   198	                {
   199	                    (
   200	                        row.code_digest,
   201	                        row.physics_digest,
   202	                        row.launch_digest,
   203	                        row.catalogue_digest,
   204	                        row.provider_digest,
   205	                        row.archive_digest,
   206	                        row.setting_digest,
   207	                        row.calibration_digest,
   208	                        row.allocation_manifest_digest,
   209	                        row.q1_schema_sha256,
   210	                        row.q2_schema_sha256,
   211	                    )
   212	                    for row in rows
   213	                }
   214	            ),
   215	        }
   216	    )
   217	    groups: dict[tuple[str, str, int], list[SourceRow]] = {}
   218	    for row in rows:
   219	        groups.setdefault((row.world_id, row.anchor_id, row.user_id), []).append(row)
   220	    by_route: dict[Route, PairwiseBatch] = {}
   221	    for route in ROUTES:
   222	        references: list[tuple[float, ...]] = []
   223	        candidates: list[tuple[float, ...]] = []
   224	        targets: list[float] = []
   225	        identities: list[str] = []
   226	        for key in sorted(groups):
   227	            ordered = sorted(groups[key], key=lambda row: row.action_index)
   228	            shared_mask = ordered[0].action_mask
   229	            if any(row.action_mask != shared_mask for row in ordered):
   230	                raise StageCContractError("user-anchor rows disagree on the legal mask")
   231	            expected_indices = [
   232	                index for index, enabled in enumerate(shared_mask) if enabled
   233	            ]
   234	            if [row.action_index for row in ordered] != expected_indices:
   235	                raise StageCContractError("user-anchor rows do not cover each legal action once")
   236	            if sum(row.null_action for row in ordered) != 1:
   237	                raise StageCContractError("user-anchor requires exactly one legal null action")
   238	            reference_rows = [row for row in ordered if row.reference_action]
   239	            if len(reference_rows) != 1:
   240	                raise StageCContractError("every user-anchor requires exactly one BASE row")
   241	            reference = reference_rows[0]
   242	            for candidate in ordered:
   243	                if candidate.reference_action or not candidate.action_mask[candidate.action_index]:
   244	                    continue
   245	                references.append(_route_state(reference, route))
   246	                candidates.append(_route_state(candidate, route))
   247	                targets.append(_route_label(candidate, route) - _route_label(reference, route))
   248	                identities.append(
   249	                    f"{candidate.world_id}|{candidate.anchor_id}|{candidate.user_id}|{candidate.action_index}"
   250	                )
   251	        by_route[route] = PairwiseBatch.create(
   252	            route,
   253	            references,
   254	            candidates,
   255	            targets,
   256	            identities,
   257	            source_authority_sha256,
   258	            physics_digest=physics_digest,
   259	        )
   260	    return by_route
