   322	
   323	def c3_lcsrs_interaction(
   324	    *,
   325	    coalition_users: Sequence[int],
   326	    f00: NetworkOutcome,
   327	    f10: NetworkOutcome,
   328	    f01: NetworkOutcome,
   329	    f11: NetworkOutcome,
   330	    lambda_bits_per_j: int | float | str | Fraction,
   331	    eta_ref: int | float | str | Fraction,
   332	    kappa_bits_per_user_step: int | float | str | Fraction,
   333	) -> C3Interaction:
   334	    """Declared LC-SRS two-user interaction Psi on one network objective F."""
   335	
   336	    users = tuple(int(user) for user in coalition_users)
   337	    if len(users) != 2 or len(set(users)) != 2:
   338	        raise MCRLContractError("LC-SRS pair interaction requires exactly two users")
   339	    values = tuple(
   340	        network_objective(
   341	            outcome,
   342	            lambda_bits_per_j=lambda_bits_per_j,
   343	            eta_ref=eta_ref,
   344	            kappa_bits_per_user_step=kappa_bits_per_user_step,
   345	        )
   346	        for outcome in (f00, f10, f01, f11)
   347	    )
   348	    psi = values[3] - values[1] - values[2] + values[0]
   349	    # Whole-network C1 already owns every unilateral bit and joule change.
   350	    # C3 owns interaction only; no historical own-bits C1 externality term.
   351	    z3 = tuple((user, psi / 2) for user in users)
   352	    return C3Interaction(*values, psi, z3)
