   101	def masked_argmax(values: Sequence[float], mask: Sequence[bool]) -> int:
   102	    if len(values) != len(mask) or not values:
   103	        raise StageCContractError("masked argmax shape mismatch")
   104	    legal = [index for index, enabled in enumerate(mask) if enabled]
   105	    if not legal:
   106	        raise StageCContractError("masked argmax has no legal action")
   107	    # Lowest stable action index wins ties. BASE tie preference is applied at
   108	    # profile coordination, where BASE need not be action index zero.
   109	    return max(legal, key=lambda index: (float(values[index]), -index))
