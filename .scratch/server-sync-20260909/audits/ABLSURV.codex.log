   677	
   678	    @classmethod
   679	    def create(cls, input_dim: int, literal: Mapping[str, object], rng: np.random.Generator) -> "AdamMLPHead":
   680	        widths = (input_dim, *tuple(int(value) for value in literal["hidden_layers"]), 1)
   681	        weights = [
   682	            rng.normal(0.0, np.sqrt(2.0 / max(1, left)), (left, right))
   683	            for left, right in zip(widths[:-1], widths[1:], strict=True)
   684	        ]
   685	        biases = [np.zeros(right, dtype=np.float64) for right in widths[1:]]
   686	        return cls(
   687	            weights=weights,
   688	            biases=biases,
   689	            first_moment_w=[np.zeros_like(value) for value in weights],
   690	            second_moment_w=[np.zeros_like(value) for value in weights],
   691	            first_moment_b=[np.zeros_like(value) for value in biases],
   692	            second_moment_b=[np.zeros_like(value) for value in biases],
   693	            activation=str(literal["activation"]),
   694	            learning_rate=float(literal["learning_rate"]),
   695	            beta1=float(tuple(literal["adam_betas"])[0]),
   696	            beta2=float(tuple(literal["adam_betas"])[1]),
   697	            epsilon=float(literal["adam_epsilon"]),
   698	            weight_decay=float(literal["weight_decay"]),
   699	            gauge_beta=float(literal.get("gauge_beta", 0.0)),
   700	            loss_weight=float(literal["loss_weight"]),
   701	        )
   702	
   703	    def clone(self) -> "AdamMLPHead":
   704	        return AdamMLPHead(
   705	            *(
   706	                [[value.copy() for value in group] for group in (
   707	                    self.weights, self.biases, self.first_moment_w, self.second_moment_w,
   708	                    self.first_moment_b, self.second_moment_b,
   709	                )]
   710	            ),
   711	            self.activation, self.learning_rate, self.beta1, self.beta2,
   712	            self.epsilon, self.weight_decay, self.gauge_beta, self.loss_weight,
   713	            self.adam_step,
   714	        )
   715	
   716	    def _forward(self, values: np.ndarray) -> tuple[np.ndarray, list[np.ndarray], list[np.ndarray]]:
   717	        current = np.asarray(values, dtype=np.float64)
   718	        activations = [current]
   719	        preactivations: list[np.ndarray] = []
   720	        for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
   721	            pre = current @ weights + bias
   722	            preactivations.append(pre)
   723	            if index == len(self.weights) - 1:
   724	                current = pre
   725	            elif self.activation == "relu":
   726	                current = np.maximum(pre, 0.0)
   727	            else:
   728	                current = np.tanh(pre)
   729	            activations.append(current)
   730	        return current[:, 0], activations, preactivations
   731	
   732	    def score(self, state: Sequence[float]) -> float:
   733	        value, _, _ = self._forward(np.asarray(state, dtype=np.float64)[None, :])
   734	        return float(value[0])
   735	
   736	    def _backward(
   737	        self, activations: list[np.ndarray], preactivations: list[np.ndarray], output_gradient: np.ndarray
   738	    ) -> tuple[list[np.ndarray], list[np.ndarray]]:
   739	        gradient = output_gradient[:, None]
   740	        weight_gradients = [np.empty_like(value) for value in self.weights]
   741	        bias_gradients = [np.empty_like(value) for value in self.biases]
   742	        for index in reversed(range(len(self.weights))):
   743	            weight_gradients[index] = activations[index].T @ gradient
   744	            bias_gradients[index] = gradient.sum(axis=0)
   745	            if index:
   746	                gradient = gradient @ self.weights[index].T
   747	                if self.activation == "relu":
   748	                    gradient *= preactivations[index - 1] > 0.0
   749	                else:
   750	                    hidden = activations[index]
   751	                    gradient *= 1.0 - hidden * hidden
   752	        return weight_gradients, bias_gradients
   753	
   754	    def _adam(self, grad_w: list[np.ndarray], grad_b: list[np.ndarray]) -> None:
   755	        self.adam_step += 1
   756	        for parameter, gradient, first, second in zip(
   757	            self.weights, grad_w, self.first_moment_w, self.second_moment_w, strict=True
