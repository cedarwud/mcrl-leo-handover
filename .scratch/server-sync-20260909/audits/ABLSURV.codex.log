   549	@dataclass(frozen=True)
   550	class CoalitionIdentity:
   551	    """Phi-inclusive and physical B4 identities for an uncapped coalition."""
   552	
   553	    users: tuple[int, ...]
   554	    c1: Fraction
   555	    c3: Fraction
   556	    objective_delta: Fraction
   557	    physical_c1: Fraction
   558	    physical_c3: Fraction
   559	    physical_delta: Fraction
   560	
   561	    def assert_exact(self) -> None:
   562	        if self.c1 + self.c3 != self.objective_delta:
   563	            raise MCRLContractError("C1+C3 does not reconstruct the Phi-inclusive F delta")
   564	        if self.physical_c1 + self.physical_c3 != self.physical_delta:
   565	            raise MCRLContractError("physical C1+C3 does not reconstruct B-etaE")
   566	
   567	
   568	def coalition_identity(
   569	    *,
   570	    coalition_users: Sequence[int],
   571	    reference: NetworkOutcome,
   572	    unilateral_by_user: Mapping[int, NetworkOutcome],
   573	    coalition: NetworkOutcome,
   574	    lambda_bits_per_j: int | float | str | Fraction,
   575	    eta_ref: int | float | str | Fraction,
   576	    kappa_bits_per_user_s: int | float | str | Fraction,
   577	) -> CoalitionIdentity:
   578	    """Return the v1.2 uncapped selected-coalition interaction identity.
   579	
   580	    ``kappa_bits_per_user_s`` is the historical build-3 keyword.  The supplied
   581	    value is the sealed per-user-step normalisation; keeping the spelling at
   582	    this adapter preserves the Stage-C row API without changing physics.
   583	    """
   584	
   585	    users = tuple(sorted(int(user) for user in coalition_users))
   586	    if len(users) < 2 or len(set(users)) != len(users):
   587	        raise MCRLContractError("coalition identity requires at least two distinct users")
   588	    if set(unilateral_by_user) != set(users):
   589	        raise MCRLContractError("unilateral outcomes must cover the coalition exactly")
   590	    eta, kappa = assert_calibration_prices(
   591	        lambda_bits_per_j=lambda_bits_per_j,
   592	        eta_ref=eta_ref,
   593	        kappa_bits_per_user_step=kappa_bits_per_user_s,
   594	    )
   595	
   596	    def physical(outcome: NetworkOutcome) -> Fraction:
   597	        return outcome.bits - eta * outcome.joules
   598	
   599	    def inclusive(outcome: NetworkOutcome) -> Fraction:
   600	        return physical(outcome) + kappa * outcome.phi
   601	
   602	    f0, fa = inclusive(reference), inclusive(coalition)
   603	    p0, pa = physical(reference), physical(coalition)
   604	    unilateral = tuple(inclusive(unilateral_by_user[user]) - f0 for user in users)
   605	    physical_unilateral = tuple(
   606	        physical(unilateral_by_user[user]) - p0 for user in users
   607	    )
   608	    result = CoalitionIdentity(
   609	        users=users,
   610	        c1=sum(unilateral, Fraction()),
   611	        c3=fa - f0 - sum(unilateral, Fraction()),
   612	        objective_delta=fa - f0,
   613	        physical_c1=sum(physical_unilateral, Fraction()),
   614	        physical_c3=pa - p0 - sum(physical_unilateral, Fraction()),
   615	        physical_delta=pa - p0,
   616	    )
   617	    result.assert_exact()
   618	    return result
   619	
   620	
   621	def matched_anchor_decomposition(
   622	    *,
   623	    base: Sequence[NetworkOutcome],
   624	    selected: Sequence[NetworkOutcome],
   625	    singleton_selected: Sequence[Sequence[NetworkOutcome]],
   626	) -> MatchedAnchorDecomposition:
   627	    """Pooled matched-anchor A/I decomposition with no clipping."""
   628	
   629	    base_rows, selected_rows = tuple(base), tuple(selected)
   630	    singleton_rows = tuple(tuple(rows) for rows in singleton_selected)
   631	    if not base_rows or len(base_rows) != len(selected_rows) or any(
   632	        len(rows) != len(base_rows) for rows in singleton_rows
   633	    ):
   634	        raise MCRLContractError("matched-anchor profiles must have the same nonzero length")
   635	    base_bits = sum((row.bits for row in base_rows), Fraction())
   636	    base_energy = sum((row.joules for row in base_rows), Fraction())
   637	    selected_energy = sum((row.joules for row in selected_rows), Fraction())
   638	    if base_energy <= 0 or selected_energy <= 0:
   639	        raise MCRLContractError("matched-anchor energy denominators must be positive")
   640	    eta0 = base_bits / base_energy
   641	    f0 = tuple(row.bits - eta0 * row.joules for row in base_rows)
   642	    fstar = tuple(row.bits - eta0 * row.joules for row in selected_rows)
   643	    additive = sum(
   644	        (
   645	            (row.bits - eta0 * row.joules) - f0[index]
   646	            for rows in singleton_rows
   647	            for index, row in enumerate(rows)
   648	        ),
   649	        Fraction(),
   650	    )
   651	    joint = sum((fstar[index] - f0[index] for index in range(len(f0))), Fraction())
   652	    interaction = joint - additive
   653	    denominator = eta0 * selected_energy
   654	    return MatchedAnchorDecomposition(
   655	        eta0,
   656	        additive,
   657	        interaction,
   658	        joint,
   659	        denominator,
   660	        additive / denominator,
   661	        interaction / denominator,
   662	    )
   663	
   664	
   665	def assert_reward_core_identity(
   666	    steps: Iterable[StepEndpoint],
   667	    *,
   668	    lambda_bits_per_j: int | float | str | Fraction,
   669	    eta_ref: int | float | str | Fraction,
   670	    kappa_bits_per_user_step: int | float | str | Fraction,
   671	) -> Fraction:
   672	    """Prove sum_t(B_t-eta E_t) == B-eta E for the supplied trajectory."""
   673	
   674	    eta, _kappa = assert_calibration_prices(
   675	        lambda_bits_per_j=lambda_bits_per_j,
   676	        eta_ref=eta_ref,
   677	        kappa_bits_per_user_step=kappa_bits_per_user_step,
   678	    )
   679	    rows = tuple(steps)
   680	    lhs = sum((reward_core(row, eta_ref=eta) for row in rows), Fraction())
   681	    rhs = reward_core(pool(rows), eta_ref=eta)
   682	    if lhs != rhs:
   683	        raise MCRLContractError("reward core does not telescope to the endpoint")
   684	    return rhs
