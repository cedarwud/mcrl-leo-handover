   665	    second_moment_w: list[np.ndarray]
   666	    first_moment_b: list[np.ndarray]
   667	    second_moment_b: list[np.ndarray]
   668	    activation: str
   669	    learning_rate: float
   670	    beta1: float
   671	    beta2: float
   672	    epsilon: float
