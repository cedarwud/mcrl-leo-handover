   233	class DeploymentAdapter:
   234	    def __init__(self, *, deadline_s: float = DEPLOYMENT_DEADLINE_S) -> None:
   235	        if deadline_s <= 0.0:
   236	            raise StageCContractError("deployment deadline must be positive")
   237	        self.deadline_s = float(deadline_s)
   238	
   239	    def select(
   240	        self,
   241	        *,
   242	        model: ThreeRouteModel,
   243	        tables: Sequence[UserActionTable],
   244	        base_profile: Profile,
   245	        catalogue: Sequence[Profile],
   246	        jointly_legal: Callable[[Profile], bool],
   247	        resolve_profile: Callable[[Profile], ResolvedProfile],
   248	        coordinator: CoordinatorHook = learned_c3_score,
   249	        clock: Callable[[], float] = time.monotonic,
   250	        _started_at: float | None = None,
   251	    ) -> DeploymentDecision:
   252	        started = clock() if _started_at is None else _started_at
   253	        if len(base_profile) != len(tables) or not jointly_legal(base_profile):
   254	            raise StageCContractError("BASE must be a complete jointly legal profile")
   255	        independent = base_profile
   256	
   257	        def fallback(reason: str) -> DeploymentDecision:
   258	            return DeploymentDecision(
   259	                base_profile,
   260	                independent,
   261	                True,
   262	                reason,
   263	                max(0.0, clock() - started),
   264	                True,
   265	                True,
   266	            )
   267	
   268	        def deadline_expired() -> bool:
   269	            return clock() - started > self.deadline_s
   270	
   271	        try:
   272	            independent = independent_two_head_profile(model, tables)
   273	            if deadline_expired():
   274	                return fallback("deadline")
   275	            independent_legal = jointly_legal(independent)
   276	            base_resolution = resolve_profile(base_profile)
   277	            if (
   278	                base_resolution.profile != base_profile
   279	                or base_resolution.served_count < 0
   280	            ):
   281	                return fallback("base_resolution_validation")
   282	            if deadline_expired():
   283	                return fallback("deadline")
   284	            best = base_profile
   285	            best_score = self._profile_q12(model, tables, base_profile) + coordinator(
   286	                profile=base_profile, tables=tables, model=model
   287	            )
   288	            if deadline_expired():
   289	                return fallback("deadline")
   290	            fallback_reason: str | None = (
   291	                None
   292	                if independent_legal
   293	                else "independent_profile_jointly_infeasible"
   294	            )
   295	            # BASE is first and strict improvement is required, so BASE wins ties.
   296	            ordered = [base_profile, *catalogue]
   297	            if independent not in ordered:
   298	                ordered.append(independent)
   299	            seen: set[Profile] = set()
   300	            for profile in ordered:
   301	                if profile in seen:
   302	                    continue
   303	                seen.add(profile)
   304	                if deadline_expired():
   305	                    return fallback("deadline")
   306	                if len(profile) != len(tables) or not jointly_legal(profile):
   307	                    continue
   308	                resolved = resolve_profile(profile)
   309	                if deadline_expired():
   310	                    return fallback("deadline")
   311	                if resolved.profile != profile:
   312	                    return fallback("profile_resolution_validation")
   313	                if resolved.served_count < base_resolution.served_count:
   314	                    continue
   315	                score = self._profile_q12(model, tables, profile) + coordinator(
   316	                    profile=profile, tables=tables, model=model
   317	                )
   318	                if deadline_expired():
   319	                    return fallback("deadline")
   320	                if score > best_score:
   321	                    best, best_score = profile, score
   322	            legal = jointly_legal(best)
   323	            resolved_best = resolve_profile(best)
   324	            if deadline_expired():
   325	                return fallback("deadline")
   326	            guard = (
   327	                resolved_best.profile == best
   328	                and resolved_best.served_count >= base_resolution.served_count
   329	            )
   330	            if not legal or not guard:
   331	                return fallback("post_selection_validation")
   332	            elapsed = max(0.0, clock() - started)
   333	            if elapsed > self.deadline_s:
   334	                return fallback("deadline")
   335	            used_fallback = best == base_profile and fallback_reason is not None
   336	            return DeploymentDecision(
   337	                best,
   338	                independent,
   339	                used_fallback,
   340	                fallback_reason if used_fallback else None,
   341	                elapsed,
   342	                legal,
   343	                guard,
   344	            )
   345	        except Exception as error:
   346	            return fallback(f"validation_failure:{type(error).__name__}")
   347	
   348	    def select_runner_timed(
   349	        self,
   350	        *,
   351	        model: ThreeRouteModel,
   352	        tables: Sequence[UserActionTable],
   353	        base_profile: Profile,
   354	        catalogue: Sequence[Profile],
   355	        jointly_legal: Callable[[Profile], bool],
   356	        resolve_profile: Callable[[Profile], ResolvedProfile],
   357	        coordinator: CoordinatorHook = learned_c3_score,
   358	        clock: Callable[[], float] = time.monotonic,
   359	    ) -> DeploymentDecision:
   360	        """F2 runner-enforced wall timer with prevalidated BASE-first fallback."""
   361	
   362	        if len(base_profile) != len(tables) or not jointly_legal(base_profile):
   363	            raise StageCContractError("BASE must be jointly legal before coordinator start")
   364	        base_resolution = resolve_profile(base_profile)
   365	        if base_resolution.profile != base_profile or base_resolution.served_count < 0:
   366	            raise StageCContractError("BASE must be validated/repaired before coordinator start")
   367	        started = clock()
   368	        executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="stagec-coordinator")
   369	        future = executor.submit(
   370	            self.select,
   371	            model=model,
   372	            tables=tables,
   373	            base_profile=base_profile,
   374	            catalogue=catalogue,
   375	            jointly_legal=jointly_legal,
   376	            resolve_profile=resolve_profile,
   377	            coordinator=coordinator,
   378	            clock=clock,
   379	            _started_at=started,
   380	        )
   381	        try:
   382	            return future.result(timeout=self.deadline_s)
   383	        except FutureTimeoutError:
   384	            future.cancel()
   385	            return DeploymentDecision(
   386	                profile=base_profile,
   387	                independent_profile=base_profile,
   388	                used_fallback=True,
   389	                fallback_reason="runner_deadline_cancel",
   390	                elapsed_s=max(0.0, clock() - started),
   391	                jointly_legal=True,
   392	                service_guard_passed=True,
   393	            )
   394	        finally:
   395	            executor.shutdown(wait=False, cancel_futures=True)
   396	
   397	    def select_with_preparation(
   398	        self,
   399	        *,
   400	        model: ThreeRouteModel,
   401	        prepare: Callable[[], tuple[Sequence[UserActionTable], Sequence[Profile]]],
   402	        base_profile: Profile,
   403	        jointly_legal: Callable[[Profile], bool],
   404	        resolve_profile: Callable[[Profile], ResolvedProfile],
   405	        coordinator: CoordinatorHook = learned_c3_score,
   406	        clock: Callable[[], float] = time.monotonic,
   407	    ) -> DeploymentDecision:
   408	        """Runner-time preparation, catalogue search, and validation as one task."""
   409	
   410	        if not jointly_legal(base_profile):
   411	            raise StageCContractError("BASE must be a jointly legal profile")
   412	        base_resolution = resolve_profile(base_profile)
   413	        if base_resolution.profile != base_profile or base_resolution.served_count < 0:
   414	            raise StageCContractError("BASE must be validated/repaired before coordinator start")
   415	        started = clock()
   416	
   417	        def run() -> DeploymentDecision:
   418	            tables, catalogue = prepare()
   419	            return self.select(
   420	                model=model,
   421	                tables=tables,
   422	                base_profile=base_profile,
   423	                catalogue=catalogue,
   424	                jointly_legal=jointly_legal,
   425	                resolve_profile=resolve_profile,
   426	                coordinator=coordinator,
   427	                clock=clock,
   428	                _started_at=started,
   429	            )
   430	
   431	        executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="stagec-coordinator")
   432	        future = executor.submit(run)
   433	        try:
   434	            return future.result(timeout=self.deadline_s)
   435	        except FutureTimeoutError:
   436	            future.cancel()
   437	            return DeploymentDecision(
   438	                base_profile,
   439	                base_profile,
   440	                True,
   441	                "runner_deadline_cancel",
   442	                max(0.0, clock() - started),
   443	                True,
   444	                True,
   445	            )
   446	        except Exception as error:
   447	            return DeploymentDecision(
   448	                base_profile,
   449	                base_profile,
   450	                True,
   451	                f"prep_or_validation_failure:{type(error).__name__}",
   452	                max(0.0, clock() - started),
   453	                True,
   454	                True,
   455	            )
   456	        finally:
   457	            executor.shutdown(wait=False, cancel_futures=True)
   458	
   459	    @staticmethod
   460	    def _profile_q12(
   461	        model: ThreeRouteModel, tables: Sequence[UserActionTable], profile: Profile
   462	    ) -> float:
   463	        if len(profile) != len(tables):
   464	            raise StageCContractError("profile is incomplete")
   465	        total = 0.0
   466	        for table, action_index in zip(tables, profile, strict=True):
   467	            if not 0 <= action_index < len(table.actions) or not table.action_mask[action_index]:
   468	                raise StageCContractError("profile contains a locally illegal action")
   469	            total += model.score("C1", table.q1_states[action_index])
   470	            total += model.score("C2", table.q2_states[action_index])
   471	        return total
   472	
   473	
   474	def select_s_uni(
   475	    *,
   476	    base_profile: Profile,
   477	    tables: Sequence[UserActionTable],
   478	    jointly_legal: Callable[[Profile], bool],
   479	    exact_nominal_score: Callable[[Profile], float],
   480	) -> Profile:
   481	    """Iterated exact-unilateral deployable comparator with stable tie handling."""
   482	
   483	    current = base_profile
   484	    while True:
   485	        current_score = exact_nominal_score(current)
   486	        best = current
   487	        best_score = current_score
   488	        for user_index, table in enumerate(tables):
   489	            for action_index, legal in enumerate(table.action_mask):
   490	                if not legal or action_index == current[user_index]:
   491	                    continue
   492	                candidate = (*current[:user_index], action_index, *current[user_index + 1 :])
   493	                if not jointly_legal(candidate):
   494	                    continue
   495	                score = exact_nominal_score(candidate)
   496	                if score > best_score:
   497	                    best, best_score = candidate, score
   498	        if best == current:
   499	            return current
   500	        current = best
