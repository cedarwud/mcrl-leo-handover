   658	@dataclass(slots=True)
   659	class AdamMLPHead:
   660	    """Legacy-shaped MLP trained by a literal Adam pairwise objective."""
   661	
   662	    weights: list[np.ndarray]
   663	    biases: list[np.ndarray]
   664	    first_moment_w: list[np.ndarray]
   665	    second_moment_w: list[np.ndarray]
   666	    first_moment_b: list[np.ndarray]
   667	    second_moment_b: list[np.ndarray]
   668	    activation: str
   669	    learning_rate: float
   670	    beta1: float
   671	    beta2: float
   672	    epsilon: float
   673	    weight_decay: float
   674	    gauge_beta: float
   675	    loss_weight: float
   676	    adam_step: int = 0
   677	
   678	    @classmethod
   679	    def create(cls, input_dim: int, literal: Mapping[str, object], rng: np.random.Generator) -> "AdamMLPHead":
   680	        widths = (input_dim, *tuple(int(value) for value in literal["hidden_layers"]), 1)
   681	        weights = [
   682	            rng.normal(0.0, np.sqrt(2.0 / max(1, left)), (left, right))
   683	            for left, right in zip(widths[:-1], widths[1:], strict=True)
   684	        ]
   685	        biases = [np.zeros(right, dtype=np.float64) for right in widths[1:]]
   686	        return cls(
   687	            weights=weights,
   688	            biases=biases,
   689	            first_moment_w=[np.zeros_like(value) for value in weights],
   690	            second_moment_w=[np.zeros_like(value) for value in weights],
   691	            first_moment_b=[np.zeros_like(value) for value in biases],
   692	            second_moment_b=[np.zeros_like(value) for value in biases],
   693	            activation=str(literal["activation"]),
   694	            learning_rate=float(literal["learning_rate"]),
   695	            beta1=float(tuple(literal["adam_betas"])[0]),
   696	            beta2=float(tuple(literal["adam_betas"])[1]),
   697	            epsilon=float(literal["adam_epsilon"]),
   698	            weight_decay=float(literal["weight_decay"]),
   699	            gauge_beta=float(literal.get("gauge_beta", 0.0)),
   700	            loss_weight=float(literal["loss_weight"]),
   701	        )
   702	
   703	    def clone(self) -> "AdamMLPHead":
   704	        return AdamMLPHead(
   705	            *(
   706	                [[value.copy() for value in group] for group in (
   707	                    self.weights, self.biases, self.first_moment_w, self.second_moment_w,
   708	                    self.first_moment_b, self.second_moment_b,
   709	                )]
   710	            ),
   711	            self.activation, self.learning_rate, self.beta1, self.beta2,
   712	            self.epsilon, self.weight_decay, self.gauge_beta, self.loss_weight,
   713	            self.adam_step,
   714	        )
   715	
   716	    def _forward(self, values: np.ndarray) -> tuple[np.ndarray, list[np.ndarray], list[np.ndarray]]:
   717	        current = np.asarray(values, dtype=np.float64)
   718	        activations = [current]
   719	        preactivations: list[np.ndarray] = []
   720	        for index, (weights, bias) in enumerate(zip(self.weights, self.biases, strict=True)):
   721	            pre = current @ weights + bias
   722	            preactivations.append(pre)
   723	            if index == len(self.weights) - 1:
   724	                current = pre
   725	            elif self.activation == "relu":
   726	                current = np.maximum(pre, 0.0)
   727	            else:
   728	                current = np.tanh(pre)
   729	            activations.append(current)
   730	        return current[:, 0], activations, preactivations
   731	
   732	    def score(self, state: Sequence[float]) -> float:
   733	        value, _, _ = self._forward(np.asarray(state, dtype=np.float64)[None, :])
   734	        return float(value[0])
   735	
   736	    def _backward(
   737	        self, activations: list[np.ndarray], preactivations: list[np.ndarray], output_gradient: np.ndarray
   738	    ) -> tuple[list[np.ndarray], list[np.ndarray]]:
   739	        gradient = output_gradient[:, None]
   740	        weight_gradients = [np.empty_like(value) for value in self.weights]
   741	        bias_gradients = [np.empty_like(value) for value in self.biases]
   742	        for index in reversed(range(len(self.weights))):
   743	            weight_gradients[index] = activations[index].T @ gradient
   744	            bias_gradients[index] = gradient.sum(axis=0)
   745	            if index:
   746	                gradient = gradient @ self.weights[index].T
   747	                if self.activation == "relu":
   748	                    gradient *= preactivations[index - 1] > 0.0
   749	                else:
   750	                    hidden = activations[index]
   751	                    gradient *= 1.0 - hidden * hidden
   752	        return weight_gradients, bias_gradients
   753	
   754	    def _adam(self, grad_w: list[np.ndarray], grad_b: list[np.ndarray]) -> None:
   755	        self.adam_step += 1
   756	        for parameter, gradient, first, second in zip(
   757	            self.weights, grad_w, self.first_moment_w, self.second_moment_w, strict=True
   758	        ):
   759	            gradient = gradient + self.weight_decay * parameter
   760	            first *= self.beta1
   761	            first += (1.0 - self.beta1) * gradient
   762	            second *= self.beta2
   763	            second += (1.0 - self.beta2) * gradient * gradient
   764	            corrected_m = first / (1.0 - self.beta1**self.adam_step)
   765	            corrected_v = second / (1.0 - self.beta2**self.adam_step)
   766	            parameter -= self.learning_rate * corrected_m / (np.sqrt(corrected_v) + self.epsilon)
   767	        for parameter, gradient, first, second in zip(
   768	            self.biases, grad_b, self.first_moment_b, self.second_moment_b, strict=True
   769	        ):
   770	            first *= self.beta1
   771	            first += (1.0 - self.beta1) * gradient
   772	            second *= self.beta2
   773	            second += (1.0 - self.beta2) * gradient * gradient
   774	            parameter -= self.learning_rate * (first / (1.0 - self.beta1**self.adam_step)) / (
   775	                np.sqrt(second / (1.0 - self.beta2**self.adam_step)) + self.epsilon
   776	            )
   777	
   778	    def update(self, batch: PairwiseBatch) -> float:
   779	        reference, ref_a, ref_z = self._forward(batch.reference_states)
   780	        candidate, cand_a, cand_z = self._forward(batch.candidate_states)
   781	        residual = candidate - reference - batch.target_deltas
   782	        count = float(len(residual))
   783	        scale = 2.0 * self.loss_weight / count
   784	        cand_w, cand_b = self._backward(cand_a, cand_z, scale * residual)
   785	        ref_gradient = scale * (-residual + self.gauge_beta * reference)
   786	        ref_w, ref_b = self._backward(ref_a, ref_z, ref_gradient)
   787	        self._adam(
   788	            [left + right for left, right in zip(cand_w, ref_w, strict=True)],
   789	            [left + right for left, right in zip(cand_b, ref_b, strict=True)],
   790	        )
   791	        return float(self.loss_weight * np.mean(residual * residual + self.gauge_beta * reference * reference))
   792	
   793	    def update_scalar(self, states: np.ndarray, targets: np.ndarray) -> float:
   794	        prediction, activations, preactivations = self._forward(states)
   795	        residual = prediction - targets
   796	        scale = 2.0 * self.loss_weight / float(len(residual))
   797	        gradients = self._backward(activations, preactivations, scale * residual)
   798	        self._adam(*gradients)
   799	        return float(self.loss_weight * np.mean(residual * residual))
   800	
   801	    def payload(self) -> dict[str, object]:
   802	        encode = lambda arrays: [
   803	            [[float_hex(value) for value in row] for row in array]
   804	            if array.ndim == 2 else [float_hex(value) for value in array]
   805	            for array in arrays
   806	        ]
   807	        return {
   808	            "kind": "legacy_heterogeneous_adam_mlp",
   809	            "activation": self.activation,
   810	            "weights_hex": encode(self.weights),
   811	            "biases_hex": encode(self.biases),
   812	            "adam_first_moment_weights_hex": encode(self.first_moment_w),
   813	            "adam_second_moment_weights_hex": encode(self.second_moment_w),
   814	            "adam_first_moment_biases_hex": encode(self.first_moment_b),
   815	            "adam_second_moment_biases_hex": encode(self.second_moment_b),
   816	            "adam_step": self.adam_step,
   817	            "optimizer": {
   818	                "kind": "Adam", "learning_rate": self.learning_rate,
   819	                "betas": [self.beta1, self.beta2], "epsilon": self.epsilon,
   820	                "weight_decay": self.weight_decay,
   821	            },
   822	            "gauge_beta": self.gauge_beta,
   823	            "loss_weight": self.loss_weight,
   824	        }
   825	
   826	
   827	@dataclass(slots=True)
   828	class AdamSetInteractionHead:
   829	    network: AdamMLPHead
   830	    member_width: int
   831	
   832	    def clone(self) -> "AdamSetInteractionHead":
   833	        return AdamSetInteractionHead(self.network.clone(), self.member_width)
   834	
   835	    def score(self, context: CoalitionContext) -> float:
   836	        if len(context.members) <= 1:
   837	            return 0.0
   838	        return self.network.score(context.invariant_vector(member_width=self.member_width))
   839	
   840	    def update(self, batch: CoalitionBatch) -> float:
   841	        return self.network.update_scalar(batch.invariant_states, batch.target_psi)
   842	
   843	    def payload(self) -> dict[str, object]:
   844	        return {
   845	            **self.network.payload(),
   846	            "kind": "permutation_invariant_set_conditioned_legacy_adam_mlp",
   847	            "architecture": "two_hidden_layer_relu_mlp_on_set_pools_and_ordered_pairwise_cross_gain_block",
   848	            "member_width": self.member_width,
   849	            "anchors": {"empty": 0.0, "singleton": 0.0},
   850	        }
   851	
   852	
   853	@dataclass(slots=True)
   854	class SetInteractionHead:
   855	    """Two-layer permutation-invariant scalar Psi MLP with hard zero anchors."""
   856	
   857	    input_weights: np.ndarray
   858	    input_bias: np.ndarray
   859	    output_weights: np.ndarray
   860	    output_bias: float
   861	    member_width: int
   862	
   863	    def clone(self) -> "SetInteractionHead":
   864	        return SetInteractionHead(
   865	            self.input_weights.copy(),
   866	            self.input_bias.copy(),
   867	            self.output_weights.copy(),
   868	            float(self.output_bias),
   869	            self.member_width,
   870	        )
   871	
   872	    def _hidden(self, values: np.ndarray) -> np.ndarray:
   873	        if values.shape[-1] != self.input_weights.shape[1]:
   874	            raise StageCContractError("set-interaction state shape drifted")
   875	        return np.tanh(values @ self.input_weights.T + self.input_bias)
   876	
   877	    def score(self, context: CoalitionContext) -> float:
   878	        if len(context.members) <= 1:
   879	            return 0.0
   880	        values = context.invariant_vector(member_width=self.member_width)
   881	        return float(self._hidden(values) @ self.output_weights + self.output_bias)
   882	
   883	    def update(self, batch: CoalitionBatch, *, learning_rate: float) -> float:
   884	        hidden = self._hidden(batch.invariant_states)
   885	        predictions = hidden @ self.output_weights + self.output_bias
   886	        residual = predictions - batch.target_psi
   887	        count = float(batch.target_psi.size)
   888	        scale = 2.0 / count
   889	        output_weights_before = self.output_weights.copy()
   890	        self.output_weights -= learning_rate * scale * (hidden.T @ residual)
   891	        self.output_bias -= learning_rate * float(scale * residual.sum())
   892	        hidden_gradient = residual[:, None] * output_weights_before[None, :] * (1.0 - hidden * hidden)
   893	        self.input_weights -= learning_rate * scale * (hidden_gradient.T @ batch.invariant_states)
   894	        self.input_bias -= learning_rate * scale * hidden_gradient.sum(axis=0)
   895	        loss = float(np.mean(residual * residual))
   896	        if not all(
   897	            np.isfinite(value).all()
   898	            for value in (self.input_weights, self.input_bias, self.output_weights)
   899	        ) or not np.isfinite(self.output_bias):
   900	            raise StageCContractError("non-finite C3 learner update")
   901	        return loss
   902	
   903	    def fit_closed_form(self, batch: CoalitionBatch, *, ridge: float = 1e-10) -> float:
   904	        """Deterministic synthetic/KAT fit of the same scalar squared-error head."""
   905	
   906	        hidden = self._hidden(batch.invariant_states)
   907	        design = np.column_stack((hidden, np.ones(hidden.shape[0])))
   908	        gram = design.T @ design + ridge * np.eye(design.shape[1])
   909	        solution = np.linalg.solve(gram, design.T @ batch.target_psi)
   910	        self.output_weights[:] = solution[:-1]
   911	        self.output_bias = float(solution[-1])
   912	        residual = design @ solution - batch.target_psi
   913	        return float(np.mean(residual * residual))
   914	
   915	    def payload(self) -> dict[str, object]:
   916	        return {
   917	            "kind": "permutation_invariant_set_conditioned_scalar",
   918	            "architecture": "two_layer_tanh_mlp_on_set_pools_and_ordered_pairwise_cross_gain_block",
   919	            "input_weights_hex": [
   920	                [float_hex(value) for value in row] for row in self.input_weights
   921	            ],
   922	            "input_bias_hex": [float_hex(value) for value in self.input_bias],
   923	            "output_weights_hex": [float_hex(value) for value in self.output_weights],
   924	            "output_bias_hex": float_hex(self.output_bias),
   925	            "member_width": self.member_width,
   926	            "anchors": {"empty": 0.0, "singleton": 0.0},
   927	        }
   928	
   929	
   930	@dataclass(slots=True)
   931	class V1ThreeRouteModel:
   932	    q1: LinearHead | AdamMLPHead
   933	    q2: LinearHead | AdamMLPHead
   934	    psi: SetInteractionHead | AdamSetInteractionHead
   935	    checkpoint_sha256: str | None = None
   936	
   937	    def clone(self) -> "V1ThreeRouteModel":
   938	        return V1ThreeRouteModel(
   939	            self.q1.clone(), self.q2.clone(), self.psi.clone(), self.checkpoint_sha256
   940	        )
   941	
   942	    def score(self, route: Route, state: Sequence[float]) -> float:
   943	        if route == "C1":
