   441	def fit_q1_bank(train_rows: Sequence[Row]) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
   442	    values = np.concatenate(
   443	        [np.concatenate((row.selected_q1, row.reference_q1), axis=0) for row in train_rows],
   444	        axis=0,
   445	    )
   446	    mean = values.mean(axis=0)
   447	    scale = values.std(axis=0)
   448	    scale[scale < 1e-12] = 1.0
   449	    rng = np.random.default_rng(SEED)
   450	    weights = rng.normal(0.0, math.sqrt(2.0 / Q1_WIDTH), size=(PER_USER_BANK_WIDTH, Q1_WIDTH))
   451	    bias = rng.normal(0.0, 0.25, size=PER_USER_BANK_WIDTH)
   452	    return mean, scale, weights, bias
   453	
   454	
   455	def feature_matrices(
   456	    rows: Sequence[Row],
   457	    bank: tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray],
   458	) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
   459	    mean, scale, weights, bias = bank
   460	    per_user = []
   461	    full_set = []
   462	    member_only = []
   463	    for row in rows:
   464	        selected = (row.selected_q1 - mean) / scale
   465	        reference = (row.reference_q1 - mean) / scale
   466	        selected_hidden = np.maximum(selected @ weights.T + bias, 0.0)
   467	        reference_hidden = np.maximum(reference @ weights.T + bias, 0.0)
   468	        deviation = np.concatenate(
   469	            ((selected - reference).sum(axis=0), (selected_hidden - reference_hidden).sum(axis=0))
   470	        )
   471	        per_user.append(deviation)
   472	        full_set.append(np.concatenate((row.base_context, deviation)))
   473	        member_only.append(np.concatenate((row.base_context[:MEMBER_CONTEXT_WIDTH], deviation)))
   474	    arrays = tuple(np.asarray(value, dtype=np.float64) for value in (per_user, full_set, member_only))
