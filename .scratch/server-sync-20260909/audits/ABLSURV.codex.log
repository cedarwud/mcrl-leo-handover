   454	            "state": "stateless",
   455	        }
   456	        if optimizer != expected_optimizer:
   457	            raise StageCContractError("checkpoint optimizer state mismatch")
   458	        completed = int(payload.get("completed_source_epochs", -1))
   459	        updates = int(payload.get("route_update_count", -1))
   460	        if completed < 0 or updates != completed * len(ROUTES):
   461	            raise StageCContractError("checkpoint source-epoch cursor is invalid")
   462	        arms = payload.get("arms")
   463	        if not isinstance(arms, dict) or set(arms) != set(LEARNED_ARMS):
   464	            raise StageCContractError("checkpoint arm inventory drifted")
   465	        for arm in LEARNED_ARMS:
   466	            arm_payload = arms[arm]
   467	            if not isinstance(arm_payload, dict) or set(arm_payload) != set(ROUTES):
   468	                raise StageCContractError("checkpoint head inventory drifted")
   469	            for route in ROUTES:
   470	                head_payload = arm_payload[route]
   471	                if not isinstance(head_payload, dict):
   472	                    raise StageCContractError("checkpoint head payload drifted")
   473	                weights = np.asarray(
   474	                    [parse_float_hex(value, field="weight") for value in head_payload["weights_hex"]],
   475	                    dtype=np.float64,
   476	                )
   477	                if weights.shape != self.models[arm].heads[route].weights.shape:
   478	                    raise StageCContractError("checkpoint head shape drifted")
   479	                self.models[arm].heads[route].weights[:] = weights
   480	                self.models[arm].heads[route].bias = parse_float_hex(
   481	                    head_payload["bias_hex"], field="bias"
   482	                )
   483	        self.completed_source_epochs = completed
   484	        self.route_update_count = updates
