   355	@dataclass(frozen=True)
   356	class C3SetInteraction:
   357	    """Shapley allocation of interaction beyond the singleton baseline."""
   358	
   359	    coalition_users: tuple[int, ...]
   360	    set_interaction: Fraction
   361	    z3_by_user: tuple[tuple[int, Fraction], ...]
   362	
   363	
   364	def c3_set_interaction(
   365	    *,
   366	    coalition_users: Sequence[int],
   367	    outcomes_by_subset: Mapping[frozenset[int], NetworkOutcome],
   368	    lambda_bits_per_j: int | float | str | Fraction,
   369	    eta_ref: int | float | str | Fraction,
   370	    kappa_bits_per_user_step: int | float | str | Fraction,
   371	) -> C3SetInteraction:
   372	    """Allocate a set interaction with exact Shapley arithmetic.
   373	
   374	    The characteristic value is complete ``F`` for every subset.  We subtract
   375	    each singleton's baseline marginal from its Shapley value, leaving only
   376	    interaction credit.  The credits sum exactly to
   377	    ``F(S)-F(∅)-Σ_i(F({i})-F(∅))``; for a pair this reduces to Ψ/2 each.
   378	    """
   379	
   380	    users = tuple(int(user) for user in coalition_users)
   381	    if len(users) < 2 or len(set(users)) != len(users):
   382	        raise MCRLContractError("set interaction needs at least two unique users")
   383	    expected = {
   384	        frozenset(subset)
   385	        for size in range(len(users) + 1)
   386	        for subset in itertools.combinations(users, size)
   387	    }
   388	    if set(outcomes_by_subset) != expected:
   389	        raise MCRLContractError("set interaction needs every coalition subset exactly once")
   390	    values = {
   391	        subset: network_objective(
   392	            outcome,
   393	            lambda_bits_per_j=lambda_bits_per_j,
   394	            eta_ref=eta_ref,
   395	            kappa_bits_per_user_step=kappa_bits_per_user_step,
   396	        )
   397	        for subset, outcome in outcomes_by_subset.items()
   398	    }
   399	    empty = values[frozenset()]
   400	    full = values[frozenset(users)]
   401	    interaction = full - empty - sum(
   402	        (values[frozenset((user,))] - empty for user in users), Fraction()
   403	    )
   404	    factorial = math.factorial
   405	    n = len(users)
   406	    credits = []
   407	    for user in users:
   408	        others = tuple(value for value in users if value != user)
   409	        shapley = Fraction()
   410	        for size in range(n):
   411	            weight = Fraction(factorial(size) * factorial(n - size - 1), factorial(n))
   412	            for subset_tuple in itertools.combinations(others, size):
   413	                subset = frozenset(subset_tuple)
   414	                shapley += weight * (
   415	                    values[subset | {user}] - values[subset]
   416	                )
   417	        singleton = values[frozenset((user,))] - empty
   418	        credits.append((user, shapley - singleton))
   419	    if sum((credit for _, credit in credits), Fraction()) != interaction:
   420	        raise MCRLContractError("Shapley interaction credits do not conserve set interaction")
   421	    return C3SetInteraction(users, interaction, tuple(credits))
   422	
