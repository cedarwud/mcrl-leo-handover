   154	def c1_difference_surplus(
   155	    candidate: NetworkOutcome,
   156	    default: NetworkOutcome,
   157	    *,
   158	    lambda_bits_per_j: int | float | str | Fraction,
   159	    eta_ref: int | float | str | Fraction,
   160	    kappa_bits_per_user_step: int | float | str | Fraction,
   161	) -> C1Label:
   162	    """Whole-network C1 difference versus the declared default action."""
   163	
   164	    eta, kappa = assert_calibration_prices(
   165	        lambda_bits_per_j=lambda_bits_per_j,
   166	        eta_ref=eta_ref,
   167	        kappa_bits_per_user_step=kappa_bits_per_user_step,
   168	    )
   169	    core = (candidate.bits - default.bits) - eta * (candidate.joules - default.joules)
   170	    # Phi_1=.5 and Phi_2=1 are prices in κ-bit units.  Dividing the physical
   171	    # surplus by κ and then adding Phi therefore keeps the target dimensionless.
   172	    phi = candidate.phi - default.phi
   173	    return C1Label(core, phi, core / kappa + phi)
