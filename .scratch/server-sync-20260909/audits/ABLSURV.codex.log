   325	class LineageOrchestrator:
   326	    """Five matched learned arms plus an external BASELINE policy."""
   327	
   328	    def __init__(
   329	        self,
   330	        *,
   331	        learner_seed: int,
   332	        batches: Mapping[Route, PairwiseBatch],
   333	        learning_rate: float = 0.02,
   334	        gauge_weight: float = 0.01,
   335	    ) -> None:
   336	        if set(batches) != set(ROUTES):
   337	            raise StageCContractError("orchestrator needs exactly C1/C2/C3 batches")
   338	        self.learner_seed = int(learner_seed)
   339	        self.batches = dict(batches)
   340	        self.learning_rate = float(learning_rate)
   341	        self.gauge_weight = float(gauge_weight)
   342	        dimensions = {route: batch.reference_states.shape[1] for route, batch in batches.items()}
   343	        template = _initial_model(self.learner_seed, dimensions)
   344	        self.initialization_payload = template.payload()
   345	        self.initialization_sha256 = canonical_sha256(self.initialization_payload)
   346	        self.models = {arm: template.clone() for arm in LEARNED_ARMS}
   347	        self.completed_source_epochs = 0
   348	        self.route_update_count = 0
   349	        self.loss_history: list[dict[str, object]] = []
   350	
   351	    @property
   352	    def batch_digests(self) -> dict[str, str]:
   353	        return {route: self.batches[route].digest for route in ROUTES}
   354	
   355	    @property
   356	    def source_authority_sha256(self) -> str:
   357	        authorities = {
   358	            batch.source_authority_sha256 for batch in self.batches.values()
   359	        }
   360	        if len(authorities) != 1:
   361	            raise StageCContractError("route batches disagree on source authority")
   362	        return next(iter(authorities))
   363	
   364	    def train_epoch(self) -> dict[str, dict[str, float]]:
   365	        """One deterministic pass over C1, C2, C3 fixed aggregate batches."""
   366	
   367	        epoch_losses: dict[str, dict[str, float]] = {arm: {} for arm in LEARNED_ARMS}
   368	        for route in ROUTES:
   369	            informed = self.batches[route]
   370	            neutral = informed.neutral()
   371	            for arm in LEARNED_ARMS:
   372	                batch = informed if SOURCE_MAP[arm][route] == "informed" else neutral
   373	                epoch_losses[arm][route] = self.models[arm].heads[route].update(
   374	                    batch,
   375	                    learning_rate=self.learning_rate,
   376	                    gauge_weight=self.gauge_weight,
   377	                )
   378	            self.route_update_count += 1
   379	        self.completed_source_epochs += 1
   380	        self.loss_history.append({"epoch": self.completed_source_epochs, "losses": epoch_losses})
   381	        return epoch_losses
   382	
   383	    def train(self, epochs: int, *, checkpoint_directory: str | Path | None = None) -> None:
   384	        if isinstance(epochs, bool) or epochs < 0:
   385	            raise StageCContractError("epochs must be a nonnegative integer")
   386	        for _ in range(epochs):
   387	            self.train_epoch()
   388	            if (
   389	                checkpoint_directory is not None
   390	                and self.completed_source_epochs % CHECKPOINT_EVERY_SOURCE_EPOCHS == 0
   391	            ):
   392	                path = Path(checkpoint_directory) / (
   393	                    f"learner-{self.learner_seed}-epoch-{self.completed_source_epochs:06d}.json"
   394	                )
   395	                self.write_checkpoint(path)
