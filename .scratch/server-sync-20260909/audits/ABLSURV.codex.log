   258	    kappa_bits_per_user_s: int | float | str | Fraction | None = None,
   259	    horizon_offsets: int = FORECAST_OFFSETS,
   260	) -> C2Label:
   261	    """OPS-3-style absorbing persistence with one -kappa per lost offset.
   262	
