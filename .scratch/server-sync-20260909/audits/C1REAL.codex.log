def _projection_from_profile(
    *,
    offset: int,
    profile: EvaluatedProfile | None,
    survives: bool,
) -> OffsetProjection:
    return OffsetProjection(
        offset,
        profile is not None,
        survives,
        (
            profile.outcome()
            if profile is not None
            else NetworkOutcome.build(
                bits=0,
                joules=0,
                phi=0,
                decoding_availability=0,
                useful_availability=0,
            )
