                q2_state=_normalize(q2_raw, Q2_FEATURES),
                incumbent_context_nominal_decoding_margin_db_hex=float_hex(
                    item.incumbent_nominal_decoding_margin_db
                ),
                q1_schema_sha256=Q1_SCHEMA_SHA256,
