@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Strict completeness validator for the C1 learnability result."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+
+
+REQUIRED_MODELS = {
+    "sealed_declared_width_8",
+    "linear_declared",
+    "sealed_surrogate_width_8",
+    "phi_only",
+    "constant",
+}
+REQUIRED_REGIMES = {"leave_one_anchor_out", "leave_one_world_out"}
+REQUIRED_METRICS = {"r2", "pairwise_ordering", "top1_accuracy"}
+
+
+def main(path: Path) -> None:
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    assert payload["status"] == "DIAGNOSTIC_NOT_CLAIM"
+    generation = payload["generation"]
+    assert set(generation["worlds"]) == {"V025_PROBE/world/1", "V025_PROBE/world/2"}
+    assert generation["anchors"] >= 60
+    assert generation["in_process_flag_override"] is True
+    assert generation["max_abs_base_gauge"] == 0.0
+    assert generation["max_abs_decomposition_residual"] <= 1e-9
+    assert generation["max_abs_target_helper_residual"] <= 1e-9
+    models = payload["models"]
+    assert REQUIRED_MODELS <= set(models)
+    for name in REQUIRED_MODELS:
+        assert REQUIRED_REGIMES <= set(models[name])
+        for regime in REQUIRED_REGIMES:
+            assert REQUIRED_METRICS <= set(models[name][regime])
+    assert len(payload["capacity"]["widths"]) >= 3
+    assert "high_capacity" in payload["capacity"]
+    importance = payload["permutation_importance"]
+    assert len(importance["slots"]) == 16
+    assert [row["slot"] for row in importance["slots"]] == list(range(16))
+    print(
+        json.dumps(
+            {
+                "validated": True,
+                "anchors": generation["anchors"],
+                "rows": generation["rows"],
+                "worlds": generation["worlds"],
+            },
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main(Path(sys.argv[1]))

diff --git a/.scratch/c1-declared/analyze.py b/.scratch/c1-declared/analyze.py
new file mode 100644
index 0000000000000000000000000000000000000000..4121ec9fc5857af056be175ccc544835f785d7ac
--- /dev/null
+++ b/.scratch/c1-declared/analyze.py
@@ -0,0 +1,518 @@
+#!/usr/bin/env python3
+"""Held-out learnability analysis for exact-path C1 rows."""
+
+from __future__ import annotations
+
+import argparse
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+import multiprocessing as mp
+import os
+from pathlib import Path
+import time
+from types import SimpleNamespace
+from typing import Iterable
+
+import numpy as np
+
+from mcrl.stagec_v025.learner import (
+    AdamMLPHead,
+    LEGACY_EPOCH_BUDGET,
+    LEGACY_TRAINER_LITERALS,
+)
+from mcrl.stagec_v025.state import Q1_FEATURES
+from mcrl.physics_v025.tapes import seed_from_domain
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRATCH = ROOT / ".scratch/c1-declared"
+PAIR_LIMIT = 4_096
+PILOT_LEARNER_DOMAINS = tuple(f"V025_LEARNER/seed/{i}" for i in range(1, 5))
+PILOT_LEARNER_SEEDS = tuple(seed_from_domain(value) for value in PILOT_LEARNER_DOMAINS)
+_WORKER_DATA: Dataset | None = None
+
+
+@dataclass(frozen=True)
+class Dataset:
+    exact_x: np.ndarray
+    surrogate_x: np.ndarray
+    declared_y: np.ndarray
+    surrogate_y: np.ndarray
+    phi: np.ndarray
+    reference: np.ndarray
+    anchor: np.ndarray
+    world: np.ndarray
+    group: np.ndarray
+    action_index: np.ndarray
+    anchor_records: tuple[dict[str, object], ...]
+    metadata: tuple[dict[str, object], ...]
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_dataset(paths: Iterable[Path]) -> Dataset:
+    metadata: list[dict[str, object]] = []
+    anchors: list[dict[str, object]] = []
+    rows: list[dict[str, object]] = []
+    for path in paths:
+        with path.open(encoding="utf-8") as handle:
+            for line in handle:
+                record = json.loads(line)
+                if record["kind"] == "metadata":
+                    metadata.append(record)
+                    continue
+                anchors.append(record)
+                for row in record["rows"]:
+                    rows.append({**row, "anchor_id": record["anchor_id"], "world_id": record["world_id"]})
+    anchor_names = sorted({str(row["anchor_id"]) for row in rows})
+    anchor_code = {value: index for index, value in enumerate(anchor_names)}
+    world_names = sorted({str(row["world_id"]) for row in rows})
+    world_code = {value: index for index, value in enumerate(world_names)}
+    group_names = sorted({f'{row["anchor_id"]}|user/{row["user_id"]}' for row in rows})
+    group_code = {value: index for index, value in enumerate(group_names)}
+    return Dataset(
+        exact_x=np.asarray([row["q1"] for row in rows], dtype=np.float64),
+        surrogate_x=np.asarray([row["surrogate_q1"] for row in rows], dtype=np.float64),
+        declared_y=np.asarray([row["declared"] for row in rows], dtype=np.float64),
+        surrogate_y=np.asarray([row["surrogate"] for row in rows], dtype=np.float64),
+        phi=np.asarray([row["phi"] for row in rows], dtype=np.float64),
+        reference=np.asarray([row["reference"] for row in rows], dtype=bool),
+        anchor=np.asarray([anchor_code[str(row["anchor_id"])] for row in rows], dtype=np.int32),
+        world=np.asarray([world_code[str(row["world_id"])] for row in rows], dtype=np.int8),
+        group=np.asarray(
+            [group_code[f'{row["anchor_id"]}|user/{row["user_id"]}'] for row in rows],
+            dtype=np.int32,
+        ),
+        action_index=np.asarray([row["action_index"] for row in rows], dtype=np.int16),
+        anchor_records=tuple(anchors),
+        metadata=tuple(metadata),
+    )
+
+
+def splits(data: Dataset, regime: str) -> list[tuple[np.ndarray, np.ndarray, str]]:
+    key = data.anchor if regime == "leave_one_anchor_out" else data.world
+    result = []
+    for value in np.unique(key):
+        test = key == value
+        result.append((~test, test, str(int(value))))
+    return result
+
+
+def build_pair_batch(
+    x: np.ndarray,
+    y: np.ndarray,
+    group: np.ndarray,
+    reference: np.ndarray,
+    train: np.ndarray,
+) -> SimpleNamespace:
+    ref_by_group = {int(group[index]): int(index) for index in np.flatnonzero(train & reference)}
+    candidates = np.flatnonzero(train & ~reference)
+    references = np.asarray([ref_by_group[int(group[index])] for index in candidates], dtype=np.int64)
+    if candidates.size > PAIR_LIMIT:
+        chosen = np.linspace(0, candidates.size - 1, PAIR_LIMIT, dtype=np.int64)
+        candidates = candidates[chosen]
+        references = references[chosen]
+    return SimpleNamespace(
+        reference_states=x[references],
+        candidate_states=x[candidates],
+        target_deltas=y[candidates] - y[references],
+    )
+
+
+def metric(prediction: np.ndarray, truth: np.ndarray, group: np.ndarray) -> dict[str, object]:
+    residual_ss = float(np.square(truth - prediction).sum())
+    total_ss = float(np.square(truth - truth.mean()).sum())
+    r2 = 1.0 - residual_ss / total_ss if total_ss else math.nan
+    concordant = 0.0
+    comparable = 0
+    top1_hits = 0
+    groups = 0
+    for group_id in np.unique(group):
+        indices = np.flatnonzero(group == group_id)
+        if indices.size < 2:
+            continue
+        target = truth[indices]
+        score = prediction[indices]
+        left, right = np.triu_indices(indices.size, 1)
+        target_delta = target[left] - target[right]
+        score_delta = score[left] - score[right]
+        keep = np.abs(target_delta) > 1e-12
+        target_delta = target_delta[keep]
+        score_delta = score_delta[keep]
+        comparable += int(target_delta.size)
+        concordant += float(np.sum(np.sign(target_delta) == np.sign(score_delta)))
+        concordant += 0.5 * float(np.sum(np.abs(score_delta) <= 1e-15))
+        selected = int(np.argmax(score))
+        top1_hits += int(target[selected] >= target.max() - 1e-12)
+        groups += 1
+    return {
+        "r2": r2,
+        "pairwise_ordering": concordant / comparable if comparable else math.nan,
+        "top1_accuracy": top1_hits / groups if groups else math.nan,
+        "rows": int(truth.size),
+        "pairs": comparable,
+        "groups": groups,
+    }
+
+
+def aggregate_seed_metrics(items: list[dict[str, object]]) -> dict[str, object]:
+    fields = ("r2", "pairwise_ordering", "top1_accuracy")
+    result: dict[str, object] = {}
+    for field in fields:
+        values = np.asarray([float(row[field]) for row in items])
+        result[field] = float(values.mean())
+        result[f"{field}_min"] = float(values.min())
+        result[f"{field}_max"] = float(values.max())
+    result["seeds"] = len(items)
+    result["per_seed"] = items
+    return result
+
+
+def run_adam_task(task: tuple[str, str, int, int]) -> dict[str, object]:
+    target_name, regime, width, seed = task
+    data = _WORKER_DATA
+    if data is None:
+        raise RuntimeError("forked Adam worker did not inherit the dataset")
+    if target_name == "declared":
+        x, y = data.exact_x, data.declared_y
+    else:
+        x, y = data.surrogate_x, data.surrogate_y
+    literal = dict(LEGACY_TRAINER_LITERALS["C1"])
+    literal["hidden_layers"] = (width,)
+    prediction = np.empty_like(y)
+    fold_rows = []
+    started = time.perf_counter()
+    for train, test, fold in splits(data, regime):
+        batch = build_pair_batch(x, y, data.group, data.reference, train)
+        head = AdamMLPHead.create(x.shape[1], literal, np.random.default_rng(seed))
+        for _epoch in range(LEGACY_EPOCH_BUDGET):
+            head.update(batch)
+        prediction[test] = head._forward(x[test])[0]
+        fold_rows.append({"fold": fold, "train_pairs": int(batch.target_deltas.size), "test_rows": int(test.sum())})
+    result = metric(prediction, y, data.group)
+    result.update(
+        {
+            "target": target_name,
+            "regime": regime,
+            "width": width,
+            "seed": seed,
+            "epochs": LEGACY_EPOCH_BUDGET,
+            "pair_limit": PAIR_LIMIT,
+            "wall_s": time.perf_counter() - started,
+            "folds": fold_rows,
+            "prediction": prediction,
+        }
+    )
+    return result
+
+
+def linear_cv(data: Dataset, regime: str) -> tuple[dict[str, object], np.ndarray]:
+    x, y = data.exact_x, data.declared_y
+    prediction = np.empty_like(y)
+    for train, test, _fold in splits(data, regime):
+        batch = build_pair_batch(x, y, data.group, data.reference, train)
+        difference = batch.candidate_states - batch.reference_states
+        pair_design = np.column_stack((difference, np.zeros(difference.shape[0])))
+        gauge_design = np.column_stack((batch.reference_states, np.ones(batch.reference_states.shape[0])))
+        design = np.vstack((pair_design, math.sqrt(0.2) * gauge_design))
+        target = np.concatenate((batch.target_deltas, np.zeros(gauge_design.shape[0])))
+        coefficient = np.linalg.lstsq(design, target, rcond=None)[0]
+        prediction[test] = np.column_stack((x[test], np.ones(test.sum()))) @ coefficient
+    result = metric(prediction, y, data.group)
+    result.update({"fit": "closed-form pairwise least squares plus gauge_beta=0.2", "pair_limit": PAIR_LIMIT})
+    return result, prediction
+
+
+def constant_cv(data: Dataset, regime: str) -> tuple[dict[str, object], np.ndarray]:
+    prediction = np.empty_like(data.declared_y)
+    for train, test, _fold in splits(data, regime):
+        prediction[test] = float(data.declared_y[train].mean())
+    return metric(prediction, data.declared_y, data.group), prediction
+
+
+def phi_cv(data: Dataset, regime: str) -> tuple[dict[str, object], np.ndarray]:
+    prediction = data.phi.copy()
+    return metric(prediction, data.declared_y, data.group), prediction
+
+
+def random_feature_map(x: np.ndarray, mean: np.ndarray, scale: np.ndarray, seed: int) -> np.ndarray:
+    normalized = (x - mean) / scale
+    rng = np.random.default_rng(seed)
+    w1 = rng.normal(0.0, math.sqrt(2.0 / x.shape[1]), (x.shape[1], 256))
+    b1 = rng.normal(0.0, 0.1, 256)
+    hidden1 = np.maximum(normalized @ w1 + b1, 0.0)
+    w2 = rng.normal(0.0, math.sqrt(2.0 / 256), (256, 256))
+    b2 = rng.normal(0.0, 0.1, 256)
+    hidden2 = np.maximum(hidden1 @ w2 + b2, 0.0)
+    return np.column_stack((normalized, hidden1, hidden2, np.ones(x.shape[0])))
+
+
+def high_capacity_cv(
+    data: Dataset, regime: str, *, keep_models: bool = False
+) -> tuple[dict[str, object], np.ndarray, list[dict[str, object]]]:
+    x, y = data.exact_x, data.declared_y
+    prediction = np.empty_like(y)
+    models: list[dict[str, object]] = []
+    seed = PILOT_LEARNER_SEEDS[0]
+    started = time.perf_counter()
+    for train, test, fold in splits(data, regime):
+        mean = x[train].mean(axis=0)
+        scale = x[train].std(axis=0)
+        scale[scale == 0.0] = 1.0
+        z_train = random_feature_map(x[train], mean, scale, seed)
+        z_test = random_feature_map(x[test], mean, scale, seed)
+        ridge = 1e-6
+        gram = z_train.T @ z_train
+        coefficient = np.linalg.solve(
+            gram + ridge * np.eye(gram.shape[0]), z_train.T @ y[train]
+        )
+        prediction[test] = z_test @ coefficient
+        if keep_models:
+            models.append(
+                {
+                    "fold": fold,
+                    "test": test,
+                    "mean": mean,
+                    "scale": scale,
+                    "coefficient": coefficient,
+                }
+            )
+    result = metric(prediction, y, data.group)
+    result.update(
+        {
+            "architecture": "fixed-seed 16-256-256 ReLU random features plus raw slots and ridge output",
+            "trainable_output_parameters": 529,
+            "random_seed": seed,
+            "ridge": 1e-6,
+            "wall_s": time.perf_counter() - started,
+        }
+    )
+    return result, prediction, models
+
+
+def permutation_importance(
+    data: Dataset,
+    baseline: dict[str, object],
+    models: list[dict[str, object]],
+) -> dict[str, object]:
+    rows = []
+    seed = seed_from_domain("C1REAL/permutation/2026-09-10")
+    for slot in range(data.exact_x.shape[1]):
+        permuted_prediction = np.empty_like(data.declared_y)
+        for model in models:
+            test = model["test"]
+            x_test = data.exact_x[test].copy()
+            group_test = data.group[test]
+            rng = np.random.default_rng(seed + slot)
+            for group_id in np.unique(group_test):
+                indices = np.flatnonzero(group_test == group_id)
+                x_test[indices, slot] = x_test[rng.permutation(indices), slot]
+            z = random_feature_map(
+                x_test, model["mean"], model["scale"], PILOT_LEARNER_SEEDS[0]
+            )
+            permuted_prediction[test] = z @ model["coefficient"]
+        permuted = metric(permuted_prediction, data.declared_y, data.group)
+        rows.append(
+            {
+                "slot": slot,
+                "name": Q1_FEATURES[slot].name,
+                "r2_drop": float(baseline["r2"]) - float(permuted["r2"]),
+                "pairwise_ordering_drop": float(baseline["pairwise_ordering"])
+                - float(permuted["pairwise_ordering"]),
+                "top1_accuracy_drop": float(baseline["top1_accuracy"])
+                - float(permuted["top1_accuracy"]),
+                "permuted_metrics": permuted,
+            }
+        )
+    return {
+        "model": "high_capacity",
+        "regime": "leave_one_world_out",
+        "method": "permute one slot within each held-out (anchor,user) option set",
+        "seed": seed,
+        "slots": rows,
+    }
+
+
+def slot_audit(data: Dataset) -> dict[str, object]:
+    x = data.exact_x
+    return {
+        "constant_slots": {
+            "6": {"minimum": float(x[:, 6].min()), "maximum": float(x[:, 6].max())},
+            "15": {"minimum": float(x[:, 15].min()), "maximum": float(x[:, 15].max())},
+        },
+        "indicator_violations": {
+            "slot_4_equals_indicator_slot_3_positive": int(np.sum(x[:, 4] != (x[:, 3] > 0.0))),
+            "slot_12_equals_indicator_slot_11_positive": int(np.sum(x[:, 12] != (x[:, 11] > 0.0))),
+        },
+        "nominal_dimension": 16,
+        "effective_dimension": 12,
+        "indexing": "zero-based",
+    }
+
+
+def clean_metric(value: dict[str, object]) -> dict[str, object]:
+    return {key: item for key, item in value.items() if key != "prediction"}
+
+
+def main() -> None:
+    global _WORKER_DATA
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--inputs", type=Path, nargs="+", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    data = load_dataset(args.inputs)
+    _WORKER_DATA = data
+    if len(np.unique(data.anchor)) < 2 or len(np.unique(data.world)) != 2:
+        raise RuntimeError("analysis requires at least two anchors and exactly two worlds")
+
+    tasks = []
+    for target in ("declared", "surrogate"):
+        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
+            seeds = PILOT_LEARNER_SEEDS[:1] if regime == "leave_one_anchor_out" else PILOT_LEARNER_SEEDS
+            for seed in seeds:
+                tasks.append((target, regime, 8, seed))
+    for width in (32, 128):
+        for regime in ("leave_one_anchor_out", "leave_one_world_out"):
