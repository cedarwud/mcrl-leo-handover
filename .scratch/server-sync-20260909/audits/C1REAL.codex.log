+#!/usr/bin/env python3
+"""Strict completeness validator for the C1 learnability result."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+
+
+REQUIRED_MODELS = {
+    "sealed_declared_width_8",
+    "linear_declared",
+    "sealed_surrogate_width_8",
+    "phi_only",
+    "constant",
+}
+REQUIRED_REGIMES = {"leave_one_anchor_out", "leave_one_world_out"}
+REQUIRED_METRICS = {"r2", "pairwise_ordering", "top1_accuracy"}
+
+
+def main(path: Path) -> None:
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    assert payload["status"] == "DIAGNOSTIC_NOT_CLAIM"
+    generation = payload["generation"]
+    assert set(generation["worlds"]) == {"V025_PROBE/world/1", "V025_PROBE/world/2"}
+    assert generation["anchors"] >= 60
+    assert generation["in_process_flag_override"] is True
+    assert generation["max_abs_base_gauge"] == 0.0
+    assert generation["max_abs_decomposition_residual"] <= 1e-9
+    assert generation["max_abs_target_helper_residual"] <= 1e-9
+    models = payload["models"]
+    assert REQUIRED_MODELS <= set(models)
+    for name in REQUIRED_MODELS:
+        assert REQUIRED_REGIMES <= set(models[name])
+        for regime in REQUIRED_REGIMES:
+            assert REQUIRED_METRICS <= set(models[name][regime])
+    assert len(payload["capacity"]["widths"]) >= 3
+    assert "high_capacity" in payload["capacity"]
+    importance = payload["permutation_importance"]
+    assert len(importance["slots"]) == 16
+    assert [row["slot"] for row in importance["slots"]] == list(range(16))
+    print(
+        json.dumps(
+            {
+                "validated": True,
+                "anchors": generation["anchors"],
+                "rows": generation["rows"],
+                "worlds": generation["worlds"],
+            },
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main(Path(sys.argv[1]))

