+        "## M1 — endpoint efficiency and spread",
+        "",
+    ]
+    for variant in VARIANTS:
+        lines += [
+            f"### `{variant}`",
+            "",
+            "| anchor | start 0 | start 1 | start 2 | start 3 | start 4 | start 5 | start 6 | start 7 | spread | best over start 0 |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
