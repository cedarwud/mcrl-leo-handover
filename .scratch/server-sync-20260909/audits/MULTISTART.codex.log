+
+def _job(args):
+    variant, world, step, output = args
+    return run_anchor(variant, world, step, Path(output))["anchor_id"], variant
+
+
+def run_all(output_root: Path, workers: int, resume: bool) -> None:
+    if workers < 1 or workers > 4:
+        raise RuntimeError("--workers must be between 1 and 4")
+    jobs = []
+    for variant in VARIANTS:
+        for world, step in ANCHORS:
+            output = output_root / f"{variant.lower()}-w{world}-s{step}.json"
+            if resume and output.exists():
+                _load_receipt(output)
+                print(json.dumps({"resume_hit": str(output)}), flush=True)
+                continue
+            jobs.append((variant, world, step, str(output)))
+    with ProcessPoolExecutor(max_workers=workers) as executor:
+        futures = {executor.submit(_job, job): job for job in jobs}
+        for future in as_completed(futures):
+            anchor_id, variant = future.result()
+            print(json.dumps({"completed_anchor": anchor_id, "variant": variant}), flush=True)
+
+
+def _pool(metrics: Iterable[Mapping[str, object]]) -> dict[str, float]:
+    rows = list(metrics)
+    bits = math.fsum(float(row["bits"]) for row in rows)
+    joules = math.fsum(float(row["joules"]) for row in rows)
+    return {"bits": bits, "joules": joules, "ee_bit_per_j": bits / joules}
+
+
+def _pct(value: float) -> str:
+    return f"{100.0 * value:.4f}%"
+
+
+def _ee(value: float) -> str:
+    return f"{value / 1e6:.6f}"
+
+
+def _dist(values: Sequence[float]) -> str:
+    if not values:
+        return "none"
+    rows = sorted(values)
+    return (
+        f"min {min(rows):.6g}, median {statistics.median(rows):.6g}, "
+        f"mean {statistics.fmean(rows):.6g}, max {max(rows):.6g}"
+    )
+
+
+def _collect(output_root: Path) -> dict[str, list[dict]]:
+    result = {variant: [] for variant in VARIANTS}
+    for variant in VARIANTS:
+        for world, step in ANCHORS:
+            path = output_root / f"{variant.lower()}-w{world}-s{step}.json"
+            row = _load_receipt(path)
+            if not row.get("complete"):
+                raise RuntimeError(f"incomplete receipt: {path}")
+            result[variant].append(row)
+    return result
+
+
