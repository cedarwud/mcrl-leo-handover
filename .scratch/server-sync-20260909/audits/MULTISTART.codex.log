+    material = (
+        f"mcrl-v025-multistart|{MASTER_SEED}|{world}|{step}|"
+        f"{start_index}|{attempt}"
+    ).encode("ascii")
+    return int.from_bytes(hashlib.sha256(material).digest()[:8], "big")
