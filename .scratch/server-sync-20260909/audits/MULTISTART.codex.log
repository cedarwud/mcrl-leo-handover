+#!/usr/bin/env python3
+"""Multi-start and 2-swap diagnostic for the V0.25 exact selector.
+
+This runner imports the first-improvement loop from the 2026-09-10 harness
+workspace.  It does not restate that loop.  The only adapter supplies a
+different initial incumbent while retaining the nearest-eligible transition
+reference and nearest-eligible served-count guard.
+"""
+
+from __future__ import annotations
+
+import argparse
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from contextlib import contextmanager
+from fractions import Fraction
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import pickle
+import random
+import statistics
+import sys
+import time
+from typing import Iterable, Mapping, Sequence
+
+
+WORKSPACE = Path(__file__).resolve().parents[1]
+HARNESS = Path("/home/sat/mcrl-v025-harness-ws")
+HARNESS_SOURCE = HARNESS / "harness/anytime.py"
+EXPECTED_ANYTIME_SHA256 = (
+    "003bdee1df908fddf652f2f8069c31a6297a7f7178bbb83338d09b3f4add9928"
+)
+MASTER_SEED = 20260910
+START_COUNT = 8
+SWAP_BATCH_SIZE = 256
+ANCHORS = (
+    (1, 0),
+    (1, 1),
+    (2, 0),
+    (2, 1),
+    (3, 0),
+    (3, 1),
+    (4, 0),
+    (4, 1),
+)
+VARIANTS = ("SEALED", "MARGIN_Q")
+RECEIPTS = {
+    "SEALED": HARNESS / "receipts/anytime-sealed-full20.json",
+    "MARGIN_Q": HARNESS / "receipts/anytime-margin-q-full20.json",
+}
+OUTPUT_ROOT = WORKSPACE / ".scratch/multistart-ceiling-20260910"
+CLAIM = "DIAGNOSTIC_NOT_CLAIM"
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _ensure_harness() -> None:
+    actual = _sha256(HARNESS_SOURCE)
+    if actual != EXPECTED_ANYTIME_SHA256:
+        raise RuntimeError(
+            f"first-improvement implementation drifted: {actual} != "
+            f"{EXPECTED_ANYTIME_SHA256}"
+        )
+    if str(HARNESS) not in sys.path:
+        sys.path.insert(0, str(HARNESS))
+
+
+def _anchor_id(world: int, step: int) -> str:
+    return f"V025_PROBE_R2/world/{world}:step/{step}"
+
+
+def _canonical_digest(payload: Mapping[str, object]) -> str:
+    unsigned = dict(payload)
+    unsigned.pop("receipt_sha256", None)
+    encoded = json.dumps(
+        unsigned,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _write_receipt(payload: dict, path: Path) -> None:
+    payload["receipt_sha256"] = _canonical_digest(payload)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + f".tmp-{os.getpid()}")
+    temporary.write_text(
+        json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
+        encoding="ascii",
+    )
+    temporary.replace(path)
+
+
+def _load_receipt(path: Path) -> dict:
+    payload = json.loads(path.read_text(encoding="ascii"))
+    expected = payload.get("receipt_sha256")
+    actual = _canonical_digest(payload)
+    if expected != actual:
+        raise RuntimeError(f"receipt digest mismatch: {path}: {actual} != {expected}")
+    return payload
+
+
+def _source_anchor(variant: str, world: int, step: int) -> tuple[dict, dict]:
+    receipt = _load_receipt(RECEIPTS[variant])
+    wanted = _anchor_id(world, step)
+    row = next(item for item in receipt["anchors"] if item["anchor_id"] == wanted)
+    return receipt, row
+
+
+def _load_tape(receipt: Mapping[str, object], world: int):
+    world_row = next(
+        row for row in receipt["worlds"] if int(row["world_index"]) == world
+    )
+    path = HARNESS / ".harness-cache/worlds" / f"{world_row['cache_key']}.pickle"
+    tape = pickle.loads(path.read_bytes())
+    if tape.digest != world_row["world_sha256"]:
+        raise RuntimeError(f"world cache digest mismatch for world {world}")
+    return tape, world_row, path
+
+
+def _mapping(metric: Mapping[str, object]) -> dict[int, tuple[int, int] | None]:
+    return {
+        int(user): None if identity is None else tuple(int(value) for value in identity)
+        for user, identity in metric["assignments"]
+    }
+
+
+def _metric(reference, profile) -> dict[str, object]:
+    from harness.anytime import _metric_payload
+
+    return _metric_payload(reference, profile)
+
+
+def _fraction_payload(value: Fraction) -> list[int]:
+    return [value.numerator, value.denominator]
+
+
+def _seed_for(world: int, step: int, start_index: int, attempt: int) -> int:
+    material = (
+        f"mcrl-v025-multistart|{MASTER_SEED}|{world}|{step}|"
+        f"{start_index}|{attempt}"
+    ).encode("ascii")
+    return int.from_bytes(hashlib.sha256(material).digest()[:8], "big")
+
+
+def _random_start(reference, tape, true_base, options, baseline_guard: int,
+                  world: int, step: int, start_index: int, used: set[tuple]):
+    for attempt in range(10_000):
+        derived_seed = _seed_for(world, step, start_index, attempt)
+        rng = random.Random(derived_seed)
+        evaluator = reference.probe.StepEvaluator(
+            tape,
+            reference.probe._setting("a-r0"),
+            step,
+            transition_from=true_base,
+            field="realised",
+            run_setting=reference.probe.run_setting_for("a-r0"),
+            boundary_indices=(0,),
+            fading_quantile_alpha=0.10,
+        )
+        current = true_base
+        users = sorted(options)
+        rng.shuffle(users)
+        attempted_changes = 0
+        accepted_changes = 0
+        for user in users:
+            rows = options[user]
+            if not rows:
+                continue
+            identity = rows[rng.randrange(len(rows))]
+            if identity == current.mapping[user]:
+                continue
+            mapping = current.mapping
+            mapping[user] = identity
+            candidate = reference._configuration(
+                true_base, mapping, "multistart-feasible-random-walk"
+            )
+            attempted_changes += 1
+            evaluator.evaluate_many((candidate,))
+            profile = evaluator._evaluated.get(candidate.configuration_id)
+            if profile is not None and reference.served(profile) >= baseline_guard:
+                current = candidate
+                accepted_changes += 1
+        config = current
+        if config.assignments not in used:
+            used.add(config.assignments)
+            return config, derived_seed, attempt, attempted_changes, accepted_changes
+    raise RuntimeError("could not obtain a distinct randomized start")
+
+
+@contextmanager
+def _start_adapter(reference, true_base, start, baseline_guard: int):
+    """Feed a start into the imported loop without changing its decision rules."""
+
+    from harness import anytime
+
+    original_base_configuration = reference.probe._base_configuration
+    original_create_descriptor = anytime.TimedEvaluator.__dict__["create"]
+    original_create = anytime.TimedEvaluator.create
+    original_served = reference.served
+    initial_guard_pending = True
+
+    def adapted_base_configuration(tape, step_index, carrier):
+        return start
+
+    def adapted_create(cls, ref, tape, step_index, _algorithm_base, started):
+        return original_create(ref, tape, step_index, true_base, started)
+
+    def adapted_served(profile):
+        nonlocal initial_guard_pending
+        if initial_guard_pending and profile.config.configuration_id == start.configuration_id:
+            initial_guard_pending = False
+            return baseline_guard
+        return original_served(profile)
+
+    reference.probe._base_configuration = adapted_base_configuration
+    anytime.TimedEvaluator.create = classmethod(adapted_create)
+    reference.served = adapted_served
+    try:
+        yield
+    finally:
+        reference.probe._base_configuration = original_base_configuration
+        anytime.TimedEvaluator.create = original_create_descriptor
+        reference.served = original_served
+
+
+def _run_imported_search(reference, tape, step: int, true_base, start,
+                         baseline_guard: int):
+    from harness.anytime import first_improvement_unilateral
+
+    with _start_adapter(reference, true_base, start, baseline_guard):
+        return first_improvement_unilateral(reference, tape, step)
+
+
+def _singleton_profile(reference, tape, step: int, true_base, config,
+                       boundaries: Sequence[int]):
+    evaluator = reference.probe.StepEvaluator(
+        tape,
+        reference.probe._setting("a-r0"),
+        step,
+        transition_from=true_base,
+        field="realised",
+        run_setting=reference.probe.run_setting_for("a-r0"),
+        boundary_indices=tuple(boundaries),
+        fading_quantile_alpha=0.10,
+    )
+    evaluator.evaluate_many((config,))
+    profile = evaluator._evaluated.get(config.configuration_id)
+    if profile is None:
+        raise RuntimeError(f"invalid configuration: {config.configuration_id}")
+    return profile
+
+
+def _swap_test(reference, tape, step: int, true_base, endpoint, options,
+               baseline_guard: int) -> dict[str, object]:
+    evaluator = reference.probe.StepEvaluator(
+        tape,
+        reference.probe._setting("a-r0"),
+        step,
+        transition_from=true_base,
+        field="realised",
+        run_setting=reference.probe.run_setting_for("a-r0"),
+        boundary_indices=(0,),
+        fading_quantile_alpha=0.10,
+    )
+    evaluator.evaluate_many((endpoint,))
+    current_profile = evaluator._evaluated.get(endpoint.configuration_id)
+    if current_profile is None:
+        raise RuntimeError("endpoint invalid in swap test")
+    current_value = reference.objective(current_profile)
+    mapping = endpoint.mapping
+    users = sorted(mapping)
+    candidates_by_id = {}
+    pair_by_id = {}
+    pair_count = 0
+    for left_index, left in enumerate(users):
+        left_identity = mapping[left]
+        for right in users[left_index + 1:]:
+            right_identity = mapping[right]
+            if left_identity == right_identity:
+                continue
+            if right_identity is None or left_identity is None:
+                continue
+            if right_identity not in options[left] or left_identity not in options[right]:
+                continue
+            swapped = dict(mapping)
+            swapped[left], swapped[right] = right_identity, left_identity
+            candidate = reference._configuration(
+                true_base, swapped, "multistart-two-user-swap"
+            )
+            pair_count += 1
+            candidates_by_id.setdefault(candidate.configuration_id, candidate)
+            pair_by_id.setdefault(candidate.configuration_id, (left, right))
+
+    improving = []
+    candidates = tuple(candidates_by_id.values())
+    for offset in range(0, len(candidates), SWAP_BATCH_SIZE):
+        evaluator.evaluate_many(candidates[offset:offset + SWAP_BATCH_SIZE])
+    for candidate in candidates:
+        profile = evaluator._evaluated.get(candidate.configuration_id)
+        if profile is None or reference.served(profile) < baseline_guard:
+            continue
+        value = reference.objective(profile)
+        if value > current_value:
+            improving.append((value - current_value, candidate.configuration_id, candidate))
+
+    best = None
+    # The configuration id is the deterministic secondary key.  Express the
+    # maximisation explicitly to avoid depending on enumeration order.
+    if improving:
+        maximum = max(row[0] for row in improving)
+        best = min((row for row in improving if row[0] == maximum), key=lambda row: row[1])
+    best_payload = None
+    if best is not None:
+        delta, configuration_id, config = best
+        committed_current = _singleton_profile(
+            reference, tape, step, true_base, endpoint, tuple(range(48))
+        )
+        committed_swap = _singleton_profile(
+            reference, tape, step, true_base, config, tuple(range(48))
+        )
+        current_metric = _metric(reference, committed_current)
+        swap_metric = _metric(reference, committed_swap)
+        best_payload = {
+            "users": list(pair_by_id[configuration_id]),
+            "configuration_id": configuration_id,
+            "selection_delta_f_exact": _fraction_payload(delta),
+            "selection_delta_f_bit": float(delta),
+            "selection_delta_f_mbit": float(delta) / 1e6,
+            "selection_relative_delta_over_abs_f": (
+                None if current_value == 0 else float(delta / abs(current_value))
+            ),
+            "committed": swap_metric,
+            "committed_ee_gain_over_endpoint": (
+                float(swap_metric["ee_bit_per_j"])
+                / float(current_metric["ee_bit_per_j"])
+                - 1.0
+            ),
+        }
+    return {
+        "swap_definition": (
+            "unordered user pair; exchange two distinct non-NULL assigned identities; "
+            "both received identities must be in the receiving user's sealed legal options"
+        ),
+        "legal_swap_pair_count": pair_count,
+        "unique_legal_swap_configuration_count": len(candidates),
+        "feasible_improving_swap_count": len(improving),
+        "is_two_swap_optimal": not improving,
+        "endpoint_selection_f_exact": _fraction_payload(current_value),
+        "endpoint_selection_f_bit": float(current_value),
+        "best_improving_swap": best_payload,
+    }
+
+
+def _state_space(options) -> dict[str, object]:
+    counts = [max(1, len(rows)) for rows in options.values()]
+    log10_count = math.fsum(math.log10(count) for count in counts)
+    unique_identities = {identity for rows in options.values() for identity in rows}
+    return {
+        "user_count": len(options),
+        "unique_legal_identity_count": len(unique_identities),
+        "legal_option_count": sum(len(rows) for rows in options.values()),
+        "per_user_option_min": min(counts),
+        "per_user_option_max": max(counts),
+        "assignment_space_log10": log10_count,
+        "assignment_space_floor_decimal_exponent": math.floor(log10_count),
+    }
+
+
+def run_anchor(variant: str, world: int, step: int, output: Path) -> dict:
+    _ensure_harness()
+    from harness.runner import install_variant
+    from harness import sealed as sealed_module
+
+    source_receipt, source_row = _source_anchor(variant, world, step)
+    tape, world_row, tape_path = _load_tape(source_receipt, world)
+    tree = sealed_module.verify()
+    reference = sealed_module.reference_runner()
+    variant_row, _installed, _sealed = install_variant(variant)
+    true_base = reference.probe._base_configuration(tape, step, "nearest-eligible")
+    options, census = reference.probe._legal_options(tape, step)
+    base_selection = _singleton_profile(reference, tape, step, true_base, true_base, (0,))
+    baseline_guard = reference.served(base_selection)
+
+    nearest_metric = source_row["checkpoints"]["convergence"]
+    nearest = reference._configuration(
+        true_base, _mapping(nearest_metric), "multistart-source-nearest-endpoint"
+    )
+    if nearest.configuration_id != nearest_metric["configuration_id"]:
+        raise RuntimeError("nearest endpoint reconstruction mismatch")
+
+    used = {true_base.assignments}
+    starts = [{
+        "start_index": 0,
+        "start_kind": "nearest-eligible",
+        "derived_seed": None,
+        "collision_attempt": 0,
+        "configuration_id": true_base.configuration_id,
+        "assignments": [list(row) for row in true_base.assignments],
+    }]
+    start_configs = [true_base]
+    for start_index in range(1, START_COUNT):
+        config, derived_seed, attempt, attempted, accepted = _random_start(
+            reference, tape, true_base, options, baseline_guard,
+            world, step, start_index, used
+        )
+        start_configs.append(config)
+        starts.append({
+            "start_index": start_index,
+            "start_kind": "deterministic-feasible-random-walk-over-legal-options",
+            "derived_seed": derived_seed,
+            "collision_attempt": attempt,
+            "random_walk_attempted_changes": attempted,
+            "random_walk_accepted_feasible_changes": accepted,
+            "configuration_id": config.configuration_id,
+            "assignments": [list(row) for row in config.assignments],
+        })
+
+    endpoints = []
+    started = time.perf_counter()
+    for start_index, start in enumerate(start_configs):
+        if start_index == 0:
+            endpoint = nearest
+            endpoint_metric = dict(nearest_metric)
+            search = {
+                "source": "reused-signed-anytime-receipt",
+                "source_receipt": str(RECEIPTS[variant]),
+                "source_receipt_sha256": source_receipt["receipt_sha256"],
+                **source_row["unilateral"],
+            }
+        else:
+            start_profile = _singleton_profile(
+                reference, tape, step, true_base, start, (0,)
+            )
+            run = _run_imported_search(
+                reference, tape, step, true_base, start, baseline_guard
+            )
+            endpoint = run.selected
+            endpoint_profile = _singleton_profile(
+                reference, tape, step, true_base, endpoint, tuple(range(48))
+            )
+            endpoint_metric = _metric(reference, endpoint_profile)
+            search = {
+                "source": "imported-harness.anytime.first_improvement_unilateral",
+                "start_selection_served_count": reference.served(start_profile),
+                "start_satisfies_baseline_served_guard": (
+                    reference.served(start_profile) >= baseline_guard
+                ),
+                **run.receipt,
+            }
+        swap = _swap_test(
+            reference, tape, step, true_base, endpoint, options, baseline_guard
+        )
+        endpoints.append({
+            **starts[start_index],
+            "endpoint": endpoint_metric,
+            "search": search,
+            "two_swap": swap,
+        })
+        print(json.dumps({
+            "finished": _anchor_id(world, step),
+            "variant": variant,
+            "start": start_index,
+            "endpoint_ee_mbit_per_j": float(endpoint_metric["ee_bit_per_j"]) / 1e6,
+            "two_swap_optimal": swap["is_two_swap_optimal"],
+        }, sort_keys=True), flush=True)
+
+    endpoint_ees = [float(row["endpoint"]["ee_bit_per_j"]) for row in endpoints]
+    best_index = max(range(len(endpoints)), key=lambda index: endpoint_ees[index])
+    payload = {
+        "schema": "mcrl-v025-multistart-ceiling-anchor-v1",
+        "claim_ceiling": CLAIM,
+        "complete": True,
+        "variant": variant,
+        "variant_source_sha256": variant_row.source_sha256,
+        "anchor_id": _anchor_id(world, step),
+        "world_index": world,
+        "step_index": step,
+        "world_sha256": tape.digest,
+        "world_cache_path": str(tape_path),
+        "world_cache_record": world_row,
+        "sealed_manifest_sha256": tree.manifest_sha256,
+        "first_improvement_implementation": str(HARNESS_SOURCE),
+        "first_improvement_implementation_sha256": EXPECTED_ANYTIME_SHA256,
+        "master_seed": MASTER_SEED,
+        "start_count": START_COUNT,
+        "randomisation": (
+            "For each randomized start, random.Random is initialized from the first "
+            "64 bits of SHA256('mcrl-v025-multistart|MASTER_SEED|world|step|start|attempt'); "
+            "users are shuffled once and each receives one uniform draw from its ordered "
+            "sealed legal-option tuple. Starting from nearest-eligible, a drawn change is "
+            "retained exactly when its one-boundary profile is valid and meets the unchanged "
+            "nearest-baseline served-count guard. Objective values are not consulted. Duplicate "
+            "whole assignments are deterministically redrawn."
+        ),
+        "baseline_served_guard": baseline_guard,
+        "legal_option_census": census,
+        "state_space": _state_space(options),
+        "endpoints": endpoints,
+        "summary": {
+            "endpoint_ee_min": min(endpoint_ees),
+            "endpoint_ee_max": max(endpoint_ees),
+            "endpoint_ee_spread": max(endpoint_ees) - min(endpoint_ees),
+            "endpoint_ee_relative_spread": max(endpoint_ees) / min(endpoint_ees) - 1.0,
+            "best_start_index": best_index,
+            "best_over_nearest": endpoint_ees[best_index] / endpoint_ees[0] - 1.0,
+            "not_two_swap_optimal_count": sum(
+                not row["two_swap"]["is_two_swap_optimal"] for row in endpoints
+            ),
+        },
+        "wall_seconds": time.perf_counter() - started,
+        "processes_used_by_anchor": 1,
+        "numerical_threads_per_process": 1,
+        "learner_used": False,
+        "training_run_used": False,
+        "policy_run_used": False,
+        "sealed_artifact_modified": False,
+    }
+    _write_receipt(payload, output)
+    return payload
+
+
+def _job(args):
+    variant, world, step, output = args
+    return run_anchor(variant, world, step, Path(output))["anchor_id"], variant
+
+
+def run_all(output_root: Path, workers: int, resume: bool) -> None:
+    if workers < 1 or workers > 4:
+        raise RuntimeError("--workers must be between 1 and 4")
+    jobs = []
+    for variant in VARIANTS:
+        for world, step in ANCHORS:
+            output = output_root / f"{variant.lower()}-w{world}-s{step}.json"
+            if resume and output.exists():
+                _load_receipt(output)
+                print(json.dumps({"resume_hit": str(output)}), flush=True)
+                continue
+            jobs.append((variant, world, step, str(output)))
+    with ProcessPoolExecutor(max_workers=workers) as executor:
+        futures = {executor.submit(_job, job): job for job in jobs}
+        for future in as_completed(futures):
+            anchor_id, variant = future.result()
+            print(json.dumps({"completed_anchor": anchor_id, "variant": variant}), flush=True)
+
+
+def _pool(metrics: Iterable[Mapping[str, object]]) -> dict[str, float]:
+    rows = list(metrics)
+    bits = math.fsum(float(row["bits"]) for row in rows)
+    joules = math.fsum(float(row["joules"]) for row in rows)
+    return {"bits": bits, "joules": joules, "ee_bit_per_j": bits / joules}
+
+
+def _pct(value: float) -> str:
+    return f"{100.0 * value:.4f}%"
+
+
+def _ee(value: float) -> str:
+    return f"{value / 1e6:.6f}"
+
+
+def _dist(values: Sequence[float]) -> str:
+    if not values:
+        return "none"
+    rows = sorted(values)
+    return (
+        f"min {min(rows):.6g}, median {statistics.median(rows):.6g}, "
+        f"mean {statistics.fmean(rows):.6g}, max {max(rows):.6g}"
+    )
+
+
+def _collect(output_root: Path) -> dict[str, list[dict]]:
+    result = {variant: [] for variant in VARIANTS}
+    for variant in VARIANTS:
+        for world, step in ANCHORS:
+            path = output_root / f"{variant.lower()}-w{world}-s{step}.json"
+            row = _load_receipt(path)
+            if not row.get("complete"):
+                raise RuntimeError(f"incomplete receipt: {path}")
+            result[variant].append(row)
+    return result
+
+
+def render_report(output_root: Path) -> str:
+    data = _collect(output_root)
+    pooled = {}
+    all_endpoints = []
+    for variant, anchors in data.items():
+        start_pools = [
+            _pool(anchor["endpoints"][index]["endpoint"] for anchor in anchors)
+            for index in range(START_COUNT)
+        ]
+        best_rows = [
+            max(anchor["endpoints"], key=lambda row: row["endpoint"]["ee_bit_per_j"])
+            for anchor in anchors
+        ]
+        best_pool = _pool(row["endpoint"] for row in best_rows)
+        nearest_pool = start_pools[0]
+        endpoint_rows = [endpoint for anchor in anchors for endpoint in anchor["endpoints"]]
+        all_endpoints.extend((variant, anchor, endpoint)
+                             for anchor in anchors for endpoint in anchor["endpoints"])
+        nonoptimal = [row for row in endpoint_rows if not row["two_swap"]["is_two_swap_optimal"]]
+        deltas_mbit = [
+            float(row["two_swap"]["best_improving_swap"]["selection_delta_f_mbit"])
+            for row in nonoptimal
+        ]
+        committed_gains = [
+            float(row["two_swap"]["best_improving_swap"]["committed_ee_gain_over_endpoint"])
+            for row in nonoptimal
+        ]
+        pooled[variant] = {
+            "start_pools": start_pools,
+            "best_pool": best_pool,
+            "nearest_pool": nearest_pool,
+            "best_over_nearest": best_pool["ee_bit_per_j"] / nearest_pool["ee_bit_per_j"] - 1.0,
+            "pooled_start_spread": max(row["ee_bit_per_j"] for row in start_pools)
+                / min(row["ee_bit_per_j"] for row in start_pools) - 1.0,
+            "nonoptimal_count": len(nonoptimal),
+            "endpoint_count": len(endpoint_rows),
+            "deltas_mbit": deltas_mbit,
+            "committed_gains": committed_gains,
+        }
+
+    total_nonoptimal = sum(row["nonoptimal_count"] for row in pooled.values())
+    total_endpoints = sum(row["endpoint_count"] for row in pooled.values())
+    headline_spread = max(row["pooled_start_spread"] for row in pooled.values())
+    headline_gap = max(row["best_over_nearest"] for row in pooled.values())
+    lines = [
+        f"Multi-start pooled spread reaches {_pct(headline_spread)}; "
+        f"{total_nonoptimal}/{total_endpoints} endpoints "
+        f"({_pct(total_nonoptimal / total_endpoints)}) are not 2-swap optimal; "
+        f"the project's nearest-start reference sits as much as {_pct(headline_gap)} "
+        "below the best value found.",
+        "",
+        "# Multi-start ceiling diagnostic — 2026-09-10",
+        "",
+        f"`{CLAIM}`. No learner, training run, or policy run was performed. No sealed "
+        "constant, threshold, sign, seed, horizon, price, service guard, acceptance rule, "
+        "sealed artefact, or frozen manifest was changed.",
+        "",
+        "## Direct result",
+        "",
+        "| rule | pooled nearest-start EE (Mbit/J) | pooled randomized-start spread | pooled best-of-8 EE (Mbit/J) | best-of-8 over reference | endpoints not 2-swap optimal |",
+        "|---|---:|---:|---:|---:|---:|",
+    ]
+    for variant in VARIANTS:
+        row = pooled[variant]
+        lines.append(
+            f"| `{variant}` | {_ee(row['nearest_pool']['ee_bit_per_j'])} | "
+            f"{_pct(row['pooled_start_spread'])} | {_ee(row['best_pool']['ee_bit_per_j'])} | "
+            f"{_pct(row['best_over_nearest'])} | {row['nonoptimal_count']}/{row['endpoint_count']} "
+            f"({_pct(row['nonoptimal_count']/row['endpoint_count'])}) |"
+        )
+    lines += [
+        "",
+        "Here, pooled best-of-8 selects the best committed endpoint separately on each "
+        "anchor and then pools summed bits over summed joules. It is a best-known value "
+        "within these eight starts, not an upper bound.",
+        "",
+        "## Panel, starts, and invariant search",
+        "",
+        "The real-anchor panel is `w1/s0`, `w1/s1`, `w2/s0`, `w2/s1`, `w3/s0`, "
+        "`w3/s1`, `w4/s0`, and `w4/s1`: two consecutive anchors from each of the four "
+        "published `V025_PROBE_R2` worlds, 100 users per anchor. Both provisioning rules "
+        "use the same master seed and random draw construction.",
+        "",
+        f"Start 0 is the nearest-eligible baseline. Starts 1–7 use master seed `{MASTER_SEED}`. "
+        "For a start, Python's `random.Random` is initialized by the first 64 bits of "
+        "`SHA256('mcrl-v025-multistart|20260910|world|step|start|attempt')`; each user "
+        "appears once in a seeded shuffled order and receives a uniform draw from that user's "
+        "ordered sealed legal-option tuple. Starting from nearest-eligible, a drawn change is "
+        "retained only when its exact one-boundary profile is valid and meets the unchanged "
+        "nearest-baseline served guard; the objective is never consulted. Whole-assignment "
+        "duplicates are redrawn. `NULL` is used only when the user has no legal option. Because "
+        "physical feasibility is rule-dependent, the random draw stream is shared but accepted "
+        "start assignments can differ between provisioning rules.",
+        "",
+        "The search is imported from `/home/sat/mcrl-v025-harness-ws/harness/anytime.py`, "
+        f"SHA-256 `{EXPECTED_ANYTIME_SHA256}`. Its algorithm is unchanged: deterministic "
+        "cyclic first-improvement, users sorted, each user's sealed legal options in sealed "
+        "order, 16-candidate native dense microbatches, strict exact-binary64 "
+        "`F = B - eta_ref E` improvement, and the nearest-eligible baseline served-count "
+        "guard. A narrow adapter changes only the initial incumbent; transition energy and "
+        "the guard continue to reference the true nearest-eligible baseline. Start 0 and its "
+        "endpoint are reused from today's digest-checked anytime receipts.",
+        "",
+        "Committed endpoint efficiency uses the same 48 realised boundaries at "
+        "`fading_quantile_alpha = 0.10`. Each newly found endpoint is committed-evaluated "
+        "alone to avoid dense-batch-composition roundoff.",
+        "",
+        "## M1 — endpoint efficiency and spread",
+        "",
+    ]
+    for variant in VARIANTS:
+        lines += [
+            f"### `{variant}`",
+            "",
+            "| anchor | start 0 | start 1 | start 2 | start 3 | start 4 | start 5 | start 6 | start 7 | spread | best over start 0 |",
+            "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
+        ]
+        for anchor in data[variant]:
+            ees = [float(row["endpoint"]["ee_bit_per_j"]) for row in anchor["endpoints"]]
+            lines.append(
+                f"| w{anchor['world_index']}/s{anchor['step_index']} | "
+                + " | ".join(_ee(value) for value in ees)
+                + f" | {_pct(max(ees)/min(ees)-1.0)} | {_pct(max(ees)/ees[0]-1.0)} |"
+            )
+        pool_rows = pooled[variant]["start_pools"]
+        pool_ees = [float(row["ee_bit_per_j"]) for row in pool_rows]
+        lines.append(
+            "| **pooled same-index starts** | "
+            + " | ".join(_ee(value) for value in pool_ees)
+            + f" | {_pct(max(pool_ees)/min(pool_ees)-1.0)} | {_pct(max(pool_ees)/pool_ees[0]-1.0)} |"
+        )
+        lines.append(
+            f"| **pooled per-anchor best-of-8** | {_ee(pooled[variant]['best_pool']['ee_bit_per_j'])} | "
+            "— | — | — | — | — | — | — | — | "
+            f"{_pct(pooled[variant]['best_over_nearest'])} |"
+        )
+        lines.append("")
+
+    lines += [
+        "## M2 — exact pairwise-swap test",
+        "",
+        "A legal swap exchanges the two distinct, non-`NULL` assigned identities of an "
+        "unordered user pair, provided each received identity is in the receiving user's "
+        "sealed legal options. Every legal swap is evaluated at the exact one-boundary "
+        "selection objective and must satisfy the unchanged nearest-baseline served guard. "
+        "An endpoint is called 2-swap optimal only when none strictly improves `F`.",
+        "",
+        "| rule | non-optimal endpoints | best-swap selection ΔF (Mbit), non-optimal endpoints | committed EE change of the F-best swap |",
+        "|---|---:|---|---|",
+    ]
+    for variant in VARIANTS:
+        row = pooled[variant]
+        lines.append(
+            f"| `{variant}` | {row['nonoptimal_count']}/{row['endpoint_count']} "
+            f"({_pct(row['nonoptimal_count']/row['endpoint_count'])}) | "
+            f"{_dist(row['deltas_mbit'])} | "
+            f"{_dist([100.0*x for x in row['committed_gains']])}% |"
+        )
+    lines += [
+        "",
+        "Per endpoint:",
+        "",
+        "| rule | anchor | start | legal swaps | improving swaps | 2-swap optimal | best ΔF (Mbit) | committed EE change |",
+        "|---|---|---:|---:|---:|---|---:|---:|",
+    ]
+    for variant in VARIANTS:
+        for anchor in data[variant]:
+            for endpoint in anchor["endpoints"]:
+                swap = endpoint["two_swap"]
+                best = swap["best_improving_swap"]
+                lines.append(
+                    f"| `{variant}` | w{anchor['world_index']}/s{anchor['step_index']} | "
+                    f"{endpoint['start_index']} | {swap['unique_legal_swap_configuration_count']} | "
+                    f"{swap['feasible_improving_swap_count']} | "
+                    f"{'yes' if swap['is_two_swap_optimal'] else 'no'} | "
+                    f"{'—' if best is None else f'{best['selection_delta_f_mbit']:.6f}'} | "
+                    f"{'—' if best is None else _pct(best['committed_ee_gain_over_endpoint'])} |"
+                )
+
+    smallest = min(
+        (anchor for anchors in data.values() for anchor in anchors),
+        key=lambda row: row["state_space"]["assignment_space_log10"],
+    )
+    ss = smallest["state_space"]
+    best_known_lines = []
+    for variant in VARIANTS:
+        anchor = next(
+            row for row in data[variant]
+            if row["world_index"] == smallest["world_index"]
+            and row["step_index"] == smallest["step_index"]
+        )
+        best = max(anchor["endpoints"], key=lambda row: row["endpoint"]["ee_bit_per_j"])
+        best_known_lines.append(
+            f"- `{variant}`: {_ee(float(best['endpoint']['ee_bit_per_j']))} Mbit/J "
+            f"(start {best['start_index']})."
+        )
+    lines += [
+        "",
+        "## M3 — no genuine upper bound reached",
+        "",
+        f"The smallest real anchor in this panel is w{smallest['world_index']}/s{smallest['step_index']} "
+        f"under the raw assignment-space measure. It still has {ss['user_count']} users, "
+        f"{ss['unique_legal_identity_count']} distinct satellite/beam identities, and "
+        f"{ss['legal_option_count']} user-option edges. The Cartesian legal assignment "
+        f"space is between `10^{ss['assignment_space_floor_decimal_exponent']}` and "
+        f"`10^{ss['assignment_space_floor_decimal_exponent'] + 1}` configurations before "
+        "the physical feasibility and service tests.",
+        "",
+        "Exhaustion of that real instance was not affordable, and the evaluator exposes no "
+        "relaxation giving a certified global bound. Reducing the user count, beam inventory, "
+        "horizon, or physics would change sealed inputs or define a synthetic subproblem, so "
+        "it was not done. The following are therefore **best-known values, not bounds**:",
+        "",
+        *best_known_lines,
+        "",
+        "## M4 — implication for the reference fixed point",
+        "",
+    ]
+    for variant in VARIANTS:
+        lines.append(
+            f"- `{variant}`: the pooled nearest-eligible reference is "
+            f"{_pct(pooled[variant]['best_over_nearest'])} below the pooled per-anchor "
+            f"best value found ({_ee(pooled[variant]['nearest_pool']['ee_bit_per_j'])} vs "
+            f"{_ee(pooled[variant]['best_pool']['ee_bit_per_j'])} Mbit/J)."
+        )
+    lines += [
+        "",
+        "These are measured local-search gaps. No claim is made about what a learner could "
+        "recover, and the best-found values are not global optima.",
+        "",
+        "## Reproduction and receipts",
+        "",
+        "From `/home/sat/mcrl-v025-ladder-ws`:",
+        "",
+        "```console",
+        "$ env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python scripts/multistart_ceiling.py run --workers 2 --resume",
+        "$ env PYTHONPATH=src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 nice -n 15 /home/sat/mcrl-leo-handover/.venv/bin/python scripts/multistart_ceiling.py report --out MULTISTART-CEILING-2026-09-10.md",
+        "```",
+        "",
+        "The run uses at most two concurrent worker processes, one numerical thread each. "
+        "There is one digest-chained JSON receipt per rule/anchor in "
+        "`.scratch/multistart-ceiling-20260910/`. The runner verifies the signed source "
+        "receipts, the sealed manifest, each cached world digest, and the imported anytime "
+        "implementation digest before evaluation.",
+        "",
+        "## What was not reached",
+        "",
+        "No exact global optimum or certified upper bound was obtained. No learner, training, "
+        "policy, timing claim, search tuning, new traversal order, altered neighbourhood, "
+        "changed provisioning rule, reduced synthetic instance, or statistical inference was "
+        "attempted. The diagnostic covers eight declared real anchors and eight starts per "
+        "anchor, not all twenty anchors or all possible starts. A 2-swap test is still a local "
+        "certificate; passing it would not establish global optimality.",
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    subparsers = parser.add_subparsers(dest="command", required=True)
+    run_parser = subparsers.add_parser("run")
+    run_parser.add_argument("--workers", type=int, default=2)
+    run_parser.add_argument("--resume", action="store_true")
+    run_parser.add_argument("--output-root", type=Path, default=OUTPUT_ROOT)
+    anchor_parser = subparsers.add_parser("run-anchor")
+    anchor_parser.add_argument("--variant", choices=VARIANTS, required=True)
+    anchor_parser.add_argument("--world", type=int, required=True)
+    anchor_parser.add_argument("--step", type=int, required=True)
+    anchor_parser.add_argument("--out", type=Path, required=True)
+    report_parser = subparsers.add_parser("report")
+    report_parser.add_argument("--output-root", type=Path, default=OUTPUT_ROOT)
+    report_parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if args.command == "run":
+        run_all(args.output_root, args.workers, args.resume)
+    elif args.command == "run-anchor":
+        run_anchor(args.variant, args.world, args.step, args.out)
+    else:
+        report = render_report(args.output_root)
+        args.out.write_text(report, encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()

diff --git a/scripts/multistart_ceiling.py b/scripts/multistart_ceiling.py
