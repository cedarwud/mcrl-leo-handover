   114	def additive_system_ee(
   115	    user_throughputs_bps: np.ndarray,
   116	    system_consumed_power_w: float,
   117	    *,
   118	    serving_beam_u: np.ndarray,
   119	    beam_load_b: np.ndarray,
   120	    beam_active_b: np.ndarray,
   121	) -> SystemEnergyEfficiency:
   122	    """System EE as ``Σ_u R_u / P_system``, decomposed additively per user.
   123	
   124	    The decomposition is exact by construction (a shared denominator), and
   125	    the sum identity is re-checked so a future change cannot quietly break
   126	    the property ADR-003 relies on.
   127	    """
