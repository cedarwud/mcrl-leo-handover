+        ("fixed_power_w", np.inf),
+        ("system_power_w", np.nan),
+        ("interval_s", np.inf),
+    ],
+)
+def test_nonfinite_profile_fields_are_rejected(field: str, value: object) -> None:
+    valid = _one_user_profile()
+
+    with pytest.raises(C3F0Error):
+        replace(valid, **{field: value})
+
+
