   158	            system_throughput_bps=0.0,
   159	            system_consumed_power_w=0.0,
   160	            system_ee_bits_per_j=0.0,
   161	            per_user_contributions_bits_per_j=tuple(0.0 for _ in rates),
   162	            served=served,
   163	            eff_beams=0,
   164	            zero_over_zero=True,
   165	        )
   166	
   167	    contributions = tuple(float(rate / power_w) for rate in rates)
